import
	../frontend/lang
	../model/model
	../model/source-range
	../model/uri
	../util/exit-code

command record(kind command-kind, options command-options)
| Options common to all comands
command-options record
	perf bool
new command-options()
	false,
command-kind union
	build-command
	check-command
	help-command
	lsp-command
	perf-test-parse-command
	print-ast-command
	print-low-model-command
	print-dependencies-command
	print-ide-at-pos-command
	print-ide-whole-file-command
	print-model-command
	print-tokens-command
	run-command
	version-command
build-command record
	main main-kind
	out single-build-output[]
	options build-command-options
	times nat
	watch bool
build-command-options record
	sanity-checks sanity-checks
sanity-checks enum
	no-sanity-checks
	all-sanity-checks
single-build-output record
	path file-path
	kind build-target
check-command record
	root-uris uri set
	times nat
	show-color bool
	show-all-diagnostics bool
| Used for either explicit '--help' or for any command parse error
help-command record(help-text string, exit-code exit-code)
lsp-command record
perf-test-parse-command record(root-uris uri set, times nat)
print-ast-command record(uri uri)
print-tokens-command record(uri uri)
print-dependencies-command record(root-uris uri set, format print-dependencies-format)
print-dependencies-format enum(dot, flat)
to print-dependencies-format?(a string) = a.to::symbol.to
print-model-command record(root-uris uri set)
print-low-model-command record(main uri)
print-ide-at-pos-command record(kind print-ide-at-pos-kind, where uri-line-and-column)
print-ide-at-pos-kind enum
	completions
	definition
	document-highlights
	hover
	implementation
	references
	rename
	signature-help
	type-definition
to print-ide-at-pos-kind?(a string) = a.to::symbol.to
print-ide-whole-file-command record(kind print-ide-whole-file-kind, uri uri)
print-ide-whole-file-kind enum
	code-lenses
	folding-ranges
	inlay-hints
	semantic-tokens
to print-ide-whole-file-kind?(a string) = a.to::symbol.to
run-command record(main main-kind, options run-options)
run-options record
	node-js bool
	watch bool
new run-options()
	node-js: false
	watch: false
version-command record
