import
	../model/ast
	../model/lsp
	../model/model
	../model/source-range
	../model/uri
	../util/util
	./get-position
	./get-target
	./position

get-definition uri-and-line-and-character-range[](program program, params definition-params)
	do if position = get-position program, params.params, exact
	do if target = target-for-position position
	do with out in build
	definition-for-target target, of x
		unless is-java-uri x.uri
			out ~= program.line-and-character-getters[x]

get-type-definition uri-and-line-and-character-range[](program program, params type-definition-params)
	do if position = get-position program, params.text-document-and-position, exact
	do if target = target-for-position position
	do with out in build
	type-definition-for-target target, of x
		out ~= program.line-and-character-getters[x]

reference-cb alias
	void mut(where uri-and-range)

definition-for-target void(a target, f reference-cb)
	match a
	as enum-or-flags-member
		f[a.name-range]
	as fun-decl
		f[a.name-range]
	as position-imported-name
		definition-for-imported-name a, f
	as position-local
		f[a.container.module-uri, a.local.local-must-have-name-range]
	as keen-module
		f[a.range]
	as record-field
		f[a.name-range]
	as signature
		f[a.name-range]
	as spec-decl
		f[a.name-range]
	as type-alias
		f[a.name-range]
	as type-decl
		f[a.name-range]
	as type-param-with-container
		f[a.type-param-with-container-range]
	as var-decl
		f[a.name-range]

-type-param-with-container-range uri-and-range(a type-param-with-container)
	a.container.module-uri, a.container.type-param-asts[a.type-param.index].range

-definition-for-imported-name void(a position-imported-name, f reference-cb)
	do if refs = a.referents
	if x = refs.spec-or-type
		f[x.range]
	for x in refs.funs
		f[x.range]

-type-definition-for-target void(a target, f reference-cb)
	match a
	as enum-or-flags-member
		f[a.containing-enum.name-range]
	as fun-decl
		type-definition-for-fun-decl a, f
	as position-imported-name
		do if refs = a.referents
		if s = refs.spec-or-type
			type-definition-for-spec-or-type s, f
		elif fun = only refs.funs
			type-definition-for-fun-decl fun, f
	as position-local
		definition-for-type a.container.to, a.local.type, f
	as keen-module
		()
	as record-field
		definition-for-type a.containing-record, a.type, f
	as signature
		definition-for-type a.container.to, a.return-type, f
	as spec-decl
		f[a.name-range]
	as type-alias
		type-definition-for-alias a, f
	as type-decl
		f[a.name-range]
	as type-param-with-container
		f[type-param-with-container-range a]
	as var-decl
		definition-for-type a, a.type, f

-type-definition-for-spec-or-type void(a spec-or-type, f reference-cb)
	match a
	as spec-decl
		f[a.name-range]
	as type-alias
		type-definition-for-alias a, f
	as type-decl
		f[a.name-range]

-type-definition-for-alias void(a type-alias, f reference-cb)
	f[a.target.decl.name-range]

-type-definition-for-fun-decl void(a fun-decl, f reference-cb)
	definition-for-type a, a.return-type, f

-definition-for-type void(container type-container, a type, f reference-cb)
	match a
	as bogus-type
		()
	as type-param-index
		f[type-param-with-container-range (a, container.forbid-module)]
	as type-inst
		f[a.decl.name-range]
