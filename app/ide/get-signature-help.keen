import
	../frontend/show-model
	../model/lsp
	../model/ast
	../model/model
	../model/source-range
	./get-position
	./position

get-signature-help signature-help?(program program, params signature-help-params) show-ctx
	do if position = get-position program, params.text-document-and-position, after
	the common-types = program.common-types
	do if e = position.kind.expression-position
	signature-help-at-expression-position e

-signature-help-at-expression-position signature-help?(a expression-position) show-type-ctx
	match x = a.kind
	as bogus-call-expr
		signature-help-at-bogus-call a.container.to, x
	as call-expr
		if last = last x.args and bogus-expr last
			active-parameter = x.args.size - 1
			signatures:
				- signature-information a.container.to, x.called.called-decl, active-parameter
			activeSignature: 0
			activeParameter: active-parameter
	else
		()

-signature-help-at-bogus-call signature-help(container type-container, a bogus-call-expr) show-type-ctx
	active-parameter = active-parameter a.ast
	signatures: for x in a.candidates
		signature-information container, x, active-parameter
	activeSignature: ()
	activeParameter: active-parameter

-active-parameter nat?(a call-expr-source)
	match a
	as call-ast-dot
		0
	as call-ast-infix
		decr a.args.size
	as call-ast-prefix
		decr a.args.size
	as call-ast-prefix-question
		decr a.args.size
	as call-ast-prefix-with-type-arg
		decr a.args.size
	else
		()

-decr nat?(a nat) = unless a == 0 then a - 1

-signature-information signature-information
	outer-type-container type-container
	a called-decl
	active-parameter nat?
do show-type-ctx
	type-container type-container = match a
	as fun-decl
		a
	as called-spec-sig
		outer-type-container
	shown = show-called-decl-parts type-container, a
	out char8 mut[] = ()
	out ~~= shown.name-and-return-type.to::char8[]
	out ~= "("
	first mut bool = true
	parameter-info parameter-information[] = for param in shown.params
		if first
			first := false
		else
			out ~~= ", "
		begin = out.size
		out ~~= param.to::char8[]
		end = out.size
		begin .. end, ""
	out ~= ")"
	unless is-empty shown.rest
		out ~= " "
		out ~~= shown.rest.to::char8[]

	the file-content-getters = file-content-getters
	label: out.move-to
	documentation: doc-comment-string a.module-uri, a.doc-comment
	parameters: parameter-info
	activeParameter: active-parameter
