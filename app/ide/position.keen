import
	../model/ast
	../model/model
	../model/uri
	../util/by-key

position record
	module keen-module
	kind position-kind
uri uri(a position) = a.module.uri
| A SpecDecl* can contain parameters in its signatures, and a StructDecl* for a variant can too
local-container union(fun-decl, test_, spec-decl, type-decl, var-decl)
to type-container(a local-container)
	match a
	as fun-decl then a
	as test_ then a
	as spec-decl then a
	as type-decl then a
	as var-decl then a
to local-container(a expr-container)
	match a
	as fun-decl then a
	as test_ then a
	as var-decl then a
module-uri uri(a local-container)
	a.to::type-container.module-uri

assert-local-container local-container(a doc-comment-container)
	match a
	as any-decl
		assert-local-container a
	as enum-or-flags-member
		throw unreachable
	as keen-module
		throw unreachable
	as record-field
		throw unreachable
	as signature
		a.container.to
assert-local-container local-container(a any-decl)
	match a
	as fun-decl then a
	as spec-decl then a
	as test_ then a
	as type-alias then throw unreachable
	as type-decl then a
	as var-decl then throw unreachable
to local-container(a signature-container)
	match a
	as spec-decl then a
	as type-decl then a

visibility-container union(fun-decl, record-field, spec-decl, type-alias, type-decl, var-decl)
	name symbol()
	visibility visibility()

doc-comment-container union(any-decl, enum-or-flags-member, keen-module, record-field, signature)
	doc-comment doc-comment()
# WARN: typeContainerFor(a).docComment is not always a.docComment
type-container-for type-container(a doc-comment-container)
	match a
	as any-decl
		a.to
	as enum-or-flags-member
		a.containing-enum
	as keen-module
		a
	as record-field
		a.containing-record
	as signature
		a.container.to

position-kind union
	position-catch
	position-doc-ref
	enum-or-flags-member
	expression-position
	fun-decl
	position-imported-name
	position-import-path
	position-keyword
	position-local
	position-match-enum-case
	position-match-scalar-case
	position-match-string-like-case
	position-match-sum-type-case
	position-modifier
	position-modifier-extern
	position-module
	record-field
	position-record-field-mutability
	spec-decl
	signature
	position-context-modifier
	position-spec-use
	type-alias
	type-decl
	test_
	type-with-container
	type-param-with-container
	var-decl
	position-visibility-mark

position-catch record(container type-container, catch_ catch_)
position-doc-ref record(container doc-comment-container, ref doc-comment-reference)
position-imported-name record(name name-and-range, exports exports)
funs fun-decl array-view(a position-imported-name) = all-with-name a.exports.funs, a.name.name
type spec-or-type?(a position-imported-name) = a.exports.types-and-specs[a.name.name]
position-import-path record(exporting-module module)

# Non-modifier keywords only
position-keyword enum
	alias_
	builtin_
	enum_
	flags_
	global_
	interface_
	local-mut
	record_
	spec_
	thread-local_
	underscore
	union_
	variant_
position-local record(container local-container, local local)
position-match-enum-case record(member enum-or-flags-member)
position-match-scalar-case record(kind char-or-integral-type, value scalar-value)
position-match-string-like-case record(type type-with-container, value string)
position-match-sum-type-case record(container expr-container, member type-inst)
position-modifier record(container type-container, modifier modifier-keyword)
position-modifier-extern record(library-name symbol)
position-module record
position-record-field-mutability record(visibility visibility?)
position-context-modifier record(container type-container, context type-inst)
position-spec-use record(container type-container, spec_ spec-inst)
type-param-with-container record(type-param type-param-index, container any-decl)
position-visibility-mark record(container visibility-container)

expression-position record(container expr-container, expr expr, kind expression-position-kind)
expression-position-kind union
	assert-or-forbid-expr
	bogus-call-expr
	bogus-expr
	call-expr
	call-named-new-expr
	call-option-expr
	expr-keyword
	if-expr
	expression-position-literal
	lambda-expr
	let-the-expr
	list-expr
	local-ref
	logical-expr
	match-enum-expr
	match-scalar-expr
	match-string-like-expr
	match-sum-type-expr
	the-expr
	try-expr
	try-let-expr
	while-or-until-expr
	while-or-until-body-expr
expression-position-literal record
local-ref record(kind local-ref-kind, local local)
local-ref-kind enum(get, set, closure-get, closure-set, pointer)

expr-keyword enum
	ampersand
	colon-colon
	elif_
	else-after-assert
	else-after-do-if
	else-after-do-unless
	else-after-forbid
	else-after-if
	else-after-unless
	else-after-match
	equals-expression
	finally_
	force
	in-after-for
	in-after-for-star
	in-after-with
	question-before-name-or-subscript
	then-after-for-or-with
	then-after-if-with-else
	then-after-unless-with-else
	then-after-if-without-else
	then-after-unless-without-else
	then-after-of
	then-after-unless
	throw_
	trusted_
