import
	keen/io/file
	keen/io/print
	keen/io/process
	keen/io/stdin
	keen/parse
	keen/string/util
	keen/unsafe
	../lib/parse: parse-json
	./cli/command
	./cli/parse-command
	./backend/js/source-map
	./frontend/frontend
	./frontend/get-diagnostic-severity
	./frontend/lang
	./frontend/parse/lex-tokens
	./frontend/parse/parse
	./frontend/show-diag
	./frontend/show-model
	./model/lsp
	./model/model
	./model/parse-diag
	./model/source-range
	./model/uri
	./server
	./util/exit-code
	./util/file-system
	./util/perf
	./util/util

main void() global
	start = perf-now
	cwd = cwd
	command = parse-command cwd, command-line-args
	finally if command.options.perf
		log "Performance:", perf-report start
	this-executable = this-executable
	server-settings server-settings =
		keen-lib: get-keen-lib-dir this-executable 'to
		cwd: cwd.to
		show-options: color: not lsp-command command.kind
	with reader in file-reader this-executable, command.kind.needs-watch
		server server = trusted server-settings,
		ctx main-ctx =
			server: server
			reader: reader
			print-error: it.print-error
		try
			go ctx, this-executable, command.kind
		catch e as exit
			exit-process e.exit-code

-exit record(exit-code int32) exception case
-exit exception()
	exit 1
-show string(_ exit)
	throw unreachable

-needs-watch bool(a command-kind)
	match a
	as build-command
		a.watch
	as run-command
		a.options.watch
	else
		false

main-ctx record mut
	server mut server
	reader file-reader
	print-error void mut(text string)
server server() main-ctx
	the::main-ctx.server
set-server void(value server) main-ctx
	the::main-ctx.server := value
reader file-reader() main-ctx
	the::main-ctx.reader
output-error void(text string) main-ctx
	the::main-ctx.print-error[text]

-run-lsp void(server server, reader file-reader, this-executable file-path) global
	log keen-version this-executable
	log "Running language server protocol"
	do while true
	log-lsp = server.lsp-state.trace >= messages
	for message in combine-messages lsp-read-many log-lsp
		exit = handle-one-lsp-message server, message, {read-file-locally reader, it}, {lsp-write it.to, log-lsp}
		forbid exit else exit exit.value.to

| Reads as many messages as are avialable on stdin. Blocks for at least one message.
-lsp-read-many lsp-in-message[](log-lsp bool) global
	with out in build
		out ~= lsp-read log-lsp
		while stdin-has-input
			out ~= lsp-read log-lsp

-lsp-read lsp-in-message(log-lsp bool) global
	line0 = read-stdin
	stripped = try-remove-start! line0, "Content-Length: "
	content-length = parse nat, stripped
	line1 = strip read-stdin
	line1 is ""
	content = as-string read-n-bytes-from-stdin content-length
	if log-lsp then log "LSP message in: {content}"
	to parse-json content

-lsp-write void(content-json json, log-lsp bool) global
	content-string = to-json content-json
	if log-lsp
		print-error "LSP out: {content-string}"
	print-no-newline "Content-Length: {content-string.to::char8[].size}\r\n\r\n{content-string}"

-load-all-files-for-dir void(dir-uri uri) main-ctx
	assert dir-path = as-file-path dir-uri else
		output-error "Can't list files at non-file URI {dir-uri}"
		exit
	try files = files-in-directory-recursive reader, dir-path catch as path-not-found
		output-error "Not found: {dir-path}"
		throw exit
	for file in files
		if is-keen file or is-imported-file-uri server, file.to
			load-single-file server, reader, file.to

-files-for-config file-path[](reader file-reader, config-file file-path)
	files = files-in-directory-recursive reader, config-file.parent!
	filter files, it.file-type == keen

# This is exposed for use by the site
load-all-files void(root-uris uri set) main-ctx
	start = perf-now
	finally end-load-all-files start
	for uri in root-uris
		if is-keen uri or is-imported-file-uri server, uri
			load-single-file server, reader, uri
		else
			load-all-files-for-dir uri
	load-until-no-unknown-uris server, reader

-read-file-locally read-file-result-params(reader file-reader, uri uri)
	match res = try-read-file reader, uri
	as array-view
		uri, ok, res
	as read-file-diag
		type read-file-result-type = match res
		as unknown
			throw unreachable
		as not-found
			not-found
		as error
			error
		uri, type, ()

-load-until-no-unknown-uris void(server server, reader file-reader)
	until server.files-state == all-loaded
		for uri in flush-all-unknown-uris server
			load-single-file server, reader, uri

-load-single-file void(server server, reader file-reader, uri uri)
	set-file server, uri, try-read-file reader, uri

-go void(ctx main-ctx, this-executable file-path, command command-kind) global
	the main-ctx = ctx
	match command
	as build-command
		targets build-target set = map command.out, it.kind
		do-and-watch command.main, command.watch, of
			program = check-main-and-print-diags command.main, targets
			if has-fatal-diagnostics program
				print-error "Due to compile errors, nothing will be built."
				for out in command.out
					try
						remove-file out.path.to
					catch as path-not-found
						()
				throw exit
			else
				do for i in 0 .. command.times
				is-last = i == command.times - 1
				build-all-outputs server, command.out, command.options, program, not is-last
	as check-command
		for _ in 0::nat .. command.times
			options show-diags-options =
				only-for-uris: ()
				min-diag-severity: min-value
				show-options: color: command.show-color
				show-all-diagnostics: command.show-all-diagnostics
			program = check-and-print-diags command.root-uris, options
			assert is-empty program.diagnostics else exit
			server := trusted server.settings,
	as help-command
		print command.help-text
		throw exit command.exit-code.value.to
	as lsp-command
		run-lsp server, reader, this-executable
	as perf-test-parse-command
		files file-path[] = for* uri in command.root-uris
			file = as-file-path! uri
			if is-config uri
				files-for-config ctx.reader, file
			else
				- file
		file-contents line-and-column-getter[] = for file in files
			line-and-column-getter-for-text match x = try-read-file ctx.reader, file.to
			as array-view
				safe-reinterpret-cast x
			as read-file-diag
				print-error "error reading {file}"
				()
		for _ in 0 .. command.times
			for file, lcg in zip files, file-contents
				_ = parse-file file.to, lcg.source-text, lcg
		log "Parsed {files.size} files {command.times} times."
	as print-ast-command
		load-single-file server, reader, command.uri
		diagnostics, json = print-ast server, command.uri
		unless is-empty diagnostics
			print-error diagnostics
		print "{json}"
	as print-tokens-command
		match content = try-read-file reader, command.uri
		as array-view
			source string-view = safe-reinterpret-cast content
			diagnostics parse-diagnostic mut[] = ()
			tokens = lex-tokens source, diagnostics
			unless is-empty diagnostics
				the show-ctx = show-ctx-for-single-file command.uri, source, server.uris-info, server.show-options
				print-error show-parse-diagnostics command.uri, diagnostics.move-to
			print to-kid tokens
		as read-file-diag
			print-error "Can't read file"
	as print-low-model-command
		main = main-kind-main-function command.main, ()
		load-all-files root-uris main
		program = check-main-and-print-diags main, ()
		print "{json-of-low-model server, java, program}"
	as print-dependencies-command
		program = check-and-print-diags command.root-uris, min-diag-severity: check-error
		print print-dependencies server, program, command.format
	as print-ide-at-pos-command
		program = check-and-print-diags (command.where.uri,)
		print "{json-for-print-ide-at-pos server, program, command.where, command.kind}"
	as print-ide-whole-file-command
		program = check-and-print-diags (command.uri,)
		print "{json-for-print-ide-whole-file server, program, command.uri, command.kind}"
	as print-model-command
		program = check-and-print-diags command.root-uris
		print "{json-of-model server, program, command.root-uris}"
	as run-command
		do-and-watch command.main, command.options.watch, {run command}
	as version-command
		print "{keen-version this-executable}"

-do-and-watch void(main main-kind, watch bool, f void mut()) main-ctx
	load-all-files root-uris main
	f[]
	do if watch
	log "watching for changes..."
	for in infinite
		changed = wait-for-change reader
		for x in changed
			log "{x} changed, building again..."
		load-all-files map changed, it.to
		f[]

-run void(run run-command) global, main-ctx
	is-js = run.options.node-js
	program = check-main-and-print-diags run.main,
		- if is-js then js else java
	forbid has-fatal-diagnostics program else
		print-error "Stopping due to compile errors."
		exit
	trusted if is-js
		run-node-js server, program, run.main
	else
		assert java else error "This is a JS build, so 'run' only works when the '--node-js' option is passed."
		build-and-run-java server, program, run.main.program-args

-run-node-js void(server server, program program-with-main, run-main main-kind) global, unsafe
	with temp in temp-file "keen-", ".js"
		js = build-to-js server, program, no-sanity-checks, ()
		write-file temp, js.js
		args string[] = ("node", temp)::string[] ~~ run-main.program-args
		exit = run-process-and-inherit-io "/usr/bin/env", args
		assert exit == 0 else exit exit

-get-keen-lib-dir file-path(this-executable file-path)
	keen-bin-dir = parent-or-empty this-executable
	keen-dir = parent-or-empty keen-bin-dir
	usr = root-file-path "usr"
	if keen-bin-dir == usr / "bin"
		usr / "include" / "keen"
	elif keen-bin-dir == usr / "local" / "bin"
		usr / "local" / "include" / "keen"
	else
		keen-dir.base-name is "keen"
		keen-dir / "lib"

-build-all-outputs void
	server server
	outputs single-build-output[]
	options build-command-options
	program program-with-main
	dry-run bool
do global
	for x in outputs
		match x.kind
		as java
			classes = build-to-java server, program, ""
			do unless dry-run
			write-jar x.path, classes
		as js
			write-to-js server, program, options, x.path, true, dry-run

-write-to-js void
	server server
	program program-with-main
	options build-command-options
	out-file file-path
	include-source-map bool
	dry-run bool
do global
	source-map-path file-path? = if include-source-map
		add-extension out-file, ".map"
	result = build-to-js server, program, options.sanity-checks, source-map-path.?base-name
	do unless dry-run
	write-file out-file, result.js, all, allow
	?write-file source-map-path, result.map!, read-write, allow

-check-main-and-print-diags program-with-main(main main-kind, targets build-target set) main-ctx
	program = get-program-for-main server, main, targets
	unless is-empty program.diagnostics
		output-error show-diagnostics server, program
	program

-check-and-print-diags program(roots uri set) main-ctx
	check-and-print-diags roots, ()
-check-and-print-diags program(roots uri set, options show-diags-options) main-ctx
	load-all-files roots
	dirs uri set = filter roots, it.is-keen.not
	program = get-program server, dirs
	if some program.diagnostics, it.diagnostic.kind.get-diagnostic-severity >= options.min-diag-severity
		output-error show-diagnostics server, program, options
	program

-print-dependencies string(server server, program program, format print-dependencies-format)
	the show-ctx = get-show-ctx server
	match format
	as dot
		deps = join "\n\t", sort for* from, to in all-dependencies program
			for t in to
				"{quoted show-uri from} -> {quoted show-uri t}"
		"digraph \{\n\t{deps}\n\}"
	as flat
		join "\n", sort for uri in all-uris program
			show-uri uri
