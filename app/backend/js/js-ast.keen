import
	../../model/model
	./source-map

js-script-ast record
	classes js-class-decl[]
	functions js-fun-decl[]
	vars js-var-decl[]
	statements js-statement[]

js-name record(kind js-name-kind, keen-name string, mangle-index nat?)
js-name-kind enum
	| This results in a plain symbol (assuming it's a valid JS identifier)
	none
	constant
	| This is for locals from the source code
	local
	| This is for locals generated by the compiler
	temp
no-prefix js-name(name string)
	none, name, ()
constant js-name(index nat)
	constant, "", index

js-fun-decl record
	comment string
	name js-name
	memoize bool
	fun js-arrow-function
new js-fun-decl(name js-name, fun js-arrow-function)
	"", name, false, fun
new js-fun-decl(comment string, name js-name, fun js-arrow-function)
	comment, name, false, fun

js-class-decl record
	comment string
	name js-name
	extends js-name?
	members js-class-member[]
js-class-member record
	source source
	name string
	kind js-class-member-kind
js-class-member-kind union(js-class-method, js-expr, js-class-getter)
js-class-method record(async sync-or-async, params js-destructure[], body js-block-statement)
js-class-getter record(body js-block-statement)
sync-or-async enum(sync, async)
js-arrow-function record(async sync-or-async, params js-destructure[], body js-expr-or-block-statement)
js-expr-or-block-statement union(js-expr, js-block-statement)

js-destructure union(js-name, js-object-destructure)
js-object-destructure record
	fields (string, js-destructure)[]

js-statement record(source source, kind js-statement-kind)
js-statement-kind union
	js-assign-statement
	js-block-statement
	js-break-statement
	js-continue-statement
	js-expr
	js-for-of-statement
	js-if-statement
	js-return-statement
	js-switch-statement
	js-throw-statement
	js-try-catch-statement
	js-try-finally-statement
	js-var-decl
	js-while-statement
js-assign-statement record(left js-expr, right js-expr)
js-block-statement record(statements js-statement[])
~~ js-block-statement(a js-block-statement, b js-block-statement)
	a.statements ~~ b.statements,
~ ~ js-block-statement(a js-block-statement, b js-statement)
	a.statements ~ b,
~ ~ js-block-statement(a js-statement, b js-block-statement)
	a ~ b.statements,
js-break-statement record(label js-name?)
js-continue-statement record
js-for-of-statement record(local js-name, collection js-expr, body js-block-statement)
js-if-statement record(cond js-expr, then_ js-block-statement, else_ js-statement?)
js-return-statement record(arg js-expr)
js-switch-statement record(arg js-expr, cases js-switch-case[], default js-block-statement)
js-switch-case record
	value js-expr
	| Force a block statement here to ensure each branch has its own scope
	then_ js-block-statement
js-throw-statement record(arg js-expr)
js-try-catch-statement record(tried js-block-statement, exception js-name, catch_ js-block-statement)
js-try-finally-statement record(tried js-block-statement, finally_ js-block-statement)
js-var-decl record(const js-var-decl-const, vars js-destructure-and-initializer[])
new js-var-decl(const js-var-decl-const, destructure js-destructure, initializer js-expr?)
	const,
		- destructure, initializer
js-destructure-and-initializer record(destructure js-destructure, initializer js-expr?)
js-var-decl-const enum(const, let)
show string(a js-var-decl-const)
	a.to::symbol.to
js-while-statement record(label js-name?, condition js-expr, body js-block-statement)

js-expr record(source source, kind js-expr-kind)
js-expr-kind union
	js-array-expr
	js-arrow-function
	js-assign-expr
	js-binary-expr
	js-call-expr
	js-call-with-spread-expr
	js-literal-bigint
	js-literal-bool
	js-literal-number
	js-literal-string
	js-name
	js-new-expr
	js-null-expr
	js-object-expr
	js-optional-property-access-expr
	js-property-access-expr
	js-property-access-computed-expr
	js-ternary-expr
	js-this-expr
	js-unary-expr
js-array-expr record(elements js-expr[])
js-assign-expr record(assignee js-name, value js-expr)
js-binary-expr record(kind js-binary-kind, left js-expr, right js-expr)
js-binary-kind enum
	bit-shift-left
	bit-shift-right
	bit-shift-right-unsigned
	bitwise-and
	bitwise-or
	bitwise-xor
	comma
	divide
	eq-eq-eq
	greater
	greater-or-equal
	instanceof
	less
	less-or-equal
	minus
	| WARN: Not a true modulo. In JS, 'a % b' may return a negative result.
	modulo
	not-eq-eq
	or_
	plus
	times
js-call-expr record(called js-expr, args js-expr[])
js-call-with-spread-expr record(called js-expr, args js-expr[], spread-arg js-expr)
js-literal-bool record(value bool)
js-literal-bigint record(is-signed bool, value scalar-value)
js-literal-number record(type float-type, value float)
js-literal-string record(value string)
js-new-expr record(class_ js-expr, arguments js-expr[])
js-null-expr record
js-object-expr record
	keys string[]
	values js-expr[]
| `obj?.prop`
js-optional-property-access-expr record(object js-expr, property-name string)
js-property-access-expr record(object js-expr, property-name string)
js-property-access-computed-expr record(object js-expr, property-name js-expr)
js-ternary-expr record(condition js-expr, then_ js-expr, else_ js-expr)
js-this-expr record
js-unary-expr record(kind js-unary-kind, arg js-expr)
js-unary-kind enum(await, bitwise-not, not, typeof, void)

to js-statement(a js-expr)
	a.source, a
to js-block-statement(expr js-expr)
	expr.to::js-statement.to
to js-block-statement(a js-statement)
	(a,),
to js-block-statement(a js-statement[])
	a,
to js-expr-or-block-statement(a js-statement)
	a.to::js-block-statement
gen-array js-expr(source source, elements js-expr[])
	source, elements.js-array-expr

gen-assign js-statement(source source, left js-expr, right js-expr)
	source, js-assign-statement left, right
gen-assign js-statement(source source, left js-name, right js-expr)
	gen-assign source, (gen-identifier source, left), right
gen-await-if-async js-expr(source source, async sync-or-async, arg js-expr)
	match async
	as sync
		arg
	as async
		gen-await source, arg
gen-await js-expr(source source, arg js-expr)
	gen-unary source, await, arg
-gen-await-if js-expr(source source, async sync-or-async, arg js-expr)
	match async
	as sync
		arg
	as async
		gen-await source, arg
gen-binary js-expr(source source, kind js-binary-kind, arg0 js-expr, arg1 js-expr)
	source, js-binary-expr kind, arg0, arg1
gen-binary js-expr(source source, kind js-binary-kind, (arg0 js-expr, arg1 js-expr))
	source, js-binary-expr kind, arg0, arg1
gen-block-statement js-block-statement(statements js-statement[])
	statements,
gen-bool js-expr(source source, value bool)
	source, value.js-literal-bool
gen-break-no-label js-statement(source source)
	source, ().js-break-statement
gen-break js-statement(source source, label js-name)
	source, label.js-break-statement
gen-call js-expr(source source, await sync-or-async, called js-expr, args js-expr[])
	gen-await-if source, await, (gen-call-sync source, called, args)
gen-call-sync js-expr(source source, called js-expr, args js-expr[])
	source, js-call-expr called, args
gen-call-with-spread js-expr(source source, await sync-or-async, called js-expr, args js-expr[], spread-arg js-expr)
	gen-await-if source, await,
		source, js-call-with-spread-expr called, args, spread-arg
gen-call-property-sync js-expr(source source, object js-expr, property string, args js-expr[])
	gen-call-sync source, (gen-property-access source, object, property), args
gen-optional-call-property-sync js-expr(source source, object js-expr, property string, args js-expr[])
	gen-call-sync source, (gen-optional-property-access source, object, property), args
gen-continue js-statement(source source)
	source, js-continue-statement
gen-global js-expr(source source, name string)
	source, name.no-prefix
gen-if js-statement(source source, cond js-expr, then_ js-block-statement)
	source, js-if-statement cond, then_, ()
gen-if js-statement(source source, cond js-expr, then_ js-block-statement, else_ js-statement)
	source, js-if-statement cond, then_, else_
gen-instanceof js-expr(source source, arg0 js-expr, arg1 js-expr)
	gen-binary source, instanceof, arg0, arg1
-gen-bigint js-expr(source source, is-signed bool, value scalar-value)
	source, js-literal-bigint is-signed, value
gen-bigint-signed js-expr(source source, value int64)
	gen-bigint source, true, value.to
gen-bigint-unsigned js-expr(source source, value nat64)
	gen-bigint source, false, value.to
gen-not js-expr(source source, arg js-expr)
	gen-unary source, not, arg
gen-null js-expr(source source)
	source, js-null-expr
gen-number32 js-expr(source source, value float)
	source, js-literal-number float32, value
gen-number64 js-expr(source source, value float)
	source, js-literal-number float64, value
gen-new js-expr(source source, class_ js-expr)
	gen-new source, class_, ()
gen-new js-expr(source source, class_ js-expr, args js-expr[])
	source, js-new-expr class_, args
gen-or js-expr(source source, arg0 js-expr, arg1 js-expr)
	gen-binary source, or_, arg0, arg1
-gen-plus js-expr(source source, arg0 js-expr, arg1 js-expr)
	gen-binary source, plus, arg0, arg1
gen-minus js-expr(source source, arg0 js-expr, arg1 js-expr)
	gen-binary source, minus, arg0, arg1
gen-bitwise-and js-expr(source source, arg0 js-expr, arg1 js-expr)
	gen-binary source, bitwise-and, arg0, arg1
gen-property-access js-expr(source source, arg js-expr, property-name string)
	source, js-property-access-expr arg, property-name
gen-property-access-computed js-expr(source source, object js-expr, property-name js-expr)
	match x = property-name.kind
	as js-literal-string
		gen-property-access source, object, x.value
	else
		source, js-property-access-computed-expr object, property-name
gen-optional-property-access js-expr(source source, object js-expr, property-name string)
	source, js-optional-property-access-expr object, property-name
gen-return js-statement(source source, arg js-expr)
	source, js-return-statement arg
gen-switch js-statement(source source, arg js-expr, cases js-switch-case[], default js-block-statement)
	source, js-switch-statement arg, cases, default
gen-ternary js-expr(source source, cond js-expr, then_ js-expr, else_ js-expr)
	source, js-ternary-expr cond, then_, else_
gen-throw js-statement(source source, thrown js-expr)
	source, js-throw-statement thrown
gen-try-finally js-statement(source source, tried js-block-statement, finally_ js-block-statement)
	source, js-try-finally-statement tried, finally_
gen-typeof js-expr(source source, arg js-expr)
	gen-unary source, typeof, arg
gen-eq-eq-eq js-expr(source source, a js-expr, b js-expr)
	gen-binary source, eq-eq-eq, a, b
gen-not-eq-eq js-expr(source source, a js-expr, b js-expr)
	gen-binary source, not-eq-eq, a, b
gen-less js-expr(source source, a js-expr, b js-expr)
	gen-binary source, less, a, b
gen-try-catch js-statement
	source source
	try-block js-block-statement
	exception js-name
	catch-block js-block-statement
do
	source, js-try-catch-statement try-block, exception, catch-block
gen-var-decl js-statement(source source, const js-var-decl-const, destructure js-destructure, initializer js-expr?)
	source, (const, destructure, initializer)::js-var-decl
gen-const js-statement(source source, destructure js-destructure, initializer js-expr)
	gen-var-decl source, const, destructure, initializer
gen-let js-statement(source source, destructure js-destructure)
	gen-var-decl source, let, destructure, ()
gen-let js-statement(source source, destructure js-destructure, initializer js-expr)
	gen-var-decl source, let, destructure, initializer
gen-identifier js-expr(source source, name js-name)
	source, name
gen-string js-expr(source source, value string)
	source, value.js-literal-string
gen-this js-expr(source source)
	source, js-this-expr
gen-unary js-expr(source source, kind js-unary-kind, arg js-expr)
	source, js-unary-expr kind, arg
gen-undefined js-expr(source source)
	source, js-unary-expr void, gen-number64 source, 0
gen-while js-statement(source source, condition js-expr, body js-block-statement)
	gen-while source, (), condition, body
gen-while js-statement(source source, label js-name?, condition js-expr, body js-block-statement)
	source, js-while-statement label, condition, body
gen-while-true js-statement(source source, label js-name?, body js-block-statement)
	gen-while source, label, (gen-bool source, true), body

gen-increment js-statement(source source, name js-name, is-bigint bool)
	gen-assign source, name,
		gen-plus source, (gen-identifier source, name),
			if is-bigint then gen-bigint-unsigned source, 1 else gen-number64 source, 1
