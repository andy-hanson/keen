import
	../../model/low-model
	../../model/model
	../util

union-representation enum
	| Discriminate between union members using instanceof / typeof checks.
	direct
	| Need to construct a 'new U(index, value)' and use index to discriminate
	switch

union-info record
	union-to-representation union-representation[low-type]
	exception-case-types low-type set # TODO: exact same thing was needed for java/union-representation, share code?

union-representation union-representation(a union-info, union_ low-type)
	a.union-to-representation[union_]!

plan-unions union-info(program low-program)
	res union-representation mut[low-type] = ()
	for s in program.all-non-extern-types
		do if u = low-union s.body
		res[s] := choose-union-representation program, s, u
	union-to-representation: res.move-to
	exception-case-types: program.exception.body.low-union!.members.to

-choose-union-representation union-representation(program low-program, type low-type, u low-union)
	# TODO:PERF check for nullable unions
	if type == program.exception
		direct
	elif !every u.members, it.can-use-in-direct-union
		switch
	elif all-unique-primitives u
		direct
	else
		switch
-all-unique-primitives bool(a low-union)
	is-unique for*::js-primitive-kind[] x in a.members
		from-option as-js-primitive x

-can-use-in-direct-union bool(a low-type)
	match body = a.body
	as low-builtin-type then body.kind != js-any
	as low-union then false
	else then true

-is-unique[t] bool(a t[]) t key
	a.to::(t set).size == a.size

# Don't bother with boolean since there is only one type represented that way/
-js-primitive-kind enum(array, bigint, function, number)
-as-js-primitive js-primitive-kind?(a low-type)
	match body = a.body
	as low-builtin-type
		as-js-primitive body.kind
	as low-enum
		as-js-primitive body.storage.to::builtin-type
	as low-flags
		as-js-primitive body.storage.to::builtin-type
	else
		()
-as-js-primitive js-primitive-kind?(a builtin-type)
	match a
	as array
		array
	as bool
		() # Only one type compiles to 'boolean', so ignore
	as buffer
		array
	as char8
		number
	as char32
		number
	as float32
		number
	as float64
		number
	as js-any
		() # Already handled by 'can-use-in-direct-union'
	as int8
		number
	as int16
		number
	as int32
		number
	as int64
		bigint
	as lambda-data
		function
	as lambda-mut
		function
	as lambda-shared
		function
	as nat8
		number
	as nat16
		number
	as nat32
		number
	as nat64
		bigint
	as option
		throw unreachable
	as void
		() # Only one type compiles to 'undefined', so ignore
	as weak-ref
		()
