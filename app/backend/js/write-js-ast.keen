import
	keen/string/util
	../../../lib/parse
	../../cli/command
	../../model/model
	../../model/source-range
	../../util/util
	../util
	./js-ast
	./source-map

write-js-ast js-and-map
	file-content-getters file-content-getters
	module-paths module-paths
	a js-script-ast
	sanity-checks sanity-checks
	source-map-name string?
do
	map-builder source-map-builder? = if source-map-name then ()::source-map-builder
	js: with text-out in build
		out output = text-out, map-builder, 0, 0
		out ~~= "#!/usr/bin/env node\n"
		if source-map-name
			out ~~= source-map-url source-map-name
		out ~~= quote
			export \{\}
			const _global = typeof self === "undefined" ? global : self
			const _memoize = fn => \{
				let result
				return () => \{
					if (fn) \{
						result = fn()
						fn = undefined
					\}
					return result
				\}
			\}
			const _compareIntegral = (a, b) =>
				a < b ? 0 :
				b < a ? 2 :
				1;
			const _compareFloat = (a, b) =>
				a < b ? 0 :
				b < a ? 2 :
				Object.is(a, b) ? 1 :
				Number.isNaN(a) ? 0 :
				Number.isNaN(b) ? 2 :
				Object.is(a, -0) ? 0 : 2;
		if sanity-checks != no-sanity-checks
			out ~~= "const _assert = cond => \{ if (!cond) throw new Error(\"Assertion failed.\") \}"
		for x in a.classes
			write-class out, x
			out ~= "\n"
		for fun in a.functions
			write-comment out, fun.comment
			out ~~= "const {fun.name} = "
			if fun.memoize
				out ~~= "_memoize("
			write-arrow-function out, 0, expr, fun.fun
			if fun.memoize
				out ~= ")"
			out ~= "\n"
		for var in a.vars
			write-var-decl out, 0, var
			out ~= "\n"
		write-statements out, a.statements
	map: if map-builder
		finish map-builder, file-content-getters, module-paths

-output record mut
	text char8 builder
	map source-map-builder?
	line mut nat32
	character mut nat32

- ~= void(a output, x char8)
	a.text ~= x
	if x == "\n"
		a.line +:= 1
		a.character := 0
	else
		a.character +:= 1
- ~~= void(a output, s string)
	for x in s
		a ~= x

-write-with-commas[t] void(a output, xs t[], f void mut(x t))
	for i, x in with-index xs
		if i != 0
			a ~~= ", "
		f[x]

-mark-map void(a output, source source)
	if map = a.map
		map ~= source, (a.line, a.character)

-source-map-url string(source-map-name string)
	"//# sourceMappingURL={source-map-name}\n"

-write-statements void(out output, statements js-statement[])
	for x in statements
		out ~= "\n"
		write-statement out, 0, x, non-first

-show string(a js-name)
	if is-js-keyword a.keen-name and !a.mangle-index
		"_{a.keen-name}"
	else
		"{prefix a.kind}{mangle-name-common a.keen-name}{if x = a.mangle-index then "___{x}"}"
-prefix string(a js-name-kind)
	match a
	as none
		""
	as constant
		"c_"
	as local
		"l_"
	as temp
		"x_"

-property-access string(a string)
	if is-js-identifier a then ".{a}" else "[\"{a}\"]"
-member-name string(a string)
	if is-js-identifier a then a else "[\"{a}\"]"

-is-js-identifier bool(a string)
	!is-js-keyword a and
	!is-digit (a.to::char8[])[0] and
	every a.to::char8[], it.is-ascii-identifier-char
-is-js-keyword bool(a string)
	match a
	as arguments
		true
	as await
		true
	as "case"
		true
	as const
		true
	as debugger
		true
	as default
		true
	as delete
		true
	as "enum"
		true
	as extends
		true
	as false
		true
	as function
		true
	as "in"
		true
	as instanceof
		true
	as let
		true
	as new
		true
	as null
		true
	as public
		true
	as return
		true
	as static
		true
	as switch
		true
	as this
		true
	as true
		true
	as typeof
		true
	as var
		true
	as void
		true
	else
		false

-write-class void(out output, a js-class-decl)
	write-comment out, a.comment
	out ~~= "class {a.name}"
	if x = a.extends
		out ~~= " extends {x}"
	out ~~= " \{"
	for member in a.members
		mark-map out, member.source
		out ~~= "\n\t"
		write-class-member out, member
	out ~= "\n"
	out ~= "\}"

-write-comment void(out output, comment string)
	unless is-empty comment
		out ~~= "// {comment}\n"

-write-class-member void(out output, member js-class-member)
	match x = member.kind
	as js-class-method
		out ~~= "{maybe-async x.async}{member-name member.name}"
		write-params out, x.params, true
		out ~= " "
		write-block-statement out, 1, x.body
	as js-expr
		out ~~= "{member-name member.name} = "
		write-expr out, 1, x
	as js-class-getter
		out ~~= "get {member-name member.name}() "
		write-block-statement out, 1, x.body

-write-params void(out output, a js-destructure[], always-parens bool)
	parens bool = always-parens or a.size != 1 or !a.only!.js-name
	if parens
		out ~= "("
	write-with-commas out, a, {write-destructure out, it}
	if parens
		out ~= ")"

-write-destructure void(out output, a js-destructure)
	match a
	as js-name
		out ~~= "{a}"
	as js-object-destructure
		out ~~= "\{ "
		write-with-commas out, a.fields, of name, destructure
			out ~~= "{member-name name}: "
			write-destructure out, destructure
		out ~~= " \}"

-write-block-statement void(out output, indent nat, a js-block-statement)
	out ~= "\{"
	for index, x in with-index a.statements
		out ~~= newline indent + 1
		write-statement out, indent + 1, x, if index == 0 then first else non-first
	out ~~= newline indent
	out ~= "\}"

-write-expr-or-block-statement-indented void(out output, indent nat, a js-expr-or-block-statement)
	match a
	as js-expr
		out ~~= newline indent + 1
		write-expr out, indent + 1, a
	as js-block-statement
		out ~= " "
		write-block-statement out, indent, a

-statement-pos enum(first, non-first)
-write-statement void(out output, indent nat, a js-statement, pos statement-pos)
	mark-map out, a.source
	match x = a.kind
	as js-assign-statement
		write-assign out, indent, x
	as js-block-statement
		write-block-statement out, indent, x
	as js-break-statement
		out ~~= "break "
		if l = x.label
			out ~~= " {l}"
	as js-continue-statement
		out ~~= "continue"
	as js-expr
		write-expr out, indent, x, match pos
		as first
			statement-first
		as non-first
			statement-non-first
	as js-if-statement
		write-if out, indent, x
	as js-for-of-statement
		out ~~= "for (const {x.local} of "
		write-expr out, indent + 2, x.collection
		out ~~= ") "
		write-block-statement out, indent, x.body
	as js-return-statement
		out ~~= "return "
		write-expr out, indent, x.arg
	as js-switch-statement
		write-switch out, indent, x
	as js-throw-statement
		out ~~= "throw "
		write-expr out, indent, x.arg
	as js-try-catch-statement
		write-try-catch out, indent, x
	as js-try-finally-statement
		write-try-finally out, indent, x
	as js-var-decl
		write-var-decl out, indent, x
	as js-while-statement
		write-while out, indent, x

-write-assign void(out output, indent nat, a js-assign-statement)
	write-expr out, indent, a.left
	out ~~= " = "
	write-expr out, indent, a.right
-write-if void(out output, indent nat, a js-if-statement)
	out ~~= "if ("
	write-expr out, indent + 2, a.cond
	out ~~= ") "
	write-block-statement out, indent, a.then_
	if else_ = a.else_
		out ~~= " else"
		if js-if-statement else_.kind
			out ~= " "
			write-statement out, indent, else_, first
		else
			_ = write-statement-indented out, indent, else_, first
-write-switch void(out output, indent nat, a js-switch-statement)
	out ~~= "switch ("
	write-expr out, indent + 2, a.arg
	out ~~= ") \{"
	for case_ in a.cases
		out ~~= newline indent + 1
		out ~~= "case "
		write-expr out, indent, case_.value
		out ~= ":"
		write-block-statement out, indent + 1, case_.then_
	out ~~= "{newline indent + 1}default:"
	write-block-statement out, indent + 1, a.default
	out ~~= "{newline indent}\}"
-write-try-catch void(out output, indent nat, a js-try-catch-statement)
	out ~~= "try "
	write-block-statement out, indent, a.tried
	out ~~= " catch ({a.exception}) "
	write-block-statement out, indent, a.catch_
-write-try-finally void(out output, indent nat, a js-try-finally-statement)
	out ~~= "try "
	write-block-statement out, indent, a.tried
	out ~~= " finally "
	write-block-statement out, indent, a.finally_
-write-var-decl void(out output, indent nat, a js-var-decl)
	out ~~= "{a.const} "
	for index, var in with-index a.vars
		unless index == 0
			out ~~= ", "
		write-destructure out, var.destructure
		if initializer = var.initializer
			out ~~= " = "
			write-expr out, indent, initializer
-write-while void(out output, indent nat, a js-while-statement)
	if label = a.label
		out ~~= "{label}: "
	out ~~= "while ("
	write-expr out, indent + 2, a.condition
	out ~= ")"
	write-block-statement out, indent, a.body

# Returns true if it was a block
-write-statement-indented bool(out output, indent nat, a js-statement, pos statement-pos)
	match x = a.kind
	as js-block-statement
		out ~= " "
		write-block-statement out, indent, x
		true
	else
		out ~~= newline indent + 1
		write-statement out, indent + 1, a, pos
		false

-expr-pos record
	| Expression is at the start of a statement and may need ';'
	is-non-first-statement bool
	| Expression is called and may need to be wrapped in '()'
	is-called bool
-with-called expr-pos(a expr-pos)
	a.is-non-first-statement, true
-expr expr-pos()
	false, false
-statement-first expr-pos()
	false, false
-statement-non-first expr-pos()
	true, false
-write-expr void(out output, indent nat, a js-expr)
	write-expr out, indent, a, expr
-write-expr void(out output, indent nat, a js-expr, pos expr-pos)
	mark-map out, a.source
	write-arg = of arg js-expr
		write-expr out, indent, arg, expr
	write-arg-with-pos = of arg js-expr, arg-pos expr-pos
		write-expr out, indent, arg, arg-pos
	write-args = of args js-expr[]
		write-with-commas out, args, {write-expr out, indent + 1, it}
	match x = a.kind
	as js-array-expr
		out ~= "["
		write-args[x.elements]
		out ~= "]"
	as js-arrow-function
		write-arrow-function out, indent, pos, x
	as js-assign-expr
		out ~~= "({x.assignee} = "
		write-arg[x.value]
		out ~= ")"
	as js-binary-expr
		if is-non-first-statement pos
			out ~= ";"
		out ~= "("
		write-arg[x.left]
		out ~= " "
		out ~~= "{operator x.kind}"
		out ~= " "
		write-arg[x.right]
		out ~= ")"
	as js-call-expr
		write-arg-with-pos[x.called, pos.with-called]
		out ~= "("
		write-args[x.args]
		out ~= ")"
	as js-call-with-spread-expr
		write-arg-with-pos[x.called, pos.with-called]
		out ~= "("
		write-args[x.args]
		unless is-empty x.args
			out ~~= ", "
		out ~~= "..."
		write-arg[x.spread-arg]
		out ~= ")"
	as js-literal-bigint
		out ~~= if x.is-signed
			"{x.value.to::int}"
		else
			"{x.value.to::nat}"
		out ~= "n"
	as js-literal-bool
		out ~~= "{x.value}"
	as js-literal-number
		out ~~= float-literal-for-js x.value, x.type
	as js-literal-string
		out ~~= quoted x.value
	as js-name
		out ~~= "{x}"
	as js-new-expr
		out ~~= "new ("
		write-arg[x.class_]
		out ~~= ")("
		write-args[x.arguments]
		out ~= ")"
	as js-null-expr
		out ~~= "null"
	as js-optional-property-access-expr
		write-arg-with-pos[x.object, pos]
		out ~= "?"
		out ~~= property-access x.property-name
	as js-property-access-expr
		write-arg-with-pos[x.object, pos]
		out ~~= property-access x.property-name
	as js-property-access-computed-expr
		write-arg-with-pos[x.object, pos]
		out ~= "["
		write-arg[x.property-name]
		out ~= "]"
	as js-ternary-expr
		if is-non-first-statement pos
			out ~= ";"
		out ~= "("
		write-arg[x.condition]
		out ~~= " ? "
		write-arg[x.then_]
		out ~~= " : "
		write-arg[x.else_]
		out ~= ")"
	as js-this-expr
		out ~~= "this"
	as js-unary-expr
		if is-non-first-statement pos
			out ~= ";"
		out ~= "("
		out ~~= operator x.kind
		write-arg[x.arg]
		out ~= ")"

-write-arrow-function void(out output, indent nat, pos expr-pos, a js-arrow-function)
	if is-non-first-statement pos
		out ~= ";"
	if is-called pos
		out ~= "("
	out ~~= maybe-async a.async
	write-params out, a.params, false
	out ~~= " =>"
	write-expr-or-block-statement-indented out, indent, a.body
	if is-called pos
		out ~= ")"

-operator string(a js-binary-kind)
	match a
	as bit-shift-left
		"<<"
	as bit-shift-right
		">>"
	as bit-shift-right-unsigned
		">>>"
	as bitwise-and
		"&"
	as bitwise-or
		"|"
	as bitwise-xor
		"^"
	as comma
		","
	as divide
		"/"
	as eq-eq-eq
		"==="
	as greater
		">"
	as instanceof
		"instanceof"
	as less
		"<"
	as minus
		"-"
	as modulo
		"%"
	as or_
		"||"
	as plus
		"+"
	as times
		"*"
-operator string(a js-unary-kind)
	match a
	as await
		"await "
	as bitwise-not
		"~"
	as not
		"!"
	as typeof
		"typeof "
	as void
		"void "

-maybe-async string(a sync-or-async)
	match a
	as sync
		""
	as async
		"async "

-float-literal-for-js string(a float, type float-type)
	if a == trusted nan
		"Number.NaN"
	elif a == infinity
		"Number.POSITIVE_INFINITY"
	elif a == -infinity
		"-Number.POSITIVE_INFINITY"
	else
		res = "{a}"
		match type
		as float32
			"Math.fround({res})"
		as float64
			res
