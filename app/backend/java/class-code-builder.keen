import
	keen/bits
	./class-builder
	../../util/java-bytecode-types

build-code record mut
	constants constants-builder
with-block Code_attribute(a build-code, f void mut(a code-builder))
	builder code-builder = (), a.constants, (), (), (), ()
	f[builder]
	code = finish builder.out
	attribute-name-index: a.constants["Code"]
	max-stack: 99
	max-locals: 99
	code: code
	exception-table: builder.exception-table.move-to
	attributes:
		-- unless is-empty builder.line-number-table
			- LineNumberTable_attribute a.constants["LineNumberTable"], builder.line-number-table.move-to
		-- unless is-empty builder.stack-map
			- StackMapTable_attribute a.constants["StackMapTable"], builder.stack-map.move-to
code-builder record mut
	-out bytecode-out
	constants constants-builder
	-exception-table exception-table-entry mut[]
	-next-stack-frame-relative-to mut nat16
	-stack-map stack_map_frame mut[]
	-line-number-table line-number-table-entry mut[]

stack-frame record
	locals verification_type_info[]
	stack verification_type_info[]

deferred-jump record mut
	-jump-from nat16
	# This is a byte index, but the jump offset is a nat16
	-location-of-offset nat16
| Call this when 'out' is at the postion where it should jump to
jumps-to-here void(a deferred-jump, out code-builder, stack-frame stack-frame)
	cur = out.next-index
	offset nat16 = cur - a.jump-from
	out.out.out[a.location-of-offset] := offset >> 8 'to
	out.out.out[a.location-of-offset + 1] := offset & 0xff 'to
	write-stack-frame out, stack-frame

deferred-jump32 record mut
	-jump-from nat32
	-location-of-offset nat32
jumps-to-here void(a deferred-jump32, out code-builder, stack-frame stack-frame)
	cur = out.next-index
	offset = cur::nat32 - a.jump-from
	out.out.out[a.location-of-offset] := offset >> 24 'to
	out.out.out[a.location-of-offset + 1] := (offset >> 16) & 0xff 'to
	out.out.out[a.location-of-offset + 2] := (offset >> 8) & 0xff 'to
	out.out.out[a.location-of-offset + 3] := offset & 0xff 'to
	write-stack-frame out, stack-frame

mark-line-number void(a code-builder, line-number nat16)
	unless a.line-number-table.last.?line-number == line-number
		a.line-number-table ~= a.next-index, line-number

add-to-exception-table void(a code-builder, start nat16, end nat16, catch-type class-reference, frame stack-frame)
	a.exception-table ~= start, end, a.next-index, catch-type
	write-stack-frame a, frame
-write-stack-frame void(a code-builder, frame stack-frame)
	should-emit = if a.next-index + 1 == a.next-stack-frame-relative-to
		last = full_frame! last! a.stack-map
		unless frame.locals == last.locals and frame.stack == last.stack
			# Noop so the new stack frame can apply to a different position
			a.out ~= 0x00
			true
	else
		true
	if should-emit
		# TODO:PERF for efficiency, use the simpler frames where possible and not always full_frame
		a.stack-map ~=
			offset-delta: a.next-index - a.next-stack-frame-relative-to
			locals: frame.locals
			stack: frame.stack
		a.next-stack-frame-relative-to := a.next-index + 1

next-index nat16(a code-builder)
	a.out.next-index.to
dup32 void(a code-builder)
	a.out ~= 0x59
dup_x1 void(a code-builder)
	a.out ~= 0x5a
dup64 void(a code-builder)
	a.out ~= 0x5c
swap void(a code-builder)
	a.out ~= 0x5f
xload void(a code-builder, type java-runtime-type, index nat)
	match type
	as void
		()
	as java-primitive-type
		match type
		as T_BOOLEAN
			iload a, index
		as T_CHAR
			iload a, index
		as T_FLOAT
			fload a, index
		as T_DOUBLE
			dload a, index
		as T_BYTE
			iload a, index
		as T_SHORT
			iload a, index
		as T_INT
			iload a, index
		as T_LONG
			lload a, index
	else
		aload a, index
aload void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x2a + index.to # aload_0, aload_1, aload_2, or aload_3
	else
		a.out ~= 0x19 # aload
		a.out ~= index.to
-dload void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x26 + index.to # dload_0, dload_1, dload_2, or dload_3
	else
		a.out ~= 0x18 # dload
		a.out ~= index.to
-fload void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x22 + index.to # fload_0, fload_1, fload_2, or fload_3
	else
		a.out ~= 0x17 # fload
		a.out ~= index.to
iload void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x1a + index.to # iload_0, iload_1, iload_2, or iload_3
	else
		a.out ~= 0x15 # iload
		a.out ~= index.to
-lload void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x1e + index.to # lload_0, lload_1, lload_2, or lload_3
	else
		a.out ~= 0x16 # lload
		a.out ~= index.to
aconst_null void(a code-builder)
	a.out ~= 0x1
dconst void(a code-builder, value float64)
	if value == 0
		a.out ~= 0xe
	elif value == 1
		a.out ~= 0xf
	else
		ldc a, T_DOUBLE, float64 a.constants, value
fconst void(a code-builder, value float32)
	if value == 0
		a.out ~= 0xb # fconst_0
	elif value == 1
		a.out ~= 0xc
	elif value == 2
		a.out ~= 0xd
	else
		ldc a, T_FLOAT, float32 a.constants, value
iconst void(a code-builder, value int32)
	if value == -1
		a.out ~= 0x2
	elif 0::int32 <= value and value <= 5
		a.out ~= 0x3 + value.to
	elif min-value::int8::int32 <= value and value <= max-value::int8
		a.out ~= 0x10 # bipush
		a.out ~= value.to::int8.wrap-to
	else
		ldc a, T_INT, int32 a.constants, value
lconst void(a code-builder, value int64)
	if value == 0
		a.out ~= 0x9
	elif value == 1
		a.out ~= 0xa
	else
		ldc a, T_LONG, int64 a.constants, value
| 'reference' is a constant index, not the value itself
ldc void(a code-builder, class_ class-reference)
	ldc a, reference-type, class_.index
ldc void(a code-builder, ref string-reference)
	ldc a, reference-type, ref.index
-ldc void(a code-builder, type java-runtime-type, reference nat16)
	match stack-entry-count type
	as 1
		if reference <= 0xff
			a.out ~= 0x12 # ldc
			a.out ~= reference.to
		else
			a.out ~= 0x13 # ldc_w
			a.out ~~= reference
	as 2
		a.out ~= 0x14 # ldc2_w
		a.out ~~= reference
	else
		throw unreachable
idiv void(a code-builder)
	a.out ~= 0x6c
return void(a code-builder, type java-runtime-type)
	match type
	as void
		a.out ~= 0xb1 # return
	as java-primitive-type
		match type
		as T_BOOLEAN
			a.out ~= 0xac # ireturn
		as T_CHAR
			a.out ~= 0xac # ireturn
		as T_FLOAT
			a.out ~= 0xae # freturn
		as T_DOUBLE
			a.out ~= 0xaf # dreturn
		as T_BYTE
			a.out ~= 0xac # ireturn
		as T_SHORT
			a.out ~= 0xac # ireturn
		as T_INT
			a.out ~= 0xac # ireturn
		as T_LONG
			a.out ~= 0xad # lreturn
	else
		a.out ~= 0xb0 # areturn
arraylength void(a code-builder)
	a.out ~= 0xbe
makenew void(a code-builder, class_ class-reference)
	a.out ~= 0xbb
	a.out ~~= class_
getfield void(a code-builder, field field-reference)
	a.out ~= 0xb4
	a.out ~~= field
pop void(a code-builder, type java-runtime-type)
	match stack-entry-count type
	as 0
		()
	as 1
		a.out ~= 0x57 # pop
	as 2
		a.out ~= 0x58 # pop2
	else
		throw unreachable
putfield void(a code-builder, field field-reference)
	a.out ~= 0xb5
	a.out ~~= field
getstatic void(a code-builder, field field-reference)
	a.out ~= 0xb2
	a.out ~~= field
putstatic void(a code-builder, field field-reference)
	a.out ~= 0xb3
	a.out ~~= field
invokespecial void(a code-builder, ref method-reference)
	a.out ~= 0xb7
	a.out ~~= ref
invokestatic void(a code-builder, ref method-reference)
	a.out ~= 0xb8
	a.out ~~= ref
invokeinterface void(a code-builder, ref method-reference, count nat8)
	a.out ~= 0xb9
	a.out ~~= ref
	a.out ~= count
	a.out ~= 0
invokevirtual void(a code-builder, ref method-reference)
	a.out ~= 0xb6
	a.out ~~= ref
instanceof void(a code-builder, class_ class-reference)
	a.out ~= 0xc1
	a.out ~~= class_
ifeq deferred-jump(a code-builder)
	jump-from = a.out.next-index
	a.out ~= 0x99 # ifeq
	location-of-offset = a.out.next-index
	a.out ~~= 0xffff::nat16
	jump-from.to, location-of-offset.to
ifne void(a code-builder, target jump-target)
	jump-from = a.out.next-index
	a.out ~= 0x9a # ifne
	offset = jump-from.to::nat16 - target.offset
	a.out ~~= -offset
if_icmpne void(a code-builder, target jump-target)
	jump-from = a.out.next-index
	a.out ~= 0xa0 # if_icmpne
	offset = jump-from.to::nat16 - target.offset
	a.out ~~= -offset
ifnonnull deferred-jump(a code-builder)
	jump-from = a.out.next-index
	a.out ~= 0xc7 # ifnonnull
	location-of-offset = a.out.next-index
	a.out ~~= 0xffff::nat16
	jump-from.to, location-of-offset.to
nop void(a code-builder)
	a.out ~= 0

checkcast void(a code-builder, class_ class-reference)
	a.out ~= 0xc0
	a.out ~~= class_
newarray void(a code-builder, type java-primitive-type)
	a.out ~= 0xbc
	a.out ~= type.to

java-runtime-type union(void, java-primitive-type, reference-type)
stack-entry-count nat(a java-runtime-type)
	match a
	as void
		0
	as java-primitive-type
		if a == T_DOUBLE or a == T_LONG then 2 else 1
	as reference-type
		1
void java-runtime-type()
	()::void
reference-type record

anewarray void(a code-builder, class_ class-reference)
	a.out ~= 0xbd
	a.out ~~= class_
xaload void(a code-builder, type java-runtime-type)
	match type
	as void
		()
	as java-primitive-type
		a.out ~= match type
		as T_BOOLEAN then 0x33 # baload
		as T_CHAR then 0x34 # caload
		as T_FLOAT then 0x30 # faload
		as T_DOUBLE then 0x31 # daload
		as T_BYTE then 0x33 # baload
		as T_SHORT then 0x35 # saload
		as T_INT then 0x2e # iaload
		as T_LONG then 0x2f # laload
	as reference-type
		a.out ~= 0x32 # aaload
astore void(a code-builder, type java-runtime-type)
	match type
	as void
		()
	as java-primitive-type
		a.out ~= match type
		as T_BOOLEAN then 0x54 # bastore
		as T_CHAR then 0x55 # castore
		as T_FLOAT then 0x51 # fastore
		as T_DOUBLE then 0x52 # dastore
		as T_BYTE then 0x54 # bastore
		as T_SHORT then 0x56 # sastore
		as T_INT then 0x4f # iastore
		as T_LONG then 0x50 # lastore
	else
		a.out ~= 0x53 # aastore
iadd void(a code-builder)
	a.out ~= 0x60
ladd void(a code-builder)
	a.out ~= 0x61
ishl void(a code-builder)
	a.out ~= 0x78
lshl void(a code-builder)
	a.out ~= 0x79
iushr void(a code-builder)
	a.out ~= 0x7c
lushr void(a code-builder)
	a.out ~= 0x7d
iand void(a code-builder)
	a.out ~= 0x7e
ior void(a code-builder)
	a.out ~= 0x80
ixor void(a code-builder)
	a.out ~= 0x82
land void(a code-builder)
	a.out ~= 0x7f
lor void(a code-builder)
	a.out ~= 0x81
i2b void(a code-builder)
	a.out ~= 0x91
i2s void(a code-builder)
	a.out ~= 0x93
lxor void(a code-builder)
	a.out ~= 0x83
d2f void(a code-builder)
	a.out ~= 0x90
f2d void(a code-builder)
	a.out ~= 0x8d
l2d void(a code-builder)
	a.out ~= 0x8a
i2l void(a code-builder)
	a.out ~= 0x85
d2l void(a code-builder)
	a.out ~= 0x8f
l2i void(a code-builder)
	a.out ~= 0x88

fadd void(a code-builder)
	a.out ~= 0x62
dadd void(a code-builder)
	a.out ~= 0x63
fsub void(a code-builder)
	a.out ~= 0x66
dsub void(a code-builder)
	a.out ~= 0x67
fdiv void(a code-builder)
	a.out ~= 0x6e
ddiv void(a code-builder)
	a.out ~= 0x6f
drem void(a code-builder)
	a.out ~= 0x73
fmul void(a code-builder)
	a.out ~= 0x6a
dmul void(a code-builder)
	a.out ~= 0x6b
imul void(a code-builder)
	a.out ~= 0x68
lmul void(a code-builder)
	a.out ~= 0x69
ldiv void(a code-builder)
	a.out ~= 0x6d
isub void(a code-builder)
	a.out ~= 0x64
lsub void(a code-builder)
	a.out ~= 0x65
lcmp void(a code-builder)
	a.out ~= 0x94

jump-target record
	offset nat16
can-jump-back-to-here jump-target(a code-builder, stack-frame stack-frame)
	write-stack-frame a, stack-frame
	a.next-index,
go-back-to void(a code-builder, where jump-target)
	assert where.offset < a.next-index
	offset = where.offset.to::int16 - a.next-index.to
	a.out ~= 0xa7 # goto
	a.out ~~= offset
goto deferred-jump(a code-builder)
	jump-from = a.next-index
	a.out ~= 0xa7 # goto
	location-of-offset = a.next-index
	a.out ~~= 0xffff::nat16
	jump-from: jump-from
	location-of-offset: location-of-offset

xstore void(a code-builder, type java-runtime-type, index nat)
	match type
	as void
		()
	as java-primitive-type
		match type
		as T_BOOLEAN
			istore a, index
		as T_CHAR
			istore a, index
		as T_FLOAT
			fstore a, index
		as T_DOUBLE
			dstore a, index
		as T_BYTE
			istore a, index
		as T_SHORT
			istore a, index
		as T_INT
			istore a, index
		as T_LONG
			lstore a, index
	else
		astore a, index
astore void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x4b + index.to # astore_0, astore_1, astore_2, or astore_3
	else
		a.out ~= 0x3a # astore
		a.out ~= index.to
-dstore void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x47 + index.to # dstore_0, dstore_1, dstore_2, or dstore_3
	else
		a.out ~= 0x39
		a.out ~= index.to
-fstore void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x43 + index.to # fstore_0, fstore_1, fstore_2, or fstore_3
	else
		a.out ~= 0x38 # fstore
		a.out ~= index.to
istore void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x3b + index.to # istore_0, istore_1, istore_2, or istore_3
	else
		a.out ~= 0x36 # istore
		a.out ~= index.to
-lstore void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x3f + index.to # lstore_0, lstore_1, lstore_2, or lstore_3
	else
		a.out ~= 0x37 # lstore
		a.out ~= index.to

lookupswitch (deferred-jump32[], deferred-jump32)(a code-builder, values int32[])
	assert is-sorted values
	jump-from nat32 = a.out.next-index.to
	a.out ~= 0xab # lookupswitch
	pad-to-align a, 4
	location-of-default nat32 = a.out.next-index.to
	a.out ~~= 0xffffffff::nat32
	a.out ~~= values.size.to::nat32
	jumps deferred-jump32[] = for value in values
		a.out ~~= value.wrap-to::nat32
		location-of-offset nat32 = a.out.next-index.to
		a.out ~~= 0xffffffff::nat32
		jump-from, location-of-offset
	jumps, (jump-from, location-of-default)

tableswitch (deferred-jump32[], deferred-jump32)(a code-builder, range nat32 range)
	forbid is-empty range
	jump-from nat32 = a.out.next-index.to
	a.out ~= 0xaa # tableswitch
	pad-to-align a, 4
	location-of-default nat32 = a.out.next-index.to
	a.out ~~= 0xffffffff::nat32
	a.out ~~= range.low
	a.out ~~= range.high - 1
	jumps deferred-jump32[] = for _ in range
		location-of-offset nat32 = a.out.next-index.to
		a.out ~~= 0xffffffff::nat32
		jump-from, location-of-offset
	jumps, (jump-from, location-of-default)

-pad-to-align void(a code-builder, align nat)
	until a.out.next-index % align == 0 then a.out ~= 0

athrow void(a code-builder)
	a.out ~= 0xbf
