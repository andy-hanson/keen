import
	../../frontend/show-model
	../../model/low-model
	../../model/model
	../util

union-representation enum
	| Reserved for exceptions (java/lang/Throwable)
	exception
	interface_
	| Use a 'new Union(i, x)' where 'i' is the index of the case type
	switch
	| The union has 2 case types, and the first is empty. Use 'null' for the first case.
	nullable

union-info record
	show-ctx show-ctx
	union-to-representation union-representation[low-type]
	type-to-interfaces low-type[][low-type]
	exception-case-types low-type set
plan-unions union-info(program low-program) show-ctx
	union-to-representation union-representation mut[low-type] = ()
	type-to-interfaces low-type mut[] mut[low-type] = ()
	for s in program.all-types-including-extern
		body = s.body
		do if body.low-union
		do if as-extern s or
			r = choose-union-representation program, s, body
			union-to-representation[s] := r
			r == interface_
		for member in body.members
			(ensure type-to-interfaces, member) ~= s
	show-ctx: the::show-ctx
	union-to-representation: union-to-representation.move-to
	type-to-interfaces: for k, v in type-to-interfaces
		k, v.move-to
	exception-case-types: program.exception.body.low-union!.members.to

union-representation union-representation(a union-info, type low-type)
	a.union-to-representation[type] else
		assert as-extern type else todo
		interface_

java-method-kind java-method-kind(a union-info, fun low-fun)
	match body = body fun
	as low-fun-body-extern-java
		body.kind
	as low-fun-body-method
		match union-representation a, fun.params[0].type
		as exception
			static-method-of-class
		as interface_
			interface_
		as switch
			static-method-of-class
		as nullable
			static-method-of-class
	else
		static-method-of-class

-choose-union-representation union-representation(program low-program, type low-type, u low-union)
	if type == program.exception
		exception
	elif u.is-nullable-union
		nullable
	elif every u.members, it.can-implement-interface
		interface_
	else
		switch

-can-implement-interface bool(a low-type)
	match a.body
	# TODO: low-builtin-types could implement interfaces, we generate a class for them instead of using Java's
	as low-builtin-type then false
	as low-enum then true
	as low-flags then true
	as low-java-class then false
	as low-record then true
	# TODO: This could be allowed in some cases.
	# Just not out for 'union(u1, u2)' where u1 and u2 are unions that have some members in common.
	as low-union then false
	as low-type-body-deferred then throw unreachable
