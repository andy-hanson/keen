import
	foo/keen/KeenClassLoader
	java/io/ByteArrayOutputStream
	java/io/PrintStream
	java/nio/file/Path
	java/nio/file/Paths
	java/lang/Class
	java/lang/ClassLoader
	java/lang/String
	java/lang/StackTraceElement
	java/lang/Throwable
	java/lang/reflect/InvocationTargetException
	java/lang/reflect/Method
	java/lang/System
	java/net/URI
	java/net/URL
	java/net/URLClassLoader
	java/nio/charset/StandardCharsets
	keen/java
	keen/unsafe
	../../model/uri
	../../util/exit-code
	../../util/java-bytecode-types

run-java void(jar-files file-path[], classes java-compiled-class[], main-args string[]) global, unsafe, java
	if error = run-java-common jar-files, classes, main-args
		omit-runtime-stack-trace error
		throw reinterpret-cast error

| Catches errors and redirects output to a returned string.
run-java-and-catch (string, exit-code)
	jar-files file-path[]
	classes java-compiled-class[]
do global, unsafe, java
	originalOut = out
	originalErr = err
	output ByteArrayOutputStream = ()
	newOut PrintStream = output, true, UTF_8
	setOut newOut
	setErr newOut
	exit exit-code = if err = run-java-common jar-files, classes, ()
		printStackTrace err
		error
	else
		ok
	setOut originalOut
	setErr originalErr
	output.toString.to, exit

-run-java-common Throwable?(jars file-path[], classes java-compiled-class[], main-args string[]) global, unsafe, java
	urls URL buffer = for jar-path in jars
		p Path = get jar-path.to::string.to::String, ()
		p.toUri.toURL
	loader = KeenClassLoader URLClassLoader urls, getSystemClassLoader
	for file in classes
		bytes int8 buffer = file.bytes.safe-reinterpret-cast.cast-mutable
		if x = try-remove-end file.path, ".class"
			addClassBytecode loader, x.to, bytes
		else
			addResource loader, file.path.to, bytes

	Main = loadClass loader, "keenrun_Main"
	main = getMethod Main, "main",
		- arrayType forName "java.lang.String"
	args String buffer = map main-args, it.to
	# First argument is ignored, so pass an arbitrary object
	try
		_ = invoke main, Main.reinterpret-cast,
			- reinterpret-cast args
		()
	catch e as InvocationTargetException
		getCause e

-to String(a string-view) java
	a.to::string.to

-omit-runtime-stack-trace void(a Throwable) global, unsafe, java
	original StackTraceElement[] = a.getStackTrace.to
	if i = find-index original, it.is-run-java
		setStackTrace a, original[0 .. i - 2].to
-is-run-java bool(a StackTraceElement) global, unsafe, java
	a.getMethodName.to::string == "run__45java__45common"
