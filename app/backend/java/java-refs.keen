import
	../../frontend/show-model
	../../model/low-model
	../../model/model
	../../model/uri
	../../util/java-bytecode-types
	./class-builder
	./class-code-builder
	./java-names
	./union-representation
	../util
	./util

java-names-and-refs spec show-ctx, java-names, java-refs
| Can generate a constant pool reference for a Keen entity.
| This should only be used within the same class file,
| since constant pool references are not the same in different files.
java-refs record mut
	-mangled-names java-names
	constants constants-builder
-mangled-names java-names() java-refs
	the::java-refs.mangled-names
constants constants-builder() java-refs
	the::java-refs.constants

start-new-class java-refs(mangled-names java-names)
	mangled-names, ()

build-code build-code(frame stack-frame) java-refs
	constants, frame

constant-name utf8-reference(constant any-allocated-constant) java-refs
	constants[mangled-names.constant-names[constant].member]

constant-symbols-class-name symbol() java-refs
	mangled-names.constant-symbols-class-name
constant-symbols-class class-reference() java-refs
	class_ constants, constant-symbols-class-name
constant-symbol-name utf8-reference(index nat) java-refs
	constants["s{index}"]

constant-symbol-field field-reference(symbol low-type, index nat) java-refs
	symbol-type = constants[descriptor-for-field-type mangled-names, symbol]
	name-and-type = name-and-type constants, index.constant-symbol-name, symbol-type
	field constants, constant-symbols-class, name-and-type

module-class class-reference(uri uri) java-refs
	class_ constants, module-class-name mangled-names, uri
module-class-name symbol(uri uri) java-refs
	module-class-name mangled-names, uri

lambda-impl-class-name symbol(containing-fun low-fun, lambda-index nat) java-refs
	lambda-impl-class-name mangled-names, containing-fun, lambda-index

# Static "instance" field on a singleton class
instance-field field-reference(type low-type) java-refs
	instance-field type.class_, boxed-class-name mangled-names, type
instance-field field-reference(class_ class-reference, class-name symbol) java-refs
	instance-field class_, instance-field-descriptor class-name
-instance-field field-reference(class_ class-reference, descriptor utf8-reference) java-refs
	field constants, class_, name-and-type constants, instance-field-name, descriptor
instance-field-name utf8-reference() java-refs
	constants["instance"]
instance-field-descriptor utf8-reference(class-name symbol) java-refs
	constants["L{class-name};"]

lambda-impl-field field-reference(lambda-class class-reference, closure-local low-local) java-refs
	name-and-type = name-and-type constants, closure-local.lambda-impl-field-name,
		descriptor-for-field-type closure-local.type
	field constants, lambda-class, name-and-type

lambda-impl-field-name utf8-reference(closure-field low-local) java-refs
	match source = closure-field.source
	as local
		constants[source.name]
	as low-generated-local-kind
		source is the_
		constants["the{closure-field.type.id}"]

switchable-kind-field field-reference(union-type low-type) java-names-and-refs
	union-representation union-info, union-type is switch
	switchable-kind-field class_ union-type
switchable-kind-field field-reference(sum-type class-reference) java-refs
	field constants, sum-type,
		name-and-type constants, switchable-kind-name, switchable-kind-descriptor
switchable-kind-name utf8-reference() java-refs
	constants["kind"]
switchable-kind-descriptor utf8-reference() java-refs
	constants["I"]
switchable-value-field field-reference(sum-type low-type) java-names-and-refs
	union-representation union-info, sum-type is switch
	switchable-value-field class_ sum-type
switchable-value-field field-reference(sum-type class-reference) java-refs
	field constants, sum-type, name-and-type constants, value-name, java-Object-descriptor

class_ class-reference(type low-type) java-refs
	class_ constants, boxed-class-name mangled-names, type
class-name symbol(type low-type) java-refs
	mangled-names[type]

keen-reference-equal method-reference() java-refs
	keen-method "referenceEqual", "(Ljava/lang/Object;Ljava/lang/Object;)Z"
keen-not-reference-equal method-reference() java-refs
	keen-method "notReferenceEqual", "(Ljava/lang/Object;Ljava/lang/Object;)Z"
keen-throw method-reference() java-refs
	keen-method "throw_", "(Ljava/lang/Throwable;)V"

valueOf utf8-reference() java-refs
	constants["valueOf"]
boxed-class-valueOf-descriptor utf8-reference(type low-type) java-refs
	param = descriptor-for-param-type mangled-names, type
	return = boxed-class-name mangled-names, type
	constants["({param})L{return};"]
boxed-class-valueOf method-reference(type low-type) java-refs
	virtual-method-ref constants, type.class_, constants["valueOf"],
		boxed-class-valueOf-descriptor type
primitive-unboxer method-reference(type low-type, p java-primitive-type) java-refs
	virtual-method-ref constants, type.class_, p.primitive-getter-name,
		primitive-getter-descriptor p
primitive-getter-name utf8-reference(type java-primitive-type) java-refs
	name symbol = match type
	as T_BOOLEAN
		"booleanValue"
	as T_CHAR
		"charValue"
	as T_FLOAT
		"floatValue"
	as T_DOUBLE
		"doubleValue"
	as T_BYTE
		"byteValue"
	as T_SHORT
		"shortValue"
	as T_INT
		"intValue"
	as T_LONG
		"longValue"
	constants[name]
primitive-getter-descriptor utf8-reference(type java-primitive-type) java-refs
	constants["(){type.primitive-descriptor::symbol}"]

interface-method-ref method-reference(fun low-fun) java-names-and-refs
	java-method-kind union-info, fun is interface_
	class_ = class_ fun.params[0].type
	interface-method-ref constants, class_, name-and-type constants, fun.instance-method-name,
		instance-method-descriptor fun

virtual-method-ref method-reference(fun low-fun) java-names-and-refs
	java-method-kind union-info, fun is virtual
	class_ = class_ fun.params[0].type
	virtual-method-ref constants, class_, name-and-type constants, fun.instance-method-name,
		instance-method-descriptor fun

instance-method-name utf8-reference(fun low-fun) java-refs
	constants[instance-method-name mangled-names, fun]

fun-name utf8-reference(fun low-fun) java-refs
	constants[mangled-names[fun].member]
static-method-of-class-ref method-reference(fun low-fun) java-names-and-refs
	class_, name-and-type = static-method-ref-common fun, static-method-of-class
	virtual-method-ref constants, class_, name-and-type
static-method-of-interface-ref method-reference(fun low-fun) java-names-and-refs
	class_, name-and-type = static-method-ref-common fun, static-method-of-interface
	interface-method-ref constants, class_, name-and-type
-static-method-ref-common (class-reference, name-and-type-reference)
	fun low-fun
	expected-kind java-method-kind
do java-names-and-refs
	java-method-kind union-info, fun is expected-kind
	m = mangled-names[fun]
	class_ = class_ constants,  m.class_
	name-and-type = name-and-type constants, constants[m.member], static-method-descriptor fun
	class_, name-and-type

static-method-descriptor utf8-reference(fun low-fun) java-refs
	constants[static-method-descriptor mangled-names, fun]

constructor-method-ref method-reference(fun low-fun) java-names-and-refs
	java-method-kind union-info, fun is constructor
	m = mangled-names[fun]
	virtual-method-ref constants, (class_ constants, m.class_), init, constructor-descriptor fun

instance-method-descriptor utf8-reference(fun low-fun) java-names-and-refs
	assert is-instance java-method-kind union-info, fun
	constants[instance-method-descriptor mangled-names, fun]

constructor-descriptor utf8-reference(fun low-fun) java-names-and-refs
	java-method-kind union-info, fun is constructor
	constants[constructor-descriptor mangled-names, fun]

boxed-class-init method-reference(type low-type) java-refs
	virtual-method-ref constants, type.class_, init, boxed-class-init-descriptor type
boxed-class-init-descriptor utf8-reference(type low-type) java-refs
	constants["({descriptor-for-param-type mangled-names, type})V"]
boxed-class-value field-reference(type low-type) java-refs
	field constants, type.class_, name-and-type constants, constants["value"], descriptor-for-field-type type

record-init-descriptor utf8-reference(fields low-field[]) java-refs
	constants[record-init-descriptor mangled-names, fields]
-record-init-descriptor symbol(a java-names, fields low-field[])
	descriptor-for-signature a, (), map fields, it.type

record-init-reference method-reference(record_ low-type) java-refs
	descriptor = record-init-descriptor record_.body.low-record!.fields
	name-and-type = name-and-type constants, constants["<init>"], descriptor
	virtual-method-ref constants, record_.class_, name-and-type

record-field field-reference(record_ low-type, field low-field) java-refs
	field (mangled-names[record_], field.name), field.type
record-field-name utf8-reference(field low-field) java-refs
	constants[field.name]
record-field-descriptor utf8-reference(field low-field) java-refs
	descriptor-for-field-type field.type

lambda-init-reference method-reference(class_ class-reference, lambda lambda-low-expr) java-refs
	virtual-method-ref constants, class_, constants["<init>"], lambda-init-descriptor lambda
lambda-init-descriptor utf8-reference(lambda lambda-low-expr) java-refs
	constants[lambda-init-descriptor mangled-names, lambda]

lambda-call method-reference(lambda-type low-type) java-refs
	lambda-class = class_ lambda-type
	virtual-method-ref constants, lambda-class, run, lambda-call-descriptor lambda-type
lambda-call-descriptor utf8-reference(lambda-type low-type) java-refs
	constants[lambda-call-descriptor mangled-names, lambda-type]

descriptor-for-field-type utf8-reference(type low-type) java-refs
	constants[descriptor-for-field-type mangled-names, type]

primitive-descriptor utf8-reference(type java-primitive-type) java-refs
	constants[primitive-descriptor type]

-keen-method method-reference((name symbol, descriptor symbol)) java-refs
	keen-method name, descriptor
-keen-method method-reference(name symbol, descriptor symbol) java-refs
	# This deliberartely does not use the 'class-prefix',
	# meaning that 'keen run foo.jeen' uses the same Keen.java that 'keen' was built with
	virtual-method-ref constants, "foo/keen/Keen", name, descriptor

keen-equal-float method-reference(type float-type) java-refs
	keen-method match type
	as float32
		"equalFloat32", "(FF)Z"
	as float64
		"equalFloat64", "(DD)Z"
keen-not-equal-float method-reference(type float-type) java-refs
	keen-method match type
	as float32
		"notEqualFloat32", "(FF)Z"
	as float64
		"notEqualFloat64", "(DD)Z"
keen-equal-float-ieee method-reference(type float-type) java-refs
	keen-method match type
	as float32
		"equalFloat32IEEE", "(FF)Z"
	as float64
		"equalFloat64IEEE", "(DD)Z"
keen-equal-integral method-reference(type integral-type) java-refs
	keen-method match unsigned type
	as nat8
		"equalInt8", "(BB)Z"
	as nat16
		"equalInt16", "(SS)Z"
	as nat32
		"equalInt32", "(II)Z"
	as nat64
		"equalInt64", "(JJ)Z"
keen-not-equal-integral method-reference(type integral-type) java-refs
	keen-method match unsigned type
	as nat8
		"notEqualInt8", "(BB)Z"
	as nat16
		"notEqualInt16", "(SS)Z"
	as nat32
		"notEqualInt32", "(II)Z"
	as nat64
		"notEqualInt64", "(JJ)Z"
keen-is-null method-reference() java-refs
	keen-method "isNull", "(Ljava/lang/Object;)Z"
keen-is-not-null method-reference() java-refs
	keen-method "isNotNull", "(Ljava/lang/Object;)Z"
keen-compare-float method-reference(type float-type) java-refs
	keen-method match type
	as float32
		"compareFloat32", "(FF)B"
	as float64
		"compareFloat64", "(DD)B"
