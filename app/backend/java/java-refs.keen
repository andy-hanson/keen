java-Error class-reference() java-refs
	class_ constants, "java/lang/Error"
java-Runnable class-reference() java-refs
	class_ constants, "java/lang/Runnable"

keen-fits-in-nat32 method-reference() java-refs
	keen-method "fitsInNat32", "(J)Z"
keen-fits-in-int32 method-reference() java-refs
	keen-method "fitsInInt32", "(J)Z"
keen-float64FromNat64 method-reference() java-refs
	keen-method "float64FromNat64", "(J)D"
keen-nat32-from-nat64 method-reference() java-refs
	keen-method "nat32FromNat64", "(J)I"
keen-string-array-from-java-string-array method-reference() java-refs
	keen-method "stringArrayFromJavaStringArray", "([Ljava/lang/String;)[[B"
keen-weakRefGet method-reference() java-refs
	keen-method "weakRefGet", "(Ljava/lang/ref/WeakReference;)Ljava/lang/Object;"
keen-newWeakRef method-reference() java-refs
	keen-method "newWeakRef", "(Ljava/lang/Object;)Ljava/lang/ref/WeakReference;"
java-divideUnsigned method-reference(type nat-type) java-refs
	match type
	as nat8
		keen-method "divideUnsigned", "(BB)B"
	as nat16
		keen-method "divideUnsigned", "(SS)S"
	as nat32
		virtual-method-ref constants, "java/lang/Integer", "divideUnsigned", "(II)I"
	as nat64
		virtual-method-ref constants, "java/lang/Long", "divideUnsigned", "(JJ)J"
java-remainderUnsigned method-reference(type nat-type) java-refs
	match type
	as nat8
		keen-method "remainderUnsigned", "(BB)B"
	as nat16
		keen-method "remainderUnsigned", "(SS)S"
	as nat32
		virtual-method-ref constants, "java/lang/Integer", "remainderUnsigned", "(II)I"
	else
		virtual-method-ref constants, "java/lang/Long", "remainderUnsigned", "(JJ)J"
java-Class-getResourceAsStream method-reference() java-refs
	virtual-method-ref constants, "java/lang/Class", "getResourceAsStream", "(Ljava/lang/String;)Ljava/io/InputStream;"
java-doubleToRawLongBits method-reference() java-refs
	virtual-method-ref constants, "java/lang/Double", "doubleToRawLongBits", "(D)J"
java-floatToRawIntBits method-reference() java-refs
	virtual-method-ref constants, "java/lang/Float", "floatToRawIntBits", "(F)I"
java-InputStream-readAllBytes method-reference() java-refs
	virtual-method-ref constants, "java/io/InputStream", "readAllBytes", "()[B"
java-intBitsToFloat method-reference() java-refs
	virtual-method-ref constants, "java/lang/Float", "intBitsToFloat", "(I)F"
java-longBitsToDouble method-reference() java-refs
	virtual-method-ref constants, "java/lang/Double", "longBitsToDouble", "(J)D"
java-Object class-reference() java-refs
	class_ constants, "java/lang/Object"
java-Object-descriptor utf8-reference() java-refs
	constants["Ljava/lang/Object;"]
java-String class-reference() java-refs
	class_ constants, "java/lang/String"
java-String-init-from-bytes method-reference() java-refs
	virtual-method-ref constants, "java/lang/String", "<init>", "([B)V"
java-String-getBytes method-reference() java-refs
	virtual-method-ref constants, "java/lang/String", "getBytes", "()[B"
java-Throwable class-reference() java-refs
	class_ constants, "java/lang/Throwable"
java-Object-toString method-reference() java-refs
	virtual-method-ref constants, java-Object, name-and-type constants, "toString", "()Ljava/lang/String;"
toString utf8-reference() java-refs
	constants["toString"]

SourceFile utf8-reference() java-refs
	constants["SourceFile"]

init-no-args method-reference(class_ class-reference) java-refs
	virtual-method-ref constants, class_, init, init-no-args-descriptor
init utf8-reference() java-refs
	constants["<init>"]
clinit utf8-reference() java-refs
	constants["<clinit>"]
run utf8-reference() java-refs
	constants["run"]
init-no-args-descriptor utf8-reference() java-refs
	constants["()V"]
init-union-switch method-reference(class_ class-reference) java-refs
	virtual-method-ref constants, class_, init, init-union-switch-descriptor
init-union-switch-descriptor utf8-reference() java-refs
	constants["(ILjava/lang/Object;)V"]

value-name utf8-reference() java-refs
	constants["value"]

constant-field field-reference(constant any-allocated-constant) java-refs
	field mangled-names.constant-names[constant], constant.type
constant-array-field field-reference(type low-type, value constant-array) java-refs
	field (array-name mangled-names.constant-names.names, type, value), type
constant-record-field field-reference(type low-type, value constant-record) java-refs
	field (record-name mangled-names.constant-names.names, type, value), type

var-field field-reference(var low-var) java-refs
	field mangled-names[var], var.type
var-name utf8-reference(var low-var) java-refs
	constants[mangled-names[var].member]

java-field field-reference(class_ path, field-name symbol, type low-type) java-refs
	field (class_.to, field-name), type

-field field-reference(name class-and-member, type low-type) java-refs
	typedesc = descriptor-for-field-type type
	name-and-type = name-and-type constants, constants[name.member], typedesc
	class_ = class_ constants, name.class_
	field constants, class_, name-and-type
