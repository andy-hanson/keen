import
	../frontend/show-model
	../model/low-model
	../model/model
	../util/full-index-map
	../util/util

exception low-type(a low-program)
	a.common-types.exception

as-wrapper low-field?(a low-type)
	a.body.low-record.?as-wrapper
as-wrapper low-field?(a low-record)
	if f = only a.fields and not is-mutable f
		f

is-nullable-union bool(type low-type)
	low-union type.body and is-nullable-union type.body
is-nullable-union bool(u low-union)
	if null, non-null = only2 u.members
		is-empty-type null and not is-empty-type non-null and not is-nullable-union non-null

each-method-impl void
	type low-type
	interfaces low-type[]
	program low-program
	f void mut(method low-fun, impl low-fun?)
do
	for interface_ in interfaces
		do if info = program.method-impls[interface_]
		case-index = index-of! interface_.body.low-union!.members, type
		for method, impl in zip info.methods, info.cases[case-index]
			f[method, impl]

each-constant-in-dependency-order void(program low-program, emit void mut(x any-allocated-constant)) show-ctx
	seen-arrays (low-type, nat) mut-set = ()
	seen-records (low-type, constant-record) mut-set = ()
	can-reference = of type low-type, c constant
		can-reference program, seen-arrays, seen-records, type, c

	target = program.target
	all-constants = program.all-constants
	did-something mut = true
	while did-something
		did-something := false
		for arr in all-constants.arrays
			do if array-needs-constant arr, target
			for array-id, xs in with-index arr.constants
				key (low-type, nat) = arr.array-type, array-id
				do unless seen-arrays[key]
				do if every xs, {can-reference[arr.element-type, it]}
				seen-arrays ~= key
				emit[single-constant-array arr.array-type, arr.element-type, array-id, xs]
				did-something := true
		for record-type, map in all-constants.records
			do if record-needs-constant record-type, target
			for constant, args in map
				key (low-type, constant-record) = record-type, constant
				do unless seen-records[key]
				fields = record-type.body.low-record!.fields
				do if every (zip args, fields), of arg, field
					can-reference[field.type, arg]
				seen-records ~= key
				emit[single-constant-record record-type, constant, args, fields]
				did-something := true

	n-constant-arrays = sum all-constants.arrays, of x
		do if array-needs-constant x, target
		x.constants.size
	n-constant-records = sum all-constants.records, of record-type, map
		do if record-needs-constant record-type, target
		map.size
	seen-arrays.size is n-constant-arrays
	seen-records.size is n-constant-records

-array-needs-constant bool(array low-array-type-and-constants, target build-target)
	target != java or not is-empty-type array.element-type
-record-needs-constant bool(record-type low-type, target build-target)
	target != java or not is-empty-type record-type and not as-wrapper record-type

-can-reference bool
	program low-program
	seen-arrays (low-type, nat) mut-set
	seen-records (low-type, constant-record) mut-set
	type low-type
	c constant
do
	match c
	as constant-array
		is-empty-type type.as-array! or seen-arrays[type, c.index]
	as constant-native-string
		true
	as constant-record
		if is-empty-type type
			true
		elif field = as-wrapper type
			can-reference program, seen-arrays, seen-records, field.type,
				only! get-record program.all-constants, type, c
		else
			seen-records[type, c]
	as scalar-value
		true
	as constant-symbol
		true
	as constant-union
		case-type, _, value = get-union program.all-constants, type, c
		can-reference program, seen-arrays, seen-records, case-type, value
	as constant-gc-safe-value
		true

# TODO:PERF this may be simpler (and faster) as a single dictionary class-and-member[nat][low-type]
constant-names[name] record
	arrays name[nat][low-type]
	records name[constant-record][low-type]
subscript[name] name(a name constant-names, constant any-allocated-constant)
	type = constant.type
	match constant
	as single-constant-array
		a.arrays[type]![constant.index]!
	as single-constant-record
		a.records[type]![constant.constant]!
array-name[name] name(a name constant-names, type low-type, value constant-array)
	a.arrays[type]![value.index]!
record-name[name] name(a name constant-names, type low-type, value constant-record)
	a.records[type]![value]!

constant-names-builder[name] record mut
	-arrays name mut[nat] mut[low-type]
	-records name mut[constant-record] mut[low-type]
new[name] name constant-names-builder()
	(), ()
set-subscript[name] void(a name constant-names-builder, constant any-allocated-constant, name name)
	match constant
	as single-constant-array
		(ensure a.arrays, constant.type)[constant.index] := name
	as single-constant-record
		(ensure a.records, constant.type)[constant.constant] := name
finish[name] name constant-names(a name constant-names-builder)
	arrays: for k, v in a.arrays
		k, v.move-to
	records: for k, v in a.records
		k, v.move-to

any-allocated-constant union(single-constant-array, single-constant-record)
	type low-type()
single-constant-array record
	type low-type
	element-type low-type
	index nat
	elements constant[]
single-constant-record record
	type low-type
	constant constant-record
	args constant[]
	fields low-field[]

is-64-bit bool(a integral-type)
	a == int64 or a == nat64

mangle-name-common string(a string)
	do unless every a, it.is-ascii-identifier-char else a
	do with out in build
	do for x in a
	if is-ascii-identifier-char x
		out ~= x
	else
		out ~~= "__"
		out ~~= x.to::nat32.show.to
