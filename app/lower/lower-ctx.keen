import
	keen/bits
	keen/col/enum-map
	keen/random/basic-prng
	keen/unsafe
	../../lib/col/experimental/object-memoizer
	../frontend/show-model
	../model/ast
	../model/low-model
	../model/model
	../model/show-low-model
	../model/source-range
	../model/uri
	./all-constants-builder

type-args-scope alias
	low-type[]

type-args-scope-for-fun type-args-scope(a low-fun)
	match x = a.source
	as low-fun-source-regular then x.type-args
	as low-fun-source-interface-or-lens-method-impl then throw unreachable
	as low-fun-source-test then ()
	as low-fun-source-test-all then throw unreachable

specs-scope-for-fun low-fun[](a low-fun)
	match x = a.source
	as low-fun-source-regular then x.spec-impls
	as low-fun-source-interface-or-lens-method-impl then throw unreachable
	as low-fun-source-test then ()
	as low-fun-source-test-all then throw unreachable

lower-ctx spec common-types, low-common-types, lower-context
lower-context record mut
	show-ctx show-ctx
	-prng basic-prng64
	target build-target
	program-with-main program-with-main
	late-equal-string-like-functions mut (matchable-string-like-type, low-fun) enum-map?
	late-hash-nat-functions mut (nat-type, low-fun) enum-map?
	late-json-subscript-function mut low-fun?
	late-only-key-and-value-from-json-function mut low-fun?
	late-to-flags-from-json-function mut low-fun?
	late-to-symbol-or-empty-from-json-function mut low-fun?
	all-constants all-constants-builder
	low-types (low-type, low-type-source-inst) object-memoizer
	all-low-types low-type mut[] # TODO:PERF 'low-types' contains them all, except the bogus type
	low-var-lookup low-var mut[var-decl]
	low-funs (low-fun, low-fun-source-regular) object-memoizer
	deferred-methods low-fun mut[]
	deferred-java-interfaces low-type mut[]
	all-processed-low-funs low-fun mut[]
	all-unprocessed-low-funs low-fun mut[]
	| Maps a sum type to its cases
	sum-types low-sum-type-info mut[low-type]
	low-common-types mut low-common-types
	-char8-array-type mut low-type
	-deserialize-error-type mut low-type
	-error-type mut low-type
	-json-type mut low-type
	-json-object-type mut low-type
	-json-array-type mut low-type
	-symbol-array-type mut low-type
	-none-type mut low-type
	-late-bogus-type mut low-type?
new lower-context
	show-ctx show-ctx
	program program-with-main
	target build-target
do quick-fill-in-low-fun-body
	res lower-context =
		show-ctx: show-ctx
		prng: ()
		target: target
		program-with-main: program
		late-equal-string-like-functions: ()
		late-hash-nat-functions: ()
		late-json-subscript-function: ()
		late-only-key-and-value-from-json-function: ()
		late-to-flags-from-json-function: ()
		late-to-symbol-or-empty-from-json-function: ()
		all-constants: ()
		low-types: ()
		all-low-types: ()
		low-var-lookup: ()
		low-funs: ()
		deferred-methods: ()
		deferred-java-interfaces: ()
		all-processed-low-funs: ()
		all-unprocessed-low-funs: ()
		sum-types: ()
		low-common-types: trusted gc-safe-value
		char8-array-type: trusted gc-safe-value
		deserialize-error-type: trusted gc-safe-value
		error-type: trusted gc-safe-value
		json-type: trusted gc-safe-value
		json-object-type: trusted gc-safe-value
		json-array-type: trusted gc-safe-value
		symbol-array-type: trusted gc-safe-value
		none-type: trusted gc-safe-value
		late-bogus-type: ()
	the lower-context = res
	the common-types = res.common-types
	res.low-common-types :=
		bool: get-low-type-for-type-inst bool, ()
		exception: get-low-type-for-type-inst exception, ()
		float32: get-low-type-for-type-inst float32, ()
		float64: get-low-type-for-type-inst float64, ()
		int64: get-low-type-for-type-inst int64, ()
		nat8: get-low-type-for-type-inst nat8, ()
		nat16: get-low-type-for-type-inst nat16, ()
		nat32: get-low-type-for-type-inst nat32, ()
		nat64: get-low-type-for-type-inst nat64, ()
		string: get-low-type-for-type-inst string, ()
		symbol: get-low-type-for-type-inst symbol, ()
		void: get-low-type-for-type-inst void, ()
	res.char8-array-type := get-low-type-for-type-inst char8-array, ()
	res.deserialize-error-type := get-low-type-for-type-inst common-funs.deserialize-error, ()
	res.error-type := get-low-type-for-type-inst common-funs.error, ()
	res.json-type := get-low-type-for-type-inst json, ()
	res.json-object-type := get-low-type-for-type-inst json-object, ()
	symbol-array-field, json-array-field = only2! res.json-object-type.body.low-record!.fields
	res.symbol-array-type := symbol-array-field.type
	res.json-array-type := json-array-field.type
	res.none-type := get-low-type-for-type-inst the::common-types.none, ()
	res

-memoizer-key low-fun-source-regular(a low-fun)
	low-fun-source-regular! a.source
-hash nat64(a low-fun-source-regular)
	trusted deterministic-hash a

-memoizer-key low-type-source-inst(a low-type)
	low-type-source-inst! a.source
-hash nat64(a low-type-source-inst)
	trusted deterministic-hash a

show-ctx show-ctx() lower-context
	the::lower-context.show-ctx

all-constants all-constants-builder() lower-context
	the::lower-context.all-constants
the-target build-target() lower-context
	the::lower-context.target
is-java bool() lower-context
	the-target == java
is-js bool() lower-context
	the-target == js
preserve-methods bool(type low-type) lower-context
	if is-java
		true
	else
		# Allow preserving methods for interfaces, since those can't include builtin types like 'nat'
		type.source.low-type-source-inst!.decl.body.sum-type!.kind == interface_
hash-nat-function low-fun(nat-type nat-type) lower-context
	the::lower-context.late-hash-nat-functions![nat-type]
equal-string-like-function low-fun(string-type matchable-string-like-type) lower-context
	the::lower-context.late-equal-string-like-functions![string-type]
equal-symbol-function low-fun() lower-context
	equal-string-like-function symbol
json-subscript-function low-fun() lower-context
	the::lower-context.late-json-subscript-function!
only-key-and-value-from-json-function low-fun() lower-context
	the::lower-context.late-only-key-and-value-from-json-function!
to-flags-from-json-function low-fun() lower-context
	the::lower-context.late-to-flags-from-json-function!
to-symbol-or-empty-from-json-function low-fun() lower-context
	the::lower-context.late-to-symbol-or-empty-from-json-function!
program program() lower-context
	the::lower-context.program-with-main.program
common-funs common-funs() lower-context
	program.common-funs
common-types common-types(a lower-context)
	a.program-with-main.program.common-types

take-next-id nat32() lower-context
	wrap-to next64 the::lower-context.prng # TODO: Just use a 32-bit prng then -------------------------------------------------------

low-sum-type-info record mut
	| All actually used methods, in no particular order.
	methods-unsorted low-fun mut[]
	cases low-sum-type-case mut[]

low-sum-type-case union mut
	low-sum-type-case-regular
	low-sum-type-case-new-interface
	low-sum-type-case-record-field-lens
do
	case-type low-type()
	method-impls low-expr? buffer() # TODO: COuld this be non-optional ???????????????????????????????????????????????????????
low-sum-type-case-regular record mut
	case-type low-type
	type-args-scope low-type[]
	model-method-impls fun-inst?[]
	| Uses the same order of methods as on the sum-type.
	| These will be filled in when the method is used.
	method-impls low-expr? buffer
low-sum-type-case-new-interface record mut
	case-type low-type
	method-impls low-expr? buffer
low-sum-type-case-record-field-lens record mut
	case-type low-type
	method-impls low-expr? buffer

finish-low-vars low-var[]() lower-context
	res low-var[] = for _, v in the::lower-context.low-var-lookup then v
	# TODO: this also needs to take into account order of dependencies. If A imports B, B needs to initialize first.
	sort res, it.range.range.start

-bogus-type low-type() lower-context
	ctx = the::lower-context
	ctx.late-bogus-type else
		res low-type =
			id: take-next-id
			source: low-type-source-bogus
			body: (prevent-constant: false, fields: ())::low-record
		ctx.all-low-types ~= res
		ctx.late-bogus-type := res
		res
char8-array-type low-type() lower-context
	the::lower-context.char8-array-type
deserialize-error-type low-type() lower-context
	the::lower-context.deserialize-error-type
error-type low-type() lower-context
	the::lower-context.error-type
json-type low-type() lower-context
	the::lower-context.json-type
json-object-type low-type() lower-context
	the::lower-context.json-object-type
symbol-array-type low-type() lower-ctx
	the::lower-context.symbol-array-type
json-array-type low-type() lower-ctx
	the::lower-context.json-array-type
none-type low-type() lower-context
	the::lower-context.none-type

get-referenced-type low-type(type low-type) lower-ctx
	inst = type.source.low-type-source-inst!
	inst.decl is reference
	only! inst.type-args

constant-symbol constant(value symbol) lower-ctx
	get-constant-symbol all-constants, value

quick-fill-in-low-fun-body spec
	quick-fill-in-low-fun-body void(ctx lower-context, cf low-fun)

get-low-fun low-fun
	decl fun-decl
	type-args low-type[]
	spec-impls low-fun[]
do lower-context, quick-fill-in-low-fun-body
	key low-fun-source-regular = decl, type-args, spec-impls
	did-add mut = false
	res = trusted memoize the::lower-context.low-funs, key, of
		did-add := true
		hash: take-next-id
		source: key
		return-type: get-low-type decl.return-type, type-args
		params:
			-- for x in decl.params
				lower-param-destructure x, type-args
			-- for x in decl.contexts
				the_::low-generated-local-kind, get-low-type x, type-args
		body: low-fun-body-deferred
	if did-add
		quick-fill-in-low-fun-body the::lower-context, res
		unless low-fun-body-always-inline res.body
			add-low-fun res
	res

low-fun-for-new-interface-method-impl low-expr(case-type low-type, method low-fun, method-index nat32) lower-context
	field = case-type.body.low-record!.fields[method-index]
	return-type, lambda-param-type = only2! field.type.source.low-type-source-inst!.type-args
	lambda-params = method.params[1 .. end]
	range = case-type.source.range
	get-record = union-assume-case-low-expr case-type, range, local-get-low-expr range, method.params[0]
	get-lambda = record-field-get-low-expr range, get-record, field
	lambda-param low-expr = match lambda-params.size
	as 0
		lambda-param-type, range, constant-gc-safe-value
	as 1
		local-get-low-expr range, only! lambda-params
	else
		create-record-low-expr lambda-param-type, range, for p in lambda-params
			local-get-low-expr range, p
	builtin-binary-low-expr return-type, range, call-lambda, get-lambda, lambda-param

low-fun-for-record-field-lens-method-impl low-expr(case-type low-type, method low-fun, method-index nat) lower-context
	field = case-type.source.low-type-source-record-field-lens!.field
	range = case-type.source.range
	match method-index
	as 0 # get
		_, value = only2! method.params
		record-field-get-low-expr range, (local-get-low-expr range, value), field
	as 1 # set
		_, outer, inner = only3! method.params
		get-outer = local-get-low-expr range, outer
		record_ = low-record! outer.type.body
		create-record-low-expr outer.type, range, for f in record_.fields
			if f == field
				local-get-low-expr range, inner
			else
				record-field-get-low-expr range, get-outer, f
	else
		throw unreachable

get-non-template-low-fun low-fun(inst fun-inst) lower-ctx, quick-fill-in-low-fun-body
	forbid is-template inst.decl
	get-low-fun inst.decl, (), ()

get-low-type-for-type-inst low-type
	inst type-inst
	type-args-scope type-args-scope
do lower-context, quick-fill-in-low-fun-body
	type-args = get-low-types inst.type-args, type-args-scope
	key low-type-source-inst = inst.decl, type-args
	did-add mut = false
	res = trusted memoize the::lower-context.low-types, key, of
		did-add := true
		res low-type =
			id: take-next-id
			source: key
			body: low-type-body-deferred
		the::lower-context.all-low-types ~= res
		res
	if did-add
		initialize-low-type inst, res, type-args
	res

low-type-for-new-interface (nat32, low-type)(interface_ low-type, params low-local[]) lower-context
	fields low-field[] = for param in params
		name: param.source.local!.name
		is-mutable: false
		type: param.type
	res low-type =
		id: take-next-id
		source: low-type-source-new-interface interface_
		body:
			:: low-record
			prevent-constant: false
			fields: fields
	the::lower-context.all-low-types ~= res
	info = the::lower-context.sum-types[interface_]!
	case-index = info.cases.size
	info.cases ~=
		:: low-sum-type-case-new-interface
		case-type: res
		method-impls: initial-method-impls interface_, info, of method, method-index
			low-fun-for-new-interface-method-impl res, method, method-index
	case-index, res

low-type-for-record-field-lens (nat32, low-type)(lens low-type, field low-field) lower-context
	res low-type =
		id: take-next-id
		source: low-type-source-record-field-lens lens, field
		body:
			:: low-record
			prevent-constant: false
			fields: ()
	the::lower-context.all-low-types ~= res
	info = the::lower-context.sum-types[lens]!
	case-index = info.cases.size
	info.cases ~=
		:: low-sum-type-case-record-field-lens
		case-type: res
		method-impls: initial-method-impls lens, info, of method, method-index
			low-fun-for-record-field-lens-method-impl res, method, method-index
	case-index, res

-initial-method-impls low-expr? buffer
	interface_ low-type
	info low-sum-type-info
	f low-expr mut(method low-fun, method-index nat32)
do lower-context
	n-methods = interface_.source.low-type-source-inst!.decl.body.sum-type!.methods.size
	method-impls low-expr? buffer = n-of n-methods, ()
	for method in info.methods-unsorted
		method-index = method.body.low-fun-body-method!.method-index
		method-impls[method-index] := f[method, method-index]
	method-impls

get-low-type low-type(type type, type-args-scope type-args-scope) lower-context, quick-fill-in-low-fun-body
	match type
	as bogus-type
		bogus-type
	as type-param-index
		type-args-scope[type.index]
	as type-inst
		get-low-type-for-type-inst type, type-args-scope

-get-low-types low-type[](types type-args, type-args-scope type-args-scope) lower-context, quick-fill-in-low-fun-body
	for t in types
		get-low-type t, type-args-scope

get-low-fun-from-called low-fun?
	type-scope type-args-scope
	specs-scope low-fun[]
	called called
do lower-context, quick-fill-in-low-fun-body
	match called
	as called-bogus
		()
	as fun-inst
		get-low-fun-from-fun-inst type-scope, specs-scope, called
	as called-spec-sig
		specs-scope[called.index-in-specs]

fun-decl-from-called fun-decl?(called called, specs-scope low-fun[]) lower-context
	match called
	as called-bogus
		()
	as fun-inst
		called.decl
	as called-spec-sig
		specs-scope[called.index-in-specs].source.low-fun-source-regular!.decl

get-low-fun-from-fun-inst low-fun?
	type-scope type-args-scope
	specs-scope low-fun[]
	fun-inst fun-inst
do lower-context, quick-fill-in-low-fun-body
	do if spec-impls low-fun[] = map-every fun-inst.spec-impls, {get-low-fun-from-called type-scope, specs-scope, it}
	type-args = get-low-types fun-inst.type-args, type-scope
	get-low-fun fun-inst.decl, type-args, spec-impls

-lower-param-destructure low-local
	a destructure
	type-args-scope type-args-scope
do lower-context, quick-fill-in-low-fun-body
	source: match a
	as destructure-ignore
		ignore::low-generated-local-kind
	as local
		a
	as destructure-split
		destruct::low-generated-local-kind
	type: get-low-type a.type, type-args-scope

add-low-fun void(fun low-fun) lower-context
	the::lower-context.all-unprocessed-low-funs ~= fun

-initialize-low-type void
	inst type-inst
	res low-type
	type-args low-type[]
do lower-context, quick-fill-in-low-fun-body
	match body = inst.decl.body
	as type-body-bogus
		throw unreachable
	as builtin-type
		res.body := if body == option
			:: low-union
			java-interface: ()
			late-members: none-type, only! type-args
			has-new-interface-members: false
		else
			body
	as enum_
		res.body := body.storage.low-enum
	as flags_
		res.body := body.storage.low-flags
	as java-class
		res.body := low-java-class inst.class-path, ?get-low-type body.super-class, type-args
	as record_
		fields low-field[] = for field in body.fields
			name: field.name
			is-mutable: field.mutability
			type: get-low-type field.type, type-args
		res.body :=
			:: low-record
			is-exception-case = some inst.decl.sum-type-cases, of x
				x.sum-type == the::lower-context.common-types.exception
			prevent-constant: is-exception-case or some fields, it.is-mutable
			fields: fields
	as sum-type
		res.body :=
			:: low-union
			java-interface: if body.kind == java-interface then inst.class-path
			late-members: ()
			has-new-interface-members: false
		cases low-sum-type-case mut[] = for member in body.listed-members
			case-type: get-low-type-for-type-inst member.case-type, type-args
			type-args-scope: type-args
			model-method-impls: member.method-impls
			method-impls: n-of body.methods.size, ()
		the::lower-context.sum-types[res] := (), cases
		match body.kind
		as interface_
			()
		as java-interface
			the::lower-context.deferred-java-interfaces ~= res
		as union_
			finish-sum-type-cases res, cases
		as variant_
			()

	the common-types = the::lower-context.program-with-main.program.common-types
	for x in inst.decl.sum-type-cases
		# Java superclasses don't need to be handled here, except for exception types
		do unless as-extern res and x.sum-type != exception
		sum-type = get-low-type x.sum-type, type-args
		info = the::lower-context.sum-types[sum-type]!
		method-impls low-expr? buffer = n-of x.method-impls.size, ()
		for method in info.methods-unsorted
			method-index = method.body.low-fun-body-method!.method-index
			if is-empty x.method-impls
				assert as-extern res
			elif impl = x.method-impls[method-index]
				method-impls[method-index] := call-method-impl method, inst.decl.range, get-low-fun-from-called type-args, (), impl
		info.cases ~=
			case-type: res
			type-args-scope: type-args
			model-method-impls: x.method-impls
			method-impls: method-impls

call-method-impl low-expr(method low-fun, range uri-and-range, method-impl low-fun?) lower-context
	assert method-impl else todo # ----------------------------------------------------------------------------------------------
	args low-expr[] =
		- union-assume-case-low-expr method-impl.params[0].type, range, local-get-low-expr range, method.params[0]
		-- for param in method.params[1 .. end]
			local-get-low-expr range, param
	if low-fun-body-always-inline method-impl.body
		lower-inline-call-not-array-op method-impl, range, args
	else
		call-low-expr range, method-impl, args

lower-inline-call-not-array-op low-expr(fun low-fun, range uri-and-range, args low-expr[]) lower-context
	type = fun.return-type
	assert low-fun-body-always-inline fun.body
	match body = fun.source.low-fun-source-regular!.decl.body
	as fun-body-builtin
		match kind = body.kind
		as builtin-unary
			builtin-unary-low-expr type, range, kind.to, only! args
		as builtin-binary
			arg0, arg1 = only2! args
			builtin-binary-low-expr type, range, kind, arg0, arg1
		as builtin-ternary
			arg0, arg1, arg2 = only3! args
			builtin-ternary-low-expr type, range, kind, arg0, arg1, arg2
		else
			throw unreachable
	as new-interface
		type.body.low-union!.has-new-interface-members := true
		new-interface-low-expr type, range, args
	as new-record
		if is-empty args and not prevent-constant type.body.low-record!
			constant-low-expr type, range, get-constant-record all-constants, type, ()
		else
			gen-create-record type, range, args
	as record-field-get
		record_ = only! args
		the low-common-types = the::lower-context.low-common-types
		gen-record-field-get range, record_, get-low-field record_.type, body.field
	as record-field-set
		record_, value = only2! args
		:: record-field-set-low-expr
		range: range
		record_: record_
		field: get-low-field fun.params[0].type, body.field
		value: value
	else
		throw unreachable
-to low-builtin-unary(a builtin-unary)
	match a
	as array-size then array-size
	as bits-of-float32 then bits-of-float32
	as bits-of-float64 then bits-of-float64
	as bitwise-not then bitwise-not
	as float32-from-bits then float32-from-bits
	as float64-from-bits then float64-from-bits
	as not then not
	as uninitialized-buffer then uninitialized-buffer
	as reinterpret-cast then reinterpret-cast
	as to-float32-from-float64 then to-float32-from-float64
	as to-float64-from-float32 then to-float64-from-float32
	as to-float-from-integral then to-float-from-integral
	as truncate-to-int64-from-float64 then truncate-to-int64-from-float64
	as weak-ref-get then weak-ref-get
	as weak-ref-new then weak-ref-new
	as wrap-convert-integral then wrap-convert-integral

get-low-field low-field(record-type low-type, field record-field)
	index = index-of! record-type.source.low-type-source-inst!.decl.body.record_!.fields, field
	record-type.body.low-record!.fields[index]

gen-create-record low-expr(type low-type, range uri-and-range, args low-expr[]) lower-context
	if not prevent-constant type.body.low-record! and x = as-constants args
		type, range, get-constant-record all-constants, type, x
	else
		create-record-low-expr type, range, args

as-constants constant[]?(exprs low-expr[])
	map-every exprs, it.constant-low-expr.?value

gen-record-field-get low-expr
	range uri-and-range
	arg low-expr
	field low-field
do low-common-types
	if is-empty-type field.type
		gen-drop-then range, arg, constant-low-expr field.type, range, constant-gc-safe-value
	else
		record-field-get-low-expr range, arg, field

gen-drop-then low-expr(range uri-and-range, a low-expr, b low-expr) low-common-types
	seq-low-expr range,
		- builtin-unary-low-expr void, range, drop, a
		- b

-class-path path(a type-inst) = a.decl.source.type-decl-source-java!.class-path

sum-type-case-index nat32(sum-type low-type, case-type low-type) lower-context
	body = sum-type.body.low-union!
	if body.has-members
		index-of! body.members, case-type
	else
		the show-ctx = show-ctx
		assert st = the::lower-context.sum-types[sum-type] else
			error "Could not find members for sum type {show-low-type sum-type}"
		find-index st.cases, it.case-type == case-type else
			log-error "Could not find sum type member {show-low-type case-type} for {show-low-type sum-type}"
			throw todo

finish-sum-type-cases void(sum-type low-type, cases low-sum-type-case mut[])
	sum-type.body.low-union!.members := for x in cases
		x.case-type

fun-body-decl fun-body(fun low-fun)
	fun.source.low-fun-source-regular!.decl.body
