import
	../frontend/show-model
	../model/low-model
	../model/model
	../model/show-low-model
	../model/source-range
	./all-constants-builder
	./lower-auto-fun
	./lower-ctx
	./lower-expr-ctx
	./generate

# Fills in simple function bodies
quick-fill-in-low-fun-body void(ctx lower-context, fun low-fun)
	the common-types = ctx.common-types
	the lower-context = ctx
	the low-common-types = ctx.low-common-types
	the common-funs = common-funs
	assert fun.body.low-fun-body-deferred
	fun-body = fun-body-decl fun
	return-type = fun.return-type
	range = fun.range
	low-params = fun.params
	fun.body := match x = fun-body
	as fun-body-bogus
		lower-bogus fun.return-type, range
	as fun-body-extern-java
		:: low-fun-body-extern-java
		kind: x.kind
		class_: x.class_
		erased-return-type: get-low-type x.erased-return-type, ()
		erased-param-types: map x.erased-param-types, {get-low-type it, ()}
	as auto-fun
		lower-auto-fun fun, x
	as fun-body-builtin
		lower-builtin-fun fun, x.kind
	as enum-or-flags-member
		constant-low-expr return-type, range, x.value.to
	as fun-body-expr
		if is-array-op fun
			low-fun-body-always-inline
		else
			low-fun-body-deferred
	as fun-body-file-import
		lower-file-import fun, x
	as fun-body-flags-function
		lower-flags-function fun, x.function
	as fun-body-method
		info = ctx.sum-types[low-params[0].type]!
		info.methods-unsorted ~= fun
		for case_ in info.cases
			case_.method-impls[x.method-index] := match case_
			as low-sum-type-case-regular
				if impl = case_.model-method-impls[x.method-index]
					call-method-impl fun, range, get-low-fun-from-called case_.type-args-scope, (), impl
			as low-sum-type-case-new-interface
				low-fun-for-new-interface-method-impl case_.case-type, fun, x.method-index
			as low-sum-type-case-record-field-lens
				low-fun-for-record-field-lens-method-impl case_.case-type, fun, x.method-index
		unless preserve-methods fun.params[0].type
			ctx.deferred-methods ~= fun
		low-fun-body-method x.method-index, if sig = x.erased-signature
			for type in sig then get-low-type type, ()
	as new-interface
		low-fun-body-always-inline
	as new-record
		low-fun-body-always-inline
	as record-field-get
		low-fun-body-always-inline
	as record-field-lens
		low-fun-body-always-inline
	as record-field-set
		low-fun-body-always-inline
	as sum-type-case-get
		gen-union-member-get fun, sum-type-case-index low-params.only!.type, as-option! return-type
	as var-get
		low-fun-body-always-inline
	as var-set
		low-fun-body-always-inline
	as fun-body-uninitialized
		throw unreachable

-is-primitive-comparable bool(a low-type)
	as-float-type a or as-integral-type-allow-bool-char a

-lower-builtin-fun low-fun-body(fun low-fun, a builtin-fun) lower-ctx
	return-type = fun.return-type
	range = fun.range
	match a
	as builtin-unary
		low-fun-body-always-inline
	as builtin-binary
		match a
		as bitwise-and then low-fun-body-always-inline
		as bitwise-or then low-fun-body-always-inline
		as bitwise-xor then low-fun-body-always-inline
		as call-lambda then low-fun-body-always-inline
		as compare then low-fun-body-always-inline
		as compare-less then lower-comparison fun, a
		as compare-less-or-equal then lower-comparison fun, a
		as compare-greater then lower-comparison fun, a
		as compare-greater-or-equal then lower-comparison fun, a
		as equal-exact then low-fun-body-always-inline
		as equal-float-ieee then low-fun-body-always-inline
		as less-float-ieee then low-fun-body-always-inline
		as not-equal-exact then lower-comparison fun, a
		as rotate-left then low-fun-body-always-inline
		as rotate-right then low-fun-body-always-inline
		as unsafe-at then low-fun-body-always-inline
		as unsafe-bit-shift-left then low-fun-body-always-inline
		as unsafe-bit-shift-right then low-fun-body-always-inline
		as unsafe-add-float then low-fun-body-always-inline
		as unsafe-div then low-fun-body-always-inline
		as unsafe-mod then low-fun-body-always-inline
		as unsafe-mul-float then low-fun-body-always-inline
		as unsafe-sub-float then low-fun-body-always-inline
		as wrap-add then low-fun-body-always-inline
		as wrap-mul then low-fun-body-always-inline
		as wrap-sub then low-fun-body-always-inline
	as builtin-ternary
		low-fun-body-always-inline
	as java-fun
		low-fun-body-always-inline
	as js-fun
		low-fun-body-always-inline
	as builtin-fun-constant
		constant-low-expr return-type, range, to-constant return-type, a
	as builtin-fun-is-empty-type
		constant-low-expr return-type, range, to::scalar-value
			is-empty-type only! fun.source.low-fun-source-regular!.type-args
	as builtin-fun-is-target
		constant-low-expr return-type, range, to::scalar-value a.target == the-target
-to-constant constant(type low-type, a builtin-fun-constant) lower-ctx
	match a
	as bool
		a.to::scalar-value
	as float
		a.to::scalar-value
	as builtin-fun-constant-empty-option
		constant-none type
	as builtin-fun-constant-gc-safe-value
		constant-gc-safe-value

-lower-comparison low-expr(fun low-fun, fn builtin-binary) lower-ctx
	p0, p1 = only2! fun.params
	arg-type = p0.type
	p1.type is arg-type
	range = fun.range
	args low-expr[] =  map fun.params, {local-get-low-expr range, it}
	if is-primitive-comparable arg-type
		arg0, arg1 = only2! args
		builtin-binary-low-expr fun.return-type, range, fn, arg0, arg1
	else
		compare = only! fun.source.low-fun-source-regular!.spec-impls
		comparison = compare.return-type
		compared = call-low-expr range, compare, args
		comparison-is = of value comparison
			gen-equal-integral range, compared, gen-comparison comparison, range, value
		comparison-isnt = of value comparison
			gen-not-equal-integral range, compared, gen-comparison comparison, range, value
		match fn
		as compare-less
			comparison-is[less]
		as compare-less-or-equal
			comparison-isnt[greater]
		as compare-greater
			comparison-is[greater]
		as compare-greater-or-equal
			comparison-isnt[less]
		as not-equal-exact
			gen-not range, compared
		else
			throw unreachable

-lower-file-import low-expr(cf low-fun, import_ fun-body-file-import) lower-ctx
	cf.return-type, cf.range, match import_.type
	as nat8-array
		constant-of-bytes cf.return-type, import_.content
	as string
		constant-string import_.content.as-string

get-var low-var(context lower-context, decl var-decl)
	the lower-context = context
	the common-types = context.common-types
	the low-common-types = context.low-common-types
	get-var decl
get-var low-var(decl var-decl) lower-ctx
	ensure the::lower-context.low-var-lookup, decl, {get-var-inner decl}
-get-var-inner low-var(decl var-decl) lower-ctx
	type = get-low-type decl.type, ()
	the lower-expr-ctx =
		cur-uri: decl.module-uri
		type-scope: ()
		specs-scope: ()
		allocated-locals: decl.initializer.allocated-locals
	decl, type, lower-expr type, decl.initializer.as-expr

lower-fun-or-test-body low-fun-body(cf low-fun, expr expr, allocated-locals type-inst[local]) lower-ctx
	params = match x = cf.source
	as low-fun-source-regular
		the common-funs = common-funs
		x.decl.params
	as low-fun-source-test
		()
	as low-fun-source-test-all
		throw unreachable
	the lower-expr-ctx = cf, allocated-locals
	type = cf.return-type
	for param, low-param in zip params, cf.params[0 .. params.size] # Ignore context params
		begin-param-destructure param, low-param
	res mut = lower-expr type, expr
	for param, low-param in zip params, cf.params[0 .. params.size]
		res := end-param-destructure type, param.range.to-uri-and-range, param, low-param, res
	res

-lower-bogus low-expr(type low-type, range uri-and-range) lower-ctx
	gen-bogus type, range

-with-temp-if-needed low-expr(range uri-and-range, value low-expr, f low-expr mut(get-temp low-expr)) low-common-types
	if value.local-get-low-expr and not is-mutable value.local
		f[value]
	else
		temp low-local = member, value.type
		let-low-expr range, temp, value, f[local-get-low-expr range, temp]

-with-local record(local-type low-type, range uri-and-range)
-with-block low-local-and-expr(a with-local, f low-expr mut(get low-expr))
	local low-local = temp::low-generated-local-kind, a.local-type
	local, f[local-get-low-expr a.range, local]

-lower-call low-expr(type low-type, range uri-and-range, a call-expr) lower-and-expr-ctx
	do if low-called = get-low-fun-from-called a.called else
		lower-bogus type, range
	if low-fun-body-always-inline low-called.body
		if is-array-op low-called
			lower-array-op type, range, a, low-called
		else
			lower-inline-call-not-array-op low-called, range, for param, arg in zip low-called.params, a.args
				lower-expr param.type, arg
	else
		args low-expr[] =
			# Since 'list-new' is allowed to implement the 'new' spec, we need to support those here
			-- if a.args.size == 0 and array-type = as-list-new low-called
				empty-array = get-constant-array all-constants, array-type, ()
				- array-type, range, empty-array
			else
				for param, arg in zip low-called.params[0 .. a.args.size], a.args
					lower-expr param.type, arg
			-- context-args range, a.called, low-called
		# We need to widen again even though it was done already in 'lower-expr',
		# because we may be calling a spec-impl that has a narrower type than the spec.
		# (The call expr's type can't reflect this and uses the spec's declared type.)
		gen-call range, low-called, args

-lower-array-op low-expr(type low-type, range uri-and-range, a call-expr, low-called low-fun) lower-and-expr-ctx
	input-arg, lambda-arg = only2! a.args
	input-param, lambda-param = only2! low-called.params
	input = lower-expr input-param.type, input-arg
	in-element-type = if is-range input.type then range-element-type input.type else as-array-or-buffer! input.type
	out-element-type = if is-void type then type else as-array-or-buffer! type
	empty-out-array constant-array? = unless is-void type
		constant-array! get-constant-array all-constants, type, ()
	match lambda-arg
	as lambda-expr
		forbid lambda-arg.mut-type-for-explicit-shared # This won't happen because 'for-loop' takes a 'mut' lambda
		rg uri-and-range = cur-uri, lambda-arg.range
		body = lower-with-destructure out-element-type, rg, lambda-arg.param, of
			lower-expr out-element-type, lambda-arg.body
		array-op-low-expr type, range, input, body.local, empty-out-array, body.expr
	else
		lambda = lower-expr lambda-param.type, lambda-arg
		with-temp-if-needed range, lambda, of get-lambda
			in-element low-local = temp, in-element-type
			array-op-low-expr type, range, input, in-element, empty-out-array,
				builtin-binary-low-expr out-element-type, range, call-lambda, get-lambda,
					local-get-low-expr range, in-element

# Returns the parameter array type
-as-list-new low-type?(a low-fun)
	do if a.name == "list-new" and a.params.size == 1
	res = a.params.only!.type
	if as-array res then res

-lower-call-named-new low-expr
	type low-type
	range uri-and-range
	a call-named-new-expr
do lower-and-expr-ctx
	do if low-called = get-low-fun-from-called a.called else lower-bogus type, range
	p0 = low-called.params[0]
	p1 = low-called.params[1]
	symbol-array-type = p0.type
	arg-array-type = p1.type
	symbols constant[] = map a.names, it.constant-symbol
	symbol-array low-expr = symbol-array-type, range, get-constant-array all-constants, symbol-array-type, symbols
	arg-type = as-array! p1.type
	args low-expr[] = for arg in a.args
		lower-expr arg-type, arg
	symbols.size is args.size
	call-low-expr range, low-called,
		- symbol-array
		- create-array-low-expr arg-array-type, range, args
		-- context-args range, a.called, low-called

-context-args low-expr[]
	range uri-and-range
	called called
	low-called low-fun
do lower-and-expr-ctx
	for p in low-called.params[end - called.count-contexts .. end]
		get-the p.type, range

-count-contexts nat32(a called)
	if a.fun-inst
		a.decl.contexts.size

-is-array-op bool(a low-fun) lower-context
	# TODO: make sure this is the one in collection.keen and all the spec impls are as expected
	do if a.name == "for-loop"
	do if is-void a.return-type or as-array-or-buffer a.return-type
	do if a.params.size == 2
	input = a.params[0]
	do if is-range input.type or as-array-or-buffer input.type
	do if as-lambda-type a.params[1].type
	true

-is-range bool(a low-type) lower-context
	low-type-source-inst a.source and a.source.decl == common-funs.range

-lower-call-option low-expr(type low-type, range uri-and-range, a call-option-expr) lower-and-expr-ctx
	###
	Args are evaluated from left to right, and it stops at the first empty option.
	So '?foo a, b, c' where 'b' is an option must compile to:
	x = a
	if y = b
		foo x, y, c
	###
	do if called = get-low-fun-from-called a.called else lower-bogus type, range
	option-args nat32 mut[] = ()
	args low-expr[] = for i in 0 .. a.args.size
		if is-option type a.args[i] and not is-option a.called.param-types[i]
			option-args ~= i
			option-type = get-low-type option[a.called.param-types[i]]
			lower-expr option-type, a.args[i]
		else
			lower-expr called.params[i].type, a.args[i]
	first-non-option = option-args[end - 1] + 1
	arg-locals low-local[] = for i in 0 .. first-non-option
		destruct::low-generated-local-kind, called.params[i].type
	# Generate it backwards, starting form the innermost call and wrapping in optional checks
	res mut low-expr = gen-call range, called,
		-- for local in arg-locals then local-get-low-expr range, local
		-- args[first-non-option .. end].to
		-- context-args range, a.called, called
	if res.type != type
		res := gen-option type, range, res
	else_ = if is-void type then gen-void range else gen-empty-option type, range
	for i in reverse 0 .. first-non-option
		if option-args.peek == i
			_ = pop! option-args
			res := gen-if-option range, args[i],
				then_: arg-locals[i], res
				else_: else_
		else
			res := let-low-expr range, arg-locals[i], args[i], res
	res

-lower-is-or-isnt low-expr(range uri-and-range, a is-or-isnt-expr) lower-and-expr-ctx
	do if equal = ?get-low-fun-from-called a.called-equal else lower-bogus void, range
	left = lower-expr a.left
	right = lower-expr left.type, a.right
	match a.thrown
	as default-thrown-for-is
		do if to-json = ?get-low-fun-from-called a.thrown.called-to-json else lower-bogus void, range
		impl-decl = if a.is-isnt then common-funs.isnt-impl else common-funs.is-impl
		impl = get-low-fun impl-decl, (left.type,), (equal, to-json)
		gen-call range, impl, (left, right)
	as expr
		throw_ = throw-low-expr void, range, lower-expr exception, a.thrown
		eq = gen-call range, equal, (left, right)
		void_ = gen-void range
		then_ low-expr, else_ low-expr = if a.is-isnt then throw_, void_ else void_, throw_
		if-low-expr range, eq, then_, else_

-lower-lambda low-expr(type low-type, range uri-and-range, e lambda-expr) lower-and-expr-ctx
	return-type = get-low-type e.return-type
	do unless is-bogus return-type else lower-bogus type, range
	param-type = get-low-type e.param.type
	body = lower-expr-with-destructure return-type, range, e.param, e.body
	param = body.local else args::low-generated-local-kind, param-type
	closure low-local[] = for x in e.closure
		match x
		as local
			locals[x]!
		as type-inst
			get-the-local get-low-type x
	need-wrap = not is-js and is-explicit-shared e
	lambda-type = if need-wrap
		get-low-type e.mut-type-for-explicit-shared!
	else
		type
	lambda = lambda-low-expr lambda-type, range, closure, param, body.expr
	# TODO: given that 'shared' just converts a mut lambda to shared,
	# it might make more sense to have it be a separate expression that wraps the lambda
	if need-wrap
		decl = program.common-funs.shared-of-mut-lambda
		fun = get-low-fun decl, (return-type, param-type), ()
		call-low-expr range, fun, (lambda,)
	else
		lambda

-lower-let low-expr(type low-type, range uri-and-range, e let-expr) lower-and-expr-ctx
	local-type = get-low-type e.destructure.type
	value = lower-expr local-type, e.value
	lower-with-destructure-and-let type, range, e.destructure, value, of
		lower-expr-or-void type, range, e.then_

-lower-list low-expr(type low-type, range uri-and-range, a list-expr) lower-and-expr-ctx
	do if called = get-low-fun-from-called a.called else lower-bogus type, range
	call-low-expr range, called,
		- lower-list-inner a.array-type.get-low-type, range, a.parts

-lower-list-inner low-expr
	array-type low-type
	range uri-and-range
	parts list-expr-part[]
do lower-and-expr-ctx
	elem-type = as-array! array-type
	if every parts, it.expr
		create-array-low-expr array-type, range, for part in parts
			lower-expr elem-type, part.expr!
	else
		gen-concat-array-views range, elem-type, of array-view-type
			array-views low-expr mut[] = ()
			cur-list low-expr mut[] = ()
			finish-list = of
				array-views ~= gen-to-array-view create-array-low-expr array-type, range, cur-list.move-to
			for part in parts
				match part
				as expr
					cur-list ~= lower-expr elem-type, part
				as list-expr-part-multi
					finish-list[]
					array-views ~= lower-expr array-view-type, part.arg
			finish-list[]
			array-views.move-to

-lower-expr-with-destructure low-local-and-expr
	type low-type
	range uri-and-range
	destructure destructure
	expr expr
do lower-and-expr-ctx
	lower-with-destructure type, range, destructure, {lower-expr type, expr}

-lower-with-opt-local low-expr
	type low-type
	range uri-and-range
	local local?
	value expr
	f low-expr mut(matched low-expr)
do lower-and-expr-ctx
	v = lower-expr value
	if local
		lower-with-destructure-and-let type, range, local, v, of
			f[local-get-low-expr range, locals[local]!]
	else
		f[v]
-lower-with-destructure-and-let low-expr
	type low-type
	range uri-and-range
	destructure destructure
	value low-expr
	f low-expr mut()
do lower-and-expr-ctx
	use-root-local value,
		lower-with-destructure type, range, destructure, f
-use-root-local low-expr(value low-expr, then_ low-local-and-expr) lower-ctx
	expr = then_.expr
	if root = then_.local
		let-low-expr expr.range, root, value, expr
	elif value.constant-low-expr
		then_.expr
	else
		gen-drop-then expr.range, value, expr

-lower-with-destructure low-local-and-expr
	type low-type
	range uri-and-range
	destructure destructure
	f low-expr mut()
do lower-and-expr-ctx
	begin-destructure destructure
	res = f[]
	end-destructure type, range, destructure, res

-begin-destructure void(a destructure) lower-and-expr-ctx
	match a
	as destructure-ignore
		()
	as local
		the::lower-expr-ctx.locals[a] := a, (is-allocated a else get-low-type a.type)
	as destructure-split
		if is-valid-destructure a
			for part in a.parts
				begin-destructure part
-begin-param-destructure void(a destructure, low-param low-local) lower-and-expr-ctx
	match a
	as destructure-ignore
		()
	as local
		locals[a] := low-param
	as destructure-split
		begin-destructure a
-end-destructure low-local-and-expr
	type low-type
	range uri-and-range
	a destructure
	expr low-expr
do lower-and-expr-ctx
	match a
	as destructure-ignore
		(), expr
	as local
		low-local = remove! locals, a
		if is-allocated a
			root-local low-local = a, get-low-type a.type
			value = gen-reference-create low-local.type, range,
				local-get-low-expr range, root-local
			- root-local
			- let-low-expr range, low-local, value, expr
		else
			low-local, expr
	as destructure-split
		if is-valid-destructure a
			root-local low-local = destruct, get-low-type a.type
			- root-local
			- end-destructure-split type, range, expr, a, root-local
		else
			- ()
			- lower-bogus type, range
-end-param-destructure low-expr
	type low-type
	range uri-and-range
	destructure destructure
	root-local low-local
	expr low-expr
do lower-and-expr-ctx
	match destructure
	as destructure-ignore
		expr
	as local
		forbid is-allocated destructure
		expr
	as destructure-split
		end-destructure-split type, range, expr, destructure, root-local
-end-destructure-split low-expr
	type low-type
	range uri-and-range
	expr low-expr
	x destructure-split
	root-local low-local
do lower-and-expr-ctx
	# TODO: we should detect this earlier and make the entire expression fail
	do if is-valid-destructure x else lower-bogus type, range
	get-root-local = local-get-low-expr range, root-local
	res mut = expr
	fields = root-local.type.body.low-record!.fields
	for field, part in zip fields, x.parts
		part-range = to-uri-and-range part.range
		its-value = gen-record-field-get part-range, get-root-local, field
		its-local-and-expr = end-destructure type, part-range, part, res
		res := its-local-and-expr.expr
		if l = its-local-and-expr.local
			res := let-low-expr part-range, l, its-value, res
	res

-is-allocated low-type?(a local) lower-expr-ctx
	the::lower-expr-ctx.allocated-locals[a]

-lower-if low-expr(type low-type, range uri-and-range, a if-expr) lower-and-expr-ctx
	lower-if range, a.condition, {lower-expr type, a.true-branch}, {lower-expr type, a.false-branch}

-lower-if low-expr
	range uri-and-range
	condition expr
	true-branch low-expr mut()
	false-branch low-expr mut()
do lower-and-expr-ctx
	with-lower-condition range, condition, of cond
		if cond.constant-low-expr
			if as-bool cond.value then true-branch[] else false-branch[]
		else
			if-low-expr range, cond, true-branch[], false-branch[]

-with-lower-condition low-expr
	range uri-and-range
	expr expr
	f low-expr mut(condition low-expr)
do lower-and-expr-ctx
	cond = lower-condition range, expr, ()
	res mut = f[cond.condition]
	for local, value in reverse cond.locals
		res := let-low-expr range, local, value, res
	res

-lower-condition-to-expr low-expr
	range uri-and-range
	expr expr
do lower-and-expr-ctx
	with-lower-condition range, expr, {it}

-lower-condition-result record
	condition low-expr
	locals (low-local, low-expr)[]
-lower-condition lower-condition-result
	range uri-and-range
	expr expr
	prev lower-condition-result?
do lower-and-expr-ctx
	if logical-expr expr and expr.kind == bool-and-bool
		lower-condition range, expr.right,
			lower-condition range, expr.left, prev
	elif unpack-option expr
		option = lower-expr expr.option
		temp low-local = temp::low-generated-local-kind, option.type
		option-with-prev low-expr = if prev
			if-low-expr range, prev.condition, option, gen-empty-option option.type, range
		else
			option
		get-temp = local-get-low-expr range, temp
		condition: gen-option-is-non-empty get-temp
		locals:
			-- prev.?locals else ()
			- temp, option-with-prev
			-- locals-for-option expr.destructure, get-temp
	else
		cond = lower-expr bool, expr
		if prev
			condition: gen-and range, prev.condition, cond
			locals: prev.locals
		else
			cond, ()

-locals-for-option (low-local, low-expr)[](a destructure, option-expr low-expr) lower-and-expr-ctx
	match a
	as destructure-ignore
		()
	as local
		forbid is-allocated a else todo
		local low-local = a, option-expr.type.as-option!
		locals[a] := local
		- local, union-as-case-or-gc-safe-low-expr local.type, (cur-uri, a.range), option-expr
	as destructure-split
		assert is-valid-destructure a else todo
		non-option-expr = gen-assert-option option-expr
		fields = non-option-expr.type.body.low-record!.fields
		for* field, part in zip fields, a.parts
			optional-field-type = get-low-type option[part.type]
			range uri-and-range = cur-uri, part.range
			optional-field = if-low-expr range, option-expr.gen-option-is-non-empty,
				then_: gen-option optional-field-type, range,
					gen-record-field-get range, non-option-expr, field
				else_: gen-empty-option optional-field-type, range
			locals-for-option part, optional-field

-gen-assert-option low-expr(option low-expr) lower-ctx
	union-assume-case-low-expr option.type.as-option!, option.range, option

-gen-option-is-non-empty low-expr(option low-expr) lower-ctx
	union-is-case-low-expr option.range, option, 1

-gen-option-else low-expr(type low-type, range uri-and-range, option low-expr, else_ low-expr) lower-ctx
	gen-if-option range, option,
		then_: with get in with-local option.type.as-option!, range
			may-widen-type type, get
		else_: else_

-branches record(then_ low-local-and-expr, else_ low-expr)
-new branches(then_ low-expr, else_ low-expr)
	then_: ((), then_)::low-local-and-expr
	else_: else_
-gen-if-option low-expr(range uri-and-range, option low-expr, branches branches) low-common-types
	then_ = branches.then_
	else_ = branches.else_
	if x = then_.local
		option-local low-local = member2::low-generated-local-kind, option.type
		get-option-local low-expr = local-get-low-expr range, option-local
		let-low-expr range, option-local, option,
			cast-option = union-assume-case-low-expr x.type, range, get-option-local
			cases low-expr[] =
				- else_
				- let-low-expr then_.expr.range, x, cast-option, then_.expr
			match-union-low-expr range, get-option-local, (0, 1), cases, ()
	else
		cases low-expr[] = else_, then_.expr
		match-union-low-expr range, option, (0, 1), cases, ()

-lower-literal-string-like constant
	type low-type
	kind string-like-type
	value string
do lower-ctx
	match kind
	as char8-array
		constant-char8-array type, value
	as char32-array
		constant-char32-array type, value
	as java-String
		constant-native-string value
	as js-any
		constant-native-string value
	as string
		constant-string value
	as symbol
		constant-symbol value.to

-lower-local-get low-expr
	type low-type
	range uri-and-range
	local local
	type-refinements type-args
do lower-and-expr-ctx
	low-local = locals[local]!
	do unless is-bogus local.type else lower-bogus type, range
	get-local = local-get-low-expr range, low-local
	with-refinements type-refinements, if is-allocated local
		gen-reference-read range, get-local
	else
		get-local

-with-refinements low-expr(type-refinements type-args, unrefined low-expr) lower-and-expr-ctx
	res mut low-expr = unrefined
	for t in type-refinements
		res := union-assume-case-low-expr t.get-low-type, res.range, res
	res

-lower-local-set low-expr
	range uri-and-range
	local local
	value expr
do lower-and-expr-ctx
	low-local = locals[local]!
	value-type = if is-allocated local
		get-referenced-type low-local.type
	else
		low-local.type
	low-value = lower-expr value-type, value
	if is-allocated local
		gen-reference-write range, (local-get-low-expr range, low-local), low-value
	else
		local-set-low-expr range, low-local, low-value

-lower-logical low-expr
	outer-type low-type
	type low-type
	model-type type
	range uri-and-range
	a logical-expr
do lower-and-expr-ctx
	match a.kind
	as bool-and-bool
		lower-condition-to-expr range, a
	as bool-or-bool
		left = lower-expr-and-convert-option-to-bool a.left
		right = lower-expr-and-convert-option-to-bool a.right
		gen-or range, left, right
	else
		left-type low-type = match a.kind
		as bool-and-bool
			throw unreachable
		as bool-or-bool
			throw unreachable
		as option-else
			if is-option model-type
				type
			else
				get-low-type option[model-type]
		as option-or
			outer-type
		left = lower-expr left-type, a.left
		right = lower-expr type, a.right
		match a.kind
		as bool-and-bool
			throw unreachable
		as bool-or-bool
			throw unreachable
		as option-else
			gen-option-else type, range, left, right
		as option-or
			temp low-local = member::low-generated-local-kind, type
			get-temp = local-get-low-expr range, temp
			let-low-expr range, temp, left,
				gen-if-option range, get-temp, then_: get-temp, else_: right

-lower-while-or-until-body low-expr
	type low-type
	range uri-and-range
	expr while-or-until-body-expr
do lower-and-expr-ctx
	if is-until expr and not is-bool expr.body.type
		body = lower-expr expr.body
		if as-option body.type
			###
			until
				body
			==>
			loop
				if res = body
					break res
				else
					continue
			###
			loop-low-expr range,
				temp low-local = temp::low-generated-local-kind, body.type
				get-body = local-get-low-expr range, temp
				let-low-expr range, temp, body,
					gen-if-option range, get-body,
						then_: loop-break-low-expr range, gen-assert-option get-body
						else_: loop-continue-low-expr type, range
		else
			# 'until then body' where 'body' is non-optional simplifies to 'body'
			body
	else
		body = lower-expr bool, expr.body
		loop-low-expr range,
			if-low-expr range, body,
				break_ = loop-break-low-expr range, gen-void range
				continue_ = loop-continue-low-expr void, range
				if is-until expr
					then_: break_, else_: continue_
				else
					then_: continue_, else_: break_


-lower-while-or-until low-expr
	type low-type
	range uri-and-range
	expr while-or-until-expr
do lower-and-expr-ctx
	void = gen-void range
	if expr.is-until
		###
		until cond
			body
		after
		==>
		loop
			if cond
				# Put this inside the 'if' so it can access any locals introduced by 'cond'
				break after
			else
				body
				continue
		###
		loop-low-expr range,
			with-lower-condition range, expr.condition, of cond
				if-low-expr range, cond,
					then_: loop-break-low-expr range, lower-expr-or-void type, range, expr.after
					else_: gen-do-and-continue type, range, lower-expr void.type, expr.body
	else
		###
		while cond
			body
		after
		==>
		loop
			if cond
				body
				continue
			else
				break
		after
		###
		seq-low-expr range,
			- loop-low-expr range,
				with-lower-condition range, expr.condition, of cond
					if-low-expr range, cond,
						then_: gen-do-and-continue void.type, range, lower-expr void.type, expr.body
						else_: loop-break-low-expr range, void
			- lower-expr-or-void type, range, expr.after

-lower-match-enum low-expr(type low-type, range uri-and-range, a match-enum-expr) lower-and-expr-ctx
	do unless is-empty a.cases else lower-bogus type, range
	lower-with-opt-local type, range, a.matched-local, a.matched, of matched
		values-unsorted nat64[] = map a.cases, it.member.value
		cases-unsorted low-expr[] = for value in values-unsorted
			case_ = find! a.cases, it.member.value == value
			lower-expr type, case_.then_
		else_ low-expr? = if x = a.else_
			lower-expr type, x
		values, cases = sort-by-first values-unsorted, cases-unsorted
		match-scalar-low-expr range, matched, values.to, cases, else_

-lower-match-integral low-expr
	type low-type
	range uri-and-range
	a match-scalar-expr
do lower-and-expr-ctx
	lower-with-opt-local type, range, a.matched-local, a.matched, of matched
		values-unsorted scalar-value[] = map a.cases, it.value
		# TODO: If matched is a constant, just compile the relevant case
		cases-unsorted low-expr[] = for value in values-unsorted
			case_ = find! a.cases, it.value == value
			lower-expr type, case_.then_
		else_ = lower-expr type, a.else_
		values, cases = sort-by-first values-unsorted, cases-unsorted
		match-scalar-low-expr range, matched, values.to, cases, else_

-lower-match-string-like low-expr
	type low-type
	range uri-and-range
	a match-string-like-expr
do lower-and-expr-ctx
	lower-with-opt-local type, range, a.matched-local, a.matched, of::match-string-like-low-expr matched
		range: range
		matched: matched
		equals: equal-string-like-function a.string-type
		cases: for case_ in a.cases
			- lower-literal-string-like matched.type, a.string-type.to, case_.value
			- lower-expr type, case_.then_
		else_: lower-expr type, a.else_

-lower-match-sum-type low-expr
	type low-type
	range uri-and-range
	a match-sum-type-expr
do lower-and-expr-ctx
	lower-with-opt-local type, range, a.matched-local, a.matched, of matched
		else_ low-expr? = if x = a.else_
			lower-expr type, x
		if is-empty a.cases
			else_ else lower-bogus type, range
		else
			case-indices nat32[] = for x in a.cases
				member-index-for-match-sum-type-case matched.type, x.case-type
			cases low-expr[] = for case_ in a.cases
				lower-expr type, case_.then_
			sorted-indices, sorted-cases = sort-by-first case-indices, cases
			match-union-low-expr range, matched, sorted-indices.to, sorted-cases, else_

-lower-catches (nat32[], low-local-and-expr[], low-local-and-expr?)
	type low-type
	range uri-and-range
	catches catch_[]
do lower-and-expr-ctx
	variant-type low-type = exception
	typed-catches catch_ array-view, catch-else catch_? = if catches[end - 1].caught-type == exception
		catches[0 .. end - 1], catches[end - 1]
	else
		catches, ()
	case-indices nat32[] = for x in typed-catches
		member-index-for-match-sum-type-case variant-type, x.caught-type
	cases low-local-and-expr[] = for catch_ in typed-catches
		lower-expr-with-destructure type, range, catch_.destructure.to, catch_.then_
	sorted-indices, sorted-catches = sort-by-first case-indices, cases
	sorted-indices, sorted-catches, if catch-else
		lower-expr-with-destructure type, range, catch-else.destructure.to, catch-else.then_

-lower-catch (nat32, low-local-and-expr)
	type low-type
	range uri-and-range
	catch_ catch_
do lower-and-expr-ctx
	- member-index-for-match-sum-type-case exception, catch_.caught-type
	- lower-expr-with-destructure type, range, catch_.destructure.to, catch_.then_

-member-index-for-match-sum-type-case nat32(variant-type low-type, type type-inst) lower-and-expr-ctx
	sum-type-case-index variant-type, get-low-type type

-lower-force low-expr
	type low-type
	range uri-and-range
	a force-expr
do lower-and-expr-ctx
	arg = lower-expr a.arg
	gen-option-else type, range, arg,
		throw-low-expr type, range,
			gen-error range,
				the show-ctx = show-ctx
				"Option was empty: '{file-content-getters[arg.range].to::string}'"

-lower-assert-or-forbid low-expr
	type low-type
	range uri-and-range
	a assert-or-forbid-expr
do lower-and-expr-ctx
	the show-ctx = show-ctx
	throw_ = of::low-expr
		throw-low-expr type, range, if x = a.thrown
			lower-expr exception, x
		else
			gen-error range,
				default-assert-or-forbid-message cur-uri, a, file-content-getters
	after = {lower-expr-or-void range, a.after}
	true-branch low-expr mut(), false-branch low-expr mut() =
		if a.is-forbid then throw_, after else after, throw_
	lower-if range, a.condition, true-branch, false-branch

-lower-expr low-expr(a expr) lower-and-expr-ctx
	lower-expr a.low-type, a

-lower-expr-or-void low-expr(type low-type, range uri-and-range, a expr?) lower-and-expr-ctx
	if a
		lower-expr type, a
	else
		gen-void range
-lower-expr-or-void low-expr(range uri-and-range, a expr?) lower-and-expr-ctx
	if a
		lower-expr a
	else
		gen-void range

lower-expr low-expr(outer-type low-type, a expr) lower-and-expr-ctx
	model-type = a.type
	type = get-low-type model-type
	range = to-uri-and-range a.range
	do unless is-bogus type else lower-bogus type, range
	res = match a
	as assert-or-forbid-expr
		lower-assert-or-forbid type, range, a
	as bogus-call-expr
		lower-bogus type, range
	as bogus-expr
		lower-bogus type, range
	as bogus-wrong-type-expr
		lower-bogus type, range
	as call-expr
		lower-call type, range, a
	as call-named-new-expr
		lower-call-named-new type, range, a
	as call-option-expr
		lower-call-option type, range, a
	as finally-expr
		lower-finally type, range, a
	as force-expr
		lower-force type, range, a
	as if-expr
		lower-if type, range, a
	as is-or-isnt-expr
		type is void
		lower-is-or-isnt range, a
	as lambda-expr
		lower-lambda type, range, a
	as let-expr
		# Use 'outer-type' instead of 'type' here
		# to make the conversion be in the 'then' expression instead of wrapping the whole 'let'.
		# This leads to simpler generated code.
		lower-let outer-type, range, a
	as let-the-expr
		the-type = get-low-type a.the-type
		value = lower-expr the-type, a.value
		local = low-local the_::low-generated-local-kind, the-type
		the::lower-expr-ctx.contexts ~:= local
		let-low-expr range, local, value, lower-expr-or-void type, range, a.then_
	as list-expr
		lower-list type, range, a
	as literal-scalar-expr
		constant-low-expr type, range, a.value
	as literal-string-like-expr
		type, range, lower-literal-string-like type, a.string-type, a.value
	as local-get-expr
		lower-local-get type, range, a.local, ()
	as local-get-and-refine-expr
		lower-local-get type, range, a.local, a.type-refinements
	as local-get-and-call-and-refine-expr
		do if called = get-low-fun-from-called a.called else lower-bogus type, range
		with-refinements a.type-refinements, gen-call range, called,
			- may-widen-type called.params.only!.type,
				lower-local-get called.params.only!.type, range, a.local, a.local-type-refinements
	as local-set-expr
		lower-local-set range, a.local, a.value
	as logical-expr
		lower-logical outer-type, type, model-type, range, a
	as match-enum-expr
		lower-match-enum type, range, a
	as match-scalar-expr
		lower-match-integral type, range, a
	as match-string-like-expr
		lower-match-string-like type, range, a
	as match-sum-type-expr
		lower-match-sum-type type, range, a
	as seq-expr
		first = lower-expr void, a.first
		# See comment on 'as let-expr' for why we use 'outer-type' instead of 'type'
		then_ = lower-expr outer-type, a.then_
		if first.constant-low-expr
			then_
		else
			seq-low-expr range, first.as-seq ~~ then_.as-seq
	as the-expr
		get-the type, range
	as throw-expr
		throw-low-expr type, range, lower-expr exception, a.thrown
	as trusted-expr
		lower-expr type, a.inner
	as try-expr
		lower-try type, range, a
	as try-let-expr
		lower-try-let type, range, a
	as typed-expr
		lower-expr type, a.inner
	as unpack-option
		gen-option-is-non-empty lower-expr a.option
	as while-or-until-expr
		lower-while-or-until type, range, a
	as while-or-until-body-expr
		lower-while-or-until-body type, range, a

	may-widen-type outer-type, res

-get-the low-expr(type low-type, range uri-and-range) lower-expr-ctx
	local-get-low-expr range, get-the-local type
-get-the-local low-local(type low-type) lower-expr-ctx
	find! the::lower-expr-ctx.contexts, it.type == type

-lower-expr-and-convert-option-to-bool low-expr(expr expr) lower-and-expr-ctx
	inner = lower-expr expr
	if is-bool inner.type
		inner
	else
		gen-option-is-non-empty inner

-may-widen-type low-expr(expected-type low-type, actual low-expr) lower-ctx
	try-widen expected-type, actual, true else
		the show-ctx = show-ctx
		where = line-and-column-getters[actual.range]
		log-error "At: {where}, expected type: {show-low-type expected-type}, actual: {show-low-type actual.type}"
		throw unreachable

# Implicitly convert the actual expression to the expected type.
-try-widen low-expr?(expected low-type, actual low-expr, allow-option-to-bool bool) lower-ctx
	if actual.type == expected
		actual
	elif expected-unwrapped = as-option expected
		if res = try-widen expected-unwrapped, actual, false
			gen-option expected, actual.range, res
		elif actual-unwrapped = as-option actual.type
			# 'actual' generates an option.
			temp low-local = member::low-generated-local-kind, actual-unwrapped
			range = actual.range
			if widen-temp = try-widen expected-unwrapped, (local-get-low-expr range, temp), false
				gen-if-option range, actual,
					then_: temp, gen-option expected, range, widen-temp
					else_: gen-empty-option expected, range
	elif u = low-union expected.body
		members low-type[] = if u.has-members
			u.members
		else
			map the::lower-context.sum-types[expected]!.cases, it.case-type
		res = first members.with-index, of member-index, member
			if res = try-widen member, actual, false
				create-union-low-expr expected, actual.range, member-index, res
		res or
			# We don't track all java class members of java interfaces, so just cast them
			# (create-union-low-expr is only needed for non-reference types anyway)
			if u.java-interface then gen-reinterpret-cast expected, actual
	elif is-java-subclass actual.type, expected
		gen-reinterpret-cast expected, actual
	else
		if is-array-view expected and as-array actual.type
			gen-to-array-view actual
		elif is-buffer-view expected and as-buffer actual.type
			gen-to-buffer-view actual
		elif x = as-nat-type expected and y = as-nat-type actual.type and x > y
			builtin-unary-low-expr expected, actual.range, wrap-convert-integral, actual
		elif x = as-int-type expected and y = as-int-type actual.type and x > y
			builtin-unary-low-expr expected, actual.range, wrap-convert-integral, actual
		elif x = as-float-type expected and y = as-float-type actual.type and x > y
			builtin-unary-low-expr expected, actual.range, to-float64-from-float32, actual
		elif allow-option-to-bool and is-bool expected and as-option actual.type
			gen-option-is-non-empty actual
-is-array-view bool(a low-type) common-types
	low-type-source-inst a.source and a.source.decl == array-view
-is-buffer-view bool(a low-type) common-types
	low-type-source-inst a.source and a.source.decl == buffer-view

-is-java-subclass bool(sub low-type, super low-type)
	body = sub.body
	do if low-java-class body and super-class = body.super-class
	super-class == super or is-java-subclass super-class, super

-lower-finally low-expr
	type low-type
	range uri-and-range
	a finally-expr
do lower-and-expr-ctx
	:: finally-low-expr
	range: range
	right: lower-expr void, a.right
	below: lower-expr type, a.below

-lower-try low-expr
	type low-type
	range uri-and-range
	a try-expr
do lower-and-expr-ctx
	tried = lower-expr type, a.tried
	member-indices, cases, else_ = lower-catches type, range, a.catches
	try-low-expr range, tried, member-indices.to, cases, else_

-lower-try-let low-expr
	type low-type
	range uri-and-range
	a try-let-expr
do lower-and-expr-ctx
	local-type = get-low-type a.destructure.type
	value = lower-expr local-type, a.value
	catch-member-index, catch-expr = lower-catch type, range, a.catch_
	then_ = if then_ = a.then_
		lower-expr-with-destructure type, range, a.destructure, then_
	else
		(), gen-void range
	try-let-low-expr range, then_.local, value, catch-member-index, catch-expr, then_.expr
