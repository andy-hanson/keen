import
	../model/low-model
	../model/model
	../util/full-index-map
	../util/util

all-constants-builder record mut
	-symbols constant-symbol mut[symbol]
	-arrs low-array-type-and-constants-builder mut[low-type]
	-records constant-record mut[constant[]] mut[low-type]
	-unions constant-union mut[constant-union-value] mut[low-type]
new all-constants-builder()
	(), (), (), ()

-low-array-type-and-constants-builder record mut
	arr-type low-type
	| The order this was inserted into {arrs}
	type-index nat32
	constants constant[] mut[]

finish-all-constants all-constants(a all-constants-builder)
	arrays low-array-type-and-constants mut[] = for _, x in a.arrs
		# Dummy value. We will actually do it by type-index below
		x.arr-type, ()
	for _, x in a.arrs
		arrays[x.type-index] := x.arr-type, x.constants.move-to

	records (constant-record, constant[]) full-index-map[low-type] = for type, constants in a.records
		lookup constant[][constant-record] = for k, v in constants
			v, k
		res (constant-record, constant[]) full-index-map = for i in 0::nat32 .. lookup.size
			lookup[i,]!
		type, res

	unions (constant-union, constant-union-value) full-index-map[low-type] = for type, constants in a.unions
		lookup constant-union-value[constant-union] = for k, v in constants
			v, k
		res (constant-union, constant-union-value) full-index-map = for i in 0::nat32 .. lookup.size
			lookup[i,]!
		type, res

	symbols-lookup symbol[nat] = for symbol, value in a.symbols then value.index, symbol
	symbols symbol[] = for x in 0::nat .. a.symbols.size then symbols-lookup[x]!
	symbols, arrays.move-to, records, unions

get-constant-array-view constant
	all-constants all-constants-builder
	array-view-type low-type
	array-type low-type
	elements constant[]
do
	get-constant-record all-constants, array-view-type,
		- get-constant-array all-constants, array-type, elements
		- 0::nat.to
		- elements.size.to

get-constant-array constant(all-constants all-constants-builder, array-type low-type, elements constant[])
	assert as-array-or-buffer array-type
	res = ensure all-constants.arrs, array-type, of
		array-type, all-constants.arrs.size, ()
	index = find-index-or-push res.constants, elements # TODO:PERF
	constant-array res.type-index, index

get-constant-string constant(a all-constants-builder, type low-type, value string)
	char8-array = type.body.low-record!.fields.only!.type
	get-constant-record a, type,
		# TODO:PERF this probably costs a lot. Support having a constant array that is represented as a char8[].
		- get-constant-array a, char8-array, map value.to::char8[], it.to

get-constant-symbol constant(a all-constants-builder, value symbol)
	ensure a.symbols, value, {a.symbols.size,}

get-constant-record constant(a all-constants-builder, type low-type, args constant[])
	assert r = type.body.low-record
	forbid prevent-constant r
	r.fields.size is args.size
	records = ensure a.records, type
	ensure records, args, {records.size,}

get-constant-union constant(a all-constants-builder, type low-type, case-index nat32, inner constant)
	assert u = type.body.low-union
	if u.has-members
		assert case-index < u.members.size
	unions = ensure a.unions, type
	ensure unions, (case-index, inner), {unions.size,}
