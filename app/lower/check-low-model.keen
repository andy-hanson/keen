import
	../model/ast
	../model/low-model
	../model/model

check-low-program void(a low-program) low-common-types
	if a.target == java
		for type in a.all-non-extern-types
			match x = body type
			as low-union
				assert are-unique x.members
			else
				()
	the low-program = a
	for fun in a.all-non-extern-funs
		if e = fun.body.low-expr
			check-expr fun.return-type, e

-ctx spec low-program, low-common-types
-program low-program() low-program
	the::low-program

-check-expr void(type low-type, a low-expr) ctx
	if is-bogus a.type
		assert a.throw-low-expr
	else
		forbid is-bogus type
		type is a.type
	match a
	as array-op-low-expr
		out-element = if is-void type then type else as-array-or-buffer! type
		check-expr a.input.type, a.input
		if l = a.local
			l.type is a.in-element
		check-expr out-element, a.body
	as builtin-unary-low-expr
		check-builtin-unary type, a.fun, a.arg
	as builtin-binary-low-expr
		check-builtin-binary type, a.fun, a.arg0, a.arg1
	as builtin-ternary-low-expr
		check-builtin-ternary type, a.fun, a.arg0, a.arg1, a.arg2
	as builtin-java-instanceof-low-expr
		type is bool
		check-expr a.arg.type, a.arg
	as builtin-js-low-expr
		check-builtin-js type, a.fun, a.args
	as call-low-expr
		body = a.called.body
		assert body.low-expr or body.low-fun-body-extern-java or body.low-fun-body-method
		type is a.called.return-type
		for param, arg in zip a.called.params, a.args
			check-expr param.type, arg
	as constant-low-expr
		each-nested-constant program.all-constants, type, a.value, of constant-type, c
			match c
			as constant-record
				assert constant-type.body.low-record
			else
				# TODO
				()
	as create-array-low-expr
		element-type = as-array! type
		for arg in a.args
			check-expr element-type, arg
	as create-record-low-expr
		record_ = type.body.low-record!
		for arg, field in zip a.args, record_.fields
			check-expr field.type, arg
	as create-union-low-expr
		check-expr type.body.low-union!.members[a.case-index], a.arg
	as finally-low-expr
		check-expr void, a.right
		check-expr type, a.below
	as if-low-expr
		check-expr bool, a.cond
		check-expr type, a.then_
		check-expr type, a.else_
	as let-low-expr
		check-expr a.local.type, a.value
		check-expr type, a.then_
	as lambda-low-expr
		assert return-type, param-type = as-lambda-type type
		a.param.type is param-type
		check-expr return-type, a.body
	as local-get-low-expr
		type is a.local.type
	as local-set-low-expr
		assert is-void type
		check-expr a.local.type, a.value
	as loop-low-expr
		check-expr type, a.body
	as loop-break-low-expr
		check-expr type, a.value
	as loop-continue-low-expr
		()
	as match-scalar-low-expr
		assert is-sorted a.case-values
		_ = matched-integral-type a
		a.case-values.size is a.case-exprs.size
		check-expr-any-type a.matched
		for case_ in a.case-exprs
			check-expr type, case_
		if e = a.else_
			check-expr type, e
	as match-string-like-low-expr
		check-expr-any-type a.matched
		a.equals.return-type is bool
		a.equals.params.size is 2
		assert every a.equals.params, it.type == a.matched.type
		for case_ in a.cases
			check-expr type, case_.then_
		check-expr type, a.else_
	as match-union-low-expr
		assert is-sorted a.case-indices
		forbid is-empty a.cases
		check-expr-any-type a.matched
		case-types = a.union_.members
		assert a.case-indices.size <= case-types.size
		a.cases.size is a.case-indices.size
		for case_ in a.cases
			check-expr type, case_
		if e = a.else_
			check-expr type, e
	as new-interface-low-expr
		methods = the::low-program.method-impls[type]!.methods
		for method in methods
			arg = a.args[method.body.low-fun-body-method!.method-index]
			params = method.params[1 .. end]
			assert return-type, param-type = as-lambda-type arg.type
			method.return-type is return-type
			match params.size
			as 0
				assert is-void param-type
			as 1
				params.only!.type is param-type
			else
				for param, pt in zip params, param-type.source.low-type-source-inst!.type-args
					param.type is pt
		for arg in a.args
			check-expr-any-type arg
	as record-field-get-low-expr
		check-expr-any-type a.record_
		a.field.type is type
	as record-field-set-low-expr
		assert is-void type
		check-expr-any-type a.record_
		check-expr a.field.type, a.value
	as seq-low-expr
		for part in a.parts[0 .. end - 1]
			check-expr void, part
		check-expr type, a.parts[end - 1]
	as throw-low-expr
		check-expr exception, a.thrown
	as try-low-expr
		check-expr type, a.tried
		check-catches type, exception, a.exception-member-indices, a.catch-cases
	as try-let-low-expr
		assert not a.local or a.local.type == a.value.type
		check-expr a.value.type, a.value
		check-catches type, exception, a.exception-member-index.to, (a.catch_,)
		check-expr type, a.then_
	as union-assume-case-low-expr
		assert contains a.union_.members, type
		check-expr a.union-type, a.arg
	as union-as-case-or-gc-safe-low-expr
		assert contains a.union_.members, type
		check-expr a.union-type, a.arg
	as union-is-case-low-expr
		type is bool
		check-expr a.union-type, a.arg
	as var-get-low-expr
		type is a.var.type
	as var-set-low-expr
		assert is-void type
		check-expr a.var.type, a.value

-check-catches void
	type low-type
	union_ low-type
	member-indices indices
	cases low-local-and-expr[]
do ctx
	cases.size is member-indices.size
	members = union_.union-members
	for case-index, case_ in with-index cases
		check-local-and-expr type, members[member-indices[case-index]], case_

-check-local-and-expr void(type low-type, local-type low-type, a low-local-and-expr) ctx
	if local = a.local
		local.type is local-type
	check-expr type, a.expr

-union-members low-type[](type low-type)
	type.body.low-union!.members

-check-expr-any-type void(expr low-expr) ctx
	check-expr expr.type, expr

-as-lambda (mutability, low-type, low-type)?(a low-type)
	source = a.source.low-type-source-inst!
	do if mutability = as-lambda-type source.decl
	return-type, param-type = only2! source.type-args
	mutability, return-type, param-type

-check-builtin-unary void(type low-type, fun low-builtin-unary, a low-expr) ctx
	check = of return-type low-type, arg-type low-type
		type is return-type
		check-expr arg-type, a
	match fun
	as array-size
		type is nat32
		assert as-array-or-buffer a.type
		check-expr a.type, a
	as bits-of-float32
		check[nat32, float32]
	as bits-of-float64
		check[nat64, float64]
	as bitwise-not
		assert as-integral-type type
		check-expr type, a
	as count-ones
		type is nat32
		assert as-nat-type a.type
		check-expr a.type, a
	as drop
		type is void
		check-expr a.type, a
	as float32-from-bits
		check[float32, nat32]
	as float64-from-bits
		check[float64, nat64]
	as uninitialized-buffer
		assert as-array-or-buffer type
		check-expr nat32, a
	as not
		check[bool, bool]
	as reinterpret-cast
		check-expr a.type, a
	as to-float32-from-float64
		check[float32, float64]
	as to-float64-from-float32
		check[float64, float32]
	as to-float-from-integral
		assert as-float-type type
		assert as-integral-type a.type
		check-expr a.type, a
	as truncate-to-int64-from-float64
		check[int64, float64]
	as weak-ref-get
		as-option! type is as-weak-ref! a.type
		check-expr a.type, a
	as weak-ref-new
		a.type is as-weak-ref! type
		check-expr a.type, a
	as wrap-convert-integral
		assert as-integral-type-allow-char type
		assert is-bool a.type or as-integral-type-allow-char a.type
		check-expr a.type, a

-check-builtin-binary void
	type low-type
	fun low-builtin-binary
	a low-expr
	b low-expr
do ctx
	check = of return-type low-type, a-type low-type, b-type low-type
		type is return-type
		check-expr a-type, a
		check-expr b-type, b
	binary-integral = of
		assert as-integral-type type
		check-expr type, a
		check-expr type, b
	binary-float = of
		assert as-float-type type
		check-expr type, a
		check-expr type, b
	binary-float-or-integral = of
		assert as-float-type type or as-integral-type type
		check-expr type, a
		check-expr type, b
	compare-primitive = of
		assert is-bool type
		assert is-bool a.type or is-char8-or-32 a.type or as-integral-type a.type or as-float-type a.type
		check-expr a.type, a
		check-expr a.type, b
	match fun
	as bitwise-and
		binary-integral[]
	as bitwise-or
		binary-integral[]
	as bitwise-xor
		binary-integral[]
	as call-lambda
		assert _, return-type, param-type = as-lambda a.type
		type is return-type
		check-expr a.type, a
		check-expr param-type, b
	as compare
		# TODO: returns 'comparison'
		a.type is b.type
		check-expr a.type, a
		check-expr b.type, b
	as compare-less
		compare-primitive[]
	as compare-less-or-equal
		compare-primitive[]
	as compare-greater
		compare-primitive[]
	as compare-greater-or-equal
		compare-primitive[]
	as equal-exact
		check[bool, a.type, a.type]
	as equal-float-ieee
		compare-primitive[]
	as less-float-ieee
		compare-primitive[]
	as not-equal-exact
		check[bool, a.type, b.type]
	as rotate-left
		binary-integral[]
	as rotate-right
		binary-integral[]
	as unsafe-add-float
		binary-float[]
	as unsafe-at
		type is as-array-or-buffer! a.type
		check-expr a.type, a
		check-expr nat32, b
	as unsafe-bit-shift-left
		binary-integral[]
	as unsafe-bit-shift-right
		binary-integral[]
	as unsafe-div
		binary-float-or-integral[]
	as unsafe-mod
		binary-float-or-integral[]
	as unsafe-mul-float
		binary-float[]
	as unsafe-sub-float
		binary-float[]
	as wrap-add
		binary-integral[]
	as wrap-mul
		binary-integral[]
	as wrap-sub
		binary-integral[]

-check-builtin-ternary void
	type low-type
	fun low-builtin-ternary
	a low-expr
	b low-expr
	c low-expr
do ctx
	match fun
	as unsafe-set-at
		type is void
		check-expr a.type, a
		check-expr nat32, b
		check-expr a.type.as-buffer!, c

-check-builtin-js void(type low-type, fun js-fun, args low-expr[]) ctx
	js-any = program.common-funs.low-common-funs-js!.js-any
	js-args = of
		for::void arg in args
			check-expr js-any, arg
	all-js = of
		type is js-any
		js-args[]
	bool-from-js = of
		type is bool
		js-args[]
	match fun
	as await
		all-js[]
	as call
		all-js[]
	as call-new
		all-js[]
	as call-property
		all-js[]
	as call-property-spread
		type is js-any
		a, name, xs = only3! args
		check-expr js-any, a
		check-expr js-any, name
		assert as-array xs.type
		check-expr xs.type, xs
	as eq-eq-eq
		bool-from-js[]
	as eval
		all-js[]
	as subscript
		all-js[]
	as import_
		all-js[]
	as instanceof
		bool-from-js[]
	as js-global
		all-js[]
	as null
		type is js-any
		assert is-empty args
	as plus
		all-js[]
	as set-subscript
		type is void
		js-args[]
	as typeof
		all-js[]
	as undefined
		type is js-any
		assert is-empty args
