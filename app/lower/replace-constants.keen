import
	../model/low-model
	../model/model
	./all-constants-builder
	./lower-ctx
	./generate

replace-constants void() lower-ctx
	ctx = the::lower-context
	assert is-empty ctx.all-unprocessed-low-funs
	constants-map constant mut[low-fun] = for* fun in ctx.all-processed-low-funs
		body = fun.body
		if body.low-expr and body.constant-low-expr
			- fun, body.value
	do while
	added-any-new-constants mut = false
	for fun in ctx.all-processed-low-funs
		do if new-body = replace-constants-in-function fun, constants-map
		fun.body := new-body
		do if new-body.constant-low-expr
		constants-map[fun] := new-body.value
		added-any-new-constants := true
	added-any-new-constants

-replace-constants-in-function low-expr?(fun low-fun, constants-map constant mut[low-fun]) lower-ctx
	body = fun.body
	do if body.low-expr
	the replace-constants-specific-ctx = constants-map, ()
	replace-constants body

-replace-constants-ctx spec lower-ctx, replace-constants-specific-ctx
-replace-constants-specific-ctx record mut
	constants-map constant mut[low-fun]
	constant-locals constant mut[low-local]
-constants-map constant mut[low-fun]() replace-constants-specific-ctx
	the::replace-constants-specific-ctx.constants-map
-constant-locals constant mut[low-local]() replace-constants-specific-ctx
	the::replace-constants-specific-ctx.constant-locals
-replace-constants low-expr?(a low-expr) replace-constants-ctx
	type = a.type
	range = a.range
	match a
	as array-op-low-expr
		do if input, body = replace-constants-in-args-exprs a.input, a.body
		array-op-low-expr type, range, input, a.local, a.empty-out-array, body
	as builtin-unary-low-expr
		do if new-arg = replace-constants a.arg
		builtin-unary-low-expr type, range, a.fun, new-arg
	as builtin-binary-low-expr
		do if new-arg0, new-arg1 = replace-constants-in-args-exprs a.arg0, a.arg1
		builtin-binary-low-expr type, range, a.fun, new-arg0, new-arg1
	as builtin-ternary-low-expr
		do if new-arg0, new-arg1, new-arg2 = replace-constants-in-args-exprs a.arg0, a.arg1, a.arg2
		builtin-ternary-low-expr type, range, a.fun, new-arg0, new-arg1, new-arg2
	as builtin-js-low-expr
		do if new-args = replace-constants-in-args-exprs a.args
		builtin-js-low-expr type, range, a.fun, new-args
	as call-low-expr
		if res = constants-map[a.called]
			type, range, res
		elif args = replace-constants-in-args-exprs a.args
			if constants = as-constants args
				if constant = try-eval-constant a.called, constants
					type, range, constant
				else
					call-low-expr range, a.called, args
			else
				call-low-expr range, a.called, args
		elif constants = as-constants a.args and c = try-eval-constant a.called, constants
			type, range, c
	as constant-low-expr
		()
	as create-array-low-expr
		do if args = replace-constants-in-args a.args
		match args
		as constants
			type, range, get-constant-array all-constants, type, args.constants
		as exprs
			create-array-low-expr type, range, args.exprs
	as create-record-low-expr
		do if args = replace-constants-in-args a.args, not type.body.low-record!.prevent-constant
		match args
		as constants
			type, range, get-constant-record all-constants, type, args.constants
		as exprs
			create-record-low-expr type, range, args.exprs
	as create-union-low-expr
		do if arg = replace-constants a.arg
		if arg.constant-low-expr
			type, range, get-constant-union all-constants, type, a.case-index, arg.value
		else
			create-union-low-expr type, range, a.case-index, arg
	as finally-low-expr
		do if right, below = replace-constants-in-args-exprs a.right, a.below
		finally-low-expr range, right, below
	as if-low-expr
		do if cond, then_, else_ = replace-constants-in-args a.cond, a.then_, a.else_
		if cond.constant-low-expr
			if as-bool cond.value then then_ else else_
		else
			if-low-expr range, cond, then_, else_
	as let-low-expr
		if value = (replace-constants a.value or if a.value.constant-low-expr then a.value)
			if not is-mutable a.local and value.constant-low-expr
				constant-locals[a.local] := value.value
				replace-constants a.then_ else a.then_
			else
				let-low-expr range, a.local, value, (replace-constants a.then_ else a.then_)
		elif then_ = replace-constants a.then_
			let-low-expr range, a.local, a.value, then_
	as lambda-low-expr
		do if body = replace-constants a.body
		new-closure low-local[] = filter a.closure, constant-locals[it].not
		lambda-low-expr type, range, new-closure, a.param, body
	as local-get-low-expr
		if c = constant-locals[a.local]
			type, range, c
	as local-set-low-expr
		do if value = replace-constants a.value
		local-set-low-expr range, a.local, value
	as loop-low-expr
		do if body = replace-constants a.body
		loop-low-expr range, body
	as loop-break-low-expr
		do if value = replace-constants a.value
		loop-break-low-expr range, value
	as loop-continue-low-expr
		()
	as match-scalar-low-expr
		matched = replace-constants a.matched
		cases = replace-constants-in-args-exprs a.case-exprs
		else_ = ?replace-constants a.else_
		do if matched or cases or else_
		# TODO: if 'matched' is a constant, use just that branch
		:: match-scalar-low-expr
		range: range
		matched: matched else a.matched
		case-values: a.case-values
		case-exprs: cases else a.case-exprs
		else_: else_ or a.else_
	as match-string-like-low-expr
		matched = replace-constants a.matched
		# TODO: if 'matched' is a constant, use just that branch
		updated-case mut = false
		cases low-match-string-like-case[] = for case_ in a.cases
			then_ = replace-constants case_.then_
			updated-case := updated-case or then_
			value: case_.value
			then_: then_ else case_.then_
		else_ = replace-constants a.else_
		do if matched or updated-case or else_
		:: match-string-like-low-expr
		range: range
		matched: matched else a.matched
		equals: a.equals
		cases: cases
		else_: else_ else a.else_
	as match-union-low-expr
		matched = replace-constants a.matched
		# TODO: if 'matched' is a constant, use just that branch
		cases = replace-constants-in-match-union-cases a.cases
		else_ = ?replace-constants a.else_
		do if matched or cases or else_
		:: match-union-low-expr
		range: range
		matched: matched else a.matched
		case-indices: a.case-indices
		cases: cases else a.cases
		else_: else_ or a.else_
	as record-field-get-low-expr
		do if record_ = replace-constants a.record_
		# TODO: For a constant record, get the constant field value
		record-field-get-low-expr range, record_, a.field-index
	as record-field-set-low-expr
		do if record_, value = replace-constants-in-args-exprs a.record_, a.value
		record-field-set-low-expr range, record_, a.field-index, value
	as seq-low-expr
		do if new-parts = replace-constants-in-args-exprs a.parts
		without-constants low-expr[] = for* index, part in with-index new-parts
			if index == new-parts.size - 1 or not constant-low-expr part
				- part
		# TODO: should not need type annotation
		:: low-expr
		without-constants.only else seq-low-expr range, without-constants
	as throw-low-expr
		do if thrown = replace-constants a.thrown
		throw-low-expr type, range, thrown
	as try-low-expr
		tried = replace-constants a.tried
		cases = replace-constants-in-catches a.catch-cases
		catch-else = ?replace-constants-in-local-and-expr a.catch-else
		do if tried or cases or catch-else
		:: try-low-expr
		range: range
		tried: tried else a.tried
		exception-member-indices: a.exception-member-indices
		catch-cases: cases else a.catch-cases
		catch-else: catch-else or a.catch-else
	as try-let-low-expr
		# TODO: if value is constant, the local is constant too (like for let-low-expr)
		value = replace-constants a.value
		catch_ = replace-constants-in-local-and-expr a.catch_
		then_ = replace-constants a.then_
		do if value or catch_ or then_
		:: try-let-low-expr
		range: range
		local: a.local
		value: value else a.value
		exception-member-index: a.exception-member-index
		catch_: catch_ else a.catch_
		then_: then_ else a.then_
	as union-assume-case-low-expr
		# TODO:PERF If the arg is a constant union, assert the case here and emit just the case
		do if arg = replace-constants a.arg
		union-assume-case-low-expr type, range, arg
	as union-as-case-or-gc-safe-low-expr
		# TODO:PERF If the arg is a constant union, assert the case here and emit just the case (or gc-safe-value)
		do if arg = replace-constants a.arg
		union-as-case-or-gc-safe-low-expr type, range, arg
	as union-is-case-low-expr
		# TODO:PERF If the arg is a constant union, check it here and emit a constant bool
		do if arg = replace-constants a.arg
		union-is-case-low-expr range, arg, a.case-index
	as var-get-low-expr
		()
	as var-set-low-expr
		do if value = replace-constants a.value
		var-set-low-expr range, a.var, value

-replace-constants-in-match-union-cases low-expr[]?(cases low-expr[]) replace-constants-ctx
	any mut = false
	res low-expr[] = for case_ in cases
		replaced = replace-constants case_
		any := any or replaced
		replaced else case_
	if any then res
-replace-constants-in-catches low-local-and-expr[]?(cases low-local-and-expr[]) replace-constants-ctx
	any mut = false
	res low-local-and-expr[] = for case_ in cases
		replaced = replace-constants-in-local-and-expr case_
		any := any or replaced
		replaced else case_
	if any then res
-replace-constants-in-local-and-expr low-local-and-expr?(case_ low-local-and-expr) replace-constants-ctx
	if expr = replace-constants case_.expr
		case_.local, expr

-constants-or-exprs union(constants, exprs)
-constants record(constants constant[])
-exprs record(exprs low-expr[])

-replace-constants-in-args constants-or-exprs?(a low-expr[]) replace-constants-ctx
	replace-constants-in-args a, true
-replace-constants-in-args constants-or-exprs?(a low-expr[], allow-constants bool) replace-constants-ctx
	if x = replace-constants-in-args-exprs a
		if allow-constants and cs = as-constants x
			constants cs
		else
			exprs x
	elif allow-constants and x = as-constants a
		constants x
-replace-constants-in-args-exprs (low-expr, low-expr)?
	a low-expr
	b low-expr
do replace-constants-ctx
	?only2 replace-constants-in-args-exprs (a, b)
-replace-constants-in-args-exprs (low-expr, low-expr, low-expr)?
	a low-expr
	b low-expr
	c low-expr
do replace-constants-ctx
	?only3 replace-constants-in-args-exprs (a, b, c)
-replace-constants-in-args (low-expr, low-expr, low-expr)?
	a low-expr
	b low-expr
	c low-expr
do replace-constants-ctx
	?only3 replace-constants-in-args-exprs (a, b, c)
-replace-constants-in-args-exprs low-expr[]?(a low-expr[]) replace-constants-ctx
	any mut = false
	res low-expr[] = for x in a
		if updated = replace-constants x
			any := true
			updated
		else
			x
	if any then res

-try-eval-constant constant?(fn low-fun, args constant[]) lower-ctx
	match body = fn.body
	as low-expr
		eval-as-constant fn, body, args
	as low-fun-body-extern-java
		()
	as low-fun-body-method
		()
	as low-fun-body-deferred
		()
	as low-fun-body-always-inline
		throw unreachable
	as low-builtin-unary
		()
	as low-builtin-binary
		()
	as low-builtin-ternary
		()
	as js-fun
		()
-eval-as-constant constant?(fn low-fun, a low-expr, fn-args constant[]) lower-ctx
	match a
	as constant-low-expr
		a.value
	as create-record-low-expr
		unless prevent-constant a.type.body.low-record!
			if args constant[] = map-every a.args, of arg then eval-as-constant fn, arg, fn-args
				get-constant-record all-constants, a.type, args
	as local-get-low-expr
		assert index = index-of fn.params, a.local
		fn-args[index]
	else
		() # TODO
