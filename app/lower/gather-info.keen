import
	../frontend/show-model
	../model/low-model
	../model/model

low-fun-info record
	all-used-funs low-fun set
	async low-async-info?

gather-info low-fun-info
	common-funs low-common-funs
	all-funs low-fun[]
	all-vars low-var[]
	method-impls low-method-info[low-type]
do show-ctx, low-common-types
	called-by = build-called-by all-funs, all-vars, method-impls
	all-used-funs = get-used-funs common-funs, all-vars, called-by, method-impls
	async low-async-info? = if common-funs.low-common-funs-js
		get-async-funs all-used-funs, all-vars, called-by
	all-used-funs, async

-get-used-funs low-fun set
	common-funs low-common-funs
	all-vars low-var[]
	called-by calls-info
	method-impls low-method-info[low-type]
do
	start-funs low-fun set = with out in build
		from-common-funs low-fun[] = match x = common-funs
		as low-common-funs-java
			x.main, x.show-exception, x.to-symbol-from-string, x.start-runtime, x.stop-runtime
		as low-common-funs-js
			x.main, x.show-exception, x.to-symbol-from-string, x.to-string-from-js-any
		out ~~= from-common-funs
		# TODO: We should first find which vars are used
		for var in all-vars
			for v in called-by.var-calls[var] else ()
				out ~= v.called
		# All Java interface methods might be used, so force generating implementations
		for sum-type, impls in method-impls
			if sum-type.body.low-union!.java-interface
				out ~~= impls.methods
	res low-fun mut[] = start-funs.to::low-fun[].to
	set low-fun mut-set = start-funs.to
	to-propagate low-fun mut[] = start-funs.to::low-fun[].to
	until is-empty to-propagate
		fun = pop! to-propagate
		for x in called-by.calls[fun] else ()
			called = x.called
			if try-add set, called
				res ~= called
				to-propagate ~= called
	res.move-to.to

-temp-async-kind enum(depends-on-caller, always-async)
- == bool(a temp-async-kind, b temp-async-kind)
- <=> comparison(a temp-async-kind, b temp-async-kind)

-get-async-funs low-async-info
	all-used-funs low-fun set
	all-used-vars low-var[]
	called-by calls-info
do low-common-types
	temp-kinds temp-async-kind mut[low-fun] = ()
	to-propagate low-fun mut[] = ()

	# TODO:PERF we already went over all funs when generating 'called-by'.
	# Should do this as part of that to avoid having to walk all funs again.
	for fun in all-used-funs
		reason = find-direct-async fun
		kind temp-async-kind? = reason.?to
		if kind > temp-kinds[fun]
			temp-kinds[fun] := kind!
			to-propagate ~= fun

	until is-empty to-propagate
		fun = pop! to-propagate
		its-kind = temp-kinds[fun]!
		for x in called-by.called-by[fun] else ()
			caller = x.caller
			do if all-used-funs[caller] # TODO: can we just not put these in callers then?
			new-kind = propagation-kind its-kind, x
			if new-kind > temp-kinds[caller]
				temp-kinds[caller] := new-kind!
				to-propagate ~= caller

	used-depends-on-caller = calc-used-depends-on-caller all-used-funs, called-by, temp-kinds

	async-funs async-kind[low-fun] = for* fun, kind in temp-kinds
		out-kind async-kind? = match kind
		as depends-on-caller
			uses = used-depends-on-caller[fun]!
			if uses == used-sync | used-async
				sync-and-async
			elif uses == used-sync
				()
			elif uses == used-async
				always-async
			else
				throw unreachable
		as always-async
			always-async
		if out-kind
			- fun, out-kind
	funs: async-funs
	# TODO: this is not right.
	# The correct way to do this is basically consider each low-var as if it is a fun,
	# since accessing it might run the initializer.
	var-initializers: filter all-used-vars, of x
		# TODO: This should use 'called-by.var-calls' instead of searching again
		search-async x.initializer, async-funs

-uses flags(used-sync, used-async)
- == bool(a uses, b uses)
-calc-used-depends-on-caller uses[low-fun]
	all-used-funs low-fun set
	called-by calls-info
	async-kinds temp-async-kind mut[low-fun]
do
	# This will only contain 'depends-on-caller' functions
	to-propagate low-fun mut[] = ()
	res uses mut[low-fun] = ()

	for fun in all-used-funs
		do if calls = called-by.calls[fun]
		do if use uses =
			if ak = async-kinds[fun]
				match ak
				as depends-on-caller
					() # Do nothing so far
				as always-async
					used-async
			else
				used-sync
		for x in calls
			called = x.called
			if async-kinds[called] == depends-on-caller and try-add res, called, use
				to-propagate ~= called

	until is-empty to-propagate
		fun = pop! to-propagate
		do if calls = called-by.calls[fun]
		uses = res[fun]!
		for x in calls
			called = x.called
			if async-kinds[called] == depends-on-caller and try-add res, called, uses
				to-propagate ~= called

	res.move-to

-try-add bool(res uses mut[low-fun], key low-fun, used uses)
	should-add = !(cur = res[key] and cur[used])
	if should-add
		res[key] := (res[key] else ()) | used
	should-add

-search-async bool(a low-expr, async-funs async-kind[low-fun])
	here bool = match a
	as builtin-binary-low-expr
		!!(intrinsic-async-kind a.fun, a.arg0, (), ())
	as builtin-js-low-expr
		!!(intrinsic-async-kind a.fun)
	as call-low-expr
		!!async-funs[a.called]
	else
		false
	here or some a.direct-child-exprs, of x then search-async x, async-funs

-directly-async-reason enum(calls-lambda-parameter, calls-other-lambda, js-await)
-to temp-async-kind(a directly-async-reason)
	match a
	as calls-lambda-parameter
		depends-on-caller
	as calls-other-lambda
		always-async
	as js-await
		always-async
- == bool(a directly-async-reason, b directly-async-reason)
- <=> comparison(a directly-async-reason, b directly-async-reason)

-find-direct-async directly-async-reason?(a low-fun)
	match body = a.body
	as low-expr
		intrinsic-async-kind body, a.params.to, ()
	as low-fun-body-extern-java
		throw unreachable
	as low-fun-body-method
		throw todo
	as low-fun-body-deferred
		throw unreachable
	as low-fun-body-always-inline
		throw unreachable
	as low-builtin-unary
		()
	as low-builtin-binary
		match body
		as call-lambda
			calls-lambda-parameter
		else
			()
	as low-builtin-ternary
		()
	as js-fun
		intrinsic-async-kind body

-intrinsic-async-kind directly-async-reason?(a low-expr, params low-local set, local-lambda-locals low-local set)
	from-children = of
		max mut directly-async-reason? = ()
		for x in direct-child-exprs a
			max := max max, intrinsic-async-kind x, params, local-lambda-locals
		max
	match a
	as builtin-binary-low-expr
		max from-children[], intrinsic-async-kind a.fun, a.arg0, params, local-lambda-locals
	as builtin-js-low-expr
		max from-children[], intrinsic-async-kind a.fun
	as let-low-expr
		from-value = intrinsic-async-kind a.value, params, local-lambda-locals
		new-locals = match a.value
		as lambda-low-expr
			local-lambda-locals ~ a.local
		else
			local-lambda-locals
		max from-value, intrinsic-async-kind a.then_, params, new-locals
	else
		from-children[]
-intrinsic-async-kind directly-async-reason?
	a low-builtin-binary
	arg0 low-expr
	params low-local set
	local-lambda-locals low-local set
do
	match a
	as call-lambda
		match arg0
		as local-get-low-expr
			if params[arg0.local]
				calls-lambda-parameter
			elif local-lambda-locals[arg0.local]
				# Function is calling a lambda it defined, and we trace its body anyway
				()
			else
				# Unhandled case, pessimistically assume this is async
				calls-other-lambda
		else
			calls-other-lambda
	else
		()
-intrinsic-async-kind directly-async-reason?(a js-fun)
	if a == await or a == import_
		js-await

-calls-info record
	calls call-kind[][low-fun]
	var-calls call-kind[][low-var]
	called-by caller[][low-fun]

-build-called-by calls-info
	all-funs low-fun[]
	all-vars low-var[]
	method-impls low-method-info[low-type]
do show-ctx
	calls call-kind mut[] mut[low-fun] = ()
	called-by caller mut[] mut[low-fun] = ()
	for fun in all-funs
		match x = fun.body
		as low-expr
			build-called-by-recur calls, called-by, fun, x
		as low-fun-body-extern-java
			()
		as low-fun-body-method
			method-info = method-impls[fun.params[0].type]!
			new-method-index = index-of! method-info.methods, fun
			assert new-method-index <= x.method-index # some methods may be omitted
			for impls in method-info.cases
				if impl = impls[new-method-index]
					(ensure calls, fun) ~= call-kind-method-impl impl
					(ensure called-by, impl) ~= fun, impl.call-kind-method-impl
		as low-fun-body-deferred
			throw unreachable
		as low-fun-body-always-inline
			()
		as low-builtin-unary
			()
		as low-builtin-binary
			()
		as low-builtin-ternary
			()
		as js-fun
			()
	var-calls call-kind mut[] mut[low-var] = ()
	for var in all-vars
		for called in all-calls var.initializer
			(ensure var-calls, var) ~= called
	calls: for k, v in calls then k, v.move-to
	var-calls: for k, v in var-calls then k, v.move-to
	called-by: for k, v in called-by then k, v.move-to
-build-called-by-recur void
	calls call-kind mut[] mut[low-fun]
	called-by caller mut[] mut[low-fun]
	f low-fun
	expr low-expr
do
	for x in all-calls expr
		ensure calls, f, it.noop ~= x
		ensure called-by, x.called, it.noop ~= (f, x)

-all-calls record(expr low-expr)
-some bool(a all-calls, f bool mut(x call-kind))
	here = match x = a.expr
	as call-low-expr
		f[x]
	as match-string-like-low-expr
		f[x]
	else
		()
	here or some a.expr.direct-child-exprs, of child
		some child.all-calls, f

-caller record
	caller low-fun
	call-expr call-kind

-call-kind union
	call-low-expr
	match-string-like-low-expr
	call-kind-method-impl
-call-kind-method-impl record(impl low-fun)
-called low-fun(a call-kind)
	match a
	as call-low-expr
		a.called
	as match-string-like-low-expr
		a.equals
	as call-kind-method-impl
		a.impl

-propagation-kind temp-async-kind?(called-kind temp-async-kind, caller caller) low-common-types
	match call = caller.call-expr
	as call-low-expr
		match called-kind
		as depends-on-caller
			res mut temp-async-kind? = ()
			for arg in call.args
				res max:= if as-lambda-type arg.type
					match arg
					as local-get-low-expr
						if contains caller.caller.params, arg.local
							depends-on-caller
						else
							# Calling into one of caller's locals, which will be scanned anyway
							()
					as lambda-low-expr
						# We scan the body of the lambda anyway
						()
					else
						always-async
				else
					()
			res
		as always-async
			always-async
	as match-string-like-low-expr
		called-kind
	as call-kind-method-impl
		called-kind

