import
	../model/low-model
	../model/model
	../model/source-range
	../model/uri
	./lower-ctx

lower-expr-ctx record mut
	cur-uri uri
	allocated-locals low-type[local]
	type-scope type-args-scope
	specs-scope low-fun[]
	locals low-local mut[local]
	contexts mut low-local array-view
new lower-expr-ctx
	fun low-fun
	allocated-locals type-inst[local]
do lower-ctx, quick-fill-in-low-fun-body
	type-scope = type-args-scope-for-fun fun
	cur-uri: fun.module-uri
	allocated-locals: to-allocated-locals allocated-locals, type-scope
	type-scope: type-scope
	specs-scope: specs-scope-for-fun fun
	locals: ()
	contexts: fun.context-params

new lower-expr-ctx
	cur-uri uri
	type-scope type-args-scope
	specs-scope low-fun[]
	allocated-locals type-inst[local]
do lower-ctx, quick-fill-in-low-fun-body
	cur-uri: cur-uri
	allocated-locals: to-allocated-locals allocated-locals, type-scope
	type-scope: type-scope
	specs-scope: specs-scope
	locals: ()
	contexts: ()
-to-allocated-locals low-type[local]
	a type-inst[local]
	type-scope type-args-scope
do lower-ctx, quick-fill-in-low-fun-body
	do if is-java
	map-values a, {get-low-type it, type-scope}
to-uri-and-range uri-and-range(a source-range) lower-expr-ctx
	cur-uri, a

lower-and-expr-ctx spec lower-ctx, low-common-types, lower-expr-ctx

low-type low-type(a expr) lower-and-expr-ctx, quick-fill-in-low-fun-body
	get-low-type type a

cur-uri uri() lower-expr-ctx
	the::lower-expr-ctx.cur-uri
locals low-local mut[local]() lower-expr-ctx
	the::lower-expr-ctx.locals
type-scope type-args-scope() lower-expr-ctx
	the::lower-expr-ctx.type-scope
specs-scope low-fun[]() lower-expr-ctx
	the::lower-expr-ctx.specs-scope

get-low-type low-type(t type) lower-and-expr-ctx, quick-fill-in-low-fun-body
	get-low-type t, type-scope
get-low-type-for low-type(e expr) lower-and-expr-ctx, quick-fill-in-low-fun-body
	get-low-type type e

get-low-fun-from-called low-fun?(called called) lower-and-expr-ctx, quick-fill-in-low-fun-body
	do if res = get-low-fun-from-called type-scope, specs-scope, called
	do unless is-bogus res.return-type
	res
