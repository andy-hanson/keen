import
	../../lib/private/parse-util

at[t] t?(a t array-view, index nat)
	if index < a.size
		a[index]

arrays-correspond[t, u] bool(a t[], b u[], f bool mut(x t, y u))
	a.size == b.size and every 0::nat .. a.size, {f[a[it], b[it]]}
test
	arrays-correspond (1, 2)::nat[], (11, 12)::nat[], (of x, y then x == y - 10) is true
	arrays-correspond (1, 2)::nat[], (11, 13)::nat[], (of x, y then x == y - 10) is false

find-index-or-push[t] nat(a t mut[], value t) t equal
	index-of a, value else
		res = a.size
		a ~= value
		res
test
	xs nat mut[] = 1, 2, 3
	find-index-or-push xs, 2 is 1
	xs.to::nat[] is (1, 2, 3)
	find-index-or-push xs, 4 is 3
	xs.to::nat[] is (1, 2, 3, 4)

zip[t, u] record(a t, b u)
size[t, u] nat64(a (t, u) zip) t size, u size
	a.a.size is a.b.size
	a.a.size
some[t, x, u, y] bool(a (t, u) zip, f bool mut(x x, y y)) (t, x) array-like, (u, y) array-like
	some (0::nat .. a.size), {f[a.a[it], a.b[it]]}
some-reverse[t, x, u, y] bool(a (t, u) zip, f bool mut(x x, y y)) (t, x) array-like, (u, y) array-like
	some-reverse (0::nat .. a.size), {f[a.a[it], a.b[it]]}

all-pairs[t] record(inner t[])
size[t] nat(a t all-pairs)
	do unless is-empty a.inner
	a.inner.size * (a.inner.size - 1) / 2
some[t] bool(a t all-pairs, f bool mut(x t, y t))
	some 0::nat .. a.inner.size, of i
		some i + 1 .. a.inner.size, of j
			f[a.inner[i], a.inner[j]]
test
	(for x in all-pairs (1, 2, 3)::nat[] then x)::(nat, nat)[] is ((1, 2), (1, 3), (2, 3))

none-or-one-or-many[t] union(none, t one, many)
none record
one[t] record(value t)
many record

none-or-one-or-many[col, elem] elem none-or-one-or-many(a col, cb bool mut(x elem)) (col, elem) some
	one mut elem? = ()
	has-many = some a, of x
		if cb[x]
			if one
				true
			else
				one := x
				false
	if has-many
		many
	elif one
		one one!
	else
		none
test
	xs nat[] = 1, 2, 3
	none-or-one-or-many xs, it == 4 is none
	none-or-one-or-many xs, it == 2 is 2.one
	none-or-one-or-many xs, it < 3 is many

zip-if-size-eq[t, u] record(a t[], b u[])
some[t, u] bool(a (t, u) zip-if-size-eq, f bool mut(x t, y u))
	if a.a.size == a.b.size
		some (zip a.a, a.b), f

cb-option[output, input] output(a input?, f output mut(x input)) output new
	if a then f[a]

| Filter a list, possibly reordering it.
| (This is faster than if we had to preserve the order.)
filter-unordered[t] void(a t mut[], f bool mut(x t))
	i mut = 0
	while i < a.size
		if f[a[i]]
			i +:= 1
		elif i == a.size - 1
			_ = a.pop!
		else
			a[i] := a.pop!
test
	xs nat mut[] = 1, 2, 3, 4, 5
	filter-unordered xs, it.is-even
	xs.to::nat[] is (4, 2)
	filter-unordered xs, it < 3
	xs.to::nat[] is (2,)
	filter-unordered xs, it == 3
	xs.to::nat[] is ()

all-same[t, k] bool(a t[], f k data(x t)) k equal
	a.size < 2 or
		value = f[a[0]]
		every a[1 .. end], f[it] == value
test
	all-same ()::nat[], {it} is true
	all-same (1, 11, 21)::nat[], it % 10 is true
	all-same (1, 11, 22)::nat[], it % 10 is false

newline string(indent nat)
	tabs char8[] = n-of indent, "\t"
	"\n{tabs.to::string}"

is-ascii-identifier-char bool(a char8)
	is-letter-or-digit a or a == "_"

filter-together[t, u] (t[], u[])(a t[], b u[], f bool mut(index nat, x t, y u))
	a.size is b.size
	indices nat[] = filter 0 .. a.size, {f[it, a[it], b[it]]}
	if indices.size == a.size
		a, b
	else
		- map indices, a[it]
		- map indices, b[it]
