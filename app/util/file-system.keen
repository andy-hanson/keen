-path-exists bool(path file-path) global
	do trusted
	if java
		exists File path.to
	elif js
		call-property fs, "existsSync", path.to 'to
	else
		throw todo

-to String(a file-path) java
	a.to.to

-to js-any(a file-path) js
	a.to::string.to

allow-overwrite enum(allow, disallow)
write-file void(path file-path, content string, permissions permissions, overwrite allow-overwrite) global
	match overwrite
	as allow
		()
	as disallow
		forbid path-exists path else path-already-exists path.to
	if java
		_ = trusted write path.to-java-path, content.to::int8[].cast-mutable, ()
	elif js
		trusted call-property fs, "writeFileSync", path.to, content.to 'to
	else
		throw todo
	change-permissions path, permissions.user-only

-change-permissions void(path file-path, permissions file-permissions) global
	do trusted
	if java
		args = java-permissions permissions
		values PosixFilePermission List = asList cast-mutable args
		perms PosixFilePermission EnumSet = values.copyOf
		_ = setPosixFilePermissions path.to-java-path, perms
	elif js
		_ = call-property fs, "chmodSync", path.to, permissions.to::nat.to::float.to
	else
		throw todo

-java-permissions PosixFilePermission[](a file-permissions) global, java
	do trusted
	-- if a.user.read
		- OWNER_READ
	-- if a.user.write
		- OWNER_WRITE
	-- if a.user.execute
		- OWNER_EXECUTE
	-- if a.group.read
		- GROUP_READ
	-- if a.group.write
		- GROUP_WRITE
	-- if a.group.execute
		- GROUP_EXECUTE
	-- if a.public.read
		- OTHERS_READ
	-- if a.public.write
		- OTHERS_WRITE
	-- if a.public.execute
		- OTHERS_EXECUTE

write-jar void(path file-path, files java-compiled-class[]) global
	do trusted
	assert java else todo
	start = perf-now
	manifest Manifest = ()
	attr = getMainAttributes manifest
	_ = putValue attr, "Manifest-Version", "1.0"
	_ = putValue attr, "Main-Class", "Main"
	file-out FileOutputStream = path.to,
	finally close file-out
	buf-out BufferedOutputStream = file-out,
	write buf-out::OutputStream, "#!/usr/bin/java -jar\n"::char8[].safe-reinterpret-cast::int8[].cast-mutable
	jar-out JarOutputStream = buf-out, manifest
	for file in files
		putNextEntry jar-out, JarEntry file.path.to
		write jar-out, file.bytes.safe-reinterpret-cast.cast-mutable
		closeEntry jar-out
	finish jar-out
	flush buf-out
	change-permissions path, all.user-only
	end-write-jar start

files-in-directory-recursive file-path[](dir-path file-path) global
	for* path in get-paths-in-dir dir-path
		match get-path-kind path
		as other
			()
		as file
			- path
		as directory
			files-in-directory-recursive path

-get-path-kind path-kind(path file-path) global
	do trusted
	if java
		jpath = to-java-path path
		if isRegularFile jpath, ()
			file
		elif isDirectory jpath, ()
			directory
		else
			other
	elif js
		stat = call-property fs, "lstatSync", path.to
		if call-property stat, "isDirectory" 'to
			directory
		elif call-property stat, "isFile" 'to
			file
		else
			other
	else
		throw todo

get-paths-in-dir file-path[](dir-path file-path) global
	do trusted
	if java
		try stream = list to-java-path dir-path catch as NoSuchFileException then throw path-not-found dir-path.to
		for path in toArray stream
			must-parse-file-path path.toString.to
	elif js
		names js-any[] = call-property fs, "readdirSync", dir-path.to 'to
		for name in names
			dir-path / name.to
	else
		throw todo

file-reader record mut
	path-to-keen file-path
	| Only used when '--watch' is passed
	-watch-service WatchService?
	-watched-files file-path mut-set
	-watched-dirs WatchKey mut[file-path]
	-read-file-inner read-file-result mut(path string)
	-read-java-class read-file-result mut(class-path path)
	-files-in-directory-recursive file-path[] mut(root file-path)
with-file-reader record(path-to-keen file-path, watch bool)
file-reader with-file-reader(path-to-keen file-path, watch bool)
	path-to-keen, watch
with-block[t] t(a with-file-reader, f t mut(a file-reader)) global
	with read-java-class in with-java-class-reader path-to-keen a
		watch-service WatchService? = if watch a
			do trusted
			assert java else todo
			newWatchService getDefault::FileSystem
		finally if watch-service
			do trusted
			assert java
			close watch-service
		reader file-reader =
			path-to-keen: path-to-keen a
			watch-service: watch-service
			watched-files: ()
			watched-dirs: ()
			read-file-inner: it.read-file-inner
			read-java-class: read-java-class
			files-in-directory-recursive: it.files-in-directory-recursive
		f[reader]

-watch-file void(a file-reader, file file-path)
	do if service = watch-service a and try-add a.watched-files, file
	dir = parent! file
	_ = ensure a.watched-dirs, dir, of
		do trusted
		assert java else todo
		buf Path Kind buffer = ENTRY_CREATE, ENTRY_DELETE, ENTRY_MODIFY
		register dir.to-java-path, service, buf.reinterpret-cast::(Object Kind buffer), ()

| Returns the path of watched files that changed.
wait-for-change file-path set(a file-reader)
	do trusted
	assert java else todo
	assert service = a.watch-service
	do until
	key = take service
	files mut = take-events a, key
	do unless is-empty files
	while extra = poll-and-take-events a
		files |:= extra
	files

-poll-and-take-events file-path set?(a file-reader) java
	do trusted
	polled = poll a.watch-service!
	unless is-null polled
		take-events a, polled

-take-events file-path set(a file-reader, key WatchKey) java
	do trusted
	watchable = key.watchable
	dir file-path = watchable.reinterpret-cast::Path.to
	events = key.pollEvents.toArray
	assert reset key
	for* o in events
		event Path WatchEvent = reinterpret-cast o
		name string = event.context.toString.to
		file-path = dir / name
		if a.watched-files[file-path]
			- file-path

-java-class-reader alias
	read-file-result mut(path path)
-with-java-class-reader record(path-to-keen file-path)
-with-block[t] t(a with-java-class-reader, f t mut(a java-class-reader))
	do trusted
	if java
		base-jmod = find-java-base-jmod
		jmods FileSystem mut[file-path] = ()
		finally for _, fs in unsorted jmods
			# TODO: we should not do this if we got it through 'getFileSystem' instead of 'newFileSystem'
			close fs
		f[{read-java-class base-jmod, it, jmods}]
	elif js
		tar-path = a.path-to-keen.parent! / "java-classes.tar"
		tar = read-entire-tar read-file tar-path.to
		f[{tar["{it}.class"] else not-found}]
	else
		throw todo

files-in-directory-recursive file-path[](a file-reader, root file-path)
	a.files-in-directory-recursive[root]

-find-java-base-jmod file-path() global
	do trusted
	if java
		path-to-jmod "java.base"
	elif js
		must-parse-file-path "/usr/lib/jvm/java-25-openjdk-amd64/jmods/java.base.jmod" # TODO: JS code to find this
	else
		throw todo

-path-to-jmod file-path(jmod-name string) global, java, unsafe
	java-home string = "java.home".getProperty.to
	must-parse-file-path "{java-home}/jmods/{jmod-name}.jmod"

-read-java-class read-file-result(base-jmod file-path, class_ path, jmods FileSystem mut[file-path]) global, java
	do trusted
	# TODO: Use a better method to determine which jmod the class belongs to.
	jmod = if starts-with class_.to::string, "com/sun/"
		path-to-jmod "jdk.httpserver"
	else
		base-jmod
	file-system = ensure jmods, jmod, of
		# Even though we cache the jmods, if we are running a client program with 'keen run',
		# it might want to create a file system for the jar too.
		get-or-create-file-system "jar:file://{jmod}".create
	path = getPath file-system, "classes/{class_}.class", ()
	try
		path.readAllBytes.cast-immutable.safe-reinterpret-cast::nat8[]
	catch as NoSuchFileException
		not-found

-get-or-create-file-system FileSystem(uri URI) global, java
	do trusted
	try
		newFileSystem uri, emptyMap
	catch as FileSystemAlreadyExistsException
		getFileSystem uri

try-read-file read-file-result(a file-reader, uri uri)
	if path = as-java-uri uri
		try-read-java-class a, path
	elif file = as-file-path uri
		watch-file a, file
		a.read-file-inner[file.to]
	else
		not-found

try-read-java-class read-file-result(a file-reader, path path)
	if path.to::symbol == "KeenClassLoader"
		keen string = a.path-to-keen.parent!.parent!.to
		full-path = "{keen}/app/backend/java/lib/KeenClassLoader.class"
		a.read-file-inner[full-path]
	else
		start = perf-now
		finally end-read-file start
		a.read-java-class[path]

-read-file-inner read-file-result(path string) global
	start = perf-now
	finally end-read-file start
	try
		read-file path
	catch as path-not-found
		not-found
	catch as file-system-error
		error

cwd file-path() global
	do trusted
	must-parse-file-path if java
		"".to-java-path.toAbsolutePath.toString.to
	elif js
		call-property process, "cwd" 'to
	else
		throw todo

-process js-any() js, global, unsafe
	js-global["process"]

-fs js-any() js
	trusted js-import "fs"

this-executable file-path() global
	do trusted
	if java
		class_ = "Keen".forName
		path = class_.getProtectionDomain.getCodeSource.getLocation.getPath
		must-parse-file-path (decode path, "UTF-8").to
	elif js
		must-parse-file-path process["argv"]["1"].to
	else
		throw todo

-to-java-path Path(a file-path) java
	to-java-path a.to::string
-to-java-path Path(a string) java
	trusted get a.to, ()
-to file-path(a Path) java
	must-parse-file-path (trusted a.toString).to
