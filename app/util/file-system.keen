-path-exists bool(path file-path) global
	do trusted
	if java
		exists File path.to
	elif js
		call-property fs, "existsSync", path.to 'to
	else
		throw todo

-to String(a file-path) java
	a.to.to

-to js-any(a file-path) js
	a.to::string.to

allow-overwrite enum(allow, disallow)
write-file void(path file-path, content string, permissions permissions, overwrite allow-overwrite) global
	match overwrite
	as allow
		()
	as disallow
		forbid path-exists path else path-already-exists path.to
	if java
		_ = trusted write path.to-java-path, content.to::int8[].cast-mutable, ()
	elif js
		trusted call-property fs, "writeFileSync", path.to, content.to 'to
	else
		throw todo
	change-permissions path, permissions.user-only

-change-permissions void(path file-path, permissions file-permissions) global
	do trusted
	if java
		args = java-permissions permissions
		values PosixFilePermission List = asList cast-mutable args
		perms PosixFilePermission EnumSet = values.copyOf
		_ = setPosixFilePermissions path.to-java-path, perms
	elif js
		_ = call-property fs, "chmodSync", path.to, permissions.to::nat.to::float.to
	else
		throw todo

-java-permissions PosixFilePermission[](a file-permissions) global, java
	do trusted
	-- if a.user.read
		- OWNER_READ
	-- if a.user.write
		- OWNER_WRITE
	-- if a.user.execute
		- OWNER_EXECUTE
	-- if a.group.read
		- GROUP_READ
	-- if a.group.write
		- GROUP_WRITE
	-- if a.group.execute
		- GROUP_EXECUTE
	-- if a.public.read
		- OTHERS_READ
	-- if a.public.write
		- OTHERS_WRITE
	-- if a.public.execute
		- OTHERS_EXECUTE

write-jar void(jar-files file-path[], path file-path, files java-compiled-class[]) global
	do trusted
	assert java else todo
	start = perf-now
	manifest Manifest = ()
	attr = getMainAttributes manifest
	_ = putValue attr, "Manifest-Version", "1.0"
	_ = putValue attr, "Main-Class", "Main"
	file-out FileOutputStream = path.to,
	finally close file-out
	buf-out BufferedOutputStream = file-out,
	write buf-out::OutputStream, "#!/usr/bin/java -jar\n"::char8[].safe-reinterpret-cast::int8[].cast-mutable
	jar-out JarOutputStream = buf-out, manifest
	for jar-path in jar-files
		copy-jar-out jar-path, jar-out
	for file in files
		putNextEntry jar-out, JarEntry file.path.to
		write jar-out, file.bytes.safe-reinterpret-cast.cast-mutable
		closeEntry jar-out
	finish jar-out
	flush buf-out
	change-permissions path, all.user-only
	end-write-jar start

-copy-jar-out void(in-path file-path, out JarOutputStream) global, java
	do trusted
	input = JarInputStream BufferedInputStream newInputStream in-path.to-java-path, ()
	finally close input::ZipInputStream
	while entry = option-of-nullable getNextJarEntry input
		# Directory entries aren't actually needed,
		# and they can conflict if two different jars we are copying from declare the same directory
		do unless isDirectory entry
		name = getName entry
		# META-INF is not necessary for an executable jar, and may have conflicts
		do unless starts-with name.to::string, "META-INF/"
		putNextEntry out, JarEntry entry.getName
		_ = transferTo input, out
		closeEntry out
		closeEntry input

files-in-directory-recursive file-path[](a file-reader-impl, dir-path file-path) global
	for* path in get-paths-in-dir dir-path
		match get-path-kind path
		as other
			()
		as file
			- path
		as directory
			files-in-directory-recursive a, path

-get-path-kind path-kind(path file-path) global
	do trusted
	if java
		jpath = to-java-path path
		if isRegularFile jpath, ()
			file
		elif isDirectory jpath, ()
			directory
		else
			other
	elif js
		stat = call-property fs, "lstatSync", path.to
		if call-property stat, "isDirectory" 'to
			directory
		elif call-property stat, "isFile" 'to
			file
		else
			other
	else
		throw todo

get-paths-in-dir file-path[](dir-path file-path) global
	do trusted
	if java
		try stream = list to-java-path dir-path catch as NoSuchFileException then throw path-not-found dir-path.to
		sort for path in toArray stream
			must-parse-file-path path.toString.to
	elif js
		names js-any[] = call-property fs, "readdirSync", dir-path.to 'to
		sort for name in names
			dir-path / name.to
	else
		throw todo

file-reader interface mut
	path-to-keen file-path()
	| Only used when '--watch' is passed
	try-read-file read-file-result(uri uri)
	files-in-directory-recursive file-path[](root file-path)
	wait-for-change file-path set()
with-file-reader record(path-to-keen file-path, watch bool)
file-reader with-file-reader(path-to-keen file-path, watch bool)
	path-to-keen, watch
with-block[t] t(a with-file-reader, f t mut(a file-reader)) global
	watch-service WatchService? = if watch a
		do trusted
		assert java else todo
		newWatchService getDefault::FileSystem
	finally if watch-service
		do trusted
		assert java
		close watch-service
	reader file-reader-impl =
		path-to-keen: a.path-to-keen
		watch-service: watch-service
		watched-files: ()
		watched-dirs: ()
		jmods: ()
		java-classes-tar: if js
			tar-path = a.path-to-keen.parent! / "java-classes.tar"
			read-entire-tar read-file tar-path.to
	finally for _, fs in reader.jmods
		assert java
		trusted close fs
	f[reader]

-file-reader-impl record mut, global, file-reader case
	path-to-keen file-path
	watch-service WatchService?
	watched-files file-path mut-set
	watched-dirs WatchKey mut[file-path]
	jmods FileSystem mut[file-path]
	# Used for JS builds only
	java-classes-tar nat8 array-view[symbol]

-watch-file void(a file-reader-impl, file file-path) global
	do if service = a.watch-service and try-add a.watched-files, file
	dir = parent! file
	_ = ensure a.watched-dirs, dir, of
		do trusted
		assert java else todo
		buf Path Kind buffer = ENTRY_CREATE, ENTRY_DELETE, ENTRY_MODIFY
		register dir.to-java-path, service, buf.reinterpret-cast::(Object Kind buffer), ()

| Returns the path of watched files that changed.
-wait-for-change file-path set(a file-reader-impl) global
	do trusted
	assert java else todo
	assert service = a.watch-service
	do until
	key = take service
	files mut = take-events a, key
	do unless is-empty files
	while extra = poll-and-take-events a
		files |:= extra
	files

-poll-and-take-events file-path set?(a file-reader-impl) java
	do trusted
	polled = poll a.watch-service!
	unless is-null polled
		take-events a, polled

-take-events file-path set(a file-reader-impl, key WatchKey) java
	do trusted
	dir file-path = key.watchable.reinterpret-cast::Path.to
	events = key.pollEvents.toArray
	assert reset key
	for* o in events
		event Path WatchEvent = reinterpret-cast o
		name string = event.context.toString.to
		file-path = dir / name
		if a.watched-files[file-path]
			- file-path


get-builtin-java-paths builtin-java-paths() global
	if java
		base uri = find-java-base-jmod.to
		# These are tested in order, so put "java/x" before just "java"
		- "java/awt".assume-path, to trusted path-to-jmod "java.desktop"
		- "java/util/logging".assume-path, to trusted path-to-jmod "java.logging"
		- "java".assume-path, base
		- "jdk".assume-path, base
		- "sun".assume-path, base
		- "com/sun".assume-path, to trusted path-to-jmod "jdk.httpserver"
	elif js
		base = to::uri must-parse-file-path "/usr/lib/jvm/java-25-openjdk-amd64/jmods/java.base.jmod"
		- "java".assume-path, base
		- "jdk".assume-path, base
		- "sun".assume-path, base
	else
		throw todo

-find-java-base-jmod file-path() global
	do trusted
	if java
		path-to-jmod "java.base"
	elif js
		must-parse-file-path "/usr/lib/jvm/java-25-openjdk-amd64/jmods/java.base.jmod" # TODO: JS code to find this
	else
		throw todo

-path-to-jmod file-path(jmod-name string) global, java, unsafe
	java-home string = "java.home".getProperty.to
	must-parse-file-path "{java-home}/jmods/{jmod-name}.jmod"

-read-java-class read-file-result(a file-reader-impl, class_ jar-and-class) global
	if java
		do trusted
		file-system = ensure a.jmods, class_.jar-path, of
			get-or-create-file-system create "jar:{to::uri class_.jar-path}"
		full-class-path string = if class_.jar-path.get-extension == ".jmod"
			"classes/{class_.class-path-including-extension}"
		else
			class_.class-path-including-extension.to
		path = getPath file-system, full-class-path.to, ()
		try
			path.readAllBytes.cast-immutable.safe-reinterpret-cast::nat8[]
		catch as NoSuchFileException
			not-found
	elif js
		a.java-classes-tar[class_.class-path-including-extension.to] else not-found

-get-or-create-file-system FileSystem(uri URI) global, java
	do trusted
	try
		newFileSystem uri, emptyMap
	catch as FileSystemAlreadyExistsException
		getFileSystem uri

-try-read-file read-file-result(a file-reader-impl, uri uri) global
	if x = as-jar-and-class-uri uri
		read-java-class a, x
	elif file = as-file-path uri
		watch-file a, file
		read-file-inner a, file.to
	else
		not-found

-read-file-inner read-file-result(_ file-reader-impl, path string) global
	start = perf-now
	finally end-read-file start
	try
		read-file path
	catch as path-not-found
		not-found
	catch as file-system-error
		error

-fs js-any() js
	trusted js-import "fs"

-to-java-path Path(a file-path) java
	to-java-path a.to::string
-to-java-path Path(a string) java
	trusted get a.to::String, ()
-to file-path(a Path) java
	must-parse-file-path (trusted a.toString).to
