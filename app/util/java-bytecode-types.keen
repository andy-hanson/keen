java-compiled-class record
	path string
	bytes nat8[]

class-access flags
	public = 1
	final = 0x10
	super = 0x20
	interface_ = 0x0200
	abstract_ = 0x400
	synthetic = 0x1000
	annotation = 0x2000
	enum_ = 0x4000

field-access-flags flags
	public = 1
	private = 2
	protected = 4
	static = 8
	final = 0x10
	volatile = 0x40
	transient = 0x80
	synthetic = 0x1000
	enum_ = 0x4000

method-access-flags flags
	public = 1
	private = 2
	protected = 4
	static = 8
	final = 0x10
	synchronized = 0x20
	bridge = 0x40
	varargs = 0x80
	native = 0x100
	abstract_ = 0x400
	strict = 0x800
	synthetic = 0x1000

java-primitive-type enum
	T_BOOLEAN = 4
	T_CHAR = 5
	T_FLOAT = 6
	T_DOUBLE = 7
	T_BYTE = 8
	T_SHORT = 9
	T_INT = 10
	T_LONG = 11
