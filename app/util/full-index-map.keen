index[t] spec
	index nat32(a t)
	new t(index nat32)

full-index-map[k, v] record
	values v[]
size[k, v] nat32(a (k, v) full-index-map)
	a.values.size
subscript[k, v] v(a (k, v) full-index-map, key k) k index
	a.values[key.index]
some[k, v] bool(a (k, v) full-index-map, f bool mut(key k, value v)) k index
	some a.values.with-index, of i, v
		f[(i,), v]

list-new[k, v] (k, v) full-index-map(values v[])
	values: values
