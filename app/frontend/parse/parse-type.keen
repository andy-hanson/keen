import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	./parser
	./parse-util
	./token

-try-take-new-visibility visibility?() parser
	if res = peek-visibility and peek2 name and next-next-symbol == "new"
		advance
		advance
		res
try-take-visibility visibility?() parser
	if res = peek-visibility
		advance
		res
-peek-visibility visibility?() parser
	match peek
	as list-dash
		private
	as operator-binary
		as-visibility next-symbol
	as operator-prefix
		as-visibility next-symbol
	else
		()
-as-visibility visibility?(a symbol)
	match a
	as "+" then public
	as "~" then internal
	as "-" then private
	else then ()

parse-type-arg-for-var-decl type-ast() parser
	if take-or-add-diag-expected-token paren-left, open-paren
		res = parse-type
		_ = take-or-add-diag-expected-token paren-right, closing-paren
		res
	else
		bogus-type-ast next-range

try-parse-type-arg-for-expr type-ast?() parser
	if try-take-token at
		parse-type-for-typed-expr

-parse-types-with-commas-then-closing-paren type-ast[]() parser
	do unless try-take-token paren-right
	res type-ast[] = parse-comma-separated {parse-type}
	_ = take-or-add-diag-expected-token paren-right, closing-paren
	res

parse-type type-ast() parser
	parse-type-suffixes parse-type-before-suffixes unnecessary

parse-modifiers modifier-ast[]() parser
	do unless peek-end-of-line or peek equal
	parse-comma-separated {parse-modifier}

-parse-modifier modifier-ast() parser
	start = next-start
	if keyword = try-take-modifier-keyword
		((), start, keyword)::modifier-keyword-ast
	else
		parse-modifier-suffixes parse-type-before-suffixes unnecessary

-try-take-modifier-keyword modifier-keyword?() parser
	res modifier-keyword? = peek.to
	if res
		advance
		res
	elif visibility = try-take-new-visibility
		new-visibility visibility

-to modifier-keyword?(a token)
	a.to::symbol.to

| Ensures that 't data' or 't shared' parses as a spec and not a modifier
-try-take-modifier-keyword-non-spec modifier-keyword?() parser
	unless is-data-or-shared peek
		try-take-modifier-keyword
-is-data-or-shared bool(a token)
	a == data_ or a == shared_

-new-visibility modifier-keyword(a visibility)
	match a
	as private
		new-private
	as internal
		new-internal
	as public
		new-public

parse-type-for-typed-expr type-ast() parser
	parse-type-suffixes-non-name parse-type-before-suffixes necessary

parse-destructure-require-parens destructure-ast() parser
	start = next-start
	match peek
	as paren-left
		advance
		if try-take-token paren-right
			void-destructure-ast range start
		else
			res = parse-destructure-no-require-parens
			_ = take-or-add-diag-expected-token paren-right, closing-paren
			res
	as underscore
		advance
		ignore-destructure-ast start, try-take-type
	as name
		name name-and-range = start, next-symbol
		advance
		mut_ = try-take-mut
		type = try-take-type
		if mut_ or type
			name, mut_, type
		else
			name
	else
		add-diag-at-next-token destructure::parse-diag-expected
		skip-until-newline-no-diag
		void-destructure-ast next-range
-try-take-mut pos?() parser
	pos = next-start
	if try-take-token mut_
		pos
-try-take-type type-ast?() parser
	?parse-type-suffixes try-parse-type-before-suffixes unnecessary

parse-destructure-no-require-parens destructure-ast() parser
	destructure-from-parts next-start, parse-comma-separated {parse-destructure-require-parens}

try-parse-sum-type-listed-types-parenthesized type-ast[]?() parser
	if try-take-token paren-left
		parse-types-with-commas-then-closing-paren

try-parse-params-parenthesized destructure-ast[]?() parser
	if peek paren-left
		parse-params-parenthesized

params-kind enum(indented, parenthesized)
parse-params (destructure-ast[], params-kind)() parser
	if try-take-token newline-indent
		params = parse-indented-lines-after-indent {parse-destructure-no-require-parens}
		_ = try-take-token newline-same-indent
		params, indented
	else
		parse-params-parenthesized, parenthesized

parse-params-parenthesized destructure-ast[]() parser
	if not take-or-add-diag-expected-token paren-left, open-paren
		skip-until-newline-no-diag
		()
	elif try-take-token paren-right
		()
	else
		params = parse-comma-separated {parse-destructure-require-parens}
		unless take-or-add-diag-expected-token paren-right, closing-paren
			skip-until-newline-no-diag
		params

-parentheses-necessary enum(unnecessary, necessary)

-parse-type-before-suffixes type-ast(parens parentheses-necessary) parser
	try-parse-type-before-suffixes parens else
		add-diag-unexpected-next-token
		bogus-type-ast next-range

-try-parse-type-before-suffixes type-ast?(parens parentheses-necessary) parser
	start = next-start
	match peek
	as global_
		advance
		name-and-range start, "global"
	as name
		advance
		name-and-range start, prev-symbol
	as paren-left
		advance
		parse-tuple-type start, parens
	else
		()

-parse-tuple-type type-ast(start pos, parens parentheses-necessary) parser
	args type-ast[] = parse-types-with-commas-then-closing-paren
	match args.size
	as 0
		range = range start
		add-diag range, parse-diag-type-empty-parens
		bogus-type-ast range
	as 1
		if parens != necessary
			add-diag start.range, parse-diag-type-unnecessary-parens
		args[0]
	else
		tuple-type-ast start.range, args

-parse-type-suffixes type-ast(left type-ast) parser
	if suffix = parse-type-suffix-non-name left
		parse-type-suffixes suffix
	elif name = try-take-name-and-range
		parse-type-suffixes suffix-name-type-ast left, name
	else
		left

-parse-modifier-suffixes modifier-ast(left type-ast) parser
	keyword-pos = next-start
	if keyword = try-take-modifier-keyword-non-spec
		modifier-keyword-ast left, keyword-pos, keyword
	elif suffix = parse-type-suffix-non-name left
		parse-modifier-suffixes suffix
	elif name = try-take-name-and-range-allow-name-like-keywords
		parse-modifier-suffixes-after-name left, name
	elif left.name-and-range
		spec-use-ast (), left
	else
		add-diag-expected name
		spec-use-ast left, (next-start, "")

-parse-modifier-suffixes-after-name modifier-ast(left type-ast, name name-and-range) parser
	name-is-type = suffix-name-type-ast left, name
	keyword-pos = next-start
	if keyword = try-take-modifier-keyword-non-spec
		modifier-keyword-ast name-is-type, keyword-pos, keyword
	elif suffix = parse-type-suffix-non-name name-is-type
		parse-modifier-suffixes suffix
	elif name2 = try-take-name-and-range
		parse-modifier-suffixes-after-name name-is-type, name2
	else
		spec-use-ast left, name

-parse-type-suffixes-non-name type-ast(left type-ast) parser
	if suffix = parse-type-suffix-non-name left
		parse-type-suffixes-non-name suffix
	else
		left

-parse-type-suffix-non-name type-ast?(left type-ast) parser
	suffix-pos = next-start
	array-or-map = of::type-ast array-kind suffix-special-type-ast-kind, map-kind mutability
		if try-take-token bracket-right
			suffix-special-type-ast left, suffix-pos, array-kind
		else
			map-like left, map-kind

	match peek
	as question
		advance
		suffix-special-type-ast left, suffix-pos, option
	as bracket-left
		advance
		array-or-map[array, data_]
	as question-bracket
		advance
		left-option = suffix-special-type-ast left, suffix-pos, option
		if try-take-token bracket-right
			suffix-special-type-ast left-option, suffix-pos + 1, array
		else
			map-like left-option, data_
	as mut_
		try-parse-fun-type suffix-pos, mut_, left or
			mut-pos = next-start
			advance
			if try-take-token bracket-left
				array-or-map[mut-array, mut_]
			else
				add-diag mut-pos.range, parse-diag-type-trailing-mut
				()
	as data_
		try-parse-fun-type suffix-pos, data_, left
	as shared_
		if fun = try-parse-fun-type suffix-pos, shared_, left
			fun
		elif peek2 bracket-left
			advance
			advance
			array-or-map[shared-array, shared_]
	else
		()
-map-like type-ast(left type-ast, kind mutability) parser
	key = parse-type
	if take-or-add-diag-expected-token bracket-right, closing-bracket
		map-type-ast kind, left, key
	else
		left

-try-parse-fun-type fun-type-ast?(keyword-pos pos, kind mutability, return-type type-ast) parser
	do if peek2 paren-left
	advance
	before-params = next-start
	params-array = parse-params-parenthesized
	params destructure-ast = destructure-from-parts before-params, params-array
	return-type, keyword-pos, kind, params

-destructure-from-parts destructure-ast(start pos, parts destructure-ast[]) parser
	match parts.size
	as 0
		void-destructure-ast range start
	as 1
		parts[0]
	else
		parts
