import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	./parser
	./token
	./token-util

try-take-token bool(expected token) parser
	if peek expected
		advance
		true

try-take-operator bool(expected symbol) parser
	if peek operator-binary and next-symbol == expected
		advance
		true

take-or-add-diag-expected-token bool(token token, kind parse-diag-expected) parser
	res = try-take-token token
	unless res
		add-diag-at-next-token kind
	res

add-diag-expected void(kind parse-diag-expected) parser
	add-diag-at-next-token kind

take-or-add-diag-expected-operator bool(operator symbol, kind parse-diag-expected) parser
	res = try-take-operator operator
	unless res
		add-diag-at-next-token kind
	res

try-take-name-and-range-allow-name-like-keywords name-and-range?() parser
	start = next-start
	token = peek
	res symbol? = if token == name or token == reserved
		next-symbol
	else
		try-get-name-like-keyword token
	if res
		advance
		start, res

take-name-allow-name-like-keywords symbol() parser
	if res = try-take-name-and-range-allow-name-like-keywords
		res.name
	else
		add-diag-at-next-token name::parse-diag-expected
		""

-try-get-name-like-keyword symbol?(a token)
	match a
	as data_
		"data"
	as enum_
		"enum"
	as flags_
		"flags"
	as global_
		"global"
	as in_
		"in"
	as list-dash
		"-"
	as shared_
		"shared"
	else
		()

try-take-name-and-range name-and-range?() parser
	if peek name
		advance
		prev-start, prev-symbol
try-take-name-and-range-or-diag name-and-range?() parser
	res = try-take-name-and-range
	unless res
		add-diag-at-next-token name::parse-diag-expected
		skip-until-newline-no-diag
	res

try-take-name-like-token name-and-range?(token token) parser
	do if peek token
	res name-and-range =
		start: next-start + (token == name-after-question).to
		name: next-symbol
	advance
	res

try-take-name-colon symbol?() parser
	if peek name-colon
		advance
		prev-symbol

| Range does not include the ':'
try-take-name-colon-and-range name-and-range?() parser
	start = next-start
	if name = try-take-name-colon
		start, name

take-name-and-range name-and-range() parser
	try-take-name-and-range-or-diag else next-start, ""

take-name symbol() parser
	take-name-and-range.name

take-name-or-operator name-and-range() parser
	if res = peek-name-or-operator
		advance
		prev-start, res
	else
		add-diag-at-next-token name-or-operator::parse-diag-expected
		next-start, ""

peek-name-or-operator symbol?() parser
	token = peek
	if is-name-like-token token
		next-symbol
	else
		try-get-name-like-keyword token

-is-name-like-token bool(a token)
	match a
	as name
		true
	as name-equals
		true
	as operator-binary
		true
	as operator-equals
		true
	as operator-prefix
		true
	else
		false

skip-blank-lines void() parser
	while try-take-token newline-same-indent
		()

peek-end-of-line bool() parser
	match peek
	as newline-dedent
		true
	as newline-indent
		true
	as newline-same-indent
		true
	as end-of-file
		true
	else
		false

take-dedent void() parser
	unless try-take-token newline-dedent
		add-diag-at-next-token dedent::parse-diag-expected
		while skip-to-next-newline-or-dedent != dedent
			()

newline-or-dedent enum(newline, dedent)
== bool(a newline-or-dedent, b newline-or-dedent)
take-newline-or-dedent newline-or-dedent() parser
	if try-take-token newline-same-indent
		newline
	elif try-take-token newline-dedent
		dedent
	elif peek end-of-file
		dedent
	else
		add-diag-at-next-token newline-or-dedent::parse-diag-expected
		skip-to-next-newline-or-dedent

-skip-to-next-newline-or-dedent newline-or-dedent() parser
	skip-to-next-newline-or-dedent 0
-skip-to-next-newline-or-dedent newline-or-dedent(init-dedents-needed nat) parser
	dedents-needed mut = init-dedents-needed
	do until
	skip-until-newline-no-diag
	match peek
	as newline-dedent
		advance
		if dedents-needed == 0
			dedent
		else
			dedents-needed -:= 1
			()
	as newline-same-indent
		advance
		if dedents-needed == 0
			newline
	as end-of-file
		dedents-needed is 0
		newline
	as newline-indent
		advance
		dedents-needed +:= 1
		()
	else
		throw unreachable

parse-indented-lines[t] t[](f t mut()) parser
	if try-take-token newline-indent
		parse-indented-lines-after-indent f

parse-indented-lines-after-indent[t] t[](f t mut()) parser
	do with out in build
	do until
	out ~= f[]
	match take-newline-or-dedent
	as newline
		false
	as dedent
		true

take-indent-or-fail-generic[t] t(cb-indent t mut(), cb-fail t mut(x source-range)) parser
	if try-take-token newline-indent
		cb-indent[]
	else
		add-diag-at-next-token indent::parse-diag-expected
		cb-fail[next-range]

try-take-literal-number literal-number?() parser
	start = next-start
	if try-take-token literal-number
		- range start

parse-comma-separated-names name-and-range[]() parser
	parse-comma-separated {take-name-or-operator}

parse-comma-separated[t] t[](f t mut()) parser
	do with out in build
	out ~= f[]
	while try-take-token comma
		out ~= f[]

take-after-interpolated bool() parser
	if take-or-add-diag-expected-token brace-right, closing-brace
		true
	else
		inside-quotes mut = 1
		do until
		# parser guarantees a fake 'brace-right' token in interpolated, but we might have skipped to the end of the line
		if is-newline-token peek
			false
		elif try-take-token brace-right
			inside-quotes -:= 1
			if inside-quotes == 0 then true
		elif try-take-token quote-double-then-interpolated
			inside-quotes +:= 1
			()
		else
			advance
			()

