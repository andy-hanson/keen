import
	../../model/ast
	../../model/parse-diag
	../../model/uri
	./parser
	./parse-type
	./parse-util
	./token

parse-imports-or-exports imports-or-exports-ast?(keyword token) parser
	start = next-start
	if try-take-token keyword
		imports = take-indent-or-fail-generic {parse-import-lines}, {}
		(range start), imports

-parse-import-lines import-or-export-ast[]() parser
	do with out in build
	do until
	out ~= parse-single-module-import-on-own-line
	match take-newline-or-dedent
	as newline
		false
	as dedent
		true

-parse-import-path (path-or-rel-path, bool)() parser
	n-parents nat? = if try-take-token dot
		_ = take-or-add-diag-expected-operator "/", slash
		0
	elif try-take-operator ".."
		_ = take-or-add-diag-expected-operator "/", slash
		take-dot-dot-slashes
	first-component, first-colon = take-path-component
	path, colon = add-path-components (first-component.root-path, first-colon)
	if n-parents
		(rel-path n-parents, path), colon
	else
		path, colon

-take-dot-dot-slashes nat() parser
	acc mut = 1
	while try-take-operator ".."
		_ = take-or-add-diag-expected-operator "/", slash
		acc +:= 1
	acc

-add-path-components (path, bool)(start (path, bool)) parser
	acc mut, colon mut = start
	while !colon and try-take-operator "/"
		name, new-colon = take-path-component
		acc /:= name.to
		colon := new-colon
	acc, colon

-parse-single-module-import-on-own-line import-or-export-ast() parser
	start = next-start
	path, ends-with-colon = parse-import-path
	kind = parse-import-or-export-kind ends-with-colon
	start.range-allow-empty, path, kind

-parse-import-or-export-kind import-or-export-ast-kind(colon bool) parser
	if colon
		parse-comma-separated-names
	elif try-take-token as_
		name = take-name-and-range
		type = parse-type
		import-file-ast name, type, to-import-file-type-or-diag type
	else
		import-whole-module-ast

-to-import-file-type-or-diag import-file-type(type type-ast) parser
	to-import-file-type type else
		add-diag type.range, parse-diag-import-file-type-not-supported
		string

-to-import-file-type import-file-type?(a type-ast)
	if is-simple-name a, "string"
		string
	elif is-nat8-array a
		nat8-array

-is-simple-name bool(a type-ast, name symbol)
	a.name-and-range and a.name == name
-is-nat8-array bool(a type-ast)
	a.suffix-special-type-ast and a.kind == array and is-simple-name a.left, "nat8"

-take-path-component (symbol, bool)() parser
	cur mut, colon mut = take-path-component-name
	while !colon and p = take-path-component-punctuation
		name, new-colon = take-path-component-name
		cur := "{cur}{p}{name}"
		colon := new-colon
	cur, colon

-take-path-component-name (symbol, bool)() parser
	if x = try-take-name-colon
		x, true
	else
		take-name-allow-name-like-keywords, false

-take-path-component-punctuation string?() parser
	if try-take-token dollar
		"$"
	elif try-take-token dot
		"."
