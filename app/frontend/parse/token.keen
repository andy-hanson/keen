token enum
	alias_
	and_
	as_
	assert_
	| '@'
	at
	| '!'
	bang
	builtin_
	| '\{'
	brace-left
	| '\}'
	brace-right
	| '['
	bracket-left
	| ']'
	bracket-right
	case_
	catch_
	| ':'
	colon
	| '::'
	colon2
	| ':='
	colon-equal
	| ','
	comma
	data_
	do_
	| '$'
	dollar
	| '.'
	| Note: '..' would be an {operator-binary}
	dot
	elif_
	else_
	enum_
	| '='
	equal
	end-of-file
	export_
	finally_
	flags_
	for_
	| 'for*'
	for-star
	force-data_
	force-shared_
	forbid_
	global_
	if_
	import_
	in_
	interface_
	it_
	| '-' at the start of a line, followed by a space
	list-dash
	list-dash-dash
	literal-number
	match_
	mut_
	| Any non-keyword, non-operator name; use as-symbol with this
	name
	| '!name'
	name-after-bang
	| '?foo'
	name-after-question
	| `'foo`
	name-after-tick
	| 'foo!'
	name-bang
	| 'foo:'
	name-colon
	| 'foo:='
	name-colon-equals
	| 'foo='. The symbol will include the '='.
	name-equals
	| End of line followed by another line at lesser indentation.
	| There will be one of these tokens for each reduced indent level, followed by a {newline-same-indent} token.
	newline-dedent
	| End of line followed by another line at 1 greater indent level.
	| Unlike {newline-dedent}, this is not followed by a 'newlineSameIndent' token.
	newline-indent
	| end of line followed by another line at the same indent level.
	newline-same-indent
	no-std_
	of_
	| Any operator; use 'as-symbol' with this
	operator-binary
	| '+:='
	operator-colon-equals
	| e.g. '~='. The symbol will include the '='.
	operator-equals
	| '-' or '~', with no space after them
	operator-prefix
	or_
	| '('
	paren-left
	| ')'
	paren-right
	pure_
	| '?'
	question
	| '?['
	question-bracket
	| 'quote'
	quote-block-no-interpolated
	quote-block-then-interpolated
	| '|' at start of a line
	quote-bar-no-interpolated
	quote-bar-then-interpolated
	| '"'
	quote-double-no-interpolated
	quote-double-then-interpolated
	| This is only used temporarily by the parser.
	quote-keyword
	record_
	region_
	reserved
	shared_
	spec_
	test_
	the_
	then_
	thread-local_
	throw_
	trusted_
	try_
	| '_'
	underscore
	union_
	unless_
	until_
	variant_
	while_
	with_
