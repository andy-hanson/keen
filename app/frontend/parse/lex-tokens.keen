import
	keen/bits
	keen/unsafe
	../../../lib/parse
	../../../lib/private/parse-util
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	../../util/perf
	./token
	./token-util

tokens record
	tokens-starts-ends token-start-end[]
	datas token-data[]
token-start-end record(value nat64)
new token-start-end(token token, start pos, end pos)
	value: token.to::nat64 << 48 | start::nat64 << 24 | end
token token(a token-start-end)
	trusted reinterpret-cast (a.value >> 48).to::nat8
range source-range(a token-start-end)
	a.start, a.end
start pos(a token-start-end)
	(a.value >> 24) & 0xffffff 'to
end pos(a token-start-end)
	a.value & 0xffffff 'to
to json(a tokens)
	size = a.tokens-starts-ends.size
	for::json[] i in 0 .. size
		x = a.tokens-starts-ends[i]
		match data_ = a.datas[i]
		as no-token-data
			token: x.token.to, start: x.start.to, end: x.end.to
		else
			token: x.token.to, start: x.start.to, end: x.end.to, data_: data_.to

token-data union(no-token-data, float, int, nat, symbol, string)
no-token-data record
number number?(a token-data)
	match a
	as float then a
	as int then a
	as nat then a
	else then ()
-to token-data(a number)
	match a
	as float then a
	as int then a
	as nat then a

lex-tokens tokens(source string-view, diagnostics parse-diagnostic mut[])
	assert source.size < (1 << 24) # Check that 24 bits is enough for pos
	perf-start = perf-now
	finally end-tokens perf-start
	state lexer-state = source, diagnostics
	iter string-iterator = begin source

	# Skip initial blank lines so they don't get a token
	delta = skip-blank-lines-and-get-indent-delta state, iter
	if delta != 0
		state.diagnostics ~= (0, iter.pos), parse-diag-indent-too-much
		state.cur-indent := 0

	until iter.is-at-end
		skip-spaces-and-comments iter, {}, diagnostics
		do unless is-at-end iter
		start = iter.pos
		match take-next iter
		as "\n"
			emit-newline state, iter, start
		as "~"
			if peek-space-after-binary-operator iter or iter.peek == "~"
				emit-operator state, start, iter, if try-take iter, "~" then "~~" else "~"
			else
				emit-operator-prefix state, start, iter, "~"
		as "@"
			emit state, at, start, iter.pos
		as "!"
			if try-take iter, "="
				emit-operator state, start, iter, "!="
			else
				emit state, bang, start, iter.pos
		as "%"
			emit-operator state, start, iter, "%"
		as "^"
			emit-operator state, start, iter, "^"
		as "&"
			emit-operator state, start, iter, "&"
		as "*"
			emit-operator state, start, iter, if try-take iter, "*" then "**" else "*"
		as "("
			emit state, paren-left, start, iter.pos
		as ")"
			emit state, paren-right, start, iter.pos
		as "["
			emit state, bracket-left, start, iter.pos
		as "]"
			emit state, bracket-right, start, iter.pos
		as "\{"
			push-inside-braces state, lambda
			emit state, brace-left, start, iter.pos
		as "\}"
			emit state, brace-right, start, iter.pos
			if braces-kind = pop-inside-braces state
				if quote-kind = to::quote-kind? braces-kind
					take-string-part state, iter, iter.pos, quote-kind
		as "-"
			if peek-digit iter
				take-number-after-sign state, start, iter
			elif try-take iter, "-"
				emit state, list-dash-dash, start, iter.pos
			elif peek-space-after-binary-operator iter
				if prev-is-newline state and iter.peek != "="
					emit state, list-dash, start, iter.pos
				else
					emit-operator state, start, iter, "-"
			else
				emit-operator-prefix state, start, iter, "-"
		as "="
			if try-take iter, "="
				emit-operator state, start, iter, "=="
			else
				emit state, equal, start, iter.pos
		as "+"
			if peek-digit iter
				take-number-after-sign state, start, iter
			else
				emit-operator state, start, iter, "+"
		as "|"
			if prev-is-newline state and peek-whitespace iter
				take-string-part state, iter, start, bar
			else
				emit-operator state, start, iter, "|"
		as ":"
			if try-take iter, "="
				emit state, colon-equal, start, iter.pos
			elif try-take iter, ":"
				emit state, colon2, start, iter.pos
			else
				emit state, colon, start, iter.pos
		as "'"
			if name = try-take-keen-identifier iter
				emit state, name-after-tick, start, iter.pos, name
			else
				state.diagnostics ~= (start, iter.pos), "'".parse-diag-unexpected-character
		as "\""
			take-string-part state, iter, start, double
		as ","
			emit state, comma, start, iter.pos
		as "<"
			emit-operator state, start, iter, if try-take iter, "="
				if try-take iter, ">" then "<=>" else "<="
			elif try-take iter, "<"
				"<<"
			else
				"<"
		as ">"
			emit-operator state, start, iter, if try-take iter, "="
				">="
			elif try-take iter, ">"
				">>"
			else
				">"
		as "."
			if try-take iter, "."
				emit-operator state, start, iter, ".."
			else
				emit state, dot, start, iter.pos
		as "$"
			emit state, dollar, start, iter.pos
		as "/"
			emit-operator state, start, iter, "/"
		as "?"
			if try-take iter, "["
				emit state, question-bracket, start, iter.pos
			elif name = try-take-keen-identifier iter
				emit state, name-after-question, start, iter.pos, name
			else
				emit state, question, start, iter.pos
		as "0" then number state, iter
		as "1" then number state, iter
		as "2" then number state, iter
		as "3" then number state, iter
		as "4" then number state, iter
		as "5" then number state, iter
		as "6" then number state, iter
		as "7" then number state, iter
		as "8" then number state, iter
		as "9" then number state, iter
		else
			iter.pos := start
			lex-identifier-like state, iter, start

	emit-newline state, iter, iter.pos
	finish state

-peek-whitespace bool(a string-iterator)
	(x = peek a) and is-whitespace x

-peek-space-after-binary-operator bool(iter string-iterator)
	# Ensure that `x -= 1` or `x -:= 1` parses '-' as an operator
	(x = peek iter) and (is-whitespace x or x == "=" or x == ":")

-number void(state lexer-state, iter string-iterator)
	iter.pos -:= 1
	take-number-after-sign state, iter.pos, iter

-lexer-state record mut
	# For performance, we handle growable arrays inline here rather than through an indirection like mut[]
	n-tokens mut nat32
	tokens-starts-ends mut token-start-end buffer
	data_ mut token-data buffer
	indent-kind indent-kind
	cur-indent mut nat32
	n-inside-braces mut nat32
	inside-braces mut braces-kind buffer
	diagnostics parse-diagnostic mut[]
-braces-kind enum(bar, double, indented, lambda)
-to braces-kind(a quote-kind)
	match a
	as bar then bar
	as double then double
	as indented then indented
-to quote-kind?(a braces-kind)
	match a
	as bar then bar
	as double then double
	as indented then indented
	as lambda then ()
-finish tokens(a lexer-state)
	a.tokens-starts-ends[0 .. a.n-tokens].to, a.data_[0 .. a.n-tokens].to
-new lexer-state(source string-view, diagnostics parse-diagnostic mut[])
	expected-n-tokens = max source.size / 4, 1
	n-tokens: 0
	tokens-starts-ends: trusted uninitialized-buffer expected-n-tokens
	data_: trusted uninitialized-buffer expected-n-tokens
	indent-kind: detect-indent-kind source.begin
	cur-indent: 0
	n-inside-braces: 0
	inside-braces: trusted uninitialized-buffer 4
	diagnostics: diagnostics
-emit void(a lexer-state, token token, start pos, end pos)
	emit a, token, start, end, no-token-data
-emit void(a lexer-state, token token, start pos, end pos, data_ token-data)
	if a.n-tokens == a.tokens-starts-ends.size
		do trusted
		a.tokens-starts-ends := increase-capacity a.tokens-starts-ends
		a.data_ := increase-capacity a.data_
	a.tokens-starts-ends[a.n-tokens] := token, start, end
	a.data_[a.n-tokens] := data_
	a.n-tokens +:= 1
-increase-capacity[t] t buffer(a t buffer) unsafe
	res t buffer = uninitialized-buffer a.size  * 2
	copy-from res[0 .. a.size], a
	res
-prev-token token?(a lexer-state)
	unless a.n-tokens == 0
		a.tokens-starts-ends[a.n-tokens - 1].token
-prev-is-newline bool(a lexer-state)
	if p = a.prev-token
		is-newline-token p
	else
		true
-push-inside-braces void(a lexer-state, value braces-kind)
	if a.n-inside-braces == a.inside-braces.size
		a.inside-braces := trusted increase-capacity a.inside-braces
	a.inside-braces[a.n-inside-braces] := value
	a.n-inside-braces +:= 1
-pop-inside-braces braces-kind?(a lexer-state)
	unless a.n-inside-braces == 0
		a.n-inside-braces -:= 1
		a.inside-braces[a.n-inside-braces]

-lex-identifier-like void(state lexer-state, iter string-iterator, start pos)
	if symbol = try-take-keen-identifier iter
		if try-take-just-colon iter
			emit state, name-colon, start, iter.pos, symbol
		else
			match token = token-for-symbol symbol
			as name
				emit-name-like-token state, iter, start, symbol, false
			as region_
				skip-until-newline iter
				emit state, region_, start, iter.pos
			as for_
				emit state, (if try-take iter, "*" then for-star else for_), start, iter.pos
			as operator-binary
				emit state, token, start, iter.pos, symbol
			as quote-keyword
				before-newline = iter.pos
				if try-take iter, "\n"
					end-all-quotes state, iter
					delta = get-indent-delta-after-quote state, iter
					if delta == 1
						take-indented-quote-part state, iter
					else
						emit state, quote-keyword, start, iter.pos
						emit-newline-inner state, iter, before-newline, delta
				else
					# This will eventually trigger a parse error
					emit state, quote-keyword, start, iter.pos
			as reserved
				emit state, reserved, start, iter.pos, symbol
			else
				emit state, token, start, iter.pos
	else
		char = must-take-one-unicode-char iter
		state.diagnostics ~= (start, iter.pos), char.parse-diag-unexpected-character
		# Skip to end of line to avoid excessive diagnostics
		until is-at-end iter or iter.peek == "\n"
			_ = take-next iter

-emit-newline void(state lexer-state, iter string-iterator, start pos)
	end-all-quotes state, iter
	emit-newline-inner state, iter, start, skip-blank-lines-and-get-indent-delta state, iter
-emit-newline-inner void(state lexer-state, iter string-iterator, start pos, delta int32)
	if delta == 0
		emit-newline-same-indent state, start, iter
	elif delta < 0
		emit-dedents state, start, iter, delta.abs
	else
		emit state, newline-indent, start, iter.pos
-emit-newline-same-indent void(state lexer-state, start pos, iter string-iterator)
	if is-at-end iter
		unless p = prev-token state and p == end-of-file
			emit state, end-of-file, start, iter.pos
	else
		emit state, newline-same-indent, start, iter.pos
-emit-dedents void(state lexer-state, start pos, iter string-iterator, amount nat32)
	for _ in 0::nat32 .. amount
		emit state, newline-dedent, start, start
	emit-newline-same-indent state, start, iter
-end-all-quotes void(state lexer-state, iter string-iterator)
	while braces-kind = pop-inside-braces state
		state.diagnostics ~= (iter.pos, iter.pos), closing-brace::parse-diag-expected
		if quote-kind = to::quote-kind? braces-kind
			emit state, brace-right, iter.pos, iter.pos
			if quote-kind == indented
				take-string-part state, iter, iter.pos, quote-kind
			else
				emit state, quote-kind.no-interpolated, iter.pos, iter.pos, ""::string

-emit-operator-prefix void(out lexer-state, start pos, iter string-iterator, value symbol)
	check-after-operator out, start, iter, value
	emit out, operator-prefix, start, iter.pos, value
-emit-operator void(out lexer-state, start pos, iter string-iterator, value symbol)
	check-after-operator out, start, iter, value
	emit-name-like-token out, iter, start, value, true
-check-after-operator void(out lexer-state, start pos, iter string-iterator, value symbol)
	if peek-operator-char iter
		# Imports often have './' or '/.', so ignore it
		unless value == ".." and iter.peek == "/" or value == "/" and iter.peek == "."
			out.diagnostics ~= (start, iter.pos + 1), parse-diag-operator-needs-space value, iter.peek!.to
	elif iter.peek == "=" and iter.peek-next == "="
		out.diagnostics ~= (start, iter.pos + 2), parse-diag-operator-needs-space value, "=="
-emit-name-like-token void(out lexer-state, iter string-iterator, start pos, value symbol, is-operator bool)
	v mut = value
	regular-token = if is-operator then operator-binary else name
	token = match peek iter else "\0"
	as "="
		if iter.peek-next == "="
			regular-token
		else
			_ = take-next iter
			v := "{value}="
			if is-operator then operator-equals else name-equals
	as "!"
		if regular-token == name
			_ = take-next iter
			name-bang
		else
			regular-token
	as ":"
		if iter.peek-next == "="
			_ = take-next iter
			_ = take-next iter
			if is-operator then operator-colon-equals else name-colon-equals
		else
			regular-token
	else
		regular-token
	emit out, token, start, iter.pos, v

-peek-next char8?(a string-iterator) = peek-by a, 1

-try-take-just-colon bool(a string-iterator)
	if a.peek == ":" and (peek-by a, 1) != ":" and (peek-by a, 1) != "="
		_ = take-next a
		true

-token-for-symbol token(a symbol)
	match a
	as "abstract"
		reserved
	as "alias"
		alias_
	as "and"
		and_
	as "as"
		as_
	as "assert"
		assert_
	as "builtin"
		builtin_
	as "case"
		case_
	as "catch"
		catch_
	as "class"
		reserved
	as "data"
		data_
	as "do"
		do_
	as "elif"
		elif_
	as "else"
		else_
	as "enum"
		enum_
	as "export"
		export_
	as "finally"
		finally_
	as "flags"
		flags_
	as "for"
		for_
	as "force-data"
		force-data_
	as "force-shared"
		force-shared_
	as "forbid"
		forbid_
	as "global"
		global_
	as "if"
		if_
	as "import"
		import_
	as "in"
		in_
	as "interface"
		interface_
	as "is"
		is_
	as "isnt"
		isnt_
	as "it"
		it_
	as "match"
		match_
	as "mut"
		mut_
	as "no-std"
		no-std_
	as "of"
		of_
	as "or"
		or_
	as "pure"
		pure_
	as "quote"
		quote-keyword
	as "record"
		record_
	as "region"
		region_
	as "shared"
		shared_
	as "spec"
		spec_
	as "test"
		test_
	as "the"
		the_
	as "then"
		then_
	as "thread-local"
		thread-local_
	as "throw"
		throw_
	as "trusted"
		trusted_
	as "try"
		try_
	as "unless"
		unless_
	as "union"
		union_
	as "until"
		until_
	as "variant"
		variant_
	as "while"
		while_
	as "with"
		with_
	as "_"
		underscore
	else
		name

-take-number-after-sign void(out lexer-state, start pos, iter string-iterator)
	iter.pos := start
	number = try
		take-number iter
	catch e as inner-parse-error
		out.diagnostics ~= (iter.pos, iter.pos), if contains-seq e.expected, "overflow"
			parse-diag-number-overflow
		else
			parse-diag-number-invalid
		0
	emit out, literal-number, start, iter.pos, number.to

region strings

-take-string-part void(state lexer-state, iter string-iterator, start pos, kind quote-kind)
	if kind == indented
		take-indented-quote-part state, iter
	else
		take-non-indented-string-part state, iter, start, kind

-take-indented-quote-part void(state lexer-state, iter string-iterator)
	range-start = iter.pos
	interpolate mut = false
	dedents mut nat32 = 0
	text string = with out in build
		do until
		start = iter.pos
		match peek iter else "\0"
		as "\{"
			_ = take-next iter
			push-inside-braces state, indented
			interpolate := true
			true
		as "\}"
			out ~= take-next iter
			state.diagnostics ~= (start, start + 1), parse-diag-closing-brace-needs-escape
			false
		as "\\"
			_ = take-next iter
			take-string-escape out, start, iter, state.diagnostics
			false
		as "\n"
			count-newlines mut nat32 = 0
			new-indent mut nat32 = 0
			while try-take iter, "\n"
				count-newlines +:= 1
				new-indent := take-indent-amount-after-newline iter, state.indent-kind, of pos
					state.diagnostics ~= (pos, iter.pos), parse-diag-indent-wrong state.indent-kind
			prev-indent = state.cur-indent
			if new-indent < prev-indent
				dedents := prev-indent - new-indent - 1
				state.cur-indent := new-indent
				true
			else
				for _ in 0 .. count-newlines
					out ~= "\n"
				for _ in 0::nat32 .. new-indent - prev-indent
					out ~~= chars state.indent-kind
				false
		as "\0"
			dedents := state.cur-indent - 1
			state.cur-indent := 0
			true
		else
			out ~= take-next iter
			false

	end-pos = if is-at-end iter then iter.pos else iter.pos - 1
	token = if interpolate then quote-block-then-interpolated else quote-block-no-interpolated
	emit state, token, range-start, end-pos, text
	unless interpolate
		emit-dedents state, end-pos, iter, dedents

-chars char8[](a indent-kind)
	match a
	as tabs
		"\t"
	as spaces-2
		"  "
	as spaces-4
		"    "

-take-non-indented-string-part void
	state lexer-state
	iter string-iterator
	start pos
	quote-kind quote-kind
do
	quote-kind isnt indented
	interpolate mut = false
	end mut pos = 0
	text string = with out in build
		interpolate := until
			start-of-char = iter.pos
			end := start-of-char
			match peek iter else "\0"
			as "\""
				_ = take-next iter
				match quote-kind
				as bar
					out ~= "\""
					()
				as double
					end := iter.pos # The range includes the quote mark
					false
				as indented
					throw unreachable
			as "\{"
				_ = take-next iter
				true
			as "\}"
				out ~= take-next iter
				state.diagnostics ~= (start-of-char, start-of-char + 1), parse-diag-closing-brace-needs-escape
				()
			as "\\"
				_ = take-next iter
				take-string-escape out, start-of-char, iter, state.diagnostics
				()
			as "\n"
				match quote-kind
				as bar
					iter2 = copy iter
					while peek-whitespace iter2
						_ = take-next iter2
					if iter2.peek == "|"
						_ = take-next iter2
						_ = try-take iter2, " "
						iter.pos := iter2.pos
						out ~= "\n"
						()
					else
						false
				as double
					state.diagnostics ~= (start-of-char, iter.pos), quote-double::parse-diag-expected
					false
				as indented
					throw unreachable
			as "\0"
				match quote-kind
				as bar
					()
				as double
					state.diagnostics ~= (start-of-char, iter.pos), quote-double::parse-diag-expected
				as indented
					throw unreachable
				false
			else
				out ~= take-next iter
				()
	if interpolate
		push-inside-braces state, quote-kind.to
		emit state, quote-kind.then-interpolated, start, end, text
	else
		emit state, quote-kind.no-interpolated, start, end, text

-take-string-escape void(out char8 builder, start pos, iter string-iterator, diagnostics parse-diagnostic mut[])
	unless take-string-escape out, iter
		string-escape-error out, start, iter, diagnostics

-string-escape-error void
	out char8 builder
	start pos
	iter string-iterator
	diagnostics parse-diagnostic mut[]
do
	diagnostics ~= (start, iter.pos), parse-diag-invalid-string-escape
	out ~~= "�"::char8[]

region whitespace (including comments)

cb-comment alias
	void mut(pos pos)

| Does not skip newlines (unless within a comment), only spaces within a line
skip-spaces-and-comments void(iter string-iterator, cb-comment cb-comment, diagnostics parse-diagnostic mut[])
	do until
	start = iter.pos
	if x = peek iter and is-whitespace-non-newline x
		_ = take-next iter
		false
	elif iter.peek == "#"
		if try-take-triple-hash-then-newline iter
			skip-rest-of-block-comment iter, diagnostics
			cb-comment[start]
		else
			while then try-take iter, " "
			skip-until-newline iter
			cb-comment[start]
		false
	else
		true

-skip-blank-lines-and-get-indent-delta int32(state lexer-state, iter string-iterator)
	repeat-until-indent-delta state, iter, of
		start mut = pos iter
		new-indent mut nat32 = 0
		cb-start-of-line = of
			start := iter.pos
			new-indent := take-indent-amount-after-newline state, iter
		skip-blank-lines iter, cb-start-of-line, {}, state.diagnostics
		start, new-indent

-get-indent-delta-after-quote int32(state lexer-state, iter string-iterator)
	repeat-until-indent-delta state, iter, of
		iter.pos, until
			amount = take-indent-amount-after-newline state, iter
			unless try-take iter, "\n"
				amount

-take-indent-amount-after-newline nat32(state lexer-state, iter string-iterator)
	take-indent-amount-after-newline iter, state.indent-kind, of pos
		state.diagnostics ~= (pos, iter.pos), parse-diag-indent-wrong state.indent-kind

-repeat-until-indent-delta int32(state lexer-state, iter string-iterator, f (pos, nat32) mut())
	do until
	start, new-indent = f[]
	delta = new-indent.to::int32 - state.cur-indent.to
	if delta > 1
		state.diagnostics ~= (start, iter.pos), parse-diag-indent-too-much
		skip-rest-of-line-and-newline iter
		()
	else
		# Ignore indent before end of file
		state.cur-indent := if is-at-end iter then 0 else new-indent
		delta

| Used for completions and signature help.
| Walks to the left skipping whitespace on the same line. Can also skip a single '.' or ','.
walk-backwards-for-position pos(source-text string-view, pos pos)
	index mut = pos
	index := skip-whitespace-backwards source-text, index
	if index != 0 and is-comma-or-dot source-text[index - 1]
		index -:= 1
		index := skip-whitespace-backwards source-text, index
		index -:= 1
	index
-is-comma-or-dot bool(a char8)
	a == "," or a == "."
-skip-whitespace-backwards pos(text string-view, index pos)
	cur mut pos = index
	do until
	if cur != 0 and text[cur - 1] == " "
		cur -:= 1
		()
	else
		cur

skip-blank-lines void
	iter string-iterator
	cb-start-of-line void mut()
	cb-comment cb-comment
	diagnostics parse-diagnostic mut[]
do
	do until
	cb-start-of-line[]
	before = iter.pos
	if try-take iter, "\n"
		false
	elif try-take-triple-hash-then-newline iter
		skip-rest-of-block-comment iter, diagnostics
		cb-comment[before]
		false
	elif try-take iter, "#"
		while then try-take iter, " "
		skip-until-newline iter
		cb-comment[before]
		false
	else
		true

-skip-rest-of-line-and-newline void(iter string-iterator)
	skip-until-newline iter
	_ = try-take iter, "\n"

-try-take-triple-hash-then-newline bool(iter string-iterator)
	iter2 = copy iter
	if try-take iter2, "###"
		while then try-take iter2, " "
		if try-take iter2, "\n" or iter2.is-at-end
			iter.pos := iter2.pos
			true

| Returns the end of the comment text ({iter} will be advanced further, past the '###')
-skip-rest-of-block-comment void(iter string-iterator, diagnostics parse-diagnostic mut[])
	do until
	while try-take iter, "\t" or try-take iter, " " then ()
	if try-take-triple-hash-then-newline iter
		true
	elif iter.is-at-end
		diagnostics ~= (iter.pos, iter.pos), block-comment-end
		true
	else
		skip-rest-of-line-and-newline iter
		false

-peek-operator-char bool(a string-iterator)
	(x = peek a) and is-operator-char x
-is-operator-char bool(a char8)
	match a
	as "." then true
	as "~" then true
	as "!" then true
	as "<" then true
	as ">" then true
	as "|" then true
	as "^" then true
	as "&" then true
	as "+" then true
	as "-" then true
	as "*" then true
	as "/" then true
	as "%" then true
	else then false
