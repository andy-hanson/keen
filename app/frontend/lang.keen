import
	../model/model
	../model/uri

# This is the 'request' to which main-fun is the response
main-kind union
	main-kind-main-function
	main-kind-tests
main-kind-main-function record
	uri uri
	| Does not include executable path
	program-args string[]
main-kind-tests record
	all bool
	root-uris uri set
	line nat?
root-uris uri set(a main-kind)
	match a
	as main-kind-main-function
		- a.uri
	as main-kind-tests
		a.root-uris
program-args string[](a main-kind)
	match a
	as main-kind-main-function then a.program-args
	as main-kind-tests then ()

config-base-name string()
	"config.kid"
is-config bool(a uri)
	a.base-name == config-base-name

max-spec-depth nat()
	8

file-type file-type(a uri)
	match extension a
	as ".class"
		class_
	as ".keen"
		keen
	as ".kid"
		kid
	else
		other
is-keen bool(a uri)
	a.extension == ".keen"
is-keen bool(a file-path)
	a.get-extension == ".keen"
file-type file-type(a file-path)
	file-type a.to

type-syntax-kind diag-type-should-use-syntax?(a symbol)
	match a
	as array
		array
	as map
		map
	as mut-array
		mut-array
	as mut-map
		mut-map
	as lambda-data
		lambda-data
	as lambda-mut
		lambda-mut
	as lambda-shared
		lambda-shared
	as option
		option
	as shared-array
		shared-array
	as shared-map
		shared-map
	as tuple2
		tuple
	as tuple3
		tuple
	as tuple4
		tuple
	as tuple5
		tuple
	as tuple6
		tuple
	as tuple7
		tuple
	as tuple8
		tuple
	as tuple9
		tuple
	else
		()
