import
	../model/ast
	../model/model
	../model/uri
	../util/by-name
	./check/instantiate
	./parse-java-class
	../util/java-bytecode-types
	../util/perf

java-ctx spec instantiate-ctx, java-classes, common-types
java-classes interface mut
	# The frontend is responsible for ensuring that referenced Java classes have already been loaded
	get-java-class type-decl(path path)
-get-java-class type-decl(path path) java-classes
	get-java-class the::java-classes, path

fill-java-class-supertypes void(type type-decl, class_ parsed-java-class) java-ctx
	start = perf-now
	finally end-fill-java-class-supertypes start
	fill-supertypes class_, type
	if class_.access[interface_]
		# Mark this as a sum-type. That is needed so that implementations can implicitly convert to it.
		# Methods will be fillted in by {fill-interface-methods} which is only done for directly imported types.
		type.body :=
			:: sum-type
			kind: java-interface
			listed-members: ()
			methods: ()

get-java-module java-class-module(path path, type type-decl, class_ parsed-java-class) java-ctx
	start = perf-now
	finally end-get-java-module start
	fill-interface-methods class_, class_.methods, type
	path: path
	public-exports:
		funs: to funs-for-java-class path, class_, type
		types-and-specs: to-by-name (type,), of _ then throw unreachable

initial-type-decl-for-java-class type-decl(a parsed-java-class) instantiate-ctx
	path = a.this-class
	hash: next-hash
	source:
		:: type-decl-source-java
		path: path
		name:
			base = base-name path
			if _, rest = try-split-once base, "$"
				rest.to
			else
				base.to
		type-params: for x in a.type-params then 0, x
	visibility: public
	mutability: mut_
	mutability-is-forced: false
	doc-comment-references: ()
	sum-type-cases: ()
	# For an interface, This will be overwritten by {fill-java-class-supertypes}
	body: java-class path, ()

-fill-supertypes void(class_ parsed-java-class, type type-decl) java-ctx
	type.specs := global-java-unsafe-specs

	type.sum-type-cases := for i in class_.interfaces
		ast: ()
		sum-type: to-type i, class_.type-params, ()
		method-impls: ()

	if class_.this-class == assume-path "java/lang/Throwable"
		# Hack to make all java Throwable classes appear to be Keen {exception}s.
		# These will be the same type at runtime.
		type.sum-type-cases ~:=
			ast: ()
			sum-type: exception
			# The method impls will not actually be emitted, so don't bother
			method-impls: ()

	if super = class_.super-class
		super-class = to-type super, class_.type-params, ()
		type.body.java-class!.super-class := super-class
		type.sum-type-cases ~~:= for x in super-class.decl.sum-type-cases
			ast: ()
			sum-type: instantiate-type-inst x.sum-type, super-class.type-args
			method-impls: ()

-fill-interface-methods void(class_ parsed-java-class, parsed-methods parsed-method[], type type-decl) java-ctx
	do if class_.access[interface_]
	assert type.body.sum-type
	type.body :=
		:: sum-type
		kind: java-interface
		listed-members: ()
		methods: for* method in parsed-methods
			do if method.access-flags[abstract_]
			# Ignore varargs; they just become normal array parameters
			(method.access-flags & ~varargs) is (abstract_ | public)
			return-type, params = method-return-type-and-params method, class_.type-params, false
			-
				container: type
				source: signature-source-java method.name
				return-type: return-type
				params: params
				doc-comment-references: ()

-funs-for-java-class fun-decl[](path path, class_ parsed-java-class, type type-decl) java-ctx
	class-type = instantiated-with-own-type-params type
	class-type-params name-and-range[] = for x in class_.type-params
		0, x
	is-interface = class_.access[interface_]
	do with out in build
	for field in class_.fields
		do if field.access-flags[public | static] # TODO: support instance fields
		out ~=
			hash: next-hash
			source: fun-source-java path, field.name, class-type-params
			visibility: public
			return-type: to-type field.generic-type, class_.type-params, ()
			params: ()
			specs: global-java-unsafe-specs
			doc-comment-references: ()
			body:
				:: fun-body-extern-java
				kind: static-field
				class_: path
				erased-return-type: to-type-never-generic field.erased-type
				erased-param-types: ()

	for method in class_.methods
		do if method.access-flags[public]
		is-static = method.access-flags[static]
		is-constructor = method.name == "<init>"
		return-type, most-params = method-return-type-and-params method, class_.type-params, true
		do if kind java-method-kind = if is-static
			if is-interface then static-method-of-interface else static-method-of-class
		elif is-constructor
			constructor
		elif is-interface
			()
		else
			virtual
		include-this-param = !(is-static or is-constructor)
		out ~=
			hash: next-hash
			source:
				:: fun-source-java
				class-path: path
				name: if is-constructor then "new" else method.name
				type-params:
					-- unless is-static then class-type-params
					-- for x in method.type-params then 0, x
			visibility: public
			return-type: if is-constructor then class-type else return-type
			params:
				-- if include-this-param
					- "this".local-source-generated, class-type
				-- most-params
			specs: global-java-unsafe-specs
			doc-comment-references: ()
			body:
				:: fun-body-extern-java
				erased-return-type = to-type-never-generic method.erased-return-type
				erased-param-types type-inst[] =
					-- if include-this-param
						- instantiated-with-Object type
					-- map method.erased-param-types, it.to-type-never-generic
				kind: kind
				class_: path
				erased-return-type: erased-return-type
				erased-param-types: erased-param-types

	if sum = type.body.sum-type
		sum.kind is java-interface
		erased-method-signatures type[][] = for* method in class_.methods
			do if method.access-flags[abstract_]
			unsupported-type-params = class_.type-params ~~ method.type-params
			-
				- to-type method.erased-return-type, (), unsupported-type-params
				- instantiated-with-Object type
				-- for param in method.erased-param-types
					to-type param, (), unsupported-type-params
		erased-method-signatures.size is sum.methods.size
		for index, method in with-index sum.methods
			out ~= fun-for-method type, class-type, index, method, erased-method-signatures[index]

-method-return-type-and-params (type, destructure[])
	method parsed-method
	class-type-params symbol[]
	support-method-type-params bool
do java-ctx
	type-params = class-type-params ~~ if support-method-type-params then method.type-params
	unsupported-type-params = unless support-method-type-params then method.type-params
	- to-type method.generic-return-type, type-params, unsupported-type-params
	- for i, x in with-index method.generic-param-types
		:: local
		source: local-source-generated "p{i}"
		type: to-type x, type-params, unsupported-type-params

-Object type-inst() java-ctx
	only-inst get-java-class assume-path "java/lang/Object"

-to-type-never-generic type-inst(type java-type) java-ctx
	type-inst! to-type type, (), ()
-to-type type(type java-type, type-params symbol[], unsupported-type-params symbol[]) java-ctx
	match type
	as void
		void
	as java-primitive-type
		type-from-primitive type
	as java-array-type
		buffer[to-type type.element, type-params, unsupported-type-params]
	as java-class-type
		to-type type, type-params, unsupported-type-params
	as java-type-param
		if index = index-of type-params, type.name
			type-param-index index
		else
			assert contains unsupported-type-params, type.name
			Object
-to-type type-inst(a java-class-type, type-params symbol[], unsupported-type-params symbol[]) java-ctx
	decl = get-java-class a.path
	if is-empty a.type-args
		# Sometimes signatures omit type arguments
		instantiated-with-Object decl
	else
		a.type-args.size is decl.type-params.size
		args = make-type-args a.type-args, of x
			to-type x, type-params, unsupported-type-params
		decl[args]

-instantiated-with-Object type-inst(decl type-decl) java-ctx
	decl[make-type-args decl.type-params, of _ then Object]

-type-from-primitive type(type java-primitive-type) common-types
	match type
	as T_BOOLEAN
		bool
	as T_CHAR
		nat16
	as T_FLOAT
		float32
	as T_DOUBLE
		float64
	as T_BYTE
		int8
	as T_SHORT
		int16
	as T_INT
		int32
	as T_LONG
		int64
