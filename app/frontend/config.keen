import
	../../lib/parse: expected, kid-parse-error, parse-kid, pos
	../model/model
	../model/source-range
	../model/uri

parse-config config(config-uri uri, text string-view)
	line-and-column-getter = line-and-column-getter-for-text text.to
	match parsed = parse-kid text
	as json
		diags diagnostic mut[] = ()
		content = parse-config-inner config-uri.parent-or-empty, diags, parsed
		config-uri: config-uri
		diagnostics: diags.move-to
		line-and-column-getter: line-and-column-getter
		include: content.include
		extern: content.extern
	as kid-parse-error
		range source-range = parsed.pos, parsed.pos + 1
		config-for-diag config-uri, parsed.expected.diag-config-invalid-kid, range, line-and-column-getter

-config-content record(include config-import-uris, extern config-extern-uris)
-parse-config-inner config-content(dir-containing-config uri, diags diagnostic mut[], obj json)
	include: parse-include dir-containing-config, diags, obj["include"]
	extern: parse-extern dir-containing-config, diags, obj["exclude"]

-parse-include config-import-uris(dir-containing-config uri, diags diagnostic mut[], json json)
	map-values json.to::json[symbol], of value
		parse-uri-or-bogus dir-containing-config, diags, value

-parse-extern config-extern-uris(dir-containing-config uri, diags diagnostic mut[], json json)
	map-values json.to::json[symbol], of value
		if value != null
			parse-uri-or-bogus dir-containing-config, diags, value

-parse-uri-or-bogus uri(dir-containing-config uri, diags diagnostic mut[], value json)
	parse-uri dir-containing-config, diags, value else bogus-uri
-parse-uri uri?(dir-containing-config uri, diags diagnostic mut[], json json)
	_ = diags
	parse-uri-with-cwd dir-containing-config, json.to::string
