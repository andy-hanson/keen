import
	keen/col/mut-sorted-set
	keen/unsafe
	../../lib/parse: kid-parse-error, expected, parse-kid, pos
	../model/ast
	../model/lsp
	../model/model
	../model/parse-diag
	../model/source-range
	../model/uri
	../util/enum-map
	../util/perf
	./check/check
	./check/check-ctx
	./check/detect-unused-internal
	./check/get-common-funs
	./check/get-common-types
	./check/instantiate
	./config
	./java-externs
	./lang
	./parse/parse
	./parse-java-class
	./show-model

builtin-java-paths alias
	(path, uri)[]

frontend record mut, java-classes case
	-keen-lib uri
	-builtin-java-paths builtin-java-paths
	-common-uris common-uris
	-common-files mut (common-module, keen-file) enum-map
	-unknown uri mut-set
	-loading uri mut-set
	instantiate-ctx instantiate-ctx
	line-and-column-getters -mut line-and-column-getter[uri]
	| Set after 'bootstrap.keen' is compiled
	-common-types-option mut common-types?
	-keen-files keen-file mut[uri]
	| Number of keen-files without {module} set
	-count-uncompiled-keen-files mut nat
	-kid-files kid-file mut[uri]
	-config-files config-file mut[uri]
	| Key is the Java class path such as "java/lang/Object"
	-java-class-files java-class-file mut[path]
	-other-files other-file mut[uri]
	| Set of keen files which are ready to compile immediately.
	| (Parsing and resolving imports is always done immediately.)
	| This doesn't include files whose imports are not yet compiled.
	| If all import uris are resolved but nothing is workable, there must be a circular import.
	-workable-java path mut-sorted-set
	-workable-keen uri mut-sorted-set
common-types common-types(a frontend)
	a.common-types-option!
get-java-class type-decl(a frontend, path path)
	a.java-class-files[path]!.type!

show-ctx show-ctx(a frontend, uris-info uris-info, options show-options)
	line-and-column-getters: a.line-and-column-getters
	uris-info: uris-info
	options: options

| True if the URI is imported through a file import (`./foo.txt as foo string`)
is-imported-file-uri bool(a frontend, uri uri)
	a.other-files[uri]

new frontend(keen-lib uri, builtin-java-paths builtin-java-paths)
	common-uris = common-uris keen-lib
	res frontend =
		keen-lib: keen-lib
		builtin-java-paths: builtin-java-paths
		common-uris: common-uris
		common-files: for _, uri in common-uris
			# Dummy value, about to get overwritten
			uri: uri
			referenced-by: ()
			config-file: (), unknown, ()
			config: ()
			ast-or-diag: unknown
			resolved-imports: ()
			module: ()
		unknown: ()
		loading: ()
		instantiate-ctx: ()
		line-and-column-getters: ()
		common-types-option: ()
		keen-files: ()
		count-uncompiled-keen-files: 0
		kid-files: ()
		config-files: ()
		java-class-files: ()
		other-files: ()
		workable-java: ()
		workable-keen: ()
	res.common-files := for _, uri in common-uris
		ensure-keen-file res, uri
	_ = ensure-java-class-file res, "java/lang/String".as-path, all
	res

|  This is initially empty and the fields fill in from top to bottom in various steps.
| * The config is determined ({config-file}, {config})
| * The file is (attempted) read and parsed and gets ({ast-or-diag})
| * Then imports are resolved ({resolved-imports})
| * Then a {module} is built
-keen-file record mut
	uri uri
	| Uris are for {keen-file}s
	referenced-by uri mut-set
	config-file config-file
	config mut config?
	ast-or-diag mut ast-or-diag
	| Also includes re-exports. Set once we have config.
	resolved-imports mut mostly-resolved-import[]?
	module mut keen-module?

-kid-file record mut
	line-and-column-getter mut line-and-column-getter
	parsed mut json?
	diagnostics mut diagnostic[]
-config-file record mut
	uri uri
	# If this is 'not-found' (and it usually is not-found), we will ignore it and use the parent
	config mut config-or-diag
	# Missing only for the root file
	parent config-file?
-config-or-diag union(config, read-file-diag)

-java-class-file record mut
	path path
	uri uri
	parsed mut java-class-or-diag
	work-needed mut java-work-kind
	type mut type-decl?
	has-filled-in-supertypes mut bool
	| This will be an empty option if we don't need to import this Java class as a module
	module mut java-class-module?
	| Uris are for {keen-file}s
	referenced-by-keen uri mut-set
	| Subclasses or interface implementers must be processed after their supertypes.
	| Processing a class body requires types to exist for all referenced classes.
	referenced-by-java path mut-set

-java-work-kind enum
	| The Java class is referenced, so we just need it as a type
	referencable
	| The Java class is used as a supertype, so we need its supertypes to copy to the subtype
	supertypes
	| The Java class is imported as a module, so we need all of its public methods.
	all

-java-class-or-diag union(parsed-java-class, read-file-diag)

-ast-or-diag union(file-ast, read-file-diag)

-other-file record mut
	uri uri
	content mut read-file-result
	| Uris are for {keen-file}s
	referenced-by uri mut-set

make-program-with-main program-with-main(a frontend, main main-kind, targets build-target set)
	fully-loaded-dirs uri set = filter main.root-uris, it.is-keen.not
	program-with-main-from-program a, (make-program a, fully-loaded-dirs), main, targets
program-with-main-from-program program-with-main
	a frontend
	program program
	main main-kind
	targets build-target set
do
	the instantiate-ctx = a.instantiate-ctx
	program, get-main-fun-and-diagnostics program, main, targets

make-program program(a frontend, fully-loaded-dirs uri set)
	start = perf-now
	finally end-make-program start
	a.files-state is all-loaded
	common-modules (common-module, keen-module) enum-map = for _, x in a.common-files
		x.module!
	the instantiate-ctx = a.instantiate-ctx
	the common-types = a.common-types
	the common-uris = a.common-uris
	common-funs, common-funs-diagnostics = get-common-funs common-modules
	keen-modules keen-module[uri] = for uri, file in a.keen-files
		uri, file.module!
	unused-diagnostics = detect-unused-internal keen-modules, fully-loaded-dirs
	kid-diagnostics uri-and-diagnostic[] = for* uri, file in a.kid-files
		map file.diagnostics, {uri, it}
	all-configs: for* uri, x in a.config-files
		if config = x.config.config
			- uri, config
	jar-files: all-jar-files a
	keen-modules: keen-modules
	java-modules: for* k, v in a.java-class-files
		if m = v.module
			- k, m
	all-java-classes: map-values a.java-class-files, it.type!
	additional-diagnostics: common-funs-diagnostics ~~ unused-diagnostics ~~ kid-diagnostics
	line-and-column-getters: a.line-and-column-getters
	common-funs: common-funs
	common-types: a.common-types

get-kid-file line-and-character-getter(a frontend, uri uri)
	if is-config uri
		a.config-files[uri]!.config.line-and-column-getter.line-and-character-getter
	else
		a.kid-files[uri]!.line-and-column-getter.line-and-character-getter
get-ast file-ast(a frontend, uri uri)
	get-ast a.keen-files[uri]!
-get-ast file-ast(a keen-file)
	to-ast a.ast-or-diag
line-and-character-getter line-and-character-getter(a frontend, uri uri)
	a.line-and-column-getters[uri]!.line-and-character-getter

| Changes them to loading
flush-all-unknown-uris uri[](a frontend)
	res uri[] = a.unknown.move-to
	a.loading ~~= res
	res

files-state enum(has-unknown, has-loading, all-loaded)
files-state files-state(a frontend)
	if not is-empty a.unknown
		has-unknown
	elif not is-empty a.loading
		has-loading
	else
		a.count-uncompiled-keen-files is 0
		all-loaded

change-file void(a frontend, uri uri, changes text-document-content-change-event[])
	set-file a, uri,
		string = apply-changes (line-and-character-getter a, uri), changes
		string.to::nat8[]

-apply-changes string(lc line-and-character-getter, events text-document-content-change-event[])
	cur mut string-view = source-text lc
	cur-lc mut = lc
	for i, event in with-index events
		if r = range event
			range source-range = cur-lc[r]
			cur :=
				-- cur[0 .. range.start].to
				-- event.text.to
				-- cur[range.end .. end].to
		else
			cur := event.text.to
		if i != events.size - 1
			cur-lc := line-and-character-getter-for-text cur
	cur.to

read-file-result union(nat8 array-view, read-file-diag)
set-file void(a frontend, uri uri, result read-file-result)
	result isnt unknown # Files don't change *to* unknown, only change out of that state
	match file-type uri
	as class_
		path = uri.as-jar-and-class-uri!.class-path-excluding-extension
		file = ensure-java-class-file a, path, referencable
		the instantiate-ctx = a.instantiate-ctx
		match result
		as array-view
			parsed = parse-java-class result
			file.parsed := parsed
			file.type := initial-type-decl-for-java-class parsed, uri
			ensure-java-class-references a, file
			for x in file.referenced-by-java
				add-to-workable-if-so a, x, a.java-class-files[x]!
		as read-file-diag
			file.parsed := result
			file.type := bogus-type-decl uri, path.base-name.to, 0
			file.has-filled-in-supertypes := true
		add-to-workable-if-so a, path, file
	as keen
		file = ensure-keen-file a, uri
		file.ast-or-diag := match result
		as array-view
			text string-view = safe-reinterpret-cast result
			parse-file uri, text, text.line-and-column-getter-for-text
		as read-file-diag
			result
		a.line-and-column-getters ~:= uri, file.ast-or-diag.line-and-column-getter
		updated-ast-or-config a, file
	as kid
		if is-config uri
			config-file = ensure-config-file-for a, uri
			config-file.config := match result
			as array-view
				parse-config uri, safe-reinterpret-cast result
			as read-file-diag
				match result
				as unknown
					throw unreachable
				as not-found
					result
				as error
					config-for-diag uri, error, (), ()
			a.line-and-column-getters ~:= uri, config-file.config.line-and-column-getter
			for file in values a.keen-files
				update-file-on-config-change a, file, uri
		else
			file = ensure-kid-file a, uri
			match result
			as array-view
				text string-view = safe-reinterpret-cast result
				file.line-and-column-getter := line-and-column-getter-for-text text
				match x = parse-kid text
				as json
					file.parsed := x
					file.diagnostics := ()
				as kid-parse-error
					file.parsed := null
					file.diagnostics :=
						- range: (x.pos, x.pos + 1), kind: parse-diag-kid x.expected
			as read-file-diag
				file.parsed := null
				file.diagnostics :=
					- (), result
			a.line-and-column-getters ~:= uri, file.line-and-column-getter
	as other
		file = ensure-other-file a, uri
		file.content := result
		for referencing-uri in file.referenced-by
			# TODO: It's is kind of inefficient to completely recompile referencing files if the content just changed.
			mark-module-dirty a, a.keen-files[referencing-uri]!
		for referencing-uri in file.referenced-by
			add-to-workable-if-so a, a.keen-files[referencing-uri]!

	if remove a.unknown, uri
		forbid a.loading[uri]
	else
		a.loading -= uri

	do-dirty-work a

-line-and-column-getter line-and-column-getter(a ast-or-diag)
	match a
	as file-ast then a.line-and-column-getter
	as read-file-diag then ()
-line-and-column-getter line-and-column-getter(a config-or-diag)
	match a
	as config then a.line-and-column-getter
	as read-file-diag then ()

-ensure-keen-file keen-file(a frontend, uri uri)
	uri.file-type is keen
	ensure a.keen-files, uri, of
		a.unknown ~= uri
		a.count-uncompiled-keen-files +:= 1
		config-file = ensure-config-file-for a, uri
		uri: uri
		referenced-by: ()
		config-file: config-file
		config: find-config config-file
		ast-or-diag: unknown
		resolved-imports: ()
		module: ()

-ensure-kid-file kid-file(a frontend, uri uri)
	uri.file-type is kid
	ensure a.kid-files, uri, of
		a.unknown ~= uri
		line-and-column-getter: ()
		parsed: ()
		diagnostics: ()

-ensure-config-file-for config-file(a frontend, keen-uri uri)
	ensure-config-file a, keen-uri.parent! / config-base-name
-ensure-config-file config-file(a frontend, uri uri)
	dir = uri.parent!
	parent config-file? = if parent-dir = dir.parent
		ensure-config-file a, parent-dir / config-base-name
	ensure a.config-files, uri, of
		a.unknown ~= uri
		uri: uri, config: unknown, parent: parent

-ensure-java-class-file java-class-file(a frontend, path path, work-needed java-work-kind)
	the instantiate-ctx = a.instantiate-ctx
	res = ensure a.java-class-files, path, of
		assert uri = get-uri-for-java-class a, path
		a.unknown ~= uri
		path: path
		uri: uri
		parsed: unknown
		work-needed: work-needed
		type: ()
		has-filled-in-supertypes: ()
		module: ()
		referenced-by-keen: ()
		referenced-by-java: ()
	if res.work-needed < work-needed
		res.work-needed := work-needed
		ensure-java-class-references a, res
		add-to-workable-if-so a, path, res
	res

-get-uri-for-java-class uri?(a frontend, path path)
	if jar-uri = get-jar-uri-for-java-class-path a, path
		make-jar-and-class-uri jar-uri, path

-all-jar-files file-path[](a frontend)
	sort-unique for* _, file in a.config-files
		if config = file.config.config
			config.imports.all-jar-files

-get-jar-uri-for-java-class-path uri?(a frontend, path path)
	jar-uri-for-builtin a, path or first a.config-files, of _, config-file
		do if config = config-file.config.config
		do if res, _ = config.imports[path]
		do if res.kind == jar
		res.uri

-ensure-java-class-references void(a frontend, file java-class-file)
	parsed = file.parsed
	do if parsed-java-class parsed
	match file.work-needed
	as referencable
		()
	as supertypes
		for ref in referenced-classes parsed
			if ref.is-supertype
				(ensure-java-class-file a, ref.path, supertypes).referenced-by-java ~= file.path
	as all
		for ref in referenced-classes parsed
			kind = if ref.is-supertype then supertypes else referencable
			(ensure-java-class-file a, ref.path, kind).referenced-by-java ~= file.path

-ensure-other-file other-file(a frontend, uri uri)
	uri.file-type is other
	ensure a.other-files, uri, of
		a.unknown ~= uri
		uri, unknown, ()

-to-ast file-ast(a ast-or-diag)
	match a
	as file-ast then a
	as read-file-diag then file-ast-for-diag a

-do-dirty-work void(a frontend)
	start = perf-now
	finally end-dirty-work start

	the instantiate-ctx = a.instantiate-ctx
	bootstrap = a.common-files[bootstrap]
	if a.workable-keen[bootstrap.uri] and java-String = ?only-inst ?type a.java-class-files[as-path "java/lang/String"]
		assert remove a.workable-keen, bootstrap.uri
		module, common-types = check-bootstrap a.keen-lib, a.common-uris, java-String,
			bootstrap.uri, bootstrap.config!, bootstrap.get-ast
		a.common-types-option := common-types
		bootstrap.module := module
		a.count-uncompiled-keen-files -:= 1
		mark-all-non-bootstrap-modules-dirty a, bootstrap.uri # since they all use common-types

	do if common-types = a.common-types-option
	the common-types = common-types
	do until
	if path = remove-min a.workable-java
		work-on-java-class a, path
		false
	elif uri = remove-min a.workable-keen
		file = a.keen-files[uri]!
		file.module := compile-non-bootstrap-module a, file
		a.count-uncompiled-keen-files -:= 1
		for importer in file.referenced-by
			add-to-workable-if-so a, a.keen-files[importer]!
		false
	elif is-empty a.unknown and is-empty a.loading and a.count-uncompiled-keen-files != 0
		fix-circular-imports a
		false
	else
		true

-work-on-java-class void(a frontend, path path) common-types, instantiate-ctx
	the java-classes = a
	file = a.java-class-files[path]!
	class_ = match x = file.parsed
	as parsed-java-class
		x
	as read-file-diag
		bogus-java-class path
	filled-in-supertypes = not file.has-filled-in-supertypes
	unless file.has-filled-in-supertypes
		fill-java-class-supertypes file.type!, class_
		file.has-filled-in-supertypes := true

	filled-body mut = false

	match file.work-needed
	as referencable
		throw unreachable
	as supertypes
		assert filled-in-supertypes
	as all
		if can-fill-class-body a, file
			filled-body := true
			file.module := get-java-module path, file.uri, file.type!, class_
		else
			assert filled-in-supertypes

	if filled-body
		for x in file.referenced-by-keen
			file.work-needed is all
			add-to-workable-if-so a, a.keen-files[x]!
	for x in file.referenced-by-java
		add-to-workable-if-so a, x, a.java-class-files[x]!

| This may not fix all circular imports, but it's run in a loop
-fix-circular-imports void(a frontend)
	do if _, file = find a.keen-files, of _, file then not file.module
	cycle-builder uri mut[] = ()
	_ = fix-circular-imports-recur a, cycle-builder, file
-fix-circular-imports-recur uri[](a frontend, cycle-builder uri mut[], file keen-file)
	forbid file.module
	cycle-builder ~= file.uri
	import-index = find-index! file.resolved-imports!, it.is-import-workable.not
	next = keen-file! file.resolved-imports![import-index]
	cycle uri[] = if contains cycle-builder, next.uri
		move-to cycle-builder
	else
		fix-circular-imports-recur a, cycle-builder, next
	new-import = circular-import rotate-to-first cycle, file.uri
	file.resolved-imports := update-at file.resolved-imports!, import-index, new-import
	_ = remove next.referenced-by, file.uri
	add-to-workable-if-so a, file
	cycle

-rotate-to-first[t] t[](values t[], first-value t) t equal
	index = index-of! values, first-value
	values[index .. end] ~~ values[0 .. index]

-compile-non-bootstrap-module keen-module(a frontend, file keen-file) instantiate-ctx
	assert is-workable file
	assert common-types = a.common-types-option # bootstrap must be compiled first
	ast uri-and-ast = file.uri, file.config!, file.get-ast
	imports = fully-resolve-imports file.resolved-imports!
	check a.keen-lib, a.common-uris, ast, imports, common-types

-update-file-on-config-change void(a frontend, file keen-file, changed-config-uri uri)
	do if new-config = get-changed-config file.config-file, changed-config-uri
	do unless is-default-config new-config and file.config and file.config!.is-default-config
	file.config := new-config
	updated-ast-or-config a, file

| Returns new config value if it has changed
-get-changed-config config?(a config-file, changed-config-uri uri)
	if a.uri == changed-config-uri
		match config = a.config
		as config
			config
		as read-file-diag
			find-config a
	else
		match a.config
		as config
			# It doesn't matter if some ancestor config changed, since this one has content
			()
		as read-file-diag
			?get-changed-config a.parent, changed-config-uri

| Returns empty option only for unknown config; default config is a non-empty option
-find-config config?(a config-file)
	match x = a.config
	as config
		x
	as read-file-diag
		match x
		as unknown
			()
		as not-found
			if p = a.parent
				find-config p
			else
				default-config
		as error
			throw unreachable # It will be a config with diagnostics in this case

-updated-ast-or-config void(a frontend, file keen-file)
	if file.config
		recompute-resolved-imports a, file
	else
		forbid file.resolved-imports or file.module

-recompute-resolved-imports void(a frontend, file keen-file)
	mark-module-dirty a, file
	circular-import = if file.resolved-imports
		clear-resolved-imports file
	file.resolved-imports := resolve-imports a, file.get-ast, file.config!, file.uri
	for x in file.resolved-imports!
		if rb = x.get-referenced-by
			rb ~= file.uri

	if circular-import
		unless has-circular-import file.resolved-imports!
			for uri in circular-import
				if uri != file.uri
					other = a.keen-files[uri]!
					ci = clear-resolved-imports other
					assert ci # But ignore since we've already handled it
					recompute-resolved-imports a, other

	add-to-workable-if-so a, file

-clear-resolved-imports uri[]?(file keen-file)
	circular-import mut uri[]? = ()
	for import_ in file.resolved-imports!
		if rb = import_.get-referenced-by
			_ = remove rb, file.uri
		else
			circular-import := as-circular-import import_
	file.resolved-imports := ()
	circular-import

-has-circular-import bool(a mostly-resolved-import[])
	some a, it.is-circular-import
-is-circular-import bool(a mostly-resolved-import)
	a.diag-import-file.?circular-import
-as-circular-import uri[]?(a mostly-resolved-import)
	if is-circular-import a
		a.diag-import-file!.circular-import!.cycle

-add-to-workable-if-so void(a frontend, path path, file java-class-file)
	if is-workable a, file
		a.workable-java ~= path
-add-to-workable-if-so void(a frontend, file keen-file)
	if is-workable file
		a.workable-keen ~= file.uri

-any-work-to-do bool(file java-class-file)
	match file.work-needed
	as referencable
		# Type is created as soon as file content is ready, not in a separate work step
		false
	as supertypes
		not file.has-filled-in-supertypes
	as all
		not file.module
-is-workable bool(a frontend, file java-class-file)
	do if any-work-to-do file
	match parsed = file.parsed
	as parsed-java-class
		has-all-supertypes = every parsed.referenced-in-supertypes, {can-use-reference a, it}
		match file.work-needed
		as referencable
			throw unreachable
		as supertypes
			has-all-supertypes
		as all
			if file.has-filled-in-supertypes
				can-fill-class-body a, file
			else
				# At least the work of filling in supertypes can be done
				has-all-supertypes
	as read-file-diag
		parsed != unknown
-can-fill-class-body bool(a frontend, file java-class-file)
	match parsed = file.parsed
	as parsed-java-class
		every parsed.referenced-classes, {can-use-reference a, it}
	as read-file-diag
		true

-can-use-reference bool(a frontend, ref java-class-reference)
	referenced-file = a.java-class-files[ref.path]!
	if ref.is-supertype
		referenced-file.has-filled-in-supertypes
	else
		referenced-file.type

-is-workable bool(a keen-file)
	forbid a.module
	a.ast-or-diag.read-file-diag != unknown and
	a.config and
	every a.resolved-imports!, it.is-import-workable
-is-import-workable bool(a mostly-resolved-import)
	match a
	as keen-file
		a.module
	as java-class-file
		a.module
	as other-file
		a.content != unknown
	as diag-import-file
		a.read-error.?diag isnt unknown
		true

-resolve-imports mostly-resolved-import[](a frontend, ast file-ast, config config, uri uri)
	do with out in build ast.count-imports-and-re-exports
	unless ast.no-std_
		out ~= a.common-files[std]
	if i = ast.imports
		for x in i.paths
			out ~= try-resolve-import a, config, uri, x
	if i = ast.re-exports
		for x in i.paths
			out ~= try-resolve-import a, config, uri, x

-count-imports-and-re-exports nat(a file-ast)
	a.no-std_.not.to::nat + (a.imports.?paths.?size else 0) + (a.re-exports.?paths.?size else 0)

-mark-all-non-bootstrap-modules-dirty void(a frontend, bootstrap uri)
	clear a.workable-java
	for path, file in a.java-class-files
		file.module := ()
		# No need to reset files that aren't yet workable, they'll be processed eventually anyway
		add-to-workable-if-so a, path, file
	for uri, x in a.keen-files
		if uri != bootstrap
			mark-module-dirty a, x
	clear a.workable-keen
	for uri, x in a.keen-files
		if uri != bootstrap
			add-to-workable-if-so a, x

-mark-module-dirty void(a frontend, file keen-file)
	a.workable-keen -= file.uri
	if file.module
		file.module := ()
		a.count-uncompiled-keen-files +:= 1
		for x in file.referenced-by
			mark-module-dirty a, a.keen-files[x]!

-fully-resolve-imports resolved-import[](imports mostly-resolved-import[])
	for file in imports
		match file
		as keen-file
			match x = file.ast-or-diag
			as file-ast
				file.module!
			as read-file-diag
				read-error file.uri, x
		as java-class-file
			match x = file.parsed
			as parsed-java-class
				file.module!
			as read-file-diag
				read-error file.uri, x
		as other-file
			match x = file.content
			as array-view
				imported-file file.uri, x
			as read-file-diag
				read-error file.uri, x
		as diag-import-file
			file

-common-uris common-uris(lib uri)
	col = lib / "col"
	private = lib / "private"
	for k in make-enum-map
		match k
		as array
			col / "array.keen"
		as bootstrap
			private / "bootstrap.keen"
		as buffer
			col / "buffer.keen"
		as exception
			lib / "exception.keen"
		as number
			lib / "number.keen"
		as js
			lib / "js.keen"
		as json
			lib / "json.keen"
		as range
			lib / "range.keen"
		as runtime
			private / "runtime.keen"
		as std
			lib / "std.keen"
		as string
			lib / "string.keen"
		as symbol
			lib / "symbol.keen"
		as test-util
			lib / "test-util.keen"

| For an unknown/loading file, this will still be a {keen-file} or {other-file}
-mostly-resolved-import union mut
	keen-file
	java-class-file
	other-file
	diag-import-file

-get-referenced-by uri mut-set?(a mostly-resolved-import)
	match a
	as keen-file
		a.referenced-by
	as java-class-file
		a.referenced-by-keen
	as other-file
		a.referenced-by
	as diag-import-file
		()

-try-resolve-import mostly-resolved-import
	a frontend
	config config
	from-uri uri
	ast import-or-export-ast
do
	match path = ast.path
	as path
		java = of
			no-file-imports ast, class_, of
				ensure-java-class-file a, path, all
		if rest = try-remove-start path, as-path "keen"
			# If you import just 'keen', 'rest' will be empty and it will be a resolution error.
			try-resolve-import-from-uri a, ast, a.keen-lib / rest
		elif jar-uri-for-builtin a, path
			java[]
		elif x, rest = config.imports[path]
			match x.kind
			as keen
				try-resolve-import-from-uri a, ast, x.uri / rest
			as jar
				java[]
		else
			library-not-configured path
	as rel-path
		if rel = resolve-uri-from-file from-uri, path
			try-resolve-import-from-uri a, ast, rel
		else
			relative-import-reaches-past-root path

-jar-uri-for-builtin uri?(a frontend, path path)
	first a.builtin-java-paths, of builtin-path, builtin-jar
		if starts-with path, builtin-path
			builtin-jar

-no-file-imports mostly-resolved-import(ast import-or-export-ast, file-type file-type, f mostly-resolved-import mut())
	match ast.kind
	as import-whole-module-ast
		f[]
	as array
		f[]
	as import-file-ast
		cant-import-as-content file-type

-try-resolve-import-from-uri mostly-resolved-import
	a frontend
	ast import-or-export-ast
	uri uri
do
	keen-file = {ensure-keen-file a, add-extension uri, ".keen"}
	match ast.kind
	as import-whole-module-ast
		keen-file[]
	as array
		keen-file[]
	as import-file-ast
		file-type = file-type uri
		if file-type == other
			ensure-other-file a, uri
		else
			cant-import-as-content file-type

test
	a frontend =
		keen-lib: parse-uri "test://bin/keen/lib"
		builtin-java-paths:
			- "java".as-path, "file:///java.base.jmod".assume-uri
	uri-a = parse-uri "test://src/a.keen"
	set-file a, uri-a, "a"::string.to::read-file-result
	get-file-content a, uri-a is "a"::char8[]
	change-file a, uri-a,
		- "a\nb\nc",
	get-file-content a, uri-a is "a\nb\nc"::char8[]
	change-file a, uri-a,
		- ((1, 0), (1, 1)), "y"
	get-file-content a, uri-a is "a\ny\nc"::char8[]
	change-file a, uri-a,
		- ((0, 0), (0, 1)), "x"
		- ((2, 0), (2, 1)), "z"
	get-file-content a, uri-a is "x\ny\nz"::char8[]
-get-file-content string-view(a frontend, uri uri)
	a.line-and-column-getters[uri]!.source-text
