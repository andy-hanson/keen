import
	keen/random/random
	../../model/model

instantiate-ctx record mut
	prng basic-prng
new instantiate-ctx()
	(),
next-hash nat32() instantiate-ctx
	next the::instantiate-ctx.prng

delay-spec-insts alias
	spec-inst mut[]
may-delay-spec-insts alias
	spec-inst mut[]?
no-delay-spec-insts may-delay-spec-insts()
	()

instantiate-fun fun-inst(decl fun-decl, type-args type-args, specs specs, spec-impls spec-impls)
	get-or-add-fun-inst decl, type-args, spec-impls, of
		- instantiate-return-and-param-types decl.return-type, decl.params, type-args
		- specs

instantiate-spec-or-type spec-or-type-inst
	decl spec-or-type
	type-args type-args
	delay-spec-insts may-delay-spec-insts
do instantiate-ctx
	match decl
	as spec-decl
		instantiate-spec decl, type-args, delay-spec-insts
	as type-alias
		decl.target
	as type-decl
		decl[type-args]

subscript spec-inst(decl spec-decl, type type) instantiate-ctx
	instantiate-spec decl, type.as-type-args, ()
instantiate-spec spec-inst(decl spec-decl, type-args type-args, delay-spec-insts may-delay-spec-insts) instantiate-ctx
	value, did-add = get-or-add-spec-inst decl, type-args
	if did-add
		if decl.body-is-set
			instantiate-spec-body value, delay-spec-insts
		else
			delay-spec-insts! ~= value
	value

instantiate-spec-body void(a spec-inst, delay-spec-insts may-delay-spec-insts) instantiate-ctx
	parents spec-or-type-inst[] = for parent in a.decl.parents.inner
		instantiate-spec-or-type-inst parent, a.type-args, delay-spec-insts
	a.builtin_ := with out in build
		for parent in parents
			if parent.spec-inst
				out ~~= parent.builtin_
		if b = a.decl.builtin_
			out ~= b, a.type-args
	a.all-contexts := to-type-args for* parent in parents
		match parent
		as spec-inst
			parent.all-contexts.slow-to-array
		as type-inst
			- parent
	a.all-sigs := with out in build
		for parent in parents
			if parent.spec-inst
				out ~~= parent.all-sigs
		out ~~= a.decl.sigs
	a.sig-types := with out in build
		for parent in parents
			if parent.spec-inst
				out ~~= parent.sig-types
		for sig in a.decl.sigs
			out ~= instantiate-return-and-param-types sig.return-type, sig.params, a.type-args

instantiate-specs specs(specs specs, type-args type-args) instantiate-ctx
	do unless is-empty type-args else specs
	get-or-add-specs for x in specs.inner
		instantiate-spec-or-type-inst x, type-args, no-delay-spec-insts

instantiate-spec-or-type-inst spec-or-type-inst
	inst spec-or-type-inst
	type-args type-args
	delay-spec-insts may-delay-spec-insts
do instantiate-ctx
	match inst
	as spec-inst
		instantiate-spec-inst inst, type-args, delay-spec-insts
	as type-inst
		instantiate-type-inst inst, type-args

instantiate-spec-inst spec-inst
	spec-inst spec-inst
	type-args type-args
	delay-spec-insts may-delay-spec-insts
do instantiate-ctx
	do unless is-empty type-args else spec-inst
	instantiated-type-args = instantiate-type-args spec-inst.type-args, type-args
	instantiate-spec spec-inst.decl, instantiated-type-args, delay-spec-insts

-instantiate-return-and-param-types return-and-param-types
	decl-return-type type
	decl-params destructure[]
	type-args type-args
do
	return-type = instantiate-type decl-return-type, type-args
	make-return-and-param-types return-type, decl-params, {instantiate-type it.type, type-args}

fun-for-method fun-decl
	type type-decl
	inst type-inst
	method-index nat
	method signature
	erased-signature type[]
do instantiate-ctx
	hash: next-hash
	source: method
	visibility: type.visibility
	return-type: method.return-type
	params:
		- destructure-ignore type, inst
		-- method.params
	specs: type.specs
	body: fun-body-method method-index, method, erased-signature
