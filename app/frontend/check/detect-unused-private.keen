import
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/by-key
	../../util/perf
	../walk-model
	./check-ctx
	./funs-for-type

detect-unused-private void(diags diagnostic mut[], module keen-module) common-types, common-uris
	start = perf-now
	used = gather-used module
	for fun in module.funs
		do if fun.visibility == private
		do unless ok-if-unused fun
		do unless used[fun]
		diags ~= fun.name-range.range, diag-unused-private-decl fun.name
	for type in module.types
		do if type.visibility == private
		do unless used[type]
		do unless some type.sum-type-cases, of m
			used[sum-type-case-getter module.funs, type, m]
		diags ~= type.name-range.range, type.name.diag-unused-private-decl
	for spec_ in module.specs
		do if spec_.visibility == private
		do unless used[spec_]
		diags ~= spec_.name-range.range, spec_.name.diag-unused-private-decl

	for x in used.unused-locals
		kind = if x.is-mutable and not used.unused-mut-locals[x]
			write-only
		else
			completely-unused
		diags ~= x.local-must-have-name-range, diag-unused-local x, kind
	for x in used.unused-mut-locals
		unless used.unused-locals[x]
			diags ~= x.local-must-have-name-range, diag-unused-local x, read-only

	for ast, imported in walk-explicit-imports module
		match kind = ast.kind
		as import-whole-module-ast
			unless has imported, used
				diags ~= ast.range, diag-unused-import imported, ()
		as array
			for name in kind
				unless has-for-name imported, name.name, used
					diags ~= name.range, diag-unused-import imported, name.name
		as import-file-ast
			()
	end-detect-unused-private start

ok-if-unused bool(a any-decl) common-types, common-uris
	a.fun-decl and ok-if-unused a
ok-if-unused bool(a fun-decl) common-types, common-uris
	match a.body
	as fun-body-uninitialized then throw unreachable
	as fun-body-extern-java then true
	as auto-fun then true
	as builtin-fun then false
	as enum-or-flags-member then true
	as expr then as-auto-fun-override a
	as expr-with-allocated-locals then false
	as fun-body-file-import then false
	as flags-function then true
	as fun-body-method then false
	as new-interface then true
	as new-record then true
	as record-field-get then true
	as record-field-set then true
	as sum-type-case-get then true
	as var-get then true
	as var-set then true

used record
	funs fun-decl set
	structs type-decl set
	specs spec-decl set
	vars var-decl set
	unused-locals local set
	unused-mut-locals local set
subscript bool(a used, x fun-decl)
	a.funs[x]
subscript bool(a used, x type-decl)
	a.structs[x]
subscript bool(a used, x spec-decl)
	a.specs[x]
subscript bool(a used, t spec-or-type)
	match t
	as spec-decl
		a[t]
	as type-alias
		a[t.target.decl]
	as type-decl
		a[t]

gather-used used(module keen-module) common-types
	funs fun-decl mut-set = ()
	types type-decl mut-set = ()
	specs spec-decl mut-set = ()
	vars var-decl mut-set = ()

	unused-locals local mut-set = ()
	unused-mut-locals local mut-set = ()

	for _, kind, ref in walk-module module
		match ref
		as doc-comment-reference-bogus
			()
		as doc-comment-reference-context
			()
		as called-spec-sig
			()
		as enum-or-flags-member
			()
		as fun-decl
			funs ~= ref
		as local
			match kind
			as declare-local
				unused-locals ~= ref
				if is-mutable ref
					unused-mut-locals ~= ref
			as get-local
				_ = remove unused-locals, ref
			as set-local
				_ = remove unused-mut-locals, ref
			as comment
				()
			else
				throw unreachable
		as record-field
			()
		as signature
			()
		as spec-decl
			specs ~= ref
		as type-alias
			()
		as type-decl
			types ~= ref
		as type-param-index
			()
		as var-decl
			vars ~= ref

	if module.ast.no-std_
		# Ensure return types of auto funs count as used (e.g. 'comparison')
		for fun in module.funs
			do if fun.body.auto-fun
			types ~= fun.return-type.type-inst!.decl

	funs.move-to, types.move-to, specs.move-to, vars.move-to, unused-locals.move-to, unused-mut-locals.move-to

-has bool(module module, used used)
	exports = module.public-and-internal-exports
	some exports.funs, used[it] or some exports.types-and-specs, used[it]

-has-for-name bool(module module, name symbol, used used)
	exports = module.public-and-internal-exports
	some (all-with-name exports.funs, name), used[it] or
	x = exports.types-and-specs[name] and used[x] or
	name == "compare" or name == "equal" # 'equal' and 'compare' are needed when checking certain auto-funs
