import
	keen/unsafe
	../../model/model
	../../util/object-pools

-type-contexts global(inference? buffer-allocator) = ()
-all-candidates global(candidates) = 0x1000,
-n-live-stack-array global(nat) = ()
-type-and-context-arrays global(type-and-context mut-array-allocator) = ()

assert-all-allocated-freed void()
	do trusted
	assert-all-free type-contexts
	assert-all-free all-candidates
	n-live-stack-array is 0
	assert-all-free type-and-context-arrays

inference-kind enum
	| The type must be exactly as specified
	exact
	| The type may be widened (for example, from `nat` to `nat?`).
	| Suppose we are calling `push[t] void(value t, a t mut[])`.
	| When we check the first arg, we might infer the type as `nat allow-wider`.
	| Then if the argument turns out to be a `nat? mut[]`, we would upgrade `t` to `nat?` with `exact`.
	allow-wider
	| The type may be narrowed (for example, from `nat?` to `nat`).
	| Suppose we are calling `first[t] t(a t[])` and the expected type is `nat?`.
	| We would check the return type first. Then `t` would be inferred at `nat?` with `allow-narrower`.
	| Then if the argument turns out to be a `nat[]`, we would upgrade `t` to `nat` with `exact`.
	allow-narrower
inference record
	kind inference-kind
	type type

type-context alias
	inference? buffer

with-type-context-for[t] t(n-type-params nat, f t mut(x type-context))
	do trusted
	context = allocate-gc-safe-values type-contexts, n-type-params
	finally free type-contexts, context
	f[context]

| This optimizes for the common case of a non-generic, non-variadic candidate.
candidate union(fun-inst, called-spec-sig, full-candidate) mut
| Used for generic or variadic functions.
| `inferring-type-args` will usually be non-empty,
| but not for a variadic function or a function with specs but no type params.
full-candidate record mut, -new
	called -mut called-decl
	variadic-type type?
	inferring-type-args type-context

called called-decl(a candidate)
	match a
	as fun-inst then a.decl
	as called-spec-sig then a
	as full-candidate then a.called
inferring-type-args type-context(a candidate)
	match a
	as fun-inst then ()
	as called-spec-sig then ()
	as full-candidate then a.inferring-type-args

init-candidate candidate(called called-decl)
	match called
	as fun-decl
		if is-template called
			called: called
			variadic-type: ()
			inferring-type-args: n-of called.n-type-params, ()
		else
			only-inst called
	as called-spec-sig
		called

init-variadic-candidate candidate(called called-decl, element-type type)
	called: called
	variadic-type: element-type
	inferring-type-args: n-of called.n-type-params, ()

| This optimizes for the common case of a type with no context.
type-and-context union(bogus-type, type-param-index, type-inst, full-type-and-context) mut
type type(a type-and-context)
	match a
	as bogus-type then a
	as type-param-index then a
	as type-inst then a
	as full-type-and-context then a.type

type-and-maybe-context type-and-context(type type, context type-context)
	if is-empty context
		non-inferring type
	else
		full-type-and-context type, context
type-and-new-context type-and-context(a type-with-container)
	context-size = a.container.n-type-params
	if context-size == 0
		non-inferring a.type
	else
		full-type-and-context a.type, n-of context-size, ()

full-type-and-context record mut
	dummy void
	type type
	context type-context
full-type-and-context full-type-and-context(type type, context type-context)
	forbid is-empty context
	(), type, context
to json(a full-type-and-context)
	type: a.type.to
	context: a.context.to
non-inferring type-and-context(type type)
	match type
	as bogus-type then type
	as type-param-index then type
	as type-inst then type
identical bool(a type-and-context, b type-and-context)
	trusted reference-equal a, b
as-non-inferring type?(a type-and-context)
	match a
	as bogus-type then a
	as type-param-index then a
	as type-inst then a
	as full-type-and-context then ()
copy type-and-context(a type-and-context)
	match a
	as full-type-and-context then full-type-and-context a.type, copy a.context
	else then a
with-type type-and-context(a type-and-context, new-type type)
	match a
	as full-type-and-context then with-type a, new-type
	else then non-inferring new-type
with-type full-type-and-context(a full-type-and-context, new-type type)
	full-type-and-context new-type, a.context

allocate type-and-context mut[]()
	trusted allocate type-and-context-arrays
free void(value type-and-context mut[])
	trusted free type-and-context-arrays, value

non-inferring type-context()
	()
is-fully-inferred bool(a type-context)
	every a, {it}

| This is used for stack-array arrays.
| Since only one stack-array array is active at a time, we store them all together concatenated.
stack-array[t] record mut
	| Remember to access this between {cur-array-start} and {cur-array-end}
	-all-entries t buffer
	-cur-array-start mut nat
	-cur-array-end mut nat
-new[t] t stack-array(capacity nat) unsafe
	capacity.uninitialized-buffer, 0, 0
candidates alias
	candidate stack-array
-to[t] t[](a t stack-array)
	a.all-entries[a.cur-array-start .. a.cur-array-end].to

assert-all-free[t] void(a t stack-array)
	a.cur-array-start is 0
	a.cur-array-end is 0

some[t] bool(a t stack-array, f bool mut(x t))
	some a.cur-array-start .. a.cur-array-end, f[a.all-entries[it]]

is-empty[t] bool(a t stack-array)
	a.cur-array-start == a.cur-array-end

size[t] nat(a t stack-array)
	a.cur-array-end - a.cur-array-start

| Remember to call {free-candidates}
allocate-candidates (candidate stack-array, nat)() unsafe
	do trusted
	restore = push-context all-candidates
	all-candidates, restore

free-candidates void(candidates candidates, restore nat) unsafe
	do trusted
	assert candidates 'reference-equal all-candidates
	pop-context all-candidates, restore

clear-candidates[t] void(a t stack-array)
	for i in a.cur-array-start .. a.cur-array-end
		a.all-entries[i] := trusted gc-safe-value
	a.cur-array-end := a.cur-array-start

| Returns the restore info. Pass this into {pop-context}.
push-context[t] nat(a t stack-array)
	res = a.cur-array-start
	a.cur-array-start := a.cur-array-end
	res

pop-context[t] void(a t stack-array, restore nat)
	clear-candidates a
	a.cur-array-start := restore

~=[t] void(a t stack-array, value t)
	a.all-entries[a.cur-array-end] := value
	a.cur-array-end +:= 1

-filter-unordered-starting-from[t] void(a t stack-array, start nat, f bool mut(x t))
	i mut = start
	until i == a.cur-array-end
		if f[a.all-entries[i]]
			i +:= 1
		else
			remove-at-unordered a, i

filter-tri-result enum(reject, allow, prefer)
filter-unordered-tri[t] void(a t stack-array, f filter-tri-result mut(x t))
	i mut = a.cur-array-start
	do until
	i == a.cur-array-end or
	match f[a.all-entries[i]]
	as prefer
		remove-before a, i
		filter-unordered-starting-from a, a.cur-array-start + 1, f[it] == prefer
		true
	as allow
		i +:= 1
		false
	as reject
		remove-at-unordered a, i
		false

| Filters out all elements not at the max priority
filter-unordered-max-priority[t] void(a t stack-array, get-priority nat mut(x t))
	do if a.size > 1
	max-priority mut = 0
	i mut = a.cur-array-start
	# Invariant: elements a.cur-array-start .. i are at max priority
	do until i == a.cur-array-end
	priority = get-priority[a.all-entries[i]]
	match priority <=> max-priority
	as less
		remove-at-unordered a, i
	as equal
		i +:= 1
	as greater
		max-priority := priority
		a.all-entries[a.cur-array-start] := a.all-entries[i]
		for j in a.cur-array-start + 1 .. i + 1
			remove-at-unordered a, j
		i := a.cur-array-start + 1

test
	xs nat stack-array = trusted 5,
	for x in (11, 12, 21, 22)::nat[]
		xs ~= x
	filter-unordered-max-priority xs, it % 10
	xs.to::nat[] is (12, 22)

| Note: This is used in a situation where there will be a diagnostic if {a} isn't down to a single entry after this.
| So it's acceptable to do O(n^2) comparisons in the worst case (where partial-comparison always returns {equal},
| since there is a diagnostic in that case.
filter-partial-compare[t] void(a t stack-array, partial-comparison comparison mut(a t, b t))
	do if a.size > 1
	i mut = a.cur-array-start
	j mut = i + 1
	do until
	if j == a.cur-array-end
		i +:= 1
		if i == a.cur-array-end
			true
		else
			j := i + 1
			false
	else
		match partial-comparison[a.all-entries[i], a.all-entries[j]]
		as less
			remove-at-unordered a, i
			j := i + 1
		as equal
			j +:= 1
		as greater
			remove-at-unordered a, j
		false

filter-unordered[t] void(a t stack-array, f bool mut(x t))
	filter-unordered-starting-from a, a.cur-array-start, f

filter-unordered-but-dont-remove-all[t] void(a t stack-array, f bool mut(x t))
	i mut = a.cur-array-start
	do until
	if i == a.cur-array-end
		# Got to the end and no candidate passed the test. In this case we have done nothing.
		true
	elif f[a.all-entries[i]]
		remove-before a, i
		filter-unordered-starting-from a, a.cur-array-start + 1, f
		true
	else
		i +:= 1
		false

# This moves the entry at 'i' to the beginning, and drops everything that was before it.
-remove-before[t] void(a t stack-array, i nat)
	if i != a.cur-array-start
		a.all-entries[a.cur-array-start] := a.all-entries[i]
		remove-at-unordered a, i
		for j in a.cur-array-start + 1 .. i
			remove-at-unordered a, j

test
	xs nat stack-array = trusted 5,
	for x in 1 .. 5
		xs ~= x
	filter-unordered-but-dont-remove-all xs, it.is-even
	xs.to::nat[] is (2, 4)
	filter-unordered-but-dont-remove-all xs, it.is-even.not
	xs.to::nat[] is (2, 4)
	filter-unordered-but-dont-remove-all xs, it < 3
	xs.to::nat[] is (2,)

-remove-at-unordered[t] void(a t stack-array, i nat)
	take-from = a.cur-array-end - 1
	a.all-entries[i] := a.all-entries[take-from]
	a.all-entries[take-from] := trusted gc-safe-value
	a.cur-array-end := take-from
