import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-key
	./instantiate

get-common-types common-types
	uri uri
	diagnostics-builder diagnostic mut[]
	java-String type-inst
	types-and-specs-map types-and-specs-map
do instantiate-ctx
	the context = uri, diagnostics-builder, types-and-specs-map
	char8 = non-template "char8"
	char32 = non-template "char32"
	symbol = non-template "symbol"
	array = get-decl "array", 1
	option = get-decl "option", 1
	java-spec = non-template-spec java
	global_ = non-template-spec global_
	unsafe = non-template-spec unsafe

	bool: non-template "bool"
	char8: char8
	char16: non-template "char16"
	char32: char32
	comparison: non-template "comparison"
	exception: non-template "exception"
	float32: non-template "float32"
	float64: non-template "float64"
	hash-state: non-template "hash-state"
	int8: non-template "int8"
	int16: non-template "int16"
	int32: non-template "int32"
	int64: non-template "int64"
	nat8: non-template "nat8"
	nat16: non-template "nat16"
	nat32: non-template "nat32"
	nat64: non-template "nat64"
	java-String: java-String
	js-any: non-template "js-any"
	json: non-template "json"
	json-object: non-template "json-object"
	none: non-template "none"
	string: non-template "string"
	symbol: symbol
	symbol-array: array[symbol]
	void: non-template "void"
	array: array
	array-view: get-decl "array-view", 1
	buffer: get-decl "buffer", 1
	buffer-view: get-decl "buffer-view", 1
	char8-array: array[char8]
	char32-array: array[char32]
	option: option
	reference: get-decl "reference", 1
	tuples: for i in 2 .. max-type-params.to + 1
		get-decl "tuple{i}", i.to
	lambda-data: get-decl "lambda-data", 2
	lambda-shared: get-decl "lambda-shared", 2
	lambda-mut: get-decl "lambda-mut", 2
	compare: spec-decl "compare"
	equal: spec-decl "equal"
	from-json: spec-decl "from-json"
	hash: spec-decl "hash"
	to-json: spec-decl "to-json"
	global-spec: global_
	unsafe-spec: unsafe
	java-spec: java-spec
	js-spec: non-template-spec js
	global-java-unsafe-specs: get-or-add-specs (java-spec, global_, unsafe)
	global-unsafe-specs: get-or-add-specs (global_, unsafe)
	unsafe-specs: get-or-add-specs (unsafe,)

-context record mut
	module-uri uri
	diagnostics-builder diagnostic mut[]
	types-and-specs-map types-and-specs-map
-ctx spec instantiate-ctx, context
-types-and-specs-map types-and-specs-map() context
	the::context.types-and-specs-map

-add-diag-missing void(name symbol) ctx
	the::context.diagnostics-builder ~= (), name.diag-common-type-missing

-get-decl type-decl(name symbol, n-type-parameters nat8) ctx
	get-common-template-type name, n-type-parameters else
		add-diag-missing name
		bogus-type-decl the::context.module-uri, name, n-type-parameters

-non-template type-inst(name symbol) ctx
	get-common-non-template-type name else
		add-diag-missing name
		only-inst bogus-type-decl the::context.module-uri, name, 0

-spec-decl spec-decl(name symbol) ctx
	?spec-decl types-and-specs-map[name] else
		add-diag-missing name
		throw todo

-non-template-spec spec-inst(builtin_ builtin-spec) ctx
	name symbol = builtin_.to
	decl = ?spec-decl types-and-specs-map[name]
	if decl and decl.n-type-params == 0
		res, did-add = get-or-add-spec-inst decl, ()
		assert did-add
		res.builtin_ := ((builtin_, no-type-args),)
		res
	else
		add-diag-missing name
		throw todo

-get-common-template-type type-decl?(name symbol, expected-type-params nat8) ctx
	if decl = types-and-specs-map[name].?type-decl
		if decl.n-type-params == expected-type-params
			decl

-get-common-non-template-type type-inst?(name symbol) ctx
	if decl = types-and-specs-map[name].?type-decl
		decl.n-type-params is 0
		only-inst decl

bogus-type-decl type-decl(uri uri, name symbol, n-type-parameters nat) instantiate-ctx
	hash: next-hash
	source: type-decl-source-bogus uri, name, for i in 0::nat .. n-type-parameters
		0, "t{i}"
	visibility: public
	specs: ()
	mutability: data_
	mutability-is-forced: false
	doc-comment-references: ()
	sum-type-cases: ()
	body: type-body-bogus
