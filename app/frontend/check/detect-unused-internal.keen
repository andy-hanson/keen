import
	keen/col/mut-queue
	../../model/ast
	../../model/model
	../../model/uri
	../../util/perf
	../walk-model
	./check-ctx
	./detect-unused-private: ok-if-unused

detect-unused-internal uri-and-diagnostic[]
	all-modules keen-module[uri]
	fully-loaded-dirs uri set
do common-types, common-uris
	do unless is-empty fully-loaded-dirs

	start = perf-now
	finally end-detect-unused-internal start
	states decl-state mut[any-decl] = ()
	queue any-decl mut-queue = ()
	each-decl all-modules, of decl
		states[decl] := if is-public-or-main-or-test decl
			queue ~= decl
			public, true
		else
			(), false

	add-it = of decl any-decl, usage visibility
		if old-state = states[decl]
			states[decl] := (max usage, old-state.usage), true
			unless old-state.added-to-queue
				queue ~= decl

	while x = dequeue queue
		if x.fun-decl and !x.source.fun-decl-ast
			# Mark the return type as used.
			# So if you have 'r record(x nat)' and use '1.r.x', 'r' is considered used,
			# even though no fun with an AST used it.
			return = x.return-type
			if return.type-inst
				add-it[return.decl, internal]
		walk-any-decl x, of _, kind, ref
			do unless kind == comment
			do if decl = as-any-decl ref
			# TODO: for *private* sum types we could still consider it private
			usage = if x.module-uri == decl.module-uri and kind != explicit-internal and kind != sum-type-method-impl
				private
			else
				internal
			add-it[decl, usage]

	for* decl, state in states
		do unless decl.type-alias
		diag diag? = if u = state.usage
			if u < decl.visibility
				if false # TODO: This was generating too many errors
					diag-unused-internal-decl decl.name, true
		elif !ok-if-unused decl and decl.visibility != private # Privates handled by detect-unused-private
			diag-unused-internal-decl decl.name, false
		do if diag
		do if config-uri = all-modules[decl.module-uri]!.config.config-uri
		do if fully-loaded-dirs[config-uri.parent!]
		- decl.name-range, diag

-each-decl void(modules keen-module[uri], f void mut(x any-decl))
	for _, module in modules
		each-decl module, f

-as-any-decl any-decl?(a doc-comment-reference)
	match a
	as doc-comment-reference-bogus then ()
	as doc-comment-reference-context then ()
	as called-spec-sig then ()
	as enum-or-flags-member then ()
	as fun-decl then a
	as local then ()
	as record-field then ()
	as signature then ()
	as spec-decl then a
	as type-alias then ()
	as type-decl then a
	as type-param-index then ()
	as var-decl then a

-is-public-or-main-or-test bool(a any-decl)
	a.visibility == public or is-main a or a.test_
-is-main bool(a any-decl)
	a.fun-decl and a.visibility != private and a.name == "main"

-decl-state record
	usage visibility?
	added-to-queue bool
