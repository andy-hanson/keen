import
	../../model/ast
	../../model/model
	../../model/source-range
	./check-call/candidates
	./check-ctx
	./type-from-ast

check-doc-comments void
	funs-map funs-map
	type-aliases type-alias[]
	types type-decl[]
	spec-decls spec-decl[]
	vars var-decl[]
	funs fun-decl[]
	tests test_[]
do check-ctx, types-and-specs-map
	check-ref = of type-params type-params, specs specs, ast name-and-range
		check-doc-comment-reference funs-map, type-params, specs, ast
	check-ref-for-sig = of type-params type-params, specs specs, params destructure[], ast name-and-range
		reference-in-params params, ast.name else check-ref[type-params, specs, ast]
	check-refs = of type-params type-params, specs specs, ast doc-comment-ast
		check-doc-comment-references funs-map, type-params, specs, ast
	check-refs-for-decl = of decl any-decl
		check-refs[decl.type-params, decl.specs, decl.doc-comment-ast]
	check-refs-for-type = of type type-decl, ast doc-comment-ast
		check-refs[type.type-params, (), ast]

	for x in type-aliases
		x.doc-comment-references := check-refs-for-decl[x]
	for type in types
		type.doc-comment-references := check-refs-for-decl[type]
		match body = type.body
		as type-body-bogus
			()
		as builtin-type
			()
		as enum_
			for member in body.members
				member.doc-comment-references := check-refs-for-type[type, member.doc-comment-ast]
		as flags_
			for member in body.members
				member.doc-comment-references := check-refs-for-type[type, member.doc-comment-ast]
		as java-class
			()
		as record_
			for field in body.fields
				field.doc-comment-references := check-refs-for-type[type, field.doc-comment-ast]
		as sum-type
			for sig in body.methods
				sig.doc-comment-references := for ast in sig.doc-comment-ast.references
					check-ref-for-sig[type.type-params, (), sig.params, ast]
	for spec_ in spec-decls
		spec_.doc-comment-references := check-refs-for-decl[spec_]
		for sig in spec_.sigs
			sig.doc-comment-references := for ast in sig.doc-comment-ast.references
				reference-spec-sig spec_, ast.name else
					check-ref-for-sig[spec_.type-params, spec_.parents, sig.params, ast]
	for x in vars
		x.doc-comment-references := check-refs-for-decl[x]
	for x in funs
		x.doc-comment-references := for ast in x.doc-comment-ast.references
			check-ref-for-sig[x.type-params, x.specs, x.params, ast]
	for x in tests
		x.doc-comment-references := check-refs-for-decl[x]

check-doc-comment-references doc-comment-reference[]
	funs-map funs-map
	type-params type-params
	specs specs
	ast doc-comment-ast
do check-ctx, types-and-specs-map
	for name in ast.references
		check-doc-comment-reference funs-map, type-params, specs, name

-check-doc-comment-reference doc-comment-reference
	funs-map funs-map
	type-params type-params
	specs specs
	ast name-and-range
do check-ctx, types-and-specs-map
	name = ast.name
	if x = find-index type-params, it.name == name
		(x,)::type-param-index
	elif x = spec-or-type-from-name name, ast.range, true
		x.to
	elif x = reference-fun funs-map, specs, name
		x
	else
		add-diag ast.range, diag-name-not-found doc-comment-reference, name
		doc-comment-reference-bogus

-reference-in-params doc-comment-reference?(params destructure[], name symbol)
	first params, of::local? param # TODO: type annotation should not be necessary
		find param.locals, it.name == name

-reference-spec-sig doc-comment-reference?(cur-spec spec-decl, name symbol)
	::signature? # TODO: type annotation should not be necessary
	find cur-spec.sigs, it.name == name

-reference-fun doc-comment-reference?(funs-map funs-map, specs specs, name symbol) check-ctx
	do if called = first-fun-in-scope funs-map, specs, name
	match called
	as fun-decl then doc-comment-reference-for-fun-decl called
	as called-spec-sig then called

-doc-comment-reference-for-fun-decl doc-comment-reference(a fun-decl)
	return-type = {a.return-type.type-inst!.decl}
	match body = a.body
	as fun-body-bogus
		doc-comment-reference-bogus
	as fun-body-uninitialized
		throw unreachable
	as fun-body-extern-java
		a
	as auto-fun
		a
	as fun-body-builtin
		a
	as enum-or-flags-member
		return-type[]
	as fun-body-expr
		a
	as fun-body-file-import
		a
	as fun-body-flags-function
		return-type[]
	as fun-body-method
		body.method
	as new-interface
		return-type[]
	as new-record
		return-type[]
	as record-field-get
		body.field
	as record-field-set
		body.field
	as sum-type-case-get
		return-type[]
	as var-get
		body.var
	as var-set
		body.var

-first-fun-in-scope called-decl?(funs-map funs-map, specs specs, name symbol) check-ctx
	res mut called-decl? = ()
	each-fun-in-scope-with-name (specs, funs-map), name, of x
		unless r = res and r.range < x.range
			res := x
	res
