import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/enum-map
	./instantiate

check-ctx spec instantiate-ctx, check-context
check-context record mut
	keen-lib uri
	common-uris common-uris
	cur-uri uri
	config config
	cur-module-is-no-std bool
	module-imports-and-re-exports import-or-export[]
	imports-and-re-exports exports[]
	diagnostics-builder diagnostic mut[]

import-or-export record force-data
	| Empty for an automatic import of std
	source import-or-export-ast?
	module module
	import-visibility export-visibility
	named-imported mut exports

cur-module-is-no-std bool() check-context
	the::check-context.cur-module-is-no-std
common-uris common-uris() check-context
	the::check-context.common-uris
cur-uri uri() check-context
	the::check-context.cur-uri
imports-and-re-exports exports[]() check-context
	the::check-context.imports-and-re-exports

common-module enum
	array
	bootstrap
	buffer
	exception
	number
	js
	json
	range
	runtime
	std
	string
	symbol
common-uris alias
	(common-module, uri) enum-map

add-diag-assert-same-uri void(range uri-and-range, diag diag) check-context
	range.uri is cur-uri
	add-diag range.range, diag

add-diag void(range source-range, diag diag) check-context
	add-diag (range, diag)
add-diag void(diag diagnostic) check-context
	the::check-context.diagnostics-builder ~= diag

finish-diagnostics diagnostic[]() check-context
	move-to the::check-context.diagnostics-builder

visibility-from-explicit-top-level visibility(a visibility-and-range?)
	a.?visibility else internal

check-no-type-params void(type-params type-params, decl-kind decl-kind) check-ctx
	unless is-empty type-params
		add-diag type-params.type-params-range, diag-type-params-unsupported decl-kind
