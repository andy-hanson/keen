import
	../../../model/ast
	../../../model/model
	../../../model/source-range
	../../lang
	../../../util/util
	../allocators
	../check-ctx
	../expr-ctx
	../instantiate
	./candidates

is-shared bool(fun-specs specs, type type)
	is-mutability-always-compatible-considering-specs fun-specs, type, shared_

check-no-contexts bool
	container type-container
	kind diag-contexts-not-allowed-kind
	diag-range source-range
	called called
do check-ctx
	match called
	as called-bogus
		true
	as fun-inst
		if is-empty called.specs.all-contexts
			true
		else
			add-diag diag-range, diag-contexts-not-allowed container, kind, called
			false
	as called-spec-sig
		true

check-contexts void(diag-range source-range, called called) check-expr-ctx
	do if called.fun-inst
	for context in called.specs.all-contexts
		_ = get-the diag-range, context.type-inst!

check-call-specs-except-contexts called
	type-container type-container
	funs-in-scope funs-in-scope
	call-scope call-scope
	diag-range source-range
	candidate candidate
do check-ctx, common-types
	the check-specs-ctx = funs-in-scope, call-scope, false
	match called = get-called-from-candidate-after-type-checks candidate, 0.dummy-trace
	as called
		if has-errors the::check-specs-ctx
			check-call-specs-with-real-trace type-container, funs-in-scope, call-scope, diag-range, candidate
		elif deep-check-no-contexts-in-specs type-container, diag-range, called
			called
		else
			called-bogus called.fun-inst!.decl, called.return-type, called.param-types
	as no-match
		check-call-specs-with-real-trace type-container, funs-in-scope, call-scope, diag-range, candidate

-deep-check-no-contexts-in-specs bool(container type-container, diag-range source-range, called called) check-ctx
	match called
	as called-bogus
		throw unreachable
	as fun-inst
		every called.spec-impls, of impl
			check-no-contexts container, spec-impl, diag-range, impl and
			deep-check-no-contexts-in-specs container, diag-range, impl
	as called-spec-sig
		true

check-spec-and-get-last-impl called(decl fun-decl, spec_ spec-inst) check-ctx, common-types, funs-map
	check-spec-and-get-last-impl the::funs-map, decl.name-range.range, decl, decl.specs, never-trusted, spec_
check-spec-and-get-last-impl called(diag-range source-range, spec_ spec-inst) check-expr-ctx
	check-spec-and-get-last-impl funs-map, diag-range, type-container, specs, the::expr-ctx, spec_
-check-spec-and-get-last-impl called
	funs-map funs-map
	diag-range source-range
	caller type-container
	caller-specs specs
	call-scope call-scope
	spec_ spec-inst
do check-ctx, common-types
	the check-specs-ctx =
		funs-in-scope: caller-specs, funs-map
		call-scope: call-scope
		has-errors: false
	trace real-trace = caller, diag-range, ()
	match impls = check-spec-impls-inner trace, (spec_,).get-or-add-specs
	as array
		impls[end - 1]
	as no-match
		add-diag diag-range, impls.diag!
		types = spec_.sig-types[end - 1]
		sig called-spec-sig = 1, spec_.decl, spec_.all-sigs[end - 1], types.return-type, types.param-types
		called-bogus sig, sig.return-type, sig.param-types

-check-call-specs-with-real-trace called
	type-container type-container
	funs-in-scope funs-in-scope
	call-scope call-scope
	range source-range
	candidate candidate
do check-ctx, common-types
	the check-specs-ctx = funs-in-scope, call-scope, false
	trace real-trace = type-container, range, ()
	match x = get-called-from-candidate-after-type-checks candidate, trace
	as called
		x
	as no-match
		add-diag range, x.diag!
		candidate-bogus-called candidate

-check-specs spec check-ctx, common-types, check-specs-ctx
-check-specs-ctx record mut
	funs-in-scope funs-in-scope
	call-scope call-scope
	has-errors mut bool
funs-in-scope funs-in-scope() check-specs-ctx
	the::check-specs-ctx.funs-in-scope
call-scope call-scope() check-specs-ctx
	the::check-specs-ctx.call-scope

-spec-result union(called, no-match)
-no-match record
	depth nat
	diag diag?

# TODO:PERF This was an optimization to avoid allocating in the common case, but it may not be necessary
-trace union(dummy-trace, real-trace) mut
-dummy-trace record mut
	depth mut nat
-real-trace record mut
	container type-container
	range source-range
	trace fun-decl-and-type-args mut[]

-depth nat(a trace)
	match a
	as dummy-trace
		a.depth
	as real-trace
		a.trace.size
-trace-push void(a trace, called fun-decl-and-type-args)
	match a
	as dummy-trace
		a.depth +:= 1
	as real-trace
		a.trace ~= called
-trace-pop void(a trace)
	match a
	as dummy-trace
		a.depth -:= 1
	as real-trace
		_ = pop! a.trace
-spec-no-match diag?(a trace, reason spec-no-match-reason)
	match a
	as dummy-trace
		()
	as real-trace
		diag-spec-no-match a.container, reason, a.trace.to

-check-candidate spec-result
	sig-decl signature
	sig-type return-and-param-types
	candidate candidate
	trace trace
	conv allow-implicit-conversions
do check-specs
	if test-candidate-for-spec-sig candidate, sig-type, non-inferring, conv
		get-called-from-candidate-after-type-checks candidate, trace
	else
		no-match trace.depth, spec-no-match trace, spec-impl-not-found sig-decl, sig-type

-get-called-from-candidate-after-type-checks spec-result(candidate candidate, trace trace) check-specs
	do if every candidate.inferring-type-args, !!it else
		depth: trace.depth
		diag: spec-no-match trace, candidate.called.fun-decl!.spec-cant-infer-type-args
	match called = candidate.called
	as fun-decl
		do if trace.depth < max-spec-depth else
			depth: trace.depth
			diag: spec-no-match trace, spec-too-deep
		candidate-type-args = make-type-args candidate.inferring-type-args, it!.type
		specs = instantiate-specs called.specs, candidate-type-args
		match impls = check-spec-impls called, specs, candidate-type-args, trace
		as array
			instantiate-fun called, candidate-type-args, specs, impls
		as no-match
			impls
	as called-spec-sig
		called

-find-spec-sig-implementation spec-result
	sig-decl signature
	sig-type return-and-param-types
	trace trace
do check-specs
	res mut called? = ()
	multiple-matches called mut[] = ()
	deepest-no-match mut no-match? = ()
	doit = of allow-implicit-conversions allow-implicit-conversions
		each-candidate funs-in-scope, sig-decl.name, sig-type.param-types.size, of candidate
			match checked = check-candidate sig-decl, sig-type, candidate, trace, allow-implicit-conversions
			as called
				if res
					multiple-matches ~= checked
				else
					res := checked
			as no-match
				if deepest-no-match
					if deepest-no-match!.depth < checked.depth
						deepest-no-match := checked
				else
					deepest-no-match := checked
	doit[allow-conversions]
	unless is-empty multiple-matches
		# TODO:PERF can I do this in a single pass? Would need to track the quality of each result
		res := ()
		deepest-no-match := ()
		clear multiple-matches
		doit[no-conversions]
		unless res
			# The multiple matches error is more useful
			assert is-empty multiple-matches
			deepest-no-match := ()
			doit[allow-conversions]

	if res
		unless is-empty multiple-matches
			the::check-specs-ctx.has-errors := true
		match trace
		as dummy-trace
			()
		as real-trace
			unless is-empty multiple-matches
				multiple-matches ~= res!
				add-diag trace.range,
					diag-spec-match-multiple trace.container, sig-decl.name, multiple-matches.move-to, trace.trace.to
		res!
	elif deepest-no-match
		deepest-no-match!
	else
		no-match trace.depth, spec-no-match trace, spec-impl-not-found sig-decl, sig-type

-check-builtin-spec bool(kind builtin-spec, type-args type-args) check-specs-ctx
	fun-specs = the::check-specs-ctx.funs-in-scope.fun-specs
	match kind
	as data_
		is-mutability-always-compatible-considering-specs fun-specs, type-args.only!, data_
	as global_
		is-global fun-specs and !context-forbids-global call-scope or check-trusted call-scope
	as java
		check-extern java
	as js
		check-extern js
	as shared_
		is-mutability-always-compatible-considering-specs fun-specs, type-args.only!, shared_
	as unsafe
		is-unsafe fun-specs or check-trusted call-scope

-check-extern bool(kind build-target) check-specs-ctx
	has-build-target funs-in-scope.fun-specs, kind

-specs-result union(called[], no-match)
-check-spec-impls specs-result(called fun-decl, called-specs specs, called-type-args type-args, trace trace) check-specs
	trace-push trace, (called, called-type-args)
	res = check-spec-impls-inner trace, called-specs
	trace-pop trace
	res

-check-spec-impls-inner specs-result(trace trace, specs specs) check-specs
	builtin-no-match specs-result? = first specs.all-builtin, of b, t
		if !check-builtin-spec b, t
			no-match trace.depth, spec-no-match trace, spec-builtin-not-satisfied b, t
	builtin-no-match else
		sigs = instantiated-sigs specs
		no-match mut no-match? = ()
		result called[]? = map-every sigs, of sig
			match found = find-spec-sig-implementation sig.non-instantiated-sig, sig.instantiated-sig, trace
			as called
				found
			as no-match
				no-match := found
				()
		result else no-match!
