import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-key
	../../util/enum-map
	../lang
	./check-ctx
	./get-common-types
	./instantiate

get-common-funs (common-funs, uri-and-diagnostic[])
	modules (common-module, keen-module) enum-map
do instantiate-ctx, common-types
	diags uri-and-diagnostic mut[] = ()
	get-type = of module common-module, name symbol
		only-inst get-type-or-add-diag diags, modules[module], name, 0
	get-fun-inner = of module keen-module, name symbol, return-type type, params type[]
		instantiate-non-template-fun get-fun-decl diags, module, name, return-type, params
	get-fun = of module common-module, name symbol, return-type type, params type[]
		get-fun-inner[modules[module], name, return-type, params]

	json-type = get-type[json, "json"]
	r-shared-of-p = lambda-shared[type-param0, type-param1]
	r-mut-of-p = lambda-mut[type-param0, type-param1]
	json-array = array[json-type]
	t-array = array[type-param0]
	t-array-view = array-view[type-param0]
	t-array-view-array = array[t-array-view]
	t-buffer = buffer[type-param0]
	t-buffer-view = buffer-view[type-param0]
	-
		error: get-type[exception, "error"]
		json-array: json-array
		shared-of-mut-lambda: get-fun-decl diags, modules[runtime], "shared-of-mut-lambda", r-shared-of-p, (r-mut-of-p,)
		to-array-view: get-fun-decl diags, modules[array], "to-array-view", t-array-view, (t-array,)
		to-buffer-view: get-fun-decl diags, modules[buffer], "to-buffer-view", t-buffer-view, (t-buffer,)
		to-symbol-from-string: get-fun[symbol, "to", symbol, (string,)]
		to-string-from-js-any: get-fun[js, "to", string, (js-any,)]
		equal-string-like: for type in make-enum-map
			match type
			as string
				get-fun[string, "==", bool, (string, string)]
			as symbol
				get-fun[symbol, "==", bool, (symbol, symbol)]
		hash-nat: for nat-type in make-enum-map
			get-fun[number, "hash", void, (nat-type.to, hash-state)]
		json-named-new: get-fun[json, "named-new", json-type, (symbol-array, json-array)]
		show-exception: get-fun[bootstrap, "show", string, (exception,)]
		start-runtime: instantiate-non-template-fun
			get-fun-decl diags, modules[runtime], "start-runtime", void, (string-array,)
		stop-runtime: instantiate-non-template-fun get-fun-decl diags, modules[runtime], "stop-runtime", void, ()
		concat-array-views: get-fun-decl diags, modules[array], "concat-array-views", t-array, (t-array-view-array,)
	- move-to diags

get-main-fun-and-diagnostics main-fun-and-diagnostics
	program program
	kind main-kind
	targets build-target set
do instantiate-ctx
	diags-builder uri-and-diagnostic mut[] = ()
	the common-types = common-types program
	res main-fun = match kind
	as main-kind-main-function
		get-main-fun diags-builder, module-at-uri program, kind.uri
	as main-kind-tests
		if kind.all
			test-selector-all top-of-file program.keen-modules.keys[0]
		elif line = kind.line
			test-at-line diags-builder, program, kind.root-uris.only!, line
		else
			:: test-selector-some
			range: top-of-file program.keen-modules.keys[0]
			files: filter kind.root-uris, it.is-keen
			dirs: filter kind.root-uris, it.is-keen.not
	for target in targets
		unless can-run-in-target res, target
			diags-builder ~= res.range-for-diag, target.diag-main-incompatible-with-target
	res, diags-builder.move-to

make-param destructure(name symbol, type type)
	name.local-source-generated, type
make-params destructure[](params type array-view)
	for index, type in with-index params
		index.name.local-source-generated, type
-name symbol(index nat)
	match index
	as 0 then "a"
	as 1 then "b"
	else then throw unreachable

-test-at-line test-selector(diags-builder uri-and-diagnostic mut[], program program, uri uri, line nat)
	module = module-at-uri program, uri
	lcg = program.line-and-character-getters[uri]
	if test_ = find module.tests, {line == line-of-pos lcg, it.range.range.start}
		test_
	else
		range uri-and-range = uri, range-of-line lcg, line
		diags-builder ~= range, diag-main-test-missing line
		test-selector-all range

-type-param0 type() = 0,
-type-param1 type() = 1,

-get-type-or-add-diag type-decl
	diags-builder uri-and-diagnostic mut[]
	module keen-module
	name symbol
	n-type-params nat8
do instantiate-ctx
	if res = get-type-decl module, name and res.n-type-params == n-type-params
		res
	else
		diags-builder ~= (module.uri, ()), name.diag-common-type-missing
		bogus-type-decl module.uri, name, n-type-params

-get-type-decl type-decl?(a module, name symbol)
	a.public-and-internal-exports.types-and-specs[name].?type-decl

-get-fun-decl fun-decl
	diagnostics uri-and-diagnostic mut[]
	module keen-module
	name symbol
	return-type type
	param-types type[]
do instantiate-ctx
	res mut fun-decl? = ()
	sig return-and-param-types = make-return-and-param-types return-type ~ param-types
	name-and-arity = get-name-and-arity name, param-types.size
	each-with-name-and-signature module.public-and-internal-exports.funs, name-and-arity, sig, of x
		do if x.specs.instantiated-sigs.size == 0
		if res
			diagnostics ~= x.range, diag-common-fun-duplicate name
		else
			res := x
	res else bogus-fun-decl diagnostics, module, name, sig

-get-main-fun main-fun(diags-builder uri-and-diagnostic mut[], main-module keen-module) instantiate-ctx, common-types
	decl = get-fun-decl diags-builder, main-module, "main", void, ()
	inst = instantiate-non-template-fun decl
	specs = decl.specs
	unless is-empty specs.all-contexts and is-empty specs.instantiated-sigs
		diags-builder ~= inst.decl.name-range, diag-main-has-specs
	inst

-bogus-fun-decl fun-decl
	diagnostics uri-and-diagnostic mut[]
	module keen-module
	name symbol
	expected-sig return-and-param-types
do instantiate-ctx
	n-type-params = max-of expected-sig.return-and-param-types, it.max-type-param-count else 0
	decl fun-decl =
		hash: next-hash
		source: fun-source-bogus module.uri, name, for i in 0 .. n-type-params then i.to, "t{i}"
		visibility: public
		return-type: expected-sig.return-type
		params: make-params expected-sig.param-types
		specs: ()
		body: bogus-expr (), expected-sig.return-type
	diagnostics ~= (module.uri, ()), diag-common-fun-missing decl, expected-sig
	decl

-max-type-param-count nat(a type)
	match a
	as bogus-type then 0
	as type-param-index then a.index + 1
	as type-inst then max-of a.type-args, it.max-type-param-count else 0

-instantiate-non-template-fun fun-inst(decl fun-decl)
	instantiate-fun decl, (), decl.specs, ()
