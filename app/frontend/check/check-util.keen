import
	../../../lib/parse
	../../model/ast
	../../model/model
	../../model/source-range
	./check-ctx
	./type-from-ast

check-literal-nat-value nat64(type nat-type, range source-range) check-ctx
	check-literal-integral-value type.to, range 'to
check-literal-integral-value scalar-value(type integral-type, range source-range) check-ctx
	text = get-text range
	is-negative = text[0] == "-"
	value scalar-value? = try
		if contains text, "."
			()
		elif is-negative
			res = parse-int text
			ok = if type.is-signed
				res >= type.min-value and (res < 0 or res.to::nat64 <= type.max-value)
			else
				res >= 0 and res.to::nat <= type.max-value
			if ok then res.to
		else
			text2 = if text[0] == "+" then text[1 .. end] else text
			res = parse-nat text2
			if res <= type.max-value then res.to
	catch as inner-parse-error
		()
	value else
		add-diag range, type.diag-literal-overflow
		0::nat.to

check-return-type-and-params (type, destructure[])
	type-container type-container
	return-type-ast type-ast
	params-asts destructure-ast[]
	type-params type-params
do check-ctx, types-get
	ret = type-from-ast return-type-ast, type-params, yes
	params = check-params type-container, params-asts, type-params
	ret, params

-check-params destructure[]
	type-container type-container
	asts destructure-ast[]
	type-params-scope type-params
do check-ctx, types-get
	for x in asts
		check-destructure type-container, type-params-scope, x, (), param
