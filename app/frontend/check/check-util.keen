import
	../../model/ast
	../../model/model
	./check-ctx
	./type-from-ast

check-literal-nat-value nat64(type nat-type, ast literal-number) check-ctx
	check-literal-integral-value type.to, ast 'to
check-literal-integral-value scalar-value(type integral-type, ast literal-number) check-ctx
	res scalar-value? = match value = ast.value
	as nat64
		if value <= type.max-value
			value.to
	as int64
		if is-signed type and value >= type.min-value and value <= type.max-value.to
			value.to
	as float64
		()
	res else
		add-diag ast.range, diag-literal-overflow type
		0.to
check-literal-float-value float(ast literal-number) check-ctx
	match value = ast.value
	as nat64
		value.to
	as int64
		value.to
	as float64
		value

check-return-type-and-params (type, destructure[])
	type-container type-container
	return-type-ast type-ast
	params-asts destructure-ast[]
	type-params type-params
do check-ctx, types-get
	ret = type-from-ast return-type-ast, type-params, yes
	params = check-params type-container, params-asts, type-params
	ret, params

-check-params destructure[]
	type-container type-container
	asts destructure-ast[]
	type-params-scope type-params
do check-ctx, types-get
	for x in asts
		check-destructure type-container, type-params-scope, x, (), param
