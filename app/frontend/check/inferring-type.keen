import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/enum-map
	../../util/util
	./allocators
	./check-ctx
	./expr-ctx
	./instantiate

| This is logically a *union* of its fields. At most one should be set, or none for inferring.
| Since unions aren't mutable, we would have had to wrap it in a mut field of a record,
| and using a single record is more performant as it avoids indirection.
expected record mut
	| If empty, this is purely inferring.
	| If a single entry with no context, this is fully inferred.
	-choices type-and-context mut[]
infer expected()
	choices: ()
expect expected(type type)
	choices: type.non-inferring,
expect-with-context expected(type type-and-context)
	choices: type,
-is-purely-inferring bool(a expected)
	is-empty a.choices
| Purely inferring, or expecting 't' where 't' can be any type
-is-practically-inferring bool(expected expected)
	is-purely-inferring expected or
		do if choice = only expected.choices
		do if full-type-and-context choice
		type = choice.type
		type.type-param-index and !choice.context[type.index]

as-expected expected(a type-and-context mut[])
	choices: a

check-with-modify-expected expr
	outer expected
	# If this returns an empty option, the expected type can't be satisfied.
	modify-expected-type type? mut(x type)
	# This can return a modified type. E.g., if expecting a non-option, it would return the option.
	check-inner (expr, type) mut(x expected)
do check-expr-ctx
	outer-types = outer.choices
	modified-types type-and-context mut[] = with out in build
		do for outer-type in outer-types
		do if new-expected = modify-expected-type[get-exact-non-inferring-type outer-type else outer-type.type]
		out ~= with-type outer-type, new-expected
	inner-expr, outer-type = check-inner[modified-types.as-expected]
	check outer, outer-type, inner-expr

| Final 'type' option is for any other type when it is unambiguous
char-or-string-type union(char-type, string-like-type)
choose-string-type (type, char-or-string-type?)?(range source-range, expected expected) check-expr-ctx
	do unless is-practically-inferring expected else
		must-check expected, string
		string, string
	choices (type-inst, char-or-string-type) mut[] = ()
	for choice in expected.choices
		each-narrowed-type choice, of type
			if kind = as-char-or-string-type type and !some choices, it.b == kind
				choices ~= type, kind
	if is-empty choices
		if x = try-get-inexact-non-inferring-type expected
			x, ()
	else
		choice = only choices else
			# Prefer string over char8[]
			if every choices, of _, kind then kind == string or kind == char8-array
				string, string
			else
				add-diag range, diag-literal-multiple-match type-container, map choices, it.a
				choices[0]
		must-check expected, choice.a
		choice.a, choice.b

-as-char-or-string-type char-or-string-type?(a type) check-ctx, common-types
	if is-char8 a
		char8
	elif is-char32 a
		char32
	elif a == char8-array
		char8-array
	elif a == char32-array
		char32-array
	elif is-js-any a
		js-any
	elif a == string
		string
	elif a == symbol
		symbol
	elif is-java-String a
		java-String
	elif a::type? == the::check-context.json-type
		json
	else
		()

-is-java-String bool(a type)
	do if type-inst a
	body = a.decl.body
	do if java-class body
	body.path == assume-path "java/lang/String"

number-type union(integral-type, float-type-or-js-or-json)
choose-number-type number-type?(range source-range, expected expected, text string-view) check-expr-ctx
	is-float = contains text, "." or (contains text, "e" and !starts-with text, "0x")
	is-negative = text[0] == "-"
	do unless is-practically-inferring expected else
		res number-type, type type-inst = if is-float
			float64, float64
		elif is-negative
			int64, int64
		else
			nat64, nat64
		must-check expected, type
		res
	res-nat mut nat-type? = ()
	res-int mut int-type? = ()
	res-float mut float-type? = ()
	res-js mut type-inst? = ()
	res-json mut type-inst? = ()
	for choice in expected.choices
		each-narrowed-type choice, of type
			if x = as-nat-type type and !is-float and !is-negative
				res-nat := max res-nat, x
			elif x = as-int-type type and !is-float
				res-int := max res-int, x
			elif x = as-float-type type
				res-float := max res-float, x
			elif is-js-any type
				res-js := type
			elif is-json type
				res-json := type
	total = (!!res-nat).to + (!!res-int).to + (!!res-float).to + (!!res-js).to + (!!res-json).to
	if total == 0
		add-diag range, diag-literal-not-expected get-expected-for-diag expected
		()
	else
		res number-type, type type-inst = if res-nat
			res-nat!.to::integral-type, res-nat!.to
		elif res-int
			res-int!.to::integral-type, res-int!.to
		elif res-float
			res-float!.to, res-float!.to
		elif res-js
			js-any, res-js!
		else
			json, res-json!
		assert try-set-no-diagnostic expected, type
		res

-to float-type-or-js-or-json(a float-type)
	match a
	as float32 then float32
	as float64 then float64

-is-json bool(a type-inst) check-ctx
	a.decl.name == "json" and a.decl.uri == common-uris[json]

-each-narrowed-type void(a type-and-context, f void mut(x type-inst)) common-types
	match type = a.type
	as bogus-type
		()
	as type-param-index
		if full-type-and-context a and inferred = a.context[type.index]
			each-narrowed-type inferred.type.non-inferring, f
	as type-inst
		match body = type.decl.body
		as builtin-type
			if body == option
				each-narrowed-type (with-type a, type.unwrap-option!), f
			else
				f[type]
		as sum-type
			if body.kind == union_
				for m in body.listed-members
					# TODO:PERF It would probably help to have all instantiated members precomputed
					inst = instantiate-type-inst m.case-type, type.type-args
					each-narrowed-type (with-type a, inst), f
			else
				# This is only used for the expected type for a literal,
				# so don't worry about interface/variant since literals can't implement those
				f[type]
		else
			# NOTE: no need to handle 'builtin-widens' here, since 'choose-number-type' handles that.
			# Also, 'each-narrowed-type' is only used for literals and lambdas,
			# so no need to consider buffer from buffer-view (since there are no literal buffers).
			f[if elem = as-array-view type then array[elem] else type]
-can-widen-to type-match-kind?(narrow type-inst, wide type-inst) common-types
	# 'narrow' can widen to 'wide' if 'wide' is 'narrow?', or 'wide' is a sum-type containing 'narrow', or transitive
	match body = wide.decl.body
	as builtin-type
		if body == option
			match w = only! wide.type-args
			as bogus-type
				bogus-match
			as type-param-index
				()
			as type-inst
				min convert-to-option-or-union, is-or-can-widen-to narrow, w
		else
			narrow-body = narrow.decl.body
			if narrow-body.builtin-type and builtin-widens narrow-body, body then convert-array-view-or-numeric
	as sum-type
		if body.kind == union_
			min convert-to-option-or-union, first body.listed-members, of x
				if is-bool x.case-type
					# Don't recurse, because we don't want to implicitly convert option -> bool -> something else
					if is-bool narrow then convert-to-option-or-union
				else
					# TODO:PERF It would probably help to have all instantiated members precomputed
					narrow 'is-or-can-widen-to instantiate-type-inst x.case-type, wide.type-args
		else
			min convert-to-option-or-union, first narrow.decl.sum-type-cases, of x
				# TODO:PERF It would probably help to have all instantiated members precomputed
				st = instantiate-type-inst x.sum-type, narrow.type-args
				# TODO:PERF could have a simpler recursion since we already know we're looking for a sum-type.
				# Or could just cache all implemented interfaces
				st 'is-or-can-widen-to wide
	as java-class
		narrow-body = narrow.decl.body
		do if java-class narrow-body
		do if super = narrow-body.super-class
		instantiated-super = instantiate-type-inst super, narrow.type-args
		min convert-to-option-or-union, is-or-can-widen-to instantiated-super, wide
	else
		if as-array-view wide and as-array narrow and narrow.type-args 'can-match wide.type-args
			convert-array-view-or-numeric
		elif as-buffer-view wide and as-buffer narrow and narrow.type-args 'can-match wide.type-args
			convert-array-view-or-numeric
-is-or-can-widen-to type-match-kind?(narrow type-inst, wide type-inst) common-types
	if narrow == wide
		exact-match
	else
		narrow 'can-widen-to wide
-can-match bool(a type-args, b type-args)
	zip-every-type-args a, b, of x, y
		x == y or is-bogus y

-set void(a expected, type type)
	clear a.choices
	a.choices ~= non-inferring type

-is-inferred bool(a expected)
	(choice = only a.choices) and !full-type-and-context choice

set-to-bogus-if-inferring void(a expected)
	unless is-inferred a
		set a, bogus-type

expected-lambda record mut
	lambda-decl type-decl
	| Missing for purely inferred lambdas
	return-type type-and-context?
	| Fully inferred, not in type-context.
	instantiated-param-type type
get-expected-lambda expected-lambda?(source lambda-source, expected expected) check-expr-ctx
	declared-param lambda-param-declared-type? = match source
	as for-or-with-ast
		type-from-destructure source.param
	as it-scope-ast
		prefer-void
	as lambda-ast
		type-from-destructure source.param
	do unless declared-param == bogus-type
	res mut expected-lambda? = ()
	multiple type-inst mut[] = ()
	any-diag bool reference = false,
	diag-range = diag-range source
	for choice in expected.choices
		each-narrowed-type choice, of type
			do if as-lambda-type type
			return-type, param-type = only2! type.type-args
			do if actual-param = lambda-param-type diag-range, declared-param, (with-type choice, param-type), any-diag
			prev = res
			res := type.decl, (with-type choice, return-type), actual-param
			if prev
				if is-empty multiple
					multiple ~= get-inferred-or-bogus prev
				multiple ~= get-inferred-or-bogus res!
				any-diag set= true
	if any-diag.get
		unless is-empty multiple
			add-diag diag-range, diag-lambda-multiple-match ((map multiple, {it}), type-container)
		()
	else
		if res
			freeze-expected-return-type res!.return-type!
			res
		else
			if is-purely-inferring expected and declared-param
				lambda-mut, (), as-type declared-param
			else
				add-diag diag-range, diag-lambda-not-expected get-expected-for-diag expected
				()
diag-range source-range(a lambda-source)
	match a
	as for-or-with-ast
		keyword-range a
	as it-scope-ast
		it-range a
	as lambda-ast
		keyword-range a
-get-inferred-or-bogus type-inst(a expected-lambda)
	a.lambda-decl[a.return-type!.get-inferred-or-bogus, a.instantiated-param-type]

###
If we have an expected type, we should freeze it at this point (to forbid narrowing).
If the user wrote `xs nat?[] = for x in xs ...`, they presumably want the body to have a type of `nat?` not `nat`.
###
-freeze-expected-return-type void(return-type type-and-context)
	do if full-type-and-context return-type
	match type = return-type.type
	as bogus-type
		()
	as type-param-index
		type-context = return-type.context
		do if inferred = type-context[type.index]
		do unless inferred.kind == exact
		type-context[type.index] := exact, inferred.type
	as type-inst
		()

-lambda-param-declared-type union(type, prefer-void)
-as-type type(a lambda-param-declared-type) common-types
	match a
	as type then a
	as prefer-void then void
-prefer-void record

-lambda-param-type type?
	diag-range source-range
	declared-param lambda-param-declared-type?
	expected-lambda-type-param-type type-and-context
	any-diag bool reference
do check-ctx, common-types
	if expected-param-type = try-get-inexact-non-inferring-type expected-lambda-type-param-type
		declared-param-type = ?type declared-param
		unless declared-param-type and expected-param-type != declared-param-type
			expected-param-type
	elif declared-param
		as-type declared-param
	else
		add-diag diag-range, diag-lambda-cant-infer-param-type
		any-diag set= true
		()

try-get-inexact-non-inferring-type type?(expected expected)
	?try-get-inexact-non-inferring-type only expected.choices

match-expected-vs-return-type-no-diagnostic type-match-kind?
	expected expected
	candidate-return-type type-and-context
do common-types
	if is-purely-inferring expected
		exact-match
	elif x = only expected.choices
		match-types candidate-return-type, x, a-to-b
	else
		res = none-or-one-or-many expected.choices, of x
			is-type-match-possible candidate-return-type, x, a-to-b
		match res
		as none
			()
		as one
			match-types candidate-return-type, res.value, a-to-b
		as many
			# Else don't infer any type args; multiple candidates and multiple possible return types.
			exact-match

bogus expr(expected expected, ast expr-ast)
	bogus expected, ast.range
bogus expr(expected expected, range source-range)
	set-to-bogus-if-inferring expected
	bogus-expr range, expected.inferred

inferred type(expected expected)
	type only! expected.choices

check expr(expected expected, expr-type type, expr expr) check-expr-ctx
	if try-set-no-diagnostic expected, expr-type
		expr
	else
		add-diag expr.range,
			diag-type-conflict expected.get-expected-for-diag, type-with-container expr-type
		set-to-bogus-if-inferring expected
		bogus-wrong-type-expr expr, expected.inferred

get-expected-for-diag expected-for-diag(expected expected) check-expr-ctx
	if is-purely-inferring expected
		expected-for-diag-infer
	else
		choices type[] = sort (map expected.choices, it.get-inferred-or-bogus), it.name-for-sort
		expected-for-diag-choices choices, type-container

-name-for-sort symbol(a type)
	match a
	as bogus-type then ""
	as type-param-index then "{a.index}"
	as type-inst then a.decl.name

| Call this when you are certain 'type' satisfies 'expected'.
| (But it may still be necessary to update expected with a more precise type.)_
must-check void(expected expected, actual type) common-types
	assert try-set-no-diagnostic expected, actual
| This may infer type parameters
-try-set-no-diagnostic bool(expected expected, actual type) common-types
	if is-purely-inferring expected
		set expected, actual
		true
	# This branch is redundant to the below one, but having it seems to improve performance.
	elif x = only expected.choices
		if match-types x, actual.non-inferring, b-to-a
			set expected, (try-get-inexact-non-inferring-type x else actual)
			true
	else
		res = none-or-one-or-many expected.choices, of x
			!!(match-types x, actual.non-inferring, b-to-a)
		match res
		as none
			false
		as one
			# If we're expecting a type parameter 't' that is inferred to 'nat? exact',
			# preserve that instead of unnecessarily narrowing.
			# TODO: maybe we should just not have 'choices' in the case where there is a single type...
			set expected, (try-get-inexact-non-inferring-type res.value else actual)
			true
		as many
			set expected, actual
			true

get-exact-non-inferring-type type?(a type-and-context)
	try-get-exact-or-inexact-non-inferring-type a, true
try-get-inexact-non-inferring-type type?(a type-and-context)
	try-get-exact-or-inexact-non-inferring-type a, false
-try-get-exact-or-inexact-non-inferring-type type?(a type-and-context, require-exact bool)
	match a
	as bogus-type then a
	as type-param-index then a
	as type-inst then a
	as full-type-and-context
		match type = a.type
		as bogus-type
			bogus-type
		as type-param-index
			do if inferred = a.context[type.index]
			do if inferred.kind == exact or !require-exact
			inferred.type
		as type-inst
			if is-empty type.type-args
				type
			else
				do if new-type-args = map-every-type-args type.type-args, of x
					try-get-exact-or-inexact-non-inferring-type (full-type-and-context x, a.context), require-exact
				type.decl[new-type-args]

-replace-uninferred-with-bogus type(a type-and-context)
	match a
	as bogus-type then a
	as type-param-index then throw unreachable
	as type-inst then a
	as full-type-and-context
		match type = a.type
		as bogus-type
			bogus-type
		as type-param-index
			if inferred = a.context[type.index]
				inferred.type
			else
				bogus-type
		as type-inst
			type.decl[make-type-args type.type-args, {replace-uninferred-with-bogus with-type a, it}]

-try-get-non-inferring inference?(a type-and-context)
	match a
	as bogus-type then exact, a
	as type-param-index then exact, a
	as type-inst then exact, a
	as full-type-and-context
		match type = a.type
		as bogus-type
			exact, a.type
		as type-param-index
			a.context[type.index]
		as type-inst
			if is-empty type.type-args
				exact, a.type
			elif new-type-args = map-every-type-args type.type-args, {get-exact-non-inferring-type (with-type a, it)}
				exact, type.decl[new-type-args]

| For diagnostics. Applies inferred types as much as possible, using {bogus-type} where types have not been inferred.
| This is like {try-get-inexact-non-inferring-type}, but always succeeds.
get-inferred-or-bogus type(a type-and-context)
	match a
	as bogus-type then a
	as type-param-index then a
	as type-inst then a
	as full-type-and-context
		match type = a.type
		as bogus-type
			bogus-type
		as type-param-index
			a.context[type.index].?type else bogus-type
		as type-inst
			type.decl[make-type-args type.type-args, {get-inferred-or-bogus (full-type-and-context it, a.context)}]

implicit-conversions enum
	| The type parameter should not be changed any more.
	exact
	| 'b' may be a union, allow converting 'a' to it
	a-to-b
	| 'a' may be a union, allow converting 'b' to it
	b-to-a

# Infer information about a candidate based on the declared type on a lambda parameter
infer-type-args-from-lambda-parameter-type void
	expected full-type-and-context
	declared-lambda-parameter-type type
do
	expected-type = expected.type
	do if type-inst expected-type and as-lambda-type expected-type
	_, param-type = only2! expected-type.type-args
	infer-type-args-bidirectional (full-type-and-context param-type, expected.context),
		non-inferring declared-lambda-parameter-type

| This is only used in situations without implicit conversion.
| Infers types in 'a' and 'b' given that they are expected to be the same type. (If they are not, does nothing.)
infer-type-args-bidirectional void(a type-and-context, b type-and-context)
	a-type = a.type
	b-type = b.type
	if ta = is-inferring-non-inferred-type-param a
		if tb = try-get-inexact-non-inferring-type b
			a.full-type-and-context!.context[ta.index] := exact, tb
	elif tb = is-inferring-non-inferred-type-param b
		if ta = try-get-inexact-non-inferring-type a
			b.full-type-and-context!.context[tb.index] := exact, ta
	elif a-type.type-inst and b-type.type-inst and a-type.decl == b-type.decl
		for i in 0::nat .. a-type.type-args.size
			infer-type-args-bidirectional (with-type a, a-type.type-args[i]), (with-type b, b-type.type-args[i])

is-type-match-possible-for-completions bool(param-type type-with-container, actual-arg-type type) common-types
	is-type-match-possible param-type.type-and-new-context, actual-arg-type.non-inferring, b-to-a

-is-type-match-possible bool(a type-and-context, b type-and-context, conv implicit-conversions) common-types
	!!(match-types a.copy, b, conv)

| True for a type param with no inference yet
-is-inferring-non-inferred-type-param type-param-index?(a type-and-context)
	if full-type-and-context a and x = a.type.type-param-index and !a.context[x.index]
		x

| Ranked from least to most exact
type-match-kind enum(bogus-match, convert-array-view-or-numeric, convert-to-option-or-union, exact-match)
| Returns true if 'a' and 'b' are possibly compatible.
| 'a' may have its type args be inferred, 'b' may not. Unknown types in 'b' are always possibly compatible.
match-types type-match-kind?(a type-and-context, b type-and-context, conv implicit-conversions) common-types
	if full-type-and-context a
		if full-type-and-context b
			match-types-both-inferring a, b, conv
		else
			match-types-no-b-context a, b.type, conv
	elif full-type-and-context b
		?a match-types-no-a-context (exact, a.type), b, conv
	else
		?a match-types-no-context (exact, a.type), b.type, conv

-match-types-both-inferring type-match-kind?
	a full-type-and-context
	b full-type-and-context
	conv implicit-conversions
do common-types
	match tb = b.type
	as bogus-type
		bogus-match
	as type-param-index
		if b-inferred = b.context[tb.index]
			inner-conv implicit-conversions = match conv
			as exact
				match b-inferred.kind
				as exact
					exact
				as allow-narrower
					a-to-b
				as allow-wider
					b-to-a
			as a-to-b
				a-to-b
			as b-to-a
				b-to-a
			match-types-no-b-context a, b-inferred.type, inner-conv
		else
			exact-match
	as type-inst
		match ta = a.type
		as bogus-type
			()
		as type-param-index
			if a-inferred = a.context[ta.index]
				if kind, x = match-types-no-a-context a-inferred, b, conv
					a.context[ta.index] := x
					kind
			elif x = try-get-non-inferring b
				if x.kind == exact
					kind inference-kind = match conv
					as exact
						exact
					as a-to-b
						allow-wider
					as b-to-a
						allow-narrower
					a.context[ta.index] := kind, x.type
				exact-match
			else
				exact-match
		as type-inst
			match-type-insts ta, tb, conv, of x, y, conv2
				match-types (with-type a, x), (with-type b, y), conv2

| Returns new inference value for 'a'.
-match-types-no-a-context (type-match-kind, inference)?
	a inference
	b full-type-and-context
	conv implicit-conversions
do common-types
	match tb = b.type
	as bogus-type
		bogus-match, a
	as type-param-index
		if b-inferred = b.context[tb.index]
			match-types-no-context a, b-inferred.type, conv
		else
			# We haven't inferred anything about 'b', so it could match
			exact-match, a
	as type-inst
		match ta = a.type
		as bogus-type
			()
		as type-param-index
			()
		as type-inst
			if ta.decl == tb.decl
				res = zip-type-args-and-match ta.type-args, tb.type-args, of x, y
					?a match-types-no-a-context (exact, x), (full-type-and-context y, b.context), conv
				if res
					exact-match, (exact, a.type)
			else
				match-types-no-context a, b.replace-uninferred-with-bogus, conv

-zip-type-args-and-match type-match-kind?(a type-args, b type-args, f type-match-kind? mut(x type, y type))
	res mut type-match-kind = exact-match
	ok = zip-every-type-args a, b, of x, y
		if here = f[x, y]
			res min:= here
			true
	if ok then res

-match-types-no-b-context type-match-kind?(a full-type-and-context, b type, conv implicit-conversions) common-types
	match ta = a.type
	as bogus-type
		()
	as type-param-index
		if a-inferred = a.context[ta.index]
			if kind, new-a = match-types-no-context a-inferred, b, conv
				a.context[ta.index] := new-a
				if a-inferred.kind == allow-narrower then exact-match else kind
		else
			kind inference-kind = match conv
			as exact
				exact
			as a-to-b
				allow-narrower
			as b-to-a
				allow-wider
			a.context[ta.index] := kind, b
			exact-match
	as type-inst
		match b
		as bogus-type
			bogus-match
		as type-param-index
			if is-option ta.decl and conv == b-to-a
				min convert-to-option-or-union, match-types-no-b-context (with-type a, ta.type-args.only!), b, conv
		as type-inst
			match-type-insts ta, b, conv, of x, y, conv2
				match-types-no-b-context (full-type-and-context x, a.context), y, conv2

-match-type-args alias
	type-match-kind? mut(x type, y type, conv implicit-conversions)
-match-type-insts type-match-kind?
	sa type-inst
	sb type-inst
	conv implicit-conversions
	match-inner type-match-kind? mut(x type, y type, conv implicit-conversions)
do common-types
	if sa.decl == sb.decl
		conv2 = if is-option sa.decl then conv else exact
		zip-type-args-and-match sa.type-args, sb.type-args, of x, y
			match-inner[x, y, conv2]
	else
		match conv
		as exact
			()
		as a-to-b
			match-type-insts-a-to-b sa, sb, of x, y then match-inner[x, y, conv]
		as b-to-a
			match-type-insts-a-to-b sb, sa, of y, x then match-inner[x, y, conv]
-match-type-insts-a-to-b type-match-kind?
	sa type-inst
	sb type-inst
	match-after-unwrap type-match-kind? mut(x type, y type)
do common-types
	match body = sb.decl.body
	as builtin-type
		if body == option
			min convert-to-option-or-union, match-after-unwrap[sa, sb.unwrap-option!]
		else
			body-a = sa.decl.body
			if body-a.builtin-type and builtin-widens body-a, body then convert-array-view-or-numeric
	as sum-type
		if body.kind == union_
			min convert-to-option-or-union, first body.listed-members, of x
				if is-bool x.case-type
					# Don't recurse, because we don't want to implicitly convert option -> bool -> something else
					if is-bool sa then convert-to-option-or-union
				else
					member = instantiate-type-inst x.case-type, sb.type-args
					match-after-unwrap[sa, member]
		else
			()
	else
		if x = as-array sa and y = as-array-view sb
			min convert-array-view-or-numeric, match-after-unwrap[x, y]
		elif x = as-buffer sa and y = as-buffer-view sb
			min convert-array-view-or-numeric, match-after-unwrap[x, y]

| Returns new inference value for 'a', or none if they can't match
-match-types-no-context (type-match-kind, inference)?(a inference, b type, conv implicit-conversions) common-types
	match ta = a.type
	as bogus-type
		bogus-match, a
	as type-param-index
		match b
		as bogus-type
			bogus-match, a
		as type-param-index
			if ta == b
				exact-match, a
		as type-inst
			do if is-option b
			min-kind type-match-kind? = match conv
			as exact
				if a.kind == allow-wider then exact-match
			as a-to-b
				convert-to-option-or-union
			as b-to-a
				()
			if min-kind
				min-kind min-kind, match-types-no-context a, b.unwrap-option!, conv
	as type-inst
		match b
		as bogus-type
			bogus-match, a
		as type-param-index
			do if is-option ta
			min-kind type-match-kind? = match conv
			as exact
				if a.kind == allow-narrower then exact-match
			as a-to-b
				()
			as b-to-a
				convert-to-option-or-union
			if min-kind
				min-kind min-kind, match-types-no-context (a.kind, ta.unwrap-option!), b, conv
		as type-inst
			if ta.decl == b.decl
				if ta.type-args == b.type-args
					# Need to choose the new inference kind based on 'a.kind' and 'conv'
					exact-match, ((kind-combine a.kind, conv), a.type)
				elif is-option ta.decl and conv != exact
					min-kind convert-to-option-or-union,
						match-types-no-context (a.kind, ta.type-args.only!), b.type-args.only!, conv
			else
				match conv
				as exact
					match a.kind
					as exact
						()
					as allow-wider
						if kind = can-widen-to ta, b then kind, (exact, b)
					as allow-narrower
						if kind = can-widen-to b, ta then kind, (exact, b)
				as a-to-b
					if kind = can-widen-to ta, b then kind, a
				as b-to-a
					if kind = can-widen-to b, ta then kind, a

-min-kind (type-match-kind, inference)?(kind type-match-kind, b (type-match-kind, inference)?)
	if b-kind, inference = b
		(min kind, b-kind), inference

-kind-combine inference-kind(a inference-kind, conv implicit-conversions)
	match a
	as exact
		exact
	as allow-wider
		match conv
		as a-to-b
			allow-wider
		else
			exact
	as allow-narrower
		match conv
		as b-to-a
			allow-narrower
		else
			exact
