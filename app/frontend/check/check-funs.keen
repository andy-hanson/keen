import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/enum-map
	./check-ctx
	./check-expr
	./check-type-decls
	./check-util
	./funs-for-type
	./get-builtin-fun
	./instantiate
	./type-from-ast

import-or-export-file record(source import-or-export-ast, uri uri, content nat8 array-view)
file-imports-and-exports record
	imports import-or-export-file[]
	exports import-or-export-file[]
funs-and-map record
	funs fun-decl[]
	tests test_[]
	funs-map funs-map
check-funs funs-and-map
	structs type-decl[]
	vars var-decl[]
	file-imports-and-exports file-imports-and-exports
	asts fun-decl-ast[]
	test-asts test-ast[]
do check-ctx, common-types, types-get
	funs, auto-funs = check-funs-initial structs, vars, file-imports-and-exports, asts
	assert funs.size >= asts.size
	the funs-map = make-funs-map funs
	fill-auto-fun-bodies auto-funs
	check-method-impls structs
	check-funs-with-asts funs[0 .. asts.size], asts
	funs: funs
	tests: check-tests test-asts
	funs-map: the::funs-map

-check-funs-initial (fun-decl[], auto-funs)
	types type-decl[]
	vars var-decl[]
	file-imports-and-exports file-imports-and-exports
	asts fun-decl-ast[]
do check-ctx, types-get
	the common-uris = common-uris
	auto-funs auto-funs = ()
	funs fun-decl[] = with out in build
		auto-fun-overrides auto-fun-overrides = ()
		for fun-ast in asts
			fun = check-fun-initial fun-ast
			auto-fun-overrides ~~= from-option as-auto-fun-override fun
			out ~= fun
		for f in file-imports-and-exports.imports
			out ~= fun-decl-for-file-import-or-export f, private
		for f in file-imports-and-exports.exports
			out ~= fun-decl-for-file-import-or-export f, public
		for type in types
			add-funs-for-type out, auto-funs, type, auto-fun-overrides
		for var in vars
			add-funs-for-var out, var
	funs, auto-funs

# Get the function signature, but not yet fill in the body.
-check-fun-initial fun-decl(fun-ast fun-decl-ast) check-ctx, types-get
	visibility = visibility-from-explicit-top-level fun-ast.visibility
	specs = check-fun-modifiers fun-ast.type-params, fun-ast.modifiers
	check-type-params fun-ast.type-params
	fun = unfinished-fun-decl next-hash, visibility, fun-ast.name, fun-ast.type-params, fun-ast.uri-and-range, specs
	return-type, params = check-return-type-and-params fun, fun-ast.return-type, fun-ast.params, fun-ast.type-params
	fill-in-fun-types fun, return-type, params
	fun

-fun-decl-for-file-import-or-export fun-decl(a import-or-export-file, visibility visibility) check-ctx, common-types
	ast = import-file-ast! a.source.kind
	return-type = type-for-file-import ast.type
	hash: next-hash
	visibility: visibility
	return-type: return-type
	params: ()
	specs: ()
	body: fun-body-file-import cur-uri, a.source, a.source.kind.import-file-ast!.type, a.content

-type-for-file-import type(type import-file-type) common-types
	match type
	as nat8-array
		nat8-array
	as string
		string

-check-fun-modifiers specs(type-params-scope type-params, asts modifier-ast[]) check-ctx, types-get
	get-or-add-specs with out in build
		for ast in asts
			match ast
			as modifier-keyword-ast
				add-diag ast.keyword-range, diag-modifier-invalid ast.keyword, function_
			as spec-use-ast
				out ~~= from-option spec-or-type-from-ast type-params-scope, ast, no-delay-spec-insts

-check-tests test_[](test-asts test-ast[]) check-ctx, types-get, funs-map
	for ast in test-asts
		specs = check-fun-modifiers (), ast.modifiers
		if  not is-empty specs.instantiated-sigs
			add-diag ast.keyword-range, test_.diag-spec-use-invalid
		test_ test_ = next-hash, ast, cur-uri, specs, (bogus-expr (), void, temporary), ()
		test_.body := check-fun-or-test-body test_, (), void, (), ast.body, false
		test_

-check-funs-with-asts void
	funs-with-asts fun-decl array-view
	asts fun-decl-ast[]
do check-ctx, common-types, types-get, funs-map
	for i in 0::nat .. asts.size
		fun = funs-with-asts[i]
		fun-ast = asts[i]
		do if fun.body.fun-body-uninitialized
		fun.body := if is-bogus fun.return-type
			ast: fun-ast
			expr: bogus-expr fun-ast.body.range, fun.return-type, from-other-bogus
			allocated-locals: ()
		elif bogus-ast fun-ast.body
			get-builtin-fun fun, fun-ast
		else
			res = check-fun-or-test-body fun, fun-ast.type-params, fun.return-type, fun.params, fun-ast.body,
				must-be-auto fun.name
			match res
			as expr then fun-body-expr fun-ast, res, ()
			as expr-with-allocated-locals then fun-body-expr fun-ast, res.expr, res.allocated-locals

-must-be-auto bool(a symbol)
	match a
	as "==" then true
	as "<=>" then true
	as "hash" then true
	else then false
