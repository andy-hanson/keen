import
	../../../lib/col/experimental/object-memoizer
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	./check-auto-fun
	./check-ctx
	./check-expr
	./check-type-decls
	./check-util
	./funs-for-type
	./instantiate
	./type-from-ast

import-or-export-file record(source import-or-export-ast, uri uri, content nat8 array-view)
file-imports-and-exports record
	imports import-or-export-file[]
	exports import-or-export-file[]
funs-and-map record
	funs fun-decl[]
	tests test_[]
	funs-map funs-map
check-funs funs-and-map
	structs type-decl[]
	vars var-decl[]
	file-imports-and-exports file-imports-and-exports
	asts fun-decl-ast[]
	test-asts test-ast[]
do check-ctx, common-types, types-get
	funs = check-funs-initial structs, vars, file-imports-and-exports, asts
	assert funs.size >= asts.size
	the funs-map = funs.to
	check-method-impls structs
	check-funs-with-asts funs[0 .. asts.size], asts
	for i, f in with-index file-imports-and-exports.imports
		funs[asts.size + i].body := file-import-function-body f
	for i, f in with-index file-imports-and-exports.exports
		funs[asts.size + file-imports-and-exports.imports.size + i].body := file-import-function-body f
	funs: funs
	tests: check-tests test-asts
	funs-map: the::funs-map

-check-funs-initial fun-decl[]
	types type-decl[]
	vars var-decl[]
	file-imports-and-exports file-imports-and-exports
	asts fun-decl-ast[]
do check-ctx, types-get
	do with out in build
	for fun-ast in asts
		out ~= check-fun fun-ast
	for f in file-imports-and-exports.imports
		out ~= fun-decl-for-file-import-or-export f, private
	for f in file-imports-and-exports.exports
		out ~= fun-decl-for-file-import-or-export f, public
	for type in types
		add-funs-for-type out, type
	for var in vars
		add-funs-for-var out, var

-check-fun fun-decl(fun-ast fun-decl-ast) check-ctx, types-get
	fun fun-decl =
		hash: next-hash
		source: fun-ast
		visibility: visibility-from-explicit-top-level fun-ast.visibility
		return-type: bogus-type
		params: ()
		specs: check-fun-modifiers fun-ast.type-params, fun-ast.modifiers
		doc-comment-references: ()
		body: fun-body-uninitialized
	check-type-params fun-ast.type-params
	return-type, params = check-return-type-and-params fun, fun-ast.return-type, fun-ast.params, fun-ast.type-params
	fun.return-type := return-type
	fun.params := params
	param-types type[] = map params, it.type
	fun.param-types := param-types
	match insts = fun.insts
	as fun-inst
		insts.return-type := return-type
		insts.param-types := param-types
	as object-memoizer
		()
	fun

-file-import-function-body fun-body(a import-or-export-file)
	fun-body-file-import a.source.kind.import-file-ast!.type, a.content

-fun-decl-for-file-import-or-export fun-decl(a import-or-export-file, visibility visibility) check-ctx, common-types
	ast = a.source.kind.import-file-ast!
	hash: next-hash
	source: fun-source-file-import cur-uri, a.source
	visibility: visibility
	return-type: type-for-file-import ast.type
	params: ()
	specs: ()
	doc-comment-references: ()
	body: fun-body-bogus

-type-for-file-import type(type import-file-type) common-types
	match type
	as nat8-array
		nat8-array
	as string
		string

-check-fun-modifiers specs(type-params-scope type-params, asts modifier-ast[]) check-ctx, types-get
	get-or-add-specs with out in build
		for ast in asts
			match ast
			as modifier-keyword-ast
				add-diag ast.keyword-range, diag-modifier-invalid ast.keyword, function_
			as spec-use-ast
				out ~~= from-option spec-or-type-from-ast type-params-scope, ast, no-delay-spec-insts

-check-tests test_[](test-asts test-ast[]) check-ctx, types-get, funs-map
	for ast in test-asts
		specs = check-fun-modifiers (), ast.modifiers
		if !is-empty specs.instantiated-sigs
			add-diag ast.keyword-range, test_.diag-spec-use-invalid
		test_ test_ = next-hash, ast, cur-uri, specs, (bogus-expr (), void), ()
		if body = ast.body
			test_.body := check-fun-or-test-body test_, void, (), body, (), false
		else
			add-diag ast.range, diag-test-missing-body
		test_

-check-funs-with-asts void
	funs-with-asts fun-decl array-view
	asts fun-decl-ast[]
do check-ctx, common-types, types-get, funs-map
	for i in 0::nat .. asts.size
		fun = funs-with-asts[i]
		fun-ast = asts[i]
		do if fun.body.fun-body-uninitialized
		fun.body := if is-bogus fun.return-type
			fun-body-bogus
		elif body = fun-ast.body
			check-fun-or-test-body fun, fun.return-type, fun.params, body, (), must-be-auto fun.name 'to
		else
			check-auto-fun fun

-must-be-auto bool(a symbol)
	match a
	as "==" then true
	as "<=>" then true
	as "hash" then true
	else then false
