import
	../../model/ast
	../../model/model
	../../model/source-range
	./check-ctx
	./instantiate
	./type-from-ast

lambda-info record mut
	mutability mutability
	# Index into locals on expr-ctx. This is the first local inside the lambda (or an inner lambda).
	first-local-index nat
	closure-locals local mut[]
	closure-contexts type-inst mut[]

call-scope interface mut
	check-trusted bool()
	context-forbids-global bool()
never-trusted record call-scope case
check-trusted bool(_ never-trusted)
	false
context-forbids-global bool(_ never-trusted)
	false

check-expr-ctx spec check-ctx, common-types, expr-ctx

expr-ctx record mut, call-scope case
	types-and-specs-map types-and-specs-map
	funs-map funs-map
	| For diags. This will be a {fun-decl} or {test_}.
	container expr-container
	specs mut specs
	type-params type-params
	-is-in-trusted mut bool
	-used-trusted mut bool
	locals local mut[]
	refined-types (local, type-args) mut[]
	# When we access a local in a lambda, we need to make sure it's added to the closure of each lambda it's in
	lambdas lambda-info mut[]
	allocated-locals type-inst mut[local]
new expr-ctx
	types-and-specs-map types-and-specs-map
	funs-map funs-map
	container expr-container
do common-types
	types-and-specs-map: types-and-specs-map
	funs-map: funs-map
	container: container
	specs: specs container
	type-params: type-param-asts container
	is-in-trusted: false
	used-trusted: false
	locals: ()
	refined-types: ()
	lambdas: ()
	allocated-locals: ()

funs-map funs-map() expr-ctx
	the::expr-ctx.funs-map
specs specs() expr-ctx
	the::expr-ctx.specs
set-specs void(value specs) expr-ctx
	the::expr-ctx.specs := value
type-container type-container() expr-ctx
	the::expr-ctx.type-container
type-params type-params() expr-ctx
	the::expr-ctx.type-params
lambdas lambda-info mut[]() expr-ctx
	the::expr-ctx.lambdas
locals local mut[]() expr-ctx
	the::expr-ctx.locals
refined-types (local, type-args) mut[]() expr-ctx
	the::expr-ctx.refined-types

type-container type-container(a expr-ctx)
	a.container.to

type-with-container type-with-container(a type) expr-ctx
	a, the::expr-ctx.container.to

trusted-scope record(ast trusted-ast, allow-unused bool)
with-block[out] out(a trusted-scope, cb out mut()) check-expr-ctx
	ctx = the::expr-ctx
	ctx.is-in-trusted := true
	res = cb[]
	ctx.is-in-trusted := false
	if !ctx.used-trusted and !a.allow-unused
		add-diag a.ast.keyword-range, diag-trusted-unused
	ctx.used-trusted := false
	res

check-trusted bool(ctx expr-ctx)
	res = ctx.is-in-trusted
	if res
		ctx.used-trusted := true
	res

context-forbids-global bool(a expr-ctx)
	some a.lambdas, it.mutability == data_

type-from-destructure type?(ast destructure-ast) check-expr-ctx
	the types-and-specs-map = the::expr-ctx.types-and-specs-map
	type-from-destructure ast, type-params

check-destructure destructure(ast destructure-ast, type type, kind destructure-kind) check-expr-ctx
	the types-and-specs-map = the::expr-ctx.types-and-specs-map
	check-destructure type-container, type-params, ast, type, kind

type-from-ast type(ast type-ast) check-expr-ctx
	the types-and-specs-map = the::expr-ctx.types-and-specs-map
	type-from-ast ast, type-params, yes

ensure-context-in-closure void(diag-range source-range, context-type type-inst) check-expr-ctx
	lambdas = lambdas
	i mut = lambdas.size
	until i == 0 or contains lambdas[i - 1].closure-contexts, context-type
		lambdas[i - 1].closure-contexts ~= context-type
		check-lambda-can-reference-local diag-range, lambdas[i - 1].mutability, "the", context-type, false
		i -:= 1

check-lambda-can-reference-local void
	diag-range source-range
	expected-mutability mutability
	local-name symbol
	local-type type
	local-is-mutable bool
do check-expr-ctx
	do unless expected-mutability == mut_
	if local-is-mutable
		add-diag diag-range,
			diag-lambda-closure-mutability expected-mutability, local-name, ()
	elif !is-mutability-always-compatible-considering-specs specs, local-type, expected-mutability
		add-diag diag-range,
			diag-lambda-closure-mutability expected-mutability, local-name, type-with-container local-type

is-mutability-always-compatible-considering-specs bool(fun-specs specs, type type, expected mutability)
	type-mutability = mutability-range type
	is-mutability-always-compatible expected, type-mutability or
	specs-provide-mutability fun-specs, type, expected or
	match type
	as bogus-type
		false
	as type-param-index
		false
	as type-inst
		type-mutability.best-case <= expected and
		every type.type-args, of type-arg
			is-mutability-always-compatible-considering-specs fun-specs, type-arg, expected

| Whether {specs} tells us that {type} has mutability at most {expected}
-specs-provide-mutability bool(specs specs, type type, expected mutability)
	some specs.all-builtin, of builtin_, type-args
		(p = builtin_.to::mutability?) and type-args.only! == type and p <= expected

get-the bool(range source-range, the-type type-inst) check-expr-ctx
	if contains specs.all-contexts, the-type
		ensure-context-in-closure range, the-type
		true
	else
		add-diag range,
			diag-context-type-missing type-container, specs.all-contexts.slow-to-array, the-type
		false
