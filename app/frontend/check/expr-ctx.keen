import
	../../model/ast
	../../model/model
	../../model/source-range
	./check-ctx
	./type-from-ast

lambda-info record mut
	mutability mutability
	# Index into locals on expr-ctx. This is the first local inside the lambda (or an inner lambda).
	first-local-index nat
	closure-locals local mut[]
	closure-contexts type-inst mut[]

call-scope interface mut
	check-trusted bool()
	context-forbids-global bool()
never-trusted record call-scope case
check-trusted bool(_ never-trusted)
	false
context-forbids-global bool(_ never-trusted)
	false

check-expr-ctx spec check-ctx, common-types, expr-ctx

expr-ctx record mut, call-scope case
	types-and-specs-map types-and-specs-map
	funs-map funs-map
	| For diags. This will be a {fun-decl} or {test_}.
	container expr-container
	specs mut specs
	type-params type-params
	-is-in-trusted mut bool
	-used-trusted mut bool
	locals local mut[]
	refined-types (local, type-args) mut[]
	refined-calls refined-call mut[]
	# When we access a local in a lambda, we need to make sure it's added to the closure of each lambda it's in
	lambdas lambda-info mut[]
	allocated-locals type-inst mut[local]
-refined-call record(local local, called fun-inst, type-refinements type-args)
new expr-ctx
	types-and-specs-map types-and-specs-map
	funs-map funs-map
	container expr-container
	type-params type-params
do common-types
	types-and-specs-map: types-and-specs-map
	funs-map: funs-map
	container: container
	specs: specs container
	type-params: type-params
	is-in-trusted: false
	used-trusted: false
	locals: ()
	refined-types: ()
	refined-calls: ()
	lambdas: ()
	allocated-locals: ()
funs-map funs-map() expr-ctx
	the::expr-ctx.funs-map
the-specs specs() expr-ctx
	the::expr-ctx.specs
set-specs void(value specs) expr-ctx
	the::expr-ctx.specs := value
type-container type-container() expr-ctx
	the::expr-ctx.type-container
type-params type-params() expr-ctx
	the::expr-ctx.type-params
lambdas lambda-info mut[]() expr-ctx
	the::expr-ctx.lambdas
locals local mut[]() expr-ctx
	the::expr-ctx.locals
-refined-locals (local, type-args) mut[]() expr-ctx
	the::expr-ctx.refined-types
-refined-calls refined-call mut[]() expr-ctx
	the::expr-ctx.refined-calls

refinements-for-local type-args?(local local) expr-ctx
	?b find-last refined-locals, it.a == local
as-refined-call local-get-and-call-and-refine-expr?(ast call-and-refine-source) expr-ctx
	do if arg = only-arg ast
	do if name-and-range arg
	do if call = find-last refined-calls, {it.local.name == arg.name and it.called.name == ast.fun-name.name}
	ast: ast
	local: call.local
	local-type-refinements: refinements-for-local call.local else no-type-args
	called: call.called
	type-refinements: call.type-refinements

type-container type-container(a expr-ctx)
	a.container.to

type-with-container type-with-container(a type) expr-ctx
	a, the::expr-ctx.container.to

trusted-scope record(ast trusted-ast, allow-unused bool)
with-block[out] out(a trusted-scope, cb out mut()) check-expr-ctx
	ctx = the::expr-ctx
	ctx.is-in-trusted := true
	res = cb[]
	ctx.is-in-trusted := false
	if not ctx.used-trusted and not a.allow-unused
		add-diag a.ast.keyword-range, diag-trusted-unused
	ctx.used-trusted := false
	res

check-trusted bool(ctx expr-ctx)
	res = ctx.is-in-trusted
	if res
		ctx.used-trusted := true
	res

context-forbids-global bool(a expr-ctx)
	some a.lambdas, it.mutability == data_

type-from-destructure type?(ast destructure-ast) check-expr-ctx
	the types-and-specs-map = the::expr-ctx.types-and-specs-map
	type-from-destructure ast, type-params

check-destructure destructure(ast destructure-ast, type type, kind destructure-kind) check-expr-ctx
	the types-and-specs-map = the::expr-ctx.types-and-specs-map
	check-destructure type-container, type-params, ast, type, kind

type-from-ast type(ast type-ast) check-expr-ctx
	the types-and-specs-map = the::expr-ctx.types-and-specs-map
	type-from-ast ast, type-params, yes

ensure-context-in-closure void(diag-range source-range, context-type type-inst) check-expr-ctx
	lambdas = lambdas
	i mut = lambdas.size
	until i == 0 or contains lambdas[i - 1].closure-contexts, context-type
		lambdas[i - 1].closure-contexts ~= context-type
		check-lambda-can-reference-local diag-range, lambdas[i - 1].mutability, "the", context-type, false
		i -:= 1

check-lambda-can-reference-local void
	diag-range source-range
	expected-mutability mutability
	local-name symbol
	local-type type
	local-is-mutable bool
do check-expr-ctx
	do unless expected-mutability == mut_
	if local-is-mutable
		add-diag diag-range,
			diag-lambda-closure-mutability expected-mutability, local-name, ()
	elif not is-mutability-always-compatible-considering-specs the-specs, local-type, expected-mutability
		add-diag diag-range,
			diag-lambda-closure-mutability expected-mutability, local-name, type-with-container local-type

is-mutability-always-compatible-considering-specs bool(fun-specs specs, type type, expected mutability)
	type-mutability = mutability-range type
	is-always-compatible expected, type-mutability or
	specs-provide-mutability fun-specs, type, expected or
	match type
	as bogus-type
		false
	as type-param-index
		false
	as type-inst
		type-mutability.best-case <= expected and
		every type.type-args, of type-arg
			is-mutability-always-compatible-considering-specs fun-specs, type-arg, expected

| Whether {specs} tells us that {type} has mutability at most {expected}
-specs-provide-mutability bool(specs specs, type type, expected mutability)
	some specs.all-builtin, of builtin_, type-args
		(p = builtin_.to::mutability?) and type-args.only! == type and p <= expected

get-the bool(range source-range, the-type type-inst) check-expr-ctx
	if contains the-specs.all-contexts, the-type
		ensure-context-in-closure range, the-type
		true
	else
		add-diag range,
			diag-context-type-missing type-container, the-specs.all-contexts.slow-to-array, the-type
		false

expression-context union(known-value, destructure, no-context)
| Context where {expr} is known to be {expr-value}
known-value record(expr expr, expr-value bool)
no-context record
check-with-condition[t] t(context expression-context, f t mut()) check-expr-ctx
	restore-locals = locals.size
	restore-refined-types = refined-locals.size
	restore-refined-calls = refined-calls.size
	original-specs = the-specs
	match context
	as known-value
		for x in condition-knowledge context.expr, context.expr-value
			match x
			as local
				add-local x
			as local-refinement
				add-type-refinement x.local, x.refined-type
			as call-refinement
				add-call-refinement x
			as build-target
				specs := add-build-target-to-specs the-specs, x
	as destructure
		add-locals-for-destructure context
	as no-context
		()
	res = f[]
	reduce-size-to locals, restore-locals
	reduce-size-to refined-locals, restore-refined-types
	reduce-size-to refined-calls, restore-refined-calls
	specs := original-specs
	res
add-locals-for-destructure void(destructure destructure) check-expr-ctx
	for x in destructure.locals
		add-local x

-add-build-target-to-specs specs(specs specs, target build-target) common-types
	get-or-add-specs specs.inner ~ match target
	as java
		java-spec
	as js
		js-spec

maybe-refinement record(refinable refinable?, refined-type type-inst)
with-block[t] t(a maybe-refinement, f t mut()) expr-ctx
	if x = a.refinable
		match x
		as local
			add-type-refinement x, a.refined-type
		as local-and-called
			add-call-refinement (x.local, x.called, a.refined-type)
	res = f[]
	if x = a.refinable
		match x
		as local
			_ = pop! refined-locals
		as local-and-called
			_ = pop! refined-calls
	res

-add-type-refinement void(local local, refined-type type) expr-ctx
	refined-locals ~= local, if existing = find refined-locals, it.a == local
		existing.b ~ refined-type
	else
		as-type-args refined-type

-add-call-refinement void(a call-refinement) expr-ctx
	existing = find refined-calls, {it.local.name == a.local.name and it.called == a.called}
	refined-calls ~= a.local, a.called, if existing
		existing.type-refinements ~ a.refined-type
	else
		as-type-args a.refined-type

with-local record(local local?)
with-block[t] t(a with-local, f t mut()) check-expr-ctx
	?add-local a.local
	res = f[]
	if a.local
		_ = pop! locals
	res

-add-local void(local local) check-expr-ctx
	if some locals, it.name == local.name
		add-diag local.local-must-have-name-range, diag-duplicate-declaration param-or-local, local.name
	locals ~= local

| Iterate over this to get knowledge deduced when the expression has the given value.
-condition-knowledge record(expr expr, expr-value bool)
| Indicates that when the condition has the given value:
| * A local will exist (e.g. `if x = ...`)
| * Or an already-existing local will have a more specific type
|	(e.g. `if x.specific-case-type` or `if x` for an option)
| * Or the scope is for a particular build (e.g. `if java`)
-condition-knowledge-item union(local, local-refinement, call-refinement, build-target)
local-refinement record(local local, refined-type type)
-call-refinement record(local local, called fun-inst, refined-type type)
-some bool(a condition-knowledge, f bool mut(x condition-knowledge-item))
	match expr = a.expr
	as call-expr
		if a.expr-value and case-type = as-sum-type-case-get expr.called
			arg = only! expr.args
			if local = as-immut-local-get arg
				f[local, case-type]
			elif x = as-access-field-of-local arg
				f[x.local, x.called, case-type]
		elif a.expr-value and x = as-access-field-of-local expr and inner = unwrap-option x.called.return-type
			f[x.local, x.called, inner]
		elif b = as-builtin-fun expr.called
			if b == not
				some (condition-knowledge expr.args.only!, not a.expr-value), f
			elif a.expr-value and builtin-fun-is-target b
				f[b.target]
	as local-get-expr
		do if a.expr-value
		local = expr.local
		if not is-mutable local and inner = unwrap-option local.type
			f[local, inner]
	as logical-expr
		do if a.expr-value
		if expr.kind == bool-and-bool
			some (condition-knowledge expr.left, true), f or
			some (condition-knowledge expr.right, true), f
	as trusted-expr
		some (condition-knowledge expr.inner, a.expr-value), f
	as unpack-option
		do if a.expr-value
		some expr.destructure.locals, f[it]
	else
		()

refinable union(local, local-and-called)
local-and-called record(local local, called fun-inst)
as-refinable refinable?(expr expr)
	as-immut-local-get expr or as-access-field-of-local expr

as-call-sum-type-case-get-on-local (local, type)?(expr call-expr)
	if case-type = as-sum-type-case-get expr.called
		if local = as-immut-local-get only! expr.args
			local, case-type
-as-sum-type-case-get type?(a called)
	do if fun-inst a
	do if sum-type-case-get a.decl.body
	a.return-type.unwrap-option!

-as-immut-local-get local?(a expr)
	if res = as-local-get a and not is-mutable res
		res
-as-local-get local?(a expr)
	match a
	as local-get-expr
		a.local
	as local-get-and-refine-expr
		a.local
	else
		()
-as-access-field-of-local local-and-called?(a expr)
	match a
	as call-expr
		called = a.called
		do if arg = only a.args
		do if fun-inst called
		do if is-immutable-field-getter called or is-pure-function called
		do if local = as-immut-local-get arg
		local, called
	as local-get-and-call-and-refine-expr
		a.local, a.called
	else
		()

# Allow accessing an immutable field even if the type is mutable
-is-immutable-field-getter bool(a fun-inst)
	body = a.decl.body
	record-field-get body and not body.field.mutability
-is-pure-function bool(a fun-inst)
	every a.param-types, it.worst-case-mutability == data_ and
	every a.specs.all-contexts, it.worst-case-mutability == data_ and
	not is-global a.specs
