import
	keen/bits
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/by-key
	../../util/util
	./check-call/check-call-specs
	./check-ctx
	./check-util
	./instantiate
	./type-from-ast

modifier-type-arg-invalid void(modifier modifier-keyword-ast) check-ctx
	if modifier.type-arg
		add-diag modifier.range, modifier.diag-modifier-type-arg-invalid

check-types-initial type-decl[](asts type-decl-ast[]) check-ctx
	for ast in asts
		check-type-params ast.type-params
		mutability = get-type-mutability ast
		hash: next-hash
		source: ast
		visibility: visibility-from-explicit-top-level ast.visibility
		mutability: mutability.mutability
		mutability-is-forced: mutability.forced
		doc-comment-references: ()
		sum-type-cases: ()
		body: type-body-bogus

check-type-bodies void(types type-decl[], asts type-decl-ast[]) check-ctx, types-get
	for type, ast in zip types, asts
		type.body := match x = ast.body
		as builtin-type-ast
			check-only-common-modifiers builtin_, ast.modifiers
			get-builtin-type type
		as enum-ast
			check-no-type-params ast.type-params, enum_
			check-only-common-modifiers enum_, ast.modifiers
			check-enum type, x
		as flags-ast
			check-no-type-params ast.type-params, flags_
			check-only-common-modifiers flags_, ast.modifiers
			check-flags type, x
		as record-ast
			check-record type, ast.modifiers, x
		as sum-type-ast
			check-sum-type type, ast, x
	for type, ast in zip types, asts
		type.specs := check-type-specs type, ast
		type.sum-type-cases := check-sum-type-cases-initial type, ast
		# 'fill-narrow-types-for-type-decl' fills in related types' narrow-types, so this may have already been done
		unless type.narrow-types
			fill-narrow-types-for-type-decl 10, type, of type-with-cycle
				add-diag type-with-cycle.name-range.range, diag-union-cycle

-check-sum-type sum-type
	type type-decl
	ast type-decl-ast
	ast-body sum-type-ast
do check-ctx, types-get
	check-only-common-modifiers ast-body.kind.decl-kind-for-sum-type, ast.modifiers
	listed-members = check-sum-type-listed-members-initial type, ast-body
	kind: ast-body.kind
	listed-members: listed-members
	methods: check-signatures type, ast.type-params, ast-body.methods

check-signatures signature[]
	container signature-container
	type-params type-params
	asts signature-ast[]
do check-ctx, types-get
	for ast in asts
		return-type, params = check-return-type-and-params container.to, ast.return-type, ast.params, type-params
		container, ast, (get-name-and-arity ast.name, params.size), return-type, params, ()

-check-sum-type-listed-members-initial sum-type-case-and-method-impls[]
	sum-type type-decl
	ast sum-type-ast
do check-ctx, types-get
	if ast.kind == union_
		if is-empty ast.types
			add-diag sum-type.keyword-range.range, diag-empty-enum-or-union
		res sum-type-case-and-method-impls mut[] = ()
		for type-ast in ast.types
			type = type-from-ast type-ast, sum-type.type-param-asts, yes
			match type
			as bogus-type
				()
			as type-param-index
				add-diag type-ast.range, type-parameter::diag-union-member-invalid
			as type-inst
				if some res, it.case-type.decl == type.decl
					add-diag type-ast.range, diag-duplicate-declaration union-member, type.decl.name
				elif is-option type
					add-diag type-ast.range, option::diag-union-member-invalid
				else
					res ~= type, ()
		res.move-to
	else
		unless ast.types.is-empty
			add-diag ast.types-range, diag-sum-type-listed-members-non-union
		()

-check-type-specs specs(decl type-decl, ast type-decl-ast) check-ctx, common-types
	get-or-add-specs for* modifier in ast.modifiers
		match modifier
		as modifier-keyword-ast
			()
		as spec-use-ast
			name = modifier.name.name
			if name == "global"
				if is-data decl
					add-diag modifier.range, diag-global-data-type
				- global-spec
			elif value build-target = name.to
				- extern-spec value
			else
				add-diag modifier.name.range, ast.body.get-decl-kind.diag-spec-use-invalid
				()

-check-sum-type-cases-initial sum-type-case[]
	type type-decl
	ast type-decl-ast
do check-ctx, types-get
	res sum-type-case mut[] = ()
	for mod in ast.modifiers
		do if case_ = sum-type-case-from-modifier type, mod
		if is-template type
			add-diag mod.range, diag-case-type-not-allowed type, has-type-parameters
		elif sum-type type.body
			add-diag mod.range, diag-case-type-not-allowed type, is-sum-type
		elif some res, it.sum-type.decl == case_.sum-type.decl
			add-diag mod.range, diag-case-duplicate type, case_.sum-type.decl
		else
			res ~= case_
	move-to res
-sum-type-case-from-modifier sum-type-case?(type type-decl, mod modifier-ast) check-ctx, types-get
	do if mod.modifier-keyword-ast
	do if mod.keyword == case_
	if type-ast = mod.type-arg
		type-arg = type-from-ast type-ast, type.type-param-asts, yes
		if is-interface-or-variant type-arg
			mod, type-arg.type-inst!, ()
		else
			if not is-bogus type-arg
				add-diag mod.range, diag-case-invalid-sum-type type, type-arg
			()
	else
		add-diag mod.range, diag-case-missing-type
		()

-is-interface-or-variant bool(a type)
	a.type-inst and is-interface-or-variant a.decl.body
-is-interface-or-variant bool(a type-body)
	a.sum-type and match a.kind
	as interface_
		true
	as java-interface
		true
	as variant_
		true
	as union_
		false

check-method-impls void(types type-decl[]) check-ctx, common-types, funs-map
	do for type in types
	if sum = type.body.sum-type
		members = sum.listed-members
		do unless is-empty members
		inst = type.instantiated-with-own-type-params
		member-asts = type.source.type-decl-ast!.body.sum-type-ast!.types
		for i, x in with-index members
			range = if members.size == member-asts.size then member-asts[i].range else type.name-range.range
			x.method-impls := check-method-impls-for-case type, x.case-type, range, inst, type.body.sum-type!.methods

	unless is-empty type.sum-type-cases
		case-type = type.instantiated-with-own-type-params
		for x in type.sum-type-cases
			x.method-impls :=
				check-method-impls-for-case type, case-type, x.ast!.range, x.sum-type, x.sum-type-decl-methods

-check-method-impls-for-case fun-inst?[]
	# This may be the union type, or it may be a case type of a variant. It's used for specs.
	type-container type-decl
	member-type type-inst
	diag-range source-range
	sum-type type-inst
	method-decls signature[]
do check-ctx, common-types, funs-map
	member = member-type.decl
	check-mutability-compatible sum-type.decl, member-type, diag-range

	do for sig in method-decls
	types return-and-param-types = make-return-and-param-types
		- instantiate-type sig.return-type, sum-type.type-args
		- member-type
		-- for x in sig.params
			instantiate-type x.type, sum-type.type-args
	called = get-method-impl type-container, diag-range, (get-name-and-arity sig.name, sig.params.size + 1), types
	if called and called.decl.visibility < min sum-type.decl.visibility, member.visibility
		add-diag diag-range, diag-method-impl-visibility member, sum-type, called
	called

-mutability-and-forced record(mutability mutability, forced bool)
-get-type-mutability mutability-and-forced(ast type-decl-ast) check-ctx
	if modifier = get-mutability-modifier ast
		pf = mutability-and-forced-from-modifier! modifier.keyword
		if pf.mutability == data_ and not pf.forced
			add-diag modifier.keyword-range,
				diag-modifier-redundant-due-to-decl-kind modifier.keyword, ast.body.get-decl-kind
		pf
	else
		data_, false

-get-mutability-modifier modifier-keyword-ast?(ast type-decl-ast) check-ctx
	res mut modifier-keyword-ast? = ()
	for modifier in ast.modifiers
		match modifier
		as modifier-keyword-ast
			do unless is-new-visibility modifier.keyword
			do unless modifier.keyword == case_
			if mutability-and-forced-from-modifier modifier.keyword
				modifier-type-arg-invalid modifier
				if res then add-diag-duplicate-modifier res!, modifier
				res := modifier
			else
				add-diag modifier.keyword-range,
					diag-modifier-invalid modifier.keyword, ast.body.get-decl-kind
		as spec-use-ast
			()
	res

-decl-kind-for-sum-type decl-kind(a sum-type-kind)
	match a
	as interface_
		interface_
	as java-interface
		java-interface
	as union_
		union_
	as variant_
		variant_

-get-decl-kind decl-kind(a type-body-ast)
	match a
	as builtin-type-ast
		builtin_
	as enum-ast
		enum_
	as flags-ast
		flags_
	as record-ast
		record_
	as sum-type-ast
		decl-kind-for-sum-type a.kind

-mutability-and-forced-from-modifier mutability-and-forced?(a modifier-keyword)
	match a
	as data_
		data_, false
	as force-data_
		data_, true
	as force-shared_
		shared_, true
	as mut_
		mut_, false
	as shared_
		shared_, false
	else
		()

-check-only-common-modifiers void(decl-kind decl-kind, modifiers modifier-ast[]) check-ctx
	for modifier in modifiers
		unless is-common-modifier modifier
			add-diag-modifier-invalid decl-kind, modifier

-add-diag-modifier-invalid void(decl-kind decl-kind, modifier modifier-ast) check-ctx
	add-diag modifier.range, match modifier
	as modifier-keyword-ast
		diag-modifier-invalid modifier.keyword, decl-kind
	as spec-use-ast
		diag-spec-use-invalid decl-kind

-is-common-modifier bool(a modifier-ast)
	match a
	as modifier-keyword-ast
		a.keyword == case_ or mutability-and-forced-from-modifier a.keyword
	as spec-use-ast
		a.name.name == "global" or a.name.name.to::build-target?

-check-enum enum_(type type-decl, ast enum-ast) check-ctx
	members = check-enum-or-flags-members type, ast.params, ast.members, enum-member, of diag-range, last, declared
		if declared
			if last and declared <= last
				add-diag diag-range, last.diag-enum-value-not-sorted
				next-enum-value diag-range, last
			else
				declared
		else
			next-enum-value diag-range, last
	if is-empty members.members
		add-diag type.name-range.range, diag-empty-enum-or-union
	members.storage, members.members, members.members-by-key
-next-enum-value nat(diag-range source-range, last-value nat?) check-ctx
	if last-value
		try
			last-value + 1
		catch as arithmetic-error
			add-diag diag-range, diag-literal-overflow nat64
			0
	else
		0

-check-flags flags_(type type-decl, ast flags-ast) check-ctx
	members = check-enum-or-flags-members type, ast.params, ast.members, flags-member, of diag-range, last, declared
		if declared
			if is-power-of-two declared
				if last and declared <= last
					add-diag diag-range, last.diag-enum-value-not-sorted
					next-flags-value diag-range, last
				else
					declared
			else
				add-diag diag-range, diag-flags-value-not-power-of-2
				next-flags-value diag-range, last
		else
			next-flags-value diag-range, last
	members.storage, members.members
-next-flags-value nat(diag-range source-range, last-value nat?) check-ctx
	if last-value
		try
			last-value * 2
		catch as arithmetic-error
			add-diag diag-range, diag-literal-overflow nat64
			()
	else
		1

-enum-or-flags-members record
	storage nat-type
	members enum-or-flags-member[]
	members-by-key (symbol, enum-or-flags-member) by-key
-check-enum-or-flags-members enum-or-flags-members
	type type-decl
	params destructure-ast[]?
	member-asts enum-or-flags-member-ast[]
	member-kind diag-duplicate-declaration-kind
	cb-get-next-value nat mut(diag-range source-range, last-value nat?, declared-value nat?)
do check-ctx
	if params and not is-empty member-asts
		add-diag type.name-range.range,
			diag-type-decl-params-syntax-error type, has-params-and-fields

	last-value mut nat? = ()
	cb-value cb-enum-value = of value-range, literal
		declared-value nat? = if literal
			check-literal-nat-value nat64, literal.range
		value = cb-get-next-value[value-range, last-value, declared-value]
		last-value := value
		value

	members = if params
		enum-or-flags-members-from-params type, params, cb-value
	else
		with out in member-asts.size.build
			for x in member-asts
				if value = cb-value[x.range, x.value]
					out ~= x, type, value, ()

	members-by-key (symbol, enum-or-flags-member) by-key = to-by-key members, of _, duplicate
		add-diag duplicate.name-range.range,
			diag-duplicate-declaration member-kind, duplicate.name
	members.enum-storage-type, members, members-by-key

-cb-enum-value alias
	nat? mut(range source-range, explicit literal-number?)

-enum-or-flags-members-from-params enum-or-flags-member[]
	enum-or-flags type-decl
	params destructure-ast[]
	cb-value cb-enum-value
do check-ctx
	do with out in build params.size
	do for param in params
	do if value = cb-value[param.range, ()]
	if param.name-and-range
		out ~= param, enum-or-flags, value, ()
	else
		add-diag param.range, diag-type-decl-params-syntax-error enum-or-flags, destructure

-enum-storage-type nat-type(members enum-or-flags-member[])
	max = if is-empty members then 0 else members[end - 1].value
	if max <= max-value::nat8
		nat8
	elif max <= max-value::nat16
		nat16
	elif max <= max-value::nat32
		nat32
	else
		nat64

-check-record record_
	type type-decl
	modifier-asts modifier-ast[]
	ast record-ast
do check-ctx, types-get
	new-visibility = accumulate-record-modifiers modifier-asts
	fields = check-record-fields type, ast
	new-visibility: record-new-visibility type, fields, new-visibility
	fields: fields

-check-record-fields record-field[](type type-decl, ast record-ast) check-ctx, types-get
	if ast.params and not is-empty ast.fields
		add-diag type.name-range.range, diag-type-decl-params-syntax-error type, has-params-and-fields
	res record-field[] = if ast.params
		for* param in ast.params
			from-option record-field-from-param type, param
	else
		for x in ast.fields
			check-record-field type, x, x.visibility, x.name, x.mutability, x.type
	for x, y in all-pairs res
		if x.name == y.name
			add-diag-assert-same-uri y.range,
				diag-duplicate-declaration record-field, y.name
	res

-record-field-from-param record-field?(record_ type-decl, ast destructure-ast) check-ctx, types-get
	if ast.single-destructure-ast
		mutability field-mutability-ast? = if x = ast.mut_ then x, ()
		check-record-field record_, ast, (), ast.name, mutability, ast.type
	else
		add-diag ast.range, diag-type-decl-params-syntax-error record_, destructure
		()

| Shared in common between {single-destructure-ast} and {record-field-ast}
-check-record-field record-field
	record_ type-decl
	source record-field-source
	visibility-ast visibility-and-range?
	name name-and-range
	mutability-ast field-mutability-ast?
	type-ast type-ast?
do check-ctx, types-get
	field-type = if type-ast
		res = type-from-ast type-ast, record_.type-param-asts, yes
		check-mutability-compatible record_, res, type-ast.range
		res
	else
		add-diag name.range, diag-record-field-needs-type name.name
		bogus-type

	visibility = visibility-from-default-with-diag record_.visibility, visibility-ast,
		visibility-warning-field record_, name.name
	mutability visibility? = if mutability-ast
		if record_.mutability != mut_ and not record_.mutability-is-forced
			add-diag mutability-ast.range, diag-mutability-of-field-more-than-parent record_, name.name
		visibility-from-default-with-diag visibility, mutability-ast.visibility,
			visibility-warning-field-mutability name.name
	source, record_, visibility, mutability, field-type, ()

-check-mutability-compatible void(parent type-decl, child type, diag-range source-range) check-context
	unless is-possibly-compatible parent.mutability, child.mutability-range or mutability-is-forced parent
		add-diag diag-range, diag-mutability-more-than-parent parent, child

-visibility-from-default-with-diag visibility
	default visibility
	explicit visibility-and-range?
	kind visibility-warning-kind
do check-ctx
	if explicit
		actual = explicit.visibility
		if actual < default
			actual
		else
			add-diag explicit.range, diag-visibility-warning kind, default, actual
			default
	else
		default

-add-diag-duplicate-modifier void(old modifier-ast, new modifier-ast) check-ctx
	add-diag new.range, if new.name-or-keyword == old.name-or-keyword
		diag-modifier-duplicate new.name-or-keyword
	else
		diag-modifier-conflict old.name-or-keyword, new.name-or-keyword

-accumulate-record-modifiers modifier-keyword-ast?(modifiers modifier-ast[]) check-ctx
	new-visibility mut modifier-keyword-ast? = ()
	for modifier in modifiers
		do if modifier.modifier-keyword-ast
		keyword = modifier.keyword
		if is-new-visibility keyword
			modifier-type-arg-invalid modifier
			if old = new-visibility
				add-diag-duplicate-modifier old, modifier
			new-visibility := modifier
		elif not is-common-modifier modifier
			add-diag modifier.keyword-range, diag-modifier-invalid keyword, record_
	new-visibility

-is-new-visibility bool(a modifier-keyword)
	a == new-internal or a == new-private or a == new-public

-record-new-visibility visibility
	record_ type-decl
	fields record-field[]
	new-visibility modifier-keyword-ast?
do check-ctx
	default mut = record_.visibility
	for field in fields
		default min:= field.visibility
	explicit visibility-and-range? = if new-visibility
		new-visibility.keyword.visibility-from-new-visibility, new-visibility.keyword-pos
	visibility-from-default-with-diag default, explicit, record_.visibility-warning-new

-visibility-from-new-visibility visibility(a modifier-keyword)
	match a
	as new-private
		private
	as new-internal
		internal
	as new-public
		public
	else
		throw unreachable

-get-builtin-type builtin-type(decl type-decl) check-ctx
	decl.name.to else
		add-diag-assert-same-uri decl.name-range, diag-builtin-unsupported type, decl.name
		void
