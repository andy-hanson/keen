import
	keen/bits
	keen/format/binary
	keen/parse
	keen/unsafe
	../../lib/private/parse-util
	../model/model
	../model/uri
	../util/java-bytecode-types
	../util/perf
	../util/util

parsed-java-class record
	content nat8 array-view
	constants constants
	access class-access
	this-class path
	type-params symbol[]
	super-class java-class-type?
	interfaces java-class-type[]
	# Omits private fields
	fields parsed-field[]
	# Omits private methods
	methods parsed-method[]

java-class-reference record
	path path
	is-supertype bool

referenced-in-supertypes record(class_ parsed-java-class)
some bool(a referenced-in-supertypes, f bool mut(x java-class-reference))
	class_ = a.class_
	(super = class_.super-class) and some-supertype-reference super, f or
	some class_.interfaces, of x then some-supertype-reference x, f

-some-supertype-reference bool(a java-class-type, f bool mut(x java-class-reference))
	f[a.path, true] or some a.type-args, of x then some-type-reference x, f

referenced-classes record(class_ parsed-java-class)
some bool(a referenced-classes, f bool mut(x java-class-reference))
	class_ = a.class_
	some a.class_.referenced-in-supertypes, f or
	some class_.fields, (of x then some-type-reference x.erased-type, f or some-type-reference x.generic-type, f) or
	some class_.methods, (of x then some-method-reference x, f)
-some-method-reference bool(a parsed-method, f bool mut(x java-class-reference))
	some-type-reference a.erased-return-type, f or
	some a.erased-param-types, (of x then some-type-reference x, f) or
	some-type-reference a.generic-return-type, f or
	some a.generic-param-types, of x then some-type-reference x, f
-some-type-reference bool(a java-type, f bool mut(x java-class-reference))
	match a
	as void
		()
	as java-primitive-type
		()
	as java-array-type
		some-type-reference a.element, f
	as java-class-type
		some-class-reference a, f
	as java-type-param
		()
-some-class-reference bool(a java-class-type, f bool mut(x java-class-reference))
	f[a.path, false] or some a.type-args, of x then some-type-reference x, f

bogus-java-class parsed-java-class(path path)
	content: 0, 0, 0, 0, 0, 0 # 0 fields, 0 methods, 0 attributes (and 2 bytes per '0')
	constants: ()
	access: public
	this-class: path
	type-params: ()
	super-class: ()
	interfaces: ()
	fields: ()
	methods: ()
parse-java-class parsed-java-class(content nat8 array-view)
	start = perf-now
	finally end-parse-java-class start
	reader = begin content
	reader.take32 is 0xcafebabe
	version = take32 reader
	assert version >= 69
	the constants = read-constant-pool reader
	access class-access = reader.take16.to!
	this-class = read-class-reference reader
	super-class-path = read-optional-class-reference reader
	interface-paths = read-array reader, it.read-class-reference
	fields = read-array reader, it.read-field
	methods = read-array reader, it.read-method
	sig = if signature = get-signature read-attributes reader
		parse-class-signature signature, super-class-path!, interface-paths
	else
		type-params: ()
		super-class: if super-class-path
			java-class-type super-class-path, ()
		interfaces: for x in interface-paths
			java-class-type x, ()
	assert is-at-end reader
	content: content
	constants: the::constants
	access: access
	this-class: this-class
	type-params: sig.type-params
	super-class: sig.super-class
	interfaces: sig.interfaces
	fields: filter fields, !it.access-flags[private]
	methods: filter methods, !it.access-flags[private]

-class-signature record(type-params symbol[], super-class java-class-type?, interfaces java-class-type[])
-parse-class-signature class-signature(input char8 array-view, super-class-path path, interface-paths path[]) constants
	iter = begin input
	type-params = read-type-params iter
	super-class = read-class-type iter
	super-class.path is super-class-path
	interfaces java-class-type[] = for i in interface-paths
		res = read-class-type iter
		res.path is i
		res
	assert is-at-end iter
	type-params, super-class, interfaces

-read-type-params symbol[](iter string-iterator)
	do if try-take-char8 iter, "<"
	do with out in build
	do until
	start = copy iter
	until iter.peek == ":" or iter.peek == ">"
		_ = take-next iter
	out ~= to::symbol slice start, iter
	if try-take iter, "::"
		# Class bound
		_ = read-type iter
	if try-take iter, ":"
		# Interface bounds
		_ = read-type iter
		while iter.peek == "L"
			_ = read-type iter
	try-take iter, ">"

take-until-terminator char8 array-view(iter string-iterator, char char8)
	start = copy iter
	until iter.peek8 == char
		_ = take-next iter
	res = slice start, iter
	take-next iter is char
	res

-read-array[t] t[](reader nat8 array-iterator, f t mut(reader nat8 array-iterator))
	for _ in 0 .. reader.take16
		f[reader]

parsed-field record
	access-flags field-access-flags
	name symbol
	erased-type java-type
	generic-type java-type
-read-field parsed-field(reader nat8 array-iterator) constants
	access-flags field-access-flags = to! reader.take16
	name symbol = to read-utf8-reference reader
	erased-type = parse-type read-utf8-reference reader
	attributes = read-attributes reader
	generic-type = if sig = get-signature attributes
		parse-type sig
	else
		erased-type
	access-flags: access-flags
	name: name
	erased-type: erased-type
	generic-type: generic-type

-constants record
	| These are both indexed by constant pool indices. Thus some entries are unused,
	constant-strings string-view[]
	constant-classes path[]
new constants()
	(), ()

parsed-method record
	access-flags method-access-flags
	name symbol
	erased-return-type java-type
	erased-param-types java-type[]
	type-params symbol[]
	generic-return-type java-type
	generic-param-types java-type[]
-read-method parsed-method(reader nat8 array-iterator) constants
	access-flags method-access-flags = reader.take16.to!
	name symbol = to read-utf8-reference reader
	descriptor-text = read-utf8-reference reader
	erased-type-params, erased-return-type, erased-param-types = parse-method-descriptor descriptor-text
	assert is-empty erased-type-params
	attributes = read-attributes reader
	type-params, generic-return-type, generic-param-types = if sig = get-signature attributes
		parse-method-descriptor sig
	else
		erased-type-params, erased-return-type, erased-param-types
	access-flags: access-flags
	name: name
	erased-return-type: erased-return-type
	erased-param-types: erased-param-types
	type-params: type-params
	generic-return-type: generic-return-type
	generic-param-types: generic-param-types

| 'path' is a class path such as "java/lang/Object"
java-type union(void, java-primitive-type, java-array-type, java-class-type, java-type-param)
java-array-type record(element java-type)
java-class-type record(path path, type-args java-type[])
java-type-param record(name symbol)

-parse-method-descriptor (symbol[], java-type, java-type[])(a string-view)
	iter string-iterator = begin a
	type-params = read-type-params iter
	take-next iter is "("
	param-types java-type[] = with out in build
		until try-take-char8 iter, ")"
			out ~= read-type iter
	return-type = read-type iter
	# Ignore 'throws' clauses
	while try-take-char8 iter, "^"
		_ = read-type iter
	assert is-at-end iter
	type-params, return-type, param-types
-wrap-arrays java-type(type java-type, arrays nat)
	if arrays == 0 then type else wrap-arrays type.java-array-type, arrays - 1
-parse-type java-type(a string-view)
	iter = begin a
	res = read-type iter
	assert is-at-end iter
	res
-read-type java-type(iter string-iterator)
	arrays mut = 0
	res java-type = until
		match char = take-next iter
		as L
			read-class-type-after-L iter
		as T
			java-type-param to take-until-terminator iter, ";"
		as "["
			arrays +:= 1
			()
		as "-"
			# This means '? super foo'. Treat this as just 'foo'.
			()
		as "+"
			# This means '? extends foo'. Treat this as just 'foo'.
			()
		else
			single-char-type char
	wrap-arrays res, arrays
-read-class-type java-class-type(iter string-iterator)
	take-next iter is "L"
	read-class-type-after-L iter
-read-class-type-after-L java-class-type(iter string-iterator)
	start = copy iter
	until iter.peek8 == ";" or iter.peek8 == "<"
		_ = take-next iter
	path = as-path slice start, iter
	match take-next iter
	as "<"
		type-args = read-type-args-after-lt iter
		# Some signatures use Foo<Bar>.Baz instead of Foo$Baz<Bar>
		if try-take iter, "."
			after-dot = copy iter
			until iter.peek8 == ";" or iter.peek8 == "<"
				_ = take-next iter
			path2 = add-to-base-name path, "${slice after-dot, iter}"
			# Foo<Bar>.Baz<Bang> is Foo$Baz<Bar, Bang>
			more-type-args = if try-take iter, "<"
				type-args ~~ read-type-args-after-lt iter
			take-next iter is ";"
			java-class-type path2, type-args ~~ more-type-args
		else
			take-next iter is ";"
			java-class-type path, type-args
	as ";"
		java-class-type path, ()
	else
		throw unreachable

-read-type-args-after-lt java-type[](iter string-iterator)
	do with out in build
	out ~= read-type iter
	until try-take-char8 iter, ">"
		out ~= read-type iter

-single-char-type java-type(a char8)
	match a
	as B
		T_BYTE
	as C
		T_CHAR
	as D
		T_DOUBLE
	as F
		T_FLOAT
	as I
		T_INT
	as J
		T_LONG
	as S
		T_SHORT
	as V
		()::void
	as Z
		T_BOOLEAN
	as "*"
		java-class-type "java/lang/Object".assume-path, ()
	else
		throw unreachable

-read-attribute record
	attribute-name symbol
	attribute-bytes nat8 array-view
-read-attributes read-attribute[](reader nat8 array-iterator) constants
	read-array reader, it.read-attribute
-read-attribute read-attribute(reader nat8 array-iterator) constants
	attribute-name = read-utf8-reference reader
	attribute-bytes = take-next-n reader, reader.take32
	attribute-name: attribute-name.to
	attribute-bytes: attribute-bytes

-get-signature string-view?(attributes read-attribute[]) constants
	do if attr = find attributes, it.attribute-name == "Signature"
	attr.attribute-bytes.size is 2
	the::constants.constant-strings[attr.attribute-bytes.to::nat16]

-to nat16(a nat8 array-view)
	x, y = only2! a
	x 'bits-cat y

-read-utf8-reference string-view(reader nat8 array-iterator) constants
	the::constants.constant-strings[reader.take16]
-read-class-reference path(reader nat8 array-iterator) constants
	read-optional-class-reference! reader
-read-optional-class-reference path?(reader nat8 array-iterator) constants
	index = take16 reader
	unless index == 0
		the::constants.constant-classes[index]

# https://docs.oracle.com/javase/specs/jvms/se21/html/jvms-4.html#jvms-4.4
-read-constant-pool constants(reader nat8 array-iterator)
	constants-pool-count = take16 reader
	constant-pool-index mut nat16 = 1
	constant-strings-builder string-view buffer = n-of constants-pool-count, ()
	constant-classes nat16 buffer = n-of constants-pool-count, 0
	while constant-pool-index < constants-pool-count
		kind = take-next reader
		constant-pool-index +:= match kind
		as 1
			# CONSTANT_Utf8_info
			bytes = take-next-n reader, reader.take16
			# Java does not really use standard UTF8, but this shouldn't matter for method and type names
			constant-strings-builder[constant-pool-index] := safe-reinterpret-cast bytes
			1
		as 3
			# CONSTANT_Integer_info
			skip-next-n reader, 4
			1
		as 4
			# CONSTANT_Float_info
			skip-next-n reader, 4
			1
		as 5
			# CONSTANT_Long_info
			skip-next-n reader, 8
			2
		as 6
			# CONSTANT_Double_info
			skip-next-n reader, 8
			2
		as 7
			# CONSTANT_Class_info
			constant-classes[constant-pool-index] := take16 reader
			1
		as 8
			# CONSTANT_String_info
			skip-next-n reader, 2
			1
		as 9
			# CONSTANT_Fieldref_info
			skip-next-n reader, 4
			1
		as 10
			# CONSTANT_Methodref_info
			skip-next-n reader, 4
			1
		as 11
			# CONSTANT_InterfaceMethodref_info
			skip-next-n reader, 4
			1
		as 12
			# CONSTANT_NameAndType_info
			skip-next-n reader, 4
			1
		as 15
			# CONSTANT_MethodHandle_info
			skip-next-n reader, 3
			1
		as 16
			# CONSTANT_MethodType_info
			skip-next-n reader, 2
			1
		as 18
			# CONSTANT_InvokeDynamic_info
			skip-next-n reader, 4
			1
		else
			log-error "Unexpected constant kind {kind}"
			throw todo
	constant-pool-index is constants-pool-count
	constant-strings: trusted cast-immutable constant-strings-builder
	constant-classes: for x in constant-classes
		if x == 0
			as-path ""
		else
			as-path constant-strings-builder[x]
