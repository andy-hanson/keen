name-range source-range(a type-decl-source)
	match a
	as type-decl-ast
		a.name-range
	as type-decl-source-java
		()
	as type-decl-source-bogus
		()
can-have-type-params bool(a type-decl-source)
	match a
	as type-decl-ast
		a.can-have-type-params
	as type-decl-source-java
		true
	as type-decl-source-bogus
		false
can-have-type-params bool(a type-decl-ast)
	match a.body
	as builtin-type-ast
		true
	as enum-ast
		false
	as flags-ast
		false
	as record-ast
		true
	as sum-type-ast
		true

type-inst record force-data, -new
	decl type-decl
	type-args type-args
	hash nat32
	| Set of types that can implicitly convert to this.
	| This will be missing when the set can't be determined.
	| This is the case for interfaces and variants, and for {bool} since every option type converts to it.
	| We also don't bother to fill this in for {option} instances since that is easier to handle specially.
	| This will only be non-empty for unions, numeric types, {array-view} and {buffer-view}.
	narrow-types mut type-inst[]?
subscript type-inst(decl type-decl, type-arg type-inst)
	decl[type-arg::type-args]
subscript type-inst(decl type-decl, type-arg type)
	decl[as-type-args type-arg]
subscript type-inst(decl type-decl, type-args (type, type))
	decl[to-type-array (type-args.a, type-args.b)]
subscript type-inst(decl type-decl, type-args type-args)
	match insts = decl.insts
	as type-inst
		insts
	as object-memoizer
		trusted memoize insts, type-args, of
			hash = decl.hash ^ type-args.hash
			res type-inst = decl, type-args, hash, ()
			# If narrow-types aren't available on the decl yet,
			# they'll be filled in on the insts immediately after filling them in for the decl.
			if decl.narrow-types
				fill-narrow-types-for-type-inst res
			res

instantiate-type type(type type, type-args type-args)
	match type
	as bogus-type
		bogus-type
	as type-param-index
		type-args[type.index]
	as type-inst
		instantiate-type-inst type, type-args
instantiate-type-inst type-inst(type-inst type-inst, type-args type-args)
	do unless is-empty type-args else type-inst
	type-inst.decl[instantiate-type-args type-inst.type-args, type-args]
instantiate-type-args type-args(a type-args, type-args type-args)
	make-type-args a, {instantiate-type it, type-args}

memoizer-key type-args(a type-inst)
	a.type-args
== bool(a type-inst, b type-inst)
	trusted a 'reference-equal b
<=> comparison(a type-inst, b type-inst)
	do trusted
	res = a.decl <=> b.decl
	if res == equal
		a.type-args <=> b.type-args
	else
		res
hash void(a type-inst, state hash-state) = trusted hash a.hash, state
to json(a type-inst)
	if is-empty a.type-args
		a.decl.name.to
	else
		decl: a.decl.name.to
		type-args: a.type-args.to
mutability-range mutability-range(a type-inst)
	res mut mutability-range = a.decl.mutability, a.decl.mutability
	for x in a.type-args
		res combine:= x.mutability-range
	res

