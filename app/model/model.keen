import
	keen/bits
	keen/col/enum-map
	keen/parse
	keen/string/unicode
	keen/unsafe
	../../lib/col/experimental/object-memoizer
	../util/by-key
	../util/util
	./ast
	./parse-diag
	./source-range
	./uri

mutability-range record(best-case mutability, worst-case mutability)

-combine mutability-range(a mutability-range, b mutability-range)
	best-case: max a.best-case, b.best-case
	worst-case: max a.worst-case, b.worst-case

is-always-compatible bool(referencer mutability, referenced mutability-range)
	referenced.worst-case <= referencer
is-possibly-compatible bool(referencer mutability, referenced mutability-range)
	referenced.best-case <= referencer

max-type-params nat32()
	8

-type-arrays global((type-array, type-array-key) object-memoizer) = ()
-type-params-type-args global(type-args[])
	for n nat32 in 0 .. max-type-params + 1
		to-type-args for i nat32 in 0 .. n then (i,)::type-param-index
-spec-arrays global((specs, specs-key) object-memoizer) = ()

| This should only be called if there is nothing from the 'model' alive any more.
clear-object-memoizers void() global, unsafe
	type-arrays := ()
	spec-arrays := ()

to-type-array type-array(types type[])
	hash nat32 = wrap-to deterministic-hash types
	trusted memoize type-arrays, (types, hash), {types, hash}
type-array record
	inner type[]
	hash nat32
-type-array-key record
	inner type[]
	hash nat32
- == bool(a type-array-key, b type-array-key)
	trusted a.inner == b.inner
-memoizer-key type-array-key(a type-array)
	a.inner, a.hash
size nat32(a type-array)
	a.inner.size
subscript type(a type-array, index nat32)
	a.inner[index]
subscript type(a type-array, index index-relative-to-end)
	a.inner[index]
subscript type array-view(a type-array, indices range-relative-to-end)
	a.inner[indices]
some bool(a type-array, f bool mut(a type)) = some a.inner, f
hash void(a type-array, state hash-state)
	trusted hash a.hash, state
to json(a type-array)
	a.inner.to
-type-params-type-args type-args(n nat32)
	trusted type-params-type-args[n]

type-params alias
	name-and-range[]
| No type args, one type arg, or many type args.
| This is more efficient than always allocating an array, since most types have <= 1 type args.
# TODO: I'd like to just use `no-type-args, type, type-array`.
# But currently unions-of-unions have inefficient representation.
type-args union(no-type-args, bogus-type, type-param-index, type-inst, type-array)
-type type?(a type-args)
	match a
	as no-type-args then ()
	as bogus-type then a
	as type-param-index then a
	as type-inst then a
	as type-array then ()
as-type-args type-args(a type)
	match a
	as bogus-type then a
	as type-param-index then a
	as type-inst then a
hash nat32(a type-args)
	trusted match a
	as no-type-args
		0
	as bogus-type
		0
	as type-param-index
		a.index
	as type-inst
		a.hash
	as type-array
		a.hash
hash void(a type-args, state hash-state)
	trusted hash a.hash, state
to json(a type-args)
	match a
	as no-type-args
		null
	as bogus-type
		a.to
	as type-param-index
		a.to
	as type-inst
		a.to
	as type-array
		a.to
no-type-args record
new type-args()
	no-type-args
make-type-args[col, elem] type-args(inputs col, f type mut(x elem)) (col, elem) some, col size
	match inputs.size
	as 0
		()
	as 1
		as-type-args f[first! inputs]
	else
		to-type-array map inputs, f
| Most code should avoid calling this as it means allocating an array
slow-to-array type[](a type-args)
	match a
	as no-type-args
		()
	as bogus-type
		- a
	as type-param-index
		- a
	as type-inst
		- a
	as type-array
		a.inner
to-type-args type-args(a type[])
	match a.size
	as 0
		()
	as 1
		as-type-args a[0]
	else
		to-type-array a
== bool(a type-args, b type-args)
	trusted a 'reference-equal b
is-empty bool(a type-args)
	a.no-type-args
subscript type(a type-args, index nat32)
	match a
	as no-type-args
		throw unreachable
	as bogus-type
		index is 0
		a
	as type-param-index
		index is 0
		a
	as type-inst
		index is 0
		a
	as type-array
		a[index]
last type?(a type-args)
	match a
	as no-type-args
		()
	as bogus-type
		a
	as type-param-index
		a
	as type-inst
		a
	as type-array
		a[end - 1]
map-every-type-args[col, elem] type-args?
	a col
	f type? mut(x elem)
do (col, elem) array-like, (col, elem) some
	match a.size
	as 0
		no-type-args
	as 1
		?as-type-args f[a[0]]
	else
		if res type[] = map-every a, f
			to-type-array res
zip-every-type-args bool(a type-args, b type-args, f bool mut(x type, y type))
	match a
	as no-type-args
		assert b.no-type-args
		true
	as bogus-type
		f[a, b.type!]
	as type-param-index
		f[a, b.type!]
	as type-inst
		f[a, b.type!]
	as type-array
		every (zip a.inner, b.type-array!.inner), f
some bool(a type-args, f bool mut(x type))
	match a
	as no-type-args
		false
	as bogus-type
		f[a]
	as type-param-index
		f[a]
	as type-inst
		f[a]
	as type-array
		some a.inner, f
size nat32(a type-args)
	match a
	as no-type-args
		0
	as bogus-type
		1
	as type-param-index
		1
	as type-inst
		1
	as type-array
		a.inner.size
~ ~ type-args(a type-args, x type)
	to-type-args a.slow-to-array ~ x

return-and-param-types record
	return-and-param-types type-array
map return-and-param-types(a return-and-param-types, f type mut(x type))
	make-return-and-param-types map a.return-and-param-types, f
make-return-and-param-types[t] return-and-param-types(return-type type, params t array-view, f type mut(param t))
	make-return-and-param-types with out in build
		out ~= return-type
		for param in params
			out ~= f[param]
make-return-and-param-types return-and-param-types(types type[])
	return-and-param-types: to-type-array types
return-type type(a return-and-param-types)
	a.return-and-param-types[0]
param-types type array-view(a return-and-param-types)
	a.return-and-param-types[1 .. end]
hash-value nat32(a return-and-param-types)
	a.return-and-param-types.hash
# It doesn't seem to be worth memoizing these
spec-impls alias
	called[]
specs record -new
	inner spec-or-type-inst[]
	hash nat32
	all-builtin (builtin-spec, type-args)[]
	all-contexts type-args
	instantiated-sigs called-spec-sig[]
to json(a specs)
	a.inner.to
new specs()
	(), 0, (), (), ()
is-empty bool(a specs)
	trusted a 'reference-equal ()
-specs-key record
	inner spec-or-type-inst[]
	hash nat32
- == bool(a specs-key, b specs-key)
	trusted a.inner == b.inner
-memoizer-key specs-key(a specs)
	a.inner, a.hash
get-or-add-specs specs(specs spec-or-type-inst[])
	do unless is-empty specs
	hash nat32 = wrap-to deterministic-hash specs
	trusted memoize spec-arrays, (specs, hash), of
		inner: specs
		hash: hash
		all-builtin: for* x in specs
			if x.spec-inst
				x.builtin_
		all-contexts: to-type-args for* x in specs
			match x
			as spec-inst
				x.all-contexts.slow-to-array
			as type-inst
				- x
		instantiated-sigs:
			index mut nat32 = 0
			for* x in specs
				do if x.spec-inst
				for sig, sig-type in zip x.all-sigs, x.sig-types
					res called-spec-sig = index, x.decl, sig, sig-type
					index +:= 1
					res
~ ~ specs(a specs, type type-inst)
	get-or-add-specs a.inner ~ type
is-global bool(a specs)
	some a.all-builtin, it.a == global_
is-unsafe bool(a specs)
	some a.all-builtin, it.a == unsafe
has-build-target bool(a specs, value build-target)
	some a.all-builtin, it.a == value.to

type union(bogus-type, type-param-index, type-inst)
	hash void(state hash-state)
	to json()
== bool(a type, b type)
	trusted a 'reference-equal b
bogus-type record
to json(_ bogus-type) = "bogus"
| Represent type parameter as the index, so we don't generate different types for every 't[]'.
| (These are disambiguated in the type checker using 'type-and-context')
type-param-index record
	-index_ nat32
	# This is needed to force this type to be wrapped and not use 'nat32' directly.
	-dummy nat32
index nat32(a type-param-index)
	a.index_
new type-param-index(index nat32)
	# This silly-looking code ensures that each type-param-index value is a compile-time constant,
	# avoiding runtime allocation.
	match index
	as 0
		0, 0
	as 1
		1, 1
	as 2
		2, 2
	as 3
		3, 3
	as 4
		4, 4
	as 5
		5, 5
	as 6
		6, 6
	as 7
		7, 7
	as 8
		8, 8
	as 9
		9, 9
	as 10
		10, 10
	as 11
		11, 11
	as 12
		12, 12
	as 13
		13, 13
	as 14
		14, 15
	as 15
		15, 15
	else
		throw unreachable
type-param-index type-param-index(index nat32)
	index,
== bool(a type-param-index, b type-param-index)
	trusted a 'reference-equal b
<=> comparison(a type-param-index, b type-param-index)
	trusted a.index <=> b.index
hash void(a type-param-index, state hash-state)
	trusted hash a.index, state
to json(a type-param-index) = a.index.to
to type-param-index(_ json) = throw not-implemented

is-bogus bool(a type)
	a.bogus-type

as-array-or-buffer type?(a type)
	as-array a or as-buffer a
as-array type?(a type)
	if is-builtin-type a, array
		only a.type-inst!.type-args
as-buffer type?(a type)
	if is-builtin-type a, buffer
		only a.type-inst!.type-args

is-tuple bool(a type) common-types
	a.type-inst and is-tuple a.decl
is-tuple bool(a type-decl) common-types
	(tuple a.n-type-params) == a

as-tuple type-args?(type type) common-types
	if is-tuple type
		type.type-inst!.type-args

is-bool bool(a type)
	is-builtin-type a, bool
is-char8 bool(a type)
	is-builtin-type a, char8
is-char32 bool(a type)
	is-builtin-type a, char32
is-float32 bool(a type)
	is-builtin-type a, float32
is-float64 bool(a type)
	is-builtin-type a, float64
is-int64 bool(a type)
	is-builtin-type a, int64
is-js-any bool(a type)
	is-builtin-type a, js-any
is-nat32 bool(a type)
	is-builtin-type a, nat32
is-nat64 bool(a type)
	is-builtin-type a, nat64
is-void bool(a type)
	is-builtin-type a, void
is-weak-ref bool(a type)
	is-builtin-type a, weak-ref

as-nat-type nat-type?(a type)
	a.as-builtin-type.?to
as-int-type int-type?(a type)
	a.as-builtin-type.?to
as-float-type float-type?(a type)
	a.as-builtin-type.?to
as-integral-type integral-type?(a type)
	a.as-builtin-type.?to

-is-builtin-type bool(a type, builtin_ builtin-type)
	a.type-inst and is-builtin-type a, builtin_
-is-builtin-type bool(a type-inst, builtin_ builtin-type)
	is-builtin-type a.decl, builtin_
-is-builtin-type bool(a type-decl, builtin_ builtin-type)
	a.body.builtin-type == builtin_
as-builtin-type builtin-type?(a type)
	if a.type-inst
		a.decl.body.builtin-type


unwrap-option-allow-bogus type?(a type)
	if is-bogus a
		a
	else
		unwrap-option a
unwrap-if-option-type type(a type)
	unwrap-option a else a
unwrap-option-or-same type(a type)
	unwrap-option-allow-bogus a else a
unwrap-option type?(a type)
	a.type-inst.?unwrap-option
unwrap-option type?(a type-inst)
	if is-option a
		only a.type-args

is-option bool(a type)
	is-builtin-type a, option
is-option bool(a type-inst)
	is-builtin-type a, option
is-option bool(a type-decl)
	is-builtin-type a, option

as-lambda-type mutability?(a type)
	if a.type-inst then as-lambda-type a
as-lambda-type mutability?(a type-inst)
	as-lambda-type a.decl
as-lambda-type mutability?(a type-decl)
	a.body.builtin-type.?as-lambda-type

mutability-range mutability-range(a type)
	match a
	as bogus-type
		data_, data_
	as type-param-index
		data_, mut_
	as type-inst
		a.mutability-range

best-case-mutability mutability(a type)
	a.mutability-range.best-case
worst-case-mutability mutability(a type)
	a.mutability-range.worst-case

signature-container union(spec-decl, type-decl)
	module-uri uri()
to type-container(a signature-container)
	match a
	as spec-decl then a
	as type-decl then a

signature-source union(signature-ast, signature-source-java)
	name symbol()
	name-range source-range()
	range source-range()
signature-source-java record
	name symbol
range source-range(_ signature-source-java) = ()
name-range source-range(_ signature-source-java) = ()

| Function signature without a body. Used in a spec or variant.
signature record force-data
	container signature-container
	source signature-source
	name-and-arity name-and-arity
	return-type type
	params destructure[]
	doc-comment-references mut doc-comment-reference[]
== bool(a signature, b signature)
	trusted a.range == b.range
to json(a signature)
	a.name.to::json
name symbol(a signature)
	a.source.name
module-uri uri(a signature)
	a.container.module-uri
range uri-and-range(a signature)
	a.module-uri, a.source.range
name-range uri-and-range(a signature)
	a.module-uri, a.source.name-range
doc-comment-ast doc-comment-ast(a signature)
	match source = a.source
	as signature-ast
		source.doc-comment
	as signature-source-java
		()
doc-comment doc-comment(a signature)
	a.doc-comment-ast, a.doc-comment-references
index-of-signature nat32(a signature)
	match container = a.container
	as spec-decl
		index-of! container.sigs, a
	as type-decl
		index-of! container.body.sum-type!.methods, a

record-field-source union(single-destructure-ast, record-field-ast)
	doc-comment doc-comment-ast()
	range source-range()
	name-range source-range()
name symbol(a record-field-source)
	match a
	as single-destructure-ast
		a.name.name
	as record-field-ast
		a.name.name

record-field record force-data
	source record-field-source
	containing-record type-decl
	visibility visibility
	mutability visibility?
	type type
	doc-comment-references mut doc-comment-reference[]
== bool(a record-field, b record-field)
	trusted a 'reference-equal b
to json(a record-field)
	a.name.to::json
module-uri uri(a record-field)
	a.containing-record.module-uri
name symbol(a record-field)
	a.source.name
range uri-and-range(a record-field)
	a.containing-record.module-uri, a.source.range
name-range uri-and-range(a record-field)
	a.module-uri, a.source.name-range
doc-comment-ast doc-comment-ast(a record-field)
	a.source.doc-comment
doc-comment doc-comment(a record-field)
	a.doc-comment-ast, a.doc-comment-references

enum-member-source union(enum-or-flags-member-ast, name-and-range)
	range source-range()
	name symbol()
== bool(a enum-member-source, b enum-member-source)
	trusted a.range == b.range
doc-comment doc-comment-ast(a enum-member-source)
	if a.enum-or-flags-member-ast
		a.doc-comment
name-range source-range(a enum-member-source)
	match a
	as enum-or-flags-member-ast
		a.name-range
	as name-and-range
		a.range

enum-member alias
	enum-or-flags-member
enum-or-flags-member record force-data
	source enum-member-source
	containing-enum type-decl
	value nat64
	doc-comment-references mut doc-comment-reference[]
== bool(a enum-or-flags-member, b enum-or-flags-member)
	trusted a.source == b.source
<=> comparison(a enum-or-flags-member, b enum-or-flags-member)
	trusted a.range <=> b.range
hash void(a enum-or-flags-member, state hash-state)
	trusted hash a.name, state
to json(a enum-or-flags-member)
	a.source.name.to
module-uri uri(a enum-or-flags-member)
	a.containing-enum.module-uri
name symbol(a enum-or-flags-member)
	a.source.name
key symbol(a enum-or-flags-member) = a.name
range uri-and-range(a enum-or-flags-member)
	a.containing-enum.module-uri, a.source.range
name-range uri-and-range(a enum-or-flags-member)
	a.module-uri, a.source.name-range
doc-comment-ast doc-comment-ast(a enum-or-flags-member)
	a.source.doc-comment
doc-comment doc-comment(a enum-or-flags-member)
	a.doc-comment-ast, a.doc-comment-references

type-body union
	type-body-bogus
	builtin-type
	enum_
	flags_
	java-class
	record_
	sum-type
type-body-bogus record
enum_ record
	| Inferred type big enough to store all members
	storage nat-type
	| Always sorted by value
	members enum-or-flags-member[]
	members-by-key (symbol, enum-or-flags-member) by-key
to json(a enum_)
	storage: a.storage.to
	members: a.members.to
| A Java interface is a {sum-type} instead.
java-class record force-data
	super-class mut type-inst?
flags_ record
	| Inferred type big enough to store all members
	storage nat-type
	| Always sorted by value
	members enum-or-flags-member[]
record_ record
	new-visibility visibility
	fields record-field[]
| interface, union, or variant
sum-type record
	kind sum-type-kind
	listed-members sum-type-case-and-method-impls[]
	methods signature[]
as-union sum-type-case-and-method-impls[]?(a type-body)
	?as-union a.sum-type
as-union sum-type-case-and-method-impls[]?(a sum-type)
	if a.kind == union_
		a.listed-members

get-all-flags-value nat64(body flags_)
	res mut = 0
	for member in body.members
		res |:= member.value
	res

builtin-type enum
	array
	bool
	buffer
	char8
	char16
	char32
	float32
	float64
	int8
	int16
	int32
	int64
	js-any
	lambda-data
	lambda-mut
	lambda-shared
	nat8
	nat16
	nat32
	nat64
	option
	void
	weak-ref
is-char-or-integral bool(a builtin-type)
	a.to::char-or-integral-type?
is-char-or-integral bool(a type)
	(b = a.as-builtin-type) and b.is-char-or-integral
to char-or-integral-type?(a builtin-type)
	a.to::char-type? or a.to::integral-type?
to char-type?(a builtin-type)
	match a
	as char8 then char8
	as char16 then char16
	as char32 then char32
	else then ()
to float-type?(a builtin-type)
	match a
	as float32
		float32
	as float64
		float64
	else
		()
to nat-type?(a builtin-type)
	match a
	as nat8
		nat8
	as nat16
		nat16
	as nat32
		nat32
	as nat64
		nat64
	else
		()
to int-type?(a builtin-type)
	match a
	as int8
		int8
	as int16
		int16
	as int32
		int32
	as int64
		int64
	else
		()
to integral-type?(a builtin-type)
	match a
	as int8
		int8
	as int16
		int16
	as int32
		int32
	as int64
		int64
	as nat8
		nat8
	as nat16
		nat16
	as nat32
		nat32
	as nat64
		nat64
	else
		()
as-lambda-type mutability?(a builtin-type)
	match a
	as lambda-data
		data_
	as lambda-shared
		shared_
	as lambda-mut
		mut_
	else
		()

type-alias record force-data
	hash nat32
	ast type-alias-ast
	module-uri uri
	visibility visibility
	doc-comment-references mut doc-comment-reference[]
	late-target mut type-inst?
== bool(a type-alias, b type-alias)
	trusted a 'reference-equal b
to json(a type-alias)
	a.name.to
target type-inst(a type-alias)
	a.late-target!
set-target void(a type-alias, value type-inst)
	forbid a.late-target
	a.late-target := value
doc-comment-ast doc-comment-ast(a type-alias)
	a.ast.doc-comment
doc-comment doc-comment(a type-alias)
	a.doc-comment-ast, a.doc-comment-references
name symbol(a type-alias)
	a.ast.name.name
n-type-params nat8(_ type-alias)
	0
type-params type-params(_ type-alias)
	()
range uri-and-range(a type-alias)
	a.module-uri, a.ast.range
name-range uri-and-range(a type-alias)
	a.module-uri, a.ast.name-range

type-decl record force-data
	hash nat32
	source type-decl-source
	visibility visibility
	n-type-params nat8
	| Can only contain 'global', 'js', 'java'
	late-specs mut specs?
	| Warn: mutability on the decl does not take type args into account
	mutability mutability
	mutability-is-forced bool
	sum-type-cases mut sum-type-case[]
	| Set of types that can implicitly convert to this.
	| This includes chainsed conversions;
	| if you have a union including {nat}, then {nat8} will be included in {narrow-types}.
	| This will be missing when the set can't be determined.
	| That is the case for interfaces and variants, and for {option} whose narrow types depend on the type argument.
	| This will only be non-empty for unions, numeric types, {array-view} and {buffer-view}.
	| Note: There are also narrow-types on the {type-inst}.
	narrow-types mut type-decl[]?
	body mut type-body
	-insts mut type-insts
	doc-comment-references mut doc-comment-reference[]
type-params type-params(a type-decl)
	if a.source.type-params.size == a.n-type-params
		a.source.type-params
	else
		# Type params were declared but are not allowed on this kind of type
		a.n-type-params is 0
		()
| For a non-template, this will be its only {type-inst}
-type-insts union mut
	type-inst
	(type-inst, type-args) object-memoizer
to-json-with-body json(a type-decl)
	source: a.source.to
	visibility: a.visibility.to
	specs: a.specs.to
	mutability: a.mutability.to
	mutability-is-forced: a.mutability-is-forced.to
	doc-comment-references: a.doc-comment-references.to
	sum-type-cases: a.sum-type-cases.to
	body: a.body.to
to json(a type-decl)
	a.name.to::json
to type-decl(_ json) = throw not-implemented
only-inst type-inst(a type-decl)
	forbid is-template a
	type-inst! a.insts
new type-decl
	hash nat32
	source type-decl-source
	visibility visibility
	specs specs
	mutability mutability
	mutability-is-forced bool
	doc-comment-references doc-comment-reference[]
	sum-type-cases sum-type-case[]
	body type-body
do
	res type-decl =
		hash: hash
		source: source
		visibility: visibility
		mutability: mutability
		mutability-is-forced: mutability-is-forced
		doc-comment-references: doc-comment-references
		sum-type-cases: sum-type-cases
		body: body
	res.specs := specs
	res
new type-decl
	hash nat32
	source type-decl-source
	visibility visibility
	mutability mutability
	mutability-is-forced bool
	doc-comment-references doc-comment-reference[]
	sum-type-cases sum-type-case[]
	body type-body
do
	res type-decl =
		hash: hash
		source: source
		visibility: visibility
		n-type-params: if can-have-type-params source
			source.type-params.size.to
		late-specs: ()
		mutability: mutability
		mutability-is-forced: mutability-is-forced
		sum-type-cases: sum-type-cases
		narrow-types: ()
		body: body
		insts: ()
		doc-comment-references: doc-comment-references
	res.insts := if res.is-template
		()::((type-inst, type-args) object-memoizer)
	else
		(res, (), res.hash, ())::type-inst
	res
== bool(a type-decl, b type-decl)
	trusted a 'reference-equal b
<=> comparison(a type-decl, b type-decl)
	trusted a.range <=> b.range
hash void(a type-decl, state hash-state)
	trusted hash a.hash, state
doc-comment-ast doc-comment-ast(a type-decl)
	a.source.doc-comment
doc-comment doc-comment(a type-decl)
	a.doc-comment-ast, a.doc-comment-references
name symbol(a type-decl)
	a.source.name
module-uri uri(a type-decl)
	a.source.module-uri
range uri-and-range(a type-decl)
	a.module-uri, a.source.range
keyword-range uri-and-range(a type-decl)
	a.module-uri, a.source.keyword-range
name-range uri-and-range(a type-decl)
	a.module-uri, a.source.name-range
is-template bool(a type-decl)
	a.n-type-params != 0
| Given a type `foo[t, u], this is the type `(t, u) foo`.
instantiated-with-own-type-params type-inst(a type-decl)
	match x = a.insts
	as type-inst
		x
	as object-memoizer
		a[a.n-type-params.type-params-type-args]

fill-narrow-types-for-type-decl void(depth nat32, type type-decl, on-cycle void mut(type type-decl)) common-types
	forbid type.narrow-types
	match body = type.body
	as builtin-type
		init-narrow-types type, builtin-narrow-types body
	as sum-type
		do if body.kind == union_
		res type-decl[] = with out in build
			if depth == 0
				type.body := sum-type body.kind, (), body.methods
				on-cycle[type]
			else
				for member in body.listed-members
					case-type = member.case-type.decl
					out ~= case-type
					its-narrow-types = case-type.narrow-types else
						fill-narrow-types-for-type-decl depth - 1, case-type, on-cycle
						case-type.narrow-types else (case-type,)
					out ~~= its-narrow-types
		unless type.narrow-types # In the case of a cycle, this might have been filled in by a recursive call.
			init-narrow-types type, res
	else
		init-narrow-types type, if type == array-view
			array::type-decl,
		elif type == buffer-view
			buffer,
		else
			()::type-decl[]

-builtin-narrow-types type-decl[](body builtin-type) common-types
	match body
	as array then ()
	as bool then option,
	as buffer then ()
	as char8 then ()
	as char16 then ()
	as char32 then ()
	as float32 then ()
	as float64 then float32.decl,
	as int8 then ()
	as int16 then int8.decl,
	as int32 then int8.decl, int16.decl
	as int64 then int8.decl, int16.decl, int32.decl
	as js-any then ()
	as lambda-data then ()
	as lambda-mut then ()
	as lambda-shared then ()
	as nat8 then ()
	as nat16 then nat8.decl,
	as nat32 then nat8.decl, nat16.decl
	as nat64 then nat8.decl, nat16.decl, nat32.decl
	as option then () # Option narrowed type is the type argument, can't be determined by the decl
	as void then ()
	as weak-ref then ()

-fill-narrow-types-for-type-inst void(type type-inst)
	forbid type.narrow-types
	match body = type.decl.body
	as builtin-type
		match body
		as bool
			# Every option is a narrow type of bool. We can't list them all, so omit.
			()
		as option
			# We don't bother for options, they will just be handled specially.
			()
		else
			type.narrow-types := map type.decl.narrow-types!, it.only-inst
	as sum-type
		do if body.kind == union_
		type.narrow-types := with out in build
			for member in body.listed-members
				case-type = instantiate-type-inst member.case-type, type.type-args
				unless case-type.narrow-types
					fill-narrow-types-for-type-inst case-type
				out ~= case-type
				if n = case-type.narrow-types then out ~~= n
	else
		# Only array-view and buffer-view have narrow-types here
		type.narrow-types := map type.decl.narrow-types!, it[type.type-args]

-init-narrow-types void(type type-decl, value type-decl[])
	forbid type.narrow-types
	type.narrow-types := value
	match insts = type.insts
	as type-inst
		fill-narrow-types-for-type-inst insts
	as object-memoizer
		trusted each insts, of x
			fill-narrow-types-for-type-inst x

is-data bool(a type-decl)
	a.mutability == data_

specs specs(a type-decl)
	a.late-specs!
set-specs void(a type-decl, value specs)
	forbid a.late-specs
	a.late-specs := value

must-be-enum-or-flags-storage nat-type(a type-decl)
	match body = a.body
	as enum_
		body.storage
	as flags_
		body.storage
	else
		throw unreachable
must-be-enum-or-flags enum-or-flags-member[](a type-decl)
	match body = a.body
	as enum_
		body.members
	as flags_
		body.members
	else
		throw unreachable

sum-type-case-and-method-impls record force-data
	case-type type-inst
	method-impls mut fun-inst?[]

sum-type-case record force-data
	ast modifier-keyword-ast?
	sum-type type-inst
	method-impls mut fun-inst?[]
to json(a sum-type-case)
	sum-type: a.sum-type.to
	method-impls: a.method-impls.to
sum-type-body sum-type(a sum-type-case)
	a.sum-type.decl.body.sum-type!
sum-type-decl-methods signature[](a sum-type-case)
	a.sum-type-body.methods

type-decl-source union(type-decl-ast, type-decl-source-java, type-decl-source-bogus)
	module-uri uri()
	type-params type-params()
to json(a type-decl-source)
	match a
	as type-decl-ast
		"ast"
	as type-decl-source-java
		a.to
	as type-decl-source-bogus
		"bogus"
type-decl-source-java record(module-uri uri, name symbol, type-params name-and-range[])
class-path path(a type-decl-source-java) = a.module-uri.as-jar-and-class-uri!.class-path-excluding-extension
type-decl-source-bogus record(module-uri uri, name symbol, type-params type-params)
range source-range(a type-decl-source)
	match a
	as type-decl-ast
		a.range
	as type-decl-source-java
		()
	as type-decl-source-bogus
		()
name symbol(a type-decl-source)
	match a
	as type-decl-ast
		a.name.name
	as type-decl-source-java
		a.name
	as type-decl-source-bogus
		a.name
doc-comment doc-comment-ast(a type-decl-source)
	match a
	as type-decl-ast
		a.doc-comment
	as type-decl-source-java
		()
	as type-decl-source-bogus
		()
keyword-range source-range(a type-decl-source)
	match a
	as type-decl-ast
		a.keyword-range
	as type-decl-source-java
