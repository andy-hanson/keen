fun-decl record force-data, -new
	hash nat32
	visibility visibility
	name-and-arity name-and-arity
	n-type-params nat8
	return-and-param-types mut return-and-param-types
	params mut destructure[]
	specs mut specs
	doc-comment-references mut doc-comment-reference[]
	body mut fun-body
	insts mut fun-decl-insts
name symbol(a fun-decl) = a.name-and-arity.name
return-type type(a fun-decl) = a.return-and-param-types.return-type
param-types type array-view(a fun-decl) = a.return-and-param-types.param-types
to json(a fun-decl)
	visibility: a.visibility.to
	name: a.name.to
	n-type-params: a.n-type-params.to
	return-type: a.return-type.to
	params: a.params.to
	specs: a.specs.to
	doc-comment-references: a.doc-comment-references.to
	body: a.body.to
| Used by {funs-map}
-key symbol(a fun-decl) = a.name
-key name-and-arity(a fun-decl) = a.name-and-arity
-key return-and-param-types(a fun-decl) = a.return-and-param-types
-key type-decl(a fun-decl) = a.return-type.type-inst!.decl
-hash-value nat32(a type-decl) = a.hash
| Used by {funs-set}
-key arg0-type-decl(a fun-decl) = decl: a.params[0].type.type-inst!.decl
-arg0-type-decl record(decl type-decl)
-hash-value nat32(a arg0-type-decl) = a.decl.hash

| For a non-template, this will be its only {fun-inst}.
fun-decl-insts union(fun-inst, (fun-inst, fun-inst-key) object-memoizer) mut
unfinished-fun-decl fun-decl
	hash nat32
	visibility visibility
	name-and-arity name-and-arity
	type-params type-params
	range uri-and-range
	specs specs
do
	hash: hash
	visibility: visibility
	name-and-arity: name-and-arity
	n-type-params: type-params.size.to
	return-and-param-types: trusted gc-safe-value
	params: ()
	specs: specs
	doc-comment-references: ()
	body: fun-body-uninitialized range.uri, range.range
	insts: trusted gc-safe-value
fill-in-fun-types void(fun fun-decl, return-type type, params destructure[])
	fun.params := params
	fun.return-and-param-types := make-return-and-param-types return-type, params, it.type
	fun.insts := if is-template fun
		:: (fun-inst, fun-inst-key) object-memoizer
	else
		:: fun-inst
		fun, (), fun.specs, (), fun.return-and-param-types
new fun-decl
	hash nat32
	visibility visibility
	return-type type
	params destructure[]
	specs specs
	body fun-body
do
	name-and-arity = get-name-and-arity (fun-name body, return-type), params.size
	fun = unfinished-fun-decl hash, visibility, name-and-arity, body.type-params, body.range, specs
	fill-in-fun-types fun, return-type, params
	fun.body := body
	fun
| WARN: For this to work, none of the {fun-inst}s can be referenced.
update-fun-specs-and-reset-insts void(a fun-decl, specs specs)
	a.insts := ()::((fun-inst, fun-inst-key) object-memoizer)
	a.specs := specs
contexts type-args(a fun-decl)
	a.specs.all-contexts
== bool(a fun-decl, b fun-decl)
	trusted a 'reference-equal b
<=> comparison(a fun-decl, b fun-decl)
	trusted a.range <=> b.range
hash void(a fun-decl, state hash-state)
	trusted hash a.hash, state
type-params type-params(a fun-decl)
	a.body.type-params
module-uri uri(a fun-decl)
	a.body.module-uri
range uri-and-range(a fun-decl)
	a.body.range
name-range uri-and-range(a fun-decl)
	a.body.name-range
doc-comment-ast doc-comment-ast(a fun-decl)
	a.body.doc-comment-ast
doc-comment doc-comment(a fun-decl)
	a.doc-comment-ast, a.doc-comment-references
is-template bool(a fun-decl)
	a.n-type-params != 0 or not is-empty a.specs.instantiated-sigs
arity nat32(a fun-decl)
	a.params.size
only-inst fun-inst(a fun-decl)
	forbid is-template a
	fun-inst! a.insts

test_ record force-data
	hash nat32
	ast test-ast
	module-uri uri
	| Tests can't have spec-impls, so this iss limited to builtin specs like 'global', 'java', 'js'
	specs specs
	body mut expr-maybe-allocated-locals
	doc-comment-references mut doc-comment-reference[]
== bool(a test_, b test_)
	trusted a 'reference-equal b
to json(a test_)
	specs: a.specs.to
	body: a.body.to
	doc-comment-references: a.doc-comment-references.to
doc-comment-ast doc-comment-ast(a test_)
	a.ast.doc-comment
doc-comment doc-comment(a test_)
	a.doc-comment-ast, a.doc-comment-references
range uri-and-range(a test_)
	a.module-uri, a.ast.range
name symbol(_ test_)
	"test"
name-range uri-and-range(a test_)
	a.module-uri, a.ast.keyword-range
n-type-params nat8(_ test_)
	0
type-params type-params(_ test_)
	()
visibility visibility(_ test_)
	private

expr-container union(fun-decl, test_, var-decl)
	doc-comment doc-comment()
to type-container(a expr-container)
	match a
	as fun-decl then a
	as test_ then a
	as var-decl then a
specs specs(a expr-container) common-types
