is-empty bool(a program-with-opt-main-diagnostics)
	not some a, {true}
some bool(a program-with-opt-main-diagnostics, f bool mut(x uri-and-diagnostic))
	some a.program.main-fun-diagnostics, f or some a.program.program.diagnostics, f

program-diagnostics record(program program)
diagnostics program-diagnostics(a program)
	a,
is-empty bool(a program-diagnostics)
	not some a, {true}
some bool(a program-diagnostics, f bool mut(x uri-and-diagnostic))
	some a.program.additional-diagnostics, f or
	some-diagnostic-in-configs a.program, f or
	some-diagnostic-in-modules a.program, f
-some-diagnostic-in-configs bool(a program, f bool mut(x uri-and-diagnostic))
	some a.all-configs, of _, config
		some config.diagnostics, {f[config.config-uri!, it]}
-some-diagnostic-in-modules bool(a program, f bool mut(x uri-and-diagnostic))
	some a.keen-modules, of _, module
		some module.ast.parse-diagnostics, {f[(module.uri, it.range), it.kind]} or
		some module.check-diagnostics, {f[module.uri, it]}

tests record(program program, selector test-selector, target build-target)
size nat32(a tests)
	sum a, {1}
some bool(a tests, f bool mut(x test_))
	match selector = a.selector
	as test-selector-all
		some a.program.keen-modules, of _, m
			some m.tests, {can-include-test it, a.target and f[it]}
	as test-selector-some
		some a.program.keen-modules, of _, m
			selector[m.uri] and some m.tests, {can-include-test it, a.target and f[it]}
	as test_
		assert can-include-test selector, a.target
		f[selector]

-can-include-test bool(a test_, target build-target)
	specs-allow-target a.specs, target

-specs-allow-target bool(a specs, target build-target)
	every a.all-builtin, of b, _
		match b
		as data_
			throw todo
		as global_
			true
		as java
			target == java
		as js
			target == js
		as shared_
			throw todo
		as unsafe
			true

config record
	| Empty only for {default-config}
	config-uri uri?
	diagnostics diagnostic[]
	line-and-column-getter line-and-column-getter
	imports config-imports
default-config config() = (), (), (), ()
is-default-config bool(a config) = not a.config-uri
config-for-diag config(uri uri, diag diag, range source-range, line-and-column-getter line-and-column-getter)
	config-uri: uri
	diagnostics:
		- range, diag
	line-and-column-getter: line-and-column-getter
	imports: ()

config-imports record
	imports configured-import[]
all-jar-files file-path[](a config-imports)
	for* x in a.imports
		if x.kind == jar
			- as-file-path! x.uri
configured-import record
	path-prefix path
	uri uri
	kind configured-import-kind
configured-import-kind enum(keen, jar)
new config-imports() = (),
subscript (configured-import, path)?(a config-imports, imported path)
	res mut (configured-import, path)? = ()
	for x in a.imports
		if path = try-remove-start imported, x.path-prefix
			if not res or is-ancestor-of res!.a.path-prefix, x.path-prefix
				res := x, path
	res

local-source union(catch-ast, it-scope-ast, name-and-range, single-destructure-ast, local-source-generated)
local-source-generated record(name symbol)

local record force-data
	source local-source
	type type
== bool(a local, b local)
	trusted a 'reference-equal b
<=> comparison(a local, b local)
	trusted a.range <=> b.range
hash void(a local, state hash-state)
	trusted hash a.name, state
to json(a local)
	a.name.to
name symbol(a local)
	match source = a.source
	as catch-ast
		source.name!.name
	as it-scope-ast
		"it"
	as name-and-range
		source.name
	as single-destructure-ast
		source.name.name
	as local-source-generated
		source.name
is-mutable bool(a local)
	source = a.source
	source.single-destructure-ast and source.mut_
local-must-have-name-range source-range(a local)
	match source = a.source
	as catch-ast
		source.name!.range
	as it-scope-ast
		it-range source
	as name-and-range
		source.range
	as single-destructure-ast
		source.name-range
	as local-source-generated
		throw unreachable
-local-must-have-range source-range(a local)
	match source = a.source
	as single-destructure-ast
		source.range
	else
		a.local-must-have-name-range

destructure union(destructure-ignore, local, destructure-split)
destructure-ignore record(source destructure-ignore-source, type type)
to json(a destructure-ignore)
	type: a.type.to
| {type-decl} only comes up from generated code.
| {void-destructure-ast} is treated as a 'destructure-ignore' in the model since it behaves the same as '_ void'.
destructure-ignore-source union(catch-ast, type-decl, ignore-destructure-ast, void-destructure-ast)
destructure-split record
	| This will be the type attempted to destructure.
	| If it can't be destructured, each of 'parts' will have a bogus type.
	destructured-type type
	parts destructure[]
is-valid-destructure bool(a destructure-split) common-types
	(types = as-tuple a.destructured-type) and types.size == a.parts.size

simple-destructure union(destructure-ignore, local)
	type type()
to destructure(a simple-destructure)
	match a
	as destructure-ignore then a
	as local then a

name symbol?(a destructure)
	match a
	as destructure-ignore
		()
	as local
		a.name
	as destructure-split
		()
range source-range(a destructure)
	match a
	as destructure-ignore
		match source = a.source
		as catch-ast
			()
		as type-decl
			()
		as ignore-destructure-ast
			source.range
		as void-destructure-ast
			source.range
	as local
		a.local-must-have-range
	as destructure-split
		a.parts[0].start, a.parts[end - 1].end
start pos(a destructure)
	a.range.start
end pos(a destructure)
	a.range.end
type type(a destructure)
	match a
	as destructure-ignore
		a.type
	as local
		a.type
	as destructure-split
		a.destructured-type
locals record(destructure destructure)
some bool(a locals, f bool mut(x local))
	match d = a.destructure
	as destructure-ignore
		()
	as local
		f[d]
	as destructure-split
		some d.parts, {some it.locals, f}

doc-comment record
	ast doc-comment-ast
	references doc-comment-reference[]
is-empty bool(a doc-comment)
	a.ast.is-empty
doc-comment-string string(uri uri, a doc-comment) file-content-getters
	unless is-empty a
		strip-doc-comment (the::file-content-getters)[uri, a.ast.range!]
-strip-doc-comment string(a string-view)
	# This filters out '| ' at the beginning of lines
	do with out in build
	iter = begin a
	do until is-at-end iter
	while x = peek iter and x == "|" or is-whitespace-non-newline x
		_ = take-next iter
	while x = peek iter and x != "\n"
		out ~= take-next iter
	unless is-at-end iter
		out ~= take-next iter

doc-comment-reference union
	doc-comment-reference-bogus
	doc-comment-reference-context
	called-spec-sig
	enum-or-flags-member
	fun-decl
	local
	record-field
	signature
	spec-decl
	type-alias
	type-decl
	type-param-index
	var-decl
doc-comment-reference-bogus record
doc-comment-reference-context record(type type-inst)
uri uri?(a doc-comment-reference)
	match a
	as doc-comment-reference-bogus
		()
	as doc-comment-reference-context
		a.type.decl.module-uri
	as called-spec-sig
		a.containing-spec.module-uri
	as enum-or-flags-member
		a.containing-enum.module-uri
	as fun-decl
		a.module-uri
	as local
		()
	as record-field
		a.containing-record.module-uri
	as signature
		a.container.module-uri
	as spec-decl
		a.module-uri
	as type-alias
		a.module-uri
	as type-decl
		a.module-uri
	as type-param-index
		()
	as var-decl
		a.module-uri

expr union
	assert-or-forbid-expr
	bogus-call-expr
	bogus-expr
	bogus-wrong-type-expr
	call-expr
	call-named-new-expr
	call-option-expr
	finally-expr
	force-expr
	if-expr
	is-or-isnt-expr
	lambda-expr
	let-expr
	let-the-expr
	list-expr
	literal-scalar-expr
	literal-string-like-expr
	local-get-expr
	local-get-and-refine-expr
	local-get-and-call-and-refine-expr
	local-set-expr
	logical-expr
	match-enum-expr
	match-scalar-expr
	match-string-like-expr
	match-sum-type-expr
	seq-expr
	the-expr
	throw-expr
	trusted-expr
	try-expr
	try-let-expr
	typed-expr
	unpack-option
	while-or-until-expr
	while-or-until-body-expr
do
	range source-range()
start pos(a expr)
	a.range.start
end pos(a expr)
	a.range.end

type type(a expr) common-types
	match a
	as assert-or-forbid-expr
		a.after.?type else void
	as bogus-call-expr
		type a
	as bogus-expr
		type a
	as bogus-wrong-type-expr
		type a
	as call-expr
		type a
	as call-named-new-expr
		type a
	as call-option-expr
		type a
	as finally-expr
		type a
	as force-expr
		type a
	as if-expr
		type a
	as is-or-isnt-expr
		void
	as lambda-expr
		type a
	as let-expr
		type a
	as let-the-expr
		type a
	as list-expr
		a.type
	as literal-scalar-expr
		type a
	as literal-string-like-expr
		type a
	as local-get-expr
		type a
	as local-get-and-refine-expr
		type a
	as local-get-and-call-and-refine-expr
		type a
	as local-set-expr
		void
	as logical-expr
		type a
	as match-enum-expr
		type a
	as match-scalar-expr
		type a
	as match-string-like-expr
		type a
	as match-sum-type-expr
		type a
	as seq-expr
		type a
	as the-expr
		type a
	as throw-expr
		type a
	as trusted-expr
		type a
	as try-expr
		type a
	as try-let-expr
		type a
	as typed-expr
		type a
	as unpack-option
		bool
	as while-or-until-expr
		a.after.?type else void
	as while-or-until-body-expr
		type a

assert-or-forbid-expr record
	ast assert-or-forbid-ast
	is-forbid bool
	condition expr
	thrown expr?
	after expr?
range source-range(a assert-or-forbid-expr) = a.ast.range
default-assert-or-forbid-message string
	cur-uri uri
	a assert-or-forbid-expr
	content file-content-getters
do common-types
	prefix string, range source-range = match cond = a.condition
	as unpack-option
		- assert-or-forbid-option-message a.is-forbid
		- cond.option.range
	else
		- if is-option type cond
			assert-or-forbid-option-message a.is-forbid
		else
			if a.is-forbid then "Forbidden expression is true: " else "Asserted expression is false: "
		- a.condition.range
	prefix ~~ content[cur-uri, range].to
-assert-or-forbid-option-message string(is-forbid bool)
	if is-forbid then "Forbidden option is non-empty: " else "Asserted option is empty: "

bogus-expr record(range source-range, type type, kind bogus-expr-kind)
bogus-expr-kind union
	missing-expr
	expr-ast
	interpolated-template-part
	from-other-bogus
	temporary
| This {bogus-expr} represents something that should have been present (like a function body or 'else' branch).
missing-expr record
| This expression is bogus because a previous expression was bogus, so there is no expected type.
from-other-bogus record
| The bogus-expr is temporary and will be overwritten
temporary record

| Wraps an expression that has an invalid type.
bogus-wrong-type-expr record(inner expr, type type)
range source-range(a bogus-wrong-type-expr) = a.inner.range

call-expr-source union
	assignment-ast
	assignment-call-ast
	call-ast-dot
	call-ast-dot-question
	call-ast-infix
	call-ast-prefix
	call-ast-prefix-question
	call-ast-prefix-with-type-arg
	call-ast-then
	call-named-ast
	call-subscript-ast
	call-question-subscript-ast
	for-or-with-ast
	if-ast # Used for an empty 'else' branch
	interpolated-ast
	interpolated-template-part
	list-ast
	literal-string-ast
	name-and-range
	typed-ast # Used when this has an empty value
do
	range source-range()
name-range source-range(a call-expr-source)
	match a
	as assignment-ast
		a.left.range
	as assignment-call-ast
		a.name-range
	as call-ast-dot
		a.name-range
	as call-ast-dot-question
		a.name-range
	as call-ast-infix
		a.name-range
	as call-ast-prefix
		a.name-range
	as call-ast-prefix-question
		a.name-range
	as call-ast-prefix-with-type-arg
		a.name-range
	as call-ast-then
		a.name-range
	as call-named-ast
		a.range
	as call-subscript-ast
		a.subscript-range
	as call-question-subscript-ast
		a.subscript-range
	as for-or-with-ast
		a.keyword-range
	as if-ast
		a.first-keyword-range
	as interpolated-ast
		a.range
	as interpolated-template-part
		a.range
	as list-ast
		a.first-keyword-range
	as literal-string-ast
		a.range
	as name-and-range
		a.range
	as typed-ast
		a.keyword-range

bogus-call-expr record
	ast call-expr-source
	name symbol
	candidates called-decl[]
	| Note: It may have given up on checking arguments.
	checked-args expr[]
	type type
range source-range(a bogus-call-expr) = a.ast.range

call-expr record(ast call-expr-source, called called, args expr[])
range source-range(a call-expr) = a.ast.range
type type(a call-expr) = a.called.return-type

| This is for a call to 'named-new' where it provides symbols and args.
| Calls matching parameter names will use {call-expr}.
call-named-new-expr record(ast call-named-ast, called called, args expr[])
to json(a call-named-new-expr)
	called: a.called.to
	args: a.args.to
range source-range(a call-named-new-expr) = a.ast.range
type type(a call-named-new-expr) = a.called.return-type
names symbol[](a call-named-new-expr)
	for* x in a.ast.names
		-- from-option x.name

| Expression for 'x ?foo' or 'x.?foo' or 'x?[y]'
call-option-expr record
	ast call-option-source
	| May or may not return an option. If not it will be wrapped after calling.
	called called
	| The first arg is an option which is unwrapped before calling. The rest are non-optional.
	args expr[]
	| This is the final type, meaining it is void or an option type.
	type type
range source-range(a call-option-expr) = a.ast.range
call-option-source union(call-ast-dot-question, call-ast-prefix-question, call-question-subscript-ast)
	to json()
	range source-range()
	question-pos pos()
to expr-ast(a call-option-source)
	match a
	as call-ast-dot-question then a
	as call-ast-prefix-question then a
	as call-question-subscript-ast then a
to call-expr-source(a call-option-source)
	match a
	as call-ast-dot-question then a
	as call-ast-prefix-question then a
	as call-question-subscript-ast then a

finally-expr record(ast finally-ast, right expr, below expr)
range source-range(a finally-expr) = a.ast.range
type type(a finally-expr) common-types = type a.below

force-expr record(ast force-ast, arg expr)
range source-range(a force-expr) = a.ast.range
type type(a force-expr) common-types
	unwrap-option-allow-bogus! type a.arg

if-expr record
	ast if-ast
	condition expr
	true-branch expr
	false-branch expr
	type type
range source-range(a if-expr) = a.ast.range
first-branch expr(a if-expr)
	if a.ast.is-condition-negated then a.false-branch else a.true-branch
second-branch expr(a if-expr)
	if a.ast.is-condition-negated then a.true-branch else a.false-branch

is-or-isnt-expr record
	ast is-or-isnt-ast
	left expr
	right expr
	called-equal called?
	thrown thrown-for-is
thrown-for-is union(default-thrown-for-is, expr)
default-thrown-for-is record(called-to-json called?)
range source-range(a is-or-isnt-expr) = range a.ast
keyword-range source-range(a is-or-isnt-expr) = keyword-range a.ast
is-isnt bool(a is-or-isnt-expr) = a.ast.is-isnt

lambda-source union(for-or-with-ast, it-scope-ast, lambda-ast)
	range source-range()
to expr-ast(a lambda-source)
	match a
	as for-or-with-ast then a
	as it-scope-ast then a
	as lambda-ast then a
param destructure-ast?(a lambda-source)
	match a
	as for-or-with-ast
		a.param
	as it-scope-ast
		()
	as lambda-ast
		a.param
body expr-ast(a lambda-source)
	match a
	as for-or-with-ast
		a.body
	as it-scope-ast
		a.inner
	as lambda-ast
		a.body

lambda-expr record
	ast lambda-source
	param destructure
	| If this is present, the lambda was part of a `shared` expression.
	mut-type-for-explicit-shared type-inst?
	body expr
	closure closure-element[]
	type type-inst
is-explicit-shared bool(a lambda-expr)
	a.mut-type-for-explicit-shared
mutability mutability(a lambda-expr)
	a.type.as-lambda-type!
to json(a lambda-expr)
	param: a.param.to
	body: a.body.to
	closure: a.closure.to
	type: a.type.to
range source-range(a lambda-expr) = a.ast.range
return-type type(a lambda-expr)
	a.type.type-args[0]
| We don't know whether this lambda is for the main body or for the optional 'else'.
| But if it is from the 'else', this function will return true.
is-ignore bool(a lambda-expr)
	param = a.param
	param.destructure-ignore and param.source.void-destructure-ast
| {type-inst} for a context value
closure-element union(local, type-inst)
	to json()

let-expr-source union(let-ast, match-ast)
let-expr record(ast let-expr-source, destructure destructure, value expr, then_ expr?)
to json(a let-expr)
	destructure: a.destructure.to
	value: a.value.to
	then: a.then_.to
destructure-ast destructure-ast(a let-expr)
	match ast = a.ast
	as let-ast
		ast.destructure
	as match-ast
		ast.local!
range source-range(a let-expr)
	a.destructure.start, (a.then_ else a.value).end
type type(a let-expr) common-types
	a.then_.?type else void

let-the-expr record(ast let-the-ast, the-type type-inst, value expr, then_ expr?)
to json(a let-the-expr)
	the-type: a.the-type.to
	value: a.value.to
	then: a.then_.to
range source-range(a let-the-expr) = a.ast.range
type type(a let-the-expr) common-types
	a.then_.?type else void

list-expr record
	ast list-expr-source
	| Takes a single array parameter
	called called
	parts list-expr-part[]
list-expr-source union(if-ast, interpolated-ast, list-ast, literal-string-ast)
	range source-range()
to call-expr-source(a list-expr-source)
	match a
	as if-ast then a
	as interpolated-ast then a
	as list-ast then a
	as literal-string-ast then a
to expr-ast(a list-expr-source)
	match a
	as if-ast then a
	as interpolated-ast then a
	as list-ast then a
	as literal-string-ast then a
range source-range(a list-expr) = a.ast.range
to json(a list-expr)
	range: a.range.to
	called: a.called.to
	parts: a.parts.to
type type(a list-expr)
	a.called.return-type
array-type type(a list-expr)
	only! a.called.param-types
list-expr-part union(expr, list-expr-part-multi)
to json(a list-expr-part)
	match a
	as expr
		single: a.to
	as list-expr-part-multi
		multi: a.arg.to
list-expr-part-multi record(arg expr)

scalar-value record
	bits nat64
to scalar-value(a bool) = a.to,
to bool(a scalar-value)
	match a.to::nat64
	as 0 then false
	as 1 then true
	else then throw unreachable
to scalar-value(a nat8) = a,
to scalar-value(a char8) = a.to,
to scalar-value(a char32) = a.to,
to char32(a scalar-value) = a.to::nat64.to::nat32.to
to scalar-value(a int64) = a.wrap-to,
to int64(a scalar-value) = a.bits.wrap-to
to scalar-value(a nat64) = a,
to nat8(a scalar-value) = a.to::nat64.to
to nat64(a scalar-value) = a.bits
to scalar-value(a float64) = a.bits-of,
to float64(a scalar-value) = from-bits a.bits

scalar-values record
	bits nat64[]
subscript scalar-value(a scalar-values, index nat32)
	a.bits[index].to
to json(a scalar-values)
	a.bits.to
size nat32(a scalar-values)
	a.bits.size
some bool(a scalar-values, f bool mut(x scalar-value))
	some a.bits, f[it.to]
to scalar-values(values nat64[])
	bits: values
to scalar-values(values scalar-value[])
	bits: map values, it.to
is-range bool(a scalar-values)
	every a.with-index, of i, x
		x == (i,)

literal-scalar-expr record
	range source-range
	type char-or-integral-or-float-type
	value scalar-value
type type-inst(a literal-scalar-expr) common-types
	a.type.to

literal-string-like-expr record
	range source-range
	string-type string-like-type
	| For char32-array, this will be decoded in lower.
	value string
type type-inst(a literal-string-like-expr) common-types
	a.string-type.to

string-like-type enum(char8-array, char32-array, java-String, js-any, string, symbol)
matchable-string-like-type enum(string, symbol)
to string-like-type(a matchable-string-like-type)
	match a
	as string then string
	as symbol then symbol

local-get-expr record
	ast local-get-source
	local local
local-get-source union(it-ast, name-and-range)
	range source-range()
to json(a local-get-expr)
	local: a.local.name.to
range source-range(a local-get-expr) = a.ast.range
type type(a local-get-expr) = a.local.type

local-get-and-refine-expr record
	ast local-get-source
	local local
	| The type may be refined through nested 'match'es; this has each refined type in order.
	type-refinements type-args
to json(a local-get-and-refine-expr)
	local: a.local.name.to
	type-refinements: a.type-refinements.to
range source-range(a local-get-and-refine-expr) = a.ast.range
type type(a local-get-and-refine-expr) = last! a.type-refinements

| `a.x` where the type has been refined
call-and-refine-source union(call-ast-dot, call-ast-prefix)
	fun-name name-and-arity()
	name-range source-range()
	range source-range()
| For a {local-get-and-call-and-refine-expr}, this will always be non-empty
only-arg expr-ast?(a call-and-refine-source)
	match a
	as call-ast-dot then a.left
	as call-ast-prefix then only a.args
local-get-and-call-and-refine-expr record
	ast call-and-refine-source
	local local
	| May be empty, unlike {type-refinements}
	local-type-refinements type-args
	called fun-inst
	type-refinements type-args
to json(a local-get-and-call-and-refine-expr)
	local: a.local.name.to
	called: a.called.to
	type-refinements: a.type-refinements.to
range source-range(a local-get-and-call-and-refine-expr) = a.ast.range
local-ast name-and-range(a local-get-and-call-and-refine-expr) = name-and-range! only-arg! a.ast
local-range source-range(a local-get-and-call-and-refine-expr) = a.local-ast.range
local-type type(a local-get-and-call-and-refine-expr) = last a.local-type-refinements else a.local.type
name-range source-range(a local-get-and-call-and-refine-expr) = a.ast.name-range
type type(a local-get-and-call-and-refine-expr) = last! a.type-refinements

local-set-expr record(assignee-ast name-and-range, local local, value expr)
range source-range(a local-set-expr) = a.assignee-ast.start, a.value.end

logical-expr record
	ast logical-ast
	kind logical-expr-kind
	type type
	left expr
	right expr
to json(a logical-expr)
	kind: a.kind.to
	left: a.left.to
	right: a.right.to
logical-expr-kind enum
	bool-and-bool
	bool-or-bool
	option-else
	option-or
keyword-range source-range(a logical-expr) = a.ast.keyword-range
range source-range(a logical-expr) = a.ast.range

match-enum-expr record
	ast match-ast
	matched-local local?
	matched expr
	cases match-enum-case[]
	else_ expr?
	type type
to json(a match-enum-expr)
	matched: a.matched.to
	cases: a.cases.to
	else: a.else_.to
match-enum-case record(member enum-or-flags-member, then_ expr)
to json(a match-enum-case)
	member: a.member.name.to
	then: a.then_.to
range source-range(a match-enum-expr) = a.ast.range
enum-type type-inst(a match-enum-expr) common-types
	type-inst! type a.matched

match-scalar-expr record
	ast match-ast
	integral-type char-or-integral-type
	matched-local local?
	matched expr
	cases match-scalar-case[]
	else_ expr
	type type
to json(a match-scalar-expr)
	integral-type: a.integral-type.to
	matched: a.matched.to
	cases: a.cases.to
	else: a.else_.to
match-scalar-case record(value scalar-value, then_ expr)
range source-range(a match-scalar-expr) = a.ast.range
matched-type type-inst(a match-scalar-expr) common-types
	type-inst! type a.matched

match-string-like-expr record
	ast match-ast
	string-type matchable-string-like-type
	matched-local local?
	matched expr
	cases match-string-like-case[]
	else_ expr
	type type
to json(a match-string-like-expr)
	matched: a.matched.to
	cases: a.cases.to
	else: a.else_.to
match-string-like-case record(value string, then_ expr)
range source-range(a match-string-like-expr) = a.ast.range
matched-type type-inst(a match-string-like-expr) common-types
	type-inst! type a.matched

match-sum-type-expr record
	ast match-ast
	matched-local local?
	matched expr
	cases match-sum-type-case[]
	else_ expr?
	type type
to json(a match-sum-type-expr)
	matched: a.matched.to
	cases: a.cases.to
	else: a.else_.to
match-sum-type-case record(case-type type-inst, then_ expr)
range source-range(a match-sum-type-expr) = a.ast.range
sum-type type-inst(a match-sum-type-expr) common-types
	type-inst! type a.matched
sum-type-body sum-type(a match-sum-type-expr) common-types
	a.sum-type.decl.body.sum-type!

seq-expr record(first expr, then_ expr)
range source-range(a seq-expr) = a.first.start, a.then_.end
type type(a seq-expr) common-types = type a.then_

the-expr record(ast the-ast, type type-inst)
range source-range(a the-expr) = a.ast.range

throw-expr record(ast throw-ast, thrown expr, type type)
to json(a throw-expr)
	thrown: a.thrown.to
	type: a.type.to
range source-range(a throw-expr) = a.ast.range

trusted-expr record(ast trusted-ast, inner expr)
to json(a trusted-expr)
	inner: a.inner.to
range source-range(a trusted-expr) = a.ast.range
type type(a trusted-expr) common-types = type a.inner

try-expr record
	ast try-ast
	tried expr
	catches catch_[]
	type type
to json(a try-expr)
	tried: a.tried.to
	catches: a.catches.to
range source-range(a try-expr) = a.ast.range
| The local type is the caught type.
| NOTE: We create a local even if the user did not write one.
| The final catch may have a type of {exception}.
catch_ record(destructure simple-destructure, then_ expr)
caught-type type-inst(a catch_) = a.destructure.type.type-inst!

try-let-expr record
	ast try-let-ast
	destructure destructure
	value expr
	catch_ catch_
	then_ expr?
	type type
to json(a try-let-expr)
	destructure: a.destructure.to
	value: a.value.to
	catch: a.catch_.to
	then: a.then_.to
range source-range(a try-let-expr) = a.ast.range

typed-expr record(ast typed-ast, inner expr, type type)
to json(a typed-expr)
	inner: a.inner.to
	type: a.type.to
range source-range(a typed-expr) = a.ast.range

unpack-option record(ast unpack-option-ast, destructure destructure, option expr)
range source-range(a unpack-option)
	a.destructure.start, a.option.end

while-or-until-expr record
	ast while-or-until-ast
	condition expr
	| Always of type 'void'
	body expr
	after expr?
to json(a while-or-until-expr)
	condition: a.condition.to
	body: a.body.to
	after: a.after.to
is-until bool(a while-or-until-expr) = a.ast.is-until
range source-range(a while-or-until-expr) = a.ast.range

while-or-until-body-expr record
	ast while-or-until-body-ast
	body expr
type type(a while-or-until-body-expr) common-types
	body-type = type a.body
	if is-bool body-type
		void
	else
		unwrap-option body-type else body-type
to json(a while-or-until-body-expr) = body: a.body.to
is-until bool(a while-or-until-body-expr) = a.ast.is-until
range source-range(a while-or-until-body-expr) = a.ast.range

all-exprs-in-tree record(expr expr)
some bool(a all-exprs-in-tree, f bool mut(x expr))
	f[a.expr] or
	some a.expr.direct-child-exprs, {some it.all-exprs-in-tree, f}

direct-child-exprs record(expr expr)
some bool(a direct-child-exprs, f bool mut(x expr))
	match x = a.expr
	as assert-or-forbid-expr
		f[x.condition] or cb-option x.thrown, f or cb-option x.after, f
	as bogus-call-expr
		()
	as bogus-expr
		()
	as bogus-wrong-type-expr
		f[x.inner]
	as call-expr
		some x.args, f
	as call-named-new-expr
		some x.args, f
	as call-option-expr
		some x.args, f
	as finally-expr
		f[x.right] or f[x.below]
	as force-expr
		f[x.arg]
	as if-expr
		f[x.condition] or f[x.first-branch] or f[x.second-branch]
	as is-or-isnt-expr
		f[x.left] or f[x.right] or cb-option x.thrown.expr, f
	as lambda-expr
		f[x.body]
	as let-expr
		f[x.value] or cb-option x.then_, f
	as let-the-expr
		f[x.value] or cb-option x.then_, f
	as list-expr
		some x.parts, of part
			match part
			as expr then f[part]
			as list-expr-part-multi then f[part.arg]
	as literal-scalar-expr
		()
	as literal-string-like-expr
		()
	as local-get-expr
		()
	as local-get-and-refine-expr
		()
	as local-get-and-call-and-refine-expr
		()
	as local-set-expr
		f[x.value]
	as logical-expr
		f[x.left] or f[x.right]
	as while-or-until-expr
		f[x.condition] or f[x.body] or cb-option x.after, f
	as while-or-until-body-expr
		f[x.body]
	as match-enum-expr
		f[x.matched] or some x.cases, f[it.then_] or cb-option x.else_, f
	as match-scalar-expr
		f[x.matched] or some x.cases, f[it.then_] or f[x.else_]
	as match-string-like-expr
		f[x.matched] or some x.cases, f[it.then_] or f[x.else_]
	as match-sum-type-expr
		f[x.matched] or some x.cases, f[it.then_] or cb-option x.else_, f
	as seq-expr
		f[x.first] or f[x.then_]
	as the-expr
		()
	as throw-expr
		f[x.thrown]
	as trusted-expr
		f[x.inner]
	as try-expr
		f[x.tried] or some x.catches, f[it.then_]
	as try-let-expr
		f[x.value] or f[x.catch_.then_] or cb-option x.then_, f
	as typed-expr
		f[x.inner]
	as unpack-option
		f[x.option]

sum-type-case-getter fun-decl(funs fun-decl[], type type-decl, x sum-type-case)
	must-find-fun-named funs, type.name, of fun
		sum-type-case-get fun.body and
		fun.params.only!.type == x.sum-type and
		fun.body.type == type

# TODO:PERF this is slow!
must-find-fun-named fun-decl(funs fun-decl[], name symbol, cb bool mut(x fun-decl))
	find! funs, {it.name == name and cb[it]}

| In the CLI, we omit diagnostics if there are other more severe ones.
| So e.g., you wouldn't see unused code errors if there are parse errors.
diagnostic-severity enum
	| Unused or unstylish code
	lint
	warning
	check-error
	name-not-found
	| Severe error where a common fun (e.g. 'alloc', 'main') or type (e.g. 'void') is missing
	common-missing
	parse-error
	import-error
min-value diagnostic-severity()
	lint
is-fatal bool(a diagnostic-severity)
	a == common-missing or a == parse-error or a == import-error

uri-and-diagnostic record(uri uri, diagnostic diagnostic)
new uri-and-diagnostic(range uri-and-range, kind diag)
	range.uri, (range.range, kind)
where uri-and-range(a uri-and-diagnostic)
	a.uri, a.diagnostic.range
kind diag(a uri-and-diagnostic)
	a.diagnostic.kind

diagnostic record(range source-range, kind diag)

decl-kind enum
	alias_
	bogus-type
	builtin_
	enum_
	flags_
	function_
	global_
	interface_
	java-class
	java-interface
	record_
	spec_
	test_
	thread-local_
	union_
	variant_

fun-name union(name-and-arity, fun-name-list-new, named-new)
fun-name-list-new record(regular name-and-arity)
named-new record(names symbol[], regular name-and-arity)
regular-name symbol(a fun-name) = a.regular-name.name
regular-name name-and-arity(a fun-name)
	match a
	as name-and-arity then a
	as fun-name-list-new then a.regular
	as named-new then a.regular
arity nat32(a fun-name) = a.regular-name.arity

diag union
	diag-alias-not-allowed
	diag-assert-or-forbid-message-is-throw
	diag-assignment-not-allowed
	diag-builtin-unsupported
	diag-call-deprecated
	diag-call-multiple-matches
	diag-call-no-match
	diag-call-no-match-for-interpolate-or-list-new
	diag-call-option-non-option
	diag-call-should-use-syntax
	diag-case-duplicate
	diag-case-invalid-sum-type
	diag-case-missing-type
	diag-case-type-not-allowed
	diag-catch-else-must-come-last
	diag-char-literal-must-be-one-char
	diag-common-fun-duplicate
	diag-common-fun-missing
	diag-common-type-missing
	diag-common-var-missing
	diag-context-defined-in-lambda
	diag-context-duplicate
	diag-contexts-not-allowed
	diag-context-type-missing
	diag-context-type-param
	diag-config-invalid-kid
	diag-config-invalid-value
	diag-config-unhandled-key
	diag-destructure-type-mismatch
	diag-duplicate-declaration
	diag-duplicate-exports
	diag-duplicate-import-name
	diag-duplicate-imports
	diag-empty-enum-or-union
	diag-enum-value-not-sorted
	diag-expected-type-is-not-a-lambda
	diag-extern-body-multiple
	diag-flags-value-not-power-of-2
	diag-global-data-type
	diag-if-throw
	diag-import-file
	diag-import-refers-to-nothing
	diag-it-identity
	diag-lambda-cant-be-function-pointer
	diag-lambda-cant-infer-param-type
	diag-lambda-closure-mutability
	diag-lambda-multiple-match
	diag-lambda-not-expected
	diag-lambda-type-missing-param-type
	diag-literal-multiple-match
	diag-literal-not-expected
	diag-literal-overflow
	diag-local-not-mutable
	diag-main-incompatible-with-target
	diag-main-has-specs
	diag-main-test-missing
	diag-match-case-duplicate
	diag-match-case-for-type
	diag-match-case-name-not-in-enum
	diag-match-needs-else
	diag-match-on-non-matchable
	diag-match-sum-type-cant-infer-type-args
	diag-match-sum-type-no-member
	diag-match-unhandled-enum-members
	diag-match-unhandled-union-case-types
	diag-match-unnecessary-else
	diag-method-impl-visibility
	diag-modifier-conflict
	diag-modifier-duplicate
	diag-modifier-invalid
	diag-modifier-redundant-due-to-decl-kind
	diag-modifier-type-arg-invalid
	diag-must-be-auto
	diag-named-new-duplicate-name
	diag-named-new-interpolated
	diag-name-not-found
	diag-needs-expected-type
	diag-option-else-left-non-option
	diag-option-force-non-option
	diag-option-or-left-non-option
	diag-option-or-right-non-option
	diag-param-missing-type
	diag-param-mutable
	parse-diag
	parse-diag-kid
	diag-mutability-more-than-parent
	diag-mutability-of-field-more-than-parent
	diag-record-field-needs-type
	diag-required-after
	diag-shared-arg-is-not-lambda
	diag-shared-lambda-unused
	diag-shared-not-expected
	diag-spec-match-multiple
	diag-spec-no-match
	diag-spec-recursion
	diag-spec-used-as-type
	diag-spec-use-invalid
	diag-string-literal-invalid
	diag-sum-type-listed-members-non-union
	diag-trusted-unused
	diag-tuple-too-big
	diag-type-conflict
	diag-type-decl-params-syntax-error
	diag-type-param-cant-have-type-args
	diag-type-params-unsupported
	diag-type-should-use-syntax
	diag-underscore
	diag-union-cycle
	diag-union-member-invalid
	diag-unmodified-recursive-call
	diag-unpack-option-must-be-option
	diag-unpack-option-unnecessary
	diag-until-non-option
	diag-unused-import
	diag-unused-local
	diag-unused-internal-decl
	diag-unused-private-decl
	diag-visibility-warning
	diag-wrong-number-type-args
diag-alias-not-allowed record
diag-assert-or-forbid-message-is-throw record
diag-assignment-not-allowed record
diag-builtin-unsupported record(kind diag-builtin-unsupported-kind, name symbol)
diag-builtin-unsupported-kind enum(spec_, type)
diag-call-deprecated record(callee fun-decl)
| Note: this error is issued *before* resolving specs.
| We don't exclude a candidate based on not having specs.
diag-call-multiple-matches record
	fun-name fun-name
	type-container type-container
	| Unlike {diag-call-no-match}, these are only the ones that match
	matches called-decl[]
diag-call-no-match record
	type-container type-container
	fun-name fun-name
	expected-return-type expected-for-diag
	| 0 for inferred type args.
	| This is the unpacked tuple, actualNTypeArgs > 1 may match candidates with 1 type arg.
	actual-n-type-args nat32
	actual-arity nat32
	| NOTE: we may have given up early and this may not be as much as actualArity
	actual-arg-types type[]
	| All candidates, including those with wrong arity
	all-candidates called-decl[]
diag-call-no-match-for-interpolate-or-list-new record
	name symbol
	expected-return-type type-with-container
diag-call-option-non-option record(fun-name symbol)
diag-call-should-use-syntax record(arity nat32, kind diag-call-should-use-syntax-kind)
diag-call-should-use-syntax-kind enum
	for-loop
	list-new
	new_
	set-name
	set-subscript
	subscript
	with-block
diag-case-duplicate record(member type-decl, sum-type type-decl)
diag-case-invalid-sum-type record(member type-decl, actual type)
diag-case-missing-type record
diag-case-type-not-allowed record(case-type type-decl, reason diag-case-type-not-allowed-reason)
diag-case-type-not-allowed-reason enum(has-type-parameters, is-sum-type)
diag-catch-else-must-come-last record
diag-char-literal-must-be-one-char record
diag-common-fun-duplicate record(name symbol)
diag-common-fun-missing record(dummy-for-context fun-decl, signature return-and-param-types)
diag-common-type-missing record(name symbol)
diag-common-var-missing record(var-kind var-kind, name symbol)
diag-context-defined-in-lambda record
diag-context-duplicate record(type type-with-container)
diag-contexts-not-allowed record
	type-container type-container
	kind diag-contexts-not-allowed-kind
	called fun-inst
context type-decl(a diag-contexts-not-allowed)
	a.called.specs.all-contexts[0].type-inst!.decl
diag-contexts-not-allowed-kind enum(spec-impl, method-impl)
diag-context-type-missing record(container type-container, actual type[], expected type)
diag-context-type-param record
diag-config-invalid-kid record(expected string)
diag-config-invalid-value record(expected string, actual json)
diag-config-unhandled-key record(allowed symbol set, actual symbol)
diag-destructure-type-mismatch record
	expected destructure-expected-type
	actual type-with-container
destructure-expected-type union(destructure-expected-tuple, type-with-container)
destructure-expected-tuple record(size nat32)
diag-duplicate-declaration record(kind diag-duplicate-declaration-kind, name symbol)
diag-duplicate-declaration-kind enum
	enum-member
	flags-member
	param-or-local
	record-field
	spec-or-type
	type-param
	union-member
diag-duplicate-exports record(kind diag-duplicate-exports-kind, name symbol)
diag-duplicate-exports-kind enum(spec_, type)
| This is for the same name imported multiple times ('import ./m: foo, foo')
diag-duplicate-import-name record(name symbol)
| This is for different types of the same name imported from multiple modules
diag-duplicate-imports record(kind diag-duplicate-exports-kind, name symbol)
diag-empty-enum-or-union record
diag-enum-value-not-sorted record(prev-value nat64)
diag-flags-value-not-power-of-2 record
diag-expected-type-is-not-a-lambda record(expected-type type-with-container?)
diag-extern-body-multiple record
diag-global-data-type record
diag-if-throw record
diag-import-file union
	cant-import-as-content
	circular-import
	library-not-configured
	read-error
	relative-import-reaches-past-root
cant-import-as-content record(file-type file-type)
circular-import record(cycle uri[])
library-not-configured record(path path)
| The imported file will also have a ParseDiag for the issue, but we also show the error in the importer.
| (This is important in an IDE.)
read-error record(uri uri, diag read-file-diag)
relative-import-reaches-past-root record(imported rel-path)
diag-import-refers-to-nothing record(name symbol)
diag-it-identity record
diag-lambda-cant-be-function-pointer record
diag-lambda-cant-infer-param-type record
diag-lambda-closure-mutability record
	| This will only ever be 'data' or 'shared', since a 'mut' lambda allows everything
	lambda-kind mutability
	local-name symbol
	| If missing, the error is that the local itself is 'mut'.
	| If present, the error is that the type is 'mut'.
	type type-with-container?
diag-lambda-multiple-match record
	| This is only the expected types that are lambdas
	choices expected-for-diag-choices
diag-lambda-not-expected record(expected expected-for-diag)
diag-lambda-type-missing-param-type record
diag-literal-multiple-match record(type-container type-container, types type-inst[])
diag-literal-not-expected record(expected expected-for-diag)
diag-literal-overflow record(type integral-type)
diag-local-not-mutable record(local local)
diag-main-has-specs record
diag-main-incompatible-with-target record(target build-target)
diag-main-test-missing record(expected-line nat32)
diag-match-case-duplicate union(symbol, string, nat64, int64)
diag-match-case-for-type enum(enum-or-union, numeric, string-like)
diag-match-case-name-not-in-enum record(actual symbol, enum_ type-decl)
diag-match-needs-else enum(integral, string-like, variant_)
diag-match-on-non-matchable record(type type-with-container)
diag-match-sum-type-cant-infer-type-args record(member type-decl)
diag-match-sum-type-no-member record(sum-type type-with-container, non-member type-decl)
diag-match-unhandled-enum-members record(members enum-or-flags-member[])
diag-match-unhandled-union-case-types record(case-types type-inst[])
diag-match-unnecessary-else record
diag-modifier-conflict record(prev-modifier symbol, cur-modifier symbol)
diag-modifier-duplicate record(modifier symbol)
diag-modifier-invalid record(modifier modifier-keyword, decl-kind decl-kind)
diag-modifier-redundant-due-to-decl-kind record
	modifier modifier-keyword
	decl-kind decl-kind
diag-modifier-type-arg-invalid record
	modifier modifier-ast
diag-must-be-auto record
diag-named-new-duplicate-name record(name symbol)
diag-named-new-interpolated record
diag-name-not-found record(kind diag-name-not-found-kind, name symbol)
diag-name-not-found-kind enum(doc-comment-reference, spec-or-type)
diag-needs-expected-type enum(interpolated, list, loop_, throw_)
diag-option-else-left-non-option record(actual-type type-with-container)
diag-option-force-non-option record(actual-type type-with-container)
diag-option-or-left-non-option record(actual-type type-with-container)
diag-option-or-right-non-option record(actual-type type-with-container)
diag-param-missing-type record
diag-param-mutable record
diag-mutability-more-than-parent record(parent type-decl, child-type type)
diag-mutability-of-field-more-than-parent record(record_ type-decl, field-name symbol)
parse-diag-kid record(expected string)
diag-record-field-needs-type record(field-name symbol)
diag-required-after enum(assert_, forbid_, let, while_, until_, try-let)
diag-shared-arg-is-not-lambda record
diag-type-decl-params-syntax-error record
	type type-decl
	reason diag-type-params-syntax-error-reason
diag-type-params-syntax-error-reason enum(has-params-and-fields, destructure)
diag-shared-lambda-unused record
diag-shared-not-expected record(expected expected-for-diag)
diag-spec-used-as-type record(name symbol)
fun-decl-and-type-args record(decl fun-decl, type-args type-args)
diag-spec-match-multiple record
	type-container type-container
	sig-name symbol
	matches called[]
	trace fun-decl-and-type-args[]
diag-spec-no-match record
	type-container type-container
	reason spec-no-match-reason
	trace fun-decl-and-type-args[]
spec-no-match-reason union
	spec-builtin-not-satisfied
	spec-cant-infer-type-args
	spec-impl-not-found
	spec-too-deep
spec-builtin-not-satisfied record(kind builtin-spec, type-args type-args)
spec-cant-infer-type-args record
	| Since we didn't infer type args, it can't go onto the trace.
	fun fun-decl
spec-impl-not-found record(name symbol, type return-and-param-types)
spec-too-deep record
diag-spec-recursion record(trace spec-decl[])
diag-spec-use-invalid record(decl-kind decl-kind)
diag-string-literal-invalid enum
	not-extern-js
diag-sum-type-listed-members-non-union record
diag-trusted-unused record
diag-tuple-too-big record(actual nat32)
diag-type-conflict record(expected expected-for-diag, actual type-with-container)
diag-type-param-cant-have-type-args record
diag-type-params-unsupported record(decl-kind decl-kind)
diag-type-should-use-syntax enum
	array
	lambda-data
	lambda-mut
	lambda-shared
	map
	mut-array
	mut-map
	option
	shared-array
	shared-map
	tuple
diag-underscore record
diag-union-cycle record
diag-union-member-invalid enum
	option
	type-parameter
diag-unmodified-recursive-call record(fun fun-decl)
diag-unpack-option-must-be-option record(actual type-with-container)
diag-unpack-option-unnecessary record(unpacked-name symbol, original-name symbol, case-type symbol?)
diag-until-non-option record(actual type-with-container)
diag-unused-import record(imported-module module, imported-name symbol?)
diag-unused-local record(local local, kind diag-unused-local-kind)
diag-unused-local-kind enum(completely-unused, read-only, write-only)
diag-unused-internal-decl record(name symbol, is-used-locally bool)
diag-unused-private-decl record(name symbol)
diag-method-impl-visibility record
	case-type type-decl
	sum-type type-inst
	method-impl fun-inst
| We don't have any warning at the top-level even though '~' is redundant. This is only within a record.
diag-visibility-warning record
	kind visibility-warning-kind
	default-visibility visibility
	actual-visibility visibility
visibility-warning-kind union
	visibility-warning-field
	visibility-warning-field-mutability
	visibility-warning-new
visibility-warning-field record(record_ type-decl, field-name symbol)
visibility-warning-field-mutability record(field-name symbol)
visibility-warning-new record(record_ type-decl)
diag-wrong-number-type-args record(name symbol, n-expected-type-args nat32, n-actual-type-args nat32)

expected-for-diag union
	expected-for-diag-choices
	expected-for-diag-infer
expected-for-diag-choices record(types type[], type-container type-container)
expected-for-diag-infer record
