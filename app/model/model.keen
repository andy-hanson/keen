module union(keen-module, java-class-module)
	uri uri()
	name string()
	public-exports exports()
	public-and-internal-exports exports()

exports-with-visibility exports(a module, visibility export-visibility)
	match visibility
	as internal then a.public-and-internal-exports
	as public then a.public-exports

# Synthetic module generated from a Java class
java-class-module record
	uri uri
	public-exports exports
name string(a java-class-module)
	a.uri.base-name
public-and-internal-exports exports(a java-class-module)
	a.public-exports

keen-module record force-data
	uri uri
	| The config closest to this module. (Not necessarily the main config.)
	config config
	ast file-ast
	| Used to implement {walk-explicit-imports}.
	| This will match the order in {ast}.imports and {ast}.re-exports, omitting file imports.
	| As a result, it can contain duplicates if a module is both imported and re-exported.
	imports-and-re-exports module[]
	file-imports-and-exports uri[]
	| WARN: This is not every diagnostic; some are on the {ast}.
	check-diagnostics mut diagnostic[]
	aliases type-alias[]
	types type-decl[]
	vars var-decl[]
	specs spec-decl[]
	funs fun-decl[]
	tests test_[]
	| This is derived data based on the funs, specs, and structs/aliases in a module
	public-exports exports
	public-and-internal-exports exports
	doc-comment-references doc-comment-reference[]
== bool(a keen-module, b keen-module)
	trusted a 'reference-equal b
to json(a keen-module)
	deep-omit-empty-values
		uri: a.uri.to
		config: a.config.config-uri.to
		aliases: a.aliases.to
		structs: map a.types, it.to-json-with-body
		vars: a.vars.to
		specs: a.specs.to
		funs: a.funs.to
		tests: a.tests.to
		doc-comment-references: a.doc-comment-references.to
module-uri uri(a keen-module)
	a.uri
name string(a keen-module)
	a.uri.base-name
n-type-params nat8(_ keen-module)
	0
type-params type-params(_ keen-module)
	()
range uri-and-range(a keen-module)
	a.uri.top-of-file
doc-comment-ast doc-comment-ast(a keen-module)
	a.ast.doc-comment
doc-comment doc-comment(a keen-module)
	a.doc-comment-ast, a.doc-comment-references
exports exports(a module, visibility export-visibility)
	match visibility
	as public
		a.public-exports
	as internal
		a.public-and-internal-exports

exports record
	funs funs-map
	types-and-specs types-and-specs-map
new exports()
	(), ()
is-empty bool(a exports)
	is-empty a.funs and is-empty a.types-and-specs
test
	# Hack to make it appear used. This is used by the site.
	assert is-empty ()::exports

types-and-specs-map alias
	(symbol, spec-or-type) by-key

equal-2 name-and-arity() = trusted equal-2-var
-equal-2-var global(name-and-arity) = get-name-and-arity "==", 2
for-loop-2 name-and-arity() = trusted for-loop-2-var
-for-loop-2-var global(name-and-arity) = get-name-and-arity "for-loop", 2
for-star-2 name-and-arity() = trusted for-star-2-var
-for-star-2-var global(name-and-arity) = get-name-and-arity "for-star", 2
interpolate-1 name-and-arity() = trusted interpolate-1-var
-interpolate-1-var global(name-and-arity) = get-name-and-arity "interpolate", 1
interpolate-string-1 name-and-arity() = trusted interpolate-string-1-var
-interpolate-string-1-var global(name-and-arity) = get-name-and-arity "interpolate-string", 1
interpolate-value-1 name-and-arity() = trusted interpolate-value-1-var
-interpolate-value-1-var global(name-and-arity) = get-name-and-arity "interpolate-value", 1
list-new-1 name-and-arity() = trusted list-new-1-var
-list-new-1-var global(name-and-arity) = get-name-and-arity "list-new", 1
named-new-2 name-and-arity() = trusted named-new-2-var
-named-new-2-var global(name-and-arity) = get-name-and-arity "named-new", 2
new-0 name-and-arity() = new-n 0
new-n name-and-arity(n nat32)
	trusted if n < news.size then news[n] else get-name-and-arity "new", n
-news global(name-and-arity[])
	for i in 0 .. 8
		get-name-and-arity "new", i
set-subscript-3 name-and-arity() = trusted set-subscript-3-var
-set-subscript-3-var global(name-and-arity) = get-name-and-arity "set-subscript", 3
subscript-2 name-and-arity() = trusted subscript-2-var
-subscript-2-var global(name-and-arity) = get-name-and-arity "subscript", 2
to-1 name-and-arity() = trusted to-1-var
-to-1-var global(name-and-arity) = get-name-and-arity "to", 1
with-block-2 name-and-arity() = trusted with-block-2-var
-with-block-2-var global(name-and-arity) = get-name-and-arity "with-block", 2

funs-map record
	by-name (symbol, fun-decl) multi-by-key
	by-name-and-arity (name-and-arity, funs-set) by-key
new funs-map() = (), ()
make-funs-map funs-map(funs fun-decl[])
	by-name: to funs
	by-name-and-arity: to-by-key-combine-duplicates funs, it.to-funs-set
is-empty bool(a funs-map) = is-empty a.by-name
size nat32(a funs-map) = size a.by-name
test
	# Hack to make it appear used. This is used by the site.
	size ()::funs-map is 0
some bool(a funs-map, f bool mut(a fun-decl))
	some a.by-name.all, f
filter-by-names funs-map(a funs-map, names symbol set)
	by-name: choose-keys a.by-name, names
	by-name-and-arity: filter-keys a.by-name-and-arity, names[it.name]
any-for-name bool(a funs-map, name symbol)
	not is-empty a.by-name[name]
all-with-name fun-decl array-view(a funs-map, name symbol) = a.by-name[name]
all-with-name-and-arity record(map funs-map, key name-and-arity)
some bool(a all-with-name-and-arity, f bool mut(x fun-decl))
	(set = a.map.by-name-and-arity[a.key]) and some set, f
each-with-name-and-types void
	a funs-map
	key name-and-arity
	return-type type?
	arg0-type type?
	f void mut(x fun-decl)
do common-types
	if set = a.by-name-and-arity[key]
		each-with-types set, return-type, arg0-type, f
each-with-name-and-signature void
	a funs-map
	key name-and-arity
	signature return-and-param-types
	f void mut(x fun-decl)
do
	if set = a.by-name-and-arity[key]
		each-with-signature set, signature, f

| For these functions, we will not have an expected type for the first argument.
| Then candidates will be keyed by the first argument ytpe
is-highly-overloaded bool(a fun-name)
	name-and-arity a and is-highly-overloaded a.name
is-highly-overloaded bool(name symbol)
	match name
	as "==" then true
	as "<=>" then true
	as "~=" then true
	as "~~=" then true
	as a then true
	as b then true
	as c then true
	as d then true
	as e then true
	as f then true
	as g then true
	as "is-empty" then true
	as "size" then true
	as "show" then true
	as "some" then true
	else then false

| Set of functions with the same name and arity.
-funs-set union(fun-decl, fun-decl[], large-funs-set)
-large-funs-set record
	by-return-type-decl (type-decl, fun-decl) multi-by-key
	returning-non-decl fun-decl[]
	| This will only be set if {is-highly-overloaded}
	by-arg0-type-decl (arg0-type-decl, fun-decl) multi-by-key?
	by-signature (return-and-param-types, fun-decl) multi-by-key
-all fun-decl[](a large-funs-set)
	a.by-signature.all
-key name-and-arity(a funs-set)
	match a
	as fun-decl then a.name-and-arity
	as array then a[0].name-and-arity
	as large-funs-set then a.all[0].name-and-arity
-to-funs-set funs-set(funs fun-decl[])
	forbid is-empty funs
	if f = only funs
		f
	elif funs.size <= 4
		funs
	else
		by-return-type-decl (type-decl, fun-decl) multi-by-key, returning-non-decl fun-decl[] =
			do with by-decl, non-decl in build2
			do for fun in funs
			if type-inst fun.return-type
				by-decl ~= fun
			else
				non-decl ~= fun
		by-return-type-decl: by-return-type-decl
		returning-non-decl: returning-non-decl
		by-arg0-type-decl: if is-highly-overloaded funs[0].name
			any-non-decl mut = false
			by-arg0-type-decl (arg0-type-decl, fun-decl) multi-by-key = with out in build
				do for fun in funs
				if fun.params.size >= 1 and type-inst fun.params[0].type
					out ~= fun
				else
					any-non-decl := true
			unless any-non-decl
				by-arg0-type-decl
		by-signature: to funs
-some bool(a funs-set, f bool mut(a fun-decl))
	match a
	as fun-decl then f[a]
	as array then some a, f
	as large-funs-set then some a.all, f
| Returns functions that return type-decl or return a type parameter.
-each-with-types void(a funs-set, return-type type?, arg0-type type?, f void mut(x fun-decl)) common-types
	match a
	as fun-decl then f[a]
	as array then each a, f
	as large-funs-set
		if arg0-type and type-inst arg0-type and by-first = a.by-arg0-type-decl
			each by-first[arg0-type.decl,], f
		else
			used-return-type = return-type and each-narrowed-type-decl return-type, of decl
				for x in a.by-return-type-decl[decl]
					f[x]
			each (if used-return-type then a.returning-non-decl else a.all), f
-each-with-signature void(a funs-set, signature return-and-param-types, f void mut(x fun-decl))
	match a
	as fun-decl
		if a.return-and-param-types == signature
			f[a]
	as array
		for x in a
			if x.return-and-param-types == signature
				f[x]
	as large-funs-set
		each a.by-signature[signature], f

| For use by {each-with-types} only.
| This only calls {f} when it returns {true}.
| Returns false if it gave up.
| On success, also calls {f} on {a}.
-each-narrowed-type-decl bool(a type, f void mut(x type-decl)) common-types
	# If the expected type is a type parameter, only functions returning a type parameter can match it
	do if type-inst a else true
	ok = if unwrapped = unwrap-option a
		# Avoid outputting 'option' twice. This can happen if the type is 'bool?'
		each-narrowed-type-decl unwrapped, {unless it == option then f[it]}
	# Don't iterate over huge unions, it's faster to just use all functions
	elif n = a.decl.narrow-types and n.size <= 8
		each n, f
		true
	if ok then f[a.decl]
	ok

each-decl void(a keen-module, cb void mut(x any-decl))
	for x in a.aliases
		cb[x]
	for x in a.types
		cb[x]
	for x in a.vars
		cb[x]
	for x in a.specs
		cb[x]
	for x in a.funs
		cb[x]
	for x in a.tests
		cb[x]

| This if for detecting unused imports, so it omits the standard import and re-exports (which are not considered unused)
walk-explicit-imports record(module keen-module)
some bool(a walk-explicit-imports, f bool mut(ast import-or-export-ast, imported module))
	some a.module.walk-all-imports, of kind, ast, imported
		if kind == import_
			f[ast!, imported]

| Does not include the standard import
walk-explicit-imports-and-re-exports record(module keen-module)
some bool(a walk-explicit-imports-and-re-exports, f bool mut(a import-or-export-ast, imported module))
	some a.module.walk-all-imports, of _, ast, imported
		ast and f[ast, imported]

find-alias-in-module-scope type-alias?(module keen-module, name symbol)
	find module.aliases, it.name == name or
		first module.walk-all-imports, of _, import-ast, imported
			?type-alias get-imported-spec-or-type import-ast, imported, name

import-or-export-kind enum(standard-import, import_, export_)
walk-all-imports record(module keen-module)
some bool(a walk-all-imports, f bool mut(kind import-or-export-kind, ast import-or-export-ast?, imported module))
	module = a.module
	imports-and-re-exports = module.imports-and-re-exports
	ast = module.ast
	ast-total = ast.imports.count-non-file-imports + ast.re-exports.count-non-file-imports + ast.no-std_.not.to
	do if ast-total == imports-and-re-exports.size
	import-asts = ast.imports.?paths else ()
	do unless not ast.no-std_ and f[standard-import, (), imports-and-re-exports[0]]
	i mut nat32 = to not ast.no-std_
	res-imports = some import-asts, of import-ast
		do unless import-ast.kind.import-file-ast
		res = f[import_, import-ast, imports-and-re-exports[i]]
		i +:= 1
		res
	export-asts = ast.re-exports.?paths else ()
	res-exports = res-imports or some export-asts, of export-ast
		do unless export-ast.kind.import-file-ast
		res = f[export_, export-ast, imports-and-re-exports[i]]
		i +:= 1
		res
	unless res-exports
		i is imports-and-re-exports.size
	res-exports
each-imported-fun void(ast import-or-export-ast?, imported module, f void mut(x fun-decl))
	if ast
		base = exports-for-import ast, imported
		match kind = ast.kind
		as import-whole-module-ast
			each base.funs, f
		as array
			for name in kind
				each (all-with-name base.funs, name.name), f
		as import-file-ast
			throw unreachable
	else
		each imported.public-exports.funs, f
get-imported-spec-or-type spec-or-type?(ast import-or-export-ast?, imported module, name symbol)
	if ast
		all = exports-for-import ast, imported
		match kind = ast.kind
		as import-whole-module-ast
			all.types-and-specs[name]
		as array
			if some kind, it.name == name
				all.types-and-specs[name]
		as import-file-ast
			throw unreachable
	else
		imported.public-exports.types-and-specs[name]
| WARN: This does not filter by an explicit list of imported names
-exports-for-import exports(ast import-or-export-ast, imported module)
	match ast.path
	as path then imported.public-exports
	as rel-path then imported.public-and-internal-exports
-count-non-file-imports nat32(a imports-or-exports-ast?)
	do if a
	count a.paths, it.kind.import-file-ast.not

any-decl union
	fun-decl
	spec-decl
	type-alias
	type-decl
	test_
	var-decl
do
	hash nat32()
	module-uri uri()
	range uri-and-range()
	name-range uri-and-range()
	doc-comment-ast doc-comment-ast()
	doc-comment doc-comment()
	type-params type-params()
	visibility visibility()
	name symbol()
hash void(a any-decl, state hash-state)
	trusted hash a.hash, state
<=> comparison(a any-decl, b any-decl)
	trusted a.range <=> b.range
specs specs(a any-decl)
	match a
	as fun-decl
		a.specs
	as spec-decl
		a.parents
	as test_
		()
	as type-alias
		()
	as type-decl
		()
	as var-decl
		()

type-with-container record(type type, container type-container)

| Since a type parameter is represented as its index, we need a context to know where to find it.
| This is like AnyDecl, but also includes 'Module' which can have types in its doc comment.
type-container union(fun-decl, keen-module, spec-decl, type-alias, type-decl, test_, var-decl)
	module-uri uri()
	n-type-params nat8()
	type-params type-params()
forbid-module any-decl(a type-container)
	match a
	as fun-decl then a
	as keen-module then throw unreachable
	as spec-decl then a
	as test_ then a
	as type-alias then a
	as type-decl then a
	as var-decl then a
to type-container(a any-decl)
	match a
	as fun-decl then a
	as spec-decl then a
	as test_ then a
	as type-alias then a
	as type-decl then a
	as var-decl then a

