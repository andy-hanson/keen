fun-inst record force-data, -new
	decl fun-decl
	type-args type-args
	specs specs
	spec-impls spec-impls
	return-and-param-types mut return-and-param-types
get-or-add-fun-inst fun-inst
	decl fun-decl
	type-args type-args
	spec-impls spec-impls
	cb-return-and-param-types (return-and-param-types, specs) mut()
do
	if type-args.is-empty and spec-impls.is-empty
		decl.insts.fun-inst!
	else
		trusted memoize decl.insts.object-memoizer!, (type-args, spec-impls), of
			rp, specs = cb-return-and-param-types[]
			decl, type-args, specs, spec-impls, rp
-fun-inst-key record
	type-args type-args
	spec-impls spec-impls
-hash nat32(a fun-inst-key)
	do trusted
	state hash-state = ()
	hash a.type-args, state
	hash a.spec-impls, state
	wrap-to finish state
-memoizer-key fun-inst-key(a fun-inst)
	a.type-args, a.spec-impls
== bool(a fun-inst, b fun-inst)
	trusted a 'reference-equal b
hash void(a fun-inst, state hash-state)
	do trusted
	hash a.decl, state
	hash a.type-args, state
	hash a.spec-impls, state
to json(a fun-inst)
	decl: a.decl.name.to
	type-args: a.type-args.to
	spec-impls: a.spec-impls.to
return-type type(a fun-inst) = a.return-and-param-types.return-type
param-types type array-view(a fun-inst) = a.return-and-param-types.param-types

| Represents calling the n'th signature on this function's {specs}
called-spec-sig record
	index-in-specs nat32
	containing-spec spec-decl
	non-instantiated-sig signature
	return-and-param-types return-and-param-types
name-and-arity name-and-arity(a called-spec-sig) = a.non-instantiated-sig.name-and-arity
== bool(a called-spec-sig, b called-spec-sig)
	do trusted
	res = a.index-in-specs == b.index-in-specs and a.containing-spec == b.containing-spec
	if res
		a.non-instantiated-sig is b.non-instantiated-sig
		a.return-and-param-types is b.return-and-param-types
	res
hash void(a called-spec-sig, state hash-state)
	do trusted
	hash a.index-in-specs, state
	hash a.containing-spec, state
	hash a.non-instantiated-sig.name, state
	hash a.return-and-param-types, state
to json(a called-spec-sig)
	index-in-specs: a.index-in-specs.to
	spec_: a.containing-spec.name.to
	sig: a.non-instantiated-sig.name.to
	return-and-param-types: a.return-and-param-types.to
return-type type(a called-spec-sig)
	a.return-and-param-types.return-type
param-types type array-view(a called-spec-sig)
	a.return-and-param-types.param-types
module-uri uri(a called-spec-sig)
	a.non-instantiated-sig.module-uri
name symbol(a called-spec-sig)
	a.non-instantiated-sig.name
arity nat32(a called-spec-sig)
	a.non-instantiated-sig.params.size
n-type-params nat8(_ called-spec-sig)
	0
doc-comment doc-comment(a called-spec-sig)
	a.non-instantiated-sig.doc-comment

| Like {called}, but not fully instantiated.
called-decl union(fun-decl, called-spec-sig)
