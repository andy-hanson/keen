fun-body union
	fun-body-uninitialized
	fun-body-bogus
	fun-body-extern-java
	auto-fun
	fun-body-builtin
	enum-or-flags-member
	fun-body-expr
	fun-body-file-import
	fun-body-flags-function
	fun-body-method
	new-record
	new-interface
	record-field-get
	record-field-lens
	record-field-set
	sum-type-case-get
	var-get
	var-set
-fun-name symbol(body fun-body, return-type type)
	match body
	as fun-body-uninitialized then throw unreachable
	as fun-body-bogus then body.name
	as fun-body-expr then body.ast.name.name
	as fun-body-extern-java then body.name
	as auto-fun
		match body.kind
		as compare then "<=>"
		as equals then "=="
		as from-json then "to"
		as hash then "hash"
		as members-of-enum-or-flags then "members"
		as to-enum-or-flags-option-from-nat then "to"
		as to-enum-or-flags-option-from-symbol then "to"
		as to-nat-from-enum-or-flags then "to"
		as to-symbol-from-enum then "to"
		as to-symbol-array-from-flags then "to"
		as to-json then "to"
	as fun-body-builtin then body.ast.name.name
	as enum-or-flags-member then body.name
	as fun-body-file-import then body.name
	as fun-body-flags-function then body.function.to
	as fun-body-method then body.method.name
	as new-interface then "new"
	as new-record then if body.nominal_ then body.type.name else "new"
	as record-field-get then body.field.name
	as record-field-lens then body.field.name
	as record-field-set then "set-{body.field.name}"
	as sum-type-case-get then return-type.unwrap-option!.type-inst!.decl.name
	as var-get then body.var.name
	as var-set then "set-{body.var.name}"
type-params type-params(a fun-body)
	match a
	as fun-body-uninitialized then throw unreachable
	as fun-body-bogus then a.type-params
	as fun-body-expr then a.ast.type-params
	as fun-body-extern-java then a.type-params
	as auto-fun then a.source.type-params
	as fun-body-builtin then a.ast.type-params
	as enum-or-flags-member then ()
	as fun-body-file-import then ()
	as fun-body-flags-function then ()
	as fun-body-method then a.type.type-params
	as new-interface then a.type.type-params
	as new-record then a.type.type-params
	as record-field-get then a.type.type-params
	as record-field-lens then a.type.type-params
	as record-field-set then a.type.type-params
	as sum-type-case-get then a.type.type-params
	as var-get then ()
	as var-set then ()
module-uri uri(a fun-body)
	match a
	as fun-body-uninitialized then a.module-uri
	as fun-body-bogus then a.module-uri
	as fun-body-expr then a.ast.module-uri
	as fun-body-extern-java then a.module-uri
	as auto-fun then a.source.module-uri
	as fun-body-builtin then a.ast.module-uri
	as enum-or-flags-member then a.module-uri
	as fun-body-file-import then a.module-uri
	as fun-body-flags-function then a.type.module-uri
	as fun-body-method then a.type.module-uri
	as new-interface then a.type.module-uri
	as new-record then a.type.module-uri
	as record-field-get then a.type.module-uri
	as record-field-lens then a.type.module-uri
	as record-field-set then a.type.module-uri
	as sum-type-case-get then a.type.module-uri
	as var-get then a.var.module-uri
	as var-set then a.var.module-uri
range uri-and-range(a fun-body)
	match a
	as fun-body-uninitialized then a.module-uri, a.range
	as fun-body-bogus then a.module-uri, (a.ast.?range else ())
	as fun-body-expr then a.module-uri, a.ast.range
	as fun-body-extern-java then a.module-uri, ()
	as auto-fun then a.source.range
	as fun-body-builtin then a.module-uri, a.ast.range
	as enum-or-flags-member then a.range
	as fun-body-file-import then a.module-uri, a.ast.range
	as fun-body-flags-function then a.type.range
	as fun-body-method then a.method.range
	as new-interface then a.type.range
	as new-record then a.type.range
	as record-field-get then a.field.range
	as record-field-lens then a.field.range
	as record-field-set then a.field.range
	as sum-type-case-get then a.type.range
	as var-get then a.var.range
	as var-set then a.var.range
name-range uri-and-range(a fun-body)
	match a
	as fun-body-uninitialized then throw unreachable
	as fun-body-bogus then a.module-uri, (a.ast.?name-range else ())
	as fun-body-expr then a.module-uri, a.ast.name-range
	as fun-body-extern-java then a.module-uri, ()
	as auto-fun then a.source.name-range
	as fun-body-builtin then a.module-uri, a.ast.name-range
	as enum-or-flags-member then a.name-range
	as fun-body-file-import then a.module-uri, a.ast.range
	as fun-body-flags-function then a.type.name-range
	as fun-body-method then a.method.name-range
	as new-interface then a.type.name-range
	as new-record then a.type.name-range
	as record-field-get then a.field.name-range
	as record-field-lens then a.field.name-range
	as record-field-set then a.field.name-range
	as sum-type-case-get then a.type.name-range
	as var-get then a.var.name-range
	as var-set then a.var.name-range
ast fun-decl-ast?(a fun-body)
	match a
	as fun-body-bogus then a.ast
	as fun-body-builtin then a.ast
	as fun-body-expr then a.ast
	else then ()
doc-comment-ast doc-comment-ast(a fun-body)
	if ast = a.ast then ast.doc-comment

fun-body-builtin record
	ast fun-decl-ast
	kind builtin-fun

fun-body-expr record
	ast fun-decl-ast
	expr expr
	allocated-locals type-inst[local]
expr-maybe-allocated-locals union(expr, expr-with-allocated-locals)
as-expr expr(a expr-maybe-allocated-locals)
	match a
	as expr then a
	as expr-with-allocated-locals then a.expr
allocated-locals type-inst[local](a expr-maybe-allocated-locals)
	match a
	as expr then ()
	as expr-with-allocated-locals then a.allocated-locals
expr-with-allocated-locals record
	expr expr
	allocated-locals type-inst[local]

fun-body-bogus record(module-uri uri, name symbol, type-params type-params, ast fun-decl-ast?)
fun-body-uninitialized record(module-uri uri, range source-range)
