import
	../../lib/private/parse-util
	../frontend/parse/token
	./source-range

read-file-diag enum
	| The file content or diagnostic has not yet been set.
	unknown
	| The file is known to not exist.
	not-found
	| There was some error trying read the file.
	error
== bool(a read-file-diag, b read-file-diag)
to json(a read-file-diag)

parse-diagnostic record(range source-range, kind parse-diag)
to json(a parse-diagnostic)

parse-diag union
	parse-diag-closing-brace-needs-escape
	parse-diag-doc-comment-unused
	parse-diag-equals-left
	parse-diag-expected
	parse-diag-file-not-utf8
	parse-diag-import-file-type-not-supported
	parse-diag-indent-wrong
	parse-diag-indent-too-much
	parse-diag-invalid-string-escape
	parse-diag-line-too-long
	parse-diag-list-call-needs-hyphen
	parse-diag-match-case-interpolated
	parse-diag-missing-interpolated
	parse-diag-operator-needs-space
	parse-diag-named-new-key
	parse-diag-needs-block-ctx
	parse-diag-number-invalid
	parse-diag-too-many-type-params
	parse-diag-trailing-whitespace
	parse-diag-try-no-catch
	parse-diag-type-empty-parens
	parse-diag-type-trailing-mut
	parse-diag-type-unnecessary-parens
	parse-diag-unexpected-character
	parse-diag-unexpected-operator
	parse-diag-unexpected-token
	read-file-diag
to json(a parse-diag)
parse-diag-closing-brace-needs-escape record
to json(a parse-diag-closing-brace-needs-escape)
parse-diag-doc-comment-unused record
to json(a parse-diag-doc-comment-unused)
parse-diag-equals-left record
to json(a parse-diag-equals-left)
parse-diag-expected enum
	after-do-keyword
	after-do-line
	after-finally
	block-comment-end
	catch_
	close-interpolated
	closing-bracket
	closing-paren
	colon
	colon2
	comma
	dedent
	destructure
	end-of-line
	expression
	equals
	in_
	indent
	literal-integral
	name
	name-colon
	name-or-operator
	newline-or-dedent
	open-paren
	quote-double
	slash
to json(a parse-diag-expected)
parse-diag-file-not-utf8 record
to json(a parse-diag-file-not-utf8)
parse-diag-import-file-type-not-supported record
to json(a parse-diag-import-file-type-not-supported)
parse-diag-indent-too-much record
to json(a parse-diag-indent-too-much)
parse-diag-indent-wrong record(expected indent-kind)
to json(a parse-diag-indent-wrong)
-to json(a indent-kind)
parse-diag-invalid-string-escape record(actual string)
to json(a parse-diag-invalid-string-escape)
parse-diag-line-too-long record(actual nat, maximum nat)
to json(a parse-diag-line-too-long)
parse-diag-list-call-needs-hyphen record
to json(a parse-diag-list-call-needs-hyphen)
parse-diag-match-case-interpolated record
to json(a parse-diag-match-case-interpolated)
parse-diag-missing-interpolated record
to json(a parse-diag-missing-interpolated)
parse-diag-operator-needs-space record(before symbol, after string)
to json(a parse-diag-operator-needs-space)
parse-diag-named-new-key record
to json(a parse-diag-named-new-key)
parse-diag-needs-block-ctx enum
	for_
	for-star
	if_
	match_
	loop_
	of_
	quote_
	try_
	unless_
	with_
to json(a parse-diag-needs-block-ctx)
parse-diag-number-invalid record
to json(a parse-diag-number-invalid)
parse-diag-too-many-type-params record
to json(a parse-diag-too-many-type-params)
parse-diag-trailing-whitespace record
to json(a parse-diag-trailing-whitespace)
parse-diag-try-no-catch record
to json(a parse-diag-try-no-catch)
parse-diag-type-empty-parens record
to json(a parse-diag-type-empty-parens)
parse-diag-type-trailing-mut record
to json(a parse-diag-type-trailing-mut)
parse-diag-type-unnecessary-parens record
to json(a parse-diag-type-unnecessary-parens)
parse-diag-unexpected-character record(character char32)
to json(a parse-diag-unexpected-character)
parse-diag-unexpected-operator record(operator symbol)
to json(a parse-diag-unexpected-operator)
parse-diag-unexpected-token record(token token)
to json(a parse-diag-unexpected-token)
