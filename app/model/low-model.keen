import
	keen/unsafe
	../util/full-index-map
	../util/util
	./ast
	./model
	./source-range
	./uri

low-type-body union
	low-builtin-type
	low-enum
	low-flags
	low-java-class
	low-record
	low-union
	low-type-body-deferred
do
	to json()
low-builtin-type record(kind builtin-type, type-args low-type[])
to json(a low-builtin-type)
low-enum record(storage nat-type)
to json(a low-enum)
low-flags record(storage nat-type)
to json(a low-flags)
low-java-class record
	path path
	super-class low-type?
to json(a low-java-class)
low-record record
	prevent-constant bool
	fields low-field[]
to json(a low-record)
| Lambdas and all {sum-type} kinds compile to this.
| Method impls are stored separately on the {low-program}.
low-union record force-data
	java-interface path?
	| This may be an empty array for a lambda type with no implementations.
	| WARN: for a Java interface, this is not exhaustive.
	late-members mut low-type[]?
to json(a low-union)
low-type-body-deferred record
to json(a low-type-body-deferred)
has-members bool(a low-union)
	!!a.late-members
members low-type[](a low-union)
	a.late-members!
set-members void(a low-union, members low-type[])
	a.late-members := members

as-builtin-type low-builtin-type?(a low-type)
	a.body.low-builtin-type
is-void bool(a low-type)
	a.body.low-builtin-type.?kind == void
is-empty-type bool(a low-type)
	match body = a.body
	as low-builtin-type
		body.kind == void
	as low-enum
		false
	as low-flags
		false
	as low-java-class
		false
	as low-record
		!prevent-constant body and every body.fields, it.type.is-empty-type
	as low-union
		false
	as low-type-body-deferred
		false
is-enum-or-flags bool(a low-type)
	a.is-enum or a.is-flags
is-enum bool(a low-type)
	!!a.body.low-enum
is-flags bool(a low-type)
	!!a.body.low-flags
must-be-enum-or-flags enum-or-flags-member[](a low-type)
	a.source.low-type-source-inst!.decl.must-be-enum-or-flags
must-be-enum enum-or-flags-member[](a low-type)
	a.source.low-type-source-inst!.decl.body.enum_!.members
must-be-flags flags_(a low-type)
	a.source.low-type-source-inst!.decl.body.flags_!

low-type-source union(low-type-source-inst, low-type-source-bogus)
	to json()
low-type-source-bogus record
to json(a low-type-source-bogus)
low-type-source-inst record
	decl type-decl
	type-args low-type[]
to json(a low-type-source-inst)
range uri-and-range(a low-type-source)
	match a
	as low-type-source-bogus
		()
	as low-type-source-inst
		a.decl.range
low-type record force-data
	id nat
	source low-type-source
	body mut low-type-body
to json(a low-type)
	"{a.simple-name} {a.id}"
to-json-with-body json(a low-type)
	id: a.id.to
	source: a.source.to
	body: a.body.to
| Not guaranteed to be unique
simple-name symbol(a low-type)
	match source = a.source
	as low-type-source-bogus
		"BOGUS"
	as low-type-source-inst
		source.decl.name.to
== bool(a low-type, b low-type)
	trusted a 'reference-equal b
<=> comparison(a low-type, b low-type)
	do trusted
	a.id <=> b.id
hash void(a low-type, state hash-state)
	do trusted
	hash a.id, state
as-extern path?(a low-type)
	match body = a.body
	as low-builtin-type
		()
	as low-enum
		()
	as low-flags
		()
	as low-java-class
		body.path
	as low-record
		()
	as low-union
		body.java-interface
	as low-type-body-deferred
		throw unreachable

# Returns return and param types
as-lambda-type (low-type, low-type)?(a low-type)
	body = a.body
	if body.low-builtin-type and as-lambda-type body.kind
		only2! body.type-args

is-bool bool(a low-type)
	a.body.low-builtin-type.?kind == bool
is-char8-or-32 bool(a low-type)
	body = a.body
	body.low-builtin-type and (body.kind == char8 or body.kind == char32)
is-char8 bool(a low-type)
	a.body.low-builtin-type.?kind == char8
is-nat8 bool(a low-type)
	a.body.low-builtin-type.?kind == nat8
is-nat32 bool(a low-type)
	a.body.low-builtin-type.?kind == nat32
is-float32-or-64 bool(a low-type)
	body = a.body
	body.low-builtin-type and (body.kind == float32 or body.kind == float64)
as-char-type char-type?(a low-type)
	a.body.low-builtin-type.?kind.?to
as-nat-type nat-type?(a low-type)
	a.body.low-builtin-type.?kind.?to
as-int-type int-type?(a low-type)
	a.body.low-builtin-type.?kind.?to
as-integral-type integral-type?(a low-type)
	a.body.low-builtin-type.?kind.?to
as-integral-type-allow-char integral-type?(a low-type)
	if x = a.as-char-type
		match x
		as char8 then nat8
		as char32 then nat32
	else
		a.as-integral-type
as-float-type float-type?(a low-type)
	a.body.low-builtin-type.?kind.?to
as-array low-type?(a low-type)
	body = a.body
	if body.low-builtin-type and body.kind == array
		only body.type-args

as-array-or-buffer low-type?(type low-type)
	body = type.body
	if body.low-builtin-type and (body.kind == array or body.kind == buffer)
		only! type.source.low-type-source-inst!.type-args
as-buffer low-type?(type low-type)
	body = type.body
	if body.low-builtin-type and body.kind == buffer
		only! type.source.low-type-source-inst!.type-args
as-option low-type?(type low-type)
	source = type.source
	if source.low-type-source-inst and is-option source.decl
		only! type.source.low-type-source-inst!.type-args
as-weak-ref low-type?(a low-type)
	if is-weak-ref a
		only! a.source.low-type-source-inst!.type-args
is-weak-ref bool(a low-type)
	source = a.source
	source.low-type-source-inst and is-weak-ref source.decl
is-bogus bool(a low-type)
	!!a.source.low-type-source-bogus
is-js-any bool(a low-type)
	a.body.low-builtin-type.?kind == js-any

low-field record
	name symbol
	is-mutable bool
	type low-type
to json(a low-field)

low-local-source union(local, low-generated-local-kind)
	hash void(state hash-state)
	to json()
is-mutable bool(a low-local-source)
	a.local and a.is-mutable
low-generated-local-kind enum(args, ignore, destruct, member, member2, temp, the_, union-kind)
== bool(a low-generated-local-kind, b low-generated-local-kind)
to symbol(a low-generated-local-kind)
to string(a low-generated-local-kind)
	a.to::symbol.to
to json(a low-generated-local-kind)
hash void(a low-generated-local-kind, state hash-state)
low-local record
	source low-local-source
	type low-type
to json(a low-local)
	source: a.source.to
	type: a.type.to
== bool(a low-local, b low-local)
	trusted a 'reference-equal b
<=> comparison(_ low-local, _ low-local)
	trusted throw todo
hash void(a low-local, state hash-state)
	trusted hash a.source, state
is-mutable bool(a low-local)
	is-mutable a.source

low-fun-body union
	low-expr
	low-fun-body-extern-java
	low-fun-body-method
	low-fun-body-deferred
	low-fun-body-always-inline
	# Builtin functions are usually inlined, but not if they are used to implement a method
	low-builtin-unary
	low-builtin-binary
	low-builtin-ternary
	js-fun
to json(a low-fun-body)
	match a
	as low-expr
		a.to
	as low-fun-body-extern-java
		"Java method"
	as low-fun-body-method
		"method"
	as low-fun-body-deferred
		"deferred"
	as low-fun-body-always-inline
		"always-inline"
	as low-builtin-unary
		a.to
	as low-builtin-binary
		a.to
	as low-builtin-ternary
		a.to
	as js-fun
		a.to
low-fun-body-extern-java record
	kind java-method-kind
	class_ path
	erased-return-type low-type
	erased-param-types low-type[]
low-fun-body-method record(method-index nat)
low-fun-body-deferred record
# Type for a function body that will never be filled in because the function should always be inlined
low-fun-body-always-inline record

low-fun-source union
	low-fun-source-regular
	low-fun-source-test
	low-fun-source-wrap-main
to json(a low-fun-source)
range uri-and-range(a low-fun-source)
	match a
	as low-fun-source-regular
		a.decl.range
	as low-fun-source-test
		a.test_.range
	as low-fun-source-wrap-main
		a.range
low-fun-source-test record
	test_ test_
	| Arbitrary index over all tests
	test-index nat
to json(a low-fun-source-test)
	where: a.test_.name-range.start.to
low-fun-source-wrap-main record(range uri-and-range)
to json(a low-fun-source-wrap-main)

low-fun record force-data
	hash nat
	source low-fun-source
	return-type low-type
	| This includes regular params and context params (low-model makes no distinction)
	params low-local[]
	body mut low-fun-body
== bool(a low-fun, b low-fun)
	trusted a 'reference-equal b
<=> comparison(a low-fun, b low-fun)
	trusted a.range <=> b.range
hash void(a low-fun, state hash-state)
	trusted hash a.hash, state
context-params low-local array-view(a low-fun)
	source = a.source
	n-contexts = if source.low-fun-source-regular then source.decl.contexts.size
	a.params[end - n-contexts .. end]
to-json-with-body json(a low-fun)
	source: a.source.to
	return-type: a.return-type.to
	params: a.params.to
	body: a.body.to
to json(a low-fun)
	"{a.simple-name}{a.hash}"
| Not guaranteed to be unique
simple-name symbol(a low-fun)
	match source = a.source
	as low-fun-source-regular
		source.decl.name
	as low-fun-source-test
		"test"
	as low-fun-source-wrap-main
		"wrap-main"
module-uri uri(a low-fun)
	a.range.uri
range uri-and-range(a low-fun)
	a.source.range
is-extern bool(a low-fun)
	match a.body
	as low-expr
		false
	as low-fun-body-extern-java
		true
	as low-fun-body-method
		!!a.params[0].type.as-extern
	as low-fun-body-deferred
		throw unreachable
	as low-fun-body-always-inline
		throw unreachable
	as low-builtin-unary
		false
	as low-builtin-binary
		false
	as low-builtin-ternary
		false
	as js-fun
		false
name symbol?(a low-fun)
	a.source.low-fun-source-regular.?decl.?name

low-fun-source-regular record
	decl fun-decl
	type-args low-type[]
	spec-impls low-fun[]
to json(a low-fun-source-regular)
	omit-empty-values
		decl: a.decl.name.to
		type-args: a.type-args.to
		spec-impls: a.spec-impls.to

low-expr union
	array-op-low-expr
	builtin-unary-low-expr
	builtin-binary-low-expr
	builtin-ternary-low-expr
	builtin-js-low-expr
	call-low-expr
	constant-low-expr
	create-array-low-expr
	create-record-low-expr
	create-union-low-expr
	finally-low-expr
	if-low-expr
	let-low-expr
	lambda-low-expr
	local-get-low-expr
	local-set-low-expr
	loop-low-expr
	loop-break-low-expr
	loop-continue-low-expr
	match-scalar-low-expr
	match-string-like-low-expr
	match-union-low-expr
	record-field-get-low-expr
	record-field-set-low-expr
	seq-low-expr
	throw-low-expr
	try-low-expr
	try-let-low-expr
	union-assume-case-low-expr
	union-as-case-or-gc-safe-low-expr
	union-is-case-low-expr
	var-get-low-expr
	var-set-low-expr
do
	range uri-and-range()
to json(a low-expr)
uri uri(a low-expr)
	a.range.uri
start uri-and-pos(a low-expr)
	a.range.start
type low-type(a low-expr) low-common-types
	match a
	as array-op-low-expr
		type a
	as builtin-unary-low-expr
		type a
	as builtin-binary-low-expr
		type a
	as builtin-ternary-low-expr
		type a
	as builtin-js-low-expr
		type a
	as call-low-expr
		type a
	as constant-low-expr
		type a
	as create-array-low-expr
		type a
	as create-record-low-expr
		type a
	as create-union-low-expr
		type a
	as finally-low-expr
		type a
	as if-low-expr
		type a
	as let-low-expr
		type a
	as lambda-low-expr
		type a
	as local-get-low-expr
		type a
	as local-set-low-expr
		type a
	as loop-low-expr
		type a
	as loop-break-low-expr
		type a
	as loop-continue-low-expr
		type a
	as match-scalar-low-expr
		type a
	as match-string-like-low-expr
		type a
	as match-union-low-expr
		type a
	as record-field-get-low-expr
		type a
	as record-field-set-low-expr
		type a
	as seq-low-expr
		type a
	as throw-low-expr
		type a
	as try-low-expr
		type a
	as try-let-low-expr
		type a
	as union-assume-case-low-expr
		type a
	as union-as-case-or-gc-safe-low-expr
		type a
	as union-is-case-low-expr
		type a
	as var-get-low-expr
		type a
	as var-set-low-expr
		type a

| Specialization of `for local in in-array then inner`
| where the input is an {array}, {buffer}, or {range} and the output is an {array}, {buffer}, or {void}.
| If the return type is {void}, this does not return an array.
array-op-low-expr record
	type low-type
	range uri-and-range
	input low-expr
	local low-local?
	| Used for performance to avoid allocating empty arrays
	empty-out-array constant-array?
	body low-expr
input-kind for-loop-input-kind(a array-op-low-expr) low-common-types
	if as-array-or-buffer a.input.type
		array
	else
		range
for-loop-input-kind enum(array, range)
== bool(a for-loop-input-kind, b for-loop-input-kind)
output-kind for-loop-output-kind(_ array-op-low-expr, type low-type)
	if as-array-or-buffer type
		array
	else
		assert is-void type
		void
for-loop-output-kind enum(array, void)
in-element low-type(a array-op-low-expr) low-common-types
	match input-kind a
	as array
		as-array-or-buffer! a.input.type
	as range
		range-element-type a.input.type
range-element-type low-type(range-type low-type)
	low, high = range-fields range-type
	low.type is high.type
	low.type
range-fields (low-field, low-field)(range-type low-type)
	only2! range-type.body.low-record!.fields
out-element low-type(a array-op-low-expr) low-common-types
	a.body.type
to json(a array-op-low-expr)

builtin-unary-low-expr record
	type low-type
	range uri-and-range
	fun low-builtin-unary
	arg low-expr
to json(a builtin-unary-low-expr)
| This has some additional members not in {builtin-unary}
low-builtin-unary enum
	array-size
	bits-of-float32
	bits-of-float64
	bitwise-not
	drop
	float32-from-bits
	float64-from-bits
	uninitialized-buffer
	not
	reinterpret-cast
	to-float32-from-float64
	to-float64-from-float32
	to-float64-from-int64
	to-float64-from-nat64
	truncate-to-int64-from-float64
	weak-ref-get
	weak-ref-new
	wrap-convert-integral
to json(a low-builtin-unary)

builtin-binary-low-expr record
	type low-type
	range uri-and-range
	fun builtin-binary
	arg0 low-expr
	arg1 low-expr
to json(a builtin-binary-low-expr)
low-builtin-binary alias
	builtin-binary

builtin-ternary-low-expr record
	type low-type
	range uri-and-range
	fun low-builtin-ternary
	arg0 low-expr
	arg1 low-expr
	arg2 low-expr
to json(a builtin-ternary-low-expr)
low-builtin-ternary alias
	builtin-ternary

builtin-js-low-expr record
	type low-type
	range uri-and-range
	fun js-fun
	args low-expr[]
to json(a builtin-js-low-expr)

call-low-expr record
	range uri-and-range
	called low-fun
	args low-expr[]
type low-type(a call-low-expr)
	a.called.return-type
to json(a call-low-expr)

constant-low-expr record
	type low-type
	range uri-and-range
	value constant
to json(a constant-low-expr)

create-array-low-expr record
	type low-type
	range uri-and-range
	args low-expr[]
to json(a create-array-low-expr)

create-record-low-expr record
	type low-type
	range uri-and-range
	args low-expr[]
to json(a create-record-low-expr)

create-union-low-expr record
	type low-type
	range uri-and-range
	case-index nat
	arg low-expr
to json(a create-union-low-expr)

finally-low-expr record(range uri-and-range, right low-expr, below low-expr)
type low-type(a finally-low-expr) low-common-types
	a.below.type
to json(a finally-low-expr)

if-low-expr record(range uri-and-range, cond low-expr, then_ low-expr, else_ low-expr)
type low-type(a if-low-expr) low-common-types
	a.then_.type
to json(a if-low-expr)

let-low-expr record(range uri-and-range, local low-local, value low-expr, then_ low-expr)
type low-type(a let-low-expr) low-common-types
	a.then_.type
to json(a let-low-expr)

lambda-low-expr record
	type low-type
	range uri-and-range
	closure low-local[]
	param low-local
	body low-expr
to json(a lambda-low-expr)

| For a JS target, this can get a local through a closure.
local-get-low-expr record(range uri-and-range, local low-local)
type low-type(a local-get-low-expr)
	a.local.type
to json(a local-get-low-expr)

local-set-low-expr record
	range uri-and-range
	local low-local
	value low-expr
type low-type(_ local-set-low-expr) low-common-types
	void
to json(a local-set-low-expr)

loop-low-expr record(range uri-and-range, body low-expr)
type low-type(a loop-low-expr) low-common-types
	a.body.type
to json(a loop-low-expr)

loop-break-low-expr record(range uri-and-range, value low-expr)
type low-type(a loop-break-low-expr) low-common-types
	a.value.type
to json(a loop-break-low-expr)

loop-continue-low-expr record(type low-type, range uri-and-range)
to json(a loop-continue-low-expr)

match-scalar-low-expr record
	range uri-and-range
	matched low-expr
	case-values scalar-values
	case-exprs low-expr[]
	else_ low-expr?
type low-type(a match-scalar-low-expr) low-common-types
	a.case-exprs[0].type
to json(a match-scalar-low-expr)
matched-integral-type char-or-integral-type(a match-scalar-low-expr) low-common-types
	match body = a.matched.type.body
	as low-builtin-type
		body.kind.to!
	as low-enum
		body.storage.to
	else
		throw unreachable

match-string-like-low-expr record
	range uri-and-range
	matched low-expr
	equals low-fun
	cases low-match-string-like-case[]
	else_ low-expr
type low-type(a match-string-like-low-expr) low-common-types
	a.cases[0].then_.type
to json(a match-string-like-low-expr)
low-match-string-like-case record(value constant, then_ low-expr)
to json(a low-match-string-like-case)

indices record(values scalar-values)
list-new indices(values nat64[])
	values.to
== bool(a indices, b indices)
to json(a indices)
	a.values.to
to indices(a nat)
	values: (a.to::scalar-value,).to::scalar-values
to indices(a nat range)
	a.to::nat[].to
to indices(a nat[])
	values: a.to
size nat(a indices)
	a.values.size
some bool(a indices, f bool mut(x nat))
	some a.values, f[it.to]
subscript nat(a indices, index nat)
	a.values[index].to
to-array nat[](a indices)
	a.values.to-array

match-union-low-expr record
	range uri-and-range
	matched low-expr
	case-indices indices
	cases low-expr[]
	else_ low-expr?
type low-type(a match-union-low-expr) low-common-types
	a.cases[0].type
to json(a match-union-low-expr)
union-type low-type(a match-union-low-expr) low-common-types
	a.matched.type
union_ low-union(a match-union-low-expr) low-common-types
	a.union-type.body.low-union!

| Expression that optionally uses something as a local
low-local-and-expr record(local low-local?, expr low-expr)
to json(a low-local-and-expr)

record-field-get-low-expr record(range uri-and-range, record_ low-expr, field-index nat)
type low-type(a record-field-get-low-expr) low-common-types
	a.field.type
to json(a record-field-get-low-expr)
field low-field(a record-field-get-low-expr) low-common-types
	a.record_.type.body.low-record!.fields[a.field-index]

record-field-set-low-expr record
	range uri-and-range
	record_ low-expr
	field-index nat
	value low-expr
type low-type(_ record-field-set-low-expr) low-common-types
	void
to json(a record-field-set-low-expr)
field low-field(a record-field-set-low-expr) low-common-types
	a.record_.type.body.low-record!.fields[a.field-index]

seq-low-expr record
	| All parts but the last should be of type 'void'
	range uri-and-range
	parts low-expr[]
type low-type(a seq-low-expr) low-common-types
	a.parts[end - 1].type
to json(a seq-low-expr)

throw-low-expr record(type low-type, range uri-and-range, thrown low-expr)
to json(a throw-low-expr)

try-low-expr record
	range uri-and-range
	tried low-expr
	exception-member-indices indices
	catch-cases low-local-and-expr[]
	| For this, the local type is always 'exception'
	catch-else low-local-and-expr?
type low-type(a try-low-expr) low-common-types
	a.tried.type
to json(a try-low-expr)

try-let-low-expr record
	range uri-and-range
	local low-local?
	value low-expr
	exception-member-index nat
	catch_ low-local-and-expr
	then_ low-expr
type low-type(a try-let-low-expr) low-common-types
	a.then_.type
caught-type low-type(a try-let-low-expr, exception low-type)
	exception.body.low-union!.members[a.exception-member-index]
to json(a try-let-low-expr)

| The type of {arg} is a union type and the type of this expression is one of its cases.
| Use only in situations where we know the union value has that case type.
| In a JavaScript build this will usually do nothing. In Java it must insert a cast.
union-assume-case-low-expr record(type low-type, range uri-and-range, arg low-expr)
union-type low-type(a union-assume-case-low-expr) low-common-types
	a.arg.type
union_ low-union(a union-assume-case-low-expr) low-common-types
	a.union-type.body.low-union!
to json(a union-assume-case-low-expr)

union-as-case-or-gc-safe-low-expr record(type low-type, range uri-and-range, arg low-expr)
union-type low-type(a union-as-case-or-gc-safe-low-expr) low-common-types
	a.arg.type
union_ low-union(a union-as-case-or-gc-safe-low-expr) low-common-types
	a.union-type.body.low-union!
to json(a union-as-case-or-gc-safe-low-expr)

union-is-case-low-expr record
	range uri-and-range
	arg low-expr
	case-index nat
type low-type(_ union-is-case-low-expr) low-common-types
	bool
union-type low-type(a union-is-case-low-expr) low-common-types
	a.arg.type
union_ low-union(a union-is-case-low-expr) low-common-types
	a.union-type.body.low-union!
case-type low-type(a union-is-case-low-expr) low-common-types
	a.union_.members[a.case-index]
to json(a union-is-case-low-expr)

var-get-low-expr record(range uri-and-range, var low-var)
type low-type(a var-get-low-expr)
	a.var.type
to json(a var-get-low-expr)

var-set-low-expr record
	range uri-and-range
	var low-var
	value low-expr
type low-type(_ var-set-low-expr) low-common-types
	void
to json(a var-set-low-expr)

low-array-type-and-constants record
	array-type low-type
	constants constant[][]
element-type low-type(a low-array-type-and-constants)
	as-array-or-buffer! a.array-type

all-constants record
	symbols symbol[]
	arrays low-array-type-and-constants[]
	| Maps a {constant-record} to the record values.
	records (constant-record, constant[]) full-index-map[low-type]
	unions (constant-union, constant-union-value) full-index-map[low-type]
subscript constant[](a all-constants, constant constant-array)
	a.arrays[constant.type-index].constants[constant.index]
get-record constant[](a all-constants, type low-type, constant constant-record)
	a.records[type]![constant]
get-union (low-type, nat, constant)(a all-constants, type low-type, constant constant-union)
	res = a.unions[type]![constant]
	type.body.low-union!.members[res.case-index], res.case-index, res.value

low-var record
	source var-decl
	type low-type
	initializer low-expr
== bool(a low-var, b low-var)
	trusted a 'reference-equal b
<=> comparison(a low-var, b low-var)
	trusted a.range <=> b.range
hash void(a low-var, state hash-state)
	trusted hash a.source, state
to json(a low-var)
	kind: a.kind.to
	name: a.source.name.to
	type: a.type.to
kind var-kind(a low-var)
	a.source.kind
range uri-and-range(a low-var)
	a.source.range
module-uri uri(a low-var)
	a.source.module-uri

low-program record
	model-program program
	target build-target
	all-constants all-constants
	all-non-extern-types low-type[]
	all-types-including-extern low-type[]
	all-vars low-var[]
	all-non-extern-funs low-fun[]
	all-funs-including-extern low-fun[]
	method-impls low-method-info[low-type]
	| Only used in a JS build
	async low-async-info?
	common-types low-common-types
	common-funs low-common-funs
low-async-info record
	funs async-kind[low-fun]
	var-initializers low-var set
to json(a low-program)
	target: a.target.to
	all-types: for x in a.all-types-including-extern
		x.to-json-with-body
	all-vars: a.all-vars.to
	all-funs: for x in a.all-funs-including-extern
		x.to-json-with-body

# If this is missing it will be always sync
async-kind enum
	always-async
	| This should compile to separate sync and async versions. Async callers will call the async version.
	| This can happen for a function that takes a callback and calls it.
	sync-and-async
== bool(a async-kind, b async-kind)

low-method-info record
	| Note: This is not all methods, only the ones that were accessed
	methods low-fun[]
	# This matches the order of types in the union
	cases low-fun?[][]
low-common-types record
	bool low-type
	exception low-type
	float32 low-type
	float64 low-type
	int64 low-type
	nat8 low-type
	nat16 low-type
	nat32 low-type
	nat64 low-type
	string low-type
	symbol low-type
	void low-type
bool low-type() low-common-types
	the::low-common-types.bool
exception low-type() low-common-types
	the::low-common-types.exception
float32 low-type() low-common-types
	the::low-common-types.float32
float64 low-type() low-common-types
	the::low-common-types.float64
int64 low-type() low-common-types
	the::low-common-types.int64
to low-type(a nat-type) low-common-types
	match a
	as nat8
		nat8
	as nat16
		nat16
	as nat32
		nat32
	as nat64
		nat64
nat8 low-type() low-common-types
	the::low-common-types.nat8
nat16 low-type() low-common-types
	the::low-common-types.nat16
nat32 low-type() low-common-types
	the::low-common-types.nat32
nat64 low-type() low-common-types
	the::low-common-types.nat64
string low-type() low-common-types
	the::low-common-types.string
symbol low-type() low-common-types
	the::low-common-types.symbol
void low-type() low-common-types
	the::low-common-types.void

low-common-funs union
	low-common-funs-java
	low-common-funs-js
do
	main low-fun()
	show-exception low-fun()
low-common-funs-java record
	show-exception low-fun
	start-runtime low-fun
	stop-runtime low-fun
	to-symbol-from-string low-fun
	main low-fun
low-common-funs-js record
	js-any low-type
	main low-fun
	show-exception low-fun
	to-symbol-from-string low-fun
	to-string-from-js-any low-fun

low-direct-child-exprs record(expr low-expr)
direct-child-exprs low-direct-child-exprs(expr low-expr)
	expr,
some bool(a low-direct-child-exprs, f bool mut(x low-expr))
	match x = a.expr
	as array-op-low-expr
		f[x.input] or f[x.body]
	as builtin-unary-low-expr
		f[x.arg]
	as builtin-binary-low-expr
		f[x.arg0] or f[x.arg1]
	as builtin-ternary-low-expr
		f[x.arg0] or f[x.arg1] or f[x.arg2]
	as builtin-js-low-expr
		some x.args, f
	as call-low-expr
		some x.args, f
	as constant-low-expr
		false
	as create-array-low-expr
		some x.args, f
	as create-record-low-expr
		some x.args, f
	as create-union-low-expr
		f[x.arg]
	as finally-low-expr
		f[x.right] or f[x.below]
	as if-low-expr
		f[x.cond] or f[x.then_] or f[x.else_]
	as lambda-low-expr
		f[x.body]
	as let-low-expr
		f[x.value] or f[x.then_]
	as local-get-low-expr
		false
	as local-set-low-expr
		f[x.value]
	as loop-low-expr
		f[x.body]
	as loop-break-low-expr
		f[x.value]
	as loop-continue-low-expr
		false
	as match-scalar-low-expr
		f[x.matched] or some x.case-exprs, f or cb-option x.else_, f
	as match-string-like-low-expr
		f[x.matched] or some x.cases, f[it.then_] or f[x.else_]
	as match-union-low-expr
		f[x.matched] or some x.cases, f[it] or cb-option x.else_, f
	as record-field-get-low-expr
		f[x.record_]
	as record-field-set-low-expr
		f[x.record_] or f[x.value]
	as seq-low-expr
		some x.parts, f
	as throw-low-expr
		f[x.thrown]
	as try-low-expr
		f[x.tried] or some x.catch-cases, f[it.expr] or cb-option x.catch-else.?expr, f
	as try-let-low-expr
		f[x.value] or f[x.catch_.expr] or f[x.then_]
	as union-assume-case-low-expr
		f[x.arg]
	as union-as-case-or-gc-safe-low-expr
		f[x.arg]
	as union-is-case-low-expr
		f[x.arg]
	as var-get-low-expr
		false
	as var-set-low-expr
		f[x.value]

| The type of a constant is implicit (given by context).
| This means two constants that look equal may not be the same constant if they have different types
| (e.g., IntegralValue has different sizes.)
constant union
	constant-array
	constant-native-string
	constant-record
	scalar-value
	constant-symbol
	constant-union
	constant-gc-safe-value
do
	hash void(state hash-state)
to json(a constant)
# This assumes the constants are for the same type
== bool(a constant, b constant)
<=> comparison(a constant, b constant)
each-nested-constant void
	all-constants all-constants
	type low-type
	a constant
	f void mut(type low-type, value constant)
do
	f[type, a]
	match a
	as constant-array
		elem = as-array! type
		for x in all-constants[a]
			each-nested-constant all-constants, elem, x, f
	as constant-native-string
		()
	as constant-record
		args = get-record all-constants, type, a
		for arg, field in zip args, type.body.low-record!.fields
			each-nested-constant all-constants, field.type, arg, f
	as scalar-value
		()
	as constant-symbol
		()
	as constant-union
		member-type, _, member = get-union all-constants, type, a
		each-nested-constant all-constants, member-type, member, f
	as constant-gc-safe-value
		()

constant-array record
	| Index of the array type in {all-constants}.{arrays} (TODO: maybe that should just be a map keyed by {low-type}?)
	type-index nat
	| Index within that array type
	index nat
== bool(a constant-array, b constant-array)
<=> comparison(a constant-array, b constant-array)
to json(a constant-array)
hash void(a constant-array, state hash-state)
| Constant Java or JS string
constant-native-string record(value string)
== bool(a constant-native-string, b constant-native-string)
<=> comparison(a constant-native-string, b constant-native-string)
hash void(a constant-native-string, state hash-state)
to json(a constant-native-string)
| Index into {all-constants}.{records}
constant-record record(index nat)
== bool(a constant-record, b constant-record)
<=> comparison(a constant-record, b constant-record)
hash void(a constant-record, state hash-state)
to json(a constant-record)
	a.index.to
constant-symbol record(index nat)
== bool(a constant-symbol, b constant-symbol)
<=> comparison(a constant-symbol, b constant-symbol)
hash void(a constant-symbol, state hash-state)
to json(a constant-symbol)
| Index into {all-constants}.{unions}
constant-union record(index nat)
== bool(a constant-union, b constant-union)
<=> comparison(a constant-union, b constant-union)
hash void(a constant-union, state hash-state)
to json(a constant-union)
	a.index.to
constant-union-value record(case-index nat, value constant)
== bool(a constant-union-value, b constant-union-value)
<=> comparison(a constant-union-value, b constant-union-value)
hash void(a constant-union-value, state hash-state)
constant-gc-safe-value record
== bool(a constant-gc-safe-value, b constant-gc-safe-value)
<=> comparison(a constant-gc-safe-value, b constant-gc-safe-value)
to json(a constant-gc-safe-value)
hash void(a constant-gc-safe-value, state hash-state)
as-bool bool(a constant)
	a.scalar-value!.to
as-float float64(a constant)
	match a
	as constant-gc-safe-value
		trusted nan
	as scalar-value
		a.to
	else
		throw unreachable
