import
	keen/bits
	keen/parse
	keen/string/util
	../../lib/private/parse-util
	../util/util

path record(to symbol) -new

as-path path(a string-view)
	a.to,

-parent-and-base-name (path, string)?(a path)
	if left, right = try-split-once-right a.to::string, "/"
		(left.to,), right.to
is-empty bool(a path) = a.to::symbol == ""
base-name string(a path)
	a.parent-and-base-name.?b else a.to
test
	("a/b",)::path.base-name is "b"
to string(a path)
	a.to::symbol.to
show string(a path)
	a.to
to json(a path)
	a.to::string.to
parent path?(a path)
	a.parent-and-base-name.?a
test
	("a",)::path.parent is ()
	("a/b",)::path.parent is ("a",)
root-path path(first-component symbol)
	res path = first-component,
	forbid res.parent
	res
/ path(a path, b string)
	if is-empty b
		a
	else
		"{a}/{b}",
test
	a path = "a",
	a / "" is a
	a / "b" is "a/b",

| Returns an empty path if they are exactly the same
starts-with bool(a path, start path) = try-remove-start a, start
try-remove-start path?(a path, start path)
	if rest = try-remove-start a.to::string, start.to::string
		if rest == ""
			as-path ""
		else
			?as-path try-remove-start rest, "/"
test
	a path = as-path "a"
	a-b path = as-path "a/b"
	a-b-c path = as-path "a/b/c"
	try-remove-start a-b-c, a is as-path "b/c"
	try-remove-start a-b-c, a-b is as-path "c"
	try-remove-start a-b-c, a-b-c is as-path ""
	try-remove-start a-b, a-b-c is ()
	try-remove-start "ab/c".as-path, a is ()

assume-path path(a symbol)
	a,
assume-file-path file-path(a symbol)
	a,

parse-path path(a string-view)
	- parse-path-inner a, false 'to
test
	parse-path "a/" is root-path "a"
	parse-path "a/b\\c" is "a".root-path / "b" / "c"
-parse-path-inner string(a string-view, uri-decode bool)
	iter = a.begin
	res string = with out in build
		parse-path-component out, iter, uri-decode
		until iter.is-at-end
			out ~= "/"
			parse-path-component out, iter, uri-decode
	if res.is-windows-path then res.lower-case else res
-parse-path-component void(out char8 builder, iter string-iterator, uri-decode bool)
	do until
	do unless is-at-end iter else true
	x = iter.take-next
	if x == "%" and uri-decode
		out ~~= if x0 = ?decode-hex-digit try-take-next iter and x1 = ?decode-hex-digit try-take-next iter
			decoded char8 = (x0 << 4) | x1 'to
			decoded.lower-case,
		else
			"�"
		false
	elif x.is-slash
		true
	else
		out ~= x
		false

file-path record(to symbol) -new
to path(a file-path)
	a.to,
base-name string(a file-path)
	a.to::path.base-name
root-file-path file-path(a symbol)
	a.root-path.to,
to string(a file-path)
	a.to::symbol.to
show string(a file-path)
	a.to
to json(a file-path)
	a.to::string.to
parent file-path?(a file-path)
	if p = a.to::path.parent
		- p.to
parent-or-empty file-path(a file-path)
	a.parent else a
/ file-path(a file-path, component string)
	- "{a}/{if a.is-windows-path then component.lower-case else component}"
test
	("/a/b",)::file-path / "CAPS" is ("/a/b/CAPS",)
	("c:/blah",)::file-path / "CAPS" is ("c:/blah/caps",)
is-windows-path bool(a file-path)
	a.to::string.is-windows-path

uri record(to symbol) -new
-file-scheme string()
	"file://"
as-file-path file-path?(a uri)
	do if res = try-remove-start a.to::string, file-scheme
	path char8[] = parse-path-inner res, true 'to
	# A uri has a "/" before a Windows path, like `file:///c%3a`; a file-path does not.
	str string = if not is-empty path and path[0] == "/" and path[1 .. end].is-windows-path
		path[1 .. end].to
	else
		path.to
	str.to,
test
	("file:///a/b",).as-file-path is ("/a/b",)
	("file://c:/foo",).as-file-path is ("c:/foo",)
to string(a uri)
	a.to::symbol.to
show string(a uri)
	a.to::symbol.to
to json(a uri)
	a.to::symbol.to
to uri(a json)
	- a.to::symbol
parent uri?(a uri)
	chars char8[] = a.to::string.to
	if index = last-index-of chars, "/"
		first-index = index-of! chars, "/"
		unless index == first-index + 1
			res string = chars[0 .. index].to
			res.to,
test
	("file:///home/keen",)::uri.parent is ("file:///home",)
	("file:///home",)::uri.parent is ("file://",)
	("file://",)::uri.parent is ()
parent-or-empty uri(a uri)
	a.parent else a

new uri() = "",

is-ancestor-of bool(a uri, b uri)
	starts-with b.to::string, "{a.to::string}/"
is-ancestor-of bool(a path, b path)
	starts-with b.to::string, "{a.to::string}/"

base-name string(a uri)
	(a.to,)::path.base-name
# Return value will start with a "." unless it is the empty string
get-extension symbol(a path)
	a.base-name.get-extension
get-extension symbol(a uri)
	a.base-name.get-extension
test
	("",)::path.get-extension is ""
	("a.txt",)::path.get-extension is ".txt"
	("a.txt.exe",)::path.get-extension is ".exe"
	("a/b",)::path.get-extension is ""
	("a/b.txt",)::path.get-extension is ".txt"
	("a.txt/b",)::path.get-extension is ""
without-extension file-path?(a file-path, extension string)
	?new without-extension a.to::symbol, extension
-without-extension symbol?(a symbol, ext string)
	?to try-remove-end a.to::string, ext

-get-extension symbol(base-name string)
	if _, r = try-split-once-right base-name, "."
		".{r}"
	else
		""
get-extension symbol(a file-path)
	a.to::path.get-extension
extension symbol(a uri)
	a.base-name.get-extension
is-extensionless bool(a uri)
	a.extension == ""
-alter-extension symbol(a symbol, old-extension string, new-extension string)
	"{without-extension! a, old-extension}{new-extension}"
alter-extension file-path(a file-path, old-extension string, new-extension string)
	- alter-extension a.to, old-extension, new-extension

add-to-base-name path(a path, rest string)
	forbid contains rest, "/"
	"{a}{rest}",

/ uri(a uri, b string)
	if is-empty b
		a
	elif is-windows-path a
		"{a}/{b.lower-case}",
	else
		"{a}/{b}",
test
	a uri = "file:///c%3a/foo",
	a / "" is a
	a / "BAR" is ("file:///c%3a/foo/bar",)

/ path(a path, b path)
	a / b.to::string
/ uri(a uri, b path)
	fixed-b = if a.is-windows-path then b.to.lower-case else b.to
	- "{a.to::string}/{fixed-b}"

assume-uri uri(a symbol)
	a,
parse-uri uri(a string)
	chars char8[] = a.to
	assert colon = index-of chars, ":" else parse-error a, 0, "URI"
	start = if colon < chars.size - 2 and chars[colon + 1] == "/" and chars[colon + 2] == "/"
		colon + 3
	else
		colon + 1
	schema string = chars[0 .. start].to
	if schema == file-scheme and chars.size >= start + 5 and chars[start .. start + 5].to::char8[] == "/C%3A"
		a.lower-case.to,
	else
		a.to,
is-windows-path bool(a uri)
	(f = as-file-path a) and is-windows-path f
test
	("file:///",)::uri.is-windows-path is false
	("file://c%3a",)::uri.is-windows-path is true
parse-uri-with-cwd uri(cwd uri, text string)
	if looks-like-absolute-path text
		parse-file-path text 'to
	elif looks-like-uri text
		parse-uri text
	else
		resolve-uri-from-dir cwd, parse-rel-path text else throw todo
-looks-like-absolute-path bool(a string)
	starts-with a, "/" or a.is-windows-path
-looks-like-uri bool(a string)
	contains-seq a, "://"
test
	looks-like-uri "file://foo" is true
	looks-like-uri "/a/b" is false
-is-windows-path bool(a string)
	is-windows-path a.to::char8[]
-is-windows-path bool(a string-view)
	if a.size >= 3
		a[0 .. 2].is-windows-path-start and a[2].is-slash
	elif a.size == 2
		a.is-windows-path-start
test
	is-windows-path "C:\\Users" is true
	is-windows-path "c:/users" is true
	is-windows-path "aa:/b" is false
is-windows-path-start bool(a string-view)
	a.size == 2 and a[0].is-letter and a[1] == ":"

test
	file-a uri = "file:///a",
	file-ab uri = "file:///a/b",
	file-xy uri = "file:///x/y",
	file-abxy uri = "file:///a/b/x/y",
	file-axy uri = "file:///a/x/y",
	parse-uri-with-cwd file-ab, "file:///x/y" is file-xy
	parse-uri-with-cwd file-ab, "x/y" is file-abxy
	parse-uri-with-cwd file-ab, "../x/y" is file-axy
	parse-uri-with-cwd file-ab, "." is file-ab
	parse-uri-with-cwd file-ab, ".." is file-a

parse-uri-with-cwd uri(cwd file-path, text string)
	parse-uri-with-cwd cwd.to::uri, text
parse-file-path-with-cwd file-path?(cwd file-path, text string)
	as-file-path parse-uri-with-cwd cwd, text
must-parse-file-path file-path(text string)
	parse-file-path text
parse-file-path file-path(a string) = parse-file-path to::string-view a
parse-file-path file-path(a string-view)
	is-windows = a.is-windows-path
	fixed-a string-view = if is-windows
		a.to.lower-case.to
	else
		try-remove-start a, "/" else a.to
	path = parse-path-inner fixed-a, false
	- if is-windows then path.to else "/{path}"
test
	parse-file-path "a/b" is ("/a/b",)
	parse-file-path "/a/b" is ("/a/b",)
	parse-file-path "a\\b" is ("/a/b",)
	parse-file-path "C:\\User\\CAPPY" is ("c:/user/cappy",)

to uri(a file-path)
	"{file-scheme}{if a.is-windows-path then "/"}{a.to.uri-encode}",
test
	fp file-path = "/a/b",
	fp.to::uri is ("file:///a/b",)

rel-path record(n-parents nat, path path)
show string(a rel-path)
	parents = if a.n-parents == 0
		"./"
	else
		repeat "../", a.n-parents
	if is-empty a.path
		parents[0 .. end - 1].to
	else
		"{parents}{a.path}"
to json(a rel-path) =a.show.to
test
	(0, ("a",))::rel-path.show is "./a"
	(1, ("a",))::rel-path.show is "../a"
	(2, ("a",))::rel-path.show is "../../a"
parse-rel-path rel-path(text string)
	match text
	as "."
		0, ("",)
	as ".."
		1, ("",)
	else
		n-parents mut = 0
		cur mut string-view = text.to
		do until
		if cur.size >= 2 and cur[0] == "." and cur[1].is-slash
			cur := cur[2 .. end]
			()
		elif cur.size >= 3 and cur[0] == "." and cur[1] == "." and cur[2].is-slash
			n-parents +:= 1
			cur := cur[3 .. end]
			()
		else
			forbid cur.size >= 1 and cur[0] == "/" else todo
			n-parents, parse-path cur.to
test
	"".parse-rel-path is (0, ("",))
	".".parse-rel-path is (0, ("",))
	"..".parse-rel-path is (1, ("",))
	"a".parse-rel-path is (0, ("a",))
	"./a".parse-rel-path is (0, ("a",))
	"../a".parse-rel-path is (1, ("a",))
	".././../a".parse-rel-path is (2, ("a",))
-is-slash bool(a char8)
	a == "/" or a == "\\"

uris-info record
	cwd uri?
	keen-lib uri

show-uri-prefer-relative string(uris-info uris-info, a uri)
	components = a.to.components
	if x = try-remove-start components, uris-info.keen-lib.to.components
		show-components "keen"::string-view ~ x, false
	elif uris-info.cwd and y = try-remove-start components, uris-info.cwd.to.components
		show-components y, false
	else
		show-components components, true
test
	info uris-info =
		cwd: "file://a/b",
		keen-lib: "file://keen/lib",
	show-uri-prefer-relative info, ("file://a/b/c/d",) is "c/d"
	show-uri-prefer-relative info, ("file://x/y/c/d",) is "file://x/y/c/d"
	show-uri-prefer-relative info, ("file://keen/lib/json.keen",) is "keen/json.keen"

-components string-view[](a string)
	split a, "/"

-show-components string(components string-view array-view, uri-encode bool)
	join "/", for index, component in with-index components
		# First component of a Uri is the scheme, which is not encoded
		if uri-encode and index != 0
			encode-path-component component
		else
			component.to
-uri-encode string(a string)
	do with out in build
	do for x in a
	if x == "/"
		out ~= x
	else
		encode-char out, x

-encode-path-component string(component string-view)
	with out in build
		for x in component
			encode-char out, x
-encode-char void(out char8 builder, a char8)
	if is-uri-safe-char a
		out ~= a
	else
		out ~= "%"
		out ~~= encode-as-hex a.to

-is-uri-safe-char bool(a char8)
	is-ascii-identifier-char a or a == "-" or a == "." or a == "~"

encode-as-hex char8[](a nat8)
	(a >> 4).encode-as-hex-digit, (a & 0xf).encode-as-hex-digit
-encode-as-hex-digit char8(a nat8)
	assert a <= 0xf
	res char8 = if a <= 9
		"0"::char8.to + a 'to
	else
		"a"::char8.to + (a - 10) 'to
	decode-hex-digit res is a
	res

add-extension file-path(a file-path, extension symbol)
	- add-extension a.to, extension
add-extension uri(a uri, extension symbol)
	- add-extension a.to, extension
-add-extension symbol(a symbol, extension symbol)
	"{a}{extension}"

resolve-uri-from-file uri?(from-file uri, relative rel-path)
	if dir = from-file.parent
		resolve-uri-from-dir dir, relative
resolve-uri-from-dir uri?(from-dir uri, relative rel-path)
	if res = resolve-path (from-dir.to,), relative
		res.to,
-resolve-path path?(from-dir path, relative rel-path)
	if relative.n-parents == 0
		from-dir / relative.path
	elif par = from-dir.parent
		resolve-path par, (relative.n-parents - 1, relative.path)
test
	resolve-uri-from-file ("file:///foo/a.keen",), (0, ("b.keen",)) is ("file:///foo/b.keen",)
	resolve-uri-from-file ("file:///a.keen",), (0, ("b.keen",)) is ("file:///b.keen",)

# TODO: these were in testUri.d. These should probably be broken up to go near the relevant functions
test
	a = parse-uri "file:///a"
	to::string a is "file:///a"
	b = parse-uri "file:///b"
	a is a
	a <=> b is less

	a-x = a / "x"
	a / "x" is a-x
	a-y = a / "y"
	to::string a-y is "file:///a/y"

	z-w = parse-uri-with-cwd a-x, "/z/w.keen"
	to::string z-w is "file:///z/w.keen"
	base-name z-w is "w.keen"
	extension z-w is ".keen"
	a-x-z-w = parse-uri-with-cwd a-x, "./z/w"
	to::string a-x-z-w is "file:///a/x/z/w"
	parse-uri-with-cwd a-x, "z/w" is a-x-z-w
	parse-uri-with-cwd a-x, "../y" is a-y

	keen-lang = parse-uri "http://keen.codes"
	parse-uri-with-cwd a-x, "http://keen.codes" is keen-lang

	parent keen-lang is ()
	extension keen-lang is ".codes"

test
	verify-file "file:///home/keen/a.txt", "/home/keen/a.txt", ("home", "keen", "a.txt")
	win-upper = "file:///C%3A/Users/User/a.txt"
	win-lower = "file:///c%3a/users/user/a.txt"
	verify-file win-upper, win-lower, "C:\\Users\\User\\a.txt", "c:/users/user/a.txt",
		"c:", "users", "user", "a.txt"

	a-uri = parse-uri "file:///C%3A/Users/User/a"
	to::string a-uri is "file:///c%3a/users/user/a"
	is-windows-path a-uri is true
	boo-uri = a-uri / "BOO"
	to::string boo-uri is "file:///c%3a/users/user/a/boo"
	is-windows-path boo-uri is true

	a = parse-file-path "C:\\Users\\User\\a"
	"c:/users/user/a".parse-file-path is a
	is-windows-path a is true
	boo = a / "BOO"
	to::string boo is "c:/users/user/a/boo"
	is-windows-path boo is true

	a-txt = parse-file-path "/foo/a.txt"
	is-windows-path a-txt is false
	a-f00d-json = alter-extension a-txt, ".txt", ".f00d.json"
	to::string a-f00d-json is "/foo/a.f00d.json"

	a-f00d-keen = alter-extension a-f00d-json, ".json", ".keen"
	to::string a-f00d-keen is "/foo/a.f00d.keen"

-verify-file void(uri string, file-path string, components string[])
	verify-file uri, uri, file-path, file-path, components
-verify-file void(uri-in string, uri-out string, file-path-in string, file-path-out string, components string[])
	uri = parse-uri uri-in
	file-path = parse-file-path file-path-in
	as-file-path uri is file-path
	to::uri file-path is uri

	test-components file-path.to is components

	to::string uri is uri-out
	to::string file-path is file-path-out

-test-components string[](a path)
	to reverse with::string[] out in build
		cur mut = a
		while p = parent cur
			out ~= base-name cur
			cur := p
		unless cur.to::string.is-empty
			out ~= base-name cur

jar-and-class record
	jar-path file-path
	| Includes '.class'
	class-path-including-extension path
class-path-excluding-extension path(a jar-and-class)
	assume-path to::symbol try-remove-end! a.class-path-including-extension.to::string, ".class"
make-jar-and-class-uri uri(jar-uri uri, class-path path)
	assert as-file-path jar-uri
	get-extension class-path is ""
	assume-uri "jar:{jar-uri}!/{class-path}.class"
as-jar-and-class-uri jar-and-class?(a uri)
	rest = try-remove-start a.to::string, "jar:file:///"
	if starts-with a.to::string, "jar:"
		assert rest
	do if rest
	assert jar-path, class-path = try-split-once rest, "!/"
	jar-path.parse-file-path, class-path.parse-path

test
	as-jar-and-class-uri assume-uri "jar:file:///path/to/foo.jar!/org/foo/Main.class" is
		jar-path: assume-file-path "/path/to/foo.jar"
		class-path-including-extension: as-path "org/foo/Main.class"
