import
	../frontend/show-model
	./low-model
	./model
	./source-range

show-low-fun-name string(a low-fun) show-ctx
	where = line-and-column-getters[a.range].start
	match a.source
	as low-fun-source-regular
		"{a.source.decl.name}{show-low-type-args-post a.source.type-args} {where}" # TODO: include spec impls
	as low-fun-source-new-interface-method-impl
		"impl"
	as low-fun-source-test
		"test {where}"
	as low-fun-source-test-all
		"run-all-tests {where}"

show-low-type string(a low-type) show-ctx
	match a.source
	as low-type-source-bogus
		"BOGUS"
	as low-type-source-inst
		"{show-low-type-args-pre a.source.type-args}{a.source.decl.name}"
	as low-type-source-new-interface
		"new {show-low-type a.source.interface_}"

show-low-type-args-pre string(type-args low-type[]) show-ctx
	match type-args.size
	as 0
		""
	as 1
		"{show-low-type only! type-args} "
	else
		"({join ", ", map type-args, it.show-low-type}) "

-show-low-type-args-post string(a low-type[]) show-ctx
	show-type-args-generic a, {false}, it.show-low-type
