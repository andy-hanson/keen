import
	keen/bits
	keen/unsafe
	../../lib/col/experimental/object-memoizer
	../util/by-key
	../util/util
	./parse-diag
	./source-range
	./uri

mutability enum(data_, shared_, mut_)
to symbol(a mutability)
	match a
	as data_
		"data"
	as shared_
		"shared"
	as mut_
		"mut"
to string(a mutability)
	a.to::symbol.to
show string(a mutability)
	a.to::string
to json(a mutability)
	a.to::string.to

sum-type-kind enum(java-interface, interface_, union_, variant_)
to symbol(a sum-type-kind)
	match a
	as java-interface
		"java-interface"
	as interface_
		"interface"
	as union_
		"union"
	as variant_
		"variant"
var-kind enum(global_, thread-local_)

string-of-var-kind-lower-case string(a var-kind)
	match a
	as global_
		"global"
	as thread-local_
		"thread-local"

string-of-var-kind-upper-case string(a var-kind)
	match a
	as global_
		"Global"
	as thread-local_
		"Thread-local"

visibility enum(private, internal, public)
export-visibility enum(internal, public)

-names-and-arities global((name-and-arity, (symbol, nat32)) object-memoizer) = ()
name-and-arity record(name symbol, arity nat32) -new
hash nat((name symbol, arity nat32)) = trusted name.hash-value ^ arity
hash-value nat(a name-and-arity) = a.name.hash-value ^ a.arity
-memoizer-key (symbol, nat32)(a name-and-arity) = a.name, a.arity
get-name-and-arity name-and-arity(name symbol, arity nat)
	trusted memoize names-and-arities, (name, arity.to), {name, arity.to}
== bool(a name-and-arity, b name-and-arity) = trusted reference-equal a, b

name-and-range record(start pos, name symbol)
end pos(a name-and-range)
	a.start + a.name.to::char8[].size.to
range source-range(a name-and-range)
	range-of-start-and-length a.start, a.name.to::char8[]

field-mutability-ast record(pos pos, visibility_ visibility?)
range source-range(a field-mutability-ast)
	range-of-start-and-length a.pos, if a.visibility_ then "-mut" else "mut"
visibility visibility-and-range?(a field-mutability-ast)
	get-visibility-and-range a.pos, a.visibility_

visibility-and-range record(visibility visibility, pos pos)
range source-range(a visibility-and-range)
	range-of-start-and-length a.pos, "+"

-get-visibility-and-range visibility-and-range?(pos pos, visibility visibility?)
	if visibility
		visibility, pos

the-ast record(start pos, type type-ast)
end pos(a the-ast)
	a.type.end
keyword-range source-range(a the-ast)
	range-of-start-and-length a.start, "the"

type-ast union
	bogus-type-ast
	fun-type-ast
	map-type-ast
	name-and-range
	suffix-name-type-ast
	suffix-special-type-ast
	tuple-type-ast
do
	range source-range()
start pos(a type-ast) = a.range.start
end pos(a type-ast) = a.range.end
name-range-or-range source-range(a type-ast)
	match a
	as bogus-type-ast
		range a
	as fun-type-ast
		kind-range a
	as map-type-ast
		range a
	as name-and-range
		range a
	as suffix-name-type-ast
		suffix-range a
	as suffix-special-type-ast
		suffix-range a
	as tuple-type-ast
		range a

bogus-type-ast record(range source-range)
fun-type-ast record
	return-type type-ast
	kind-pos pos
	kind mutability
	param destructure-ast
range source-range(a fun-type-ast)
	a.return-type.start, a.param.end
kind-range source-range(a fun-type-ast)
	range-of-start-and-length a.kind-pos, a.kind.to::symbol.to

map-type-ast record(kind mutability, value type-ast, key type-ast)
range source-range(a map-type-ast)
	a.value.range.start, a.key.range.end + "]"::char8[].size.to

suffix-name-type-ast record(left type-ast, name name-and-range)
range source-range(a suffix-name-type-ast)
	a.left.start, a.suffix-range.end
suffix-range source-range(a suffix-name-type-ast)
	a.name.range

suffix-special-type-ast record(left type-ast, suffix-pos pos, kind suffix-special-type-ast-kind)
suffix-special-type-ast-kind enum(array, mut-array, option, shared-array)
range source-range(a suffix-special-type-ast)
	a.left.range.start, a.suffix-end
suffix-range source-range(a suffix-special-type-ast)
	a.suffix-pos, a.suffix-end
-suffix-end pos(a suffix-special-type-ast)
	a.suffix-pos + a.kind.suffix.to::char8[].size.to

-suffix string(a suffix-special-type-ast-kind)
	match a
	as array
		"[]"
	as mut-array
		"mut[]"
	as option
		"?"
	as shared-array
		"shared[]"

tuple-type-ast record(range source-range, members type-ast[])

expr-ast union
	assert-or-forbid-ast
	assignment-ast
	assignment-call-ast
	bogus-ast
	call-ast-dot
	call-ast-dot-question
	call-ast-infix
	call-ast-prefix
	call-ast-prefix-question
	call-ast-prefix-with-type-arg
	call-named-ast
	call-subscript-ast
	call-question-subscript-ast
	finally-ast
	force-ast
	for-or-with-ast
	name-and-range
	if-ast
	interpolated-ast
	is-or-isnt-ast
	it-ast
	it-scope-ast
	lambda-ast
	let-ast
	let-the-ast
	list-ast
	literal-number
	literal-string-ast
	logical-ast
	match-ast
	parenthesized-ast
	seq-ast
	shared-ast
	the-ast
	throw-ast
	trusted-ast
	try-ast
	try-let-ast
	typed-ast
	underscore-ast
	unpack-option-ast
	while-or-until-body-ast
	while-or-until-ast
do
	start pos()
	end pos()
range source-range(a expr-ast)
	a.start, a.end

assert-or-forbid-ast record
	start pos
	is-forbid bool
	condition expr-ast
	thrown assert-or-forbid-thrown-ast?
	after expr-ast?
end pos(a assert-or-forbid-ast)
	if after = a.after
		end after
	elif thrown = a.thrown
		end thrown
	else
		end a.condition
range source-range(a assert-or-forbid-ast)
	a.start, a.end
keyword-range source-range(a assert-or-forbid-ast)
	"assert"::char8[].size is "forbid"::char8[].size
	range-of-start-and-length a.start, "assert"

assert-or-forbid-thrown-ast record(else-pos pos, expr expr-ast)
else-range source-range(a assert-or-forbid-thrown-ast)
	range-of-start-and-length a.else-pos, ":"
end pos(a assert-or-forbid-thrown-ast)
	a.expr.end

| {left} := {right}
assignment-ast record(left expr-ast, assignment-pos pos, right expr-ast)
start pos(a assignment-ast) = a.left.start
end pos(a assignment-ast) = a.right.end
range source-range(a assignment-ast) = a.start, a.end
keyword-range source-range(a assignment-ast)
	range-of-start-and-length a.assignment-pos, ":="

| {left} {fun-name}:= {right}"
assignment-call-ast record
	fun-pos pos
	| Arity is always 2
	fun-name name-and-arity
	left expr-ast
	right expr-ast
assignment-call-ast assignment-call-ast(fun-pos pos, fun-name symbol, left expr-ast, right expr-ast)
	fun-pos, (get-name-and-arity fun-name, 2), left, right
start pos(a assignment-call-ast) = a.left.start
end pos(a assignment-call-ast) = a.right.end
range source-range(a assignment-call-ast) = a.start, a.end
name-range source-range(a assignment-call-ast) = range name-and-range a.fun-pos, a.fun-name.name
keyword-range source-range(a assignment-call-ast)
	range-of-start-and-length a.name-range.end, ":="

bogus-ast record(range source-range)
start pos(a bogus-ast) = a.range.start
end pos(a bogus-ast) = a.range.end

call-ast-dot record
	left expr-ast
	fun-pos pos
	fun-name name-and-arity
call-ast-dot call-ast-dot(left expr-ast, name name-and-range)
	left, name.start, get-name-and-arity name.name, 1
start pos(a call-ast-dot) = a.left.start
end pos(a call-ast-dot) = a.name-range.end
name-range source-range(a call-ast-dot) = range name-and-range a.fun-pos, a.fun-name.name
range source-range(a call-ast-dot) = a.start, a.end

call-ast-dot-question record
	left expr-ast
	fun-pos pos
	fun-name name-and-arity
call-ast-dot-question call-ast-dot-question(left expr-ast, name name-and-range)
	left, name.start, get-name-and-arity name.name, 1
start pos(a call-ast-dot-question) = a.left.start
end pos(a call-ast-dot-question) = a.name-range.end
name-range source-range(a call-ast-dot-question) = range name-and-range a.fun-pos, a.fun-name.name
name-range-including-question source-range(a call-ast-dot-question) = a.question-pos, a.name-range.end
question-pos pos(a call-ast-dot-question) = a.start
range source-range(a call-ast-dot-question) = a.start, a.end

| E.g., `a + b` or `a 'foo b, c`
call-ast-infix record
	fun-pos pos
	fun-name name-and-arity
	args expr-ast[]
call-ast-infix call-ast-infix(name-pos pos, name symbol, args expr-ast[])
	name-pos, (get-name-and-arity name, args.size), args
range source-range(a call-ast-infix) = a.start, a.end
start pos(a call-ast-infix) = a.args[0].start
end pos(a call-ast-infix)
	if a.args.size == 1 then a.name-range.end else a.args[end - 1].end
name-range source-range(a call-ast-infix)
	range name-and-range a.fun-pos, a.fun-name.name

| This will never have empty args; that is a {name-and-range} instead.
call-ast-prefix record
	start pos
	fun-name name-and-arity
	args expr-ast[]
call-ast-prefix call-ast-prefix(start pos, fun-name symbol, args expr-ast[])
	start, (get-name-and-arity fun-name, args.size), args
name-range source-range(a call-ast-prefix) = range name-and-range a.start, a.fun-name.name
range source-range(a call-ast-prefix) = a.start, a.end
end pos(a call-ast-prefix) = a.args[end - 1].end

call-ast-prefix-question record
	start pos
	fun-name name-and-arity
	args expr-ast[]
call-ast-prefix-question call-ast-prefix-question(start pos, fun-name symbol, args expr-ast[])
	start, (get-name-and-arity fun-name, args.size), args
name-start pos(a call-ast-prefix-question) = a.start + 1
name-range source-range(a call-ast-prefix-question) = range name-and-range a.name-start, a.fun-name.name
name-range-including-question source-range(a call-ast-prefix-question) = a.question-pos, a.name-range.end
question-pos pos(a call-ast-prefix-question) = a.start
range source-range(a call-ast-prefix-question) = a.start, a.end
end pos(a call-ast-prefix-question)
	if is-empty a.args
		a.name-range.end
	else
		a.args[end - 1].end

| Unlike {call-ast-prefix}, this can have empty args.
call-ast-prefix-with-type-arg record
	start pos
	fun-name name-and-arity
	type-arg type-ast
	args expr-ast[]
call-ast-prefix-with-type-arg call-ast-prefix-with-type-arg(start pos, name symbol, type-arg type-ast, args expr-ast[])
	start, (get-name-and-arity name, args.size), type-arg, args
range source-range(a call-ast-prefix-with-type-arg) = a.start, a.end
name-range source-range(a call-ast-prefix-with-type-arg) = range name-and-range a.start, a.fun-name.name
end pos(a call-ast-prefix-with-type-arg)
	if is-empty a.args
		a.type-arg.end
	else
		a.args[end - 1].end

name-or-string-ast union(name-and-range, literal-string-ast, interpolated-ast, it-scope-ast)
	range source-range()
	start pos()
	to json()
name symbol?(a name-or-string-ast)
	match a
	as it-scope-ast
		()
	as name-and-range
		a.name
	as literal-string-ast
		a.value.to
	as interpolated-ast
		()
call-named-ast record(names name-or-string-ast[], args expr-ast[])
start pos(a call-named-ast) = a.names[0].start
end pos(a call-named-ast) = a.args[end - 1].end
range source-range(a call-named-ast) = a.start, a.end

| `left[right]`
call-subscript-ast record
	left expr-ast
	keyword-pos pos
	right expr-ast
	end pos
range source-range(a call-subscript-ast) = a.start, a.end
start pos(a call-subscript-ast) = a.left.start
subscript-range source-range(a call-subscript-ast) =a.keyword-pos, a.end

| `left?[right]`
call-question-subscript-ast record
	left expr-ast
	keyword-pos pos
	right expr-ast
	end pos
range source-range(a call-question-subscript-ast) = a.start, a.end
start pos(a call-question-subscript-ast) = a.left.start
question-pos pos(a call-question-subscript-ast) = a.keyword-pos
subscript-range source-range(a call-question-subscript-ast) =a.keyword-pos, a.end

finally-ast record(start pos, right expr-ast, below expr-ast)
end pos(a finally-ast)
	a.below.end
range source-range(a finally-ast)
	a.start, a.end
finally-keyword-range source-range(a finally-ast)
	range-of-start-and-length a.start, "finally"

force-ast record
	arg expr-ast
	keyword-pos pos
start pos(a force-ast) = a.arg.start
end pos(a force-ast) = max a.keyword-range.end, a.arg.end
range source-range(a force-ast) = a.start, a.end
keyword-range source-range(a force-ast) = a.keyword-pos, a.keyword-pos + 1

for-or-with-ast record
	start pos
	keyword for-or-with-ast-keyword
	param destructure-ast
	in-pos pos
	| 'max-value' if there was not an 'then' keyword
	then-pos pos
	arg expr-ast
	body expr-ast
for-or-with-ast-keyword enum(for_, for-star, with_)
-size nat32(a for-or-with-ast-keyword)
	match a
	as for_
		3
	as for-star
		4
	as with_
		4
end pos(a for-or-with-ast)
	a.body.end
range source-range(a for-or-with-ast)
	a.start, a.end
keyword-range source-range(a for-or-with-ast)
	range-of-start-and-length a.start, a.keyword.size
in-range source-range(a for-or-with-ast)
	range-of-start-and-length a.in-pos, "else"
then-range source-range?(a for-or-with-ast)
	unless a.then-pos == max-value
		range-of-start-and-length a.then-pos, "then"

if-ast record
	start pos
	is-unless bool
	kind if-ast-kind
	| {if-without-else}, {if-elif}, and {if-else} could all be the 'else' branch of a preceding 'if'
	is-else-of-parent bool
	| Position of 'then', 'elif', or 'else'. 'max-value' if there is no second keyword.
	second-keyword-pos pos
	| Position of 'else' in 'if ... then ... else'. 'max-value' otherwise.
	third-keyword-pos pos
	condition expr-ast
	| This may not be present for a 'do if' or 'do unless'
	first-branch expr-ast?
	second-branch expr-ast?
if-ast-kind enum
	do-if
	do-if-else
	if-without-else
	| In this case, the 'elif' expression will be another IfAst
	if-elif
	| Has 'if' and 'else' keywords, no 'elif' (though this may begin as an 'elif')
	if-else
	if-then
	if-then-else
end pos(a if-ast)
	if x = a.second-branch
		x.end
	elif x = a.first-branch
		x.end
	else
		a.condition.end
range source-range(a if-ast)
	a.start, a.end
is-condition-negated bool(a if-ast)
	a.is-unless != match a.kind
	as do-if
		true
	as do-if-else
		true
	as if-elif
		false
	as if-else
		false
	as if-without-else
		false
	as if-then
		false
	as if-then-else
		false
first-keyword-range source-range(a if-ast)
	do-if-unless char8[] = if a.is-unless then "do unless" else "do if"
	if-unless char8[] = if a.is-unless then "unless" else "if"
	range-of-start-and-length a.start, match a.kind
	as do-if
		do-if-unless
	as do-if-else
		do-if-unless
	as if-elif
		if-unless
	as if-else
		if-unless
	as if-then
		if-unless
	as if-then-else
		if-unless
	as if-without-else
		if-unless
second-keyword-range source-range?(a if-ast)
	keyword char8[]? = match a.kind
	as do-if
		()
	as do-if-else
		"else"
	as if-elif
		"else"
	as if-else
		"else"
	as if-then
		"then"
	as if-then-else
		"then"
	as if-without-else
		()
	if keyword
		range-of-start-and-length a.second-keyword-pos, keyword
third-keyword-range source-range?(a if-ast)
	if a.kind == if-then-else
		range-of-start-and-length a.third-keyword-pos, "else"

interpolated-ast record
	quote-kind quote-kind
	template interpolated-template-part[]
	interpolated expr-ast[]
range source-range(a interpolated-ast)
	a.start, a.end
start pos(a interpolated-ast) = a.template[0].range.start
end pos(a interpolated-ast) = a.template[end - 1].range.end
quote-kind enum(bar, double, indented)
interpolated-template-part record
	range source-range
	value string

is-or-isnt-ast record
	left expr-ast
	keyword-pos pos
	is-isnt bool
	right expr-ast
	else_ expr-ast?
start pos(a is-or-isnt-ast) = a.left.start
end pos(a is-or-isnt-ast) = (a.else_ else a.right).end
range source-range(a is-or-isnt-ast) = a.start, a.end
keyword-range source-range(a is-or-isnt-ast)
	range-of-start-and-length a.keyword-pos,
		if a.is-isnt then "isnt" else "is"

it-ast record(start pos)
end pos(a it-ast) = a.range.end
range source-range(a it-ast) = range-of-start-and-length a.start, "it"

it-scope-ast record
	| If empty, this is an implicit it-scope like for 'it * 2'.
	| If non-empty, this is an explicit it-scope like '\{foo it\}'.
	braces-range source-range?
	inner expr-ast
is-explicit bool(a it-scope-ast) = a.braces-range
start pos(a it-scope-ast) = a.range.start
end pos(a it-scope-ast) = a.range.end
range source-range(a it-scope-ast) = a.braces-range else a.inner.range
it-range source-range(a it-scope-ast)
	if x = first a.its, {it} then x.range else a.range
its record(scope it-scope-ast)
some bool(a its, f bool mut(x it-ast)) = some-it a.scope, f
-some-it bool(a expr-ast, f bool mut(x it-ast))
	some a.children, {it.it-ast and f[it] or some-it it, f}

| An 'it' lambda uses an {it-scope-ast} instead.
lambda-ast record
	start pos
	param destructure-ast
	| {max-value} if there is no 'then' keyword.
	then-pos pos
	body expr-ast
end pos(a lambda-ast)
	a.body.end
range source-range(a lambda-ast)
	a.start, a.end
keyword-range source-range(a lambda-ast)
	range-of-start-and-length a.start, "of"
then-range source-range?(a lambda-ast)
	unless a.then-pos == max-value
		range-of-start-and-length a.then-pos, "then"

destructure-ast union
	name-and-range
	single-destructure-ast
	ignore-destructure-ast
	void-destructure-ast
	destructure-ast[]
start pos(a destructure-ast)
	match a
	as name-and-range
		a.start
	as single-destructure-ast
		a.start
	as ignore-destructure-ast
		a.start
	as void-destructure-ast
		a.range.start
	as array
		a[0].start
end pos(a destructure-ast)
	match a
	as name-and-range
		a.end
	as single-destructure-ast
		a.end
	as ignore-destructure-ast
		a.end
	as void-destructure-ast
		a.range.end
	as array
		a[end - 1].end
range source-range(a destructure-ast)
	a.start, a.end

single-destructure-ast record(name name-and-range, mut_ pos?, type type-ast?, ignore void)
new single-destructure-ast(name name-and-range, mut_ pos?, type type-ast?)
	assert mut_ or type # Otherwise this should be a name-and-range
	name, mut_, type, ()
to json(a single-destructure-ast)
	name: a.name.to
	mut_: a.mut_.to
	type: a.type.to
start pos(a single-destructure-ast) = a.name.start
end pos(a single-destructure-ast)
	if x = a.type
		x.end
	elif x = a.mut-range
		x.end
	else
		a.name.end
doc-comment doc-comment-ast(_ single-destructure-ast) = ()
name-range source-range(a single-destructure-ast) = a.name.range
mut-range source-range?(a single-destructure-ast)
	if x = a.mut_
		range-of-start-and-length x, "mut"

ignore-destructure-ast record(start pos, type type-ast?)
end pos(a ignore-destructure-ast)
	a.type.?end else a.start
underscore-range source-range(a ignore-destructure-ast)
	range-of-start-and-length a.start, "_"

| `()` is a destructure matching only void values
void-destructure-ast record(range source-range)

range source-range(a single-destructure-ast)
	end-range = a.type.?range or a.mut-range else a.name.range
	a.name.start, end-range.end

let-ast record(destructure destructure-ast, value expr-ast, then_ expr-ast?)
start pos(a let-ast) = a.destructure.start
end pos(a let-ast) = (a.then_ else a.value).end

let-the-ast record
	start pos
	type type-ast
	value expr-ast
	then_ expr-ast?
end pos(a let-the-ast)
	a.then_.?end else a.value.end
keyword-range source-range(a let-the-ast)
	range-of-start-and-length a.start, "the"

| Could be `()`, `x, y`, or a multi-line list with `- x` and `-- xs`
list-ast record(range source-range, parts list-ast-part[])
start pos(a list-ast) = a.range.start
end pos(a list-ast) = a.range.end
| Range of the initial '-' or '--'
first-keyword-range source-range(a list-ast)
	if is-empty a.parts
		a.range
	else
		size = match a.parts[0]
		as expr-ast then 1
		as list-ast-part-multi then 2
		a.range[0 .. size]

# Represent singles directly, since they are the most common
list-ast-part union(expr-ast, list-ast-part-multi)
to json(a list-ast-part)
	match a
	as expr-ast
		single: a.to
	as list-ast-part-multi
		multi: a.arg.to
list-ast-part-multi record(arg expr-ast)
list-part-arg expr-ast(a list-ast-part)
	match a
	as expr-ast
		a
	as list-ast-part-multi
		a.arg

literal-number record(range source-range, value number)
start pos(a literal-number) = a.range.start
end pos(a literal-number) = a.range.end

literal-string-ast record(kind quote-kind, range source-range, value string)
start pos(a literal-string-ast) = a.range.start
end pos(a literal-string-ast) = a.range.end

logical-ast record(left expr-ast, kind logical-ast-kind, keyword-pos pos, right expr-ast)
logical-ast-kind enum(and_, else_, or_)
range source-range(a logical-ast) = a.start, a.end
start pos(a logical-ast) = a.left.start
end pos(a logical-ast) = a.right.end
keyword-range source-range(a logical-ast)
	range-of-start-and-length a.keyword-pos, match a.kind
	as and_
		"and"
	as else_
		"else"
	as or_
		"or"

match-ast record
	start pos
	local name-and-range?
	matched expr-ast
	cases case-ast[]
	else_ match-else-ast?
end pos(a match-ast)
	if x = a.else_
		x.end
	elif not is-empty a.cases
		a.cases[end - 1].end
	else
		a.matched.end
range source-range(a match-ast) = a.start, a.end
keyword-range source-range(a match-ast)
	range-of-start-and-length a.start, "match"

parenthesized-ast record(range source-range, inner expr-ast)
start pos(a parenthesized-ast) = a.range.start
end pos(a parenthesized-ast) = a.range.end

case-ast record(keyword-pos pos, member case-member-ast, then_ expr-ast)
end pos(a case-ast)
	a.then_.end
name-range source-range(a case-ast)
	a.member.name-range
keyword-and-member-name-range source-range(a case-ast)
	a.keyword-pos, a.name-range.end

case-member-ast union(as-name-ast, literal-number, literal-string-ast, as-bogus-ast)
name-range source-range(a case-member-ast)
	match a
	as as-name-ast
		a.name.range
	as literal-number
		a.range
	as literal-string-ast
		a.range
	as as-bogus-ast
		a.range

as-bogus-ast record(range source-range)
as-name-ast record(name name-and-range)

match-else-ast record(keyword-pos pos, expr expr-ast)
end pos(a match-else-ast) = a.expr.end
keyword-range source-range(a match-else-ast) = range-of-start-and-length a.keyword-pos, "else"

seq-ast record(first expr-ast, then_ expr-ast)
start pos(a seq-ast) = a.first.start
end pos(a seq-ast) = a.then_.end

shared-ast record(start pos, inner expr-ast)
end pos(a shared-ast) = a.inner.end
keyword-range source-range(a shared-ast) = range-of-start-and-length a.start, "shared"

throw-ast record(start pos, thrown expr-ast)
end pos(a throw-ast) = a.thrown.end
range source-range(a throw-ast) = a.start, a.end
keyword-range source-range(a throw-ast) = range-of-start-and-length a.start, "throw"

trusted-ast record(start pos, inner expr-ast)
end pos(a trusted-ast) = a.inner.end
range source-range(a trusted-ast) = a.start, a.end
keyword-range source-range(a trusted-ast) = range-of-start-and-length a.start, "trusted"

try-ast record
	start pos
	tried expr-ast
	catches catch-ast[]
end pos(a try-ast)
	if is-empty a.catches
		a.tried.end
	else
		a.catches[end - 1].end
range source-range(a try-ast)
	a.start, a.end
try-keyword-range source-range(a try-ast)
	range-of-start-and-length a.start, "try"

catch-ast record(start pos, name name-and-range?, as_ catch-as-ast?, then_ expr-ast)
end pos(a catch-ast)
	a.then_.end
keyword-range source-range(a catch-ast)
	range-of-start-and-length a.start, "catch"
catch-as-ast record(start pos, type-name name-and-range)
keyword-range source-range(a catch-as-ast)
	range-of-start-and-length a.start, "as"

try-let-ast record
	start pos
	destructure destructure-ast
	value expr-ast
	catch_ catch-ast
	after expr-ast?
end pos(a try-let-ast)
	if after = a.after
		after.end
	else
		a.catch_.end
range source-range(a try-let-ast)
	a.start, a.end
try-keyword-range source-range(a try-let-ast)
	range-of-start-and-length a.start, "try"

| `expr :: t` or `:: t \n expr` or `of::t` or `fun-name::t args...` or `for::t ...`
| For `of::t`, this is body of the lambda even though {type} is actually in the lambda signature and not the body.
| For `fun-name::t` or `for::t`, {expr} is a {call-ast-prefix} or {for-or-with-ast}. So {type} will be inside of {expr}.
typed-ast record
	| This may be missing for `:: t` with no line following it
	expr expr-ast?
	colon-pos pos
	type type-ast
start pos(a typed-ast)
	if expr = a.expr
		min a.type.start, expr.start
	else
		a.type.start
end pos(a typed-ast)
	if expr = a.expr
		max expr.end, a.type.end
	else
		a.type.end
range source-range(a typed-ast) = a.start, a.end
keyword-range source-range(a typed-ast)
	range-of-start-and-length a.colon-pos, "::"

underscore-ast record
	start pos
end pos(a underscore-ast)
	a.start + 1

unpack-option-ast record(destructure destructure-ast, equals-pos pos, option expr-ast)
keyword-range source-range(a unpack-option-ast)
	range-of-start-and-length a.equals-pos, "="
start pos(a unpack-option-ast) = a.destructure.start
end pos(a unpack-option-ast) = a.option.end

while-or-until-ast record
	start pos
	is-until bool
	condition expr-ast
	body expr-ast
	after expr-ast?
end pos(a while-or-until-ast) = (a.after else a.body).end
range source-range(a while-or-until-ast) = a.start, a.end
keyword-range source-range(a while-or-until-ast)
	"while"::char8[].size is "until"::char8[].size
	range-of-start-and-length a.start, "while"

while-or-until-body-ast record
	start pos
	is-until bool
	body expr-ast
keyword-range source-range(a while-or-until-body-ast)
	"while"::char8[].size is "until"::char8[].size
	range-of-start-and-length a.start, "until"
end pos(a while-or-until-body-ast) = end a.body

signature-ast record
	doc-comment doc-comment-ast
	range source-range
	name symbol
	return-type type-ast
	params destructure-ast[]
name-and-range name-and-range(a signature-ast) = a.range.start, a.name
name-range source-range(a signature-ast) = a.name-and-range.range

type-alias-ast record
	doc-comment doc-comment-ast
	range source-range
	visibility_ visibility?
	name name-and-range
	type-params name-and-range[]
	keyword-pos pos
	target type-ast
name-range source-range(a type-alias-ast) = a.name.range
keyword-range source-range(a type-alias-ast)
	range-of-start-and-length a.keyword-pos, "alias"
visibility visibility-and-range?(a type-alias-ast)
	get-visibility-and-range a.range.start, a.visibility_

type-params-range source-range(type-params name-and-range[])
	forbid is-empty type-params
	type-params[0].start, type-params[end - 1].end

modifier-ast union(modifier-keyword-ast, spec-use-ast)
	range source-range()
name-or-keyword symbol(a modifier-ast)
	match a
	as modifier-keyword-ast
		a.keyword.to
	as spec-use-ast
		a.name.name

modifier-keyword-ast record(type-arg type-ast?, keyword-pos pos, keyword modifier-keyword)
range source-range(a modifier-keyword-ast)
	if x = a.type-arg
		x.start, a.keyword-range.end
	else
		a.keyword-range
keyword-range source-range(a modifier-keyword-ast)
	range-of-start-and-length a.keyword-pos, a.keyword.to

spec-use-ast record(type-arg type-ast?, name name-and-range)
range source-range(a spec-use-ast)
	if x = a.type-arg
		x.start, a.name.end
	else
		a.name.range
name-range source-range(a spec-use-ast) = a.name.range

modifier-keyword enum
	builtin_
	case_
	data_
	force-data_
	force-shared_
	mut_
	new-internal
	new-public
	new-private
	shared_
to symbol(a modifier-keyword)
	match a
	as builtin_
		"builtin"
	as case_
		"case"
	as data_
		"data"
	as force-data_
		"force-data"
	as force-shared_
		"force-shared"
	as mut_
		"mut"
	as new-internal
		"~new"
	as new-private
		"-new"
	as new-public
		"+new"
	as shared_
		"shared"
to char8[](a modifier-keyword) = a.to::symbol.to
to string(a modifier-keyword) = a.to::symbol.to
to json(a modifier-keyword) = a.to::string.to

type-body-ast union(builtin-type-ast, enum-ast, flags-ast, record-ast, sum-type-ast)

builtin-type-ast record
enum-ast record(params destructure-ast[]?, members enum-or-flags-member-ast[])
flags-ast record(params destructure-ast[]?, members enum-or-flags-member-ast[])
record-ast record(params destructure-ast[]?, fields record-field-ast[])
sum-type-ast record(kind sum-type-kind, types type-ast[], methods signature-ast[])
types-range source-range?(a sum-type-ast)
	unless is-empty a.types
		a.types[0].start, a.types[end - 1].end

enum-or-flags-member-ast record
	doc-comment doc-comment-ast
	range source-range
	name symbol
	value literal-number?
name-and-range name-and-range(a enum-or-flags-member-ast)
	a.range.start, a.name
name-range source-range(a enum-or-flags-member-ast)
	a.name-and-range.range

record-field-ast record
	doc-comment doc-comment-ast
	range source-range
	visibility_ visibility?
	name name-and-range
	mutability field-mutability-ast?
	type type-ast?
visibility visibility-and-range?(a record-field-ast)
	get-visibility-and-range a.range.start, a.visibility_
name-range source-range(a record-field-ast)
	a.name.range

type-decl-ast record
	module-uri uri
	doc-comment doc-comment-ast
	| Range starts at the visibility (not at the doc comment)
	range source-range
	visibility_ visibility?
	name name-and-range
	type-params name-and-range[]
	keyword-pos pos
	modifiers modifier-ast[]
	body type-body-ast
name-range source-range(a type-decl-ast)
	a.name.range
keyword-range source-range(a type-decl-ast)
	range-of-start-and-length a.keyword-pos, a.body.keyword-for-type-body.to
-keyword-for-type-body symbol(a type-body-ast)
	match a
	as builtin-type-ast
		"builtin"
	as enum-ast
		"enum"
	as flags-ast
		"flags"
	as record-ast
		"record"
	as sum-type-ast
		a.kind.to
visibility visibility-and-range?(a type-decl-ast)
	get-visibility-and-range a.range.start, a.visibility_

spec-decl-ast record
	doc-comment doc-comment-ast
	range source-range
	visibility_ visibility?
	name name-and-range
	type-params name-and-range[]
	spec-keyword-pos pos
	modifiers modifier-ast[]
	sigs signature-ast[]
name-range source-range(a spec-decl-ast) = a.name.range
keyword-range source-range(a spec-decl-ast)
	range-of-start-and-length a.spec-keyword-pos, "spec"
visibility visibility-and-range?(a spec-decl-ast)
	get-visibility-and-range a.range.start, a.visibility_

fun-decl-ast record
	module-uri uri
	doc-comment doc-comment-ast
	start pos
	visibility_ visibility?
	name-pos pos
	name name-and-arity
	type-params name-and-range[]
	return-type type-ast
	params destructure-ast[]
	modifiers modifier-ast[]
	| If the body is missing this will be {bogus-ast}
	body expr-ast
range source-range(a fun-decl-ast) = a.start, a.end
end pos(a fun-decl-ast) = a.body.end
visibility visibility-and-range?(a fun-decl-ast)
	get-visibility-and-range a.start, a.visibility_
name-range uri-and-range(a fun-decl-ast)
	a.module-uri, a.name-range
name-range source-range(a fun-decl-ast)
	range name-and-range a.name-pos, a.name.name

test-ast record
	doc-comment doc-comment-ast
	start pos
	modifiers modifier-ast[]
	body expr-ast
range source-range(a test-ast) = a.start, a.body.end
keyword-range source-range(a test-ast)
	range-of-start-and-length a.start, "test"

| 'global' or 'thread-local'
var-decl-ast record
	doc-comment doc-comment-ast
	start pos
	visibility_ visibility?
	name name-and-range
	type-params name-and-range[]
	keyword-pos pos
	kind var-kind
	type type-ast
	modifiers modifier-ast[]
	initializer expr-ast
range source-range(a var-decl-ast) = a.start, a.initializer.end
name-range source-range(a var-decl-ast) = a.name.range
keyword-range source-range(a var-decl-ast)
	range-of-start-and-length a.keyword-pos, a.kind.string-of-var-kind-lower-case.to
visibility visibility-and-range?(a var-decl-ast)
	get-visibility-and-range a.start, a.visibility_

import-or-export-ast record
	range source-range
	path path-or-rel-path
	kind import-or-export-ast-kind
path-range source-range(a import-or-export-ast)
	range-of-start-and-length a.range.start, a.path.show.size.to
import-min-visibility export-visibility(a import-or-export-ast)
	match a.path
	as path
		public
	as rel-path
		internal

path-or-rel-path union(path, rel-path)
	show string()
	to json()

import-or-export-ast-kind union
	import-whole-module-ast
	name-and-range[]
	import-file-ast
import-whole-module-ast record
import-file-ast record(name name-and-range, type-ast type-ast, type import-file-type)
import-file-type enum(nat8-array, string)

imports-or-exports-ast record(range source-range, paths import-or-export-ast[])

doc-comment-ast record(content doc-comment-content?)
to json(a doc-comment-ast) = a.content.?to else ()
new doc-comment-ast() = content: ()
new doc-comment-ast(range source-range) = content: range, ()
is-empty bool(a doc-comment-ast) = not a.content
range source-range?(a doc-comment-ast) = a.content.?range
references name-and-range[](a doc-comment-ast) = a.content.?references else ()

doc-comment-content record(range source-range, references name-and-range[])

file-ast record
	line-and-column-getter line-and-column-getter
	parse-diagnostics parse-diagnostic[]
	doc-comment doc-comment-ast
	no-std_ bool
	imports imports-or-exports-ast?
	re-exports imports-or-exports-ast?
	| Stores the range of each `region` comment. (Not the range of the region itself.)
	regions source-range[]
	specs spec-decl-ast[]
	type-aliases type-alias-ast[]
	structs type-decl-ast[]
	funs fun-decl-ast[]
	tests test-ast[]
	vars var-decl-ast[]
to json(a file-ast)
	parse-diagnostics: a.parse-diagnostics.to
	doc-comment: a.doc-comment.to
	no-std_: a.no-std_.to
	imports: a.imports.to
	re-exports: a.re-exports.to
	regions: a.regions.to
	specs: a.specs.to
	type-aliases: a.type-aliases.to
	structs: a.structs.to
	funs: a.funs.to
	tests: a.tests.to
	vars: a.vars.to

line-and-character-getter line-and-character-getter(a file-ast)
	a.line-and-column-getter.line-and-character-getter

file-ast-for-diag file-ast(diag read-file-diag)
	line-and-column-getter: ()
	parse-diagnostics: ((), diag),
	doc-comment: ()
	no-std_: true
	imports: ()
	re-exports: ()
	regions: ()
	specs: ()
	type-aliases: ()
	structs: ()
	funs: ()
	tests: ()
	vars: ()

ast-in-order any-ast[](ast file-ast)
	res any-ast[] =
		-- from-option ast.imports
		-- from-option ast.re-exports
		-- map ast.specs, {it}
		-- map ast.type-aliases, {it}
		-- map ast.structs, {it}
		-- map ast.funs, {it}
		-- map ast.tests, {it}
		-- map ast.vars, {it}
	sort res, it.range
any-ast union
	imports-or-exports-ast
	spec-decl-ast
	type-alias-ast
	type-decl-ast
	fun-decl-ast
	test-ast
	var-decl-ast
do
	range source-range()

children record(expr expr-ast)
some bool(a children, f bool mut(x expr-ast))
	match x = a.expr
	as assert-or-forbid-ast
		f[x.condition] or cb-option x.thrown.?expr, f or cb-option x.after, f
	as assignment-ast
		f[x.left] or f[x.right]
	as assignment-call-ast
		f[x.left] or f[x.right]
	as bogus-ast
		()
	as call-ast-dot
		f[x.left]
	as call-ast-infix
		some x.args, f
	as call-ast-dot-question
		f[x.left]
	as call-ast-prefix
		some x.args, f
	as call-ast-prefix-question
		some x.args, f
	as call-ast-prefix-with-type-arg
		some x.args, f
	as call-named-ast
		some x.args, f
	as call-subscript-ast
		f[x.left] or f[x.right]
	as call-question-subscript-ast
		f[x.left] or f[x.right]
	as finally-ast
		f[x.right] or f[x.below]
	as force-ast
		f[x.arg]
	as for-or-with-ast
		f[x.arg] or f[x.body]
	as name-and-range
		()
	as if-ast
		f[x.condition] or cb-option x.first-branch, f or cb-option x.second-branch, f
	as interpolated-ast
		some x.interpolated, f
	as is-or-isnt-ast
		f[x.left] or f[x.right] or cb-option x.else_, f
	as it-ast
		()
	as it-scope-ast
		f[x.inner]
	as lambda-ast
		f[x.body]
	as let-ast
		f[x.value] or cb-option x.then_, f
	as let-the-ast
		f[x.value] or cb-option x.then_, f
	as list-ast
		some x.parts, f[it.list-part-arg]
	as literal-number
		()
	as literal-string-ast
		()
	as logical-ast
		f[x.left] or f[x.right]
	as match-ast
		f[x.matched] or some x.cases, f[it.then_] or cb-option x.else_.?expr, f
	as parenthesized-ast
		f[x.inner]
	as seq-ast
		f[x.first] or f[x.then_]
	as shared-ast
		f[x.inner]
	as the-ast
		()
	as throw-ast
		f[x.thrown]
	as trusted-ast
		f[x.inner]
	as try-ast
		f[x.tried] or some x.catches, f[it.then_]
	as try-let-ast
		f[x.value] or f[x.catch_.then_] or cb-option x.after, f
	as typed-ast
		cb-option x.expr, f
	as underscore-ast
		()
	as unpack-option-ast
		f[x.option]
	as while-or-until-body-ast
		f[x.body]
	as while-or-until-ast
		f[x.condition] or f[x.body] or cb-option x.after, f
