import
	crow/parse
	./include/compiler/util/parse-util

main void()
	"1" roundtrip "1".to
	"a" roundtrip "a".to
	"- 1" roundtrip ("1".to,)
	"a: 1" roundtrip (("a", "1".to),)::repr[symbol]
	"""
- 1
- 2
- 3
	""" roundtrip ("1".to, "2".to, "3".to)
	"""
a: 1
b: 2
c: 3""" roundtrip (("a" to "1".to), ("b" to "2".to), ("c" to "3".to))
	yaml parse """
k:
	1
	""" is (("k" to "1".to),)
	"""
k:
	- v
	""" roundtrip (("k" to ("v".to,)),)
	"""
a:
	b:
		c: 1
	d: 2
	""" roundtrip do
		c1 repr = ("c" to "1".to),
		bd repr = ("b" to c1), ("d" to "2".to)
		(("a" to bd),)
	# TODO: test that it rejects illegal characters (e.g. {}) (must be quoted) --------------------------------------------------
	# TODO: test parsing quotes

-roundtrip void(text string, value repr)
	yaml parse text is value
	value.show is text.strip
	info log value.to-json

-to[k, v] (k, v)(k k, v v)
	k, v

show string(a repr)
	with out in build
		out show a, 0

to-json string(a repr)
	match a
	as scalar x
		if _ ?= x type-hint
			x value
		else
			x.value quote
	as array xs
		parts = "," join for x in xs then x to-json
		"[{parts}]"
	as map xs
		parts = "," join for k, v in xs
			"{k.to quote}:{v to-json}"
		"\{{parts}}"

-show void(out string-builder, a repr, indent nat)
	match a
	as scalar x
		out ~~= x.show
	as array xs
		first mut = true
		for x in xs
			if first
				first := false
			else
				out ~~= indent.newline
			out ~= "-"
			out show-inner x, indent
	as map xs
		first mut = true
		for key, value in xs
			if first
				first := false
			else
				out ~~= indent.newline
			out ~~= "{key}:"
			out show-inner value, indent
-show-inner void(out string-builder, a repr, indent nat)
	match a
	as scalar x
		out ~~= " {x show}"
	else
		out ~~= indent + 1 newline
		out show a, indent + 1

-newline string(indent nat)
	"\n" ~~ ("\t" repeat indent)

-is-simple-value bool(a string)
	a.to::char8[] every x => x is-ascii-identifier-char

repr union(scalar, repr[], repr[symbol])
== bool(a repr, b repr)
to json(a repr)
	match a
	as scalar x
		x.value.to
	as array xs
		(for x in xs then x to)::json[] to
	as map xs
		(for k, v in xs then k, v.to)::json[symbol] to
scalar record
	value string
	| Only present for value parsed from JSON
	type-hint type-hint?
== bool(a scalar, b scalar)
show string(a scalar)
	if a.value is-simple-value
		a value
	else
		a.value quote
type-hint enum(bool, null, number)
== bool(a type-hint, b type-hint)

new repr(...pairs (symbol, repr)[])
	pairs to

to repr(a string)
	:: scalar
	a, ()

yaml repr grammar()
	func: iter =>
		while iter try-take-char "\n"
			()
		res = iter parse-yaml (tab,), false, 0
		res.dedents is 0
		iter skip-whitespace
		res value

-repr-result record
	value repr
	dedents nat
-ctx record
	indent-kind indent-kind
-parse-yaml repr-result(ptr string-mut-iterator, ctx ctx, is-inner bool, indent nat)
	if ptr try-take-char "\""
		x = ptr parse-quoted-string-after-quote
		x.to, (ptr take-whitespace-after-scalar ctx, indent)
	elif !is-inner and ptr try-take-chars "- "
		value repr mut[] = ()
		dedents nat = loop
			result = ptr parse-yaml-inner ctx, indent
			value ~= result value
			if result.dedents == 0 and ptr try-take-chars "- "
				continue
			else
				break result dedents
		value.move-to, dedents
	else
		start = ptr char8-index
		until ptr is-at-end or ptr.peek8 == "\n" or ptr.peek8 == ":"
			_ = ptr take-char8
		string = ptr string-from start
		guard ptr.peek8 == ":" else (string scalar ()), (ptr take-whitespace-after-scalar ctx, indent)
		assert ptr.peek8 == ":"
		assert !is-inner else "Map cannot appear in single line" inner-parse-error
		_ = ptr take-char8
		first-result = ptr parse-yaml-inner ctx, indent
		if first-result.dedents == 0
			ptr parse-yaml-object ctx, indent, (string.to, first-result.value)
		else
			((string.to::symbol, first-result.value),), first-result.dedents

| Returns number of dedents (indenting is not allowed)
-take-whitespace-after-scalar nat(ptr string-mut-iterator, ctx ctx, indent nat)
	ptr skip-whitespace-single-line
	new-indent = ptr take-some-indent ctx
	assert new-indent <= indent else "Cannot indent here" inner-parse-error
	indent - new-indent

-parse-yaml-object repr-result(ptr string-mut-iterator, ctx ctx, indent nat, first (symbol, repr))
	dedents mut nat = 0
	res repr[symbol] = with out in build
		out ~= first
		loop
			start = ptr char8-index
			until ptr is-at-end or ptr.peek8 == "\n" or ptr.peek8 == ":"
				_ = ptr take-char8
			key = ptr string-from start
			if ptr.char8-index == start
				if ptr.peek8 == "\n"
					_ = ptr take-char8
					continue
				else
					break
			else
				assert ptr.peek8 == ":" else "Expected another map key" inner-parse-error
				_ = ptr take-char8
				value = ptr parse-yaml-inner ctx, indent
				out ~= key.to, value.value
				if value.dedents == 0
					continue
				else
					dedents := value dedents
					break
	res, dedents

# Also takes the newline at the end
-parse-yaml-inner repr-result(ptr string-mut-iterator, ctx ctx, indent nat)
	ptr skip-whitespace-single-line
	if ptr try-take-char "\n"
		new-indent = ptr take-some-indent ctx
		assert new-indent == indent + 1 else todo # ERROR: indented too far, or unexpected dedent -----------------------------------------------------------------------------------------
		res = ptr parse-yaml ctx, false, new-indent
		res.value, res.dedents - 1
	else
		ptr parse-yaml ctx, true, indent

-skip-whitespace-single-line void(ptr string-mut-iterator)
	while ptr.peek8 == " "
		_ = ptr take-char8

-parse-quoted-string string(ptr string-mut-iterator)
	assert ptr try-take-char "\"" else "Expected '\"'" inner-parse-error # TODO: this is also used for yaml, so I guess they should be the same type ......
	ptr parse-quoted-string-after-quote
-parse-quoted-string-after-quote string(_ string-mut-iterator)
	throw todo # Use 'take-quoted-string-rest' from 'parse.crow' -----------------------------------------------------------------------------

-take-some-indent nat(ptr string-mut-iterator, ctx ctx)
	match ctx indent-kind
	as tab
		loop
			start = ptr char8-index
			while ptr try-take-char "\t"
				()
			if ptr try-take-char "\n"
				continue
			elif ptr is-at-end
				break 0
			else
				break ptr.char8-index - start
	as space2
		throw todo
	as space4
		throw todo

-indent-kind enum(tab, space2, space4)

# TODO: rename to 'json', once that is gone
json2 repr grammar()
	func: iter =>
		res = iter parse-json
		iter skip-whitespace
		res
-parse-json repr(a string-mut-iterator)
	a skip-whitespace
	if a try-take-chars "false"
		"false", bool
	elif a try-take-chars "true"
		"true", bool
	elif a try-take-chars "null"
		"null", null
	elif a try-take-char "\""
		a.parse-quoted-string-after-quote to
	elif a try-take-char "["
		a skip-whitespace
		:: repr[]
		guard a !try-take-char "]"
		with out in build
			out ~= a parse-json
			a skip-whitespace
			while a try-take-char ","
				out ~= a parse-json
			assert a try-take-char "]" else "Expected ']'" inner-parse-error
	elif a try-take-char "\{"
		a skip-whitespace
		:: repr[symbol]
		guard a !try-take-char "}"
		with out in build
			key = a parse-quoted-string
			a skip-whitespace
			assert a try-take-char ":" else "Expected ':'" inner-parse-error
			a skip-whitespace
			value = a parse-json
			out ~= key.to, value
			assert a try-take-char "}" else "Expected '}'" inner-parse-error
