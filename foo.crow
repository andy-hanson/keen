	info log s.normalize-js-temp-paths

-normalize-js-temp-paths string(a string)
	cur mut = a
	with out : build
		loop
			if before, after ?= cur try-split-once "/tmp/crow-"
				info log "BEFORE: {before.to::json}"
				info log "AFTER: {after.to::json}"
				out ~~= before
				out ~~= "TMP"
				dropped-digits = after drop-while x => x is-digit
				info log "DROPPED DIGITS: {dropped-digits.to::json}"
				cur := dropped-digits
				continue
			else
				out ~~= cur
				break

-is-digit bool(a char32)
	"0"::char32 <= a && a <= "9"
