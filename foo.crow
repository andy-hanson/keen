import
	./include/crow/col/private/array-low-level: is-empty-type

main void() unsafe
	info log (is-empty-type@void).show
	info log (is-empty-type@nat).show
	info log (is-empty-type@foo).show

foo record

foo nat(a u)
	match a
	as nat x
		x
	as w1 x
		x.x.x[0]

w0 record(x nat[])
w1 record(x w0)
u union(nat, w1)
