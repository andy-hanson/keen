import
	com/sun/net/httpserver/HttpExchange
	com/sun/net/httpserver/HttpHandler
	com/sun/net/httpserver/HttpServer
	java/net/InetSocketAddress
	java/io/OutputStream
	#java/io/IOException
	java/lang/String
	crow/unsafe

main void() summon, trusted, java extern
	address InetSocketAddress = 8080,
	server HttpServer = address create 0
	_ = server createContext "/test".to-java-string, my-type
	server setExecutor null
	info log "Gonna start the server now"
	server start
	info log "Did start"

my-type record HttpHandler case, java extern, summon

handle void(_ my-type, t HttpExchange) java extern, summon, trusted
	info log "In the handler"
	response String = "WE R REALLY HERE" to-java-string
	l = response length
	t sendResponseHeaders 200, l.to
	os = t getResponseBody
	os write response.getBytes
	os close
