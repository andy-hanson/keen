no-std
import
	../bool: bool, true
	../misc: void
	../number: nat64
	../option: option
	./array: array
	./mut-array

| Mutable stack.
|
| Elements are pushed and popped from the top of the stack.
| Iterates from the bottom (least recently pushed) to the top (most recently pushed).
+mut-stack[t] record mut
	-inner t mut[]

+list-new[t] t mut-stack(a t[])
	inner: a to

| This is O({a} {size}).
+copy[t] t mut-stack(a t mut-stack)
	a.inner.copy,

| Copy from a list.
| This is O({a} {size}).
+to[t] t mut-stack(a t[])
	a.to,

| Copy to an array.
| This is O({a} {size}).
+to[t] t[](a t mut-stack)
	a.inner to

| {true} if `{a}.{size} == 0`.
+is-empty[t] bool(a t mut-stack)
	a.inner is-empty

| Number of elements in the stack.
| This is O(1).
+size[t] nat64(a t mut-stack)
	a.inner size

| Pushes a value to the top of the stack.
+~=[t] void(a t mut-stack, value t)
	a.inner ~= value

| Pushes many values to the top of the stack.
+~~=[t] void(a t mut-stack, values t[])
	a.inner ~~= values

| {index}th element from the bottom.
+subscript[t] t(a t mut-stack, index nat64)
	a.inner[index]

| Returns the top element of the stack without removing it.
| Returns an empty option if `{a} {is-empty}`.
+peek[t] t?(a t mut-stack)
	a.inner peek

| Removes and returns the top element of the stack.
| Returns an empty option if `{a} {is-empty}`.
+pop[t] t?(a t mut-stack)
	a.inner pop

+iterate[t] bool(a t mut-stack, f bool mut(elem t))
	a.inner iterate f
+iterate-reverse[t] bool(a t mut-stack, f bool mut(elem t))
	a.inner iterate-reverse f

+filter=[t] void(a t mut-stack, f bool mut(elem t))
	a.inner filter= f
