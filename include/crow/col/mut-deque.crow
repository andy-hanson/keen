use-prefix
import
	../unsafe: gc-safe-value
	./mut-slice

| Mutable double-ended queue.
+mut-deque[t] record mut
	-inner mut t mut-slice
	| Index of the first element. {nil} for an empty queue.
	-left mut nat64
	| Index of the element after the last. 'nil' for an empty queue.
	| This should never be inner.size; it wraps around to 0.
	-right mut nat64

-nil nat64()
	max-value
-prev-index[t] nat64(a t mut-deque, index nat64)
	forbid index == nil
	(if index == 0 then a.inner.size else index) - 1
-next-index[t] nat64(a t mut-deque, index nat64)
	forbid index == nil
	if index == a.inner.size - 1 then 0 else index + 1

| New empty {mut-deque}.
+new[t] t mut-deque()
	(), nil, nil

| Copy elements to a list.
| This is O(n).
+to[t] t[](a t mut-deque)
	trusted cast-immutable a.to

-to[t] t mut-slice(a t mut-deque)
	guard !is-empty a
	res t mut-slice = trusted gc-safe-mut-slice a.size
	copy-from-deque res[0 .. end], a
	res

| Copy elements to a new deque.
| This is O(n).
+copy[t] t mut-deque(a t mut-deque)
	a.to, 0, 0

| {true} iff `{a}.{size} == 0`.
+is-empty[t] bool(a t mut-deque)
	a.left == nil

| Number of elements in the deque.
+size[t] nat64(a t mut-deque)
	match a.left <=> a.right
	as less
		a.right - a.left
	as equal
		unless a.left == nil
			a.inner.size
	as greater
		a.inner.size - a.left + a.right

| Add a new value on the left.
+push[t] void(value t, a t mut-deque)
	trusted
	ensure-capacity a
	a.left := prev-index a, a.left
	a.inner[a.left] := value

| Add a new value on the right.
+push[t] void(a t mut-deque, value t)
	trusted
	ensure-capacity a
	assert a.right < a.inner.size
	a.inner[a.right] := value
	a.right := next-index a, a.right

| Returns the leftmost element without removing it.
| Returns an empty option if `{a} {is-empty}`.
+peek-left[t] t?(a t mut-deque)
	guard a.left != nil
	a.inner[a.left]

| Returns the rightmost element without removing it.
| Returns an empty option if `{a} {is-empty}`.
+peek-right[t] t?(a t mut-deque)
	guard a.right != nil
	a.inner[prev-index a, a.right]

| Removes and returns the leftmost element.
| Returns an empty option if `{a} {is-empty}`.
+pop-left[t] t?(a t mut-deque)
	guard a.left != nil
	res = a.inner[a.left]
	a.inner[a.left] := trusted gc-safe-value
	a.left := next-index a, a.left
	if a.left == a.right
		a.left := nil
		a.right := nil
		# Still hold on to `a inner`
	res

| Removes and returns the rightmost element.
| Returns an empty option if `{a} {is-empty}`.
+pop-right[t] t?(a t mut-deque)
	guard a.right != nil
	a.right := prev-index a, a.right
	res = a.inner[a.right]
	a.inner[a.right] := trusted gc-safe-value
	if a.right == a.left
		a.left := nil
		a.right := nil
		# Still hold on to `a inner`
	res

-ensure-capacity[t] void(a t mut-deque) unsafe
	if a.left == nil
		assert a.right == nil
		if is-empty a.inner
			a.inner := gc-safe-mut-slice 2
		a.left := 0
		a.right := 0
	else
		assert a.right != nil
		forbid is-empty a.inner
		if a.left == a.right
			old-inner = a.inner
			old-capacity = old-inner.size
			new-capacity = old-capacity * 2
			new-inner t mut-slice = gc-safe-mut-slice new-capacity
			copy-from-deque new-inner[0 .. old-capacity], a
			clear-memory new-inner[old-capacity .. new-capacity]
			a.inner := new-inner
			a.left := 0
			a.right := old-capacity

-copy-from-deque[t] void(dest t mut-slice-view, a t mut-deque)
	assert dest.size == a.size
	if a.left < a.right
		dest[0 .. end] := a.inner[a.left .. a.right]
	else
		left-to-end-size = a.inner.size - a.left
		dest[0 .. left-to-end-size] := a.inner[a.left .. end]
		dest[left-to-end-size .. end] := a.inner[0 .. a.right]

-dbg string(a nat64 mut-deque)
	join " ", for i, x in with-index a.inner
		is-nil = trusted x == gc-safe-value
		is-right string = if i == a.right then "<-R "
		is-left string = if i == a.left then "L-> "
		"{is-right}{is-left}{if is-nil then "_"::string else "{x}"}"

-verify void(a nat64 mut-deque, expected nat64[], expected-dbg string)
	a.peek-left is unless is-empty expected then expected[0]
	a.peek-right is unless is-empty expected then expected[end - 1]
	a.size is expected.size
	a.to::nat64[] is expected
	a.dbg is expected-dbg

test
	a nat64 mut-deque = ()
	a.pop-left is ()
	a.pop-right is ()
	verify a, (), ""
	push 1::nat64, a
	verify a, (1,), "<-R _ L-> 1"
	push a, 2
	verify a, (1, 2), "2 <-R L-> 1"

	a-copy = copy a
	verify a-copy, (1, 2), "<-R L-> 1 2"

	a.pop-right is 2
	verify a, (1,), "<-R _ L-> 1"

	a.pop-right is 1
	a.left is nil
	a.right is nil
	verify a, (), "_ _"

	push a, 1
	verify a, (1,), "L-> 1 <-R _"

	push 2::nat64, a
	verify a, (2, 1), "1 <-R L-> 2"

	push 3::nat64, a
	verify a, (3, 2, 1), "2 1 <-R _ L-> 3"
