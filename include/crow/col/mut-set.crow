use-prefix
no-std
import
	../bool
	../hash
	../misc
	../number
	../tuple
	./array
	./mut-map
	./set
	./util

| Mutable unordered set.
+mut-set[t] record mut
	-inner void mut[t]

+list-new[t] t mut-set(a t[]) t key
	a.to

+is-empty[t] bool(a t mut-set) t key
	is-empty a.inner

+size[t] nat64(a t mut-set) t key
	size a.inner

~hint-size[t] void(a t mut-set, size nat64) t key
	hint-size a.inner, size

+to[t] t[](a t mut-set) t key
	map a, it.identity

+to[t] t set(a t mut-set) t key
	map a, it.identity

+to[t] t mut-set(a t[]) t key
	res t mut-set = inner: ()
	for x in a
		res ~= x
	res
| Copies an immutable set to a mutable set.
+to[t] t mut-set(a t set) t key
	map a, it.identity

| Removes all elements.
+clear[t] void(a t mut-set) t key
	clear a.inner

| Returns an array of all elements in {a}. Afterwards, {a} will be empty.
+move-to[t] t[](a t mut-set) t key
	for x in a.inner.move-to::(t, void)[]
		x.a

| Returns a {set} equivalent to {a}. Afterwards, {a} will be empty.
+move-to[t] t set(a t mut-set) t key
	a.move-to::t[].to

| Adds a value to the set.
| Does nothing if the value is already in the set.
+~=[t] void(a t mut-set, value t) t key
	a.inner ~= value, ()

| Adds many values.
| Like with {~=}, values already in the set have no effect.
+~~=[t] void(a t mut-set, values t[]) t key
	for x in values
		a ~= x

| {true} if the set contains {value}.
+subscript[t] bool(a t mut-set, value t) t key
	!!a.inner[value]

| If the value is already in the set, does nothing and returns {false}.
| Otherwise, adds it and returns {true}.
+try-add[t] bool(a t mut-set, value t) t key
	# TODO:PERF do it without two lookups
	unless a[value]
		a ~= value
		true

| Same as {remove} but returning {void}
+-=[t] void(a t mut-set, value t) t key
	_ = remove a, value

| If the value is in the set, removes it and returns {true}.
| Else, does nothing and returns {false}.
+remove[t] bool(a t mut-set, value t) t key
	!!(remove a.inner, value)

+iterate[t] bool(a t mut-set, f bool mut(elem t)) t key
	iterate a.inner, f[it.a]
