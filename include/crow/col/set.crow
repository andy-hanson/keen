no-std
import
	../bool
	../hash
	../misc
	../number
	../option
	../tuple
	./array
	./collection
	./map
	./util

+set[t] record
	-inner void[t]

+list-new[t] t set(values t[]) t key
	values to

+to[t] t set(a t[]) t key
	inner: a map (it, ())

+==[t] bool(a t set, b t set) t key
	a.size == b.size and a every b[it]

+to[t] t[](a t set) t key
	a map it.identity

+is-empty[t] bool(a t set) t key
	a.inner is-empty

+size[t] nat64(a t set) t key
	a.inner size

| True if the value is in the set.
+subscript[t] bool(a t set, value t) t key
	!!a.inner[value]

+is-subset-of[t] bool(a t set, b t set) t key
	a every b[it]
+is-superset-of[t] bool(a t set, b t set) t key
	b is-subset-of a

| Adds an element to the set.
| If it was already in the set, returns {a} unmodified.
+~[t] t set(a t set, value t) t key
	a try-add value else a

| Union of two sets.
| This is a set containing all elements in either {a} or {b}.
+|[t] t set(a t set, b t set) t key
	res mut = a
	trusted for x in b unsorted
		res ~:= x
	res

| Intersection of two sets.
| This is a set containing all elements in both {a} and {b}.
+&[t] t set(a t set, b t set) t key
	trusted a.unsorted filter b[it]

| Set difference.
| This is a set containing all elements in {a} but not in {b}.
+-[t] t set(a t set, b t set) t key
	trusted a.unsorted filter !b[it]

| If the value is already in the set, returns an empty option.
| Else, adds it and returns the new set.
+try-add[t] t set?(a t set, value t) t key
	match res = a.inner get-or-add value, it.noop
	as got
		()
	as added
		inner: res map

+try-remove[t] t set?(a t set, value t) t key
	if res = a.inner try-remove value
		- res b

+iterate[t] bool(a t set, f bool mut(elem t)) t key
	a.inner iterate f[it.a]

-set-unsorted[t] record(inner t set)
-unsorted[t] t set-unsorted(a t set)
	a,
-size[t] nat(a t set-unsorted) t key
	a.inner size
-iterate[t] bool(a t set-unsorted, f bool mut(x t)) t key, unsafe
	a.inner.inner.unsorted iterate f[it.a]
