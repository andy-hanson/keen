no-std
import
	../bool: &&, bool, false, true
	../compare: !=, <, <=, equal
	../java: call-static, java-array-get, java-array-set, java-cast, java-new-array
	../js: as-js, call, call-property, cast, js-cast, js-global, subscript, set-subscript
	../misc: new, subscript, void
	../number: ==, <=>, +, -, *, /, %, float64, int32, nat64, next, to
	../option: new, option
	../pointer:
		==, <=>, +, -, as-const, as-mut, mem-clear, mem-move, mut-pointer, pointer-cast,
		set-subscript, size-of, subscript
	../private/alloc: allocate
	../private/bootstrap: new-array, todo
	../range: .., difference, is-empty, iterate, high, low, range, size, subscript
	../tuple: new
	../unsafe: gc-safe-value
	./array: ~=, ~~=, array, array-builder, array-view, begin-pointer, build, iterate, size, subscript
	./private/array-low-level:
		array-reference-equal, indices, inner, new-mut-slice, mut-slice-pointer, mut-slice-size, new
	./collection:
		.., build-options, end, for-loop, index-too-big, iterator-not-comparable,
		range-relative-to-end, slice-out-of-order, subscript, to-range
export
	../private/bootstrap: mut-slice

| {true} if {a} and {b} are the exact same reference.
| This is O(1) as it does not need to look at the elements.
+==[t] bool(a t mut-slice, b t mut-slice) bare, trusted
	a.cast-immutable array-reference-equal b.cast-immutable

| Creates a new {mut-slice} with the given elements.
+new[t] t mut-slice(...a t[]) bare, trusted
	# A spread argument is always a new array
	a cast-mutable

| Slice from `{a}[{indices} {low}]` (inclusive) to `{a}[{indices} {high}]` (exclusive).
| This is O(1) because it does not copy anything.
+subscript[t] t mut-slice(a t mut*, indices nat64 range) bare, unsafe, native extern
	a.as-const[indices] cast-mutable

+mut-slice-view[t] record by-val, mut # TODO: this is a silly name --------------------------------------------------------------------------
	-inner t mut-slice
	-indices nat64 range

+as-const[t] t array-view(a t mut-slice-view) bare, unsafe
	a.inner.cast-immutable, a.indices

+to[t] t[](a t mut-slice-view)
	for x : a; x

+begin-pointer[t] t mut*(a t mut-slice-view) bare, unsafe, native extern
	a.inner.begin-pointer + a.indices.low
+end-pointer[t] t mut*(a t mut-slice-view) bare, unsafe, native extern
	a.begin-pointer + a.size
+is-empty[t] bool(a t mut-slice-view) bare
	a.indices is-empty

+size[t] nat64(a t mut-slice-view) bare
	a.indices size

+subscript[t] t(a t mut-slice-view, index nat64) bare
	assert index < a.size : index index-too-big a.size
	a.inner[a.indices.low + index]

+set-subscript[t] void(a t mut-slice-view, index nat64, value t) bare
	assert index < a.size : index index-too-big a.size
	a.inner[a.indices.low + index] := value

+subscript[t] t mut-slice-view(a t mut-slice, indices nat64 range) bare
	assert indices.high <= a.size : indices.high index-too-big a.size
	a, indices
+subscript[t] t mut-slice-view(a t mut-slice-view, indices nat64 range) bare
	a.inner, a.indices[indices]

+iterate[t] bool(a t mut-slice-view, f bool mut(x t))
	i mut = a.indices low
	loop
		if i == a.indices.high
			break false
		elif f[a.inner[i]]
			break true
		else
			i +:= 1
			continue

| Copies the array elements to a new `mut-slice`.
| This is O({a} {size}).
+to[t] t mut-slice(a t[]) trusted
	# Not using a 'for' loop because the compiler may think it may yield (due to the virtual call)
	res t mut-slice = a.size gc-safe-mut-slice
	res[0 .. end] copy-from a
	res

| Copies the elements to an immutable array.
| This is O({a} {size}).
|
| There is no `move-to` function for `mut-slice`,
| since its pointer and size are immutable and so it can't be made empty.
+to[t] t[](a t mut-slice) trusted
	for x : a; x

| Creates a slice from `{a} {low}` (inclusive) to `{a} {high}` (exclusive).
| This is O(1) because it does not copy anything.
+as-mut-slice[t] t mut-slice(a t mut* range) bare, unsafe, native extern
	assert a.low <= a.high
	(a.high - a.low) new-mut-slice a.low

+pointers[t] t mut* range(a t mut-slice) bare, unsafe, native extern
	a.begin-pointer .. a.end-pointer

| Number of elements.
+size[t] nat64(a t mut-slice) bare
	a mut-slice-size

| {true} if `{a}.{size} == 0`.
+is-empty[t] bool(a t mut-slice) bare
	a.size == 0

| Pointer to the first element of the `mut-slice`.
| WARN: Not a valid pointer if `{a} {is-empty}`.
+begin-pointer[t] t mut*(a t mut-slice) bare, unsafe, native extern
	a mut-slice-pointer

| Pointer to the end of the `mut-slice`.
| This is one past the last valid pointer.
+end-pointer[t] t mut*(a t mut-slice) bare, unsafe, native extern
	a.begin-pointer + a.size

| Copies the elements to a new `mut-slice`.
| This is O({a} {size}).
+copy[t] t mut-slice(a t mut-slice)
	for x : a; x

+subscript[t] t(a t mut-slice, index nat64) bare, trusted
	assert index < a.size : index index-too-big a.size
	if extern native
		a.begin-pointer[index]
	elif extern java
		a java-array-get index.to
	elif extern js
		a.as-js[index] cast
	else
		todo

+set-subscript[t] void(a t mut-slice, index nat64, value t) bare, trusted
	assert index < a.size : index index-too-big a.size
	if extern native
		a.begin-pointer[index] := value
	elif extern java
		a java-array-set index.to, value
	elif extern js
		a.as-js[index] := value
	else
		todo

+set-subscript[t] void(dest t mut-slice, range nat64 range, source t[]) bare
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice, range nat64 range, source t array-view) bare
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice, range nat64 range, source t mut-slice) bare
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice, range nat64 range, source t mut-slice-view) bare
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice, range range-relative-to-end, source t[]) bare
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice, range range-relative-to-end, source t array-view) bare
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice, range range-relative-to-end, source t mut-slice) bare
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice, range range-relative-to-end, source t mut-slice-view) bare
	dest[range to-range dest.size] copy-from source

# TODO: overloading this on every collection is silly. It should work on anything with 'size' and 'iterate'. -----------------------------
+set-subscript[t] void(dest t mut-slice-view, range nat64 range, source t[]) bare
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range nat64 range, source t array-view) bare
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range nat64 range, source t mut-slice) bare
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range nat64 range, source t mut-slice-view) bare
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range range-relative-to-end, source t[]) bare
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range range-relative-to-end, source t array-view) bare
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range range-relative-to-end, source t mut-slice) bare
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range range-relative-to-end, source t mut-slice-view) bare
	dest[range to-range dest.size] copy-from source

| Overwrites {dest} with the contents of {source}.
| {dest} and {source} must be the same size.
+copy-from[t] void(dest t mut-slice-view, source t mut-slice) bare
	dest copy-from source[0 .. end]
-copy-from[t] void(dest t mut-slice-view, source t[]) bare
	dest copy-from source[0 .. end]
-copy-from[t] void(dest t mut-slice-view, source t mut-slice-view) bare
	dest copy-from trusted source temp-as-array-view
-copy-from[t] void(dest t mut-slice-view, source t array-view) bare
	assert dest.size == source.size
	trusted if extern native
		dest.begin-pointer mem-move source.begin-pointer, source.size
	elif extern java
		_ void = "java.lang.System" call-static "arraycopy", source.inner, source.indices.low.to::int32, dest.inner, dest.indices.low.to::int32, dest.size.to::int32
	else
		i mut nat64 = 0
		until i == source.size
			dest[i] := source[i]
			i +:= 1

| Swaps the values at `{a}[{i}]` and `{a}[{j}]`.
+swap[t] void(a t mut-slice, i nat64, j nat64) bare
	temp = a[i]
	a[i] := a[j]
	a[j] := temp

| {true} if {a} contains {value}.
+in[t] bool(value t, a t mut-slice) bare, t equal, trusted
	cur mut nat64 = 0
	loop
		if cur == a.size
			break false
		elif a[cur] == value
			break true
		else
			cur +:= 1
			continue

| Overwrites each element `x` with `{f}[x]`.
+map=[t] void(a t mut-slice, f t mut(x t))
	for i : 0::nat64 .. a.size
		a[i] := f[a[i]]

region unsafe

| Allocates a `mut-slice` full of {gc-safe-value}.
| There are usually better ways of creating a mut-slice, such as a `for` over a range.
|
| Keep exceptions in mind: Don't store a reference to the result until it's initialized,
| since initialization code might throw an exception.
|
| This is used by collections like `mut[]` that need some excess capacity that will be GC-safe.
+gc-safe-mut-slice[t] t mut-slice(size nat64) unsafe
	if extern native
		(size.allocate::t mut*)[0 .. size]
	elif extern java
		size.to java-new-array
	elif extern js
		"Array".js-global call size.to::float64 call-property "fill", gc-safe-value::t cast
	else
		todo

| Sets every element to {gc-safe-value}.
+clear-memory[t] void(a t mut-slice-view) bare, unsafe
	if extern native
		a.begin-pointer mem-clear a.size
	else
		i mut nat64 = 0
		until i == a.size
			a[i] := gc-safe-value
			i +:= 1

| Unsafe cast to an immutable array.
| This is O(1).
| WARN: It's undefined behavior if {a} is ever written to again.
+cast-immutable[t] t[](a t mut-slice) bare, unsafe
	if extern native
		a.size new-array a.begin-pointer.as-const
	elif extern java
		a java-cast
	elif extern js
		a js-cast
	else
		todo

~cast-mutable[t] t mut-slice(a t[]) bare, unsafe
	if extern native
		a.size new-mut-slice a.begin-pointer.as-mut
	elif extern java
		a java-cast
	elif extern js
		a js-cast
	else
		todo

~temp-as-array[t] t[](a t mut-slice) bare, unsafe
	a cast-immutable
~temp-as-array-view[t] t array-view(a t mut-slice) bare, unsafe
	a.temp-as-array[0 .. end]
~temp-as-array-view[t] t array-view(a t mut-slice-view) bare, unsafe
	a.inner.temp-as-array, a.indices

| Casts elements to a different type.
| This is O(1).
| If the element type is different, adjusts the size so that the number of bytes is the same.
+cast-mut-slice[out, in] out mut-slice(a in mut-slice) bare, unsafe, native extern
	assert size-of@in != 0 && size-of@out != 0
	size-bytes = a.size * size-of@in
	assert size-bytes % size-of@out == 0
	size-out = size-bytes / size-of@out
	# TODO: shouldn't need parentheses
	(a.begin-pointer.pointer-cast::out mut*)[0 .. size-out]

region spec impls (see collection.crow)

| Calls {f} on each element in {a}.
| If {a} is mutated while iterating, it will affect future calls to {f}.
+iterate[t] bool(a t mut-slice, f bool mut(elem t))
	trusted a.temp-as-array iterate f

+mut-slice-iterator[t] record by-val, mut
	~collection t mut-slice
	~next-index nat64

+begin[t] t mut-slice-iterator(a t mut-slice) bare
	a, 0

+end[t] t mut-slice-iterator(a t mut-slice) bare
	a, a.size

+ +[t] t mut-slice-iterator(a t mut-slice-iterator, b nat64) bare
	new-index = a.next-index + b
	assert new-index <= a.collection.size
	a.collection, new-index

+-[t] t mut-slice-iterator(a t mut-slice-iterator, b nat64) bare
	a.collection, a.next-index - b

+-[t] nat64(a t mut-slice-iterator, b t mut-slice-iterator) bare
	assert a.collection == b.collection
	a.next-index - b.next-index

+prev[t] (t mut-slice-iterator, t)?(a t mut-slice-iterator) bare
	guard a.next-index != 0
	assert a.next-index <= a.collection.size
	value = a.collection[a.next-index - 1]
	((a.collection, a.next-index - 1), value),

+next[t] (t, t mut-slice-iterator)?(a t mut-slice-iterator) bare
	guard a.next-index < a.collection.size
	value = a.collection[a next-index]
	(value, (a.collection, a.next-index + 1)),

+set-prev[t] void(a t mut-slice-iterator, value t) bare
	assert a.next-index != 0 && a.next-index <= a.collection.size
	a.collection[a.next-index - 1] := value

+set-next[t] void(a t mut-slice-iterator, value t) bare
	assert a.next-index < a.collection.size
	a.collection[a next-index] := value

+slice[t] t mut-slice-view(begin t mut-slice-iterator, end t mut-slice-iterator) bare
	assert begin.collection == end.collection : iterator-not-comparable
	assert begin.next-index <= end.next-index : slice-out-of-order
	begin.collection[begin.next-index .. end.next-index]

+mut-slice-builder[t] record mut
	-inner t array-builder
+build[t] t mut-slice(a build-options, f void mut(out t mut-slice-builder)) trusted
	(a build out => f[out,]) cast-mutable
+~=[t] void(a t mut-slice-builder, value t)
	a.inner ~= value
+~~=[t] void(a t mut-slice-builder, values t[])
	a.inner ~~= values
+size[t] nat64(a t mut-slice-builder)
	a.inner size
