no-std
import
	java/lang/System
	../bool: &&, bool, false, true
	../compare: !=, <, <=, equal
	../exception: todo
	../java: java-array-get, java-array-set, java-cast, java-new-array
	../js: as-js, call, call-property, cast, js-cast, js-global, subscript, set-subscript
	../misc: new, subscript, void
	../number: ==, <=>, +, -, float64, int32, nat64, next, to
	../option: new, option
	../range: .., difference, is-empty, iterate, high, low, range, size, subscript
	../tuple: new
	../unsafe: gc-safe-value, reference-equal
	./array: ~=, ~~=, array, array-builder, array-view, build, iterate, size, subscript
	./private/array-low-level: indices, inner, is-empty-type, mut-slice-size, new
	./collection:
		.., build-options, end, for-loop, index-too-big, iterator-not-comparable,
		range-relative-to-end, slice-out-of-order, subscript, to-range
export
	../private/bootstrap: mut-slice

| {true} if {a} and {b} are the exact same reference.
| This is O(1) as it does not need to look at the elements.
+==[t] bool(a t mut-slice, b t mut-slice)
	trusted a reference-equal b

| Creates a new {mut-slice} with the given elements.
+new[t] t mut-slice(...a t[]) trusted
	# A spread argument is always a new array
	a cast-mutable

+mut-slice-view[t] record mut # TODO: this is a silly name -------------------------------------------------------------------------------------
	-inner t mut-slice
	-indices nat64 range

+as-const[t] t array-view(a t mut-slice-view) unsafe
	a.inner.cast-immutable, a.indices

+to[t] t[](a t mut-slice-view)
	for x : a; x

+is-empty[t] bool(a t mut-slice-view)
	a.indices is-empty

+size[t] nat64(a t mut-slice-view)
	a.indices size

+subscript[t] t(a t mut-slice-view, index nat64)
	assert index < a.size : index index-too-big a.size
	a.inner[a.indices.low + index]

+set-subscript[t] void(a t mut-slice-view, index nat64, value t)
	assert index < a.size : index index-too-big a.size
	a.inner[a.indices.low + index] := value

+subscript[t] t mut-slice-view(a t mut-slice, indices nat64 range)
	assert indices.high <= a.size : indices.high index-too-big a.size
	a, indices
+subscript[t] t mut-slice-view(a t mut-slice-view, indices nat64 range)
	a.inner, a.indices[indices]

+iterate[t] bool(a t mut-slice-view, f bool mut(x t))
	i mut = a.indices low
	loop
		if i == a.indices.high
			break false
		elif f[a.inner[i]]
			break true
		else
			i +:= 1
			continue

| Copies the array elements to a new `mut-slice`.
| This is O({a} {size}).
+to[t] t mut-slice(a t[]) trusted
	# Not using a 'for' loop because the compiler may think it may yield (due to the virtual call)
	res t mut-slice = a.size gc-safe-mut-slice
	res[0 .. end] copy-from a
	res

| Copies the elements to an immutable array.
| This is O({a} {size}).
|
| There is no `move-to` function for `mut-slice`,
| since its pointer and size are immutable and so it can't be made empty.
+to[t] t[](a t mut-slice) trusted
	for x : a; x

| Number of elements.
+size[t] nat64(a t mut-slice)
	a mut-slice-size

| {true} if `{a}.{size} == 0`.
+is-empty[t] bool(a t mut-slice)
	a.size == 0

| Copies the elements to a new `mut-slice`.
| This is O({a} {size}).
+copy[t] t mut-slice(a t mut-slice)
	for x : a; x

+subscript[t] t(a t mut-slice, index nat64) trusted
	assert index < a.size : index index-too-big a.size
	if extern java
		a java-array-get index.to
	elif extern js
		a.as-js[index] cast
	else
		throw todo

+set-subscript[t] void(a t mut-slice, index nat64, value t) trusted
	assert index < a.size : index index-too-big a.size
	if extern java
		a java-array-set index.to, value
	elif extern js
		a.as-js[index] := value
	else
		throw todo

+set-subscript[t] void(dest t mut-slice, range nat64 range, source t[])
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice, range nat64 range, source t array-view)
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice, range nat64 range, source t mut-slice)
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice, range nat64 range, source t mut-slice-view)
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice, range range-relative-to-end, source t[])
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice, range range-relative-to-end, source t array-view)
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice, range range-relative-to-end, source t mut-slice)
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice, range range-relative-to-end, source t mut-slice-view)
	dest[range to-range dest.size] copy-from source

# TODO: overloading this on every collection is silly. It should work on anything with 'size' and 'iterate'. -----------------------------
+set-subscript[t] void(dest t mut-slice-view, range nat64 range, source t[])
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range nat64 range, source t array-view)
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range nat64 range, source t mut-slice)
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range nat64 range, source t mut-slice-view)
	dest[range] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range range-relative-to-end, source t[])
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range range-relative-to-end, source t array-view)
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range range-relative-to-end, source t mut-slice)
	dest[range to-range dest.size] copy-from source
+set-subscript[t] void(dest t mut-slice-view, range range-relative-to-end, source t mut-slice-view)
	dest[range to-range dest.size] copy-from source

| Overwrites {dest} with the contents of {source}.
| {dest} and {source} must be the same size.
+copy-from[t] void(dest t mut-slice-view, source t mut-slice)
	dest copy-from source[0 .. end]
-copy-from[t] void(dest t mut-slice-view, source t[])
	dest copy-from source[0 .. end]
-copy-from[t] void(dest t mut-slice-view, source t mut-slice-view)
	dest copy-from trusted source temp-as-array-view
-copy-from[t] void(dest t mut-slice-view, source t array-view)
	assert dest.size == source.size
	if trusted extern java
		trusted unless is-empty-type@t
			source.inner.java-cast arraycopy source.indices.low.to::int32, dest.inner.java-cast, dest.indices.low.to::int32, dest.size.to::int32 # TODO:PERF use wrap-to instead
	else
		i mut nat64 = 0
		until i == source.size
			dest[i] := source[i]
			i +:= 1

| Swaps the values at `{a}[{i}]` and `{a}[{j}]`.
+swap[t] void(a t mut-slice, i nat64, j nat64)
	temp = a[i]
	a[i] := a[j]
	a[j] := temp

| {true} if {a} contains {value}.
+in[t] bool(value t, a t mut-slice) t equal, trusted
	cur mut nat64 = 0
	loop
		if cur == a.size
			break false
		elif a[cur] == value
			break true
		else
			cur +:= 1
			continue

| Overwrites each element `x` with `{f}[x]`.
+map=[t] void(a t mut-slice, f t mut(x t))
	for i : 0::nat64 .. a.size
		a[i] := f[a[i]]

region unsafe

| Allocates a `mut-slice` full of {gc-safe-value}.
| There are usually better ways of creating a mut-slice, such as a `for` over a range.
|
| Keep exceptions in mind: Don't store a reference to the result until it's initialized,
| since initialization code might throw an exception.
|
| This is used by collections like `mut[]` that need some excess capacity that will be GC-safe.
+gc-safe-mut-slice[t] t mut-slice(size nat64) unsafe
	# TODO: Why not just make 'gc-safe-mut-slice' a builtin? That's all we need 'java-new-array' for anyway --------------------------
	if extern java
		size.to java-new-array
	elif extern js
		"Array".js-global call size.to::float64 call-property "fill", gc-safe-value::t cast
	else
		throw todo

| Sets every element to {gc-safe-value}.
+clear-memory[t] void(a t mut-slice-view) unsafe
	i mut nat64 = 0
	until i == a.size
		a[i] := gc-safe-value
		i +:= 1

| Unsafe cast to an immutable array.
| This is O(1).
| WARN: It's undefined behavior if {a} is ever written to again.
+cast-immutable[t] t[](a t mut-slice) unsafe
	if extern java
		a java-cast
	elif extern js
		a js-cast
	else
		throw todo

~cast-mutable[t] t mut-slice(a t[]) unsafe
	if extern java
		a java-cast
	elif extern js
		a js-cast
	else
		throw todo

~temp-as-array[t] t[](a t mut-slice) unsafe
	a cast-immutable
~temp-as-array-view[t] t array-view(a t mut-slice) unsafe
	a.temp-as-array[0 .. end]
~temp-as-array-view[t] t array-view(a t mut-slice-view) unsafe
	a.inner.temp-as-array, a.indices

region spec impls (see collection.crow)

| Calls {f} on each element in {a}.
| If {a} is mutated while iterating, it will affect future calls to {f}.
+iterate[t] bool(a t mut-slice, f bool mut(elem t))
	trusted a.temp-as-array iterate f

+mut-slice-iterator[t] record mut
	~collection t mut-slice
	~next-index nat64

+begin[t] t mut-slice-iterator(a t mut-slice)
	a, 0

+end[t] t mut-slice-iterator(a t mut-slice)
	a, a.size

+ +[t] t mut-slice-iterator(a t mut-slice-iterator, b nat64)
	new-index = a.next-index + b
	assert new-index <= a.collection.size
	a.collection, new-index

+-[t] t mut-slice-iterator(a t mut-slice-iterator, b nat64)
	a.collection, a.next-index - b

+-[t] nat64(a t mut-slice-iterator, b t mut-slice-iterator)
	assert a.collection == b.collection
	a.next-index - b.next-index

+prev[t] (t mut-slice-iterator, t)?(a t mut-slice-iterator)
	guard a.next-index != 0
	assert a.next-index <= a.collection.size
	value = a.collection[a.next-index - 1]
	(a.collection, a.next-index - 1), value

+next[t] (t, t mut-slice-iterator)?(a t mut-slice-iterator)
	guard a.next-index < a.collection.size
	value = a.collection[a next-index]
	value, (a.collection, a.next-index + 1)

+set-prev[t] void(a t mut-slice-iterator, value t)
	assert a.next-index != 0 && a.next-index <= a.collection.size
	a.collection[a.next-index - 1] := value

+set-next[t] void(a t mut-slice-iterator, value t)
	assert a.next-index < a.collection.size
	a.collection[a next-index] := value

+slice[t] t mut-slice-view(begin t mut-slice-iterator, end t mut-slice-iterator)
	assert begin.collection == end.collection : iterator-not-comparable
	assert begin.next-index <= end.next-index : slice-out-of-order
	begin.collection[begin.next-index .. end.next-index]

+mut-slice-builder[t] record mut
	-inner t array-builder
+build[t] t mut-slice(a build-options, f void mut(out t mut-slice-builder)) trusted
	(a build out => f[out,]) cast-mutable
+~=[t] void(a t mut-slice-builder, value t)
	a.inner ~= value
+~~=[t] void(a t mut-slice-builder, values t[])
	a.inner ~~= values
+size[t] nat64(a t mut-slice-builder)
	a.inner size
