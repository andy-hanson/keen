no-std
import
	../bool: &&, ||, bool, false, not, true
	../compare: >, >=
	../hash: hash, hash-mix
	../json: to
	../misc: key, new, subscript, void
	../number: ==, <=>, +, -, *, %, is-even, nat64
	../option: ==, ??, is-empty, new, option
	../string: ==, interpolate, join, show, string, upper-case
	../test-util: is, should-throw
	../tuple: ==, new, tuple2
	./array: ==, ~=, array, build, iterate, new, size
	./collection: build-options, fill, find, find-index, for-loop, n-of, size-hint, was-locked
	./map: ==, ~=, build, map, new
	./mut-array:
		~=, copy, filter=, is-at-capacity, is-empty, iterate, map=, move-to, mut-array, new,
		remove-unordered-at, set-subscript, size, subscript
	./mut-slice:
		~=, begin, build, iterate, is-empty, map=, mut-slice, new, next, set-next, set-subscript,
		size, subscript
	../symbol: to

| Mutable unordered map.
+mut-map[k, v] record mut
	-locked mut bool
	-entries mut (k, v) entry mut-slice
	-total-size mut nat64

-entry[k, v] union(none, (k, v), (k, v) mut[]) mut
-none record

| New map containing the given pairs.
| Later pairs overwrite earlier pairs with the same key.
+new[k, v] v mut[k](...a (k, v)[]) k key
	a to

| New empty map with space for approximately {capacity} entries.
| This can have a small performance benefit if you know that much space will be needed.
|
| Since hash conflicts are possible,
| this makes no guarantees about whether more allocations will be needed.
-mut-map-with-capacity[k, v] v mut[k](capacity nat64) k key
	false, (capacity n-of none), 0

| Convert a list of pairs to a map.
| Later pairs overwrite earlier pairs with the same key.
+to[k, v] v mut[k](a (k, v)[]) k key
	for x : a; x
+to[k, v] v[k](a v mut[k]) k key
	for x : a; x

| Copy pairs to an array.
+to[k, v] (k, v)[](a v mut[k]) k key
	for x : a; x

| Copy pairs to an array and clear the map.
+move-to[k, v] (k, v)[](a v mut[k]) k key
	res (k, v)[] = a to
	a clear
	res
+move-to[k, v] v[k](a v mut[k]) k key
	res v[k] = a to
	a clear
	res
+move-to[k, v] v mut[k](a v mut[k]) k key
	forbid a.locked
	res v mut[k] = false, a.entries, a.total-size
	a.entries := ()
	a.total-size := 0
	res

| Copy pairs to a new {mut-map}.
+copy[k, v] v mut[k](a v mut[k]) k key
	forbid a locked : was-locked
	a.locked := true
	finally do
		a.locked := false
	entries (k, v) entry mut-slice = for entry : a entries
		match entry
		as none
			none
		as tuple2 x
			x to
		as mut-array x
			x.copy to
	false, entries, a.total-size
test
	a string mut[nat64] = (1, "1"), (2, "2"), (5, "5")
	a verify "_ (1 -> 1) [2 -> 2, 5 -> 5]"

	b = a copy
	b verify "_ (1 -> 1) [2 -> 2, 5 -> 5]"

	a[6] := "6"
	a verify "(6 -> 6) (1 -> 1) [2 -> 2, 5 -> 5]"
	b verify "_ (1 -> 1) [2 -> 2, 5 -> 5]"

| {true} if `{a}.{size} == 0`.
+is-empty[k, v] bool(a v mut[k]) k key
	a.size == 0

| Number of pairs in the map.
+size[k, v] nat64(a v mut[k]) k key
	a total-size

| Gets the value associated with a key.
| Returns an empty option if `{key} !{in} {a}`.
+subscript[k, v] v?(a v mut[k], key k) k key
	guard a !is-empty
	match a.entries[key.hash % a.entries.size]
	as none
		()
	as tuple2 k, v
		k == key ? v,
	as mut-array m
		if (_, v) ?= m find (k, _) => k == key
			v,

| {true} if some pair in the map has the {key}.
+in[k, v] bool(key k, a v mut[k]) k key
	!a[key].is-empty

| Sets the key to the given value, so that `{a}[{key}]` will return {value}.
| If `{key} {in} {a}`, this overwrites the previous value.
+set-subscript[k, v] void(a v mut[k], key k, value v) k key
	_ = a update key, (value,)

| Removes all pairs, leaving the map empty.
+clear[k, v] void(a v mut[k]) k key
	forbid a locked : was-locked
	a.entries fill none
	a.total-size := 0

| Set the contents of {a} to the contents of {b} and vice versa.
| This is O(1).
+swap[k, v] void(a v mut[k], b v mut[k]) k key
	forbid a locked || b locked : was-locked
	temp-entries = a entries
	a.entries := b entries
	b.entries := temp-entries
	temp-size = a.total-size
	a.total-size := b total-size
	b.total-size := temp-size

| If `{key} {in} {a}`, removes it and returns the associated value.
| Returns an empty option if `{key} !{in} {a}`.
+remove[k, v] v?(a v mut[k], key k) k key
	a update key, ()

| Ensures that a key is the map.
| If `{key} {in} {a}`, does nothing and returns the associated value.
| If `{key} !{in} {a}`, sets the value to `{get-value}[]` and returns that.
+ensure[k, v] v(a v mut[k], key k, get-value v mut()) k key
	forbid a locked
	a[key] ?? do
		value = get-value[]
		a[key] := value
		value

+ensure[k, v] v(a v mut[k], key k) k key, v new
	a ensure key, () => ()

| Returns the old value (if it exists).
-update[k, v] v?(a v mut[k], key k, new-value v?) k key
	forbid a locked : was-locked
	if a.entries is-empty
		if value ?= new-value
			a.entries := (key, value).to,
			a.total-size := 1
		()
	else
		entry-index = key.hash % a.entries.size
		match a.entries[entry-index]
		as none
			guard value ?= new-value
			a.entries[entry-index] := (key, value) to
			a.total-size +:= 1
			()
		as tuple2 k, v
			if k == key
				a.entries[entry-index] := if value ?= new-value
					(key, value) to
				else
					a.total-size -:= 1
					none
				v,
			else
				guard value ?= new-value
				if a should-expand
					a expand
					a[key] := value
				else
					a.entries[entry-index] := ((k, v), (key, value)) to
					a.total-size +:= 1
				()
		as mut-array m
			if index ?= m find-index (k, _) => k == key
				_, old-value = m[index]
				if value ?= new-value
					m[index] := key, value
				else
					_ = m remove-unordered-at index
					match m size
					as 0
						a.entries[entry-index] := none
					as 1
						a.entries[entry-index] := m[0] to
					else
						()
					a.total-size -:= 1
				old-value,
			else
				guard value ?= new-value
				at-capacity = trusted if extern native
					m is-at-capacity
				else
					true
				if at-capacity && a should-expand
					a expand
					a[key] := value
				else
					m ~= (key, value)
					a.total-size +:= 1
				()

| This is the same as calling `{a}[{key}] := {value}`.
| Prefer to write it that way instead.
+~=[k, v] void(a v mut[k], (key k, value v)) k key
	a[key] := value

+~~=[k, v] void(a v mut[k], pairs (k, v)[]) k key
	for pair : pairs; a ~= pair

| Called when we're about to allocate a bigger bucket -- maybe we should expand the table instead.
-should-expand[k, v] bool(a v mut[k])
	a.total-size >= a.entries.size

-expand[k, v] void(a v mut[k]) k key
	forbid a.entries.size == 0
	new-size = a.entries.size * 2
	bigger v mut[k] = new-size mut-map-with-capacity
	for k, v : a
		bigger[k] := v
	a swap bigger
	assert a.entries.size == new-size

| Filters the map in place.
| Calls {f} on every key and value and removes the key if {f} returns {false}.
+filter=[k, v] void(a v mut[k], f bool mut(key k, value v)) k key
	forbid a locked : was-locked
	a.locked := true
	finally do
		a.locked := false
	a.entries map= entry =>
		match entry
		as none
			none
		as tuple2 k, v
			if f[k, v]
				(k, v) to
			else
				none
		as mut-array m
			m filter= f
			if m is-empty
				none
			elif m.size == 1
				m[0] to
			else
				m to
test
	a string mut[nat64] = (0, "zero"), (1, "one"), (2, "two")
	a filter= (key, _) =>
		try
			a[3] := "three"
			should-throw
		catch was-locked _
			()
		key is-even
	a.to::string[nat64] is ((0, "zero"), (2, "two"))

| Calls {f} on every key and value, and replaces the value with the new value returned by {f}.
| Does not modify keys.
+map-values=[k, v] void(a v mut[k], f v mut(key k, value v)) k key
	forbid a locked : was-locked
	a.locked := true
	finally do
		a.locked := false
	a.entries map= entry =>
		match entry
		as none
			none
		as tuple2 k, v
			(k, f[k, v]) to
		as mut-array m
			m map= (k, v) => k, f[k, v]
			m to
test
	a string mut[nat64] = (0, "zero"), (1, "one"), (2, "two")
	a map-values= (_, value) =>
		try
			a[3] := "three"
			should-throw
		catch was-locked
			()
		value upper-case
	a.to::string[nat64] is ((0, "ZERO"), (1, "ONE"), (2, "TWO"))

region spec impls (see collection.crow)

| Calls {f} for every key and value in the map.
+iterate[k, v] bool(a v mut[k], f bool mut(key k, value v)) k key
	forbid a locked : was-locked
	a.locked := true
	finally do
		a.locked := false
	i mut nat64 = 0
	loop
		if i == a.entries.size
			break false
		else
			done = match a.entries[i]
			as none
				false
			as tuple2 x
				f[x]
			as mut-array m
				m iterate f
			if done
				break true
			else
				i +:= 1
				continue
test
	a string mut[nat64] = (0, "zero"), (1, "one")
	calls (nat64, string) mut[] = ()
	for pair : a
		try
			_ = a remove 0
			should-throw
		catch was-locked
			()
		calls ~= pair
	calls.move-to::(nat64, string)[] is ((0, "zero"), (1, "one"))

+build[k, v] v mut[k](a build-options, f void mut(out v mut[k])) k key
	res v mut[k] = a.size-hint mut-map-with-capacity
	f[res]
	res

region test

-dbg[k, v] string(a v mut[k]) k show, v show
	parts string[] = for entry : a entries
		match entry
		as none
			"_"
		as tuple2 ar
			"({ar dbg})"
		as mut-array m
			"[{", " join for pair : m; pair dbg}]"
	" " join parts
-dbg[k, v] string((k k, v v)) k show, v show
	"{k} -> {v}"

-verify void(a string mut[nat64], expected string)
	a.dbg is expected

test
	a string mut[nat64] = ()

	a[6] := "6"
	a[5] is ()
	a[6] is ("6",)
	a.size is 1
	a.to::(nat64, string)[] is ((6, "6"),)

	a verify "(6 -> 6)"

	a[6] := "six"
	a verify "(6 -> six)"

	a[3] := "3"
	a verify "(6 -> six) (3 -> 3)"

	a[4] := "4"
	a verify "(4 -> 4) _ (6 -> six) (3 -> 3)"

	a[8] := "8"
	a verify "[4 -> 4, 8 -> 8] _ (6 -> six) (3 -> 3)"

	a[4] is ("4",)
	a[8] is ("8",)
	a[5] is ()

	a.to::(nat64, string)[] is ((4, "4"), (8, "8"), (6, "six"), (3, "3"))

	a[12] := "12"
	a verify "(8 -> 8) _ _ (3 -> 3) [4 -> 4, 12 -> 12] _ (6 -> six) _"

	a remove 5 is ()
	a remove 4 is ("4",)

	a verify "(8 -> 8) _ _ (3 -> 3) (12 -> 12) _ (6 -> six) _"

	a[11] := "11"
	a verify "(8 -> 8) _ _ [3 -> 3, 11 -> 11] (12 -> 12) _ (6 -> six) _"

	a filter= (key, value) => key > 10 || value == "six"
	a verify "_ _ _ (11 -> 11) (12 -> 12) _ (6 -> six) _"

	a map-values= (key, value) => "{key}-{value}"
	a verify "_ _ _ (11 -> 11-11) (12 -> 12-12) _ (6 -> 6-six) _"
