no-std
import
	../bool: ==, ||, bool, false, new, not, true
	../compare: <, <=, >, >=
	../hash: get-hash, hash-mix, key
	../json: to
	../misc: new, subscript, void
	../number: ==, <=>, +, -, *, /, %, is-even, nat64
	../option: ==, force, is-empty, new, option
	../string: ==, <=>, interpolate, join, show, string, upper-case
	../test-util: is, should-throw
	../tuple: ==, <=>, b, new
	./array: ==, ~=, array, build, iterate, new, size
	./collection: build-options, fill, for-loop, n-of, size-hint, was-locked, with-index
	./map: ==, ~=, build, map, new
	./mut-array: ~=, move-to, mut-array, new
	./mut-slice:
		~=, begin, build, copy, iterate, is-empty, map=, mut-slice, new, next, set-next, set-subscript,
		size, subscript, swap
	./sort
	../symbol: to

| Mutable unordered map.
+mut-map[k, v] record mut
	-locked mut bool
	-size_ mut nat64
	-entries mut (k, v)? mut-slice

| New map containing the given pairs.
| Later pairs overwrite earlier pairs with the same key.
+new[k, v] v mut[k](...a (k, v)[]) k key
	a to

| New empty map with space for approximately {capacity} entries.
| This can have a small performance benefit if you know that much space will be needed.
|
| Since hash conflicts are possible,
| this makes no guarantees about whether more allocations will be needed.
~mut-map-with-capacity[k, v] v mut[k](capacity nat64) k key
	false, 0, (capacity n-of ())

| Convert a list of pairs to a map.
| Later pairs overwrite earlier pairs with the same key.
+to[k, v] v mut[k](a (k, v)[]) k key
	for x : a; x
+to[k, v] v[k](a v mut[k]) k key
	for x : a; x
| Copy pairs to an array.
+to[k, v] (k, v)[](a v mut[k]) k key
	for x : a; x

| Copy pairs to an array and clear the map.
+move-to[k, v] (k, v)[](a v mut[k]) k key
	res (k, v)[] = a to
	a clear
	res
+move-to[k, v] v[k](a v mut[k]) k key
	# TODO: map should have a possibility that is a flat hash table instead of a tree, then this won't have to allocate ---------------
	res v[k] = a to
	a clear
	res
+move-to[k, v] v mut[k](a v mut[k]) k key
	forbid a.locked
	res v mut[k] = false, a.size_, a.entries
	a.size_ := 0
	a.entries := ()
	res

| Copy pairs to a new {mut-map}.
+copy[k, v] v mut[k](a v mut[k]) k key
	false, a.size_, a.entries.copy
test
	a string mut[nat64] = (1, "1"), (2, "2"), (5, "5")
	a verify "5 -> 5, 1 -> 1, 2 -> 2"

	b = a copy
	b verify "5 -> 5, 1 -> 1, 2 -> 2"

	a[6] := "6"
	a verify "6 -> 6, 1 -> 1, 2 -> 2, _, _, 5 -> 5"
	b verify "5 -> 5, 1 -> 1, 2 -> 2"

| {true} if `{a}.{size} == 0`.
+is-empty[k, v] bool(a v mut[k]) k key
	a.size == 0

| Number of pairs in the map.
+size[k, v] nat64(a v mut[k]) k key
	a size_

~hint-size[k, v] void(a v mut[k], size nat64) k key
	if size > a.entries.size / 2
		a expand-to-capacity size * 9 / 8

| Gets the value associated with a key.
| Returns an empty option if `{key} !{in} {a}`.
+subscript[k, v] v?(a v mut[k], key k) k key
	if index ?= a.entries get-index key
		a.entries[index]! b

| {true} if some pair in the map has the {key}.
+in[k, v] bool(key k, a v mut[k]) k key
	a.entries get-index key !is-empty

| Sets the key to the given value, so that `{a}[{key}]` will return {value}.
| If `{key} {in} {a}`, this overwrites the previous value.
+set-subscript[k, v] void(a v mut[k], key k, value v) k key
	forbid a locked : was-locked
	if index ?= a.entries get-index key
		# TODO:PERF this needlessly overwrites the key with an equivalent one -----------------------------------------
		a.entries[index] := key, value
	else
		a must-add key, value

| Removes all pairs, leaving the map empty.
+clear[k, v] void(a v mut[k]) k key
	forbid a locked : was-locked
	a.entries fill ()
	a.size_ := 0

| Set the contents of {a} to the contents of {b} and vice versa.
| This is O(1).
+swap[k, v] void(a v mut[k], b v mut[k]) k key
	forbid a locked || b locked : was-locked
	temp-entries = a entries
	a.entries := b entries
	b.entries := temp-entries
	temp-size = a.size_
	a.size_ := b size_
	b.size_ := temp-size
test
	a string mut[nat64] = (1, "one"),
	b string mut[nat64] = ()
	a swap b
	a.to::string[nat64] is ()
	b.to::string[nat64] is ((1, "one"),)

| If `{key} {in} {a}`, removes it and returns the associated value.
| Returns an empty option if `{key} !{in} {a}`.
+remove[k, v] v?(a v mut[k], key k) k key
	forbid a locked : was-locked
	guard index ?= a.entries get-index key
	value = a.entries[index]!.b
	a remove-at-index index
	value
test
	a string mut[nat64] = (1, "one"),
	a remove 2 is ()
	a.size is 1
	a remove 1 is "one"
	a.size is 0
	a remove 1 is ()

-remove-at-index[k, v] void(a v mut[k], index nat64) k key
	# When there is a hole, move values closer to where they should be.
	hole mut = index
	a.entries[hole] := ()
	from mut = index next-index a.entries
	while key, _ ?= a.entries[from]
		key-desired-index = key.get-hash % a.entries.size
		if (a.entries walk-distance key-desired-index, hole) < (a.entries walk-distance key-desired-index, from)
			a.entries swap hole, from
			hole := from
		from next-index:= a.entries
	a.size_ -:= 1

| Ensures that a key is the map.
| If `{key} {in} {a}`, does nothing and returns the associated value.
| If `{key} !{in} {a}`, sets the value to `{get-value}[]` and returns that.
+ensure[k, v] v(a v mut[k], key k, get-value v mut()) k key
	forbid a locked : was-locked
	a.locked := true
	finally a.locked := false
	res = if index ?= a.entries get-index key
		a.entries[index]! b
	else
		value = get-value[]
		a must-add key, value
		value
	res
test
	a string mut[nat64] = ()
	a ensure 1, (() => "one") is "one"
	a ensure 1, (() => "two") is "one"
	try
		_ = a ensure 2, () =>
			a[3] := "three"
			"two"
		should-throw
	catch was-locked
		a.locked is false
		a.size is 1

+ensure[k, v] v(a v mut[k], key k) k key, v new
	a ensure key, () => ()

-must-add[k, v] void(a v mut[k], key k, value v) k key
	if a should-expand-before-add
		a do-expand
	a.size_ +:= 1
	a.entries must-add-to-entries key, value

-must-add-to-entries[k, v] void(entries (k, v)? mut-slice, initial-key k, initial-value v) k key
	key mut = initial-key
	value mut = initial-value
	index mut = key hash entries.size
	my-cost mut nat64 = 0
	loop
		if existing-key, existing-value ?= entries[index]
			forbid existing-key == key
			its-cost = entries cost existing-key, index
			if my-cost > its-cost
				entries[index] := key, value
				key := existing-key
				value := existing-value
				my-cost := its-cost
			index next-index:= entries
			my-cost +:= 1
			continue
		else
			entries[index] := key, value
			break

-cost[k, v] nat64(entries (k, v)? mut-slice, key k, actual-index nat64) k key
	entries walk-distance (key hash entries.size), actual-index

-hash[k] nat64(key k, array-size nat64) k key
	key.get-hash % array-size

| This is the same as calling `{a}[{key}] := {value}`.
| Prefer to write it that way instead.
+~=[k, v] void(a v mut[k], (key k, value v)) k key
	a[key] := value

+~~=[k, v] void(a v mut[k], pairs (k, v)[]) k key
	for pair : pairs; a ~= pair

-get-index[k, v] nat64?(entries (k, v)? mut-slice, key k) k key
	guard entries !is-empty
	start-i = key hash entries.size
	i mut = start-i
	loop
		if k, _ ?= entries[i]
			if key == k
				break i
			else
				i next-index:= entries
				if i == start-i
					break ()
				else
					continue
		else
			break ()

-next-index[t] nat64(index nat64, array t mut-slice)
	res = index + 1
	if res == array.size
		0
	else
		res

| Number of {next-index} calls it would take to get from {from} to {to}
-walk-distance[t] nat64(entries t mut-slice, from nat64, to nat64)
	if from <= to
		to - from
	else
		entries.size + to - from

-should-expand-before-add[k, v] bool(a v mut[k]) k key
	if a.size_ <= 8
		a.size_ == a.entries.size
	else
		a.size_ * 4 / 3 >= a.entries.size

-do-expand[k, v] void(a v mut[k]) k key
	a expand-to-capacity (a.entries.size < 2 ? 2 : a.entries.size * 2)

-expand-to-capacity[k, v] void(a v mut[k], new-capacity nat64) k key
	new-entries (k, v)? mut-slice = new-capacity n-of ()
	for e : a entries
		if k, v ?= e
			new-entries must-add-to-entries k, v
	a.entries := new-entries

| Filters the map in place.
| Calls {f} on every key and value and removes the key if {f} returns {false}.
+filter=[k, v] void(a v mut[k], f bool mut(key k, value v)) k key
	forbid a locked : was-locked
	a.locked := true
	finally a.locked := false
	i mut nat64 = 0
	until i == a.entries.size
		rm = if x ?= a.entries[i]
			!f[x]
		if rm
			a remove-at-index i
		else
			i +:= 1
	a.entries map= entry =>
		if x ?= entry
			if f[x]
				x
test
	a string mut[nat64] = (0, "zero"), (1, "one"), (2, "two")
	a filter= (key, _) =>
		try
			a[3] := "three"
			should-throw
		catch was-locked _
			()
		key is-even
	a verify "0 -> zero, _, 2 -> two"
	a.to::string[nat64] is ((0, "zero"), (2, "two"))

| Calls {f} on every key and value, and replaces the value with the new value returned by {f}.
| Does not modify keys.
+map-values=[k, v] void(a v mut[k], f v mut(key k, value v)) k key
	forbid a locked : was-locked
	a.locked := true
	finally a.locked := false
	a.entries map= entry =>
		if k, v ?= entry
			k, f[k, v]
test
	a string mut[nat64] = (0, "zero"), (1, "one"), (2, "two")
	a map-values= (_, value) =>
		try
			a[3] := "three"
			should-throw
		catch was-locked
			()
		value upper-case
	a.to::string[nat64] is ((0, "ZERO"), (1, "ONE"), (2, "TWO"))

region spec impls (see collection.crow)

| Calls {f} for every key and value in the map.
+iterate[k, v] bool(a v mut[k], f bool mut(key k, value v)) k key
	forbid a locked : was-locked
	a.locked := true
	finally a.locked := false
	i mut nat64 = 0
	loop
		if i == a.entries.size
			break false
		else
			done = if x ?= a.entries[i]
				f[x]
			if done
				break true
			else
				i +:= 1
				continue
test
	a string mut[nat64] = (0, "zero"), (1, "one")
	calls (nat64, string) mut[] = ()
	for pair : a
		try
			_ = a remove 0
			should-throw
		catch was-locked
			()
		calls ~= pair
	calls.move-to::(nat64, string)[].sort is ((0, "zero"), (1, "one"))

+build[k, v] v mut[k](a build-options, f void mut(out v mut[k])) k key
	res v mut[k] = a.size-hint mut-map-with-capacity
	f[res]
	res

region test

-dbg[k, v] string(a v mut[k]) k show, v show
	", " join for entry : a entries
		if k, v ?= entry
			"{k} -> {v}"
		else
			"_"

-verify void(a string mut[nat64], expected string)
	if false # TODO: changing the hash algorithm broke this --------------------------------------------------------------------------
		a.dbg is expected

-verify-costs void(a string mut[nat64], costs nat64[])
	if false # TODO: changing the hash algorithm broke this --------------------------------------------------------------------------
		actual-costs nat64[] = for index, x : a.entries with-index
			if key, _ ?= x
				a.entries cost key, index
			else
				0
		actual-costs is costs

test
	a string mut[nat64] = ()

	a[6] := "6"
	a[5] is ()
	a[6] is "6"
	a.size is 1
	a.to::(nat64, string)[] is ((6, "6"),)

	a verify "6 -> 6, _"

	a[6] := "six"
	a verify "6 -> six, _"

	a[3] := "3"
	a verify "6 -> six, 3 -> 3"

	a[4] := "4"
	a verify "4 -> 4, _, 6 -> six, 3 -> 3"

	a[8] := "8"
	a verify "4 -> 4, 8 -> 8, 6 -> six, 3 -> 3"

	a[4] is "4"
	a[8] is "8"
	a[5] is ()

	a.to::(nat64, string)[].sort is ((3, "3"), (4, "4"), (6, "six"), (8, "8"))

	a[12] := "12"
	a verify "8 -> 8, _, _, 3 -> 3, 4 -> 4, 12 -> 12, 6 -> six, _"

	a remove 5 is ()
	a remove 4 is "4"

	a verify "8 -> 8, _, _, 3 -> 3, 12 -> 12, _, 6 -> six, _"

	a[11] := "11"
	a verify "8 -> 8, _, _, 3 -> 3, 11 -> 11, 12 -> 12, 6 -> six, _"
	a verify-costs (0, 0, 0, 0, 1, 1, 0, 0)

	a filter= (key, value) => key > 10 || value == "six"
	a verify "_, _, _, 11 -> 11, 12 -> 12, _, 6 -> six, _"

	a map-values= (key, value) => "{key}-{value}"
	a verify "_, _, _, 11 -> 11-11, 12 -> 12-12, _, 6 -> 6-six, _"
