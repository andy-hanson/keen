no-std
import
	../bits
	../bool
	../compare
	../exception
	../js
	../misc
	../number
	../option
	../range
	../tuple
	./collection
	./private/array-low-level
	../private/bootstrap: mut-slice

| Calls {f} for each element in the collection and returns nothing.
+for-loop[col, elem] void(a col, f void mut(elem elem)) (col, elem) iterate
	res = a iterate of x
		f[x]
		false
	forbid res

| Calls {f} for each element in the input collection
| and returns an output collection of the results of {f}.
+for-loop[out-col, out-elem, in-col, in-elem] out-col
	a in-col
	f out-elem mut(elem in-elem)
do (out-col, out-elem) list-new, (in-col, in-elem) iterate, in-col size
	trusted
	size = a size
	res out-elem mut-slice = size gc-safe-mut-slice
	i mut nat = 0
	_ = a iterate of x
		res array-set i, f[x]
		i +:= 1
		false
	assert i == size
	res.cast-immutable list-new

| Calls {f} for each element in the input collection,
| and returns an output collection of the elements for which {f} returned {true}.
+filter[out-col, elem, in-col] out-col
	a in-col
	f bool mut(elem elem)
do (out-col, elem) list-new, in-col size, (in-col, elem) iterate
	trusted
	in-size = a size
	res elem mut-slice = in-size gc-safe-mut-slice
	out-size mut nat = 0
	_ = a iterate of x
		if f[x]
			res array-set out-size, x
			out-size +:= 1
			assert out-size <= in-size
		false
	res.cast-immutable[0 .. out-size].to list-new

| Same as {for-loop}.
| For good style, use this only with an `it` lambda.
| `xs map it.abs` is OK, but instead of `xs map of x ...`, prefer `for x in xs ...`
+map[out-col, out-elem, in-col, in-elem] out-col
	a in-col
	f out-elem mut(elem in-elem)
do (out-col, out-elem) list-new, (in-col, in-elem) iterate, in-col size
	a for-loop f

| Only returns a result if {f} returned a non-empty option every time.
+map-every[out-col, out-elem, in-col, in-elem] out-col?
	a in-col
	f out-elem? mut(x in-elem)
do (out-col, out-elem) list-new, in-col size, (in-col, in-elem) iterate
	ok mut bool = false
	out out-elem builder = a.size,
	ok := a !iterate of x
		if y = f[x]
			out ~= y
			false
		else
			true
	if ok then out finish

+map-values[out-col, out-value, in-col, in-value, key] out-col
	col in-col
	f out-value mut(value in-value)
do (out-col, (key, out-value)) list-new, (in-col, (key, in-value)) iterate, in-col size
	col map of k, v
		k, f[v]

+n-of[col, elem] col(n nat64, value elem) (col, elem) list-new
	trusted
	res elem mut-slice = n gc-safe-mut-slice
	for i in 0 .. n
		res array-set i, value
	res.cast-immutable list-new

+concatenate[col] spec
	~~ col(a col, b col)
+repeat[col] col(a col, n nat64) col concatenate, col new
	res mut col = ()
	for _ in 0 .. n
		res ~~:= a
	res

| Like `for-loop`, but {f} must return an array of outputs which are all added to the result.
+for-star[out-col, out-elem, in-col, in-elem] out-col
	a in-col
	f out-elem[] mut(elem in-elem)
do (out-col, out-elem) list-new, (in-col, in-elem) iterate
	out out-elem builder = ()
	_ = a iterate of x
		out ~~= f[x]
		false
	out finish

+with-index[col] record(inner col)
+first[out, col, elem] out?(a col with-index, f out? mut(index nat64, elem elem)) (col, elem) iterate
	i mut nat64 = 0
	res mut out? = ()
	_ = a.inner iterate of x
		res := f[i, x]
		i +:= 1
		!!res
	res
+for-loop[col, elem] void(a col with-index, f void mut(index nat64, elem elem)) (col, elem) iterate
	i mut nat64 = 0
	_ = a.inner iterate of x
		f[i, x]
		i +:= 1
		false
+for-loop[out-col, out-elem, in-col, in-elem] out-col
	a in-col with-index
	f out-elem mut(index nat64, elem in-elem)
do (out-col, out-elem) list-new, (in-col, in-elem) iterate, in-col size
	out out-elem builder = a.inner.size,
	i mut nat64 = 0
	_ = a.inner iterate of x
		out ~= f[i, x]
		i +:= 1
		false
	out finish
+exists[col, elem] bool(a col with-index, f bool mut(index nat64, elem elem)) (col, elem) iterate
	i mut nat64 = 0
	a.inner iterate of x
		res = f[i, x]
		i +:= 1
		res
+every[col, elem] bool(a col with-index, f bool mut(index nat64, elem elem)) (col, elem) iterate
	a !exists !f[it]
+for-star[out-col, out-elem, in-col, in-elem] out-col
	a in-col with-index
	f out-elem[] mut(index nat64, elem in-elem)
do (out-col, out-elem) list-new, (in-col, in-elem) iterate
	out out-elem builder = ()
	for x in a
		out ~~= f[x]
	out finish

+range-relative-to-end record(low nat64, high index-relative-to-end)

+.. range-relative-to-end(low nat64, high index-relative-to-end)
	low, high

+to-range nat64 range(a range-relative-to-end, size nat64)
	assert a.low <= size else a.low index-too-big size
	assert a.high.subtract <= size else a.high.subtract index-too-big size
	high = size - a.high.subtract
	assert a.low <= high
	a.low .. high

+subscript-range[out-col, in-col] spec
	subscript out-col(a in-col, range nat64 range)

+subscript[out-col, in-col] out-col
	a in-col
	indices range-relative-to-end
do in-col size, (out-col, in-col) subscript-range
	a[indices to-range a.size]

+split[out-col, in-col, in-iter, elem] out-col[]
	a in-col
	b in-col
do (in-col, in-iter, elem) basic-iter, in-iter skip-next-n, (out-col, in-iter) slice, elem equal
	out out-col builder = ()
	part-start mut = a begin
	iter = part-start copy
	loop
		before = iter copy
		if iter try-take-all b
			out ~= part-start slice before
			part-start := iter copy
			continue
		elif iter try-take-next
			continue
		else
			out ~= part-start slice iter
			break
	out finish-array

+count[col, elem] nat(a col, f bool mut(x elem)) (col, elem) iterate
	a sum f[it].to

+summable[t] spec t new
	+ t(a t, b t)
+sum[col, elem] elem(a col) elem summable, (col, elem) iterate
	a sum it.identity
+sum[out, col, elem] out(a col, f out mut(x elem)) out summable, (col, elem) iterate
	res mut out = ()
	_ = a iterate of x
		res +:= f[x]
		false
	res

| Collection that iterates and returns 'value' forever
+infinite[t] record(value t)
+infinite void infinite()
	(),
+iterate[t] bool(a t infinite, f bool mut(x t))
	until f[a value]
		()
	true

+reverse[col] record(inner col)
+size[col] nat(a col reverse) col size
	a.inner size
+iterate[col, elem] bool(a col reverse, f bool mut(x elem)) (col, elem) iterate-reverse
	a.inner iterate-reverse f
+to[out-col, in-col, elem] out-col
	a in-col reverse
do (out-col, elem) list-new, in-col size, (in-col, elem) iterate-reverse
	out elem builder = a.inner.size,
	_ = a.inner iterate-reverse of x
		out ~= x
		false
	out finish

+index-of-sequence[col, iter, elem] nat?
	a col
	seq col
do (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	index mut nat = 0
	iter = a begin
	loop
		if iter try-take-all seq
			break index
		elif iter try-take-next
			index +:= 1
			continue
		else
			break

+swap-at[col, elem] void(a col, i nat64, j nat64) (col, elem) at-index, (col, elem) set-at-index
	temp = a[i]
	a[i] := a[j]
	a[j] := temp
+swap-at[col, elem] void
	a col
	i nat64
	j index-relative-to-end
do (col, elem) mut-array-like
	a swap-at i, (a to-index j)
+swap-at[col, elem] void
	a col
	i index-relative-to-end
	j index-relative-to-end
do (col, elem) mut-array-like
	a swap-at (a to-index i), (a to-index j)

+reverse-in-place[col, elem] void(a col) col size, (col, elem) at-index, (col, elem) set-at-index
	for i in 0::nat64 .. a.size / 2
		a swap-at i, a.size - 1 - i

+set-reverse[col, elem] void
	a col
do (col, elem) mut-array-like
	guard a.size != 0
	lo mut nat = 0
	hi mut nat = a.size - 1
	while hi - lo > 1
		a swap-at lo, hi
		lo +:= 1
		hi -:= 1

+take-while[out-col, in-col, in-iter, elem] out-col
	a in-col
	f bool mut(x elem)
do (in-iter, in-col) begin, (elem, in-iter) take-next, in-iter copy, (out-col, in-iter) slice
	iter = a begin
	loop
		before = iter copy
		if x = iter try-take-next and f[x]
			continue
		else
			break a.begin slice before

+take-right-while[out-col, in-col, in-iter, elem] out-col
	a in-col
	f bool mut(x elem)
do (in-iter, in-col) end, (elem, in-iter) take-prev, in-iter copy, (out-col, in-iter) slice
	iter = a end
	loop
		before = iter copy
		if x = iter try-take-prev and f[x]
			continue
		else
			break before slice a.end

+drop-while[out-col, in-col, in-iter, elem] out-col
	a in-col
	f bool mut(x elem)
do (in-iter, in-col) begin, (in-iter, in-col) end, (elem, in-iter) take-next, in-iter copy, (out-col, in-iter) slice
	iter = a begin
	loop
		before = iter copy
		# TODO: `if x = iter try-take-next and f[x] then continue else break before slice a.end`
		guard x = iter try-take-next else break before slice a.end
		guard f[x] else break before slice a.end
		continue

+drop-right-while[out-col, in-col, in-iter, elem] out-col
	a in-col
	f bool mut(x elem)
do (in-iter, in-col) begin, (in-iter, in-col) end, (elem, in-iter) take-prev, in-iter copy, (out-col , in-iter) slice
	iter = a end
	loop
		before = iter copy
		# TODO: if x = iter try-take-prev and f[x] then continue else break a.begin slice before
		guard x = iter try-take-prev else break a.begin slice before
		guard f[x] else break a.begin slice before
		continue

+starts-with[col, iter, elem] bool(a col, b col) (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	a.begin try-take-all b

+ends-with[col, iter, elem] bool(a col, b col) (col, iter, elem) basic-reverse-iter, iter skip-prev-n, elem equal
	a.end try-take-all-prev b

+try-remove-start[out-col, in-col, in-iter, in-elem] out-col?
	a in-col
	start in-col
do (in-col, in-iter, in-elem) basic-iter, (in-iter, in-col) end, in-iter skip-next-n, (out-col, in-iter) slice, in-elem equal
	iter = a begin
	if iter try-take-all start
		iter slice a.end
+try-remove-end[out-col, in-col, in-iter, in-elem] out-col?
	a in-col
	end in-col
do (in-col, in-iter, in-elem) basic-reverse-iter, (in-iter, in-col) begin, in-iter skip-prev-n, (out-col, in-iter) slice, in-elem equal
	iter = a end
	if iter try-take-all-prev end
		a.begin slice iter

| Removes all occurrences of {b} from the front of {a}.
+strip-left[col, iter, elem] col
	a col
	b col
do (col, iter, elem) basic-iter, (iter, col) end, iter skip-next-n, (col, iter) slice, elem equal
	if x = a try-remove-start b
		x strip-left b
	else
		a
| Removes all occurrences of {b} from the end of {a}.
+strip-right[col, iter, elem] col
	a col
	b col
do (col, iter, elem) basic-reverse-iter, (iter, col) begin, iter skip-prev-n, (col, iter) slice, elem equal
	if x = a try-remove-end b
		x strip-right b
	else
		a

| If the next elements in {a} all match {start}, skips them all and returns true.
| Otherwise, does nothing and returns false.
~try-take-all[col, iter, elem] bool
	a iter
	start col
do (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	copy = a copy
	stopped = start iterate of x
		try value = copy take-next catch as iterator-out-of-bounds then true
		value != x
	unless stopped
		a skip-next-n start.size
		true
~try-take-all-prev[col, iter, elem] bool
	a iter
	end col
do (col, iter, elem) basic-reverse-iter, iter skip-prev-n, elem equal
	copy = a copy
	stopped = end iterate-reverse of x
		try value = copy take-prev catch as iterator-out-of-bounds then true
		value != x
	unless stopped
		a skip-prev-n end.size
		true

| {true} if {b} is contained in {a}.
|
| That means: The elements in {b} appear in {a}, in order, without interruptions.
+contains-seq[col, iter, elem] bool(a col, b col) (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	!!(a iters-of-seq b)

| Finds the first appearance of {b} in {a},
| and returns slices of {a} to the left and right of that.
|
| Returns an empty option if {b} is not a subsequence of {a}.
+try-split-once[out-col, in-col, in-iter, in-elem] (out-col, out-col)?
	a in-col
	b in-col
do (in-iter, in-col) end, (in-col, in-iter, in-elem) basic-iter, in-iter skip-next-n, (out-col, in-iter) slice, in-elem equal
	if l, r = a iters-of-seq b
		- a.begin slice l
		- r slice a.end

+try-split-once-right[out-col, in-col, in-iter, in-elem] (out-col, out-col)?
	a in-col
	b in-col
do (in-iter, in-col) begin, (in-col, in-iter, in-elem) basic-reverse-iter, in-iter skip-prev-n, (out-col, in-iter) slice, in-elem equal
	if l, r = a iters-of-seq-right b
		- a.begin slice l
		- r slice a.end

| Tries to find a subsequence {b} within {a}. If so, returns an iterator before and after {b}.
~iters-of-seq[col, iter, elem] (iter, iter)?
	a col
	b col
do (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	iter = a begin
	loop
		before = iter copy
		if iter try-take-all b
			break before, iter
		elif iter try-take-next
			continue
		else
			break

-iters-of-seq-right[col, iter, elem] (iter, iter)?
	a col
	b col
do (col, iter, elem) basic-reverse-iter, iter skip-prev-n, elem equal
	iter = a end
	loop
		before = iter copy
		if iter try-take-all-prev b
			break iter, before
		elif iter try-take-prev
			continue
		else
			break

| This is an opaque type for pushing values to using {~=} or {~~=}.
| This deliberately does not provide any way to access the values.
| You get a builder by using `with out in build` where `out` is the builder.
+builder[t] record mut
	-buffer mut t mut-slice
	-cur-size mut nat64
~new[t] t builder()
	0,
~new[t] t builder(size-hint nat64)
	trusted size-hint.gc-safe-mut-slice, 0
+~=[t] void(a t builder, value t)
	forbid a.cur-size == max-value
	capacity = a.buffer mut-slice-size
	if a.cur-size == capacity
		a expand-capacity if capacity == 0 then 4 else capacity * 2
	trusted a.buffer array-set a.cur-size, value
	a.cur-size +:= 1
+~~=[t] void(a t builder, values t[])
	a ~~= values to
+~~=[t] void(a t builder, values t array-view)
	forbid a.cur-size == max-value
	capacity = a.buffer mut-slice-size
	new-size = a.cur-size + values.size
	if new-size > capacity
		a expand-capacity (a.cur-size + values.size).round-up-to-power-of-two
	a.buffer copy-from a.cur-size .. new-size, values.inner, values.low .. values.high
	a.cur-size +:= values size
-expand-capacity[t] void(a t builder, new-capacity nat64)
	trusted
	# assert new-capacity > a.cur-size # TODO -----------------------------------------------------------------------------------
	new-buffer t mut-slice = new-capacity gc-safe-mut-slice
	new-buffer copy-from 0 .. a.cur-size, a.buffer.cast-immutable, 0 .. a.cur-size
	a.buffer := new-buffer
-finish-array[elem] elem[](a elem builder)
	trusted
	forbid a.cur-size == max-value
	size = a cur-size
	a.cur-size := max-value
	buffer = a buffer
	a.buffer := 0 gc-safe-mut-slice
	if buffer.mut-slice-size == size
		buffer cast-immutable
	elif java
		res elem mut-slice = size gc-safe-mut-slice
		res copy-from 0 .. size, buffer.cast-immutable, 0 .. size
		res cast-immutable
	elif js
		buffer.as-js call-property "slice", 0, size.wrap-to::nat32.to assume-type
	else
		throw todo
~finish[col, elem] col(a elem builder) (col, elem) list-new
	a.finish-array list-new
+build-options record
	size-hint nat64
+build build-options()
	0,
+build build-options(size-hint nat64)
	size-hint,
+with-block[col, elem] col
	a build-options
	f void mut(out elem builder)
do (col, elem) list-new
	out elem builder = a.size-hint,
	f[out]
	out finish
