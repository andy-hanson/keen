no-std
import
	../bool
	../compare
	../misc
	../number
	./array
	./collection

+split[out-col, in-col, in-iter, in-elem] out-col[]
	a in-col
	b in-col
do (in-iter, in-col) begin-end, (in-elem, in-iter) next, (out-col, in-iter) slice, in-elem equal
	with out in build
		part-start mut = a begin
		ai mut = part-start
		loop
			if after ?= ai iter-starts-with b
				out ~= part-start slice ai
				part-start := after
				ai := part-start
				continue
			elif _, next ?= ai next
				ai := next
				continue
			else
				out ~= part-start slice ai
				break

+count[col, elem] nat(a col, f bool mut(x elem)) (col, elem) iterate
	a sum f[it].to

+summable[t] spec t new
	+ t(a t, b t)
+sum[col, elem] elem(a col) elem summable, (col, elem) iterate
	a sum it.identity
+sum[out, col, elem] out(a col, f out mut(x elem)) out summable, (col, elem) iterate
	res mut out = ()
	_ = a iterate of x
		res +:= f[x]
		false
	res

| Collection that iterates and returns 'value' forever
+infinite[t] record(value t)
+infinite void infinite()
	(),
+iterate[t] bool(a t infinite, f bool mut(x t))
	until f[a value]
		()
