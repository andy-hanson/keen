no-std
import
	../bool
	../compare
	../misc
	../number
	../private/range-low-level
	./array
	./collection

+split[out, in, iter, elem] out[]
	a in
	b in
do (iter, in) begin-end, (elem, iter) next, (out, iter) slice, elem equal
	with out : build
		part-start mut = a begin
		ai mut = part-start
		loop
			if after ?= ai iter-starts-with b
				out ~= part-start slice ai
				part-start := after
				ai := part-start
				continue
			elif _, next ?= ai next
				ai := next
				continue
			else
				out ~= part-start slice ai
				break

+groupable[group, col, iter] spec (iter, col) begin-end, \
	iter difference, \
	iter skip-next, \
	(group, iter) slice, \
	col size
+groups-of[group, col, iter] group[](a col, group-size nat) (group, col, iter) groupable
	div = a.size / group-size
	out-size = div * group-size == a.size and div else div + 1
	iter mut = a begin
	with out : out-size build
		loop
			diff = a.end difference iter
			guard diff != 0 : break
			next-iter = iter + (diff min group-size)
			out ~= iter slice next-iter
			iter := next-iter
			continue

+count[col, elem] nat(a col, f bool mut(x elem)) (col, elem) iterate
	res mut nat = 0
	for x : a
		if f[x]
			res +:= 1
	res
