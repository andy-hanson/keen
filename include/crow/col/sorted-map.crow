import
	crow/crypto/pseudo-random
	crow/crypto/random
	crow/unsafe
	./mut-slice
	./mut-stack
	./private/sort-utils

sorted-map[k, v] record
	| The root node is special:
	| - It can have a branch with as few as 2 nodes
	| - It can be a leaf with any number of nodes
	-root (k, v) node
-node[k, v] union
	(k, v) branch
	(k, v)[]
do
	min-key k()
	iterate bool(f bool mut(key k, value v))
-branch[k, v] record
	| This is the min-key of each child.
	keys k[]
	children (k, v) node[]

-max-branch-children nat()
	8
-max-leaf-size nat()
	16

-min-key[k, v] k(a (k, v) branch)
	a.keys[0]
-min-key[k, v] k(a (k, v)[])
	a[0].a

+list-new[k, v] (k, v) sorted-map(pairs (k, v)[]) k sorted-key
	pairs.to
+named-new[v] (symbol, v) sorted-map(names symbol[], values v[])
	to for::(symbol, v)[] i in 0 .. names.size
		names[i], values[i]

-get-root-for-update[k, v] (k, v) node(a (k, v) sorted-map) k sorted-key
	root = a.root
	if root.array and root.size > max-leaf-size * 2
		build-tree root
	else
		root
-build-tree[k, v] (k, v) node(pairs (k, v)[])
	nodes mut (k, v) node[] = for chunk in chunk pairs, max-leaf-size
		chunk
	until nodes.size == 1
		nodes := for children in chunk nodes, max-branch-children
			keys: map children, it.min-key
			children: children
	nodes[0]
-chunk[t] t[][](a t[], chunk-size nat)
	for i in 0 .. div-ceil a.size, chunk-size
		a[i * chunk-size .. ((i + 1) * min chunk-size, a.size)].to

+is-empty[k, v] bool(a (k, v) sorted-map) k sorted-key
	match root = a.root
	as branch
		false
	as array
		is-empty root

+size[k, v] nat(a (k, v) sorted-map)
	size a.root
-size[k, v] nat(a (k, v) node)
	match a
	as branch
		sum a.children, it.size
	as array
		size a

+ ==[k, v] bool(a (k, v) sorted-map, b (k, v) sorted-map) k sorted-key, v equal
	trusted
	b-iter = begin b
	ok = every a, of a-pair
		b-pair = next b-iter
		b-pair and a-pair == b-pair
	ok and !b-iter.peek

+to[k, v] (k, v) sorted-map(a (k, v)[]) k sorted-key
	root: sort-unique a, it.a

+to[k, v] (k, v)[](a (k, v) sorted-map)
	match root = a.root
	as branch
		map a, it.identity
	as array
		root

+subscript[k, v] v?(a (k, v) sorted-map, key k) k sorted-key
	a.root[key]
-subscript[k, v] v?(a (k, v) node, key k) k sorted-key
	match a
	as branch
		a.children[binary-search-key a.keys, key][key]
	as array
		if index = binary-search-exact a, key
			a[index].b

+ ~[k, v] (k, v) sorted-map(a (k, v) sorted-map, (key k, value v)) k sorted-key
	match res = insert a.get-root-for-update, (key, value)
	as no-change
		a
	as node
		root: res
	as split
		root:
			keys: res.left.min-key, res.right.min-key
			children: res.left, res.right

-insert-result[k, v] union
	no-change
	(k, v) node
	(k, v) split
-no-change record
-split[k, v] record(left (k, v) node, right (k, v) node)
-insert[k, v] (k, v) insert-result(a (k, v) node, (key k, value v)) k sorted-key
	match a
	as branch
		index = binary-search-key a.keys, key
		match res = insert a.children[index], (key, value)
		as no-change
			no-change
		as node
			keys: update-if-necessary a.keys, index, res.min-key
			children: update-at a.children, index, res
		as split
			new-node (k, v) branch =
				keys: concat a.keys[0 .. index], res.left.min-key, res.right.min-key, a.keys[index + 1 .. end]
				children: concat a.children[0 .. index], res.left, res.right, a.children[index + 1 .. end]
			if new-node.children.size <= max-branch-children
				new-node
			else
				split new-node
	as array
		index = binary-search-insert a, key
		if index != a.size and a[index].a == key
			if trusted reference-equal a[index].b, value
				no-change
			else
				update-at a, index, (key, value)
		else
			res = concat a[0 .. index], (key, value), a[index .. end]
			if res.size <= max-leaf-size
				res
			else
				l, r = split res
				left: l, right: r
-split[k, v] (k, v) split(a (k, v) branch)
	kl, kr = split a.keys
	cl, cr = split a.children
	left: kl, cl
	right: kr, cr
-split[t] (t[], t[])(a t[])
	mid = a.size / 2
	a[0 .. mid].to, a[mid .. end].to

-concat[t] t[](a t array-view, b t, c t array-view) # TODO: remove when list expressions hae the same performance
	res t mut-slice = trusted gc-safe-mut-slice a.size + 1 + c.size
	res[0 .. a.size] := a
	res[a.size] := b
	res[a.size + 1 .. end] := c
	trusted cast-immutable res

-concat[t] t[](a t array-view, b t, c t, d t array-view) # TODO: remove when list expressions hae the same performance
	res t mut-slice = trusted gc-safe-mut-slice a.size + 2 + d.size
	res[0 .. a.size] := a
	res[a.size] := b
	res[a.size + 1] := c
	res[a.size + 2 .. end] := d
	trusted cast-immutable res

| Adds all pairs in {b} to {a}. Values in {b} overwrite those in {a}.
| For a more customizable version, see {merge}.
+ ~~[k, v] (k, v) sorted-map(a (k, v) sorted-map, b (k, v) sorted-map) k sorted-key
	merge a, b, it.b
-consume-rest[k, v] void(out (k, v) builder, a (k, v) iter)
	out ~~= a.cur-array[a.cur-index .. end]
	for index nat, nodes (k, v) node[] in reverse a.stack
		for node in nodes[index .. end]
			for x in node
				out ~= x

-walk-iter-union[k, v] void
	out (k, v) builder
	(key k, value v)
	iter (k, v) iter
	f v mut(key k, a v, b v)
do k sorted-key
	do loop
	if peek-key, _ = peek iter
		match key <=> peek-key
		as less
			out ~= key, value
			break
		as equal
			_, other-value = next! iter
			out ~= key, f[key, value, other-value]
			break
		as greater
			out ~= next! iter
			continue
	else
		out ~= key, value
		break

-walk-iter-intersect[k, v] void
	out (k, v) builder
	(key k, value v)
	iter (k, v) iter
	f v mut(key k, a v, b v)
do k sorted-key
	do loop
	do if peek-key, _ = peek iter else break
	match key <=> peek-key
	as less
		break
	as equal
		_, other-value = next! iter
		out ~= key, f[key, value, other-value]
		break
	as greater
		_ = next! iter
		continue

+ -[k, v] (k, v) sorted-map(a (k, v) sorted-map, key k) k sorted-key
	if _, res = remove a, key
		res
	else
		a

+remove[k, v] (v, (k, v) sorted-map)?(a (k, v) sorted-map, key k) k sorted-key
	if r = remove a.get-root-for-update, key
		- removed-value r
		- root: match node = new-node r
		as branch
			match size node.children
			as 1
				node.children[0]
			else
				node
		as array
			node
-removed[k, v] record
	removed-value v
	new-node (k, v) node
-remove[k, v] (k, v) removed?(a (k, v) node, key k) k sorted-key
	match a
	as branch
		index = binary-search-key a.keys, key
		if r = remove a.children[index], key
			removed-value: r.removed-value
			new-node: if r.new-node.number-of-branches < r.new-node.min-branches
				larger-sibling-is-left bool = if index == 0
					false
				elif index == a.children.size - 1
					true
				else
					a.children[index - 1].number-of-branches >= a.children[index + 1].number-of-branches
				left-index = if larger-sibling-is-left then index - 1 else index
				right-index = if larger-sibling-is-left then index else index + 1
				new-children = if larger-sibling-is-left
					merge-or-rebalance a.children[index - 1], r.new-node
				else
					merge-or-rebalance r.new-node, a.children[index + 1]
				match new-children
				as node
					keys: update-if-necessary (remove-at a.keys, index), left-index, new-children.min-key
					children: concat a.children[0 .. left-index], new-children, a.children[right-index + 1 .. end]
				as tuple2
					x, y = new-children
					keys: concat a.keys[0 .. left-index], x.min-key, y.min-key, a.keys[right-index + 1 .. end]
					children: concat a.children[0 .. left-index], x, y, a.children[right-index + 1 .. end]
			else
				keys: update-if-necessary a.keys, index, r.new-node.min-key
				children: update-at a.children, index, r.new-node
	as array
		if index = binary-search-exact a, key
			_, value = a[index]
			removed-value: value
			new-node: remove-at a, index

-update-if-necessary[t] t[](a t[], index nat, value t) t equal
	if a[index] == value
		a
	else
		update-at a, index, value

-binary-search-key[k] nat(keys k[], key k) k sorted-key
	index = binary-search-insert keys, key
	if index == 0 or (index != keys.size and keys[index] == key)
		index
	else
		index - 1

-merge-or-rebalance[k, v] union((k, v) node, ((k, v) node, (k, v) node))
-merge-or-rebalance[k, v] (k, v) merge-or-rebalance(left (k, v) node, right (k, v) node)
	dir rebalance-direction = if left.number-of-branches < right.number-of-branches then to-left else to-right
	can-rebalance = match dir
	as to-left
		right.number-of-branches > right.min-branches
	as to-right
		left.number-of-branches > left.min-branches
	if can-rebalance
		rebalance left, right, dir
	else
		merge left, right

-number-of-branches[k, v] nat(a (k, v) node)
	match a
	as branch
		size a.children
	as array
		size a
-min-branches[k, v] nat(a (k, v) node)
	match a
	as branch
		max-branch-children / 2
	as array
		max-leaf-size / 2
-max-branches[k, v] nat(a (k, v) node)
	match a
	as branch
		max-branch-children
	as array
		max-leaf-size
-merge[k, v] (k, v) node(left (k, v) node, right (k, v) node)
	match left
	as branch
		assert right.branch
		keys: left.keys ~~ right.keys
		children: left.children ~~ right.children
	as array
		assert right.array
		left ~~ right
-rebalance[k, v] ((k, v) node, (k, v) node)(left (k, v) node, right (k, v) node, dir rebalance-direction)
	match left
	as branch
		assert right.branch
		kl, kr = rebalance left.keys, right.keys, dir
		cl, cr = rebalance left.children, right.children, dir
		(kl, cl), (kr, cr)
	as array
		assert right.array
		l, r = rebalance left, right, dir
		l, r
-rebalance-direction enum(to-left, to-right)
-rebalance[t] (t[], t[])(a t[], b t[], dir rebalance-direction)
	match dir
	as to-left
		a ~ b[0], b[1 .. end].to
	as to-right
		a[0 .. end - 1].to, a[end - 1] ~ b

-iter[k, v] record mut
	cur-array mut (k, v)[]
	cur-index mut nat
	# Each entry in the stack is the remaining branches we need to do
	stack (nat, (k, v) node[]) mut-stack
-begin[k, v] (k, v) iter(a (k, v) sorted-map)
	res (k, v) iter = (), (), ()
	add-node res, a.root
	res

-add-node[k, v] void(a (k, v) iter, node (k, v) node)
	match node
	as branch
		a.stack ~= 1, node.children
		add-node a, node.children[0]
	as array
		a.cur-array := node
		a.cur-index := 0

-peek[k, v] (k, v)?(a (k, v) iter)
	unless a.cur-index == a.cur-array.size
		a.cur-array[a.cur-index]

-next[k, v] (k, v)?(a (k, v) iter)
	do unless a.cur-index == a.cur-array.size
	res = a.cur-array[a.cur-index]
	a.cur-index +:= 1
	if a.cur-index == a.cur-array.size
		if index, branches = pop a.stack
			add-node a, branches[index]
			unless index + 1 == branches.size
				a.stack ~= index + 1, branches
	res

| Returns a map containing keys that are in either {a} or {b}.
| Calls {f} when the same key appears in both; otherwise uses the value from whichever one has the key.
+merge[k, v] (k, v) sorted-map(a (k, v) sorted-map, b (k, v) sorted-map, f v mut(key k, a v, b v)) k sorted-key
	do with out in build a.size + b.size
	b-iter = begin b
	for x in a
		walk-iter-union out, x, b-iter, f
	consume-rest out, b-iter

| Returns a map containing only keys that are in both {a} and {b}.
| Calls {f} on values with the same key.
+intersect[k, v] (k, v) sorted-map(a (k, v) sorted-map, b (k, v) sorted-map, f v mut(key k, a v, b v)) k sorted-key
	do with out in build min a.size, b.size
	b-iter = begin b
	for x in a
		walk-iter-intersect out, x, b-iter, f

+iterate[k, v] bool(a (k, v) sorted-map, f bool mut(key k, value v))
	iterate a.root, f
-iterate[k, v] bool(a (k, v) branch, f bool mut(key k, value v))
	iterate a.children, of child
		iterate child, f

+min-key[k, v] k?(a (k, v) sorted-map) k sorted-key
	unless is-empty a
		min-key a.root
+max-key[k, v] k?(a (k, v) sorted-map) k sorted-key
	unless is-empty a
		max-key a.root
-max-key[k, v] k(a (k, v) node)
	match a
	as branch
		max-key a.children[end - 1]
	as array
		a[end - 1].a

region test

-validate[k, v] void(a (k, v) sorted-map) k sorted-key, (json, k) to, (json, v) to
	unless is-empty a
		validate a.root, a.root.min-key
-validate[k, v] void(a (k, v) node, min k) k sorted-key, (json, k) to, (json, v) to
	match a
	as branch
		a.keys[0] is min
		a.keys is map a.children, it.min-key
		assert is-sorted a.keys
		for index, child in with-index a.children
			key = a.keys[index]
			assert child[key]
			assert child.min-key == key
			assert child.number-of-branches >= child.min-branches
			assert child.number-of-branches <= child.max-branches
			validate child, key
	as array
		a[0].a is min
		assert is-sorted a, it.a

test global
	seed nat64 = random
	try
		p prng = seed,
		values nat[] = unique for _ in 0 .. 1000 then next-in-range p, 1000 .. 2000
		a mut (nat, nat) sorted-map = ()
		for value in values
			a ~:= (value, value)
			validate a
			a[value] is value
		for value in values
			a[value] is value
		for value in values
			removed, rest = remove! a, value
			removed is value
			a := rest
			validate a
		assert is-empty a
	catch e
		log error, "Random seed was {seed}"
		throw e

-unique[t] t[](a t[]) t key
	set t mut-set = ()
	filter a, of x
		try-add set, x
