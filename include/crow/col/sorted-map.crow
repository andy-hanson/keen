import
	crow/crypto/pseudo-random
	crow/crypto/random
	crow/unsafe
	./mut-slice
	./mut-stack
	./private/sort-utils

sorted-map[k, v] record
	| The root node is special:
	| - It can have a branch with as few as 2 nodes
	| - It can be a leaf with any number of nodes
	-root (k, v) node
-node[k, v] union
	(k, v) branch
	(k, v)[]
do
	min-key k()
	iterate bool(f bool mut(key k, value v))
-branch[k, v] record
	| This is the min-key of each child.
	keys k[]
	children (k, v) node[]

-max-branch-children nat()
	8
-max-leaf-size nat()
	16

-min-key[k, v] k(a (k, v) branch)
	a.keys[0]
-min-key[k, v] k(a (k, v)[])
	a[0] a

+list-new[k, v] (k, v) sorted-map(pairs (k, v)[]) k sorted-key
	pairs to
+named-new[v] (symbol, v) sorted-map(names symbol[], values v[])
	(for i in 0 .. names.size then names[i], values[i])::(symbol, v)[] to

-get-root-for-update[k, v] (k, v) node(a (k, v) sorted-map) k sorted-key
	root = a root
	if root array and root.size > max-leaf-size * 2
		root build-tree
	else
		root
-build-tree[k, v] (k, v) node(pairs (k, v)[])
	nodes mut (k, v) node[] = for chunk in pairs chunk max-leaf-size
		chunk
	until nodes.size == 1
		nodes := for children in nodes chunk max-branch-children
			keys: children map it.min-key
			children: children
	nodes[0]
-chunk[t] t[][](a t[], chunk-size nat)
	for i in 0 .. (a.size div-ceil chunk-size)
		a[i * chunk-size .. ((i + 1) * chunk-size min a.size)] to

+is-empty[k, v] bool(a (k, v) sorted-map) k sorted-key
	match root = a root
	as branch
		false
	as array
		root is-empty

+size[k, v] nat(a (k, v) sorted-map)
	a.root size
-size[k, v] nat(a (k, v) node)
	match a
	as branch
		a.children sum it.size
	as array
		a size

+==[k, v] bool(a (k, v) sorted-map, b (k, v) sorted-map) k sorted-key, v equal
	b-iter = b begin
	ok = a every of a-pair
		b-pair = b-iter next
		b-pair and a-pair == b-pair
	ok and !b-iter.peek

+to[k, v] (k, v) sorted-map(a (k, v)[]) k sorted-key
	root: a sort-unique it.a

+to[k, v] (k, v)[](a (k, v) sorted-map)
	match root = a root
	as branch
		a map it.identity
	as array
		root

+subscript[k, v] v?(a (k, v) sorted-map, key k) k sorted-key
	a.root[key]
-subscript[k, v] v?(a (k, v) node, key k) k sorted-key
	match a
	as branch
		a.children[a.keys binary-search-key key][key]
	as array
		if index = a binary-search-exact key
			a[index] b

+~[k, v] (k, v) sorted-map(a (k, v) sorted-map, (key k, value v)) k sorted-key
	match res = a.get-root-for-update insert (key, value)
	as no-change
		a
	as node
		root: res
	as split
		root:
			keys: res.left.min-key, res.right.min-key
			children: res.left, res.right

-insert-result[k, v] union
	no-change
	(k, v) node
	(k, v) split
-no-change record
-split[k, v] record(left (k, v) node, right (k, v) node)
-insert[k, v] (k, v) insert-result(a (k, v) node, (key k, value v)) k sorted-key
	match a
	as branch
		index = a.keys binary-search-key key
		match res = a.children[index] insert (key, value)
		as no-change
			no-change
		as node
			keys: a.keys update-if-necessary index, res.min-key
			children: a.children update-at index, res
		as split
			new-node (k, v) branch =
				keys: a.keys[0 .. index] concat res.left.min-key, res.right.min-key, a.keys[index + 1 .. end]
				children: a.children[0 .. index] concat res.left, res.right, a.children[index + 1 .. end]
			if new-node.children.size <= max-branch-children
				new-node
			else
				new-node split
	as array
		index = a binary-search-insert key
		if index != a.size and a[index].a == key
			if trusted a[index].b reference-equal value
				no-change
			else
				a update-at index, (key, value)
		else
			res = a[0 .. index] concat (key, value), a[index .. end]
			if res.size <= max-leaf-size
				res
			else
				l, r = res split
				left: l, right: r
-split[k, v] (k, v) split(a (k, v) branch)
	kl, kr = a.keys split
	cl, cr = a.children split
	left: kl, cl
	right: kr, cr
-split[t] (t[], t[])(a t[])
	mid = a.size / 2
	a[0 .. mid].to, a[mid .. end].to

-concat[t] t[](a t array-view, b t, c t array-view) # TODO: remove when list expressions hae the same performance
	res t mut-slice = trusted a.size + 1 + c.size gc-safe-mut-slice
	res[0 .. a.size] := a
	res[a.size] := b
	res[a.size + 1 .. end] := c
	trusted res cast-immutable

-concat[t] t[](a t array-view, b t, c t, d t array-view) # TODO: remove when list expressions hae the same performance
	res t mut-slice = trusted a.size + 2 + d.size gc-safe-mut-slice
	res[0 .. a.size] := a
	res[a.size] := b
	res[a.size + 1] := c
	res[a.size + 2 .. end] := d
	trusted res cast-immutable

| Adds all pairs in {b} to {a}. Values in {b} overwrite those in {a}.
| For a more customizable version, see {merge}.
+~~[k, v] (k, v) sorted-map(a (k, v) sorted-map, b (k, v) sorted-map) k sorted-key
	a merge b, it.b
-consume-rest[k, v] void(out (k, v) builder, a (k, v) iter)
	out ~~= a.cur-array[a.cur-index .. end]
	for index nat, nodes (k, v) node[] in a.stack reverse
		for node in nodes[index .. end]
			for x in node
				out ~= x

-walk-iter-union[k, v] void
	out (k, v) builder
	(key k, value v)
	iter (k, v) iter
	f v mut(key k, a v, b v)
do k sorted-key
	loop
		if peek-key, _ = iter peek
			match key <=> peek-key
			as less
				out ~= key, value
				break
			as equal
				_, other-value = iter next!
				out ~= key, f[key, value, other-value]
				break
			as greater
				out ~= iter next!
				continue
		else
			out ~= key, value
			break

-walk-iter-intersect[k, v] void
	out (k, v) builder
	(key k, value v)
	iter (k, v) iter
	f v mut(key k, a v, b v)
do k sorted-key
	loop
		guard peek-key, _ = iter peek else break
		match key <=> peek-key
		as less
			break
		as equal
			_, other-value = iter next!
			out ~= key, f[key, value, other-value]
			break
		as greater
			_ = iter next!
			continue

+ -[k, v] (k, v) sorted-map(a (k, v) sorted-map, key k) k sorted-key
	if _, res = a remove key
		res
	else
		a

+remove[k, v] (v, (k, v) sorted-map)?(a (k, v) sorted-map, key k) k sorted-key
	if r = a.get-root-for-update remove key
		- r removed-value
		- root: match node = r new-node
		as branch
			match node.children size
			as 1
				node.children[0]
			else
				node
		as array
			node
-removed[k, v] record
	removed-value v
	new-node (k, v) node
-remove[k, v] (k, v) removed?(a (k, v) node, key k) k sorted-key
	match a
	as branch
		index = a.keys binary-search-key key
		if r = a.children[index] remove key
			removed-value: r removed-value
			new-node: if r.new-node.number-of-branches < r.new-node.min-branches
				larger-sibling-is-left bool = if index == 0
					false
				elif index == a.children.size - 1
					true
				else
					a.children[index - 1].number-of-branches >= a.children[index + 1].number-of-branches
				left-index = if larger-sibling-is-left then index - 1 else index
				right-index = if larger-sibling-is-left then index else index + 1
				new-children = if larger-sibling-is-left
					a.children[index - 1] merge-or-rebalance r.new-node
				else
					r.new-node merge-or-rebalance a.children[index + 1]
				match new-children
				as node
					keys: a.keys remove-at index update-if-necessary left-index, new-children.min-key
					children: a.children[0 .. left-index] concat new-children, a.children[right-index + 1 .. end]
				as tuple2
					x, y = new-children
					keys: a.keys[0 .. left-index] concat x.min-key, y.min-key, a.keys[right-index + 1 .. end]
					children: a.children[0 .. left-index] concat x, y, a.children[right-index + 1 .. end]
			else
				keys: a.keys update-if-necessary index, r.new-node.min-key
				children: a.children update-at index, r.new-node
	as array
		if index = a binary-search-exact key
			_, value = a[index]
			removed-value: value
			new-node: a remove-at index

-update-if-necessary[t] t[](a t[], index nat, value t) t equal
	if a[index] == value
		a
	else
		a update-at index, value

-binary-search-key[k] nat(keys k[], key k) k sorted-key
	index = keys binary-search-insert key
	if index == 0 or (index != keys.size and keys[index] == key)
		index
	else
		index - 1

-merge-or-rebalance[k, v] union((k, v) node, ((k, v) node, (k, v) node))
-merge-or-rebalance[k, v] (k, v) merge-or-rebalance(left (k, v) node, right (k, v) node)
	dir rebalance-direction = if left.number-of-branches < right.number-of-branches then to-left else to-right
	can-rebalance = match dir
	as to-left
		right.number-of-branches > right.min-branches
	as to-right
		left.number-of-branches > left.min-branches
	if can-rebalance
		left rebalance right, dir
	else
		left merge right

-number-of-branches[k, v] nat(a (k, v) node)
	match a
	as branch
		a.children size
	as array
		a size
-min-branches[k, v] nat(a (k, v) node)
	match a
	as branch
		max-branch-children / 2
	as array
		max-leaf-size / 2
-max-branches[k, v] nat(a (k, v) node)
	match a
	as branch
		max-branch-children
	as array
		max-leaf-size
-merge[k, v] (k, v) node(a (k, v) node, b (k, v) node)
	match a
	as branch
		assert b branch
		keys: a.keys ~~ b.keys
		children: a.children ~~ b.children
	as array
		assert b array
		a ~~ b
-rebalance[k, v] ((k, v) node, (k, v) node)(left (k, v) node, right (k, v) node, dir rebalance-direction)
	match left
	as branch
		assert right branch
		kl, kr = left.keys rebalance right.keys, dir
		cl, cr = left.children rebalance right.children, dir
		(kl, cl), (kr, cr)
	as array
		assert right array
		l, r = left rebalance right, dir
		l, r
-rebalance-direction enum(to-left, to-right)
-rebalance[t] (t[], t[])(a t[], b t[], dir rebalance-direction)
	match dir
	as to-left
		a ~ b[0], b[1 .. end].to
	as to-right
		a[0 .. end - 1].to, a[end - 1] ~ b

-iter[k, v] record mut
	cur-array mut (k, v)[]
	cur-index mut nat
	# Each entry in the stack is the remaining branches we need to do
	stack (nat, (k, v) node[]) mut-stack
-begin[k, v] (k, v) iter(a (k, v) sorted-map)
	res (k, v) iter = (), (), ()
	res add-node a.root
	res

-add-node[k, v] void(a (k, v) iter, node (k, v) node)
	match node
	as branch
		a.stack ~= 1, node.children
		a add-node node.children[0]
	as array
		a.cur-array := node
		a.cur-index := 0

-peek[k, v] (k, v)?(a (k, v) iter)
	unless a.cur-index == a.cur-array.size
		a.cur-array[a cur-index]

-next[k, v] (k, v)?(a (k, v) iter)
	guard a.cur-index != a.cur-array.size
	res = a.cur-array[a cur-index]
	a.cur-index +:= 1
	if a.cur-index == a.cur-array.size
		if index, branches = a.stack pop
			a add-node branches[index]
			unless index + 1 == branches.size
				a.stack ~= index + 1, branches
	res

| Returns a map containing keys that are in either {a} or {b}.
| Calls {f} when the same key appears in both; otherwise uses the value from whichever one has the key.
+merge[k, v] (k, v) sorted-map(a (k, v) sorted-map, b (k, v) sorted-map, f v mut(key k, a v, b v)) k sorted-key
	with out in a.size + b.size build
		b-iter = b begin
		for x in a
			out walk-iter-union x, b-iter, f
		out consume-rest b-iter

| Returns a map containing only keys that are in both {a} and {b}.
| Calls {f} on values with the same key.
+intersect[k, v] (k, v) sorted-map(a (k, v) sorted-map, b (k, v) sorted-map, f v mut(key k, a v, b v)) k sorted-key
	with out in a.size min b.size build
		b-iter = b begin
		for x in a
			out walk-iter-intersect x, b-iter, f

+iterate[k, v] bool(a (k, v) sorted-map, f bool mut(key k, value v))
	a.root iterate f
-iterate[k, v] bool(a (k, v) branch, f bool mut(key k, value v))
	a.children iterate of child
		child iterate f

+min-key[k, v] k?(a (k, v) sorted-map) k sorted-key
	unless a is-empty
		a.root min-key
+max-key[k, v] k?(a (k, v) sorted-map) k sorted-key
	unless a is-empty
		a.root max-key
-max-key[k, v] k(a (k, v) node)
	match a
	as branch
		a.children[end - 1] max-key
	as array
		a[end - 1] a

region test

-validate[k, v] void(a (k, v) sorted-map) k sorted-key, (json, k) to, (json, v) to
	unless a is-empty
		a.root validate a.root.min-key
-validate[k, v] void(a (k, v) node, min k) k sorted-key, (json, k) to, (json, v) to
	match a
	as branch
		a.keys[0] is min
		a.keys is (a.children map it.min-key)
		assert a.keys is-sorted
		for index, child in a.children with-index
			key = a.keys[index]
			assert child[key]
			assert child.min-key == key
			assert child.number-of-branches >= child.min-branches
			assert child.number-of-branches <= child.max-branches
			child validate key
	as array
		a[0].a is min
		assert a is-sorted it.a

test summon
	seed nat64 = random
	try
		p prng = seed,
		values nat[] = (for _ in 0 .. 1000 then p next-in-range 1000 .. 2000) unique
		a mut (nat, nat) sorted-map = ()
		for value in values
			a ~:= (value, value)
			a validate
			a[value] is value
		for value in values
			a[value] is value
		for value in values
			removed, rest = a remove! value
			removed is value
			a := rest
			a validate
		assert a is-empty
	catch e
		error log "Random seed was {seed}"
		throw e

-unique[t] t[](a t[]) t key
	set t mut-set = ()
	a filter of x
		set try-add x
