+counter[k] record
	-inner nat64[k]

+list-new[k] k counter(a k[]) k key
	a.to

+to[k] k counter(values k[]) k key
	res nat64 mut[k] = ()
	for x in values
		res[x] := (res[x] else 0) + 1
	inner: res.move-to

+to[k] nat64[k](a k counter) k key
	a.inner

+subscript[k] nat64(a k counter, value k) k key
	a.inner[value] else 0

+ ~[k] k counter(a k counter, value k) k key
	a.inner ~ (value, a[value] + 1),

+some[k] bool(a k counter, f bool mut(key k, count nat64)) k key
	some a.inner, f

test
	a nat64 counter = ()
	a[1] is 0
	b = a ~ 3
	b[3] is 1
	c = b ~ 3
	c[3] is 2
