no-std
import
	../bool
	../compare
	../hash
	../json
	../misc
	../number
	../option
	../string
	../test-util
	../tuple
	./array
	./collection
	./sorted-map
	./util

+sorted-list[k, v] record
	-inner (k, v[]) sorted-map

+list-new[k, v] (k, v) sorted-list(a (k, v)[]) k sorted-key
	a.to

+to[k, v] (k, v) sorted-list(a (k, v)[]) k sorted-key
	res mut (k, v) sorted-list = (),
	for k, v in a
		res ~:= (k, v)
	res

+to[k, v] (k, v)[](a (k, v) sorted-list) k sorted-key
	for x in a then x

+==[k, v] bool(a (k, v) sorted-list, b (k, v) sorted-list) k sorted-key, v equal
	a.inner == b.inner
+to[k, v] json(a (k, v) sorted-list) k sorted-key, (json, k) to, (json, v) to
	a.to::(k, v)[].to

+is-empty[k, v] bool(a (k, v) sorted-list) k sorted-key
	is-empty a.inner

+size[k, v] nat64(a (k, v) sorted-list) k sorted-key
	res mut nat64 = 0
	for _, vs in a.inner
		res +:= vs.size
	res

| These are not unique; the same key can appear multiple times.
+keys[k, v] k[](a (k, v) sorted-list) k sorted-key
	map a, it.a
+values[k, v] v[](a (k, v) sorted-list) k sorted-key
	map a, it.b

+first[k, v] (k, v)?(a (k, v) sorted-list) k sorted-key
	if k = min-key a.inner
		k, a[k][0]

+last[k, v] (k, v)?(a (k, v) sorted-list) k sorted-key
	if k = max-key a.inner
		k, a[k][end - 1]

+~[k, v] (k, v) sorted-list(a (k, v) sorted-list, (key k, value v)) k sorted-key
	a.inner ~ (key, a[key].to ~ value),

+~~[k, v] (k, v) sorted-list(a (k, v) sorted-list, b (k, v) sorted-list) k sorted-key
	inner: merge a.inner, b.inner, of _, x, y then x ~~ y

+subscript[k, v] v array-view(a (k, v) sorted-list, key k) k sorted-key
	if res = a.inner[key]
		to res

+iterate[k, v] bool(a (k, v) sorted-list, f bool mut(key k, value v)) k sorted-key
	iterate a.inner, of k, vs
		iterate vs, f[k, it]

test
	a (nat64, string) sorted-list = ()
	a is ()
	assert is-empty a
	a.size is 0

	b = a ~ (1, "one")
	b is ((1, "one"),)
	b.size is 1
	b[1] is ("one",)

	c = b ~ (2, "two")
	c is ((1, "one"), (2, "two"))
	c.size is 2
	c[1] is ("one",)

	d = c ~ (1, "uno")
	assert d != c
	d is ((1, "one"), (1, "uno"), (2, "two"))
	d.size is 3
	d[1] is ("one", "uno")
	d[3] is ()
	d.first is (1, "one")
	d.last is (2, "two")

	d.keys is (1, 1, 2)
