no-std
import
	../bool
	../compare
	../hash
	../json
	../misc
	../number
	../option
	../string
	../test-util
	../tuple
	./array
	./collection
	./experimental/compact-sorted-map

+sorted-list[k, v] record
	-inner (k, v[]) compact-sorted-map

+list-new[k, v] (k, v) sorted-list(a (k, v)[]) k key
	a to

+to[k, v] (k, v) sorted-list(a (k, v)[]) k key
	res mut (k, v) sorted-list = (),
	for k, v in a
		res ~:= (k, v)
	res

+to[k, v] (k, v)[](a (k, v) sorted-list) k key
	for x in a then x

+==[k, v] bool(a (k, v) sorted-list, b (k, v) sorted-list) k key, v equal
	a.inner == b.inner
+to[k, v] json(a (k, v) sorted-list) k key, (json, k) to, (json, v) to
	a.to::(k, v)[] to

+is-empty[k, v] bool(a (k, v) sorted-list) k key
	a.inner is-empty

+size[k, v] nat64(a (k, v) sorted-list) k key
	res mut nat64 = 0
	for _, vs in a inner
		res +:= vs.size
	res

| These are not unique; the same key can appear multiple times.
+keys[k, v] k[](a (k, v) sorted-list) k key
	for k, _ in a then k

+first[k, v] (k, v)?(a (k, v) sorted-list) k key
	if k, vs = a.inner first
		k, vs[0]

+last[k, v] (k, v)?(a (k, v) sorted-list) k key
	if k, vs = a.inner last
		k, vs[end - 1]

+~[k, v] (k, v) sorted-list(a (k, v) sorted-list, (key k, value v)) k key
	a.inner ~ (key, (a all-for-key key) ~ value),

+~~[k, v] (k, v) sorted-list(a (k, v) sorted-list, b (k, v) sorted-list) k key
	res mut = a
	for x in b
		res ~:= x
	res

+|[k, v] (k, v) sorted-list(a (k, v) sorted-list, b (k, v) sorted-list) k key
	res mut = a
	for pair in b
		res ~:= pair
	res

+all-for-key[k, v] v[](a (k, v) sorted-list, key k) k key
	a.inner[key] else ()

+in[k, v] bool(key k, a (k, v) sorted-list) k key
	key in a.inner

+iterate[k, v] bool(a (k, v) sorted-list, f bool mut(key k, value v)) k key
	a.inner iterate of k, vs
		vs iterate f[k, it]

+sorted-list-builder[k, v] record mut
	-inner (k, v) array-builder
+build[k, v] (k, v) sorted-list
	a build-options
	f void mut(out (k, v) sorted-list-builder)
do k key
	a build f[it,] to
+ ~=[k, v] void(a (k, v) sorted-list-builder, value (k, v)) k key
	a.inner ~= value

test
	a (nat64, string) sorted-list = ()
	a is ()
	assert a is-empty
	a.size is 0

	b = a ~ (1, "one")
	b is ((1, "one"),)
	b.size is 1
	b all-for-key 1 is ("one",)

	c = b ~ (2, "two")
	c is ((1, "one"), (2, "two"))
	c.size is 2
	c all-for-key 1 is ("one",)

	d = c ~ (1, "uno")
	assert d != c
	d is ((1, "one"), (1, "uno"), (2, "two"))
	d.size is 3
	d all-for-key 1 is ("one", "uno")
	d.first is (1, "one")
	d.last is (2, "two")

	d.keys is (1, 1, 2)
