# TODO: this is only used by collection.crow, so just merge it into there ----------------------------------------------------------
no-std
import
	../../misc: void
	../../number: nat64
	../../private/bootstrap: array

+builder[col, builder] spec
	build col(options build-options, f void mut(out builder))
+build[col, elem, builder] spec (col, builder) builder
	~= void(a builder, value elem)
+build-in-chunks[col, elem, builder] spec (col, builder) builder
	~~= void(a builder, values elem[])
+build-options record
	size-hint nat64
+build build-options()
	0,
+build build-options(size-hint nat64)
	size-hint,
+with-block[col, builder] col
	a build-options
	f void mut(out builder)
do (col, builder) builder
	a build f
