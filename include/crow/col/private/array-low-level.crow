no-std
import
	java/lang/IndexOutOfBoundsException
	java/lang/Object
	java/lang/System
	../../bool
	../../compare
	../collection
	../../misc
	../../number
	../../private/bootstrap: array-size, buffer, buffer-view
	../../range
	../../unsafe
export
	../../private/bootstrap: array, array-view, high, inner, low, new-array-view, new-buffer-view

+array-like[col, elem] spec col size, (col, elem) at-index
+mut-array-like[col, elem] spec (col, elem) array-like, (col, elem) set-at-index

~buffer-size[t] nat64(a t buffer)

+subscript[t] t(a t[], index nat64)
	trusted if java
		try
			array-get a, index
		catch as IndexOutOfBoundsException
			throw index-too-big index, a.array-size
	else
		assert index < a.array-size else index-too-big index, a.array-size
		array-get a, index
-array-get[t] t(a t[], index nat64) unsafe

###
Equivalent to calling `f[a[0]]`, `f[a[1]]`, etc.

Calls `f` for each element in `a`.
###
+iterate[t] bool(a t[], f bool mut(elem t))
	i mut nat64 = 0
	do loop
	if i == a.array-size
		break false
	elif f[a[i]]
		break true
	else
		i +:= 1
		continue

~array-set[t] void(a t buffer, index nat64, value t) unsafe

~uninitialized-buffer[t] t buffer(size nat64) unsafe # TODO: Try to only define this once ................................

region Views

+subscript[t] t array-view(a t[], indices nat64 range)
	assert indices.high <= a.array-size else index-too-big indices.high, a.array-size
	new-array-view a, indices.low, indices.high
+to[t] t[](a t array-view)
	size = a.size
	if size == a.inner.array-size
		a.inner
	else
		trusted
		res t buffer = uninitialized-buffer a.size
		copy-from res, 0 .. size, a.inner, a.low .. a.high
		cast-immutable res
# Called implicitly by the compiler
+to-array-view[t] t array-view(a t[])
	new-array-view a, 0, a.array-size
# Called implicitly by the compiler
+to-buffer-view[t] t buffer-view(a t buffer)
	new-buffer-view a, 0, a.buffer-size
+is-empty[t] bool(a t array-view)
	a.low == a.high
+size[t] nat64(a t array-view)
	a.high - a.low
+subscript[t] t(a t array-view, index nat64)
	assert index < a.size else index-too-big index, a.size
	a.inner[a.low + index]
+subscript[t] t array-view(a t array-view, indices nat64 range)
	assert indices.high <= a.size else index-too-big indices.high, a.size
	new-array-view a.inner, a.low + indices.low, a.low + indices.high
+iterate[t] bool(a t array-view, f bool mut(x t))
	i mut = a.low
	do loop
	if i == a.high
		break false
	elif f[a.inner[i]]
		break true
	else
		i +:= 1
		continue

~cast-immutable[t] t[](a t buffer) unsafe
	reinterpret-cast a

~copy-from[t] void(dest t buffer, dest-range nat range, src t[], src-range nat range)
	trusted
	do unless is-empty-type@t
	size = dest-range.size
	assert src-range.size == size
	assert dest-range.high <= dest.buffer-size
	assert src-range.high <= src.array-size
	dl = dest-range.low
	sl = src-range.low
	if java
		arraycopy src.reinterpret-cast::Object, sl.wrap-to, dest.reinterpret-cast::Object, dl.wrap-to, size.wrap-to
	else
		i mut = 0
		until i == size
			array-set dest, dl + i, array-get src, sl + i
			i +:= 1
