no-std
import
	java/lang/IndexOutOfBoundsException
	java/lang/System
	../../bits: round-up-to-power-of-two
	../../bool: bool, false, true
	../../compare: <, <=, >
	../collection
	../../exception: todo
	../../js: as-js, call-property, cast
	../../misc: new, subscript, void
	../../number
	../../option: option
	../../private/bootstrap: array-size, mut-slice
	../../range
	../../unsafe: reinterpret-cast
export
	../../private/bootstrap: array

~mut-slice-size[t] nat64(a t mut-slice) builtin

array-cast[out, in] out[](a in[]) unsafe # TODO: RM. This is only used to convert nat8[] to char8[]. Maybe just have a builtin for that specifically.
	a reinterpret-cast

+subscript[t] t(a t[], index nat64)
	trusted if extern java
		try
			a array-get index
		catch IndexOutOfBoundsException _
			throw index index-too-big a.array-size
	else
		assert index < a.array-size : index index-too-big a.array-size
		a array-get index
-array-get[t] t(a t[], index nat64) builtin, unsafe
-array-get[t] t(a t mut-slice, index nat64) builtin, unsafe

###
Equivalent to calling `f[a[0]]`, `f[a[1]]`, etc.

Calls `f` for each element in `a`.
###
+iterate[t] bool(a t[], f bool mut(elem t))
	i mut nat64 = 0
	loop
		if i == a.array-size
			break false
		elif f[a[i]]
			break true
		else
			i +:= 1
			continue

+array-builder[t] record mut
	-buffer mut t mut-slice
	-cur-size mut nat64
+build[t] t[](a build-options, f void mut(out t array-builder))
	trusted
	builder t array-builder = a.size-hint.gc-safe-mut-slice, 0
	f[builder]
	# TODO:PERF reuse 'buffer' if size matches? ---------------------------------------------------------------------------
	size = builder cur-size
	builder.cur-size := max-value
	if extern java
		res t mut-slice = size gc-safe-mut-slice
		unless is-empty-type@t
			builder.buffer.reinterpret-cast arraycopy 0, res.reinterpret-cast, 0, size.wrap-to
		res reinterpret-cast
	elif extern js
		builder.buffer.as-js call-property "slice", 0::nat32, size.wrap-to::nat32 cast  
	else
		throw todo

+size[t] nat64(a t array-builder)
	forbid a.cur-size == max-value
	a cur-size

+~=[t] void(a t array-builder, value t)
	forbid a.cur-size == max-value
	capacity = a.buffer mut-slice-size
	if a.cur-size == capacity
		a expand-capacity do capacity == 0 ? 4 : capacity * 2
	trusted a.buffer array-set a.cur-size, value
	a.cur-size +:= 1
~array-set[t] void(a t mut-slice, index nat64, value t) builtin, unsafe

# TODO: MOVE. This is useful from Java too, unlike other pointer functions --------------------------------------------------------------------------------
~is-empty-type[t] bool() builtin, unsafe

+~~=[t] void(a t array-builder, option t?)
	if x ?= option
		a ~= x
+~~=[t] void(a t array-builder, values t[])
	a ~~= values to
+~~=[t] void(a t array-builder, values t array-view)
	forbid a.cur-size == max-value
	capacity = a.buffer mut-slice-size
	if a.cur-size + values.size > capacity
		a expand-capacity (a.cur-size + values.size).round-up-to-power-of-two
	trusted if extern java
		unless is-empty-type@t
			values.inner.reinterpret-cast arraycopy values.view-indices.low.wrap-to, a.buffer.reinterpret-cast, a.cur-size.wrap-to, values.size.wrap-to
	else
		for i : 0 .. values.size
			a.buffer array-set a.cur-size + i, values[i]
	a.cur-size +:= values size
-expand-capacity[t] void(a t array-builder, new-capacity nat64)
	# assert new-capacity > a.cur-size # TODO -----------------------------------------------------------------------------------
	trusted
	new-buffer t mut-slice = new-capacity gc-safe-mut-slice
	if extern java
		unless is-empty-type@t
			a.buffer.reinterpret-cast arraycopy 0, new-buffer.reinterpret-cast, 0, a.cur-size.wrap-to # TODO: shouldn't need cast? ---------------
	else
		for i nat64 : 0 .. a.cur-size
			new-buffer array-set i, do a.buffer array-get i
	a.buffer := new-buffer

-wrap-to int32(a nat64)
	a.wrap-to::nat32 wrap-to

-gc-safe-mut-slice[t] t mut-slice(size nat64) unsafe, builtin # TODO: Try to only define this once ................................

region Views

# TODO:MOVE? ---------------------------------------------------------------------------------------------------------------------
+array-view[t] record
	~inner t[]
	~view-indices nat64 range
+new[t] t array-view(...a t[])
	a to
+subscript[t] t array-view(a t[], indices nat64 range)
	assert indices.high <= a.array-size : indices.high index-too-big a.array-size
	a, indices
+to[t] t[](a t array-view)
	if a.view-indices == (0 .. a.inner.array-size)
		a inner
	else
		with out : a.size build
			out ~~= a
+to[t] t array-view(a t[])
	a, 0 .. a.array-size
+is-empty[t] bool(a t array-view)
	a.view-indices is-empty
+size[t] nat64(a t array-view)
	a.view-indices size
+subscript[t] t(a t array-view, index nat64)
	assert index < a.size : index index-too-big a.size
	a.inner[a.view-indices.low + index]
+subscript[t] t array-view(a t array-view, indices nat64 range)
	a.inner, a.view-indices[indices]
+iterate[t] bool(a t array-view, f bool mut(x t))
	i mut = a.view-indices low
	loop
		if i == a.view-indices.high
			break false
		elif f[a.inner[i]]
			break true
		else
			i +:= 1
			continue
