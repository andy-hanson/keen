no-std
import
	java/lang/IndexOutOfBoundsException
	java/lang/Object
	java/lang/System
	../../bool
	../../compare
	../collection
	../../misc
	../../number
	../../private/bootstrap: array-size, mut-slice
	../../range
	../../unsafe
export
	../../private/bootstrap: array

+array-like[col, elem] spec col size, (col, elem) at-index
+mut-array-like[col, elem] spec (col, elem) array-like, (col, elem) set-at-index

~mut-slice-size[t] nat64(a t mut-slice)

+subscript[t] t(a t[], index nat64)
	trusted if java
		try
			array-get a, index
		catch as IndexOutOfBoundsException
			throw index-too-big index, a.array-size
	else
		assert index < a.array-size else index-too-big index, a.array-size
		array-get a, index
-array-get[t] t(a t[], index nat64) unsafe

###
Equivalent to calling `f[a[0]]`, `f[a[1]]`, etc.

Calls `f` for each element in `a`.
###
+iterate[t] bool(a t[], f bool mut(elem t))
	i mut nat64 = 0
	loop
		if i == a.array-size
			break false
		elif f[a[i]]
			break true
		else
			i +:= 1
			continue

~array-set[t] void(a t mut-slice, index nat64, value t) unsafe

-wrap-to int32(a nat64)
	a.wrap-to::nat32.wrap-to

~gc-safe-mut-slice[t] t mut-slice(size nat64) unsafe # TODO: Try to only define this once ................................

region Views

# TODO:MOVE? ---------------------------------------------------------------------------------------------------------------------
+array-view[t] record
	~inner t[]
	~low nat
	~high nat
+list-new[t] t array-view(a t[])
	a.to
+subscript[t] t array-view(a t[], indices nat64 range)
	assert indices.high <= a.array-size else index-too-big indices.high, a.array-size
	a, indices.low, indices.high
+to[t] t[](a t array-view)
	size = a.size
	if size == a.inner.array-size
		a.inner
	else
		trusted
		res t mut-slice = gc-safe-mut-slice a.size
		copy-from res, 0 .. size, a.inner, a.low .. a.high
		cast-immutable res
+to[t] t array-view(a t[])
	a, 0, a.array-size
+is-empty[t] bool(a t array-view)
	a.low == a.high
+size[t] nat64(a t array-view)
	a.high - a.low
+subscript[t] t(a t array-view, index nat64)
	assert index < a.size else index-too-big index, a.size
	a.inner[a.low + index]
+subscript[t] t array-view(a t array-view, indices nat64 range)
	assert indices.high <= a.size else index-too-big indices.high, a.size
	a.inner, a.low + indices.low, a.low + indices.high
+iterate[t] bool(a t array-view, f bool mut(x t))
	i mut = a.low
	loop
		if i == a.high
			break false
		elif f[a.inner[i]]
			break true
		else
			i +:= 1
			continue

~cast-immutable[t] t[](a t mut-slice) unsafe
	reinterpret-cast a

~copy-from[t] void(dest t mut-slice, dest-range nat range, src t[], src-range nat range)
	trusted
	guard !(is-empty-type@t) # TODO: should not need parentheses
	size = dest-range.size
	assert src-range.size == size
	assert dest-range.high <= dest.mut-slice-size
	assert src-range.high <= src.array-size
	dl = dest-range.low
	sl = src-range.low
	if java
		arraycopy src.reinterpret-cast::Object, sl.wrap-to, dest.reinterpret-cast::Object, dl.wrap-to, size.wrap-to
	else
		i mut nat = 0
		until i == size
			array-set dest, dl + i, array-get src, sl + i
			i +:= 1
