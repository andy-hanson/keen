no-std
import
	java/lang/System
	../../bits: round-up-to-power-of-two
	../../bool: bool, false, true
	../../compare: <, <=, >
	../collection: build, index-too-big, with-block
	../../exception: todo
	../../java: java-cast
	../../js: as-js, call-property, cast, js-cast
	../../misc: new, subscript, void
	../../number: ==, <=>, +, -, *, int32, max-value, nat32, nat64, wrap-to
	../../option: option
	../../range: ==, .., difference, is-empty, high, low, range, size, subscript
	../../private/bootstrap: array-size, mut-slice
	./build: build-options, size-hint
export
	../../private/bootstrap: array

~mut-slice-size[t] nat64(a t mut-slice) builtin

array-cast[out, in] out[](a in[]) unsafe # TODO: RM. This is only used to convert nat8[] to char8[]. Maybe just have a builtin for that specifically. -----------------------------------------------------------------------------
	if extern java
		a java-cast
	elif extern js
		a js-cast
	else
		throw todo

+subscript[t] t(a t[], index nat64) trusted
	assert index < a.array-size : index index-too-big a.array-size
	a array-get index
~array-get[t] t(a t[], index nat64) builtin, unsafe

###
Equivalent to calling `f[a[0]]`, `f[a[1]]`, etc.

Calls `f` for each element in `a`.
###
+iterate[t] bool(a t[], f bool mut(elem t)) trusted
	i mut nat64 = 0
	loop
		if i == a.array-size
			break false
		elif f[a[i]]
			break true
		else
			i +:= 1
			continue

+array-builder[t] record mut
	-buffer mut t mut-slice
	| Not used in JS
	-cur-size mut nat64
+build[t] t[](a build-options, f void mut(out t array-builder)) trusted
	if extern java
		builder t array-builder = a.size-hint.gc-safe-mut-slice, 0
		f[builder]
		# TODO:PERF reuse 'buffer' if size matches? ---------------------------------------------------------------------------
		res t mut-slice = builder.cur-size gc-safe-mut-slice
		unless is-empty-type@t
			builder.buffer.java-cast arraycopy 0, res.java-cast, 0, builder.cur-size.wrap-to
		builder.cur-size := max-value
		res java-cast
	elif extern js
		builder t array-builder = (), max-value
		f[builder]
		assert builder.cur-size == max-value
		builder.buffer.js-cast
	else
		throw todo

-new[t] t mut-slice(...a t[]) trusted, js extern
	a js-cast

+size[t] nat64(a t array-builder) trusted
	if extern js
		assert a.cur-size == max-value
		a.buffer mut-slice-size
	else
		forbid a.cur-size == max-value
		a cur-size

+~=[t] void(a t array-builder, value t) trusted
	if extern java
		forbid a.cur-size == max-value
		capacity = a.buffer mut-slice-size
		if a.cur-size == capacity
			a expand-capacity do capacity == 0 ? 4 : capacity * 2
		a.buffer array-set a.cur-size, value
		a.cur-size +:= 1
	elif extern js
		a.buffer.as-js call-property "push", value cast
	else
		throw todo
~array-set[t] void(a t mut-slice, index nat64, value t) builtin, unsafe

# TODO: MOVE. This is useful from Java too, unlike other pointer functions --------------------------------------------------------------------------------
~is-empty-type[t] bool() builtin, unsafe

+~~=[t] void(a t array-builder, option t?)
	if x ?= option
		a ~= x
+~~=[t] void(a t array-builder, values t[]) trusted
	a ~~= values.to
+~~=[t] void(a t array-builder, values t array-view) trusted
	if extern java
		forbid a.cur-size == max-value
		capacity = a.buffer mut-slice-size
		if a.cur-size + values.size > capacity
			a expand-capacity (a.cur-size + values.size).round-up-to-power-of-two
		unless is-empty-type@t
			values.inner.java-cast arraycopy values.indices.low.wrap-to, a.buffer.java-cast, a.cur-size.wrap-to, values.size.wrap-to
		a.cur-size +:= values size
	elif extern js
		_ = values iterate x =>
			_ = a.buffer.as-js call-property "push", x
			false
	else
		throw todo
-expand-capacity[t] void(a t array-builder, new-capacity nat64) trusted
	# assert new-capacity > a.cur-size # TODO -----------------------------------------------------------------------------------
	new-buffer t mut-slice = new-capacity gc-safe-mut-slice
	unless is-empty-type@t
		assert extern java : todo
		a.buffer.java-cast arraycopy 0, new-buffer.java-cast, 0, a.cur-size.wrap-to
	a.buffer := new-buffer

-wrap-to int32(a nat64)
	a.wrap-to::nat32 wrap-to

-gc-safe-mut-slice[t] t mut-slice(size nat64) unsafe, builtin # TODO: Try to only define this once ................................

region Views

# TODO:MOVE? ---------------------------------------------------------------------------------------------------------------------
+array-view[t] record
	~inner t[]
	~indices nat64 range
+new[t] t array-view(...a t[])
	a to
+subscript[t] t array-view(a t[], indices nat64 range)
	assert indices.high <= a.array-size : indices.high index-too-big a.array-size
	a, indices
+to[t] t[](a t array-view)
	if a.indices == (0 .. a.inner.array-size)
		a inner
	else
		with out : a.size build
			out ~~= a
+to[t] t array-view(a t[])
	a, 0 .. a.array-size
+is-empty[t] bool(a t array-view)
	a.indices is-empty
+size[t] nat64(a t array-view)
	a.indices size
+subscript[t] t(a t array-view, index nat64)
	assert index < a.size : index index-too-big a.size
	a.inner[a.indices.low + index]
+subscript[t] t array-view(a t array-view, indices nat64 range)
	a.inner, a.indices[indices]
+iterate[t] bool(a t array-view, f bool mut(x t))
	i mut = a.indices low
	loop
		if i == a.indices.high
			break false
		elif f[a.inner[i]]
			break true
		else
			i +:= 1
			continue
