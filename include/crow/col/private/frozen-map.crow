no-std
import
	../../bool
	../../compare
	../../hash
	../../misc
	../../number
	../../option
	../../range
	../../tuple
	../array
	../collection
	../util
	../mut-slice

| Immutable map that is not efficient to update.
| However, this is more compact than `v[k]` and has faster lookups.
~frozen-map[k, v] record
	# exposed for tests only
	pairs (k, v)[]
	bucket-starts nat64[]

~list-new[k, v] (k, v) frozen-map(a (k, v)[]) k key
	a to

~to[k, v] (k, v) frozen-map(a (k, v)[]) k key
	trusted a.to as-frozen-map
~to[k, v] (k, v) frozen-map(a (k, v) array-view) k key
	trusted (for x in a then x) as-frozen-map

| This is O(1). Unsafe because the pairs are unsorted.
~to[k, v] (k, v)[](a (k, v) frozen-map) unsafe
	a pairs

~is-empty[k, v] bool(a (k, v) frozen-map)
	a.pairs is-empty

~size[k, v] nat64(a (k, v) frozen-map)
	a.pairs size

~subscript[k, v] v?(a (k, v) frozen-map, key k) k key
	trusted if index = a try-get-unordered-index key
		a.pairs[index] b

try-get-unordered-index[k, v] nat64?(a (k, v) frozen-map, key k) k key, unsafe
	a bucket-indices key find a.pairs[it].a == key

-bucket-indices[k, v] nat64 range(a (k, v) frozen-map, key k) k key
	if a.bucket-starts is-empty
		0 .. a.pairs.size
	else
		a bucket-indices-at-index key.get-hash % a.bucket-starts.size

# Returns a slice of 'a.pairs'
-bucket-indices-at-index[k, v] nat64 range(a (k, v) frozen-map, bucket-index nat64)
	bucket-start = a.bucket-starts[bucket-index]
	bucket-end = if bucket-index == a.bucket-starts.size - 1
		a.pairs size
	else
		a.bucket-starts[bucket-index + 1]
	bucket-start .. bucket-end

-bucket-at-index[k, v] (k, v) array-view(a (k, v) frozen-map, bucket-index nat64)
	a.pairs[a bucket-indices-at-index bucket-index]

-as-frozen-map[k, v] (k, v) frozen-map(a (k, v) mut-slice) unsafe, k key
	a.make-frozen-map remove-duplicates

-make-frozen-map[k, v] (k, v) frozen-map
	a (k, v) mut-slice
do unsafe, k key
	if a.size <= 4
		a.cast-immutable, ()
	else
		n-buckets = a.size / 2
		bucket-starts = a get-bucket-starts n-buckets
		bucket-counts nat64 mut-slice = n-buckets n-of 0
		cur mut nat64 = 0
		until cur == a.size
			bucket-index = a[cur].a get-bucket-index bucket-counts.size
			bucket-count = bucket-counts[bucket-index]
			bucket-start = bucket-starts[bucket-index]
			bucket-cur-end = bucket-start + bucket-count
			if bucket-start <= cur and cur <= bucket-cur-end
				if cur == bucket-cur-end
					bucket-counts[bucket-index] := bucket-count + 1
				cur +:= 1
			else
				bucket-counts[bucket-index] := bucket-count + 1
				a swap-at cur, bucket-cur-end
		a.cast-immutable, bucket-starts

-remove-duplicates[k, v] (k, v) frozen-map(a (k, v) frozen-map) unsafe, k key
	if a has-duplicates
		# Write out pairs from each bucket to a mut-slice,
		# omitting a pair if its key appears later in the same bucket.
		with out in a.size build
			out write-without-duplicates a
		then make-frozen-map
	else
		a

-write-without-duplicates[k, v] void(out (k, v) builder, a (k, v) frozen-map) k key
	if a.bucket-starts is-empty
		out write-bucket-without-duplicates a.pairs.to
	else
		for i in 0 .. a.bucket-starts.size
			out write-bucket-without-duplicates (a bucket-at-index i)

-write-bucket-without-duplicates[k, v] void(out (k, v) builder, pairs (k, v) array-view) k key
	for i, pair in pairs with-index
		unless pair.a key-in-range pairs[i + 1 .. end]
			out ~= pair

-has-duplicates[k, v] bool(a (k, v) frozen-map) k key
	if a.bucket-starts is-empty
		a.pairs.to bucket-has-duplicates
	else
		0 .. a.bucket-starts.size exists of i
			a bucket-at-index i bucket-has-duplicates

-bucket-has-duplicates[k, v] bool(pairs (k, v) array-view) k key
	pairs.with-index exists of i, (k, _)
		k key-in-range pairs[i + 1 .. end]

-key-in-range[k, v] bool(key k, pairs (k, v) array-view) k key
	pairs exists it.a == key

-get-bucket-starts[k, v] nat64[](a (k, v) mut-slice, n-buckets nat64) unsafe, k key
	res nat64 mut-slice = n-buckets n-of 0
	for k, _ in a
		res[k get-bucket-index n-buckets] +:= 1
	res running-sum
	res cast-immutable

-get-bucket-index[k] nat64(key k, n-buckets nat64) k key
	key.get-hash % n-buckets

-running-sum void(a nat64 mut-slice)
	acc mut nat64 = 0
	a map= of x
		start = acc
		acc +:= x
		start

~iterate[k, v] bool(a (k, v) frozen-map, f bool mut(key k, value v)) unsafe
	a.pairs iterate f
