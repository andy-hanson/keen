no-std
import
	../../bool: &&, bool, not
	../../compare: ==, !=, <, >=, compare, comparison, equal
	../../exception: unreachable
	../../json: to
	../../misc: data, loop-break, new, subscript, void
	../../number: ==, <=>, +, -, /, next
	../../option: ==, force, is-empty, new, option
	../../range: .., iterate
	../../test-util: is
	../../tuple: a, new
	../../private/bootstrap: nat64
	../array: ==, +, -, array, array-view, begin, end, iterate, new, next, size, slice, subscript
	../collection: .., end, for-break, for-loop, subscript
	../mut-slice: as-const, mut-slice, mut-slice-view, size, subscript
	../mut-array

binary-search-has[t] bool(a t[], value t) t compare, t data
	a binary-search-exact value !is-empty

binary-search-key[k, v] v?(a (k, v)[], key k) k compare
	left mut = a begin
	right mut = a end
	loop
		diff = right - left
		if diff < 4
			break for k, v : left slice right
				if k == key
					break v
		else
			mid = left + diff / 2
			next-k, next-v = mid.next!.a
			match key <=> next-k
			as less
				right := mid
				continue
			as equal
				break next-v
			as greater
				left := mid + 1
				continue

###
Assumes the array is sorted.
Returns an iterator whose 'next' is the value, or nothing if the array does not contain the value.
###
binary-search-exact-cb[t] nat64?(a t mut[], comparer comparison data(x t))
	# temp-as-array is safe because 'compare' is 'data'
	trusted a.temp-as-array-view binary-search-exact-cb comparer
-binary-search-exact-cb[t] nat64?(a t array-view, comparer comparison data(x t))
	res = a binary-search-insert-cb comparer
	if res != a.size && comparer[a[res]] == equal
		res
-binary-search-exact[t] nat64?(a t[], value t) t compare, t data
	res = a binary-search-insert value
	if res != a.size && a[res] == value
		res
test
	a nat64[] = 1, 5, 9
	a binary-search-exact 5 is 1
	a binary-search-exact 6 is ()

binary-search-insert[t] nat64(a t[], value t) t compare, t data
	a binary-search-insert-cb x => value <=> x

###
Returns the pointer to the least value that is compared equal or greater.
Returns `a end-pointer` if all values compare less.
###
binary-search-insert-cb[t] nat64(a t mut[], compare comparison data(elem t))
	trusted a.temp-as-mut-slice binary-search-insert-cb compare

binary-search-insert-cb[t] nat64(a t mut-slice, compare comparison data(elem t))
	a[0 .. end] binary-search-insert-cb compare

binary-search-insert-cb[t] nat64(a t[], compare comparison data(elem t))
	a.to binary-search-insert-cb compare

binary-search-insert-cb[t] nat64(a t array-view, compare comparison data(elem t))
	left mut nat64 = 0
	right mut = a size
	loop
		if left == right
			break left
		else
			mid = left + (right - left) / 2
			match compare[a[mid]]
			as less
				right := mid
				continue
			as equal
				break mid
			as greater
				left := mid + 1
				continue

binary-search-insert-cb[t] nat64(a t mut-slice-view, compare comparison data(elem t))
	(trusted a.as-const) binary-search-insert-cb compare

test
	a nat64[] = 1, 3, 5, 7
	(a binary-search-insert-cb x => 0::nat64 <=> x) is 0
	(a binary-search-insert-cb x => 3::nat64 <=> x) is 1
	(a binary-search-insert-cb x => 4::nat64 <=> x) is 2
	(a binary-search-insert-cb x => 5::nat64 <=> x) is 2
	(a binary-search-insert-cb x => 6::nat64 <=> x) is 3
	(a binary-search-insert-cb x => 7::nat64 <=> x) is 3
	(a binary-search-insert-cb x => 8::nat64 <=> x) is 4

unique-comparison enum(less, greater)

assert-comparison-not-equal unique-comparison(a comparison)
	match a
	as less
		less
	as equal
		throw unreachable
	as greater
		greater

# 'a' and 'b' must be sorted. Moves contents of 'b' into 'a' and preserves sorting.
merge-no-duplicates[t] void(a t mut[], b t mut[], compare unique-comparison data(x t, y t))
	if a.size < b.size
		a swap b
	assert a.size >= b.size
	guard b !is-empty
	trusted
		a-old-size = a size
		a push-gc-safe-values b.size
		a-read mut = a-old-size - 1
		a-write mut = a.size - 1
		b-read mut = b.size - 1
		# Merge right-to-left so we never overwrite anything we still have to read.
		# Invariant: a-read, a-write, b-read are all valid indices.
		loop
			match compare[a[a-read], b[b-read]]
			as less
				a[a-write] := b[b-read]
				if b-read == 0
					break
				else
					a-write -:= 1
					b-read -:= 1
					continue
			as greater
				a[a-write] := a[a-read]
				if a-read == 0
					assert b-read + 1 == a-write
					for i : 0::nat64 .. a-write
						a[i] := b[i]
					break
				else
					a-read -:= 1
					a-write -:= 1
					continue
		b clear

-test-one void(a nat64[], b nat64[], expected nat64[])
	a-mut nat64 mut[] = a to
	b-mut nat64 mut[] = b to
	a-mut merge-no-duplicates b-mut, (x, y) =>
		x <=> y assert-comparison-not-equal
	a-mut.move-to::nat64[] is expected

test
	(1, 2, 3) test-one (4, 5, 6), (1, 2, 3, 4, 5, 6)
	(4, 5, 6) test-one (1, 2, 3), (1, 2, 3, 4, 5, 6)
	(1, 3, 5) test-one (2, 4, 6), (1, 2, 3, 4, 5, 6)
	(2, 4, 6) test-one (1, 3, 5), (1, 2, 3, 4, 5, 6)
	(3, 4, 5) test-one (1, 2, 6), (1, 2, 3, 4, 5, 6)
