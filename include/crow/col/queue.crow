import
	./stack: ~, is-empty, iterate, new, size, stack, to

| Immutable queue.
| Supports efficient removal from the left and insertion to the right.
+queue[t] record
	-left t[]
	-right t stack

| Empty queue.
+new[t] t queue()
	(), ()

+to[t] t queue(a t[])
	a, ()

| Copies queue elements to an array.
| This is O({a} {size}).
+to[t] t[](a t queue)
	for x in a
		x

| {true} if `{a}.{size} == 0`.
+is-empty[t] bool(a t queue)
	a.left is-empty and a.right is-empty

| Number of elements in the queue.
+size[t] nat64(a t queue)
	a.left.size + a.right.size

| Adds a new element on the right.
+~[t] t queue(a t queue, value t)
	a.left, a.right ~ value

| Removes and returns an element from the left.
| Returns an empty option if `{a} {is-empty}`.
+dequeue[t] (t, t queue)?(a t queue)
	if a.left is-empty
		unless a.right is-empty
			(a.right.to, ()) dequeue
	else
		a.left[0], (a.left[1 .. end].to, a.right)

region iteration

+iterate[t] bool(a t queue, f bool mut(elem t))
	a.left iterate f or a.right iterate f

region build

+queue-builder[t] record mut
	-inner t array-builder
+build[t] t queue(a build-options, f void mut(out t queue-builder))
	a build f[it,] to
+~=[t] void(a t queue-builder, value t)
	a.inner ~= value

test
	a nat64 queue = ()
	assert a is-empty
	a.to is ()
	forbid _ ?= a dequeue

	b = a ~ 1
	b.to::nat64[] is (1,)
	bx, br = b dequeue!
	bx is 1
	assert br is-empty

	c = b ~ 2
	c.to::nat64[] is (1, 2)
	cx, cr = c dequeue!
	cx is 1

	cr.to::nat64[] is (2,)
	crx, crr = cr dequeue!
	crx is 2
	assert crr is-empty

	d = c ~ 3
	d.to::nat64[] is (1, 2, 3)

	(for x in d then x + 10)::(nat64 queue).to::nat64[] is (11, 12, 13)
