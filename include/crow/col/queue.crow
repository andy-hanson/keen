import
	./stack

| Immutable queue.
| Supports efficient removal from the left and insertion to the right.
+queue[t] record
	-left t[]
	-right t stack

+list-new[t] t queue(values t[])
	values, ()

+to[t] t queue(a t[])
	a, ()

| Copies queue elements to an array.
| This is O({a} {size}).
+to[t] t[](a t queue)
	map a, it.identity

| {true} if `{a}.{size} == 0`.
+is-empty[t] bool(a t queue)
	is-empty a.left and is-empty a.right

| Number of elements in the queue.
+size[t] nat64(a t queue)
	a.left.size + a.right.size

| Adds a new element on the right.
+~[t] t queue(a t queue, value t)
	a.left, a.right ~ value

| Removes and returns an element from the left.
| Returns an empty option if `{a} {is-empty}`.
+dequeue[t] (t, t queue)?(a t queue)
	if is-empty a.left
		unless is-empty a.right
			dequeue (a.right.to, ())
	else
		a.left[0], (a.left[1 .. end].to, a.right)

region iteration

+iterate[t] bool(a t queue, f bool mut(elem t))
	iterate a.left, f or iterate a.right, f

test
	a nat64 queue = ()
	assert is-empty a
	a.to is ()
	forbid _ = dequeue a

	b = a ~ 1
	b.to::nat64[] is (1,)
	bx, br = dequeue! b
	bx is 1
	assert is-empty br

	c = b ~ 2
	c.to::nat64[] is (1, 2)
	cx, cr = dequeue! c
	cx is 1

	cr.to::nat64[] is (2,)
	crx, crr = dequeue! cr
	crx is 2
	assert is-empty crr

	d = c ~ 3
	d.to::nat64[] is (1, 2, 3)

	map::nat64[] d, it + 10 is (11, 12, 13)
