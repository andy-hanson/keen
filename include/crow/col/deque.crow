import
	./stack

| Immutable double-ended queue.
+deque[t] record
	| This is in reverse; the top of the stack is the leftmost element of the deque.
	-left t stack
	-mid t[]
	| The top of the stack is the rightmost element of the deque.
	-right t stack

| {deque} containing the given elements.
+new[t] t deque(...a t[])
	a to

+to[t] t deque(a t[])
	# TODO: should not need type annotation
	()::(t stack), a, ()

+to[t] t[](a t deque)
	for x : a; x

| {true} iff `{a}.{size} == 0`.
| This is O(1).
+is-empty[t] bool(a t deque)
	a.left is-empty and a.mid is-empty and a.right is-empty

| Number of elements in the deque.
| This is O(n).
+size[t] nat64(a t deque)
	a.left.size + a.mid.size + a.right.size

+to[t] json(a t deque) (json, t) to
	a.to::t[] to

+==[t] bool(a t deque, b t deque) t equal
	a.to::t[] == b.to::t[] # TODO:PERF

| Adds a new element on the right.
+~[t] t deque(a t deque, value t)
	a.left, a.mid, a.right ~ value

| Adds a new element on the left.
+~[t] t deque(value t, a t deque)
	a.left ~ value, a.mid, a.right

| Remove a value from the left.
| Returns an empty option if {a} is empty.
+pop-left[t] (t, t deque)?(a t deque)
	if popped ?= a.left pop
		popped.b, (popped.a, a.mid, a.right)
	elif a.mid !is-empty
		a.mid[0], ((), a.mid[1 .. end].to, a.right)
	else
		right-arr t[] = a.right to
		unless right-arr is-empty
			right-arr[0], right-arr[1 .. end].to.to

| Remove a value from the right.
| Returns an empty option if {a} is empty.
+pop-right[t] (t deque, t)?(a t deque)
	if popped ?= a.right pop
		(a.left, a.mid, popped.a), popped.b
	elif a.mid !is-empty
		(a.left, a.mid[0 .. end - 1].to, ()), a.mid[end - 1]
	else
		left-arr = a.left to-array-reverse
		unless left-arr is-empty
			left-arr[0 .. end - 1].to.to, left-arr[end - 1]

region spec impls (see collection.crow)

+iterate[t] bool(a t deque, f bool mut(elem t))
	a.left.reverse iterate f or a.mid iterate f or a.right iterate f

region test

-dbg string(a nat64 deque)
	left = "" join for x : a.left reverse; "{x} "
	mid = " " join for x : a mid; "{x}"
	right = "" join for x : a right; " {x}"
	"{left}[{mid}]{right}"

test
	a nat64 deque = ()
	assert a is-empty
	a.dbg is "[]"
	a.to::nat64[] is ()
	a.pop-left is ()
	a.pop-right is ()

	bl nat64 deque = 1 ~ a
	bl.dbg is "1 []"
	bl.to::nat64[] is (1,)
	bl.pop-left! is (1, ())
	bl.pop-right! is ((), 1)

	br = a ~ 1
	br.dbg is "[] 1"
	br.to::nat64[] is bl.to
	br.pop-left! is (1, ())
	br.pop-right! is ((), 1)

	c = bl ~ 2 ~ 3
	c.dbg is "1 [] 2 3"
	c-pop, d = c pop-left!
	c-pop is 1

	# Forces it to convert to an array
	d.dbg is "[] 2 3"
	d.pop-left! is (2, (3,))

	d-pop = d pop-left!
	d-pop.a is 2
	d-pop.b.dbg is "[3]"

	# Test converting right stack to array
	e nat64 deque = 1 ~ (2 ~ (3 ~ ()))
	e.to::nat64[] is (1, 2, 3)
	e.dbg is "1 2 3 []"
	e-pop = e pop-right!
	e-pop.b is 3
	e-pop.a.dbg is "[1 2]"

	six nat64 deque = 1 ~ (2 ~ (3, 4)) ~ 5 ~ 6
	six.dbg is "1 2 [3 4] 5 6"
	(for x : six; x + 10)::nat64[] is (11, 12, 13, 14, 15, 16)
