import
	./stack

| Immutable double-ended queue.
+deque[t] record
	| This is in reverse; the top of the stack is the leftmost element of the deque.
	-left t stack
	-mid t[]
	| The top of the stack is the rightmost element of the deque.
	-right t stack

+list-new[t] t deque(a t[])
	a.to

+to[t] t deque(a t[])
	(), a, ()

+to[t] t[](a t deque)
	for x in a then x

| {true} iff `{a}.{size} == 0`.
| This is O(1).
+is-empty[t] bool(a t deque)
	is-empty a.left and is-empty a.mid and is-empty a.right

| Number of elements in the deque.
| This is O(n).
+size[t] nat64(a t deque)
	a.left.size + a.mid.size + a.right.size

+to[t] json(a t deque) (json, t) to
	a.to::t[].to

+==[t] bool(a t deque, b t deque) t equal
	trusted a.to::t[] == b.to::t[] # TODO:PERF

| Adds a new element on the right.
+~[t] t deque(a t deque, value t)
	a.left, a.mid, a.right ~ value

| Adds a new element on the left.
+~[t] t deque(value t, a t deque)
	a.left ~ value, a.mid, a.right

| Remove a value from the left.
| Returns an empty option if {a} is empty.
+pop-left[t] (t, t deque)?(a t deque)
	if popped = pop a.left
		popped.b, (popped.a, a.mid, a.right)
	elif !is-empty a.mid
		a.mid[0], ((), a.mid[1 .. end].to, a.right)
	else
		right-arr t[] = a.right.to
		unless is-empty right-arr
			right-arr[0], right-arr[1 .. end].to.to

| Remove a value from the right.
| Returns an empty option if {a} is empty.
+pop-right[t] (t deque, t)?(a t deque)
	if popped = pop a.right
		(a.left, a.mid, popped.a), popped.b
	elif !is-empty a.mid
		(a.left, a.mid[0 .. end - 1].to, ()), a.mid[end - 1]
	else
		left-arr = to-array-reverse a.left
		unless is-empty left-arr
			left-arr[0 .. end - 1].to.to, left-arr[end - 1]

+iterate[t] bool(a t deque, f bool mut(elem t))
	iterate a.left.reverse, f or iterate a.mid, f or iterate a.right, f

-dbg string(a nat64 deque)
	left = join "", for x in reverse a.left then "{x} "
	mid = join " ", for x in a.mid then "{x}"
	right = join "", for x in a.right then " {x}"
	"{left}[{mid}]{right}"

test
	a nat64 deque = ()
	assert is-empty a
	a.dbg is "[]"
	a.to::nat64[] is ()
	a.pop-left is ()
	a.pop-right is ()

	bl nat64 deque = 1 ~ a
	bl.dbg is "1 []"
	bl.to::nat64[] is (1,)
	bl.pop-left! is (1, ())
	bl.pop-right! is ((), 1)

	br = a ~ 1
	br.dbg is "[] 1"
	br.to::nat64[] is bl.to
	br.pop-left! is (1, ())
	br.pop-right! is ((), 1)

	c = bl ~ 2 ~ 3
	c.dbg is "1 [] 2 3"
	c-pop, d = pop-left! c
	c-pop is 1

	# Forces it to convert to an array
	d.dbg is "[] 2 3"
	d.pop-left! is (2, (3,))

	d-pop = pop-left! d
	d-pop.a is 2
	d-pop.b.dbg is "[3]"

	# Test converting right stack to array
	e nat64 deque = 1 ~ (2 ~ (3 ~ ()))
	e.to::nat64[] is (1, 2, 3)
	e.dbg is "1 2 3 []"
	e-pop = pop-right! e
	e-pop.b is 3
	e-pop.a.dbg is "[1 2]"

	six nat64 deque = 1 ~ (2 ~ (3, 4)) ~ 5 ~ 6
	six.dbg is "1 2 [3 4] 5 6"
	map::nat64[] six, it + 10 is (11, 12, 13, 14, 15, 16)
