no-std
import
	../bits
	../bool
	../compare
	../exception
	../hash
	../misc
	../number
	../option
	../range
	../string
	../symbol
	../tuple
	./array
	./collection
	./mut-slice
	./private/frozen-map
	./sort
	./util

| Immutable unordered map type.
| Iteration is sorted, meaning it does O(n) work even if it only iterates one element.
| A map is logically a collection of key-value pairs (`({k}, {v})`).
| A key can appear at most once, and given a key, you can access the associated value in O(1).
+map[k, v] record
	-root (k, v) node

+==[k, v] bool(a v[k], b v[k]) k key, v equal
	trusted
	a.size == b.size and a.unsorted every of k, v
		b[k] == v

-node[k, v] union
	(k, v) frozen-map
	(k, v) inner-node
	(k, v)[]
-inner-node[k, v] record(nodes (k, v) node[])

-empty-leaf-node[k, v] (k, v) node()
	()::(k, v)[]

-low-bits nat64(a nat64)
	a & 0b1111

-inner-node-n-bits nat64()
	4

-leaf-max-size nat64()
	8

| Later pairs overwrite earlier pairs with the same key.
+list-new[k, v] v[k](a (k, v)[]) k key
	a to

| Maps with symbol keys can be created using the named-new syntax.
+named-new[v] v[symbol](keys symbol[], values v[])
	for i, key in keys with-index
		key, values[i]

| Converts a list of pairs to a map.
| Later pairs overwrite earlier pairs with the same key.
+to[k, v] v[k](a (k, v)[]) k key
	if a.size <= 4 and a.to !has-duplicate-keys
		a,
	else
		a.to::((k, v) frozen-map),
+to[k, v] v[k](a (k, v) array-view) k key
	if a.size <= 4 and a !has-duplicate-keys
		a.to::(k, v)[],
	else
		a.to::((k, v) frozen-map),

| Returns all pairs in the map, sorted by key.
+to[k, v] (k, v)[](a v[k]) k key
	a map it.identity

| O(n^2) but it doesn't matter since n <= 4
-has-duplicate-keys[k, v] bool(a (k, v) array-view) k key
	match a size
	as 0
		false
	as 1
		false
	as 2
		a[0].a == a[1].a
	as 3
		a[0].a == a[1].a or a[0].a == a[2].a or a[1 .. a.size] has-duplicate-keys
	as 4
		a[0].a == a[1].a or a[0].a == a[2].a or a[0].a == a[3].a or a[1 .. a.size] has-duplicate-keys
	else
		throw unreachable

| {true} if `{a}.{size} == 0`
+is-empty[k, v] bool(a v[k]) k key
	a.root node-is-empty
-node-is-empty[k, v] bool(a (k, v) node)
	match a
	as frozen-map
		a is-empty
	as inner-node
		false
	as array
		a is-empty

| Number of pairs.
+size[k, v] nat64(a v[k])
	a.root size
-size[k, v] nat64(a (k, v) node)
	match a
	as frozen-map
		a size
	as inner-node
		acc mut nat64 = 0
		for child in a nodes
			acc +:= child size
		acc
	as array
		a size

| Gets the value associated with a key.
| Returns an empty option unless `{key} in {a}`.
+subscript[k, v] v?(a v[k], key k) k key
	match root = a root
	as frozen-map
		root[key]
	as inner-node
		root subscript-inner key
	as array
		root lookup key
-subscript-inner[k, v] v?(a (k, v) inner-node, key k) k key
	cur mut (k, v) node = a
	remaining-hash mut = key get-hash
	loop
		match x = cur
		as frozen-map
			throw unreachable
		as inner-node
			which = remaining-hash low-bits
			guard which < x.nodes.size else break
			cur := x.nodes[which]
			remaining-hash >>:= inner-node-n-bits
			continue
		as array
			break x lookup key
-lookup[k, v] v?(a (k, v)[], key k) k key
	a first of k, v
		if k == key then v

| Associates the key with the value.
| If `{key} in {a}`, overwrites the old value. Otherwise adds a new entry.
+~[k, v] v[k](a v[k], (key k, value v)) k key
	res = a get-or-update key, of _
		value insert
	if node = res new-node
		node,
	else
		a

| Adds/updates many entries to {a}.
| Where keys match, values in {b} overwrite values in {b}. Otherwise they add new entries.
+~~[k, v] v[k](a v[k], b v[k]) k key
	res mut = a
	trusted for pair in b unsorted
		res ~:= pair
	res

+keys[k, v] k[](a v[k]) k key
	a map it.a

+values[k, v] v[](a v[k]) k key
	a map it.b

~got-or-added[k, v] union(v got, (k, v) added)
~got[t] record(value t)
~added[k, v] record(map v[k], value v)

| If {key} is already in {a}, returns {got} with the old value.
| Else, adds a new pair `{key}, {get-value}[]` and return {added}.
~get-or-add[k, v] (k, v) got-or-added(a v[k], key k, get-value v mut()) k key
	res = a get-or-update key, of old-value
		if old-value
			no-change
		else
			get-value[] insert
	if v = res old-value
		(v,)::(v got)
	else
		((res.new-node!,), res.new-value!)::((k, v) added)

| Removes {key} and its associated value.
| If `{key} !in {a}`, returns {a} unmodified.
| If you need the old value, use {remove} instead.
+-[k, v] v[k](a v[k], key k) k key
	if res = a remove key
		res b
	else
		a

| Removes a key and its associated value, and returns the value and the new map.
|
| If `{key} !in {a}`, returns an empty option.
+remove[k, v] (v, v[k])?(a v[k], key k) k key
	res = a get-or-update key, of _ then remove
	if value = res old-value
		value, (res.new-node!,)

-get-or-update-result[k, v] record
	# If none, don't update anything
	new-node (k, v) node?
	old-value v?
	new-value v?
-get-or-update-action[v] union(no-change, remove, v insert)
-no-change record
-remove record
-insert[t] record(value t)
-get-or-update[k, v] (k, v) get-or-update-result
	a v[k]
	key k
	f v get-or-update-action mut(old-value v?)
do k key
	hash = key get-hash
	match root = a root
	as frozen-map
		trusted root.to get-or-update-leaf key, hash, 0, f
	as inner-node
		root get-or-update-recur key, hash, 0, f
	as array
		root get-or-update-leaf key, hash, 0, f

-get-or-update-recur[k, v] (k, v) get-or-update-result
	a (k, v) node
	key k
	remaining-hash nat64
	hash-shift nat64
	f v get-or-update-action mut(old-value v?)
do k key
	match a
	as frozen-map
		throw unreachable
	as inner-node
		which = remaining-hash low-bits
		if which < a.nodes.size
			next-hash = remaining-hash >> inner-node-n-bits
			child-res = a.nodes[which] get-or-update-recur key, next-hash, hash-shift + inner-node-n-bits, f
			if node = child-res new-node
				new-node: a.nodes update-child which, node
				old-value: child-res old-value
				new-value: child-res new-value
			else
				child-res
		else
			match action = f[]
			as no-change
				(), (), ()
			as remove
				(), (), ()
			as insert
				new-leaf (k, v)[] = (key, action.value),
				new-node = a.nodes update-at-with-default which, new-leaf, empty-leaf-node
				new-node.inner-node, (), action.value
	as array
		a get-or-update-leaf key, remaining-hash, hash-shift, f

| Unlike for {update-at}, {index} doesn't need to be a valid index.
| If `{index} > {a}.{size}`, entries between the and of {a} and the new entries will be {default}.
-update-at-with-default[t] t[](a t[], index nat64, new-value t, default t)
	if index < a.size
		a update-at index, new-value
	else
		for i in 0::nat64 .. index + 1
			if i < a.size
				a[i]
			elif i == index
				new-value
			else
				default

-update-child[k, v] (k, v) node(a (k, v) node[], which nat64, new-child (k, v) node)
	if leaf = a inner-node-to-leaf which, new-child
		leaf
	elif new-child node-is-empty
		if which == a.size - 1
			new-children (k, v) node array-view = a[0 .. a.size - 1]
			if new-children.size == 1 then new-children[0] else new-children.to inner-node
		else
			new-children = a update-at which, new-child
			if child = new-children find-only-non-empty-child
				child
			else
				new-children inner-node
	else
		a update-at which, new-child inner-node

| Returns a new node if we should change this to a leaf.
-inner-node-to-leaf[k, v] (k, v) node?(a (k, v) node[] , which nat64, new-child (k, v) node)
	total-size mut nat64 = 0
	for child-index, child in a with-index
		total-size := match x = if child-index == which then new-child else child
		as frozen-map
			throw unreachable
		as inner-node
			leaf-max-size + 1
		as array
			total-size + x.size
	if total-size <= leaf-max-size
		# TODO: if only one non-empty leaf, don't copy..
		pairs (k, v)[] = with out in total-size build
			for child-index, child in a with-index
				match x = if child-index == which then new-child else child
				as frozen-map
					throw unreachable
				as inner-node
					throw unreachable
				as array
					out ~~= x
		assert pairs.size == total-size
		pairs

-find-only-non-empty-child[k, v] (k, v) node?(children (k, v) node[])
	first-non-empty-index = children find-index! !it.node-is-empty
	if children[first-non-empty-index + 1 .. children.size] every it.node-is-empty
		children[first-non-empty-index]

-get-or-update-leaf[k, v] (k, v) get-or-update-result
	a (k, v)[]
	key k
	remaining-hash nat64
	hash-shift nat64
	f v get-or-update-action mut(old-value v?)
do k key
	if index = a find-index it.a == key
		_, old-value = a[index]
		match action = f[old-value]
		as no-change
			(), old-value, ()
		as remove
			(a remove-at index), old-value, ()
		as insert
			new-node: a update-at index, (key, action.value)
			old-value: old-value
			new-value: action value
	else
		match action = f[]
		as no-change
			(), (), ()
		as remove
			(), (), ()
		as insert
			new-node (k, v) node = if a.size >= leaf-max-size
				assert hash-shift < 64 else todo # TODO: fall back to a sorted map?
				# If we get here, it's guaranteed that we don't need to recursively create leaves.
				# Just group by hash.
				a new-inner-node key, action.value, remaining-hash, hash-shift
			else
				a ~ (key, action.value)
			new-node, (), action.value

-new-inner-node[k, v] (k, v) node(a (k, v)[], key k, value v, hash nat64, hash-shift nat64) k key
	key-hash = hash low-bits
	max-hash mut = key-hash
	for k, _ in a
		max-hash max:= k.get-hash >> hash-shift low-bits
	trusted
	res (k, v) node mut-slice = max-hash + 1 n-of empty-leaf-node
	# TODO: avoid allocating the same leaf twice...
	res[key-hash] := ((key, value),)::(k, v)[] # TODO: type annotation should not be necessary ----------------------------------
	for k, v in a
		index = k.get-hash >> hash-shift low-bits
		res[index] := res[index].array! ~ (k, v)
	res.cast-immutable inner-node

+iterate[k, v] bool(a v[k], f bool mut(key k, value v)) k key
	(trusted a.unsorted map it.identity)::(k, v)[] sort it.a iterate f

~map-unsorted[k, v] record
	-inner v[k]
~unsorted[k, v] (k, v) map-unsorted(a v[k]) unsafe
	a,
~size[k, v] nat(a (k, v) map-unsorted)
	a.inner size
~iterate[k, v] bool(a (k, v) map-unsorted, f bool mut(key k, value v)) unsafe
	a.inner.root iterate-recur f
-iterate-recur[k, v] bool(a (k, v) node, f bool mut(key k, value v)) unsafe
	match a
	as frozen-map
		a iterate f
	as inner-node
		a.nodes iterate of child
			child iterate-recur f
	as array
		a iterate f

dbg[k, v] string(a v[k]) k show, v show
	a.root dbg ""
-dbg[k, v] string(a (k, v) node, path string) k show, v show
	match a
	as frozen-map
		"TODO" # -----------------------------------------------------------------------------------------------------------------------
	as inner-node
		" " join for* index, child in a.nodes with-index
			unless child node-is-empty
				- child dbg "{path}{index}"
	as array
		parts string[] = for k, v in a
			"{k} -> {v}"
		"{path}[{", " join parts}]"
