no-std
import
	../bits: &, >>
	../bool: &&, ||, bool, false, new, not, true
	../compare: <, <=, >=, equal, max
	../exception: unreachable
	../hash: get-hash, key
	../misc: loop-break, new, subscript, void
	../number: ==, <=>, +, -, nat64, next
	../option: force, is-empty, new, option
	../range: .., difference, iterate, size
	../string: interpolate, join, show, string
	../tuple: a, b, new
	../private/bootstrap: todo
	./array:
		~, ~~, ~=, ~~=, array, array-builder, array-view, build, is-empty, iterate, new, remove-at,
		size, subscript, to, update-at
	./collection:
		.., -, build, build-options, end, every, find-index, flatten, for-break, for-loop, n-of,
		subscript, with-block, with-index
	./mut-slice: ~=, build, cast-immutable, mut-slice, set-subscript, subscript

| Immutable unordered map type.
| A map is logically a collection of key-value pairs (`({k}, {v})`).
| A key can appear at most once, and given a key, you can access the associated value in O(1).
+map[k, v] record
	-root (k, v) node

+==[k, v] bool(a v[k], b v[k]) k key, v equal
	a.size == b.size && a every (k, v) =>
		if bv ?= b[k]
			bv == v

-node[k, v] union((k, v) inner-node, (k, v)[])
-inner-node[k, v] record(nodes (k, v) node[])

-empty-leaf-node[k, v] (k, v) node()
	()::(k, v)[]

-low-bits nat64(a nat64)
	a & 0b1111

-inner-node-n-bits nat64()
	4

-leaf-max-size nat64()
	8

empty-map[k, v] v[k]()
	empty-leaf-node,

| Creates a new map from the given key-value pairs.
| Later pairs overwrite earlier pairs with the same key.
+new[k, v] v[k](...a (k, v)[]) k key
	a to

| Converts a list of pairs to a map.
| Later pairs overwrite earlier pairs with the same key.
+to[k, v] v[k](a (k, v)[]) k key
	a.to to
+to[k, v] v[k](a (k, v) array-view) k key
	if a.size <= 4 && a !has-duplicate-keys
		a.to::(k, v)[],
	else
		res mut v[k] = empty-leaf-node::((k, v) node),
		for x : a
			res ~:= x
		res

| Returns all pairs in the map.
+to[k, v] (k, v)[](a v[k]) k key
	for k, v : a; k, v

| O(n^2) but it doesn't matter since n <= 4
-has-duplicate-keys[k, v] bool(a (k, v) array-view) k key
	match a size
	as 0
		true
	as 1
		true
	as 2
		a[0].a == a[1].a
	as 3
		a[0].a == a[1].a || a[0].a == a[2].a || a[1 .. end] has-duplicate-keys
	as 4
		a[0].a == a[1].a || a[0].a == a[2].a || a[0].a == a[3].a || a[1 .. end] has-duplicate-keys
	else
		throw unreachable

| {true} if `{a}.{size} == 0`
+is-empty[k, v] bool(a v[k]) k key
	a.root node-is-empty
-node-is-empty[k, v] bool(a (k, v) node)
	match a
	as inner-node _
		false
	as array x
		x is-empty

| Number of pairs.
+size[k, v] nat64(a v[k]) k key
	a.root size
-size[k, v] nat64(a (k, v) node)
	match a
	as inner-node i
		acc mut nat64 = 0
		for child : i nodes
			acc +:= child size
		acc
	as array l
		l size

| Gets the value associated with a key.
| Returns an empty option unless `{key} in {a}`.
+subscript[k, v] v?(a v[k], key k) k key
	cur mut = a root
	remaining-hash mut = key get-hash
	loop
		match cur
		as inner-node i
			which = remaining-hash low-bits
			guard which < i.nodes.size : break
			cur := i.nodes[which]
			remaining-hash >>:= inner-node-n-bits
			continue
		as array xs
			break for k, v : xs
				if k == key
					break v

| {true} if the key is in the map.
+in[k, v] bool(key k, a v[k]) k key
	!a[key].is-empty

| Associates the key with the value.
| If `{key} in {a}`, overwrites the old value. Otherwise adds a new entry.
+~[k, v] v[k](a v[k], (key k, value v)) k key
	res = a get-or-update key, _ =>
		value insert
	if node ?= res new-node
		node,
	else
		a

| Adds/updates many entries to {a}.
| Where keys match, values in {b} overwrite values in {b}. Otherwise they add new entries.
+~~[k, v] v[k](a v[k], b v[k]) k key
	res mut = a
	for pair : b
		res ~:= pair
	res

+keys[k, v] k[](a v[k]) k key
	for k, _ : a
		k

+values[k, v] v[](a v[k]) k key
	for _, v : a
		v

~got-or-added[k, v] union(v got, (k, v) added)
~got[t] record(value t)
~added[k, v] record(map v[k], value v)

| If {key} is already in {a}, returns {got} with the old value.
| Else, adds a new pair `{key}, {get-value}[]` and return {added}.
~get-or-add[k, v] (k, v) got-or-added(a v[k], key k, get-value v mut()) k key
	res = a get-or-update key, old-value =>
		if old-value is-empty
			get-value[] insert
		else
			no-change
	if v ?= res old-value
		(v,)::(v got)
	else
		((res.new-node!,), res.new-value!)::((k, v) added)

| Removes {key} and its associated value.
| If `{key} !in {a}`, returns {a} unmodified.
| If you need the old value, use {try-remove} instead.
+-[k, v] v[k](a v[k], key k) k key
	if res ?= a try-remove key
		res b
	else
		a

| Removes a key and its associated value, and returns the value and the new map.
|
| If `{key} !in {a}`, returns an empty option.
+try-remove[k, v] (v, v[k])?(a v[k], key k) k key
	res = a get-or-update key, _ => remove
	if value ?= res old-value
		value, (res.new-node!,)

-get-or-update-result[k, v] record
	# If none, don't update anything
	new-node (k, v) node?
	old-value v?
	new-value v?

-get-or-update-action[v] union(no-change, remove, v insert)
-no-change record
-remove record
-insert[t] record(value t)
-get-or-update[k, v] (k, v) get-or-update-result
	a v[k]
	key k
	f v get-or-update-action mut(old-value v?)
do k key
	hash = key get-hash
	match a root
	as inner-node _
		a.root get-or-update-recur key, hash, 0, f
	as array x
		x get-or-update-leaf key, hash, 0, f

-get-or-update-recur[k, v] (k, v) get-or-update-result
	a (k, v) node
	key k
	remaining-hash nat64
	hash-shift nat64
	f v get-or-update-action mut(old-value v?)
do k key
	match a
	as inner-node i
		which = remaining-hash low-bits
		if which < i.nodes.size
			next-hash = remaining-hash >> inner-node-n-bits
			child-res = i.nodes[which] get-or-update-recur key, next-hash, hash-shift + inner-node-n-bits, f
			if node ?= child-res new-node
				new-inner = i.nodes update-child which, node
				new-inner, child-res.old-value, child-res.new-value
			else
				child-res
		else
			match f[]
			as no-change
				(), (), ()
			as remove
				(), (), ()
			as insert ins
				new-leaf (k, v) node = ((key, ins.value),)::(k, v)[]
				new-node = i.nodes update-at-with-default which, new-leaf, empty-leaf-node
				new-node.inner-node, (), ins.value
	as array x
		x get-or-update-leaf key, remaining-hash, hash-shift, f

| Unlike for {update-at}, {index} doesn't need to be a valid index.
| If `{index} > {a}.{size}`, entries between the and of {a} and the new entries will be {default}.
-update-at-with-default[t] t[](a t[], index nat64, new-value t, default t)
	if index < a.size
		a update-at index, new-value
	else
		for i : 0::nat64 .. index + 1
			if i < a.size
				a[i]
			elif i == index
				new-value
			else
				default

-update-child[k, v] (k, v) node(a (k, v) node[], which nat64, new-child (k, v) node)
	if leaf ?= a inner-node-to-leaf which, new-child
		leaf
	elif new-child node-is-empty
		if which == a.size - 1
			new-children (k, v) node array-view = a[0 .. end - 1]
			new-children.size == 1 ? new-children[0] : new-children.to.inner-node
		else
			new-children = a update-at which, new-child
			if child ?= new-children find-only-non-empty-child
				child
			else
				new-children inner-node
	else
		a update-at which, new-child inner-node

| Returns a new node if we should change this to a leaf.
-inner-node-to-leaf[k, v] (k, v) node?(a (k, v) node[] , which nat64, new-child (k, v) node)
	total-size mut nat64 = 0
	for child-index, child : a with-index
		total-size := match child-index == which ? new-child : child
		as inner-node _
			leaf-max-size + 1
		as array x
			total-size + x.size
	if total-size <= leaf-max-size
		# TODO: if only one non-empty leaf, don't copy..
		pairs (k, v)[] = with out : total-size build
			for child-index, child : a with-index
				match child-index == which ? new-child : child
				as inner-node _
					throw unreachable
				as array x
					out ~~= x
		assert pairs.size == total-size
		pairs

-find-only-non-empty-child[k, v] (k, v) node?(children (k, v) node[])
	first-non-empty-index = children find-index! x => x !node-is-empty
	if children[first-non-empty-index + 1 .. end]::((k, v) node array-view) every it => it node-is-empty
		children[first-non-empty-index]

-get-or-update-leaf[k, v] (k, v) get-or-update-result
	a (k, v)[]
	key k
	remaining-hash nat64
	hash-shift nat64
	f v get-or-update-action mut(old-value v?)
do k key
	if index ?= a find-index (k, _) => k == key
		_, old-value = a[index]
		match f[old-value]
		as no-change
			(), old-value, ()
		as remove
			(a remove-at index)::(k, v)[], old-value, () # TODO: type annotation should not be necessary ----------------------------------
		as insert ins
			new-node = a update-at index, (key, ins.value)
			new-node, old-value, ins.value
	else
		match f[]
		as no-change
			(), (), ()
		as remove
			(), (), ()
		as insert ins
			new-node (k, v) node = if a.size >= leaf-max-size
				if hash-shift >= 64
					# We've exhausted the hash.
					# TODO: fall back to a sorted map?
					todo
				# If we get here, it's guaranteed that we don't need to recursively create leaves.
				# Just group by hash.
				a new-inner-node key, ins.value, remaining-hash, hash-shift
			else
				(a ~ (key, ins.value))::(k, v)[] # TODO: type annotation should not be necessary ----------------------------------
			new-node, (), ins.value

-new-inner-node[k, v] (k, v) node(a (k, v)[], key k, value v, hash nat64, hash-shift nat64) k key
	key-hash = hash low-bits
	max-hash mut = key-hash
	for k, _ : a
		max-hash max:= k.get-hash >> hash-shift low-bits
	trusted
		res (k, v) node mut-slice = max-hash + 1 n-of empty-leaf-node
		# TODO: avoid allocating the same leaf twice...
		res[key-hash] := ((key, value),)::(k, v)[] # TODO: type annotation should not be necessary ----------------------------------
		for k, v : a
			x = k.get-hash >> hash-shift low-bits
			res[x] := match res[x]
			as inner-node _
				throw unreachable
			as array xs
				(xs ~ (k, v))::(k, v)[] # TODO: type annotation should not be necessary ----------------------------------
		res.cast-immutable inner-node

region spec impls (see collection.crow)

+iterate[k, v] bool(a v[k], f bool mut(key k, value v))
	a.root iterate-recur f
-iterate-recur[k, v] bool(a (k, v) node, f bool mut(key k, value v))
	match a
	as inner-node i
		i.nodes iterate child =>
			child iterate-recur f
	as array x
		x iterate f

+map-builder[k, v] record mut
	-inner (k, v) array-builder
+build[k, v] v[k](a build-options, f void mut(out (k, v) map-builder)) k key
	a build (out => f[out,]) to
+~=[k, v] void(a (k, v) map-builder, pair (k, v))
	a.inner ~= pair

dbg[k, v] string(a v[k]) k show, v show
	a.root dbg ""
-dbg[k, v] string(a (k, v) node, path string) k show, v show
	match a
	as inner-node i
		parts string[][] = for index, child : i.nodes with-index
			unless child node-is-empty
				(child dbg "{path}{index}"),
		" " join parts.flatten
	as array x
		parts string[] = for k, v : x
			"{k} -> {v}"
		"{path}[{", " join parts}]"
