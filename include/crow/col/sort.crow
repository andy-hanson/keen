no-std
import
	../bool
	../compare
	../misc
	../number
	../option
	../range
	../tuple
	./array
	./collection
	./mut-slice
	./mut-array
	./util

+is-sorted[col, elem] bool(a col) (col, elem) iterate, elem compare
	is-sorted a, it.identity

+is-sorted[col, elem, key] bool(a col, f key data(x elem)) (col, elem) iterate, key compare
	prev mut key? = ()
	!exists a, of x
		key = f[x]
		wrong = p = prev and p > key
		prev := key
		wrong

| Returns the permutation that would sort {a}.
| `a[result[0]]` is the lowest value, `a[result[1]]` is the second lowest, etc.
+get-sort-permutation[t] nat64[](a t[]) t compare
	sort-by-first a, (0 .. a.size).to 'b

+apply-permutation[t] t[](a t[], permutation nat64[])
	for i in permutation then a[i]

| Sorts the elements from least to greatest.
| The result satisfies `res[i] <= res[i + 1]`.
+sort[col, elem] col
	a col
do (col, elem) list-new, (col, elem) iterate, col size, elem compare
	sort a, it.identity

| Sorts the elements comparing by the result of {get-key}.
+sort[col, elem, k] col
	a col
	get-key k mut(elem elem)
do (col, elem) list-new, (col, elem) iterate, col size, k compare
	res elem mut-slice = map a, it.identity
	res sort= get-key
	list-new trusted cast-immutable res

| Sorts and remove duplicates.
| That means `res[i] < res[i + 1]` for each element in the result.
| `(2, 1, 2) sort-unique` is `1, 2`.
+sort-unique[col, elem] col
	a col
do (col, elem) list-new, (col, elem) iterate, col size, elem compare
	sort-unique a, it.identity
+sort-unique[col, elem, k] col
	a col
	get-key k data(a elem)
do (col, elem) list-new, (col, elem) iterate, col size, k compare
	m elem mut-slice = map a, it.identity
	list-new to sort-unique-in-place m, get-key

| Sorts in-place from least to greatest.
+sort-in-place[t] void(a t mut-slice) t compare
	a sort= it.identity
+sort=[t, k] void(a t mut[], get-key k mut(elem t)) k compare
	trusted a.temp-as-mut-slice sort= get-key
+sort=[t, k] void(a t mut-slice, get-key k mut(elem t)) k compare
	a[0 .. end] sort= get-key
+sort=[t, k] void(a t mut-slice-view, get-key k mut(elem t)) k compare
	do if a.size > 4 else small-sort a, get-key

	a[0 .. a.size / 2] sort= get-key
	a[a.size / 2 .. end] sort= get-key

	# Copy the left half to avoid overwriting it
	left t[] = a[0 .. a.size / 2].to
	l mut nat64 = 0
	r mut nat64 = a.size / 2
	out mut nat64 = 0
	while l < left.size and r < a.size
		x = left[l]
		y = a[r]
		if get-key[x] <= get-key[y]
			a[out] := x
			l +:= 1
		else
			a[out] := y
			r +:= 1
		out +:= 1
	while l < left.size
		a[out] := left[l]
		out +:= 1
		l +:= 1
	while r < a.size
		a[out] := a[r]
		out +:= 1
		r +:= 1
	assert out == a.size

-small-sort[t, k] void(a t mut-slice-view, get-key k mut(elem t)) k compare
	do if a.size > 1
	for i in 2::nat64 .. a.size + 1
		move-last-into-sorted a[0 .. i], get-key
| Given that all but the last element is sorted, move the last element to where it needs to be.
-move-last-into-sorted[t, k] void(a t mut-slice-view, get-key k mut(elem t)) k compare
	if a.size > 1 and get-key[a[end - 2]] > get-key[a[end - 1]]
		swap-at a, end - 2, end - 1
		move-last-into-sorted a[0 .. end - 1], get-key

| Sorts in place and removes unique elements.
| Returns a slice of the original, which will be shorter if non-unique elements were removed.
-sort-unique-in-place[t, k] t mut-slice-view(a t mut-slice, get-key k data(x t)) k compare
	a sort= get-key[it]
	out mut nat = 0
	in_ mut nat = 0
	prev mut k? = ()
	while in_ != a.size
		x = a[in_]
		key = get-key[x]
		unless prev == key
			a[out] := x
			out +:= 1
			prev := key
		in_ +:= 1
	a[0 .. out]

| Sort {a}, and move elements of {b} in the same permutation as {a}.
| This is useful if {a} and {b} are parallel arrays,
| meaning `a[i]` and `b[i]` belong together for the same `i`.
| Every pair `a[i]` and `b[i]`, will move to `res.a[j]` and `res.b[j]` for some `j`.
~sort-by-first[t, u] (t[], u[])(a t[], b u[]) t compare
	mut-a t mut-slice = a.to
	mut-b u mut-slice = b.to
	sort-in-place-by-first mut-a[0 .. end], mut-b[0 .. end]
	trusted mut-a.cast-immutable, mut-b.cast-immutable

| Sort `a` in place, and move elements of `b` in the same permutation as `a`.
~sort-in-place-by-first[t, u] void(a t mut-slice-view, b u mut-slice-view) t compare
	assert a.size == b.size
	if a.size > 1
		swap-at a, 0, a.size / 2
		swap-at b, 0, b.size / 2
		pivot = a[0]
		new-pivot-index = (set-partition-by-first a, b, pivot, 1, a.size - 1) - 1
		swap-at a, 0, new-pivot-index
		swap-at b, 0, new-pivot-index
		sort-in-place-by-first a[0 .. new-pivot-index], b[0 .. new-pivot-index]
		sort-in-place-by-first a[new-pivot-index + 1 .. end], b[new-pivot-index + 1 .. end]

-set-partition-by-first[t, u] nat64
	a t mut-slice-view
	b u mut-slice-view
	pivot t
	left nat64
	right nat64
do t compare
	l mut = left
	r mut = right
	while l <= r
		assert r < a.size
		if a[l] < pivot
			l +:= 1
		else
			swap-at a, l, r
			swap-at b, l, r
			r -:= 1
	l
