import
	../mut-slice
	./frozen-map

+compact-map[k, v] record
	-ignore void # TODO: RM? -----------------------------------------------------------------------------------------------------
	-impl (k, v) impl

+==[k, v] bool(a (k, v) compact-map, b (k, v) compact-map) k key, v equal
	a.to-sorted-pairs == b.to-sorted-pairs
-to-sorted-pairs[k, v] (k, v)[](a (k, v) compact-map) k key
	a map it.identity sort it.a

+to[k, v] json(a (k, v) compact-map) k key, (json, k) to, (json, v) to
	a.to-sorted-pairs to

-impl[k, v] union((k, v) overlay, (k, v) frozen-map)

-overlay[k, v] record(pairs (k, v?) frozen-map, prev (k, v) impl)

+new[k, v] (k, v) compact-map() k key
	(), ()::((k, v) frozen-map)

+to[k, v] (k, v) compact-map(a (k, v)[]) k key
	(), a.to::((k, v) frozen-map)

+is-empty[k, v] bool(a (k, v) compact-map) k key
	match x = a impl
	as overlay
		false
	as frozen-map
		x is-empty

| Number of pairs.
| This is O(n) where 'n' is the result.
+size[k, v] nat64(a (k, v) compact-map) k key
	res mut nat64 = 0
	for _ in a
		res +:= 1
	res

+ ~[k, v] (k, v) compact-map(a (k, v) compact-map, (key k, value v)) k key
	a add-or-remove key, value

###
TODO
~[k, v] (k, v) compact-map(a (k, v) compact-map, b (k, v) compact-map) k key
	a ~ b.arr
###

+ ~~[k, v] (k, v) compact-map(a (k, v) compact-map, b (k, v)[]) k key
	res mut = a
	for pair in b
		res ~:= pair
	res

+ -[k, v] (k, v) compact-map(a (k, v) compact-map, key k) k key
	if key in a
		a add-or-remove key, ()
	else
		a

+subscript[k, v] v?(a (k, v) compact-map, key k) k key
	cur mut = a impl
	loop
		match x = cur
		as overlay
			if res = x.pairs[key]
				break res
			else
				cur := x prev
				continue
		as frozen-map
			break x[key]

+in[k, v] bool(key k, a (k, v) compact-map) k key
	!!a[key]

-add-or-remove[k, v] (k, v) compact-map(a (k, v) compact-map, key k, value v?) k key
	added (k, v?) frozen-map = (key, value),
	(), do (added, a.impl) merge-as-needed

-merge-as-needed[k, v] (k, v) impl(a (k, v) overlay) k key
	match x = a prev
	as overlay
		if x.pairs.size should-merge a.pairs.size
			((x.pairs merge-overlays a.pairs), x.prev) merge-as-needed
		else
			a
	as frozen-map
		if x.size should-merge a.pairs.size
			x merge-to-end a.pairs
		else
			a

-should-merge bool(prev-size nat64, overlay-size nat64)
	prev-size <= (overlay-size max 3)

-merge-overlays[k, v] (k, v?) frozen-map
	l (k, v?) frozen-map
	r (k, v?) frozen-map
do k key
	pairs (k, v?) mut-slice = with out in l.size + r.size build
		for k, vl in l
			unless k in r
				out ~= k, vl
		for x in r
			out ~= x
	trusted pairs mut-slice-to-frozen-map-promise-no-duplicates

-merge-to-end[k, v] (k, v) frozen-map
	l (k, v) frozen-map
	r (k, v?) frozen-map
do k key
	pairs (k, v) mut-slice = with out in l.size + r.size build
		for k, vl in l
			unless k in r
				out ~= k, vl
		for k, vr in r
			if vr
				out ~= k, vr
	trusted pairs mut-slice-to-frozen-map-promise-no-duplicates

region spec impls (see collection.crow)

+iterate[k, v] bool(a (k, v) compact-map, f bool mut(key k, value v)) k key
	cur mut = a impl
	seen k mut-set = ()
	loop
		match x = cur
		as overlay
			broke = x.pairs iterate of k, v
				seen try-add k and v and f[k, v]
			if broke
				break true
			else
				cur := x prev
				continue
		as frozen-map
			break x iterate of k, v
				unless k in seen
					# Don't need to add to 'seen' because this is the last node.
					f[k, v]

region test

-dbg[k, v] string(a (k, v) compact-map) k show, v show
	a.impl dbg
-dbg[k, v] string(a (k, v) impl) k show, v show
	match a
	as overlay
		parts = ", " join for k, v in a pairs
			"{k} -> {v ?show else "_"}"
		"{a.prev dbg}, [{parts}]"
	as frozen-map
		parts = ", " join for k, v in a
			"{k} -> {v}"
		"[{parts}]"

-verify void(a (nat64, string) compact-map, expected string)
	if false # TODO: this broke when I changed the hashing algorithm ------------------------------------------------------------------
		a.dbg is expected
	for k, v in a
		a[k] is v

test
	a (nat64, string) compact-map = ()
	a.is-empty is true
	a.size is 0
	a verify "[]"
	a[0] is ()

	b = a ~ (10, "10")
	b.is-empty is false
	b.size is 1
	b verify "[10 -> 10]"
	b[10] is "10"

	c = b ~~ ((15, "15"), (5, "5"), (20, "20"))
	c verify "[10 -> 10, 15 -> 15, 5 -> 5, 20 -> 20]"

	d = c ~ (11, "11")
	d verify "[10 -> 10, 15 -> 15, 5 -> 5, 20 -> 20], [11 -> 11]"

	e = d - 15
	e verify "[10 -> 10, 15 -> 15, 5 -> 5, 20 -> 20], [11 -> 11, 15 -> _]"
	e[10] is "10"
	e[11] is "11"
	e[15] is ()

	e - 15 is e
	e - 16 is e

	f = e - 10
	f verify "[10 -> 10, 15 -> 15, 5 -> 5, 20 -> 20], [11 -> 11, 15 -> _, 10 -> _]"
	f[10] is ()
	10::nat64 in f is false

	g = f ~ (10, "10b")
	g verify "[10 -> 10, 15 -> 15, 5 -> 5, 20 -> 20], [11 -> 11, 15 -> _, 10 -> 10b]"

	h = g - 11 - 12
	h verify "[10 -> 10, 15 -> 15, 5 -> 5, 20 -> 20], [15 -> _, 10 -> 10b, 11 -> _]"

	i = h ~~ ((11, "11"), (25, "25"))
	i verify "[10 -> 10b, 20 -> 20, 5 -> 5, 11 -> 11, 25 -> 25]"
