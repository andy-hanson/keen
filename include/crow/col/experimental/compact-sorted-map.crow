import
	../mut-priority-queue
	../private/sort-utils

+compact-sorted-map[k, v] record
	-impl (k, v) impl

-impl[k, v] union((k, v) overlay, (k, v)[])

# TODO: consider tracking the number of keys that are new, or change a value, or remove a value.
# We should merge more frequently if removing keys, less frequently if adding keys.
-overlay[k, v] record
	# never empty
	pairs (k, v?)[]
	prev (k, v) impl

+==[k, v] bool(a (k, v) compact-sorted-map, b (k, v) compact-sorted-map) k key, v equal
	a.to-sorted-pairs == b.to-sorted-pairs
-to-sorted-pairs[k, v] (k, v)[](a (k, v) compact-sorted-map) k key
	a.to sort it.a

+to[k, v] json(a (k, v) compact-sorted-map) k key, (json, k) to, (json, v) to
	a.to-sorted-pairs to

+list-new[k, v] (k, v) compact-sorted-map(a (k, v)[]) k key
	a to

+to[k, v] (k, v) compact-sorted-map(a (k, v)[]) k key
	- a sort it.a

+is-empty[k, v] bool(a (k, v) compact-sorted-map) k key
	match impl = a impl
	as overlay
		false
	as array
		impl is-empty

+first[k, v] (k, v)?(a (k, v) compact-sorted-map) k key
	res mut (k, v)? = ()
	cur mut = a impl
	loop
		match x = cur
		as overlay
			res first-of:= x.pairs first of k, v
				if v then k, v
			cur := x prev
			continue
		as array
			res first-of:= x first it.identity
			break res
-first-of[k, v] (k, v)?(a (k, v)?, b (k, v)?) k key
	if x, _ = a
		if y, _ = b
			if y < x then b else a
		else
			a
	else
		b

+last[k, v] (k, v)?(a (k, v) compact-sorted-map) k key
	res mut (k, v)? = ()
	cur mut = a impl
	loop
		match x = cur
		as overlay
			res last-of:= x.pairs.reverse first of k k, v v? # TODO: should not need type annotation
				if v then k, v
			cur := x prev
			continue
		as array
			res last-of:= x last
			break res
-last[t] t?(a t[])
	unless a is-empty
		a[end - 1]
-last-of[k, v] (k, v)?(a (k, v)?, b (k, v)?) k key
	if x, _ = a
		if y, _ = b
			if y > x then b else a
		else
			a
	else
		b

| Number of pairs.
| This is O(n) where 'n' is the result.
+size[k, v] nat64(a (k, v) compact-sorted-map) k key
	res mut nat64 = 0
	for _ in a
		res +:= 1
	res

+to[k, v] (k, v)[](a (k, v) compact-sorted-map) k key
	match x = a impl
	as overlay
		x merge-unconditionally
	as array
		x

+ ~[k, v] (k, v) compact-sorted-map(a (k, v) compact-sorted-map, (key k, value v)) k key
	(a.impl add-or-remove key, value),

+ ~~[k, v] (k, v) compact-sorted-map(a (k, v) compact-sorted-map, b (k, v)[]) k key
	if b is-empty
		a
	elif a is-empty
		b to
	else
		pairs (k, v?)[] = (for k, v in b then k, v) sort it.a
		(pairs, a.impl).merge-as-needed,

+ -[k, v] (k, v) compact-sorted-map(a (k, v) compact-sorted-map, key k) k key
	if a[key]
		(a.impl add-or-remove key, ()),
	else
		a

+subscript[k, v] v?(a (k, v) compact-sorted-map, key k) k key
	cur mut = a impl
	loop
		match x = cur
		as overlay
			if v = x.pairs binary-search-key key
				break v
			else
				cur := x prev
				continue
		as array
			break x binary-search-key key

-add-or-remove[k, v] (k, v) impl(a (k, v) impl, key k, value v?) k key
	(((key, value),), a) merge-as-needed

-merge-as-needed[k, v] (k, v) impl(a (k, v) overlay) k key
	match x = a prev
	as overlay
		if x.pairs.size should-merge a.pairs.size
			new-pairs = x.pairs merge-overlays a.pairs
			(new-pairs, x.prev) merge-as-needed
		else
			a
	as array
		if x.size should-merge a.pairs.size
			x merge-to-end a.pairs
		else
			a

-merge-unconditionally[k, v] (k, v)[](a (k, v) overlay) k key
	match x = a prev
	as overlay
		((x.pairs merge-overlays a.pairs), x.prev) merge-unconditionally
	as array
		x merge-to-end a.pairs

-should-merge bool(prev-size nat64, overlay-size nat64)
	prev-size <= (overlay-size max 3)

-merge-overlays[k, v] (k, v?)[](left (k, v?)[], right (k, v?)[]) k key
	with out in left.size + right.size build
		l = left begin
		r = right begin
		loop
			if lk, lv = l peek
				if rk, rv = r peek
					match lk <=> rk
					as less
						out ~= lk, lv
						_ = l take-next
					as equal
						out ~= rk, rv
						_ = l take-next
						_ = r take-next
					as greater
						out ~= rk, rv
						_ = r take-next
					continue
				else
					out ~~= l slice left.end
					break
			else
				out ~~= r slice right.end
				break

-merge-to-end[k, v] (k, v)[](left (k, v)[], right (k, v?)[]) k key
	with out in left.size + right.size build
		l = left begin
		r = right begin
		loop
			if lk, lv = l peek
				if rk, rv = r peek
					match lk <=> rk
					as less
						out ~= lk, lv
						_ = l take-next
					as equal
						out add-if-has-value (rk, rv)
						_ = l take-next
						_ = r take-next
					as greater
						out add-if-has-value (rk, rv)
						_ = r take-next
					continue
				else
					out ~~= l slice left.end
					break
			else
				for pair in r slice right.end
					out add-if-has-value pair
				break
-add-if-has-value[k, v] void(out (k, v) builder, (k k, v v?))
	if v
		out ~= k, v

| Returns an equal map that takes up less space.
+compact[k, v] (k, v) compact-sorted-map(a (k, v) compact-sorted-map) k key
	a.to to

+iterate[k, v] bool(a (k, v) compact-sorted-map, f bool mut(key k, value v)) k key
	end-node mut (k, v) array-view = ()
	# Key has an index because overlays with a lower index (rightmost) should come first
	overlays ((k, nat64), (k, v?) array-view) mut-priority-queue = with out in build
		cur mut = a impl
		overlay-index mut nat64 = 0
		end-node := loop
			match x = cur
			as overlay
				k, _ = x.pairs[0]
				out ~= (k, overlay-index), x.pairs.to
				cur := x prev
				overlay-index +:= 1
				continue
			as array
				break x to
	res = overlays iterate-overlays of k, v
		res bool = loop
			if end-node is-empty
				break false
			else
				ek, ev = end-node[0]
				match ek <=> k
				as less
					if f[ek, ev]
						break true
					else
						end-node := end-node[1 .. end]
						continue
				as equal
					end-node := end-node[1 .. end]
					break false
				as greater
					break false
		if res
			true
		elif v
			f[k, v]
	res or end-node iterate f

-iterate-overlays[k, v] bool
	overlays ((k, nat64), (k, v?) array-view) mut-priority-queue
	f bool mut(key k, value v?)
do k key
	loop
		guard popped = overlays pop else break false
		(key, _), rest = popped
		overlays drop-overlays-with-key key
		overlays maybe-add-back popped
		guard rest !is-empty else continue
		if f[key, rest[0].b]
			break true
		else
			continue

-maybe-add-back[k, v] void
	overlays ((k, nat64), (k, v?) array-view) mut-priority-queue
	last-popped ((k, nat64), (k, v?) array-view)
do k key
	(_, order), rest = last-popped
	if rest.size > 1
		overlays ~= (rest[1].a, order), rest[1 .. end]

-drop-overlays-with-key[k, v] void
	overlays ((k, nat64), (k, v?) array-view) mut-priority-queue
	key k
do k key
	# TODO: use 'drop-while'
	if (k, _), _ = overlays peek
		if k == key
			overlays maybe-add-back overlays.pop!

-get-end[k, v] (k, v)[](a (k, v) impl)
	match a
	as overlay
		a.prev get-end
	as array
		a

region test

-dbg[k, v] string(a (k, v) compact-sorted-map) k show, v show
	a.impl dbg
-dbg[k, v] string(a (k, v) impl) k show, v show
	match a
	as overlay
		pairs = ", " join for k, v in a pairs
			"{k} -> {v ?show else "_"}"
		"{a.prev dbg}, [{pairs}]"
	as array
		pairs = ", " join for k, v in a
			"{k} -> {v}"
		"[{pairs}]"

-verify void(a (nat64, string) compact-sorted-map, expected string)
	a.dbg is expected

test
	a (nat64, string) compact-sorted-map = ()
	a.is-empty is true
	a.size is 0
	a verify "[]"
	a[10] is ()
	a.first is ()
	a.last is ()

	b = a ~ (10, "10")
	b verify "[10 -> 10]"
	b[10] is "10"
	b.first is (10, "10")
	b.last is (10, "10")

	c = b ~~ ((15, "15"), (5, "5"), (20, "20"))
	c verify "[5 -> 5, 10 -> 10, 15 -> 15, 20 -> 20]"
	c.first is (5, "5")
	c.last is (20, "20")

	d = c ~ (11, "11")
	d verify "[5 -> 5, 10 -> 10, 15 -> 15, 20 -> 20], [11 -> 11]"

	e = d - 15
	e verify "[5 -> 5, 10 -> 10, 15 -> 15, 20 -> 20], [11 -> 11, 15 -> _]"

	e - 15 is e
	e - 16 is e

	f = e - 10
	f verify "[5 -> 5, 10 -> 10, 15 -> 15, 20 -> 20], [10 -> _, 11 -> 11, 15 -> _]"

	g = f ~ (10, "10b")
	g verify "[5 -> 5, 10 -> 10, 15 -> 15, 20 -> 20], [10 -> 10b, 11 -> 11, 15 -> _]"

	h = g - 11 - 12
	# Unfortunately we leave an unnecessary '11 -> _',
	# because we don't keep track of what a removal removes from,
	# and it might be removing from the leftmost node.
	h verify "[5 -> 5, 10 -> 10, 15 -> 15, 20 -> 20], [10 -> 10b, 11 -> _, 15 -> _]"
	h.first is (5, "5")
	h.last is (20, "20")

	i = h ~~ ((11, "11"), (25, "25"))
	i verify "[5 -> 5, 10 -> 10b, 11 -> 11, 20 -> 20, 25 -> 25]"

	", " join (for k, v in h then "{k} -> {v}") is "5 -> 5, 10 -> 10b, 20 -> 20"

	h-mapped (nat64, string) compact-sorted-map = for k, v in h then k, "{v}!"
	h-mapped verify "[5 -> 5!, 10 -> 10b!, 20 -> 20!]"

test
	a (nat64, string) compact-sorted-map = (84, "84"),
	b = a ~ (84, "84b")
	b verify "[84 -> 84b]"
