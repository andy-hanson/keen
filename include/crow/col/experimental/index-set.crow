use-prefix
import
	../../bits

+index-set record
	# This is one more than the highest number that would currently fit in the tree.
	-capacity nat64
	-root node

-node union(inner-node, leaf-node, empty)
# TODO: could save space by having separate types for inner node of inner nodes
# and inner node of leaf-node?
-inner-node record(a node, b node, c node, d node)
-leaf-node record(a nat64, b nat64, c nat64, d nat64) # TODO:PERF would probably be better to just use an array -------------------------------
-empty record
-== bool(a empty, b empty)

-subscript nat64(a leaf-node, n nat64)
	a.values[n]

-values nat64[](a leaf-node)
	a.a, a.b, a.c, a.d
-bits-in-leaf-node nat64()
	# 64 * 4
	256

+list-new index-set(a nat64[])
	a.to
+to index-set(a nat64[])
	res mut index-set = 0, empty
	for x in a
		res ~:= x
	res

+== bool(a index-set, b index-set)
-== bool(a node, b node)
-== bool(a inner-node, b inner-node)
-== bool(a leaf-node, b leaf-node)

+is-empty bool(a index-set)
	a.capacity == 0
-is-empty bool(a node)
	match a
	as inner-node
		false
	as leaf-node
		false
	as empty
		true

| This is O(n) where 'n' is the result.
+size nat64(a index-set)
	size-recur 0, a.root
-size-recur nat64(acc nat64, a node)
	match a
	as inner-node
		acc 'size-recur a.a 'size-recur a.b 'size-recur a.c 'size-recur a.d
	as leaf-node
		acc + a.a.count-ones + a.b.count-ones + a.c.count-ones + a.d.count-ones
	as empty
		acc

+to nat64[](a index-set)
	map a, it.identity

+subscript bool(a index-set, index nat64)
	index < a.capacity and contains a.root, index, a.capacity
| {n}: capacity of this node
-contains bool(a node, index nat64, n nat64)
	assert index < n
	match a
	as inner-node
		assert n > bits-in-leaf-node
		half = n / 2
		quarter = half / 2
		if index < half
			if index < quarter
				contains a.a, index, quarter
			else
				contains a.b, index - quarter, quarter
		else
			index2 = index - half
			if index2 < quarter
				contains a.c, index2, quarter
			else
				contains a.d, index2 - quarter, quarter
	as leaf-node
		assert n == bits-in-leaf-node
		a[word-index index] 'has-bit index.bit-index
	as empty
		false

+ ~ index-set(a index-set, index nat64)
	try-add a, index else a

-quadruple-capacity index-set(a index-set)
	if a.capacity == 0
		bits-in-leaf-node, empty-leaf-node
	else
		a.capacity * 4, (a.root, empty, empty, empty)::inner-node

-empty-inner-node inner-node()
	empty, empty, empty, empty
-empty-leaf-node leaf-node()
	0, 0, 0, 0

+try-add index-set?(a index-set, index nat64)
	if index >= a.capacity
		try-add a.quadruple-capacity, index
	elif res = try-add a.root, index, a.capacity
		capacity: a.capacity, root: res
-try-add node?(a node, index nat64, n nat64)
	assert index < n
	match a
	as inner-node
		try-add a, index, n
	as leaf-node
		try-add a, index, n
	as empty
		try-add-to-empty-node index, n
-try-add node?(i inner-node, index nat64, n nat64)
	assert n > bits-in-leaf-node
	half = n / 2
	quarter = half / 2
	if index < half
		if index < quarter
			if res = try-add i.a, index, quarter
				with-a i, res
		else
			if res = try-add i.b, index - quarter, quarter
				with-b i, res
	else
		index2 = index - half
		if index2 < quarter
			if res = try-add i.c, index2, quarter
				with-c i, res
		else
			if res = try-add i.d, index2 - quarter, quarter
				with-d i, res
-try-add node?(l leaf-node, index nat64, n nat64)
	assert n == bits-in-leaf-node
	word-index = word-index index
	bit-index = bit-index index
	word = l[word-index]
	new-word = add-bit word, bit-index
	unless new-word == word
		update-leaf l, word-index, new-word
-try-add-to-empty-node node?(index nat64, n nat64) # TODO: INLINE -----------------------------------------------------------
	new-node node = if n == bits-in-leaf-node then empty-leaf-node else empty-inner-node
	try-add new-node, index, n

+ ~~ index-set(a index-set, indices nat64[])
	res mut = a
	for index in indices
		res ~:= index
	res

+ - index-set(a index-set, index nat64)
	try-remove a, index else a

+try-remove index-set?(a index-set, index nat64)
	if index < a.capacity
		if removed = try-remove a.root, index, a.capacity
			simplify-after-remove-or-filter removed, a.capacity
-try-remove node?(a node, index nat64, n nat64)
	assert index < n
	match a
	as inner-node
		assert n > bits-in-leaf-node
		half = n / 2
		quarter = half / 2
		new-node inner-node? = if index < half
			if index < quarter
				if res = try-remove a.a, index, quarter
					with-a a, res
			else
				if res = try-remove a.b, index - quarter, quarter
					with-b a, res
		else
			index2 = index - half
			if index2 < quarter
				if res = try-remove a.c, index2, quarter
					with-c a, res
			else
				if res = try-remove a.d, index2 - quarter, quarter
					with-d a, res
		if new-node
			if is-all-empty new-node
				empty
			else
				new-node
	as leaf-node
		assert n == bits-in-leaf-node
		word-index = word-index index
		bit-index = bit-index index
		word = a[word-index]
		new-word = sub-bit word, bit-index
		unless new-word == word
			if new-word == 0
				empty
			else
				update-leaf a, word-index, new-word
	as empty
		()
-simplify-after-remove-or-filter index-set(node node, capacity nat64)
	match node
	as inner-node
		if is-empty node.b and is-empty node.c and is-empty node.d
			forbid is-empty node.a
			simplify-after-remove-or-filter node.a, capacity / 4
		else
			capacity, node
	as leaf-node
		assert capacity == bits-in-leaf-node
		forbid node.a == 0 and node.b == 0 and node.c == 0 and node.d == 0
		capacity, node
	as empty
		0, empty

-is-all-empty bool(a inner-node)
	is-empty a.a and is-empty a.b and is-empty a.c and is-empty a.d

# TODO:MOVE
-with-a inner-node(a inner-node, new-a node)
	new-a, a.b, a.c, a.d
-with-b inner-node(a inner-node, new-b node)
	a.a, new-b, a.c, a.d
-with-c inner-node(a inner-node, new-c node)
	a.a, a.b, new-c, a.d
-with-d inner-node(a inner-node, new-d node)
	a.a, a.b, a.c, new-d

-update-leaf leaf-node(a leaf-node, word-index nat64, new-word nat64)
	match word-index
	as 0
		new-word, a.b, a.c, a.d
	as 1
		a.a, new-word, a.c, a.d
	as 2
		a.a, a.b, new-word, a.d
	as 3
		a.a, a.b, a.c, new-word
	else
		throw unreachable

###
# TODO: ~ index-set(a index-set, b index-set)

intersect index-set(a index-set, b index-set)
	strip-trailing-zeroes: a.values zip-smaller b.values, of x, y
		x & y

- index-set(a index-set, b index-set)
	strip-trailing-zeroes: a.values zip-larger b.values, of x, y
		(x else 0) & ~(y else 0)

-strip-trailing-zeroes index-set(a nat64 array)
	index-set: void, a.strip-trailing-zeroes
-strip-trailing-zeroes nat64 array(a nat64 array)
	if last = a last
		if last == 0
			a.rtail strip-trailing-zeroes
		else
			a
###

| Number of values in that are in both {a} and {range}.
+count nat64(a index-set, range nat64 range)
	count-range a.root, a.capacity, range.low, range.size
-count-range nat64(a node, n nat64, low nat64, len nat64)
	if low <= n
		match a
		as inner-node
			assert n > bits-in-leaf-node
			half = n / 2
			quarter = half / 2
			three-quarters = quarter + half
			# If low < quarter, wrap-sub will give an impossibly high value
			# and the recursive call will return 0.
			ca = count-range a.a, quarter, low, len
			cb = count-range a.b, quarter, (low 'wrap-sub quarter), len
			cc = count-range a.c, quarter, (low 'wrap-sub half), len
			cd = count-range a.d, quarter, (low 'wrap-sub three-quarters), len
			ca + cb + cc + cd
		as leaf-node
			assert n == bits-in-leaf-node
			high = min low + len, (bits-in-leaf-node - 1)
			low-word-index = word-index low
			high-word-index = word-index high
			low-bit-index = bit-index low
			high-bit-index = bit-index high
			if low-word-index == high-word-index
				count-range-in-nat64 a[low-word-index], low-bit-index, high-bit-index
			else
				first-word = count-gte-in-nat64 a[low-word-index], low-bit-index
				mid-words = count-ones-in-array a.values[low-word-index + 1 .. high-word-index]
				last-word = count-less-in-nat64 a[high-word-index], high-bit-index
				first-word + mid-words + last-word
		as empty
			0

| Number of values in {a} that are >= {n}.
+count-greater-or-equal nat64(a index-set, n nat64)
	count a, n .. max-value

-count-range-in-nat64 nat64(a nat64, low-bit-index nat64, high-bit-index nat64)
	count-less-in-nat64 a >> low-bit-index, high-bit-index - low-bit-index

-count-less-in-nat64 nat64(a nat64, bit-index nat64)
	count-ones a << (64 - bit-index)

-count-gte-in-nat64 nat64(a nat64, bit-index nat64)
	count-ones a >> bit-index

-count-ones-in-array nat64(a nat64 array-view)
	res mut nat64 = 0
	for x in a
		res +:= count-ones x
	res

| Gets the set with only values < {limit}
+filter-less index-set(a index-set, limit nat64)
	if limit < a.capacity
		simplify-after-remove-or-filter (filter-less-recur a.root, a.capacity, limit), a.capacity
	else
		a
-filter-less-recur node(a node, n nat64, limit nat64)
	match a
	as inner-node
		assert n > bits-in-leaf-node
		half = n / 2
		quarter = half / 2
		new-a = filter-less-recur a.a, quarter, limit, 0
		new-b = filter-less-recur a.b, quarter, limit, 0x40
		new-c = filter-less-recur a.c, quarter, limit, 0x80
		new-d = filter-less-recur a.c, quarter, limit, 0xc0
		new-node inner-node = new-a, new-b, new-c, new-d
		if is-all-empty new-node then empty else new-node
	as leaf-node
		assert n == bits-in-leaf-node
		new-a = filter-less-word a.a, limit, 0
		new-b = filter-less-word a.b, limit, 0x40
		new-c = filter-less-word a.c, limit, 0x80
		new-d = filter-less-word a.d, limit, 0xc0
		(new-a, new-b, new-c, new-d)::leaf-node
	as empty
		empty
-filter-less-recur node(a node, n nat64, limit nat64, offset nat64)
	if limit < offset
		empty
	elif limit > offset + n
		a
	else
		filter-less-recur a, n, limit - offset

-filter-less-word nat64(a nat64, limit nat64, offset nat64)
	if limit >= offset
		if limit > offset + 64
			a
		else
			a & (low-n-bits limit - offset)

-word-index nat64(a nat64)
	a / 64
-bit-index nat64(a nat64)
	a % 64

+show string(a index-set)
	join ", ", map a, it.show

+iterate bool(a index-set, f bool mut(elem nat64))
	iterate-recur a.root, 0, a.capacity, f
| {offset}: how much to add to indices in this node
-iterate-recur bool(node node, offset nat64, n nat64, f bool mut(elem nat64))
	match node
	as inner-node
		half = n / 2
		quarter = half / 2
		three-quarters = half + quarter
		if iterate-recur node.a, offset, quarter, f
			true
		elif iterate-recur node.b, offset + quarter, quarter, f
			true
		elif iterate-recur node.c, offset + half, quarter, f
			true
		else
			iterate-recur node.d, offset + three-quarters, quarter, f
	as leaf-node
		word-index mut nat64 = 0
		iterate node.values, of value
			bit-index-offset = offset + word-index * 64
			word-index +:= 1
			iterate value.one-bits, of bit-index
				f[bit-index-offset + bit-index]
	as empty
		false

~dbg string(a index-set)
	dbg a.root
-dbg string(a node)
	match a
	as inner-node
		"({dbg a.a} {dbg a.b} {dbg a.c} {dbg a.d})"
	as leaf-node
		"[{to-hex a.a} {to-hex a.b} {to-hex a.c} {to-hex a.d}]"
	as empty
		"_"
