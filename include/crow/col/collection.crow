no-std
import
	../bool
	../compare
	../misc
	../number
	../option
	../private/bootstrap: array, exception, string
	../private/range-low-level
	../tuple
export
	./private/build

+index-too-big record(actual nat64, maximum nat64) exception case
+show string(_ index-too-big)
	"The index is bigger than the collection's size"

| Exception when attempting to mutate a collection that is being iterated
+was-locked record exception case
+show string(_ was-locked)
	"Collection cannot be modified while it is locked."

| Exception when attempting to skip too far forward or backward
+iterator-out-of-bounds record exception case
+show string(_ iterator-out-of-bounds)
	"Iterator out of bounds"
| Exception thrown when trying to {slice}
| but the first iterator is not to the right of the second iterator.
+slice-right-to-left record exception case
+show string(_ slice-right-to-left)
	"Iterators for slice were in the wrong order"

| Some iterator operations like {slice} require two iterators to be for the same collection.
+iterator-not-comparable record exception case
+show string(_ iterator-not-comparable)
	"Iterators are for different collections and can't be compared."

+is-empty[t] spec
	is-empty bool(a t)
+size[t] spec
	size nat64(a t)

+iterate[col, elem] spec
	iterate bool(a col, f bool mut(elem elem))
+iterate-reverse[col, elem] spec
	iterate-reverse bool(a col, f bool mut(elem elem))

+begin[iter, col] spec
	begin iter(a col)
+end[iter, col] spec
	end iter(a col)
+begin-end[iter, col] spec (iter, col) begin, (iter, col) end
+collection[col, iter] spec
	collection col(a iter)

+take-prev[elem, iter] spec
	take-prev elem(a iter)
+take-next[elem, iter] spec
	take-next elem(a iter)
+take-prev-next[elem, iter] spec (elem, iter) take-prev, (elem, iter) take-next
+peek[elem, iter] spec
	peek elem?(a iter)
+peek-prev[elem, iter] spec
	peek-prev elem?(a iter)
+skip-next-n[iter] spec
	skip-next-n void(a iter, n nat)
+skip-prev-n[iter] spec
	skip-prev-n void(a iter, n nat)

+basic-iter[col, iter, elem] spec (col, elem) iterate, col size, (iter, col) begin, iter copy, (elem, iter) take-next
+basic-reverse-iter[col, iter, elem] spec (col, elem) iterate-reverse, col size, (iter, col) end, iter copy, (elem, iter) take-prev

+try-take-prev[elem, iter] elem?(a iter) (elem, iter) take-prev
	try
		a take-prev
	catch iterator-out-of-bounds
		()
+try-take-next[elem, iter] elem?(a iter) (elem, iter) take-next
	try
		a take-next
	catch iterator-out-of-bounds
		()

+set-prev[iter, elem] spec
	set-prev void(a iter, value elem)
+set-next[iter, elem] spec
	set-next void(a iter, value elem)
+set-prev-next[iter, elem] spec (iter, elem) set-prev, (iter, elem) set-next

+slice[out, iter] spec
	slice out(begin iter, end iter)
+slice-out-of-order record exception case
+show string(_ slice-out-of-order)
	"Tried to slice from a later iterator to an earlier one."

+skip-prev[iter] spec
	- iter(a iter, n nat64)
+skip-next[iter] spec
	+ iter(a iter, n nat64)
+skip-prev-next[iter] spec iter skip-prev, iter skip-next

| Represents an index relative to the size of a collection.
+index-relative-to-end record(subtract nat64)
+end index-relative-to-end()
	0,
~to-index[col] nat64(a col, index index-relative-to-end) col size
	a.size - index.subtract

+- index-relative-to-end(a index-relative-to-end, n nat64)
	a.subtract + n,

+at-index[col, elem] spec
	subscript elem(a col, index nat64)
+set-at-index[col, elem] spec
	set-subscript void(a col, index nat64, value elem)

+subscript[col, elem] elem(a col, index index-relative-to-end) (col, elem) at-index, col size
	a[a to-index index]

+set-subscript[col, elem] void
	a col
	index index-relative-to-end
	value elem
do (col, elem) set-at-index, col size
	a[(a to-index index)] := value

+range-relative-to-end record(low nat64, high index-relative-to-end)

+.. range-relative-to-end(low nat64, high index-relative-to-end)
	low, high

+to-range nat64 range(a range-relative-to-end, size nat64)
	assert a.low <= size else a.low index-too-big size
	assert a.high.subtract <= size else a.high.subtract index-too-big size
	high = size - a.high.subtract
	assert a.low <= high
	a.low .. high

+subscript-range[out-col, in-col] spec
	subscript out-col(a in-col, range nat64 range)

+subscript[out-col, in-col] out-col
	a in-col
	indices range-relative-to-end
do in-col size, (out-col, in-col) subscript-range
	a[indices to-range a.size]

+slice-left[out-col, in-col, iter] out-col
	a iter
do (in-col, iter) collection, (iter, in-col) begin, (out-col, iter) slice
	a.collection.begin slice a
+slice-right[out-col, in-col, iter] out-col
	a iter
do (in-col, iter) collection, (iter, in-col) end, (out-col, iter) slice
	a slice a.collection.end

region 'for' loops

| Calls {f} for each element in the collection and returns nothing.
+for-loop[col, elem] void(a col, f void mut(elem elem)) (col, elem) iterate
	res = a iterate of x
		f[x]
		false
	forbid res

| Like `for-loop`, but {f} must return an array of outputs which are all added to the result.
+for-star[out-col, out-elem, out-builder, in-col, in-elem] out-col
	xs in-col
	f out-elem[] mut(elem in-elem)
do (out-col, out-elem, out-builder) build-in-chunks, (in-col, in-elem) iterate
	(0,) build of out
		_ = xs iterate of x
			out ~~= f[x]
			false

| Calls {f} for each element in the input collection
| and returns an output collection of the results of {f}.
+for-loop[out-col, out-elem, out-builder, in-col, in-elem] out-col
	col in-col
	f out-elem mut(elem in-elem)
do (out-col, out-elem, out-builder) build, (in-col, in-elem) iterate, in-col size
	(col.size,) build of out
		_ = col iterate of x
			out ~= f[x]
			false

| Same as {for-loop}.
| For good style, use this only with an `it` lambda.
| `xs map it.abs` is OK, but instead of `xs map of x ...`, prefer `for x in xs ...`
+map[out-col, out-elem, out-builder, in-col, in-elem] out-col
	col in-col
	f out-elem mut(elem in-elem)
do (out-col, out-elem, out-builder) build, (in-col, in-elem) iterate, in-col size
	(col.size,) build of out
		_ = col iterate of x
			out ~= f[x]
			false

+map-values[out-col, out-value, out-builder, in-col, in-value, key] out-col
	col in-col
	f out-value mut(value in-value)
do (out-col, (key, out-value), out-builder) build, (in-col, (key, in-value)) iterate, in-col size
	col map of k, v
		k, f[v]

| Calls {f} for each element in the input collection,
| and returns an output collection of the elements for which {f} returned {true}.
+filter[out-col, elem, out-builder, in-col] out-col
	col in-col
	f bool mut(elem elem)
do (out-col, elem, out-builder) build, (in-col, elem) iterate
	with out in build
		for x in col
			if f[x]
				out ~= x

~sequence-equal[col, iter, elem] bool
	a col
	b col
do col size, (iter, col) begin, (elem, iter) take-next, elem equal
	guard a.size == b.size
	ai = a begin
	bi = b begin
	res = 0 .. a.size every of _
		ax = ai take-next
		bx = bi take-next
		ax == bx
	forbid _ ?= ai try-take-next
	forbid _ ?= bi try-take-next
	res

~sequence-compare[col, iter, elem] comparison
	a col
	b col
do (iter, col) begin, (elem, iter) take-next, elem compare
	ai = a begin
	bi = b begin
	loop
		guard ax ?= ai try-take-next else
			break if _ ?= bi try-take-next then less else equal
		guard bx ?= bi try-take-next else
			break greater
		res = ax <=> bx
		if res == equal then continue else break res

+starts-with[col, iter, elem] bool(a col, b col) (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	a.begin try-take-all b

+ends-with[col, iter, elem] bool(a col, b col) (col, iter, elem) basic-reverse-iter, iter skip-prev-n, elem equal
	a.end try-take-all-prev b

+try-remove-start[out-col, in-col, in-iter, in-elem] out-col?
	a in-col
	start in-col
do (in-col, in-iter, in-elem) basic-iter, (in-iter, in-col) end, in-iter skip-next-n, (out-col, in-iter) slice, in-elem equal
	iter = a begin
	if iter try-take-all start
		iter slice a.end
+try-remove-end[out-col, in-col, in-iter, in-elem] out-col?
	a in-col
	end in-col
do (in-col, in-iter, in-elem) basic-reverse-iter, (in-iter, in-col) begin, in-iter skip-prev-n, (out-col, in-iter) slice, in-elem equal
	iter = a end
	if iter try-take-all-prev end
		a.begin slice iter

| Removes all occurrences of {b} from the front of {a}.
+strip-left[col, iter, elem] col
	a col
	b col
do (col, iter, elem) basic-iter, (iter, col) end, iter skip-next-n, (col, iter) slice, elem equal
	if x ?= a try-remove-start b
		x strip-left b
	else
		a
| Removes all occurrences of {b} from the end of {a}.
+strip-right[col, iter, elem] col
	a col
	b col
do (col, iter, elem) basic-reverse-iter, (iter, col) begin, iter skip-prev-n, (col, iter) slice, elem equal
	if x ?= a try-remove-end b
		x strip-right b
	else
		a

| If the next elements in {a} all match {start}, skips them all and returns true.
| Otherwise, does nothing and returns false.
~try-take-all[col, iter, elem] bool
	a iter
	start col
do (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	copy = a copy
	stopped = start iterate of x
		try value = copy take-next catch iterator-out-of-bounds then true
		value != x
	unless stopped
		a skip-next-n start.size
		true
~try-take-all-prev[col, iter, elem] bool
	a iter
	end col
do (col, iter, elem) basic-reverse-iter, iter skip-prev-n, elem equal
	copy = a copy
	stopped = end iterate-reverse of x
		try value = copy take-prev catch iterator-out-of-bounds then true
		value != x
	unless stopped
		a skip-prev-n end.size
		true

| {true} if {b} is contained in {a}.
|
| That means: The elements in {b} appear in {a}, in order, without interruptions.
+contains-seq[col, iter, elem] bool(a col, b col) (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	_ ?= a iters-of-seq b

| Finds the first appearance of {b} in {a},
| and returns slices of {a} to the left and right of that.
|
| Returns an empty option if {b} is not a subsequence of {a}.
+try-split-once[out-col, in-col, in-iter, in-elem] (out-col, out-col)?
	a in-col
	b in-col
do (in-iter, in-col) end, (in-col, in-iter, in-elem) basic-iter, in-iter skip-next-n, (out-col, in-iter) slice, in-elem equal
	if l, r ?= a iters-of-seq b
		- a.begin slice l
		- r slice a.end

+try-split-once-right[out-col, in-col, in-iter, in-elem] (out-col, out-col)?
	a in-col
	b in-col
do (in-iter, in-col) begin, (in-col, in-iter, in-elem) basic-reverse-iter, in-iter skip-prev-n, (out-col, in-iter) slice, in-elem equal
	if l, r ?= a iters-of-seq-right b
		- a.begin slice l
		- r slice a.end

| Tries to find a subsequence {b} within {a}. If so, returns an iterator before and after {b}.
~iters-of-seq[col, iter, elem] (iter, iter)?
	a col
	b col
do (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	iter = a begin
	loop
		before = iter copy
		if iter try-take-all b
			break before, iter
		elif _ ?= iter try-take-next
			continue
		else
			break

-iters-of-seq-right[col, iter, elem] (iter, iter)?
	a col
	b col
do (col, iter, elem) basic-reverse-iter, iter skip-prev-n, elem equal
	iter = a end
	loop
		before = iter copy
		if iter try-take-all-prev b
			break iter, before
		elif _ ?= iter try-take-prev
			continue
		else
			break

| Returns the first non-empty result of {f}.
+first[out, col, elem] out?(a col, f out? mut(elem elem)) (col, elem) iterate
	res mut out? = ()
	_ = a iterate of x
		res := f[x]
		_ ?= res
	res

| Returns the first element for which {f} returns {true},
| or an empty option if {f} always returned {false}.
+find[col, elem] elem?(a col, f bool mut(elem elem)) (col, elem) iterate
	res mut elem? = ()
	_ = a iterate of x
		if f[x]
			res := x
			true
	res

| Returns the first index `i` for which `{f}[{a}[i]]` is true.
| Returns an empty option if {f} returned {false} for every element of {a}.
+find-index[col, elem] nat64?(a col, f bool mut(elem elem)) (col, elem) iterate
	a.with-index first of i, x
		if f[x] then i

+find-last-iter[col, iter, elem] iter?
	a col
	f bool mut(elem elem)
do (iter, col) end, (elem, iter) take-prev
	iter = a end
	loop
		guard x ?= iter try-take-prev else break
		# TODO: parse 'if f[x] then break iter else continue'
		if f[x]
			break iter
		else
			continue

+last-iter-of[col, iter, elem] iter?
	a col
	value elem
do (iter, col) end, (elem, iter) take-prev, elem equal
	a find-last-iter it == value

| If {search-value} is in {a}, return its index.
+index-of[col, elem] nat64?(a col, search-value elem) (col, elem) iterate, elem equal
	a find-index it == search-value
+last-index-of[col, elem] nat64?(a col, search-value elem) col size, (col, elem) at-index, elem equal
	i mut = a size
	loop
		guard i != 0 else break
		i -:= 1
		if a[i] == search-value
			break i
		else
			continue

| Equivalent to `f[a[0]] or f[a[1]] or ... or f[a[end - 1]]`
|
| Calls {f} on each element of {a} and returns {true} the first time {f} does.
| Returns {false} if {f} returned {false} every time.
+exists[col, elem] bool(a col, f bool mut(elem elem)) (col, elem) iterate
	a iterate f

| Equivalent to `f[a[0]] and f[a[1]] and ... and f[a[end - 1]]`.
|
| Calls {f} on each element of {a} and returns {false} the fist time {f} does.
| Returns {true} if {f} returned {true} every time.
+every[col, elem] bool(a col, f bool mut(elem elem)) (col, elem) iterate
	a !iterate !f[it]

+concatenate[t] spec
	~~ t(a t, b t)

+flatten[col, col-col] col(a col-col) (col-col, col) iterate, col concatenate, col new
	res mut col = ()
	for x in a
		res ~~:= x
	res

| Concatenate {n} copies of {a}.
+repeat[col] col(a col, n nat64) col concatenate, col new
	res mut col = ()
	for _ nat64 in 0 .. n
		res ~~:= a
	res

+n-of[col, elem, builder] col(n nat64, value elem) (col, elem, builder) build
	for _ nat64 in 0 .. n
		value

region with-index

+indices[col] nat64 range(a col) col size
	0 .. a.size

+with-index[col] record(inner col)
+first[out, col, elem] out?(a col with-index, f out? mut(index nat64, elem elem)) (col, elem) iterate
	i mut nat64 = 0
	res mut out? = ()
	_ = a.inner iterate of x
		res := f[i, x]
		i +:= 1
		_ ?= res
	res
+for-loop[col, elem] void(a col with-index, f void mut(index nat64, elem elem)) (col, elem) iterate
	i mut nat64 = 0
	_ = a.inner iterate of x
		f[i, x]
		i +:= 1
		false
+for-loop[out-col, out-elem, out-builder, in-col, in-elem] out-col
	a in-col with-index
	f out-elem mut(index nat64, elem in-elem)
do (out-col, out-elem, out-builder) build, (in-col, in-elem) iterate, in-col size
	(a.inner.size,) build of out
		i mut nat64 = 0
		for x in a inner
			out ~= f[i, x]
			i +:= 1
+for-star[out-col, out-elem, out-builder, in-col, in-elem] out-col
	a in-col with-index
	f out-elem[] mut(index nat64, elem in-elem)
do (out-col, out-elem, out-builder) build-in-chunks, (in-col, in-elem) iterate
	(0,) build of out
		i mut nat64 = 0
		for x in a inner
			out ~~= f[i, x]
			i +:= 1
+exists[col, elem] bool(a col with-index, f bool mut(index nat64, elem elem)) (col, elem) iterate
	i mut nat64 = 0
	a.inner iterate of x
		res = f[i, x]
		i +:= 1
		res
+every[col, elem] bool(a col with-index, f bool mut(index nat64, elem elem)) (col, elem) iterate
	a !exists !f[it]

| Only returns a result if {f} returned a non-empty option every time.
+map-every[out-col, out-elem, out-builder, in-col, in-elem] out-col?
	a in-col
	f out-elem? mut(x in-elem)
do (out-col, out-elem, out-builder) build, in-col size, (in-col, in-elem) iterate
	ok mut = false
	res out-col = with out in a.size build
		ok := a !iterate of x
			if y ?= f[x]
				out ~= y
				false
			else
				true
	if ok then res

+max[col, elem] elem?(a col) (col, elem) iterate, elem compare
	a max-by it.identity
+max-of[col, elem, key] key?(a col, f key mut(x elem)) (col, elem) iterate, key compare
	guard x ?= a min-and-max-by f
	x.keys max
+max-by[col, elem, key] elem?(a col, f key mut(x elem)) (col, elem) iterate, key compare
	guard x ?= a min-and-max-by f
	x.elems max

+min[col, elem] elem?(a col) (col, elem) iterate, elem compare
	a min-by it.identity
+min-of[col, elem, key] key?(a col, f key mut(x elem)) (col, elem) iterate, key compare
	guard x ?= a min-and-max-by f
	x.keys min
+min-by[col, elem, key] elem?(a col, f key mut(x elem)) (col, elem) iterate, key compare
	guard x ?= a min-and-max-by f
	x.elems min

+min-and-max[col, elem] elem min-and-max?(a col) (col, elem) iterate, elem compare
	a min-and-max-by it.identity ?elems

+min-and-max-by[elem, key] record(elems elem min-and-max, keys key min-and-max)
+==[elem, key] bool
	a (elem, key) min-and-max-by
	b (elem, key) min-and-max-by
do elem equal, key equal
+min-and-max-by[col, elem, key] (elem, key) min-and-max-by?
	a col
	f key mut(x elem)
do (col, elem) iterate, key compare
	min-elem mut elem? = ()
	min-key mut key? = ()
	max-elem mut elem? = ()
	max-key mut key? = ()
	for x in a
		key = f[x]
		if cur-min-key ?= min-key
			if key < cur-min-key
				min-elem := x
				min-key := key
			elif key > max-key!
				max-elem := x
				max-key := key
		else
			min-elem := x
			min-key := key
			max-elem := x
			max-key := key
	if _ ?= min-key
		(min-elem!, max-elem!), (min-key!, max-key!)

# Returns a single-element collection, or an empty collection if the option was empty.
+from-option[col, elem] col(a elem?) (col, elem) list-new
	if x ?= a
		- x
