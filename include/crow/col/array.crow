# TODO: clean up unnecessary named imports --------------------------------------------------------------------------------
no-std
import
	../bool
	../compare
	../hash
	../misc
	../number
	../option
	../private/bootstrap: array-size
	../range
	../unsafe
	./collection
	./private/array-low-level: inner, low, high
export
	../private/bootstrap: array
	./private/array-low-level:
		~=, ~~=, array-builder, array-view, build, is-empty, iterate, list-new, new, size, subscript, to

+list-new[t] t[](a t[])
	a

+size[t] nat64(a t[])
	a array-size

+to[t] t[](a t range) t rangeable, t difference
	for x in a then x

| {true} if `a.size == 0`.
+is-empty[t] bool(a t[])
	a.size == 0

| Prepend an element to an array.
| This is O(n).
+~[t] t[](a t, b t[])
	(a,)::t[] ~~ b

| Append an element to an array.
| This is O(n).
+~[t] t[](a t[], b t)
	a ~~ (b,)

| Concatenates two arrays.
| This is O(n).
+~~[t] t[](a t[], b t[])
	if a is-empty
		b
	elif b is-empty
		a
	else
		with out in a.size + b.size build
			out ~~= a
			out ~~= b
+~~[t] t[](a t array-view, b t array-view)
	if a is-empty
		b to
	elif b is-empty
		a to
	else
		with out in a.size + b.size build
			out ~~= a
			out ~~= b

+==[t] bool(a t[], b t[]) t equal
	a.to::(t array-view) == b.to::(t array-view)

+==[t] bool(a t array-view, b t array-view) t equal
	if (trusted a.inner reference-equal b.inner) and a.low == b.low and a.high == b.high
		true
	elif a.size != b.size
		false
	else
		i mut nat64 = 0
		loop
			if i == a.size
				break true
			elif a[i] != b[i]
				break false
			else
				i +:= 1
				continue

+<=>[t] comparison(a t[], b t[]) t compare
	guard (trusted a !reference-equal b) else equal
	i mut nat = 0
	limit = a.size min b.size
	loop
		if i == limit
			break a.size <=> b.size
		else
			match res = a[i] <=> b[i]
			as equal
				i +:= 1
				continue
			else
				break res

+array-like[col, elem] spec col size, (col, elem) at-index
+mut-array-like[col, elem] spec (col, elem) array-like, (col, elem) set-at-index

region basic array operations

| Returns a new array like {a} but where `{a}[{index}]` is replaced with {new-value}.
| This is O(n).
|
| {index} must be a valid index into {a}. This can't be used to add a value to the end.
+update-at[t] t[](a t[], index nat64, new-value t)
	a.to update-at index, new-value
+update-at[t] t[](a t array-view, index nat64, new-value t)
	assert index < a.size else index index-too-big a.size
	with out in a.size build
		out ~~= a[0 .. index]
		out ~= new-value
		out ~~= a[index + 1 .. a.size]

| Inserts an element at {index}.
| Moves all elements that were at {index} or after to the right.
| Unlike for {update-at}, {index} can be `{a}.{size}`, though it still can't be higher.
+insert-at[t] t[](a t[], index nat64, value t)
	a.to insert-at index, value
+insert-at[t] t[](a t array-view, index nat64, value t)
	assert index <= a.size else index index-too-big a.size
	with out in a.size + 1 build
		out ~~= a[0 .. index]
		out ~= value
		out ~~= a[index .. a.size]

| Removes the element at {index}, shifting all later elements to the left.
+remove-at[t] t[](a t[], index nat64)
	a.to remove-at index
+remove-at[t] t[](a t array-view, index nat64)
	assert index < a.size else index index-too-big a.size
	a[0 .. index] ~~ a[index + 1 .. a.size]

region spec impls (see collection.crow)

+hash[t] void(a t[], state hash-state) t hash
	a.to hash state
+hash[t] void(a t array-view, state hash-state) t hash
	i mut nat64 = 0
	until i == a.size
		a[i] hash state
		i +:= 1

+iterate-reverse[t] bool(a t[], f bool mut(x t))
	a.to iterate-reverse f
+iterate-reverse[t] bool(a t array-view, f bool mut(x t))
	guard a !is-empty
	i mut = a.high - 1
	loop
		if f[a.inner[i]]
			break true
		elif i == a.low
			break false
		else
			i -:= 1
			continue

+array-iterator[t] record mut
	~array t[]
	-start nat64
	~cur mut nat64
	-end nat64
+begin[t] t array-iterator(a t[])
	a, 0, 0, a.size
+begin[t] t array-iterator(a t array-view)
	a.inner, a.low, a.low, a.high
+end[t] t array-iterator(a t[])
	a, 0, a.size, a.size
+end[t] t array-iterator(a t array-view)
	a.inner, a.low, a.high, a.high
+copy[t] t array-iterator(a t array-iterator)
	a.array, a.start, a.cur, a.end
+is-at-end[t] bool(a t array-iterator)
	assert a.cur <= a.end
	a.cur == a.end
| If {a} iterates an {array-view}, this is the index relative to the view.
+index[t] nat64(a t array-iterator)
	a.cur - a.start
+set-index[t] void(a t array-iterator, index nat)
	assert a.start + index <= a.end
	a.cur := a.start + index
+take-prev[t] t(a t array-iterator)
	assert a.cur > a.start else iterator-out-of-bounds
	a.cur -:= 1
	a.array[a cur]
+peek[t] t?(a t array-iterator)
	if a.cur < a.end
		a.array[a cur]
+peek-prev[t] t?(a t array-iterator)
	if a.cur > a.start
		a.array[a.cur - 1]
+take-next[t] t(a t array-iterator)
	assert a.cur < a.end else iterator-out-of-bounds
	res = a.array[a cur]
	a.cur +:= 1
	res
+take-next-n[t] t array-view(a t array-iterator, n nat64)
	assert a.cur + n <= a.end else iterator-out-of-bounds
	res = a.array[a.cur .. a.cur + n]
	a.cur +:= n
	res
+take-prev-n[t] t array-view(a t array-iterator, n nat64)
	assert a.start + n <= a.cur else iterator-out-of-bounds
	end = a cur
	a.cur -:= n
	a.array[a.cur .. end]
+skip-next-n[t] void(a t array-iterator, n nat64)
	_ = a take-next-n n
+skip-prev-n[t] void(a t array-iterator, n nat64)
	_ = a take-prev-n n
+slice[t] t array-view(begin t array-iterator, end t array-iterator)
	assert begin.start == end.start and begin.end == end.end
	begin.array[begin.cur .. end.cur]
