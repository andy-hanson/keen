no-std
import
	../bool: bool
	../misc: subscript, void
	../number: ==, nat64
	../private/thread-utils
	./array: array
	./collection: build-options, for-loop
	./mut-array: ~=, build, clear, iterate, move-to, mut-array, size, subscript, to

| Shared equivalent to 'mut-array'.
|
| Iteration is not supported; since operations on this take a lock, they need to be short.
| If you need to iterate, you could use 'copy-to' or 'move-to' to get a snapshot of all the elements
| and iterate it at your leisure.
+shared-array[t] record force-shared
	-lock mut lock
	-inner mut t mut[]
-with-lock[out, t] out(a t shared[], cb out mut(a t mut[])) unsafe
	with in a lock
		cb[a inner]

+new[t] t shared[](...a t[])
	a to
+list-new[t] t shared[](a t[])
	a to

+size[t] nat64(a t shared[])
	trusted a with-lock it.size
+is-empty[t] bool(a t shared[])
	a.size == 0

+to[t] t shared[](a t[])
	(), a.to
| WARN: This holds the lock while copying the entire array. Consider using 'move-to' instead.
+copy-to[t] t[](a t shared[]) unsafe
	a with-lock it.to

+move-to[t] t shared[](a t mut[])
	(), a.move-to
+move-to[t] t[](a t shared[])
	trusted a with-lock it.move-to
+move-to[t] t mut[](a t shared[])
	trusted a with-lock it.move-to

+clear[t] void(a t shared[])
	trusted a with-lock it.clear

+~=[t] void(a t shared[], value t)
	trusted a with-lock of x
		x ~= value

+subscript[t] t(a t shared[], index nat64)
	trusted a with-lock it[index]

| Unsafe because this holds a lock while calling {cb}.
| {cb} should be a short function.
~unsafe-each[t] void(a t shared[], cb void mut(x t)) unsafe
	a with-lock of xs
		for x in xs
			cb[x]

region build

+build[t] t shared[](a build-options, f void mut(out t mut[]))
	a build f move-to
