no-std
import
	../bits: round-up-to-power-of-two
	../bool: &&, bool, false, not, true
	../compare: !=, <, <=, >, equal
	../exception: todo
	../js: as-js, call, call-property, cast, eval, js-cast, set-subscript, subscript
	../misc: new, subscript, void
	../number: ==, <=>, +, -, float64, nat64, next, to
	../option: force, new, option
	../range: .., iterate
	../tuple: new
	../unsafe: gc-safe-value, reference-equal
	./array: array, array-view, size, subscript, to
	./collection:
		.., -, build, build-options, end, for-loop, index-too-big, iterator-not-comparable,
		size-hint, slice-out-of-order, subscript, with-block
	./mut-slice: ~=, build, cast-immutable, clear-memory, gc-safe-mut-slice, mut-slice, mut-slice-view, new, set-subscript, size, subscript, to

| Mutable array type that can change in size.
| Appending (or removing) elements to the end is amortized O(1),
| but appending (or removing) from the beginning is always O(N).
+mut-array[t] builtin mut

# WARN: not implemented for JS backend ---------------------------------------------------------------------------------------------
-as-mut-array-impl[t] t mut-array-impl(a t mut[]) builtin
-as-mut-array[t] t mut[](a t mut-array-impl) builtin

-mut-array-impl[t] record mut
	| {backing}.{size} is the capacity.
	| For the GC's sake, unused parts of backing are filled with 'gc-safe-value'
	backing mut t mut-slice
	| Not used for JS
	size mut nat64

-backing[t] t mut-slice(a t mut[]) unsafe
	forbid extern js
	a.as-mut-array-impl backing
-set-backing[t] void(a t mut[], value t mut-slice) unsafe
	forbid extern js
	a.as-mut-array-impl.backing := value

| {true} if `{a}.{size} == 0`.
+is-empty[t] bool(a t mut[])
	a.size == 0

+size[t] nat64(a t mut[])
	trusted if extern java
		a.as-mut-array-impl size
	elif extern js
		a.as-js["length"].cast::float64 to
	else
		throw todo
-set-size[t] void(a t mut[], size nat64)
	a.as-mut-array-impl.size := size

+subscript[t] t(a t mut[], index nat64)
	a check-index index
	trusted if extern java
		a.backing[index]
	elif extern js
		a.as-js[index] cast
	else
		throw todo
+set-subscript[t] void(a t mut[], index nat64, value t)
	a check-index index
	trusted if extern java
		a.backing[index] := value
	elif extern js
		a.as-js[index] := value
	else
		throw todo

| {true} if {a} and {b} are the exact same reference.
| This is O(1) as it does not need to look at the elements.
+==[t] bool(a t mut[], b t mut[])
	# TODO: this should be generated for all records with 'identity' ----------------------------------------------------------------
	trusted a reference-equal b

| Creates a new {mut-array} with the given elements.
+new[t] t mut[](...a t[]) trusted
	if extern java
		(a.to, a.size) as-mut-array
	elif extern js
		a.as-js call-property "slice" cast
	else
		throw todo

| Copy elements to a new {mut-array}.
+to[t] t mut[](a t[])
	res t mut[] = ()
	res ~~= a
	res

| Removes all elements. This is O(1).
+clear[t] void(a t mut[]) trusted
	a reduce-size-to 0

| Removes all elements with index >= {new-size}.
| This is O(1).
+reduce-size-to[t] void(a t mut[], new-size nat64)
	assert new-size <= a.size
	trusted if extern java
		a.backing[new-size .. a.size] clear-memory
		a.size := new-size
	elif extern js
		a.as-js["length"] := new-size.to::float64
	else
		throw todo

| Copies elements to a new {mut-array}.
+copy[t] t mut[](a t mut[])
	if trusted extern js
		trusted a.as-js call-property "slice" cast
	else
		a.begin slice a.end

| Copies elements to a new {array}.
| The result is immutable and won't be affected by future writes to {a}.
+to[t] t[](a t mut[])
	a.copy move-to

| This is like {to} but sets the input to empty.
| This allows safely returning an immutable result but avoids needing to copy elements.
| This os O(1) normally. In JS it is likely O(n).
+move-to[t] t[](a t mut[])
	trusted a.move-to cast-immutable
+move-to[t] t mut-slice(a t mut[])
	trusted if extern java
		res t mut-slice = if a.backing.size == a.size
			a backing
		else
			with out : a.size build
				for i : 0::nat64 .. a.size
					out ~= a.backing[i]
		a.backing := ()
		a.size := 0
		res
	elif extern js
		res t mut-slice = a.as-js call-property "slice" cast
		a clear
		res
	else
		throw todo
+move-to[t] t mut[](a t mut[])
	trusted if extern java
		res t mut[] = (a.backing, a.size) as-mut-array
		a.backing := ()
		a.size := 0
		res
	elif extern js
		a.move-to::(t mut-slice) js-cast
	else
		throw todo

| Swap the contents of two arrays.
| This is O(1) normally. In JS it is likely O(n).
+swap[t] void(a t mut[], b t mut[])
	trusted if extern java
		a-backing = a backing
		a-size = a size
		a.backing := b backing
		a.size := b size
		b.backing := a-backing
		b.size := a-size
	elif extern js
		_ = """
			(a, b) => \{
				const temp = a.slice()
				a.length = 0
				a.push(...b)
				b.length = 0
				b.push(...temp)
			}
		""".eval call a, b
	else
		throw todo

+swap[t] void(a t mut[], i nat64, j nat64)
	temp = a[i]
	a[i] := a[j]
	a[j] := temp

-check-index[t] void(a t mut[], index nat64)
	assert index < a.size : index index-too-big a.size

+peek[t] t?(a t mut[])
	guard a !is-empty
	a[end - 1]

| Removes the last element and returns it.
| This is O(1).
| Returns an empty option if `{a} {is-empty}`.
+pop[t] t?(a t mut[])
	guard a !is-empty
	if trusted extern java
		new-size = a.size - 1
		res = a[new-size]
		a[new-size] := trusted gc-safe-value
		a.size := new-size
		res
	elif trusted extern js
		(trusted a.as-js call-property "pop" cast)::t
	else
		throw todo

| Removes the first element and returns it.
| Returns an empty option if `{a} {is-empty}`.
+pop-left[t] t?(a t mut[])
	unless a is-empty
		(a pop-n-left 1)[0]

| Removes the last {n} elements and returns them as an array.
| The result is guaranteed to be of size {n}.
| Throws {index-too-big} if there are not at least {n} elements.
+pop-n[t] t[](a t mut[], n nat64)
	assert n <= a.size : n index-too-big a.size
	new-size = a.size - n
	trusted if extern java
		res t[] = a.backing[new-size .. a.size] to
		a.size := new-size
		res
	elif extern js
		res t[] = (a.js-cast::t[])[new-size .. a.size] to
		a.as-js["length"] := new-size.to::float64
		res
	else
		throw todo

| Removes the first {n} elements and returns them as an array.
| The result is guaranteed to be of size {n}.
| Throws {index-too-big} if there are not at least {n} elements.
+pop-n-left[t] t[](a t mut[], n nat64)
	assert n <= a.size : n index-too-big a.size
	trusted if extern java
		res t[] = a.backing[0 .. n] to
		a.backing[0 .. end - n] := a.backing[n .. end]
		a.size -:= n
		res
	elif extern js
		a.as-js call-property "splice", 0::float64, n.to::float64 cast
	else
		throw todo

| Push a value onto the beginning of the array.
| This is O(n).
+prepend=[t] void(a t mut[], value t)
	trusted if extern java
		a ensure-room-for-one-more
		a.backing[1 .. a.size + 1] := a.backing[0 .. a.size]
		a[0] := value
		a.size +:= 1
	elif extern js
		_ = a.as-js call-property "unshift", value
	else
		throw todo

| Push a value onto the end of the array.
+~=[t] void(a t mut[], value t)
	trusted if extern java
		a ensure-room-for-one-more
		a.backing[a size] := value
		a.size +:= 1
	elif extern js
		_ = a.as-js call-property "push", value
	else
		throw todo

| Push multiple values onto the end of the array.
+~~=[t] void(a t mut[], values t[])
	a ~~= values.to::(t array-view)
+~~=[t] void(a t mut[], values t array-view)
	# TODO: PERF could probably optimize this even more -----------------------------------------------------------------
	i mut nat64 = 0
	until i == values.size
		a ~= values[i]
		i +:= 1
+~~=[t] void(a t mut[], values t mut[])
	# TODO: PERF could probably optimize this even more -----------------------------------------------------------------
	i mut nat64 = 0
	until i == values.size
		a ~= values[i]
		i +:= 1

-ensure-room-for-one-more[t] void(a t mut[]) unsafe
	guard a.size == a.capacity
	a ensure-capacity-round-up a.size + 1

-increase-capacity-to[t] void(a t mut[], new-capacity nat64) trusted
	assert new-capacity > a.capacity
	old-backing = a backing
	a.backing := new-capacity gc-safe-mut-slice
	a.backing[0 .. a.size] := old-backing[0 .. a.size]

| For performance, hint that the array will eventually reach {eventual-size}.
| This has no observable effect.
| There is no unsafety if the array grows bigger than {eventual-size}.
| This takes O({eventual-size}) time if {eventual-size} > {a}.{size}.
~hint-size[t] void(a t mut[], eventual-size nat64)
	if trusted extern java
		a ensure-capacity-exact eventual-size

-ensure-capacity-round-up[t] void(a t mut[], min-capacity nat64)
	a ensure-capacity-exact min-capacity.round-up-to-power-of-two

-ensure-capacity-exact[t] void(a t mut[], min-capacity nat64)
	if trusted a.capacity < min-capacity
		a increase-capacity-to min-capacity

| Removes `{a}[{index}]`, replaces it with the last value, and returns the old `a[index]`.
| If `a[index]` is the last value, simply pops it.
| This is more efficient than `a remove-at index`,
| which has to shift all values past `index` to the left.
| Throws if `index >= a.size`.
~remove-unordered-at[t] t(a t mut[], index nat64)
	res = a[index]
	replacement = a pop!
	unless index == a.size
		a[index] := replacement
	res

| The new contents of {a} will be `a[0 .. index] ~~ (value,) ~~ a[index .. end]`.
| So, `{a}[{index}]` will be {value}.
| This is O(a.size - index) due to having to move a[index .. end] to the right by 1.
+insert-at[t] void(a t mut[], index nat64, value t)
	assert index <= a.size : index index-too-big a.size
	trusted if extern java
		a ensure-room-for-one-more
		a.backing[index + 1 .. a.size + 1] := a.backing[index .. a.size]
		a.size +:= 1
		assert a.size <= a.capacity
		a[index] := value
	elif extern js
		_ = a.as-js call-property "splice", index.to::float64, 0::float64, value
	else
		throw todo

| The new contents of {a} will be `a[0 .. index] ~~ a[index + 1 .. end]`.
| Returns the old `a[index]` which will have been removed.
| This is O(a.size - index) due to having to shift `a[index + 1 .. end]` to the left by 1.
+remove-at[t] t(a t mut[], index nat64)
	a check-index index
	res = a[index]
	trusted if extern java
		a.backing[index .. a.size - 1] := a.backing[index + 1 .. a.size]
		a.size -:= 1
	elif extern js
		_ = a.as-js call-property "splice", index.to::float64, 1::float64
	else
		throw todo
	res

+in[t] bool(value t, xs t mut[]) t equal
	xs iterate x => x == value

region mutating iteration

| Replaces every element `x` with `{f}[x]`.
| WARN: During the map, `a` will appear to be empty and pushes to it won't affect the result.
+map=[t] void(a t mut[], f t mut(elem t))
	temp t mut[] = a move-to
	i mut nat64 = 0
	while i < temp.size
		temp[i] := f[temp[i]]
		i +:= 1
	a swap temp

| Removes every element `x` where `!{f}[x]`.
| WARN: During the filter, `a` will appear to be empty and pushes to it won't affect the result.
+filter=[t] void(a t mut[], f bool mut(elem t))
	temp t mut[] = a move-to
	out mut nat64 = 0
	i mut nat64 = 0
	while i < temp.size
		x = temp[i]
		if f[x]
			temp[out] := x
			out +:= 1
		i +:= 1
	temp reduce-size-to out
	a swap temp

region unsafe

| Create a new array full of {gc-safe-value}.
+gc-safe-mut-array[t] t mut[](size nat64) unsafe
	size.gc-safe-mut-slice.cast-immutable to

| Pushes {n} of {gc-safe-value} to the mut-array.
| This can be useful to prepare the array for being written by low-level code.
+push-gc-safe-values[t] void(a t mut[], n nat64) unsafe
	if extern java
		new-size = a.size + n
		a ensure-capacity-round-up new-size
		a.size := new-size
	elif extern js
		new-size = a.size + n
		while a.size != new-size
			_ = a.as-js call-property "push", gc-safe-value::t
	else
		throw todo

| Returns a {mut-slice} of all elements currently in the `mut-array`.
|
| WARN: The result is temporary.
| It's undefined behavior to modify {a} while the result of this function is still in use.
~temp-as-mut-slice[t] t mut-slice-view(a t mut[]) unsafe # TODO: RENAME ------------------------------------------------
	if extern java
		a.backing[0 .. a.size]
	elif extern js
		(a.js-cast::(t mut-slice))[0 .. end]
	else
		throw todo
~temp-as-array-view[t] t array-view(a t mut[]) unsafe
	if extern java
		a.backing.cast-immutable[0 .. a.size]
	elif extern js
		(a.js-cast::t[])[0 .. end]
	else
		throw todo

is-at-capacity[t] bool(a t mut[]) unsafe
	a.capacity == a.size

capacity[t] nat64(a t mut[]) unsafe
	a.backing size

region spec impls (see collection.crow)

+iterate[t] bool(a t mut[], f bool mut(elem t))
	i mut nat64 = 0
	loop
		if i < a.size
			if f[a[i]]
				break true
			else
				i +:= 1
				continue
		else
			break false

+mut-array-iterator[t] record(collection t mut[], next-index nat64) mut

+begin[t] t mut-array-iterator(a t mut[])
	a, 0

+end[t] t mut-array-iterator(a t mut[])
	a, a.size

+prev[t] (t mut-array-iterator, t)?(a t mut-array-iterator)
	guard a.next-index != 0
	assert a.next-index <= a.collection.size
	value = a.collection[a.next-index - 1]
	(a.collection, a.next-index - 1), value

+next[t] (t, t mut-array-iterator)?(a t mut-array-iterator)
	guard a.next-index < a.collection.size
	value = a.collection[a next-index]
	value, (a.collection, a.next-index + 1)

+ +[t] t mut-array-iterator(a t mut-array-iterator, n nat64)
	new-next-index = a.next-index + n
	assert new-next-index <= a.collection.size
	a.collection, new-next-index

+-[t] t mut-array-iterator(a t mut-array-iterator, n nat64)
	a.collection, a.next-index - n

+-[t] nat64(a t mut-array-iterator, b t mut-array-iterator)
	assert a.collection == b.collection
	a.next-index - b.next-index

+set-prev[t] void(a t mut-array-iterator, value t)
	assert a.next-index != 0 && a.next-index <= a.collection.size
	a.collection[a.next-index - 1] := value

+set-next[t] void(a t mut-array-iterator, value t)
	assert a.next-index < a.collection.size
	a.collection[a next-index] := value

+slice[t] t mut[](begin t mut-array-iterator, end t mut-array-iterator)
	assert begin.collection == end.collection : iterator-not-comparable
	assert begin.next-index <= end.next-index : slice-out-of-order
	col = begin collection
	low = begin next-index
	high = end next-index
	trusted if extern js
		col.as-js call-property "slice", low.to::float64, high.to::float64 cast
	else
		col.backing[begin.next-index .. end.next-index].to to # TODO: avoid the double copy ------------------------------------

+build[t] t mut[](a build-options, f void mut(out t mut[]))
	res t mut[] = ()
	res hint-size a.size-hint
	f[res]
	res
