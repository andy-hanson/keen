no-std
import
	../bits
	../bool
	../compare
	../misc
	../number
	../option
	../range
	../unsafe
	./array
	./collection
	./buffer
	./private/array-low-level: copy-from, inner, low, high
	./util

| Mutable array type that can change in size.
| Appending (or removing) elements to the end is amortized O(1),
| but appending (or removing) from the beginning is always O(N).
+mut-array[t] record mut
	| {backing}.{size} is the capacity.
	| Unused parts of backing are filled with {gc-safe-value}.
	-backing mut t buffer
	-size-and-locked mut nat64

| Returns the size. Call {unlock-for-writing} in a 'finally'.
-lock-for-writing[t] nat(a t mut[]) unsafe
	assert-can-write a
	res = a.size-and-locked
	a.size-and-locked := res | top-two-bits
	res
-unlock-for-writing[t] void(a t mut[], size nat) unsafe
	a.size-and-locked := size
| Returns the old lock value. Pass this to {unlock-for-reading} in a 'finally'.
| Note: This will only work if read locks work in a nested way.
-lock-for-reading[t] bool(a t mut[]) unsafe
	assert-can-read a
	was-already-locked = !can-write a
	a.size-and-locked := a.size-and-locked | almost-top-bit
	was-already-locked
-unlock-for-reading[t] void(a t mut[], was-already-locked bool) unsafe
	unless was-already-locked
		a.size-and-locked := (a.size-and-locked & ~top-two-bits)

| Note: We don't need to call this explicitly for most functions as long as they access 'a.size' before doing anything
-assert-can-read[t] void(a t mut[])
	assert can-read a else was-locked
-can-read[t] bool(a t mut[])
	a.size-and-locked & top-bit == 0
-assert-can-write[t] void(a t mut[])
	assert can-write a else was-locked
-can-write[t] bool(a t mut[])
	a.size-and-locked & top-two-bits == 0
| This bit will be marked to prevent both reading and writing.
-top-bit nat64()
	1 << 63
| This bit will be marked to prevent reading but not writing.
-almost-top-bit nat64()
	1 << 62
-top-two-bits nat64()
	3 << 62

| {true} if `{a}.{size} == 0`.
+is-empty[t] bool(a t mut[])
	a.size == 0

+size[t] nat64(a t mut[])
	assert-can-read a
	a.size-and-locked & 0x0fffffffffffffff
-set-size[t] void(a t mut[], size nat64)
	assert-can-write a
	a.size-and-locked := size

+subscript[t] t(a t mut[], index nat64)
	check-index a, index
	a.backing[index]
+subscript[t] t(a t mut[], index index-relative-to-end)
	a[to-index a, index]
+set-subscript[t] void(a t mut[], index nat64, value t)
	assert-can-write a
	check-index a, index
	a.backing[index] := value
+set-subscript[t] void(a t mut[], index index-relative-to-end, value t)
	a[to-index a, index] := value

+list-new[t] t mut[](a t[])
	a.to, a.size

| Copy elements to a new {mut-array}.
+to[t] t mut[](a t[])
	res t mut[] = ()
	res ~~= a
	res

| Removes all elements. This is O(1).
+clear[t] void(a t mut[])
	reduce-size-to a, 0

| Removes all elements with index >= {new-size}.
| This is O(1).
+reduce-size-to[t] void(a t mut[], new-size nat64)
	assert-can-write a
	assert new-size <= a.size
	trusted
	clear-memory a.backing[new-size .. a.size]
	a.size := new-size

| Copies elements to a new {mut-array}.
+copy[t] t mut[](a t mut[])
	assert-can-read a
	backing: trusted temp-as-buffer a 'to
	size-and-locked: a.size

| Copies elements to a new {array}.
| The result is immutable and won't be affected by future writes to {a}.
+to[t] t[](a t mut[])
	trusted temp-as-buffer a 'to

| This is like {to} but sets the input to empty.
| This allows safely returning an immutable result but avoids needing to copy elements.
| This os O(1) normally. In JS it is likely O(n).
+move-to[t] t[](a t mut[])
	trusted cast-immutable a.move-to
+move-to[t] t buffer(a t mut[])
	assert-can-write a
	res t buffer = if a.backing.size == a.size
		a.backing
	else
		with out in build a.size
			for i in 0::nat64 .. a.size
				out ~= a.backing[i]
	a.backing := ()
	a.size := 0
	res
+move-to[t] t mut[](a t mut[])
	assert-can-write a
	res t mut[] = a.backing, a.size
	a.backing := ()
	a.size := 0
	res

| Swap the contents of two arrays.
| This is O(1) normally. In JS it is likely O(n).
+swap[t] void(a t mut[], b t mut[])
	assert-can-write a
	assert-can-write b
	a-backing = a.backing
	a-size = a.size
	a.backing := b.backing
	a.size := b.size
	b.backing := a-backing
	b.size := a-size

+swap[t] void(a t mut[], i nat64, j nat64)
	temp = a[i]
	a[i] := a[j]
	a[j] := temp

-check-index[t] void(a t mut[], index nat64)
	assert index < a.size else index-too-big index, a.size
-check-index-lte[t] void(a t mut[], index nat64)
	assert index <= a.size else index-too-big index, a.size

+peek[t] t?(a t mut[])
	unless is-empty a
		a[end - 1]

| Removes the last element and returns it.
| This is O(1).
| Returns an empty option if `{is-empty} {a}`.
+pop[t] t?(a t mut[])
	assert-can-write a
	do unless is-empty a
	new-size = a.size - 1
	res = a[new-size]
	a[new-size] := trusted gc-safe-value # TODO:PERF This is unnecessary for a non-reference type
	a.size := new-size
	res

| Removes the first element and returns it.
| Returns an empty option if `{is-empty} {a}`.
| This is O(n).
+pop-left[t] t?(a t mut[])
	unless is-empty a
		(pop-n-left a, 1)[0]

| Removes the last {n} elements and returns them as an array.
| The result is guaranteed to be of size {n}.
| Throws {index-too-big} if there are not at least {n} elements.
+pop-n[t] t[](a t mut[], n nat64)
	assert-can-write a
	check-index-lte a, n
	new-size = a.size - n
	slice = a.backing[new-size .. a.size]
	res t[] = slice.to
	trusted clear-memory slice
	a.size := new-size
	res

| Removes the first {n} elements and returns them as an array.
| The result is guaranteed to be of size {n}.
| Throws {index-too-big} if there are not at least {n} elements.
+pop-n-left[t] t[](a t mut[], n nat64)
	assert-can-write a
	assert n <= a.size else index-too-big n, a.size
	res t[] = a.backing[0 .. n].to
	a.backing[0 .. end - n] := a.backing[n .. end]
	a.size -:= n
	res

| Push a value onto the beginning of the array.
| This is O(n).
+prepend=[t] void(a t mut[], value t)
	trusted
	ensure-room-for-one-more a
	a.backing[1 .. a.size + 1] := a.backing[0 .. a.size]
	a[0] := value
	a.size +:= 1

| Push a value onto the end of the array.
+ ~=[t] void(a t mut[], value t)
	trusted
	ensure-room-for-one-more a
	a.backing[a.size] := value
	a.size +:= 1

| Push multiple values onto the end of the array.
+ ~~=[t] void(a t mut[], values t array-view)
	assert-can-write a
	if trusted java
		new-size = a.size + values.size
		ensure-capacity-round-up a, new-size
		copy-from a.backing, a.size .. new-size, values.inner, values.low .. values.high
		a.size := new-size
	else
		i mut nat64 = 0
		until i == values.size
			a ~= values[i]
			i +:= 1
+ ~~=[t] void(a t mut[], values t mut[])
	a ~~= trusted temp-as-array-view values
+ ~~=[t] void(a t mut[], values t buffer-view)
	a ~~= trusted cast-immutable values

-ensure-room-for-one-more[t] void(a t mut[]) unsafe
	assert-can-write a
	if a.size == a.backing.size
		ensure-capacity-round-up a, a.size + 1

-increase-capacity-to[t] void(a t mut[], new-capacity nat64)
	trusted
	assert new-capacity > a.backing.size
	old-backing = a.backing
	a.backing := uninitialized-buffer new-capacity
	a.backing[0 .. a.size] := old-backing[0 .. a.size]

-ensure-capacity-round-up[t] void(a t mut[], min-capacity nat64)
	ensure-capacity-exact a, min-capacity.round-up-to-power-of-two

-ensure-capacity-exact[t] void(a t mut[], min-capacity nat64)
	assert-can-write a
	if a.backing.size < min-capacity
		increase-capacity-to a, min-capacity

| The new contents of {a} will be `a[0 .. index] ~~ (value,) ~~ a[index .. end]`.
| So, `{a}[{index}]` will be {value}.
| This is O(a.size - index) due to having to move a[index .. end] to the right by 1.
+insert-at[t] void(a t mut[], index nat64, value t)
	assert-can-write a
	check-index-lte a, index
	trusted
	ensure-room-for-one-more a
	a.backing[index + 1 .. a.size + 1] := a.backing[index .. a.size]
	a.size +:= 1
	assert a.size <= a.backing.size
	a[index] := value

| The new contents of {a} will be `a[0 .. index] ~~ a[index + 1 .. end]`.
| Returns the old `a[index]` which will have been removed.
| This is O(a.size - index) due to having to shift `a[index + 1 .. end]` to the left by 1.
+remove-at[t] t(a t mut[], index nat64)
	assert-can-write a
	check-index a, index
	res = a[index]
	a.backing[index .. a.size - 1] := a.backing[index + 1 .. a.size]
	a.size -:= 1
	res

region mutating iteration

| Replaces every element `x` with `{f}[x]`.
| This locks {a} for both reading and writing.
| If {f} throws an exception, {a} will reflect all updated values so far, with unprocessed values unchanged.
+map=[t] void(a t mut[], f t mut(elem t))
	trusted
	size = lock-for-writing a
	finally unlock-for-writing a, size
	i mut nat64 = 0
	while i < size
		a.backing[i] := f[a.backing[i]]
		i +:= 1

| Removes every element `x` where `!{f}[x]`.
| If {f} throws an exception, {a} will contain only processed elements.
+filter=[t] void(a t mut[], f bool mut(elem t))
	trusted
	out mut nat64 = 0
	size = lock-for-writing a
	finally unlock-for-writing a, out
	i mut nat64 = 0
	while i < size
		x = a.backing[i]
		if f[x]
			a.backing[out] := x
			out +:= 1
		i +:= 1

| Pushes {n} of {gc-safe-value} to the mut-array.
| This can be useful to prepare the array for being written by low-level code.
~push-gc-safe-values[t] void(a t mut[], n nat64) unsafe
	assert-can-write a
	new-size = a.size + n
	ensure-capacity-round-up a, new-size
	a.size := new-size

| Returns a {buffer} of all elements currently in the `mut-array`.
|
| WARN: The result is temporary.
| It's undefined behavior to modify {a} while the result of this function is still in use.
~temp-as-buffer[t] t buffer-view(a t mut[]) unsafe
	a.backing[0 .. a.size]
~temp-as-array-view[t] t array-view(a t mut[]) unsafe
	a.backing.cast-immutable[0 .. a.size]

+iterate[t] bool(a t mut[], f bool mut(elem t))
	trusted
	was-locked = lock-for-reading a
	finally unlock-for-reading a, was-locked
	i mut nat64 = 0
	size = a.size
	do loop
	if i < size
		if f[a.backing[i]]
			break true
		else
			i +:= 1
			continue
	else
		break false

+iterate-reverse[t] bool(a t mut[], f bool mut(elem t))
	trusted
	was-locked = lock-for-reading a
	finally unlock-for-reading a, was-locked
	do unless is-empty a
	i mut = a.size - 1
	do loop
	if f[a.backing[i]]
		break true
	elif i == 0
		break false
	else
		i -:= 1
		continue
