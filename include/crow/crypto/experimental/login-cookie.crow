import
	../../io/duration
	../../io/time
	../../parse
	../random

+login-cookie record(timestamp unix-time, cookie nat64)

+cookie-matches bool(a login-cookie, cookie nat64, expiration duration) summon
	now = unix-time
	age = now - a.timestamp
	recent = now - a.timestamp < expiration
	unless recent
		log "Cookie expired after {age}"
	unless a.cookie == cookie
		log "Wrong cookie! expected: {a.cookie}, got: {cookie}"
	recent and a.cookie == cookie

+generate-login-cookie login-cookie() summon
	timestamp: unix-time, cookie: random

+show string(a login-cookie)
	"{seconds-since-epoch a.timestamp}|{a.cookie}"

+login-cookie login-cookie grammar()
	transform int ~~ "|" ~~ nat, of time, cookie
		(time.to,), cookie
