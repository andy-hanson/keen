use-prefix
+prng record mut
	-state mut nat64
+new prng()
	state: 0xdecafc0ffeecafe
+new prng(seed nat64)
	state: seed
+next nat64(a prng)
	# Uses the value from musl
	a.state := 0x5851f42d4c957f2d 'wrap-mul a.state 'wrap-add 1
	a.state
+next nat32(a prng)
	a.next::nat64.wrap-to

+next-in-range nat64(a prng, range nat64 range)
	range.low + (a.next % range.size)
