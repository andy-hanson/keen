| Functions for generating cryptographically random numbers.
import
	crow/unsafe
	java/util/Random
	java/security/SecureRandom
	../bits
	../js

+random nat64() summon
	trusted
	if java
		a SecureRandom = getInstanceStrong
		a.reinterpret-cast::Random.nextLong.wrap-to
	elif js
		xs = call-new "Uint32Array".js-global, 2
		_ = call-property "crypto".js-global, "getRandomValues", xs
		bits-cat xs[0].to::nat32, xs[1].to
	else
		throw todo

+random bool() summon
	random::nat64 % 2 == 0

+random nat8() summon
	random::nat64.wrap-to

+random nat16() summon
	random::nat64.wrap-to

+random nat32() summon
	random::nat64.wrap-to
