###
Functions for generating cryptographically random numbers.
###

import
	../bits
	../js

+random nat32() summon
	trusted
	assert extern js else todo
	xs = "Uint32Array".js-global call-new 1::float64.as-js # TODO: '1' should be a valid 'js-any' literal -------------------------------------------
	_ = "crypto".js-global call-property "getRandomValues", xs
	xs["0"].cast::float64 to

+random bool() summon
	random::nat32 % 2 == 0

+random nat8() summon
	random::nat32.to wrap-to

+random nat16() summon
	random::nat32.to wrap-to

+random nat64() summon
	random bits-cat random
