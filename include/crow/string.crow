		for x in a
			out ~= x

| Treats UTF-8 character codes as a string.
+to string(a char8[])
	a,
+to string(a char8 array-view)
	a.to::char8[] to
+move-to string(a char8 mut[])
	a.move-to::char8[] to
+as-string string(bytes nat8[])
	bytes.safe-reinterpret-cast::char8[] to
+as-string string(bytes nat8 array-view)
	bytes.to as-string

+to nat64(a char8)
	a.to::nat8 to
+to nat64(a char32)
	a.to::nat32 to

| Treats a string as UTF-8 bytes.
| This is O(1).
+to nat8[](a string)
	a.chars safe-reinterpret-cast

+show[t] spec
	show string(a t)

| `"true"` or `"false"`.
+show string(a bool)
	if a then "true" else "false"

| String containing a single character.
+to string(a char8)
	a.to::char32 to
+show string(a char8)
	if a is-valid-single-byte-character
		a to
	else
		"\\u{a.to::nat8 to-hex}"
+to string(a char32)
	with out in build
		out ~= a
+show string(a char32)
	a to

| Converts a {nat64} to a {string}.
| Returns only digits without punctuation, e.g. `1234`.
+show string(a nat64)
	a to-base 10

-js-to-string string(a js-any) unsafe, js
	"String".js-global call a to

-digit-to-string string(a nat64)
	a.digit-to-char to
-digit-to-char char32(a nat64)
	match a
	as 0
		"0"
	as 1
		"1"
	as 2
		"2"
	as 3
		"3"
	as 4
		"4"
	as 5
		"5"
	as 6
		"6"
	as 7
		"7"
	as 8
		"8"
	as 9
		"9"
	as 10
		"a"
	as 11
		"b"
	as 12
		"c"
	as 13
		"d"
	as 14
		"e"
	as 15
		"f"
	else
		throw unreachable

+to-binary string(a nat8)
	a.to::nat64 to-binary
+to-binary string(a nat16)
	a.to::nat64 to-binary
+to-binary string(a nat32)
	a.to::nat64 to-binary
+to-binary string(a nat64)
