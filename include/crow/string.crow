+hash-mix void(hasher hasher, a string)
	# TODO: 'hasher hash-mix a.chars' # ------------------------------------------------------------------------------------------------
	chars char8[] = a to
	i mut nat64 = 0
	until i == chars.size
		hasher hash-mix chars[i]
		i +:= 1
+hash-mix void(hasher hasher, a char8)
