export
	./private/bootstrap: char8, char32, string

+to char8(a nat8)
+to nat8(a char8)
+== bool(a char8, b char8)

+~~ string(a string, b string)
	a.to::char8[] ~~ b.to 'to
+~ string(a char32, b string)
	a.to ~~ b
+~ string(a string, b char32)
	a ~~ b.to

+interpolate-string string(a string)
	a
+interpolate-value[t] string(a t) t show
	show a
+interpolate string(parts string[])
	# TODO: this could just use 'flatten' from collection.crow if that had better perf .......................................
	res-size mut nat64 = 0
	for part in parts
		res-size +:= part.to::char8[].size
	res char8 mut-slice = trusted gc-safe-mut-slice res-size
	out-i mut nat64 = 0
	for part in parts
		chars char8[] = part.to
		res[out-i .. out-i + chars.size] := chars
		out-i +:= chars.size
	assert out-i == res-size
	trusted res.cast-immutable.to
+interpolate String(parts string[]) java
	parts.interpolate::string.to
+interpolate js-any(parts string[]) js
	parts.interpolate::string.to

| Same as `""`.
+new string()
	""

| Same as `{a} == ""`.
+is-empty bool(a string)
	is-empty a.to::char8[]

| Number of {char32}s in the string. This must walk and decode the string to count them.
+size nat64(a string)
	res mut nat64 = 0
	for _ in a
		res +:= 1
	res

+== bool(a string, b string)
	trusted if java
		trusted a.to::char8[].reinterpret-cast::(int8 mut-slice) 'equals b.to::char8[].reinterpret-cast
	else
		# TODO: ideally, this would have just as good performance. Would require letting it specialize on types.
		a.to::char8[] == b.to
+== bool(a char32, b char32)
+to nat32(a char32)
| This is unsafe because a {char32} should be a valid unicode character.
+unsafe-to char32(a nat32) unsafe
+to char32(a nat32)
	assert is-valid-unicode-character a
	trusted a.unsafe-to

+<=> comparison(a string, b string)
	trusted a.to::char8[] <=> b.to # TODO: this is same as the auto fun, so just use that? --------------------------------------------------------
+<=> comparison(a char8, b char8)
	trusted a.to::nat8 <=> b.to
+<=> comparison(a char32, b char32)
	trusted a.to::nat32 <=> b.to

+hash void(a string, state hash-state)
	trusted hash a.chars, state
+hash void(a char8, state hash-state)
	trusted hash a.to::nat8, state
+hash void(a char32, state hash-state)
	trusted hash a.to::nat32, state

region conversion

-unsafe-to char32(a char8)
+to char32(a char8)
	assert is-valid-single-byte-character a
	a.unsafe-to
+to char8(a char32)
	a.to::nat32.to::nat8.to

+to char8[](a string)
	a.chars
+to char8 array-view(a string)
	a.chars.to
+to char32[](a string)
	for x in a then x
+to string(a char32[])
	a.to.to
+to string(a char32 array-view)
	with out in build
		for x in a
			out ~= x

| Treats UTF-8 character codes as a string.
+to string(a char8[])
	a,
+to string(a char8 array-view)
	a.to::char8[].to
+move-to string(a char8 mut[])
	a.move-to::char8[].to
+as-string string(bytes nat8[])
	bytes.safe-reinterpret-cast::char8[].to
+as-string string(bytes nat8 array-view)
	as-string bytes.to

+to nat64(a char8)
	a.to::nat8.to
+to nat64(a char32)
	a.to::nat32.to

| Treats a string as UTF-8 bytes.
| This is O(1).
+to nat8[](a string)
	safe-reinterpret-cast a.chars

+show[t] spec
	show string(a t)

| `"true"` or `"false"`.
+show string(a bool)
	if a then "true" else "false"

| String containing a single character.
+to string(a char8)
	a.to::char32.to
+show string(a char8)
	if is-valid-single-byte-character a
		a.to
	else
		"\\u{to-hex a.to::nat8}"
+to string(a char32)
	with out in build
		out ~= a
+show string(a char32)
	a.to

| Converts a {nat64} to a {string}.
| Returns only digits without punctuation, e.g. `1234`.
+show string(a nat64)
	to-base a, 10

-js-to-string string(a js-any) unsafe, js
	call "String".js-global, a 'to

-digit-to-string string(a nat64)
	a.digit-to-char.to
-digit-to-char char32(a nat64)
	match a
	as 0
		"0"
	as 1
		"1"
	as 2
		"2"
	as 3
		"3"
	as 4
		"4"
	as 5
		"5"
	as 6
		"6"
	as 7
		"7"
	as 8
		"8"
	as 9
		"9"
	as 10
		"a"
	as 11
		"b"
	as 12
		"c"
	as 13
		"d"
	as 14
		"e"
	as 15
		"f"
	else
		throw unreachable

+to-binary string(a nat8)
	to-binary a.to::nat64
+to-binary string(a nat16)
	to-binary a.to::nat64
+to-binary string(a nat32)
	to-binary a.to::nat64
+to-binary string(a nat64)
	to-base a, 2

+to-hex string(a nat8)
	to-hex a.to::nat64
+to-hex string(a nat16)
	to-hex a.to::nat64
+to-hex string(a nat32)
	to-hex a.to::nat64
+to-hex string(a nat64)
	to-base a, 16

-to-base string(a nat64, base nat64)
	if a < base
		digit-to-string a
	else
		(to-base a / base, base) ~~ (a % base).digit-to-string

+show string(a string)
	a

+show string(a nat8)
	show a.to::nat64

+show string(a nat16)
	show a.to::nat64

+show string(a nat32)
	show a.to::nat64

+show string(a int8)
	show a.to::int64

+show string(a int16)
	show a.to::int64

+show string(a int32)
	show a.to::int64

+show string(a int64)
	if a == min-value
		"-9223372036854775808"
	else
		s string = "{abs a}"
		if a < 0 then "-{s}" else s

+show string(a float32)
	show a.to::float64

+show string(a float64)
	trusted if java
		strip-point-0 a.valueOf.to
	elif js
		js-to-string a.to
	else
		throw todo
-strip-point-0 string(a string)
	try-remove-end a, ".0" else a

+iterate bool(a string, f bool mut(x char32))
	iter = begin a.to::char8[]
	do loop
	next char32? = try
		unicode-decode iter
	catch as iterator-out-of-bounds
		()
	do if next else break false
	if f[next] then break true else continue
+iterate-reverse bool(a string, f bool mut(x char32))
	iter = end a.to::char8[]
	do loop
	prev char32? = try
		unicode-decode-prev iter
	catch as iterator-out-of-bounds
		()
	do if prev else break false
	# TODO: `if f[x] then break true else continue` should parse
	if f[prev]
		break true
	else
		continue

| NOTE: More helpful functions are in 'crow/parse'
+string-iterator record mut
	~inner char8 array-iterator
+begin string-iterator(a string)
	begin a.to::(char8 array-view)
+begin string-iterator(a char8 array-view)
	a.begin,
+end string-iterator(a string)
	end a.to::(char8 array-view)
+end string-iterator(a char8 array-view)
	a.end,
+copy string-iterator(a string-iterator)
	a.inner.copy,
+is-at-end bool(a string-iterator) # TODO: this should be a generic function on iterators .......................................................
	is-at-end a.inner
+take-char8 char8(a string-iterator)
	take-next a.inner
+take-next char32(a string-iterator)
	unicode-decode a.inner
+take-prev char32(a string-iterator)
	unicode-decode-prev a.inner
+skip-next-n void(a string-iterator, n nat)
	for _ in 0 .. n
		_ = take-next a
+skip-prev-n void(a string-iterator, n nat)
	for _ in 0 .. n
		_ = take-prev a
+char8-index nat(a string-iterator)
	a.inner.index
+set-char8-index void(a string-iterator, index nat)
	a.inner.index := index
+slice string(a string-iterator, b string-iterator)
	slice a.inner, b.inner 'to

+string-builder record mut
	-inner char8 builder
+with-block string(a build-options, f void mut(out string-builder))
	chars char8[] = with out in build a.size-hint
		f[out,]
	chars.to
+~= void(a string-builder, value char32)
	unicode-encode value.to, of x
		push-byte a, x
+~~= void(a string-builder, s string)
	a.inner ~~= s.to::char8[]

region utilities

+invalid-unicode-character record(character nat32) exception case
+show string(a invalid-unicode-character)
	"0x{to-hex a.character} is not a valid Unicode character."
+unicode-decode-error record exception case
+show string(_ unicode-decode-error)
	"Error decoding bytes as UTF-8"

+join string(parts string[])
	join "", parts
| Equivalent to `{parts}[0] ~~ {joiner} ~~ {parts}[1] ~~ {joiner} ~~ ... ~~ {parts}[end - 1]`.
+join string(joiner string, parts string[])
	match parts.size
	as 0
		""
	as 1
		parts[0]
	else
		join-with-multiple-parts joiner, parts
-join-with-multiple-parts string(joiner string, parts string[])
	first mut bool = true
	do with out in build
	do for x in parts
	if first
		first := false
	else
		out ~~= joiner
	out ~~= x

~unicode-encode void(a nat32, cb void mut(x nat8))
	if a < (1 << 7)
		cb[a.to]
	elif a < (1 << 11)
		cb[(a >> 6).to | first-byte-flags]
		cb[a.last-6-bits | byte-top-bit]
	elif a < (1 << 16)
		forbid a 'in 0xd800 .. 0xe000 else invalid-unicode-character a
		cb[(a >> 12).to | 0b1110_0000]
		cb[(a >> 6).last-6-bits | byte-top-bit]
		cb[a.last-6-bits | byte-top-bit]
	else
		assert a < 0x110000 else invalid-unicode-character a
		cb[(a >> 18).to | 0b1111_0000]
		cb[(a >> 12).last-6-bits | byte-top-bit]
		cb[(a >> 6).last-6-bits | byte-top-bit]
		cb[a.last-6-bits | byte-top-bit]
-push-byte void(out string-builder, a nat8)
	out.inner ~= a.to

~unicode-decode char32(iter char8 array-iterator)
	first-char = take-next iter
	if is-valid-single-byte-character first-char
		first-char.to
	else
		assert is-first-byte first-char else unicode-decode-error
		res mut nat32 = first-char.to::nat8.to
		flag mut nat8 = first-char.to << 1
		result char32? = first 1::nat64 .. 4, of i
			next-char = try-take-next iter else throw unicode-decode-error
			code nat8 = next-char.to
			assert (code & first-byte-flags) == byte-top-bit else unicode-decode-error
			res := (res << 6) | code.to.last-6-bits
			flag <<:= 1
			do if (flag & 0x80) == 0
			assert bits-intersect res, ~(i - 1).mask else unicode-decode-error
			res &:= i.mask
			assert is-valid-unicode-character res else unicode-decode-error
			res.to
		result else throw unicode-decode-error

-mask nat32(i nat64)
	match i
	as 0
		(1 << 7) - 1
	as 1
		(1 << 11) - 1
	as 2
		(1 << 16) - 1
	as 3
		(1 << 21) - 1
	else
		throw unreachable

-unicode-decode-prev char32(iter char8 array-iterator)
	first-char = take-prev iter
	if is-valid-single-byte-character first-char
		first-char.to
	else
		result = first 1::nat64 .. 4, of _
			prev-char = try-take-prev iter else throw unicode-decode-error
			if is-first-byte prev-char
				unicode-decode iter.copy
		result else throw unicode-decode-error

-last-6-bits nat32(a nat32)
	a & 0b111111
-last-6-bits nat8(a nat32)
	a.last-6-bits.to

-first-byte-flags nat8()
	0b1100_0000
-is-first-byte bool(a char8)
	has-all-bits a.to::nat8, first-byte-flags

~is-valid-single-byte-character bool(a char8)
	a.to::nat8 < 0b1000_0000

-byte-top-bit nat8()
	0x80

-is-valid-unicode-character bool(a nat32)
	a < 0xd800 or a 'in 0xe000 .. 0x110000

+is-valid-unicode-character bool(a char32)
	is-valid-unicode-character a.to

region conversion

+to string(a String) java
	to safe-reinterpret-cast trusted cast-immutable a.getBytes
+to string(a js-any) js
	trusted
	assert a.typeof == "string" else
		error "Value is not a string. Actual typeof: {a.typeof.to::string}"
	- assume-type call-property "TextEncoder".js-global.call-new, "encode", a

+to String(a string) java
	trusted
	- cast-mutable a.chars.safe-reinterpret-cast::int8[]
+to js-any(a string) js
	trusted call-property "TextDecoder".js-global.call-new, "decode", a.chars.as-js

+safe-reinterpret-cast char8 array-view(a nat8 array-view)
	a.inner.safe-reinterpret-cast, a.low, a.high
