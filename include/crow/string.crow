+to-hex string(a nat8)
	a.to::nat64 to-hex
+to-hex string(a nat16)
	a.to::nat64 to-hex
+to-hex string(a nat32)
	a.to::nat64 to-hex
+to-hex string(a nat64)
	a to-base 16

-to-base string(a nat64, base nat64)
	if a < base
		a digit-to-string
	else
		(a / base to-base base) ~~ (a % base).digit-to-string

+show string(a string)
	a

+show string(a nat8)
	a.to::nat64 show

+show string(a nat16)
	a.to::nat64 show

+show string(a nat32)
	a.to::nat64 show

+show string(a int8)
	a.to::int64 show

+show string(a int16)
	a.to::int64 show

+show string(a int32)
	a.to::int64 show

+show string(a int64)
	if a == min-value
		"-9223372036854775808"
	else
		s string = "{a abs}"
		if a < 0 then "-{s}" else s

+show string(a float32)
	a.to::float64 show

+show string(a float64)
	trusted if java
		a.valueOf.to strip-point-0
	elif js
		a.to js-to-string
	else
		throw todo
-strip-point-0 string(a string)
	a try-remove-end ".0" else a

+iterate bool(a string, f bool mut(x char32))
	iter = a.to::char8[] begin
	loop
		next char32? = try
			iter unicode-decode
		catch as iterator-out-of-bounds
			()
		guard next else break false
		# TODO: `if f[x] then break true else continue` should parse
		if f[next]
			break true
		else
			continue
+iterate-reverse bool(a string, f bool mut(x char32))
	iter = a.to::char8[] end
	loop
		prev char32? = try
			iter unicode-decode-prev
		catch as iterator-out-of-bounds
			()
		guard prev else break false
		# TODO: `if f[x] then break true else continue` should parse
		if f[prev]
			break true
		else
			continue

| NOTE: More helpful functions are in 'crow/parse'
+string-iterator record mut
	~inner char8 array-iterator
+begin string-iterator(a string)
	a.to::(char8 array-view) begin
+begin string-iterator(a char8 array-view)
	a.begin,
+end string-iterator(a string)
	a.to::(char8 array-view) end
+end string-iterator(a char8 array-view)
	a.end,
+copy string-iterator(a string-iterator)
	a.inner.copy,
+is-at-end bool(a string-iterator) # TODO: this should be a generic function on iterators .......................................................
	a.inner is-at-end
+take-char8 char8(a string-iterator)
	a.inner take-next
+take-next char32(a string-iterator)
	a.inner unicode-decode
+take-prev char32(a string-iterator)
	a.inner unicode-decode-prev
+skip-next-n void(a string-iterator, n nat)
	for _ in 0 .. n
		_ = a take-next
+skip-prev-n void(a string-iterator, n nat)
	for _ in 0 .. n
		_ = a take-prev
+char8-index nat(a string-iterator)
	a.inner index
+set-char8-index void(a string-iterator, index nat)
	a.inner.index := index
+slice string(a string-iterator, b string-iterator)
	a.inner slice b.inner to

+string-builder record mut
	-inner char8 builder
+with-block string(a build-options, f void mut(out string-builder))
	chars char8[] = with out in a.size-hint build
		f[out,]
	chars to
+~= void(a string-builder, value char32)
	value.to unicode-encode of x
		a push-byte x
+~~= void(a string-builder, s string)
	a.inner ~~= s.to::char8[]

region utilities

+invalid-unicode-character record(character nat32) exception case
+show string(a invalid-unicode-character)
	"0x{a.character to-hex} is not a valid Unicode character."
+unicode-decode-error record exception case
+show string(_ unicode-decode-error)
	"Error decoding bytes as UTF-8"

| Equivalent to `{parts}[0] ~~ {joiner} ~~ {parts}[1] ~~ {joiner} ~~ ... ~~ {parts}[end - 1]`.
+join string(joiner string, parts string[])
	match parts size
	as 0
		""
	as 1
		parts[0]
	else
		joiner join-with-multiple-parts parts
-join-with-multiple-parts string(joiner string, parts string[])
	first mut bool = true
	with out in build
		for x in parts
			if first
				first := false
			else
				out ~~= joiner
			out ~~= x

~unicode-encode void(a nat32, cb void mut(x nat8))
	if a < (1 << 7)
		cb[a to]
	elif a < (1 << 11)
		cb[(a >> 6).to | first-byte-flags]
		cb[a.last-6-bits | byte-top-bit]
	elif a < (1 << 16)
		forbid a in 0xd800 .. 0xe000 else a invalid-unicode-character
		cb[(a >> 12).to | 0b1110_0000]
		cb[(a >> 6).last-6-bits | byte-top-bit]
		cb[a.last-6-bits | byte-top-bit]
	else
		assert a < 0x110000 else a invalid-unicode-character
		cb[(a >> 18).to | 0b1111_0000]
		cb[(a >> 12).last-6-bits | byte-top-bit]
		cb[(a >> 6).last-6-bits | byte-top-bit]
		cb[a.last-6-bits | byte-top-bit]
-push-byte void(out string-builder, a nat8)
	out.inner ~= a to

~unicode-decode char32(iter char8 array-iterator)
	first-char = iter take-next
	if first-char is-valid-single-byte-character
		first-char to
	else
		assert first-char is-first-byte else unicode-decode-error
		res mut nat32 = first-char.to::nat8 to
		flag mut nat8 = first-char.to << 1
		result char32? = 1::nat64 .. 4 first of i
			next-char = iter try-take-next else throw unicode-decode-error
			code nat8 = next-char to
			assert (code & first-byte-flags) == byte-top-bit else unicode-decode-error
			res := (res << 6) | code.to.last-6-bits
			flag <<:= 1
			guard (flag & 0x80) == 0
			assert res bits-intersect ~(i - 1).mask else unicode-decode-error
			res &:= i.mask
			assert res is-valid-unicode-character else unicode-decode-error
			res to
		result else throw unicode-decode-error

-mask nat32(i nat64)
	match i
	as 0
		(1 << 7) - 1
	as 1
		(1 << 11) - 1
	as 2
		(1 << 16) - 1
	as 3
		(1 << 21) - 1
	else
		throw unreachable

-unicode-decode-prev char32(iter char8 array-iterator)
	first-char = iter take-prev
	if first-char is-valid-single-byte-character
		first-char to
	else
		result = 1::nat64 .. 4 first of _
			prev-char = iter try-take-prev else throw unicode-decode-error
			if prev-char is-first-byte
				iter.copy unicode-decode
		result else throw unicode-decode-error

-last-6-bits nat32(a nat32)
	a & 0b111111
-last-6-bits nat8(a nat32)
	a.last-6-bits.to

-first-byte-flags nat8()
	0b1100_0000
-is-first-byte bool(a char8)
	a.to::nat8 has-all-bits first-byte-flags

~is-valid-single-byte-character bool(a char8)
	a.to::nat8 < 0b1000_0000

-byte-top-bit nat8()
	0x80

-is-valid-unicode-character bool(a nat32)
	a < 0xd800 or a in 0xe000 .. 0x110000

+is-valid-unicode-character bool(a char32)
	a.to is-valid-unicode-character

region conversion

+to string(a String) java
	(trusted a.getBytes cast-immutable).safe-reinterpret-cast to
+to string(a js-any) js
	trusted
	assert a.typeof == "string" else
		"Value is not a string. Actual typeof: {a.typeof.to::string}" error
	- "TextEncoder".js-global.call-new call-property "encode", a assume-type

+to String(a string) java
	trusted
	- a.chars.safe-reinterpret-cast::int8[] cast-mutable
+to js-any(a string) js
	trusted "TextDecoder".js-global.call-new call-property "decode", a.chars.as-js

+safe-reinterpret-cast char8 array-view(a nat8 array-view)
	a.inner.safe-reinterpret-cast, a.low, a.high
