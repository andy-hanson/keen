+lines string[](a string)
	# TODO:PERF should be better (or at least just as good) with just `a split "\n"`
	for x in a.to::char32[] split ("\n",)
		(x try-remove-end "\r".to else x) to

| Lower cases every character in {a}.
+lower-case string(a string)
	for x in a then x lower-case

+lower-case char32(a char32)
	diff = a.to::nat32 wrap-sub "A"::char32.to
	if diff < 26
		trusted "a"::char32.to + diff unsafe-to
	else
		a

| Capitalizes every character in {a}.
+upper-case string(a string)
	for x in a then x upper-case

+upper-case char32(a char32)
	diff = a.to::nat32 wrap-sub "a"::char32.to
	if diff < 26
		trusted "A"::char32.to + diff unsafe-to
	else
		a

+in bool(a char32, b string)
	b exists it == a

| Replaces every instance of the substring {find} with {replace-with}.
+replace-all string(a string, find string, replace-with string)
	# TODO:PERF
	if l, r ?= a try-split-once find
		l ~~ replace-with ~~ (r replace-all find, replace-with)
	else
		a

+pad-left string(a string, min-size nat64, padding char32)
	chars char32[] = a to
	if chars.size < min-size
		(min-size - chars.size n-of padding)::char32[] ~~ chars to
	else
		a
+pad-right string(a string, min-size nat64, padding char32)
	chars char32[] = a to
	if chars.size < min-size
		chars ~~ (min-size - chars.size n-of padding) to
	else
		a

| Strips whitespace from both ends.
+strip string(a string)
	a.strip-left strip-right

| Strips whitespace from the front.
+strip-left string(a string)
	a drop-while it.is-whitespace

| Strips whitespace from the end.
+strip-right string(a string)
	a drop-right-while it.is-whitespace

+is-whitespace bool(a char32)
	match a
	as " "
		true
	as "\r"
		true
	as "\n"
		true
	as "\t"
		true
	else
		false

+normalize-newlines string(a string)
	a replace-all "\r\n", "\n" replace-all "\r", "\n"

| Enclose a string in quotes and escape special characters.
+quote string(a string)
	with out in build
		out ~= "\""
		for x in a
			match x
			as "\""
				out ~~= "\\\""
			as "\n"
				out ~~= "\\n"
			as "\r"
				out ~~= "\\r"
			as "\t"
				out ~~= "\\t"
			as "\\"
				out ~~= "\\\\"
			else
				out ~= x
		out ~= "\""

+unindent string(a string)
	a replace-all "\t", ""

| Equivalent to `{parts}[0] ~~ {joiner} ~~ parts[1] ~~ {joiner} ~~ ... ~~ {parts}[end - 1]`.
+join string(joiner string, parts string[])
	match parts size
	as 0
		""
	as 1
		parts[0]
	else
		joiner join-with-multiple-parts parts
-join-with-multiple-parts string(joiner string, parts string[])
	first mut = true
	with out in build
		for x in parts
			if first
				first := false
			else
				out ~~= joiner
			out ~~= x

~unicode-encode void(a nat32, cb void mut(x nat8))
	if a < (1 << 7)
		cb[a to]
	elif a < (1 << 11)
		cb[(a >> 6).to | first-byte-flags]
		cb[a.last-6-bits | byte-top-bit]
	elif a < (1 << 16)
		forbid a in 0xd800 .. 0xe000 else a invalid-unicode-character
		cb[(a >> 12).to | 0b1110_0000]
		cb[(a >> 6).last-6-bits | byte-top-bit]
		cb[a.last-6-bits | byte-top-bit]
	else
		assert a < 0x110000 else a invalid-unicode-character
		cb[(a >> 18).to | 0b1111_0000]
		cb[(a >> 12).last-6-bits | byte-top-bit]
		cb[(a >> 6).last-6-bits | byte-top-bit]
		cb[a.last-6-bits | byte-top-bit]
-push-byte void(out string-builder, a nat8)
	out.inner ~= a to

~unicode-decode (char32, char8 array-iterator)(first-char char8, original-iter char8 array-iterator)
	if first-char is-valid-single-byte-character
		first-char.to, original-iter
	else
		assert first-char is-first-byte else unicode-decode-error
		iter mut = original-iter
		res mut nat32 = first-char.to::nat8 to
		flag mut nat8 = first-char.to << 1
		result (char32, char8 array-iterator)? = 1::nat64 .. 4 first of i
			next-char, next-iter = iter next else throw unicode-decode-error
			code nat8 = next-char to
			assert (code & first-byte-flags) == byte-top-bit else unicode-decode-error
			iter := next-iter
			res := (res << 6) | code.to.last-6-bits
			flag <<:= 1
			guard (flag & 0x80) == 0
			assert res bits-intersect ~(i - 1).mask else unicode-decode-error
			res &:= i.mask
			assert res is-valid-unicode-character else unicode-decode-error
			res.to, iter
		result else throw unicode-decode-error

-mask nat32(i nat64)
	match i
	as 0
		(1 << 7) - 1
	as 1
		(1 << 11) - 1
	as 2
		(1 << 16) - 1
	as 3
		(1 << 21) - 1
	else
		throw unreachable

-unicode-decode-prev (char8 array-iterator, char32)
	original-iter char8 array-iterator
	first-char char8
do
	if first-char is-valid-single-byte-character
		original-iter, first-char.to
	else
		iter mut = original-iter
		result = 1::nat64 .. 4 first of _
			prev-iter, prev-char = iter prev else throw unicode-decode-error
			if prev-char is-first-byte
				res, end-iter = prev-char unicode-decode iter
				assert end-iter == original-iter.next!.b
				prev-iter, res
			else
				iter := prev-iter
				()
		result else throw unicode-decode-error

-last-6-bits nat32(a nat32)
	a & 0b111111
-last-6-bits nat8(a nat32)
	a.last-6-bits.to

-first-byte-flags nat8()
	0b1100_0000
-is-first-byte bool(a char8)
	a.to::nat8 has-all-bits first-byte-flags

-is-valid-single-byte-character bool(a char8)
	a.to::nat8 < 0b1000_0000

-byte-top-bit nat8()
	0x80

-is-valid-unicode-character bool(a nat32)
	a < 0xd800 or a in 0xe000 .. 0x110000

+is-valid-unicode-character bool(a char32)
	a.to is-valid-unicode-character

