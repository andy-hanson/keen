export
	./private/bootstrap: char8, char32, string

+to char8(a nat8)
+to nat8(a char8)
+== bool(a char8, b char8)

+~~ string(a string, b string)
	a.to::char8[] ~~ b.to to
+~ string(a char32, b string)
	a.to ~~ b
+~ string(a string, b char32)
	a ~~ b.to

+interpolate-string string(a string)
	a
+interpolate-value[t] string(a t) t show
	a show
+interpolate string(parts string[])
	# TODO: this could just use 'flatten' from collection.crow if that had better perf .......................................
	res-size mut nat64 = 0
	for part in parts
		res-size +:= part.to::char8[].size
	res char8 mut-slice = trusted res-size gc-safe-mut-slice
	out-i mut nat64 = 0
	for part in parts
		chars char8[] = part to
		res[out-i .. out-i + chars.size] := chars
		out-i +:= chars.size
	assert out-i == res-size
	trusted res.cast-immutable to
+interpolate String(parts string[]) java
	parts.interpolate::string to
+interpolate js-any(parts string[]) js
	parts.interpolate::string to

| Same as `""`.
+new string()
	""

| Same as `{a} == ""`.
+is-empty bool(a string)
	a.to::char8[] is-empty

| Number of {char32}s in the string. This must walk and decode the string to count them.
+size nat64(a string)
	res mut nat64 = 0
	for _ in a
		res +:= 1
	res

+== bool(a string, b string)
	if trusted java
		trusted a.to::char8[].reinterpret-cast::(int8 mut-slice) equals b.to::char8[].reinterpret-cast
	else
		# TODO: ideally, this would have just as good performance. Would require letting it specialize on types.
		a.to::char8[] == b.to
+== bool(a char32, b char32)
+to nat32(a char32)
| This is unsafe because a {char32} should be a valid unicode character.
+unsafe-to char32(a nat32) unsafe
+to char32(a nat32)
	assert a is-valid-unicode-character
	trusted a unsafe-to

+<=> comparison(a string, b string)
	a.to::char8[] <=> b.to # TODO: this is same as the auto fun, so just use that? --------------------------------------------------------
+<=> comparison(a char8, b char8)
	a.to::nat8 <=> b.to
+<=> comparison(a char32, b char32)
	a.to::nat32 <=> b.to

+hash void(a string, state hash-state)
	a.chars hash state
+hash void(a char8, state hash-state)
	a.to::nat8.to::nat64 hash state
+hash void(a char32, state hash-state)
	a.to::nat32.to::nat64 hash state

region conversion

-unsafe-to char32(a char8)
+to char32(a char8)
	assert a is-valid-single-byte-character
	a unsafe-to
+to char8(a char32)
	a.to::nat32.to::nat8.to

+to char8[](a string)
	a chars
+to char8 array-view(a string)
	a.chars to
+to char32[](a string)
	for x in a then x
+to string(a char32[])
	a.to to
+to string(a char32 array-view)
