use-prefix
no-std
import
	../exception
	../misc
	../number

# TODO: this should definitely just be a builtin type ----------------------------------------------------------------------------------------------
+lock record shared
	n0 nat64
	n1 nat64
	n2 nat64
	n3 nat64
	n4 nat64

+new lock()
	0, 0, 0, 0, 0

+with-block[t] t(_ lock, f t mut()) unsafe
	trusted
	assert js else todo
	f[]
