no-std
import
	../compare: comparison, equal, greater, less
	./bool-low-level: bool
export
	./bootstrap: float32, float64, int8, int16, int32, int64, nat8, nat16, nat32, nat64

+new nat8()
	0
+new nat16()
	0
+new nat32()
	0
+new nat64()
	0
+new int8()
	0
+new int16()
	0
+new int32()
	0
+new int64()
	0
+new float32()
	0
+new float64()
	0

+<=> comparison(a nat8, b nat8)
	a cmp b
+<=> comparison(a nat16, b nat16)
	a cmp b
+<=> comparison(a nat32, b nat32)
	a cmp b
+<=> comparison(a nat64, b nat64)
	a cmp b
+<=> comparison(a int8, b int8)
	a cmp b
+<=> comparison(a int16, b int16)
	a cmp b
+<=> comparison(a int32, b int32)
	a cmp b
+<=> comparison(a int64, b int64)
	a cmp b
+<=> comparison(a float64, b float64)
	a cmp b
+<=> comparison(a float32, b float32)
	a cmp b

-cmp[t] comparison(a t, b t) t less
	if a is-less b
		less
	elif a == b
		equal
	else
		greater

-less[t] spec
	is-less bool(a t, b t)
	== bool(a t, b t)

# These are internal since the compiler needs to refer to them
~is-less bool(a nat8, b nat8) builtin
~is-less bool(a nat16, b nat16) builtin
~is-less bool(a nat32, b nat32) builtin
~is-less bool(a nat64, b nat64) builtin
~is-less bool(a int8, b int8) builtin
~is-less bool(a int16, b int16) builtin
~is-less bool(a int32, b int32) builtin
~is-less bool(a int64, b int64) builtin
~is-less bool(a float32, b float32) builtin
~is-less bool(a float64, b float64) builtin
+== bool(a nat8, b nat8) builtin
+== bool(a nat16, b nat16) builtin
+== bool(a nat32, b nat32) builtin
+== bool(a nat64, b nat64) builtin
+== bool(a int8, b int8) builtin
+== bool(a int16, b int16) builtin
+== bool(a int32, b int32) builtin
+== bool(a int64, b int64) builtin
+== bool(a float32, b float32) builtin
+== bool(a float64, b float64) builtin

+unsafe-log float32(a float32) builtin, unsafe
+unsafe-log float64(a float64) builtin, unsafe

# ~unsafe-mod int64(a int64, b int64) builtin, unsafe # TODO ------------------------------------------------------------------
~unsafe-mod nat64(a nat64, b nat64) builtin, unsafe

+to int32(a int8)
	a.to::int64 wrap-to
+to int32(a int16)
	a.to::int64 wrap-to

+wrap-to int8(a int64) builtin
+wrap-to int8(a nat8)
	a.to.wrap-to::int64 wrap-to # TODO: this should be a builtin -----------------------------------------------------
+wrap-to int16(a int64) builtin
+wrap-to int16(a nat16)
	a.to.wrap-to::int64 wrap-to # TODO: this should be a builtin -----------------------------------------------------
+wrap-to int32(a int64) builtin
+wrap-to int32(a nat32)
	a.to.wrap-to::int64 wrap-to # TODO: this should be a builtin -----------------------------------------------------
+wrap-to int64(a nat64) builtin
+wrap-to nat8(a int8)
	a.to.wrap-to::nat64 wrap-to # TODO: this should be a builtin -----------------------------------------------------
+wrap-to nat8(a nat64) builtin
+wrap-to nat16(a int16)
	a.to.wrap-to::nat64 wrap-to # TODO: this should be a builtin -----------------------------------------------------
+wrap-to nat16(a nat64) builtin
+wrap-to nat32(a nat64) builtin
+wrap-to nat32(a int32) builtin
+wrap-to nat64(a int64) builtin

+to nat16(a nat8)
	a.to::nat64 wrap-to # TODO: this should be a builtin -------------------------------------------------------------------------
+to nat64(a nat8) builtin
+to nat64(a nat16) builtin
+to nat64(a nat32) builtin

+to int64(a int8) builtin
+to int64(a int16) builtin
+to int64(a int32) builtin

+wrap-add nat8(a nat8, b nat8) builtin
+wrap-add nat16(a nat16, b nat16) builtin
+wrap-add nat32(a nat32, b nat32) builtin
+wrap-add nat64(a nat64, b nat64) builtin

~wrap-add int8(a int8, b int8) builtin
~wrap-add int16(a int16, b int16) builtin
~wrap-add int32(a int32, b int32) builtin
~wrap-add int64(a int64, b int64) builtin

+wrap-sub nat8(a nat8, b nat8) builtin
+wrap-sub nat16(a nat16, b nat16) builtin
+wrap-sub nat32(a nat32, b nat32) builtin
+wrap-sub nat64(a nat64, b nat64) builtin

~wrap-sub int8(a int8, b int8) builtin
~wrap-sub int16(a int16, b int16) builtin
~wrap-sub int32(a int32, b int32) builtin
~wrap-sub int64(a int64, b int64) builtin

+wrap-mul nat8(a nat8, b nat8) builtin
+wrap-mul nat16(a nat16, b nat16) builtin
+wrap-mul nat32(a nat32, b nat32) builtin
+wrap-mul nat64(a nat64, b nat64) builtin

~wrap-mul int8(a int8, b int8) builtin
~wrap-mul int16(a int16, b int16) builtin
~wrap-mul int32(a int32, b int32) builtin
~wrap-mul int64(a int64, b int64) builtin

~unsafe-div nat8(a nat8, b nat8) builtin, unsafe
~unsafe-div nat16(a nat16, b nat16) builtin, unsafe
~unsafe-div nat32(a nat32, b nat32) builtin, unsafe
~unsafe-div nat64(a nat64, b nat64) builtin, unsafe
~unsafe-div int8(a int8, b int8) builtin, unsafe
~unsafe-div int16(a int16, b int16) builtin, unsafe
~unsafe-div int32(a int32, b int32) builtin, unsafe
~unsafe-div int64(a int64, b int64) builtin, unsafe

# Equivlaent to `a is-multiple-of 2`.
+is-even bool(a nat64)
	(trusted a unsafe-mod 2) == 0

region constants

# Least possible value for a type.
+min-value int8()
	-0x80
+min-value int16()
	-0x8000
+min-value int32()
	-0x80000000
+min-value int64()
	-0x8000000000000000

# Greatest possible value for a type.
+max-value int8()
	0x7f
+max-value int16()
	0x7fff
+max-value int32()
	0x7fffffff
+max-value int64()
	0x7fffffffffffffff
+max-value nat8()
	0xff
+max-value nat16()
	0xffff
+max-value nat32()
	0xffffffff
+max-value nat64()
	0xffffffffffffffff
