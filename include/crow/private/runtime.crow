import
	crow/unsafe
	java/lang/System
	java/lang/ThreadLocal
	java/util/concurrent/Executors
	java/util/concurrent/ExecutorService
	java/util/concurrent/locks/ReentrantLock

# Called by the compiler before 'main'
~start-runtime void() summon, unsafe, java extern
	cur-exclusion := ()::ThreadLocal

# Called by the compiler after 'main'
~stop-runtime void() summon, unsafe, java extern
	# TODO: should be able to do `executor?.shutdown` -------------------------------------------------------------------------
	if e ?= executor
		e shutdown
~stop-runtime void(exit-code nat) summon, unsafe, java extern
	if e ?= executor
		e shutdown
	if exit-code != 0
		exit-code.to::int32 exit

~unlocked-exclusion record
~with-block[t] t(_ unlocked-exclusion, f t mut()) summon, unsafe, java extern
	ex = get-cur-exclusion
	ex unlock
	finally ex lock
	f[]

# TODO: use a thread-local(ReentrantLock) (not global(ThreadLocal)) -------------------------------------------------------------------------------------------------------
-cur-exclusion global(ThreadLocal?)

-get-cur-exclusion ReentrantLock() trusted, java extern
	got = cur-exclusion! get
	if got reference-equal gc-safe-value
		res ReentrantLock = ()
		cur-exclusion! set res.reinterpret-cast
		res lock
		res
	else
		got reinterpret-cast

-change-exclusion-to ReentrantLock(new-exclusion ReentrantLock) trusted, java extern
	prev-exclusion = get-cur-exclusion
	prev-exclusion unlock
	cur-exclusion! set new-exclusion.reinterpret-cast
	new-exclusion lock
	prev-exclusion

~get-executor ExecutorService() summon, unsafe, java extern
	if e ?= executor
		e
	else
		res = 4 newFixedThreadPool
		executor := res
		res

-executor global(ExecutorService?)

| This is called by the compiler for `shared x => ...` lambdas.
~shared-of-mut-lambda[r, p] r shared(param p)(a r mut(param p)) r shared, p shared, trusted # TODO: this is wrong, make it right!
	assert extern java
	wrapper (r, p) force-lambda-shared = a, get-cur-exclusion
	param =>
		prev-exclusion = wrapper.exclusion change-exclusion-to
		finally do
			_ = prev-exclusion change-exclusion-to
		wrapper.fn[param]
-force-lambda-shared[r, p] record force-shared
	fn r mut(param p)
	exclusion ReentrantLock
