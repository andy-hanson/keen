| This module exists to give names from java Math unique names, so they can be used in Crow functions of the same name
no-std
import
	java/lang/Math
	./bootstrap: float64, int64, java

java-acos float64(a float64) java
	trusted acos a

java-asin float64(a float64) java
	trusted asin a

java-atan float64(a float64) java
	trusted atan a

java-atan2 float64(y float64, x float64) java
	trusted atan2 y, x

java-ceil float64(a float64) java
	trusted ceil a

java-cos float64(a float64) java
	trusted cos a

java-cosh float64(a float64) java
	trusted cosh a

java-floor float64(a float64) java
	trusted floor a

java-log float64(a float64) java
	trusted log a

java-pow float64(a float64, b float64) java
	trusted pow a, b

java-round int64(a float64) java
	trusted round a

java-sin float64(a float64) java
	trusted sin a

java-sinh float64(a float64) java
	trusted sinh a

java-tan float64(a float64) java
	trusted tan a

java-tanh float64(a float64) java
	trusted tanh a
