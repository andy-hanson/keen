| This module exists to give names from java Math unique names, so they can be used in Crow functions of the same name
no-std
import
	java/lang/Math
	./bootstrap: float64, int64

java-acos float64(a float64) trusted, java extern
	a acos

java-asin float64(a float64) trusted, java extern
	a asin

java-atan float64(a float64) trusted, java extern
	a atan

java-atan2 float64(y float64, x float64) trusted, java extern
	y atan2 x

java-ceil float64(a float64) trusted, java extern
	a ceil

java-cos float64(a float64) trusted, java extern
	a cos

java-cosh float64(a float64) trusted, java extern
	a cosh

java-floor float64(a float64) trusted, java extern
	a floor

java-log float64(a float64) trusted, java extern
	a log

java-pow float64(a float64, b float64) trusted, java extern
	a pow b

java-round int64(a float64) trusted, java extern
	a round

java-sin float64(a float64) trusted, java extern
	a sin

java-sinh float64(a float64) trusted, java extern
	a sinh

java-tan float64(a float64) trusted, java extern
	a tan

java-tanh float64(a float64) trusted, java extern
	a tanh
