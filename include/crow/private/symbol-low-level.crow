no-std
import
	../bool: bool
	../compare: comparison
	../java: ==, as-java, call-instance, java-cast
	../js: ==, as-js, js-cast
	../string: <=>, string
	./bootstrap: todo
export
	../private/bootstrap: symbol

+== bool(a symbol, b symbol) bare, trusted
	if extern java
		a.as-java == b.as-java
	elif extern js
		a.as-js == b.as-js
	else
		todo

| Same as `{a}.to::string <=> {b}.to::string`.
+<=> comparison(a symbol, b symbol)
	a.to::string <=> b.to

+to string(a symbol) trusted
	if extern java
		a java-cast
	elif extern js
		a js-cast
	else
		todo

| Interns a string.
| This is O(log n), where 'n' is the number of unique symbols that exist.
+to symbol(a string) trusted
	if extern java
		a call-instance "intern"
	elif extern js
		a js-cast
	else
		todo
