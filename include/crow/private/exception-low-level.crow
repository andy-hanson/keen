no-std
import
	../bool: false, true
	../java: as-java, call-static
	../js:
		+, as-js, await, call, call-property, cast, eval, instanceof, js-any, js-global, subscript
	../misc: new, subscript, void
	../result: new, ok, result, to
	../unsafe: gc-safe-value
	./bootstrap: abandoned, string
export
	./bootstrap: exception, show

+exception-and-backtrace record by-val # TODO: RM, just use 'exception' directly. ---------------------------------------------------
	exception exception

| Thrown when an exception is not specified in an `assert` or `forbid`.
+error record(show string) by-val, exception case

+catch-all[t] (t, exception-and-backtrace) result(tried t mut()) trusted # TODO: just support catching 'exception' so we don't need this
	if extern java
		res mut t = gc-safe-value
		ok mut = false
		cb void mut() = () =>
			res := tried[]
			ok := true
		# Unlike lambdas, function pointers reliably compile to `MethodHandle`s
		call-it-pointer void function(f void mut()) = &call-it
		caught exception = "Crow" call-static "catchAll", cb.as-java, call-it-pointer
		if ok
			res ok
		else
			((caught,),) to
	elif extern js
		f (t, exception-and-backtrace) result mut() = () =>
			tried[] ok
		error (t, exception-and-backtrace) result mut(e js-any) = e =>
			sample-error exception = "e" error
			exception-class = sample-error.as-js.prototype["constructor"]
			if e instanceof exception-class
				((e.cast,),) to
			else
				((e.threw-non-exception,),) to
		("""
			async (f, error) => \{
				try \{
					return await f()
				} catch (e) \{
					return error(e)
				}
			}
		""".eval call f, error).await cast
	else
		throw abandoned # This should throw 'todo' ------------------------------------------------------------------------------------

-call-it void(f void mut()) force-ctx
	f[]

| This can only happen in JS.
+threw-non-exception record(thrown js-any) exception case
+show string(a threw-non-exception) trusted
	if extern js
		"Threw a non-exception value " + a.thrown cast
	else
		"This message should not appear"

-prototype js-any(a js-any) unsafe, js extern
	"Object".js-global call-property "getPrototypeOf", a

| Fail unconditionally.
| This function is used to mark part of an `if` or `match` that should not be possible.
+unreachable[t] t() bare
	throw "Should be unreachable" error

| Throw an existing exception object.
| This is useful for `catch` branches that want to change their mind and not catch the exception.
| Rethrowing an exception does not modify its backtrace.
+rethrow[t] t(e exception-and-backtrace) bare, trusted # TODO: rm, I don't need this, can just use 'throw' directly .......
	throw e.exception
