| Parsing utilities common to both Crow and Crowd.
| Since this will be used in `json.crow`, its dependencies must be minimal.

no-std
import
	crow/bits
	crow/bool
	crow/col/array
	crow/col/collection
	crow/compare
	crow/hash
	crow/misc
	crow/number
	crow/option
	crow/parse
	../parse: is-digit
	crow/string
	../string: inner
	crow/symbol
	../symbol: to-symbol-with-hash

pos nat32(a string-iterator)
	a.char8-index to
set-pos void(a string-iterator, pos nat32)
	a.char8-index := pos to

peek8-next char8(a string-iterator)
	try
		copy = a copy
		_ = copy take-char8
		copy take-char8
	catch as iterator-out-of-bounds
		"\0"

take-char8-or-nul char8(a string-iterator)
	try
		a take-char8
	catch as iterator-out-of-bounds
		"\0"
try-take-char8 bool(a string-iterator, x char8)
	if a.peek8 == x
		_ = a take-char8
		true

starts-with-then-whitespace bool(a string-iterator, start string)
	copy = a copy
	copy try-take start and copy.peek8 is-whitespace

string-from string(a string-iterator, start-pos nat32)
	a slice-from start-pos to
slice-from char8 array-view(a string-iterator, start-pos nat32)
	start = a copy
	start.pos := start-pos
	start.inner slice a.inner

is-utf8-initial-or-continue-code bool(a char8)
	(a.to::nat8 & top-bit) != 0
-top-bit nat8()
	0b10000000

must-take-one-unicode-char char32(a string-iterator)
	try
		a take-next
	catch as unicode-decode-error
		_ = a take-char8
		"�"

decode-hex-digit nat8?(a char8)
	if "0"::char8 <= a and a <= "9"
		a.to - "0"::char8.to
	elif "a"::char8 <= a and a <= "f"
		10 + (a.to - "a"::char8.to)
	elif "A"::char8 <= a and a <= "F"
		10 + (a.to - "A"::char8.to)

| This does not check for keywords
try-take-crow-identifier symbol?(iter string-iterator)
	start = iter pos
	state hash-state = ()
	if iter try-take-initial-identifier-char state
		while iter try-take-one-identifier-char state
			()
		trusted iter slice-from start to-symbol-with-hash state.finish
-try-take-initial-identifier-char bool(iter string-iterator, state hash-state)
	if iter.peek8 is-initial-single-byte-identifier-char
		iter.take-char8 hash state
		true
	else
		iter try-take-unicode-identifier-char state
-try-take-one-identifier-char bool(iter string-iterator, state hash-state)
	if iter.peek8 is-single-byte-identifier-char
		iter.take-char8 hash state
		true
	else
		iter try-take-unicode-identifier-char state

-try-take-unicode-identifier-char bool(iter string-iterator, state hash-state)
	if iter.peek8 is-utf8-initial-or-continue-code
		before = iter pos
		x = iter must-take-one-unicode-char
		if x is-allowed-unicode-identifier-char
			iter slice-from before hash state
			true
		else
			iter.pos := before
			false

| True even for keywords
is-crow-identifier bool(a string)
	iter = a begin
	iter try-take-crow-identifier and iter is-at-end

-is-initial-single-byte-identifier-char bool(a char8)
	match a
	as "a" then true
	as "b" then true
	as "c" then true
	as "d" then true
	as "e" then true
	as "f" then true
	as "g" then true
	as "h" then true
	as "i" then true
	as "j" then true
	as "k" then true
	as "l" then true
	as "m" then true
	as "n" then true
	as "o" then true
	as "p" then true
	as "q" then true
	as "r" then true
	as "s" then true
	as "t" then true
	as "u" then true
	as "v" then true
	as "w" then true
	as "x" then true
	as "y" then true
	as "z" then true
	as "A" then true
	as "B" then true
	as "C" then true
	as "D" then true
	as "E" then true
	as "F" then true
	as "G" then true
	as "H" then true
	as "I" then true
	as "J" then true
	as "K" then true
	as "L" then true
	as "M" then true
	as "N" then true
	as "O" then true
	as "P" then true
	as "Q" then true
	as "R" then true
	as "S" then true
	as "T" then true
	as "U" then true
	as "V" then true
	as "W" then true
	as "X" then true
	as "Y" then true
	as "Z" then true
	as "_" then true
	else then false

-is-single-byte-identifier-char bool(a char8)
	match a
	as "a" then true
	as "b" then true
	as "c" then true
	as "d" then true
	as "e" then true
	as "f" then true
	as "g" then true
	as "h" then true
	as "i" then true
	as "j" then true
	as "k" then true
	as "l" then true
	as "m" then true
	as "n" then true
	as "o" then true
	as "p" then true
	as "q" then true
	as "r" then true
	as "s" then true
	as "t" then true
	as "u" then true
	as "v" then true
	as "w" then true
	as "x" then true
	as "y" then true
	as "z" then true
	as "A" then true
	as "B" then true
	as "C" then true
	as "D" then true
	as "E" then true
	as "F" then true
	as "G" then true
	as "H" then true
	as "I" then true
	as "J" then true
	as "K" then true
	as "L" then true
	as "M" then true
	as "N" then true
	as "O" then true
	as "P" then true
	as "Q" then true
	as "R" then true
	as "S" then true
	as "T" then true
	as "U" then true
	as "V" then true
	as "W" then true
	as "X" then true
	as "Y" then true
	as "Z" then true
	as "0" then true
	as "1" then true
	as "2" then true
	as "3" then true
	as "4" then true
	as "5" then true
	as "6" then true
	as "7" then true
	as "8" then true
	as "9" then true
	as "-" then true
	as "_" then true
	else then false

is-letter-or-digit bool(a char8)
	a is-letter or a is-digit
is-letter bool(a char8)
	a is-lower-case-letter or a is-upper-case-letter
-is-lower-case-letter bool(a char8)
	"a"::char8 <= a and a <= "z"
-is-upper-case-letter bool(a char8)
	"A"::char8 <= a and a <= "Z"

-is-allowed-unicode-identifier-char bool(a char32)
	a.to::nat32 is-allowed-unicode-identifier-char
-is-allowed-unicode-identifier-char bool(a nat32)
	# Latin extended
	if 0xc0::nat32 <= a and a <= 0xff and a != "×"::char32.to and a != "÷"::char32.to
		true
	# Greek and Coptic
	elif 0x370::nat32 <= a and a <= 0x3ff
		true
	# Cyrillic
	elif 0x400::nat32 <= a and a <= 0x4ff
		true
	# Hebrew
	elif 0x591::nat32 <= a and a <= 0x5f4
		true
	# Arabic
	elif 0x600::nat32 <= a and a <= 0x6ff
		true
	# Devanagari
	elif 0x904::nat32 <= a and a <= 0x97f and !(0x964::nat32 <= a and a <= 0x971)
		true
	# Bengali
	elif 0x985::nat32 <= a and a <= 0x9e3
		true
	# Gurmukhi
	elif 0xa01::nat32 <= a and a <= 0xa5e
		true
	# Gujarati
	elif 0xa81::nat32 <= a and a <= 0xaff
		true
	# Tamil
	elif 0xb82::nat32 <= a and a <= 0xbfa
		true
	# Telugu
	elif 0xc00::nat32 <= a and a <= 0xc7f
		true
	# Tibetan
	elif 0xf00::nat32 <= a and a <= 0xfda
		true
	# Latin extended additional
	elif 0x1e00::nat32 <= a and a <= 0x1eff
		true
	# Hiragana
	elif 0x3041::nat32 <= a and a <= 0x309f
		true
	# Katakana
	elif 0x30a0::nat32 <= a and a <= 0x30ff
		true
	# CJK Unified Ideographs
	elif 0x4e00::nat32 <= a and a <= 0x9fff
		true
	# Hangul
	elif 0xac00::nat32 <= a and a <= 0xd7a3
		true

indent-kind enum(tabs, spaces-2, spaces-4)
show string(a indent-kind)
	match a
	as tabs
		"tabs"
	as spaces-2
		"groups of 2 spaces"
	as spaces-4
		"groups of 4 spaces"

detect-indent-kind indent-kind(a string-iterator)
	iter = a copy
	loop
		begin = iter pos
		match iter peek8
		as "\0"
			break tabs
		as "\t"
			break tabs
		as " "
			while iter try-take-char8 " "
				()
			n = iter.pos - begin
			break if n == 2
				spaces-2
			else
				spaces-4
		else
			iter skip-until-newline
			_ = iter try-take-char8 "\n"
			continue

skip-until-newline void(a string-iterator)
	while a !is-at-end and a.peek8 != "\n"
		_ = a take-char8

take-indent-amount-after-newline nat32
	iter string-iterator
	indent-kind indent-kind
	add-diag void mut(pos nat32)
do
	match indent-kind
	as tabs
		iter take-indent-chars "\t", " ", add-diag
	as spaces-2
		iter take-indent-spaces 2, add-diag
	as spaces-4
		iter take-indent-spaces 4, add-diag
-take-indent-spaces nat32(iter string-iterator, n nat32, add-diag void mut(pos nat32))
	start = iter pos
	n-spaces = iter take-indent-chars " ", "\t", add-diag
	res = n-spaces / n
	if res * n != n-spaces
		add-diag[start]
	res
-take-indent-chars nat32(iter string-iterator, right-indent char8, wrong-indent char8, add-diag void mut(pos nat32))
	start = iter pos
	while iter try-take-char8 right-indent
		()
	res = iter.pos - start
	mid = iter pos
	if iter try-take-char8 wrong-indent
		while iter try-take-char8 wrong-indent
			()
		add-diag[mid]
	res
