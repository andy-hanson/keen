no-std
import
	./private/bootstrap: array, bool, mut-slice, nat32, string, void

+java-any builtin
+== bool(a java-any, b java-any) bare, builtin, unsafe, java extern

+java-null java-any() bare, builtin, unsafe, java extern

+as-java[t] java-any(a t) bare, builtin, unsafe, java extern
