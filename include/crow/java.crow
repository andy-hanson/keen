+call-static[r, p0, p1, p2] r(class_ string, name string, arg0 p0, arg1 p1, arg2 p2) bare, builtin, unsafe, java extern
+call-static[r, p0, p1, p2, p3] r(class_ string, name string, arg0 p0, arg1 p1, arg2 p2, arg3 p3) bare, builtin, unsafe, java extern
+call-static[r, p0, p1, p2, p3, p4] r(class_ string, name string, arg0 p0, arg1 p1, arg2 p2, arg3 p3, arg4 p4) bare, builtin, unsafe, java extern
+call-instance[r, o] r(object o, method-name string) bare, builtin, unsafe, java extern
