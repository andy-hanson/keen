+java-cast[out, in] out(a in) bare, unsafe, java extern
	a.as-java cast

+get-static-field java-any(class_ string, field string) bare, builtin, unsafe, java extern
+call-new java-any(class_ string, args java-any[]) bare, builtin, unsafe, java extern
+call-static-varargs[r] r(class_ string, name string, args java-any[]) bare, builtin, unsafe, java extern
+call-static[r] r(class_ string, name string) bare, builtin, unsafe, java extern
+call-static[r, p] r(class_ string, name string, arg p) bare, builtin, unsafe, java extern
