no-std
import
	./private/bootstrap: array, bool, mut-slice, nat32, string, void
export
	./private/bootstrap: java-any

+== bool(a java-any, b java-any) builtin, unsafe, java extern

+java-null java-any() builtin, unsafe, java extern

+as-java[t] java-any(a t) builtin, unsafe, java extern
+cast[t] t(a java-any) builtin, unsafe, java extern
+java-cast[out, in] out(a in) unsafe, java extern
	a.as-java cast

+java-class-of[t] java-any() builtin, unsafe, java extern

+get-static-field java-any(class_ string, field string) builtin, unsafe, java extern
+call-new java-any(class_ string) builtin, unsafe, java extern
+call-new[p] java-any(class_ string, arg0 p) builtin, unsafe, java extern
+call-new[p0, p1] java-any(class_ string, arg0 p0, arg1 p1) builtin, unsafe, java extern
+call-static-varargs[r] r(class_ string, name string, args java-any[]) builtin, unsafe, java extern
+call-static[r] r(class_ string, name string) builtin, unsafe, java extern
+call-static[r, p] r(class_ string, name string, arg p) builtin, unsafe, java extern
+call-static[r, p0, p1] r(class_ string, name string, arg0 p0, arg1 p1) builtin, unsafe, java extern
+call-static[r, p0, p1, p2] r(class_ string, name string, arg0 p0, arg1 p1, arg2 p2) builtin, unsafe, java extern
+call-static[r, p0, p1, p2, p3] r(class_ string, name string, arg0 p0, arg1 p1, arg2 p2, arg3 p3) builtin, unsafe, java extern
+call-static[r, p0, p1, p2, p3, p4] r(class_ string, name string, arg0 p0, arg1 p1, arg2 p2, arg3 p3, arg4 p4) builtin, unsafe, java extern
+call-instance[r, o] r(object o, method-name string) builtin, unsafe, java extern
+call-instance[r, o, p] r(object o, method-name string, arg p) builtin, unsafe, java extern
+call-instance[r, o, p0, p1] r(object o, method-name string, arg0 p0, arg1 p1) builtin, unsafe, java extern
+call-instance[r, o, p0, p1, p2] r(object o, method-name string, arg0 p0, arg1 p1, arg2 p2) builtin, unsafe, java extern

+java-new-array[t] t[](size nat32) builtin, unsafe, java extern
+java-new-array[t] t mut-slice(size nat32) builtin, unsafe, java extern

+java-array-get[t] t(a t[], index nat32) builtin, java extern
+java-array-get[t] t(a t mut-slice, index nat32) builtin, java extern
+java-array-set[t] void(a t mut-slice, index nat32, value t) builtin, java extern
