| Functions for operating on the individual bits in nats / ints.
|
| Bit indexes are counted from the right, so the least-siginificant digit is 0.
| So, the number 5 has bits 0 and 2 set, since 5 is `2**0 + 2**2`.

no-std
import
	java/lang/Long
	./bool
	./compare
	./exception
	./js
	./misc
	./number

| Negates every bit.
| 0 bits become 1 bits and vice versa.
+~ nat8(a nat8) builtin
+~ nat16(a nat16) builtin
+~ nat32(a nat32) builtin
+~ nat64(a nat64) builtin

| Intersection of bits; 'and's each corresponding bit in parallel.
| An output bit will be 1 iff both corresponding input bits are 1.
+& nat8(a nat8, b nat8) builtin
+& nat16(a nat16, b nat16) builtin
+& nat32(a nat32, b nat32) builtin
+& nat64(a nat64, b nat64) builtin
+& int8(a int8, b int8) builtin
+& int16(a int16, b int16) builtin
+& int32(a int32, b int32) builtin
+& int64(a int64, b int64) builtin

| Union of bits; 'or's each corresponding bit in parallel.
| An output bit will be 1 iff either corresponding input bit is 1.
+| nat8(a nat8, b nat8) builtin
+| nat16(a nat16, b nat16) builtin
+| nat32(a nat32, b nat32) builtin
+| nat64(a nat64, b nat64) builtin
+| int8(a int8, b int8) builtin
+| int16(a int16, b int16) builtin
+| int32(a int32, b int32) builtin
+| int64(a int64, b int64) builtin

| Performs exclusive or of each bit in parallel.
| Output bits will be 1 iff the corresponding input bits are not equal.
+^ nat8(a nat8, b nat8) builtin
+^ nat16(a nat16, b nat16) builtin
+^ nat32(a nat32, b nat32) builtin
+^ nat64(a nat64, b nat64) builtin
+^ int8(a int8, b int8) builtin
+^ int16(a int16, b int16) builtin
+^ int32(a int32, b int32) builtin
+^ int64(a int64, b int64) builtin

| Shifts the bits of 'a' left by 'b' bits.
| Does not rotate.
+<< nat8(a nat8, b nat8)
	guard b < 8
	trusted a.to unsafe-bit-shift-left b.to wrap-to
+<< nat16(a nat16, b nat16)
	guard b < 16
	trusted a.to unsafe-bit-shift-left b.to wrap-to
+<< nat32(a nat32, b nat32)
	guard b < 32
	trusted a unsafe-bit-shift-left b
+<< nat64(a nat64, b nat64)
	guard b < 64
	trusted a unsafe-bit-shift-left b

+rotate-left nat64(a nat64, amount nat64)
	n = amount % 64
	(a << n) | (a >> (64 wrap-sub n))
+rotate-right nat64(a nat64, amount nat64)
	n = amount % 64
	(a >> n) | (a << (64 wrap-sub n))

| Shifts the bits of {a} right by {b} bits.
| Does not rotate.
+>> nat8(a nat8, b nat8)
	guard b < 8
	trusted a.to unsafe-bit-shift-right b.to wrap-to
+>> nat16(a nat16, b nat16)
	guard b < 16
	trusted a.to unsafe-bit-shift-right b.to wrap-to
+>> nat32(a nat32, b nat32)
	guard b < 32
	trusted a unsafe-bit-shift-right b
+>> nat64(a nat64, b nat64)
	guard b < 64
	trusted a unsafe-bit-shift-right b
+>> int32(a int32, b int32)
	assert a >= 0 else todo
	assert b >= 0 else todo
	assert b < 32 else todo
	a.to::int64 >> b.to wrap-to
+>> int64(a int64, b int64)
	assert a >= 0 else todo
	assert b >= 0 else todo
	assert b < 64 else todo
	trusted a.wrap-to unsafe-bit-shift-right b.wrap-to wrap-to

| True iff the numbers have at least one bit in common.
+bits-intersect bool(a nat16, b nat16)
	a & b != 0
+bits-intersect bool(a nat32, b nat32)
	a & b != 0
+bits-intersect bool(a nat64, b nat64)
	a & b != 0

| True if for every 1 bit in `b`, the corresponding bit in `a` is also a 1.
+has-all-bits bool(a nat8, b nat8)
	a & b == b
+has-all-bits bool(a nat16, b nat16)
	a & b == b
+has-all-bits bool(a nat32, b nat32)
	a & b == b
+has-all-bits bool(a nat64, b nat64)
	a & b == b

| Unsafe because {b} should be < 32
-unsafe-bit-shift-left nat32(a nat32, b nat32) builtin, unsafe
| Unsafe because {b} should be < 32
-unsafe-bit-shift-right nat32(a nat32, b nat32) builtin, unsafe
| Unsafe because {b} should be < 64
-unsafe-bit-shift-left nat64(a nat64, b nat64) builtin, unsafe
| Unsafe because {b} should be < 64
-unsafe-bit-shift-right nat64(a nat64, b nat64) builtin, unsafe

| Number with only the bit at `bit-index` set.
| Same as `1 << bit-index`.
+nth-bit nat64(bit-index nat64)
	1 << bit-index

| True if the bit at `bit-index` is set.
+has-bit bool(a nat64, bit-index nat64)
	a bits-intersect bit-index.nth-bit

| Sets the bit at `bit-index` to 1.
+add-bit nat64(a nat64, bit-index nat64)
	a | bit-index.nth-bit

| Sets the bit at `bit-index` to 0.
+sub-bit nat64(a nat64, bit-index nat64)
	a & ~bit-index.nth-bit

| Returns the number of 1 bits in `a`.
+count-ones nat64(a nat64)
	if trusted extern java
		trusted a.wrap-to.bitCount.to::int64 to
	else
		res mut nat64 = 0
		x mut = a
		until x == 0
			res +:= x & 1
			x >>:= 1
		res

one-bits record(bits nat64)
| Calls `f` on the index of each `1` bit.
iterate bool(a one-bits, f bool mut(bit nat64))
	cur mut = a bits
	offset mut nat64 = 0
	loop
		if cur == 0
			break false
		elif cur bits-intersect 1 and f[offset]
			break true
		else
			cur >>:= 1
			offset +:= 1
			continue

+bits-cat nat16(a nat8, b nat8)
	a.to << 8 | b.to
+bits-cat nat32(a nat16, b nat16)
	a.to << 16 | b.to
| Concatenates two 32-bit numbers to a 64-bit number.
| `a` will be the high bits and `b` will be the low bits.
+bits-cat nat64(a nat32, b nat32)
	a.to << 32 | b.to

| Number with the highest `n` bits set.
+high-n-bits nat32(n nat32)
	assert n <= 32 else n.to unary-out-of-range
	~(32 wrap-sub n).low-n-bits
+high-n-bits nat64(n nat64)
	assert n <= 64 else n unary-out-of-range
	~(64 wrap-sub n).low-n-bits

| Number with the lowest `n` bits set.
+low-n-bits nat32(n nat32)
	assert n <= 32 else n.to unary-out-of-range
	guard n != 32 else 0xffffffff
	(trusted 1 unsafe-bit-shift-left n) wrap-sub 1
+low-n-bits nat64(n nat64)
	assert n <= 64 else n unary-out-of-range
	guard n != 64 else 0xffffffffffffffff
	(trusted 1 unsafe-bit-shift-left n) wrap-sub 1

+log-2-rounded-down nat64(a nat64)
	guard a != 0
	trusted if extern java
		63 wrap-sub a.wrap-to.numberOfLeadingZeros.to::int64.to
	elif extern js
		binary = a.to call-property "toString", 2
		binary["length"].to::nat32.to - 1
	else
		throw todo

+round-up-to-power-of-two nat64(a nat64)
	trusted if extern java
		h nat64 = a.wrap-to.highestOneBit wrap-to
		if h == a
			if a == 0 then 1 else a
		else
			res = h unsafe-bit-shift-left 1
			forbid res == 0 else a unary-out-of-range
			res
	else
		x mut nat64 = a wrap-sub 1
		x |:= x unsafe-bit-shift-right 1
		x |:= x unsafe-bit-shift-right 2
		x |:= x unsafe-bit-shift-right 4
		x |:= x unsafe-bit-shift-right 8
		x |:= x unsafe-bit-shift-right 16
		x |:= x unsafe-bit-shift-right 32
		x wrap-add:= 1
		if x == 0
			assert a == 0 else a unary-out-of-range
			1
		else
			x
