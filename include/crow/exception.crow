no-std
import
	./js: as-js, await, call, call-property, cast, eval, instanceof, js-any, js-global, subscript
	./misc: new, subscript
	./result: fail, new, ok, result
	./private/bootstrap: string
export
	./private/bootstrap: exception, show

+todo record exception case
+show string(_ todo)
	"TODO"

+not-implemented record exception case # TODO: this is basically just 'todo' then?? Or maybe I should call this 'not-supported' to indicate that it's intentional
+show string(_ not-implemented)
	"The operation is not implemented on this platform."

| Thrown when an exception is not specified in an `assert` or `forbid`.
+error record(show string) exception case

+catch-all[t] (t, exception) result(tried t mut()) trusted, js extern # TODO: remove this, just support cathing 'exception' -----------------------------------------------------------------------------
	f (t, exception) result mut() = () =>
		tried[] ok
	error (t, exception) result mut(e js-any) = e =>
		(e.ensure-exception,)::(exception fail)
	("""
		async (f, error) => \{
			try \{
				return await f()
			} catch (e) \{
				return error(e)
			}
		}
	""".eval call f, error).await cast

-ensure-exception exception(a js-any) trusted, js extern
	sample-error exception = "e" error
	# TODO: isn't this guaranteed to be "Error"? -----------------------------------------------------------------------------------
	exception-class = sample-error.as-js.prototype["constructor"]
	if a instanceof exception-class
		a cast
	else
		a threw-non-exception

| This can only happen in JS.
+threw-non-exception record(thrown js-any) exception case
+show string(_ threw-non-exception) trusted
	"Threw a non-exception value"

-prototype js-any(a js-any) unsafe, js extern
	"Object".js-global call-property "getPrototypeOf", a

+unreachable record exception case
+show string(_ unreachable)
	"Should be unreachable"
