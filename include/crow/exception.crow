no-std
import
	./result: fail, ok, result, value
	./string: string
export
	./private/exception-low-level:
		catch-all, error, exception, exception-and-backtrace, rethrow, show,
		threw-non-exception, thrown, unreachable

+todo record exception case
+show string(_ todo)
	"TODO"

+not-implemented record exception case # TODO: this is basically just 'todo' then?? Or maybe I should call this 'not-supported' to indicate that it's intentional
+show string(_ not-implemented)
	"The operation is not implemented on this platform."

+force[t] t(a (t, exception-and-backtrace) result)
	match a
	as ok v
		v value
	as fail e
		e.value rethrow
