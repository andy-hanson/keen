no-std
import
	./compare: comparison, equal, greater, less
	./private/bootstrap: nat64
export
	./private/bootstrap: bool, false, true

+new bool()
	false

| Changes {true} to {false}, and {false} to {true}.
+not bool(a bool) builtin

| If {a} is {false}, returns {false} immediately and does not evaluate {b}.
| Else, returns {b}.
+&& bool(a bool, b bool) builtin

###
If {a} is {true}, returns {true} immediately and does not evaluate {b}.
Else, returns {b}.
###
+|| bool(a bool, b bool) builtin

+== bool(a bool, b bool) builtin

| Compares {false} less than {true}.
+<=> comparison(a bool, b bool)
	if a
		b ? equal : greater
	else
		b ? less : equal

+to nat64(a bool)
	a ? 1 : 0
