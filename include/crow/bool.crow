no-std
import
	./compare: comparison
	./private/number-low-level: ==, <=>, nat64, new
export
	./private/bool-low-level: &&, ||, bool, false, not, true

+new bool() bare
	false

+== bool(a bool, b bool) bare
	a.to == b.to

| Compares {false} less than {true}.
+<=> comparison(a bool, b bool) bare
	a.to <=> b.to

| 0 for {false}, 1 for {true}.
+to nat64(a bool) bare
	a ? 1
