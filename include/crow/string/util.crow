import
	crow/parse

+lines string[](a string)
	# TODO:PERF should be better (or at least just as good) with just `a split "\n"`
	for x in a.to::char32[] split ("\n",)
		(x try-remove-end "\r".to else x) to

| Lower cases every character in {a}.
+lower-case string(a string)
	for x in a then x lower-case

+lower-case char32(a char32)
	diff = a.to::nat32 wrap-sub "A"::char32.to
	if diff < 26
		trusted "a"::char32.to + diff unsafe-to
	else
		a

| Capitalizes every character in {a}.
+upper-case string(a string)
	for x in a then x upper-case

+upper-case char32(a char32)
	diff = a.to::nat32 wrap-sub "a"::char32.to
	if diff < 26
		trusted "A"::char32.to + diff unsafe-to
	else
		a

| Replaces every instance of the substring {find} with {replace-with}.
+replace-all string(a string, find string, replace-with string)
	# TODO:PERF
	if l, r ?= a try-split-once find
		l ~~ replace-with ~~ (r replace-all find, replace-with)
	else
		a

+pad-left string(a string, min-size nat64, padding char32)
	chars char32[] = a to
	if chars.size < min-size
		(min-size - chars.size n-of padding)::char32[] ~~ chars to
	else
		a
+pad-right string(a string, min-size nat64, padding char32)
	chars char32[] = a to
	if chars.size < min-size
		chars ~~ (min-size - chars.size n-of padding) to
	else
		a

| Strips whitespace from both ends.
+strip string(a string)
	a.strip-left strip-right

| Strips whitespace from the front.
+strip-left string(a string)
	a.to::char8[] drop-while it.is-whitespace to

| Strips whitespace from the end.
+strip-right string(a string)
	a.to::char8[] drop-right-while it.is-whitespace to

+quoted string(a string)
	a to-json

+string-reverse record(inner string)
+reverse string-reverse(a string)
	a,
+size nat64(a string-reverse)
	a.inner size
+iterate bool(a string-reverse, f bool mut(x char32))
	iter mut = a.inner end
	loop
		guard prev, x ?= iter prev else break
		if f[x]
			break true
		else
			iter := prev
			continue
+to string(a string-reverse)
	for x in a then x
