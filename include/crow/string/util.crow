import
	crow/parse

+lines string[](a string)
	# TODO:PERF should be better (or at least just as good) with just `a split "\n"`
	for x in split a.to::char8[], ("\n",)
		(try-remove-end x, "\r"::char8[] else x).to

| Lower cases every character in {a}.
+lower-case string(a string)
	map::char8[] a, it.lower-case 'to

+lower-case char8(a char8)
	diff = a.to::nat8 'wrap-sub "A"::char8.to
	if diff < 26
		"a"::char8.to + diff 'to
	else
		a

| Capitalizes every character in {a}.
+upper-case string(a string)
	map::char8[] a, it.upper-case 'to

+upper-case char8(a char8)
	diff = a.to::nat8 'wrap-sub "a"::char8.to
	if diff < 26
		"A"::char8.to + diff 'to
	else
		a

| Replaces every instance of the substring {find} with {replace-with}.
+replace-all string(a string, find string, replace-with string)
	cur mut string-view = a.to
	do with out in build
	loop
		if l, r = try-split-once cur, find.to::char8[]
			out ~~= l
			out ~~= replace-with.to
			cur := r
			continue
		else
			out ~~= cur
			break

| Strips whitespace from both ends.
+strip string(a string)
	strip-right strip-left a

| Strips whitespace from the front.
+strip-left string(a string)
	drop-while a.to::char8[], it.is-whitespace 'to

| Strips whitespace from the end.
+strip-right string(a string)
	drop-right-while a.to::char8[], it.is-whitespace 'to

+quoted string(a string)
	to-json a
