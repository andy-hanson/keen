no-std
import
	./bool: bool, true
	./private/bootstrap: new-reference, new-void, reference-value, set-reference-value
	./compare: comparison, equal
export
	./private/bootstrap: reference, void

+new void() bare
	new-void
+== bool(_ void, _ void) bare
	true
+<=> comparison(_ void, _ void) bare
	equal

+new[t] spec
	new t()

+copy[t] spec
	copy t(a t)

| Spec for functions that convert `in` to `out`.
+to[out, in] spec
	to out(a in)

+break-or-continue[t] union(t loop-break, loop-continue)
+loop-break[t] record(value t)
+loop-continue record
| Default is to 'continue'
+new[t] t break-or-continue()
	continue

| Specifies that a type must be immutable data.
|
| This includes most types in crow that are not `mut`.
|
| To put it another way, a type works with `data` if it is:
| * A primitive like `nat`, an `enum`, or `flags`.
| * A record with no `mut` fields, whose fields are all `data`.
| * A union whose member types are all `data`.
| * Immutable collections like `x[]`, where the type arguments are all `data`.
| * A constant pointer like `nat*`.
+data[t] spec builtin

| Specifies that a type must be safe to share between tasks that may run in parallel.
| Anything that satisfies `data` satisfies `shared`.
+shared[t] spec builtin

| Calls the function and returns its return value.
+subscript[r, p] r(a r function(x p), params p) builtin, bare
+subscript[r, p] r(a r data(x p), params p) builtin
+subscript[r, p] r(a r shared(x p), params p) builtin
+subscript[r, p] r(a r mut(x p), params p) builtin

+new[t] t reference(value t)
	value new-reference
+*[t] t(a t reference)
	a reference-value
+set-deref[t] void(a t reference, value t)
	a.reference-value := value
