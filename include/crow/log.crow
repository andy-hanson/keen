no-std
import
	java/io/PrintStream
	java/lang/System
	./exception
	./js: call-property, js-global
	./misc: new, subscript, void
	./string: interpolate, show, string, to-java-string, to-js-string

| Log severity.
| The log handler can use this any way it wants.
| The default log handler just prints the level at the beginning of each log.
+log-level enum
	| Temporary log for debugging.
	debug
	| Any log message not fitting in other levels can be 'info'.
	info
	| This is useful for anything that seems like it might be a problem in the future.
	| For example: Something took an unusually long time; or a resource like memory is running low.
	warn
	| An error is for when something has gone wrong (but wasn't worthy of an exception).
	| For example: An HTTP request that is expected to normally succeed failed.
	error

| Represents a single call to `log`.
+logged record(level log-level, message string)

| Function that handles a log message.
| For example, this might write it to the console.
+log-handler alias
	void shared(logged logged)

| Sends a log to the current log handler.
| By default, this means the message is logged to the console.
|
| This is not considered `summon` since the I/O is done by the log handler,
| which is passed in via the crow context. A {temp-log-handler} can change it.
+log void(level log-level, message string)
	if trusted extern js
		trusted
			content string = "{level}: {message}"
			_ = "console".js-global call-property level.show, content.to-js-string
	else
		get-log-handler[level, message]

+temp-log-handler record(handler log-handler) shared
| Temporarily replaces the log handler.
+with-block[t] t(_ temp-log-handler, _ t mut())
	throw if trusted extern js
		not-implemented # For performance, log handler in JS is hardcoded
	else
		todo # TODO: I should be able to use a 'thread-local' for the log handler now. -----------------------------------

# TODO: this is what 'show' in enum.crow would do, is there a way to use that?
-show string(a log-level)
	match a
	as debug
		"debug"
	as info
		"info"
	as warn
		"warn"
	as error
		"error"

| This gets the current log handler.
| This is useful if you want to use a {temp-log-handler} to add a little extra information,
| then fall back to the original log handler.
+get-log-handler log-handler() 
	trusted if extern java
		# TODO: support setting a current log handler ............................................................................
		logged =>
			content string = "{logged level}: {logged message}"
			stream PrintStream = match logged level
			as debug
				out
			as info
				out
			as warn
				err
			as error
				err
			# TODO: reuse code from crow/io/print -----------------------------------------------------------------------------
			stream println content.to-java-string
	elif extern js
		throw not-implemented # For performance, log handler in JS is hardcoded
	else
		throw todo
