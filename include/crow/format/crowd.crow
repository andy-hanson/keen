import
	../parse
	../../compiler/util/parse-util
	../../compiler/frontend/parse/lexer
	../../compiler/frontend/parse/lex-string
	../../compiler/frontend/parse/lex-token
	../../compiler/frontend/parse/parse-util
	../../compiler/frontend/parse/token
	../../compiler/model/parse-diag
	../../compiler/model/source-range
	../../compiler/model/uri

+crowd json grammar()
	func: of iter
		lexer lexer = (), iter
		try
			while lexer try-take-token newline-same-indent
				()
			res = lexer parse-crowd false
			while lexer try-take-token newline-same-indent
				()
			assert lexer try-take-token end-of-file else "End of file" inner-parse-error
			diagnostics = lexer finish-diagnostics
			assert diagnostics is-empty else
				error log diagnostics.to::json.to-json
				todo # We should not call functions that add to diagnostics
			res
		catch crowd-parse-error x
			iter set-pos x.pos
			throw "Crowd value" inner-parse-error

-== bool(a string-part-after, b string-part-after)

| Starting on a fresh line, parse a Crowd value, allowing multi-line values.
-parse-crowd json(lexer lexer, is-inner bool)
	start = lexer cur-pos
	token = lexer take-next-token
	match token token
	as quote-double
		s = lexer take-simple-string-after-quote
		if lexer try-take-token colon
			lexer parse-object s.to to
		else
			s to
	as literal-number
		text = lexer.ptr string-from start
		text.to.parse-float to
	as name
		token.as-symbol value-from-name else throw start crowd-parse-error
	as name-colon
		assert !is-inner else start crowd-parse-error
		lexer parse-object token.as-symbol to
	as operator
		assert !is-inner and token.as-symbol == "-" else start crowd-parse-error
		lexer.parse-list to
	as newline-indent
		assert is-inner else start crowd-parse-error
		res = lexer parse-crowd false
		assert lexer try-take-token newline-dedent else start crowd-parse-error
		res
	else
		throw start crowd-parse-error
| Parse a Crowd value that may appear in the middle of the line, such as after 'foo: '.
-parse-crowd-inner json(lexer lexer)
	lexer parse-crowd true

-parse-name-colon-or-string-colon symbol(lexer lexer)
	start = lexer cur-pos
	token = lexer take-next-token
	match token token
	as name-colon
		token as-symbol
	as quote-double
		res symbol = lexer.take-simple-string-after-quote to
		assert lexer try-take-token colon else start crowd-parse-error
		res
	else
		throw start crowd-parse-error

-take-simple-string-after-quote string(lexer lexer)
	start = lexer cur-pos
	x = lexer take-initial-string-part double
	assert x.after == done else start crowd-parse-error
	x text

-crowd-parse-error record(pos pos) exception case
-show string(_ crowd-parse-error)
	throw unreachable

-value-from-name json?(name symbol)
	match name
	as false
		false
	as true
		true
	as null
		null
	as empty-array
		()::json[] to
	as empty-object
		()::json[symbol] to
	else
		()

-parse-list json[](lexer lexer)
	with out in build
		out ~= lexer parse-crowd-inner
		while lexer try-take-token newline-same-indent and lexer !try-take-token end-of-file
			assert lexer try-take-operator "-" else lexer.cur-pos crowd-parse-error
			out ~= lexer parse-crowd-inner

-parse-object json[symbol](lexer lexer, first-name symbol)
	with out in build
		out ~= first-name, lexer.parse-crowd-inner
		while lexer try-take-token newline-same-indent and lexer !try-take-token end-of-file
			out ~= lexer.parse-name-colon-or-string-colon, lexer.parse-crowd-inner

test
	"null" roundtrip null
	"false" roundtrip false
	"true" roundtrip true
	"1" roundtrip 1
	"-1" roundtrip -1
	"\"hello\"" roundtrip "hello"
	"empty-array" roundtrip ()::json[].to
	"empty-object" roundtrip ()::json[symbol].to
	"- 1" roundtrip (1,)
	"a: 1" roundtrip
		a: 1
	"\"big key\": 1" roundtrip
		"big key": 1
	"""
- 1
- 2
	""" roundtrip (1, 2)
	"""
a: 1
b: 2
c: 3
	""" roundtrip
		a: 1
		b: 2
		c: 3

	crowd parse """
k:
	1
	""" is
		k: 1

	"""
k:
	- "v"
	""" roundtrip
		k: "v",
	"""
a:
	b:
		c: 1
	d: 2
	""" roundtrip do
		a:
			b:
				c: 1
			d: 2

-roundtrip void(text string, value json)
	crowd parse text is value
	value.to-crowd is text.strip
