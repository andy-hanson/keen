| Utilities for reading binary files

import
	crow/bits

+take16 nat16(a nat8 array-mut-iterator)
	a.take bits-cat a.take

+take32 nat32(a nat8 array-mut-iterator)
	a.take16 bits-cat a.take16

+take64 nat64(a nat8 array-mut-iterator)
	a.take32 bits-cat a.take32

| Takes a UTF8 string with a fixed size.
| The string will be cut at the first "\0", but this still takes all {n-bytes} unconditionally.
+take-string string(a nat8 array-mut-iterator, n-bytes nat)
	bytes = a take-n n-bytes
	(if index ?= bytes index-of 0 then bytes[0 .. index] else bytes) as-string
