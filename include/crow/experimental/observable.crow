import
	crow/col/shared-array
	../private/thread-utils
	../col/shared-array: unsafe-each
	../parallel

+atomic[t] record force-shared
	-lock mut lock
	-sequence mut nat
	-value mut t
-new[t] t atomic(value t)
	(), 0, value
+get[t] t(a t atomic)
	trusted with in a lock
		a value
+set[t] void(a t atomic, value t)
	trusted with in a lock
		a.sequence +:= 1
		a.value := value
+get-and-set[t] t(a t atomic, value t)
	trusted with in a lock
		res = a value
		a.sequence +:= 1
		a.value := value
		res

-get-with-sequence[t] (nat, t)(a t atomic)
	trusted with in a lock
		a.sequence, a.value
-compare-sequence-and-set[t] bool(a t atomic, sequence nat, value t)
	trusted with in a lock
		ok = a.sequence == sequence
		if ok
			a.sequence +:= 1
			a.value := value
		ok

# This will retry if the value changed during modification
+modify[t] t(a t atomic, cb t data(x t)) t equal
	loop
		sequence, old-value = a get-with-sequence
		new-value = cb[old-value]
		if a compare-sequence-and-set sequence, new-value
			break new-value
		else
			continue

test
	guard !(trusted java) # TODO ----------------------------------------------------------------------------------------------------------
	a nat atomic = 0,
	results nat[] = for x in 1::nat .. 10 parallel
		a get-and-set x
	(results ~ a.get).sort is (0 .. 10).to

###
This is the type for receiving events.
To send events, use 'events-out'.
###
+events[t] record shared
	-subscribers void shared(x t) shared[]

# Empty events object which will never have an event.
+new[t] t events()
	subscribers: ()

+subscribe[t] void(a t events, cb void shared(x t)) t shared
	a.subscribers ~= cb

# Create a new events object that is mapped from input events.
+for-loop[out-event, in-event] out-event events
	a in-event events
	f out-event mut(x in-event)
do in-event shared, out-event shared
	res out-event events-out = ()
	a subscribe shared of x
		res ~= f[x]
	res events

+events-out[t] record shared
	events t events

+new[t] t events-out() t shared
	events: ()

+~=[t] void(a t events-out, event t) t shared
	trusted a.events.subscribers unsafe-each of subscriber
		with in fire-and-forget
			subscriber[event]

# Unlike 'events', this has a current value.
+observable[t] record shared
	# TODO: The observable should potentially have an error state if a callback failed. Then 'get' should throw the error. --------------------------
	-value t atomic
	-events-out t events-out
+constant[t] t observable(a t)
	value: a,
	events-out: (),

+|[t, u] (t, u) observable(a t observable, b u observable) t shared, u shared
	cur-a mut = a get
	cur-b mut = b get
	res (t, u) mut-observable = (cur-a, cur-b),
	a subscribe shared of x
		cur-a := x
		res set (cur-a, cur-b)
	b subscribe shared of x
		cur-b := x
		res set (cur-a, cur-b)
	res observable

+events[t] t events(a t observable) t shared
	a.events-out events

+get[t] t(a t observable) t shared
	a.value get

+subscribe[t] void(a t observable, cb void shared(x t)) t shared
	a.events subscribe cb

+now-and-subscribe[t] void(a t observable, cb void shared(x t)) t shared
	cb[a get]
	a subscribe cb

+mut-observable[t] record shared
	observable t observable

+new[t] t mut-observable(initial t) t shared
	observable:
		value: initial,
		events-out: ()
+new[t] t mut-observable() t shared, t new
	- ()

+events[t] t events(a t mut-observable) t shared
	a.observable events

+get[t] t(a t mut-observable) t shared
	a.observable get

+set[t] void(a t mut-observable, value t) t shared
	a.observable.value set value
	a.observable.events-out ~= value

+modify[t] void(a t mut-observable, cb t data(x t)) t equal, t shared
	a set (a.observable.value modify cb)

+for-loop[output, input] output observable
	a input observable
	f output shared(x input)
do output shared, input shared
	res output mut-observable = f[a.value get],
	a now-and-subscribe of x
		res set f[x]
	res observable

| Unlike {for-loop}, this does not block on the first call to {f}.
| So it needs an {initial} value to use until {f} has completed the first time.
+map-non-blocking[output, input] output observable
	a input observable
	initial output
	f output shared(x input)
do output shared, input shared
	res output mut-observable = initial,
	with in fire-and-forget
		# TODO: if 'f' is asynchronous, we need to make sure it isn't running multiple times at once?
		# At least 'res set' should not be out of order
		a now-and-subscribe of x
			res set f[x]
	res observable

+join[t, u] record(a t observable, b u observable) shared
+for-loop[out, t, u] out observable
	a (t, u) join
	f out shared(x t, y u)
do t shared, u shared, out shared
	res out mut-observable = f[a.a.get, a.b.get],
	a.a subscribe of x
		res set f[x, a.b.get]
	a.b subscribe of x
		res set f[a.a.get, x]
	res observable
