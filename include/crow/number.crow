# Equivlaent to `a is-multiple-of 2`.
+is-even bool(a nat64)
	(trusted a unsafe-mod 2) == 0

region constants

# Least possible value for a type.
+min-value int8()
	-0x80
+min-value int16()
	-0x8000
+min-value int32()
	-0x80000000
+min-value int64()
	-0x8000000000000000

# Greatest possible value for a type.
+max-value int8()
	0x7f
+max-value int16()
	0x7fff
+max-value int32()
	0x7fffffff
+max-value int64()
	0x7fffffffffffffff
+max-value nat8()
	0xff
+max-value nat16()
	0xffff
+max-value nat32()
	0xffffffff
+max-value nat64()
	0xffffffffffffffff

region arithmetic

| Used to store values for exceptions
+integral union(nat64, int64)

+unary-out-of-range record(input integral) exception case
+show string(_ unary-out-of-range)
	"Output of unary function does not fit in the result type"
+binary-out-of-range record(a integral, b integral) exception case
+show string(_ binary-out-of-range)
	"Output of binary function does not fit in the result type"
+divide-by-0 record exception case
+show string(_ divide-by-0)
	"Division by 0"

| Throws if the result would overflow.
|
| "Overflow" means: be greater than the maximum possible value.
+ + nat8(a nat8, b nat8)
	res = a wrap-add b
	assert res >= a && res >= b : a.to::nat64 binary-out-of-range b.to::nat64
	res
+ + nat16(a nat16, b nat16)
	res = a wrap-add b
	assert res >= a && res >= b : a.to::nat64 binary-out-of-range b.to::nat64
	res
+ + nat32(a nat32, b nat32)
	res = a wrap-add b
	assert res >= a && res >= b : a.to::nat64 binary-out-of-range b.to::nat64
	res
+ + nat64(a nat64, b nat64)
	res = a wrap-add b
	assert res >= a && res >= b : a binary-out-of-range b
	res

| Throws if the result would be negative.
+- nat8(a nat8, b nat8)
	assert a >= b : a.to::nat64 binary-out-of-range b.to::nat64
	a wrap-sub b
+- nat16(a nat16, b nat16)
	assert a >= b : a.to::nat64 binary-out-of-range b.to::nat64
	a wrap-sub b
+- nat32(a nat32, b nat32)
	assert a >= b : a.to::nat64 binary-out-of-range b.to::nat64
	a wrap-sub b
+- nat64(a nat64, b nat64)
	assert a >= b : a binary-out-of-range b
	a wrap-sub b

| Throws if the result would overflow.
+* nat32(a nat32, b nat32)
	res nat64 = a.to wrap-mul b.to
	assert res <= max-value::nat32.to : a.to::nat64 binary-out-of-range b.to::nat64
	res wrap-to
+* nat64(a nat64, b nat64)
	# TODO:PERF better safety check
	guard a != 0 && b != 0
	res = a wrap-mul b
	assert res / b == a : a binary-out-of-range b
	assert res / a == b : a binary-out-of-range b
	res

| Flooring division of {a} divided by {b}.
| Throws if `b == 0`.
+/ nat32(a nat32, b nat32)
	forbid b == 0 : divide-by-0
	trusted a unsafe-div b
+/ nat64(a nat64, b nat64)
	forbid b == 0 : divide-by-0
	trusted a unsafe-div b

| Like {a} / {b} but takes the ceil instead of the floor.
+div-ceil nat64(a nat64, b nat64)
	res = a / b
	res + (res * b == a ? 1)

| Remainder of {a} / {b}.
| Result will be in the range 0 .. {b}.
| Throws if {b} == 0.
+% nat64(a nat64, b nat64)
	forbid b == 0 : divide-by-0
	trusted a unsafe-mod b
+% nat32(a nat32, b nat32)
	forbid b == 0 : divide-by-0
	trusted (a.to unsafe-mod b.to) to

| This returns a {nat64} since modulo always returns a non-negative number.
+% nat64(a int64, b nat64)
	forbid b == 0 : divide-by-0
	if a < 0
		abs-mod = a.abs % b
		if abs-mod != 0
			b - abs-mod
	else
		a.to::nat64 % b

+modulo-of-negative record exception case
+show string(_ modulo-of-negative)
	"Tried to take modulo with a negative divisor"

-unsafe-mod float64(a float64, b float64) builtin

+% float32(a float32, b float32)
	a.to % b.to to
+% float64(a float64, b float64)
	forbid b <= 0 : b == 0 ? divide-by-0 : modulo-of-negative
	res = a unsafe-mod b
	res >= 0 ? res : res + b

| {true} iff `{b} * x == {a}` for some 'x'.
+is-multiple-of bool(a nat64, b nat64)
	if b == 0
		a == 0
	else
		(trusted a unsafe-mod b) == 0

+round-down-to-multiple-of nat64(a nat64, b nat64)
	a - (a % b)

| Throws if the result would overflow.
|
| "Overflow" means:
| Be less than the least possible value or greater than the greatest possible value.
+ + int8(a int8, b int8)
	a.to::int64 wrap-add b.to to
+ + int16(a int16, b int16)
	a.to::int64 wrap-add b.to to
+ + int32(a int32, b int32)
	a.to::int64 wrap-add b.to to
+ + int64(a int64, b int64)
	overflow = if b > 0
		a > (max-value wrap-sub b)
	else
		a < (min-value wrap-sub b)
	forbid overflow : a binary-out-of-range b
	a wrap-add b

+- int8(a int8, b int8)
	a.to::int64 wrap-sub b.to to
+- int16(a int16, b int16)
	a.to::int64 wrap-sub b.to to
+- int32(a int32, b int32)
	a.to::int64 wrap-sub b.to to
+- int64(a int64, b int64)
	overflow = if b > 0
		a < (min-value wrap-add b)
	else
		a > (max-value wrap-add b)
	forbid overflow : a binary-out-of-range b
	a wrap-sub b

+* int8(a int8, b int8)
	a.to::int64 wrap-mul b.to to
+* int16(a int16, b int16)
	a.to::int64 wrap-mul b.to to
+* int32(a int32, b int32)
	a.to::int64 wrap-mul b.to to
+* int64(a int64, b int64)
	overflow = if a == -1
		b == min-value
	elif b == -1
		a == min-value
	elif b == 0
		false
	elif a > max-value / b
		true
	elif a < min-value / b
		true
	forbid overflow : a binary-out-of-range b
	a wrap-mul b

| Negates a number.
| Same as `{a} * -1`.
|
| Throws if {a} is {min-value}.
+- int8(a int8)
	a * -1
+- int16(a int16)
	a * -1
+- int32(a int32)
	a * -1
+- int64(a int64)
	a * -1
+- int8(a nat8)
	-a.to
+- int16(a nat16)
	-a.to
+- int32(a nat32)
	-a.to
+- int64(a nat64)
	-a.to

| Flooring division.
| Throws if `{b} == 0`.
| Throws if the result would overflow, which only happens if
| {a} is {min-value} and {b} is -1.
+/ int32(a int32, b int32)
	forbid b == 0 : divide-by-0
	forbid a == min-value && b == -1 : a.to::int64 binary-out-of-range b.to::int64
	trusted a unsafe-div b
+/ int64(a int64, b int64)
	forbid b == 0 : divide-by-0
	forbid a == min-value && b == -1 : a binary-out-of-range b
	trusted a unsafe-div b

region misc

| Absolute value.
| For an integer type, throws for {min-value}.
+abs nat64(a int64)
	(a < 0 ? -a : a) to

+abs float32(a float32)
	a < 0 ? -a : a
+abs float64(a float64)
	a < 0 ? -a : a

+** nat64(a nat64, b nat64)
	if b == 0
		1
	elif b is-even
		(a * a) ** (b / 2)
	else
		a * a ** (b - 1)

region float

| Never throws.
+ + float32(a float32, b float32) builtin
+ + float64(a float64, b float64) builtin
| Never throws.
+- float32(a float32)
	a * -1
+- float64(a float64)
	a * -1
| Never throws.
+- float32(a float32, b float32) builtin
+- float64(a float64, b float64) builtin
| Never throws.
+* float32(a float32, b float32) builtin
+* float64(a float64, b float64) builtin

| Divide two floats. Undefined behavior if `{b} == 0`.
unsafe-div float32(a float32, b float32) builtin, unsafe
unsafe-div float64(a float64, b float64) builtin, unsafe

| Throws if `{b} == 0`.
+/ float32(a float32, b float32)
	forbid b == 0 : divide-by-0
	trusted a unsafe-div b
+/ float64(a float64, b float64)
	forbid b == 0 : divide-by-0
	trusted a unsafe-div b

+is-negative-0 bool(a float64)
	a == 0 && (trusted 1::float64 unsafe-div a) < 0

| {a} to the power of {b}.
| Throws {power-of-negative-number} if {a} is negative and {b} is not an integer.
+** float32(a float32, b float32)
	a.to ** b.to to
+** float64(a float64, b float64)
	forbid a < 0 && b !is-exactly-int : power-of-negative-number
	trusted if extern java
		"java.lang.Math" call-static "pow", a, b
	elif extern js
		"Math".js-global call-property "pow", a, b cast

+power-of-negative-number record exception case
+show string(_ power-of-negative-number)
	"Can't get a fractional power of a negative number."

| Not-a-Number value.
| 'unsafe' because Crow generally throws exceptions instead of returning NaN.
+nan float32() builtin, unsafe
+nan float64() builtin, unsafe
+infinity float32() builtin
+infinity float64() builtin

| {true} iff {a} is {nan}.
+is-nan bool(a float32) builtin
+is-nan bool(a float64) builtin

+is-near-int bool(a float32)
	a.to::float64 is-near-int
+is-near-int bool(a float64)
	a.round is-near a
+is-exactly-int bool(a float32)
	a.to::float64 is-exactly-int
+is-exactly-int bool(a float64)
	a.to::int64.to::float64 == a
+is-near bool(a float64, b float64)
	diff = a - b abs
	a == b || diff <= epsilon || diff <= epsilon * (a.abs min b.abs)
+epsilon float64()
	2.22e-16

region conversion

| Conversions between integral types throw on overflow or underflow.
| Conversions involving floats (in either direction) are approximate and never throw.
+to float32(a nat64)
	a.to::float64 to
+to float32(a int64)
	a.to::float64 to
+to float32(a float64) builtin

+to float64(a nat64) builtin
+to float64(a int64) builtin
+to float64(a float32) builtin

+to int64(a float64)
	a.round truncate-to

# TODO: move to math.crow? -----------------------------------------------------------------------------------------------------
+round float32(a float32)
	a.to.round to
+round float64(a float64)
	trusted if extern java
		sign float64 = a < 0 ? -1 : 1
		java-round int64 = "java.lang.Math" call-static "round", a.abs
		sign * java-round.to
	elif extern js
		sign float64 = a < 0 ? -1 : 1
		js-round float64 = "Math".js-global call-property "round", a.abs cast
		sign * js-round
	else
		throw todo
| floor
+round-down float32(a float32)
	a.to.round-down to
+round-down float64(a float64)
	trusted if extern java
		"java.lang.Math" call-static "floor", a
	elif extern js
		"Math".js-global call-property "floor", a cast
	else
		throw todo
| ceiling
+round-up float32(a float32)
	a.to.round-up to
+round-up float64(a float64)
	trusted if extern java
		"java.lang.Math" call-static "ceil", a
	elif extern js
		"Math".js-global call-property "ceil", a cast
	else
		throw todo

+to nat64(a float64)
	a.to::int64 to
+to nat32(a float64)
	a.to::nat64 to

| Throws if the result would overflow.
+to int64(a nat64)
	assert a < max-value::int64.to : a unary-out-of-range
	a wrap-to

+to nat8(a int8)
	assert a >= 0 : a.to::int64 unary-out-of-range
	a wrap-to
+to int8(a nat8)
	assert a <= max-value::int8.to : a.to::nat64 unary-out-of-range
	a wrap-to
+to int8(a int64)
	assert a >= min-value::int8.to : a unary-out-of-range
	assert a <= max-value::int8.to : a unary-out-of-range
	a wrap-to

+to nat16(a int16)
	assert a >= 0 : a.to::int64 unary-out-of-range
	a wrap-to
+to int16(a nat16)
	assert a <= max-value::int16.to : a.to::nat64 unary-out-of-range
	a wrap-to
+to int16(a int64)
	assert a >= min-value::int16.to : a unary-out-of-range
	assert a <= max-value::int16.to : a unary-out-of-range
	a wrap-to

| Convert an int to 32 bits. Fail if the result would overflow.
+to int32(a int64)
	assert a >= min-value::int32.to : a unary-out-of-range
	assert a <= max-value::int32.to : a unary-out-of-range
	a wrap-to
+to int32(a nat32)
	a.to::nat64 to
+to int32(a nat64)
	a.to::int64 to

+clamp-sub nat64(a nat64, b nat64)
	if a >= b
		a - b
	else
		0

| Return the closest value. Never throws.
+clamp-to int32(a int64)
	guard a >= min-value::int32.to : min-value
	guard a <= max-value::int32.to : max-value
	a wrap-to
+clamp-to int32(a nat64)
	a.clamp-to::int64 clamp-to
+clamp-to int64(a nat64)
	guard a <= max-value::int64.to : max-value
	a wrap-to
+clamp-to nat8(a nat64)
	guard a <= max-value::nat8.to : max-value
	a wrap-to
+clamp-to nat64(a int64)
	guard a >= 0
	a wrap-to
+clamp-to nat64(a float64)
	a.to::int64 clamp-to

| Return the closest possible value to `{a} + {b}`. Never throws.
+clamp-add int32(a int32, b int32)
	a.to::int64 wrap-add b.to clamp-to

| Throws if the result would not have the same value as the input (due to overflow or underflow).
+to nat64(a int8)
	a.to::int64 to
+to nat64(a int16)
	a.to::int64 to
+to nat64(a int32)
	a.to::int64 to
+to nat64(a int64)
	assert a >= 0 : a unary-out-of-range
	a wrap-to
+to nat8(a nat16)
	a.to::nat64 to
+to nat8(a nat32)
	a.to::nat64 to
+to nat8(a nat64)
	assert a <= max-value::nat8.to : a unary-out-of-range
	a wrap-to
+to nat8(a float64)
	a.to clamp-to
+to nat32(a int32)
	a.to::int64.to::nat64 to
+to nat32(a nat8)
	a.to::nat64 wrap-to
+to nat32(a nat16)
	a.to::nat64 wrap-to
+to nat32(a nat64)
	assert a <= max-value::nat32.to : a unary-out-of-range
	a wrap-to
+to nat16(a nat32)
	a.to::nat64 to
+to nat16(a nat64)
	assert a <= max-value::nat16.to : a unary-out-of-range
	a wrap-to

+truncate-to int64(a float64) builtin

+bits-of nat64(a float64) builtin
+bits-of nat32(a float32) builtin
+from-bits float32(bits nat32) builtin
+from-bits float64(bits nat64) builtin

region Spec impls for range

+next nat8(a nat8)
	a + 1
+next nat16(a nat16)
	a + 1
+next nat32(a nat32)
	a + 1
+next nat64(a nat64)
	a + 1
+next int8(a int8)
	a + 1
+next int16(a int16)
	a + 1
+next int32(a int32)
	a + 1
+next int64(a int64)
	a + 1

+prev nat8(a nat8)
	a - 1
+prev nat16(a nat16)
	a - 1
+prev nat32(a nat32)
	a - 1
+prev nat64(a nat64)
	a - 1
+prev int8(a int8)
	a - 1
+prev int16(a int16)
	a - 1
+prev int32(a int32)
	a - 1
+prev int64(a int64)
	a - 1

+difference nat64(a nat8, b nat8)
	a - b to
+difference nat64(a nat16, b nat16)
	a - b to
+difference nat64(a nat32, b nat32)
	a - b to

+difference nat64(a int8, b int8)
	a - b to
+difference nat64(a int16, b int16)
	a - b to
+difference nat64(a int32, b int32)
	a - b to
+difference nat64(a int64, b int64)
	a - b to

+divide-and-round-up nat64(a nat64, b nat64)
	res = a / b
	remainder = a % b
	if remainder == 0
		res
	else
		res + 1

+round-up-to nat64(a nat64, b nat64)
	remainder = a % b
	if remainder == 0
		a
	else
		a + b - remainder
