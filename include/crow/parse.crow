no-std
import
	java/lang/Double
	./bool
	./col/array
	./col/collection
	./compare
	./exception
	./js
	./misc
	./number
	./option
	./range
	./string
	./tuple

+string-mut-iterator record mut
	char8s char8[] # TODO: should this be private? Having this exposed makes it possible for the parser to look backwards -------
	char8-index mut nat64
+to string-mut-iterator(a string-iterator)
	a.inner.collection, a.next-char8-index
+to string-iterator(a string-mut-iterator)
	(a.char8s, a.char8-index),
+new string-mut-iterator(a string)
	a.begin to
+copy string-mut-iterator(a string-mut-iterator)
	a.char8s, a.char8-index
+is-at-end bool(a string-mut-iterator)
	a.char8-index == a.char8s.size
+take-char8 char8(a string-mut-iterator)
	forbid a is-at-end # TODO: throw a parse-error? ----------------------------------------------------------------------------------
	res = a peek8
	a.char8-index +:= 1
	res
+take-char32 char32(a string-mut-iterator)
	iter char8 array-iterator = a.char8s.begin + a.char8-index
	assert res, next ?= (iter,)::string-iterator next
	a.char8-index := next next-char8-index
	res
| WARN: This peeks the next byte, which could be an invalid char8.
| Uses "\0" to indicate the end.
+peek8 char8(a string-mut-iterator)
	if a is-at-end then "\0" else a.char8s[a char8-index]
+peek char32?(a string-mut-iterator)
	guard a !is-at-end
	iter char8 array-iterator = a.char8s.begin + a.char8-index
	assert res, _ ?= (iter,)::string-iterator next
	res
+try-take bool(a string-mut-iterator, exact string)
	if a starts-with exact
		a.char8-index +:= exact.to::char8[].size
		true
+starts-with bool(a string-mut-iterator, start string)
	char8s char8[] = start to
	a.char8-index + char8s.size <= a.char8s.size and 0::nat .. char8s.size every of i
		a.char8s[a.char8-index + i] == char8s[i]

| Opaque grammar type parsing a {t} value.
| Use the functions in this module to build a grammar.
# TODO: this should probably be an interface, not a record with a lambda in it ----------------------------------------------
+grammar[t] record mut
	func t mut(iter string-mut-iterator)
-fn[t] t(a t grammar, iter string-mut-iterator)
	a.func[iter]

| Match a string against a grammar.
| The whole string must match the grammar.
| If the string has leading or trailing spaces you must use a grammar that includes those.
| Throws a {parse-error} on failure.
+parse[t] t(a t grammar, text string)
	iter string-mut-iterator = text,
	try
		res = a fn iter
		assert iter is-at-end else text parse-error iter.to, "string continues past end of parse"
		res
	catch inner-parse-error e
		throw text parse-error iter.to, e.expected

+parse-error record exception case
	| The argument passed to {parse}.
	input string
	| Position where the parse error happened.
	| This will be `{input}.end` if the error was end of input.
	iter string-iterator # TODO: would be simpler to just use a nat? ----------------------------------------------------------
	| Description of what was expected.
	expected string
+== bool(a parse-error, b parse-error)
+show string(a parse-error)
	# TODO: show where it is
	peek string = if x, _ ?= a.iter next
		"'{x}'"
	else
		"EOF"
	"Expected {a expected}, got {peek}"

+inner-parse-error record(expected string) exception case # TODO: it's annoying to have this, could parsers throw 'parse-error' directly?
+show string(a inner-parse-error)
	"Expected {a expected}"

| This is like {grammar} but produces no result.
+grammar-skip record(inner void grammar) mut

| Grammar matching empty strings
+new grammar-skip()
	"" exact

| Use to discard the result of any {grammar}.
+skip[t] grammar-skip(a t grammar)
	- a transform it.noop

+and-return[t] t grammar(a grammar-skip, value t)
	a.inner transform of _ then value

+text-delimited string grammar(begin string, end string)
	begin ~~ end.text-not-containing ~~ end

+text-not-containing string grammar(ending string)
	(ending,) text-not-containing-any

+text-not-containing-any string grammar(possible-endings string[])
	func: of iter
		res string = with out in build
			loop
				if possible-endings exists of x then iter starts-with x
					break
				elif iter !is-at-end
					out ~= iter take-char32
					continue
				else
					break
		forbid res is-empty else
			endings = ", " join for x in possible-endings then "'{x}'"
			"expected text ending in one of {endings}" inner-parse-error
		res

| Grammar for a single character matching the predicate.
-char-matching-predicate char32 grammar(description string, predicate bool data(x char32))
	func: of iter
		assert res ?= iter peek else description inner-parse-error
		assert predicate[res] else description inner-parse-error
		_ = iter take-char8 # TODO: this only advances past a char8. Should advance the whole char32. ----------------------------------------------
		res

| Expects to parse {a} followed by {b}.
| By default this does not allow spaces in between. For that, use `a ~~ spaces ~~ b`.
+~~[t, u] (t, u) grammar(a t grammar, b u grammar)
	func: of iter
		- a fn iter
		- b fn iter
+~~[t] t grammar(a t grammar, b grammar-skip)
	func: of iter
		res = a fn iter
		b.inner fn iter
		res
+~~[t] t grammar(a grammar-skip, b t grammar)
	func: of iter
		a.inner fn iter
		b fn iter
+~~ grammar-skip(a grammar-skip, b grammar-skip)
	a.inner ~~ b,
| Skips an exact string, then parses {b}.
+~~[t] t grammar(a string, b t grammar)
	a.exact ~~ b
| Parses {a}, then skips an exact string.
+~~[t] t grammar(a t grammar, b string)
	a ~~ b.exact
+~~ grammar-skip(a string, b grammar-skip)
	a.exact ~~ b
+~~ grammar-skip(a grammar-skip, b string)
	a ~~ b.exact

| Tries to parse with {a}, and if that fails, tries to parse with {b} instead.
# TODO: I should probably remove this. This is the only rule that involves backtracing. -----------------------------------------
+/[t] t grammar(a t grammar, b t grammar)
	func: of iter
		restore = iter char8-index
		try
			a fn iter
		catch inner-parse-error _
			iter.char8-index := restore
			b fn iter

# TODO: 'f' should be 'data', not 'mut' -----------------------------------------------------------------------------------
| Uses a function to transform the result if parsing is successful.
+transform[output, input] output grammar(a input grammar, f output mut(x input))
	func: of iter
		f[a fn iter]

| Allows parsing to fail, returning an empty option if it does.
+optional[t] t? grammar(a t grammar)
	func: of iter
		restore = iter char8-index
		try
			a fn iter
		catch inner-parse-error _
			iter.char8-index := restore
			()
| Optionally skips an exact string.
+optional grammar-skip(a string)
	a.exact.inner.optional skip

| Parses the same grammar as many times as possible (including 0 times).
+many[t] t[] grammar(a t grammar)
	func: of iter
		with out in build
			restore mut = iter char8-index
			try
				while true
					restore := iter char8-index
					v = a fn iter
					out ~= v
			catch inner-parse-error _
				iter.char8-index := restore

+many grammar-skip(a grammar-skip)
	inner void[] grammar = a.inner many
	- inner transform it.noop

| Parses {a} at least once, then as many times as possible.
+one-or-more[t] t[] grammar(a t grammar)
	a ~~ a.many transform of x
		x.a ~ x.b

+one-or-more grammar-skip(a grammar-skip)
	inner void[] grammar = a.inner one-or-more
	- inner transform it.noop

| Parses {a} as many times as possible, with 'separator' in between.
|
| This does not allow a trailing separator;
| it is a parse error to have a separator not followed by another {a}.
| This does allow to parse nothing, returning an empty array.
+separated-by[t] t[] grammar(a t grammar, separator string)
	a separated-by separator.exact
+separated-by[t] t[] grammar(a t grammar, separator grammar-skip)
	func: of iter
		guard first ?= a try-parse iter
		with out in build
			out ~= first
			while separator try-parse iter
				out ~= a fn iter

-try-parse bool(a grammar-skip, iter string-mut-iterator)
	_ ?= a.inner try-parse iter

-try-parse[t] t?(a t grammar, iter string-mut-iterator)
	restore = iter char8-index
	try
		a fn iter
	catch inner-parse-error _
		iter.char8-index := restore
		()

| Use this to allow recursive grammars.
+lazy record
+with-block[t] t grammar(_ lazy, f t grammar data())
	grammar mut t grammar? = ()
	func: of iter
		unless _ ?= grammar
			grammar := f[]
		grammar! fn iter

| Matches {a} exactly.
+exact grammar-skip(a string)
	inner:
		func: of iter
			assert iter try-take a else "expected '{a}'" inner-parse-error

| Equivalent to `{a}.{exact} {transform} of _ then {value}`
+exact[t] t grammar(a string, value t)
	a.exact.inner transform of _ then value

+whitespace grammar-skip()
	inner:
		func: it.skip-whitespace
+skip-whitespace void(a string-mut-iterator)
	while a.peek8 is-space
		_ = a take-char8
+is-space bool(a char8)
	match a
	as " "
		true
	as "\r"
		true
	as "\n"
		true
	as "\t"
		true
	else
		false

| A double-quoted string as in JSON, including escape sequences.
+quoted-string string grammar()
	func: it.take-quoted-string
~take-quoted-string string(iter string-mut-iterator)
	assert iter try-take "\"" else "quoted string" inner-parse-error
	iter take-quoted-string-after-quote
~take-quoted-string-after-quote string(iter string-mut-iterator)
	with out in build
		loop
			forbid iter is-at-end else "quoted string" inner-parse-error
			match iter take-char32
			as "\""
				break
			as "\\"
				guard iter !is-at-end else break
				assert esc ?= iter.take-char8 escape else "quoted string" inner-parse-error
				out ~= esc
				continue
			else x
				out ~= x
				continue
-escape char32?(a char8)
	match a
	as "n"
		"\n"
	as "r"
		"\r"
	as "t"
		"\t"
	as "\""
		"\""
	as "\\"
		"\\"
	as "0"
		"\0"
	else
		()

# TODO: support letters from more languages
| Matches and returns a sequence of letters.
+word string grammar()
	letter.one-or-more transform it.to

-letter char32 grammar()
	"letter" char-matching-predicate it.is-letter

-is-letter bool(a char32)
	# TODO: support other alphabets
	"a"::char32.to::nat32 <= a.to and a.to::nat32 <= "z"::char32.to

| Parse a string "true" or "false".
+bool bool grammar()
	("true" exact true) / ("false" exact false)

| Parses a natural number in decimal format.
| This allows leading 0s which have no effect.
+nat nat64 grammar()
	func: of iter
		iter take-nat else throw "natural number" inner-parse-error

| Parses a signed integer in decimal format.
| This allows e.g. "1", "+23", "-45".
+int int64 grammar()
	("+".optional ~~ (nat transform it.to)) / ("+" ~~ (nat transform -it.to))

-nat-and-count-digits record
	value nat64
	count-digits nat64
-take-nat nat64?(iter string-mut-iterator)
	iter.take-nat-and-count-digits ?value
-take-nat-and-count-digits nat-and-count-digits?(iter string-mut-iterator)
	acc mut nat64 = 0
	count-digits mut nat64 = 0
	while x ?= iter next-digit
		acc *:= 10
		acc +:= x
		count-digits := count-digits + 1
	unless count-digits == 0
		acc, count-digits
-next-digit nat64?(a string-mut-iterator)
	guard digit ?= a.peek8 char-to-nat64
	_ = a take-char8
	digit

-is-digit bool(a char8)
	_ ?= a char-to-nat64
-char-to-nat64 nat64?(c char8)
	if "0"::char8 <= c and c <= "9"
		c.to - "0"::char8.to to

| Parse a decimal number.
| This allows e.g. "+1.23".
+float float64 grammar()
	func: it.take-float
~take-float float64(iter string-mut-iterator)
	index = iter char8-index
	_ = iter try-take "-" or iter try-take "+"
	assert iter peek-digit else "float" inner-parse-error
	while iter peek-digit
		_ = iter take-char8
	if iter try-take "."
		while iter peek-digit
			_ = iter take-char8
	iter.char8s[index .. iter.char8-index].to string-to-float

-peek-digit bool(a string-mut-iterator)
	a.peek8 is-digit

-string-to-float float64(a string)
	trusted if extern java
		a.to parseDouble
	elif extern js
		"Number".js-global call a.to to
	else
		throw todo
