no-std
import
	java/lang/Double
	./bool
	./col/array
	./col/collection
	./col/util
	./compare
	./exception
	./js
	./misc
	./number
	./option
	./string
	./string/unicode
	./tuple

-peek-after char8(a string-iterator)
	try
		copy = a.copy
		_ = take-char8 copy
		take-char8 copy
	catch as iterator-out-of-bounds
		"\0"
+try-take bool(a string-iterator, start string)
	try-take-all a, start.to::char8[]
+starts-with bool(a string-iterator, start string)
	try-take a.copy, start

| Opaque grammar type parsing a {t} value.
| Use the functions in this module to build a grammar.
# TODO: this should probably be an interface, not a record with a lambda in it ----------------------------------------------
+grammar[t] record mut
	func t mut(iter string-iterator)
-fn[t] t(a t grammar, iter string-iterator)
	a.func[iter]

| Match a string against a grammar.
| The whole string must match the grammar.
| If the string has leading or trailing spaces you must use a grammar that includes those.
| Throws a {parse-error} on failure.
+parse[t] t(a t grammar, text string)
	parse a, text.to::string-view
+parse[t] t(a t grammar, text string-view)
	iter string-iterator = begin text
	try
		res = fn a, iter
		assert is-at-end iter else parse-error text.to, iter.char8-index, "string continues past end of parse"
		res
	catch e as inner-parse-error
		throw parse-error text.to, iter.char8-index, e.expected

+parse-error record exception case
	| The argument passed to {parse}.
	input string
	| Position where the parse error happened.
	| This will be `{input}.end` if the error was end of input.
	char8-index nat
	| Description of what was expected.
	expected string
+ == bool(a parse-error, b parse-error)
+show string(a parse-error)
	# TODO: show where it is. Also handle funny characters
	peek string = if a.char8-index == a.input.size then "EOF" else "'{(a.input.to::char8[])[a.char8-index]}'"
	"Expected {a.expected}, got {peek}"

+inner-parse-error record(expected string) exception case # TODO: it's annoying to have this, could parsers throw 'parse-error' directly?
+show string(a inner-parse-error)
	"Expected {a.expected}"

| This is like {grammar} but produces no result.
+grammar-skip record(inner void grammar) mut

| Grammar matching empty strings
+new grammar-skip()
	exact ""

| Use to discard the result of any {grammar}.
+skip[t] grammar-skip(a t grammar)
	- transform a, it.noop

+and-return[t] t grammar(a grammar-skip, value t)
	transform a.inner, of _ then value

+text-delimited string grammar(begin string, end string)
	begin ~~ end.text-not-containing ~~ end

+text-not-containing string grammar(ending string)
	text-not-containing-any (ending,)

+text-not-containing-any string grammar(possible-endings string[])
	func: of iter
		res string = with out in build
			do loop
			if exists possible-endings, of x then starts-with iter, x
				break
			elif !is-at-end iter
				out ~= take-next iter
				continue
			else
				break
		forbid is-empty res else
			endings = join ", ", for x in possible-endings then "'{x}'"
			inner-parse-error "expected text ending in one of {endings}"
		res

| Grammar for a single character matching the predicate.
-char-matching-predicate char8 grammar(description string, predicate bool data(x char8))
	func: of iter
		res = peek iter
		assert res and predicate[res] else inner-parse-error description
		_ = take-char8 iter # TODO: this only advances past a char8. Should advance the whole char32. ----------------------------------------------
		res

| Expects to parse {a} followed by {b}.
| By default this does not allow spaces in between. For that, use `a ~~ spaces ~~ b`.
+ ~~[t, u] (t, u) grammar(a t grammar, b u grammar)
	func: of iter
		- fn a, iter
		- fn b, iter
+ ~~[t] t grammar(a t grammar, b grammar-skip)
	func: of iter
		res = fn a, iter
		fn b.inner, iter
		res
+ ~~[t] t grammar(a grammar-skip, b t grammar)
	func: of iter
		fn a.inner, iter
		fn b, iter
+ ~~ grammar-skip(a grammar-skip, b grammar-skip)
	- a.inner ~~ b
| Skips an exact string, then parses {b}.
+ ~~[t] t grammar(a string, b t grammar)
	a.exact ~~ b
| Parses {a}, then skips an exact string.
+ ~~[t] t grammar(a t grammar, b string)
	a ~~ b.exact
+ ~~ grammar-skip(a string, b grammar-skip)
	a.exact ~~ b
+ ~~ grammar-skip(a grammar-skip, b string)
	a ~~ b.exact

| Tries to parse with {a}, and if that fails, tries to parse with {b} instead.
# TODO: I should probably remove this. This is the only rule that involves backtracing. -----------------------------------------
+ /[t] t grammar(a t grammar, b t grammar)
	func: of iter
		restore = iter.char8-index
		try
			fn a, iter
		catch as inner-parse-error
			iter.char8-index := restore
			fn b, iter

# TODO: 'f' should be 'data', not 'mut' -----------------------------------------------------------------------------------
| Uses a function to transform the result if parsing is successful.
+transform[output, input] output grammar(a input grammar, f output mut(x input))
	func: of iter
		f[fn a, iter]

| Allows parsing to fail, returning an empty option if it does.
+optional[t] t? grammar(a t grammar)
	func: of iter
		restore = iter.char8-index
		try
			fn a, iter
		catch as inner-parse-error
			iter.char8-index := restore
			()
| Optionally skips an exact string.
+optional grammar-skip(a string)
	skip optional inner exact a

| Parses the same grammar as many times as possible (including 0 times).
+many[t] t[] grammar(a t grammar)
	func: of iter
		do with out in build
		restore mut = iter.char8-index
		try
			while true
				restore := iter.char8-index
				v = fn a, iter
				out ~= v
		catch as inner-parse-error
			iter.char8-index := restore

+many grammar-skip(a grammar-skip)
	inner void[] grammar = many a.inner
	- transform inner, it.noop

| Parses {a} at least once, then as many times as possible.
+one-or-more[t] t[] grammar(a t grammar)
	transform a ~~ a.many, of x
		x.a ~ x.b

+one-or-more grammar-skip(a grammar-skip)
	inner void[] grammar = one-or-more a.inner
	- transform inner, it.noop

| Parses {a} as many times as possible, with 'separator' in between.
|
| This does not allow a trailing separator;
| it is a parse error to have a separator not followed by another {a}.
| This does allow to parse nothing, returning an empty array.
+separated-by[t] t[] grammar(a t grammar, separator string)
	separated-by a, separator.exact
+separated-by[t] t[] grammar(a t grammar, separator grammar-skip)
	func: of iter
		do if first = try-parse a, iter
		do with out in build
		out ~= first
		while try-parse separator, iter
			out ~= fn a, iter

-try-parse bool(a grammar-skip, iter string-iterator)
	!!(try-parse a.inner, iter)

-try-parse[t] t?(a t grammar, iter string-iterator)
	restore = char8-index iter
	try
		fn a, iter
	catch as inner-parse-error
		iter.char8-index := restore
		()

| Use this to allow recursive grammars.
+lazy record
+with-block[t] t grammar(_ lazy, f t grammar data())
	grammar mut t grammar? = ()
	func: of iter
		unless grammar
			grammar := f[]
		fn grammar!, iter

| Matches {a} exactly.
+exact grammar-skip(a string)
	inner: func: of iter
		assert try-take iter, a else inner-parse-error "expected '{a}'"

| Equivalent to `{a}.{exact} {transform} of _ then {value}`
+exact[t] t grammar(a string, value t)
	transform a.exact.inner, of _ then value

+whitespace grammar-skip()
	inner: func: it.skip-whitespace
+skip-whitespace void(a string-iterator)
	while x = a.peek and is-space x
		_ = take-char8 a
+is-space bool(a char8)
	match a
	as " "
		true
	as "\r"
		true
	as "\n"
		true
	as "\t"
		true
	else
		false

| A double-quoted string as in JSON, including escape sequences.
+quoted-string string grammar()
	func: it.take-quoted-string
~take-quoted-string string(iter string-iterator)
	assert try-take iter, "\"" else inner-parse-error "quoted string"
	take-quoted-string-after-quote iter
~take-quoted-string-after-quote string(iter string-iterator)
	with out in build
		do loop
		forbid is-at-end iter else inner-parse-error "quoted string"
		match char = take-char8 iter
		as "\""
			break
		as "\\"
			do unless is-at-end iter else break
			assert esc = escape iter.take-char8 else inner-parse-error "Valid escape sequence"
			out ~~= esc.to::string.to
			continue
		else
			out ~= char
			continue
-escape char32?(a char8)
	match a
	as "n"
		"\n"
	as "r"
		"\r"
	as "t"
		"\t"
	as "\""
		"\""
	as "\\"
		"\\"
	as "0"
		"\0"
	# This is not normally allowed in JSON, but allow it since Crow needs this character escaped.
	as "\{"
		"\{"
	else
		()

# TODO: support letters from more languages
| Matches and returns a sequence of letters.
+word string grammar()
	transform letter.one-or-more, it.to

-letter char8 grammar()
	char-matching-predicate "letter", it.is-letter

-is-letter bool(a char8)
	# TODO: support other alphabets
	"a"::char8.to::nat8 <= a.to and a.to::nat8 <= "z"::char8.to

| Parse a string "true" or "false".
+bool bool grammar()
	(exact "true", true) / (exact "false", false)

| Parses a natural number in decimal format.
| This allows leading 0s which have no effect.
+nat nat64 grammar()
	func: it.take-nat

| Parses a signed integer in decimal format.
| This allows e.g. "1", "+23", "-45".
+int int64 grammar()
	("+".optional ~~ (transform nat, it.to)) / ("+" ~~ (transform nat, -it.to))
~parse-int int64(a char8 array-view)
	forbid is-empty a else inner-parse-error "integer"
	if a[0] == "+"
		a[1 .. end].parse-nat.to
	elif a[0] == "-"
		-a[1 .. end].parse-nat
	else
		a.parse-nat.to

~take-nat nat64(iter string-iterator)
	if try-take iter, "0b"
		take-nat iter, 2
	elif try-take iter, "0o"
		take-nat iter, 8
	elif try-take iter, "0x"
		take-nat iter, 16
	else
		take-nat iter, 10
-take-nat nat64(iter string-iterator, base nat64)
	try
		acc mut nat64 = next-digit iter, base else throw inner-parse-error "natural number"
		while x = next-digit iter, base
			acc *:= base
			acc +:= x
		acc
	catch as unary-out-of-range
		throw inner-parse-error "number that fits in a nat64"
-next-digit nat64?(a string-iterator, base nat)
	skip-underscore-if-before-digit a
	do if char = peek a
	do if digit = char-to-nat64 char, base
	_ = take-char8 a
	digit
~parse-nat nat64(a char8 array-view)
	iter string-iterator = begin a
	res = take-nat iter
	assert is-at-end iter else todo
	res

+is-digit bool(a char8)
	"0"::char8 <= a and a <= "9"
-char-to-nat64 nat64?(c char8, base nat64)
	assert base <= 36
	if "0"::char8 <= c and c <= "9"
		res nat64 = c.to - "0"::char8.to
		if res < base then res
	elif "a"::char8 <= c and c <= "z"
		res nat64 = 10 + (c.to - "a"::char8.to)
		if res < base then res

| Parse a decimal number.
| This allows e.g. "+1.23".
+float float64 grammar()
	func: it.take-float
~take-float float64(iter string-iterator)
	start = copy iter
	_ = try-take iter, "-" or try-take iter, "+"
	assert peek-digit iter else inner-parse-error "float"
	while peek-digit iter
		_ = take-char8 iter
		skip-underscore-if-before-digit iter
	if iter.peek == "." and is-digit peek-after iter
		_ = take-char8 iter
		while peek-digit iter
			_ = take-char8 iter
			skip-underscore-if-before-digit iter
	parse-float slice start, iter

-peek-digit bool(a string-iterator)
	(x = peek a) and is-digit x

-skip-underscore-if-before-digit void(a string-iterator)
	if a.peek == "_" and is-digit peek-after a
		_ = a.take-char8

~parse-float float64(a string-view)
	trusted if java
		fixed char8[] = if exists a, it == "_" # TODO: "_"::char8 'in a -----------------------------------------------------------
			for* x in a
				unless x == "_"
					- x
		else
			a.to
		parseDouble fixed.to::string.to
	elif js
		call "Number".js-global, a.to::string.to 'to
	else
		throw todo

+is-whitespace bool(a char8)
	a == "\n" or is-whitespace-non-newline a

+is-whitespace-non-newline bool(a char8)
	a == " " or a == "\t" or a == "\r"
