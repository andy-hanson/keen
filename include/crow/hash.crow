| Functions for getting hash codes.
|
| Hash codes are used internally by map and set types,
| which require a `hash-mix` implementation for the key type.
no-std
import
	./bits: >>, ^, rotate-left
	./bool: bool, to
	./compare: compare
	./misc: data, new, void
	./number: bits-of, float32, float64, int8, int16, int32, int64, nat8, nat16, nat32, nat64, to
	./option: new, option
	./private/number-low-level: unsafe-to, wrap-add, wrap-mul

| Spec for values that can be used as keys in a map or set.
+key[t] spec t data, t compare, t hash-mix

| Spec that should be implemented for any type used as a map key.
|
| {hash-mix} on a composite type (such as a record or collection)
| usually just calls {hash-mix} for each value it contains.
|
| {hash-mix} on a union should mix a number or name for the union member,
| then mix its associated value, if any.
+hash-mix[t] spec
	hash-mix void(hasher hasher, a t)

| Get a hash code for any value.
+get-hash[t] nat64(a t) t hash-mix # TODO: KILL (just have this be the protocol) -----------------------------------------------------------------------------------------
	hasher hasher = ()
	hasher hash-mix a
	hasher finish

| Type that stores the state of hashing.
+hasher record mut
	-h1 mut nat64
	-h2 mut nat64
	-first-half mut nat64?
+new hasher()
	0, 0, ()

+finish nat64(a hasher)
	if _ ?= a first-half
		a hash-mix 0::nat64
	forbid _ ?= a first-half
	h1 mut = a h1
	h2 mut = a h2
	h1 wrap-add:= h2
	h2 wrap-add:= h1
	h1 := h1 fmix64
	h2 := h2 fmix64
	h1 wrap-add:= h2
	h2 wrap-add:= h1
	h1 ^ h2

-fmix64 nat64(a nat64)
	x mut = a
	x ^:= x >> 33
	x wrap-mul:= 0xff51afd7ed558ccd
	x ^:= x >> 33
	x wrap-mul:= 0xc4ceb9fe1a85ec53
	x ^:= x >> 33
	x

+hash-mix void(hasher hasher, a nat8) bare
	hasher hash-mix a.to::nat64
+hash-mix void(hasher hasher, a nat16) bare
	hasher hash-mix a.to::nat64
+hash-mix void(hasher hasher, a nat32) bare
	hasher hash-mix a.to::nat64
+hash-mix void(hasher hasher, a nat64) bare
	# TODO: better hash mixing algorithm
	if x ?= hasher first-half
		hasher.first-half := ()
		h1 mut = hasher h1
		h2 mut = hasher h2
		k1 mut = x
		k2 mut = a
		k1 wrap-mul:= c1
		k1 rotate-left:= 31
		k1 wrap-mul:= c2
		h1 ^:= k1
		h1 rotate-left:= 27
		h1 wrap-add:= h2
		h1 wrap-mul:= 5
		h1 wrap-add:= 0x52dce729
		k2 wrap-mul:= c2
		k2 rotate-left:= 33
		k2 wrap-mul:= c1
		h2 ^:= k2
		h2 rotate-left:= 31
		h2 wrap-add:= h1
		h2 wrap-mul:= 5
		h2 wrap-add:= 0x38495ab5
		hasher.h1 := h1
		hasher.h2 := h2
	else
		hasher.first-half := a,
-c1 nat64() bare
	0x87c37b91114253d5
-c2 nat64() bare
	0x4cf5ad432745937f
+hash-mix void(hasher hasher, a int8) bare
	hasher hash-mix a.to::int64
+hash-mix void(hasher hasher, a int16) bare
	hasher hash-mix a.to::int64
+hash-mix void(hasher hasher, a int32) bare
	hasher hash-mix a.to::int64
+hash-mix void(hasher hasher, a int64) bare
	# TODO: we need 'wrap-to'
	trusted hasher hash-mix a.unsafe-to::nat64

+hash-mix void(hasher hasher, a bool) bare
	hasher hash-mix a.to::nat64

+hash-mix void(hasher hasher, a float32) bare
	hasher hash-mix a.bits-of
+hash-mix void(hasher hasher, a float64) bare
	hasher hash-mix a.bits-of

+hash-mix[t, u] void(hasher hasher, (t t, u u)) t hash-mix, u hash-mix
	hasher hash-mix t
	hasher hash-mix u
