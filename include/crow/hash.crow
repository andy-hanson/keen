| Functions for getting hash codes.
|
| Hash codes are used internally by map and set types,
| which require a `hash` implementation for the key type.
no-std
import
	./bits: ^
	./bool: bool, to
	./compare: compare
	./misc: data, new, void
	./number: bits-of, float32, float64, int8, int16, int32, int64, nat8, nat16, nat32, nat64, to, wrap-add, wrap-mul, wrap-to

| Spec for values that can be used as keys in a map or set.
+key[t] spec t data, t compare, t hash

| Spec that should be implemented for any type used as a map key.
|
| {hash} on a composite type (such as a record or collection)
| usually just calls {hash} for each value it contains.
|
| {hash} on a union should mix a number or name for the union member,
| then mix its associated value, if any.
+hash[t] spec
	hash void(a t, state hash-state)

| Get a hash code for any value.
+get-hash[t] nat64(a t) t hash
	state hash-state = ()
	a hash state
	state finish

+hash-state record mut
	-state mut nat64
	-dummy void
+new hash-state()
	0xdecafc0ffeecafe,
+new hash-state(seed nat64)
	seed, ()
+finish nat64(a hash-state)
	a state

###
----------------------------------------------------------------------------------------------------------------------------
| Type that stores the state of hashing.
+hash-state record mut
	-h1 mut nat64
	-h2 mut nat64
	-first-half mut nat64?
+new hash-state()
	0, 0, ()

+finish nat64(a hash-state)
	if a first-half
		a hash 0::nat64
	forbid a first-half
	h1 mut = a h1
	h2 mut = a h2
	h1 wrap-add:= h2
	h2 wrap-add:= h1
	h1 := h1 fmix64
	h2 := h2 fmix64
	h1 wrap-add:= h2
	h2 wrap-add:= h1
	h1 ^ h2

-fmix64 nat64(a nat64)
	x mut = a
	x ^:= x >> 33
	x wrap-mul:= 0xff51afd7ed558ccd
	x ^:= x >> 33
	x wrap-mul:= 0xc4ceb9fe1a85ec53
	x ^:= x >> 33
	x
###

+hash void(_ void, _ hash-state)
	()
+hash void(a nat8, state hash-state)
	a.to::nat64 hash state
+hash void(a nat16, state hash-state)
	a.to::nat64 hash state
+hash void(a nat32, state hash-state)
	a.to::nat64 hash state
+hash void(a nat64, state hash-state)
	state.state ^:= a
	state.state := 0x5851f42d4c957f2d wrap-mul state.state wrap-add 1

###
------------------------------------------------------------------------------------------------------------------------------------
+hash void(a nat64, state hash-state)
	# TODO: better hash mixing algorithm
	if x = state first-half
		state.first-half := ()
		h1 mut = state h1
		h2 mut = state h2
		k1 mut = x
		k2 mut = a
		k1 wrap-mul:= c1
		k1 rotate-left:= 31
		k1 wrap-mul:= c2
		h1 ^:= k1
		h1 rotate-left:= 27
		h1 wrap-add:= h2
		h1 wrap-mul:= 5
		h1 wrap-add:= 0x52dce729
		k2 wrap-mul:= c2
		k2 rotate-left:= 33
		k2 wrap-mul:= c1
		h2 ^:= k2
		h2 rotate-left:= 31
		h2 wrap-add:= h1
		h2 wrap-mul:= 5
		h2 wrap-add:= 0x38495ab5
		state.h1 := h1
		state.h2 := h2
	else
		state.first-half := a,
-c1 nat64()
	0x87c37b91114253d5
-c2 nat64()
	0x4cf5ad432745937f
###

+hash void(a int8, state hash-state)
	a.to::int64 hash state
+hash void(a int16, state hash-state)
	a.to::int64 hash state
+hash void(a int32, state hash-state)
	a.to::int64 hash state
+hash void(a int64, state hash-state)
	a.wrap-to::nat64 hash state

+hash void(a bool, state hash-state)
	a.to::nat64 hash state

+hash void(a float32, state hash-state)
	a.bits-of hash state
+hash void(a float64, state hash-state)
	a.bits-of hash state

+hash[t, u] void((t t, u u), state hash-state) t hash, u hash
	t hash state
	u hash state
