use-prefix
no-std
import
	java/lang/Runnable
	java/lang/Throwable
	java/util/concurrent/CompletableFuture
	java/util/concurrent/ExecutionException
	java/util/concurrent/Future
	java/util/concurrent/ExecutorService
	./bool
	./col/array
	./col/mut-array
	./col/collection
	./col/sort
	./col/util
	./exception
	./js
	./json
	./misc
	./number
	./private/runtime
	./range
	./string
	./test-util
	./unsafe

| In Java, this is a `java.util.concurrent.Future`.
| In JS, this is a `Promise`.
+future[t] builtin

+await[t] t(a t future)
	trusted if java
		with in unlocked-exclusion
			try
				reinterpret-cast a.reinterpret-cast::Future.get
			catch e as ExecutionException
				throw reinterpret-cast e.reinterpret-cast::Throwable.getCause
	elif js
		assume-type a.as-js.await
	else
		throw todo

| Just yields the fiber temporarily. It may be restarted immediately.
+yield-fiber void()
	trusted if java
		with in unlocked-exclusion
			()
	elif js
		resolver void mut(resolve js-any) = of resolve
			_ = call "setTimeout".js-global, resolve, 0
		_ = await call-new "Promise".js-global, resolver.to
	else
		throw todo

| Converts a value to a future resolved with that value.
+new[t] t future(value t)
	trusted if java
		res CompletableFuture = ()
		ok = complete res, value.reinterpret-cast
		assert ok
		reinterpret-cast res
	elif js
		assume-type call-property "Promise".js-global, "resolve", value.as-js
	else
		throw todo
test
	x nat future = 1,
	x.await is 1

| Future resolved with an exception.
+rejected[t] t future(err exception)
	trusted if java
		res CompletableFuture = ()
		ok = completeExceptionally res, err.reinterpret-cast
		assert ok
		reinterpret-cast res
	elif js
		assume-type call-property "Promise".js-global, "reject", err.as-js
	else
		throw todo
test
	fut nat future = rejected error "foo"
	try
		_ = await fut
		should-throw
	catch e as error
		e.show is "foo"

+parallel record
| Run {f} in a new fiber with a new exclusion and return a future for its result.
+with-block[t] t future(_ parallel, f t shared())
	trusted if java
		future CompletableFuture = ()
		fill-it void mut() = of
			ok = complete future, f[].reinterpret-cast
			assert ok == true
		# Ignore this void turue
		_ Future = submit get-executor, fill-it.reinterpret-cast::Runnable
		reinterpret-cast future
	elif js
		# This ensures 'f' is not run immediately
		"Promise".js-global 'call-property "resolve" 'call-property "then", f.as-js 'assume-type
	else
		throw todo
# Test single future awaited by multiple fibers at once
test
	f nat future = with in later
		1
	a0 nat future = with in parallel
		f.await + 1
	a1 nat future = with in parallel
		f.await + 2
	a0.await is 2
	a1.await is 3
# This tests 'shared-of-mut-lambda', which the compiler uses to implement 'shared' lambdas.
test
	out nat mut[] = ()
	f void shared(x nat) = shared of x
		out ~= x
		()
	for x in parallel 0::nat .. 10
		f[x]
	out.move-to.sort::nat[] is for x in 0::nat .. 10 then x

| This is like running something with `parallel` and then waiting on it.
| The purpose is to allow other fibers with the current exclusion to run while waiting.
+new-exclusion record
+with-block[t] t(_ new-exclusion, f t shared())
	await with-block parallel, f

+later record
| Run {f} in a new fiber with the current exclusion. So it can't run until the current fiber yields.
+with-block[t] t future(_ later, f t mut()) t shared
	with-block parallel, shared-of-mut-lambda f
test
	out nat mut[] = ()
	f void future = with in later
		out ~= 2
	out ~= 1
	out.to::nat[] is (1,) # this is guaranteed to not have changed yet
	await f
	out.to::nat[] is (1, 2)

| Does not await the future, but will log any exceptions from the future once it is done.
+forget[t] void(a t future)
	trusted
	assert js else todo # --------------------------------------------------------------------------------------------
	cb void mut(x js-any) = of error
		_ = call-property "console".js-global, "error", error
	_ = call-property a.as-js, "catch", cb.to

+fire-and-forget record
| Runs {f} in parallel and logs any exceptions, but does not await it.
+with-block void(_ fire-and-forget, f void shared())
	forget with-block parallel, f

+parallel-collection[col] record(collection col)
+parallel[col] col parallel-collection(a col)
	a,
| For each element of {a}, runs {f} in parallel. Then awaits them all.
+for-loop[out-elem, in-col, in-elem] out-elem[]
	a in-col parallel-collection
	f out-elem shared(elem in-elem)
do out-elem shared, in-elem shared, (in-col, in-elem) iterate, in-col size
	promises out-elem future[] = for x in a.collection
		with in parallel
			f[x]
	for x in promises
		trusted if js
			# Can't do `x await`, since that will fail if the input is not a Promise.
			# This is tricky because we may have implicitly awaited the Promise already.
			# TODO: I should *not* use Promise as future since it is implicitly awaited and thus hard to keep typed correctly. ----------------------
			# Instead have Future wrap Promise in a way that it won't be implicitly awaited.
			assume-type await as-js x
		else
			await x
test
	xs nat[] = for x in parallel 0::nat .. 5
		x * 2
	xs is (0, 2, 4, 6, 8)

| Same as the above but returning 'void'.
+for-loop[in-col, in-elem] void
	a in-col parallel-collection
	f void shared(elem in-elem)
do (in-col, in-elem) iterate, in-col size, in-elem shared
	promises void future[] = for x in a.collection
		with in parallel
			f[x]
	for x in promises
		await x

| Runs {f} in parallel for each element of {a} and returns elements for which it was {true}.
+filter[out-col, in-col, elem, builder] out-col
	a in-col parallel-collection
	f bool shared(elem elem)
do (in-col, elem) iterate, in-col size, (out-col, elem) list-new, elem shared
	bools bool[] = for-loop a, f
	with out in build
		for i, x in with-index a.collection
			if bools[i]
				out ~= x
