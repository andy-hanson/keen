no-std
import
	java/lang/Runnable
	java/lang/Throwable
	java/util/concurrent/CompletableFuture
	java/util/concurrent/ExecutionException
	java/util/concurrent/Future
	java/util/concurrent/ExecutorService
	./bool
	./col/array
	./col/mut-array
	./col/collection
	./col/sort
	./col/util
	./exception
	./js
	./json
	./misc
	./number
	./private/runtime
	./range
	./string
	./test-util
	./unsafe

| In Java, this is a `java.util.concurrent.Future`.
| In JS, this is a `Promise`.
+future[t] builtin

+await[t] t(a t future)
	trusted if extern java
		with : unlocked-exclusion
			try
				a.reinterpret-cast::Future.get reinterpret-cast
			catch ExecutionException e
				throw e.reinterpret-cast::Throwable.getCause reinterpret-cast
	elif extern js
		a.as-js.await cast
	else
		throw todo

| Just yields the fiber temporarily. It may be restarted immediately.
+yield-fiber void()
	trusted if extern java
		with : unlocked-exclusion
			()
	elif extern js
		resolver void mut(resolve void mut()) = resolve =>
			_ = "setTimeout".js-global call resolve, 0::float
		_ = "Promise".js-global call-new resolver await
	else
		throw todo

| Converts a value to a future resolved with that value.
+new[t] t future(value t) trusted
	if extern java
		res CompletableFuture = ()
		ok = res complete value.reinterpret-cast
		assert ok
		res reinterpret-cast
	elif extern js
		"Promise".js-global call-property "resolve", value cast
	else
		throw todo
test
	x nat future = 1,
	x.await is 1

| Future resolved with an exception.
+rejected[t] t future(err exception) trusted
	if extern java
		res CompletableFuture = ()
		ok = res completeExceptionally err.reinterpret-cast
		assert ok
		res reinterpret-cast
	elif extern js
		"Promise".js-global call-property "reject", err cast
	else
		throw todo
test
	fut nat future = "foo".error rejected
	try
		_ = fut await
		should-throw
	catch error e
		e.show is "foo"

+parallel record
| Run {f} in a new fiber with a new exclusion and return a future for its result.
+with-block[t] t future(_ parallel, f t shared()) trusted
	if extern java
		future CompletableFuture = ()
		fill-it void mut() = () =>
			ok = future complete f[].reinterpret-cast
			assert ok == true
		# Ignore this void turue
		_ Future = get-executor submit fill-it.reinterpret-cast::Runnable
		future reinterpret-cast
	elif extern js
		# `Promise.resolve().then(f)`; this ensures 'f' is not run immediately
		"Promise".js-global call-property "resolve" call-property "then", f cast
	else
		throw todo
# Test single future awaited by multiple fibers at once
test
	f nat future = with : later
		1
	a0 nat future = with : parallel
		f.await + 1
	a1 nat future = with : parallel
		f.await + 2
	a0.await is 2
	a1.await is 3
# This tests 'shared-of-mut-lambda', which the compiler uses to implement 'shared' lambdas.
test
	out nat mut[] = ()
	f void shared(x nat) = shared x =>
		out ~= x
		()
	for x : 0::nat .. 10 parallel
		f[x]
	out.move-to.sort::nat[] is for x : 0::nat .. 10; x

| This is like running something with `parallel` and then waiting on it.
| The purpose is to allow other fibers with the current exclusion to run while waiting.
+new-exclusion record
+with-block[t] t(_ new-exclusion, f t shared())
	parallel with-block f await

+later record
| Run {f} in a new fiber with the current exclusion. So it can't run until the current fiber yields.
+with-block[t] t future(_ later, f t mut()) t shared
	parallel with-block f.shared-of-mut-lambda
test
	out nat mut[] = ()
	f void future = with : later
		out ~= 2
	out ~= 1
	out.to::nat[] is (1,) # this is guaranteed to not have changed yet
	f await
	out.to::nat[] is (1, 2)

| Does not await the future, but will log any exceptions from the future once it is done.
+forget[t] void(a t future) trusted
	assert extern js : todo # --------------------------------------------------------------------------------------------
	cb void mut(x js-any) = error =>
		_ = "console".js-global call-property "error", error
	_ = a.as-js call-property "catch", cb

+fire-and-forget record
| Runs {f} in parallel and logs any exceptions, but does not await it.
+with-block void(_ fire-and-forget, f void shared()) trusted
	parallel with-block f forget

+parallel-collection[col] record(collection col)
+parallel[col] col parallel-collection(a col)
	a,
| For each element of {a}, runs {f} in parallel. Then awaits them all.
+for-loop[out-elem, in-col, in-elem] out-elem[]
	a in-col parallel-collection
	f out-elem shared(elem in-elem)
do out-elem shared, in-elem shared, (in-col, in-elem) iterate, in-col size
	promises out-elem future[] = for x : a collection
		with : parallel
			f[x]
	for x : promises
		trusted if extern js
			# Array.fromAsync already implicitly unwraps promises (TODO: this is a problem ..............................................)
			x.as-js cast
		else
			x await
test
	xs nat[] = for x : 0::nat .. 5 parallel
		x * 2
	xs is (0, 2, 4, 6, 8)

| Same as the above but returning 'void'.
+for-loop[in-col, in-elem] void
	a in-col parallel-collection
	f void shared(elem in-elem)
do (in-col, in-elem) iterate, in-col size, in-elem shared
	promises void future[] = for x : a collection
		with : parallel
			f[x]
	for x : promises
		x await

+parallel-concat[col] record(collection col)
| Runs {f} in parallel for each element of {a} and concatenates results.
+for-loop[out-elem, in-col, in-elem] out-elem[]
	a in-col parallel-concat
	f out-elem[] shared(elem in-elem)
do out-elem shared, in-elem shared, (in-col, in-elem) iterate, in-col size
	a.collection.parallel for-loop f flatten

| Runs {f} in parallel for each element of {a} and returns elements for which it was {true}.
+filter[out-col, in-col, elem, builder] out-col
	a in-col parallel-collection
	f bool shared(elem elem)
do (in-col, elem) iterate, in-col size, (out-col, elem, builder) build, elem shared
	bools bool[] = a for-loop f
	with out : build
		for i, x : a.collection with-index
			if bools[i]
				out ~= x

| Works like `parallel`, but works in groups of 'chunk-size' elements to reduce parallelism.
+chunked-parallel[col] record(collection col, chunk-size nat64)

+chunkable[chunk, col, iter, elem] spec chunk shared, \
	col shared, \
	elem shared, \
	(chunk, col, iter) groupable, \
	(col, elem) iterate, \
	(chunk, elem) iterate, \
	chunk size

+for-loop[out-elem, chunk, in-col, in-iter, in-elem] out-elem[]
	a in-col chunked-parallel
	f out-elem shared(elem in-elem)
do out-elem shared, (chunk, in-col, in-iter, in-elem) chunkable
	for chunk : a.collection groups-of a.chunk-size parallel-concat
		for x : chunk
			f[x]

+for-loop[chunk, in-col, in-iter, in-elem] void
	a in-col chunked-parallel
	f void shared(elem in-elem)
do (chunk, in-col, in-iter, in-elem) chunkable
	for chunk : a.collection groups-of a.chunk-size parallel
		for x : chunk
			f[x]

+filter[out-col, chunk, in-col, in-iter, elem, builder] out-col
	a in-col chunked-parallel
	f bool shared(elem elem)
do out-col shared, (chunk, in-col, in-iter, elem) chunkable, (out-col, elem, builder) build
	bools bool[] = a for-loop f
	with out : build
		for i, x : a.collection with-index
			if bools[i]
				out ~= x
