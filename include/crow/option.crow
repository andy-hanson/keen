no-std
import
	./bool
	./compare
export
	./private/bootstrap: option

| Empty option.
+new[t] t?() builtin

+==[t] bool(a t?, b t?) t equal
	if x ?= a
		if y ?= b
			x == y
		else
			false
	elif _ ?= b
		false
	else
		true
| An empty option is less than a non-empty option.
+<=>[t] comparison(a t?, b t?) t compare
	if x ?= a
		if y ?= b
			x <=> y
		else
			greater
	elif _ ?= b
		less
	else
		equal
