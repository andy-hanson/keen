no-std
import
	./bool: bool, false, new, true
	./compare: compare, comparison, equal, greater, less
	./number: nat64, new
	./private/bootstrap: exception, string
export
	./private/bootstrap: option

| Empty option.
+new[t] t?() bare, builtin

| Option containing {a}. This will always be non-empty.
+new[t] t?(a t) bare, builtin

+==[t] bool(a t?, b t?) bare, t equal
	if x ?= a
		if y ?= b
			x == y
		else
			false
	elif _ ?= b
		false
	else
		true
+<=>[t] comparison(a t?, b t?) bare, t compare
	if x ?= a
		if y ?= b
			x <=> y
		else
			greater
	elif _ ?= b
		less
	else
		equal

| True iff {a} is an empty option.
+is-empty[t] bool(a t?) bare
	unless _ ?= a
		true

| 0 if {a} is empty, 1 if {a} is non-empty.
+size[t] nat64(a t?) bare
	unless a is-empty
		1

| Lazily-evaluated.
| If {a} is non-empty, returns it and does not evaluate {b}.
| Else, returns {b}.
+||[t] t?(a t?, b t?) builtin, bare

| Lazily-evaluated.
| If {a} is non-empty, returns its value and does not evaluate {default}.
| Else, returns {default}.
+??[t] t(a t?, default t) builtin, bare

| Called like `a!`
| If {a} is non-empty, returns its value; else throws {force-option-error}.
+force[t] t(a t?) bare
	a ?? throw force-option-error
+force-option-error record exception case
+show string(_ force-option-error)
	"Tried to force empty option"
