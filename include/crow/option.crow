no-std
import
	./bool
	./compare
export
	./private/bootstrap: option

| Empty option.
+new[t] t?() builtin

+==[t] bool(a t?, b t?) t equal
	if a
		if b
			a == b
		else
			false
	elif b
		false
	else
		true
| An empty option is less than a non-empty option.
+<=>[t] comparison(a t?, b t?) t compare
	if a
		if b
			a <=> b
		else
			greater
	elif b
		less
	else
		equal
