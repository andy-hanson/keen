no-std
import
	./bool
	./col/array: array
	./compare: comparison
	./hash: hasher
	./misc: void
	./number: nat64
	./private/bootstrap: new, string-of-symbol
	./string
export
	./private/bootstrap: symbol

+== bool(a symbol, b symbol) trusted
	a.to::string == b.to::string

| Same as `{a}.to::string <=> {b}.to::string`.
+<=> comparison(a symbol, b symbol)
	a.to::string <=> b.to

+to string(a symbol)
	a string-of-symbol

| Interns a string.
| This is O(log n), where 'n' is the number of unique symbols that exist.
+to symbol(a string)
	false, a

+show string(a symbol)
	a to

+hash-mix void(hasher hasher, a symbol)
	hasher hash-mix a.to::string

+to symbol(a symbol)
	a
+to symbol(a nat64)
	a.show to

+interpolate symbol(...parts string[])
	"" join parts to
