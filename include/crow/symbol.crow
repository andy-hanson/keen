no-std
import
	./col/array: array
	./hash: hasher
	./misc: void
	./number: nat64
	./string: hash-mix, join, show, string
export
	./private/symbol-low-level: ==, <=>, symbol, to

+show string(a symbol)
	a to

+hash-mix void(hasher hasher, a symbol)
	hasher hash-mix a.to::string

+to symbol(a symbol)
	a
+to symbol(a nat64)
	a.show to

+interpolate symbol(...parts string[])
	"" join parts to
