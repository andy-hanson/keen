no-std
import
	java/util/Arrays
	java/lang/String
	./bool
	./col/array
	./col/collection
	./col/experimental/object-memoizer
	./col/mut-slice
	./col/private/array-low-level: inner, view-indices
	./compare
	./hash
	./js
	./misc
	./number
	./private/bootstrap: new, symbol-chars, symbol-hash
	./range
	./string
	./unsafe
export
	./private/bootstrap: symbol

-symbol-key record
	hash nat64
	chars char8 array-view
-memoizer-key symbol-key(a symbol)
	a.symbol-hash, a.symbol-chars.to
-== bool(a symbol-key, b symbol-key)
	a.chars == b.chars

~hash nat64(a symbol)
	a symbol-hash

+== bool(a symbol, b symbol)
	trusted a reference-equal b
-== bool(a char8 array-view, b char8 array-view) # TODO: reuse the existing function? ----------------------------------------------
	if trusted extern java
		ai int8 mut-slice = trusted a.inner reinterpret-cast
		bi int8 mut-slice = trusted b.inner reinterpret-cast
		av = a view-indices
		bv = b view-indices
		trusted ai equals av.low.wrap-to, av.high.wrap-to, bi, bv.low.wrap-to, bv.high.wrap-to
	else
		size = a.size
		guard size == b.size
		i mut nat = 0
		loop
			if i == size
				break true
			elif a[i] == b[i]
				i +:= 1
				continue
			else
				break false
-wrap-to int32(a nat64)
	a.wrap-to::nat32 wrap-to

| Same as `{a}.to::string <=> {b}.to::string`.
+<=> comparison(a symbol, b symbol)
	a.to::string <=> b.to

+to string(a symbol)
	a.to::char8[] to
+to char8[](a symbol)
	a symbol-chars

| Interns a string.
+to symbol(a string)
	a.to::char8[] to
+to symbol(a char8[])
	a.to::(char8 array-view) to
+to symbol(a char8 array-view)
	hash =
		hasher hasher = ()
		for x in a
			hasher hash-mix x
		hasher finish
	trusted lookup memoize (hash, a), of
		hash, a.to
		
+to symbol(a String) java extern
	a.to::string to

-lookup global((symbol, symbol-key) object-memoizer)

+show string(a symbol)
	a to

+hash-mix void(hasher hasher, a symbol)
	hasher hash-mix a.symbol-hash

+to symbol(a symbol) # Why did I do this ----------------------------------------------------------------------------------------
	a
+to symbol(a nat64)
	a.show to

+interpolate symbol(...parts string[])
	parts.interpolate to

| Converts to a JS 'string', not a 'Symbol'
+to js-any(a symbol) js extern
	a.to::string to
+to symbol(a js-any) js extern
	a.to::string to
