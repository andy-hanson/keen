no-std
import
	./bool
	./col/array
	./col/collection
	./col/experimental/object-memoizer
	./compare
	./hash
	./misc
	./number
	./private/bootstrap: new, symbol-chars, symbol-id, symbol-hash
	./string
	./unsafe
export
	./private/bootstrap: symbol

-symbol-key record
	hash nat64
	chars char8 array-view
-memoizer-key symbol-key(a symbol)
	a.symbol-hash, a.symbol-chars.to
-== bool(a symbol-key, b symbol-key)
	a.chars == b.chars

+== bool(a symbol, b symbol)
	trusted a reference-equal b
-== bool(a char8 array-view, b char8 array-view) # TODO: reuse the existing function? ----------------------------------------------
	size = a.size
	guard size == b.size
	i mut nat = 0
	loop
		if i == size
			break true
		elif a[i] == b[i]
			i +:= 1
			continue
		else
			break false

| Same as `{a}.to::string <=> {b}.to::string`.
+<=> comparison(a symbol, b symbol)
	a.to::string <=> b.to

+to string(a symbol)
	a.symbol-chars to

| Interns a string.
| This is O(log n), where 'n' is the number of unique symbols that exist.
+to symbol(a string)
	a.to::char8[] to
+to symbol(a char8[])
	a.to::(char8 array-view) to
+to symbol(a char8 array-view) trusted
	hash = do
		hasher hasher = ()
		for x : a
			hasher hash-mix x
		hasher finish
	lookup memoize (hash, a), () =>
		res symbol = next-id, hash, a.to
		next-id +:= 1
		res

-lookup global((symbol, symbol-key) object-memoizer)
-next-id global(nat64)
	1

+show string(a symbol)
	a to

+hash-mix void(hasher hasher, a symbol)
	hasher hash-mix a.symbol-id

+to symbol(a symbol)
	a
+to symbol(a nat64)
	a.show to

+interpolate symbol(...parts string[])
	"" join parts to
