no-std
import
	java/lang/String
	./bool
	./col/array
	./col/experimental/object-memoizer
	./compare
	./hash
	./js
	./misc
	./number
	./private/bootstrap: new, symbol-chars, symbol-hash
	./string
	./unsafe
export
	./private/bootstrap: symbol

-symbol-key record
	hash nat64
	chars char8 array-view
-memoizer-key symbol-key(a symbol)
	a.symbol-hash, a.symbol-chars.to
-== bool(a symbol-key, b symbol-key)
	a.chars == b.chars

~hash-value nat64(a symbol)
	a symbol-hash

+== bool(a symbol, b symbol)
	trusted a reference-equal b

| Same as `{a}.to::string <=> {b}.to::string`.
+<=> comparison(a symbol, b symbol)
	a.to::string <=> b.to

+to string(a symbol)
	a.to::char8[] to
+to char8[](a symbol)
	a symbol-chars

| Interns a string.
+to symbol(a string)
	a.to::char8[] to
+to symbol(a char8[])
	a.to::(char8 array-view) to
+to symbol(a char8 array-view)
	hash =
		state hash-state = ()
		a hash state
		state finish
	trusted lookup memoize (hash, a), of
		hash, a.to

+to symbol(a String) java extern
	a.to::string to

-lookup global((symbol, symbol-key) object-memoizer)

+show string(a symbol)
	a to

+hash void(a symbol, state hash-state)
	a.symbol-hash hash state

+to symbol(a symbol) # Why did I do this ----------------------------------------------------------------------------------------
	a
+to symbol(a nat64)
	a.show to

+interpolate symbol(parts string[])
	parts.interpolate::string to

| Converts to a JS 'string', not a 'Symbol'
+to js-any(a symbol) js extern
	a.to::string to
+to symbol(a js-any) js extern
	a.to::string to
