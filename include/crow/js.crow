| Contains functions for JavaScript primitive operations.

no-std
import
	./private/bootstrap: array, bool, float64, void, nat64, string
export
	./private/bootstrap: js-any

| Treats the value as a JS value without doing anything to it.
| WARN: Only do this with a type you know the representation of.
| For example, a Crow {string} will not work as a JS string.
+as-js[t] js-any(a t) builtin, unsafe, js extern
| Treats the JS value as a Crow value without doing anything to it.
| WARN: Only do this with a type you know the representation of.
| For example, a JS string will not work as a Crow {string}.
+cast[t] t(a js-any) builtin, unsafe, js extern

| 'self' in the browser or 'global' in node.js
+js-global js-any() builtin, unsafe, js extern
+js-global js-any(name string) builtin, unsafe, js extern
| `{a}[{key}]`
+subscript js-any(a js-any, key string) builtin, unsafe, js extern
| In JavaScript, the argument to a subscript is always a string,
| and array indices are implicitly converted to strings.
+subscript js-any(a js-any, key nat64) builtin, unsafe, js extern
+subscript js-any(a js-any, key float64) builtin, unsafe, js extern
| `{a}[{key}] = {value}`
+set-subscript void(a js-any, key string, value js-any) builtin, unsafe, js extern
+set-subscript void(a js-any, key nat64, value js-any) builtin, unsafe, js extern
+set-subscript void(a js-any, key float64, value js-any) builtin, unsafe, js extern
