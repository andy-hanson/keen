| Contains functions for JavaScript primitive operations.

no-std
import
	./bool
	./private/bootstrap: array
	./misc
	./unsafe
export
	./private/bootstrap: js-any

| Treats the value as a JS value without doing anything to it.
| WARN: Only do this with a type you know the representation of.
| For example, a Crow 'string' will not work as a JS string.
+as-js[t] js-any(a t) unsafe, js
	a reinterpret-cast
| Treats the JS value as a Crow value without doing anything to it.
| WARN: Only do this with a type you know the representation of.
| For example, a JS string will not work as a Crow 'string'.
+assume-type[t] t(a js-any) unsafe, js
	a reinterpret-cast

| 'self' in the browser or 'global' in node.js
+js-global js-any() builtin, unsafe, js
+js-global js-any(name js-any) builtin, unsafe, js
| Gets a property from a JS object.
| For a  function call use {call} or {call-property}.
+subscript js-any(a js-any, key js-any) builtin, unsafe, js
| Sets a property on a JS object.
+set-subscript void(a js-any, key js-any, value js-any) builtin, unsafe, js
| `{a}()`
| WARN: This does not {await} the result.
| WARN: {subscript} followed by {call} may not work. Use {call-property} instead.
+call js-any(a js-any) builtin, unsafe, js
| `{a}({arg})`
+call js-any(a js-any, arg js-any) builtin, unsafe, js
| `{a}({arg0}, {arg1})`
+call js-any(a js-any, arg0 js-any, arg1 js-any) builtin, unsafe, js
| `{a}({arg0}, {arg1}, {arg2})`
+call js-any(a js-any, arg0 js-any, arg1 js-any, arg2 js-any) builtin, unsafe, js
| `new {a}()`
+call-new js-any(a js-any) builtin, unsafe, js
| `new {a}({arg})`
+call-new js-any(a js-any, arg js-any) builtin, unsafe, js
| `new {a}({arg0}, {arg1})`
+call-new js-any(a js-any, arg0 js-any, arg1 js-any) builtin, unsafe, js
| `new {a}({arg0}, {arg1}, {arg2})`
+call-new js-any(a js-any, arg0 js-any, arg1 js-any, arg2 js-any) builtin, unsafe, js
| `{a}[{name}]()`
+call-property js-any(a js-any, name js-any) builtin, unsafe, js
| `{a}[{name}]({arg})`
+call-property js-any(a js-any, name js-any, arg js-any) builtin, unsafe, js
| `{a}[{name}]({arg0}, {arg1})`
+call-property js-any
	a js-any
	name js-any
	arg0 js-any
	arg1 js-any
do builtin, unsafe, js
| `{a}[{name}]({arg0}, {arg1}, {arg2})`
+call-property js-any
	a js-any
	name js-any
	arg0 js-any
	arg1 js-any
	arg2 js-any
do builtin, unsafe, js
| `{a}[{name}]({arg0}, {arg1}, {arg2}, {arg3})`
+call-property js-any
	a js-any
	name js-any
	arg0 js-any
	arg1 js-any
	arg2 js-any
	arg3 js-any
do builtin, unsafe, js
| `{a}[{name}](...{args})`
+call-property-spread js-any(a js-any, name js-any, args js-any[]) builtin, unsafe, js

+null js-any() builtin, js
+undefined js-any() builtin, js

region Unary operators
+await js-any(a js-any) builtin, unsafe, js
+typeof js-any(a js-any) builtin, unsafe, js

region Binary operators
| NOTE: This is actually JavaScript's `===` operator.
+== bool(a js-any, b js-any) builtin, unsafe, js
+instanceof bool(a js-any, b js-any) builtin, unsafe, js
+< bool(a js-any, b js-any) builtin, unsafe, js
++ js-any(a js-any, b js-any) builtin, unsafe, js

region Utiliies

| Calls JavaScript's 'eval' function. 'source' should be JavaScript source code.
| This could be useful for making use of JS features that don't have a Crow analog,
| or if you just have a big chunk of JS code and don't have time to translate it to Crow.
|
| This happens in its own scope, so don't count on anything being in the enclosing scope.
| Instead, {eval} a function literal, then {call} it, like `"x => f(x)".eval call x`.
| If appropriate, remember to make the function `async` and {await} the result.
+eval js-any(source js-any) builtin, unsafe, js

+js-import js-any(name js-any) builtin, unsafe, js

+to void(a js-any) js
	assert trusted a == undefined
	()
+to js-any(a void) js
	trusted a reinterpret-cast
+to bool(a js-any) js
	trusted
	assert a.typeof == "boolean"
	a reinterpret-cast
+to js-any(a bool) js
	trusted a reinterpret-cast
+false js-any() js
	false::bool to
+true js-any() js
	true::bool to

+to js-any(a void mut()) js
	trusted a reinterpret-cast
+to js-any(a void mut(arg js-any)) js
	trusted a reinterpret-cast
+to js-any(a js-any mut()) js
	trusted a reinterpret-cast
+to js-any(a js-any mut(arg js-any)) js
	trusted a reinterpret-cast
