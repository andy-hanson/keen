import
	crow/js
	crow/unsafe: reinterpret-cast
	./util

| Represents a DOM node.
# TODO: have a way to actually define a type like this! ----------------------------------------------------------------------------
+node alias
	js-any

region Create nodes

| Create a new DOM node with the given tag.
+create-node node(tag-name symbol) js extern
	trusted "document".js-global call-property "createElement", tag-name.to
| Create a new node with the given tag and HTML attributes.
+create-node node(tag-name symbol, attr string[symbol]) js extern
	node = tag-name create-node
	for key, value in attr
		_ = trusted node.as-js call-property "setAttribute", key.to, value.to
	node
+create-node node
	tag-name symbol
	attr string[symbol]
	class-name string?
	children node[]
do js extern
	trusted
	node = tag-name create-node attr
	if x ?= class-name
		node["className"] := x to
	_ = node call-property-spread "append", children
	node

+create-button node
	title string
	class-name string
	children node[]
	on-click void mut()
do js extern
	trusted
	res = "button" create-node (("title", title),), class-name, children
	res.as-js["onclick"] := on-click as-js
	res

+style record(node node) mut
+set-subscript void(a style, key symbol, value string) js extern
	trusted
	a.node.as-js["style"][key to] := value to

+classes record(node node) mut
+~= void(a classes, class-name string) js extern
	_ = trusted a.node["classList"] call-property "add", class-name.to
+-= void(a classes, class-name string) js extern
	_ = trusted a.node["classList"] call-property "remove", class-name.to
+set-classes void(a node, class-names string[]) js extern
	trusted
	a["className"] := " " join class-names to
+set-subscript void(a classes, class-name string, value bool) js extern
	if value
		a ~= class-name
	else
		a -= class-name

+set-text-content void(a node, text string) js extern
	trusted
	a["textContent"] := text to

+add-event-listener void(a node, event-name string, fn void mut(event js-any)) js extern
	trusted
	_ = a call-property "addEventListener", event-name.to, fn.as-js

+create-input-text node(on-input void mut(x js-any), value string) js extern
	trusted
	res = "input" create-node (("type", "text"), ("value", value))
	_ = res.as-js call-property "addEventListener", "input", on-input.as-js
	res

+create-div node() js extern
	"" create-div
+create-div node(class-name string) js extern
	class-name create-div ()
+create-div node(class-name string, children node[]) js extern
	"div" create-node (), class-name, children

+create-span node(class-name string, children node[]) js extern
	class-name create-span (), children
+create-span node(class-name string, attr string[symbol], children node[]) js extern
	"span" create-node attr, class-name, children

+create-text-node node(text string) js extern
	trusted "document".js-global call-property "createTextNode", text.to

+document node() summon, js extern
	trusted "document" js-global

region Node properties

+is-text-node bool(a node) js extern
	trusted a["nodeType"].to::nat32 == 3

+attributes record(node node) mut
+subscript string?(a attributes, attr-name symbol) js extern
	trusted
	res = a.node call-property "getAttribute", attr-name.to
	unless res == null then res to
+set-subscript void(a attributes, attr-name symbol, value string) js extern
	trusted
	_ = a.node call-property "setAttribute", attr-name.to, value.to
+set-subscript void(a attributes, attr-name symbol, value bool) js extern
	trusted
	_ = a.node call-property "setAttribute", attr-name.to, value.to
+-= void(a attributes, attr-name symbol) js extern
	trusted
	_ = a.node call-property "removeAttribute", attr-name.to

| Gets the value for an input node, or "" if it's not an input node.
+value string(a node) js extern
	trusted
	value = a["value"]
	unless value == undefined then value to
| You can set a 'value' on any node, but it will only make a visual difference for input nodes.
+set-value void(a node, value string) js extern
	trusted
	a["value"] := value to

region Node queries

| Calls 'querySelector'
+query node?(parent node, selector string) js extern
	trusted
	res = parent.as-js call-property "querySelector", selector.to
	unless res == null then res

+query-all node[](selector string) js extern
	trusted "document".js-global call-property "querySelectorAll", selector.to array-of-node-list

+child-nodes node[](a node) js extern
	trusted a["childNodes"] array-of-node-list

-array-of-node-list node[](node-list js-any) js extern
	trusted "Array".js-global call-property "from", node-list to

| Calls 'getElementById'
+element node?(parent node, id string) js extern
	trusted
	res = parent call-property "getElementById", id.to
	unless res == null then res

+first-child node?(a node) js extern
	trusted
	res = a.as-js["firstChild"]
	unless res == null then res

region Events

+on-click void(a node, fn void mut()) summon, js extern
	_ = trusted a.as-js call-property "addEventListener", "click"::js-any, fn.as-js

+on-mouse-down void(a node, fn void mut()) summon, js extern
	_ = trusted a.as-js call-property "addEventListener", "mousedown"::js-any, fn.as-js

+on-mouse-up void(a node, fn void mut()) summon, js extern
	_ = trusted a.as-js call-property "addEventListener", "mouseup"::js-any, fn.as-js

region Mutations

+id string(a node) js extern
	trusted a["id"] to
+set-id void(a node, value string) js extern
	trusted
	a.as-js["id"] := value to

| Append a child node.
+~= void(a node, b node) js extern
	_ = trusted a.as-js call-property "appendChild", b

| Append many child nodes.
+~~= void(a node, b node[]) js extern
	for x in b
		a ~= x

| Overwrites any existing child nodes.
+set-children void(a node, children node[]) js extern
	a remove-all-children
	a ~~= children

+remove-all-children void(a node) js extern
	while child ?= a first-child
		_ = trusted a.as-js call-property "removeChild", child

region Custom elements

+custom-element-options record
	styles string[]
+new custom-element-options(style string)
	styles: style,
+define-custom-element void(element-name string, connected connected-callback) summon, js extern
	element-name define-custom-element (styles: ()), connected
+define-custom-element void
	element-name string
	options custom-element-options
	connected connected-callback
do summon, js extern
	trusted
	constructor method = of this, _
		root = this call-property "attachShadow", mode: "open"
		sheets js-any[] = for style in options styles
			sheet = "CSSStyleSheet".js-global call-new
			_ = sheet call-property "replace", style.to
			sheet
		root["adoptedStyleSheets"] := sheets to
		()::void to # TODO: just '()' should do .....................................................................................................
	connected-callback method = of this, _
		connected[this as-custom-element-node] as-js
	cls = "HTMLElement".js-global make-class constructor, connectedCallback: connected-callback
	_ = "customElements".js-global call-property "define", element-name.to, cls

+connected-callback alias
	void mut(this custom-element-node)

# +custom-element-node extern ----------------------------------------------------------------------------------------------------
# TODO: also, figure out why it crashes when I try to make this an alias for js-any (some early access to 'target' is crashing it)
+custom-element-node record(dummy js-any)
+as-custom-element-node custom-element-node(a js-any) unsafe, js extern
	a reinterpret-cast
+as-node node(a custom-element-node) js extern
	trusted a reinterpret-cast
+attributes attributes(a custom-element-node) js extern
	a.as-node attributes
+shadow-root node(a custom-element-node) js extern
	trusted a.as-node["shadowRoot"]

+wait-until-window-loaded void() summon, js extern
	trusted
	unless "document".js-global["readyState"] == "complete"
		_ = "new Promise(resolve => window.addEventListener('load', resolve))".eval await
