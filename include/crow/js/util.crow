import
	crow/unsafe
	../js

+self js-any() unsafe, js extern
	"self" js-global

| Creates an empty JS object.
+new js-any() js extern
	trusted "Object".js-global call-new
| Create a new JS object.
+named-new js-any(keys symbol[], values js-any[]) unsafe, js extern
	keys.size is values.size
	res js-any = ()
	for i in 0 .. keys.size
		res[keys[i] to] := values[i]
	res

+to js-any(a json) js extern
	match a simplify
	as null
		null
	as bool x
		x to
	as float64 x
		x to
	as string x
		x to
	as array xs
		trusted
		res js-any = "Array".js-global call-new
		for x in xs
			_ = res call-property "push", x.to
		res
	as map o
		trusted
		res js-any = "Object".js-global call-new
		for key, value in o
			res[key to] := value to
		res

| {reinterpret-cast} as an `Int8Array`. Unsafe because that is mutable.
+to js-any(a int8[]) unsafe, js extern
	a reinterpret-cast
| {reinterpret-cast} as an `Int16Array`. Unsafe because that is mutable.
+to js-any(a int16[]) unsafe, js extern
	a reinterpret-cast
| {reinterpret-cast} as an `Int32Array`. Unsafe because that is mutable.
+to js-any(a int32[]) unsafe, js extern
	a reinterpret-cast
| {reinterpret-cast} as an `Int64Array`. Unsafe because that is mutable.
+to js-any(a int64[]) unsafe, js extern
	a reinterpret-cast
| {reinterpret-cast} as a `Uint8Array`. Unsafe because that is mutable.
+to js-any(a nat8[]) unsafe, js extern
	a reinterpret-cast
+to js-any(a char8[]) unsafe, js extern
	a reinterpret-cast
| {reinterpret-cast} as a `Uint16Array`. Unsafe because that is mutable.
+to js-any(a nat16[]) unsafe, js extern
	a reinterpret-cast
| {reinterpret-cast} as a `Uint32Array`. Unsafe because that is mutable.
+to js-any(a nat32[]) unsafe, js extern
	a reinterpret-cast
| {reinterpret-cast} as a `Uint64Array`. Unsafe because that is mutable.
+to js-any(a nat64[]) unsafe, js extern
	a reinterpret-cast

# DOCUMENT ------------------------------------------------------------------------------------------------------------------------------------------
+to int8[](a js-any) unsafe, js extern
	assert a instanceof "Int8Array".js-global
	a reinterpret-cast
+to int16[](a js-any) unsafe, js extern
	assert a instanceof "Int16Array".js-global
	a reinterpret-cast
+to int32[](a js-any) unsafe, js extern
	assert a instanceof "Int32Array".js-global
	a reinterpret-cast
+to int64[](a js-any) unsafe, js extern
	assert a instanceof "Int64Array".js-global
	a reinterpret-cast
+to char8[](a js-any) unsafe, js extern
	assert a instanceof "Char8Array".js-global
	a reinterpret-cast
+to nat8[](a js-any) unsafe, js extern
	assert a instanceof "Uint8Array".js-global
	a reinterpret-cast
+to nat16[](a js-any) unsafe, js extern
	assert a instanceof "Uint16Array".js-global
	a reinterpret-cast
+to nat32[](a js-any) unsafe, js extern
	assert a instanceof "Uint32Array".js-global
	a reinterpret-cast
+to nat64[](a js-any) unsafe, js extern
	assert a instanceof "Uint64Array".js-global
	a reinterpret-cast

| {reinterpret-cast} as a JS array. Unsafe because that is mutable.
+to js-any(a js-any[]) unsafe, js extern
	a reinterpret-cast
| {reinterpret-cast} the value as an array. Unsafe because the input may be mutable.
+to js-any[](a js-any) unsafe, js extern
	assert a instanceof "Array".js-global
	a reinterpret-cast

###
Creates a new JS class.
This currently does not support fields, getters/setters, or calling 'super' with arguments.
###
+make-class js-any
	super-class js-any
	constructor method
	methods method[symbol]
do unsafe, js extern
	src js-any = quote
		(ctor, Super) => class extends Super \{
			constructor(...args) \{
				super()
				ctor(\{ a: this, b: args })
			}
		}
	res = src.eval call constructor.as-js, super-class
	for name, method in methods
		res["prototype"][name to] := method make-method
	res

+method alias
	js-any mut(this js-any, args js-any[])

-make-method js-any(fn method) unsafe, js extern
	"fn => function(...args) \{ return fn(\{ a: this, b: args }) }".eval call fn.as-js
