import
	../js

# TODO: maybe rename js to js-low-level, then make this the new 'js'

+self js-any() unsafe, js extern
	"self" js-global

| Create a new JavaScript object.
+named-new js-any(keys symbol[], values js-any[]) unsafe, js extern
	keys.size is values.size
	res = "Object".js-global call-new
	for i in 0 .. keys.size
		key = keys[i]
		value = values[i]
		res[key to] := value
	res

# Converts a JS nullable / undefined-able value to 't'.
+is-nullish bool(a js-any) unsafe, js extern
	a == null or a == undefined

###
Creates a new JavaScript class.
This currently does not support fields, getters/setters, or calling 'super' with arguments.
###
+make-class js-any
	super-class js-any
	constructor method
	methods method[symbol]
do unsafe, js extern
	res = """
		(ctor, Super) => class extends Super \{
			constructor(...args) \{
				super()
				ctor(\{ a: this, b: args })
			}
		}
	""".eval call constructor.as-js, super-class
	for name, method in methods
		res["prototype"][name to] := method make-method
	res

+method alias
	js-any mut(this js-any, args js-any[])

-make-method js-any(fn method) unsafe, js extern
	make-method = """
		fn => function(...args) \{
			return fn(\{ a: this, b: args })
		}
	""" eval
	make-method call fn.as-js
