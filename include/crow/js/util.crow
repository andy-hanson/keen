use-prefix
import
	crow/unsafe
	../js

+self js-any() unsafe, js
	js-global "self"

+new js-any() js
	null
| Create a new JS object.
+named-new js-any(keys symbol[], values js-any[]) unsafe, js
	keys.size is values.size
	res js-any = call-new "Object".js-global
	for i in 0 .. keys.size
		res[keys[i].to] := values[i]
	res

+to js-any(a json) js
	match x = simplify a
	as null
		null
	as bool
		x.to
	as float64
		x.to
	as string
		x.to
	as array
		trusted
		res js-any = call-new "Array".js-global
		for y in x
			_ = call-property res, "push", y.to
		res
	as map
		trusted
		res js-any = call-new "Object".js-global
		for key, value in x
			res[key.to] := value.to
		res

| {reinterpret-cast} as an `Int8Array`. Unsafe because that is mutable.
+to js-any(a int8[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as an `Int16Array`. Unsafe because that is mutable.
+to js-any(a int16[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as an `Int32Array`. Unsafe because that is mutable.
+to js-any(a int32[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as an `Int64Array`. Unsafe because that is mutable.
+to js-any(a int64[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as a `Uint8Array`. Unsafe because that is mutable.
+to js-any(a nat8[]) unsafe, js
	reinterpret-cast a
+to js-any(a char8[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as a `Uint16Array`. Unsafe because that is mutable.
+to js-any(a nat16[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as a `Uint32Array`. Unsafe because that is mutable.
+to js-any(a nat32[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as a `Uint64Array`. Unsafe because that is mutable.
+to js-any(a nat64[]) unsafe, js
	reinterpret-cast a

# DOCUMENT ------------------------------------------------------------------------------------------------------------------------------------------
+to int8[](a js-any) unsafe, js
	assert a 'instanceof "Int8Array".js-global
	reinterpret-cast a
+to int16[](a js-any) unsafe, js
	assert a 'instanceof "Int16Array".js-global
	reinterpret-cast a
+to int32[](a js-any) unsafe, js
	assert a 'instanceof "Int32Array".js-global
	reinterpret-cast a
+to int64[](a js-any) unsafe, js
	assert a 'instanceof "Int64Array".js-global
	reinterpret-cast a
+to char8[](a js-any) unsafe, js
	assert a 'instanceof "Char8Array".js-global
	reinterpret-cast a
+to nat8[](a js-any) unsafe, js
	assert a 'instanceof "Uint8Array".js-global
	reinterpret-cast a
+to nat16[](a js-any) unsafe, js
	assert a 'instanceof "Uint16Array".js-global
	reinterpret-cast a
+to nat32[](a js-any) unsafe, js
	assert a 'instanceof "Uint32Array".js-global
	reinterpret-cast a
+to nat64[](a js-any) unsafe, js
	assert a 'instanceof "Uint64Array".js-global
	reinterpret-cast a

| {reinterpret-cast} as a JS array. Unsafe because that is mutable.
+to js-any(a js-any[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} the value as an array. Unsafe because the input may be mutable.
+to js-any[](a js-any) unsafe, js
	assert a 'instanceof "Array".js-global
	reinterpret-cast a

###
Creates a new JS class.
This currently does not support fields, getters/setters, or calling 'super' with arguments.
###
+make-class js-any
	super-class js-any
	constructor method
	methods method[symbol]
do unsafe, js
	src js-any = quote
		(ctor, Super) => class extends Super \{
			constructor(...args) \{
				super()
				ctor(\{ a: this, b: args })
			}
		}
	res = call src.eval, constructor.as-js, super-class
	for name, method in methods
		res["prototype"][name.to] := make-method method
	res

+method alias
	js-any mut(this js-any, args js-any[])

-make-method js-any(fn method) unsafe, js
	call "fn => function(...args) \{ return fn(\{ a: this, b: args }) }".eval, fn.as-js

+debugger void() js
	trusted
	_ = eval "debugger"
