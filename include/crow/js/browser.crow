use-prefix
import
	crow/parse
	../js
	./util

+alert void(message string) summon, js
	_ = trusted call "alert".js-global, message.to

+document-cookies record
+cookies document-cookies()
	()
+subscript string?(_ document-cookies, cookie-name string) summon, js
	cookie-string string = trusted "document".js-global["cookie"].to
	guard !is-empty cookie-string
	first (split cookie-string, ";"), of part
		name, value = try-split-once! part, "="
		if name == cookie-name then value

+fetch-error record(url string, status nat, response string) exception case
+show string(a fetch-error)
	"HTTP {a.status} error fetching {a.url}: {a.response}"

+fetch string(url string) summon, js
	fetch-text url, ()
+fetch json(url string) summon, js
	parse json, url.fetch
+fetch nat8[](url string) summon, js
	trusted get-bytes fetch-response url, ()

+post[body] json
	url string
	body body
do (json, string) to, body show, summon, js
	post url, body, exclude-credentials
+include-credentials enum(include-credentials, exclude-credentials)
+post[body] json
	url string
	body body
	credentials include-credentials
do body show, summon, js
	parse json, fetch-text url, post-options body.show, credentials
-post-options js-any(body string, credentials include-credentials) js
	trusted
	cred js-any = match credentials
	as include-credentials
		"include"
	as exclude-credentials
		undefined
	method: "POST"
	body: body.show.as-js
	credentials: cred

-fetch-text string(url string, options js-any) summon, js
	trusted await (fetch-response url, options 'call-property "text") 'to
-fetch-response js-any(url string, options js-any) summon, unsafe, js
	response = await call "fetch".js-global, url.to, options
	status nat32 = response["status"].to
	assert status == 200 else fetch-error url, status.to, response.get-text
	response

-get-text string(response js-any) summon, unsafe, js
	await call-property response, "text" 'to
-get-bytes nat8[](response js-any) summon, unsafe, js
	await call-property response, "bytes" 'to
