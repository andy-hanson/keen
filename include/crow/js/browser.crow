import
	crow/parse
	../js
	./util

+alert void(message string) summon, js extern
	_ = trusted "alert".js-global call message.to

+document-cookies record
+cookies document-cookies()
	()
+subscript string?(_ document-cookies, cookie-name string) summon, js extern
	cookie-string string = trusted "document".js-global["cookie"] to
	guard cookie-string !is-empty
	cookie-string split ";" first of part
		name, value = part try-split-once! "="
		if name == cookie-name then value

+fetch-error record(url string, status nat, message string) exception case
+show string(a fetch-error)
	"HTTP {a status} error fetching {a url}: {a message}"

+fetch string(url string) summon, js extern
	url fetch-text ()
+fetch json(url string) summon, js extern
	json parse url.fetch
+fetch nat8[](url string) summon, js extern
	trusted url fetch-response () get-bytes

+post[body] json
	url string
	body body
do (json, string) to, body show, summon, js extern
	url post body, exclude-credentials
+include-credentials enum(include-credentials, exclude-credentials)
+post[body] json
	url string
	body body
	credentials include-credentials
do body show, summon, js extern
	json parse do url fetch-text do body.show post-options credentials
-post-options js-any(body string, credentials include-credentials) js extern
	trusted
	cred js-any = match credentials
	as include-credentials
		"include"
	as exclude-credentials
		undefined
	method: "POST"
	body: body.show as-js
	credentials: cred

-fetch-text string(url string, options js-any) summon, js extern
	trusted (url fetch-response options call-property "text").await to
-fetch-response js-any(url string, options js-any) summon, unsafe, js extern
	response = "fetch".js-global call url.to, options await
	status nat32 = response["status"] to
	assert status == 200 else url fetch-error status.to, response.get-text
	response

-get-text string(response js-any) summon, unsafe, js extern
	(response call-property "text").await to
-get-bytes nat8[](response js-any) summon, unsafe, js extern
	(response call-property "bytes").await to
