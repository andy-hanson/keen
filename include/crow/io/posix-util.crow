no-std
import
	system/errno: errno
	../c-types: err-t
	../exception: error
	../misc: new, void
	../number: ==
	../string: interpolate, show

| Fail if `{errno} != 0`.
check-errno void() summon, unsafe, (libc, native) extern
	errno check-posix-error

| Fail if `{a} != 0`.
check-posix-error void(a err-t)
	assert a == 0 : "posix error {a}" error
