no-std
import
	java/io/PrintStream
	java/lang/System
	../bool
	# TODO: there is a compiler bug where it thinks the module is unused if I don't have `: equal` --------------------------------------------------
	../compare: equal
	../exception
	../js
	../misc
	../string
	../symbol

+print-error record(show string) exception case

+pipe enum(out, err)
+== bool(a pipe, b pipe)
+show string(a pipe)
	a to
+to symbol(a pipe)
+to string(a pipe)
	a.to::symbol to

+to PrintStream(a pipe) summon, java extern
	trusted match a
	as out
		out
	as err
		err

| Print to stdout or stderr, including a newline.
+print void(pipe pipe, message string) summon
	trusted if extern java
		pipe.to println message.to
	elif extern js
		fn js-any = match pipe
		as out
			"info"
		as err
			"error"
		_ = "console".js-global call-property fn, message.to
	else
		throw not-implemented

| Print to stdout or stderr, without appending a newline.
+print-no-newline void(pipe pipe, message string) summon
	trusted
	assert extern java else todo
	pipe.to print message.to

| Clear the terminal.
+clear-screen void() summon
	out print-no-newline "\x1bc"
