no-std
import
	java/io/PrintStream
	java/lang/System
	../bool
	# TODO: there is a compiler bug where it thinks the module is unused if I don't have `: equal` --------------------------------------------------
	../compare: equal
	../exception
	../js
	../misc
	../string
	../symbol

+print-error record(show string) exception case

+pipe enum(out, err)
+== bool(a pipe, b pipe)
+show string(a pipe)
	a.to
+to symbol(a pipe)
+to string(a pipe)
	a.to::symbol.to

+to PrintStream(a pipe) summon, java
	trusted match a
	as out
		out
	as err
		err

+print void(message string) summon
	print out::pipe, message

| Print to stdout or stderr, including a newline.
+print void(pipe pipe, message string) summon
	trusted if java
		println pipe.to, message.to
	elif js
		fn js-any = match pipe
		as out
			"info"
		as err
			"error"
		_ = call-property "console".js-global, fn, message.to
	else
		throw not-implemented

+print-no-newline void(message string) summon
	print-no-newline out, message
+print-no-newline void(pipe pipe, message string) summon
	trusted
	assert java else todo
	print pipe.to, message.to

| Clear the terminal.
+clear-screen void() summon
	print-no-newline out, "\x1bc"
