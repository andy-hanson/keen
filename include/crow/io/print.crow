no-std
import
	java/io/PrintStream
	java/lang/System
	../bool: bool
	../compare: equal
	../exception: exception, not-implemented, todo
	../js: call-property, js-global
	../misc: new, void
	../string: string, to-java-string, to-js-string

+print-error record(show string) exception case

+pipe enum(out, err)
+== bool(a pipe, b pipe)
+show string(a pipe)
	a to
+to string(a pipe)
	match a
	as out
		"out"
	as err
		"err"

+to-print-stream PrintStream(a pipe) summon, java extern
	trusted match a
	as out
		out
	as err
		err

| Print to stdout or stderr, including a newline.
+print void(pipe pipe, message string) summon
	trusted if extern java
		pipe.to-print-stream println message.to-java-string
	elif extern js
		fn string = match pipe
		as out
			"info"
		as err
			"error"
		_ = "console".js-global call-property fn, message.to-js-string
	else
		throw not-implemented

| Print to stdout or stderr, without appending a newline.
+print-no-newline void(pipe pipe, message string) summon, trusted
	assert extern java : todo
	pipe.to-print-stream print message.to-java-string

| Clear the terminal.
+clear-screen void() summon
	out print-no-newline "\x1bc"
