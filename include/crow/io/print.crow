no-std
import
	../bool: bool
	../compare: equal
	../exception: exception, not-implemented, todo
	../java: call-instance, get-static-field
	../js: call-property, js-global
	../misc: new, void
	../string: string

+print-error record(show string) exception case

+pipe enum(out, err)
+== bool(a pipe, b pipe)
+show string(a pipe)
	a to
+to string(a pipe)
	match a
	as out
		"out"
	as err
		"err"

| Print to stdout or stderr, including a newline.
+print void(pipe pipe, message string) summon
	trusted if extern java
		_ void = "java.lang.System" get-static-field pipe.to call-instance "println", message
	elif extern js
		fn string = match pipe
		as out
			"info"
		as err
			"error"
		_ = "console".js-global call-property fn, message
	else
		throw not-implemented

| Print to stdout or stderr, without appending a newline.
+print-no-newline void(pipe pipe, message string) summon, trusted
	assert extern java : todo
	_ void = "java.lang.System" get-static-field pipe.to call-instance "print", message

| Clear the terminal.
+clear-screen void() summon
	out print-no-newline "\x1bc"
