| Represents an amount of time.
| This is technically allowed to be negative.
+duration record
	-s float64
+== bool(a duration, b duration)
+<=> comparison(a duration, b duration)
	a.s <=> b.s
+hash void(a duration, state hash-state)
	hash a.s, state
+to json(a duration)
	a.s.to
++ duration(a duration, b duration)
	a.s + b.s,
+- duration(a duration, b duration)
	a.s - b.s,

| 0 duration.
+new duration()
	0,

| Duration of {a} seconds.
+seconds duration(a float64)
	a,

| Duration of {a} milliseconds.
+milliseconds duration(a float64)
	a * 0.001,

| Duration of {a} microseconds.
+microseconds duration(a float64)
	a * 0.000_001,

| Duration of {a} nanoseconds.
+nanoseconds duration(a float64)
	a * 0.000_000_001,

| Number of seconds in {a}.
+seconds float64(a duration)
	a.s

| Number of milliseconds in {a}.
+milliseconds float64(a duration)
	a.seconds * 1000

| Number of microseconds in {a}.
+microseconds float64(a duration)
	a.seconds * 1_000_000

| Number of nanoseconds in {a}.
+nanoseconds float64(a duration)
	a.seconds * 1_000_000_000

| Tries to pick an appropriate format for the value, like `1.5s` or `2.3us`.
+show string(a duration)
	if a >= 1.seconds
		"{a.seconds}s"
	elif a >= 1.milliseconds
		"{a.milliseconds}ms"
	elif a >= 1.microseconds
		"{a.microseconds}μs"
	else
		"{a.nanoseconds}ns"

test
	1.seconds.seconds is 1
	2.seconds.milliseconds is 2_000
	3.milliseconds.seconds is 0.003
	"{4.seconds}"::string is "4s"
	"{5.milliseconds}"::string is "5ms"
	"{6.microseconds}"::string is "6μs"
	"{7.nanoseconds}"::string is "7.000000000000001ns"

	1.seconds + 2.milliseconds is 1002.milliseconds
