import
	crow/bits
	crow/col/mut-slice
	crow/js
	crow/unsafe
	java/io/File
	java/lang/System
	java/nio/file/FileAlreadyExistsException
	java/nio/file/Files
	java/nio/file/Path
	java/nio/file/Paths
	java/nio/file/NoSuchFileException
	java/nio/file/CopyOption
	java/nio/file/StandardCopyOption
	./path: child-path

+path-already-exists record(path string) exception case
+show string(a path-already-exists)
	"Path already exists: {a path}"

+path-not-found record(path string) exception case
+show string(a path-not-found)
	"Path not found: {a path}"

+file-system-error record(path string, description string) exception case
+show string(a file-system-error)
	"Error at path {a path}: {a description}"

| {true} if anything (like a file or directory) exists at the path.
+path-exists bool(path string) summon
	trusted
	assert extern java else todo
	path.to::Path exists ()

| {true} if {path} is the path of a directory, or a symlink to a directory.
| {false} if there is anything else at the path, or nothing at the path.
+is-directory bool(path string) summon
	try
		path.get-path-kind == directory
	catch path-not-found _
		false

| {true} if `path` is the path of a file, or a symlink to a file.
| {false} if there is anything else at the path, or nothing at the path.
+is-file bool(path string) summon
	try
		path.get-path-kind == file
	catch path-not-found _
		false

+path-kind enum(file, directory, other)
+== bool(a path-kind, b path-kind)
+to symbol(a path-kind)
+show string(a path-kind)
	a.to::symbol to

+get-path-kind path-kind(path string) summon
	trusted
	assert extern java else todo
	p Path = path to
	assert p exists () else path path-not-found
	if p isRegularFile ()
		file
	elif p isDirectory ()
		directory
	else
		other

| Returns all children of the directory {path}, as full paths.
| Use {names-in-dir} instead if you want just the basenames.
+paths-in-dir string[](path string) summon
	for x in path names-in-dir
		path child-path x

| Returns the basename of all children of the directory.
| Does not include ".." or ".".
| Use {paths-in-dir} instead if you want full paths.
+names-in-dir string[](a string) summon
	trusted
	assert extern java else todo
	dir File = a.to,
	files = dir listFiles
	forbid files reference-equal gc-safe-value else todo # TODO: this is a confusing way to say 'is null' --------------------------------------------
	(for file in files then file.getName to) sort

| Gets the path a symbolic link refers to.
+read-link string(_ string) summon
	throw todo

| Create a symbolic link at {link} with the target {target}.
+make-symlink-to void(link string, target string) summon
	trusted
	assert extern java else todo
	try
		_ = link.to createSymbolicLink target.to, ()
	catch FileAlreadyExistsException _
		throw link path-already-exists

| Gets the path of the current executable.
| If this program was built to executable, this will return its path.
| Otherwise, this will be the path where `crow` is installed.
+current-executable-path string() summon
	"/proc/self/exe" read-link

+not-a-text-file record(path string) exception case
+show string(a not-a-text-file)
	"File is not valid UTF-8: {a path}"

| Reads the full contents of the file.
+read-file string(path string) summon
	try
		path.read-file::nat8[] as-string
	catch unicode-decode-error
		throw path not-a-text-file

| Like {read-file}, but returns an empty string instead of throwing {path-not-found}.
+read-file-or-empty string(path string) summon
	try
		path read-file
	catch path-not-found _
		""

+copy-file void(from string, to string) summon
	trusted
	assert extern java else todo
	_ = from.to copy to.to,
		- REPLACE_EXISTING.reinterpret-cast::CopyOption

| Writes the full contents of the file as a string.
| If the file already exists, overwrites it.
+write-file void(path string, content string) summon
	path write-file content.to::nat8[]
+write-file void(path string, content nat8[]) summon
	trusted
	assert extern java else todo
	_ = path.to write content.reinterpret-cast::(int8 mut-slice), ()

-fs js-any() js extern
	trusted "fs" js-import

+read-file nat8[](path string) summon
	trusted
	if extern java
		p Path = path to
		try
			p.readAllBytes.cast-immutable safe-reinterpret-cast
		catch NoSuchFileException _
			throw path path-not-found
	elif extern js
		try
			fs call-property "readFileSync", path.to array-from-buffer
		catch else exception
			code = exception.as-js["code"]
			throw if code == "ENOENT"
				path path-not-found
			else
				exception
	else
		throw todo

-array-from-buffer nat8[](buffer js-any) unsafe, js extern
	"Uint8Array".js-global call-property "from", buffer reinterpret-cast

-to Path(a string) java extern
	trusted
	a.to get ()

| Gets the current directory (of the user that ran the program).
+current-directory string() summon
	trusted
	assert extern java else todo
	"user.dir".getProperty to

| If {path} is a directory, calls {f} on each file in the directory and any nested directories.
| If {path} is a file, calls {f} once.
+each-child-recursive void(path string, f void mut(path string)) summon
	path each-child-recursive (of _ then true), f

| Like {each-child-recursive}, but calls {filter} on names of directory children
| and skips them if {filter} returns false.
+each-child-recursive void
	path string
	filter bool mut(name string)
	f void mut(path string)
do summon
	if path is-directory
		for child-name in path names-in-dir
			if filter[child-name]
				path child-path child-name each-child-recursive filter, f
	else
		f[path]

| POSIX file permissions.
+file-permissions record(user permissions, group permissions, public permissions)
| Permissions for one of user, group, public.
+permissions record(read bool, write bool, execute bool)
+all permissions()
	true, true, true
+read-only permissions()
	true, false, false

+to nat(a file-permissions)
	a.user.to << 6 | a.group.to << 3 | a.public.to
+to nat(a permissions)
	a.read.to << 2 | a.write.to << 1 | a.execute.to

+no-permissions permissions()
	false, false, false

+all-permissions permissions()
	true, true, true

+read-write permissions()
	read: true
	write: true
	execute: false

+user-only file-permissions(user-permissions permissions)
	user-permissions, no-permissions, no-permissions

+set-permissions void(path string, permissions file-permissions) summon
	_ = path
	_ = permissions
	throw todo

# TODO: this might not be the correct default permissions
| Creates a new empty directory at {path}.
+make-directory void(path string) summon
	trusted
	assert extern java else todo
	file File = path.to,
	ok = file mkdir
	assert ok else todo

| Like 'make-directory', but OK if it already exists.
+ensure-directory void(path string) summon
	try
		path make-directory
	catch path-already-exists x
		assert path.get-path-kind == directory else x

| Deletes the file at {path}.
+remove-file void(path string) summon
	trusted
	assert extern java else todo
	try
		path.to::Path delete
	catch NoSuchFileException _
		throw path path-not-found

| Deletes the directory at {path}. It should be empty.
+remove-directory void(path string) summon
	_ = path
	throw todo

| Normally "/dev/null". "NUL" on Windows.
+null-path string() summon
	if trusted extern windows
		"NUL"
	else
		"/dev/null"

+temp-file record(prefix string, suffix string)
+with-block[t] t(a temp-file, f t mut(path string)) summon
	trusted
	assert extern java else todo
	temp = a.prefix.to createTempFile a.suffix.to
	finally temp.toPath delete
	f[temp.toPath.toString to]
