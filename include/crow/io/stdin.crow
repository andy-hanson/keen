import
	../col/mut-slice
	../java
	./print: out, print

| Reads a line from stdin.
| If that comes from the user typing at the terminal, this will block until they hit enter.
| Result will not have leading or trailing whitespace.
+read-stdin string() summon, trusted
	chars char8[] = with out : build
		loop
			c char8 = read-one-byte-from-stdin to
			if c == "\n"
				break
			else
				if c != "\r"
					out ~= c
				continue
	chars to

+read-one-byte-from-stdin nat8() summon, trusted
	assert extern java : todo
	in = "java.lang.System" get-static-field "in"
	res int32 = in call-instance "read"
	res.to::nat32 to

+read-n-bytes-from-stdin nat8[](size nat) summon, trusted
	first = size read-up-to-n-bytes-from-stdin
	if first.size == size
		first
	else
		res nat8 mut[] = ()
		res ~~= first
		while res.size < size
			res ~~= size - res.size read-up-to-n-bytes-from-stdin
		res.size is size
		res	move-to

+read-up-to-n-bytes-from-stdin nat8[](max-size nat) summon, trusted
	assert extern java : todo
	buffer nat8 mut-slice = max-size gc-safe-mut-slice
	bytes-read int32  = "java.lang.System" get-static-field "in" call-instance "read", buffer
	assert bytes-read <= buffer.size.to : unreachable
	buffer[0 .. bytes-read.to] to

| Keep reading from stdin until {parse} returns a non-empty option.
| Print {error-message} after every failure.
+read-stdin-until-parse[t] t
	error-message string
	parse t? mut(input string)
do summon, t shared
	until res ?= parse[read-stdin]
		out print error-message
	res
