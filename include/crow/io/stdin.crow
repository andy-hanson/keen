import
	java/io/InputStream
	java/lang/System
	../col/mut-slice
	./print: out, print

| Reads a line from stdin.
| If that comes from the user typing at the terminal, this will block until they hit enter.
| Result will not have leading or trailing whitespace.
+read-stdin string() summon
	chars char8[] = with out in build
		loop
			c char8 = read-one-byte-from-stdin to
			if c == "\n"
				break
			else
				if c != "\r"
					out ~= c
				continue
	chars to

+read-one-byte-from-stdin nat8() summon
	trusted
	assert extern java else todo
	in.read.to::nat32 to

+read-n-bytes-from-stdin nat8[](size nat) summon
	first = size read-up-to-n-bytes-from-stdin
	if first.size == size
		first
	else
		res nat8 mut[] = ()
		res ~~= first
		while res.size < size
			res ~~= size - res.size read-up-to-n-bytes-from-stdin
		res.size is size
		res	move-to

+read-up-to-n-bytes-from-stdin nat8[](max-size nat) summon
	trusted
	assert extern java else todo
	buffer int8 mut-slice = max-size gc-safe-mut-slice
	bytes-read int32  = in read buffer
	assert bytes-read <= buffer.size.to else unreachable
	res int8[] = buffer[0 .. bytes-read.to] to
	for x in res then x wrap-to # TODO:PERF cast the array instead ---------------------------------------------------------------------

| Keep reading from stdin until {parse} returns a non-empty option.
| Print {error-message} after every failure.
+read-stdin-until-parse[t] t
	error-message string
	parse t? mut(input string)
do summon, t shared
	until res = parse[read-stdin]
		out print error-message
	res
