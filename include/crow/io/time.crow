import
	../js
	./duration

+unix-time record(seconds-since-epoch nat)
+- duration(a unix-time, b unix-time)
	seconds to a.seconds-since-epoch - b.seconds-since-epoch

| Monotonically increasing time in nanoseconds.
+monotime record(nanoseconds nat)

| Get the value from a monotonic clock.
+monotime duration() global
	trusted
	assert js else todo
	msec float = call-property "performance".js-global, "now" 'to
	milliseconds msec

| Get the current Unix timestamp.
+unix-time unix-time() global
	trusted
	assert js else todo
	msec float = call-property "Date".js-global.call-new, "valueOf" 'to
	seconds-since-epoch: msec / 1000 'to

| Returns a future that will resolve after `duration` has passed.
+delay void(duration duration) global
	trusted
	assert js else todo
	resolver void mut(resolve js-any) = of resolve
		_ = call "setTimeout".js-global, resolve, duration.milliseconds.to
	_ = await call-new "Promise".js-global, resolver.to
