import
	../js
	./duration

+unix-time record(seconds-since-epoch nat)
+- duration(a unix-time, b unix-time)
	(a.seconds-since-epoch - b.seconds-since-epoch to) seconds

| Monotonically increasing time in nanoseconds.
+monotime record(nanoseconds nat)

| Get the value from a monotonic clock.
| TODO: This should be 'summon', but I didn't mark it that way so 'perf' can use it.
+monotime duration() summon
	trusted
	assert extern js else todo
	msec float = "performance".js-global call-property "now" to
	msec milliseconds

| Get the current Unix timestamp.
+unix-time unix-time() summon
	trusted
	assert extern js else todo
	msec float = "Date".js-global.call-new call-property "valueOf" to
	seconds-since-epoch: msec / 1000 to

| Returns a future that will resolve after `duration` has passed.
+delay void(duration duration) summon
	trusted
	assert extern js else todo
	resolver void mut(resolve js-any) = of resolve
		_ = "setTimeout".js-global call resolve, duration.milliseconds.to
	_ = "Promise".js-global call-new resolver.to await
