import
	../js
	./duration
export
	./private/time-low-level: get-monotime-nsec

+get-monotime-msec nat64() summon
	get-monotime-nsec / 1000000

+unix-time record
	seconds-since-epoch nat

| Get the current Unix timestamp.
+get-unix-time unix-time() summon
	trusted
	assert extern js else todo
	msec float = "Date".js-global.call-new call-property "valueOf" cast
	(msec / 1000).to,

| Returns a future that will resolve after `duration` has passed.
+delay void(duration duration) summon
	trusted
	assert extern js else todo
	resolver void mut(resolve void mut()) = of resolve
		_ = "setTimeout".js-global call resolve.as-js, duration.milliseconds.as-js
	_ = "Promise".js-global call-new resolver.as-js await
