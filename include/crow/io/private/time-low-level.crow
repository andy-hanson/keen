# TODO: Shouldn't need a 'low-level' version of this. This should all be in time.crow --------------------------------------------
no-std
import
	crow/js: call-property, cast, js-global
	../../exception: todo
	../../number: *, /, float, nat64, to

| Monotime in nanoseconds.
timestamp alias
	nat64

| Get the value from a monotonic clock.
| TODO: This should be 'summon', but I didn't mark it that way so 'perf' can use it.
get-monotime-nsec timestamp() trusted
	assert extern js : todo
	msec float = "performance".js-global call-property "now" cast
	msec * 1_000_000 to

nsec-to-msec nat64(a nat64)
	a / 1_000_000
