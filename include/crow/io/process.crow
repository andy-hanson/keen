import
	crow/col/mut-slice
	java/io/File
	java/lang/Process
	java/lang/ProcessBuilder
	java/lang/String
	java/nio/file/Files
	
| Represents the output of running a process.
+process-result record(exit process-exit, stdout string, stderr string)

+process-exit union(exited, signaled)
+exited record(exit-code int32)
+signaled record(signal int32)

+has-error bool(a process-result)
	!a.stderr.is-empty or match a exit
	as exited x
		x.exit-code != 0
	as signaled _
		true

| Replace this process 
+spawn-and-inherit-io int32(exe string, args string[]) summon
	trusted
	assert extern java else todo
	all-args String mut-slice = exe ~ args map it.to
	pb ProcessBuilder = all-args,
	_ = pb inheritIO
	process = pb start
	process waitFor

| Launches a process and synchronously waits on the result.
| The child process' stdout and stderr will be sent to the {process-result},
| not to the parent's stdout and stderr.
| {exe} should be a file path and not just a name; this does not search the system path for {exe}.
+spawn-and-wait-result process-result(exe string, args string[]) summon
	trusted
	assert extern java else todo
	all-args String mut-slice = exe ~ args map it.to
	pb ProcessBuilder = all-args,

	temp-out = "stdout-" createTempFile ".txt"
	finally temp-out.toPath delete
	temp-err = "stderr-" createTempFile ".txt"
	finally temp-err.toPath delete
	_ = pb redirectOutput temp-out
	_ = pb redirectError temp-err
	process = pb start
	exit: process.waitFor exited
	stdout: temp-out.toPath.readString to
	stderr: temp-err.toPath.readString to

| Launches a process and synchronously waits on the result.
| The child process shares stdout and stderr with the parent process.
+spawn-and-wait process-exit(_ string, _ string[]) summon
