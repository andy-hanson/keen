no-std
import
	./bool
	./compare
	./col/array
	./col/map
	./col/mut-array
	./col/set
	./col/util
	./exception
	./hash
	./parse
	./misc
	./number
	./option
	./private/parse-util
	./range
	./string
	./string/unicode
	./symbol
	./tuple

| JSON data.
| The representation is deliberately opaque to allow precise representation of numbers.
| Generally you should use 'to::t' to read a JSON value as the type you expect it to be.
| If you really need to match on a json value, use {simplify}.
+json record
	-inner json-inner
-json-inner union(null, bool, nat64, int64, float64, string, json[], json[symbol])

+interpolate json(parts string[])
	parts.interpolate::string.to

+deserialize-error record(value json) exception case
+show string(a deserialize-error)
	"The json value cannot be interpreted as this type. Actual: {a.value}"

+json-simplified union(null, bool, float64, string, json[], json[symbol])
+ == bool(a json-simplified, b json-simplified)
+simplify json-simplified(a json)
	match x = a.inner
	as null
		null
	as bool
		x
	as nat
		x.to::float64
	as int
		x.to::float64
	as float
		x
	as string
		x
	as array
		x
	as map
		x

+ == bool(a json, b json)
	# TODO: We should actually just use the auto fun. But make sure '1' parses as a nat consistently!
	trusted a.simplify == b.simplify

+to string(a json)
	a.inner.string else throw deserialize-error a

+null record
+ == bool(a null, b null)
+to json(a null)
	a,

| If no arguments are passed this is {null}. Otherwise it is a JSON array.
| For an empty JSON array, use `()::json[] to`
+list-new json(args json[])
	if is-empty args
		null
	else
		- args
+named-new json(keys symbol[], values json[])
	assert keys.size == values.size
	map json[symbol] = for i in 0::nat .. keys.size
		keys[i], values[i]
	map.to

+null json()
	inner: ()::null
+false json()
	inner: false::bool
+true json()
	inner: true::bool
+empty-array json()
	()::json[].to
+empty-object json()
	()::json[symbol].to
+to json(a json)
	a
+to json(_ void)
	null
+to json(a bool)
	inner: a
+to json(a char8)
	a.to::string.to
+to json(a char32)
	a.to::string.to
+to json(a string)
	inner: a
+to json(a nat8)
	a::nat64.to
+to json(a nat16)
	a::nat64.to
+to json(a nat32)
	a::nat64.to
+to json(a nat64)
	inner: a
+to json(a int8)
	a::int64.to
+to json(a int16)
	a::int64.to
+to json(a int32)
	a::int64.to
+to json(a int64)
	inner: a
+to json(a float32)
	a.to::float64.to
+to json(a float64)
	inner: a
+to json(a symbol)
	a.to::string.to
+to[t] json(a t[]) (json, t) to
	- map::json[] a, it.to
+to[t] json(a t array-view) (json, t) to
	- map::json[] a, it.to
+to[t] json(a t mut[]) (json, t) to
	- map::json[] a, it.to
+to[t] json(a t set) (json, t) to, t key
	- map::json[] a, it.to
+to[k, v] json(a v[k]) k key, (symbol, k) to, (json, v) to
	inner:
		:: json[symbol]
		for k, v in a then k.to, v.to
+to[v] v[symbol](a json) (v, json) to
	match x = a.inner
	as null
		()
	as map
		map-values x, it.to
	else
		throw deserialize-error a
+to[t] json(a t?) (json, t) to
	if a
		a.to
	else
		null
+to[t, u] json(a (t, u)) (json, t) to, (json, u) to
	a.a.to, a.b.to
+to json(a comparison)

| If {a} is an `object` containing the key {key}, returns the associated value.
| Returns `null` if any of these is true:
| * {a} is not an object.
| * {a} is an object, but does not have {key}.
| * {a} is an object with the key, and its value is {null}.
|
| Most code does not care about this distinction.
| If you do, you can test `if {a}.{simplify} {map}` or `if {a} {has-key} {key}`.
+subscript json(a json, key symbol)
	a.inner.map?[key] else null

| {true} if {a} is an object and {key} is one of its keys.
+has-key bool(a json, key symbol)
	(x = a.inner.map) and x[key]

| `a bool-or-null` is like `a bool`, but treats {null} as {false}.
+to bool(a json)
	a.inner.bool else
		assert a == null else deserialize-error a
		false

+to[t] t[](a json) (t, json) to
	match x = a.inner
	as null
		()
	as array
		map x, it.to
	else
		throw deserialize-error a

+to nat32(a json)
	a.to::nat64.to
+to nat64(a json)
	a.inner.float64!.to
+to symbol(a json)
	a.to::string.to

| By default, json is shown using crowd.
+show string(a json)
	to-crowd a

| Converts a value to {json} and renders it as standard JSON.
+to-json[t] string(a t) (json, t) to
	match x = a.to.inner
	as null
		"null"
	as bool
		"{x}"
	as nat64
		"{x}"
	as int64
		"{x}"
	as float64
		"{x}"
	as string
		quoted x
	as array
		"[{join ",", map x, it.to-json}]"
	as map
		parts = join ",", for k, v in x
			"{quoted k.to}:{to-json v}"
		"\{{parts}}"

-quoted string(a string)
	do with out in build
	out ~= "\""
	for x in a
		match x
		as "\""
			out ~~= "\\\""
		as "\n"
			out ~~= "\\n"
		as "\r"
			out ~~= "\\r"
		as "\t"
			out ~~= "\\t"
		as "\\"
			out ~~= "\\\\"
		as "\0"
			out ~~= "\\0"
		else
			out ~= x
	out ~= "\""

+omit-empty-values json(a json)
	match x = a.inner
	as map
		filter::json[symbol] x, !it.b.is-empty-value 'to
	else
		a

| For every object in the json value, omit a key if the value is null, an empty array, or an empty object.
+deep-omit-empty-values json(a json)
	match x = a.inner
	as array
		map x, it.deep-omit-empty-values
	as map
		res json[symbol] = with out in build
			for k, v in x
				unless is-empty-value v
					out ~= k, deep-omit-empty-values v
		res.to
	else
		a
-is-empty-value bool(a json)
	match x = a.inner
	as null
		true
	as array
		is-empty x
	as map
		is-empty x
	else
		false

| Converts a value to {json} and renders it as Crowd.
+to-crowd[t] string(a t) (json, t) to
	match x = to-crowd-inner a.to, 100
	as lines
		join "\n", x.lines
	as single
		text x
-to-crowd-result union(lines, single)
-lines record(lines string[])
-single record(text string, needs-parens bool)
-parenthesize string(a single)
	if a.needs-parens then "({a.text})" else a.text
-to-crowd-inner to-crowd-result(value json, max-columns nat)
	match x = value.inner
	as null
		single "()", false
	as bool
		single "{x}", false
	as nat64
		single "{x}", false
	as int64
		single "{x}", false
	as float
		single "{x}", false
	as string
		single x.quoted, false
	as array
		if is-empty x
			single "empty-array", false
		else
			to-crowd-array-or-object (), x, max-columns
	as map
		if is-empty x
			single "empty-object", false
		else
			to-crowd-array-or-object x.keys, x.values, max-columns
-tab-size nat()
	4
-to-crowd-array-or-object to-crowd-result(keys symbol[]?, values json[], max-columns nat)
	forbid is-empty values
	if keys
		assert keys.size == values.size
	size mut nat = 0
	multi-line mut bool = false
	parts to-crowd-result[] = for index, x in with-index values
		key-size = if keys then keys[index].quote-if-necessary.size + ": ".size
		part = to-crowd-inner x, safe-subtract max-columns, tab-size + key-size
		match part
		as lines
			multi-line := true
		as single
			if keys
				size +:= key-size + 1
			size +:= part.text.size
		part
	size +:= ", ".size * values.size - 1
	if multi-line or size > max-columns
		lines: with out in build
			do for index, part in with-index parts
			key = if keys then "{quote-if-necessary keys[index]}:" else "-"
			match part
			as lines
				out ~= key
				for line in part.lines
					out ~= "\t{line}"
			as single
				out ~= "{key} {part.text}"
	else
		text = join ", ", for index, part in with-index parts
			p = parenthesize part.single!
			if keys then "{quote-if-necessary keys[index]}: {p}" else p
		text: if !keys and parts.size == 1 then "{text}," else text
		needs-parens: true
-safe-subtract nat(a nat, b nat)
	if a >= b then a - b else 0
-quote-if-necessary string(key symbol)
	s string = key.to
	if is-crow-identifier s then s else quoted s

+json json grammar()
	func: of iter
		res = parse-json iter
		skip-whitespace iter
		res
| Expose an alternate version to avoid 'parse' which is an async fun
~parse-json json(a string)
	iter = begin a
	res = parse-json iter
	skip-whitespace iter
	assert is-at-end iter else parse-error a, iter.index, "string continues past end of parse"
	res
-parse-json json(a string-iterator)
	skip-whitespace a
	if try-take a, "false"
		false
	elif try-take a, "true"
		true
	elif try-take a, "null"
		null
	elif try-take a, "\""
		take-quoted-string-after-quote a 'to
	elif try-take a, "["
		skip-whitespace a
		res json[] = unless try-take a, "]"
			do with out in build
			out ~= parse-json a
			skip-whitespace a
			while try-take a, ","
				out ~= parse-json a
			skip-whitespace a
			assert try-take a, "]" else inner-parse-error "']'"
		res.to
	elif try-take a, "\{"
		skip-whitespace a
		res json[symbol] = unless try-take a, "}"
			do with out in build
			out ~= take-key-value a
			while try-take a, ","
				out ~= take-key-value a
			skip-whitespace a
			assert try-take a, "}" else inner-parse-error "'}'"
		res.to
	else
		try
			take-float a 'to
		catch as inner-parse-error
			throw inner-parse-error "JSON value"
-take-key-value (symbol, json)(a string-iterator)
	skip-whitespace a
	key = take-quoted-string a
	skip-whitespace a
	assert try-take a, ":" else inner-parse-error "':'"
	skip-whitespace a
	value = parse-json a
	skip-whitespace a
	key.to, value

# TODO: PRIVATE -------------------------------------------------------------------------------------------------------------------------------------
~try-take-number json?(iter string-iterator)
	if is-digit iter.peek8 or iter.peek8 == "-" and is-digit iter.peek8-next
		# TODO: could take an int or nat
		take-float iter 'to

+crowd json grammar()
	func: it.parse-crowd

~crowd-parse-error record(pos nat32, expected string)
~parse-crowd-result union(json, crowd-parse-error)
~parse-crowd parse-crowd-result(text string-view)
	iter string-iterator = begin text
	try
		res = parse-crowd iter
		assert is-at-end iter else inner-parse-error "Crowd value"
		res
	catch error as inner-parse-error
		pos: iter.pos
		expected: expected error

-parse-crowd json(iter string-iterator)
	indent-kind = detect-indent-kind iter
	skip-all-whitespace iter
	ctx ctx = indent-kind: indent-kind
	res, new-indent = parse-crowd-line iter, ctx, 0
	assert new-indent == eof-indent
	res

-ctx record(indent-kind indent-kind)
-eof-indent int32()
	# Treat end of file as being at a lesser indent so the parser will naturally exit
	-1

| Returns the expression, and optionally the new indent amount (which will be <= {indent})
-parse-crowd-line (json, int32)(iter string-iterator, ctx ctx, indent int32)
	if try-take-list-start iter
		parse-crowd-multi-line-list iter, ctx, indent
	else
		match first = parse-crowd-simple iter
		as json
			- if try-take-char8 iter, ","
				parse-crowd-single-line-list-after-value-and-comma iter, first
			else
				first
			- take-next-indent iter, ctx, indent
		as symbol
			parse-crowd-single-or-multi-line-object iter, ctx, first, indent

-to (json, int32?)((j json, i int32))
	j, i

-parse-crowd-inner-including-list (json, int32?)(iter string-iterator, ctx ctx, indent int32)
	res, new-indent = parse-crowd-inner iter, ctx, indent
	- if !new-indent and try-take-char8 iter, ","
		parse-crowd-single-line-list-after-value-and-comma iter, res
	else
		res
	- new-indent

| This does not take commas for lists. Caller is responsible.
-parse-crowd-inner (json, int32?)(iter string-iterator, ctx ctx, indent int32)
	skip-spaces iter
	if try-take-char8 iter, "\n"
		new-indent = take-next-indent-after-newline iter, ctx
		assert new-indent == indent + 1 else inner-parse-error "Crowd value"
		parse-crowd-line iter, ctx, new-indent 'to
	else
		match first = parse-crowd-simple iter
		as json
			- first
			- try-take-next-indent iter, ctx, indent
		as symbol
			parse-crowd-single-line-object iter, ctx, first, indent 'to

-parse-crowd-single-line-list-after-value-and-comma json(iter string-iterator, first json)
	skip-spaces iter
	if peek-end-of-line iter or iter.peek8 == ")"
		- first
	else
		parse-crowd-single-line-list-after-value-comma-value iter, first, parse-crowd-simple-no-colon iter
-parse-crowd-single-line-list-after-value-comma-value json(iter string-iterator, first json, second json)
	do with out in build
	out ~= first
	out ~= second
	while try-take-char8 iter, ","
		skip-spaces iter
		out ~= parse-crowd-simple-no-colon iter

-parse-crowd-multi-line-list (json, int32)(iter string-iterator, ctx ctx, indent int32)
	new-indent mut int32 = ()
	res json[] = with out in build
		first-value, first-indent = parse-crowd-inner-including-list iter, ctx, indent
		out ~= first-value
		new-indent := first-indent else take-next-indent iter, ctx, indent
		while new-indent == indent
			assert try-take-list-start iter else inner-parse-error "List item"
			next-value, next-indent = parse-crowd-inner-including-list iter, ctx, indent
			out ~= next-value
			new-indent := next-indent else take-next-indent iter, ctx, indent
	res.to, new-indent

-try-take-list-start bool(iter string-iterator)
	if starts-with-then-whitespace iter, "-"
		_ = take-next iter
		true

-parse-crowd-single-line-object (json, int32)(iter string-iterator, ctx ctx, first-name symbol, indent int32)
	first-value, first-indent = parse-crowd-inner iter, ctx, indent
	if first-indent
		res json[symbol] = (first-name, first-value),
		res.to, first-indent
	else
		parse-crowd-single-line-object-inner iter, ctx, first-name, first-value, indent

-parse-crowd-single-or-multi-line-object (json, int32)(iter string-iterator, ctx ctx, first-name symbol, indent int32)
	first-value, first-indent = parse-crowd-inner iter, ctx, indent
	do if first-indent else parse-crowd-single-line-object-inner iter, ctx, first-name, first-value, indent
	new-indent mut int32 = first-indent
	res json[symbol] = with out in build
		out ~= first-name, first-value
		while new-indent == indent
			next-name = take-name-colon-or-string-colon iter
			next-value, next-indent = parse-crowd-inner-including-list iter, ctx, indent
			new-indent := next-indent else take-next-indent iter, ctx, indent
			out ~= next-name, next-value
	res.to, new-indent

-parse-crowd-single-line-object-inner (json, int32)(iter string-iterator, ctx ctx, first-name symbol, first-value json, indent int32)
	new-indent mut int32? = ()
	cur-name mut = first-name
	cur-value mut = first-value
	res json[symbol] = with out in build
		while !new-indent and try-take-char8 iter, ","
			skip-spaces iter
			match x = parse-crowd-simple iter
			as json
				cur-value := parse-crowd-single-line-list-after-value-comma-value iter, cur-value, x
			as symbol
				out ~= cur-name, cur-value
				next-value, next-indent = parse-crowd-inner iter, ctx, indent
				cur-name := x
				cur-value := next-value
				new-indent := next-indent
		out ~= cur-name, cur-value
	- res.to
	- new-indent else take-next-indent iter, ctx, indent

-parse-crowd-simple-no-colon json(iter string-iterator)
	if try-take-char8 iter, "("
		after-paren iter
	elif name = try-take-crow-identifier iter
		crowd-value-from-name name
	elif x = try-take-quoted-string iter
		x.to
	elif x = try-take-number iter
		x
	else
		throw inner-parse-error "Crowd value"

-after-paren json(iter string-iterator)
	if try-take-char8 iter, ")"
		null
	else
		value, dedent = parse-crowd-inner-including-list iter, (indent-kind: tabs), 0
		assert !dedent and try-take-char8 iter, ")" else
			inner-parse-error "Closing parenthesis"
		value

# 'json' for a simple value; 'symbol' for a name followed by a colon
-crowd-simple union(json, symbol)
-parse-crowd-simple crowd-simple(iter string-iterator)
	if try-take-char8 iter, "("
		after-paren iter
	elif name = try-take-crow-identifier iter
		if try-take-char8 iter, ":"
			name
		else
			crowd-value-from-name name
	elif x = try-take-quoted-string iter
		if try-take-char8 iter, ":"
			x.to::symbol
		else
			x.to::json
	elif x = try-take-number iter
		x
	else
		throw inner-parse-error "Crowd value"

-crowd-value-from-name json(name symbol)
	match name
	as false
		false
	as true
		true
	as empty-array
		()::json[].to
	as empty-object
		()::json[symbol].to
	else
		throw inner-parse-error "Crowd value"

-peek-end-of-line bool(a string-iterator)
	is-at-end a or a.peek8 == "\n"

-take-name-colon-or-string-colon symbol(iter string-iterator)
	assert res = (try-take-crow-identifier iter or ?to try-take-quoted-string iter) else
		inner-parse-error "Identifier or string, then ':'"
	assert try-take-char8 iter, ":" else inner-parse-error "Colon after identifier"
	res

-skip-all-whitespace void(iter string-iterator)
	while is-whitespace iter.peek8
		_ = take-next iter
-skip-spaces void(iter string-iterator)
	while is-whitespace-non-newline iter.peek8
		_ = take-next iter
~try-take-quoted-string string?(iter string-iterator)
	if try-take-char8 iter, "\""
		take-quoted-string-after-quote iter

-try-take-next-indent int32?(iter string-iterator, ctx ctx, cur-indent int32)
	if peek-end-of-line iter
		take-next-indent iter, ctx, cur-indent
-take-next-indent int32(iter string-iterator, ctx ctx, cur-indent int32) # TODO: not sure we actually need cur-indent here ......................
	skip-spaces iter
	assert try-take-char8 iter, "\n" or is-at-end iter else inner-parse-error "Newline"
	res = take-next-indent-after-newline iter, ctx
	assert res <= cur-indent else inner-parse-error "Cannot indent here"
	res
-take-next-indent-after-newline int32(iter string-iterator, ctx ctx)
	do loop
	new-indent = take-indent-amount-after-newline iter, ctx.indent-kind, of _
		throw inner-parse-error "Indent by {ctx.indent-kind}"
	if is-at-end iter
		break eof-indent
	elif try-take-char8 iter, "\n"
		continue
	else
		break new-indent::nat64.to::int64.to
