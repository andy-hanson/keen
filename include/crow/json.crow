no-std
import
	./bool
	./compare
	./col/array
	./col/collection
	./col/map
	./col/mut-array
	./col/set
	./exception
	./hash
	./parse
	./misc
	./number
	./option
	./private/parse-util
	./range
	./string
	./symbol
	./tuple

| JSON data.
| The representation is deliberately opaque to allow precise representation of numbers.
| Generally you should use 'to::t' to read a JSON value as the type you expect it to be.
| If you really need to match on a json value, use {simplify}.
+json record
	-inner json-inner
-json-inner union(null, bool, nat64, int64, float64, string, json[], json[symbol])

+interpolate json(...parts string[])
	parts.interpolate to

+deserialize-error record(value json) exception case
+show string(a deserialize-error)
	"The json value cannot be interpreted as this type. Actual: {a value}"

+json-simplified union(null, bool, float64, string, json[], json[symbol])
+== bool(a json-simplified, b json-simplified)
+simplify json-simplified(a json)
	match a inner
	as null
		null
	as bool x
		x
	as nat x
		x.to::float64
	as int x
		x.to::float64
	as float x
		x
	as string x
		x
	as array x
		x
	as map x
		x

+== bool(a json, b json)
	# TODO: We should actually just use the auto fun. But make sure '1' parses as a nat consistently!
	a.simplify == b.simplify

+to string(a json)
	a.inner.string else throw a deserialize-error

+null record
+== bool(a null, b null)
+to json(a null)
	a,

| If no arguments are passed this is {null}. Otherwise it is a JSON array.
| For an empty JSON array, use `()::json[] to`
+new json(...args json[])
	if args is-empty
		null
	else
		- args
+named-new json(keys symbol[], values json[])
	assert keys.size == values.size
	map json[symbol] = for i in 0 .. keys.size
		keys[i], values[i]
	map to

+null json()
	inner: ()::null
+false json()
	inner: false::bool
+true json()
	inner: true::bool
+empty-array json()
	()::json[] to
+empty-object json()
	()::json[symbol] to
+to json(a json)
	a
+to json(_ void)
	null
+to json(a bool)
	inner: a
+to json(a char8)
	a.to::string to
+to json(a char32)
	a.to::string to
+to json(a string)
	inner: a
+to json(a nat8)
	a.to::nat64 to
+to json(a nat16)
	a.to::nat64 to
+to json(a nat32)
	a.to::nat64 to
+to json(a nat64)
	inner: a
+to json(a int8)
	a.to::int64 to
+to json(a int16)
	a.to::int64 to
+to json(a int32)
	a.to::int64 to
+to json(a int64)
	inner: a
+to json(a float32)
	a.to::float64 to
+to json(a float64)
	inner: a
+to json(a symbol)
	a.to::string to
+to[t] json(a t[]) (json, t) to
	- (a map it.to)::json[]
+to[t] json(a t array-view) (json, t) to
	- (a map it.to)::json[]
+to[t] json(a t mut[]) (json, t) to
	- (a map it.to)::json[]
+to[t] json(a t set) (json, t) to, t key
	- (a map it.to)::json[]
+to[k, v] json(a v[k]) k key, (symbol, k) to, (json, v) to
	inner:
		:: json[symbol]
		for k, v in a then k.to, v.to
+to[v] v[symbol](a json) (v, json) to
	match a inner
	as null
		()
	as map x
		x map-values it.to
	else
		throw a deserialize-error
+to[t] json(a t?) (json, t) to
	if x ?= a
		x to
	else
		null
+to[t, u] json(a (t, u)) (json, t) to, (json, u) to
	a.a.to, a.b.to
+to json(a comparison)

| If {a} is an `object` containing the key {key}, returns the associated value.
| Returns `null` if one of these is true:
| * {a} is not an object.
| * {a} is an object, but does not have {key}.
| * {a} is an object with the key, and its value is {null}.
|
| Most code does not care about this distinction.
| If you do, you can test `if obj ?= {a} object` or `if {key} in a`.
+subscript json(a json, key symbol)
	a.inner.map?[key] else null

| {true} if {a} is an object and {key} is one of its keys.
+in bool(key symbol, a json)
	x ?= a.inner map and key in x

| `a bool-or-null` is like `a bool`, but treats {null} as {false}.
+to bool(a json)
	a.inner bool else
		assert a == null else a deserialize-error
		false

+to[t] t[](a json) (t, json) to
	match a inner
	as null
		()
	as array xs
		xs map it.to
	else
		throw a deserialize-error

+to nat32(a json)
	a.to::nat64 to
+to nat64(a json)
	a.inner.float64! to
+to symbol(a json)
	a.to::string to

| By default, json is shown using crowd.
+show string(a json)
	a to-crowd

| Converts a value to {json} and renders it as standard JSON.
+to-json[t] string(a t) (json, t) to
	match a.to inner
	as null
		"null"
	as bool b
		"{b}"
	as nat64 x
		"{x}"
	as int64 x
		"{x}"
	as float64 f
		"{f}"
	as string s
		s quoted
	as array xs
		parts = "," join for x in xs then "{x to-json}"
		"[{parts}]"
	as map xs
		parts = "," join for k, v in xs
			"{k.to quoted}:{v to-json}"
		"\{{parts}}"

+build json(a build-options, f void mut(out json array-builder))
	(a build f)::json[] to

| Converts a value to {json} and renders it as Crowd.
+to-crowd[t] string(a t) (json, t) to
	match a.to to-crowd-inner 100
	as lines x
		"\n" join x.lines
	as single x
		x text
-to-crowd-result union(lines, single)
-lines record(lines string[])
-single record(text string, needs-parens bool)
-parenthesize string(a single)
	if a needs-parens then "({a text})" else a text
-to-crowd-inner to-crowd-result(value json, max-columns nat)
	match value inner
	as null
		"()" single false
	as bool x
		"{x}" single false
	as nat64 x
		"{x}" single false
	as int64 x
		"{x}" single false
	as float x
		"{x}" single false
	as string x
		x.quoted single false
	as array x
		if x is-empty
			"empty-array" single false
		else
			() to-crowd-array-or-object x, max-columns
	as map x
		if x is-empty
			"empty-object" single false
		else
			x.keys to-crowd-array-or-object x.values, max-columns
-tab-size nat()
	4
-to-crowd-array-or-object to-crowd-result(keys symbol[]?, values json[], max-columns nat)
	forbid values is-empty
	if k ?= keys
		assert k.size == values.size
	size mut nat = 0
	multi-line mut bool = false
	parts to-crowd-result[] = for index, x in values with-index
		part = x to-crowd-inner max-columns - tab-size
		match part
		as lines _
			multi-line := true
		as single s
			if k ?= keys
				size +:= k[index].quote-if-necessary.size + 1
			size +:= s.text size
		part
	size +:= ", ".size * values.size - 1
	if multi-line or size > max-columns
		lines: with out in build
			for index, part in parts with-index
				key string = if k ?= keys then "{k[index] quote-if-necessary}:" else "-"
				match part
				as lines x
					out ~= key
					for line in x lines
						out ~= "\t{line}"
				as single x
					out ~= "{key} {x text}"
	else
		text = ", " join for index, part in parts with-index
			p = part.single! parenthesize
			if k ?= keys then "{k[index] quote-if-necessary}: {p}" else p
		text: if !(_ ?= keys) and parts.size == 1 then "{text}," else text
		needs-parens: true
-quote-if-necessary string(key symbol)
	s string = key to
	if s is-crow-identifier then s else s quoted

+json json grammar()
	func: of iter
		res = iter parse-json
		iter skip-whitespace
		res
| Expose an alternate version to void 'parse' which is an async fun
~parse-json json(a string)
	iter string-mut-iterator = a,
	res = iter parse-json
	iter skip-whitespace
	assert iter is-at-end else a parse-error iter.to, "string continues past end of parse"
	res
-parse-json json(a string-mut-iterator)
	a skip-whitespace
	if a try-take "false"
		false
	elif a try-take "true"
		true
	elif a try-take "null"
		null
	elif a try-take "\""
		a.take-quoted-string-after-quote to
	elif a try-take "["
		a skip-whitespace
		res json[] =
			guard a !try-take "]"
			with out in build
				out ~= a parse-json
				a skip-whitespace
				while a try-take ","
					out ~= a parse-json
				a skip-whitespace
				assert a try-take "]" else "']'" inner-parse-error
		res to
	elif a try-take "\{"
		a skip-whitespace
		res json[symbol] =
			guard a !try-take "}"
			with out in build
				out ~= a take-key-value
				while a try-take ","
					out ~= a take-key-value
				a skip-whitespace
				assert a try-take "}" else "'}'" inner-parse-error
		res to
	else
		try
			a.take-float to
		catch inner-parse-error _
			throw "JSON value" inner-parse-error
-take-key-value (symbol, json)(a string-mut-iterator)
	a skip-whitespace
	key = a take-quoted-string
	a skip-whitespace
	assert a try-take ":" else "':'" inner-parse-error
	a skip-whitespace
	value = a parse-json
	a skip-whitespace
	key.to, value

# TODO: PRIVATE -------------------------------------------------------------------------------------------------------------------------------------
~try-take-number json?(iter string-mut-iterator)
	if iter.peek8 is-digit or iter.peek8 == "-" and iter.peek8-next is-digit
		# TODO: could take an int or nat
		iter.take-float to

+crowd json grammar()
	func: it.parse-crowd

~crowd-parse-error record(pos nat32, expected string)
~parse-crowd-result union(json, crowd-parse-error)
~parse-crowd parse-crowd-result(text char8 array-view)
	iter string-mut-iterator = text,
	try
		res = iter parse-crowd
		assert iter is-at-end else "Crowd value" inner-parse-error
		res
	catch inner-parse-error x
		pos: iter pos
		expected: x expected

-parse-crowd json(iter string-mut-iterator)
	indent-kind = iter detect-indent-kind
	iter skip-all-whitespace
	ctx ctx = indent-kind: indent-kind
	res, new-indent = iter parse-crowd-line ctx, 0
	assert new-indent == eof-indent
	res

-ctx record(indent-kind indent-kind)
-eof-indent int32()
	# Treat end of file as being at a lesser indent so the parser will naturally exit
	-1

| Returns the expression, and optionally the new indent amount (which will be <= {indent})
-parse-crowd-line (json, int32)(iter string-mut-iterator, ctx ctx, indent int32)
	if iter try-take-list-start
		iter parse-crowd-multi-line-list ctx, indent
	else
		match iter parse-crowd-simple
		as json first
			value = if iter try-take-char8 ","
				iter parse-crowd-single-line-list-after-value-and-comma first
			else
				first
			- value
			- iter take-next-indent ctx, indent
		as symbol name
			iter parse-crowd-single-or-multi-line-object ctx, name, indent

-to (json, int32?)((j json, i int32))
	j, i

-parse-crowd-inner-including-list (json, int32?)(iter string-mut-iterator, ctx ctx, indent int32)
	res, new-indent = iter parse-crowd-inner ctx, indent
	- if !(_ ?= new-indent) and iter try-take-char8 ","
		iter parse-crowd-single-line-list-after-value-and-comma res
	else
		res
	- new-indent

| This does not take commas for lists. Caller is responsible.
-parse-crowd-inner (json, int32?)(iter string-mut-iterator, ctx ctx, indent int32)
	iter skip-spaces
	if iter try-take-char8 "\n"
		new-indent = iter take-next-indent-after-newline ctx
		assert new-indent == indent + 1 else "Crowd value" inner-parse-error
		iter parse-crowd-line ctx, new-indent to
	else
		match iter parse-crowd-simple
		as json first
			- first
			- iter try-take-next-indent ctx, indent
		as symbol name
			iter parse-crowd-single-line-object ctx, name, indent to

-parse-crowd-single-line-list-after-value-and-comma json(iter string-mut-iterator, first json)
	iter skip-spaces
	if iter peek-end-of-line or iter.peek8 == ")"
		- first
	else
		iter parse-crowd-single-line-list-after-value-comma-value first, iter.parse-crowd-simple-no-colon
-parse-crowd-single-line-list-after-value-comma-value json(iter string-mut-iterator, first json, second json)
	values json[] = with out in build
		out ~= first
		out ~= second
		while iter try-take-char8 ","
			iter skip-spaces
			out ~= iter parse-crowd-simple-no-colon
	values to

-parse-crowd-multi-line-list (json, int32)(iter string-mut-iterator, ctx ctx, indent int32)
	new-indent mut int32 = ()
	res json[] = with out in build
		first-value, first-indent = iter parse-crowd-inner-including-list ctx, indent 
		out ~= first-value
		new-indent := first-indent else iter take-next-indent ctx, indent
		while new-indent == indent
			assert iter try-take-list-start else "List item" inner-parse-error
			next-value, next-indent = iter parse-crowd-inner-including-list ctx, indent
			out ~= next-value
			new-indent := next-indent else iter take-next-indent ctx, indent
	res.to, new-indent

-try-take-list-start bool(iter string-mut-iterator)
	if iter starts-with-then-whitespace "-"
		_ = iter take-char8
		true

-parse-crowd-single-line-object (json, int32)(iter string-mut-iterator, ctx ctx, first-name symbol, indent int32)
	first-value, first-indent = iter parse-crowd-inner ctx, indent
	if x ?= first-indent
		res json[symbol] = (first-name, first-value),
		res.to, x
	else
		iter parse-crowd-single-line-object-inner ctx, first-name, first-value, indent

-parse-crowd-single-or-multi-line-object (json, int32)(iter string-mut-iterator, ctx ctx, first-name symbol, indent int32)
	first-value, first-indent = iter parse-crowd-inner ctx, indent
	guard x ?= first-indent else iter parse-crowd-single-line-object-inner ctx, first-name, first-value, indent
	new-indent mut int32 = x
	res json[symbol] = with out in build
		out ~= first-name, first-value
		while new-indent == indent
			next-name = iter take-name-colon-or-string-colon
			next-value, next-indent = iter parse-crowd-inner-including-list ctx, indent
			new-indent := next-indent else iter take-next-indent ctx, indent
			out ~= next-name, next-value
	res.to, new-indent

-parse-crowd-single-line-object-inner (json, int32)(iter string-mut-iterator, ctx ctx, first-name symbol, first-value json, indent int32)
	new-indent mut int32? = ()
	cur-name mut = first-name
	cur-value mut = first-value
	res json[symbol] = with out in build
		while !(_ ?= new-indent) and iter try-take-char8 ","
			iter skip-spaces
			match iter parse-crowd-simple
			as json value
				cur-value := iter parse-crowd-single-line-list-after-value-comma-value cur-value, value
			as symbol name
				out ~= cur-name, cur-value
				next-value, next-indent = iter parse-crowd-inner ctx, indent
				cur-name := name
				cur-value := next-value
				new-indent := next-indent
		out ~= cur-name, cur-value
	- res to
	- new-indent else iter take-next-indent ctx, indent

-parse-crowd-simple-no-colon json(iter string-mut-iterator)
	if iter try-take-char8 "("
		iter after-paren
	elif name ?= iter try-take-crow-identifier
		name crowd-value-from-name
	elif x ?= iter try-take-quoted-string
		x to
	elif x ?= iter try-take-number
		x
	else
		throw "Crowd value" inner-parse-error

-after-paren json(iter string-mut-iterator)
	if iter try-take-char8 ")"
		null
	else
		value, dedent = iter parse-crowd-inner-including-list (indent-kind: tabs), 0
		assert !(_ ?= dedent) and iter try-take-char8 ")" else
			"Closing parenthesis" inner-parse-error
		value

# 'json' for a simple value; 'symbol' for a name followed by a colon
-crowd-simple union(json, symbol)
-parse-crowd-simple crowd-simple(iter string-mut-iterator)
	if iter try-take-char8 "("
		iter after-paren
	elif name ?= iter try-take-crow-identifier
		if iter try-take-char8 ":"
			name
		else
			name crowd-value-from-name
	elif x ?= iter try-take-quoted-string
		if iter try-take-char8 ":"
			x.to::symbol
		else
			x.to::json
	elif x ?= iter try-take-number
		x
	else
		throw "Crowd value" inner-parse-error

-crowd-value-from-name json(name symbol)
	match name
	as false
		false
	as true
		true
	as empty-array
		()::json[] to
	as empty-object
		()::json[symbol] to
	else
		throw "Crowd value" inner-parse-error

-peek-end-of-line bool(a string-mut-iterator)
	a is-at-end or a.peek8 == "\n"

-take-name-colon-or-string-colon symbol(iter string-mut-iterator)
	assert res ?= (iter try-take-crow-identifier or iter.try-take-quoted-string ?to) else
		"Identifier or string, then ':'" inner-parse-error
	assert iter try-take-char8 ":" else "Colon after identifier" inner-parse-error
	res

-skip-all-whitespace void(iter string-mut-iterator)
	while iter.peek8 is-whitespace
		_ = iter take-char8
-skip-spaces void(iter string-mut-iterator)
	while iter.peek8 is-whitespace-non-newline
		_ = iter take-char8
~try-take-quoted-string string?(iter string-mut-iterator)
	if iter try-take-char8 "\"" then iter take-quoted-string-after-quote

-try-take-next-indent int32?(iter string-mut-iterator, ctx ctx, cur-indent int32)
	if iter peek-end-of-line
		iter take-next-indent ctx, cur-indent
-take-next-indent int32(iter string-mut-iterator, ctx ctx, cur-indent int32) # TODO: not sure we actually need cur-indent here ......................
	iter skip-spaces
	assert iter try-take-newline or iter is-at-end else "Newline" inner-parse-error
	res = iter take-next-indent-after-newline ctx
	assert res <= cur-indent else "Cannot indent here" inner-parse-error
	res
-take-next-indent-after-newline int32(iter string-mut-iterator, ctx ctx)
	loop
		new-indent = iter take-indent-amount-after-newline ctx.indent-kind, of _
			throw "Indent by {ctx.indent-kind}" inner-parse-error
		if iter is-at-end
			break eof-indent
		elif iter try-take-newline
			continue
		else
			break new-indent to
