no-std
import
	./bool
	./compare
	./col/array
	./col/collection
	./col/map
	./col/mut-array
	./col/set
	./exception
	./hash
	./parse
	./misc
	./number
	./option
	./range
	./string
	./symbol
	./tuple

| JSON data.
| The representation is deliberately opaque to allow precise representation of numbers.
| Generally you should use 'to::t' to read a JSON value as the type you expect it to be.
| If you really need to match on a json value, use {simplify}.
+json record
	-inner json-inner
-json-inner union(null, bool, nat64, int64, float64, string, json[], json[symbol])

+interpolate json(...parts string[])
	parts.interpolate to

+deserialize-error record(value json) exception case
+show string(a deserialize-error)
	"The json value cannot be interpreted as this type. Actual: {a value}"

+json-simplified union(null, bool, float64, string, json[], json[symbol])
+== bool(a json-simplified, b json-simplified)
+simplify json-simplified(a json)
	match a inner
	as null
		null
	as bool x
		x
	as nat x
		x.to::float64
	as int x
		x.to::float64
	as float x
		x
	as string x
		x
	as array x
		x
	as map x
		x

+== bool(a json, b json)
	# TODO: We should actually just use the auto fun. But make sure '1' parses as a nat consistently!
	a.simplify == b.simplify

+to string(a json)
	a.inner.string else throw a deserialize-error

+null record
+== bool(a null, b null)
+to json(a null)
	a,

| If no arguments are passed this is {null}. Otherwise it is a JSON array.
| For an empty JSON array, use `()::json[] to`
+new json(...args json[])
	if args is-empty
		null
	else
		- args
+named-new json(keys symbol[], values json[])
	assert keys.size == values.size
	map json[symbol] = for i in 0 .. keys.size
		keys[i], values[i]
	map to

+null json()
	inner: ()::null
+false json()
	inner: false::bool
+true json()
	inner: true::bool
+to json(a json)
	a
+to json(_ void)
	null
+to json(a bool)
	inner: a
+to json(a char8)
	a.to::string to
+to json(a char32)
	a.to::string to
+to json(a string)
	inner: a
+to json(a nat8)
	a.to::nat64 to
+to json(a nat16)
	a.to::nat64 to
+to json(a nat32)
	a.to::nat64 to
+to json(a nat64)
	inner: a
+to json(a int8)
	a.to::int64 to
+to json(a int16)
	a.to::int64 to
+to json(a int32)
	a.to::int64 to
+to json(a int64)
	inner: a
+to json(a float32)
	a.to::float64 to
+to json(a float64)
	inner: a
+to json(a symbol)
	a.to::string to
+to[t] json(a t[]) (json, t) to
	- (a map it.to)::json[]
+to[t] json(a t array-view) (json, t) to
	- (a map it.to)::json[]
+to[t] json(a t mut[]) (json, t) to
	- (a map it.to)::json[]
+to[t] json(a t set) (json, t) to, t key
	- (a map it.to)::json[]
+to[k, v] json(a v[k]) k key, (symbol, k) to, (json, v) to
	inner:
		:: json[symbol]
		for k, v in a then k.to, v.to
+to[v] v[symbol](a json) (v, json) to
	match a inner
	as null
		()
	as map x
		x map-values it.to
	else
		throw a deserialize-error
+to[t] json(a t?) (json, t) to
	if x ?= a
		x to
	else
		null
+to[t, u] json(a (t, u)) (json, t) to, (json, u) to
	a.a.to, a.b.to
+to json(a comparison)

| If {a} is an `object` containing the key {key}, returns the associated value.
| Returns `null` if one of these is true:
| * {a} is not an object.
| * {a} is an object, but does not have {key}.
| * {a} is an object with the key, and its value is {null}.
|
| Most code does not care about this distinction.
| If you do, you can test `if obj ?= {a} object` or `if {key} in a`.
+subscript json(a json, key symbol)
	a.inner.map?[key] else null

| {true} if {a} is an object and {key} is one of its keys.
+in bool(key symbol, a json)
	x ?= a.inner map and key in x

| `a bool-or-null` is like `a bool`, but treats {null} as {false}.
+to bool(a json)
	a.inner bool else
		assert a == null else a deserialize-error
		false

+to[t] t[](a json) (t, json) to
	match a inner
	as null
		()
	as array xs
		xs map it.to
	else
		throw a deserialize-error

+to nat32(a json)
	a.to::nat64 to
+to nat64(a json)
	a.inner.float64! to
+to symbol(a json)
	a.to::string to

| By default, json is shown using crowd.
+show string(a json)
	a to-crowd

| Converts a value to {json} and renders it as standard JSON.
+to-json[t] string(a t) (json, t) to
	match a.to inner
	as null
		"null"
	as bool b
		"{b}"
	as nat64 x
		"{x}"
	as int64 x
		"{x}"
	as float64 f
		"{f}"
	as string s
		s quote
	as array xs
		parts = "," join for x in xs then "{x to-json}"
		"[{parts}]"
	as map xs
		parts = "," join for k, v in xs
			"{k.to quote}:{v to-json}"
		"\{{parts}}"

+build json(a build-options, f void mut(out json array-builder))
	(a build f)::json[] to

+to-crowd string(a json)
	a to-crowd
		indent: 0
+to-crowd-options record
	indent nat
+to-crowd string(a json, options to-crowd-options)
	with out in build
		out to-crowd a, options
-to-crowd void(out string-builder, a json, options to-crowd-options)
	match a simplify
	as array xs
		if xs is-empty
			out ~~= "empty-array"
		else
			first mut bool = true
			for x in xs
				if first
					first := false
				else
					out ~~= options newline
				out ~= "-"
				out to-crowd-inner x, options
	as map pairs
		if pairs is-empty
			out ~~= "empty-object"
		else
			first mut bool = true
			for key, value in pairs
				if first
					first := false
				else
					out ~~= options newline
				out ~~= if key.to is-identifier then key to else key.to quote
				out ~= ":"
				out to-crowd-inner value, options
	else
		out ~~= a to-json

-is-identifier bool(a char8[])
	a[0] is-letter and a[1 .. end] every of x
		x is-letter or x is-digit
-is-letter bool(a char8)
	"a"::char8 <= a and a <= "z" or
	"A"::char8 <= a and a <= "Z"

-to-crowd-inner void(out string-builder, a json, options to-crowd-options)
	if a is-scalar
		out ~= " "
		out ~~= a to-json
	else
		new-options to-crowd-options =
			indent: options.indent + 1
		out ~~= new-options newline
		out to-crowd a, new-options
-is-scalar bool(a json)
	match a simplify
	as array _
		false
	as map _
		false
	else
		true
-newline string(options to-crowd-options)
	"\n" ~~ ("\t" repeat options.indent)

+json json grammar()
	func: of iter
		res = iter parse-json
		iter skip-whitespace
		res
| Expose an alternate version to void 'parse' which is an async fun
~parse-json json(a string)
	iter string-mut-iterator = a,
	res = iter parse-json
	iter skip-whitespace
	assert iter is-at-end else a parse-error iter.to, "string continues past end of parse"
	res
-parse-json json(a string-mut-iterator)
	a skip-whitespace
	if a try-take "false"
		false
	elif a try-take "true"
		true
	elif a try-take "null"
		null
	elif a try-take "\""
		a.take-quoted-string-after-quote to
	elif a try-take "["
		a skip-whitespace
		res json[] =
			guard a !try-take "]"
			with out in build
				out ~= a parse-json
				a skip-whitespace
				while a try-take ","
					out ~= a parse-json
				a skip-whitespace
				assert a try-take "]" else "']'" inner-parse-error
		res to
	elif a try-take "\{"
		a skip-whitespace
		res json[symbol] =
			guard a !try-take "}"
			with out in build
				out ~= a take-key-value
				while a try-take ","
					out ~= a take-key-value
				a skip-whitespace
				assert a try-take "}" else "'}'" inner-parse-error
		res to
	else
		try
			a.take-float to
		catch inner-parse-error _
			throw "JSON value" inner-parse-error
-take-key-value (symbol, json)(a string-mut-iterator)
	a skip-whitespace
	key = a take-quoted-string
	a skip-whitespace
	assert a try-take ":" else "':'" inner-parse-error
	a skip-whitespace
	value = a parse-json
	a skip-whitespace
	key.to, value
