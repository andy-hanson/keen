no-std
import
	./bool
	./compare
	./col/array
	./col/collection
	./col/experimental/index-set
	./col/map
	./col/mut-array
	./col/set
	./hash
	./js
	./parse
	./misc
	./number
	./option
	./range
	./result
	./string
	./symbol
	./tuple

| JSON data.
+json record
	-inner json-inner
-json-inner union(null, bool, float64, string, json-array, json-object)
+json-array record(elements json[])
+== bool(a json-array, b json-array)
+json-object record(fields json[symbol])
+== bool(a json-object, b json-object)

+== bool(a json, b json)
-== bool(a json-inner, b json-inner)

+string string?(a json)
	a.inner string
+object json[symbol]?(a json)
	a.inner.json-object?.fields

+null record
+== bool(a null, b null)
+to json(a null)
	a,

+new json(...pairs (symbol, json)[]) # TODO: RM ------------------------------------------------------------------------------------------------
	(pairs.to,)::json-object,
+named-new json(keys symbol[], values json[])
	assert keys.size == values.size
	map json[symbol] = for i : 0 .. keys.size
		keys[i], values[i]
	map to

+null json()
	null,
+to json(a json)
	a
+to json(_ void)
	()
+to json(a bool)
	a::json-inner,
+to json(a char8)
	a.to::string to
+to json(a char32)
	a.to::string to
+to json(a string)
	a,
+to json(a nat8)
	a.to::nat64 to
+to json(a nat16)
	a.to::nat64 to
+to json(a nat32)
	a.to::nat64 to
+to json(a nat64)
	a.to::float64 to
+to json(a int8)
	a.to::int64 to
+to json(a int16)
	a.to::int64 to
+to json(a int32)
	a.to::int64 to
+to json(a int64)
	a.to::float64 to
+to json(a float32)
	a.to::float64 to
+to json(a float64)
	a,
+to json(a symbol)
	a.to::string to
+to[t] json(a t[]) (json, t) to
	xs json[] = for x : a; x to
	(xs,)::json-array,
+to[t] json(a t array-view) (json, t) to
	(for x : a; x to)::json[] to
+to[t] json(a t mut[]) (json, t) to
	(for x : a; x to)::json[] to
+to[t] json(a t set) (json, t) to, t key
	(for x : a; x to)::json[] to
+to[k, v] json(a v[k]) k key, (symbol, k) to, (json, v) to
	((for k, v : a; k.to, v.to),)::json-object,
to json(a index-set)
	(for x : a; x to)::json[] to
+to[t] json(a t?) (json, t) to
	if x ?= a
		x to
	else
		null
+to[t, u] json(a (t, u)) (json, t) to, (json, u) to
	(a.a.to, a.b.to)::json[] to
+to json(a comparison)
+to[t, u] json(a (t, u) result) (json, t) to, (json, u) to
	match a
	as ok v
		ok: v.value to
	as fail e
		fail: e.value to

+symbol symbol?(a json)
	a.inner.string?.to

| If {a} is an `object` containing the key {key}, returns the associated value.
| Returns `null` if one of these is true:
| * {a} is not an object.
| * {a} is an object, but does not have {key}.
| * {a} is an object with the key, and its value is {null}.
|
| Most code does not care about this distinction.
| If you do, you can test `if obj ?= {a} object` or `if {key} in a`.
+subscript json(a json, key symbol)
	a.inner.json-object?.fields?[key] ?? null

| {true} if {a} is an object and {key} is one of its keys.
+in bool(key symbol, a json)
	if obj ?= a.inner json-object
		key in obj.fields

| `a bool-or-null` is like `a bool`, but treats {null} as {false}.
+bool-or-null bool?(a json)
	a == null ? false : a.inner bool

+array json[]?(a json)
	a.inner.json-array?.elements

| `a array-or-null` is like `a array`, but treats {null} as an empty array.
+array-or-null json[]?(a json)
	if a == null
		()::json[]
	else
		a.inner.json-array?.elements

+json json grammar()
	func: iter =>
		iter skip-whitespace
		res = iter parse-json
		iter skip-whitespace
		res
-parse-json json(a string-mut-iterator)
	a skip-whitespace
	# TODO: match on char -----------------------------------------------------------------------------------------------------------------------------------------------
	if a try-take "false"
		false to
	elif a try-take "true"
		true to
	elif a try-take "null"
		null
	elif a try-take "\""
		a.take-quoted-string-after-quote to
	elif a try-take "["
		a skip-whitespace
		res json[] = do
			guard a !try-take "]"
			with out : build
				out ~= a parse-json
				a skip-whitespace
				while a try-take ","
					out ~= a parse-json
				assert a try-take "]" : "']'" inner-parse-error
		res to
	elif a try-take "\{"
		a skip-whitespace
		res json[symbol] = do
			guard a !try-take "}"
			with out : build
				out ~= a take-key-value
				while a try-take ","
					out ~= a take-key-value
				assert a try-take "}" : "'}'" inner-parse-error
		res to
	else
		try
			a.take-float to
		catch inner-parse-error _
			throw "JSON value" inner-parse-error
-take-key-value (symbol, json)(a string-mut-iterator)
	a skip-whitespace
	key = a take-quoted-string
	a skip-whitespace
	assert a try-take ":" : "':'" inner-parse-error
	a skip-whitespace
	value = a parse-json
	a skip-whitespace
	key.to, value

# TODO: use the below if performance is just as good (it probably isn't though) -----------------------------------------------------------------------
###
+json json grammar()
	spaces ~~ json-inner ~~ spaces
-json-inner json grammar()
	with : lazy
		(json-object map x => x to) / (json-array map x => x to) / json-primitive
-json-object json[symbol] grammar()
	quoted-symbol symbol grammar = quoted-string map s => s.to
	pair (symbol, json) grammar = quoted-symbol ~~ spaces ~~ ":" ~~ spaces ~~ json
	pairs (symbol, json)[] grammar = pair separated-by "," ~~ spaces
	pairs2 json[symbol] grammar = pairs map x => x to
	"\{" ~~ spaces ~~ pairs2 ~~ spaces ~~ "}"
-json-array json[] grammar()
	"[" ~~ spaces ~~ (json separated-by "," ~~ spaces) ~~ spaces ~~ "]"
-json-primitive json grammar()
	literal json grammar = (bool map x => x to) / ("null" exact null)
	(quoted-string map x => x.to) / (float map x => x.to) / literal
###

+to[t] t[](a json) (t, json) to
	for x : a.inner.json-array! elements
		x to

+to nat32(a json)
	a.to::nat64 to
+to nat64(a json)
	a.inner.float64! to

| Renders a {json} value to JSON.
+show string(a json)
	match a inner
	as null
		"null"
	as bool b
		"{b}"
	as float64 f
		"{f}"
	as string s
		s quote
	as json-array xs
		parts = "," join for x : xs.elements; "{x}"
		"[{parts}]"
	as json-object o
		parts = "," join for k, v : o fields
			"{k.to quote}:{v}"
		"\{{parts}}"

| Converts from a {json} value to the corresponding JavaScript object.
+to js-any(a json) trusted, js extern
	match a inner
	as null
		null
	as bool x
		x as-js
	as float64 x
		x as-js
	as string x
		x to-js-string
	as json-array xs
		(for x : xs.elements; x to)::js-any[] as-js
	as json-object x
		res = "Object".js-global call-new
		for key, value : x fields
			res[key to] := value
		res

| Converts a JS object to the corresponding JSON value.
| This does not fail on JS values that aren't JSON values; it just returns {null}.
+to json(a js-any) unsafe, js extern
	match a typeof
	as boolean
		a.cast::bool to
	as number
		a.cast::float64 to
	as string
		a.string-of-js-string to
	as object
		if a == null
			null
		elif a instanceof "Array".js-global
			a.cast::js-any[] to
		else
			entries js-any[] = "Object".js-global call-property "entries", a cast
			map json[symbol] = for entry : entries
				entry[0::nat64].string-of-js-string.to, entry[1::nat64].to
			map to
	else
		null
