+e float32()
	2.718281828459045
+e float64()
	2.718281828459045

| Logarithm base {e}
+log float32(a float32)
	a.to.log to
+log float64(a float64)
	assert a > 0 else a float-out-of-range
	trusted if java
		a java-log
	elif js
		"Math".js-global call-property "log", a.to to
	else
		throw todo

+log float32(a float32, base float32)
	a.log / base.log
+log float64(a float64, base float64)
	a.log / base.log
