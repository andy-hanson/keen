no-std
import
	java/lang/Math: sqrt
	../compare
	../exception
	../js
	../misc
	../number
	../private/java-math
	../string

+pi float64()
	3.141592653589793239
+pi float32()
	pi::float64.to
| pi / 2
+pi_2 float64()
	1.570796326794899662
+pi_2 float32()
	pi_2::float64.to
| pi / 4
+pi_4 float64()
	# TODO: add '62' to the end
	0.785398163397448309
+pi_4 float32()
	pi_4::float64.to

| Used for a non-total function like 'square-root'
+float-out-of-range record(input float64) exception case
+show string(a float-out-of-range)
	"Input is not in the domain of the function: {a input}"

+square-root float32(a float32)
	a.to.square-root to
+square-root float64(a float64)
	assert a >= 0 else a float-out-of-range
	trusted if java
		a sqrt
	elif js
		"Math".js-global call-property "sqrt", a.to to
	else
		throw todo

+acos float32(a float32)
	a.to.acos to
+acos float64(a float64)
	trusted if java
		a java-acos
	elif js
		"Math".js-global call-property "acos", a.to to
	else
		throw todo
+asin float32(a float32)
	a.to.asin to
+asin float64(a float64)
	trusted if java
		a java-asin
	elif js
		"Math".js-global call-property "asin", a.to to
	else
		throw todo
+atan float32(a float32)
	a.to.atan to
+atan float64(a float64)
	trusted if java
		a java-atan
	elif js
		"Math".js-global call-property "atan", a.to to
	else
		throw todo
+atan2 float32(y float32, x float32)
	y.to atan2 x.to to
+atan2 float64(y float64, x float64)
	trusted if java
		y java-atan2 x
	elif js
		"Math".js-global call-property "atan2", y.to, x.to to
	else
		throw todo
+cos float32(a float32)
	a.to.cos to
+cos float64(a float64)
	trusted if java
		a java-cos
	elif js
		"Math".js-global call-property "cos", a.to to
	else
		throw todo
