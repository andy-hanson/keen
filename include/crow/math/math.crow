+tan float32(a float32)
	a.to.tan to
+tan float64(a float64)
	trusted if java
		a java-tan
	elif js
		"Math".js-global call-property "tan", a.to to
	else
		throw todo
+acosh float32(a float32)
	a.to.acosh to
+acosh float64(a float64)
	trusted if java
		(a * a - 1 square-root) + a log
	elif js
		"Math".js-global call-property "acosh", a.to to
	else
		throw todo
+asinh float32(a float32)
	a.to.asinh to
+asinh float64(a float64)
	trusted if java
		(a * a + 1 square-root) + a log
	elif js
		"Math".js-global call-property "asinh", a.to to
	else
		throw todo
+atanh float32(a float32)
	a.to.atanh to
+atanh float64(a float64)
	trusted if java
		((a + 1) / (a - 1)).abs.log * 0.5
	elif js
		"Math".js-global call-property "atanh", a.to to
	else
		throw todo
+cosh float32(a float32)
	a.to.cosh to
+cosh float64(a float64)
	trusted if java
		a java-cosh
	elif js
		"Math".js-global call-property "cosh", a.to to
	else
		throw todo
