use-prefix
no-std
import
	java/lang/Math: sqrt
	../compare
	../exception
	../js
	../misc
	../number
	../private/java-math
	../string

+pi float64()
	3.141592653589793239
+pi float32()
	pi::float64.to
| pi / 2
+pi_2 float64()
	1.570796326794899662
+pi_2 float32()
	pi_2::float64.to
| pi / 4
+pi_4 float64()
	# TODO: add '62' to the end
	0.785398163397448309
+pi_4 float32()
	pi_4::float64.to

| Used for a non-total function like 'square-root'
+float-out-of-range record(input float64) exception case
+show string(a float-out-of-range)
	"Input is not in the domain of the function: {a.input}"

+square-root float32(a float32)
	a.to.square-root.to
+square-root float64(a float64)
	assert a >= 0 else float-out-of-range a
	trusted if java
		sqrt a
	elif js
		call-property "Math".js-global, "sqrt", a.to 'to
	else
		throw todo

+acos float32(a float32)
	a.to.acos.to
+acos float64(a float64)
	trusted if java
		java-acos a
	elif js
		call-property "Math".js-global, "acos", a.to 'to
	else
		throw todo
+asin float32(a float32)
	a.to.asin.to
+asin float64(a float64)
	trusted if java
		java-asin a
	elif js
		call-property "Math".js-global, "asin", a.to 'to
	else
		throw todo
+atan float32(a float32)
	a.to.atan.to
+atan float64(a float64)
	trusted if java
		java-atan a
	elif js
		call-property "Math".js-global, "atan", a.to 'to
	else
		throw todo
+atan2 float32(y float32, x float32)
	atan2 y.to, x.to 'to
+atan2 float64(y float64, x float64)
	trusted if java
		java-atan2 y, x
	elif js
		call-property "Math".js-global, "atan2", y.to, x.to 'to
	else
		throw todo
+cos float32(a float32)
	a.to.cos.to
+cos float64(a float64)
	trusted if java
		java-cos a
	elif js
		call-property "Math".js-global, "cos", a.to 'to
	else
		throw todo
+sin float32(a float32)
	a.to.sin.to
+sin float64(a float64)
	trusted if java
		java-sin a
	elif js
		call-property "Math".js-global, "sin", a.to 'to
	else
		throw todo
+tan float32(a float32)
	a.to.tan.to
+tan float64(a float64)
	trusted if java
		java-tan a
	elif js
		call-property "Math".js-global, "tan", a.to 'to
	else
		throw todo
+acosh float32(a float32)
	a.to.acosh.to
+acosh float64(a float64)
	trusted if java
		log a + square-root (a * a - 1)
	elif js
		call-property "Math".js-global, "acosh", a.to 'to
	else
		throw todo
+asinh float32(a float32)
	a.to.asinh.to
+asinh float64(a float64)
	trusted if java
		log a + square-root (a * a + 1)
	elif js
		call-property "Math".js-global, "asinh", a.to 'to
	else
		throw todo
+atanh float32(a float32)
	a.to.atanh.to
+atanh float64(a float64)
	trusted if java
		0.5 * log abs ((a + 1) / (a - 1))
	elif js
		call-property "Math".js-global, "atanh", a.to 'to
	else
		throw todo
+cosh float32(a float32)
	a.to.cosh.to
+cosh float64(a float64)
	trusted if java
		java-cosh a
	elif js
		call-property "Math".js-global, "cosh", a.to 'to
	else
		throw todo
+sinh float32(a float32)
	a.to.sinh.to
+sinh float64(a float64)
	trusted if java
		java-sinh a
	elif js
		call-property "Math".js-global, "sinh", a.to 'to
	else
		throw todo
+tanh float32(a float32)
	a.to.tanh.to
+tanh float64(a float64)
	trusted if java
		java-tanh a
	elif js
		call-property "Math".js-global, "tanh", a.to 'to
	else
		throw todo

+e float32()
	2.718281828459045
+e float64()
	2.718281828459045

| Logarithm base {e}
+log float32(a float32)
	a.to.log.to
+log float64(a float64)
	assert a > 0 else float-out-of-range a
	trusted if java
		java-log a
	elif js
		call-property "Math".js-global, "log", a.to 'to
	else
		throw todo

+log float32(a float32, base float32)
	a.log / base.log
+log float64(a float64, base float64)
	a.log / base.log
