no-std
import
	./bool
	./col/collection: index-too-big, iterator-not-comparable
	./compare: !=, <, <=, >, compare, comparison, equal
	./misc: subscript
	./number: ==, <=>, +, -, nat64
	./option: new, option
	./private/bootstrap: new
export
	./private/range-low-level:
		.., difference, forward-rangeable, iterate, low, high, range, rangeable, size,
		subtract-to-nat

+subscript nat64 range(a nat64 range, b nat64 range)
	assert b.high <= a.size : b.high index-too-big a.size
	a.low + b.low .. a.low + b.high

region iteration

+add-nat[t] spec
	+ t(a t, n nat64)

+==[t] bool(a t range, b t range) t equal

+is-empty[t] bool(a t range) t equal
	a.low == a.high

+range-iterator[t] record
	-collection t range
	-next-value t
+==[t] bool(a t range-iterator, b t range-iterator) t equal
	assert a.collection == b.collection : iterator-not-comparable
	a.next-value == b.next-value
+<=>[t] comparison(a t range-iterator, b t range-iterator) t compare
	assert a.collection == b.collection : iterator-not-comparable
	a.next-value <=> b.next-value

+-[t] nat64(a t range-iterator, b t range-iterator) t difference
	a.next-value difference b.next-value
++[t] t range-iterator(a t range-iterator, n nat64) t compare, t add-nat
	value t = a.next-value + n
	assert value <= a.collection.high
	a.collection, value
+slice[t] t range(a t range-iterator, b t range-iterator) t compare
	assert a.next-value <= b.next-value
	a.next-value .. b.next-value

+begin[t] t range-iterator(a t range)
	a, a.low
+end[t] t range-iterator(a t range)
	a, a.high

+prev[t] (t range-iterator, t)?(a t range-iterator) t rangeable
	guard a.next-value > a.collection.low
	value = a.next-value prev
	(a.collection, value), value
+next[t] (t, t range-iterator)?(a t range-iterator) t forward-rangeable
	guard a.next-value < a.collection.high
	a.next-value, (a.collection, a.next-value.next)

+in[t] bool(a t, b t range) t compare
	b.low <= a and a < b.high

+clamp[t] t(a t, range t range) t rangeable
	if a < range.low
		range.low
	elif a > range.high
		range.high
	else
		a

+range-reverse[t] record(range t range)
+reverse[t] t range-reverse(a t range) t rangeable
	a,
+iterate[t] bool(a t range-reverse, f bool mut(x t)) t rangeable
	cur mut = a.range high
	loop
		guard cur != a.range.low : break
		cur := cur prev
		if f[cur]
			break true
		else
			continue
