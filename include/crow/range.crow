no-std
import
	./bool
	./col/collection
	./compare
	./number
export
	./private/range-low-level:
		.., difference, forward-rangeable, iterate, iterate-reverse, low, high, range, rangeable,
		size, subtract-to-nat

+subscript nat64 range(a nat64 range, b nat64 range)
	assert b.high <= a.size else b.high index-too-big a.size
	a.low + b.low .. a.low + b.high

region iteration

+add-nat[t] spec
	+ t(a t, n nat64)

+==[t] bool(a t range, b t range) t equal

+is-empty[t] bool(a t range) t equal
	a.low == a.high

+range-mut-iterator[t] record mut
	-collection t range
	-next-value mut t
+begin[t] t range-mut-iterator(a t range)
	a, a.low
+end[t] t range-mut-iterator(a t range)
	a, a.high
+take-prev[t] t(a t range-mut-iterator) t rangeable
	assert a.next-value > a.collection.low else iterator-out-of-bounds
	a.next-value := a.next-value prev
	a.next-value
+take-next[t] t(a t range-mut-iterator) t forward-rangeable
	assert a.next-value < a.collection.high else iterator-out-of-bounds
	res = a.next-value
	a.next-value := a.next-value next
	res

+in[t] bool(a t, b t range) t compare
	b.low <= a and a < b.high

+clamp[t] t(a t, range t range) t rangeable
	if a < range.low
		range.low
	elif a > range.high
		range.high
	else
		a
