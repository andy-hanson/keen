| Functions for generating cryptographically random numbers.
import
	keen/unsafe
	java/util/Random
	java/security/SecureRandom
	../bits
	../js

+random nat64() global
	trusted
	if java
		a SecureRandom = getInstanceStrong
		a.reinterpret-cast::Random.nextLong.wrap-to
	elif js
		xs = call-new js-global["Uint32Array"], 2
		_ = call-property js-global["crypto"], "getRandomValues", xs
		bits-cat xs[0].to::nat32, xs[1].to
	else
		throw todo

+random bool() global
	random::nat64 % 2 == 0

+random nat8() global
	random::nat64.wrap-to

+random nat16() global
	random::nat64.wrap-to

+random nat32() global
	random::nat64.wrap-to
