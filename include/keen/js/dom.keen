import
	keen/js
	keen/unsafe: reinterpret-cast
	./util

| Represents a DOM node.
# TODO: have a way to actually define a type like this!
+node alias
	js-any

region Create nodes

| Create a new DOM node with the given tag.
+create-node node(tag-name symbol) js
	trusted call-property document, "createElement", tag-name.to
| Create a new node with the given tag and HTML attributes.
+create-node node(tag-name symbol, attr string[symbol]) js
	node = create-node tag-name
	for key, value in attr
		_ = trusted call-property node, "setAttribute", key.to, value.to
	node
+create-node node
	tag-name symbol
	attr string[symbol]
	class-name string?
	children node[]
do js
	trusted
	node = create-node tag-name, attr
	if class-name
		node["className"] := class-name.to
	_ = call-property-spread node, "append", children
	node

+create-button node
	title string
	class-name string
	children node[]
	on-click void mut()
do js
	trusted
	res = create-node "button", (("title", title),), class-name, children
	res["onclick"] := on-click.to
	res

+style record(node node) mut
+set-subscript void(a style, key symbol, value string) js
	trusted
	a.node["style"][key.to] := value.to
+ ~~= void(a style, properties string[symbol]) js
	for key, value in properties
		a[key] := value

+classes record(node node) mut
+ ~= void(a classes, class-name string) js
	_ = trusted call-property a.node["classList"], "add", class-name.to
+ -= void(a classes, class-name string) js
	_ = trusted call-property a.node["classList"], "remove", class-name.to
+set-classes void(a node, class-names string[]) js
	trusted
	a["className"] := join " ", class-names 'to
+toggle void(a classes, class-name string) js
	a[class-name] := !a[class-name]
+subscript bool(a classes, class-name string) js
	to trusted call-property a.node["classList"], "contains", class-name.to
+set-subscript void(a classes, class-name string, value bool) js
	if value
		a ~= class-name
	else
		a -= class-name

+text-content string(a node) unsafe, js
	a["textContent"].to
+set-text-content void(a node, text string) js
	trusted
	a["textContent"] := text.to

+add-event-listener void(a node, event-name string, fn void mut(event js-any)) js
	trusted
	_ = call-property a, "addEventListener", event-name.to, fn.to

+create-input-text node(on-input void mut(x js-any), value string) js
	trusted
	res = create-node "input",
		type: "text"
		value: value
	_ = call-property res, "addEventListener", "input", on-input.to
	res

+create-div node() js
	create-div ""
+create-div node(class-name string) js
	create-div class-name, ()
+create-div node(class-name string, children node[]) js
	create-node "div", (), class-name, children

+create-span node(children node[]) js
	create-span "", (), children
+create-span node(class-name string, children node[]) js
	create-span class-name, (), children
+create-span node(class-name string, attr string[symbol], children node[]) js
	create-node "span", attr, class-name, children

+create-text-node node(text string) js
	trusted call-property document, "createTextNode", text.to

+document node() global, js
	trusted js-global["document"]

region Node properties

+is-text-node bool(a node) js
	trusted a["nodeType"].to::nat32 == 3

+attributes record(node node) mut
+subscript string?(a attributes, attr-name symbol) js
	trusted
	res = call-property a.node, "getAttribute", attr-name.to
	unless res == null then res.to
+set-subscript void(a attributes, attr-name symbol, value string) js
	trusted
	_ = call-property a.node, "setAttribute", attr-name.to, value.to
+ -= void(a attributes, attr-name symbol) js
	trusted
	_ = call-property a.node, "removeAttribute", attr-name.to
+ ~~= void(a attributes, attributes string[symbol]) js
	for key, value in attributes
		a[key] := value

| Gets the value for an input node, or "" if it's not an input node.
+value string(a node) js
	trusted
	value = a["value"]
	unless value == undefined then value.to
| You can set a 'value' on any node, but it will only make a visual difference for input nodes.
+set-value void(a node, value string) js
	trusted
	a["value"] := value.to

region Node queries

| Calls 'querySelector'
+query node?(parent node, selector string) js
	trusted
	res = call-property parent, "querySelector", selector.to
	unless res == null then res

+query-all node[](parent node, selector string) js
	trusted array-of-node-list call-property parent, "querySelectorAll", selector.to

+child-nodes node[](a node) js
	trusted array-of-node-list a["childNodes"]

-array-of-node-list node[](node-list js-any) js
	trusted call-property js-global["Array"], "from", node-list 'to

| Calls 'getElementById'
+element node?(parent node, id string) js
	trusted
	res = call-property parent, "getElementById", id.to
	unless res == null then res

+first-child node?(a node) js
	trusted
	res = a["firstChild"]
	unless res == null then res

region Events

+on-click void(a node, fn void mut()) global, js
	_ = trusted call-property a, "addEventListener", "click"::js-any, fn.to

+on-mouse-down void(a node, fn void mut()) global, js
	_ = trusted call-property a, "addEventListener", "mousedown"::js-any, fn.to

+on-mouse-up void(a node, fn void mut()) global, js
	_ = trusted call-property a, "addEventListener", "mouseup"::js-any, fn.to

region Mutations

+id string(a node) js
	trusted a["id"].to
+set-id void(a node, value string) js
	trusted
	a["id"] := value.to

| Append a child node.
+ ~= void(a node, b node) js
	_ = trusted call-property a, "appendChild", b

| Append many child nodes.
+ ~~= void(a node, b node[]) js
	for x in b
		a ~= x

| Overwrites any existing child nodes.
+set-children void(a node, children node[]) js
	remove-all-children a
	a ~~= children

+remove-all-children void(a node) js
	while child = first-child a
		_ = trusted call-property a, "removeChild", child

+remove-self void(a node) js
	_ = trusted call-property a, "remove"

region Custom elements

+custom-element-options record
	styles string[]
+new custom-element-options(style string)
	styles: style,
+define-custom-element void(element-name string, connected connected-callback) global, js
	define-custom-element element-name, (styles: ()), connected
+define-custom-element void
	element-name string
	options custom-element-options
	connected connected-callback
do global, js
	trusted
	constructor method = of this, _
		root = call-property this, "attachShadow", mode: "open"
		sheets js-any[] = for style in options.styles
			sheet = call-new js-global["CSSStyleSheet"]
			_ = call-property sheet, "replace", style.to
			sheet
		root["adoptedStyleSheets"] := sheets.to
		()
	connected-callback method = of this, _
		connected[as-custom-element-node this].to
	cls = make-class js-global["HTMLElement"], constructor, connectedCallback: connected-callback
	_ = call-property js-global["customElements"], "define", element-name.to, cls

+connected-callback alias
	void mut(this custom-element-node)

# TODO: figure out why it crashes when I try to make this an alias for js-any
# (some early access to 'target' is crashing it)
+custom-element-node record(dummy js-any)
+as-js js-any(a custom-element-node) js, unsafe
	reinterpret-cast a
+as-custom-element-node custom-element-node(a js-any) js, unsafe
	reinterpret-cast a
+as-node node(a custom-element-node) js
	trusted reinterpret-cast a
+attributes attributes(a custom-element-node) js
	attributes a.as-node
+shadow-root node(a custom-element-node) js
	trusted a.as-node["shadowRoot"]

+wait-until-window-loaded void() global, js
	trusted
	unless document["readyState"] == "complete"
		_ = await eval "new Promise(resolve => window.addEventListener('load', resolve))"
