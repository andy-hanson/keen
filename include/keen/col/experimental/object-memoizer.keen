no-std
import
	keen/bits
	keen/col/buffer
	keen/col/util
	keen/compare
	keen/misc
	keen/number
	keen/option
	keen/unsafe

memoizable[t, k] spec t data, k data, k equal
	memoizer-key k(a t)
	hash nat(a k)

object-memoizer[t, k] record mut
	# This uses a Robin Hood hash.
	| Greatest distance of any entry from its home
	-max-cost mut nat64
	| 2 ** capacity-log-2 is entries.size
	-capacity-log-2 mut nat
	| Mask to convert hash codes to indices = {capacity-log-2} 1 bits
	-index-mask mut nat
	-entries mut t weak-ref buffer
new[t, k] (t, k) object-memoizer() (t, k) memoizable
	max-cost: 0
	capacity-log-2: 1
	index-mask: index-mask-for 1
	entries: trusted uninitialized-buffer 2

-index-mask-for nat(capacity-log-2 nat)
	low-n-bits capacity-log-2

| WARN: 'make-value' should be a simple function. It should not access {a}.
memoize[t, k] t(a (t, k) object-memoizer, key k, make-value t mut()) unsafe, (t, k) memoizable
	find a, key else
		value = make-value[]
		must-insert a, value
		value

-find[t, k] t?(a (t, k) object-memoizer, key k) (t, k) memoizable
	i mut = ideal-index a, key
	cost mut = 0
	do until
	if cost > a.max-cost
		()::t?
	elif v = (trusted a.entries[i].get) and v.memoizer-key == key
		v
	else
		i := next-index a, i
		cost +:= 1
		()

| For this function, the caller guarantees that 'value' is not already in 'a'
-must-insert[t, k] void(a (t, k) object-memoizer, top-value t) (t, k) memoizable
	value mut = top-value
	i mut = ideal-index a, value.memoizer-key
	cost mut = 0
	while v = trusted a.entries[i].get
		its-home = ideal-index a, v.memoizer-key
		its-cost = cost a, its-home, i
		if cost > its-cost
			a.entries[i] := trusted value,
			value := v
			cost := its-cost
		i := next-index a, i
		cost +:= 1
		if cost >= a.max-cost
			a.max-cost := cost
			if a.max-cost > a.max-max-cost
				increase-capacity a
				i := ideal-index a, value.memoizer-key
				cost := 0
	a.entries[i] := trusted value,

-max-max-cost[t, k] nat(a (t, k) object-memoizer)
	a.capacity-log-2 / 2

-increase-capacity[t, k] void(a (t, k) object-memoizer) (t, k) memoizable
	old-entries = a.entries
	a.max-cost := 0
	a.capacity-log-2 +:= 1
	a.index-mask := index-mask-for a.capacity-log-2
	a.entries := trusted uninitialized-buffer 1 << a.capacity-log-2
	for x in old-entries
		if v = trusted x.get
			must-insert a, v

-ideal-index[t, k] nat(a (t, k) object-memoizer, key k) (t, k) memoizable
	key.hash & a.index-mask
-next-index[t, k] nat(a (t, k) object-memoizer, index nat)
	(wrap-add index, 1) & a.index-mask
-cost[t, k] nat(a (t, k) object-memoizer, ideal-index nat, actual-index nat)
	if ideal-index <= actual-index
		actual-index - ideal-index
	else
		a.entries.size - ideal-index + actual-index
