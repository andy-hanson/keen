no-std
import
	../bool
	../compare
	../misc
	../number
	../option
	../tuple
	../private/bootstrap: exception, string

+index-too-big record(actual nat64, max-exclusive nat64) exception case
+ == bool(a index-too-big, b index-too-big)
+show string(_ index-too-big)
	"The index is bigger than the collection's size."

| Exception when attempting to mutate a collection that is being iterated
+was-locked record exception case
+show string(_ was-locked)
	"The collection is temporarily in a state where this can not be done."

| Exception when attempting to skip too far forward or backward
+iterator-out-of-bounds record exception case
+show string(_ iterator-out-of-bounds)
	"Iterator out of bounds"
| Exception thrown when trying to {slice}
| but the first iterator is to the right of the second iterator.
+slice-right-to-left record exception case
+show string(_ slice-right-to-left)
	"Iterators for slice were in the wrong order"

| Some iterator operations like {slice} require two iterators to be for the same collection.
+iterator-not-comparable record exception case
+show string(_ iterator-not-comparable)
	"Iterators are for different collections and can't be compared."

+size[t] spec
	size nat64(a t)

+some[col, elem] spec
	some bool(a col, f bool mut(elem elem))
+some-reverse[col, elem] spec
	some-reverse bool(a col, f bool mut(elem elem))

+begin[iter, col] spec
	begin iter(a col)
+end[iter, col] spec
	end iter(a col)

+take-prev[elem, iter] spec
	take-prev elem(a iter)
+take-next[elem, iter] spec
	take-next elem(a iter)
+peek[elem, iter] spec
	peek elem?(a iter)
+peek-prev[elem, iter] spec
	peek-prev elem?(a iter)
+skip-next-n[iter] spec
	skip-next-n void(a iter, n nat)
+skip-prev-n[iter] spec
	skip-prev-n void(a iter, n nat)

+basic-iter[col, iter, elem] spec col size, (iter, col) begin, iter copy, (elem, iter) take-next
+basic-reverse-iter[col, iter, elem] spec col size, (iter, col) end, iter copy, (elem, iter) take-prev

+try-take-prev[elem, iter] elem?(a iter) (elem, iter) take-prev
	try
		take-prev a
	catch as iterator-out-of-bounds
		()
+try-take-next[elem, iter] elem?(a iter) (elem, iter) take-next
	try
		take-next a
	catch as iterator-out-of-bounds
		()

+slice[out, iter] spec
	slice out(begin iter, end iter)
+slice-out-of-order record exception case
+show string(_ slice-out-of-order)
	"Tried to slice from a later iterator to an earlier one."

+skip-prev[iter] spec
	- iter(a iter, n nat64)
+skip-next[iter] spec
	+ iter(a iter, n nat64)
+skip-prev-next[iter] spec iter skip-prev, iter skip-next

| Represents an index relative to the size of a collection.
+index-relative-to-end record(subtract nat64)
+end index-relative-to-end()
	0,
+to-index[col] nat64(a col, index index-relative-to-end) col size
	size = size a
	sub = index.subtract
	assert sub <= size else index-too-big sub, size + 1
	a.size - index.subtract

+ - index-relative-to-end(a index-relative-to-end, n nat64)
	a.subtract + n,

+index-maybe-relative-to-end union(nat, index-relative-to-end)
+range-relative-to-end record(low index-maybe-relative-to-end, high index-relative-to-end)
+ .. range-relative-to-end(low nat, high index-relative-to-end)
	low, high
+ .. range-relative-to-end(low index-relative-to-end, high index-relative-to-end)
	low, high

region 'for' loops

+first[col, elem] elem?(a col) (col, elem) some
	first a, it.identity
| Returns the first non-empty result of {f}.
+first[out, col, elem] out?(a col, f out? mut(elem elem)) (col, elem) some
	res mut out? = ()
	_ = some a, of x
		res := f[x]
		!!res
	res

+last[col, elem] elem?(a col) (col, elem) some-reverse
	last a, it.identity
+last[out, col, elem] out?(a col, f out? mut(elem elem)) (col, elem) some-reverse
	res mut out? = ()
	_ = some-reverse a, of x
		res := f[x]
		!!res
	res

| Returns the first element for which {f} returns {true},
| or an empty option if {f} always returned {false}.
+find[col, elem] elem?(a col, f bool mut(elem elem)) (col, elem) some
	res mut elem? = ()
	_ = some a, of x
		if f[x]
			res := x
			true
	res
+find-last[col, elem] elem?(a col, f bool mut(elem elem)) (col, elem) some-reverse
	res mut elem? = ()
	_ = some-reverse a, of x
		if f[x]
			res := x
			true
	res

| Returns the first index `i` for which `{f}[{a}[i]]` is true.
| Returns an empty option if {f} returned {false} for every element of {a}.
+find-index[col, elem] nat64?(a col, f bool mut(elem elem)) (col, elem) some
	i mut = 0
	ok = some a, of x
		if f[x]
			true
		else
			i +:= 1
			false
	if ok then i
+find-last-index[col, elem] nat64?(a col, f bool mut(elem elem)) col size, (col, elem) some-reverse
	i mut = 0
	ok = some-reverse a, of x
		if f[x]
			true
		else
			i +:= 1
			false
	if ok then a.size - 1 - i
~find-last-iter[col, iter, elem] iter?
	a col
	f bool mut(elem elem)
do (iter, col) end, (elem, iter) take-prev
	iter = a.end
	do until
	if x = try-take-prev iter
		if f[x] then iter
	else
		()::iter?

~last-iter-of[col, iter, elem] iter?
	a col
	value elem
do (iter, col) end, (elem, iter) take-prev, elem equal
	find-last-iter a, it == value

+contains[col, elem] bool(xs col, value elem) (col, elem) some, elem equal
	some xs, it == value

| If {search-value} is in {a}, return its index.
+index-of[col, elem] nat64?(a col, search-value elem) (col, elem) some, elem equal
	find-index a, it == search-value
+last-index-of[col, elem] nat64?(a col, search-value elem) col size, (col, elem) some-reverse, elem equal
	find-last-index a, it == search-value

| Equivalent to `f[a[0]] and f[a[1]] and ... and f[a[end - 1]]`.
|
| Calls {f} on each element of {a} and returns {false} the fist time {f} does.
| Returns {true} if {f} returned {true} every time.
+every[col, elem] bool(a col, f bool mut(elem elem)) (col, elem) some
	!some a, !f[it]

| Element with the greatest key.
+max-by[col, elem, key] elem?(a col, f key mut(x elem)) (col, elem) some, key compare
	?a most a, (of x then x, f[x]), of x, y
		if y.b > x.b then y else x
| Greatest result of {f}.
+max-of[col, elem, out] out?(a col, f out mut(x elem)) (col, elem) some, out compare
	most a, f, of x, y then max x, y

| Element with the least key.
+min-by[col, elem, key] elem?(a col, f key mut(x elem)) (col, elem) some, key compare
	?a most a, (of x then x, f[x]), of x, y
		if y.b < x.b then y else x
| Least result of {f}.
+min-of[col, elem, out] out?(a col, f out mut(x elem)) (col, elem) some, out compare
	most a, f, of x, y then min x, y

-most[col, elem, out] out?(a col, f out mut(x elem), is-preferred out mut(a out, b out)) (col, elem) some
	res mut out? = ()
	_ = some a, of x
		here = f[x]
		if res
			res := is-preferred[res!, here]
		else
			res := here
		false
	res

| Empty collection for an empty option; single-element collection for a non-empty option.
+from-option[col, elem] col(a elem?) (col, elem) list-new
	if a
		- a
