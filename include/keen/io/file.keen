import
	keen/bits
	keen/java
	keen/js
	keen/unsafe
	java/io/File
	java/lang/System
	java/nio/file/FileAlreadyExistsException
	java/nio/file/Files
	java/nio/file/Path
	java/nio/file/Paths
	java/nio/file/NoSuchFileException
	java/nio/file/CopyOption
	java/nio/file/StandardCopyOption
	./path: child-path

+path-already-exists record(path string) exception case
+show string(a path-already-exists)
	"Path already exists: {a.path}"

+path-not-found record(path string) exception case
+show string(a path-not-found)
	"Path not found: {a.path}"

+file-system-error record(path string, description string) exception case
+show string(a file-system-error)
	"Error at path {a.path}: {a.description}"

| {true} if anything (like a file or directory) exists at the path.
+path-exists bool(path string) global
	trusted
	assert java else todo
	exists path.to::Path, ()

| {true} if {path} is the path of a directory, or a symlink to a directory.
| {false} if there is anything else at the path, or nothing at the path.
+is-directory bool(path string) global
	try
		path.get-path-kind == directory
	catch as path-not-found
		false

| {true} if `path` is the path of a file, or a symlink to a file.
| {false} if there is anything else at the path, or nothing at the path.
+is-file bool(path string) global
	try
		path.get-path-kind == file
	catch as path-not-found
		false

+path-kind enum(file, directory, other)
+ == bool(a path-kind, b path-kind)
+to symbol(a path-kind)
+show string(a path-kind)
	a.to::symbol.to

+get-path-kind path-kind(path string) global
	trusted
	assert java else todo
	p Path = path.to
	assert exists p, () else path-not-found path
	if isRegularFile p, ()
		file
	elif isDirectory p, ()
		directory
	else
		other

| Returns all children of the directory {path}, as full paths.
| Use {names-in-dir} instead if you want just the basenames.
+paths-in-dir string[](path string) global
	for x in names-in-dir path
		child-path path, x

| Returns the basename of all children of the directory.
| Does not include ".." or ".".
| Use {paths-in-dir} instead if you want full paths.
+names-in-dir string[](a string) global
	trusted
	assert java else todo
	dir File = a.to,
	files = listFiles dir
	forbid is-null files else todo
	sort map files, it.getName.to

| Gets the path a symbolic link refers to.
+read-link string(_ string) global
	throw todo

| Create a symbolic link at {link} with the target {target}.
+make-symlink-to void(link string, target string) global
	trusted
	assert java else todo
	try
		_ = createSymbolicLink link.to, target.to, ()
	catch as FileAlreadyExistsException
		throw path-already-exists link

| Gets the path of the current executable.
| If this program was built to executable, this will return its path.
| Otherwise, this will be the path where `keen` is installed.
+current-executable-path string() global
	read-link "/proc/self/exe"

| Reads the full contents of the file.
+read-file string(path string) global
	path.read-file::nat8[].as-string

+copy-file void(from string, to string) global
	trusted
	assert java else todo
	_ = copy from.to, to.to,
		- REPLACE_EXISTING.reinterpret-cast::CopyOption

| Writes the full contents of the file as a string.
| If the file already exists, overwrites it.
+write-file void(path string, content string) global
	write-file path, content.to::nat8[]
+write-file void(path string, content nat8[]) global
	trusted
	assert java else todo
	_ = write path.to, content.reinterpret-cast::(int8 buffer), ()

-fs js-any() js
	trusted js-import "fs"

+read-file nat8[](path string) global
	trusted
	if java
		p Path = to path
		try
			safe-reinterpret-cast cast-immutable readAllBytes p
		catch as NoSuchFileException
			throw path-not-found path
	elif js
		try
			array-from-buffer call-property fs, "readFileSync", path.to
		catch exception
			code = (exception.reinterpret-cast::js-any)["code"]
			throw if code == "ENOENT"
				path-not-found path
			else
				exception
	else
		throw todo

-array-from-buffer nat8[](buffer js-any) unsafe, js
	reinterpret-cast call-property (trusted js-global["Uint8Array"]), "from", buffer

-to Path(a string) java
	trusted
	get a.to, ()

| Gets the current directory (of the user that ran the program).
+current-directory string() global
	trusted
	assert java else todo
	getProperty "user.dir" 'to

| If {path} is a directory, calls {f} on each file in the directory and any nested directories.
| If {path} is a file, calls {f} once.
+each-child-recursive void(path string, f void mut(path string)) global
	each-child-recursive path, (of _ then true), f

| Like {each-child-recursive}, but calls {filter} on names of directory children
| and skips them if {filter} returns false.
+each-child-recursive void
	path string
	filter bool mut(name string)
	f void mut(path string)
do global
	if is-directory path
		for child-name in names-in-dir path
			if filter[child-name]
				each-child-recursive (child-path path, child-name), filter, f
	else
		f[path]

| POSIX file permissions.
+file-permissions record(user permissions, group permissions, public permissions)
| Permissions for one of user, group, public.
+permissions record(read bool, write bool, execute bool)
+all permissions()
	true, true, true
+read-only permissions()
	true, false, false

+to nat(a file-permissions)
	a.user.to << 6 | a.group.to << 3 | a.public.to
+to nat(a permissions)
	a.read.to << 2 | a.write.to << 1 | a.execute.to

+no-permissions permissions()
	false, false, false

+all-permissions permissions()
	true, true, true

+read-write permissions()
	read: true, write: true, execute: false

+user-only file-permissions(user-permissions permissions)
	user-permissions, no-permissions, no-permissions

+set-permissions void(path string, permissions file-permissions) global
	_ = path
	_ = permissions
	throw todo

# TODO: this might not be the correct default permissions
| Creates a new empty directory at {path}.
+make-directory void(path string) global
	trusted
	assert java else todo
	file File = path.to,
	ok = mkdir file
	assert ok else todo

| Like 'make-directory', but OK if it already exists.
+ensure-directory void(path string) global
	try
		make-directory path
	catch x as path-already-exists
		assert path.get-path-kind == directory else x

| Deletes the file at {path}.
+remove-file void(path string) global
	trusted
	assert java else todo
	try
		delete path.to::Path
	catch as NoSuchFileException
		throw path-not-found path

| Deletes the directory at {path}. It should be empty.
+remove-directory void(path string) global
	_ = path
	throw todo

+temp-file record(prefix string, suffix string)
+with-block[t] t(a temp-file, f t mut(path string)) global
	trusted
	assert java else todo
	temp = createTempFile a.prefix.to, a.suffix.to
	finally delete toPath temp
	f[temp.toPath.toString.to]
