no-std
import
	java/io/PrintStream
	java/lang/System
	../compare: equal
	../exception
	../java
	../js
	../misc
	../string

+print void(message string) global
	trusted if java
		println out, message.to
	elif js
		_ = call-property js-global["console"], "info", message.to
	else
		throw not-implemented

+print-error void(message string) global
	trusted if java
		println err, message.to
	elif js
		_ = call-property js-global["console"], "error", message.to
	else
		throw not-implemented

+print-no-newline void(message string) global
	trusted
	assert java else todo
	print out, message.to

| Clear the terminal.
+clear-screen void() global
	print-no-newline "\x1bc"
