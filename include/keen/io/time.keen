import
	../js
	./duration

+unix-time record(seconds-since-epoch nat)
+ - duration(a unix-time, b unix-time)
	seconds to a.seconds-since-epoch - b.seconds-since-epoch

| Monotonically increasing time in nanoseconds.
+monotime record(nanoseconds nat)

| Get the value from a monotonic clock.
+monotime duration() global
	do trusted
	assert js else todo
	msec float = call-property js-global["performance"], "now" 'to
	milliseconds msec

| Get the current Unix timestamp.
+unix-time unix-time() global
	do trusted
	assert js else todo
	msec float = call-property js-global["Date"].call-new, "valueOf" 'to
	seconds-since-epoch: msec / 1000 'to

+sleep void(duration duration) global
	do trusted
	assert js else todo
	resolver = of resolve js-any
		:: void
		_ = call js-global["setTimeout"], resolve, duration.milliseconds.to
	_ = await call-new js-global["Promise"], resolver.to
