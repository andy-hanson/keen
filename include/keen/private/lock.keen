no-std
import
	java/util/concurrent/locks/StampedLock
	../exception
	../misc
	../option

~lock record force-shared
	-java StampedLock?

~new lock()
	do trusted
	if java
		java: ()::StampedLock
	else
		java: ()

~read-lock record(lock lock) shared
~with-block[t] t(a read-lock, f t mut()) unsafe
	do trusted
	if java
		lock = a.lock.java!
		stamp mut = tryOptimisticRead lock
		finally if isReadLockStamp stamp then unlockRead lock, stamp
		until
			res = f[]
			if validate lock, stamp
				res
			else
				stamp := readLock lock
				()
	elif js
		f[]
	else
		throw todo

~write-lock record(lock lock) shared
~with-block[t] t(a write-lock, f t mut()) unsafe
	do trusted
	if java
		lock = a.lock.java!
		stamp = writeLock lock
		finally unlockWrite lock, stamp
		f[]
	elif js
		f[]
	else
		throw todo
