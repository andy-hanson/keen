no-std
import
	keen/unsafe
	java/util/Random
	java/security/SecureRandom
	../bits
	../exception
	../misc
	../number
	../js
	./random

| This uses `SecureRandom` in Java and `crypto.getRandomValues` in JS.
+secure-random record mut, global, random case
+next nat32(_ secure-random) global
	do trusted
	if java
		getInstanceStrong::SecureRandom.reinterpret-cast::Random.nextInt.wrap-to
	elif js
		xs = call-new js-global["Uint32Array"], 1
		_ = call-property js-global["crypto"], "getRandomValues", xs
		xs[0].to::nat32
	else
		throw todo
+next nat64(_ secure-random) global
	do trusted
	if java
		getInstanceStrong::SecureRandom.reinterpret-cast::Random.nextLong.wrap-to
	elif js
		xs = call-new js-global["Uint32Array"], 2
		_ = call-property js-global["crypto"], "getRandomValues", xs
		bits-cat xs[0].to::nat32, xs[1].to
	else
		throw todo
