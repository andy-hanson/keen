no-std
import
	../number
	../range

+random interface mut
	next nat32()
	next nat64()

| Very simple and fast pseudorandom number generator.
+basic-prng record mut, random case
	-state mut nat64
+new basic-prng()
	state: 0xdecafc0ffeecafe
+basic-prng basic-prng()
	()
+new basic-prng(seed nat64)
	state: seed
+basic-prng basic-prng(seed nat64)
	state: seed
+next nat32(a basic-prng)
	wrap-to a.next::nat64
+next nat64(a basic-prng)
	# Uses the value from musl
	a.state := 0x5851f42d4c957f2d 'wrap-mul a.state 'wrap-add 1
	a.state

+next-in-range nat64(a random, range nat64 range)
	range.low + (a.next % range.size)
