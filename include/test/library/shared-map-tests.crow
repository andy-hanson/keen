use-prefix
import
	crow/col/shared-map
	crow/parallel

# TODO: can't this go in shared-map.crow? ----------------------------------------------------------------------------------
test
	guard !(trusted java) # TODO ------------------------------------------------------------------------------------------------
	guard !(trusted js) # TODO --------------------------------------------------------------------------------------------------
	res nat shared[nat] = ()
	for x in parallel 0::nat .. 100
		res[x] := x * 2
		()
	res.move-to::nat[nat] is for x in 0::nat .. 100
		x, x * 2
