import
	crow/parse

#TODO:MOVE
-to json(a parse-error)
	# TODO: include input/iter
	expected: a.expected to

-verify[t] void(a t, s string) (json, t) to
	j json = a to
	json parse s is j
	j.to-json is s

test
	try
		_ = json parse "potato"
		should-throw
	catch parse-error e
		e is ("potato", "potato".begin, "JSON value")
	()::null verify "null"
	true::bool verify "true"
	false::bool verify "false"
	-3.0::float64 verify "-3"
	1.5::float64 verify "1.5"
	-1.5::float64 verify "-1.5"
	"j"::string verify "\"j\""
	"a\nb"::string verify "\"a\\nb\""
	"a\\nb"::string verify "\"a\\\\nb\""

	()::json[] verify "[]"
	(1,)::json[] verify "[1]"
	(1, true)::json[] verify "[1,true]"

	()::json[symbol] verify "\{}"
	(("a", 1),)::json[symbol] verify "\{\"a\":1}"
	(("a", 1), ("x\ny", true))::json[symbol] verify "\{\"a\":1,\"x\\ny\":true}" # TODO: LHS could use a named-new expression

test
	j json =
		a: 1::float64 to # TODO: should not need type annotation --------------------------------------------------
	j["a"] is 1::float64.to
	j["b"] is null
