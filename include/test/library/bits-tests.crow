import
	crow/bits

test
	"{to-hex 0x0d15ea5e0d15ea5e::nat64 & ~7}"::string is "d15ea5e0d15ea58"

test
	0.count-ones is 0
	1.count-ones is 1
	0b100000.count-ones is 1
	0b10101.count-ones is 3

test
	0xdeadbeefcafebabe::nat64 >> 32 is 0xdeadbeef
	0xdeadbeef::nat32 >> 16 is 0xdead
	0xdead::nat16 >> 8 is 0xde
	0xde::nat8 >> 4 is 0xd

test
	0::nat32.high-n-bits is 0
	31::nat32.high-n-bits is 0b11111111_11111111_11111111_11111110
	32::nat32.high-n-bits is 0b11111111_11111111_11111111_11111111
	try
		_ nat32 = high-n-bits 33
		should-throw
	catch as unary-out-of-range
		()
test
	0::nat64.high-n-bits is 0
	1::nat64.high-n-bits is 0b10000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000
	13::nat64.high-n-bits is 0b11111111_11111000_00000000_00000000_00000000_00000000_00000000_00000000
	63::nat64.high-n-bits is 0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111110
	64::nat64.high-n-bits is 0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111

test
	0::nat32.low-n-bits is 0
	1::nat32.low-n-bits is 1
	31::nat32.low-n-bits is 0b01111111_11111111_11111111_11111111
	32::nat32.low-n-bits is 0b11111111_11111111_11111111_11111111
	try
		_ nat32 = low-n-bits 33
		should-throw
	catch as unary-out-of-range
		()
test
	0::nat64.low-n-bits is 0
	1::nat64.low-n-bits is 1
	13::nat64.low-n-bits is 0b11111_11111111
	63::nat64.low-n-bits is 0b01111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111
	64::nat64.low-n-bits is 0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111

test
	0.log-2-rounded-down is 0
	1.log-2-rounded-down is 0
	2.log-2-rounded-down is 1
	3.log-2-rounded-down is 1
	4.log-2-rounded-down is 2
	7.log-2-rounded-down is 2
	8.log-2-rounded-down is 3
	15.log-2-rounded-down is 3
	16.log-2-rounded-down is 4
	0x8fffffffffffffff.log-2-rounded-down is 63
	0xffffffffffffffff.log-2-rounded-down is 63

test
	0.round-up-to-power-of-two is 1
	1.round-up-to-power-of-two is 1
	2.round-up-to-power-of-two is 2
	3.round-up-to-power-of-two is 4
	4.round-up-to-power-of-two is 4
	5.round-up-to-power-of-two is 8
	8.round-up-to-power-of-two is 8
	9.round-up-to-power-of-two is 16
	16.round-up-to-power-of-two is 16
	17.round-up-to-power-of-two is 32
	0x8000000000000000.round-up-to-power-of-two is 0x8000000000000000
	try
		_ = round-up-to-power-of-two 0x8000000000000001
		should-throw
	catch as unary-out-of-range
		()

test
	0.round-up-to-power-of-two is 1
	1.round-up-to-power-of-two is 1
	2.round-up-to-power-of-two is 2
	3.round-up-to-power-of-two is 4
	4.round-up-to-power-of-two is 4
	5.round-up-to-power-of-two is 8
	8.round-up-to-power-of-two is 8
	9.round-up-to-power-of-two is 16
	16.round-up-to-power-of-two is 16
	17.round-up-to-power-of-two is 32
	0x7fffffffffffffff.round-up-to-power-of-two is 0x8000000000000000
	try
		_ = round-up-to-power-of-two 0xffffffffffffffff
		should-throw
	catch as unary-out-of-range
		()

test
	a nat16 = 0xcafe
	b nat16 = 0xbabe
	((a.to << 16) | b.to)::nat32 is 0xcafebabe
