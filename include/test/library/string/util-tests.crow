use-prefix
import
	crow/string/util

test
	pad-left "a", 3, "0" is "00a"
	pad-right "b", 3, "x" is "bxx"

test
	"a\nb".lines is ("a", "b")
	"a\r\nb".lines is ("a", "b")

test
	"$¥₿𝄮"::string.reverse::string is "𝄮₿¥$"

-reverse string(a string)
	with out in build
		_ = iterate-reverse a, of x
			out ~= x
			false
