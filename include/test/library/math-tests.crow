import
	crow/math/math
	crow/parse

test
	test-t@float32
	test-t@float64

-to float64(a string)
	parse float, a
-to float32(a string)
	a.to::float64.to

-big-negative float32()
	-22877332
-big-negative float64()
	-286411383293069

-floatish[t] spec t compare
	- t(a t)

	+ t(a t, b t)
	- t(a t, b t)
	* t(a t, b t)
	/ t(a t, b t)

	big-negative t()
	pi t()
	pi_2 t()
	pi_4 t()

	abs t(a t)
	acos t(a t)
	acosh t(a t)
	asin t(a t)
	asinh t(a t)
	atan t(a t)
	atan2 t(y t, x t)
	atanh t(a t)
	cos t(a t)
	cosh t(a t)
	sin t(a t)
	sinh t(a t)
	tan t(a t)
	tanh t(a t)
	square-root t(a t)
	to t(a string)
	show string(a t)
	to json(a t)

-test-t[t] void() t floatish
	zero t = "0".to
	one t = "1".to
	two t = "2".to
	three t = "3".to
	one + two is three

	square-root 4::float64 is 2
	try
		_ float64 = square-root -1
		should-throw
	catch x as float-out-of-range
		x.input is -1

	acos -one 'is-about pi
	acos zero 'is-about pi_2
	acos one is zero

	asin -one 'is-about -pi_2
	asin zero is zero
	asin one 'is-about pi_2

	atan -one 'is-about -pi_4
	atan zero is zero
	atan one 'is-about pi_4

	cos zero is one
	cos pi_4::t 'is-about two.square-root / two
	cos pi_2::t 'is-about -zero
	cos pi::t is -one

	sin zero is zero
	sin pi_4::t 'is-about two.square-root / two
	sin pi_2::t is one
	sin pi::t 'is-about -zero

	tan zero is zero
	tan pi_4::t 'is-about one
	assert pi_2::t.tan <= big-negative
	tan three * pi_4 'is-about -one
	tan pi::t 'is-about zero

	atan2 one, one 'is-about pi_4
	atan2 one, zero 'is-about pi_2
	atan2 zero, -one 'is-about pi

	cosh zero is one
	one-cosh t = cosh one
	one-cosh 'is-about "1.543".to
	acosh one is zero
	acosh one-cosh 'is-about one

	sinh zero is zero
	asinh zero is zero
	sinh-one = sinh one
	sinh-one 'is-about "1.175".to
	asinh sinh-one 'is-about one

	tanh zero is zero
	atanh zero is zero
	one-tanh = tanh one
	one-tanh 'is-about "0.761".to
	atanh one-tanh 'is-about one

# TODO: these tests should use exact answers, but the compiler needs better float parsing
-is-about[t] void(a t, b t) t floatish
	diff = a - b
	assert diff.abs < "0.0006".to else error "Expected {a} is-about {b}"
