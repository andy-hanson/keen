import
	crow/math/math

test
	test-t@float32
	test-t@float64

-big-negative float32()
	-22877332
-big-negative float64()
	-286411383293069

-floatish[t] spec t compare
	- t(a t)

	+ t(a t, b t)
	- t(a t, b t)
	* t(a t, b t)
	/ t(a t, b t)

	big-negative t()
	pi t()
	pi_2 t()
	pi_4 t()

	abs t(a t)
	acos t(a t)
	acosh t(a t)
	asin t(a t)
	asinh t(a t)
	atan t(a t)
	atan2 t(y t, x t)
	atanh t(a t)
	cos t(a t)
	cosh t(a t)
	sin t(a t)
	sinh t(a t)
	tan t(a t)
	tanh t(a t)
	square-root t(a t)
	show string(a t)
	to json(a t)
	from64 t(a float)
	to64 float(a t)

-from64 float32(a float)
	a.to
-from64 float(a float)
	a
-to64 float(a float32)
	a.to
-to64 float(a float)
	a

-test-t[t] void() t floatish
	neg-one t = from64 -1
	zero t = from64 0
	one t = from64 1
	two t = from64 2
	three t = from64 3
	one + two is three

	square-root 4::float64 is 2
	throws-out-of-range neg-one, it.square-root

	acos -one 'is-about pi
	acos zero 'is-about pi_2
	acos one is zero

	asin -one 'is-about -pi_2
	asin zero is zero
	asin one 'is-about pi_2

	atan -one 'is-about -pi_4
	atan zero is zero
	atan one 'is-about pi_4

	cos zero is one
	cos pi_4::t 'is-about two.square-root / two
	cos pi_2::t 'is-about -zero
	cos pi::t is -one
	throws-out-of-range -infinity, it.cos
	throws-out-of-range infinity, it.cos

	sin zero is zero
	sin pi_4::t 'is-about two.square-root / two
	sin pi_2::t is one
	sin pi::t 'is-about -zero
	throws-out-of-range -infinity, it.sin
	throws-out-of-range infinity, it.sin

	tan zero is zero
	tan pi_4::t 'is-about one
	assert pi_2::t.tan <= big-negative
	tan three * pi_4 'is-about -one
	tan pi::t 'is-about zero
	throws-out-of-range -infinity, it.tan
	throws-out-of-range infinity, it.tan

	atan2 one, one 'is-about pi_4
	atan2 one, zero 'is-about pi_2
	atan2 zero, -one 'is-about pi

	cosh zero is one
	one-cosh t = cosh one
	one-cosh 'is-about from64 1.543
	acosh one is zero
	acosh one-cosh 'is-about one
	throws-out-of-range 0.99.from64::t, it.acosh

	sinh zero is zero
	asinh zero is zero
	sinh-one = sinh one
	sinh-one 'is-about from64 1.175
	asinh sinh-one 'is-about one

	tanh zero is zero
	atanh zero is zero
	one-tanh = tanh one
	one-tanh 'is-about from64 0.761
	atanh one-tanh 'is-about one
	throws-out-of-range -1.01.from64::t, it.atanh
	throws-out-of-range 1.01.from64::t, it.atanh

-throws-out-of-range[t] void(input t, f t mut(x t)) t floatish
	try
		_ = f[input]
		should-throw
	catch x as float-out-of-range
		x.input is input.to64

# TODO: these tests should use exact answers, but the compiler needs better float parsing
-is-about[t] void(a t, b t) t floatish
	diff = a - b
	assert diff.abs < 0.0006.from64 else error "Expected {a} is-about {b}"
