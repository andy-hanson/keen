import
	crow/private/number-low-level: wrap-add

dummy-number-tests nat64()
	0

test
	a nat32 = 0xffffffff
	a wrap-add 2 is 1

test
	1::int64 + 1 is 2
	(() => max-value::int64 + 1) throws-out-of-range
	(() => min-value::int64 + -1) throws-out-of-range
	(() => min-value::int64 + min-value) throws-out-of-range

-throws-out-of-range[t] void(f t mut())
	try
		_ = f[]
		should-throw
	catch binary-out-of-range _
		()
test
	1::int64 - 2 is -1
	(() => max-value::int64 - -1) throws-out-of-range
	(() => min-value::int64 - 1) throws-out-of-range
	min-value::int64 - min-value is 0

test
	# TODO: should not need parens
	(max-value::int64) * 0 is 0
	(-1::int64) * -1 is 1
	(() => max-value::int64 / 3 * 4) throws-out-of-range
	(() => (4::int64) * (max-value / 3)) throws-out-of-range
	(() => (min-value::int64) * -1) throws-out-of-range
	(() => (-1::int64) * min-value) throws-out-of-range
test
	(3::nat32) * 5 is 15
	(() => (max-value::nat32) * 2) throws-out-of-range

test
	-1.5.to::int64 is -2
	-1.49.to::int64 is -1
	1.49.to::int64 is 1
	1.5.to::int64 is 2

	4.1.to::nat64 is 4
	4.5.to::nat64 is 5
	5.5.to::nat64 is 6

test
	"{0x0d15ea5e0d15ea5e::nat64 & ~7 to-hex}"::string is "d15ea5e0d15ea58"

test
	1.499999::float64.round is 1
	1.5::float64.round is 2
test
	1.999::float64.round-down is 1
	2::float64.round-down is 2
test
	1::float64.round-up is 1
	1.001::float64.round-up is 2

test
	(4::float64) ** 0.5 is 2
	(-2::float64) ** -3 is -0.125
	(-2::float64) ** 2 is 4
	try
		_ = (-2::float64) ** 2.001
		should-throw
	catch power-of-negative-number _
		()

test
	f64 float64 = 1.23
	f64.bits-of is 4608218246714312622
	f32 float32 = 1.23
	f32.bits-of is 1067282596
	1067282596.from-bits::float32 is 1.23
	4608218246714312622.from-bits::float64 is 1.23

test
	5.4::float64 % 2.2 is 1
	-3.5::float64 % 4 is 0.5
	try
		_ = 5.4::float64 % -2.2
		should-throw
	catch modulo-of-negative _
		()
