test
	xs nat[] = 3, 1, 2
	xs.min-and-max is (1, 3)
	xs.min is 1
	xs.max is 3
	()::nat[].min is ()

test
	xs nat[] = 53, 61, 72
	xs min-and-max-by it % 10 is
		elems: (61, 53)
		keys: (1, 3)

-to[t] json(a t min-and-max) (json, t) to
-to[elem, key] json(a (elem, key) min-and-max-by) (json, elem) to, (json, key) to

test
	xs nat[] = 1, 2, 3
	r0 nat[]? = xs map-every it + 1
	r0 is (2, 3, 4)
	r1 nat[]? = xs map-every of x
		x < 3 and x + 3
	r1 is ()
	r2 nat[]? = ()::nat[] map-every of _
		throw unreachable
	r2 is ()::nat[]
