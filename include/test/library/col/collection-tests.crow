test
	xs nat[] = 3, 1, 2
	xs.min-and-max is (1, 3)
	xs.min is 1
	xs.max is 3
	()::nat[].min is ()

test
	xs nat[] = 53, 61, 72
	min-and-max-by xs, it % 10 is
		elems: 61, 53
		keys: 1, 3

-to[t] json(a t min-and-max) (json, t) to
-to[elem, key] json(a (elem, key) min-and-max-by) (json, elem) to, (json, key) to

test
	xs nat[] = 1, 2, 3
	r0 nat[]? = map-every xs, it + 1
	r0 is (2, 3, 4)
	r1 nat[]? = map-every xs, of x
		if x < 3 then x + 3
	r1 is ()
	r2 nat[]? = map-every ()::nat[], of _
		throw unreachable
	r2 is ()::nat[]

test
	xs nat[] = 1, 2, 3, 4, 5
	count xs, it.is-even is 2
	sum xs is 15
	sum xs, it * it is 55
