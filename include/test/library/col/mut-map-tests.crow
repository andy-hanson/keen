import
	../../../keen/col/mut-map: debug, debug-costs
	keen/string/util

test
	trusted
	a string mut[nat64] = ()

	a[6] := "6"
	a[5] is ()
	a[6] is "6"
	a.size is 1
	a.to::(nat64, string)[] is ((6, "6"),)

	a.debug is ((), (6, "6"))

	a[6] := "six"
	a.debug is ((), (6, "six"))

	a[3] := "3"
	a.debug is ((3, "3"), (6, "six"))

	a[4] := "4"
	a.debug is ((), (6, "six"), (3, "3"), (4, "4"))

	a[8] := "8"
	a.debug is ((8, "8"), (6, "six"), (3, "3"), (4, "4"))

	a[4] is "4"
	a[8] is "8"
	a[5] is ()

	a.to::(nat64, string)[].sort is ((3, "3"), (4, "4"), (6, "six"), (8, "8"))

	a[12] := "12"
	a.debug is ((), (6, "six"), (3, "3"), (4, "4"), (12, "12"), (), (), (8, "8"))

	remove a, 5 is ()
	remove a, 4 is "4"

	a.debug is ((), (6, "six"), (3, "3"), (12, "12"), (), (), (), (8, "8"))

	a[11] := "11"
	a.debug is ((), (6, "six"), (3, "3"), (11, "11"), (12, "12"), (), (), (8, "8"))
	a.debug-costs is (0, 0, 0, 1, 1, 0, 0, 0)

	a filter= of key, value
		key > 10 or value == "six"
	a.debug is ((), (6, "six"), (11, "11"), (12, "12"), (), (), (), ())

	a map-values= of key, value
		"{key}-{value}"
	a.debug is ((), (6, "6-six"), (11, "11-11"), (12, "12-12"), (), (), (), ())

test
	trusted
	a string mut[nat64] = (1, "1"), (2, "2"), (5, "5")
	a.debug is ((1, "1"), (2, "2"), (5, "5"))

	b = copy a
	b.debug is ((1, "1"), (2, "2"), (5, "5"))

	a[6] := "6"
	a.debug is ((1, "1"), (2, "2"), (), (), (5, "5"), (6, "6"))
	b.debug is ((1, "1"), (2, "2"), (5, "5"))

test
	a string mut[nat64] = (1, "one"),
	b string mut[nat64] = ()
	swap a, b
	a.to::string[nat64] is ()
	b.to::string[nat64] is ((1, "one"),)

test
	a string mut[nat64] = (1, "one"),
	remove a, 2 is ()
	a.size is 1
	remove a, 1 is "one"
	a.size is 0
	remove a, 1 is ()

test
	a string mut[nat64] = ()
	ensure a, 1, (of then "one") is "one"
	ensure a, 1, (of then "two") is "one"
	try
		_ = ensure a, 2, of
			a[3] := "three"
			"two"
		should-throw
	catch as was-locked
		a.size is 1
	a[2] is ()
	ensure a, 2, (of then "two") is "two"

test
	a string mut[nat64] = (0, "zero"), (1, "one"), (2, "two")
	a map-values= of _, value
		try
			a[3] := "three"
			should-throw
		catch as was-locked
			()
		upper-case value
	a.to::string[nat64] is
		- 0, "ZERO"
		- 1, "ONE"
		- 2, "TWO"

test
	trusted
	a string mut[nat64] = (0, "zero"), (1, "one"), (2, "two")
	a filter= of key, _
		try
			a[3] := "three"
			should-throw
		catch as was-locked
			()
		is-even key
	a.debug is ((0, "zero"), (2, "two"), ())
	a.to::string[nat64] is ((0, "zero"), (2, "two"))

test
	a string mut[nat64] = (0, "zero"), (1, "one")
	calls (nat64, string) mut[] = ()
	for pair in a
		try
			_ = remove a, 0
			should-throw
		catch as was-locked
			()
		calls ~= pair
	calls.move-to::(nat64, string)[].sort is ((0, "zero"), (1, "one"))
