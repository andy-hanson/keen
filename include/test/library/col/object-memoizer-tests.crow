import	
	../../../crow/col/experimental/object-memoizer

-my-memoizable-record record(x nat, y nat) by-ref
-hash-content nat(a my-memoizable-record)
	# Use a deliberately bad hash code to make this predictable
	a x
-content-equals bool(a my-memoizable-record, b my-memoizable-record)
	a.x == b.x && a.y == b.y
-copy my-memoizable-record(a my-memoizable-record)
	a.x, a.y

test trusted
	guard !(extern js) # TODO: support weak-ref in JS -----------------------------------------------------------------------------------
	a my-memoizable-record object-memoizer = ()
	x0 = a assert-insert (0, 0)
	assert (a assert-get-existing (0, 0)) reference-equal x0
	x1 = a assert-insert (1, 1)
	assert (a assert-get-existing (1, 1)) reference-equal x1
	x2 = a assert-insert (2, 2)
	assert a[0, 0] reference-equal x0
	assert a[1, 1] reference-equal x1
	assert a[2, 2] reference-equal x2
	x0.x is 0
	x1.x is 1
	x2.x is 2

	x01 = a assert-insert (0, 1)
	assert (a assert-get-existing (0, 0)) reference-equal x0
	assert (a assert-get-existing (0, 1)) reference-equal x01
	x01.x is 0
	x01.y is 1

-assert-insert my-memoizable-record(a my-memoizable-record object-memoizer, value my-memoizable-record) trusted
	value-copy = value copy
	res = a get-and-did-add value-copy
	assert res did-add
	assert res.value reference-equal value-copy
	assert res.value content-equals value-copy
	res value

-assert-get-existing my-memoizable-record(a my-memoizable-record object-memoizer, value my-memoizable-record) trusted
	# Ensure this is not a constant (since then it would reference-equal the previous value)
	value-copy = value copy
	res = a get-and-did-add value-copy
	forbid res did-add
	forbid res.value reference-equal value-copy
	assert res.value content-equals value-copy
	res value
