import	
	crow/unsafe
	../../../crow/col/experimental/object-memoizer

-my-memoizable-record record(memoizer-key nat, y nat)
-hash nat64(a nat64)
	a

test
	guard !(trusted extern js) # TODO: support weak-ref in JS -----------------------------------------------------------------------------------
	a (my-memoizable-record, nat) object-memoizer = ()
	x0 = a assert-insert (0, 0)
	a assert-get-existing x0
	x1 = a assert-insert (1, 1)
	a assert-get-existing x1
	x2 = a assert-insert (2, 2)
	a assert-get-existing x2

-assert-insert my-memoizable-record(a (my-memoizable-record, nat) object-memoizer, value my-memoizable-record)
	trusted
	called mut = false
	res = a memoize value.memoizer-key, () =>
		called := true
		value
	assert called
	assert res reference-equal value
	res

-assert-get-existing void(a (my-memoizable-record, nat) object-memoizer, value my-memoizable-record)
	trusted
	res = a memoize value.memoizer-key, () => throw unreachable
	assert res reference-equal value
