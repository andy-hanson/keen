import
	../../../keen/col/map: dbg

-verify void(a string[nat64], expected string)
	a.dbg is expected

test
	l0 string[nat64] = ()
	l0.is-empty is true
	l0.size is 0
	verify l0, "[]"
	l0[0] is ()

	l1 = l0 ~ (5, "5")
	l1.is-empty is false
	l1.size is 1
	verify l1, "[5 -> 5]"

	l2 = l1 ~~ ((1, "1"), (3, "3"), (9, "9"))
	verify l2, "[5 -> 5, 1 -> 1, 3 -> 3, 9 -> 9]"

	l3 = l2 ~ (13, "13")
	verify l3, "[5 -> 5, 1 -> 1, 3 -> 3, 9 -> 9, 13 -> 13]"
