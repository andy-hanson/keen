test
	a nat8 mut[] = 1, 2, 3, 4, 5
	pop-n-left a, 2 is (1, 2)
	a.to::nat8[] is (3, 4, 5)
	pop-n a, 2 is (4, 5)
	a.to::nat8[] is (3,)
	a prepend= 2
	a.to::nat8[] is (2, 3)
	insert-at a, 1, 5
	a.to::nat8[] is (2, 5, 3)
	remove-at a, 1 is 5
	a.to::nat8[] is (2, 3)

test
	a nat8 mut[] = 1, 2
	b nat8 mut[] = 3,
	swap a, b
	a.to::nat8[] is (3,)
	b.to::nat8[] is (1, 2)

test
	xs nat mut[] = 1, 2, 3
	xs map= of x
		xs ~= 42
		x * 10
	xs.to::nat[] is (10, 20, 30)

test
	xs nat mut[] = 0, 1, 2, 3
	xs filter= of x
		xs ~= 42
		is-even x
	xs.to::nat[] is (0, 2)
