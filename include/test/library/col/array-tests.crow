import
	crow/unsafe

test
	xs nat[] = ()
	try
		_ nat = xs[0]
		should-throw
	catch x as index-too-big
		x.actual is 0
		x.maximum is 0

test
	xs nat[] = 1, 2, 3
	try
		_ nat = xs[4]
		should-throw
	catch x as index-too-big
		x.actual is 4
		x.maximum is 3

test
	(for _ in ((), ())::void[] then 1)::nat[] is (1, 1)

test
	(for i, _ in ((), ())::void[] with-index then i)::nat[] is (0, 1)

test
	side-effects nat mut[] = ()
	foo void[] = for x in (1, 2)::nat[]
		side-effects ~= x
	foo is ((), ())
	side-effects.move-to::nat[] is (1, 2)

test
	count mut nat = 0
	foo void[] = for in ((), ())::void[]
		count +:= 1
	foo is ((), ())
	count is 2

test
	a void[] = with out in build
		out ~= ()
		out.size is 1
		out ~~= ((), ())::void[]
		out.size is 3
	a.size is 3

test
	xs nat[] = for x in 1::nat .. 1
		x
	ys nat[] = for x in xs
		x + 1
	xs is ()
	ys is ()
	trusted if extern java
		# For performance, the bytecode uses a constant empty array for array-op-concrete-expr
		assert xs reference-equal ys
