dummy-array-tests nat64()
	0

test
	res nat[] = for _ : ((), ())::void[]
		1
	res is (1, 1)

test
	res nat[] = for i, _ : ((), ())::void[] with-index
		i
	res is (0, 1)

test
	side-effects nat mut[] = ()
	foo void[] = for x : (1, 2)::nat[]
		side-effects ~= x
	foo is ((), ())
	side-effects.move-to::nat[] is (1, 2)

test
	count mut nat = 0
	foo void[] = for : ((), ())::void[]
		count +:= 1
	foo is ((), ())
	count is 2

test
	a void[] = with out : build
		out ~= ()
		out.size is 1
		out ~~= ((), ())::void[]
		out.size is 3
	a.size is 3

test
	xs nat[] = for x : 1::nat .. 1
		x
	ys nat[] = for x : xs
		x + 1
	xs is ()
	ys is ()
	trusted if extern java
		# For performance, the bytecode uses a constant empty array for array-op-concrete-expr
		assert xs reference-equal ys
