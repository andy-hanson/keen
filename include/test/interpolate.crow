test
	res html[] = "foo"
	res is ("foo",)
	res.render is "foo"
test
	text string = "1 < 2"
	res html[] = "Line 1{br}{text}"
	res is
		- "Line 1"
		- br
		- ""
		- "1 < 2"
		- ""
	res.render is "Line 1<br />1 &lt; 2"

html union(node, string)
== bool(a html, b html)
to json(a html)
node record(tag string)
== bool(a node, b node)
to json(a node)
br node()
	"br",
render string(a html)
	match a
	as node x
		"<{x tag} />"
	as string s
		s replace-all "<", "&lt;"
render string(a html[])
	"" join for x in a then x render

interpolate html[](...parts html[])
	parts
interpolate-string html(a string)
	a
interpolate-value node(a node)
	a
