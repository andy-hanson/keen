use-prefix
test
	xs nat mut[] = ()
	a nat mut[]? = xs
	a else () foo= 3
	xs.move-to::nat[] is (3,)

	(true or false and false)::bool is true # TODO: should not need a type annotation
	((true or false) and false) is false

	(false and false or true) is true
	(false and (false or true)) is false

-foo= void(a nat mut[], b nat)
	a ~= b

test
	(1::nat64) * 2 + 3 is 5
	1::nat64 + 2 * 3 is 7
