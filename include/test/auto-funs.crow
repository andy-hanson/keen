-r record
	x nat
	y string
	z bool
-== bool(a r, b r)
-<=> comparison(a r, b r)
-to json(a r)

test
	r0 r = 1, "two", true
	r1 r = 1, "two", false
	r0 is r0
	forbid r0 == r1
	r0 <=> r0 is equal
	r0 <=> r1 is greater
	r1 <=> r0 is less
	r0.to::json is
		x: 1
		y: "two"
		z: true

-u2 union(nat, string)
-== bool(a u2, b u2)
-<=> comparison(a u2, b u2)
-to json(a u2)

test
	u0 u2 = 1
	u1 u2 = "two"
	u0 is u0
	forbid u0 == u1
	u0 <=> u0 is equal
	u0 <=> 0 is greater
	u0 <=> 2 is less
	u0 <=> u1 is less
	u1 <=> u0 is greater
	u1 <=> "twn" is greater
	u1 <=> "twp" is less
	u0.to::json is
		nat64: 1
	u1.to::json is
		string: "two"

# Test a union with 4 members to test full complexity of the implementation for <= 4 members (see 'concretize-compare-union')
-u4 union(void, bool, nat, string)
-== bool(a u4, b u4)
-<=> comparison(a u4, b u4)
-to json(a u4)
test
	u1 u4 = true
	u2 u4 = 1
	u3 u4 = "foo"
	u2 is u2
	forbid u2 == u1
	forbid u2 == 2
	u2 <=> u2 is equal
	u2 <=> u1 is greater
	u2 <=> u3 is less
	u2 <=> 0 is greater
	u2 <=> 2 is less

# Test a union with 5 members since these use a different implementation (see 'concretize-compare-union')
-u5 union(void, bool, nat, string, symbol)
-== bool(a u5, b u5)
-<=> comparison(a u5, b u5)
-to json(a u5)
test
	u1 u5 = true
	u2 u5 = 1
	u3 u5 = "foo"::string
	u2 is u2
	forbid u2 == u1
	forbid u2 == 2
	u2 <=> u2 is equal
	u2 <=> u1 is greater
	u2 <=> u3 is less
	u2 <=> 0 is greater
	u2 <=> 2 is less
