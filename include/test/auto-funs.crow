dummy-auto-funs nat()
	0

-r record
	x nat
	y string
	z bool
-== bool(a r, b r)
-<=> comparison(a r, b r)
-to json(a r)

test
	r0 r = 1, "two", true
	r1 r = 1, "two", false
	r0 is r0
	forbid r0 == r1
	r0 <=> r0 is equal
	r0 <=> r1 is greater
	r1 <=> r0 is less
	r0.to::json is (("x", 1::nat.to), ("y", "two"::string.to), ("z", true.to))

-u union(nat, string)
-== bool(a u, b u)
-<=> comparison(a u, b u)
-to json(a u)

test
	u0 u = 1 to
	u1 u = "two" to
	u0 is u0
	forbid u0 == u1
	u0 <=> u0 is equal
	u0 <=> 0.to is greater
	u0 <=> 2.to is less
	u0 <=> u1 is less
	u1 <=> u0 is greater
	u1 <=> "twn".to is greater
	u1 <=> "twp".to is less
	u0.to::json is (("nat64", 1::nat.to),)
	u1.to::json is (("string", "two"::string.to),)
