import
	crow/parallel

test native extern
	logs logged mut[] = ()
	with in (shared log => logs ~= log) temp-log-handler
		info log "test"
		# Also works in fibers derived from this one
		fut void future = with in parallel
			warn log "test2"
		fut await
		error log "test3"
	logs.to::logged[] is ((info, "test"), (warn, "test2"), (error, "test3"))

-== bool(a logged, b logged)
-== bool(a log-level, b log-level)
-to json(a logged)
-to json(a log-level)
	a.to::symbol to
-to symbol(a log-level)
