import
	crow/parallel

test
	do if false # TODO ------------------------------------------------------------------------------------------------------------------------------
	logs logged mut[] = ()
	with in temp-log-handler shared of log then logs ~= log
		log info, "test"
		# Also works in fibers derived from this one
		fut void future = with in parallel
			log warn, "test2"
		await fut
		log error, "test3"
	logs.to::logged[] is ((info, "test"), (warn, "test2"), (error, "test3"))

-== bool(a logged, b logged)
-== bool(a log-level, b log-level)
-to json(a logged)
-to json(a log-level)
	a.to::symbol.to
-to symbol(a log-level)
