import
	crow/parallel

# Unlike 'finally' and 'try' with a block, 'try =' should work in a loop.
test
	n mut nat = 4
	results nat mut[] = ()
	loop
		try res nat = 12 / n catch divide-by-0 then break
		results ~= res
		n -:= 1
		continue
	n is 0
	results.to::nat[] is (3, 4, 6, 12)

test
	n nat? =
		try x nat = 1 / 0 catch divide-by-0
		x + 1
	n is ()

test
	try
		finally throw "thrown second" error
		throw "thrown first" error
	catch error e
		e.show is "thrown second"

# Test that yielding the fiber does not break exception handling
test
	guard trusted extern js # TODO -------------------------------------------------------------------------------------------------------
	xs nat mut[] = ()
	try
		xs ~= 1
		yield-fiber
		xs ~= 2
		xs ~= 3 / 0
	catch divide-by-0
		xs ~= 4
	xs.to::nat[] is (1, 2, 4)

test
	(of then 3).foo is 4
	(of then 0).foo is 0
	(of then throw "Testing" error).foo is 99

-foo nat(f nat mut())
	try
		12 / f[]
	catch divide-by-0
		0
	catch else x
		x.show is "Testing"
		99
