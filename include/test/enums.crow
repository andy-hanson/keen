use-prefix
test
	x.to::symbol is "x"
	y.to::symbol is "y"
	"x".to::e? is x
	"z".to::e? is ()

	x.to::nat32 is 0
	y.to::nat32 is 1

	0.to::e? is x
	1.to::e? is y
	2.to::e? is ()

	x == x is true
	x == y is false

	x <=> x is equal
	x <=> y is less
	y <=> x is greater
	y <=> y is equal

	members is (x, y)

-e enum(x, y)
-== bool(a e, b e)
-<=> comparison(a e, b e)
-to json(a e)
-to nat32(a e)
-to e?(a nat32)
-to symbol(a e)
-to e?(a symbol)
-members e[]()
