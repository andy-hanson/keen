dummy-flags nat()
	0

test
	none f = ()
	none.to::nat32 is 0
	x.to::nat32 is 1
	y.to::nat32 is 0b10
	z.to::nat32 is 0b100
	xy = x | y
	xy.to::nat32 is 0b11
	xz = x | z
	xz.to::nat32 is 0b101
	yz = y | z
	yz.to::nat32 is 0b110
	all = x | y | z
	all.to::nat32 is 0b111

	x <=> x is equal
	x <=> y is less
	y <=> x is greater
	y <=> y is equal
	xy <=> y is greater
	xy <=> z is less

	none | none is none
	x | x is x
	xy | yz is all
	all | x is all

	x & yz is none
	x & all is x
	xy & yz is y

	assert x in x
	assert x in xz
	forbid y in xz

	members::f[] is (x, y, z)

	none.to::symbol[] is ()
	x.to::symbol[] is ("x",)
	xy.to::symbol[] is ("x", "y")
	all.to::symbol[] is ("x", "y", "z")

	"x".to::f? is (x,)
	"w".to::f? is ()

	none.to::json is ()::json[].to
	x.to::json is ("x"::string.to,).array
	xy.to::json is ("x"::string.to, "y"::string.to).array

	~none is all
	~x is yz
	~y is xz
	~z is xy
	~xy is z
	~xz is y
	~yz is x
	~all is none

	none.to::symbol[] is ()
	x.to::symbol[] is ("x",)
	xy.to::symbol[] is ("x", "y")

-f flags(x, y, z)
-== bool(a f, b f)
-<=> comparison(a f, b f)
-to nat32(a f)
-to symbol[](a f)
-to f?(a symbol)
-to json(a f)
-members f[]()
