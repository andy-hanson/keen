test
	calls symbol mut[] = ()
	one = of x symbol
		calls ~= x
		1::nat
	optional-one = of x symbol then one[x]:: nat?
	none = of x symbol
		calls ~= x
		()::nat?
	get-calls = of
		calls.move-to::symbol[]

	?add one["a"], optional-one["b"], one["c"] is 3
	get-calls[] is ("a", "b", "c")
	?add one["a"], none["b"], one["b"] is ()
	get-calls[] is ("a", "b")
	?add optional-one["a"], one["b"], optional-one["c"] is 3
	get-calls[] is ("a", "b", "c")

-add nat(a nat, b nat, c nat)
	a + b + c
