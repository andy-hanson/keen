test
	r r = 1,
	i i = r
	i.m is "r"
	v v = r
	v.m is "r"
	# TODO: support parsing 'assert match ...' ----------------------------------------------------------------------------------
	b bool = match v
	as r _
		true
	else
		false
	assert b

test
	x nat = 1
	y nat?? = x
	y!! is 1

-i interface
	m string()
-v variant
	m string()
-r record(x nat) i case, v case
-m string(_ r)
	"r"

test
	r r = 1,
	i i = returns-r
	r takes-i
	xs r[] = r,
	_ i = xs takes-t-array
	_ i[] = r takes-t
	i takes-t-t r
	# TODO: r takes-t-t i ------------------------------------------------------------------------------------------------
-returns-r r()
	1,
-takes-i void(_ i)
	()
-takes-t-array[t] t(a t[])
	a[0]
-takes-t[t] t[](a t)
	a,
-takes-t-t[t] void(_ t, _ t)
	()
