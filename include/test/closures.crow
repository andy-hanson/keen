test
	x mut = 0
	f void mut() = of
		x +:= 1
	f[]
	x is 1

test
	x mut = 0
	f void mut() = of
		x +:= 1
	g void mut() = of
		x +:= 2
	f[]
	g[]
	x is 3

test
	x mut nat, y mut nat = 1, 2
	f void mut() = of
		x +:= 1
		y +:= 2
	f[]
	x is 2
	y is 4

test
	x mut foo = 0, 0
	get foo mut() = of
		x
	set void mut() = of
		x := 1, 1
	get[].x is 0
	set[]
	get[].x is 1
-foo record(x nat, y nat)
