test
	try
		assert 1::nat < 0
		should-throw
	catch x as error
		x.show is "Asserted expression is false: 1::nat < 0"
test
	try
		forbid 1::nat > 0
		should-throw
	catch x as error
		x.show is "Forbidden expression is true: 1::nat > 0"

test
	xs nat mut[] = 1,
	assert x = xs pop
	x is 1
	forbid y = xs pop else "popped {y}".error

test
	try
		xs nat mut[] = ()
		assert xs pop
		should-throw
	catch x as error
		x.show is "Asserted option is empty: xs pop"

test
	try
		xs nat mut[] = 1,
		forbid xs pop
		should-throw
	catch x as error
		x.show is "Forbidden option is non-empty: xs pop"
test
	try
		xs nat mut[] = 1,
		forbid x = xs pop else "popped {x}".error
		should-throw
	catch x as error
		x.show is "popped 1"

test
	xs nat mut[] = 1,
	n = if x = xs pop
		x
	else
		2
	n is 1
	m = if x = xs pop
		x
	else
		2
	m is 2

	y nat = unless xs pop
		3
	y is 3

test
	xs nat mut[] = 1,
	a nat =
		guard x = xs pop else 2
		x
	a is 1
	b nat =
		guard x = xs pop else 2
		x
	b is 2

test
	xs nat mut[] = 1, 2
	out nat mut[] = ()
	while x = xs pop
		out ~= x
	xs.to::nat[] is ()
	out.to::nat[] is (2, 1)

test
	xs nat mut[] = 1, 2
	until x = xs pop
		throw unreachable
	x is 2
	xs.to::nat[] is (1,)

-some nat?()
	1
-some2 nat?()
	2
-none nat?()
	()

main void()
	(if x = some and y = none then x + y) is 0
	(if x = some and y = some2 then x + y) is 3
	g nat = do
		guard x = some and y = none
		x + y
	g is 0
	g2 nat = do
		guard x = some and y = some2
		x + y
	g2 is 3
