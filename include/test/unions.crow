test
	m 1::u, 2 is 3
	m "abc"::u, 4 is 7
-u union(nat, string)
	m nat(x nat)
-m nat(a nat, x nat)
	a + x
-m nat(a string, x nat)
	a.size + x

test
	1::nat8.match-numbers is "nat8 1"
	2::nat16.match-numbers is "nat16 2"
# In JS, these are both represented as a 'number'
-u-numbers union(nat8, nat16)
-match-numbers string(a u-numbers)
	match a
	as nat8
		"nat8 {a}"
	as nat16
		"nat16 {a}"

test
	1::int64.match-big-ints is "int64 1"
	2::nat64.match-big-ints is "nat64 2"
# In JS, these are both represented as a 'bigint'
-u-big-ints union(int64, nat64)
-match-big-ints string(a u-big-ints)
	match a
	as int64
		"int64 {a}"
	as nat64
		"nat64 {a}"

# In JS, these are both represented as a 'function'
test
	(of then 1)::(nat mut()).match-funs is "mut 1"
	(of then 2)::(nat shared()).match-funs is "shared 2"
-u-funs union(nat mut(), nat shared()) mut
-match-funs string(a u-funs)
	match a
	as lambda-mut
		"mut {a[]}"
	as lambda-shared
		"shared {a[]}"

# In JS, these are both represented as an 'Array'
-match-arrays union(string[], string buffer) mut
-match-arrays string(a match-arrays)
	match a
	as array
		"array {a[0]}"
	as buffer
		"buffer {a[0]}"
test
	("a",)::string[].match-arrays is "array a"
	("b",)::(string buffer).match-arrays is "buffer b"

# In JS, these are both represented as a 'BigUint64Array'
-u-big-uint-arrays union(nat[], nat buffer) mut
-match-big-uint-arrays string(a u-big-uint-arrays)
	match a
	as array
		"array {a[0]}"
	as buffer
		"buffer {a[0]}"
test
	(1,)::nat[].match-big-uint-arrays is "array 1"
	(2,)::(nat buffer).match-big-uint-arrays is "buffer 2"
