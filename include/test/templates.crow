test
	f = 1::nat getter
	f[] is 1
-getter[k] k data()(k k) k data
	of then k

# Infer type arguments from explicit type of lambda
test
	a = () sum-by of x nat then x
	b = ("foo", "bar") sum-by of s symbol
		s.to::string size
	a is 0
	b is 6
-sum-by[t] nat(a t[], f nat mut(x t))
	res mut nat = 0
	for x in a
		res +:= f[x]
	res
