import
	crow/parallel

test
	trusted
	guard !java # TODO
	g := 33
	results nat[] = for _ in 0::nat .. 100 parallel
		# If 'foo' were thread-local, this would be uninitialized for some threads.
		g
	results is for _ in 1::nat64 .. 101 then 33
	results[99] is 33
-g global(nat64)

test summon
	trusted
	guard !java # TODO ----------------------------------------------------------------------------------------------------------
	guard !js # TODO: thread-local in JS needs to be on the async context -------------------------------------------------------
	results nat[] = for x in 0::nat64 .. 100 parallel
		tl := x
		tl +:= 1
		# This gives 'foo' time to change before returning,
		# which would cause the test to fail if 'foo' were global
		yield-fiber
		tl
	results is for x in 1::nat64 .. 101 then x
	results[99] is 100
-tl thread-local(nat64)

test
	trusted
	v is (1,)
-v global(r)
-r record(x nat)
-== bool(a r, b r)
-to json(a r)
-new r()
	1,
