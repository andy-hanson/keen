import
	../model/model
	../model/uri

# This is the 'request' to which main-fun is the response
main-kind union
	main-kind-main-function
	main-kind-tests-in-config
	main-kind-tests-at-uri
main-kind-main-function record
	uri uri
	| Does not include executable path
	program-args string[]
main-kind-tests-in-config record(all bool, config-uri uri)
main-kind-tests-at-uri record(all bool, crow-uri uri, line nat?)

main-uri-for-all-args uri(a main-kind) # TODO: Move to where it is used? ----------------------------------------------------------
	match a
	as main-kind-main-function x
		x uri
	as main-kind-tests-in-config x
		x config-uri
	as main-kind-tests-at-uri x
		x crow-uri

crow-config-base-name string()
	"crow-config.json"

max-spec-depth nat()
	8

file-type enum(crow, crow-config, other)
== bool(a file-type, b file-type)
file-type file-type(a uri)
	match a get-extension
	as ".crow"
		crow
	as ".json"
		a.base-name == crow-config-base-name ? crow-config : other
	else
		other
is-crow-config bool(a uri)
	a.file-type == crow-config

# TODO: MOVE somewhere else ------------------------------------------------------------------------------------------------------------
type-syntax-kind diag-type-should-use-syntax?(a symbol)
	match a
	as array
		array
	as fun-data
		fun-data
	as fun-mut
		fun-mut
	as fun-shared
		fun-shared
	as map
		map
	as mut-array
		mut-array
	as mut-map
		mut-map
	as option
		option
	as shared-array
		shared-array
	as shared-map
		shared-map
	as tuple2
		tuple
	as tuple3
		tuple
	as tuple4
		tuple
	as tuple5
		tuple
	as tuple6
		tuple
	as tuple7
		tuple
	as tuple8
		tuple
	as tuple9
		tuple
	else
		()
