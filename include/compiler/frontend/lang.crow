import
	../model/uri

# This is the 'request' to which main-fun is the response
main-kind union(main-kind-main-function, main-kind-tests-in-config, main-kind-tests-at-uri)
main-kind-main-function record
	uri uri
	| Does not include executable path
	program-args string[]
main-kind-tests-in-config record(all bool, config-uri uri)
main-kind-tests-at-uri record(all bool, crow-uri uri, line nat?)

main-uri-for-all-args uri(a main-kind) # TODO: Move to where it is used? ----------------------------------------------------------
	match a
	as main-kind-main-function x
		x uri
	as main-kind-tests-in-config x
		x config-uri
	as main-kind-tests-at-uri x
		x crow-uri

program-args string[](a main-kind)
	match a
	as main-kind-main-function x
		x program-args
	as main-kind-tests-in-config _
		()
	as main-kind-tests-at-uri _
		()

crow-config-base-name symbol()
	"crow-config.json"

jit-options record
	optimization optimization-level

c-version enum(c99, c11)

c-compile-options record
	optimization-level optimization-level
	c-version c-version

optimization-level enum(none, o2)

max-spec-depth nat()
	8

file-type enum(crow, crow-config, other)
== bool(a file-type, b file-type)
file-type file-type(a uri)
	match a get-extension
	as crow
		crow
	as json
		a.base-name == crow-config-base-name ? crow-config : other
	else
		other
