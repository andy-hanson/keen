import
	../model/model
	../model/uri

# This is the 'request' to which main-fun is the response
main-kind union
	main-kind-main-function
	main-kind-tests-in-config
	main-kind-tests-at-uri
main-kind-main-function record
	uri uri
	| Does not include executable path
	program-args string[]
main-kind-tests-in-config record(all bool, config-uri uri)
main-kind-tests-at-uri record(all bool, crow-uri uri, line nat?)
program-args string[](a main-kind)
	match a
	as main-kind-main-function then a.program-args
	as main-kind-tests-in-config then ()
	as main-kind-tests-at-uri then ()

crow-config-base-name string()
	"crow-config.json"

max-spec-depth nat()
	8

file-type enum(class_, crow, crowd, crow-config, other)
== bool(a file-type, b file-type)
to json(a file-type)
file-type file-type(a uri)
	match get-extension a
	as ".crow"
		crow
	as ".crowd"
		crowd
	as ".json"
		if a.base-name == crow-config-base-name then crow-config else other
	else
		if is-java-uri a then class_ else other
file-type file-type(a file-path)
	file-type a.to
is-crow-config bool(a uri)
	a.file-type == crow-config

type-syntax-kind diag-type-should-use-syntax?(a symbol)
	match a
	as array
		array
	as map
		map
	as mut-array
		mut-array
	as mut-map
		mut-map
	as lambda-data
		lambda-data
	as lambda-mut
		lambda-mut
	as lambda-shared
		lambda-shared
	as option
		option
	as shared-array
		shared-array
	as shared-map
		shared-map
	as tuple2
		tuple
	as tuple3
		tuple
	as tuple4
		tuple
	as tuple5
		tuple
	as tuple6
		tuple
	as tuple7
		tuple
	as tuple8
		tuple
	as tuple9
		tuple
	else
		()
