import
	../lib/lsp/lsp-types
	../model/ast
	../model/model
	../model/parse-diag
	../model/source-range
	../model/uri
	./config
	./lang
	./parse/parse

storage_ record mut
	# A uri will be in at most one of these maps (TODO: just use file-info-or-diag)-----------------------------------------
	successes file-info mut[uri]
	diags read-file-diag mut[uri]
new storage_()
	(), ()
reset void(a storage_)
	a.successes clear
	a.diags clear

file-info union(crow-file-info, crow-config-file-info, other-file-info)
-as-text-file text-file-content?(a file-info)
	match a
	as crow-file-info x
		x content
	as crow-config-file-info x
		x content
	as other-file-info _
		()

text-file-content record
	line-and-column-getter line-and-column-getter
new text-file-content()
	(),
content string(a text-file-content)
	a.line-and-column-getter.line-and-character-getter.source-text to
line-and-character-getter line-and-character-getter(a text-file-content)
	a.line-and-column-getter line-and-character-getter

crow-file-info record(content text-file-content, ast file-ast)
crow-config-file-info record(content text-file-content, config config)
other-file-info record(content file-content)
file-info-or-diag union(file-info, read-file-diag)
set-file file-info-or-diag(a storage_, uri uri, result read-file-result)
	match result
	as file-content x
		a set-file-bytes uri, x.bytes
	as read-file-diag x
		a set-file-diag uri, x
		x
set-file-bytes file-info(a storage_, uri uri, content nat8[])
	a prepare-set-file uri
	info = uri init-file-info content
	forbid uri in a.successes
	a.successes[uri] := info
	info
# TODO: We don't need 'assume-utf8', we'll throw na exception and the test will fail if it's not valid utf8 ----------------------------------
set-file-assume-utf8 file-info(a storage_, uri uri, content string)
	a set-file-bytes uri, content.to-bytes
-set-file-diag void(a storage_, uri uri, diag read-file-diag)
	a prepare-set-file uri
	forbid uri in a.diags
	a.diags[uri] := diag
-prepare-set-file void(a storage_, uri uri)
	_ = a.diags remove uri
	_ = a.successes remove uri

change-file file-info(a storage_, uri uri, changes text-document-content-change-event[])
	info = a file-or-diag uri file-info!
	text = info as-text-file!
	new-content = text.content apply-changes text.line-and-character-getter, changes
	a set-file-assume-utf8 uri, new-content

-init-file-info file-info(uri uri, input nat8[])
	content file-content = input,
	string string? = try
		input as-string
	catch unicode-decode-error _
		()
	text-file-content text-file-content mut() = () =>
		if x ?= string
			- x line-and-column-getter-for-text
	match uri file-type
	as crow
		tfc = text-file-content[]
		tfc crow-file-info if x ?= string
			uri parse-file x, tfc.line-and-column-getter
		else
			parse-diag-file-not-utf8 file-ast-for-diag
	as crow-config
		text-file-content[] crow-config-file-info if x ?= string
			uri parse-config x
		else
			uri config-for-diag parse-diag-file-not-utf8
	as other
		content other-file-info

files-state enum(has-unknown, has-loading, all-loaded)
== bool(a files-state, b files-state)
files-state files-state(a storage_)
	res mut files-state = all-loaded
	_ = a.diags exists (_, x) =>
		match x
		as unknown
			res := has-unknown
			true
		as loading
			res := has-loading
			()
		as not-found
			()
		as error
			()
	res

all-uris-with-file-diag uri[](a storage_, search-diags read-file-diag[])
	for* uri, diag in a diags
		if diag in search-diags
			- uri
| This adds to the unknown set if {uri} is not found
file-or-diag file-info-or-diag(a storage_, uri uri)
	if res ?= a.successes[uri]
		res
	else
		a.diags ensure uri, () => unknown
mark-unknown-if-not-exist void(a storage_, uri uri)
	_ = a file-or-diag uri

read-file-result union(file-content, read-file-diag)

file-content-getters file-content-getters(a storage_)
	- for* uri, file in a successes
		match file
		as crow-file-info x
			- uri, x.content.content
		as crow-config-file-info x
			- uri, x.content.content
		else
			()
line-and-character-getter line-and-character-getter(a storage_, uri uri)
	a line-and-column-getter uri line-and-character-getter
line-and-column-getter line-and-column-getter(a storage_, uri uri)
	a.successes[uri]?.as-text-file?.line-and-column-getter else ()
line-and-column-getters line-and-column-getters(a storage_)
	- for* uri, file in a successes
		if x ?= file as-text-file
			- uri, x.line-and-column-getter

-apply-changes string(input string, lc line-and-character-getter, events text-document-content-change-event[])
	cur mut char8[] = input to
	cur-lc mut = lc
	for i, event in events with-index
		if r ?= event range
			range source-range = cur-lc[r]
			cur :=
				-- cur[0 .. range.start.to] to
				-- event.text to
				-- cur[range.end.to .. end] to
		else
			cur := event.text to
		if i != events.size - 1
			cur-lc := cur.to line-and-character-getter-for-text
	cur to

test
	s storage_ = ()
	uri-a = "test://a.crow" must-parse-uri
	do
		file0 = s set-file-assume-utf8 uri-a, "a"
		file0.crow-file-info!.content.content is "a"
	do
		change0 text-document-content-change-event = (), "a\nb\nc"
		# TODO: I should not have to give these unique names, but apparently building to JS has a bug ---------------------------
		file1 = s change-file uri-a, (change0,)
		file1.crow-file-info!.content.content is "a\nb\nc"
	do
		range line-and-character-range = (1, 0), (1, 1)
		change1 text-document-content-change-event = range, "y"
		file2 = s change-file uri-a, (change1,)
		file2.crow-file-info!.content.content is "a\ny\nc"
	do
		change2 text-document-content-change-event = ((0, 0), (0, 1)), "x"
		change3 text-document-content-change-event = ((2, 0), (2, 1)), "z"
		file3 = s change-file uri-a, (change2, change3)
		file3.crow-file-info!.content.content is "x\ny\nz"
