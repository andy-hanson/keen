import
	crow/io/terminal-color
	crow/unsafe
	../model/ast
	../model/model
	../model/source-range
	../model/uri
	../util/util
	./lang

show-ctx record
	line-and-column-getters line-and-column-getters
	file-content-getters file-content-getters
	uris-info uris-info
	options show-options
line-and-character-getters line-and-character-getters(a show-ctx)
	a.line-and-column-getters line-and-character-getters

show-type-ctx record
	show show-ctx
	common-types common-types
file-content-getters file-content-getters(a show-type-ctx)
	a.show file-content-getters
line-and-character-getters line-and-character-getters(a show-type-ctx)
	a.show line-and-character-getters
line-and-column-getters line-and-column-getters(a show-type-ctx)
	a.show line-and-column-getters
show-diag-ctx alias
	show-type-ctx
show-model-ctx alias
	show-type-ctx

show-options record(color bool)
new show-options()
	false,
without-color show-options(_ show-options)
	false,

show-called string(ctx show-type-ctx, kind write-type-kind, type-container type-container, a called)
	match a
	as called-bogus
		"<<bogus>>"
	as fun-inst
		ctx show-fun-inst kind, type-container, a
	as called-spec-sig
		ctx show-called-spec-sig kind, type-container, a

shown-signature record(name-and-return-type string, params string[], rest string)
show string(a shown-signature, kind write-type-kind)
	quoted = kind == quoted
	with out in build
		if quoted
			out ~= "'"
		out ~~= a.name-and-return-type
		out ~= "("
		out ~~= ", " join a.params
		out ~= ")"
		if quoted
			out ~= "'"
		unless a.rest is-empty
			out ~~= " {a.rest}"

show-called-decl string(ctx show-type-ctx, kind write-type-kind, type-container type-container, a called-decl)
	ctx show-called-decl-parts type-container, a show kind
show-called-decl-parts shown-signature(ctx show-type-ctx, type-container type-container, a called-decl)
	match a
	as fun-decl
		ctx show-fun-decl-parts a
	as called-spec-sig
		ctx show-called-spec-sig-parts type-container, a

show-called-decls string(ctx show-type-ctx, type-container type-container, cs called-decl[])
	ctx show-called-decls type-container, cs, of _ then true	
show-called-decls string
	ctx show-type-ctx
	type-container type-container
	cs called-decl[]
	filter bool mut(x called-decl)
do
	"" join for x in cs
		if filter[x]
			"\n\t{ctx show-called-decl unquoted, type-container, x}"

show-calleds string(ctx show-type-ctx, type-container type-container, cs called[])
	"" join for x in cs
		"\n\t{ctx show-called unquoted, type-container, x}"

show-called-spec-sig string(ctx show-type-ctx, kind write-type-kind, type-container type-container, a called-spec-sig)
	ctx show-called-spec-sig-parts type-container, a show kind
-show-called-spec-sig-parts shown-signature
	ctx show-type-ctx
	type-container type-container
	a called-spec-sig
do
	name-and-return-type, parameters = ctx show-sig-parts type-container, a.name, a.return-type, a.non-instantiated-sig.params, a.instantiated-sig
	name-and-return-type, parameters, "(from spec {ctx show-name a.containing-spec.name})"

-show-type-params-and-args string
	ctx show-type-ctx
	type-params type-params
	type-args-context type-container
	type-args type-args
do
	type-params.size is type-args.size
	unless type-params is-empty
		shown string = ", " join for param, arg in type-params zip type-args.slow-to-array
			"{param name}={ctx show-type-unquoted (arg, type-args-context)}"
		" with {shown}"

show-fun-decl string(ctx show-type-ctx, kind write-type-kind, a fun-decl)
	ctx show-fun-decl-parts a show kind
-show-fun-decl-parts shown-signature(ctx show-type-ctx, a fun-decl)
	name-and-return-type, params = ctx show-sig-parts a, a.name, a.return-type, a.params, ()
	name-and-return-type, params, (ctx.show show-fun-decl-location a)

show-fun-decl-and-type-args string(ctx show-type-ctx, type-container type-container, a fun-decl-and-type-args)
	"{a.decl name}{ctx show-type-args type-container, a.type-args}{ctx.show show-fun-decl-location a.decl}"

write-type-kind enum(quoted, unquoted)
== bool(a write-type-kind, b write-type-kind)

show-fun-inst string(ctx show-type-ctx, kind write-type-kind, type-container type-container, a fun-inst)
	"{ctx show-fun-decl kind, a.decl}{ctx show-type-params-and-args a.decl.type-param-asts, type-container, a.type-args}"

-show-fun-decl-location string(ctx show-ctx, fun-decl fun-decl)
	"(from {ctx show-line-number fun-decl.range.to})"

-show-line-number string(ctx show-ctx, pos uri-and-pos)
	line nat32 = ctx.line-and-column-getters[pos, start-of-range].pos line-1-indexed
	"{if ctx.options color then bold}{ctx show-uri pos.uri}{if ctx.options color then reset} line {line}"

show-sig string
	ctx show-type-ctx
	kind write-type-kind
	type-container type-container
	name symbol
	return-type type
	params destructure[]
	instantiated return-and-param-types?
do
	show-name, show-params = ctx show-sig-parts type-container, name, return-type, params, instantiated
	(show-name, show-params, "") show kind

show-sig-parts (string, string[])
	ctx show-type-ctx
	type-container type-container
	name symbol
	return-type type
	params destructure[]
	instantiated return-and-param-types?
do
	show-return-type string = with out in build
		out ~~= name to
		unless instantiated
			out ~~= ctx show-type-params type-container.type-param-asts
		out ~= " "	
		out ~~= ctx show-type-unquoted
			type: instantiated ?return-type else return-type
			container: type-container
	show-params string[] = if instantiated
		for x, t in params zip instantiated.param-types
			ctx show-destructure type-container, x, t
	else
		for x in params
			ctx show-destructure type-container, x, ()
	show-return-type, show-params

show-sig-simple string(ctx show-type-ctx, type-container type-container, name symbol, sig type-params-and-sig)
	with out in build
		out ~~= name to
		out ~~= ctx show-type-params sig.type-params
		out ~= " "
		out ~~= ctx show-type-unquoted (sig.return-type, type-container)
		out ~= "("
		out ~~= ", " join for x in sig params
			ctx show-param-short type-container, x
		out ~= ")"

-show-param-short string(ctx show-type-ctx, type-container type-container, a param-short)
	"{a name} {ctx show-type-unquoted (a.type, type-container)}"

-show-type-params string(_ show-type-ctx, type-params type-params)
	unless type-params is-empty
		names string = ", " join for x in type-params then x.name to
		"[{names}]"

-show-destructure string
	ctx show-type-ctx
	type-container type-container
	a destructure
	instantiated type?
do
	type = instantiated else a type
	match a
	as destructure-ignore
		"_ {ctx show-type-unquoted (type, type-container)}"
	as local
		"{a name} {ctx show-type-unquoted (type, type-container)}"
	as destructure-split
		parts string = ", " join for part, part-type in a.parts zip type.struct-inst!.type-args.slow-to-array
			ctx show-destructure type-container, part, part-type
		"({parts})"

show-struct-inst string(ctx show-type-ctx, type-container type-container, a struct-inst)
	name = a.decl name
	if kind = name type-syntax-kind
		match kind
		as array
			ctx show-suffix-type type-container, "[]", a
		as map
			ctx show-map-type type-container, "", a
		as fun-data
			ctx show-fun-type type-container, data_, a
		as fun-mut
			ctx show-fun-type type-container, mut_, a
		as fun-shared
			ctx show-fun-type type-container, shared_, a
		as mut-array
			ctx show-suffix-type type-container, " mut[]", a
		as mut-map
			ctx show-map-type type-container, " mut", a
		as option
			ctx show-suffix-type type-container, "?", a
		as shared-array
			ctx show-suffix-type type-container, " shared[]", a
		as shared-map
			ctx show-suffix-type type-container, " shared", a
		as tuple
			ctx show-tuple-type type-container, a.type-args
	else
		ctx show-regular-type type-container, a

-show-regular-type string(ctx show-type-ctx, type-container type-container, a struct-inst)
	name = a.decl name
	match a.type-args size
	as 0
		"{name}"
	as 1
		"{ctx show-type-unquoted (a.type-args.only, type-container)} {name}"
	else
		"{ctx show-tuple-type type-container, a.type-args} {name}"

-show-fun-type string(ctx show-type-ctx, type-container type-container, kind fun-kind, a struct-inst)
	return-type, param-type = a.type-args only2
	with out in build
		out ~~= ctx show-type-unquoted (return-type, type-container)
		out ~~= " {kind}("
		out ~~= if tuple = ctx.common-types as-tuple param-type
			", " join for type-arg in tuple
				"_ {ctx show-type-unquoted (type-arg, type-container)}"
		elif param-type !is-void
			ctx show-type-unquoted (param-type, type-container)
		out ~= ")"
-show-map-type string(ctx show-type-ctx, type-container type-container, open string, a struct-inst)
	key, value = a.type-args only2
	"{ctx show-type-unquoted (value, type-container)}{open}[{ctx show-type-unquoted (key, type-container)}]"
-show-suffix-type string(ctx show-type-ctx, type-container type-container, suffix string, a struct-inst)
	if arg = a.type-args opt-only
		"{ctx show-type-unquoted (arg, type-container)}{suffix}"
	else
		ctx show-regular-type type-container, a
		

-show-tuple-type string(ctx show-type-ctx, type-container type-container, members type-args)
	parts string = ", " join for arg in members
		ctx show-type-unquoted (arg, type-container)
	"({parts})"

show-type-args-generic[t] string(type-args t[], is-simple-type bool data(x t), cb-show-type string mut(x t))
	guard type-args !is-empty
	if type-args.size == 1 and is-simple-type[type-args only]
		"@{cb-show-type[type-args only]}"
	else
		"@({", " join for x in type-args then cb-show-type[x]})"

-show-type-args string(ctx show-type-ctx, type-container type-container, types type-args)
	types.slow-to-array show-type-args-generic it.is-simple-type, of x
		ctx show-type-unquoted (x, type-container)
-is-simple-type bool(a type)
	if x = a struct-inst
		x.type-args is-empty
	else
		true

show-type-quoted string(ctx show-type-ctx, a type-with-container)
	"'{ctx show-type-unquoted a}'"
show-type-unquoted string(ctx show-type-ctx, a type-with-container)
	if trusted a.type reference-equal gc-safe-value
		"NULL_TYPE" # ------------------------------------------------------------------------------------------------------------------
	else
		match type = a type
		as bogus-type
			"<<any>>"
		as type-param-index
			if type.index < a.container.n-type-params
				"{a.container.type-param-asts[type index] name}"
			else
				# TODO: This should be unreachable, but see 'test/end-to-end/compile-errors/nested-spec-error.crow'
				"Type parameter {type index}"
		as struct-inst
			ctx show-struct-inst a.container, type

show-purity string(ctx show-type-ctx, a purity)
	ctx.show show-purity a
show-purity string(ctx show-ctx, a purity)
	ctx show-name a.to::symbol

show-keyword string(ctx show-type-ctx, keyword symbol)
	ctx show-name keyword
show-name string(ctx show-ctx, name symbol)
	ctx show-name name.to::string
show-name string(ctx show-type-ctx, name symbol)
	ctx.show show-name name.to::string
show-name string(_ show-ctx, name string)
	"'{name}'"

show-spec-inst string(ctx show-type-ctx, type-container type-container, a spec-inst)
	"{a.decl name}{ctx show-type-args type-container, a.type-args}"

show-uri-and-range string(ctx show-ctx, where uri-and-range)
	show-where string = unless where.uri == ()
		"{ctx.line-and-column-getters[where] range}"
	"{ctx show-file-no-reset where.uri}{show-where}{if ctx.options color then reset}"

show-file string(ctx show-ctx, uri uri)
	"{ctx show-file-no-reset uri}{if ctx.options color then reset}"

show-uri string(ctx show-type-ctx, uri uri)
	ctx.show show-uri uri
show-uri string(ctx show-ctx, uri uri)
	ctx.uris-info show-uri-prefer-relative uri

-show-file-no-reset string(ctx show-ctx, uri uri)
	with out in build
		if ctx.options color
			out ~~= bold
			out ~~= ctx show-uri uri
			out ~~= red foreground
		else
			out ~~= ctx show-uri uri
		out ~= " "

show-visibility string(ctx show-diag-ctx, a visibility)
	ctx.show show-visibility a
show-visibility string(_ show-ctx, a visibility)
	"{a.to::symbol}"

show-sum-type-kind-upper-case string(a sum-type-kind)
	match a
	as interface_
		"Interface"
	as java-interface
		"Java interface"
	as union_
		"Union"
	as variant_
		"Variant"
