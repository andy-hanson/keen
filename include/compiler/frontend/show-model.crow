import
	crow/io/terminal-color
	../model/ast
	../model/model
	../model/source-range
	../model/uri
	../util/util
	./lang

show-ctx record
	line-and-column-getters line-and-column-getters
	file-content-getters file-content-getters
	uris-info uris-info
	options show-options
file-content-getters file-content-getters() show-ctx
	the::show-ctx.file-content-getters
line-and-column-getters line-and-column-getters() show-ctx
	the::show-ctx.line-and-column-getters
line-and-character-getters line-and-character-getters() show-ctx
	line-and-column-getters.line-and-character-getters
uris-info uris-info() show-ctx
	the::show-ctx.uris-info
options show-options() show-ctx
	the::show-ctx.options

show-ctx-for-single-file show-ctx(uri uri, source string-view, uris-info uris-info, options show-options)
	line-and-column-getters: single-line-and-column-getter uri, source.line-and-column-getter-for-text
	file-content-getters: single-file-content-getter uri, source
	uris-info: uris-info
	options: options

-single-line-and-column-getter record(uri uri, value line-and-column-getter) line-and-column-getters case
-subscript line-and-column-getter(a single-line-and-column-getter, uri uri)
	uri is a.uri
	a.value

-single-file-content-getter record(uri uri, value string-view) file-content-getters case
-subscript string-view(a single-file-content-getter, uri uri)
	uri is a.uri
	a.value

show-type-ctx spec show-ctx, common-types

show-options record(color bool)
new show-options()
	false,
without-color show-options(_ show-options)
	false,

show-called string(kind write-type-kind, type-container type-container, a called) show-type-ctx
	match a
	as called-bogus
		"<<bogus>>"
	as fun-inst
		show-fun-inst kind, type-container, a
	as called-spec-sig
		show-called-spec-sig kind, type-container, a

shown-signature record(name-and-return-type string, params string[], rest string)
show string(kind write-type-kind, a shown-signature)
	quoted = kind == quoted
	params = "{a.name-and-return-type}({join ", ", a.params})"
	quoted-params = if quoted then "'{params}'" else params
	rest = unless is-empty a.rest then " {a.rest}"
	"{quoted-params}{rest}"

show-called-decl string(kind write-type-kind, type-container type-container, a called-decl) show-type-ctx
	show kind, show-called-decl-parts type-container, a
show-called-decl-parts shown-signature(type-container type-container, a called-decl) show-type-ctx
	match a
	as fun-decl
		show-fun-decl-parts a
	as called-spec-sig
		show-called-spec-sig-parts type-container, a

show-called-decls string(type-container type-container, cs called-decl[]) show-type-ctx
	show-called-decls type-container, cs, of _ then true
show-called-decls string
	type-container type-container
	cs called-decl[]
	filter bool mut(x called-decl)
do show-type-ctx
	join for x in cs
		if filter[x]
			"\n\t{show-called-decl unquoted, type-container, x}"

show-calleds string(type-container type-container, cs called[]) show-type-ctx
	join for x in cs
		"\n\t{show-called unquoted, type-container, x}"

show-called-spec-sig string(kind write-type-kind, type-container type-container, a called-spec-sig) show-type-ctx
	show kind, show-called-spec-sig-parts type-container, a
-show-called-spec-sig-parts shown-signature(type-container type-container, a called-spec-sig) show-type-ctx
	name-and-return-type, parameters = show-sig-parts type-container, a.name, a.return-type, a.non-instantiated-sig.params, a.instantiated-sig
	name-and-return-type, parameters, "(from spec {show-name a.containing-spec.name})"

-show-type-params-and-args string
	type-params type-params
	type-args-context type-container
	type-args type-args
do show-type-ctx
	type-params.size is type-args.size
	unless type-params.is-empty
		shown = join ", ", for param, arg in zip type-params, type-args.slow-to-array
			"{param.name}={show-type-unquoted (arg, type-args-context)}"
		" with {shown}"

show-fun-decl string(kind write-type-kind, a fun-decl) show-type-ctx
	show kind, show-fun-decl-parts a
-show-fun-decl-parts shown-signature(a fun-decl) show-type-ctx
	name-and-return-type, params = show-sig-parts a, a.name, a.return-type, a.params, ()
	name-and-return-type, params, show-fun-decl-location a

show-fun-decl-and-type-args string(type-container type-container, a fun-decl-and-type-args) show-type-ctx
	"{a.decl.name}{show-type-args type-container, a.type-args}{show-fun-decl-location a.decl}"

write-type-kind enum(quoted, unquoted)
== bool(a write-type-kind, b write-type-kind)

show-fun-inst string(kind write-type-kind, type-container type-container, a fun-inst) show-type-ctx
	"{show-fun-decl kind, a.decl}{show-type-params-and-args a.decl.type-param-asts, type-container, a.type-args}"

-show-fun-decl-location string(fun-decl fun-decl) show-ctx
	"(from {show-line-number fun-decl.range.to})"

-show-line-number string(pos uri-and-pos) show-ctx
	line nat32 = line-and-column-getters[pos, start-of-range].pos.line-1-indexed
	"{if options.color then bold}{show-uri pos.uri}{if options.color then reset} line {line}"

show-sig string
	kind write-type-kind
	type-container type-container
	name symbol
	return-type type
	params destructure[]
	instantiated return-and-param-types?
do show-type-ctx
	show-name, show-params = show-sig-parts type-container, name, return-type, params, instantiated
	show kind, (show-name, show-params, "")

show-sig-parts (string, string[])
	type-container type-container
	name symbol
	return-type type
	params destructure[]
	instantiated return-and-param-types?
do show-type-ctx
	show-return-type = join
		- name.to
		- unless instantiated
			show-type-params type-container.type-param-asts
		- " "
		- show-type-unquoted
			type: instantiated.?return-type else return-type
			container: type-container
	show-params string[] = if instantiated
		for x, t in zip params, instantiated.param-types
			show-destructure type-container, x, t
	else
		for x in params
			show-destructure type-container, x, ()
	show-return-type, show-params

show-sig-simple string(type-container type-container, name symbol, sig type-params-and-sig) show-type-ctx
	join
		- name.to
		- show-type-params sig.type-params
		- " "
		- show-type-unquoted (sig.return-type, type-container)
		- "("
		- join ", ", for x in sig.params
			"_ {show-type-unquoted (x, type-container)}"
		- ")"

-show-type-params string(type-params type-params) show-type-ctx
	unless is-empty type-params
		"[{join ", ", map type-params, it.name.to}]"

-show-destructure string(container type-container, a destructure, instantiated type?) show-type-ctx
	type = instantiated else a.type
	match a
	as destructure-ignore
		"_ {show-type-unquoted (type, container)}"
	as local
		"{a.name} {show-type-unquoted (type, container)}"
	as destructure-split
		parts = join ", ", for part, part-type in zip a.parts, type.struct-inst!.type-args.slow-to-array
			show-destructure container, part, part-type
		"({parts})"

show-struct-inst string(type-container type-container, a struct-inst) show-type-ctx
	name = a.decl.name
	if kind = type-syntax-kind name
		match kind
		as array
			show-suffix-type type-container, "[]", a
		as map
			show-map-type type-container, "", a
		as fun-data
			show-fun-type type-container, data_, a
		as fun-mut
			show-fun-type type-container, mut_, a
		as fun-shared
			show-fun-type type-container, shared_, a
		as mut-array
			show-suffix-type type-container, " mut[]", a
		as mut-map
			show-map-type type-container, " mut", a
		as option
			show-suffix-type type-container, "?", a
		as shared-array
			show-suffix-type type-container, " shared[]", a
		as shared-map
			show-suffix-type type-container, " shared", a
		as tuple
			show-tuple-type type-container, a.type-args
	else
		show-regular-type type-container, a

-show-regular-type string(type-container type-container, a struct-inst) show-type-ctx
	name = a.decl.name
	match a.type-args.size
	as 0
		"{name}"
	as 1
		"{show-type-unquoted (a.type-args.only!, type-container)} {name}"
	else
		"{show-tuple-type type-container, a.type-args} {name}"

-show-fun-type string(type-container type-container, kind purity, a struct-inst) show-type-ctx
	return-type, param-type = only2! a.type-args
	join
		- show-type-unquoted (return-type, type-container)
		- " {kind}("
		-
			if tuple = as-tuple param-type
				join ", ", for type-arg in tuple
					"_ {show-type-unquoted (type-arg, type-container)}"
			elif !param-type.is-void
				show-type-unquoted (param-type, type-container)
		- ")"
-show-map-type string(type-container type-container, open string, a struct-inst) show-type-ctx
	key, value = only2! a.type-args
	"{show-type-unquoted (value, type-container)}{open}[{show-type-unquoted (key, type-container)}]"
-show-suffix-type string(type-container type-container, suffix string, a struct-inst) show-type-ctx
	if arg = only a.type-args
		"{show-type-unquoted (arg, type-container)}{suffix}"
	else
		show-regular-type type-container, a

-show-tuple-type string(type-container type-container, members type-args) show-type-ctx
	parts = join ", ", for arg in members
		show-type-unquoted (arg, type-container)
	"({parts})"

show-type-args-generic[t] string(type-args t[], is-simple-type bool data(x t), cb-show-type string mut(x t))
	do unless is-empty type-args
	if type-arg = only type-args and is-simple-type[type-arg]
		"@{cb-show-type[type-arg]}"
	else
		"@({join ", ", map type-args, cb-show-type})"

-show-type-args string(type-container type-container, types type-args) show-type-ctx
	show-type-args-generic types.slow-to-array, it.is-simple-type, of x
		show-type-unquoted (x, type-container)
-is-simple-type bool(a type)
	!(a.struct-inst and !is-empty a.type-args)

show-type-quoted string(a type-with-container) show-type-ctx
	"'{show-type-unquoted a}'"
show-type-unquoted string(a type-with-container) show-type-ctx
	match type = a.type
	as bogus-type
		"<<any>>"
	as type-param-index
		if type.index < a.container.n-type-params
			"{a.container.type-param-asts[type.index].name}"
		else
			# TODO: This should be unreachable, but see 'test/end-to-end/compile-errors/nested-spec-error.crow'
			"Type parameter {type.index}"
	as struct-inst
		show-struct-inst a.container, type

show-purity string(a purity) show-ctx
	show-name a.to::symbol
show-keyword string(keyword symbol) show-ctx
	show-name keyword
show-visibility string(a visibility) show-ctx
	show-name a.to
show-name string(name symbol) show-ctx
	show-name name.to::string
show-name string(name string) show-ctx
	"'{name}'"

show-spec-inst string(type-container type-container, a spec-inst) show-type-ctx
	"{a.decl.name}{show-type-args type-container, a.type-args}"

show-uri-and-range string(where uri-and-range) show-ctx
	show-where = unless where.uri == ()
		"{line-and-column-getters[where].range}"
	"{show-file-no-reset where.uri}{show-where}{if options.color then reset}"

show-uri string(uri uri) show-ctx
	show-uri-prefer-relative uris-info, uri

-show-file-no-reset string(uri uri) show-ctx
	if options.color
		"{bold}{show-uri uri}{foreground red} "
	else
		"{show-uri uri} "

show-sum-type-kind-upper-case string(a sum-type-kind)
	match a
	as interface_
		"Interface"
	as java-interface
		"Java interface"
	as union_
		"Union"
	as variant_
		"Variant"
