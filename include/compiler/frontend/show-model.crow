import
	crow/io/terminal-color
	crow/unsafe
	../model/ast
	../model/model
	../model/source-range
	../model/uri
	../util/util
	./lang

show-ctx record
	line-and-column-getters line-and-column-getters
	file-content-getters file-content-getters
	uris-info uris-info
	options show-options
line-and-character-getters line-and-character-getters(a show-ctx)
	a.line-and-column-getters.line-and-character-getters

show-ctx-for-single-file show-ctx(uri uri, source char8 array-view, uris-info uris-info, options show-options)
	line-and-column-getters: single-line-and-column-getter uri, source.line-and-column-getter-for-text
	file-content-getters: single-file-content-getter uri, source
	uris-info: uris-info
	options: options

-single-line-and-column-getter record(uri uri, value line-and-column-getter) line-and-column-getters case
-subscript line-and-column-getter(a single-line-and-column-getter, uri uri)
	uri is a.uri
	a.value

-single-file-content-getter record(uri uri, value char8 array-view) file-content-getters case
-subscript char8 array-view(a single-file-content-getter, uri uri)
	uri is a.uri
	a.value

show-type-ctx record
	show show-ctx
	common-types common-types
file-content-getters file-content-getters(a show-type-ctx)
	a.show.file-content-getters
line-and-character-getters line-and-character-getters(a show-type-ctx)
	a.show.line-and-character-getters
line-and-column-getters line-and-column-getters(a show-type-ctx)
	a.show.line-and-column-getters
show-diag-ctx alias
	show-type-ctx
show-model-ctx alias
	show-type-ctx

show-options record(color bool)
new show-options()
	false,
without-color show-options(_ show-options)
	false,

show-called string(ctx show-type-ctx, kind write-type-kind, type-container type-container, a called)
	match a
	as called-bogus
		"<<bogus>>"
	as fun-inst
		show-fun-inst ctx, kind, type-container, a
	as called-spec-sig
		show-called-spec-sig ctx, kind, type-container, a

shown-signature record(name-and-return-type string, params string[], rest string)
show string(kind write-type-kind, a shown-signature)
	quoted = kind == quoted
	with out in build
		if quoted
			out ~= "'"
		out ~~= a.name-and-return-type
		out ~= "("
		out ~~= join ", ", a.params
		out ~= ")"
		if quoted
			out ~= "'"
		unless is-empty a.rest
			out ~~= " {a.rest}"

show-called-decl string(ctx show-type-ctx, kind write-type-kind, type-container type-container, a called-decl)
	show kind, show-called-decl-parts ctx, type-container, a
show-called-decl-parts shown-signature(ctx show-type-ctx, type-container type-container, a called-decl)
	match a
	as fun-decl
		show-fun-decl-parts ctx, a
	as called-spec-sig
		show-called-spec-sig-parts ctx, type-container, a

show-called-decls string(ctx show-type-ctx, type-container type-container, cs called-decl[])
	show-called-decls ctx, type-container, cs, of _ then true
show-called-decls string
	ctx show-type-ctx
	type-container type-container
	cs called-decl[]
	filter bool mut(x called-decl)
do
	join for x in cs
		if filter[x]
			"\n\t{show-called-decl ctx, unquoted, type-container, x}"

show-calleds string(ctx show-type-ctx, type-container type-container, cs called[])
	join for x in cs
		"\n\t{show-called ctx, unquoted, type-container, x}"

show-called-spec-sig string(ctx show-type-ctx, kind write-type-kind, type-container type-container, a called-spec-sig)
	show kind, show-called-spec-sig-parts ctx, type-container, a
-show-called-spec-sig-parts shown-signature
	ctx show-type-ctx
	type-container type-container
	a called-spec-sig
do
	name-and-return-type, parameters = show-sig-parts ctx, type-container, a.name, a.return-type, a.non-instantiated-sig.params, a.instantiated-sig
	name-and-return-type, parameters, "(from spec {show-name ctx, a.containing-spec.name})"

-show-type-params-and-args string
	ctx show-type-ctx
	type-params type-params
	type-args-context type-container
	type-args type-args
do
	type-params.size is type-args.size
	unless type-params.is-empty
		shown string = join ", ", for param, arg in zip type-params, type-args.slow-to-array
			"{param.name}={show-type-unquoted ctx, (arg, type-args-context)}"
		" with {shown}"

show-fun-decl string(ctx show-type-ctx, kind write-type-kind, a fun-decl)
	show kind, show-fun-decl-parts ctx, a
-show-fun-decl-parts shown-signature(ctx show-type-ctx, a fun-decl)
	name-and-return-type, params = show-sig-parts ctx, a, a.name, a.return-type, a.params, ()
	name-and-return-type, params, (show-fun-decl-location ctx.show, a)

show-fun-decl-and-type-args string(ctx show-type-ctx, type-container type-container, a fun-decl-and-type-args)
	"{a.decl.name}{show-type-args ctx, type-container, a.type-args}{show-fun-decl-location ctx.show, a.decl}"

write-type-kind enum(quoted, unquoted)
== bool(a write-type-kind, b write-type-kind)

show-fun-inst string(ctx show-type-ctx, kind write-type-kind, type-container type-container, a fun-inst)
	"{show-fun-decl ctx, kind, a.decl}{show-type-params-and-args ctx, a.decl.type-param-asts, type-container, a.type-args}"

-show-fun-decl-location string(ctx show-ctx, fun-decl fun-decl)
	"(from {show-line-number ctx, fun-decl.range.to})"

-show-line-number string(ctx show-ctx, pos uri-and-pos)
	line nat32 = ctx.line-and-column-getters[pos, start-of-range].pos.line-1-indexed
	"{if ctx.options.color then bold}{show-uri ctx, pos.uri}{if ctx.options.color then reset} line {line}"

show-sig string
	ctx show-type-ctx
	kind write-type-kind
	type-container type-container
	name symbol
	return-type type
	params destructure[]
	instantiated return-and-param-types?
do
	show-name, show-params = show-sig-parts ctx, type-container, name, return-type, params, instantiated
	show kind, (show-name, show-params, "")

show-sig-parts (string, string[])
	ctx show-type-ctx
	type-container type-container
	name symbol
	return-type type
	params destructure[]
	instantiated return-and-param-types?
do
	show-return-type string = with out in build
		out ~~= name.to
		unless instantiated
			out ~~= show-type-params ctx, type-container.type-param-asts
		out ~= " "
		out ~~= show-type-unquoted ctx,
			type: instantiated.?return-type else return-type
			container: type-container
	show-params string[] = if instantiated
		for x, t in zip params, instantiated.param-types
			show-destructure ctx, type-container, x, t
	else
		for x in params
			show-destructure ctx, type-container, x, ()
	show-return-type, show-params

show-sig-simple string(ctx show-type-ctx, type-container type-container, name symbol, sig type-params-and-sig)
	with out in build
		out ~~= name.to
		out ~~= show-type-params ctx, sig.type-params
		out ~= " "
		out ~~= show-type-unquoted ctx, (sig.return-type, type-container)
		out ~= "("
		out ~~= join ", ", for x in sig.params
			"_ {show-type-unquoted ctx, (x, type-container)}"
		out ~= ")"

-show-type-params string(_ show-type-ctx, type-params type-params)
	unless type-params.is-empty
		names string = join ", ", for x in type-params then x.name.to
		"[{names}]"

-show-destructure string
	ctx show-type-ctx
	type-container type-container
	a destructure
	instantiated type?
do
	type = instantiated else a.type
	match a
	as destructure-ignore
		"_ {show-type-unquoted ctx, (type, type-container)}"
	as local
		"{a.name} {show-type-unquoted ctx, (type, type-container)}"
	as destructure-split
		parts string = join ", ", for part, part-type in zip a.parts, type.struct-inst!.type-args.slow-to-array
			show-destructure ctx, type-container, part, part-type
		"({parts})"

show-struct-inst string(ctx show-type-ctx, type-container type-container, a struct-inst)
	name = a.decl.name
	if kind = type-syntax-kind name
		match kind
		as array
			show-suffix-type ctx, type-container, "[]", a
		as map
			show-map-type ctx, type-container, "", a
		as fun-data
			show-fun-type ctx, type-container, data_, a
		as fun-mut
			show-fun-type ctx, type-container, mut_, a
		as fun-shared
			show-fun-type ctx, type-container, shared_, a
		as mut-array
			show-suffix-type ctx, type-container, " mut[]", a
		as mut-map
			show-map-type ctx, type-container, " mut", a
		as option
			show-suffix-type ctx, type-container, "?", a
		as shared-array
			show-suffix-type ctx, type-container, " shared[]", a
		as shared-map
			show-suffix-type ctx, type-container, " shared", a
		as tuple
			show-tuple-type ctx, type-container, a.type-args
	else
		show-regular-type ctx, type-container, a

-show-regular-type string(ctx show-type-ctx, type-container type-container, a struct-inst)
	name = a.decl.name
	match a.type-args.size
	as 0
		"{name}"
	as 1
		"{show-type-unquoted ctx, (a.type-args.only, type-container)} {name}"
	else
		"{show-tuple-type ctx, type-container, a.type-args} {name}"

-show-fun-type string(ctx show-type-ctx, type-container type-container, kind fun-kind, a struct-inst)
	return-type, param-type = only2 a.type-args
	with out in build
		out ~~= show-type-unquoted ctx, (return-type, type-container)
		out ~~= " {kind}("
		out ~~= if tuple = as-tuple ctx.common-types, param-type
			join ", ", for type-arg in tuple
				"_ {show-type-unquoted ctx, (type-arg, type-container)}"
		elif !param-type.is-void
			show-type-unquoted ctx, (param-type, type-container)
		out ~= ")"
-show-map-type string(ctx show-type-ctx, type-container type-container, open string, a struct-inst)
	key, value = only2 a.type-args
	"{show-type-unquoted ctx, (value, type-container)}{open}[{show-type-unquoted ctx, (key, type-container)}]"
-show-suffix-type string(ctx show-type-ctx, type-container type-container, suffix string, a struct-inst)
	if arg = opt-only a.type-args
		"{show-type-unquoted ctx, (arg, type-container)}{suffix}"
	else
		show-regular-type ctx, type-container, a

-show-tuple-type string(ctx show-type-ctx, type-container type-container, members type-args)
	parts string = join ", ", for arg in members
		show-type-unquoted ctx, (arg, type-container)
	"({parts})"

show-type-args-generic[t] string(type-args t[], is-simple-type bool data(x t), cb-show-type string mut(x t))
	guard !is-empty type-args
	if type-arg = opt-only type-args and is-simple-type[type-arg]
		"@{cb-show-type[type-arg]}"
	else
		"@({join ", ", map type-args, cb-show-type})"

-show-type-args string(ctx show-type-ctx, type-container type-container, types type-args)
	show-type-args-generic types.slow-to-array, it.is-simple-type, of x
		show-type-unquoted ctx, (x, type-container)
-is-simple-type bool(a type)
	!(a.struct-inst and !is-empty a.type-args)

show-type-quoted string(ctx show-type-ctx, a type-with-container)
	"'{show-type-unquoted ctx, a}'"
show-type-unquoted string(ctx show-type-ctx, a type-with-container)
	match type = a.type
	as bogus-type
		"<<any>>"
	as type-param-index
		if type.index < a.container.n-type-params
			"{a.container.type-param-asts[type.index].name}"
		else
			# TODO: This should be unreachable, but see 'test/end-to-end/compile-errors/nested-spec-error.crow'
			"Type parameter {type.index}"
	as struct-inst
		show-struct-inst ctx, a.container, type

show-purity string(ctx show-type-ctx, a purity)
	show-purity ctx.show, a
show-purity string(ctx show-ctx, a purity)
	show-name ctx, a.to::symbol

show-keyword string(ctx show-type-ctx, keyword symbol)
	show-name ctx, keyword
show-name string(ctx show-ctx, name symbol)
	show-name ctx, name.to::string
show-name string(ctx show-type-ctx, name symbol)
	show-name ctx.show, name.to::string
show-name string(_ show-ctx, name string)
	"'{name}'"

show-spec-inst string(ctx show-type-ctx, type-container type-container, a spec-inst)
	"{a.decl.name}{show-type-args ctx, type-container, a.type-args}"

show-uri-and-range string(ctx show-ctx, where uri-and-range)
	show-where string = unless where.uri == ()
		"{ctx.line-and-column-getters[where].range}"
	"{show-file-no-reset ctx, where.uri}{show-where}{if ctx.options.color then reset}"

show-file string(ctx show-ctx, uri uri)
	"{show-file-no-reset ctx, uri}{if ctx.options.color then reset}"

show-uri string(ctx show-type-ctx, uri uri)
	show-uri ctx.show, uri
show-uri string(ctx show-ctx, uri uri)
	show-uri-prefer-relative ctx.uris-info, uri

-show-file-no-reset string(ctx show-ctx, uri uri)
	with out in build
		if ctx.options.color
			out ~~= bold
			out ~~= show-uri ctx, uri
			out ~~= foreground red
		else
			out ~~= show-uri ctx, uri
		out ~= " "

show-visibility string(ctx show-diag-ctx, a visibility)
	show-visibility ctx.show, a
show-visibility string(_ show-ctx, a visibility)
	"{a.to::symbol}"

show-sum-type-kind-upper-case string(a sum-type-kind)
	match a
	as interface_
		"Interface"
	as java-interface
		"Java interface"
	as union_
		"Union"
	as variant_
		"Variant"
