import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	./lexer
	./parse-type
	./parse-util
	./token
	./token-util

parse-fun-expr-body expr-ast?(lexer lexer)
	if lexer try-take-token newline-indent
		lexer parse-statements-and-dedent

-arg-ctx record
	| Allow things like 'if' that continue into an indented block.
	allowed-block bool
	| Only parse operators if their precedence is greater than this.
	min-precedence-exclusive int
-allow-everything arg-ctx()
	true, min-value
-allow-everything-except-block arg-ctx()
	false, min-value

-require-precedence-gt arg-ctx(a arg-ctx, precedence int)
	allowed-block: a allowed-block
	min-precedence-exclusive: a.min-precedence-exclusive max precedence

-parse-comma-call expr-ast(lexer lexer, start pos, arg-ctx arg-ctx, first expr-ast)
	args = lexer parse-args arg-ctx, first
	with args2 in args it-scope
		lexer range start list-ast for x in args2 then x

-parse-args expr-ast[](lexer lexer, ctx arg-ctx, first expr-ast)
	with out in build
		out ~= first
		assert ctx.min-precedence-exclusive >= comma-precedence
		if lexer peek-token-expression ctx.allowed-block
			out ~= lexer parse-expr-and-calls ctx
			while lexer try-take-token comma
				out ~= lexer parse-expr-and-calls ctx

-peek-token-expression bool(lexer lexer, allowed-block bool)
	match lexer peek
	as and_
		false
	as else_
		false
	as brace-right
		false
	as bracket-right
		false
	as catch_
		false
	as end-of-file
		false
	as paren-right
		false
	as newline-indent
		allowed-block
	as newline-dedent
		false
	as newline-same-indent
		false
	as or_
		false
	as then_
		false
	else
		true

-is-prefix-unary-operator bool(a symbol)
	a == "-" or a == "~"

-parse-assignment expr-ast(lexer lexer, left expr-ast, assignment-pos pos)
	right = lexer parse-expr-no-let
	left assignment-ast assignment-pos, right

-must-parse-next-lines expr-ast(lexer lexer, diag parse-diag-expected)
	lexer try-parse-next-lines else
		lexer add-diag-at-next-token diag
		lexer.next-range bogus-ast
-try-parse-next-lines expr-ast?(lexer lexer)
	if lexer try-take-token newline-same-indent
		lexer parse-statements

-parse-calls expr-ast(lexer lexer, start pos, lhs expr-ast, arg-ctx arg-ctx)
	before-call = lexer next-start
	precedence = arg-ctx min-precedence-exclusive
	if equals-expression-precedence > precedence and lexer try-take-token equal
		unpack = lexer parse-unpack-option lhs, before-call, arg-ctx
		lexer parse-calls start, unpack, arg-ctx
	elif comma-precedence > precedence and lexer try-take-token comma
		res = lexer parse-comma-call start, (arg-ctx require-precedence-gt comma-precedence), lhs
		lexer parse-calls start, res, arg-ctx
	elif log = lexer.peek as-logical-ast-kind and log.precedence > precedence
		lexer advance-may-continue-onto-next-line
		expr = lhs logical-ast log, before-call,
			lexer parse-expr-and-calls do arg-ctx require-precedence-gt log.precedence
		lexer parse-calls start, expr, arg-ctx
	else
		lexer parse-named-calls start, lhs, arg-ctx

-as-logical-ast-kind logical-ast-kind?(token token)
	match token
	as and_
		and_
	as else_
		else_
	as or_
		or_
	else
		()

-parse-named-calls expr-ast(lexer lexer, start pos, lhs expr-ast, arg-ctx arg-ctx)
	pos = lexer next-start
	guard name = lexer try-take-name-and-precedence arg-ctx else lhs
	fun-token = name token
	fun-name name-and-range = pos + (fun-token == name-after-bang or fun-token == name-after-question).to, name.name
	precedence = name precedence
	assignment assignment-kind? = match fun-token
	as name-or-operator-colon-equals
		replace
	as name-or-operator-equals
		in-place
	else
		()
	is-operator = precedence != 0
	# TODO: don't do this for operators ------------------------------------------------------------------------------------
	type-arg = lexer try-parse-type-arg-for-expr
	inner-ctx = arg-ctx require-precedence-gt precedence
	args expr-ast[] = if is-operator
		- lhs
		- lexer parse-expr-and-calls inner-ctx
	else
		lexer parse-args inner-ctx, lhs
	expr expr-ast = if assignment
		match assignment
		as in-place
			lexer range start call-ast infix, 0, fun-name, args, ()
		else
			args.size is 2
			fun-name assignment-call-ast args[0], args[1]
	else
		with args2 in args it-scope-if precedence > 0
			range: lexer range start
			style: if fun-token == name-after-question then question-name else infix
			keyword-pos: if fun-token == name-after-question then pos
			fun-name: fun-name
			args: args2
			type-arg: type-arg
	res expr-ast = match fun-token
	as name-after-bang
		fun-name.range.start - 1 not-ast expr
	as name-bang
		expr force-ast fun-name.range.end
	else
		expr
	lexer parse-calls start, res, arg-ctx

-name-and-precedence record
	token token
	name symbol
	precedence int
-try-take-name-and-precedence name-and-precedence?(lexer lexer, arg-ctx arg-ctx)
	x = lexer peek
	guard x is-symbol-token or x == in_
	name symbol = if x == in_ then "in" else lexer next-symbol
	precedence = name symbol-precedence
		x == name-or-operator-equals or x == name-or-operator-colon-equals
	guard precedence > arg-ctx.min-precedence-exclusive
	if x token-has-continuation
		lexer advance-may-continue-onto-next-line
	else
		lexer advance
	token: x
	name: name
	precedence: precedence

-token-has-continuation bool(a token)
	a == operator or a == name-or-operator-colon-equals or a == name-or-operator-equals

-assignment-kind enum
	| foo=
	in-place
	| foo:=
	replace

| This is for the , in `1, 2` (calling `1 new 2`), not the comma between arguments in a normal call
-comma-precedence int()
	0
-precedence int(a logical-ast-kind)
	match a
	as and_
		-2
	as else_
		-4
	as or_
		-3
-equals-expression-precedence int()
	-1

-name-precedence int()
	0
-symbol-precedence int(a symbol, is-assignment bool)
	guard !is-assignment else -5
	match a
	as ".."
		1
	as "~"
		2
	as "~~"
		2
	as "=="
		3
	as "!="
		3
	as "<"
		3
	as "<="
		3
	as ">"
		3
	as ">="
		3
	as "<=>"
		3
	as "|"
		4
	as "^"
		5
	as "&"
		6
	as "<<"
		7
	as ">>"
		7
	as "+"
		8
	as "-"
		8
	as "*"
		9
	as "/"
		9
	as "%"
		9
	as "**"
		10
	else
		name-precedence

-try-parse-dots-and-subscripts expr-ast(lexer lexer, initial expr-ast)
	dot-pos = lexer next-start
	match lexer peek
	as dot
		lexer advance
		lexer try-parse-dots-and-subscripts do lexer parse-after-dot initial, dot-pos
	as bracket-left
		lexer advance
		lexer try-parse-dots-and-subscripts do lexer parse-subscript initial, dot-pos, false
	as question-bracket
		lexer advance
		lexer try-parse-dots-and-subscripts do lexer parse-subscript initial, dot-pos, true
	as colon2
		lexer try-parse-dots-and-subscripts with initial2 in initial it-scope
			lexer advance
			initial2 typed-ast dot-pos, lexer.parse-type-for-typed-expr
	as bang
		lexer try-parse-dots-and-subscripts with initial2 in initial it-scope
			lexer advance
			initial2 force-ast dot-pos
	else
		initial

-parse-after-dot expr-ast(lexer lexer, initial expr-ast, dot-pos pos)
	call expr-ast mut(style call-ast-style, name name-and-range, type-arg type-ast?) = of style, name, type-arg
		with initial2 in initial it-scope-single
			range: lexer range initial.range.start
			style: style
			keyword-pos: dot-pos
			fun-name: name
			args: initial2,
			type-arg: type-arg
	if name = lexer try-take-name-like-token name-bang
		with x in call[dot, name, ()] it-scope
			x force-ast name.range.end
	elif name = lexer try-take-name-like-token name-after-question
		call[dot-question, name, ()]
	elif name = lexer try-take-name-and-range-or-diag
		call[dot, name, lexer.try-parse-type-arg-for-expr]
	else
		initial

-parse-subscript expr-ast(lexer lexer, initial expr-ast, subscript-pos pos, is-question-bracket bool)
	arg expr-ast = if lexer try-take-token bracket-right
		lexer range subscript-pos list-ast ()
	else
		res = lexer parse-expr-no-block
		_ = lexer take-or-add-diag-expected-token bracket-right, closing-bracket
		res
	with args in (initial, arg) it-scope
		:: call-ast
		range: lexer range initial.range.start
		style: if is-question-bracket then question-subscript else subscript
		keyword-pos: subscript-pos
		fun-name: subscript-pos, "subscript"
		args: args
		type-arg: ()

-parse-match expr-ast(lexer lexer, start pos)
	local = if lexer lookahead-equals-for-match
		res = lexer try-take-name-and-range
		_ = lexer take-or-add-diag-expected-token equal, equals
		res
	matched = lexer parse-expr-no-block
	cases case-ast[] = with out in build
		while as-pos = lexer try-take-newline-then-as
			out ~= as-pos, lexer.parse-case-member, lexer.parse-then-or-block
	start match-ast local, matched, cases, if pos = lexer try-take-newline-then-else
		pos, lexer.parse-then-or-block

-parse-then-or-block expr-ast(lexer lexer)
	if lexer try-take-token then_
		lexer parse-expr-no-block
	else
		lexer parse-indented-statements

-parse-case-member case-member-ast(lexer lexer)
	if name = lexer try-take-name-and-range
		name as-name-ast
	elif number = lexer try-take-literal-number
		number
	else
		lexer parse-string-literal-forbid-interpolated parse-diag-match-case-interpolated else
			lexer.next-range as-bogus-ast

-parse-string-literal-forbid-interpolated literal-string-ast?(lexer lexer, diag parse-diag)
	if kind = lexer.peek as-quote-no-interpolated
		lexer advance
		kind, lexer.prev-range, lexer.prev-string
	else
		lexer add-diag-at-next-token diag
		lexer skip-until-newline-no-diag
		()

-as-quote-no-interpolated quote-kind?(a token)
	match a
	as quote-bar-no-interpolated then bar
	as quote-block-no-interpolated then indented
	as quote-double-no-interpolated then double
	else then ()

-parse-quote-no-interpolated expr-ast(lexer lexer, kind quote-kind, allowed-block bool)
	string literal-string-ast = kind, lexer.prev-range, lexer.prev-string
	lexer after-quote string, allowed-block

-parse-quote-then-interpolated expr-ast(lexer lexer, kind quote-kind, allowed-block bool)
	template interpolated-template-part mut[] =
		- lexer.prev-range, lexer.prev-string
	parts expr-ast mut[] = ()
	res expr-ast = loop
		parts ~= if lexer peek brace-right
			lexer add-diag-at-next-token parse-diag-missing-interpolated
			lexer.next-range bogus-ast
		else
			lexer parse-expr-no-block
		guard lexer take-after-interpolated else break lexer range template[0].range.start bogus-ast
		token = lexer take-next-token
		template ~= lexer.prev-range, lexer.prev-string
		if token == kind.no-interpolated
			break with parts2 in parts.move-to it-scope
				kind interpolated-ast template.move-to, parts2
		else
			token is kind.then-interpolated
			continue
	lexer after-quote res, allowed-block

-after-quote expr-ast(lexer lexer, expr expr-ast, allowed-block bool)
	if lexer try-take-token colon and string = expr as-string-like
		lexer parse-single-line-named-new-after-first-name string, allowed-block
	else
		lexer try-parse-dots-and-subscripts expr
-as-string-like name-or-string-ast?(a expr-ast)
	match a
	as literal-string-ast then a
	as interpolated-ast then a
	else then ()

-parse-if expr-ast(lexer lexer, start pos, is-else-of-parent bool, allowed-block bool)
	condition = lexer parse-condition allow-everything-except-block
	then-pos = lexer next-start
	if !is-else-of-parent and lexer try-take-token then_
		then_ = lexer parse-expr-and-calls (false, else_.precedence)
		else-pos = lexer next-start
		else_ expr-ast? = if lexer try-take-token else_
			lexer parse-expr-no-block
		start: start
		kind: if else_ then if-then-else else if-then
		is-else-of-parent: false
		second-keyword-pos: then-pos
		third-keyword-pos: if else_ then else-pos else max-value
		condition: condition
		first-branch: then_
		second-branch: else_
	else
		then_ = lexer parse-indented-statements start, allowed-block, if_
		elif-or-else = if allowed-block then lexer try-take-newline-then-elif-or-else
		else_ expr-ast? = if elif-or-else
			match elif-or-else kind
			as elif_
				lexer parse-if elif-or-else.pos, true, allowed-block
			as else_
				lexer parse-indented-statements
		start: start
		kind: if elif-or-else
			match elif-or-else kind
			as elif_
				if-elif
			as else_
				if-else
		else
			if-without-else
		is-else-of-parent: is-else-of-parent
		second-keyword-pos: elif-or-else ?pos else 0
		third-keyword-pos: max-value
		condition: condition
		first-branch: then_
		second-branch: else_

-elif-or-else-keyword record(kind elif-or-else, pos pos)
-elif-or-else enum(elif_, else_)
-to elif-or-else?(a token)
	match a
	as elif_ then elif_
	as else_ then else_
	else then ()
-try-take-newline-then-elif-or-else elif-or-else-keyword?(lexer lexer)
	guard lexer peek newline-same-indent
	guard kind elif-or-else = lexer.peek2 to
	lexer advance
	pos = lexer next-start
	lexer advance
	kind, pos

-parse-condition expr-ast(lexer lexer, ctx arg-ctx)
	if lexer lookahead-equals
		start = lexer next-start
		left = lexer parse-destructure-no-require-parens
		equals-pos = lexer next-start
		_ = lexer take-or-add-diag-expected-token equal, equals
		value = lexer parse-expr-and-calls do ctx require-precedence-gt and_.precedence
		unpack = left unpack-option-ast equals-pos, value
		and-pos = lexer next-start
		if lexer try-take-token and_
			unpack logical-ast and_, and-pos, do lexer parse-condition ctx
		else
			lexer parse-calls start, unpack, ctx
	else
		lexer parse-expr-and-calls ctx

-parse-unless if-ast(lexer lexer, start pos, allowed-block bool)
	condition = lexer parse-expr-no-block
	then-pos, body = lexer parse-then-or-indented-statements start, allowed-block, unless_
	start: start
	kind: if then-pos == max-value then unless_ else unless-then
	is-else-of-parent: false
	second-keyword-pos: then-pos
	third-keyword-pos: max-value
	condition: condition
	first-branch: body
	second-branch: ()

-parse-trusted expr-ast(lexer lexer, start pos, allowed-block bool)
	start trusted-ast do lexer parse-expr-and-all-calls allowed-block

-try-take-assert-or-forbid bool?(lexer lexer)
	if lexer try-take-token assert_
		false
	elif lexer try-take-token forbid_
		true

-parse-single-statement-or-block expr-ast(lexer lexer)
	if lexer try-take-token newline-indent
		lexer parse-statements-and-dedent
	else
		lexer parse-actually-single-statement-line

-parse-guard if-ast(lexer lexer, start pos)
	res = lexer parse-assert-forbid-or-guard
	start: start
	kind: if res else_ then guard-with-else else guard-without-else
	is-else-of-parent: false
	second-keyword-pos: res.else_ ?else-pos else max-value
	third-keyword-pos: max-value
	condition: res condition
	first-branch: res.else_ ?expr
	second-branch: res after

-assert-forbid-or-guard record
	condition expr-ast
	else_ assert-or-forbid-thrown-ast?
	after expr-ast?
-parse-assert-forbid-or-guard assert-forbid-or-guard(lexer lexer)
	condition = lexer parse-condition (true, else_.precedence)
	else-pos = lexer next-start
	condition: condition
	else_: if lexer try-take-token else_
		else-pos, lexer.parse-expr-no-let
	after: lexer try-parse-next-lines

-parse-for-or-with for-or-with-ast
	lexer lexer
	start pos
	allowed-block bool
	kind for-or-with-ast-keyword
	block-kind parse-diag-needs-block-ctx
do
	param, in-pos = lexer parse-for-or-with-parameter
	arg = lexer parse-expr-no-block
	then-pos, body = lexer parse-then-or-indented-statements start, allowed-block, block-kind
	start: start
	keyword: kind
	param: param
	in-pos: in-pos
	then-pos: then-pos
	arg: arg
	body: body

-parse-loop-while-or-until expr-ast(lexer lexer, start pos, is-until bool)
	condition = lexer parse-condition allow-everything-except-block
	body = lexer parse-indented-statements
	start loop-while-or-until-ast is-until, condition, body, lexer.try-parse-next-lines

-take-indent-or-fail-expr expr-ast(lexer lexer, cb-indent expr-ast mut())
	lexer take-indent-or-fail-generic cb-indent, it.bogus-ast

-parse-for-or-with-parameter (destructure-ast, pos)(lexer lexer)
	pos = lexer next-start
	if lexer try-take-token in_
		(lexer range pos void-destructure-ast), pos
	else
		res = lexer parse-destructure-no-require-parens
		end-token-pos = lexer next-start
		_ = lexer take-or-add-diag-expected-token in_, in_
		res, end-token-pos

-skip-rest-of-line-and-return-bogus-no-diag expr-ast(lexer lexer, range source-range)
	lexer skip-until-newline-no-diag
	range bogus-ast

-skip-rest-of-line-and-return-bogus expr-ast(lexer lexer, start pos, diag parse-diag)
	range = lexer range start
	lexer add-diag range, diag
	lexer skip-rest-of-line-and-return-bogus-no-diag range

-expr-block-not-allowed expr-ast(lexer lexer, start pos, kind parse-diag-needs-block-ctx)
	lexer skip-rest-of-line-and-return-bogus start, kind

-if-allow-block expr-ast
	lexer lexer
	start pos
	allowed-block bool
	kind parse-diag-needs-block-ctx
	cb-allow-block expr-ast mut()
do
	if allowed-block
		cb-allow-block[]
	else
		lexer expr-block-not-allowed start, kind

-parse-expr-before-call expr-ast(lexer lexer, allowed-block bool)
	start = lexer next-start
	if-allow-block expr-ast mut(kind parse-diag-needs-block-ctx, cb expr-ast mut()) = of kind, cb
		lexer if-allow-block start, allowed-block, kind, cb
	peek = lexer peek
	guard peek !is-newline-token or peek == newline-indent and allowed-block else
		lexer bad-next-token
	match lexer take-next-token
	as paren-left
		if lexer try-take-token paren-right
			expr = lexer range start list-ast ()
			lexer try-parse-dots-and-subscripts expr
		else
			lexer try-parse-dots-and-subscripts with inner in lexer.parse-expr-no-block it-scope
				_ = lexer take-or-add-diag-expected-token paren-right, closing-paren
				lexer range start parenthesized-ast inner
	as quote-bar-no-interpolated
		lexer parse-quote-no-interpolated bar, allowed-block
	as quote-block-no-interpolated
		if allowed-block
			(indented, lexer.prev-range, lexer.prev-string)::literal-string-ast
		else
			lexer expr-block-not-allowed start, quote_
	as quote-double-no-interpolated
		lexer parse-quote-no-interpolated double, allowed-block
	as quote-bar-then-interpolated
		lexer parse-quote-then-interpolated bar, allowed-block
	as quote-block-then-interpolated
		if allowed-block
			lexer parse-quote-then-interpolated indented, allowed-block
		else
			lexer expr-block-not-allowed start, quote_
	as quote-double-then-interpolated
		lexer try-parse-dots-and-subscripts
			lexer parse-quote-then-interpolated double, allowed-block
	as bang
		with inner in lexer parse-expr-before-call false it-scope
			start not-ast inner
	as break_
		start loop-break-ast unless lexer peek-end-of-line and lexer.peek != newline-indent
			lexer parse-expr-and-all-calls allowed-block
	as continue_
		start loop-continue-ast
	as do_
		lexer parse-expr-and-all-calls allowed-block
	as for_
		lexer parse-for-or-with start, allowed-block, for_, for_
	as for-star
		lexer parse-for-or-with start, allowed-block, for-star, for-star
	as if_
		lexer parse-if start, false, allowed-block
	as it_
		lexer try-parse-dots-and-subscripts start.it-ast.it-scope-ast
	as in_
		# It's allowed to access 'in' just in order to access Java's `System.in`
		lexer handle-name start, (start, "in")
	as match_
		if-allow-block[match_, of then lexer parse-match start]
	as name
		lexer handle-name start, (start, lexer.prev-symbol)
	as name-after-bang
		name = lexer prev-symbol
		inner = lexer try-parse-dots-and-subscripts if name == "it"
			(start + 1).it-ast it-scope-ast
		else
			start + 1 name-and-range name
		with inner2 in inner it-scope
			start not-ast inner2
	as name-bang
		lexer try-parse-dots-and-subscripts
			start name-and-range lexer.prev-symbol force-ast (lexer range start).end - 1
	as name-colon
		lexer parse-single-line-named-new-after-first-name (start, lexer.prev-symbol), allowed-block
	as newline-indent
		assert allowed-block # The guard at top handled the false case
		lexer parse-statements-and-dedent
	as of_
		param destructure-ast = if lexer peek then_ or lexer peek newline-indent
			lexer.next-range void-destructure-ast
		else
			lexer parse-destructure-no-require-parens
		then-pos, body = lexer parse-then-or-indented-statements start, allowed-block, of_
		start lambda-ast param, then-pos, body
	as operator
		operator = lexer.prev-symbol
		if operator is-prefix-unary-operator
			lexer handle-prefix-unary-operator allowed-block, start, operator
		else
			lexer bad-prev-token
	as literal-number
		lexer try-parse-dots-and-subscripts do lexer range start literal-number
	as loop_
		if-allow-block[loop_, of then start loop-ast lexer.parse-indented-statements]
	as shared_
		start shared-ast do lexer parse-expr-and-all-calls allowed-block
	as throw_
		start throw-ast do lexer parse-expr-and-all-calls allowed-block
	as trusted_
		lexer parse-trusted start, allowed-block
	as try_
		if-allow-block[try_, of then lexer parse-try-block start]
	as underscore
		start underscore-ast
	as unless_
		lexer parse-unless start, allowed-block
	as with_
		lexer parse-for-or-with start, allowed-block, with_, with_
	else
		lexer bad-prev-token

-bad-prev-token expr-ast(lexer lexer)
	lexer add-diag-unexpected-prev-token
	lexer skip-rest-of-line-and-return-bogus-no-diag lexer.prev-range
-bad-next-token expr-ast(lexer lexer)
	lexer add-diag-unexpected-next-token
	lexer skip-rest-of-line-and-return-bogus-no-diag lexer.next-range

-handle-prefix-unary-operator expr-ast(lexer lexer, allowed-block bool, start pos, operator symbol)
	with arg in lexer parse-expr-before-call allowed-block it-scope
		lexer range start call-ast prefix-operator, 0, (start, operator), (arg,), ()

-handle-name expr-ast(lexer lexer, start pos, name name-and-range)
	if type-arg = lexer try-parse-type-arg-for-expr
		lexer range start call-ast single, 0, name, (), type-arg
	else
		lexer try-parse-dots-and-subscripts name

-parse-expr-no-block expr-ast(lexer lexer)
	lexer parse-expr-and-all-calls false

-parse-expr-and-all-calls expr-ast(lexer lexer, allowed-block bool)
	lexer parse-expr-and-calls (allowed-block, min-value)

-parse-expr-and-calls expr-ast(lexer lexer, arg-ctx arg-ctx)
	start = lexer next-start
	left = lexer parse-expr-before-call arg-ctx.allowed-block
	lexer parse-calls start, left, arg-ctx

-parse-unpack-option expr-ast(lexer lexer, left expr-ast, equals-pos pos, arg-ctx arg-ctx)
	destructure = left to-destructure else
		lexer add-diag left.range, parse-diag-equals-left
		left.start ignore-destructure-ast ()
	right = lexer parse-expr-and-calls do arg-ctx require-precedence-gt and_.precedence
	destructure unpack-option-ast equals-pos, right

-to-destructure destructure-ast?(a expr-ast)
	match a
	as list-ast
		a.parts map-every it.expr-ast.?to-destructure
	as name-and-range
		a single-destructure-ast (), ()
	as parenthesized-ast
		a.inner to-destructure
	as underscore-ast
		a.start ignore-destructure-ast ()
	else
		()

-parse-expr-no-let expr-ast(lexer lexer)
	lexer parse-expr-and-all-calls true

parse-single-statement-line expr-ast(lexer lexer)
	start = lexer next-start
	match lexer peek
	as colon2
		lexer advance
		type = lexer parse-type
		lexer.try-parse-next-lines typed-ast start, type
	as finally_
		lexer advance
		right = lexer parse-single-statement-or-block
		below = lexer must-parse-next-lines after-finally
		start finally-ast right, below
	as guard_
		lexer advance
		lexer parse-guard start
	as trusted_
		lexer advance
		if lexer peek newline-same-indent
			after = lexer must-parse-next-lines after-trusted
			start trusted-ast after
		else
			lexer parse-trusted start, true
	as until_
		lexer advance
		lexer parse-loop-while-or-until start, true
	as while_
		lexer advance
		lexer parse-loop-while-or-until start, false
	else
		if lexer lookahead-equals
			lexer parse-equals
		else
			lexer parse-actually-single-statement-line
-parse-actually-single-statement-line expr-ast(lexer lexer)
	start = lexer next-start
	if is-forbid = lexer try-take-assert-or-forbid
		res = lexer parse-assert-forbid-or-guard
		start assert-or-forbid-ast is-forbid, res.condition, res.else_, res.after
	elif first-part = lexer try-take-list-part-kind
		lexer parse-list-call start, first-part
	else
		expr = lexer parse-expr-before-call true
		assignment-pos = lexer next-start
		if expr call-named-ast and expr.names.size == 1
			lexer parse-multi-line-named-new expr
		elif lexer try-take-token-and-may-continue-onto-next-line colon-equal
			lexer parse-assignment expr, assignment-pos
		else
			lexer parse-calls start, expr, allow-everything

-list-part-kind enum(single, multi)
-try-take-list-part-kind list-part-kind?(lexer lexer)
	guard res list-part-kind = match lexer peek
	as list-dash
		single
	as list-dash-dash
		multi
	else
		()
	lexer advance
	res

-parse-single-line-named-new-after-first-name expr-ast(lexer lexer, first-name name-or-string-ast, allowed-block bool)
	value-start = lexer next-start
	value = lexer parse-expr-and-calls (allowed-block, comma-precedence)
	if lexer try-take-token comma
		if second-name = lexer try-take-name-or-string
			lexer parse-single-line-named-new-after-second-name first-name, value, second-name, allowed-block
		else
			value2 = lexer parse-comma-call value-start, (allowed-block, comma-precedence), value
			(first-name,) call-named-ast (value2,)
	else
		value2 = lexer parse-calls value-start, value, (allowed-block, min-value)
		(first-name,) call-named-ast (value2,)

-parse-single-line-named-new-after-second-name call-named-ast
	lexer lexer
	first-name name-or-string-ast
	first-value expr-ast
	second-name name-or-string-ast
	allowed-block bool
do
	second-value = lexer parse-expr-and-calls (allowed-block, comma-precedence)
	names name-or-string-ast mut[] = first-name, second-name
	values expr-ast mut[] = first-value, second-value
	while lexer try-take-token comma
		if name = lexer take-name-or-string
			names ~= name
			values ~= lexer parse-expr-and-calls (allowed-block, comma-precedence)
	names.move-to, values.move-to

-parse-multi-line-named-new call-named-ast(lexer lexer, initial call-named-ast)
	names name-or-string-ast mut[] = initial.names to
	values expr-ast mut[] = initial.args to
	while lexer try-take-newline-for-list-or-named-new
		if name = lexer take-name-or-string
			names ~= name
			values ~= lexer parse-expr-no-let
	names.move-to, values.move-to

-try-take-newline-for-list-or-named-new bool(lexer lexer)
	if lexer peek newline-same-indent and lexer !peek2 then_
		lexer advance
		true

-try-take-name-or-string name-or-string-ast?(lexer lexer)
	lexer try-take-name-colon-and-range or
		if lexer peek quote-double-no-interpolated or lexer peek quote-double-then-interpolated
			string = lexer parse-string-literal-forbid-interpolated parse-diag-named-new-key
			if string
				_ = lexer take-or-add-diag-expected-token colon, colon
			string

-take-name-or-string name-or-string-ast?(lexer lexer)
	lexer try-take-name-colon-and-range or
		string = lexer parse-string-literal-forbid-interpolated parse-diag-named-new-key
		if string
			_ = lexer take-or-add-diag-expected-token colon, colon
		string

-parse-list-call expr-ast(lexer lexer, start pos, first-part list-part-kind)
	parts list-ast-part[] = with out in build
		out ~= first-part list-part lexer.parse-expr-no-let
		while lexer try-take-newline-for-list-or-named-new
			if kind = lexer try-take-list-part-kind
				out ~= kind list-part lexer.parse-expr-no-let
			else
				lexer add-diag-at-next-token parse-diag-list-call-needs-hyphen
				lexer skip-until-newline-no-diag
	lexer range start list-ast parts
-list-part list-ast-part(kind list-part-kind, expr expr-ast)
	match kind
	as single
		expr
	as multi
		expr list-ast-part-multi

-parse-equals expr-ast(lexer lexer)
	start = lexer next-start
	if lexer try-take-token try_
		lexer parse-try-let start
	else
		left = lexer parse-destructure-no-require-parens
		_ = lexer take-or-add-diag-expected-token-and-may-continue-onto-next-line equal, equals
		init = lexer parse-expr-no-let
		then_ = lexer try-parse-next-lines
		left let-ast init, then_

-parse-try-let try-let-ast(lexer lexer, start pos)
	destructure = lexer parse-destructure-no-require-parens
	_ = lexer take-or-add-diag-expected-token-and-may-continue-onto-next-line equal, equals
	value = lexer parse-expr-no-block
	catch-pos = lexer next-start
	_ = lexer take-or-add-diag-expected-token catch_, catch_
	catch_ = lexer parse-catch-after-keyword catch-pos
	then_ = lexer try-parse-next-lines
	start, destructure, value, catch_, then_

-parse-statements expr-ast(lexer lexer)
	res mut = lexer parse-single-statement-line
	while lexer try-take-token newline-same-indent
		if lexer try-take-token then_
			res := lexer parse-calls res.start, res, allow-everything
		else
			res seq-ast:= lexer.parse-single-statement-line
	res

-parse-indented-statements expr-ast(lexer lexer)
	lexer take-indent-or-fail-expr of
		lexer parse-statements-and-dedent

# Returns position of 'then' (or max-value no 'then' keyword) and the body.
-parse-then-or-indented-statements (pos, expr-ast)
	lexer lexer
	start pos
	allow-block bool
	block-kind parse-diag-needs-block-ctx
do
	then-pos = lexer next-start
	if lexer try-take-token then_
		then-pos, lexer.parse-expr-no-block
	else
		- max-value
		- lexer parse-indented-statements start, allow-block, block-kind

-parse-indented-statements expr-ast
	lexer lexer
	start pos
	allow-block bool
	block-kind parse-diag-needs-block-ctx
do
	if allow-block
		lexer parse-indented-statements
	else
		lexer expr-block-not-allowed start, block-kind

-parse-statements-and-dedent expr-ast(lexer lexer)
	res = lexer parse-statements
	lexer take-dedent
	res

-parse-try-block expr-ast(lexer lexer, start pos)
	:: try-ast
	start: start
	tried: lexer parse-indented-statements
	catches: with out in build
		while catch-pos = lexer try-take-newline-then-catch
			out ~= lexer parse-catch-after-keyword catch-pos
-try-parse-catch-as catch-as-ast?(lexer lexer)
	pos = lexer next-start
	if lexer try-take-token as_
		pos, lexer.take-name-and-range

-parse-catch-after-keyword catch-ast(lexer lexer, start pos)
	start: start
	name: lexer try-take-name-and-range
	as_: lexer try-parse-catch-as
	then_: lexer parse-then-or-block

| Returns position of "as"
-try-take-newline-then-as pos?(lexer lexer)
	lexer try-take-newline-then-keyword as_
-try-take-newline-then-catch pos?(lexer lexer)
	lexer try-take-newline-then-keyword catch_
| Returns position of "else"
-try-take-newline-then-else pos?(lexer lexer)
	lexer try-take-newline-then-keyword else_
-try-take-newline-then-keyword pos?(lexer lexer, keyword token)
	if lexer peek newline-same-indent and lexer peek2 keyword
		lexer advance
		keyword-pos = lexer next-start
		lexer advance
		keyword-pos
