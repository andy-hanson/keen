import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	../../util/util
	./parser
	./parse-type
	./parse-util
	./token
	./token-util

parse-fun-expr-body expr-ast?() parser
	if try-take-token newline-indent
		parse-statements-and-dedent

-arg-ctx record
	| Allow things like 'if' that continue into an indented block.
	allowed-block bool
	| Only parse operators if their precedence is greater than this.
	min-precedence-exclusive precedence
-allow-everything arg-ctx()
	true, min-precedence
-precedence enum
	| Dummy value so that 'min-precedence-exclusive' can allow everything
	min-precedence
	is_
	assignment-operator
	else_
	or_
	and_
	equals-expression
	| This is for the , in `1, 2` (calling `1 new 2`), not the comma between arguments in a normal call
	comma
	op-range
	op-tilde
	op-comparison
	op-bar
	op-caret
	op-and
	op-shift
	op-add-subtract
	op-times-divide
	op-pow
-== bool(a precedence, b precedence)
-<=> comparison(a precedence, b precedence)

-name-after-tick-precedence precedence()
	comma

-without-block arg-ctx(a arg-ctx)
	allowed-block: false
	min-precedence-exclusive: a.min-precedence-exclusive
-require-precedence-gt arg-ctx(a arg-ctx, precedence precedence)
	allowed-block: a.allowed-block
	min-precedence-exclusive: max a.min-precedence-exclusive, precedence

-parse-comma-call expr-ast(arg-ctx arg-ctx, first expr-ast) parser
	args = parse-args arg-ctx, first
	with args2 in it-scope args
		list-ast first.start.range, map args2, it.identity

-parse-args expr-ast[](ctx arg-ctx) parser
	parse-args (require-precedence-gt ctx, comma), ()
-parse-args expr-ast[](ctx arg-ctx, first expr-ast?) parser
	do with out in build
	if first
		out ~= first
	assert ctx.min-precedence-exclusive >= comma
	do if peek-token-expression ctx.allowed-block
	out ~= parse-expr-and-calls ctx
	while try-take-token comma
		out ~= parse-expr-and-calls ctx

-peek-token-expression bool(allowed-block bool) parser
	match peek
	as and_
		false
	as brace-right
		false
	as bracket-right
		false
	as catch_
		false
	as comma
		false
	as else_
		false
	as end-of-file
		false
	as paren-right
		false
	as name-after-tick
		false
	as newline-indent
		allowed-block
	as newline-dedent
		false
	as newline-same-indent
		false
	as operator-binary
		false
	as or_
		false
	as then_
		false
	else
		true

-must-parse-next-lines expr-ast(diag parse-diag-expected) parser
	try-parse-next-lines else
		add-diag-at-next-token diag
		bogus-ast next-range
-try-parse-next-lines expr-ast?() parser
	if try-take-token newline-same-indent
		parse-statements

-parse-calls expr-ast(lhs expr-ast, arg-ctx arg-ctx) parser
	match peek
	as and_
		parse-logical-ast lhs, and_, arg-ctx
	as colon-equal
		do if arg-ctx.min-precedence-exclusive < assignment-operator else lhs
		advance
		assignment-ast lhs, prev-start, parse-expr-no-let
	as comma
		do if arg-ctx.min-precedence-exclusive < comma else lhs
		advance
		res = parse-comma-call (require-precedence-gt arg-ctx, comma), lhs
		parse-calls res, arg-ctx
	as else_
		parse-logical-ast lhs, else_, arg-ctx
	as equal
		do if arg-ctx.min-precedence-exclusive < equals-expression else lhs
		advance
		unpack = parse-unpack-option lhs, prev-start, arg-ctx
		parse-calls unpack, arg-ctx
	as name-after-tick
		do if arg-ctx.min-precedence-exclusive < name-after-tick-precedence else lhs
		name = next-symbol
		pos = next-start
		advance
		inner-ctx = require-precedence-gt arg-ctx, name-after-tick-precedence
		args = parse-args inner-ctx, lhs
		call = call-ast infix, (pos + 1, name), args, ()
		parse-calls call, arg-ctx
	as name-colon-equals
		parse-assignment-call lhs, arg-ctx
	as name-equals
		parse-binary-infix lhs, assignment-operator, arg-ctx, next-symbol
	as operator-binary
		name = next-symbol
		parse-binary-infix lhs, name.operator-precedence, arg-ctx, name
	as operator-colon-equals
		parse-assignment-call lhs, arg-ctx
	as operator-equals
		parse-binary-infix lhs, assignment-operator, arg-ctx, next-symbol
	as or_
		parse-logical-ast lhs, or_, arg-ctx
	else
		if callable = as-callable-expr lhs
			args = parse-args arg-ctx
			if is-empty args
				lhs
			else
				parse-calls (to-expr callable, args), arg-ctx
		else
			lhs

-parse-binary-infix expr-ast(lhs expr-ast, precedence precedence, arg-ctx arg-ctx, name symbol) parser
	do if arg-ctx.min-precedence-exclusive < precedence else lhs
	name-pos = next-start
	advance
	args expr-ast[] = lhs, parse-expr-and-calls require-precedence-gt arg-ctx, precedence
	res = with args2 in it-scope-if args, precedence > comma
		call-ast infix, (name-pos, name), args2, ()
	parse-calls res, arg-ctx

-parse-logical-ast expr-ast(lhs expr-ast, kind logical-ast-kind, arg-ctx arg-ctx) parser
	precedence = kind.precedence
	do if arg-ctx.min-precedence-exclusive < precedence else lhs
	before-call = next-start
	advance-may-continue-onto-next-line
	expr = logical-ast lhs, kind, before-call,
		parse-expr-and-calls require-precedence-gt arg-ctx, precedence
	parse-calls expr, arg-ctx

-callable-kind enum(plain, force, not, question)
-== bool(a callable-kind, b callable-kind)
-callable-expr record
	kind callable-kind
	fun-name name-and-range
	type-arg type-ast?
	type-annotation (pos, type-ast)?
-as-callable-expr callable-expr?(a expr-ast)
	match a
	as name-and-range
		plain, a, (), ()
	as call-ast
		do if is-empty a.args
		match a.style
		as prefix
			if is-empty a.args
				plain, a.fun-name, a.type-arg, ()
		as question-name
			question, a.fun-name, a.type-arg, ()
		else
			()
	as force-ast
		if arg = as-callable-expr a.arg and arg.kind == plain
			force, arg.fun-name, arg.type-arg, ()
	as not-ast
		if arg = as-callable-expr a.arg and arg.kind == plain
			not, arg.fun-name, arg.type-arg, ()
	as typed-ast
		if expr = a.expr and arg = as-callable-expr expr and !arg.type-annotation
			arg.kind, arg.fun-name, arg.type-arg, (a.colon-pos, a.type)
	else
		()
-to-expr expr-ast(a callable-expr, args expr-ast[])
	plain = of
		:: expr-ast
		if is-empty args and !a.type-arg
			a.fun-name
		else
			call-ast prefix, a.fun-name, args, a.type-arg
	res expr-ast = match a.kind
	as plain
		plain[]
	as not
		not-ast a.fun-name.start - 1, plain[]
	as force
		force-ast plain[], a.fun-name.end
	as question
		call-ast question-name, a.fun-name, args, a.type-arg
	if colon-pos, type = a.type-annotation
		typed-ast res, colon-pos, type
	else
		res

-parse-assignment-call expr-ast(lhs expr-ast, arg-ctx arg-ctx) parser
	do if arg-ctx.min-precedence-exclusive < assignment-operator else lhs
	advance
	assignment-call-ast (prev-start, prev-symbol), lhs,
		parse-expr-and-calls require-precedence-gt arg-ctx, assignment-operator

-precedence precedence(a logical-ast-kind)
	match a
	as and_ then and_
	as else_ then else_
	as or_ then or_

-operator-precedence precedence(a symbol)
	match a
	as ".."
		op-range
	as "~"
		op-tilde
	as "~~"
		op-tilde
	as "=="
		op-comparison
	as "!="
		op-comparison
	as "<"
		op-comparison
	as "<="
		op-comparison
	as ">"
		op-comparison
	as ">="
		op-comparison
	as "<=>"
		op-comparison
	as "|"
		op-bar
	as "^"
		op-caret
	as "&"
		op-and
	as "<<"
		op-shift
	as ">>"
		op-shift
	as "+"
		op-add-subtract
	as "-"
		op-add-subtract
	as "*"
		op-times-divide
	as "/"
		op-times-divide
	as "%"
		op-times-divide
	as "**"
		op-pow
	as "is"
		is_
	else
		throw unreachable

-try-parse-dots-and-subscripts expr-ast(initial expr-ast) parser
	dot-pos = next-start
	match peek
	as dot
		advance
		try-parse-dots-and-subscripts parse-after-dot initial
	as bracket-left
		advance
		try-parse-dots-and-subscripts parse-subscript initial, dot-pos, false
	as question-bracket
		advance
		try-parse-dots-and-subscripts parse-subscript initial, dot-pos, true
	as colon2
		try-parse-dots-and-subscripts with initial2 in it-scope initial
			advance
			typed-ast initial2, dot-pos, parse-type-for-typed-expr
	as bang
		try-parse-dots-and-subscripts with initial2 in it-scope initial
			advance
			force-ast initial2, dot-pos
	else
		initial

-parse-after-dot expr-ast(initial expr-ast) parser
	call = of style call-ast-style, name name-and-range, type-arg type-ast?
		with initial2 in it-scope-single initial
			call-ast style, name, (initial2,), type-arg
	if name = try-take-name-like-token name-bang
		with x in it-scope call[dot, name, ()]
			force-ast x, name.range.end
	elif name = try-take-name-like-token name-after-question
		call[dot-question, name, ()]
	elif name = try-take-name-and-range-or-diag
		call[dot, name, try-parse-type-arg-for-expr]
	else
		initial

-parse-subscript expr-ast(initial expr-ast, subscript-pos pos, is-question-bracket bool) parser
	arg expr-ast = if try-take-token bracket-right
		list-ast (range subscript-pos), ()
	else
		res = parse-expr-no-block
		_ = take-or-add-diag-expected-token bracket-right, closing-bracket
		res
	with args in it-scope (initial, arg)
		left, right = only2! args
		call-subscript-ast left, is-question-bracket, subscript-pos, right, prev-end

-parse-match expr-ast(start pos) parser
	local = parse-name-equals
	matched = parse-expr-no-block
	cases case-ast[] = with out in build
		while as-pos = try-take-newline-then-as
			out ~= as-pos, parse-case-member, parse-then-or-block
	match-ast start, local, matched, cases, if pos = try-take-newline-then-else
		pos, parse-then-or-block
-parse-name-equals name-and-range?() parser
	if peek name and peek2 equal
		res = try-take-name-and-range!
		advance
		res

-parse-then-or-block expr-ast() parser
	if try-take-token then_
		parse-expr-no-block
	else
		parse-indented-statements

-parse-case-member case-member-ast() parser
	if name = try-take-name-and-range
		as-name-ast name
	elif number = try-take-literal-number
		number
	else
		parse-string-literal-forbid-interpolated parse-diag-match-case-interpolated else
			as-bogus-ast next-range

-parse-string-literal-forbid-interpolated literal-string-ast?(diag parse-diag) parser
	if kind = as-quote-no-interpolated peek
		advance
		kind, prev-range, prev-string
	else
		add-diag-at-next-token diag
		skip-until-newline-no-diag
		()

-as-quote-no-interpolated quote-kind?(a token)
	match a
	as quote-bar-no-interpolated then bar
	as quote-block-no-interpolated then indented
	as quote-double-no-interpolated then double
	else then ()

-parse-quote-no-interpolated expr-ast(kind quote-kind, allowed-block bool) parser
	string literal-string-ast = kind, prev-range, prev-string
	after-quote string, allowed-block

-parse-quote-then-interpolated expr-ast(kind quote-kind, allowed-block bool) parser
	template interpolated-template-part mut[] =
		- prev-range, prev-string
	parts expr-ast mut[] = ()
	res expr-ast = loop
		parts ~= if peek brace-right
			add-diag-at-next-token parse-diag-missing-interpolated
			bogus-ast next-range
		else
			parse-expr-no-block
		do if take-after-interpolated else break bogus-ast range template[0].range.start
		token = take-next-token
		template ~= prev-range, prev-string
		if token == kind.no-interpolated
			break with parts2 in it-scope parts.move-to
				interpolated-ast kind, template.move-to, parts2
		else
			token is kind.then-interpolated
			continue
	after-quote res, allowed-block

-after-quote expr-ast(expr expr-ast, allowed-block bool) parser
	if try-take-token colon and string = as-string-like expr
		parse-single-line-named-new-after-first-name string, allowed-block
	else
		try-parse-dots-and-subscripts expr
-as-string-like name-or-string-ast?(a expr-ast)
	match a
	as literal-string-ast then a
	as interpolated-ast then a
	else then ()

-parse-if expr-ast(start pos, is-else-of-parent bool, allowed-block bool, is-unless bool) parser
	condition = parse-condition false
	then-pos = next-start
	if !is-else-of-parent and try-take-token then_
		then_ = parse-expr-and-calls (false, else_.precedence)
		else-pos = next-start
		else_ expr-ast? = if try-take-token else_ then parse-expr-no-block
		start: start
		is-unless: is-unless
		kind: if else_ then if-then-else else if-then
		is-else-of-parent: false
		second-keyword-pos: then-pos
		third-keyword-pos: if else_ then else-pos else max-value
		condition: condition
		first-branch: then_
		second-branch: else_
	else
		then_ = parse-indented-statements start, allowed-block, if_
		elif-or-else = if allowed-block then try-take-newline-then-elif-or-else
		else_ expr-ast? = if elif-or-else
			match kind elif-or-else
			as elif_
				parse-if elif-or-else.pos, true, allowed-block, false
			as else_
				parse-indented-statements
		start: start
		is-unless: is-unless
		kind: if elif-or-else
			match kind elif-or-else
			as elif_
				if-elif
			as else_
				if-else
		else
			if-without-else
		is-else-of-parent: is-else-of-parent
		second-keyword-pos: elif-or-else.?pos else 0
		third-keyword-pos: max-value
		condition: condition
		first-branch: then_
		second-branch: else_

-elif-or-else-keyword record(kind elif-or-else, pos pos)
-elif-or-else enum(elif_, else_)
-to elif-or-else?(a token)
	match a
	as elif_ then elif_
	as else_ then else_
	else then ()
-try-take-newline-then-elif-or-else elif-or-else-keyword?() parser
	if peek newline-same-indent and kind = peek2.to::elif-or-else?
		advance
		advance
		kind, prev-start

-parse-condition expr-ast(allow-block bool) parser
	if lookahead-equals
		left = parse-destructure-no-require-parens
		equals-pos = next-start
		_ = take-or-add-diag-expected-token equal, equals
		value = parse-expr-and-calls (allow-block, and_.precedence)
		unpack = unpack-option-ast left, equals-pos, value
		and-pos = next-start
		if try-take-token and_
			logical-ast unpack, and_, and-pos, parse-condition allow-block
		else
			parse-calls unpack, (allow-block, else_.precedence)
	else
		parse-expr-and-calls (allow-block, else_.precedence)

-parse-trusted expr-ast(start pos, arg-ctx arg-ctx) parser
	trusted-ast start, parse-expr-and-calls arg-ctx

-parse-single-statement-or-block expr-ast() parser
	if try-take-token newline-indent
		parse-statements-and-dedent
	else
		parse-expr-no-let

-parse-assert-or-forbid assert-or-forbid-ast(is-forbid bool) parser
	advance
	start: prev-start
	is-forbid: is-forbid
	condition: parse-condition true
	thrown: if try-take-token else_
		prev-start, parse-expr-no-let
	after: try-parse-next-lines

-parse-do-for-or-with expr-ast(start pos, kind for-or-with-ast-keyword) parser
	advance
	colon2-pos = next-start
	type type-ast? = if try-take-token colon2
		parse-type-for-typed-expr
	param, in-pos = parse-for-or-with-parameter
	res for-or-with-ast =
		start: start
		keyword: kind
		param: param
		in-pos: in-pos
		then-pos: max-value
		arg: parse-expr-no-block
		body: must-parse-next-lines after-do-line
	if type
		typed-ast res, colon2-pos, type
	else
		res

-parse-for-or-with expr-ast
	start pos
	allowed-block bool
	kind for-or-with-ast-keyword
	block-kind parse-diag-needs-block-ctx
do parser
	colon2-pos = next-start
	type type-ast? = if try-take-token colon2
		parse-type-for-typed-expr
	param, in-pos = parse-for-or-with-parameter
	arg = parse-expr-no-block
	then-pos, body = parse-then-or-indented-statements start, allowed-block, block-kind
	res for-or-with-ast =
		start: start
		keyword: kind
		param: param
		in-pos: in-pos
		then-pos: then-pos
		arg: arg
		body: body
	if type
		typed-ast res, colon2-pos, type
	else
		res

-parse-loop-while-or-until loop-while-or-until-ast(start pos, is-until bool) parser
	advance
	start: start
	is-until: is-until
	condition: parse-condition false
	body: parse-indented-statements
	after: try-parse-next-lines

-take-indent-or-fail-expr expr-ast(cb-indent expr-ast mut()) parser
	take-indent-or-fail-generic cb-indent, it.bogus-ast

-parse-for-or-with-parameter (destructure-ast, pos)() parser
	pos = next-start
	if try-take-token in_
		(void-destructure-ast range pos), pos
	else
		res = parse-destructure-no-require-parens
		end-token-pos = next-start
		_ = take-or-add-diag-expected-token in_, in_
		res, end-token-pos

-skip-rest-of-line-and-return-bogus-no-diag expr-ast(range source-range) parser
	skip-until-newline-no-diag
	bogus-ast range

-skip-rest-of-line-and-return-bogus expr-ast(start pos, diag parse-diag) parser
	range = range start
	add-diag range, diag
	skip-rest-of-line-and-return-bogus-no-diag range

-expr-block-not-allowed expr-ast(start pos, kind parse-diag-needs-block-ctx) parser
	skip-rest-of-line-and-return-bogus start, kind

-if-allow-block expr-ast
	start pos
	allowed-block bool
	kind parse-diag-needs-block-ctx
	cb-allow-block expr-ast mut()
do parser
	if allowed-block
		cb-allow-block[]
	else
		expr-block-not-allowed start, kind

-parse-expr-before-call expr-ast(arg-ctx arg-ctx) parser
	start = next-start
	allowed-block = arg-ctx.allowed-block
	if-allow-block = of kind parse-diag-needs-block-ctx, cb expr-ast mut()
		if-allow-block start, allowed-block, kind, cb
	do if !is-newline-token peek or peek == newline-indent and allowed-block else
		bad-next-token
	match take-next-token
	as paren-left
		if try-take-token paren-right
			expr = list-ast start.range, ()
			try-parse-dots-and-subscripts expr
		else
			try-parse-dots-and-subscripts with inner in it-scope parse-expr-no-block
				_ = take-or-add-diag-expected-token paren-right, closing-paren
				parenthesized-ast start.range, inner
	as quote-bar-no-interpolated
		parse-quote-no-interpolated bar, allowed-block
	as quote-block-no-interpolated
		if allowed-block
			(indented, prev-range, prev-string)::literal-string-ast
		else
			expr-block-not-allowed start, quote_
	as quote-double-no-interpolated
		parse-quote-no-interpolated double, allowed-block
	as quote-bar-then-interpolated
		parse-quote-then-interpolated bar, allowed-block
	as quote-block-then-interpolated
		if allowed-block
			parse-quote-then-interpolated indented, allowed-block
		else
			expr-block-not-allowed start, quote_
	as quote-double-then-interpolated
		try-parse-dots-and-subscripts parse-quote-then-interpolated double, allowed-block
	as bang
		with inner in it-scope parse-expr-before-call arg-ctx.without-block
			not-ast start, inner
	as break_
		loop-break-ast start, if peek-token-expression allowed-block
			parse-expr-and-calls arg-ctx
	as continue_
		loop-continue-ast start
	as for_
		parse-for-or-with start, allowed-block, for_, for_
	as for-star
		parse-for-or-with start, allowed-block, for-star, for-star
	as if_
		parse-if start, false, allowed-block, false
	as it_
		try-parse-dots-and-subscripts it-scope-ast it-ast start
	as in_
		# It's allowed to access 'in' just in order to access Java's `System.in`
		handle-name (start, "in")
	as match_
		if-allow-block[match_, of then parse-match start]
	as name
		handle-name (start, prev-symbol)
	as name-after-bang
		name = prev-symbol
		inner = try-parse-dots-and-subscripts if name == "it"
			it-scope-ast it-ast start + 1
		else
			name-and-range start + 1, name
		with inner2 in it-scope inner
			not-ast start, inner2
	as name-after-question
		call-ast question-name, (name-and-range start + 1, prev-symbol), (), ()
	as name-bang
		try-parse-dots-and-subscripts
			force-ast (name-and-range start, prev-symbol), start.range.end - 1
	as name-colon
		parse-single-line-named-new-after-first-name (start, prev-symbol), allowed-block
	as newline-indent
		assert allowed-block # The 'do if' at top handled the false case
		parse-statements-and-dedent
	as of_
		param destructure-ast = if peek then_ or peek newline-indent
			void-destructure-ast (prev-end, prev-end)
		else
			parse-destructure-no-require-parens
		then-pos, body = parse-then-or-indented-statements start, allowed-block, of_
		lambda-ast start, param, then-pos, body
	as operator-prefix
		operator = prev-symbol
		with arg in it-scope parse-expr-before-call arg-ctx
			call-ast prefix, (start, operator), (arg,), ()
	as literal-number
		try-parse-dots-and-subscripts literal-number range start
	as loop_
		if-allow-block[loop_, of then loop-ast start, parse-indented-statements]
	as shared_
		shared-ast start, parse-expr-and-calls arg-ctx
	as the_
		if take-or-add-diag-expected-token colon2, colon2
			try-parse-dots-and-subscripts the-ast start, parse-type-for-typed-expr
		else
			bogus-ast start.range
	as throw_
		throw-ast start, parse-expr-and-calls arg-ctx
	as trusted_
		parse-trusted start, arg-ctx
	as try_
		if-allow-block[try_, of then parse-try-block start]
	as underscore
		underscore-ast start
	as unless_
		parse-if start, false, allowed-block, true
	as with_
		parse-for-or-with start, allowed-block, with_, with_
	else
		bad-prev-token

-bad-prev-token expr-ast() parser
	add-diag-unexpected-prev-token
	skip-rest-of-line-and-return-bogus-no-diag prev-range
-bad-next-token expr-ast() parser
	add-diag-unexpected-next-token
	skip-rest-of-line-and-return-bogus-no-diag next-range

-handle-name expr-ast(name name-and-range) parser
	if type-arg = try-parse-type-arg-for-expr
		call-ast prefix, name, (), type-arg
	else
		try-parse-dots-and-subscripts name

-parse-expr-no-block expr-ast() parser
	parse-expr-and-all-calls false

-parse-expr-and-all-calls expr-ast(allowed-block bool) parser
	parse-expr-and-calls (allowed-block, min-precedence)

-parse-expr-and-calls expr-ast(arg-ctx arg-ctx) parser
	parse-calls (parse-expr-before-call arg-ctx), arg-ctx

-parse-unpack-option expr-ast(left expr-ast, equals-pos pos, arg-ctx arg-ctx) parser
	destructure = to-destructure left else
		add-diag left.range, parse-diag-equals-left
		ignore-destructure-ast left.start, ()
	right = parse-expr-and-calls require-precedence-gt arg-ctx, and_.precedence
	unpack-option-ast destructure, equals-pos, right

-to-destructure destructure-ast?(a expr-ast)
	match a
	as list-ast
		if is-empty a.parts
			void-destructure-ast a.range
		else
			map-every a.parts, it.expr-ast.?to-destructure
	as name-and-range
		a
	as parenthesized-ast
		to-destructure a.inner
	as underscore-ast
		ignore-destructure-ast a.start, ()
	else
		()

-parse-expr-no-let expr-ast() parser
	parse-expr-and-all-calls true

parse-single-statement-line expr-ast() parser
	start = next-start
	match peek
	as assert_
		parse-assert-or-forbid false
	as colon2
		advance
		type = parse-type
		typed-ast try-parse-next-lines, start, type
	as do_
		advance
		match peek
		as for_
			parse-do-for-or-with start, for_
		as for-star
			parse-do-for-or-with start, for-star
		as if_
			parse-do-if-or-unless start, false
		as loop_
			advance
			loop-ast start, must-parse-next-lines after-do-line
		as unless_
			parse-do-if-or-unless start, true
		as with_
			parse-do-for-or-with start, with_
		else
			add-diag-at-next-token after-do-keyword
			skip-until-newline-no-diag
			bogus-ast range start
	as finally_
		advance
		finally-ast start, parse-single-statement-or-block, must-parse-next-lines after-finally
	as forbid_
		parse-assert-or-forbid true
	as list-dash
		advance
		parse-list-call single
	as list-dash-dash
		advance
		parse-list-call multi
	as trusted_
		advance
		if peek newline-same-indent
			after = must-parse-next-lines after-trusted
			trusted-ast start, after
		else
			parse-trusted start, allow-everything
	as until_
		parse-loop-while-or-until start, true
	as while_
		parse-loop-while-or-until start, false
	else
		if lookahead-equals
			parse-equals
		else
			expr = parse-expr-before-call allow-everything
			if expr.call-named-ast and expr.names.size == 1
				parse-multi-line-named-new expr
			else
				parse-calls expr, allow-everything

-parse-do-if-or-unless expr-ast(start pos, is-unless bool) parser
	advance
	condition = parse-condition true
	else-pos = next-start
	else_ expr-ast? = if try-take-token else_ then parse-expr-no-let
	start: start
	is-unless: is-unless
	kind: if else_ then do-if-else else do-if
	is-else-of-parent: false
	second-keyword-pos: else-pos
	third-keyword-pos: max-value
	condition: condition
	first-branch: else_
	second-branch: must-parse-next-lines after-do-line

-list-part-kind enum(single, multi)
-try-take-list-part-kind list-part-kind?() parser
	do if res list-part-kind = match peek
	as list-dash
		single
	as list-dash-dash
		multi
	else
		()
	advance
	res

-parse-single-line-named-new-after-first-name expr-ast(first-name name-or-string-ast, allowed-block bool) parser
	value = parse-expr-and-calls (allowed-block, comma)
	if try-take-token comma
		if second-name = try-take-name-or-string
			parse-single-line-named-new-after-second-name first-name, value, second-name, allowed-block
		else
			value2 = parse-comma-call (allowed-block, comma), value
			call-named-ast (first-name,), (value2,)
	else
		value2 = parse-calls value, (allowed-block, min-precedence)
		call-named-ast (first-name,), (value2,)

-parse-single-line-named-new-after-second-name call-named-ast
	first-name name-or-string-ast
	first-value expr-ast
	second-name name-or-string-ast
	allowed-block bool
do parser
	second-value = parse-expr-and-calls (allowed-block, comma)
	names name-or-string-ast mut[] = first-name, second-name
	values expr-ast mut[] = first-value, second-value
	while try-take-token comma
		if name = take-name-or-string
			names ~= name
			values ~= parse-expr-and-calls (allowed-block, comma)
	names.move-to, values.move-to

-parse-multi-line-named-new call-named-ast(initial call-named-ast) parser
	names name-or-string-ast mut[] = initial.names.to
	values expr-ast mut[] = initial.args.to
	while try-take-token newline-same-indent
		if name = take-name-or-string
			names ~= name
			values ~= parse-expr-no-let
	names.move-to, values.move-to

-try-take-name-or-string name-or-string-ast?() parser
	try-take-name-colon-and-range or
		if peek quote-double-no-interpolated or peek quote-double-then-interpolated
			string = parse-string-literal-forbid-interpolated parse-diag-named-new-key
			if string
				_ = take-or-add-diag-expected-token colon, colon
			string

-take-name-or-string name-or-string-ast?() parser
	try-take-name-colon-and-range or
		string = parse-string-literal-forbid-interpolated parse-diag-named-new-key
		if string
			_ = take-or-add-diag-expected-token colon, colon
		string

-parse-list-call expr-ast(first-part list-part-kind) parser
	start = prev-start
	parts list-ast-part[] = with out in build
		out ~= list-part first-part, parse-expr-no-let
		while try-take-token newline-same-indent
			if kind = try-take-list-part-kind
				out ~= list-part kind, parse-expr-no-let
			else
				add-diag-at-next-token parse-diag-list-call-needs-hyphen
				skip-until-newline-no-diag
	list-ast start.range, parts
-list-part list-ast-part(kind list-part-kind, expr expr-ast)
	match kind
	as single
		expr
	as multi
		list-ast-part-multi expr

-parse-equals expr-ast() parser
	start = next-start
	if try-take-token the_
		parse-let-the start
	elif try-take-token try_
		parse-try-let start
	else
		left = parse-destructure-no-require-parens
		_ = take-or-add-diag-expected-token-and-may-continue-onto-next-line equal, equals
		init = parse-expr-no-let
		then_ = try-parse-next-lines
		let-ast left, init, then_

-parse-let-the expr-ast(start pos) parser
	type = parse-type
	if take-or-add-diag-expected-token equal, equals
		let-the-ast start, type, parse-expr-no-let, try-parse-next-lines
	else
		skip-until-newline-no-diag
		bogus-ast range start

-parse-try-let try-let-ast(start pos) parser
	destructure = parse-destructure-no-require-parens
	_ = take-or-add-diag-expected-token-and-may-continue-onto-next-line equal, equals
	value = parse-expr-no-block
	catch-pos = next-start
	_ = take-or-add-diag-expected-token catch_, catch_
	catch_ = parse-catch-after-keyword catch-pos
	start, destructure, value, catch_, try-parse-next-lines

-parse-statements expr-ast() parser
	res mut = parse-single-statement-line
	while try-take-token newline-same-indent
		res seq-ast:= parse-single-statement-line
	res

-parse-indented-statements expr-ast() parser
	take-indent-or-fail-expr of
		parse-statements-and-dedent

# Returns position of 'then' (or max-value no 'then' keyword) and the body.
-parse-then-or-indented-statements (pos, expr-ast)
	start pos
	allow-block bool
	block-kind parse-diag-needs-block-ctx
do parser
	then-pos = next-start
	if try-take-token then_
		then-pos, parse-expr-no-block
	else
		- max-value
		- parse-indented-statements start, allow-block, block-kind

-parse-indented-statements expr-ast
	start pos
	allow-block bool
	block-kind parse-diag-needs-block-ctx
do parser
	if allow-block
		parse-indented-statements
	else
		expr-block-not-allowed start, block-kind

-parse-statements-and-dedent expr-ast() parser
	res = parse-statements
	take-dedent
	res

-parse-try-block try-ast(start pos) parser
	start: start
	tried: parse-indented-statements
	catches: with out in build
		while catch-pos = try-take-newline-then-catch
			out ~= parse-catch-after-keyword catch-pos
-try-parse-catch-as catch-as-ast?() parser
	if try-take-token as_
		prev-start, take-name-and-range

-parse-catch-after-keyword catch-ast(start pos) parser
	start: start
	name: try-take-name-and-range
	as_: try-parse-catch-as
	then_: parse-then-or-block

-try-take-newline-then-as pos?() parser
	try-take-newline-then-keyword as_
-try-take-newline-then-catch pos?() parser
	try-take-newline-then-keyword catch_
-try-take-newline-then-else pos?() parser
	try-take-newline-then-keyword else_
| Returns position of keyword
-try-take-newline-then-keyword pos?(keyword token) parser
	if peek newline-same-indent and peek2 keyword
		advance
		advance
		prev-start
