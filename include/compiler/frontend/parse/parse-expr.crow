import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	../../util/util
	./lexer
	./lex-string
	./lex-token
	./parse-string
	./parse-type
	./parse-util
	./token

parse-fun-expr-body expr-ast(lexer lexer)
	if lexer try-take-token newline-indent
		lexer parse-statements-and-dedent
	else
		lexer empty-ast

-allowed-block enum(no, yes) # TODO: this is a dumb enum ----------------------------------------------------------------------
-== bool(a allowed-block, b allowed-block)
-allowed-calls record(min-precedence-exclusive int)
-allow-all-calls allowed-calls()
	min-value,
-arg-ctx record
	| Allow things like 'if' that continue into an indented block.
	allowed-block allowed-block
	allowed-calls allowed-calls

-require-precedence-gt arg-ctx(a arg-ctx, precedence int)
	a.allowed-block, ((a.allowed-calls.min-precedence-exclusive max precedence),)

-parse-args expr-ast[](lexer lexer, ctx arg-ctx, first expr-ast)
	with out : build
		out ~= first
		assert ctx.allowed-calls.min-precedence-exclusive >= comma-precedence
		if lexer peek-token-expression ctx.allowed-block
			out ~= lexer parse-expr-and-calls ctx
			while lexer try-take-token-and-may-continue-onto-next-line comma
				out ~= lexer parse-expr-and-calls ctx

-peek-token-expression bool(lexer lexer, allowed-block allowed-block)
	lexer.get-peek-token-and-data is-expression-start-token allowed-block

-is-expression-start-token bool(a token-and-data, allowed-block allowed-block)
	match a.token
	as assert_
		true
	as bang
		true
	as bracket-left
		true
	as break_
		true
	as continue_
		true
	as do_
		true
	as extern_
		true
	as forbid_
		true
	as guard_
		true
	as if_
		true
	as finally_
		true
	as for_
		true
	as for-star
		true
	as literal-float
		true
	as literal-integral
		true
	as loop_
		true
	as match_
		true
	as name
		true
	as name-after-bang
		true
	as name-bang
		true
	as newline-indent
		match allowed-block
		as no
			false
		as yes
			true
	as paren-left
		true
	as quote-bar
		true
	as quote-double
		true
	as quote-double3
		true
	as shared_
		true
	as throw_
		true
	as trusted_
		true
	as try_
		true
	as underscore
		true
	as unless_
		true
	as with_
		true
	as operator
		a.as-symbol is-prefix-unary-operator
	else
		false
-is-prefix-unary-operator bool(a symbol)
	a == "!" or a == "-" or a == "~"

-parse-assignment expr-ast(lexer lexer, left expr-ast, assignment-pos pos)
	right = lexer parse-expr-no-let
	left assignment-ast assignment-pos, right

-parse-arg-or-empty expr-ast(lexer lexer)
	if lexer peek-end-of-line
		lexer empty-ast
	else
		lexer parse-expr-no-let

-parse-next-lines-or-empty expr-ast(lexer lexer)
	if lexer try-take-token newline-same-indent
		lexer parse-statements
	else
		lexer empty-ast

-empty-ast expr-ast(lexer lexer)
	lexer.range-at-char empty-ast

-parse-calls expr-ast(lexer lexer, start pos, lhs expr-ast, arg-ctx arg-ctx)
	before-call = lexer cur-pos
	precedence = arg-ctx.allowed-calls min-precedence-exclusive
	if question-equals-precedence > precedence and lexer try-take-token question-equal
		unpack = lexer parse-unpack-option lhs, before-call, arg-ctx
		lexer parse-calls start, unpack, arg-ctx
	elif comma-precedence > precedence and lexer try-take-token comma
		args = lexer parse-args (arg-ctx require-precedence-gt comma-precedence), lhs
		range = lexer range start
		res = range call-ast comma, before-call, (range.start, "new"), args, ()
		lexer parse-calls start, res, arg-ctx
	elif and-precedence > precedence and lexer.get-peek-token == and_
		and-pos = lexer cur-pos
		_ = lexer take-next-token-may-continue-onto-next-line
		then_ = lexer parse-expr-and-calls do arg-ctx require-precedence-gt and-precedence
		else-pos = lexer cur-pos
		else_ expr-ast? = if lexer try-take-token else_
			lexer parse-expr-and-calls do arg-ctx require-precedence-gt and-precedence
		kind if-ast-kind = if _ ?= else_
			and-else
		else
			and_
		expr = start if-ast kind, false, and-pos, else-pos, lhs, then_, else_
		lexer parse-calls start, expr, arg-ctx
	elif log ?= lexer.get-peek-token as-logical-ast-kind and log.precedence > precedence
		_ = lexer take-next-token-may-continue-onto-next-line
		expr = lhs logical-ast log, before-call,
			lexer parse-expr-and-calls do arg-ctx require-precedence-gt log.precedence
		lexer parse-calls start, expr, arg-ctx
	else
		lexer parse-named-calls start, lhs, arg-ctx

-as-logical-ast-kind logical-ast-kind?(token token)
	match token
	as else_
		else_
	as or_
		or_
	else
		()

-parse-named-calls expr-ast(lexer lexer, start pos, lhs expr-ast, arg-ctx arg-ctx)
	pos = lexer cur-pos
	guard name ?= lexer try-take-name-and-precedence arg-ctx : lhs
	fun-token = name token
	fun-name name-and-range = pos + (fun-token == name-after-bang).to, name.name
	precedence = name.precedence
	assignment assignment-kind? = match fun-token
	as name-or-operator-colon-equals
		replace
	as name-or-operator-equals
		in-place
	else
		()
	is-operator = precedence != 0
	# TODO: don't do this for operators ------------------------------------------------------------------------------------
	type-arg = lexer try-parse-type-arg-for-expr
	inner-ctx = arg-ctx require-precedence-gt precedence
	args expr-ast[] = if is-operator
		lhs, (lexer parse-expr-and-calls inner-ctx)
	else
		lexer parse-args inner-ctx, lhs
	expr expr-ast = if x ?= assignment
		match x
		as in-place
			lexer range start call-ast infix, 0, fun-name, args, ()
		else
			args.size is 2
			fun-name assignment-call-ast args[0], args[1]
	else
		lexer range start call-ast infix, 0, fun-name, args, type-arg
	res = if fun-token == name-after-bang
		lexer range start make-augment fun-name.range.start - 1, "not", expr
	elif fun-token == name-bang
		expr force-ast fun-name.range.end
	else
		expr
	lexer parse-calls start, res, arg-ctx

-make-augment expr-ast(range source-range, pos pos, name symbol, inner expr-ast)
	range call-ast augment, pos, (pos, name), (inner,), ()

-name-and-precedence record
	token token
	name symbol
	precedence int
-try-take-name-and-precedence name-and-precedence?(lexer lexer, arg-ctx arg-ctx)
	x = lexer get-peek-token-and-data
	guard x is-symbol
	precedence = x.as-symbol symbol-precedence (x.token == name-or-operator-equals or x.token == name-or-operator-colon-equals)
	guard precedence > arg-ctx.allowed-calls.min-precedence-exclusive
	_ = if x.token token-has-continuation
		lexer take-next-token-may-continue-onto-next-line
	else
		lexer take-next-token
	x.token, x.as-symbol, precedence

-token-has-continuation bool(a token)
	a == operator or a == name-or-operator-colon-equals or a == name-or-operator-equals

-assignment-kind enum
	| foo=
	in-place
	| foo:=
	replace

| This is for the , in `1, 2` (calling `1 new 2`), not the comma between arguments in a normal call
-comma-precedence int()
	0
-and-precedence int()
	-2
-precedence int(a logical-ast-kind)
	match a
	as else_
		-4
	as or_
		-3
-question-equals-precedence int()
	-1

-name-precedence int()
	0
-symbol-precedence int(a symbol, is-assignment bool)
	guard !is-assignment : -5
	match a
	as ".."
		1
	as "~"
		2
	as "~~"
		2
	as "=="
		3
	as "!="
		3
	as "<"
		3
	as "<="
		3
	as ">"
		3
	as ">="
		3
	as "<=>"
		3
	as "|"
		4
	as "^"
		5
	as "&"
		6
	as "<<"
		7
	as ">>"
		7
	as "+"
		8
	as "-"
		8
	as "*"
		9
	as "/"
		9
	as "%"
		9
	as "**"
		10
	else
		name-precedence

-try-parse-dots-and-subscripts expr-ast(lexer lexer, initial expr-ast)
	start = initial.range.start
	dot-pos = lexer cur-pos
	token = lexer get-peek-token
	# TODO: use a match -----------------------------------------------------------------------------------------------------------
	if token == dot or token == question-dot
		lexer must-take-token token
		lexer handle-dot-or-question-dot initial, start, dot-pos, token == question-dot
	elif token == bracket-left or token == question-bracket
		lexer must-take-token token
		lexer parse-subscript initial, dot-pos, token == question-bracket
	elif token == colon2
		lexer must-take-token colon2
		type = lexer parse-type-for-typed-expr
		lexer try-parse-dots-and-subscripts do initial typed-ast dot-pos, type
	elif token == bang
		lexer must-take-token bang
		lexer try-parse-dots-and-subscripts do initial force-ast dot-pos
	else
		initial

-handle-dot-or-question-dot expr-ast(lexer lexer, initial expr-ast, start pos, dot-pos pos, is-question-dot bool)
	call expr-ast mut(name name-and-range, type-arg type-ast?) = (name, type-arg) =>
		(lexer range start) call-ast (is-question-dot and question-dot else dot), dot-pos, name, (initial,), type-arg
	lexer try-parse-dots-and-subscripts if lexer peek-token name-bang
		name-start = lexer cur-pos
		name name-and-range = name-start, lexer.get-peek-token-and-data.as-symbol
		lexer must-take-token name-bang
		call[name, ()] force-ast name.range.end
	elif name ?= lexer try-take-name-and-range-or-diag
		call[name, lexer.try-parse-type-arg-for-expr]
	else
		initial

-parse-subscript expr-ast(lexer lexer, initial expr-ast, subscript-pos pos, is-question-bracket bool)
	arg expr-ast = if lexer try-take-token bracket-right
		lexer range subscript-pos call-ast empty-parens, 0, (subscript-pos, "new"), (), ()
	else
		res = lexer parse-expr-no-block
		_ = lexer take-or-add-diag-expected-token bracket-right, closing-bracket
		res
	lexer try-parse-dots-and-subscripts
		:: call-ast
		range: lexer range initial.range.start
		style: is-question-bracket and question-subscript else subscript
		keyword-pos: subscript-pos
		fun-name: (subscript-pos, "subscript")
		args: (initial, arg)
		type-arg: ()

-parse-match expr-ast(lexer lexer, start pos)
	matched = lexer parse-expr-no-block
	cases case-ast[] = with out : build
		loop
			if as-pos ?= lexer try-take-newline-then-as
				member = lexer parse-case-member
				then_ = lexer parse-indented-statements
				out ~= as-pos, member, then_
				continue
			else
				break
	start match-ast matched, cases, if pos ?= lexer try-take-newline-then-else
		pos, lexer.parse-optional-destructure, lexer.parse-indented-statements

-parse-case-member case-member-ast(lexer lexer)
	if name ?= lexer try-take-name-and-range
		name as-name-ast lexer.parse-optional-destructure
	elif number ?= lexer try-take-literal-integral
		number
	else
		lexer parse-string-literal-for-match-case

-parse-optional-destructure destructure-ast?(lexer lexer)
	unless lexer peek-end-of-line or lexer peek-token colon
		lexer parse-destructure-no-require-parens

-parse-string-literal-for-match-case case-member-ast(lexer lexer)
	start = lexer cur-pos
	if lexer take-or-add-diag-expected-token quote-double, match-case
		part = lexer take-initial-string-part double
		match part after
		as done
			()
		as lbrace
			lexer add-diag (lexer range start), parse-diag-match-case-interpolated
		lexer range start as-string-ast part.text
	else
		lexer skip-until-newline-no-diag
		lexer range-for-cur-token start as-bogus-ast

-parse-if expr-ast(lexer lexer, start pos, is-else-of-parent bool, allowed-block allowed-block)
	condition = lexer parse-expr-no-block
	match allowed-block
	as no
		lexer expr-block-not-allowed start, if_
	as yes
		then_ = lexer parse-indented-statements
		elif-or-else = lexer try-take-newline-then-elif-or-else
		else_ expr-ast? = if x ?= elif-or-else
			match x kind
			as elif_
				lexer parse-if x.pos, true, allowed-block
			as else_
				lexer parse-indented-statements
		kind = if x ?= elif-or-else
			match x kind
			as elif_
				if-elif
			as else_
				if-else
		else
			if-without-else
		start if-ast kind, is-else-of-parent, start, (elif-or-else?.pos else 0), condition, then_, else_

-parse-unless expr-ast(lexer lexer, start pos, allowed-block allowed-block)
	condition = lexer parse-expr-no-block
	body = match allowed-block
	as no
		lexer expr-block-not-allowed start, unless_
	as yes
		lexer parse-indented-statements
	start if-ast unless_, false, start, 0, condition, body, ()

-parse-trusted expr-ast(lexer lexer, start pos, allowed-block allowed-block)
	start trusted-ast do lexer parse-expr-and-all-calls allowed-block

-parse-assert-or-forbid expr-ast(lexer lexer, start pos, is-forbid bool)
	condition = lexer parse-expr-no-block
	colon-pos = lexer cur-pos
	thrown assert-or-forbid-thrown-ast? = if lexer try-take-token-and-may-continue-onto-next-line colon
		colon-pos, lexer.parse-expr-no-let
	after = lexer parse-next-lines-or-empty
	start assert-or-forbid-ast is-forbid, condition, thrown, after

-parse-finally expr-ast(lexer lexer, start pos)
	right = lexer parse-single-statement-or-block
	below = lexer parse-next-lines-or-empty
	start finally-ast right, below

-parse-single-statement-or-block expr-ast(lexer lexer)
	if lexer try-take-token newline-indent
		lexer parse-statements-and-dedent
	else
		lexer parse-actually-single-statement-line

-parse-guard expr-ast(lexer lexer, start pos)
	condition = lexer parse-expr-no-block
	colon-pos = lexer cur-pos
	first-branch expr-ast? = if lexer try-take-token-and-may-continue-onto-next-line colon
		lexer parse-expr-no-let
	second-branch = lexer parse-next-lines-or-empty
	kind = _ ?= first-branch and guard-with-colon else guard-without-colon
	start if-ast kind, false, start, colon-pos, condition, first-branch, second-branch

-parse-for-or-with expr-ast
	lexer lexer
	start pos
	allowed-block allowed-block
	kind for-or-with-ast-keyword
	block-kind parse-diag-needs-block-ctx
do
	param, colon = lexer parse-for-or-with-parameter colon, colon
	arg = lexer parse-expr-no-block
	if lexer try-take-token semicolon
		start for-or-with-ast kind, param, colon, arg, lexer.parse-expr-no-block, ()
	else
		match allowed-block
		as no
			lexer expr-block-not-allowed start, block-kind
		as yes
			lexer take-indent-or-fail-expr () =>
				body = lexer parse-statements-and-dedent
				else_ expr-ast? = if _ ?= lexer try-take-newline-then-else
					lexer parse-indented-statements
				start for-or-with-ast kind, param, colon, arg, body, else_

-parse-loop-while-or-until expr-ast(lexer lexer, start pos, is-until bool)
	condition = lexer parse-expr-no-block
	body = lexer parse-indented-statements
	start loop-while-or-until-ast is-until, condition, body, lexer.parse-next-lines-or-empty

-take-indent-or-fail-expr expr-ast(lexer lexer, cb-indent expr-ast mut())
	lexer take-indent-or-fail-generic cb-indent, range => range bogus-ast

-parse-lambda-with-parenthesized-parameters expr-ast(lexer lexer, start pos, allowed-block allowed-block)
	parameter = lexer parse-destructure-require-parens
	arrow-pos = lexer cur-pos
	_ = lexer take-or-add-diag-expected-token arrow-lambda, lambda-arrow
	lexer parse-lambda-after-arrow start, allowed-block, parameter, arrow-pos

-parse-for-or-with-parameter (destructure-ast, pos)(lexer lexer, end-token token, expected-end-token parse-diag-expected) # TODO: INLINE
	pos = lexer cur-pos
	if lexer try-take-token end-token
		(lexer range pos void-destructure-ast), pos
	else
		res = lexer parse-destructure-no-require-parens
		end-token-pos = lexer cur-pos
		_ = lexer take-or-add-diag-expected-token-and-may-continue-onto-next-line end-token, expected-end-token
		res, end-token-pos

-parse-lambda-after-name-and-arrow expr-ast
	lexer lexer
	start pos
	allowed-block allowed-block
	param-name symbol
	arrow-pos pos
do
	param = (start, param-name) single-destructure-ast (), ()
	lexer parse-lambda-after-arrow start, allowed-block, param, arrow-pos

-parse-lambda-after-arrow expr-ast
	lexer lexer
	start pos
	allowed-block allowed-block
	parameter destructure-ast
	arrow-pos pos
do
	start lambda-ast parameter, arrow-pos, do lexer parse-expr-and-all-calls allowed-block # TODO: inline this function! ------

-skip-rest-of-line-and-return-bogus-no-diag expr-ast(lexer lexer, start pos)
	lexer skip-until-newline-no-diag
	lexer range-for-cur-token start bogus-ast

-skip-rest-of-line-and-return-bogus expr-ast(lexer lexer, start pos, diag parse-diag)
	lexer add-diag (lexer range start), diag
	lexer skip-rest-of-line-and-return-bogus-no-diag start

-expr-block-not-allowed expr-ast(lexer lexer, start pos, kind parse-diag-needs-block-ctx)
	lexer skip-rest-of-line-and-return-bogus start, kind

-if-allow-block expr-ast
	lexer lexer
	start pos
	allowed-block allowed-block
	kind parse-diag-needs-block-ctx
	cb-allow-block expr-ast mut()
do
	match allowed-block
	as no
		lexer expr-block-not-allowed start, kind
	as yes
		cb-allow-block[]

-parse-expr-before-call expr-ast(lexer lexer, allowed-block allowed-block)
	start = lexer cur-pos
	guard lexer !lookahead-lambda : lexer parse-lambda-with-parenthesized-parameters start, allowed-block
	if-allow-block expr-ast mut(kind parse-diag-needs-block-ctx, cb expr-ast mut()) = (kind, cb) =>
		lexer if-allow-block start, allowed-block, kind, cb
	peek = lexer get-peek-token
	guard peek !is-newline-token or peek == newline-indent and allowed-block == yes :
		lexer bad-token start, lexer.get-peek-token-and-data
	token = lexer take-next-token
	match token token
	as paren-left
		if lexer try-take-token paren-right
			# TODO: range is wrong
			expr = lexer range start call-ast empty-parens, 0, (start, "new"), (), ()
			lexer try-parse-dots-and-subscripts expr
		else
			inner = lexer parse-expr-no-block
			_ = lexer take-or-add-diag-expected-token paren-right, closing-paren
			lexer try-parse-dots-and-subscripts inner
	as quote-double
		quote = lexer parse-string start, double, () => lexer parse-expr-no-block
		lexer try-parse-dots-and-subscripts quote
	as quote-double3
		quote = lexer parse-string start, double3, () => lexer parse-expr-no-block
		lexer try-parse-dots-and-subscripts quote
	as bang
		inner = lexer parse-expr-before-call no
		lexer range start call-ast prefix-bang, 0, (start, "not"), (inner,), ()
	as break_
		start loop-break-ast lexer.parse-arg-or-empty
	as continue_
		start loop-continue-ast
	as do_
		lexer parse-expr-and-all-calls allowed-block
	as extern_
		lexer parse-extern start
	as if_
		lexer parse-if start, false, allowed-block
	as for_
		lexer parse-for-or-with start, allowed-block, for_, for_
	as for-star
		lexer parse-for-or-with start, allowed-block, for-star, for-star
	as match_
		if-allow-block[match_, () => lexer parse-match start]
	as name
		name = token as-symbol
		arrow-pos = lexer cur-pos
		if lexer try-take-token arrow-lambda
			lexer parse-lambda-after-name-and-arrow start, allowed-block, name, arrow-pos
		else
			lexer handle-name start, (start, name)
	as name-after-bang
		inner = lexer try-parse-dots-and-subscripts do start + 1 name-and-range token.as-symbol
		lexer range start call-ast prefix-bang, start, (start, "not"), (inner,), ()
	as name-bang
		lexer try-parse-dots-and-subscripts
			start name-and-range token.as-symbol force-ast (lexer range start).end - 1
	as newline-indent
		assert allowed-block == yes # The guard at top handled the false case
		lexer parse-statements-and-dedent
	as operator
		operator = token as-symbol
		if operator is-prefix-unary-operator
			lexer handle-prefix-unary-operator allowed-block, start, operator
		else
			lexer bad-token start, token
	as literal-float
		lexer try-parse-dots-and-subscripts
			lexer range start literal-float-and-range token.as-literal-float
	as literal-integral
		lexer try-parse-dots-and-subscripts
			lexer range start literal-integral-and-range token.as-literal-integral
	as loop_
		if-allow-block[loop_, () => start loop-ast lexer.parse-indented-statements]
	as shared_
		start shared-ast do lexer parse-expr-and-all-calls allowed-block
	as throw_
		start throw-ast do lexer parse-expr-and-all-calls allowed-block
	as trusted_
		lexer parse-trusted start, allowed-block
	as try_
		if-allow-block[try_, () => lexer parse-try-block start]
	as underscore
		arrow-pos = lexer cur-pos
		if lexer try-take-token arrow-lambda
			lexer parse-lambda-after-name-and-arrow start, allowed-block, "_", arrow-pos
		else
			start underscore-ast
	as unless_
		lexer parse-unless start, allowed-block
	as with_
		lexer parse-for-or-with start, allowed-block, with_, with_
	else
		lexer bad-token start, token

-bad-token expr-ast(lexer lexer, start pos, token token-and-data)
	lexer add-diag-unexpected-cur-token start, token
	lexer skip-rest-of-line-and-return-bogus-no-diag start

-handle-prefix-unary-operator expr-ast(lexer lexer, allowed-block allowed-block, start pos, operator symbol)
	arg = lexer parse-expr-before-call allowed-block
	lexer range start call-ast prefix-operator, 0, (start, operator), (arg,), ()

-parse-extern expr-ast(lexer lexer, start pos)
	names = if lexer try-take-token paren-left
		res = lexer take-comma-separated-names-diag-trailing-comma
		_ = lexer take-or-add-diag-expected-token paren-right, closing-paren
		res
	else
		- lexer take-name-and-range
	lexer range start extern-ast names

-handle-name expr-ast(lexer lexer, start pos, name name-and-range)
	if type-arg ?= lexer try-parse-type-arg-for-expr
		lexer range start call-ast single, 0, name, (), type-arg
	else
		lexer try-parse-dots-and-subscripts name

-parse-expr-no-block expr-ast(lexer lexer)
	lexer parse-expr-and-all-calls no

-parse-expr-and-all-calls expr-ast(lexer lexer, allowed-block allowed-block)
	lexer parse-expr-and-calls (allowed-block, allow-all-calls)

-parse-expr-and-calls expr-ast(lexer lexer, arg-ctx arg-ctx)
	start = lexer cur-pos
	left = lexer parse-expr-before-call arg-ctx.allowed-block
	lexer parse-calls start, left, arg-ctx

-parse-unpack-option expr-ast(lexer lexer, left expr-ast, question-equal-pos pos, arg-ctx arg-ctx)
	l = left to-destructure else
		lexer add-diag left.range, parse-diag-question-equals-left
		(left.start, "_") single-destructure-ast (), ()
	l unpack-option-ast question-equal-pos,
		lexer parse-expr-and-calls do arg-ctx require-precedence-gt and-precedence

-to-destructure destructure-ast?(a expr-ast)
	match a
	as call-ast x
		x.style == comma and x.args map-or-none arg => arg to-destructure
	as name-and-range x
		x single-destructure-ast (), ()
	as underscore-ast x
		(x.start, "_") single-destructure-ast (), ()
	else
		()

-parse-expr-no-let expr-ast(lexer lexer)
	lexer parse-expr-and-all-calls yes

parse-single-statement-line expr-ast(lexer lexer)
	start = lexer cur-pos
	match lexer get-peek-token
	as colon2
		lexer must-take-token colon2
		type = lexer parse-type
		after = lexer parse-next-lines-or-empty
		after typed-ast start, type
	as finally_
		lexer must-take-token finally_
		lexer parse-finally start
	as guard_
		lexer must-take-token guard_
		lexer parse-guard start
	as trusted_
		lexer must-take-token trusted_
		if lexer peek-token newline-same-indent
			after = lexer parse-next-lines-or-empty
			start trusted-ast after
		else
			lexer parse-trusted start, yes
	as until_
		lexer must-take-token until_
		lexer parse-loop-while-or-until start, true
	as while_
		lexer must-take-token while_
		lexer parse-loop-while-or-until start, false
	else
		if lexer lookahead-equals
			lexer parse-equals
		else
			lexer parse-actually-single-statement-line
-parse-actually-single-statement-line expr-ast(lexer lexer)
	start = lexer cur-pos
	match lexer get-peek-token
	as assert_
		lexer must-take-token assert_
		lexer parse-assert-or-forbid start, false
	as forbid_
		lexer must-take-token forbid_
		lexer parse-assert-or-forbid start, true
	else
		if lexer lookahead-name-colon
			lexer parse-named-call start
		elif first-part ?= lexer try-take-list-part-kind
			lexer parse-list-call start, first-part
		else
			expr = lexer parse-expr-before-call yes
			assignment-pos = lexer cur-pos
			if lexer try-take-token-and-may-continue-onto-next-line colon-equal
				lexer parse-assignment expr, assignment-pos
			else
				lexer parse-calls start, expr, (yes, allow-all-calls)

-parse-named-call expr-ast(lexer lexer, start pos)
	names name-and-range mut[] = ()
	values expr-ast mut[] = ()
	lexer parse-with-separator newline-same-indent, () =>
		name = lexer take-name-and-range
		if lexer take-or-add-diag-expected-token-and-skip-rest-of-line colon, named-argument
			names ~= name
			values ~= lexer parse-expr-no-let
	if names is-empty
		lexer range start bogus-ast
	else
		names.move-to call-named-ast values.move-to

-parse-list-call expr-ast(lexer lexer, start pos, first-part list-part-kind)
	parts list-ast-part[] = with out : build
		out ~= first-part list-part lexer.parse-expr-no-let
		while lexer try-take-token newline-same-indent
			if kind ?= lexer try-take-list-part-kind
				out ~= kind list-part lexer.parse-expr-no-let
			else
				lexer add-diag-at-char parse-diag-list-call-needs-hyphen
				lexer skip-until-newline-no-diag
	range = lexer range start
	if all-singles ?= parts map-or-none part => part.expr-ast
		range: range
		style: list
		keyword-pos: max-value
		fun-name: start, "new"
		args: all-singles
		type-arg: ()
	else
		range list-ast parts
-list-part list-ast-part(kind list-part-kind, expr expr-ast)
	match kind
	as single
		expr
	as multi
		expr list-ast-part-multi

-parse-equals expr-ast(lexer lexer)
	start = lexer cur-pos
	if lexer try-take-token try_
		lexer parse-try-let start
	else
		left = lexer parse-destructure-no-require-parens
		_ = lexer take-or-add-diag-expected-token-and-may-continue-onto-next-line equal, equals
		init = lexer parse-expr-no-let
		then_ = lexer parse-next-lines-or-empty
		left let-ast init, then_

-parse-try-let expr-ast(lexer lexer, start pos)
	destructure = lexer parse-destructure-no-require-parens
	_ = lexer take-or-add-diag-expected-token-and-may-continue-onto-next-line equal, equals
	value = lexer parse-expr-no-block
	catch-pos = lexer cur-pos
	_ = lexer take-or-add-diag-expected-token catch_, catch_
	catch-member = lexer parse-case-member
	catch_ = if lexer try-take-token-and-may-continue-onto-next-line colon
		lexer parse-expr-no-let
	else
		lexer empty-ast
	then_ = lexer parse-next-lines-or-empty
	start try-let-ast destructure, value, catch-pos, catch-member, catch_, then_

-parse-statements expr-ast(lexer lexer)
	lexer parse-statements-recur lexer.cur-pos, lexer.parse-single-statement-line

-parse-statements-recur expr-ast(lexer lexer, start pos, res expr-ast)
	if lexer try-take-token newline-same-indent
		next-line = lexer parse-single-statement-line
		lexer parse-statements-recur start, do res seq-ast next-line
	else
		res

-parse-indented-statements expr-ast(lexer lexer)
	lexer take-indent-or-fail-expr () =>
		lexer parse-statements-and-dedent
	
-parse-statements-and-dedent expr-ast(lexer lexer)
	res = lexer parse-statements
	lexer take-dedent
	res

-parse-try-block expr-ast(lexer lexer, start pos)
	body = lexer parse-indented-statements
	catch-else mut catch-else-ast? = ()
	catches case-ast[] = with out : build
		loop
			guard catch-pos ?= lexer try-take-newline-then-catch : break
			if lexer try-take-token else_
				keywords-range = lexer range catch-pos
				catch-else := keywords-range, lexer.parse-optional-destructure, lexer.parse-indented-statements
				break
			else
				out ~= catch-pos, lexer.parse-case-member, lexer.parse-indented-statements
				continue
	start try-ast body, catches, catch-else
