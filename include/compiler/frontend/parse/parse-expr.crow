import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	../../util/util
	./lexer
	./parse-type
	./parse-util
	./token
	./token-util

parse-fun-expr-body expr-ast?(lexer lexer)
	if try-take-token lexer, newline-indent
		lexer.parse-statements-and-dedent

-arg-ctx record
	| Allow things like 'if' that continue into an indented block.
	allowed-block bool
	| Only parse operators if their precedence is greater than this.
	min-precedence-exclusive precedence
-allow-everything arg-ctx()
	true, min-precedence
-precedence enum
	| Dummy value so that 'min-precedence-exclusive' can allow everything
	min-precedence
	is_
	assignment-operator
	else_
	or_
	and_
	equals-expression
	| This is for the , in `1, 2` (calling `1 new 2`), not the comma between arguments in a normal call
	comma
	op-range
	op-tilde
	op-comparison
	op-bar
	op-caret
	op-and
	op-shift
	op-add-subtract
	op-times-divide
	op-pow
-== bool(a precedence, b precedence)
-<=> comparison(a precedence, b precedence)

-name-after-tick-precedence precedence()
	comma

-without-block arg-ctx(a arg-ctx)
	allowed-block: false
	min-precedence-exclusive: a.min-precedence-exclusive
-require-precedence-gt arg-ctx(a arg-ctx, precedence precedence)
	allowed-block: a.allowed-block
	min-precedence-exclusive: max a.min-precedence-exclusive, precedence

-parse-comma-call expr-ast(lexer lexer, arg-ctx arg-ctx, first expr-ast)
	args = parse-args lexer, arg-ctx, first
	with args2 in it-scope args
		list-ast (range lexer, first.start), map args2, it.identity

-parse-args expr-ast[](lexer lexer, ctx arg-ctx)
	parse-args lexer, (require-precedence-gt ctx, comma), ()
-parse-args expr-ast[](lexer lexer, ctx arg-ctx, first expr-ast?)
	do with out in build
	if first
		out ~= first
	assert ctx.min-precedence-exclusive >= comma
	do if peek-token-expression lexer, ctx.allowed-block
	out ~= parse-expr-and-calls lexer, ctx
	while try-take-token lexer, comma
		out ~= parse-expr-and-calls lexer, ctx

-peek-token-expression bool(lexer lexer, allowed-block bool)
	match lexer.peek
	as and_
		false
	as brace-right
		false
	as bracket-right
		false
	as catch_
		false
	as comma
		false
	as else_
		false
	as end-of-file
		false
	as paren-right
		false
	as name-after-tick
		false
	as newline-indent
		allowed-block
	as newline-dedent
		false
	as newline-same-indent
		false
	as operator-binary
		false
	as or_
		false
	as then_
		false
	else
		true

-parse-assignment expr-ast(lexer lexer, left expr-ast, assignment-pos pos)
	right = lexer.parse-expr-no-let
	assignment-ast left, assignment-pos, right

-must-parse-next-lines expr-ast(lexer lexer, diag parse-diag-expected)
	try-parse-next-lines lexer else
		add-diag-at-next-token lexer, diag
		bogus-ast lexer.next-range
-try-parse-next-lines expr-ast?(lexer lexer)
	if try-take-token lexer, newline-same-indent
		lexer.parse-statements

-parse-calls expr-ast(lexer lexer, lhs expr-ast, arg-ctx arg-ctx)
	match peek lexer
	as and_
		parse-logical-ast lexer, lhs, and_, arg-ctx
	as colon-equal
		do if arg-ctx.min-precedence-exclusive < assignment-operator else lhs
		advance lexer
		parse-assignment lexer, lhs, lexer.prev-start
	as comma
		do if arg-ctx.min-precedence-exclusive < comma else lhs
		advance lexer
		res = parse-comma-call lexer, (require-precedence-gt arg-ctx, comma), lhs
		parse-calls lexer, res, arg-ctx
	as else_
		parse-logical-ast lexer, lhs, else_, arg-ctx
	as equal
		do if arg-ctx.min-precedence-exclusive < equals-expression else lhs
		advance lexer
		unpack = parse-unpack-option lexer, lhs, lexer.prev-start, arg-ctx
		parse-calls lexer, unpack, arg-ctx
	as name-after-tick
		do if arg-ctx.min-precedence-exclusive < name-after-tick-precedence else lhs
		name = next-symbol lexer
		pos = next-start lexer
		advance lexer
		inner-ctx = require-precedence-gt arg-ctx, name-after-tick-precedence
		args = parse-args lexer, inner-ctx, lhs
		call = call-ast infix, (pos + 1, name), args, ()
		parse-calls lexer, call, arg-ctx
	as name-colon-equals
		parse-assignment-call lexer, lhs, arg-ctx
	as name-equals
		parse-binary-infix lexer, lhs, assignment-operator, arg-ctx, lexer.next-symbol
	as operator-binary
		name = next-symbol lexer
		parse-binary-infix lexer, lhs, name.operator-precedence, arg-ctx, name
	as operator-colon-equals
		parse-assignment-call lexer, lhs, arg-ctx
	as operator-equals
		parse-binary-infix lexer, lhs, assignment-operator, arg-ctx, lexer.next-symbol
	as or_
		parse-logical-ast lexer, lhs, or_, arg-ctx
	else
		if callable = as-callable-expr lhs
			args = parse-args lexer, arg-ctx
			if is-empty args
				lhs
			else
				parse-calls lexer, (to-expr callable, args), arg-ctx
		else
			lhs

-parse-binary-infix expr-ast(lexer lexer, lhs expr-ast, precedence precedence, arg-ctx arg-ctx, name symbol)
	do if arg-ctx.min-precedence-exclusive < precedence else lhs
	name-pos = next-start lexer
	advance lexer
	args expr-ast[] = lhs, parse-expr-and-calls lexer, require-precedence-gt arg-ctx, precedence
	res = with args2 in it-scope-if args, precedence > comma
		call-ast infix, (name-pos, name), args2, ()
	parse-calls lexer, res, arg-ctx

-parse-logical-ast expr-ast(lexer lexer, lhs expr-ast, kind logical-ast-kind, arg-ctx arg-ctx)
	precedence = kind.precedence
	do if arg-ctx.min-precedence-exclusive < precedence else lhs
	before-call = next-start lexer
	advance-may-continue-onto-next-line lexer
	expr = logical-ast lhs, kind, before-call,
		parse-expr-and-calls lexer, require-precedence-gt arg-ctx, precedence
	parse-calls lexer, expr, arg-ctx

-callable-kind enum(plain, force, not, question)
-== bool(a callable-kind, b callable-kind)
-callable-expr record
	kind callable-kind
	fun-name name-and-range
	type-arg type-ast?
	type-annotation (pos, type-ast)?
-as-callable-expr callable-expr?(a expr-ast)
	match a
	as name-and-range
		plain, a, (), ()
	as call-ast
		do if is-empty a.args
		match a.style
		as prefix
			if is-empty a.args
				plain, a.fun-name, a.type-arg, ()
		as question-name
			question, a.fun-name, a.type-arg, ()
		else
			()
	as force-ast
		if arg = as-callable-expr a.arg and arg.kind == plain
			force, arg.fun-name, arg.type-arg, ()
	as not-ast
		if arg = as-callable-expr a.arg and arg.kind == plain
			not, arg.fun-name, arg.type-arg, ()
	as typed-ast
		if expr = a.expr and arg = as-callable-expr expr and !arg.type-annotation
			arg.kind, arg.fun-name, arg.type-arg, (a.colon-pos, a.type)
	else
		()
-to-expr expr-ast(a callable-expr, args expr-ast[])
	plain expr-ast mut() = of
		if is-empty args and !a.type-arg
			a.fun-name
		else
			call-ast prefix, a.fun-name, args, a.type-arg
	res expr-ast = match a.kind
	as plain
		plain[]
	as not
		not-ast a.fun-name.start - 1, plain[]
	as force
		force-ast plain[], a.fun-name.end
	as question
		call-ast question-name, a.fun-name, args, a.type-arg
	if colon-pos, type = a.type-annotation
		typed-ast res, colon-pos, type
	else
		res

-parse-assignment-call expr-ast(lexer lexer, lhs expr-ast, arg-ctx arg-ctx)
	do if arg-ctx.min-precedence-exclusive < assignment-operator else lhs
	advance lexer
	assignment-call-ast (lexer.prev-start, lexer.prev-symbol), lhs,
		parse-expr-and-calls lexer, require-precedence-gt arg-ctx, assignment-operator

-precedence precedence(a logical-ast-kind)
	match a
	as and_ then and_
	as else_ then else_
	as or_ then or_

-operator-precedence precedence(a symbol)
	match a
	as ".."
		op-range
	as "~"
		op-tilde
	as "~~"
		op-tilde
	as "=="
		op-comparison
	as "!="
		op-comparison
	as "<"
		op-comparison
	as "<="
		op-comparison
	as ">"
		op-comparison
	as ">="
		op-comparison
	as "<=>"
		op-comparison
	as "|"
		op-bar
	as "^"
		op-caret
	as "&"
		op-and
	as "<<"
		op-shift
	as ">>"
		op-shift
	as "+"
		op-add-subtract
	as "-"
		op-add-subtract
	as "*"
		op-times-divide
	as "/"
		op-times-divide
	as "%"
		op-times-divide
	as "**"
		op-pow
	as "is"
		is_
	else
		throw unreachable

-try-parse-dots-and-subscripts expr-ast(lexer lexer, initial expr-ast)
	dot-pos = lexer.next-start
	match lexer.peek
	as dot
		advance lexer
		try-parse-dots-and-subscripts lexer, parse-after-dot lexer, initial
	as bracket-left
		advance lexer
		try-parse-dots-and-subscripts lexer, parse-subscript lexer, initial, dot-pos, false
	as question-bracket
		advance lexer
		try-parse-dots-and-subscripts lexer, parse-subscript lexer, initial, dot-pos, true
	as colon2
		try-parse-dots-and-subscripts lexer, with initial2 in it-scope initial
			advance lexer
			typed-ast initial2, dot-pos, lexer.parse-type-for-typed-expr
	as bang
		try-parse-dots-and-subscripts lexer, with initial2 in it-scope initial
			advance lexer
			force-ast initial2, dot-pos
	else
		initial

-parse-after-dot expr-ast(lexer lexer, initial expr-ast)
	call expr-ast mut(style call-ast-style, name name-and-range, type-arg type-ast?) = of style, name, type-arg
		with initial2 in it-scope-single initial
			call-ast style, name, (initial2,), type-arg
	if name = try-take-name-like-token lexer, name-bang
		with x in it-scope call[dot, name, ()]
			force-ast x, name.range.end
	elif name = try-take-name-like-token lexer, name-after-question
		call[dot-question, name, ()]
	elif name = lexer.try-take-name-and-range-or-diag
		call[dot, name, lexer.try-parse-type-arg-for-expr]
	else
		initial

-parse-subscript expr-ast(lexer lexer, initial expr-ast, subscript-pos pos, is-question-bracket bool)
	arg expr-ast = if try-take-token lexer, bracket-right
		list-ast (range lexer, subscript-pos), ()
	else
		res = lexer.parse-expr-no-block
		_ = take-or-add-diag-expected-token lexer, bracket-right, closing-bracket
		res
	with args in it-scope (initial, arg)
		left, right = only2! args
		call-subscript-ast left, is-question-bracket, subscript-pos, right, lexer.prev-end

-parse-match expr-ast(lexer lexer, start pos)
	local = parse-name-equals lexer
	matched = parse-expr-no-block lexer
	cases case-ast[] = with out in build
		while as-pos = try-take-newline-then-as lexer
			out ~= as-pos, (parse-case-member lexer), parse-then-or-block lexer
	match-ast start, local, matched, cases, if pos = try-take-newline-then-else lexer
		pos, lexer.parse-then-or-block
-parse-name-equals name-and-range?(lexer lexer)
	if peek lexer, name and peek2 lexer, equal
		res = try-take-name-and-range! lexer
		advance lexer
		res

-parse-then-or-block expr-ast(lexer lexer)
	if try-take-token lexer, then_
		parse-expr-no-block lexer
	else
		parse-indented-statements lexer

-parse-case-member case-member-ast(lexer lexer)
	if name = lexer.try-take-name-and-range
		as-name-ast name
	elif number = lexer.try-take-literal-number
		number
	else
		parse-string-literal-forbid-interpolated lexer, parse-diag-match-case-interpolated else
			as-bogus-ast lexer.next-range

-parse-string-literal-forbid-interpolated literal-string-ast?(lexer lexer, diag parse-diag)
	if kind = as-quote-no-interpolated lexer.peek
		advance lexer
		kind, lexer.prev-range, lexer.prev-string
	else
		add-diag-at-next-token lexer, diag
		lexer.skip-until-newline-no-diag
		()

-as-quote-no-interpolated quote-kind?(a token)
	match a
	as quote-bar-no-interpolated then bar
	as quote-block-no-interpolated then indented
	as quote-double-no-interpolated then double
	else then ()

-parse-quote-no-interpolated expr-ast(lexer lexer, kind quote-kind, allowed-block bool)
	string literal-string-ast = kind, lexer.prev-range, lexer.prev-string
	after-quote lexer, string, allowed-block

-parse-quote-then-interpolated expr-ast(lexer lexer, kind quote-kind, allowed-block bool)
	template interpolated-template-part mut[] =
		- lexer.prev-range, lexer.prev-string
	parts expr-ast mut[] = ()
	res expr-ast = loop
		parts ~= if peek lexer, brace-right
			add-diag-at-next-token lexer, parse-diag-missing-interpolated
			bogus-ast lexer.next-range
		else
			lexer.parse-expr-no-block
		do if take-after-interpolated lexer else break bogus-ast range lexer, template[0].range.start
		token = lexer.take-next-token
		template ~= lexer.prev-range, lexer.prev-string
		if token == kind.no-interpolated
			break with parts2 in it-scope parts.move-to
				interpolated-ast kind, template.move-to, parts2
		else
			token is kind.then-interpolated
			continue
	after-quote lexer, res, allowed-block

-after-quote expr-ast(lexer lexer, expr expr-ast, allowed-block bool)
	if try-take-token lexer, colon and string = as-string-like expr
		parse-single-line-named-new-after-first-name lexer, string, allowed-block
	else
		try-parse-dots-and-subscripts lexer, expr
-as-string-like name-or-string-ast?(a expr-ast)
	match a
	as literal-string-ast then a
	as interpolated-ast then a
	else then ()

-parse-if expr-ast(lexer lexer, start pos, is-else-of-parent bool, allowed-block bool)
	condition = parse-condition lexer, false
	then-pos = lexer.next-start
	if !is-else-of-parent and try-take-token lexer, then_
		then_ = parse-expr-and-calls lexer, (false, else_.precedence)
		else-pos = lexer.next-start
		else_ expr-ast? = if try-take-token lexer, else_
			lexer.parse-expr-no-block
		start: start
		is-unless: false
		kind: if else_ then if-then-else else if-then
		is-else-of-parent: false
		second-keyword-pos: then-pos
		third-keyword-pos: if else_ then else-pos else max-value
		condition: condition
		first-branch: then_
		second-branch: else_
	else
		then_ = parse-indented-statements lexer, start, allowed-block, if_
		elif-or-else = if allowed-block then lexer.try-take-newline-then-elif-or-else
		else_ expr-ast? = if elif-or-else
			match kind elif-or-else
			as elif_
				parse-if lexer, elif-or-else.pos, true, allowed-block
			as else_
				lexer.parse-indented-statements
		start: start
		is-unless: false
		kind: if elif-or-else
			match kind elif-or-else
			as elif_
				if-elif
			as else_
				if-else
		else
			if-without-else
		is-else-of-parent: is-else-of-parent
		second-keyword-pos: elif-or-else.?pos else 0
		third-keyword-pos: max-value
		condition: condition
		first-branch: then_
		second-branch: else_

-elif-or-else-keyword record(kind elif-or-else, pos pos)
-elif-or-else enum(elif_, else_)
-to elif-or-else?(a token)
	match a
	as elif_ then elif_
	as else_ then else_
	else then ()
-try-take-newline-then-elif-or-else elif-or-else-keyword?(lexer lexer)
	do if peek lexer, newline-same-indent
	do if kind elif-or-else = lexer.peek2.to
	advance lexer
	pos = lexer.next-start
	advance lexer
	kind, pos

-parse-condition expr-ast(lexer lexer, allow-block bool)
	if lexer.lookahead-equals
		left = parse-destructure-no-require-parens lexer
		equals-pos = next-start lexer
		_ = take-or-add-diag-expected-token lexer, equal, equals
		value = parse-expr-and-calls lexer, (allow-block, and_.precedence)
		unpack = unpack-option-ast left, equals-pos, value
		and-pos = next-start lexer
		if try-take-token lexer, and_
			logical-ast unpack, and_, and-pos, parse-condition lexer, allow-block
		else
			parse-calls lexer, unpack, (allow-block, else_.precedence)
	else
		parse-expr-and-calls lexer, (allow-block, else_.precedence)

-parse-unless if-ast(lexer lexer, start pos, allowed-block bool)
	condition = lexer.parse-expr-no-block
	then-pos, body = parse-then-or-indented-statements lexer, start, allowed-block, unless_
	start: start
	is-unless: true
	kind: if then-pos == max-value then if-without-else else if-then
	is-else-of-parent: false
	second-keyword-pos: then-pos
	third-keyword-pos: max-value
	condition: condition
	first-branch: body
	second-branch: ()

-parse-trusted expr-ast(lexer lexer, start pos, arg-ctx arg-ctx)
	trusted-ast start, parse-expr-and-calls lexer, arg-ctx

-parse-single-statement-or-block expr-ast(lexer lexer)
	if try-take-token lexer, newline-indent
		parse-statements-and-dedent lexer
	else
		parse-expr-no-let lexer

-assert-forbid-or-guard record
	condition expr-ast
	else_ assert-or-forbid-thrown-ast?
	after expr-ast?
-parse-assert-forbid-or-guard assert-forbid-or-guard(lexer lexer)
	condition = parse-condition lexer, true
	else-pos = lexer.next-start
	condition: condition
	else_: if try-take-token lexer, else_
		else-pos, lexer.parse-expr-no-let
	after: lexer.try-parse-next-lines

-parse-do-for-or-with expr-ast
	lexer lexer
	start pos
	kind for-or-with-ast-keyword
do
	advance lexer
	colon2-pos = next-start lexer
	type type-ast? = if try-take-token lexer, colon2
		parse-type-for-typed-expr lexer
	param, in-pos = parse-for-or-with-parameter lexer
	res for-or-with-ast =
		start: start
		keyword: kind
		param: param
		in-pos: in-pos
		then-pos: max-value
		arg: parse-expr-no-block lexer
		body: must-parse-next-lines lexer, after-do-line
	if type
		typed-ast res, colon2-pos, type
	else
		res

-parse-for-or-with expr-ast
	lexer lexer
	start pos
	allowed-block bool
	kind for-or-with-ast-keyword
	block-kind parse-diag-needs-block-ctx
do
	colon2-pos = next-start lexer
	type type-ast? = if try-take-token lexer, colon2
		parse-type-for-typed-expr lexer
	param, in-pos = parse-for-or-with-parameter lexer
	arg = lexer.parse-expr-no-block
	then-pos, body = parse-then-or-indented-statements lexer, start, allowed-block, block-kind
	res for-or-with-ast =
		start: start
		keyword: kind
		param: param
		in-pos: in-pos
		then-pos: then-pos
		arg: arg
		body: body
	if type
		typed-ast res, colon2-pos, type
	else
		res

-parse-loop-while-or-until expr-ast(lexer lexer, start pos, is-until bool)
	condition = parse-condition lexer, false
	body = lexer.parse-indented-statements
	loop-while-or-until-ast start, is-until, condition, body, lexer.try-parse-next-lines

-take-indent-or-fail-expr expr-ast(lexer lexer, cb-indent expr-ast mut())
	take-indent-or-fail-generic lexer, cb-indent, it.bogus-ast

-parse-for-or-with-parameter (destructure-ast, pos)(lexer lexer)
	pos = lexer.next-start
	if try-take-token lexer, in_
		(void-destructure-ast range lexer, pos), pos
	else
		res = lexer.parse-destructure-no-require-parens
		end-token-pos = lexer.next-start
		_ = take-or-add-diag-expected-token lexer, in_, in_
		res, end-token-pos

-skip-rest-of-line-and-return-bogus-no-diag expr-ast(lexer lexer, range source-range)
	lexer.skip-until-newline-no-diag
	bogus-ast range

-skip-rest-of-line-and-return-bogus expr-ast(lexer lexer, start pos, diag parse-diag)
	range = range lexer, start
	add-diag lexer, range, diag
	skip-rest-of-line-and-return-bogus-no-diag lexer, range

-expr-block-not-allowed expr-ast(lexer lexer, start pos, kind parse-diag-needs-block-ctx)
	skip-rest-of-line-and-return-bogus lexer, start, kind

-if-allow-block expr-ast
	lexer lexer
	start pos
	allowed-block bool
	kind parse-diag-needs-block-ctx
	cb-allow-block expr-ast mut()
do
	if allowed-block
		cb-allow-block[]
	else
		expr-block-not-allowed lexer, start, kind

-parse-expr-before-call expr-ast(lexer lexer, arg-ctx arg-ctx)
	start = lexer.next-start
	allowed-block = arg-ctx.allowed-block
	if-allow-block expr-ast mut(kind parse-diag-needs-block-ctx, cb expr-ast mut()) = of kind, cb
		if-allow-block lexer, start, allowed-block, kind, cb
	peek = lexer.peek
	do if !is-newline-token peek or peek == newline-indent and allowed-block else
		bad-next-token lexer
	match lexer.take-next-token
	as paren-left
		if try-take-token lexer, paren-right
			expr = list-ast (range lexer, start), ()
			try-parse-dots-and-subscripts lexer, expr
		else
			try-parse-dots-and-subscripts lexer, with inner in it-scope parse-expr-no-block lexer
				_ = take-or-add-diag-expected-token lexer, paren-right, closing-paren
				parenthesized-ast (range lexer, start), inner
	as quote-bar-no-interpolated
		parse-quote-no-interpolated lexer, bar, allowed-block
	as quote-block-no-interpolated
		if allowed-block
			(indented, lexer.prev-range, lexer.prev-string)::literal-string-ast
		else
			expr-block-not-allowed lexer, start, quote_
	as quote-double-no-interpolated
		parse-quote-no-interpolated lexer, double, allowed-block
	as quote-bar-then-interpolated
		parse-quote-then-interpolated lexer, bar, allowed-block
	as quote-block-then-interpolated
		if allowed-block
			parse-quote-then-interpolated lexer, indented, allowed-block
		else
			expr-block-not-allowed lexer, start, quote_
	as quote-double-then-interpolated
		try-parse-dots-and-subscripts lexer,
			parse-quote-then-interpolated lexer, double, allowed-block
	as bang
		with inner in it-scope parse-expr-before-call lexer, arg-ctx.without-block
			not-ast start, inner
	as break_
		loop-break-ast start, if peek-token-expression lexer, allowed-block
			parse-expr-and-calls lexer, arg-ctx
	as continue_
		loop-continue-ast start
	as for_
		parse-for-or-with lexer, start, allowed-block, for_, for_
	as for-star
		parse-for-or-with lexer, start, allowed-block, for-star, for-star
	as if_
		parse-if lexer, start, false, allowed-block
	as it_
		try-parse-dots-and-subscripts lexer, start.it-ast.it-scope-ast
	as in_
		# It's allowed to access 'in' just in order to access Java's `System.in`
		handle-name lexer, (start, "in")
	as match_
		if-allow-block[match_, of then parse-match lexer, start]
	as name
		handle-name lexer, (start, lexer.prev-symbol)
	as name-after-bang
		name = lexer.prev-symbol
		inner = try-parse-dots-and-subscripts lexer, if name == "it"
			it-scope-ast it-ast start + 1
		else
			name-and-range start + 1, name
		with inner2 in it-scope inner
			not-ast start, inner2
	as name-after-question
		call-ast question-name, (name-and-range start + 1, lexer.prev-symbol), (), ()
	as name-bang
		try-parse-dots-and-subscripts lexer,
			force-ast (name-and-range start, lexer.prev-symbol), (range lexer, start).end - 1
	as name-colon
		parse-single-line-named-new-after-first-name lexer, (start, lexer.prev-symbol), allowed-block
	as newline-indent
		assert allowed-block # The guard at top handled the false case
		parse-statements-and-dedent lexer
	as of_
		param destructure-ast = if peek lexer, then_ or peek lexer, newline-indent
			void-destructure-ast (lexer.prev-end, lexer.prev-end)
		else
			parse-destructure-no-require-parens lexer
		then-pos, body = parse-then-or-indented-statements lexer, start, allowed-block, of_
		lambda-ast start, param, then-pos, body
	as operator-prefix
		handle-prefix-unary-operator lexer, arg-ctx, start, lexer.prev-symbol
	as literal-number
		try-parse-dots-and-subscripts lexer, literal-number range lexer, start
	as loop_
		if-allow-block[loop_, of then loop-ast start, parse-indented-statements lexer]
	as shared_
		shared-ast start, parse-expr-and-calls lexer, arg-ctx
	as throw_
		throw-ast start, parse-expr-and-calls lexer, arg-ctx
	as trusted_
		parse-trusted lexer, start, arg-ctx
	as try_
		if-allow-block[try_, of then parse-try-block lexer, start]
	as underscore
		underscore-ast start
	as unless_
		parse-unless lexer, start, allowed-block
	as with_
		parse-for-or-with lexer, start, allowed-block, with_, with_
	else
		lexer.bad-prev-token

-bad-prev-token expr-ast(lexer lexer)
	lexer.add-diag-unexpected-prev-token
	skip-rest-of-line-and-return-bogus-no-diag lexer, lexer.prev-range
-bad-next-token expr-ast(lexer lexer)
	lexer.add-diag-unexpected-next-token
	skip-rest-of-line-and-return-bogus-no-diag lexer, lexer.next-range

-handle-prefix-unary-operator expr-ast(lexer lexer, arg-ctx arg-ctx, start pos, operator symbol)
	with arg in it-scope parse-expr-before-call lexer, arg-ctx
		call-ast prefix, (start, operator), (arg,), ()

-handle-name expr-ast(lexer lexer, name name-and-range)
	if type-arg = try-parse-type-arg-for-expr lexer
		call-ast prefix, name, (), type-arg
	else
		try-parse-dots-and-subscripts lexer, name

-parse-expr-no-block expr-ast(lexer lexer)
	parse-expr-and-all-calls lexer, false

-parse-expr-and-all-calls expr-ast(lexer lexer, allowed-block bool)
	parse-expr-and-calls lexer, (allowed-block, min-precedence)

-parse-expr-and-calls expr-ast(lexer lexer, arg-ctx arg-ctx)
	parse-calls lexer, (parse-expr-before-call lexer, arg-ctx), arg-ctx

-parse-unpack-option expr-ast(lexer lexer, left expr-ast, equals-pos pos, arg-ctx arg-ctx)
	destructure = to-destructure left else
		add-diag lexer, left.range, parse-diag-equals-left
		ignore-destructure-ast left.start, ()
	right = parse-expr-and-calls lexer, require-precedence-gt arg-ctx, and_.precedence
	unpack-option-ast destructure, equals-pos, right

-to-destructure destructure-ast?(a expr-ast)
	match a
	as list-ast
		map-every a.parts, it.expr-ast.?to-destructure
	as name-and-range
		a
	as parenthesized-ast
		to-destructure a.inner
	as underscore-ast
		ignore-destructure-ast a.start, ()
	else
		()

-parse-expr-no-let expr-ast(lexer lexer)
	parse-expr-and-all-calls lexer, true

parse-single-statement-line expr-ast(lexer lexer)
	start = lexer.next-start
	match peek lexer
	as assert_
		advance lexer
		res = parse-assert-forbid-or-guard lexer
		assert-or-forbid-ast start, false, res.condition, res.else_, res.after
	as colon2
		advance lexer
		type = parse-type lexer
		typed-ast (try-parse-next-lines lexer), start, type
	as do_
		advance lexer
		match peek lexer
		as for_
			parse-do-for-or-with lexer, start, for_
		as for-star
			parse-do-for-or-with lexer, start, for-star
		as if_
			parse-do-if-or-unless lexer, start, false
		as loop_
			advance lexer
			loop-ast start, must-parse-next-lines lexer, after-do-line
		as unless_
			parse-do-if-or-unless lexer, start, true
		as with_
			parse-do-for-or-with lexer, start, with_
		else
			add-diag-at-next-token lexer, after-do-keyword
			skip-until-newline-no-diag lexer
			bogus-ast range lexer, start
	as finally_
		advance lexer
		right = lexer.parse-single-statement-or-block
		below = must-parse-next-lines lexer, after-finally
		finally-ast start, right, below
	as forbid_
		advance lexer
		res = parse-assert-forbid-or-guard lexer
		assert-or-forbid-ast start, true, res.condition, res.else_, res.after
	as list-dash
		advance lexer
		parse-list-call lexer, single
	as list-dash-dash
		advance lexer
		parse-list-call lexer, multi
	as trusted_
		advance lexer
		if peek lexer, newline-same-indent
			after = must-parse-next-lines lexer, after-trusted
			trusted-ast start, after
		else
			parse-trusted lexer, start, allow-everything
	as until_
		advance lexer
		parse-loop-while-or-until lexer, start, true
	as while_
		advance lexer
		parse-loop-while-or-until lexer, start, false
	else
		if lookahead-equals lexer
			parse-equals lexer
		else
			expr = parse-expr-before-call lexer, allow-everything
			if expr.call-named-ast and expr.names.size == 1
				parse-multi-line-named-new lexer, expr
			else
				parse-calls lexer, expr, allow-everything

-parse-do-if-or-unless expr-ast(lexer lexer, start pos, is-unless bool)
	advance lexer
	condition = parse-condition lexer, true
	else-pos = next-start lexer
	else_ expr-ast? = if try-take-token lexer, else_
		parse-expr-no-let lexer
	start: start
	is-unless: is-unless
	kind: if else_ then do-if-else else do-if
	is-else-of-parent: false
	second-keyword-pos: else-pos
	third-keyword-pos: max-value
	condition: condition
	first-branch: else_
	second-branch: must-parse-next-lines lexer, after-do-line

-list-part-kind enum(single, multi)
-try-take-list-part-kind list-part-kind?(lexer lexer)
	do if res list-part-kind = match lexer.peek
	as list-dash
		single
	as list-dash-dash
		multi
	else
		()
	advance lexer
	res

-parse-single-line-named-new-after-first-name expr-ast(lexer lexer, first-name name-or-string-ast, allowed-block bool)
	value = parse-expr-and-calls lexer, (allowed-block, comma)
	if try-take-token lexer, comma
		if second-name = lexer.try-take-name-or-string
			parse-single-line-named-new-after-second-name lexer, first-name, value, second-name, allowed-block
		else
			value2 = parse-comma-call lexer, (allowed-block, comma), value
			call-named-ast (first-name,), (value2,)
	else
		value2 = parse-calls lexer, value, (allowed-block, min-precedence)
		call-named-ast (first-name,), (value2,)

-parse-single-line-named-new-after-second-name call-named-ast
	lexer lexer
	first-name name-or-string-ast
	first-value expr-ast
	second-name name-or-string-ast
	allowed-block bool
do
	second-value = parse-expr-and-calls lexer, (allowed-block, comma)
	names name-or-string-ast mut[] = first-name, second-name
	values expr-ast mut[] = first-value, second-value
	while try-take-token lexer, comma
		if name = lexer.take-name-or-string
			names ~= name
			values ~= parse-expr-and-calls lexer, (allowed-block, comma)
	names.move-to, values.move-to

-parse-multi-line-named-new call-named-ast(lexer lexer, initial call-named-ast)
	names name-or-string-ast mut[] = initial.names.to
	values expr-ast mut[] = initial.args.to
	while try-take-newline-for-list-or-named-new lexer
		if name = take-name-or-string lexer
			names ~= name
			values ~= parse-expr-no-let lexer
	names.move-to, values.move-to

-try-take-newline-for-list-or-named-new bool(lexer lexer)
	if peek lexer, newline-same-indent and !peek2 lexer, then_
		advance lexer
		true

-try-take-name-or-string name-or-string-ast?(lexer lexer)
	try-take-name-colon-and-range lexer or
		if peek lexer, quote-double-no-interpolated or peek lexer, quote-double-then-interpolated
			string = parse-string-literal-forbid-interpolated lexer, parse-diag-named-new-key
			if string
				_ = take-or-add-diag-expected-token lexer, colon, colon
			string

-take-name-or-string name-or-string-ast?(lexer lexer)
	try-take-name-colon-and-range lexer or
		string = parse-string-literal-forbid-interpolated lexer, parse-diag-named-new-key
		if string
			_ = take-or-add-diag-expected-token lexer, colon, colon
		string

-parse-list-call expr-ast(lexer lexer, first-part list-part-kind)
	start = prev-start lexer
	parts list-ast-part[] = with out in build
		out ~= list-part first-part, lexer.parse-expr-no-let
		while lexer.try-take-newline-for-list-or-named-new
			if kind = lexer.try-take-list-part-kind
				out ~= list-part kind, lexer.parse-expr-no-let
			else
				add-diag-at-next-token lexer, parse-diag-list-call-needs-hyphen
				lexer.skip-until-newline-no-diag
	list-ast (range lexer, start), parts
-list-part list-ast-part(kind list-part-kind, expr expr-ast)
	match kind
	as single
		expr
	as multi
		list-ast-part-multi expr

-parse-equals expr-ast(lexer lexer)
	start = lexer.next-start
	if try-take-token lexer, try_
		parse-try-let lexer, start
	else
		left = lexer.parse-destructure-no-require-parens
		_ = take-or-add-diag-expected-token-and-may-continue-onto-next-line lexer, equal, equals
		init = lexer.parse-expr-no-let
		then_ = lexer.try-parse-next-lines
		let-ast left, init, then_

-parse-try-let try-let-ast(lexer lexer, start pos)
	destructure = lexer.parse-destructure-no-require-parens
	_ = take-or-add-diag-expected-token-and-may-continue-onto-next-line lexer, equal, equals
	value = lexer.parse-expr-no-block
	catch-pos = lexer.next-start
	_ = take-or-add-diag-expected-token lexer, catch_, catch_
	catch_ = parse-catch-after-keyword lexer, catch-pos
	then_ = lexer.try-parse-next-lines
	start, destructure, value, catch_, then_

-parse-statements expr-ast(lexer lexer)
	res mut = parse-single-statement-line lexer
	while try-take-token lexer, newline-same-indent
		if try-take-token lexer, then_
			res := parse-calls lexer, res, allow-everything
		else
			res seq-ast:= parse-single-statement-line lexer
	res

-parse-indented-statements expr-ast(lexer lexer)
	take-indent-or-fail-expr lexer, of
		lexer.parse-statements-and-dedent

# Returns position of 'then' (or max-value no 'then' keyword) and the body.
-parse-then-or-indented-statements (pos, expr-ast)
	lexer lexer
	start pos
	allow-block bool
	block-kind parse-diag-needs-block-ctx
do
	then-pos = lexer.next-start
	if try-take-token lexer, then_
		then-pos, lexer.parse-expr-no-block
	else
		- max-value
		- parse-indented-statements lexer, start, allow-block, block-kind

-parse-indented-statements expr-ast
	lexer lexer
	start pos
	allow-block bool
	block-kind parse-diag-needs-block-ctx
do
	if allow-block
		lexer.parse-indented-statements
	else
		expr-block-not-allowed lexer, start, block-kind

-parse-statements-and-dedent expr-ast(lexer lexer)
	res = lexer.parse-statements
	lexer.take-dedent
	res

-parse-try-block expr-ast(lexer lexer, start pos)
	:: try-ast
	start: start
	tried: lexer.parse-indented-statements
	catches: with out in build
		while catch-pos = lexer.try-take-newline-then-catch
			out ~= parse-catch-after-keyword lexer, catch-pos
-try-parse-catch-as catch-as-ast?(lexer lexer)
	pos = lexer.next-start
	if try-take-token lexer, as_
		pos, lexer.take-name-and-range

-parse-catch-after-keyword catch-ast(lexer lexer, start pos)
	start: start
	name: try-take-name-and-range lexer
	as_: try-parse-catch-as lexer
	then_: parse-then-or-block lexer

| Returns position of "as"
-try-take-newline-then-as pos?(lexer lexer)
	try-take-newline-then-keyword lexer, as_
-try-take-newline-then-catch pos?(lexer lexer)
	try-take-newline-then-keyword lexer, catch_
| Returns position of "else"
-try-take-newline-then-else pos?(lexer lexer)
	try-take-newline-then-keyword lexer, else_
-try-take-newline-then-keyword pos?(lexer lexer, keyword token)
	if peek lexer, newline-same-indent and peek2 lexer, keyword
		advance lexer
		keyword-pos = lexer.next-start
		advance lexer
		keyword-pos
