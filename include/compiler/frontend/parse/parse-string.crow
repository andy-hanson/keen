import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	./lexer
	./lex-string
	./parse-util
	./token

try-take-doc-comment doc-comment-ast(lexer lexer)
	lexer skip-blank-lines
	start = lexer cur-pos
	guard lexer try-take-token quote-bar

	references name-and-range mut[] = ()
	done doc-comment-ast mut() = of
		content doc-comment-content = (lexer range start), references.move-to
		content,
	cb-interpolation void mut() = of
		references ~= lexer take-name-or-operator
	res = lexer take-interpolated-cb bar, (of _ then done[]), cb-interpolation, it.noop, done
	lexer skip-blank-lines
	res

parse-expr-no-block spec
	parse-expr-no-block expr-ast(lexer lexer)
parse-string name-or-string-ast(lexer lexer, start pos, quote-kind quote-kind) parse-expr-no-block
	parts expr-ast mut[] = ()
	lexer take-interpolated-cb quote-kind, \
		(of part then quote-kind.to literal-string-ast (lexer range start), part.text), \
		(of then parts ~= lexer parse-expr-no-block), \
		(of part then parts ~= part-of-interpolated literal-string-ast part.range, part.text), \
		(of then quote-kind interpolated-ast (lexer range start), parts.move-to)

-to literal-string-ast-kind(a quote-kind)
	match a
	as bar
		quoted
	as double
		quoted
	as double3
		quoted
	as indented
		indented

-take-interpolated-cb[out] out
	lexer lexer
	quote-kind quote-kind
	cb-single out mut(part string-part)
	cb-interpolation void mut()
	cb-string void mut(part string-part)
	cb-finish out mut()
do
	first-part = lexer take-initial-string-part quote-kind
	match first-part after
	as done
		cb-single[first-part]
	as lbrace
		unless first-part.text is-empty
			cb-string[first-part]
		loop
			if lexer peek-token brace-right
				pos = lexer cur-pos
				lexer add-diag (pos - 1, pos + 1), parse-diag-missing-interpolated
			else
				cb-interpolation[]
			part = lexer take-closing-brace-then-string-part quote-kind
			unless part.text is-empty
				cb-string[part]
			match part after
			as done
				break cb-finish[]
			else
				continue
