token enum
	alias_
	| '->'
	arrow-access
	| '=>'
	arrow-lambda
	as_
	assert_
	| '@'
	at
	| '!'
	bang
	bare_
	break_
	builtin_
	| '\{'
	brace-left
	| '}'
	brace-right
	| '['
	bracket-left
	| ']'
	bracket-right
	by-ref_
	by-val_
	case_
	catch_
	| ':'
	colon
	| '::'
	colon2
	| ':='
	colon-equal
	| ','
	comma
	continue_
	data_
	do_
	| '.'
	| Note: '..' would be an {operator}
	dot
	| '...'
	dot3
	elif_
	else_
	enum_
	| '='
	equal
	extern_
	end-of-file
	export_
	finally_
	flags_
	for_
	force-data_
	force-shared_
	forbid_
	force-ctx_
	function_
	global_
	guard_
	if_
	import_
	interface_
	| Use as-literal-float
	literal-float
	| Use as-literal-integral
	literal-integral
	loop_
	match_
	mut_
	| Any non-keyword, non-operator name; use as-symbol with this
	name
	| '!name'
	name-after-bang
	| Tokens for a name with '!', ':', ':=', or '=' on the end.
	name-bang
	| 'TokenAndData.asSymbol' does NOT include the ':='
	name-or-operator-colon-equals
	| 'TokenAndData.asSymbol' DOES include the '='
	name-or-operator-equals
	| End of line followed by another line at lesser indentation.
	| There will be one of these tokens for each reduced indent level, followed by a {newline-same-indent} token.
	newline-dedent
	| End of line followed by another line at 1 greater indent level.
	| Unlike {newline-dedent}, this is not followed by a 'newlineSameIndent' token.
	newline-indent
	| end of line followed by another line at the same indent level.
	newline-same-indent
	nominal_
	no-std_
	| Any operator; use 'as-symbol' with this
	operator
	packed_
	| '('
	paren-left
	| ')'
	paren-right
	pure_
	| '?'
	question
	| '?.'
	question-dot
	| '?['
	question-bracket
	| '?='
	question-equal
	| '|', only if this is the first non-whitespace on its line. Otherwise that will be an operator.
	quote-bar
	| '"'
	quote-double
	| '"""'
	quote-double3
	| Fake token to be the peek after the '"'
	quoted-text
	record_
	region_
	| Any reserved word
	reserved
	| ';'
	semicolon
	shared_
	spec_
	storage_
	summon_
	test_
	thread-local_
	throw_
	trusted_
	try_
	unexpected-character
	| '_'
	underscore
	union_
	unless_
	unsafe_
	until_
	variant_
	while_
	with_
== bool(a token, b token)
<=> comparison(a token, b token)
hash-mix void(hasher hasher, a token)
	hasher hash-mix a.to::nat32
to nat32(a token)
to symbol(a token)
show string(a token)
	a.to::symbol to
to json(a token)
