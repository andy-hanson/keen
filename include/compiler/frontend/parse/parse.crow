import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	../../model/uri
	../../util/perf
	./lexer
	./lex-token
	./parse-expr
	./parse-import
	./parse-string
	./parse-type
	./parse-util
	./token

parse-file file-ast(uri uri, source char8 array-view, lcg line-and-column-getter)
	start = perf-now
	res = uri create-lexer source parse-file-inner lcg
	start end-parse
	res

expr-and-diags record(expr expr-ast, diags parse-diagnostic[])
parse-single-line-expression expr-and-diags(source string)
	forbid "\n"::char8 in source.to::char8[]
	lexer = () create-lexer source.to
	lexer must-take-token newline-same-indent
	expr = lexer parse-single-statement-line
	_ = lexer take-or-add-diag-expected-token end-of-file, end-of-line
	expr, lexer.finish-diagnostics	

-parse-type-params name-and-range[](lexer lexer)
	if lexer try-take-token bracket-left
		res = lexer take-comma-separated-names-diag-trailing-comma
		_ = lexer take-or-add-diag-expected-token bracket-right, closing-bracket
		res

-parse-indented-sigs signature-ast[](lexer lexer)
	lexer parse-indented-lines of
		doc-comment = lexer try-take-doc-comment
		start = lexer cur-pos
		name = lexer take-name-or-operator
		name.start is start
		return-type = lexer parse-type
		params, _ = lexer parse-params
		doc-comment, (lexer range start), name.name, return-type, params

-parse-enum-or-flags-members enum-or-flags-member-ast[](lexer lexer)
	lexer parse-indented-lines of
		doc-comment = lexer try-take-doc-comment
		start = lexer cur-pos
		name = lexer take-name
		value literal-number? = if lexer try-take-token equal
			res = lexer try-take-literal-number
			unless res
				lexer add-diag-expected literal-integral
			res
		doc-comment, (lexer range start), name, value

-parse-record-fields record-field-ast[](lexer lexer)
	lexer parse-indented-lines of
		doc-comment = lexer try-take-doc-comment
		start = lexer cur-pos
		visibility = lexer try-take-visibility
		name = lexer take-name-and-range
		mutability = lexer parse-field-mutability
		type type-ast? = unless lexer peek-end-of-line
			lexer parse-type
		doc-comment, (lexer range start), visibility, name, mutability, type

-parse-field-mutability field-mutability-ast?(lexer lexer)
	pos = lexer cur-pos
	peek = lexer get-peek-token-and-data
	visibility = lexer try-take-visibility
	if lexer try-take-token mut_
		pos, visibility
	elif visibility
		lexer add-diag-unexpected-cur-token pos, peek
		()

-parse-fun fun-decl-ast
	lexer lexer
	doc-comment doc-comment-ast
	visibility visibility?
	start pos
	name name-and-range
	type-params name-and-range[]
do
	return-type = lexer parse-type
	params, params-kind = lexer parse-params
	can-continue = match params-kind
	as indented
		lexer try-take-token do_
	as parenthesized
		true
	modifiers = if can-continue then lexer parse-modifiers
	body = if can-continue then lexer parse-fun-expr-body
	lexer.uri, doc-comment, (lexer range start), visibility, name, type-params, return-type, params, modifiers, body

-parse-spec-or-struct-or-fun-or-test void
	lexer lexer
	specs spec-decl-ast mut[]
	struct-aliases struct-alias-ast mut[]
	structs struct-decl-ast mut[]
	funs fun-decl-ast mut[]
	tests test-ast mut[]
	vars var-decl-ast mut[]
	doc-comment doc-comment-ast
do
	start = lexer cur-pos
	if lexer try-take-token test_
		modifiers = lexer parse-modifiers
		body = lexer parse-fun-expr-body
		tests ~= doc-comment, (lexer range start), modifiers, body
	else
		lexer parse-spec-or-struct-or-fun specs, struct-aliases, structs, funs, vars, doc-comment

-parse-spec-or-struct-or-fun void
	lexer lexer
	specs spec-decl-ast mut[]
	struct-aliases struct-alias-ast mut[]
	structs struct-decl-ast mut[]
	funs fun-decl-ast mut[]
	var-decls var-decl-ast mut[]
	doc-comment doc-comment-ast
do
	start = lexer cur-pos
	visibility = lexer try-take-visibility
	name = lexer take-name-or-operator
	type-params = lexer parse-type-params
	keyword-pos = lexer cur-pos

	add-struct void mut(modifiers modifier-ast[], body struct-body-ast) = of modifiers, body
		structs ~= doc-comment, (lexer range start), visibility, name, type-params, keyword-pos, modifiers, body
	add-sum-type void mut(kind sum-type-kind) = of kind
		_ = lexer take-next-token
		types = lexer try-parse-sum-type-listed-types-parenthesized
		add-struct[lexer.parse-modifiers, (lexer parse-sum-type-after-modifiers kind, types)]
	match lexer get-peek-token
	as alias_
		lexer must-take-token alias_
		cb type-ast mut() = of
			res = lexer parse-type
			lexer take-dedent
			res
		target = lexer take-indent-or-fail-generic cb, it.bogus-type-ast
		struct-aliases ~= doc-comment, (lexer range start), visibility, name, type-params, keyword-pos, target
	as builtin_
		lexer must-take-token builtin_
		add-struct[lexer.parse-modifiers, builtin-type-ast]
	as enum_
		lexer must-take-token enum_
		params = lexer try-parse-params-parenthesized
		add-struct[lexer.parse-modifiers, (params enum-ast lexer.parse-enum-or-flags-members)]
	as flags_
		lexer must-take-token flags_
		params = lexer try-parse-params-parenthesized
		add-struct[lexer.parse-modifiers, (params flags-ast lexer.parse-enum-or-flags-members)]
	as global_
		pos = lexer cur-pos
		lexer must-take-token global_
		var-decls ~= lexer parse-var-decl start, doc-comment, visibility, name, type-params, pos, global_
	as interface_
		add-sum-type[interface_]
	as record_
		lexer must-take-token record_
		params = lexer try-parse-params-parenthesized
		add-struct[lexer.parse-modifiers, (params record-ast lexer.parse-record-fields)]
	as spec_
		lexer must-take-token spec_
		modifiers = lexer parse-modifiers
		sigs = lexer parse-indented-sigs
		specs ~= doc-comment, (lexer range start), visibility, name, type-params, keyword-pos, modifiers, sigs
	as thread-local_
		pos = lexer cur-pos
		lexer must-take-token thread-local_
		var-decls ~= lexer parse-var-decl start, doc-comment, visibility, name, type-params, pos, thread-local_
	as union_
		add-sum-type[union_]
	as variant_
		add-sum-type[variant_]
	else
		funs ~= lexer parse-fun doc-comment, visibility, start, name, type-params

-parse-sum-type-after-modifiers sum-type-ast(lexer lexer, kind sum-type-kind, types-parenthesized type-ast[]?)
	types type-ast[], can-parse-sigs bool = if types-parenthesized
		types-parenthesized, true
	else
		match kind
		as union_
			types = lexer parse-indented-lines of
				lexer parse-type
			_ = lexer try-take-token newline-same-indent
			types, (lexer try-take-token do_) # TODO: if we took a 'do', we should *require* indented sigs ------------------------------------
		else
			(), true
	kind, types, if can-parse-sigs then lexer parse-indented-sigs

-parse-var-decl var-decl-ast
	lexer lexer
	start pos
	doc-comment doc-comment-ast
	visibility visibility?
	name name-and-range
	type-params name-and-range[]
	kind-pos pos
	kind var-kind
do
	type = lexer parse-type-arg-for-var-decl
	modifiers = lexer parse-modifiers
	initializer = lexer parse-fun-expr-body
	doc-comment, (lexer range start), visibility, name, type-params, kind-pos, kind, type, modifiers, initializer

-parse-file-inner file-ast(lexer lexer, lcg line-and-column-getter)
	module-doc-comment mut = lexer try-take-doc-comment
	no-std_ = lexer try-take-token no-std_
	lexer skip-blank-lines
	imports = lexer parse-imports-or-exports import_
	lexer skip-blank-lines
	exports = lexer parse-imports-or-exports export_

	regions source-range mut[] = ()
	specs spec-decl-ast mut[] = ()
	struct-aliases struct-alias-ast mut[] = ()
	structs struct-decl-ast mut[] = ()
	funs fun-decl-ast mut[] = ()
	tests test-ast mut[] = ()
	vars var-decl-ast mut[] = ()

	first mut bool = true
	while lexer !try-take-token end-of-file
		doc-comment =
			here = lexer try-take-doc-comment
			if first
				first := false
				if module-doc-comment !is-empty and here is-empty and !no-std_ and !imports and !exports
					res = module-doc-comment
					module-doc-comment := ()
					res
				else
					here
			else
				here
		if lexer try-take-token end-of-file
			if doc-comment !is-empty
				lexer add-diag doc-comment.range!, parse-diag-doc-comment-unused
		elif lexer peek-token region_
			x = lexer take-next-token
			x.token is region_
			regions ~= x.as-region
		else
			lexer parse-spec-or-struct-or-fun-or-test specs, struct-aliases, structs, funs, tests, vars, doc-comment

	max-columns nat = 150 # TODO: CONFIGURABLE (and default should be more like 100) ----------------------------------------------------------------
	for diag in lcg lines-over-n-columns max-columns
		lexer add-diag (diag.pos, diag.pos + 1), do diag.actual-columns parse-diag-line-too-long max-columns
	line-and-column-getter: lcg
	parse-diagnostics: lexer finish-diagnostics
	doc-comment: module-doc-comment
	no-std_: no-std_
	imports: imports
	re-exports: exports
	regions: regions move-to
	specs: specs move-to
	struct-aliases: struct-aliases move-to
	structs: structs move-to
	funs: funs move-to
	tests: tests move-to
	vars: vars move-to
