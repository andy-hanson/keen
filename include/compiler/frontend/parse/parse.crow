import
	crow/parse
	../../model/ast
	../../model/parse-diag
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/perf
	./parser
	./parse-expr
	./parse-import
	./parse-type
	./parse-util
	./token

parse-file file-ast(uri uri, source char8 array-view, lcg line-and-column-getter)
	start = perf-now
	the parser = uri, source
	res = parse-file-inner lcg
	end-parse start
	res

expr-and-diags record(expr expr-ast, diags parse-diagnostic[])
parse-single-line-expression expr-and-diags(source string)
	forbid contains source, "\n"
	the parser = (), source.to
	expr = parse-single-statement-line
	_ = take-or-add-diag-expected-token end-of-file, end-of-line
	expr, finish-diagnostics

-parse-type-params name-and-range[]() parser
	if try-take-token bracket-left
		res = take-comma-separated-names-diag-trailing-comma
		_ = take-or-add-diag-expected-token bracket-right, closing-bracket
		if res.size <= max-type-params
			res
		else
			add-diag res[max-type-params].range, parse-diag-too-many-type-params
			res[0 .. max-type-params].to

-parse-indented-sigs signature-ast[]() parser
	parse-indented-lines of
		doc-comment = try-take-doc-comment
		start = next-start
		name = take-name-or-operator.name
		return-type = parse-type
		params, _ = parse-params
		doc-comment, start.range, name, return-type, params

-try-take-doc-comment doc-comment-ast() parser
	skip-blank-lines
	start = next-start
	if try-take-token quote-bar-no-interpolated
		res doc-comment-ast = prev-range,
		skip-blank-lines
		res
	elif try-take-token quote-bar-then-interpolated
		references name-and-range mut[] = ()
		do loop
		references ~= take-name-or-operator
		do if take-after-interpolated else break
		if try-take-token quote-bar-no-interpolated
			skip-blank-lines
			break content: start.range, references.move-to
		else
			assert try-take-token quote-bar-then-interpolated
			continue

-parse-enum-or-flags-members enum-or-flags-member-ast[]() parser
	parse-indented-lines of
		doc-comment = try-take-doc-comment
		start = next-start
		name = take-name
		value literal-number? = if try-take-token equal
			res = try-take-literal-number
			unless res
				add-diag-expected literal-integral
			res
		doc-comment, start.range, name, value

-parse-record-fields record-field-ast[]() parser
	parse-indented-lines of
		doc-comment = try-take-doc-comment
		start = next-start
		visibility = try-take-visibility
		name = take-name-and-range
		mutability = parse-field-mutability
		type type-ast? = unless peek-end-of-line
			parse-type
		doc-comment, start.range, visibility, name, mutability, type

-parse-field-mutability field-mutability-ast?() parser
	pos = next-start
	visibility = try-take-visibility
	if try-take-token mut_
		pos, visibility
	elif visibility
		add-diag-unexpected-prev-token
		()

-parse-fun fun-decl-ast
	doc-comment doc-comment-ast
	visibility visibility?
	start pos
	name name-and-range
	type-params name-and-range[]
do parser
	return-type = parse-type
	params, params-kind = parse-params
	can-continue = match params-kind
	as indented
		try-take-token do_
	as parenthesized
		true
	modifiers = if can-continue then parse-modifiers
	body = if can-continue then parse-fun-expr-body
	uri, doc-comment, start.range, visibility, name, type-params, return-type, params, modifiers, body

-parse-spec-or-struct-or-fun-or-test void
	specs spec-decl-ast mut[]
	struct-aliases struct-alias-ast mut[]
	structs struct-decl-ast mut[]
	funs fun-decl-ast mut[]
	tests test-ast mut[]
	vars var-decl-ast mut[]
	doc-comment doc-comment-ast
do parser
	start = next-start
	if try-take-token test_
		modifiers = parse-modifiers
		body = parse-fun-expr-body
		tests ~= doc-comment, start.range, modifiers, body
	else
		parse-spec-or-struct-or-fun specs, struct-aliases, structs, funs, vars, doc-comment

-parse-spec-or-struct-or-fun void
	specs spec-decl-ast mut[]
	struct-aliases struct-alias-ast mut[]
	structs struct-decl-ast mut[]
	funs fun-decl-ast mut[]
	var-decls var-decl-ast mut[]
	doc-comment doc-comment-ast
do parser
	start = next-start
	visibility = try-take-visibility
	name = take-name-or-operator
	type-params = parse-type-params
	keyword-pos = next-start

	add-struct = of modifiers modifier-ast[], body struct-body-ast
		structs ~= doc-comment, start.range, visibility, name, type-params, keyword-pos, modifiers, body
	add-sum-type = of kind sum-type-kind
		advance
		types = try-parse-sum-type-listed-types-parenthesized
		add-struct[parse-modifiers, (parse-sum-type-after-modifiers kind, types)]
	match peek
	as alias_
		advance
		cb = of
			res = parse-type
			take-dedent
			res
		target = take-indent-or-fail-generic cb, it.bogus-type-ast
		struct-aliases ~= doc-comment, start.range, visibility, name, type-params, keyword-pos, target
	as builtin_
		advance
		add-struct[parse-modifiers, builtin-type-ast]
	as enum_
		advance
		params = try-parse-params-parenthesized
		add-struct[parse-modifiers, (enum-ast params, parse-enum-or-flags-members)]
	as flags_
		advance
		params = try-parse-params-parenthesized
		add-struct[parse-modifiers, (flags-ast params, parse-enum-or-flags-members)]
	as global_
		pos = next-start
		advance
		var-decls ~= parse-var-decl start, doc-comment, visibility, name, type-params, pos, global_
	as interface_
		add-sum-type[interface_]
	as record_
		advance
		params = try-parse-params-parenthesized
		add-struct[parse-modifiers, (record-ast params, parse-record-fields)]
	as spec_
		advance
		modifiers = parse-modifiers
		sigs = parse-indented-sigs
		specs ~= doc-comment, start.range, visibility, name, type-params, keyword-pos, modifiers, sigs
	as thread-local_
		pos = next-start
		advance
		var-decls ~= parse-var-decl start, doc-comment, visibility, name, type-params, pos, thread-local_
	as union_
		add-sum-type[union_]
	as variant_
		add-sum-type[variant_]
	else
		funs ~= parse-fun doc-comment, visibility, start, name, type-params

-parse-sum-type-after-modifiers sum-type-ast(kind sum-type-kind, types-parenthesized type-ast[]?) parser
	types type-ast[], can-parse-sigs bool = if types-parenthesized
		types-parenthesized, true
	else
		match kind
		as union_
			types = parse-indented-lines of
				parse-type
			_ = try-take-token newline-same-indent
			types, try-take-token do_ # TODO: if we took a 'do', we should *require* indented sigs ------------------------------------
		else
			(), true
	kind, types, if can-parse-sigs then parse-indented-sigs

-parse-var-decl var-decl-ast
	start pos
	doc-comment doc-comment-ast
	visibility visibility?
	name name-and-range
	type-params name-and-range[]
	kind-pos pos
	kind var-kind
do parser
	type = parse-type-arg-for-var-decl
	modifiers = parse-modifiers
	initializer = parse-fun-expr-body
	doc-comment, start.range, visibility, name, type-params, kind-pos, kind, type, modifiers, initializer

-parse-file-inner file-ast(lcg line-and-column-getter) parser
	warn-trailing-whitespace lcg.line-and-character-getter
	module-doc-comment mut = try-take-doc-comment
	no-std_ = try-take-token no-std_
	skip-blank-lines
	imports = parse-imports-or-exports import_
	skip-blank-lines
	exports = parse-imports-or-exports export_

	regions source-range mut[] = ()
	specs spec-decl-ast mut[] = ()
	struct-aliases struct-alias-ast mut[] = ()
	structs struct-decl-ast mut[] = ()
	funs fun-decl-ast mut[] = ()
	tests test-ast mut[] = ()
	vars var-decl-ast mut[] = ()

	first mut bool = true
	while !try-take-token end-of-file
		doc-comment =
			here = try-take-doc-comment
			if first
				first := false
				if !module-doc-comment.is-empty and here.is-empty and !no-std_ and !imports and !exports
					res = module-doc-comment
					module-doc-comment := ()
					res
				else
					here
			else
				here
		if peek end-of-file
			unless doc-comment.is-empty
				add-diag doc-comment.range!, parse-diag-doc-comment-unused
		elif peek region_
			x = take-next-token
			x is region_
			regions ~= prev-range
		else
			parse-spec-or-struct-or-fun-or-test specs, struct-aliases, structs, funs, tests, vars, doc-comment

	max-columns nat = 150 # TODO: CONFIGURABLE (and default should be more like 100) ----------------------------------------------------------------
	for diag in lines-over-n-columns lcg, max-columns
		add-diag (diag.pos, diag.pos + 1),
			parse-diag-line-too-long diag.actual-columns, max-columns
	line-and-column-getter: lcg
	parse-diagnostics: finish-diagnostics
	doc-comment: module-doc-comment
	no-std_: no-std_
	imports: imports
	re-exports: exports
	regions: regions.move-to
	specs: specs.move-to
	struct-aliases: struct-aliases.move-to
	structs: structs.move-to
	funs: funs.move-to
	tests: tests.move-to
	vars: vars.move-to

-warn-trailing-whitespace void(lcg line-and-character-getter) parser
	source = lcg.source-text
	do for pos in lcg.line-to-pos[1 .. end]
	do if pos > 1
	source[pos - 1] is "\n"
	do if is-whitespace-non-newline source[pos - 2]
	add-diag ((find-first-space source, pos - 2), pos), parse-diag-trailing-whitespace
-find-first-space pos(source char8 array-view, end pos)
	cur mut = end
	while is-whitespace-non-newline source[cur - 1]
		cur -:= 1
	cur
