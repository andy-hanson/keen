import
	crow/parse
	../../model/parse-diag
	../../model/source-range
	../../util/parse-util

add-diag alias
	void mut(pos pos, diag parse-diag)
cb-comment alias
	void mut(pos pos)

indent-kind enum(tabs, spaces-2, spaces-4, ignore)

detect-indent-kind indent-kind(a char8 array-view)
	ptr string-mut-iterator = a,
	loop
		begin = ptr pos
		match ptr peek8
		as "\0"
			break tabs
		as "\t"
			break tabs
		as " "
			while ptr try-take-char " "
				()
			n = ptr.pos - begin
			break if n == 2
				spaces-2
			else
				spaces-4
		else
			ptr skip-until-newline
			_ = ptr try-take-char "\n"
			continue

skip-until-newline void(a string-mut-iterator)
	while a !is-at-end and a.peek8 != "\n"
		_ = a take-char8

| Used to lex the tokens that appear between AST nodes for syntax highlighting.
lex-tokens-between-asts void
	source string
	range source-range
	cb-comment void mut(x source-range)
	cb-keyword void mut(x source-range)
do
	ptr string-mut-iterator = source,
	ptr advance range.start.to
	end = range end
	while ptr.pos < end
		ptr skip-for-tokens end, of pos
			cb-comment[pos, ptr.pos]
		if ptr.pos < end
			start = ptr pos
			while ptr.peek8 !ignore-char-for-tokens and ptr.pos < end
				_ = ptr take-char8
			cb-keyword[start, ptr.pos]

| Does not skip newlines (unless within a comment), only spaces within a line
skip-spaces-and-comments void(ptr string-mut-iterator, cb-comment cb-comment, add-diag add-diag)
	loop
		start = ptr pos
		if ptr.peek8 is-whitespace-non-newline
			_ = ptr take-char8
			continue
		elif ptr.peek8 == "\\"
			if ptr try-take-line-continuation cb-comment
				continue
			else
				break
		elif ptr.peek8 == "#"
			if ptr try-take-triple-hash-then-newline
				ptr skip-rest-of-block-comment add-diag
				cb-comment[start]
			else
				while ptr try-take-char " "
					()
				ptr skip-until-newline
				cb-comment[start]
			continue
		else
			break

skip-blank-lines-and-get-indent-delta int
	ptr string-mut-iterator
	indent-kind indent-kind
	cur-indent nat reference
	add-diag add-diag
do
	loop
		start mut = ptr pos
		new-indent mut nat = 0
		cb-start-of-loop void mut() = of
			start := ptr pos
			new-indent := ptr take-indent-amount-after-newline indent-kind, add-diag
		ptr skip-blank-lines cb-start-of-loop, it.noop, add-diag
		if ptr is-at-end
			# Ignore indent before end of file
			new-indent := 0
		
		# If we got here, we're looking at a non-empty line (or end of file)
		delta int = new-indent.to - cur-indent.get.to
		if delta > 1
			add-diag[start, parse-diag-indent-too-much]
			ptr skip-rest-of-line-and-newline
			continue
		else
			cur-indent set new-indent
			break delta

-may-continue-onto-next-line bool(ptr string-mut-iterator, indent-kind indent-kind, min-indent nat)
	start = ptr pos
	while ptr try-take-char " "
		()
	if ptr try-take-newline
		diag mut = false
		new-indent = ptr take-indent-amount-after-newline indent-kind, of _
			diag := true
		if new-indent >= min-indent and !diag
			true
		else
			ptr.pos := start
			false
	else
		false

-try-take-line-continuation bool(ptr string-mut-iterator, cb-comment cb-comment)
	if ptr.peek8 == "\\"
		ptr2 = ptr copy
		_ = ptr2 take-char8
		res = ptr2 may-continue-onto-next-line ignore, 0
		if res
			start = ptr pos
			_ = ptr take-char8
			cb-comment[start]
			ptr.pos := ptr2.pos
		res

-ignore-char-for-tokens bool(a char8)
	a is-whitespace or a == "\\" or a == "#" or a is-non-keyword-punctuation

-skip-for-tokens void(ptr string-mut-iterator, end pos, cb-comment cb-comment)
	loop
		guard ptr.pos < end else break
		start = ptr pos
		while ptr.peek8 is-non-keyword-punctuation and ptr.pos < end
			_ = ptr take-char8
		if ptr.pos < end
			ptr skip-spaces-and-comments cb-comment, it.noop
		if ptr.pos < end and ptr.peek8 == "\\"
			# Non-comment '\', skip this too
			_ = ptr take-char8
		if ptr.pos < end
			ptr skip-blank-lines it.noop, cb-comment, it.noop
		if ptr.pos == start
			break
		else
			continue

| Used for completions and signature help.
| Walks to the left skipping whitespace on the same line. Can also skip a single '.'.
walk-backwards-for-position pos(source-text string, pos pos)
	ptr string-mut-iterator = source-text.to, 0, pos.to, source-text.size
	ptr skip-whitespace-backwards
	if ptr.pos != 0 and ptr[-1] == "."
		ptr.pos -:= 1
		ptr skip-whitespace-backwards
	ptr pos
-skip-whitespace-backwards void(a string-mut-iterator)
	loop
		if a.pos != 0 and a[-1] == " "
			a.pos -:= 1
			continue
		else
			break

| Skip mundane punctuation instead of highlighting it as a keyword
-is-non-keyword-punctuation bool(a char8)
	a == "." or a == "," or a == "(" or a == ")" or a == "[" or a == "]"

-skip-blank-lines void
	ptr string-mut-iterator
	cb-start-of-loop void mut()
	cb-comment cb-comment
	add-diag add-diag
do
	loop
		cb-start-of-loop[]
		before = ptr pos
		if ptr try-take-newline
			continue
		elif ptr try-take-triple-hash-then-newline
			ptr skip-rest-of-block-comment add-diag
			cb-comment[before]
			continue
		elif ptr try-take-char "#"
			while ptr try-take-char " "
				()
			ptr skip-until-newline
			cb-comment[before]
			continue
		elif ptr try-take-line-continuation cb-comment
			continue
		else
			break

-skip-rest-of-line-and-newline void(ptr string-mut-iterator)
	ptr skip-until-newline
	_ = ptr try-take-newline

-try-take-newline bool(ptr string-mut-iterator)
	if ptr try-take-char "\r"
		_ = ptr try-take-char "\n"
		true
	else
		ptr try-take-char "\n"

-take-indent-amount-after-newline nat(ptr string-mut-iterator, indent-kind indent-kind, add-diag add-diag)
	match indent-kind
	as tabs
		begin = ptr pos
		while ptr try-take-char "\t"
			()
		if ptr.peek8 == " "
			start-spaces = ptr pos
			while ptr try-take-char " "
				()
			add-diag[start-spaces, true.parse-diag-indent-wrong-character]
		ptr.pos - begin to
	as spaces-2
		ptr take-indent-amount-after-newline-spaces 2, add-diag
	as spaces-4
		ptr take-indent-amount-after-newline-spaces 4, add-diag
	as ignore
		while ptr try-take-char "\t" or ptr try-take-char " "
			()
		0

-take-indent-amount-after-newline-spaces nat(ptr string-mut-iterator, n-spaces-per-indent nat, add-diag add-diag)
	begin = ptr pos
	while ptr try-take-char " "
		()
	if ptr.peek8 == "\t"
		start-tabs = ptr pos
		while ptr try-take-char "\t"
			()
		add-diag[start-tabs, false.parse-diag-indent-wrong-character]
	n-spaces nat = ptr.pos - begin to
	res = n-spaces / n-spaces-per-indent
	if res * n-spaces-per-indent != n-spaces
		add-diag[begin, (n-spaces parse-diag-indent-not-divisible n-spaces-per-indent)]
	res

-try-take-triple-hash-then-newline bool(ptr string-mut-iterator)
	ptr2 = ptr copy
	if ptr2 try-take "###"
		while ptr2 try-take-char " "
			()
		if ptr2 try-take-newline or ptr2 is-at-end
			ptr.pos := ptr2 pos
			true

| Returns the end of the comment text (ptr will be advanced further, past the '###')
skip-rest-of-block-comment void(ptr string-mut-iterator, add-diag add-diag)
	loop
		while ptr try-take-char "\t" or ptr try-take-char " "
			()
		if ptr try-take-triple-hash-then-newline
			break
		elif ptr is-at-end
			add-diag[ptr.pos, block-comment-end]
			break
		else
			ptr skip-rest-of-line-and-newline
			continue
