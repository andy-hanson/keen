import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	../../model/uri
	./lexer
	./parse-type
	./parse-util
	./token

parse-imports-or-exports imports-or-exports-ast?(lexer lexer, keyword token)
	start = lexer.next-start
	if try-take-token lexer, keyword
		imports = take-indent-or-fail-generic lexer, (of then parse-import-lines lexer), it.noop
		(range lexer, start), imports

-parse-import-lines import-or-export-ast[](lexer lexer)
	do with out in build
	do loop
	out ~= parse-single-module-import-on-own-line lexer
	match take-newline-or-dedent lexer
	as newline
		continue
	as dedent
		break

-parse-import-path (path-or-rel-path, bool)(lexer lexer)
	n-parents nat? = if try-take-token lexer, dot
		_ = take-or-add-diag-expected-operator lexer, "/", slash
		0
	elif try-take-operator lexer, ".."
		_ = take-or-add-diag-expected-operator lexer, "/", slash
		take-dot-dot-slashes lexer
	first-component, first-colon = take-path-component lexer
	path, colon = add-path-components lexer, (first-component.root-path, first-colon)
	if n-parents
		(rel-path n-parents, path), colon
	else
		path, colon

-take-dot-dot-slashes nat(lexer lexer)
	acc mut nat = 1
	while try-take-operator lexer, ".."
		_ = take-or-add-diag-expected-operator lexer, "/", slash
		acc +:= 1
	acc

-add-path-components (path, bool)(lexer lexer, start (path, bool))
	acc mut, colon mut = start
	while !colon and try-take-operator lexer, "/"
		name, new-colon = take-path-component lexer
		acc /:= name.to
		colon := new-colon
	acc, colon

-parse-single-module-import-on-own-line import-or-export-ast(lexer lexer)
	start = lexer.next-start
	path, ends-with-colon = parse-import-path lexer
	path-range = range-allow-empty lexer, start
	kind = parse-import-or-export-kind lexer, start, ends-with-colon
	(range-allow-empty lexer, start), path, path-range, kind

-parse-import-or-export-kind import-or-export-ast-kind(lexer lexer, start pos, colon bool)
	if colon
		if peek-name-or-operator lexer
			take-comma-separated-names-diag-trailing-comma lexer
		else
			take-indent-or-fail-generic lexer, (of then parse-indented-import-names lexer, start), of _ then import-whole-module-ast
	elif try-take-token lexer, as_
		name = take-name-and-range lexer
		type = parse-type lexer
		import-file-ast name, type, to-import-file-type-or-diag lexer, type
	else
		import-whole-module-ast

-to-import-file-type-or-diag import-file-type(lexer lexer, type type-ast)
	to-import-file-type type else
		add-diag lexer, type.range, parse-diag-import-file-type-not-supported
		string

-to-import-file-type import-file-type?(a type-ast)
	if is-simple-name a, "string"
		string
	elif is-nat8-array a
		nat8-array

-is-simple-name bool(a type-ast, name symbol)
	a.name-and-range and a.name == name
-is-nat8-array bool(a type-ast)
	a.suffix-special-type-ast and a.kind == array and is-simple-name a.left, "nat8"

-parse-indented-import-names name-and-range[](lexer lexer, start pos)
	do with out in build
	do loop
	trailing-comma = take-comma-separated-names lexer, out
	match take-newline-or-dedent lexer
	as newline
		unless trailing-comma
			add-diag lexer, (range lexer, start), comma::parse-diag-expected
		continue
	as dedent
		add-diag-if-trailing-comma lexer, trailing-comma
		break

-take-path-component (symbol, bool)(lexer lexer)
	cur mut, colon mut = take-path-component-name lexer
	while !colon and p = take-path-component-punctuation lexer
		name, new-colon = take-path-component-name lexer
		cur := "{cur}{p}{name}"
		colon := new-colon
	cur, colon

-take-path-component-name (symbol, bool)(lexer lexer)
	if x = try-take-name-colon lexer
		x, true
	else
		lexer.take-name-allow-name-like-keywords, false

-take-path-component-punctuation string?(lexer lexer)
	if try-take-token lexer, dollar
		"$"
	elif try-take-token lexer, dot
		"."
