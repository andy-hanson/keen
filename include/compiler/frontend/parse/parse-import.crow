import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	../../model/uri
	./lexer
	./parse-type
	./parse-util
	./token

parse-imports-or-exports imports-or-exports-ast?(lexer lexer, keyword token)
	start = lexer cur-pos
	if lexer try-take-token keyword
		imports = lexer take-indent-or-fail-generic (of then lexer parse-import-lines), it.noop
		(lexer range start), imports

-parse-import-lines import-or-export-ast[](lexer lexer)
	with out in build
		loop
			out ~= lexer parse-single-module-import-on-own-line
			match lexer take-newline-or-dedent
			as newline
				continue
			as dedent
				break

-parse-import-path (path-or-rel-path, bool)(lexer lexer)
	n-parents nat? = if lexer try-take-token dot
		_ = lexer take-or-add-diag-expected-operator "/", slash
		0
	elif lexer try-take-operator ".."
		_ = lexer take-or-add-diag-expected-operator "/", slash
		lexer take-dot-dot-slashes
	first-component, first-colon = lexer take-path-component
	path, colon = lexer add-path-components (first-component.root-path, first-colon)
	if n ?= n-parents
		(n rel-path path), colon
	else
		path, colon

-take-dot-dot-slashes nat(lexer lexer)
	acc mut nat = 1
	while lexer try-take-operator ".."
		_ = lexer take-or-add-diag-expected-operator "/", slash
		acc +:= 1
	acc

-add-path-components (path, bool)(lexer lexer, start (path, bool))
	acc mut, colon mut = start
	while !colon and lexer try-take-operator "/"
		name, new-colon = lexer take-path-component
		acc /:= name to
		colon := new-colon
	acc, colon

-parse-single-module-import-on-own-line import-or-export-ast(lexer lexer)
	start = lexer cur-pos
	path, ends-with-colon = lexer parse-import-path
	path-range = lexer range start
	kind = lexer parse-import-or-export-kind start, ends-with-colon
	(lexer range start), path, path-range, kind

-parse-import-or-export-kind import-or-export-ast-kind(lexer lexer, start pos, colon bool)
	if colon
		if lexer peek-name-or-operator
			lexer take-comma-separated-names-diag-trailing-comma
		else
			lexer take-indent-or-fail-generic (of then lexer parse-indented-import-names start), of _ then import-whole-module-ast
	elif lexer try-take-token as_
		name = lexer take-name-and-range
		type = lexer parse-type
		name import-file-ast type, (lexer to-import-file-type-or-diag type)
	else
		import-whole-module-ast

-to-import-file-type-or-diag import-file-type(lexer lexer, type type-ast)
	type to-import-file-type else
		lexer add-diag type.range, parse-diag-import-file-type-not-supported
		string

-to-import-file-type import-file-type?(a type-ast)
	if a is-simple-name "string"
		string
	elif a is-nat8-array
		nat8-array

-is-simple-name bool(a type-ast, name symbol)
	x ?= a name-and-range and x.name == name
-is-nat8-array bool(a type-ast)
	x ?= a suffix-special-type-ast and x.kind == array and x.left is-simple-name "nat8"

-parse-indented-import-names name-and-range[](lexer lexer, start pos)
	with out in build
		loop
			trailing-comma = lexer take-comma-separated-names out
			match lexer take-newline-or-dedent
			as newline
				unless _ ?= trailing-comma
					lexer add-diag (lexer range start), comma::parse-diag-expected
				continue
			as dedent
				lexer add-diag-if-trailing-comma trailing-comma
				break

-take-path-component (symbol, bool)(lexer lexer)
	cur mut, colon mut = lexer take-path-component-name
	while !colon and p ?= lexer take-path-component-punctuation
		name, new-colon = lexer take-path-component-name
		cur := "{cur}{p}{name}"
		colon := new-colon
	cur, colon

-take-path-component-name (symbol, bool)(lexer lexer)
	if x ?= lexer try-take-name-colon
		x, true
	elif lexer try-take-token unsafe_
		"unsafe", false
	else
		lexer.take-name-allow-name-like-keywords, false

-take-path-component-punctuation string?(lexer lexer)
	if lexer try-take-token dollar
		"$"
	elif lexer try-take-token dot
		"."
