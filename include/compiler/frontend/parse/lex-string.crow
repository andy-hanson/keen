import
	crow/bits
	crow/parse
	../../../crow/private/parse-util
	../../../crow/string: unicode-encode
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	./lex-whitespace

string-part record(range source-range, text string, after string-part-after)
string-part-after enum(done, lbrace)

| An indented quote ends in 0 or more dedents, or a brace.
indented-quote-part-after union(nat32, lbrace)
lbrace record
| This assumes we have already taken the indent after the 'quote' keyword
take-indented-quote-part (source-range, string, indented-quote-part-after)
	iter string-mut-iterator
	indent-kind indent-kind
	cur-indent nat32 reference
	add-diag add-diag
do
	forbid cur-indent.get == 0
	out char8 mut[] = ()
	range-start = iter pos
	range-end pos, after indented-quote-part-after = loop
		start = iter pos
		match iter peek8
		as "\{"
			_ = iter take-char8
			break start, lbrace
		as "\\"
			_ = iter take-char8
			start take-string-escape iter, (of x then out ~= x), add-diag
			continue
		as "\n"
			_ = iter take-char8
			while iter try-take-char8 "\n"
				()
			new-indent = iter take-indent-amount-after-newline indent-kind, of pos
				add-diag[pos, indent-kind.parse-diag-indent-wrong]
			prev-indent = cur-indent get
			if new-indent < prev-indent
				cur-indent set new-indent
				break start, prev-indent - new-indent
			else
				out ~~= "\n"
				out add-indent indent-kind, (new-indent - prev-indent).to
				continue
		as "\0"
			prev-indent = cur-indent get
			cur-indent set 0
			break start, prev-indent
		else
			out ~= iter take-char8
			continue
	(range-start, range-end), out.move-to, after

-add-indent void(out char8 mut[], indent-kind indent-kind, amount nat)
	match indent-kind
	as tabs
		for _ in 0 .. amount
			out ~= "\t"
	as spaces-2
		out ~~= "  "::char8[] repeat amount
	as spaces-4
		out ~~= "    "::char8[] repeat amount

take-string-part string-part(ptr string-mut-iterator, quote-kind quote-kind, add-diag add-diag)
	forbid quote-kind == indented # use take-idnented-quote-part
	start-pos = ptr pos
	res char8 mut[] = ()
	cb-char void mut(x char8) = of x
		if quote-kind != bar
			res ~= x
	range, after = ptr take-string-range start-pos, quote-kind, cb-char, add-diag
	range, res.move-to::char8[].to, after

-take-string-range (source-range, string-part-after)
	ptr string-mut-iterator
	start-pos pos
	quote-kind quote-kind
	cb-char void mut(x char8)
	add-diag add-diag
do
	part-start = ptr pos
	loop
		start = ptr pos
		finish-here (source-range, string-part-after) mut(after string-part-after) = of after
			- start-pos range-of-start-and-length start - part-start
			- after
		match ptr.peek8 combine-newline
		as "\""
			_ = ptr take-char8
			match quote-kind
			as bar
				cb-char["\""]
				continue
			as double
				break finish-here[done]
			as double3
				if ptr try-take "\"\""
					break finish-here[done]
				else
					cb-char["\""]
					continue
			as indented
				throw unreachable
		as "\{"
			_ = ptr take-char8
			break finish-here[lbrace]
		as "\\"
			_ = ptr take-char8
			start take-string-escape ptr, cb-char, add-diag
			continue
		as "\n"
			match quote-kind
			as bar
				ptr2 = ptr copy
				while ptr2.peek8 is-whitespace
					_ = ptr2 take-char8
				if ptr2.peek8 == "|"
					_ = ptr2 take-char8
					_ = ptr2 try-take-char8 " "
					ptr.pos := ptr2 pos
					cb-char["\n"]
					continue
				else
					break finish-here[done]
			as double
				add-diag[start, quote-double::parse-diag-expected]
				break finish-here[done]
			as double3
				cb-char[ptr take-char8]
				continue
			as indented
				throw unreachable
		as "\0"
			match quote-kind
			as bar
				()
			as double
				add-diag[start, quote-double::parse-diag-expected]
			as double3
				add-diag[start, quote-double3::parse-diag-expected]
			as indented
				throw unreachable
			break finish-here[done]
		else
			cb-char[ptr take-char8]
			continue

-combine-newline char8(a char8)
	if a == "\r" then "\n" else a

-take-string-escape void(start pos, ptr string-mut-iterator, cb-char void mut(x char8), add-diag add-diag)
	match ptr take-char8
	as "\\"
		cb-char["\\"]
	as "\{"
		cb-char["\{"]
	as "0"
		cb-char["\0"]
	as "\""
		cb-char["\""]
	as "n"
		cb-char["\n"]
	as "r"
		cb-char["\r"]
	as "t"
		cb-char["\t"]
	as "u"
		start take-unicode-escape ptr, cb-char, add-diag, 2
	as "U"
		start take-unicode-escape ptr, cb-char, add-diag, 4
	as "x"
		start take-unicode-escape ptr, cb-char, add-diag, 1
	else
		start string-escape-error ptr, cb-char, add-diag

-take-unicode-escape void
	start pos
	ptr string-mut-iterator
	cb-char void mut(x char8)
	add-diag add-diag
	n-bytes nat
do
	try
		full-char mut nat32 = 0
		for _ in 0::nat .. n-bytes
			assert x ?= ptr take-char-escape else 0 invalid-unicode-character
			full-char := (full-char << 8) | x.to
		full-char unicode-encode cb-char[it.to]
	catch invalid-unicode-character _
		start string-escape-error ptr, cb-char, add-diag

-string-escape-error void(start pos, ptr string-mut-iterator, cb-char void mut(x char8), add-diag add-diag)
	diag = ptr string-from start parse-diag-invalid-string-escape
	add-diag[start, diag]
	for x in "�"::char8[]
		cb-char[x]

-take-char-escape nat8?(a string-mut-iterator)
	if digit0 ?= a try-take-hex-digit
		if digit1 ?= a try-take-hex-digit
			(digit0 << 4) | digit1

-try-take-hex-digit nat8?(a string-mut-iterator)
	if x ?= a.peek8 decode-hex-digit
		_ = a take-char8
		x
