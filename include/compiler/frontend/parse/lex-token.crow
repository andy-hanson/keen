import
	../../../crow/parse
	../../../crow/private/parse-util
	../../model/source-range
	./lex-whitespace
	./token

token-and-data record
	-dummy void
	token token
	token-data token-data
token-data union(void, symbol, extra-dedents, char32, source-range)
extra-dedents record(extra-dedents nat32)

new token-and-data(token token)
	forbid token is-symbol-token
	forbid token is-newline-token
	forbid token == unexpected-character
	forbid token == region_
	(), token, ()::void
new token-and-data(token token, name symbol)
	assert token is-symbol-token
	(), token, name
new token-and-data(token token, d extra-dedents)
	assert token is-newline-token
	(), token, d
new token-and-data(token token, c char32)
	assert token == unexpected-character
	(), token, c
new token-and-data(token token, r source-range)
	assert token == region_
	(), token, r

is-symbol bool(a token-and-data)
	a.token is-symbol-token
as-symbol symbol(a token-and-data) # TODO: have a function returning an option instead of using an 'is' and 'as' pair -------------
	assert a.token is-symbol-token
	a.token-data symbol!
as-extra-dedents nat32(a token-and-data)
	assert a.token is-newline-token
	a.token-data.extra-dedents! extra-dedents
as-unexpected-character char32(a token-and-data)
	assert a.token == unexpected-character
	a.token-data char32!
as-region source-range(a token-and-data)
	assert a.token == region_
	a.token-data source-range!

plain-token token-and-data(a token)
	a,

is-newline-token bool(a token)
	match a
	as end-of-file
		true
	as newline-dedent
		true
	as newline-indent
		true
	as newline-same-indent
		true
	else
		false

is-symbol-token bool(a token)
	match a
	as name
		true
	as name-after-bang
		true
	as name-bang
		true
	as name-colon
		true
	as name-or-operator-equals
		true
	as name-or-operator-colon-equals
		true
	as operator
		true
	as name-after-question
		true
	else
		false

lex-initial-token token-and-data(ptr string-mut-iterator, indent-kind indent-kind, cur-indent nat32 reference, add-diag add-diag)
	ptr newline-token newline-same-indent, indent-kind, cur-indent, add-diag

| Advances {ptr} to lex a single token.
lex-token token-and-data
	ptr string-mut-iterator
	indent-kind indent-kind
	prev-token token
	cur-indent nat32 reference
	add-diag add-diag
do
	guard ptr !is-at-end else ptr newline-token end-of-file, indent-kind, cur-indent, add-diag

	start = ptr pos
	match ptr take-char8
	# skip-spaces-and-comments will prevent these characters from being next
	as " "
		throw unreachable
	as "\t"
		throw unreachable
	as "\r"
		throw unreachable
	as "#"
		throw unreachable
	as "\n"
		ptr newline-token newline-same-indent, indent-kind, cur-indent, add-diag
	as "~"
		ptr operator-token if ptr try-take-char8 "~" then "~~" else "~"
	as "@"
		at plain-token
	as "!"
		if ptr try-take-char8 "="
			ptr operator-token "!="
		elif name ?= ptr try-take-crow-identifier
			name-after-bang, name
		else
			bang plain-token
	as "%"
		ptr operator-token "%"
	as "^"
		ptr operator-token "^"
	as "&"
		ptr operator-token "&"
	as "*"
		ptr operator-token if ptr try-take-char8 "*" then "**" else "*"
	as "("
		paren-left plain-token
	as ")"
		paren-right plain-token
	as "["
		bracket-left plain-token
	as "]"
		bracket-right plain-token
	as "\{"
		brace-left plain-token
	as "}"
		brace-right plain-token
	as "-"
		if ptr.peek8 is-digit
			ptr take-number-after-sign
		elif ptr try-take-char8 "-"
			ptr operator-token "--"
		else
			ptr operator-token "-"
	as "="
		if ptr try-take-char8 "="
			ptr operator-token "=="
		else
			equal plain-token
	as "+"
		if ptr.peek8 is-digit
			ptr take-number-after-sign
		else
			ptr operator-token "+"
	as "|"
		if prev-token is-newline-token and ptr.peek8 is-whitespace
			quote-bar plain-token
		else
			ptr operator-token "|"
	as ":"
		if ptr try-take-char8 "="
			colon-equal plain-token
		elif ptr try-take-char8 ":"
			colon2 plain-token
		else
			colon plain-token
	as "\""
		(if ptr try-take "\"\"" then quote-double3 else quote-double) plain-token
	as ","
		comma plain-token
	as "<"
		ptr operator-token if ptr try-take-char8 "="
			if ptr try-take-char8 ">" then "<=>" else "<="
		elif ptr try-take-char8 "<"
			"<<"
		else
			"<"
	as ">"
		ptr operator-token if ptr try-take-char8 "="
			">="
		elif ptr try-take-char8 ">"
			">>"
		else
			">"
	as "."
		if ptr try-take-char8 "."
			if ptr try-take-char8 "."
				dot3 plain-token
			else
				ptr operator-token ".."
		else
			dot plain-token
	as "$"
		dollar plain-token
	as "/"
		ptr operator-token "/"
	as "?"
		if ptr try-take-char8 "="
			question-equal plain-token
		elif ptr try-take-char8 "["
			question-bracket plain-token
		elif name ?= ptr try-take-crow-identifier
			name-after-question, name
		else
			question plain-token
	else x
		ptr.pos := start
		if x is-digit
			ptr take-number-after-sign
		else
			ptr lex-identifier-like

-lex-identifier-like token-and-data(ptr string-mut-iterator)
	start = ptr pos
	if symbol ?= ptr try-take-crow-identifier
		if ptr try-take-just-colon
			name-colon, symbol
		else
			match symbol token-for-symbol
			as name
				ptr name-like-token symbol, name
			as region_
				ptr skip-until-newline
				region_, (start, ptr.pos)
			as for_
				(if ptr try-take "*" then for-star else for_) plain-token
			else x
				x plain-token
	else
		unexpected-character, ptr.must-take-one-unicode-char

lookahead-equals bool(start string-mut-iterator)
	ptr = start copy
	loop
		if ptr try-take-char8 " "
			if ptr starts-with-then-whitespace "="
				break true
			else
				continue
		elif ptr try-skip-type-char
			continue
		else
			break false

lookahead-keyword bool(start string-mut-iterator, expected string)
	ptr = start copy
	ptr try-take expected and ptr.peek8 !is-probably-identifier-char-for-lookahead

elif-or-else enum(elif_, else_)
lookahead-elif-or-else elif-or-else?(start string-mut-iterator)
	if start lookahead-keyword "elif"
		elif_
	elif start lookahead-keyword "else"
		else_

-newline-token token-and-data
	ptr string-mut-iterator
	newline-or-eof token
	indent-kind indent-kind
	cur-indent nat32 reference
	add-diag add-diag
do
	delta = ptr skip-blank-lines-and-get-indent-delta indent-kind, cur-indent, add-diag
	token = if delta == 0
		newline-or-eof
	elif delta < 0
		newline-dedent
	else
		newline-indent
	extra-dedents = if delta < 0 then delta.abs - 1 else 0
	token, (extra-dedents,)::extra-dedents

-operator-token token-and-data(ptr string-mut-iterator, value symbol)
	ptr name-like-token value, operator

-name-like-token token-and-data(ptr string-mut-iterator, value symbol, regular-token token)
	if ptr !starts-with "==" and ptr try-take-char8 "="
		name-or-operator-equals, "{value}="
	else
		token = if regular-token == name and ptr try-take-char8 "!"
			name-bang
		elif ptr try-take ":="
			name-or-operator-colon-equals
		else
			regular-token
		token, value

-try-take-just-colon bool(a string-mut-iterator)
	if a.peek8 == ":" and a.peek8-next != ":" and a.peek8-next != "="
		_ = a take-char8
		true

-token-for-symbol token(a symbol)
	match a
	as "abstract"
		reserved-abstract
	as "alias"
		alias_
	as "and"
		and_
	as "as"
		as_
	as "assert"
		assert_
	as "break"
		break_
	as "builtin"
		builtin_
	as "case"
		case_
	as "catch"
		catch_
	as "class"
		reserved-class
	as "continue"
		continue_
	as "data"
		data_
	as "do"
		do_
	as "elif"
		elif_
	as "else"
		else_
	as "enum"
		enum_
	as "export"
		export_
	as "extern"
		extern_
	as "finally"
		finally_
	as "flags"
		flags_
	as "for"
		for_
	as "force-data"
		force-data_
	as "force-shared"
		force-shared_
	as "forbid"
		forbid_
	as "global"
		global_
	as "guard"
		guard_
	as "if"
		if_
	as "import"
		import_
	as "in"
		in_
	as "interface"
		interface_
	as "it"
		it_
	as "loop"
		loop_
	as "match"
		match_
	as "mut"
		mut_
	as "no-std"
		no-std_
	as "of"
		of_
	as "or"
		or_
	as "pure"
		pure_
	as "record"
		record_
	as "region"
		region_
	as "shared"
		shared_
	as "spec"
		spec_
	as "storage"
		storage_
	as "summon"
		summon_
	as "test"
		test_
	as "then"
		then_
	as "thread-local"
		thread-local_
	as "throw"
		throw_
	as "trusted"
		trusted_
	as "try"
		try_
	as "unless"
		unless_
	as "union"
		union_
	as "unsafe"
		unsafe_
	as "until"
		until_
	as "variant"
		variant_
	as "while"
		while_
	as "with"
		with_
	as "_"
		underscore
	else
		name

-take-number-after-sign token-and-data(ptr string-mut-iterator)	
	ptr take-number-after-sign
	literal-number,

-try-skip-type-char bool(ptr string-mut-iterator)
	if ptr.peek8 is-type-char
		_ = ptr take-char8
		true

-is-type-char bool(a char8)
	a == " " or
	a == "," or
	a == "?" or
	a == "[" or
	a == "]" or
	a == "(" or
	a == ")" or
	a is-probably-identifier-char-for-lookahead
