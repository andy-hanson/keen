import
	../../model/ast
	./token

no-interpolated token(kind quote-kind)
	match kind
	as bar
		quote-bar-no-interpolated
	as double
		quote-double-no-interpolated
	as indented
		quote-block-no-interpolated

then-interpolated token(kind quote-kind)
	match kind
	as bar
		quote-bar-then-interpolated
	as double
		quote-double-then-interpolated
	as indented
		quote-block-then-interpolated

is-newline-token bool(a token)
	match a
	as end-of-file
		true
	as newline-dedent
		true
	as newline-indent
		true
	as newline-same-indent
		true
	else
		false

is-symbol-token bool(a token)
	match a
	as name
		true
	as name-after-bang
		true
	as name-bang
		true
	as name-colon
		true
	as name-or-operator-equals
		true
	as name-or-operator-colon-equals
		true
	as operator
		true
	as name-after-question
		true
	else
		false
