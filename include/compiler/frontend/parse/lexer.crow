import
	crow/parse
	../../model/parse-diag
	../../model/source-range
	../../model/uri
	../../util/parse-util
	./lex-string
	./lex-token
	./lex-whitespace
	./token

lexer record mut
	uri uri
	-ptr string-mut-iterator
	-indent-kind indent-kind
	| This is the indent at {ptr}, after {next-token}
	-cur-indent nat reference
	prev-token-end mut pos # TODO:PRIVATE ------------------------------------------------------------------------------------------
	-next-token-pos mut pos
	-diagnostics-builder parse-diagnostic mut[]
	-next-token mut token-and-data

create-lexer lexer(uri uri, source string) # TODO: just call it 'new' ---------------------------------------------------------
	ptr string-mut-iterator = source,
	indent-kind = source detect-indent-kind
	lexer lexer = uri, ptr, indent-kind, (0,), 0, 0, (), (alias_,)
	lexer.next-token := lexer.ptr lex-initial-token lexer.indent-kind, lexer.cur-indent, diag => lexer add-diag-from-pointer diag
	lexer

-add-diag-from-pointer void(lexer lexer, (start pos, diag parse-diag)) # TODO: RENAME -----------------------------------------
	lexer add-diag (start, lexer.pos-at-ptr), diag

cur-pos pos(lexer lexer)
	lexer next-token-pos
pos-at-ptr pos(lexer lexer) # TODO: INTERNAL -------------------------------------------------------------------------------
	lexer.ptr pos

add-diag void(lexer lexer, range source-range, diag parse-diag)
	lexer.diagnostics-builder ~= range, diag

finish-diagnostics parse-diagnostic[](lexer lexer)
	lexer.diagnostics-builder move-to

add-diag-at-char void(lexer lexer, diag parse-diag)
	lexer add-diag lexer.range-at-char, diag

range-at-char source-range(lexer lexer)
	pos pos = lexer cur-pos
	next-pos pos = match lexer.ptr peek8
	as "\0"
		pos
	as "\r"
		# Treat "\r\n" as one character
		pos + (lexer.ptr[1] == "\n" ? 2 : 1)
	else
		pos + 1
	pos, next-pos

add-diag-unexpected-cur-token void(lexer lexer, start pos, token token-and-data)
	diag parse-diag = match token token
	as unexpected-character
		token.as-unexpected-character parse-diag-unexpected-character
	as operator
		token.as-symbol parse-diag-unexpected-operator
	else
		token.token parse-diag-unexpected-token
	lexer add-diag (lexer range-for-cur-token start), diag

range source-range(lexer lexer, start pos)
	start, (lexer.prev-token-end max start) # TODO: shouldn't need 'max' ---------------------------------------------------------

range-for-cur-token source-range(lexer lexer, start pos)
	if lexer.get-peek-token is-newline-token
		start, start
	else
		start, (lexer.pos-at-ptr max start)

skip-until-newline-no-diag void(lexer lexer)
	unless lexer.get-peek-token is-newline-token
		lexer.ptr skip-until-newline
		lexer read-next-token
	assert lexer.get-peek-token is-newline-token

must-take-token void(lexer lexer, token token)
	actual = lexer.take-next-token token
	actual is token

take-next-token token-and-data(lexer lexer)
	res = lexer next-token
	if res.token == newline-dedent
		extra-dedents = res as-extra-dedents
		lexer.next-token := if extra-dedents == 0
			newline-same-indent, (0,)::extra-dedents # TODO: do we need the extra-dedents for this token?????????????????
		else
			newline-dedent, (extra-dedents - 1,)::extra-dedents
	elif res.token is-quote-token
		lexer.next-token := quoted-text,
	else
		lexer read-next-token
	res

-is-quote-token bool(a token)
	a == quote-bar || a == quote-double || a == quote-double3

take-next-token-may-continue-onto-next-line token-and-data(lexer lexer)
	res = lexer take-next-token
	while lexer.next-token.token == newline-same-indent
		x = lexer take-next-token
		x.token is newline-same-indent
	res

-read-next-token void(lexer lexer)
	lexer.prev-token-end := lexer.ptr pos
	lexer.ptr skip-spaces-and-comments (_ => ()), diag => lexer add-diag-from-pointer diag
	lexer.next-token-pos := lexer pos-at-ptr
	lexer.next-token := lexer.ptr lex-token lexer.indent-kind, lexer.next-token.token, lexer.cur-indent, diag => lexer add-diag-from-pointer diag

get-peek-token-and-data token-and-data(lexer lexer)
	lexer next-token
get-peek-token token(lexer lexer)
	lexer.get-peek-token-and-data token

take-closing-brace-then-string-part string-part(lexer lexer, quote-kind quote-kind)
	if lexer.get-peek-token != brace-right
		start = lexer pos-at-ptr
		lexer add-diag-at-char close-interpolated
		lexer skip-until-newline-no-diag
		(start, lexer.pos-at-ptr), "", done
	else
		lexer take-string-part-common quote-kind

take-initial-string-part string-part(lexer lexer, quote-kind quote-kind)
	lexer.get-peek-token is quoted-text
	lexer take-string-part-common quote-kind

-take-string-part-common string-part(lexer lexer, quote-kind quote-kind)
	res = lexer.ptr take-string-part quote-kind, diag => lexer add-diag-from-pointer diag
	# Don't skip newline token (which is a parse error)
	unless lexer.get-peek-token is-newline-token
		_ = lexer take-next-token
	res

list-part-kind enum(single, multi)
-as-list-part-kind list-part-kind?(a symbol)
	match a
	as "-"
		single
	as "--"
		multi
	else
		()

try-take-list-part-kind list-part-kind?(lexer lexer)
	n = lexer next-token
	guard n.token == operator
	guard res ?= n.as-symbol as-list-part-kind
	guard lexer.ptr.peek8 is-whitespace
	lexer must-take-token operator
	res
lookahead-equals bool(lexer lexer)
	lexer.get-peek-token == equal || lexer.ptr lookahead-equals

lookahead-new-visibility bool(lexer lexer)
	lexer.get-peek-token-and-data is-visibility && lexer.ptr lookahead-keyword "new"
-is-visibility bool(a token-and-data)
	if a.token == operator
		op = a as-symbol
		op == "-" || op == "~" || op == "+"

lookahead-name-colon bool(lexer lexer)
	lexer.get-peek-token == name && lexer.ptr lookahead-colon

lookahead-question-equals bool(lexer lexer)
	lexer.get-peek-token == question-equal || lexer.ptr lookahead-question-equals

lookahead-lambda bool(lexer lexer)
	lexer.get-peek-token == paren-left && lexer.ptr lookahead-lambda-after-paren-left

lookahead-open-paren bool(lexer lexer)
	lexer.ptr.peek8 == "("
lookahead-open-bracket bool(lexer lexer)
	lexer.ptr.peek8 == "["

| Returns position of "as"
try-take-newline-then-as pos?(lexer lexer)
	lexer try-take-newline-then-keyword as_, "as"
try-take-newline-then-catch pos?(lexer lexer)
	lexer try-take-newline-then-keyword catch_, "catch"
| Returns position of "else"
try-take-newline-then-else pos?(lexer lexer)
	lexer try-take-newline-then-keyword else_, "else"
-try-take-newline-then-keyword pos?(lexer lexer, keyword token, keyword-string char8[])
	if lexer.get-peek-token == newline-same-indent && lexer.ptr lookahead-keyword keyword-string
		_ = lexer must-take-token newline-same-indent
		keyword-pos = lexer cur-pos
		_ = lexer must-take-token keyword
		keyword-pos

elif-or-else-keyword record(kind elif-or-else, pos pos)
try-take-newline-then-elif-or-else elif-or-else-keyword?(lexer lexer)
	if lexer.get-peek-token == newline-same-indent
		if kind ?= lexer.ptr lookahead-elif-or-else
			lexer must-take-token newline-same-indent
			pos = lexer cur-pos
			lexer must-take-token kind.to
			kind, pos

-to token(a elif-or-else)
	match a
	as elif_
		elif_
	as else_
		else_
