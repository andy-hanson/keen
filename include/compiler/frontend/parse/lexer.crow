import
	../../model/parse-diag
	../../model/source-range
	../../model/uri
	./lex-token
	./token
	./token-util

lexer record mut
	-next-index mut nat
	-tokens-starts-ends token-start-end[]
	-datas token-data[]
	uri uri
	-diagnostics-builder parse-diagnostic mut[]
	-source char8 array-view

new lexer(uri uri, source char8 array-view)
	diagnostics parse-diagnostic mut[] = ()
	tokens = lex-tokens source, diagnostics
	0, tokens.tokens-starts-ends, tokens.datas, uri, diagnostics, source

prev-range source-range(lexer lexer)
	lexer.prev-start, lexer.prev-end
prev-start pos(lexer lexer)
	lexer.tokens-starts-ends[lexer.next-index - 1].start
prev-end pos(lexer lexer)
	lexer.tokens-starts-ends[lexer.next-index - 1].end
-prev-token-data token-data(lexer lexer)
	lexer.datas[lexer.next-index - 1]
prev-string string(lexer lexer)
	lexer.prev-token-data.string!
prev-symbol symbol(lexer lexer)
	lexer.prev-token-data.symbol!

next-range source-range(lexer lexer)
	lexer.tokens-starts-ends[lexer.next-index].range
next-start pos(lexer lexer)
	lexer.tokens-starts-ends[lexer.next-index].start
next-symbol symbol(lexer lexer)
	lexer.datas[lexer.next-index].symbol!
next-next-symbol symbol(lexer lexer)
	lexer.datas[lexer.next-index + 1].symbol!

add-diag void(lexer lexer, range source-range, diag parse-diag)
	lexer.diagnostics-builder ~= range, diag

finish-diagnostics parse-diagnostic[](lexer lexer)
	lexer.diagnostics-builder.move-to

add-diag-at-next-token void(lexer lexer, diag parse-diag)
	add-diag lexer, lexer.next-range, diag

add-diag-unexpected-next-token void(lexer lexer)
	add-diag-unexpected-inner lexer, lexer.next-index
add-diag-unexpected-prev-token void(lexer lexer)
	add-diag-unexpected-inner lexer, lexer.next-index - 1
-add-diag-unexpected-inner void(lexer lexer, index nat)
	token = lexer.tokens-starts-ends[index]
	add-diag lexer, token.range, match token token
	as operator-binary
		parse-diag-unexpected-operator lexer.datas[index].symbol!
	else
		parse-diag-unexpected-token token.token

range source-range(lexer lexer, start pos)
	start, lexer.end-for-range
-end-for-range pos(lexer lexer)
	prev mut = lexer.next-index - 1
	while is-newline-token lexer.tokens-starts-ends[prev].token
		prev -:= 1
	lexer.tokens-starts-ends[prev].end
range-allow-empty source-range(lexer lexer, start pos)
	end = lexer.end-for-range
	start, (max end, start)

skip-until-newline-no-diag void(lexer lexer)
	until is-newline-token lexer.peek
		advance lexer

advance void(lexer lexer)
	lexer.next-index +:= 1

take-next-token token(lexer lexer)
	res = lexer.peek
	advance lexer
	res

advance-may-continue-onto-next-line void(lexer lexer)
	advance lexer
	while peek lexer, newline-same-indent
		advance lexer

peek token(lexer lexer)
	lexer.tokens-starts-ends[lexer.next-index].token
peek bool(lexer lexer, expected token)
	lexer.peek == expected
peek2 token(lexer lexer)
	lexer.tokens-starts-ends[lexer.next-index + 1].token
peek2 bool(lexer lexer, expected token)
	lexer.peek2 == expected

lookahead-equals bool(lexer lexer)
	cur mut = lexer.next-index
	if lexer.tokens-starts-ends[cur].token == try_
		cur +:= 1
	parens mut nat = 0
	brackets mut nat = 0
	do loop
	token = lexer.tokens-starts-ends[cur].token
	cur +:= 1
	match token
	as equal
		break parens == 0 and brackets == 0
	as comma then continue
	as data_ then continue
	as mut_ then continue
	as name then continue
	as question then continue
	as shared_ then continue
	as underscore then continue
	as paren-left
		parens +:= 1
		continue
	as paren-right
		if parens == 0
			break false
		else
			parens -:= 1
			continue
	as bracket-left
		brackets +:= 1
		continue
	as question-bracket
		brackets +:= 1
		continue
	as bracket-right
		if brackets == 0
			break false
		else
			brackets -:= 1
			continue
	else
		break false
