import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	./lexer
	./parse-util
	./token
	./token-util

-try-take-new-visibility visibility?(lexer lexer)
	if res = peek-visibility lexer and peek2 lexer, name and lexer.next-next-symbol == "new"
		advance lexer
		advance lexer
		res
try-take-visibility visibility?(lexer lexer)
	if res = peek-visibility lexer
		advance lexer
		res
-peek-visibility visibility?(lexer lexer)
	match peek lexer
	as list-dash
		private
	as operator-binary
		as-visibility lexer.next-symbol
	as operator-prefix
		as-visibility lexer.next-symbol
	else
		()
-as-visibility visibility?(a symbol)
	match a
	as "+" then public
	as "~" then internal
	as "-" then private
	else then ()

parse-type-arg-for-var-decl type-ast(lexer lexer)
	if take-or-add-diag-expected-token lexer, paren-left, open-paren
		res = parse-type lexer
		_ = take-or-add-diag-expected-token lexer, paren-right, closing-paren
		res
	else
		bogus-type-ast lexer.next-range

try-parse-type-arg-for-expr type-ast?(lexer lexer)
	if try-take-token lexer, at
		parse-type-for-typed-expr lexer

-parse-types-with-commas-then-closing-paren type-ast[](lexer lexer)
	do unless try-take-token lexer, paren-right
	res type-ast[] = parse-with-separator lexer, comma, of then parse-type lexer
	_ = take-or-add-diag-expected-token lexer, paren-right, closing-paren
	res

parse-type type-ast(lexer lexer)
	parse-type-suffixes lexer, parse-type-before-suffixes lexer, unnecessary

parse-modifiers modifier-ast[](lexer lexer)
	do unless peek-end-of-line lexer
	do with out in build
	out ~= parse-modifier lexer
	while try-take-token-and-may-continue-onto-next-line lexer, comma
		out ~= parse-modifier lexer

-parse-modifier modifier-ast(lexer lexer)
	start = lexer.next-start
	if keyword = try-take-modifier-keyword lexer
		((), start, keyword)::modifier-keyword-ast
	else
		parse-modifier-suffixes lexer, parse-type-before-suffixes lexer, unnecessary

-try-take-modifier-keyword modifier-keyword?(lexer lexer)
	res modifier-keyword? = lexer.peek.to
	if res
		advance lexer
		res
	elif visibility = try-take-new-visibility lexer
		new-visibility visibility

-to modifier-keyword?(a token)
	a.to::symbol.to

| Ensures that 't data' or 't shared' parses as a spec and not a modifier
-try-take-modifier-keyword-non-spec modifier-keyword?(lexer lexer)
	unless is-data-or-shared lexer.peek
		try-take-modifier-keyword lexer
-is-data-or-shared bool(a token)
	a == data_ or a == shared_

-new-visibility modifier-keyword(a visibility)
	match a
	as private
		new-private
	as internal
		new-internal
	as public
		new-public

parse-type-for-typed-expr type-ast(lexer lexer)
	parse-type-suffixes-non-name lexer, parse-type-before-suffixes lexer, necessary

parse-destructure-require-parens destructure-ast(lexer lexer)
	start = lexer.next-start
	match lexer.peek
	as paren-left
		advance lexer
		if try-take-token lexer, paren-right
			void-destructure-ast range lexer, start
		else
			res = parse-destructure-no-require-parens lexer
			_ = take-or-add-diag-expected-token lexer, paren-right, closing-paren
			res
	as underscore
		advance lexer
		ignore-destructure-ast start, lexer.try-take-type
	as name
		name name-and-range = start, lexer.next-symbol
		advance lexer
		mut_ = try-take-mut lexer
		type = try-take-type lexer
		if mut_ or type
			name, mut_, type
		else
			name
	else
		add-diag-at-next-token lexer, destructure::parse-diag-expected
		skip-until-newline-no-diag lexer
		ignore-destructure-ast start, ()
-try-take-mut pos?(lexer lexer)
	pos = lexer.next-start
	if try-take-token lexer, mut_
		pos
-try-take-type type-ast?(lexer lexer)
	unless is-destructure-end lexer.peek
		parse-type lexer

-is-destructure-end bool(a token)
	a == comma or
	a == equal or
	a == in_ or
	a == paren-right or
	a == then_ or
	is-newline-token a

parse-destructure-no-require-parens destructure-ast(lexer lexer)
	destructure-from-parts lexer, lexer.next-start, parse-with-separator lexer, comma, of
		parse-destructure-require-parens lexer

try-parse-sum-type-listed-types-parenthesized type-ast[]?(lexer lexer)
	if try-take-token lexer, paren-left
		parse-types-with-commas-then-closing-paren lexer

try-parse-params-parenthesized destructure-ast[]?(lexer lexer)
	if peek lexer, paren-left
		parse-params-parenthesized lexer

params-kind enum(indented, parenthesized)
parse-params (destructure-ast[], params-kind)(lexer lexer)
	if try-take-token lexer, newline-indent
		params destructure-ast[] = parse-indented-lines-after-indent lexer, of
			parse-destructure-no-require-parens lexer
		_ = try-take-token lexer, newline-same-indent
		params, indented
	else
		lexer.parse-params-parenthesized, parenthesized

parse-params-parenthesized destructure-ast[](lexer lexer)
	if !take-or-add-diag-expected-token lexer, paren-left, open-paren
		skip-until-newline-no-diag lexer
		()
	elif try-take-token lexer, paren-right
		()
	else
		parts destructure-ast[] = parse-with-separator lexer, comma, of
			parse-destructure-require-parens lexer
		unless take-or-add-diag-expected-token lexer, paren-right, closing-paren
			skip-until-newline-no-diag lexer
		parts

-parentheses-necessary enum(unnecessary, necessary)
-== bool(a parentheses-necessary, b parentheses-necessary)

-parse-type-before-suffixes type-ast(lexer lexer, parens parentheses-necessary)
	start = lexer.next-start
	match lexer.peek
	as global_
		advance lexer
		name-and-range start, "global"
	as name
		advance lexer
		name-and-range start, lexer.prev-symbol
	as paren-left
		advance lexer
		parse-tuple-type lexer, start, parens
	else
		add-diag-unexpected-next-token lexer
		bogus-type-ast lexer.next-range

-parse-tuple-type type-ast(lexer lexer, start pos, parens parentheses-necessary)
	args type-ast[] = parse-types-with-commas-then-closing-paren lexer
	match args.size
	as 0
		range = range lexer, start
		add-diag lexer, range, parse-diag-type-empty-parens
		bogus-type-ast range
	as 1
		if parens != necessary
			add-diag lexer, (range lexer, start), parse-diag-type-unnecessary-parens
		args[0]
	else
		tuple-type-ast (range lexer, start), args

-parse-type-suffixes type-ast(lexer lexer, left type-ast)
	if suffix = parse-type-suffix-non-name lexer, of then left
		parse-type-suffixes lexer, suffix
	elif name = try-take-name-and-range lexer
		parse-type-suffixes lexer, suffix-name-type-ast left, name
	else
		left

-parse-modifier-suffixes modifier-ast(lexer lexer, left type-ast)
	keyword-pos = lexer.next-start
	if keyword = try-take-modifier-keyword-non-spec lexer
		modifier-keyword-ast left, keyword-pos, keyword
	elif suffix = parse-type-suffix-non-name lexer, of then left
		parse-modifier-suffixes lexer, suffix
	elif name = try-take-name-and-range-allow-name-like-keywords lexer
		parse-modifier-suffixes-after-name lexer, left, name
	elif left.name-and-range
		spec-use-ast (), left
	else
		add-diag-expected lexer, name
		spec-use-ast left, (lexer.next-start, "")

-parse-modifier-suffixes-after-name modifier-ast(lexer lexer, left type-ast, name name-and-range)
	name-is-type type-ast data() = of then suffix-name-type-ast left, name
	keyword-pos = lexer.next-start
	if keyword = try-take-modifier-keyword-non-spec lexer
		modifier-keyword-ast name-is-type[], keyword-pos, keyword
	elif suffix = parse-type-suffix-non-name lexer, name-is-type
		parse-modifier-suffixes lexer, suffix
	elif name2 = try-take-name-and-range lexer
		parse-modifier-suffixes-after-name lexer, name-is-type[], name2
	else
		spec-use-ast left, name

-parse-type-suffixes-non-name type-ast(lexer lexer, left type-ast)
	if suffix = parse-type-suffix-non-name lexer, of then left
		parse-type-suffixes-non-name lexer, suffix
	else
		left

-parse-type-suffix-non-name type-ast?(lexer lexer, cb-left type-ast data()) # TODO: does cb-left sitll need to be a cb???
	suffix-pos = lexer.next-start
	suffix2 type-ast data(kind suffix-special-type-ast-kind, left type-ast) = of kind, left
		suffix-special-type-ast left, suffix-pos, kind
	suffix1 type-ast data(kind suffix-special-type-ast-kind) = of kind
		suffix2[kind, cb-left[]]
	map-like2 type-ast mut(kind map-type-ast-kind, left type-ast) = of kind, left
		key = parse-type lexer
		_ = take-or-add-diag-expected-token lexer, bracket-right, closing-bracket
		map-type-ast kind, left, key
	map-like1 type-ast mut(kind map-type-ast-kind) = of kind
		map-like2[kind, cb-left[]]

	match lexer.peek
	as question
		advance lexer
		suffix1[option]
	as bracket-left
		advance lexer
		if try-take-token lexer, bracket-right
			suffix1[array]
		else
			map-like1[map]
	as question-bracket
		advance lexer
		left = suffix1[option]
		if try-take-token lexer, bracket-right
			suffix-special-type-ast left, suffix-pos + 1, array
		else
			map-like2[map, left]
	as mut_
		try-parse-fun-type lexer, suffix-pos, mut_, cb-left or
			mut-pos = lexer.next-start
			advance lexer
			if try-take-token lexer, bracket-left
				if try-take-token lexer, bracket-right
					suffix1[mut-array]
				else
					map-like1[mut-map]
			else
				add-diag lexer, (range lexer, mut-pos), parse-diag-type-trailing-mut
				()
	as data_
		try-parse-fun-type lexer, suffix-pos, data_, cb-left
	as shared_
		if fun = try-parse-fun-type lexer, suffix-pos, shared_, cb-left
			fun
		elif peek2 lexer, bracket-left
			advance lexer
			advance lexer
			if try-take-token lexer, bracket-right
				suffix1[shared-array]
			else
				map-like1[shared-map]
	else
		()

-try-parse-fun-type fun-type-ast?(lexer lexer, keyword-pos pos, kind fun-kind, return-type type-ast data())
	do if peek2 lexer, paren-left
	advance lexer
	before-params = lexer.next-start
	params-array = parse-params-parenthesized lexer
	params destructure-ast = destructure-from-parts lexer, before-params, params-array
	return-type[], keyword-pos, kind, params

-destructure-from-parts destructure-ast(lexer lexer, start pos, parts destructure-ast[])
	match parts.size
	as 0
		void-destructure-ast range lexer, start
	as 1
		parts[0]
	else
		parts