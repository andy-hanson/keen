import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	./lexer
	./token
	./token-util

try-take-token bool(lexer lexer, expected token)
	if lexer peek expected
		lexer advance
		true

try-take-token-and-may-continue-onto-next-line bool(lexer lexer, expected token)
	if lexer peek expected
		lexer advance-may-continue-onto-next-line
		true

try-take-operator bool(lexer lexer, expected symbol)
	guard lexer peek operator
	guard lexer.next-symbol == expected
	lexer advance
	true

take-or-add-diag-expected-token bool(lexer lexer, token token, kind parse-diag-expected)
	res = lexer try-take-token token
	unless res
		lexer add-diag-at-next-token kind
	res
take-or-add-diag-expected-token-and-may-continue-onto-next-line bool(lexer lexer, token token, kind parse-diag-expected)
	res = lexer try-take-token-and-may-continue-onto-next-line token
	unless res
		lexer add-diag-at-next-token kind
	res

add-diag-expected void(lexer lexer, kind parse-diag-expected)
	lexer add-diag-at-next-token kind

take-or-add-diag-expected-operator bool(lexer lexer, operator symbol, kind parse-diag-expected)
	res = lexer try-take-operator operator
	unless res
		lexer add-diag-at-next-token kind
	res

try-take-name-and-range-allow-name-like-keywords name-and-range?(lexer lexer)
	start = lexer next-start
	token = lexer peek
	res symbol? = if token == name
		lexer next-symbol
	else
		token try-get-name-like-keyword
	if res
		lexer advance
		start, res

take-name-allow-name-like-keywords symbol(lexer lexer)
	if res = lexer try-take-name-and-range-allow-name-like-keywords
		res name
	else
		lexer add-diag-at-next-token name::parse-diag-expected
		""

-try-get-name-like-keyword symbol?(a token)
	match a
	as data_
		"data"
	as enum_
		"enum"
	as flags_
		"flags"
	as in_
		"in"
	as list-dash
		"-"
	as shared_
		"shared"
	as reserved-class
		"class"
	else
		()

try-take-name-and-range name-and-range?(lexer lexer)
	if lexer peek name
		lexer advance
		lexer.prev-start, lexer.prev-symbol
try-take-name-and-range-or-diag name-and-range?(lexer lexer)
	res = lexer try-take-name-and-range
	unless res
		lexer add-diag-at-next-token name::parse-diag-expected
		lexer skip-until-newline-no-diag
	res

try-take-name-like-token name-and-range?(lexer lexer, token token)
	guard lexer peek token
	res name-and-range =
		start: lexer.next-start + (token == name-after-question).to
		name: lexer next-symbol
	lexer advance
	res

try-take-name-colon symbol?(lexer lexer)
	if lexer peek name-colon
		lexer advance
		lexer prev-symbol

| Range does not include the ':'
try-take-name-colon-and-range name-and-range?(lexer lexer)
	start = lexer next-start
	if name = lexer try-take-name-colon
		start, name

take-name-and-range name-and-range(lexer lexer)
	lexer try-take-name-and-range-or-diag else lexer.next-start, ""

take-name symbol(lexer lexer)
	lexer.take-name-and-range name

take-name-or-operator name-and-range(lexer lexer)
	if res = lexer peek-name-or-operator
		lexer advance
		lexer.prev-start, res
	else
		lexer add-diag-at-next-token name-or-operator::parse-diag-expected
		lexer.next-start, ""

peek-name-or-operator symbol?(lexer lexer)
	token = lexer.peek
	if token is-symbol-token and token != name-or-operator-colon-equals
		lexer next-symbol
	else
		token try-get-name-like-keyword

skip-blank-lines void(lexer lexer)
	while lexer try-take-token newline-same-indent
		()

peek-end-of-line bool(lexer lexer)
	match lexer peek
	as newline-dedent
		true
	as newline-indent
		true
	as newline-same-indent
		true
	as end-of-file
		true
	else
		false

take-dedent void(lexer lexer)
	if lexer !try-take-token newline-dedent
		lexer add-diag-at-next-token dedent::parse-diag-expected
		while lexer.skip-to-next-newline-or-dedent != dedent
			()

newline-or-dedent enum(newline, dedent)
== bool(a newline-or-dedent, b newline-or-dedent)
take-newline-or-dedent newline-or-dedent(lexer lexer)
	if lexer try-take-token newline-same-indent
		newline
	elif lexer try-take-token newline-dedent
		dedent
	elif lexer peek end-of-file
		dedent
	else
		lexer add-diag-at-next-token newline-or-dedent::parse-diag-expected
		lexer skip-to-next-newline-or-dedent

-skip-to-next-newline-or-dedent newline-or-dedent(lexer lexer)
	lexer skip-to-next-newline-or-dedent 0
-skip-to-next-newline-or-dedent newline-or-dedent(lexer lexer, init-dedents-needed nat)
	dedents-needed mut = init-dedents-needed
	loop
		lexer skip-until-newline-no-diag
		match lexer peek
		as newline-dedent
			lexer advance
			if dedents-needed == 0
				break dedent
			else
				dedents-needed -:= 1
				continue
		as newline-same-indent
			lexer advance
			if dedents-needed == 0
				break newline
			else
				continue
		as end-of-file
			dedents-needed is 0
			break newline
		as newline-indent
			lexer advance
			dedents-needed +:= 1
			continue
		else
			throw unreachable

parse-indented-lines[t] t[](lexer lexer, f t mut())
	if lexer try-take-token newline-indent
		lexer parse-indented-lines-after-indent f

parse-indented-lines-after-indent[t] t[](lexer lexer, f t mut())
	with out in build
		loop
			out ~= f[]
			match lexer take-newline-or-dedent
			as newline
				continue
			as dedent
				break

take-indent-or-fail-generic[t] t(lexer lexer, cb-indent t mut(), cb-fail t mut(x source-range))
	if lexer try-take-token newline-indent
		cb-indent[]
	else
		lexer add-diag-at-next-token indent::parse-diag-expected
		cb-fail[lexer next-range]

try-take-literal-number literal-number?(lexer lexer)
	start = lexer next-start
	if lexer try-take-token literal-number
		- lexer range start

take-comma-separated-names-diag-trailing-comma name-and-range[](lexer lexer)
	with out in build
		lexer add-diag-if-trailing-comma (lexer take-comma-separated-names out)

add-diag-if-trailing-comma void(lexer lexer, trailing-comma source-range?)
	if trailing-comma
		lexer add-diag trailing-comma, parse-diag-trailing-comma

| Returns position of trailing comma
take-comma-separated-names source-range?(lexer lexer, names name-and-range array-builder)
	loop
		names ~= lexer take-name-or-operator
		start = lexer next-start
		if lexer try-take-token comma
			if lexer peek-end-of-line
				break lexer range start
			else
				continue
		else
			break

parse-with-separator[t] t[](lexer lexer, separator token, f t mut())
	with out in build
		out ~= f[]
		while lexer try-take-token separator
			out ~= f[]

it-scope-if record(args expr-ast[], allow-it bool)
it-scope it-scope-if(args expr-ast[])
	args, true
with-block expr-ast(a it-scope-if, f expr-ast mut(args expr-ast[]))
	if a.allow-it and a.args exists !!it.it-scope-ast::it-scope-ast?
		f[a.args map of x then x.it-scope-ast ?inner else x] it-scope-ast
	else
		f[a args]
it-scope-single record(arg expr-ast)
it-scope it-scope-single(arg expr-ast)
	- arg
with-block expr-ast(a it-scope-single, f expr-ast mut(arg expr-ast))
	match arg = a arg
	as it-scope-ast
		f[arg inner] it-scope-ast
	else
		f[arg]

take-after-interpolated bool(lexer lexer)
	if lexer take-or-add-diag-expected-token brace-right, close-interpolated
		true
	else
		loop
			# Lexer guarantees a fake 'brace-right' token in interpolated, but we might have skipped to the end of the line
			if lexer.peek is-newline-token
				break false
			elif lexer try-take-token brace-right
				break true
			else
				lexer advance
				continue

