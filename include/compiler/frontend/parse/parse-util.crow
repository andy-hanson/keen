import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	./lexer
	./lex-token
	./token

peek-token bool(lexer lexer, expected token)
	lexer.get-peek-token == expected

try-take-token bool(lexer lexer, expected token)
	if lexer peek-token expected
		_ = lexer take-next-token
		true

try-take-token-and-may-continue-onto-next-line bool(lexer lexer, expected token)
	if lexer peek-token expected
		_ = lexer take-next-token-may-continue-onto-next-line
		true

try-take-operator bool(lexer lexer, expected symbol)
	lexer try-take-token-if of x
		x.token == operator and x.as-symbol == expected

-try-take-token-if bool(lexer lexer, cb bool data(x token-and-data))
	(lexer try-take-token-cb of x then if cb[x] then true) else false
try-take-token-cb[t] t?(lexer lexer, cb t? data(x token-and-data))
	peek = lexer get-peek-token-and-data
	res = cb[peek]
	if _ ?= res
		_ = lexer take-next-token
	res

take-or-add-diag-expected-token bool(lexer lexer, token token, kind parse-diag-expected)
	res = lexer try-take-token token
	unless res
		lexer add-diag-at-char kind
	res
take-or-add-diag-expected-token-and-may-continue-onto-next-line bool(lexer lexer, token token, kind parse-diag-expected)
	res = lexer try-take-token-and-may-continue-onto-next-line token
	unless res
		lexer add-diag-at-char kind
	res

add-diag-expected void(lexer lexer, kind parse-diag-expected)
	lexer add-diag-at-char kind

take-or-add-diag-expected-operator bool(lexer lexer, operator symbol, kind parse-diag-expected)
	res = lexer try-take-operator operator
	unless res
		lexer add-diag-at-char kind
	res

try-take-name-and-range-allow-name-like-keywords name-and-range?(lexer lexer)
	start = lexer cur-pos
	res = lexer try-take-token-cb of x
		if x.token == name
			x as-symbol
		else
			x.token try-get-name-like-keyword
	if x ?= res
		start, x

take-name-allow-name-like-keywords symbol(lexer lexer)
	start = lexer cur-pos
	res = lexer try-take-name-and-range-allow-name-like-keywords
	if x ?= res
		x name
	else
		lexer add-diag (lexer range-for-cur-token start), name::parse-diag-expected
		""

-try-get-name-like-keyword symbol?(a token)
	match a
	as data_
		"data"
	as enum_
		"enum"
	as flags_
		"flags"
	as in_
		"in"
	as shared_
		"shared"
	as reserved-class
		"class"
	else
		()

try-take-name-and-range name-and-range?(lexer lexer)
	start = lexer cur-pos
	lexer try-take-token-cb of x
		if x.token == name
			start, x.as-symbol
try-take-name-and-range-or-diag name-and-range?(lexer lexer)
	start = lexer cur-pos
	res = lexer try-take-name-and-range
	unless _ ?= res
		lexer add-diag (lexer range-for-cur-token start), name::parse-diag-expected
	res

try-take-name-like-token name-and-range?(lexer lexer, token token)
	guard lexer peek-token token
	res name-and-range =
		start: lexer.cur-pos + (token == name-after-question).to
		name: lexer.get-peek-token-and-data as-symbol
	lexer must-take-token token
	res

try-take-name-colon symbol?(lexer lexer)
	if lexer peek-token name-colon
		lexer.take-next-token as-symbol

| Range does not include the ':'
take-name-colon-or-skip-rest-of-line name-and-range?(lexer lexer)
	start = lexer cur-pos
	if x ?= lexer try-take-name-colon
		start, x
	else
		lexer add-diag-expected name-colon
		_ = lexer skip-until-newline-no-diag

take-name-and-range name-and-range(lexer lexer)
	lexer try-take-name-and-range-or-diag else lexer.cur-pos, ""

take-name symbol(lexer lexer)
	lexer.take-name-and-range name

take-name-or-operator name-and-range(lexer lexer)
	start pos = lexer cur-pos
	if x ?= lexer try-take-token-cb it.try-get-name-or-operator
		start, x
	else
		lexer add-diag (lexer range-for-cur-token start), name-or-operator::parse-diag-expected
		start, ""

-try-get-name-or-operator symbol?(a token-and-data)
	if a.token is-symbol-token and a.token != name-or-operator-colon-equals
		a as-symbol
	else
		a.token try-get-name-like-keyword

peek-name-or-operator bool(lexer lexer)
	_ ?= lexer.get-peek-token-and-data try-get-name-or-operator

skip-blank-lines void(lexer lexer)
	while lexer try-take-token newline-same-indent
		()

peek-end-of-line bool(lexer lexer)
	match lexer get-peek-token
	as newline-dedent
		true
	as newline-indent
		true
	as newline-same-indent
		true
	as end-of-file
		true
	else
		false

take-dedent void(lexer lexer)
	if lexer !try-take-token newline-dedent
		lexer add-diag-at-char dedent::parse-diag-expected
		while lexer.skip-to-next-newline-or-dedent != dedent
			()

newline-or-dedent enum(newline, dedent)
== bool(a newline-or-dedent, b newline-or-dedent)
take-newline-or-dedent newline-or-dedent(lexer lexer)
	if lexer try-take-token newline-same-indent
		newline
	elif lexer try-take-token newline-dedent
		dedent
	elif lexer try-take-token end-of-file
		dedent
	else
		lexer add-diag-at-char newline-or-dedent::parse-diag-expected
		lexer skip-to-next-newline-or-dedent

-skip-to-next-newline-or-dedent newline-or-dedent(lexer lexer)
	lexer skip-to-next-newline-or-dedent 0
-skip-to-next-newline-or-dedent newline-or-dedent(lexer lexer, init-dedents-needed nat)
	dedents-needed mut = init-dedents-needed
	loop
		lexer skip-until-newline-no-diag
		match lexer.take-next-token token
		as newline-dedent
			if dedents-needed == 0
				break dedent
			else
				dedents-needed -:= 1
				continue
		as newline-same-indent
			if dedents-needed == 0
				break newline
			else
				continue
		as end-of-file
			dedents-needed is 0
			break newline
		as newline-indent
			dedents-needed +:= 1
			continue
		else
			throw unreachable

parse-indented-lines[t] t[](lexer lexer, f t mut())
	if lexer try-take-token newline-indent
		lexer parse-indented-lines-after-indent f

parse-indented-lines-after-indent[t] t[](lexer lexer, f t mut())
	with out in build
		loop
			out ~= f[]
			match lexer take-newline-or-dedent
			as newline
				continue
			as dedent
				break

take-indent-or-fail-generic[t] t(lexer lexer, cb-indent t mut(), cb-fail t mut(x source-range))
	start = lexer cur-pos
	if lexer try-take-token newline-indent
		cb-indent[]
	else
		range = lexer range-for-cur-token start
		lexer add-diag range, indent::parse-diag-expected
		cb-fail[range]

try-take-literal-integral literal-integral-and-range?(lexer lexer)
	start = lexer cur-pos
	res literal-integral? = lexer try-take-token-cb of x
		if x.token == literal-integral
			x as-literal-integral
	if x ?= res
		(lexer range start), x

take-comma-separated-names-diag-trailing-comma name-and-range[](lexer lexer)
	with out in build
		lexer add-diag-if-trailing-comma (lexer take-comma-separated-names out)

add-diag-if-trailing-comma void(lexer lexer, trailing-comma source-range?)
	if x ?= trailing-comma
		lexer add-diag x, parse-diag-trailing-comma

| Returns position of trailing comma
take-comma-separated-names source-range?(lexer lexer, names name-and-range array-builder)
	loop
		names ~= lexer take-name-or-operator
		start = lexer cur-pos
		if lexer try-take-token comma
			if lexer peek-end-of-line
				break lexer range start
			else
				continue
		else
			break

parse-with-separator[t] t[](lexer lexer, separator token, f t mut())
	with out in build
		lexer parse-with-separator separator, of
			out ~= f[]

parse-with-separator void(lexer lexer, separator token, cb void mut())
	cb[]
	while lexer try-take-token separator
		cb[]
