import
	../../model/ast
	../../model/parse-diag
	../../model/source-range
	./lexer
	./token
	./token-util

try-take-token bool(lexer lexer, expected token)
	if peek lexer, expected
		advance lexer
		true

try-take-token-and-may-continue-onto-next-line bool(lexer lexer, expected token)
	if peek lexer, expected
		advance-may-continue-onto-next-line lexer
		true

try-take-operator bool(lexer lexer, expected symbol)
	guard peek lexer, operator
	guard lexer.next-symbol == expected
	advance lexer
	true

take-or-add-diag-expected-token bool(lexer lexer, token token, kind parse-diag-expected)
	res = try-take-token lexer, token
	unless res
		add-diag-at-next-token lexer, kind
	res
take-or-add-diag-expected-token-and-may-continue-onto-next-line bool(lexer lexer, token token, kind parse-diag-expected)
	res = try-take-token-and-may-continue-onto-next-line lexer, token
	unless res
		add-diag-at-next-token lexer, kind
	res

add-diag-expected void(lexer lexer, kind parse-diag-expected)
	add-diag-at-next-token lexer, kind

take-or-add-diag-expected-operator bool(lexer lexer, operator symbol, kind parse-diag-expected)
	res = try-take-operator lexer, operator
	unless res
		add-diag-at-next-token lexer, kind
	res

try-take-name-and-range-allow-name-like-keywords name-and-range?(lexer lexer)
	start = next-start lexer
	token = peek lexer
	res symbol? = if token == name
		next-symbol lexer
	else
		try-get-name-like-keyword token 
	if res
		advance lexer
		start, res

take-name-allow-name-like-keywords symbol(lexer lexer)
	if res = try-take-name-and-range-allow-name-like-keywords lexer
		res.name
	else
		add-diag-at-next-token lexer, name::parse-diag-expected
		""

-try-get-name-like-keyword symbol?(a token)
	match a
	as data_
		"data"
	as enum_
		"enum"
	as flags_
		"flags"
	as in_
		"in"
	as is_
		"is"
	as list-dash
		"-"
	as shared_
		"shared"
	as reserved-class
		"class"
	else
		()

try-take-name-and-range name-and-range?(lexer lexer)
	if peek lexer, name
		advance lexer
		lexer.prev-start, lexer.prev-symbol
try-take-name-and-range-or-diag name-and-range?(lexer lexer)
	res = try-take-name-and-range lexer
	unless res
		add-diag-at-next-token lexer, name::parse-diag-expected
		skip-until-newline-no-diag lexer
	res

try-take-name-like-token name-and-range?(lexer lexer, token token)
	guard peek lexer, token
	res name-and-range =
		start: lexer.next-start + (token == name-after-question).to
		name: next-symbol lexer
	advance lexer
	res

try-take-name-colon symbol?(lexer lexer)
	if peek lexer, name-colon
		advance lexer
		prev-symbol lexer

| Range does not include the ':'
try-take-name-colon-and-range name-and-range?(lexer lexer)
	start = next-start lexer
	if name = try-take-name-colon lexer
		start, name

take-name-and-range name-and-range(lexer lexer)
	try-take-name-and-range-or-diag lexer else lexer.next-start, ""

take-name symbol(lexer lexer)
	lexer.take-name-and-range.name

take-name-or-operator name-and-range(lexer lexer)
	if res = peek-name-or-operator lexer
		advance lexer
		lexer.prev-start, res
	else
		add-diag-at-next-token lexer, name-or-operator::parse-diag-expected
		lexer.next-start, ""

peek-name-or-operator symbol?(lexer lexer)
	token = peek lexer
	if is-symbol-token token and token != name-colon-equals and token != operator-colon-equals
		next-symbol lexer
	else
		try-get-name-like-keyword token

skip-blank-lines void(lexer lexer)
	while try-take-token lexer, newline-same-indent
		()

peek-end-of-line bool(lexer lexer)
	match peek lexer
	as newline-dedent
		true
	as newline-indent
		true
	as newline-same-indent
		true
	as end-of-file
		true
	else
		false

take-dedent void(lexer lexer)
	unless try-take-token lexer, newline-dedent
		add-diag-at-next-token lexer, dedent::parse-diag-expected
		while lexer.skip-to-next-newline-or-dedent != dedent
			()

newline-or-dedent enum(newline, dedent)
== bool(a newline-or-dedent, b newline-or-dedent)
take-newline-or-dedent newline-or-dedent(lexer lexer)
	if try-take-token lexer, newline-same-indent
		newline
	elif try-take-token lexer, newline-dedent
		dedent
	elif peek lexer, end-of-file
		dedent
	else
		add-diag-at-next-token lexer, newline-or-dedent::parse-diag-expected
		skip-to-next-newline-or-dedent lexer

-skip-to-next-newline-or-dedent newline-or-dedent(lexer lexer)
	skip-to-next-newline-or-dedent lexer, 0
-skip-to-next-newline-or-dedent newline-or-dedent(lexer lexer, init-dedents-needed nat)
	dedents-needed mut = init-dedents-needed
	loop
		skip-until-newline-no-diag lexer
		match peek lexer
		as newline-dedent
			advance lexer
			if dedents-needed == 0
				break dedent
			else
				dedents-needed -:= 1
				continue
		as newline-same-indent
			advance lexer
			if dedents-needed == 0
				break newline
			else
				continue
		as end-of-file
			dedents-needed is 0
			break newline
		as newline-indent
			advance lexer
			dedents-needed +:= 1
			continue
		else
			throw unreachable

parse-indented-lines[t] t[](lexer lexer, f t mut())
	if try-take-token lexer, newline-indent
		parse-indented-lines-after-indent lexer, f

parse-indented-lines-after-indent[t] t[](lexer lexer, f t mut())
	with out in build
		loop
			out ~= f[]
			match take-newline-or-dedent lexer
			as newline
				continue
			as dedent
				break

take-indent-or-fail-generic[t] t(lexer lexer, cb-indent t mut(), cb-fail t mut(x source-range))
	if try-take-token lexer, newline-indent
		cb-indent[]
	else
		add-diag-at-next-token lexer, indent::parse-diag-expected
		cb-fail[next-range lexer]

try-take-literal-number literal-number?(lexer lexer)
	start = next-start lexer
	if try-take-token lexer, literal-number
		- range lexer, start

take-comma-separated-names-diag-trailing-comma name-and-range[](lexer lexer)
	with out in build
		add-diag-if-trailing-comma lexer, (take-comma-separated-names lexer, out)

add-diag-if-trailing-comma void(lexer lexer, trailing-comma source-range?)
	if trailing-comma
		add-diag lexer, trailing-comma, parse-diag-trailing-comma

| Returns position of trailing comma
take-comma-separated-names source-range?(lexer lexer, names name-and-range builder)
	loop
		names ~= take-name-or-operator lexer
		start = next-start lexer
		if try-take-token lexer, comma
			if peek-end-of-line lexer
				break range lexer, start
			else
				continue
		else
			break

parse-with-separator[t] t[](lexer lexer, separator token, f t mut())
	with out in build
		out ~= f[]
		while try-take-token lexer, separator
			out ~= f[]

it-scope-if record(args expr-ast[], allow-it bool)
it-scope it-scope-if(args expr-ast[])
	args, true
with-block expr-ast(a it-scope-if, f expr-ast mut(args expr-ast[]))
	if a.allow-it and exists a.args, !!it.it-scope-ast::it-scope-ast?
		it-scope-ast f[map a.args, of x then x.it-scope-ast.?inner else x]
	else
		f[a.args]
it-scope-single record(arg expr-ast)
it-scope it-scope-single(arg expr-ast)
	- arg
with-block expr-ast(a it-scope-single, f expr-ast mut(arg expr-ast))
	match arg = a.arg
	as it-scope-ast
		it-scope-ast f[arg.inner]
	else
		f[arg]

take-after-interpolated bool(lexer lexer)
	if take-or-add-diag-expected-token lexer, brace-right, close-interpolated
		true
	else
		loop
			# guarantees lexer, a fake 'brace-right' token in interpolated, but we might have skipped to the end of the line
			if is-newline-token lexer.peek
				break false
			elif try-take-token lexer, brace-right
				break true
			else
				advance lexer
				continue

