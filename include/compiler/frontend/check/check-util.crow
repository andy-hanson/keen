use-prefix
import
	../../../crow/parse
	../../model/ast
	../../model/model
	../../model/source-range
	./check-ctx
	./type-from-ast

check-literal-nat-value nat64(ctx check-ctx, type nat-type, range source-range)
	check-literal-integral-value ctx, type.to, range 'to
check-literal-integral-value scalar-value(ctx check-ctx, type integral-type, range source-range)
	text = get-text ctx, range
	is-negative = text[0] == "-"
	value scalar-value? = try
		if exists text, it == "." # TODO: "."::char8 in text -------------------------------------------------------------------------------
			()
		elif is-negative
			res = parse-int text
			ok = if type.is-signed
				res >= type.min-value and (res < 0 or res.to::nat64 <= type.max-value)
			else
				res >= 0 and res.to::nat <= type.max-value
			if ok then res.to
		else
			text2 = if text[0] == "+" then text[1 .. end] else text
			res = parse-nat text2
			if res <= type.max-value then res.to
	catch as inner-parse-error
		()
	value else
		add-diag ctx, range, type.diag-literal-overflow
		0::nat.to

check-return-type-and-params (type, destructure[])
	ctx check-ctx
	types types-get
	type-container type-container
	return-type-ast type-ast
	params-asts destructure-ast[]
	type-params type-params
do
	ret = type-from-ast ctx, types, return-type-ast, type-params, yes
	params = check-params ctx, types, type-container, params-asts, type-params
	ret, params

-check-params destructure[]
	ctx check-ctx
	types types-get
	type-container type-container
	asts destructure-ast[]
	type-params-scope type-params
do
	for x in asts
		check-destructure ctx, types, type-container, type-params-scope, x, (), param
