import
	../../../crow/parse
	../../model/ast
	../../model/model
	../../model/source-range
	./check-ctx
	./type-from-ast

check-literal-integral-value scalar-value(ctx check-ctx, type integral-type, range source-range)
	text = ctx get-text range
	is-negative = text[0] == "-"
	value scalar-value? = try
		if text exists it == "." # TODO: "."::char8 in text -------------------------------------------------------------------------------
			()
		elif is-negative
			res = text parse-int
			ok = if type is-signed
				res >= type.min-value and (res < 0 or res.to::nat64 <= type.max-value)
			else
				res >= 0 and res.to::nat <= type.max-value
			if ok then res to
		else
			text2 = if text[0] == "+" then text[1 .. end] else text
			res = text2 parse-nat
			if res <= type.max-value then res to
	catch as inner-parse-error
		()
	value else
		ctx add-diag range, type.diag-literal-overflow
		0::nat to

check-return-type-and-params (type, destructure[])
	ctx check-ctx
	types types-get
	type-container type-container
	return-type-ast type-ast
	params-asts destructure-ast[]
	type-params type-params
do
	ret = ctx type-from-ast types, return-type-ast, type-params, yes
	params = ctx check-params types, type-container, params-asts, type-params
	ret, params

-check-params destructure[]
	ctx check-ctx
	types types-get
	type-container type-container
	asts destructure-ast[]
	type-params-scope type-params
do
	for x in asts
		ctx check-destructure types, type-container, type-params-scope, x, (), param

get-externs-from-modifier symbol-set(ctx check-ctx, modifier modifier-ast)
	assert k = modifier modifier-keyword-ast
	assert k.keyword == extern_
	res = if arg = k type-arg
		ctx try-get-externs-from-type-arg arg
	res else
		ctx add-diag k.keyword-range, diag-extern-missing-library-name
		()

-try-get-externs-from-type-arg symbol-set?(ctx check-ctx, arg type-ast)
	match arg
	as name-and-range
		- ctx check-extern-name-or-bogus arg, ()
	as tuple-type-ast
		ok mut bool = true
		res symbol-set = for member in arg members
			match member
			as name-and-range
				ctx check-extern-name-or-bogus member, ()
			else
				ok := false
				"bogus"
		if ok then res
	else
		()

-check-extern-name-or-bogus symbol(ctx check-ctx, name name-and-range, enclosing-externs symbol-set)
	ctx check-extern-name name, enclosing-externs else "bogus"
check-extern-name symbol?(ctx check-ctx, name name-and-range, enclosing-externs symbol-set)
	res = name name
	if res is-builtin-extern or res in ctx.config.extern_
		if res in enclosing-externs
			ctx add-diag name.range, res.diag-extern-redundant
		res
	else
		ctx add-diag name.range, res.diag-extern-invalid-name
		()
