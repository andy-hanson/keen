import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	../../util/enum-map
	./instantiate

get-common-types common-types
	instantiate-ctx instantiate-ctx
	diagnostics-builder diagnostic mut[]
	types-and-specs-map types-and-specs-map
	java-String struct-inst
do
	ctx common-types-ctx = instantiate-ctx, diagnostics-builder, types-and-specs-map
	char8 = non-template ctx, "char8"
	char32 = non-template ctx, "char32"
	symbol = non-template ctx, "symbol"
	void = non-template ctx, "void"
	array = get-decl ctx, "array", 1
	mut-slice = get-decl ctx, "mut-slice", 1
	integrals integral-types =
		- for type in make-enum-map then non-template ctx, type.to
	string = non-template ctx, "string"
	option = get-decl ctx, "option", 1
	java-spec = non-template-spec ctx, types-and-specs-map, java
	global_ = non-template-spec ctx, types-and-specs-map, global_
	unsafe = non-template-spec ctx, types-and-specs-map, unsafe

	bool: non-template ctx, "bool"
	char8: char8
	char32: char32
	exception: non-template ctx, "exception"
	float32: non-template ctx, "float32"
	float64: non-template ctx, "float64"
	integrals: integrals
	js-any: non-template ctx, "js-any"
	none: non-template ctx, "none"
	java-String: java-String
	string: string
	symbol: symbol
	symbol-array: array[symbol]
	void: void
	array: array
	mut-slice: mut-slice
	char8-array: array[char8]
	char32-array: array[char32]
	nat8-array: array[integrals.nat8]
	string-array: array[string]
	option: option
	t-option: instantiated-with-own-type-params option
	reference: get-decl ctx, "reference", 1
	tuples: for i in 2::nat .. max-type-params + 1
		get-tuple ctx, i
	fun-structs: for kind in make-enum-map
		get-decl ctx, "fun-{kind}", 2
	global_: global_
	unsafe: unsafe
	java-spec: java-spec
	js-spec: non-template-spec ctx, types-and-specs-map, js
	global-java-unsafe-specs: get-or-add-specs (java-spec, global_, unsafe)
	global-unsafe-specs: get-or-add-specs (global_, unsafe)
	unsafe-specs: get-or-add-specs (unsafe,)

-common-types-ctx record mut
	instantiate-ctx instantiate-ctx
	diagnostics-builder diagnostic mut[]
	types-and-specs-map types-and-specs-map

-add-diag-missing void(ctx common-types-ctx, name symbol)
	ctx.diagnostics-builder ~= (), name.diag-common-type-missing

-get-decl struct-decl(ctx common-types-ctx, name symbol, n-type-parameters nat)
	get-common-template-type ctx.types-and-specs-map, name, n-type-parameters else
		add-diag-missing ctx, name
		bogus-struct-decl ctx.instantiate-ctx, name, n-type-parameters

-non-template struct-inst(ctx common-types-ctx, name symbol)
	get-common-non-template-type ctx.types-and-specs-map, name else
		add-diag-missing ctx, name
		only-inst bogus-struct-decl ctx.instantiate-ctx, name, 0

-non-template-spec spec-inst(ctx common-types-ctx, types-and-specs-map types-and-specs-map, builtin_ builtin-spec)
	name symbol = builtin_.to
	decl = types-and-specs-map[name].?spec-decl
	if decl and decl.n-type-params == 0
		res, did-add = get-or-add-spec-inst decl, ()
		assert did-add
		res.builtin_ := ((builtin_, no-type-args),)
		res
	else
		add-diag-missing ctx, name
		throw todo

-get-tuple struct-decl(ctx common-types-ctx, n nat)
	get-decl ctx, "tuple{n}", n

-get-common-template-type struct-decl?(types-and-specs-map types-and-specs-map, name symbol, expected-type-params nat)
	if decl = types-and-specs-map[name].?struct-decl
		if decl.n-type-params == expected-type-params
			decl

-get-common-non-template-type struct-inst?(types-and-specs-map types-and-specs-map, name symbol)
	if decl = types-and-specs-map[name].?struct-decl
		decl.n-type-params is 0
		decl.only-inst

bogus-struct-decl struct-decl(ctx instantiate-ctx, name symbol, n-type-parameters nat)
	hash: next-hash ctx
	source: struct-decl-source-bogus name, for i in 0::nat .. n-type-parameters
		0, "t{i}"
	module-uri: ()
	visibility: public
	specs: ()
	purity: data_
	purity-is-forced: false
	doc-comment-references: ()
	sum-type-memberships: ()
	body: struct-body-bogus
