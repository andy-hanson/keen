import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	../../util/enum-map
	./instantiate

get-common-types common-types
	diagnostics-builder diagnostic mut[]
	types-and-specs-map types-and-specs-map
	java-String struct-inst
do instantiate-ctx
	the context = diagnostics-builder, types-and-specs-map
	char8 = non-template "char8"
	char32 = non-template "char32"
	symbol = non-template "symbol"
	array = get-decl "array", 1
	integrals integral-types =
		- for type in make-enum-map then non-template type.to
	string = non-template "string"
	option = get-decl "option", 1
	java-spec = non-template-spec java
	global_ = non-template-spec global_
	unsafe = non-template-spec unsafe

	bool: non-template "bool"
	char8: char8
	char32: char32
	exception: non-template "exception"
	float32: non-template "float32"
	float64: non-template "float64"
	integrals: integrals
	js-any: non-template "js-any"
	none: non-template "none"
	java-String: java-String
	string: string
	symbol: symbol
	symbol-array: array[symbol]
	void: non-template "void"
	array: array
	array-view: get-decl "array-view", 1
	buffer: get-decl "buffer", 1
	buffer-view: get-decl "buffer-view", 1
	char8-array: array[char8]
	char32-array: array[char32]
	nat8-array: array[integrals.nat8]
	string-array: array[string]
	option: option
	t-option: instantiated-with-own-type-params option
	reference: get-decl "reference", 1
	tuples: for i in 2 .. max-type-params.to + 1
		get-decl "tuple{i}", i.to
	fun-structs: for kind in make-enum-map
		get-decl "fun-{kind}", 2
	global_: global_
	unsafe: unsafe
	java-spec: java-spec
	js-spec: non-template-spec js
	global-java-unsafe-specs: get-or-add-specs (java-spec, global_, unsafe)
	global-unsafe-specs: get-or-add-specs (global_, unsafe)
	unsafe-specs: get-or-add-specs (unsafe,)

-context record mut
	diagnostics-builder diagnostic mut[]
	types-and-specs-map types-and-specs-map
-ctx spec instantiate-ctx, context
-types-and-specs-map types-and-specs-map() context
	the::context.types-and-specs-map

-add-diag-missing void(name symbol) ctx
	the::context.diagnostics-builder ~= (), name.diag-common-type-missing

-get-decl struct-decl(name symbol, n-type-parameters nat8) ctx
	get-common-template-type name, n-type-parameters else
		add-diag-missing name
		bogus-struct-decl name, n-type-parameters

-non-template struct-inst(name symbol) ctx
	get-common-non-template-type name else
		add-diag-missing name
		only-inst bogus-struct-decl name, 0

-non-template-spec spec-inst(builtin_ builtin-spec) ctx
	name symbol = builtin_.to
	decl = types-and-specs-map[name].?spec-decl
	if decl and decl.n-type-params == 0
		res, did-add = get-or-add-spec-inst decl, ()
		assert did-add
		res.builtin_ := ((builtin_, no-type-args),)
		res
	else
		add-diag-missing name
		throw todo

-get-common-template-type struct-decl?(name symbol, expected-type-params nat8) ctx
	if decl = types-and-specs-map[name].?struct-decl
		if decl.n-type-params == expected-type-params
			decl

-get-common-non-template-type struct-inst?(name symbol) ctx
	if decl = types-and-specs-map[name].?struct-decl
		decl.n-type-params is 0
		decl.only-inst

bogus-struct-decl struct-decl(name symbol, n-type-parameters nat) instantiate-ctx
	hash: next-hash
	source: struct-decl-source-bogus name, for i in 0::nat .. n-type-parameters
		0, "t{i}"
	module-uri: ()
	visibility: public
	specs: ()
	purity: data_
	purity-is-forced: false
	doc-comment-references: ()
	sum-type-memberships: ()
	body: struct-body-bogus
