import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	../../util/enum-map
	../../util/util
	../lang
	./check-ctx
	./instantiate

types-get spec common-types, types-and-specs-map

alias-allowed enum(different-module, yes)

-type-from-name type
	name symbol
	range source-range
	type-args-ast type-ast?
	type-params-scope type-params
	alias-allowed alias-allowed
do check-ctx, types-get
	inst-struct-from-ast name, range, type-args-ast, type-params-scope, alias-allowed else bogus-type

inst-struct-from-ast struct-inst?
	name symbol
	range source-range
	type-args-ast type-ast?
	type-params-scope type-params
	alias-allowed alias-allowed
do check-ctx, types-get
	do if s-or-a = struct-or-alias-from-name name, range
	type-arg type? = if type-args-ast
		type-from-ast type-args-ast, type-params-scope, alias-allowed
	do if type-args = get-type-args-if-number-matches range, name, s-or-a.n-type-params, type-arg
	match s-or-a
	as struct-alias
		assert is-empty type-args
		ok = match alias-allowed
		as different-module
			s-or-a.module-uri != cur-uri
		as yes
			true
		if ok
			s-or-a.target
		else
			add-diag range, diag-alias-not-allowed
			()
	as struct-decl
		s-or-a[type-args]

struct-or-alias union(struct-alias, struct-decl)
	n-type-params nat8()
struct-or-alias-from-name struct-or-alias?(name symbol, range source-range) check-ctx, types-and-specs-map
	do if res = spec-or-type-from-name name, range, false
	match res
	as spec-decl
		add-diag range, diag-spec-used-as-type name
		()
	as struct-alias
		res
	as struct-decl
		res

try-find-spec-or-type spec-or-type?(name name-and-range) check-ctx, types-and-specs-map
	spec-or-type-from-name name.name, name.range, false
spec-or-type-from-name spec-or-type?
	name symbol
	range source-range
	no-diag bool
do check-ctx, types-and-specs-map
	res mut = (the::types-and-specs-map)[name]
	for exports in imports-and-re-exports
		if x = exports.types-and-specs[name]
			if res
				unless no-diag
					add-diag range, diag-duplicate-imports type, name
			else
				res := x
	unless res or no-diag
		add-diag range, diag-name-not-found spec-or-type, name
	res

| Figures out whether the imported type was imported through an internal or public import.
| WARN: This is a bit slow, should not be used often.
imported-type-access-visibility export-visibility(decl struct-decl) check-ctx
	forbid decl.module-uri == cur-uri
	first! the::check-context.module-imports-and-re-exports, of import_
		if import_.module.public-and-internal-exports.types-and-specs[decl.name] == decl
			import_.import-visibility

make-tuple-type type(args type-args, cb-diag-range source-range data()) check-ctx, common-types
	match args
	as no-type-args
		void
	as bogus-type
		args
	as type-param-index
		args
	as struct-inst
		args
	as type-array
		if decl = tuple args.size
			decl[args]
		else
			add-diag cb-diag-range[], diag-tuple-too-big args.size
			bogus-type

-get-type-args-if-number-matches type-args?
	range source-range
	name symbol
	n-expected-type-args nat
	type type?
do check-ctx, common-types
	res = if type
		unpack-tuple-if-needed n-expected-type-args, type
	if res.size == n-expected-type-args
		res
	else
		add-diag range, diag-wrong-number-type-args name, n-expected-type-args, res.size
		()

| Tries to return array of length 'nExpectedTypeArgs', but may fail
unpack-tuple-if-needed type-args(n-expected-type-args nat, type type) common-types
	if n-expected-type-args == 1
		as-type-args type
	elif x = as-tuple type
		x
	else
		as-type-args type

get-n-type-args-for-diagnostic nat(explicit-type-arg type?) common-types
	do if explicit-type-arg
	if tuple = as-tuple explicit-type-arg
		tuple.size
	else
		1

check-type-params void(asts name-and-range[]) check-ctx
	each-pair asts, of x, y
		if x.name == y.name
			add-diag y.range, diag-duplicate-declaration type-param, y.name

type-from-ast-no-type-params type(ast type-ast) check-ctx, types-get
	type-from-ast ast, (), yes

type-from-ast type
	ast type-ast
	type-params-scope type-params
	alias-allowed alias-allowed
do check-ctx, types-get
	match ast
	as bogus-type-ast
		bogus-type
	as fun-type-ast
		type-from-fun-ast ast, type-params-scope, alias-allowed
	as map-type-ast
		type-arg type-ast = tuple-type-ast (), (ast.key, ast.value)
		type-from-name ast.kind.to, ast.range, type-arg, type-params-scope, alias-allowed
	as name-and-range
		if type-param = find-type-param type-params-scope, ast.name
			type-param
		else
			type-from-name ast.name, ast.range, (), type-params-scope, alias-allowed
	as suffix-name-type-ast
		if syntax = type-syntax-kind ast.name.name
			add-diag ast.suffix-range, syntax
		if type-param = find-type-param type-params-scope, ast.name.name
			add-diag ast.suffix-range, diag-type-param-cant-have-type-args
			type-param
		else
			type-from-name ast.name.name, ast.suffix-range, ast.left, type-params-scope, alias-allowed
	as suffix-special-type-ast
		type-from-name ast.kind.to, ast.suffix-range, ast.left, type-params-scope, alias-allowed
	as tuple-type-ast
		members = make-type-args ast.members, of member
			type-from-ast member, type-params-scope, alias-allowed
		make-tuple-type members, of
			ast.members[0].range.start, ast.members[end - 1].end

spec-or-type-from-ast spec-or-type-inst?
	type-params-scope type-params
	ast spec-use-ast
	delay-spec-insts may-delay-spec-insts
do check-ctx, types-get
	do if spec-or-type = try-find-spec-or-type ast.name
	type-arg type? = if x = ast.type-arg
		type-from-ast x, type-params-scope, yes
	if type-args = get-type-args-if-number-matches ast.name.range, spec-or-type.name, spec-or-type.n-type-params, type-arg
		instantiate-spec-or-type spec-or-type, type-args, delay-spec-insts

-find-type-param type-param-index?(type-params-scope type-params, name symbol)
	if res = find-index type-params-scope, it.name == name
		- res

-type-from-fun-ast type
	ast fun-type-ast
	type-params-scope type-params
	alias-allowed alias-allowed
do check-ctx, types-get
	return-type = type-from-ast ast.return-type, type-params-scope, alias-allowed
	param-type = type-from-destructure ast.param, type-params-scope else
		add-diag ast.param.range, diag-lambda-type-missing-param-type
		bogus-type
	ast.kind.lambda[return-type, param-type]

get-spec-from-common-module spec-decl?
	diag-range source-range
	name symbol
	expected-module common-module
do check-ctx, types-and-specs-map
	if spec_ = try-find-spec (diag-range.start, name)
		if spec_.module-uri == common-uris[expected-module]
			spec_
		else
			add-diag diag-range, diag-auto-fun-spec-from-wrong-module
			()

-try-find-spec spec-decl?(name name-and-range) check-ctx, types-and-specs-map
	if res = spec-or-type-from-name name.name, name.range, false
		if res.spec-decl
			res
		else
			add-diag name.range, diag-type-used-as-spec name.name
			()

type-from-destructure type?(ast destructure-ast, type-params-scope type-params) check-ctx, types-get
	match ast
	as name-and-range
		()
	as single-destructure-ast
		if t = ast.type
			type-from-ast t, type-params-scope, yes
	as ignore-destructure-ast
		if t = ast.type
			type-from-ast t, type-params-scope, yes
	as void-destructure-ast
		void
	as array
		do if type-args = map-every-type-args ast, of part
			type-from-destructure part, type-params-scope
		make-tuple-type type-args, of
			ast[0].start, ast[end - 1].end

destructure-kind enum(local, param)
== bool(a destructure-kind, b destructure-kind)
check-destructure destructure
	type-container type-container
	# 'typeContainer' may be uninitialized, so pass 'typeParamsScope' separately
	type-params-scope type-params
	ast destructure-ast
	# This is for the type coming from the RHS of a 'let', or the expected type of a lambda
	destructured-type type?
	kind destructure-kind
do check-ctx, types-get
	type-with-container type-with-container mut(x type) = it, type-container
	default-type = of
		if destructured-type
			destructured-type
		else
			add-diag ast.range, diag-param-missing-type
			bogus-type
	type-from-declared = of declared-type type
		if destructured-type
			if destructured-type != declared-type
				add-diag ast.range,
					diag-destructure-type-mismatch type-with-container[declared-type], type-with-container[destructured-type]
		declared-type
	get-type-from-ast = of type-ast type-ast?
		if type-ast
			type-from-declared[type-from-ast type-ast, type-params-scope, yes]
		else
			default-type[]
	match ast
	as name-and-range
		local ast, default-type[]
	as single-destructure-ast
		if ast.mut_ and kind == param
			add-diag ast.mut-range!, diag-param-mutable
		local ast, get-type-from-ast[ast.type]
	as ignore-destructure-ast
		destructure-ignore ast, get-type-from-ast[ast.type]
	as void-destructure-ast
		destructure-ignore ast, type-from-declared[void]
	as array
		if destructured-type
			if field-types = as-tuple destructured-type and field-types.size == ast.size
				parts destructure[] = for i in 0::nat .. ast.size
					part = ast[i]
					field-type = field-types[i]
					check-destructure type-container, type-params-scope, part, field-type, kind
				destructure-split destructured-type, parts
			else
				add-diag ast.range,
					diag-destructure-type-mismatch ast.size.destructure-expected-tuple, type-with-container[destructured-type]
				# TODO: this could share code with the above if it generated an array of bogus types? --------------------------------
				destructure-split destructured-type, for part in ast
					check-destructure type-container, type-params-scope, part, bogus-type, kind
		else
			parts destructure[] = for part in ast
				check-destructure type-container, type-params-scope, part, (), kind
			part-types = make-type-args parts, of part then part.type
			destructured-type: make-tuple-type part-types, of
				ast[0].range.start, ast[end - 1].end
			parts: parts
