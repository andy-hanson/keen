import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	../../util/enum-map
	../../util/util
	../lang
	./check-ctx
	./instantiate
	./maps

types-get record
	common-types common-types
	structs-and-aliases-map structs-and-aliases-map
types-and-specs record
	common-types common-types
	structs-and-aliases-map structs-and-aliases-map
	specs-map specs-map
new types-and-specs(types types-get, specs-map specs-map)
	types.common-types, types.structs-and-aliases-map, specs-map
types types-get(a types-and-specs)
	a.common-types, a.structs-and-aliases-map

alias-allowed enum(different-module, yes)

-type-from-name type
	ctx check-ctx
	types types-get
	name symbol
	range source-range
	type-args-ast type-ast?
	type-params-scope type-params
	alias-allowed alias-allowed
do
	inst-struct-from-ast ctx, types, name, range, type-args-ast, type-params-scope, alias-allowed else bogus-type

inst-struct-from-ast struct-inst?
	ctx check-ctx
	types types-get
	name symbol
	range source-range
	type-args-ast type-ast?
	type-params-scope type-params
	alias-allowed alias-allowed
do
	do if s-or-a = struct-or-alias-from-name ctx, name, range, types.structs-and-aliases-map, false
	type-arg type? = if type-args-ast
		type-from-ast ctx, types, type-args-ast, type-params-scope, alias-allowed
	do if type-args = get-type-args-if-number-matches ctx, types.common-types, range, name, s-or-a.n-type-params, type-arg
	match s-or-a
	as struct-alias
		assert is-empty type-args
		ok = match alias-allowed
		as different-module
			s-or-a.module-uri != ctx.cur-uri
		as yes
			true
		if ok
			s-or-a.target
		else
			add-diag ctx, range, diag-alias-not-allowed
			()
	as struct-decl
		s-or-a[type-args]

struct-or-alias-from-name struct-or-alias?
	ctx check-ctx
	name symbol
	range source-range
	structs-and-aliases-map structs-and-aliases-map
	no-diag bool
do
	res mut = structs-and-aliases-map[name]
	for exports in ctx.imports-and-re-exports
		if x = exports.structs-and-aliases[name]
			if res
				add-diag ctx, range, diag-duplicate-imports type, name
			else
				res := x
	unless res or no-diag
		add-diag ctx, range, diag-name-not-found type, name
	res

make-tuple-type type(ctx check-ctx, common-types common-types, args type-args, cb-diag-range source-range data())
	match args
	as no-type-args
		common-types.void
	as bogus-type
		args
	as type-param-index
		args
	as struct-inst
		args
	as type-array
		if decl = tuple common-types, args.size
			decl[args]
		else
			add-diag ctx, cb-diag-range[], diag-tuple-too-big args.size, common-types.max-tuple-size
			bogus-type

-get-type-args-if-number-matches type-args?
	ctx check-ctx
	common-types common-types
	range source-range
	name symbol
	n-expected-type-args nat
	type type?
do
	res = if type
		unpack-tuple-if-needed common-types, n-expected-type-args, type
	if res.size == n-expected-type-args
		res
	else
		add-diag ctx, range,
			diag-wrong-number-type-args name, n-expected-type-args, res.size
		()

| Tries to return array of length 'nExpectedTypeArgs', but may fail
unpack-tuple-if-needed type-args(common-types common-types, n-expected-type-args nat, type type)
	if n-expected-type-args == 1
		as-type-args type
	elif x = as-tuple common-types, type
		x
	else
		as-type-args type

get-n-type-args-for-diagnostic nat(common-types common-types, explicit-type-arg type?)
	do if explicit-type-arg
	if tuple = as-tuple common-types, explicit-type-arg
		tuple.size
	else
		1

check-type-params void(ctx check-ctx, asts name-and-range[])
	each-pair asts, of x, y
		if x.name == y.name
			add-diag ctx, y.range,
				diag-duplicate-declaration type-param, y.name

type-from-ast-no-type-params type(ctx check-ctx, types types-get, ast type-ast)
	type-from-ast ctx, types, ast, (), yes

type-from-ast type
	ctx check-ctx
	types types-get
	ast type-ast
	type-params-scope type-params
	alias-allowed alias-allowed
do
	match ast
	as bogus-type-ast
		bogus-type
	as fun-type-ast
		type-from-fun-ast ctx, types, ast, type-params-scope, alias-allowed
	as map-type-ast
		type-arg type-ast = tuple-type-ast (), (ast.key, ast.value)
		type-from-name ctx, types, ast.kind.to, ast.range, type-arg, type-params-scope, alias-allowed
	as name-and-range
		if type-param = find-type-param type-params-scope, ast.name
			type-param
		else
			type-from-name ctx, types, ast.name, ast.range, (), type-params-scope, alias-allowed
	as suffix-name-type-ast
		if syntax = type-syntax-kind ast.name.name
			add-diag ctx, ast.suffix-range, syntax
		if type-param = find-type-param type-params-scope, ast.name.name
			add-diag ctx, ast.suffix-range, diag-type-param-cant-have-type-args
			type-param
		else
			type-from-name ctx, types, ast.name.name, ast.suffix-range, ast.left, type-params-scope, alias-allowed
	as suffix-special-type-ast
		type-from-name ctx, types, ast.kind.to, ast.suffix-range, ast.left, type-params-scope, alias-allowed
	as tuple-type-ast
		members = make-type-args ast.members, of member
			type-from-ast ctx, types, member, type-params-scope, alias-allowed
		make-tuple-type ctx, types.common-types, members, of
			ast.members[0].range.start, ast.members[end - 1].end

spec-from-ast spec-inst?
	ctx check-ctx
	types types-and-specs
	type-params-scope type-params
	ast spec-use-ast
	delay-spec-insts may-delay-spec-insts
do
	if spec_ = try-find-spec ctx, ast.name, types.specs-map, false
		type-arg type? = if x = ast.type-arg
			type-from-ast ctx, types.types, x, type-params-scope, yes
		if type-args = get-type-args-if-number-matches ctx, types.common-types, ast.name.range, spec_.name, spec_.n-type-params, type-arg
			instantiate-spec ctx.instantiate-ctx, spec_, type-args, delay-spec-insts

-find-type-param type-param-index?(type-params-scope type-params, name symbol)
	if res = find-index type-params-scope, it.name == name
		- res

-type-from-fun-ast type
	ctx check-ctx
	types types-get
	ast fun-type-ast
	type-params-scope type-params
	alias-allowed alias-allowed
do
	return-type = type-from-ast ctx, types, ast.return-type, type-params-scope, alias-allowed
	param-type = type-from-destructure ctx, types, ast.param, type-params-scope else
		add-diag ctx, ast.param.range, diag-lambda-type-missing-param-type
		bogus-type
	types.common-types.fun-structs[ast.kind][to-type-array (return-type, param-type)]

get-spec-from-common-module spec-decl?
	ctx check-ctx
	specs-map specs-map
	diag-range source-range
	name symbol
	expected-module common-module
do
	if spec_ = try-find-spec ctx, (diag-range.start, name), specs-map, false
		if spec_.module-uri == ctx.common-uris[expected-module]
			spec_
		else
			add-diag ctx, diag-range, diag-auto-fun-spec-from-wrong-module
			()

try-find-spec spec-decl?(ctx check-ctx, name name-and-range, specs-map specs-map, no-diag bool)
	res mut = specs-map[name name]
	for exports in ctx.imports-and-re-exports
		if x = exports.specs[name name]
			if res
				add-diag ctx, name.range, diag-duplicate-imports spec_, name.name
			else
				res := x
	unless res or no-diag
		add-diag ctx, name.range, diag-name-not-found spec_, name.name
	res

type-from-destructure type?
	ctx check-ctx
	types types-get
	ast destructure-ast
	type-params-scope type-params
do
	match ast
	as name-and-range
		()
	as single-destructure-ast
		if t = ast.type
			type-from-ast ctx, types, t, type-params-scope, yes
	as ignore-destructure-ast
		if t = ast.type
			type-from-ast ctx, types, t, type-params-scope, yes
	as void-destructure-ast
		types.common-types.void
	as array
		do if type-args = map-every-type-args ast, of part
			type-from-destructure ctx, types, part, type-params-scope
		make-tuple-type ctx, types.common-types, type-args, of
			ast[0].start, ast[end - 1].end

destructure-kind enum(local, param)
== bool(a destructure-kind, b destructure-kind)
check-destructure destructure
	ctx check-ctx
	types types-get
	type-container type-container
	# 'typeContainer' may be uninitialized, so pass 'typeParamsScope' separately
	type-params-scope type-params
	ast destructure-ast
	# This is for the type coming from the RHS of a 'let', or the expected type of a lambda
	destructured-type type?
	kind destructure-kind
do
	common-types = types.common-types
	type-with-container type-with-container mut(x type) = it, type-container
	default-type type mut() = of
		if destructured-type
			destructured-type
		else
			add-diag ctx, ast.range, diag-param-missing-type
			bogus-type
	type-from-declared type mut(declared-type type) = of declared-type
		if destructured-type
			if destructured-type != declared-type
				add-diag ctx, ast.range,
					diag-destructure-type-mismatch type-with-container[declared-type], type-with-container[destructured-type]
		declared-type
	get-type-from-ast type mut(ast type-ast?) = of type-ast
		if type-ast
			type-from-declared[type-from-ast ctx, types, type-ast, type-params-scope, yes]
		else
			default-type[]
	match ast
	as name-and-range
		local ast, default-type[]
	as single-destructure-ast
		if ast.mut_ and kind == param
			add-diag ctx, ast.mut-range!, diag-param-mutable
		local ast, get-type-from-ast[ast.type]
	as ignore-destructure-ast
		destructure-ignore ast, get-type-from-ast[ast.type]
	as void-destructure-ast
		destructure-ignore ast, type-from-declared[common-types.void]
	as array
		if destructured-type
			if field-types = as-tuple common-types, destructured-type and field-types.size == ast.size
				parts destructure[] = for i in 0::nat .. ast.size
					part = ast[i]
					field-type = field-types[i]
					check-destructure ctx, types, type-container, type-params-scope, part, field-type, kind
				destructure-split destructured-type, parts
			else
				add-diag ctx, ast.range,
					diag-destructure-type-mismatch ast.size.destructure-expected-tuple, type-with-container[destructured-type]
				# TODO: this could share code with the above if it generated an array of bogus types? --------------------------------
				destructure-split destructured-type, for part in ast
					check-destructure ctx, types, type-container, type-params-scope, part, bogus-type, kind
		else
			parts destructure[] = for part in ast
				check-destructure ctx, types, type-container, type-params-scope, part, (), kind
			part-types = make-type-args parts, of part then part.type
			destructured-type: make-tuple-type ctx, common-types, part-types, of
				ast[0].range.start, ast[end - 1].end
			parts: parts
