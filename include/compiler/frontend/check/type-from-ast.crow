import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	../../util/enum-map
	../../util/util
	../lang
	./check-ctx
	./instantiate
	./maps

types-get record
	common-types common-types
	structs-and-aliases-map structs-and-aliases-map
types-and-specs record
	common-types common-types
	structs-and-aliases-map structs-and-aliases-map
	specs-map specs-map
new types-and-specs(types types-get, specs-map specs-map)
	types.common-types, types.structs-and-aliases-map, specs-map
types types-get(a types-and-specs)
	a.common-types, a.structs-and-aliases-map

alias-allowed enum(different-module, yes)

inst-struct-from-ast type
	ctx check-ctx
	types types-get
	name symbol
	suffix-range source-range
	type-args-ast type-ast?
	type-params-scope type-params
	alias-allowed alias-allowed
do
	guard s-or-a ?= ctx struct-or-alias-from-name name, suffix-range, types.structs-and-aliases-map, false else bogus-type
	type-arg type? = if x ?= type-args-ast
		ctx type-from-ast types, x, type-params-scope, alias-allowed
	guard type-args ?= ctx get-type-args-if-number-matches types.common-types, suffix-range, name, s-or-a.n-type-params, type-arg else bogus-type
	match s-or-a
	as struct-alias alias_
		assert type-args is-empty
		ok = match alias-allowed
		as different-module
			alias_.module-uri != ctx.cur-uri
		as yes
			true
		if ok
			alias_ target
		else
			ctx add-diag suffix-range, diag-alias-not-allowed
			bogus-type
	as struct-decl decl
		decl[type-args]

struct-or-alias-from-name struct-or-alias?
	ctx check-ctx
	name symbol
	range source-range
	structs-and-aliases-map structs-and-aliases-map
	no-diag bool
do
	res mut = structs-and-aliases-map[name]
	for exports in ctx imports-and-re-exports
		if x ?= exports.structs-and-aliases[name]
			if _ ?= res
				ctx add-diag range, (type diag-duplicate-imports name)
			else
				res := x
	unless _ ?= res or no-diag
		ctx add-diag range, (type diag-name-not-found name)
	res

make-tuple-type type(ctx check-ctx, common-types common-types, args type[], cb-diag-range source-range data())
	match args size
	as 0
		common-types void
	as 1
		args only
	else
		if decl ?= common-types tuple args.size
			decl[args]
		else
			ctx add-diag cb-diag-range[], (args.size diag-tuple-too-big common-types.max-tuple-size)
			bogus-type

-get-type-args-if-number-matches type[]?
	ctx check-ctx
	common-types common-types
	range source-range
	name symbol
	n-expected-type-args nat
	type type?
do
	res = if x ?= type
		common-types unpack-tuple-if-needed n-expected-type-args, x
	if res.size == n-expected-type-args
		res
	else
		ctx add-diag range,
			name diag-wrong-number-type-args n-expected-type-args, res.size
		()

| Tries to return array of length 'nExpectedTypeArgs', but may fail
unpack-tuple-if-needed type[](common-types common-types, n-expected-type-args nat, type type)
	if n-expected-type-args == 1
		- type
	elif x ?= common-types as-tuple type
		x inner
	else
		- type

get-n-type-args-for-diagnostic nat(common-types common-types, explicit-type-arg type?)
	guard x ?= explicit-type-arg
	if tuple ?= common-types as-tuple x
		tuple size
	else
		1

check-type-params void(ctx check-ctx, asts name-and-range[])
	asts each-pair (x, y) =>
		if x.name == y.name
			ctx add-diag y.range,
				type-param diag-duplicate-declaration y.name

type-from-ast-no-type-params type(ctx check-ctx, types types-get, ast type-ast)
	ctx type-from-ast types, ast, (), yes

type-from-ast type
	ctx check-ctx
	types types-get
	ast type-ast
	type-params-scope type-params
	alias-allowed alias-allowed
do
	match ast
	as bogus-type-ast _
		bogus-type
	as fun-type-ast x
		ctx type-from-fun-ast types, x, type-params-scope, alias-allowed
	as map-type-ast x
		type-arg type-ast = () tuple-type-ast (x.key, x.value)
		ctx inst-struct-from-ast types, x.kind.to, x.range, type-arg, type-params-scope, alias-allowed
	as name-and-range name
		if type-param ?= type-params-scope find-type-param name.name
			type-param
		else
			ctx inst-struct-from-ast types, name.name, name.range, (), type-params-scope, alias-allowed
	as suffix-name-type-ast x
		if syntax ?= x.name.name type-syntax-kind
			ctx add-diag x.suffix-range, syntax
		if type-param ?= type-params-scope find-type-param x.name.name
			ctx add-diag x.suffix-range, diag-type-param-cant-have-type-args
			type-param
		else
			ctx inst-struct-from-ast types, x.name.name, x.suffix-range, x.left, type-params-scope, alias-allowed
	as suffix-special-type-ast x
		ctx inst-struct-from-ast types, x.kind.to, x.suffix-range, x.left, type-params-scope, alias-allowed
	as tuple-type-ast x
		members type[] = for member in x.members
			ctx type-from-ast types, member, type-params-scope, alias-allowed
		ctx make-tuple-type types.common-types, members, () =>
			x.members[0].range combine-ranges x.members[end - 1].range

spec-from-ast spec-inst?
	ctx check-ctx
	types types-and-specs
	type-params-scope type-params
	ast spec-use-ast
	delay-spec-insts may-delay-spec-insts
do
	if spec_ ?= ctx try-find-spec ast.name, types.specs-map, false
		type-arg type? = if x ?= ast type-arg
			ctx type-from-ast types.types, x, type-params-scope, yes
		if type-args ?= ctx get-type-args-if-number-matches types.common-types, ast.name.range, spec_.name, spec_.n-type-params, type-arg
			ctx.instantiate-ctx instantiate-spec spec_, type-args, delay-spec-insts

-find-type-param type-param-index?(type-params-scope type-params, name symbol)
	if res ?= type-params-scope find-index x => x.name == name
		res,

-type-from-fun-ast type
	ctx check-ctx
	types types-get
	ast fun-type-ast
	type-params-scope type-params
	alias-allowed alias-allowed
do
	return-type = ctx type-from-ast types, ast.return-type, type-params-scope, alias-allowed
	param-type = match ast params
	as array params
		if res ?= ctx type-from-destructures types, type-params-scope, params
			res
		else
			ctx add-diag ast.params-range, diag-lambda-type-missing-param-type
			bogus-type
	as varargs-ast x
		ctx add-diag x.param.range, diag-lambda-type-variadic
		bogus-type
	types.common-types.fun-structs[ast kind][return-type, param-type]

get-spec-from-common-module spec-decl?
	ctx check-ctx
	specs-map specs-map
	diag-range source-range
	name symbol
	expected-module common-module
do
	if spec_ ?= ctx try-find-spec (diag-range.start, name), specs-map, false
		if spec_.module-uri == ctx.common-uris[expected-module]
			spec_
		else
			ctx add-diag diag-range, diag-auto-fun-spec-from-wrong-module
			()

try-find-spec spec-decl?(ctx check-ctx, name name-and-range, specs-map specs-map, no-diag bool)
	res mut = specs-map[name name]
	for exports in ctx imports-and-re-exports
		if x ?= exports.specs[name name]
			if _ ?= res
				ctx add-diag name.range, (spec_ diag-duplicate-imports name.name)
			else
				res := x
	unless _ ?= res or no-diag
		ctx add-diag name.range, (spec_ diag-name-not-found name.name)
	res

type-from-destructure type?
	ctx check-ctx
	types types-get
	ast destructure-ast
	type-params-scope type-params
do
	match ast
	as single-destructure-ast x
		if t ?= x type
			ctx type-from-ast types, t, type-params-scope, yes
	as void-destructure-ast _
		types.common-types void
	as array parts
		ctx type-from-destructures types, type-params-scope, parts

-type-from-destructures type?
	ctx check-ctx
	types-get types-get
	type-params-scope type-params
	parts destructure-ast[]
do
	types type[]? = parts map-or-none part =>
		ctx type-from-destructure types-get, part, type-params-scope
	guard x ?= types
	ctx make-tuple-type types-get.common-types, x, () => parts[0].range combine-ranges parts[end - 1].range

destructure-kind enum(local, param)
== bool(a destructure-kind, b destructure-kind)
check-destructure destructure
	ctx check-ctx
	types types-get
	type-container type-container
	# 'typeContainer' may be uninitialized, so pass 'typeParamsScope' separately
	type-params-scope type-params
	ast destructure-ast
	# This is for the type coming from the RHS of a 'let', or the expected type of a lambda
	destructured-type type?
	kind destructure-kind
do
	common-types = types common-types
	type-with-container type-with-container mut(x type) = x => x, type-container
	# TODO: move to function -----------------------------------------------------------------------------------------------------------
	get-type type mut(declared-type type?) = declared-type =>
		if expected ?= declared-type
			if actual ?= destructured-type
				if actual != expected
					ctx add-diag ast.range, (type-with-container[expected] diag-destructure-type-mismatch type-with-container[actual])
			expected
		elif actual ?= destructured-type
			actual
		else
			ctx add-diag ast.range, diag-param-missing-type
			bogus-type
	
	match ast
	as single-destructure-ast x
		declared-type type? = if t ?= x type
			ctx type-from-ast types, t, type-params-scope, yes
		type = get-type[declared-type]
		if x.name.name == "_"
			if _ ?= x mut_
				ctx add-diag ast.range, diag-local-ignored-but-mutable
			x destructure-ignore x.name.start, type
		else
			mutability mutability = if _ ?= x mut_
				if kind == param
					ctx add-diag x.mut-range!, diag-param-mutable
					immut
				else
					mut_
			else
				immut
			x, mutability, type
	as void-destructure-ast x
		x destructure-ignore x.range.start, get-type[common-types void]
	as array part-asts
		if tuple-type ?= destructured-type
			if field-types ?= common-types as-tuple tuple-type and field-types.size == part-asts.size
				parts destructure[] = for i in 0::nat .. part-asts.size
					part = part-asts[i]
					field-type = field-types.inner[i]
					ctx check-destructure types, type-container, type-params-scope, part, field-type, kind
				tuple-type destructure-split parts
			else
				ctx add-diag ast.range, (part-asts.size.destructure-expected-tuple diag-destructure-type-mismatch type-with-container[tuple-type])
				# TODO: this could share code with the above if it generated an array of bogus types? --------------------------------
				tuple-type destructure-split for part in part-asts
					ctx check-destructure types, type-container, type-params-scope, part, bogus-type, kind
		else
			parts destructure[] = for part in part-asts
				ctx check-destructure types, type-container, type-params-scope, part, (), kind
			part-types type[] = for part in parts; part type
			type = ctx make-tuple-type common-types, part-types, () =>
				part-asts[0].range combine-ranges part-asts[end - 1].range
			type destructure-split parts
