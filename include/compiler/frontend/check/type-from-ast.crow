import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/enum-map
	../../util/util
	../lang
	./check-ctx
	./instantiate
	./maps

alias-allowed enum(different-module, yes)

inst-struct-from-ast type(
	ctx check-ctx,
	common-types common-types,
	name symbol,
	suffix-range source-range,
	type-args-ast type-ast?,
	structs-and-aliases-map structs-and-aliases-map,
	type-params-scope type-params,
	alias-allowed alias-allowed,
)
	guard s-or-a ?= ctx struct-or-alias-from-name name, suffix-range, structs-and-aliases-map, false : bogus-type
	type-arg type? = if x ?= type-args-ast
		(ctx type-from-ast common-types, structs-and-aliases-map, x, type-params-scope, alias-allowed),
	guard type-args ?= ctx get-type-args-if-number-matches common-types, suffix-range, name, s-or-a.type-params.size, type-arg : bogus-type
	match s-or-a
	as struct-alias alias_
		assert type-args is-empty
		ok = match alias-allowed
		as different-module
			alias_.module-uri != ctx.cur-uri
		as yes
			true
		if ok
			alias_.target to
		else
			ctx add-diag suffix-range, diag-alias-not-allowed
			bogus-type
	as struct-decl decl
		ctx.instantiate-ctx instantiate-struct decl, type-args to

struct-or-alias-from-name struct-or-alias?(
	ctx check-ctx,
	name symbol,
	range source-range,
	structs-and-aliases-map structs-and-aliases-map,
	no-diag bool,
)
	ctx try-find-t name, range, structs-and-aliases-map[name], type, (!no-diag ? (type,)), x => x struct-or-alias

make-tuple-type type(ctx check-ctx, common-types common-types, args type[], cb-diag-range source-range data())
	match args size
	as 0
		common-types.void to
	as 1
		args only
	else
		if decl ?= common-types tuple args.size
			ctx.instantiate-ctx instantiate-struct decl, args to
		else
			ctx add-diag cb-diag-range[], (args.size diag-tuple-too-big common-types.max-tuple-size)
			bogus-type

-get-type-args-if-number-matches type-args?(
	ctx check-ctx,
	common-types common-types,
	range source-range,
	name symbol,
	n-expected-type-args nat,
	type type?,
)
	res = if x ?= type
		common-types unpack-tuple-if-needed n-expected-type-args, x
	if res.size == n-expected-type-args
		res,
	else
		ctx add-diag range, (name diag-wrong-number-type-args n-expected-type-args, res.size)
		()

| Tries to return array of length 'nExpectedTypeArgs', but may fail
unpack-tuple-if-needed type[](common-types common-types, n-expected-type-args nat, type type)
	if n-expected-type-args == 1
		type,
	else
		common-types as-tuple type ?? (type,)

unpack-tuple type[](common-types common-types, type type)
	unless type == common-types.void.to
		common-types as-tuple type ?? (type,)

get-n-type-args-for-diagnostic nat(common-types common-types, explicit-type-arg type?)
	if x ?= explicit-type-arg
		(common-types as-tuple x)?.size ?? 1

check-type-params void(ctx check-ctx, asts name-and-range[])
	asts each-pair (x, y) =>
		if x.name == y.name
			ctx add-diag y.range, (type-param diag-duplicate-declaration y.name)

type-from-ast-no-type-params type(
	ctx check-ctx,
	common-types common-types,
	structs-and-aliases-map structs-and-aliases-map,
	ast type-ast,
)
	ctx type-from-ast common-types, structs-and-aliases-map, ast, (), yes

type-from-ast type(
	ctx check-ctx,
	common-types common-types,
	structs-and-aliases-map structs-and-aliases-map,
	ast type-ast,
	type-params-scope type-params,
	alias-allowed alias-allowed,
)
	match ast
	as bogus-type-ast _
		bogus-type
	as fun-type-ast x
		ctx type-from-fun-ast common-types, x, structs-and-aliases-map, type-params-scope, alias-allowed
	as map-type-ast x
		ctx type-from-map-ast common-types, x, structs-and-aliases-map, type-params-scope, alias-allowed
	as name-and-range name
		if type-param ?= type-params-scope find-type-param name.name
			type-param to
		else
			ctx inst-struct-from-ast common-types, name.name, name.range, (), structs-and-aliases-map, type-params-scope, alias-allowed
	as suffix-name-type-ast x
		if syntax ?= x.name.name type-syntax-kind
			ctx add-diag x.suffix-range, syntax.to
		if type-param ?= type-params-scope find-type-param x.name.name
			ctx add-diag x.suffix-range, diag-type-param-cant-have-type-args
			type-param to
		else
			ctx inst-struct-from-ast common-types, x.name.name, x.suffix-range, (x.left,), structs-and-aliases-map, type-params-scope, alias-allowed
	as suffix-special-type-ast x
		ctx inst-struct-from-ast common-types, x.kind.to, x.suffix-range, (x.left,), structs-and-aliases-map, type-params-scope, alias-allowed
	as tuple-type-ast x
		members type[] = for member : x.members
			ctx type-from-ast common-types, structs-and-aliases-map, member, type-params-scope, alias-allowed
		ctx make-tuple-type common-types, members, () =>
			x.members[0].range combine-ranges x.members[end - 1].range

spec-from-ast spec-inst?(
	ctx check-ctx,
	common-types common-types, 
	structs-and-aliases-map structs-and-aliases-map,
	specs-map specs-map,
	type-params-scope type-params,
	ast spec-use-ast,
	delay-spec-insts may-delay-spec-insts,
)
	if spec_ ?= ctx try-find-spec ast.name, specs-map, false
		type-arg type? = if x ?= ast type-arg
			(ctx type-from-ast common-types, structs-and-aliases-map, x, type-params-scope, yes),
		if type-args ?= ctx get-type-args-if-number-matches common-types, ast.name.range, spec_.name, spec_.type-params.size, type-arg
			(ctx.instantiate-ctx instantiate-spec spec_, type-args, delay-spec-insts),

-find-type-param type-param-index?(type-params-scope type-params, name symbol)
	if res ?= type-params-scope find-index x => x.name == name
		(res,),

-type-from-fun-ast type(
	ctx check-ctx,
	common-types common-types,
	ast fun-type-ast,
	structs-and-aliases-map structs-and-aliases-map,
	type-params-scope type-params,
	alias-allowed alias-allowed,
)
	return-type = ctx type-from-ast common-types, structs-and-aliases-map, ast.return-type, type-params-scope, alias-allowed
	param-type = match ast params
	as array params
		if res ?= ctx type-from-destructures common-types, structs-and-aliases-map, type-params-scope, params
			res
		else
			ctx add-diag ast.params-range, diag-lambda-type-missing-param-type
			bogus-type
	as varargs-ast x
		ctx add-diag x.param.range, diag-lambda-type-variadic
		bogus-type
	ctx.instantiate-ctx instantiate-struct common-types.fun-structs[ast kind], (return-type, param-type) to

# TODO: INLINE? ------------------------------------------------------------------------------------------------------------
-type-from-map-ast type(
	ctx check-ctx,
	common-types common-types,
	ast map-type-ast,
	structs-and-aliases-map structs-and-aliases-map,
	type-params-scope type-params,
	alias-allowed alias-allowed,
)
	type-arg type-ast = () tuple-type-ast (ast.key, ast.value)
	ctx inst-struct-from-ast common-types, ast.kind.to, ast.range, (type-arg,), structs-and-aliases-map, type-params-scope, alias-allowed

get-spec-from-common-module spec-decl?(
	ctx check-ctx,
	specs-map specs-map,
	diag-range source-range,
	name symbol,
	expected-module common-module,
)
	if spec_ ?= ctx try-find-spec (diag-range.start, name), specs-map, false
		if spec_.module-uri == ctx.common-uris[expected-module]
			spec_,
		else
			ctx add-diag diag-range, diag-auto-fun-spec-from-wrong-module
			()

try-find-spec spec-decl?(ctx check-ctx, name name-and-range, specs-map specs-map, no-diag bool)
	ctx try-find-t name.name, name.range, specs-map[name.name], spec_, (!no-diag ? spec_,), x => x spec_

type-from-destructure type?(
	ctx check-ctx,
	common-types common-types,
	ast destructure-ast,
	structs-and-aliases-map structs-and-aliases-map,
	type-params-scope type-params,
)
	match ast
	as single-destructure-ast x
		if t ?= x type
			(ctx type-from-ast common-types, structs-and-aliases-map, t, type-params-scope, yes),
	as void-destructure-ast _
		common-types.void.to,
	as array parts
		ctx type-from-destructures common-types, structs-and-aliases-map, type-params-scope, parts

-type-from-destructures type?(
	ctx check-ctx,
	common-types common-types,
	structs-and-aliases-map structs-and-aliases-map,
	type-params-scope type-params,
	parts destructure-ast[],
)
	types type[]? = for part : parts map-or-none
		ctx type-from-destructure common-types, part, structs-and-aliases-map, type-params-scope
	if x ?= types
		(ctx make-tuple-type common-types, x, () => parts[0].range combine-ranges parts[end - 1].range),

destructure-kind enum(local, param)
== bool(a destructure-kind, b destructure-kind)
check-destructure destructure(
	ctx check-ctx,
	common-types common-types,
	structs-and-aliases-map structs-and-aliases-map,
	type-container type-container,
	# 'typeContainer' may be uninitialized, so pass 'typeParamsScope' separately
	type-params-scope type-params,
	ast destructure-ast,
	# This is for the type coming from the RHS of a 'let', or the expected type of a lambda
	destructured-type type?,
	kind destructure-kind,
)
	type-with-container type-with-container mut(x type) = x => x, type-container
	# TODO: move to function -----------------------------------------------------------------------------------------------------------
	get-type type mut(declared-type type?) = declared-type =>
		if expected ?= declared-type
			if actual ?= destructured-type
				if actual != expected
					ctx add-diag ast.range, (type-with-container[expected].to diag-destructure-type-mismatch type-with-container[actual])
			expected
		elif actual ?= destructured-type
			actual
		else
			ctx add-diag ast.range, diag-param-missing-type
			bogus-type
	
	match ast
	as single-destructure-ast x
		declared-type type? = if t ?= x type
			(ctx type-from-ast common-types, structs-and-aliases-map, t, type-params-scope, yes),
		type = get-type[declared-type]
		if x.name.name == "_"
			if _ ?= x mut_
				ctx add-diag ast.range, diag-local-ignored-but-mutable
			x.to destructure-ignore x.name.start, type
		else
			mutability local-mutability = if _ ?= x.mut_
				if kind == param
					ctx add-diag x.mut-range!, diag-param-mutable
					local-immutable
				else
					local-mutable-on-stack
			else
				local-immutable
			x.to local mutability, type
	as void-destructure-ast x
		type = get-type[(common-types.void.to,)]
		x.to destructure-ignore x.range.start, type
	as array part-asts
		if tuple-type ?= destructured-type
			field-types = common-types as-tuple tuple-type
			if field-types !is-empty && field-types!.size == part-asts.size
				parts destructure[] = for part, field-type : part-asts zip field-types!
					ctx check-destructure common-types, structs-and-aliases-map, type-container, type-params-scope, part, (field-type,), kind
				tuple-type destructure-split parts
			else
				ctx add-diag ast.range, (part-asts.size.destructure-expected-tuple diag-destructure-type-mismatch type-with-container[tuple-type])
				# TODO: this could share code with the above if it generated an array of bogus types? --------------------------------
				tuple-type destructure-split for part : part-asts
					ctx check-destructure common-types, structs-and-aliases-map, type-container, type-params-scope, part, (bogus-type,), kind
		else
			parts destructure[] = for part : part-asts
				ctx check-destructure common-types, structs-and-aliases-map, type-container, type-params-scope, part, (), kind
			types type[] = for part : parts; part type
			type = ctx make-tuple-type common-types, types, () =>
				part-asts[0].range combine-ranges part-asts[end - 1].range
			type destructure-split parts

-findable[t] spec
	id decl-id(a t)
	visibility visibility(a t)
-try-find-t[t] t?(
	ctx check-ctx,
	name symbol,
	range source-range,
	from-this-module t?,
	duplicate-import-kind diag-duplicate-exports-kind,
	name-not-found-kind diag-name-not-found-kind?,
	get-from-name-referents t? data(x name-referents)
) t findable
	res mut = from-this-module
	ctx.imports-and-re-exports each-import-and-re-export name, (visibility, referents) =>
		if got ?= get-from-name-referents[referents]
			if visibility import-can-see got.visibility
				if _ ?= res
					# TODO: include both modules in the diag
					ctx add-diag range, (duplicate-import-kind diag-duplicate-imports name)
				else
					res := got,
	if x ?= res
		ctx mark-used x.id
	elif kind ?= name-not-found-kind
		ctx add-diag range, (kind diag-name-not-found name)
	res
