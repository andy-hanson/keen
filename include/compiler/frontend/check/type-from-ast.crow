import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	../../util/enum-map
	../../util/util
	../lang
	./check-ctx
	./instantiate
	./maps

types-get record
	common-types common-types
	structs-and-aliases-map structs-and-aliases-map
types-and-specs record
	common-types common-types
	structs-and-aliases-map structs-and-aliases-map
	specs-map specs-map
new types-and-specs(types types-get, specs-map specs-map)
	types.common-types, types.structs-and-aliases-map, specs-map
types types-get(a types-and-specs)
	a.common-types, a.structs-and-aliases-map

alias-allowed enum(different-module, yes)

-type-from-name type
	ctx check-ctx
	types types-get
	name symbol
	range source-range
	type-args-ast type-ast?
	type-params-scope type-params
	alias-allowed alias-allowed
do
	ctx inst-struct-from-ast types, name, range, type-args-ast, type-params-scope, alias-allowed else bogus-type

inst-struct-from-ast struct-inst?
	ctx check-ctx
	types types-get
	name symbol
	range source-range
	type-args-ast type-ast?
	type-params-scope type-params
	alias-allowed alias-allowed
do
	guard s-or-a = ctx struct-or-alias-from-name name, range, types.structs-and-aliases-map, false
	type-arg type? = if type-args-ast
		ctx type-from-ast types, type-args-ast, type-params-scope, alias-allowed
	guard type-args = ctx get-type-args-if-number-matches types.common-types, range, name, s-or-a.n-type-params, type-arg
	match s-or-a
	as struct-alias
		assert type-args is-empty
		ok = match alias-allowed
		as different-module
			s-or-a.module-uri != ctx.cur-uri
		as yes
			true
		if ok
			s-or-a target
		else
			ctx add-diag range, diag-alias-not-allowed
			()
	as struct-decl
		s-or-a[type-args]

struct-or-alias-from-name struct-or-alias?
	ctx check-ctx
	name symbol
	range source-range
	structs-and-aliases-map structs-and-aliases-map
	no-diag bool
do
	res mut = structs-and-aliases-map[name]
	for exports in ctx imports-and-re-exports
		if x = exports.structs-and-aliases[name]
			if res
				ctx add-diag range, do type diag-duplicate-imports name
			else
				res := x
	unless !!res or no-diag
		ctx add-diag range, do type diag-name-not-found name
	res

make-tuple-type type(ctx check-ctx, common-types common-types, args type-args, cb-diag-range source-range data())
	match args
	as no-type-args
		common-types void
	as bogus-type
		args
	as type-param-index
		args
	as struct-inst
		args
	as type-array
		if decl = common-types tuple args.size
			decl[args]
		else
			ctx add-diag cb-diag-range[], do args.size diag-tuple-too-big common-types.max-tuple-size
			bogus-type

-get-type-args-if-number-matches type-args?
	ctx check-ctx
	common-types common-types
	range source-range
	name symbol
	n-expected-type-args nat
	type type?
do
	res = if type
		common-types unpack-tuple-if-needed n-expected-type-args, type
	if res.size == n-expected-type-args
		res
	else
		ctx add-diag range,
			name diag-wrong-number-type-args n-expected-type-args, res.size
		()

| Tries to return array of length 'nExpectedTypeArgs', but may fail
unpack-tuple-if-needed type-args(common-types common-types, n-expected-type-args nat, type type)
	if n-expected-type-args == 1
		type as-type-args
	elif x = common-types as-tuple type
		x
	else
		type as-type-args

get-n-type-args-for-diagnostic nat(common-types common-types, explicit-type-arg type?)
	guard x = explicit-type-arg
	if tuple = common-types as-tuple x
		tuple size
	else
		1

check-type-params void(ctx check-ctx, asts name-and-range[])
	asts each-pair of x, y
		if x.name == y.name
			ctx add-diag y.range,
				type-param diag-duplicate-declaration y.name

type-from-ast-no-type-params type(ctx check-ctx, types types-get, ast type-ast)
	ctx type-from-ast types, ast, (), yes

type-from-ast type
	ctx check-ctx
	types types-get
	ast type-ast
	type-params-scope type-params
	alias-allowed alias-allowed
do
	match ast
	as bogus-type-ast
		bogus-type
	as fun-type-ast
		ctx type-from-fun-ast types, ast, type-params-scope, alias-allowed
	as map-type-ast
		type-arg type-ast = () tuple-type-ast (ast.key, ast.value)
		ctx type-from-name types, ast.kind.to, ast.range, type-arg, type-params-scope, alias-allowed
	as name-and-range
		if type-param = type-params-scope find-type-param ast.name
			type-param
		else
			ctx type-from-name types, ast.name, ast.range, (), type-params-scope, alias-allowed
	as suffix-name-type-ast
		if syntax = ast.name.name type-syntax-kind
			ctx add-diag ast.suffix-range, syntax
		if type-param = type-params-scope find-type-param ast.name.name
			ctx add-diag ast.suffix-range, diag-type-param-cant-have-type-args
			type-param
		else
			ctx type-from-name types, ast.name.name, ast.suffix-range, ast.left, type-params-scope, alias-allowed
	as suffix-special-type-ast
		ctx type-from-name types, ast.kind.to, ast.suffix-range, ast.left, type-params-scope, alias-allowed
	as tuple-type-ast
		members = ast.members make-type-args of member
			ctx type-from-ast types, member, type-params-scope, alias-allowed
		ctx make-tuple-type types.common-types, members, of
			ast.members[0].range.start, ast.members[end - 1].end

spec-from-ast spec-inst?
	ctx check-ctx
	types types-and-specs
	type-params-scope type-params
	ast spec-use-ast
	delay-spec-insts may-delay-spec-insts
do
	if spec_ = ctx try-find-spec ast.name, types.specs-map, false
		type-arg type? = if x = ast type-arg
			ctx type-from-ast types.types, x, type-params-scope, yes
		if type-args = ctx get-type-args-if-number-matches types.common-types, ast.name.range, spec_.name, spec_.n-type-params, type-arg
			ctx.instantiate-ctx instantiate-spec spec_, type-args, delay-spec-insts

-find-type-param type-param-index?(type-params-scope type-params, name symbol)
	if res = type-params-scope find-index it.name == name
		- res

-type-from-fun-ast type
	ctx check-ctx
	types types-get
	ast fun-type-ast
	type-params-scope type-params
	alias-allowed alias-allowed
do
	return-type = ctx type-from-ast types, ast.return-type, type-params-scope, alias-allowed
	param-type = ctx type-from-destructures types, type-params-scope, ast.params else
		ctx add-diag ast.params-range, diag-lambda-type-missing-param-type
		bogus-type
	types.common-types.fun-structs[ast kind][(return-type, param-type) to-type-array]

get-spec-from-common-module spec-decl?
	ctx check-ctx
	specs-map specs-map
	diag-range source-range
	name symbol
	expected-module common-module
do
	if spec_ = ctx try-find-spec (diag-range.start, name), specs-map, false
		if spec_.module-uri == ctx.common-uris[expected-module]
			spec_
		else
			ctx add-diag diag-range, diag-auto-fun-spec-from-wrong-module
			()

try-find-spec spec-decl?(ctx check-ctx, name name-and-range, specs-map specs-map, no-diag bool)
	res mut = specs-map[name name]
	for exports in ctx imports-and-re-exports
		if x = exports.specs[name name]
			if res
				ctx add-diag name.range, do spec_ diag-duplicate-imports name.name
			else
				res := x
	unless !!res or no-diag
		ctx add-diag name.range, do spec_ diag-name-not-found name.name
	res

type-from-destructure type?
	ctx check-ctx
	types types-get
	ast destructure-ast
	type-params-scope type-params
do
	match ast
	as single-destructure-ast
		if t = ast type
			ctx type-from-ast types, t, type-params-scope, yes
	as ignore-destructure-ast
		if t = ast type
			ctx type-from-ast types, t, type-params-scope, yes
	as void-destructure-ast
		types.common-types void
	as array
		ctx type-from-destructures types, type-params-scope, ast

-type-from-destructures type?
	ctx check-ctx
	types-get types-get
	type-params-scope type-params
	parts destructure-ast[]
do
	guard types = parts map-every-type-args of part
		ctx type-from-destructure types-get, part, type-params-scope
	ctx make-tuple-type types-get.common-types, types, of
		parts[0].start, parts[end - 1].end

destructure-kind enum(local, param)
== bool(a destructure-kind, b destructure-kind)
check-destructure destructure
	ctx check-ctx
	types types-get
	type-container type-container
	# 'typeContainer' may be uninitialized, so pass 'typeParamsScope' separately
	type-params-scope type-params
	ast destructure-ast
	# This is for the type coming from the RHS of a 'let', or the expected type of a lambda
	destructured-type type?
	kind destructure-kind
do
	common-types = types common-types
	type-with-container type-with-container mut(x type) = it, type-container
	# TODO: move to function -----------------------------------------------------------------------------------------------------------
	get-type type mut(declared-type type?) = of declared-type
		if declared-type
			if destructured-type
				if destructured-type != declared-type
					ctx add-diag ast.range,
						type-with-container[declared-type] diag-destructure-type-mismatch type-with-container[destructured-type]
			declared-type
		elif destructured-type
			destructured-type
		else
			ctx add-diag ast.range, diag-param-missing-type
			bogus-type
	get-type-from-ast type mut(ast type-ast?) = of type-ast
		get-type[if type-ast then ctx type-from-ast types, type-ast, type-params-scope, yes]
	match ast
	as single-destructure-ast
		source: ast
		mutability: if ast mut_
			if kind == param
				ctx add-diag ast.mut-range!, diag-param-mutable
				immut
			else
				mut_
		else
			immut
		type: get-type-from-ast[ast type]
	as ignore-destructure-ast
		ast destructure-ignore get-type-from-ast[ast type]
	as void-destructure-ast
		ast destructure-ignore get-type[common-types void]
	as array
		if destructured-type
			if field-types = common-types as-tuple destructured-type and field-types.size == ast.size
				parts destructure[] = for i in 0::nat .. ast.size
					part = ast[i]
					field-type = field-types[i]
					ctx check-destructure types, type-container, type-params-scope, part, field-type, kind
				destructured-type destructure-split parts
			else
				ctx add-diag ast.range,
					ast.size.destructure-expected-tuple diag-destructure-type-mismatch type-with-container[destructured-type]
				# TODO: this could share code with the above if it generated an array of bogus types? --------------------------------
				destructured-type destructure-split for part in ast
					ctx check-destructure types, type-container, type-params-scope, part, bogus-type, kind
		else
			parts destructure[] = for part in ast
				ctx check-destructure types, type-container, type-params-scope, part, (), kind
			part-types = parts make-type-args of part then part type
			type = ctx make-tuple-type common-types, part-types, of
				ast[0].range.start, ast[end - 1].end
			type destructure-split parts
