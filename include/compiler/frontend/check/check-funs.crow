import
	../../../crow/col/experimental/object-memoizer
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	./check-auto-fun
	./check-ctx
	./check-expr
	./check-struct-bodies
	./check-util
	./funs-for-struct
	./instantiate
	./type-from-ast

import-or-export-file record(source import-or-export-ast, uri uri, content nat8 array-view)
file-imports-and-exports record
	imports import-or-export-file[]
	exports import-or-export-file[]
funs-and-map record # RENAME, this now includes tests -------------------------------------------------------------------------
	funs fun-decl[]
	tests test_[]
	funs-map funs-map
check-funs funs-and-map
	ctx check-ctx
	types types-get
	structs struct-decl[]
	vars var-decl[]
	file-imports-and-exports file-imports-and-exports
	asts fun-decl-ast[]
	test-asts test-ast[]
do
	funs = check-funs-initial ctx, types, structs, vars, file-imports-and-exports, asts
	assert funs.size >= asts.size
	funs-map funs-map = funs.to
	check-method-impls ctx, funs-map, structs
	check-funs-with-asts ctx, types, funs-map, funs[0 .. asts.size], asts
	for i, f in with-index file-imports-and-exports.imports
		set-file-import-function-body funs[asts.size + i], f
	for i, f in with-index file-imports-and-exports.exports
		set-file-import-function-body funs[asts.size + file-imports-and-exports.imports.size + i], f
	funs: funs
	tests: check-tests ctx, types, funs-map, test-asts
	funs-map: funs-map

-check-funs-initial fun-decl[]
	ctx check-ctx
	types types-get
	structs struct-decl[]
	vars var-decl[]
	file-imports-and-exports file-imports-and-exports
	asts fun-decl-ast[]
do
	common-types = types.common-types
	do with out in build
	for fun-ast in asts
		out ~= check-fun ctx, types, fun-ast
	for f in file-imports-and-exports.imports
		out ~= fun-decl-for-file-import-or-export ctx, common-types, f, private
	for f in file-imports-and-exports.exports
		out ~= fun-decl-for-file-import-or-export ctx, common-types, f, public
	for struct in structs
		add-funs-for-struct ctx, out, common-types, struct
	for var in vars
		add-funs-for-var ctx, out, common-types, var

-check-fun fun-decl(ctx check-ctx, types types-get, fun-ast fun-decl-ast)
	fun fun-decl =
		hash: next-hash ctx
		source: fun-ast
		visibility: visibility-from-explicit-top-level fun-ast.visibility
		n-type-params: fun-ast.type-params.size
		return-type: bogus-type
		params: ()
		specs: check-fun-modifiers ctx, types, fun-ast.type-params, fun-ast.modifiers
		doc-comment-references: ()
		body: fun-body-uninitialized
	check-type-params ctx, fun-ast.type-params
	return-type, params = check-return-type-and-params ctx, types, fun, fun-ast.return-type, fun-ast.params, fun-ast.type-params
	fun.return-type := return-type
	fun.params := params
	param-types type[] = map params, it.type
	fun.param-types := param-types
	match insts = fun.insts
	as fun-inst
		insts.return-type := return-type
		insts.param-types := param-types
	as object-memoizer
		()
	fun

-set-file-import-function-body void(fun fun-decl, a import-or-export-file)
	fun.body := fun-body-file-import a.source.kind.import-file-ast!.type, a.content

-fun-decl-for-file-import-or-export fun-decl
	ctx check-ctx
	common-types common-types
	a import-or-export-file
	visibility visibility
do
	ast = a.source.kind.import-file-ast!
	hash: next-hash ctx
	source: fun-source-file-import ctx.cur-uri, a.source
	visibility: visibility
	n-type-params: 0
	return-type: type-for-file-import common-types, ast.type
	params: ()
	specs: ()
	doc-comment-references: ()
	body: fun-body-bogus

-type-for-file-import type(common-types common-types, type import-file-type)
	match type
	as nat8-array
		common-types.nat8-array
	as string
		common-types.string

-check-fun-modifiers specs
	ctx check-ctx
	types types-get
	type-params-scope type-params
	asts modifier-ast[]
do
	get-or-add-specs with out in build
		for ast in asts
			match ast
			as modifier-keyword-ast
				add-diag ctx, ast.keyword-range, diag-modifier-invalid ast.keyword, function_
			as spec-use-ast
				if inst = spec-or-type-from-ast ctx, types, type-params-scope, ast, no-delay-spec-insts
					out ~= inst

-check-tests test_[]
	ctx check-ctx
	types types-get
	funs-map funs-map
	test-asts test-ast[]
do
	void = types.common-types.void
	for ast in test-asts
		specs = check-fun-modifiers ctx, types, (), ast.modifiers
		if !is-empty specs.instantiated-sigs
			add-diag ctx, ast.keyword-range, test_.diag-spec-use-invalid
		test_ test_ = ctx.next-hash, ast, ctx.cur-uri, specs, (bogus-expr (), void), ()
		if body = ast.body
			test_.body := check-fun-or-test-body ctx, types, funs-map, test_, void, (), body, ()
		else
			add-diag ctx, ast.range, diag-test-missing-body
		test_

-check-funs-with-asts void
	ctx check-ctx
	types types-get
	funs-map funs-map
	funs-with-asts fun-decl array-view
	asts fun-decl-ast[]
do
	for i in 0::nat .. asts.size
		fun = funs-with-asts[i]
		fun-ast = asts[i]
		do if fun.body.fun-body-uninitialized
		fun.body := if is-bogus fun.return-type
			fun-body-bogus
		elif body = fun-ast.body
			check-fun-or-test-body ctx, types, funs-map, fun, fun.return-type, fun.params, body, () 'to
		else
			check-auto-fun ctx, types.common-types, types.types-and-specs-map, funs-map, fun
