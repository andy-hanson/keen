import
	../../../crow/col/experimental/object-memoizer
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/by-name
	./check-auto-fun
	./check-ctx
	./check-expr
	./check-struct-bodies
	./check-util
	./maps
	./funs-for-struct
	./instantiate
	./type-from-ast

funs-and-map record # RENAME, this now includes tests -------------------------------------------------------------------------
	funs fun-decl[]
	tests test_[]
	funs-map funs-map
check-funs funs-and-map
	ctx check-ctx
	types types-and-specs
	structs struct-decl[]
	vars var-decl[]
	file-imports import-or-export-file[]
	file-exports import-or-export-file[]
	asts fun-decl-ast[]
	test-asts test-ast[]
do
	funs = ctx check-funs-initial types, structs, vars, file-imports, file-exports, asts
	assert funs.size >= asts.size
	funs-map funs-map = funs to
	ctx check-method-impls funs-map, structs
	ctx check-funs-with-asts types, funs-map, funs[0 .. asts.size], asts
	for i, f in file-imports with-index
		funs[asts.size + i] set-file-import-function-body f
	for i, f in file-exports with-index
		funs[asts.size + file-imports.size + i] set-file-import-function-body f
	funs, (ctx check-tests types, funs-map, test-asts), funs-map

-check-funs-initial fun-decl[]
	ctx check-ctx
	types types-and-specs
	structs struct-decl[]
	vars var-decl[]
	file-imports import-or-export-file[]
	file-exports import-or-export-file[]
	asts fun-decl-ast[]
do
	common-types = types common-types
	with out in build
		for fun-ast in asts
			out ~= ctx check-fun types, fun-ast
		for f in file-imports
			out ~= ctx fun-decl-for-file-import-or-export common-types, f, private
		for f in file-exports
			out ~= ctx fun-decl-for-file-import-or-export common-types, f, public
		for struct in structs
			ctx add-funs-for-struct out, common-types, struct
		for var in vars
			ctx add-funs-for-var out, common-types, var

-check-fun fun-decl(ctx check-ctx, types types-and-specs, fun-ast fun-decl-ast)
	fun fun-decl =
		hash: ctx next-hash
		source: fun-ast
		visibility: fun-ast.visibility visibility-from-explicit-top-level
		n-type-params: fun-ast.type-params size
		return-type: bogus-type
		params: ()
		specs: ctx check-fun-modifiers types, fun-ast.type-params, fun-ast.modifiers
		doc-comment-references: ()
		body: fun-body-uninitialized
	ctx check-type-params fun-ast.type-params
	return-type, params = ctx check-return-type-and-params types.types, fun, fun-ast.return-type, fun-ast.params, fun-ast.type-params
	fun.return-type := return-type
	fun.params := params
	param-types type[] = params map it.type
	fun.param-types := param-types
	match x = fun insts
	as fun-inst
		x.return-type := return-type
		x.param-types := param-types
	as object-memoizer
		()
	fun

-set-file-import-function-body void(fun fun-decl, a import-or-export-file)
	fun.body := a.source.kind.import-file-ast!.type fun-body-file-import a.content

-fun-decl-for-file-import-or-export fun-decl
	ctx check-ctx
	common-types common-types
	a import-or-export-file
	visibility visibility
do
	ast = a.source.kind import-file-ast!
	hash: ctx next-hash
	source: ctx.cur-uri fun-source-file-import a.source
	visibility: visibility
	n-type-params: 0
	return-type: common-types type-for-file-import ast.type
	params: ()
	specs: ()
	doc-comment-references: ()
	body: fun-body-bogus

-type-for-file-import type(common-types common-types, type import-file-type)
	match type
	as nat8-array
		common-types nat8-array
	as string
		common-types string

-check-fun-modifiers specs
	ctx check-ctx
	types types-and-specs
	type-params-scope type-params
	asts modifier-ast[]
do
	with out in build
		for ast in asts
			match ast
			as modifier-keyword-ast
				ctx add-diag ast.keyword-range, do ast.keyword diag-modifier-invalid function_
			as spec-use-ast
				if inst = ctx spec-from-ast types, type-params-scope, ast, no-delay-spec-insts
					out ~= inst
	then get-or-add-specs

-check-tests test_[]
	ctx check-ctx
	types types-and-specs
	funs-map funs-map
	test-asts test-ast[]
do
	void = types.common-types void
	for ast in test-asts
		specs = ctx check-fun-modifiers types, (), ast.modifiers
		if specs.instantiated-sigs !is-empty
			ctx add-diag ast.keyword-range, test_.diag-spec-use-invalid
		test_ test_ = ctx.next-hash, ast, ctx.cur-uri, specs, (() bogus-expr void), ()
		if body = ast body
			test_.body := ctx check-fun-or-test-body types, funs-map, test_, void, (), body, ()
		else
			ctx add-diag ast.range, diag-test-missing-body
		test_

-check-funs-with-asts void
	ctx check-ctx
	types types-and-specs
	funs-map funs-map
	funs-with-asts fun-decl array-view
	asts fun-decl-ast[]
do
	for i in 0::nat .. asts.size
		fun = funs-with-asts[i]
		fun-ast = asts[i]
		guard fun.body fun-body-uninitialized
		fun.body := if fun.return-type is-bogus
			fun-body-bogus
		elif body = fun-ast body
			ctx check-fun-or-test-body types, funs-map, fun, fun.return-type, fun.params, body, () to
		else
			ctx check-auto-fun types.common-types, types.specs-map, funs-map, fun
