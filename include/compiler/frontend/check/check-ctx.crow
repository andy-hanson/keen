import
	../show-model
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/enum-map
	../../util/util
	./instantiate

check-ctx record mut
	show-ctx show-ctx # only for debugging ---------------------------------------------------------------------------------------------
	instantiate-ctx instantiate-ctx
	common-uris common-uris
	cur-uri uri
	config config
	imports-and-re-exports import-and-re-export-modules
	diagnostics-builder diagnostic mut[]
	used used-set

next-id decl-or-inst-id(a check-ctx)
	a.instantiate-ctx next-id

common-module enum
	array
	bootstrap
	alloc
	bool-low-level
	compare
	exception-low-level
	future-low-level
	js
	json
	misc
	mut-array
	number-low-level
	pointer
	runtime
	runtime-main
	std
	string
	symbol-low-level
	test-runner
to nat32(a common-module)
members common-module[]()
common-uris alias
	(common-module, uri) enum-map

used-set record(used decl-id mut-set) mut
new used-set()
	(),

-is-used bool(a used-set, used decl-id)
	used in a.used

-mark-used void(a used-set, used decl-id)
	a.used ~= used
mark-used  void(ctx check-ctx, used decl-id)
	ctx.used mark-used used

check-for-unused void(
	ctx check-ctx,
	aliases struct-alias[],
	structs struct-decl[],
	specs spec-decl[],
	funs fun-decl[],
)
	for x : aliases
		ctx check-unused-decl x.to
	for x : structs
		ctx check-unused-decl x.to, () =>
			# Even if the struct is not used as a type, it's used if it's accessed as a sumtype member
			x.sum-type-memberships exists m =>
				ctx.used is-used (funs sum-type-member-getter x, m id)
	for x : specs
		ctx check-unused-decl x.to
	for x : funs
		if x !ok-if-unused
			ctx check-unused-decl x.to
-check-unused-decl void(ctx check-ctx, decl any-decl)
	ctx check-unused-decl decl, () => false
-check-unused-decl void(ctx check-ctx, decl any-decl, cb-alt-is-used bool mut())
	if decl.visibility == private && !(ctx.used is-used decl.id || cb-alt-is-used[])
		ctx add-diag-assert-same-uri decl.name-range, decl.name.diag-unused-private-decl

finish-imports import-or-export[](ctx check-ctx)
	for import_ : ctx.imports-and-re-exports.imports
		if import_ is-std
			import_.imported := (ctx collect-imported import_),
		else
			match import_.source! kind
			as import-whole-module-ast
				import_.imported := (ctx collect-imported import_),
				if import_.imported! is-empty
					ctx add-diag-unused import_, import_.source!.path-range, ()
			as array names
				for _, x : import_.imported!
					if x !contains-used import_.import-visibility, ctx.used
						range = names must-find (nr => nr.name == x.name) range
						ctx add-diag-unused import_, range, (x.name,)
			as import-file-ast _
				throw unreachable
	ctx.imports-and-re-exports imports
-add-diag-unused void(ctx check-ctx, import_ import-or-export, range source-range, name symbol?)
	ctx add-diag range, (import_.module diag-unused-import name)

-collect-imported name-referents[symbol](ctx check-ctx, import_ import-or-export)
	with out : build
		for _, nr : import_.module.exports
			if nr contains-used import_.import-visibility, ctx.used
				out ~= (nr.name, nr)

-contains-used bool(a name-referents, import-visibility export-visibility, used used-set)
	a contains-used-struct-or-alias import-visibility, used ||
	a contains-used-spec import-visibility, used ||
	a.funs exists x =>
		import-visibility import-can-see x.visibility && used is-used x.id
-contains-used-struct-or-alias bool(a name-referents, import-visibility export-visibility, used used-set)
	if x ?= a struct-or-alias
		import-visibility import-can-see x.visibility && used is-used x.id
-contains-used-spec bool(a name-referents, import-visibility export-visibility, used used-set) 
	if x ?= a spec_
		import-visibility import-can-see x.visibility && used is-used x.id

import-and-re-export-modules record(imports import-or-export[], re-exports import-or-export[]) mut
each-import-and-re-export void(
	a import-and-re-export-modules,
	name symbol,
	# Caller is responsible for filtering by visibility
	cb void mut(visibility export-visibility, referents name-referents),
)
	for x : a imports
		x each-import-inner name, cb
	for x : a re-exports
		x each-import-inner name, cb
-each-import-inner void(
	import_ import-or-export,
	name symbol, 
	cb void mut(visibility export-visibility, referents name-referents),
)
	if import_ is-std
		if x ?= import_.module.exports[name]
			cb[import_.import-visibility, x]
	else
		res name-referents? = match import_.source!.kind
		as import-whole-module-ast
			import_.module.exports[name]
		as array _
			import_.imported![name]
		as import-file-ast _
			throw unreachable
		if x ?= res
			cb[import_.import-visibility, x]

add-diag-assert-same-uri void(ctx check-ctx, range uri-and-range, diag diag)
	range.uri is ctx.cur-uri
	ctx add-diag range.range, diag

add-diag void(ctx check-ctx, range source-range, diag diag)
	ctx add-diag (range, diag)
add-diag void(ctx check-ctx, diag diagnostic)
	ctx.diagnostics-builder ~= diag

finish-diagnostics diagnostic[](ctx check-ctx)
	ctx.diagnostics-builder move-to

visibility-from-default-with-diag visibility(
	ctx check-ctx,
	default visibility,
	explicit visibility-and-range?,
	kind visibility-warning-kind,
)
	if x ?= explicit
		actual = x visibility
		if actual < default
			actual
		else
			ctx add-diag x.range, (kind diag-visibility-warning default, actual)
			default
	else
		default

visibility-from-explicit-top-level visibility(a visibility-and-range?)
	a?.visibility ?? internal

check-no-type-params void(ctx check-ctx, type-params type-params, decl-kind decl-kind)
	unless type-params is-empty
		ctx add-diag type-params.type-params-range, decl-kind.diag-type-params-unsupported
