import
	../show-model
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/enum-map
	./instantiate

check-ctx record mut
	show-ctx show-ctx # only for debugging ---------------------------------------------------------------------------------------------
	instantiate-ctx instantiate-ctx
	common-uris common-uris
	cur-uri uri
	config config
	cur-file-text char8 array-view
	imports-and-re-exports exports[]
	| Will be present if 'std' is imported
	json-type struct-inst?
	diagnostics-builder diagnostic mut[]

instantiate-ctx instantiate-ctx() check-ctx
	the::check-ctx.instantiate-ctx

crow-include uri(a check-ctx)
	a.show-ctx.uris-info.crow-include

get-text char8 array-view(range source-range) check-ctx
	the::check-ctx.cur-file-text[range.start.to .. range.end.to]

next-hash nat32() check-ctx # TODO: maybe check-ctx should be a spec that also includes instantiate-ctxx
	next-hash the::check-ctx.instantiate-ctx

cur-uri uri() check-ctx
	the::check-ctx.cur-uri

common-module enum
	array
	bootstrap
	compare
	exception
	hash
	json
	misc
	mut-array
	runtime
	std
	string
	symbol
to nat8(a common-module)
members common-module[]()
common-uris alias
	(common-module, uri) enum-map

add-diag-assert-same-uri void(range uri-and-range, diag diag) check-ctx
	range.uri is the::check-ctx.cur-uri
	add-diag range.range, diag

add-diag void(range source-range, diag diag) check-ctx
	add-diag (range, diag)
add-diag void(diag diagnostic) check-ctx
	the::check-ctx.diagnostics-builder ~= diag

finish-diagnostics diagnostic[]() check-ctx
	move-to the::check-ctx.diagnostics-builder

visibility-from-explicit-top-level visibility(a visibility-and-range?)
	a.?visibility else internal

check-no-type-params void(type-params type-params, decl-kind decl-kind) check-ctx
	unless is-empty type-params
		add-diag type-params.type-params-range, diag-type-params-unsupported decl-kind
