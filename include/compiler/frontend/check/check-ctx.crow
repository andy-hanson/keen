use-prefix
import
	../show-model
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/enum-map
	./instantiate

check-ctx record mut
	show-ctx show-ctx # only for debugging ---------------------------------------------------------------------------------------------
	instantiate-ctx instantiate-ctx
	common-uris common-uris
	cur-uri uri
	config config
	cur-file-text char8 array-view
	imports-and-re-exports exports[]
	| Will be present if 'std' is imported
	json-type struct-inst?
	diagnostics-builder diagnostic mut[]

crow-include uri(a check-ctx)
	a.show-ctx.uris-info.crow-include

get-text char8 array-view(a check-ctx, range source-range)
	a.cur-file-text[range.start.to .. range.end.to]

next-hash nat32(a check-ctx)
	next-hash a.instantiate-ctx

common-module enum
	array
	bootstrap
	compare
	exception
	json
	misc
	mut-array
	runtime
	std
	string
	symbol
to nat32(a common-module)
members common-module[]()
common-uris alias
	(common-module, uri) enum-map

add-diag-assert-same-uri void(ctx check-ctx, range uri-and-range, diag diag)
	range.uri is ctx.cur-uri
	add-diag ctx, range.range, diag

add-diag void(ctx check-ctx, range source-range, diag diag)
	add-diag ctx, (range, diag)
add-diag void(ctx check-ctx, diag diagnostic)
	ctx.diagnostics-builder ~= diag

finish-diagnostics diagnostic[](ctx check-ctx)
	move-to ctx.diagnostics-builder

visibility-from-default-with-diag visibility
	ctx check-ctx
	default visibility
	explicit visibility-and-range?
	kind visibility-warning-kind
do
	if explicit
		actual = explicit.visibility
		if actual < default
			actual
		else
			add-diag ctx, explicit.range, diag-visibility-warning kind, default, actual
			default
	else
		default

visibility-from-explicit-top-level visibility(a visibility-and-range?)
	a.?visibility else internal

check-no-type-params void(ctx check-ctx, type-params type-params, decl-kind decl-kind)
	unless is-empty type-params
		add-diag ctx, type-params.type-params-range, diag-type-params-unsupported decl-kind
