import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/enum-map
	../../util/util
	./check-call/check-call-specs
	./check-ctx
	./get-builtin-fun
	./instantiate
	./type-from-ast

check-auto-fun fun-body(fun fun-decl) check-ctx, common-types, funs-map, types-get
	wrong = of diag diag
		add-diag fun.name-range.range, diag
		fun-body-bogus
	wrong-params = of kind auto-fun-name
		wrong[diag-auto-fun-wrong-params kind]
	wrong-return-type = of kind auto-fun-name
		wrong[diag-auto-fun-wrong-return-type kind]

	return-type = fun.return-type
	name-range = fun.name-range.range

	match fun.name
	as "=="
		do if param-type = get-auto-fun-param-type equals, fun, 2 else fun-body-bogus
		if is-builtin param-type
			get-builtin-fun fun
		elif spec_ = get-spec-from-common-module name-range, "equal", compare
			check-auto-fun-with-spec fun, param-type, equals, equals, spec_, (), ()
		else
			fun-body-bogus
	as "<=>"
		do if param-type = get-auto-fun-param-type compare, fun, 2 else fun-body-bogus
		if is-builtin param-type
			get-builtin-fun fun
		elif spec_ = get-spec-from-common-module name-range, "compare", compare
			check-auto-fun-with-spec fun, param-type, compare, compare, spec_, (), ()
		else
			fun-body-bogus
	as hash
		do if type = get-hash-param-type fun else fun-body-bogus
		do if spec_ = get-spec-from-common-module name-range, "hash", hash else
			fun-body-bogus
		check-auto-fun-with-spec fun, type, hash, hash, spec_, return-type.is-void, ()
	as members
		if !is-empty fun.params
			wrong-params[members]
		elif !is-enum-or-flags-array fun.return-type
			wrong-return-type[members]
		else
			auto-fun members-of-enum-or-flags, ()
	as to
		do if param-type = get-auto-fun-param-type to, fun, 1 else fun-body-bogus
		returned-nat = as-nat-type return-type
		param-nat = as-nat-type param-type
		returned-enum =  as-enum-or-flags-option return-type
		param-enum = as-enum-or-flags param-type
		if returned-enum and param-type == symbol
			auto-fun to-enum-or-flags-option-from-symbol, ()
		elif returned-enum and param-nat and param-nat >= returned-enum.storage
			auto-fun to-enum-or-flags-option-from-nat, ()
		elif returned-nat and param-enum
			if returned-nat >= param-enum.storage
				auto-fun to-nat-from-enum-or-flags, ()
			else
				wrong[diag-auto-fun-enum-or-flags-to-wrong-storage param-type.struct-inst!.decl, param-enum.storage, returned-nat]
		elif return-type == symbol and as-enum param-type
			auto-fun to-symbol-from-enum, ()
		elif return-type == symbol-array and as-flags param-type
			auto-fun to-symbol-array-from-flags, ()
		elif is-builtin param-type
			get-builtin-fun fun
		elif spec_ = get-spec-from-common-module name-range, "to", misc
			check-auto-fun-with-spec fun, param-type, to, to-json, spec_, return-type.is-json, return-type
		else
			fun-body-bogus
	else
		get-builtin-fun fun

-is-enum-or-flags-array bool(a type)
	(x = as-array a) and as-enum-or-flags x
-as-enum-or-flags-option enum-or-flags?(a type)
	?as-enum-or-flags unwrap-option a
-enum-or-flags record(storage nat-type, members enum-or-flags-member[])
-as-enum-or-flags enum-or-flags?(a type)
	if e = a.as-enum
		e.storage, e.members
	elif f = a.as-flags
		f.storage, f.members
-as-enum enum_?(a type)
	if a.struct-inst
		a.decl.body.enum_
-as-flags flags_?(a type)
	if a.struct-inst
		a.decl.body.flags_

-check-auto-fun-with-spec fun-body
	fun fun-decl
	param-type type
	fun-name auto-fun-name
	fun-kind auto-fun-kind
	spec_ spec-decl
	return-type-ok bool? # If none, use sig
	extra-type-arg type?
do check-ctx, common-types, funs-map
	diag = of x diag
		add-diag fun.name-range.range, x
		fun-body-bogus
	do if sig = only spec_.sigs else diag[diag-auto-fun-spec-corrupt spec_.name]

	do if is-enum-flags-record-or-union param-type else diag[diag-auto-fun-wrong-param-type]
	do if (return-type-ok else fun.return-type == sig.return-type) else
		diag[diag-auto-fun-wrong-return-type fun-name]
	param-inst = param-type.struct-inst!
	check-spec-for-component = of decl-type type
		inst-type = instantiate-type decl-type, param-inst.type-args
		spec-inst = instantiate-spec spec_, if extra-type-arg
			to-type-array (extra-type-arg, inst-type)
		else
			as-type-args inst-type
		check-spec-and-get-last-impl fun, spec-inst
	members called[] = match body = param-inst.decl.body
	as struct-body-bogus
		throw unreachable
	as struct-body-extern-java
		throw unreachable
	as builtin-type
		throw unreachable
	as enum_
		()
	as flags_
		()
	as record_
		for field in body.fields
			check-spec-for-component[field.type]
	as sum-type
		for m in body.listed-members
			check-spec-for-component[m.member]
	auto-fun fun-kind, members

get-auto-fun-param-type type?
	fun-name auto-fun-name
	fun fun-decl
	count-params nat
do check-ctx, common-types
	fail = of diag diag
		add-diag fun.name-range.range, diag
		()::type?
	do if fun.params.size == count-params and all-same fun.params, it.type else
		fail[diag-auto-fun-wrong-params fun-name]
	res = fun.params[0].type
	do if is-fully-visible res or res == symbol else fail[diag-auto-fun-type-not-fully-visible]
	do if every fun.params, !!it.local else fail[diag-auto-fun-param-not-simple]
	res

get-hash-param-type type?(fun fun-decl) check-ctx
	fail = of diag diag
		add-diag fun.name-range.range, diag
		()::type?
	do if value, hash-state = only2 fun.params else fail[diag-auto-fun-wrong-params hash]
	do if is-hash-state hash-state.type else fail[diag-auto-fun-wrong-params hash]
	do if is-fully-visible value.type else fail[diag-auto-fun-type-not-fully-visible]
	value.type

-is-enum-flags-record-or-union bool(a type)
	as-enum-or-flags a or is-record-or-union a
-is-builtin bool(a type)
	struct-inst a and builtin-type a.decl.body
-is-record-or-union bool(a type)
	a.struct-inst and is-record-or-union a.decl.body
-is-record-or-union bool(a struct-body)
	a.record_ or a.is-union
-is-union bool(a struct-body)
	a.sum-type and a.kind == union_

-is-fully-visible bool(a type) check-ctx
	do if a.struct-inst
	decl = a.decl
	decl.module-uri == cur-uri or match body = decl.body
	as struct-body-bogus
		true
	as struct-body-extern-java
		false
	as builtin-type
		true
	as enum_
		true
	as flags_
		true
	as record_
		every body.fields, it.visibility == decl.visibility
	as sum-type
		body.kind == union_

-is-hash-state bool(a type) check-ctx
	a.struct-inst and a.decl.module-uri == common-uris[hash] and a.decl.name == "hash-state"
-is-json bool(a type) check-ctx
	a.struct-inst and a.decl.module-uri == common-uris[json] and a.decl.name == "json"
