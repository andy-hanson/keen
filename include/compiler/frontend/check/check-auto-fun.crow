import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/enum-map
	../../util/util
	./check-call/check-call-specs
	./check-ctx
	./get-builtin-fun
	./maps
	./instantiate
	./type-from-ast

check-auto-fun fun-body(ctx check-ctx, common-types common-types, specs-map specs-map, funs-map funs-map, fun fun-decl)
	wrong fun-body mut(diag diag) = of diag
		add-diag ctx, fun.name-range.range, diag
		fun-body-bogus
	wrong-params fun-body mut(kind auto-fun-name) = of kind
		wrong[diag-auto-fun-wrong-params kind]
	wrong-return-type fun-body mut(kind auto-fun-name) = of kind
		wrong[diag-auto-fun-wrong-return-type kind]

	symbol = common-types.symbol
	symbol-array = common-types.array[symbol]
	return-type = fun.return-type
	name-range = fun.name-range.range

	match fun.name
	as "=="
		if param-type = get-auto-fun-param-type ctx, common-types, equals, fun, 2
			if is-builtin param-type
				get-builtin-fun ctx, fun
			elif spec_ = get-spec-from-common-module ctx, specs-map, name-range, "equal", compare
				check-auto-fun-with-spec ctx, funs-map, fun, param-type, equals, equals, spec_, (), ()
			else
				fun-body-bogus
		else
			fun-body-bogus
	as "<=>"
		if param-type = get-auto-fun-param-type ctx, common-types, compare, fun, 2
			if is-builtin param-type
				get-builtin-fun ctx, fun
			elif spec_ = get-spec-from-common-module ctx, specs-map, name-range, "compare", compare
				check-auto-fun-with-spec ctx, funs-map, fun, param-type, compare, compare, spec_, (), ()
			else
				fun-body-bogus
		else
			fun-body-bogus
	as "to"
		if param-type = get-auto-fun-param-type ctx, common-types, to, fun, 1
			returned-nat = as-nat-type return-type
			param-nat = as-nat-type param-type
			returned-enum =  as-enum-or-flags-option return-type
			param-enum = as-enum-or-flags param-type
			if returned-enum and param-type == symbol
				auto-fun to-enum-or-flags-option-from-symbol, ()
			elif returned-enum and param-nat and param-nat >= returned-enum.storage
				auto-fun to-enum-or-flags-option-from-nat, ()
			elif returned-nat and param-enum
				if returned-nat >= param-enum.storage
					auto-fun to-nat-from-enum-or-flags, ()
				else
					wrong[diag-auto-fun-enum-or-flags-to-wrong-storage param-type.struct-inst!.decl, param-enum.storage, returned-nat]
			elif return-type == symbol and as-enum param-type
				auto-fun to-symbol-from-enum, ()
			elif return-type == symbol-array and as-flags param-type
				auto-fun to-symbol-array-from-flags, ()
			elif is-builtin param-type
				get-builtin-fun ctx, fun
			elif spec_ = get-spec-from-common-module ctx, specs-map, name-range, "to", misc
				check-auto-fun-with-spec ctx, funs-map, fun, param-type, to, to-json, spec_, (is-json ctx, return-type), return-type
			else
				fun-body-bogus
		else
			fun-body-bogus
	as "members"
		if !is-empty fun.params
			wrong-params[members]
		elif !is-enum-or-flags-array fun.return-type
			wrong-return-type[members]
		else
			auto-fun members-of-enum-or-flags, ()
	else
		get-builtin-fun ctx, fun

-is-enum-or-flags-array bool(a type)
	(x = array-element-type a) and as-enum-or-flags x
-as-enum-or-flags-option enum-or-flags?(a type)
	?as-enum-or-flags unwrap-option a
-enum-or-flags record(storage nat-type, members enum-or-flags-member[])
-as-enum-or-flags enum-or-flags?(a type)
	if e = a.as-enum
		e.storage, e.members
	elif f = a.as-flags
		f.storage, f.members
-as-enum enum_?(a type)
	if a.struct-inst
		a.decl.body.enum_
-as-flags flags_?(a type)
	if a.struct-inst
		a.decl.body.flags_

-check-auto-fun-with-spec fun-body
	ctx check-ctx
	funs-map funs-map
	fun fun-decl
	param-type type
	fun-name auto-fun-name
	fun-kind auto-fun-kind
	spec_ spec-decl
	return-type-ok bool? # If none, use sig
	extra-type-arg type?
do
	diag fun-body mut(x diag) = of x
		add-diag ctx, fun.name-range.range, x
		fun-body-bogus
	guard sig = only spec_.sigs else diag[diag-auto-fun-spec-corrupt spec_.name]

	guard is-enum-flags-record-or-union param-type else diag[diag-auto-fun-wrong-param-type]
	guard (return-type-ok else fun.return-type == sig.return-type) else
		diag[diag-auto-fun-wrong-return-type fun-name]
	param-inst = param-type.struct-inst!
	check-spec-for-component called mut(decl-type type) = of decl-type
		inst-type = instantiate-type decl-type, param-inst.type-args
		spec-inst = instantiate-spec ctx.instantiate-ctx, spec_, if extra-type-arg
			to-type-array (extra-type-arg, inst-type)
		else
			as-type-args inst-type
		check-spec-and-get-last-impl ctx, funs-map, fun, spec-inst
	members called[] = match body = param-inst.decl.body
	as struct-body-bogus
		throw unreachable
	as struct-body-extern-java
		throw unreachable
	as builtin-type
		throw unreachable
	as enum_
		()
	as flags_
		()
	as record_
		for field in body.fields
			check-spec-for-component[field.type]
	as sum-type
		for m in body.listed-members
			check-spec-for-component[m.member]
	auto-fun fun-kind, members

get-auto-fun-param-type type?(ctx check-ctx, common-types common-types, fun-name auto-fun-name, fun fun-decl, count-params nat)
	fail type? mut(diag diag) = of diag
		add-diag ctx, fun.name-range.range, diag
		()
	res type? = if fun.params.size == count-params and all-same fun.params, it.type
		fun.params[0].type

	guard res else fail[diag-auto-fun-wrong-params fun-name]
	if !is-fully-visible ctx, res and res != common-types.symbol
		fail[diag-auto-fun-type-not-fully-visible]
	elif every fun.params, !!it.local
		res
	else
		fail[diag-auto-fun-param-not-simple]

-is-enum-flags-record-or-union bool(a type)
	as-enum-or-flags a or is-record-or-union a
-is-builtin bool(a type)
	struct-inst a and builtin-type a.decl.body
-is-record-or-union bool(a type)
	a.struct-inst and is-record-or-union a.decl.body
-is-record-or-union bool(a struct-body)
	a.record_ or a.is-union
-is-union bool(a struct-body)
	a.sum-type and a.kind == union_

-is-fully-visible bool(ctx check-ctx, a type)
	guard a.struct-inst
	decl = a.decl
	decl.module-uri == ctx.cur-uri or match body = decl.body
	as struct-body-bogus
		true
	as struct-body-extern-java
		false
	as builtin-type
		true
	as enum_
		true
	as flags_
		true
	as record_
		every body.fields, it.visibility == decl.visibility
	as sum-type
		body.kind == union_

-is-json bool(ctx check-ctx, a type)
	a.struct-inst and a.decl.module-uri == ctx.common-uris[json] and a.decl.name == "json"
