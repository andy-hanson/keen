import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/enum-map
	../../util/util
	./check-call/check-call-specs
	./check-ctx
	./get-builtin-fun
	./maps
	./instantiate
	./type-from-ast

check-auto-fun fun-body(ctx check-ctx, common-types common-types, specs-map specs-map, funs-map funs-map, fun fun-decl)
	wrong fun-body mut(diag diag) = of diag
		ctx add-diag fun.name-range.range, diag
		fun-body-bogus
	wrong-params fun-body mut(kind auto-fun-name) = of kind
		wrong[kind diag-auto-fun-wrong-params]
	wrong-return-type fun-body mut(kind auto-fun-name) = of kind
		wrong[kind diag-auto-fun-wrong-return-type]

	symbol = common-types symbol
	symbol-array = common-types.array[symbol]
	return-type = fun return-type
	name-range = fun.name-range range

	match fun name
	as "=="
		if param-type = ctx get-auto-fun-param-type common-types, equals, fun, 2
			if param-type is-builtin
				ctx get-builtin-fun fun
			elif spec_ = ctx get-spec-from-common-module specs-map, name-range, "equal", compare
				ctx check-auto-fun-with-spec funs-map, fun, param-type, equals, equals, spec_, (), ()
			else
				fun-body-bogus
		else
			fun-body-bogus
	as "<=>"
		if param-type = ctx get-auto-fun-param-type common-types, compare, fun, 2
			if param-type is-builtin
				ctx get-builtin-fun fun
			elif spec_ = ctx get-spec-from-common-module specs-map, name-range, "compare", compare
				ctx check-auto-fun-with-spec funs-map, fun, param-type, compare, compare, spec_, (), ()
			else
				fun-body-bogus
		else
			fun-body-bogus
	as "to"
		if param-type = ctx get-auto-fun-param-type common-types, to, fun, 1
			returned-nat = return-type as-nat-type
			param-nat = param-type as-nat-type
			returned-enum =  return-type as-enum-or-flags-option
			param-enum = param-type as-enum-or-flags
			if returned-enum and param-type == symbol
				to-enum-or-flags-option-from-symbol auto-fun ()
			elif returned-enum and param-nat and param-nat >= returned-enum.storage_
				to-enum-or-flags-option-from-nat auto-fun ()
			elif returned-nat and param-enum
				if returned-nat >= param-enum.storage_
					to-nat-from-enum-or-flags auto-fun ()
				else
					wrong[param-type.struct-inst!.decl diag-auto-fun-enum-or-flags-to-wrong-storage param-enum.storage_, returned-nat]
			elif return-type == symbol and param-type as-enum
				to-symbol-from-enum auto-fun ()
			elif return-type == symbol-array and param-type as-flags
				to-symbol-array-from-flags auto-fun ()
			elif param-type is-builtin
				ctx get-builtin-fun fun
			elif spec_ = ctx get-spec-from-common-module specs-map, name-range, "to", misc
				ctx check-auto-fun-with-spec funs-map, fun, param-type, to, to-json, spec_, (ctx is-json return-type), return-type
			else
				fun-body-bogus
		else
			fun-body-bogus
	as "members"
		if fun.params !is-empty
			wrong-params[members]
		elif fun.return-type !is-enum-or-flags-array
			wrong-return-type[members]
		else
			members-of-enum-or-flags auto-fun ()
	else
		ctx get-builtin-fun fun

-is-enum-or-flags-array bool(a type)
	(x = a array-element-type) and x as-enum-or-flags
-as-enum-or-flags-option enum-or-flags?(a type)
	a.unwrap-option ?as-enum-or-flags
-enum-or-flags record(storage_ nat-type, members enum-or-flags-member[])
-as-enum-or-flags enum-or-flags?(a type)
	if e = a as-enum
		e.storage_, e.members
	elif f = a as-flags
		f.storage_, f.members
-as-enum enum_?(a type)
	if x = a struct-inst
		x.decl.body enum_
-as-flags flags_?(a type)
	if x = a struct-inst
		x.decl.body flags_

-check-auto-fun-with-spec fun-body
	ctx check-ctx
	funs-map funs-map
	fun fun-decl
	param-type type
	fun-name auto-fun-name
	fun-kind auto-fun-kind
	spec_ spec-decl
	return-type-ok bool? # If none, use sig
	extra-type-arg type?
do
	diag fun-body mut(x diag) = of x
		ctx add-diag fun.name-range.range, x
		fun-body-bogus
	guard sig = spec_.sigs opt-only else diag[spec_.name diag-auto-fun-spec-corrupt]

	guard param-type is-enum-flags-record-or-union else diag[diag-auto-fun-wrong-param-type]
	guard (return-type-ok else fun.return-type == sig.return-type) else
		diag[fun-name diag-auto-fun-wrong-return-type]
	param-inst = param-type struct-inst!
	check-spec-for-component called mut(decl-type type) = of decl-type
		inst-type = decl-type instantiate-type param-inst.type-args
		spec-inst = ctx.instantiate-ctx instantiate-spec spec_, if extra-type-arg
			(extra-type-arg, inst-type) to-type-array
		else
			inst-type as-type-args
		ctx check-spec-and-get-last-impl funs-map, fun, spec-inst
	members called[] = match body = param-inst.decl body
	as struct-body-bogus
		throw unreachable
	as struct-body-extern-java
		throw unreachable
	as builtin-type
		throw unreachable
	as enum_
		()
	as flags_
		()
	as record_
		for field in body fields
			check-spec-for-component[field type]
	as sum-type
		for m in body listed-members
			check-spec-for-component[m member]
	fun-kind auto-fun members

get-auto-fun-param-type type?(ctx check-ctx, common-types common-types, fun-name auto-fun-name, fun fun-decl, count-params nat)
	fail type? mut(diag diag) = of diag
		ctx add-diag fun.name-range.range, diag
		()
	res type? = if fun.params.size == count-params and fun.params all-same it.type
		fun.params[0] type

	guard res else fail[fun-name diag-auto-fun-wrong-params]
	if ctx !is-fully-visible res and res != common-types.symbol
		fail[diag-auto-fun-type-not-fully-visible]
	elif fun.params every !!it.local
		res
	else
		fail[diag-auto-fun-param-not-simple]

-is-enum-flags-record-or-union bool(a type)
	a as-enum-or-flags or a is-record-or-union
-is-builtin bool(a type)
	guard x = a struct-inst
	!!x.decl.body.builtin-type
-is-record-or-union bool(a type)
	(x = a struct-inst) and x.decl.body is-record-or-union
-is-record-or-union bool(a struct-body)
	a record_ or a is-union
-is-union bool(a struct-body)
	(x = a sum-type) and x.kind == union_

-is-fully-visible bool(ctx check-ctx, a type)
	guard inst = a struct-inst
	decl = inst decl
	decl.module-uri == ctx.cur-uri or match body = decl body
	as struct-body-bogus
		true
	as struct-body-extern-java
		false
	as builtin-type
		true
	as enum_
		true
	as flags_
		true
	as record_
		body.fields every it.visibility == decl.visibility
	as sum-type
		body.kind == union_

-is-json bool(ctx check-ctx, a type)
	guard inst = a struct-inst
	decl = inst decl
	decl.module-uri == ctx.common-uris[json] and decl.name == "json"
