use-prefix
import
	../../../model/model
	../../../util/by-name
	../../../util/util
	../allocators
	../check-ctx
	../expr-ctx
	../inferring-type
	../maps

candidates-for-diag called-decl[](candidates candidates)
	map candidates, it.called

get-all-candidates-as-called-decls called-decl[](ctx expr-ctx, fun-name fun-name) # TODO: name should indicate that this is only for error reporting
	with out in build
		match fun-name
		as symbol
			each-fun-in-expr-scope ctx, fun-name, of called
				out ~= called
		as list-new
			each-fun-in-expr-scope ctx, "new", of called
				out ~= called
			each-fun-in-expr-scope ctx, "list-new", of called
				if as-list-new called
					out ~= called
		as named-new
			each-fun-in-expr-scope ctx, "new", of called
				out ~= called
			each-fun-in-expr-scope ctx, "named-new", of called
				if as-named-new called, ctx.common-types
					out ~= called
type-context-for-candidate type-context(a candidate) # TODO: INLINE --------------------------------------------------------
	a.type-args

with-candidates[t] t
	funs funs-in-scope
	fun-name fun-name
	actual-arity nat
	initial-filter bool mut(x candidate)
	f t mut(candidates candidates)
do
	candidates, restore = trusted allocate-candidates
	finally trusted free-candidates candidates, restore
	match fun-name
	as symbol
		add-initial-candidates candidates, funs, fun-name, actual-arity, initial-filter
	as list-new
		add-initial-candidates candidates, funs, "new", actual-arity, initial-filter
		each-fun-in-scope funs, "list-new", of called
			guard element-type = as-list-new called
			candidate = init-candidate-for-list-new called, actual-arity, element-type
			guard initial-filter[candidate]
			candidates ~= candidate
	as named-new
		add-initial-candidates candidates, funs, "new", actual-arity, of candidate
			parameter-names-are candidate.called, fun-name.names and initial-filter[candidate]
		each-fun-in-scope funs, "named-new", of called
			guard element-type = as-named-new called, fun-name.common-types
			candidate = init-candidate-for-named-new called, actual-arity, element-type
			guard initial-filter[candidate]
			candidates ~= candidate
	f[candidates]

-add-initial-candidates void
	candidates candidate stack-array
	funs funs-in-scope
	name symbol
	actual-arity nat
	initial-filter bool mut(x candidate)
do
	each-fun-in-scope funs, name, of called
		guard called.arity == actual-arity
		candidate = init-candidate called
		guard initial-filter[candidate]
		candidates ~= candidate

| Returns `t` if the signature matches `(values t[])`
as-list-new type?(called called-decl)
	?array-element-type opt-only called.param-types

| Returns `t` if the signature matches `(names symbol[], values t[])`.
-as-named-new type?(called called-decl, common-types common-types)
	guard names, values = opt-only2 called.param-types
	guard names.array-element-type == common-types.symbol
	array-element-type values

-parameter-names-are bool(a called-decl, names symbol[])
	a.params-for-names 'arrays-correspond names, of x, y
		x.name == y
-params-for-names destructure[](a called-decl)
	match a
	as fun-decl
		a.params
	as called-spec-sig
		a.non-instantiated-sig.params

each-candidate void(funs funs-in-scope, fun-name symbol, actual-arity nat, f void mut(x candidate))
	each-fun-in-scope funs, fun-name, of called
		guard called.arity == actual-arity
		f[init-candidate called]
	if fun-name == "new" and actual-arity == 0
		each-fun-in-scope funs, "list-new", of called
			guard element-type = as-list-new called
			f[init-candidate-for-list-new called, actual-arity, element-type]

funs-in-scope record mut
	fun-specs specs
	funs-map funs-map
	ctx check-ctx
funs-in-non-expr-scope funs-in-scope(ctx check-ctx, specs specs, funs-map funs-map)
	specs, funs-map, ctx
funs-in-expr-scope funs-in-scope(ctx expr-ctx)
	ctx.specs, ctx.funs-map, ctx.check-ctx

-each-fun-in-expr-scope void(ctx expr-ctx, fun-name symbol, cb void mut(x called-decl))
	each-fun-in-scope ctx.funs-in-expr-scope, fun-name, cb
each-fun-in-scope void(a funs-in-scope, fun-name symbol, cb void mut(x called-decl))
	for sig in a.fun-specs.instantiated-sigs
		if sig.name == fun-name
			cb[sig]
	for f in a.funs-map[fun-name]
		cb[f]
	for exports in a.ctx.imports-and-re-exports
		for f in exports.funs[fun-name]
			cb[f]

test-candidate-for-spec-sig bool
	spec-candidate candidate
	return-and-param-types return-and-param-types
	call-type-context type-context
	conv allow-implicit-conversions
do
	return-type = return-and-param-types.return-type
	return-conv implicit-conversions = match conv
	as no-conversions
		exact
	as allow-conversions
		a-to-b
	match-types (spec-candidate.called.return-type, spec-candidate.type-context-for-candidate), (return-type, call-type-context), return-conv and
	every return-and-param-types.param-types.with-index, of arg-idx, param-type
		test-candidate-param-type spec-candidate, arg-idx, (param-type, call-type-context), no-conversions

| Also does type inference on the candidate
test-candidate-return-type bool(expected expected, candidate candidate, conversions allow-implicit-conversions)
	match-expected-vs-return-type-no-diagnostic expected, (candidate.called.return-type, candidate.type-context-for-candidate), conversions
| Also does type inference on the candidate
test-candidate-param-type bool(candidate candidate, arg-idx nat, actual-arg-type type-and-context, conversions allow-implicit-conversions)
	match-types (get-candidate-expected-parameter-type candidate, arg-idx), actual-arg-type, match conversions
	as allow-conversions
		b-to-a
	else
		exact

get-candidate-expected-parameter-type type-and-context(candidate candidate, arg-index nat)
	decl-type = candidate.param-types[arg-index]
	if instantiated = try-get-exact-non-inferring-type (decl-type, candidate.type-context-for-candidate)
		non-inferring instantiated
	else
		decl-type, type-context-for-candidate candidate

candidate-bogus-called called(candidate candidate)
	:: called-bogus
	decl: candidate.called
	return-type: get-candidate-type-or-bogus candidate, candidate.called.return-type
	param-types: for t in candidate.param-types
		get-candidate-type-or-bogus candidate, t

-get-candidate-type-or-bogus type(candidate candidate, declared-type type)
	try-get-inexact-non-inferring-type (declared-type, candidate.type-context-for-candidate) else bogus-type
