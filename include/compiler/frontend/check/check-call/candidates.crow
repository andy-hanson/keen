import
	../../../model/model
	../../../util/by-name
	../../../util/sym
	../allocators
	../check-ctx
	../expr-ctx
	../inferring-type
	../maps

candidates-for-diag called-decl[](candidates candidates)
	for x : candidates
		x called

get-all-candidates-as-called-decls called-decl[](ctx expr-ctx, fun-name sym)
	with out : build
		ctx each-fun-in-expr-scope fun-name, called =>
			out ~= called
type-context-for-candidate type-context(a candidate) # TODO: INLINE --------------------------------------------------------
	a type-args

# TODO: use 'with-block' -------------------------------------------------------------------------------------------------------------
with-candidates[t] t
	funs funs-in-scope
	fun-name sym
	actual-arity nat
	initial-filter bool mut(x candidate)
	f t mut(candidates candidates)
do trusted
	candidates, restore = allocate-candidates
	funs each-fun-in-scope fun-name, called =>
		if called.arity arity-matches actual-arity
			candidate = called init-candidate
			if initial-filter[candidate]
				candidates ~= candidate
			else
				candidate free-candidate
	res = f[candidates]
	candidates free-candidates restore
	res

each-candidate void(funs funs-in-scope, fun-name sym, actual-arity nat, f void mut(x candidate))
	funs each-fun-in-scope fun-name, called =>
		guard called.arity arity-matches actual-arity
		trusted do
			candidate = called init-candidate
			finally candidate free-candidate
			f[candidate]

funs-in-scope record mut
	outermost-fun-specs specs # TODO: 'outermost' is confusing. This is just the specs on the current fun. -------------------------------------------
	funs-map funs-map
	ctx check-ctx
funs-in-non-expr-scope funs-in-scope(ctx check-ctx, funs-map funs-map)
	(), funs-map, ctx
funs-in-expr-scope funs-in-scope(ctx expr-ctx)
	ctx.specs, ctx.funs-map, ctx.check-ctx

-each-fun-in-expr-scope void(ctx expr-ctx, fun-name sym, cb void mut(x called-decl))
	ctx.funs-in-expr-scope each-fun-in-scope fun-name, cb
each-fun-in-scope void(a funs-in-scope, fun-name sym, cb void mut(x called-decl))
	for sig : a.outermost-fun-specs instantiated-sigs
		if sig.name == fun-name
			cb[sig]
	for f : a.funs-map[fun-name]
		cb[f]
	for exports : a.ctx imports-and-re-exports
		for f : exports.funs[fun-name]
			cb[f]

test-candidate-for-spec-sig bool
	spec-candidate candidate
	return-and-param-types return-and-param-types
	call-type-context type-context
	conv allow-implicit-conversions
do
	return-type = return-and-param-types return-type
	return-conv implicit-conversions = match conv
	as no-conversions
		exact
	as allow-conversions
		a-to-b
	(spec-candidate.called.return-type, spec-candidate.type-context-for-candidate) match-types (return-type, call-type-context), return-conv &&
	return-and-param-types.param-types.with-index every (arg-idx, param-type) =>
		# Don't allow conversion on the return type, or else when we check for '==' we will include the one taking 't?', which will then include the one taking 't??', etc.
		# TODO: huh, this is the param type, above comment must have been mistaken? -------------------------------------------------------------------------------------
		spec-candidate test-candidate-param-type arg-idx, (param-type, call-type-context), no-conversions

| Also does type inference on the candidate
test-candidate-return-type bool(expected expected, candidate candidate, conversions allow-implicit-conversions)
	expected match-expected-vs-return-type-no-diagnostic (candidate.called.return-type, candidate.type-context-for-candidate), conversions
| Also does type inference on the candidate
test-candidate-param-type bool(candidate candidate, arg-idx nat, actual-arg-type type-and-context, conversions allow-implicit-conversions)
	candidate get-candidate-expected-parameter-type arg-idx match-types actual-arg-type, match conversions
	as allow-conversions
		b-to-a
	else
		exact

get-candidate-expected-parameter-type type-and-context(candidate candidate, arg-index nat)
	decl-type = candidate.called param-type-at arg-index
	if instantiated ?= (decl-type, candidate.type-context-for-candidate) try-get-exact-non-inferring-type
		instantiated non-inferring
	else
		decl-type, candidate.type-context-for-candidate

candidate-bogus-called called(common-types common-types, candidate candidate)
	return-type = candidate get-candidate-type-or-bogus candidate.called.return-type
	param-types type[] = if candidate.called is-variadic
		p0 = candidate get-candidate-type-or-bogus (candidate.called param-type-at 0)
		common-types.array[p0],
	else
		for i : 0::nat .. candidate.called.arity.count-param-decls
			candidate get-candidate-type-or-bogus (candidate.called param-type-at i)
	candidate.called called-bogus return-type, param-types

-get-candidate-type-or-bogus type(candidate candidate, declared-type type)
	(declared-type, candidate.type-context-for-candidate) try-get-inexact-non-inferring-type ?? bogus-type

-param-type-at type(called called-decl, arg-index nat)
	match called
	as fun-decl x
		x.params param-type-at arg-index
	as called-spec-sig x
		x.param-types[arg-index]
-param-type-at type(params params, arg-index nat)
	match params
	as array x
		x[arg-index] type
	as varargs x
		x element-type
