import
	../../../model/model
	../../../util/by-name
	../../../util/util
	../allocators
	../check-ctx
	../expr-ctx
	../inferring-type

candidates-for-diag called-decl[](candidates candidates)
	map candidates, it.called

get-all-candidates-for-diag called-decl[](fun-name fun-name) check-expr-ctx
	do with out in build
	match fun-name
	as symbol
		each-fun-in-expr-scope fun-name, of called
			out ~= called
	as fun-name-list-new
		each-fun-in-expr-scope "new", of called
			out ~= called
		each-fun-in-expr-scope "list-new", of called
			if as-list-new called
				out ~= called
	as named-new
		each-fun-in-expr-scope "new", of called
			out ~= called
		each-fun-in-expr-scope "named-new", of called
			if as-named-new called
				out ~= called

with-candidates[t] t
	funs funs-in-scope
	fun-name fun-name
	actual-arity nat
	initial-filter bool mut(x candidate)
	f t mut(candidates candidates)
do check-ctx, common-types
	candidates, restore = trusted allocate-candidates
	finally trusted free-candidates candidates, restore
	match fun-name
	as symbol
		add-initial-candidates candidates, funs, fun-name, actual-arity, initial-filter
	as fun-name-list-new
		add-initial-candidates candidates, funs, "new", actual-arity, initial-filter
		each-fun-in-scope funs, "list-new", of called
			do if element-type = as-list-new called
			candidate = init-candidate-for-list-new called, actual-arity, element-type
			do if initial-filter[candidate]
			candidates ~= candidate
	as named-new
		add-initial-candidates candidates, funs, "new", actual-arity, of candidate
			parameter-names-are candidate.called, fun-name.names and initial-filter[candidate]
		each-fun-in-scope funs, "named-new", of called
			do if element-type = as-named-new called
			candidate = init-candidate-for-named-new called, actual-arity, element-type
			do if initial-filter[candidate]
			candidates ~= candidate
	f[candidates]

-add-initial-candidates void
	candidates candidate stack-array
	funs funs-in-scope
	name symbol
	actual-arity nat
	initial-filter bool mut(x candidate)
do check-ctx
	each-fun-in-scope funs, name, of called
		do if called.arity == actual-arity
		candidate = init-candidate called
		do if initial-filter[candidate]
		candidates ~= candidate

| Returns `t` if the signature matches `(values t[])`
as-list-new type?(called called-decl)
	?as-array only called.param-types

| Returns `t` if the signature matches `(names symbol[], values t[])`.
-as-named-new type?(called called-decl) common-types
	do if names, values = only2 called.param-types
	do if names.as-array == symbol
	as-array values

-parameter-names-are bool(a called-decl, names symbol[])
	a.params-for-names 'arrays-correspond names, of x, y
		x.name == y
-params-for-names destructure[](a called-decl)
	match a
	as fun-decl
		a.params
	as called-spec-sig
		a.non-instantiated-sig.params

each-candidate void(funs funs-in-scope, fun-name symbol, actual-arity nat, f void mut(x candidate)) check-ctx
	each-fun-in-scope funs, fun-name, of called
		if called.arity == actual-arity
			f[init-candidate called]
	if fun-name == "new" and actual-arity == 0
		each-fun-in-scope funs, "list-new", of called
			if element-type = as-list-new called
				f[init-candidate-for-list-new called, actual-arity, element-type]

funs-in-scope record mut
	fun-specs specs
	funs-map funs-map
funs-in-non-expr-scope funs-in-scope(specs specs) funs-map
	specs, the::funs-map
funs-in-expr-scope funs-in-scope() expr-ctx
	specs, funs-map

-each-fun-in-expr-scope void(fun-name symbol, cb void mut(x called-decl)) check-expr-ctx
	each-fun-in-scope funs-in-expr-scope, fun-name, cb
each-fun-in-scope void(a funs-in-scope, fun-name symbol, cb void mut(x called-decl)) check-ctx
	for sig in a.fun-specs.instantiated-sigs
		if sig.name == fun-name
			cb[sig]
	for f in a.funs-map[fun-name]
		cb[f]
	for exports in imports-and-re-exports
		for f in exports.funs[fun-name]
			cb[f]

allow-implicit-conversions enum(no-conversions, allow-conversions)
test-candidate-for-spec-sig bool
	spec-candidate candidate
	return-and-param-types return-and-param-types
	call-type-context type-context
	conv allow-implicit-conversions
do common-types
	return-type = return-and-param-types.return-type
	return-conv implicit-conversions = match conv
	as no-conversions
		exact
	as allow-conversions
		a-to-b
	match-types (spec-candidate.called.return-type, spec-candidate.inferring-type-args), (return-type, call-type-context), return-conv and
	every return-and-param-types.param-types.with-index, of arg-idx, param-type
		!!(test-candidate-param-type spec-candidate, arg-idx, (param-type, call-type-context), no-conversions)

| Also does type inference on the candidate
test-candidate-return-type type-match-kind?(expected expected, candidate candidate) common-types
	match-expected-vs-return-type-no-diagnostic expected, (candidate.called.return-type, candidate.inferring-type-args)
| Also does type inference on the candidate
test-candidate-param-type type-match-kind?
	candidate candidate
	arg-idx nat
	actual-arg-type type-and-context
	conversions allow-implicit-conversions
do common-types
	match-types (get-candidate-expected-parameter-type candidate, arg-idx), actual-arg-type, match conversions
	as allow-conversions
		b-to-a
	else
		exact

get-candidate-expected-parameter-type type-and-context(candidate candidate, arg-index nat)
	decl-type = candidate.param-types[arg-index]
	if instantiated = try-get-exact-non-inferring-type (decl-type, candidate.inferring-type-args)
		non-inferring instantiated
	else
		decl-type, inferring-type-args candidate

candidate-bogus-called called(candidate candidate)
	:: called-bogus
	decl: candidate.called
	return-type: get-candidate-type-or-bogus candidate, candidate.called.return-type
	param-types: for t in candidate.param-types
		get-candidate-type-or-bogus candidate, t

-get-candidate-type-or-bogus type(candidate candidate, declared-type type)
	try-get-inexact-non-inferring-type (declared-type, candidate.inferring-type-args) else bogus-type
