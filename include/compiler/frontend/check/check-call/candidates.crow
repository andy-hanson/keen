import
	../../../model/model
	../../../util/by-name
	../../../util/util
	../allocators
	../check-ctx
	../expr-ctx
	../inferring-type
	../maps

candidates-for-diag called-decl[](candidates candidates)
	candidates map it.called

get-all-candidates-as-called-decls called-decl[](ctx expr-ctx, fun-name fun-name) # TODO: name should indicate that this is only for error reporting
	with out in build
		match fun-name
		as symbol
			ctx each-fun-in-expr-scope fun-name, of called
				out ~= called
		as list-new
			ctx each-fun-in-expr-scope "new", of called
				out ~= called
			ctx each-fun-in-expr-scope "list-new", of called
				if _ ?= called as-list-new
					out ~= called
		as named-new
			ctx each-fun-in-expr-scope "new", of called
				out ~= called
			ctx each-fun-in-expr-scope "named-new", of called
				if _ ?= called as-named-new ctx.common-types
					out ~= called
type-context-for-candidate type-context(a candidate) # TODO: INLINE --------------------------------------------------------
	a type-args

with-candidates[t] t
	funs funs-in-scope
	fun-name fun-name
	actual-arity nat
	initial-filter bool mut(x candidate)
	f t mut(candidates candidates)
do
	candidates, restore = trusted allocate-candidates
	finally trusted candidates free-candidates restore
	match fun-name
	as symbol
		candidates add-initial-candidates funs, fun-name, actual-arity, initial-filter
	as list-new
		candidates add-initial-candidates funs, "new", actual-arity, initial-filter
		funs each-fun-in-scope "list-new", of called
			guard element-type ?= called as-list-new
			candidate = called init-candidate-for-list-new actual-arity, element-type
			guard initial-filter[candidate]
			candidates ~= candidate
	as named-new
		candidates add-initial-candidates funs, "new", actual-arity, of candidate
			candidate.called parameter-names-are fun-name.names and initial-filter[candidate]
		funs each-fun-in-scope "named-new", of called
			guard element-type ?= called as-named-new fun-name.common-types
			candidate = called init-candidate-for-named-new actual-arity, element-type
			guard initial-filter[candidate]
			candidates ~= candidate
	f[candidates]

-add-initial-candidates void
	candidates candidate stack-array
	funs funs-in-scope
	name symbol
	actual-arity nat
	initial-filter bool mut(x candidate)
do
	funs each-fun-in-scope name, of called
		guard called.arity == actual-arity
		candidate = called init-candidate
		guard initial-filter[candidate]
		candidates ~= candidate

| Returns `t` if the signature matches `(values t[])`
as-list-new type?(called called-decl)
	called.param-types.opt-only ?array-element-type

| Returns `t` if the signature matches `(names symbol[], values t[])`.
-as-named-new type?(called called-decl, common-types common-types)
	guard x, y ?= called.param-types opt-only2
	guard sym ?= x array-element-type
	guard sym == common-types.symbol
	y array-element-type

-parameter-names-are bool(a called-decl, names symbol[])
	actual = match a
	as fun-decl
		a params
	as called-spec-sig
		a.non-instantiated-sig params
	actual arrays-correspond names, of x, y
		x.name == y

each-candidate void(funs funs-in-scope, fun-name symbol, actual-arity nat, f void mut(x candidate))
	funs each-fun-in-scope fun-name, of called
		guard called.arity == actual-arity
		f[called init-candidate]
	if fun-name == "new" and actual-arity == 0
		funs each-fun-in-scope "list-new", of called
			guard element-type ?= called as-list-new
			f[called init-candidate-for-list-new actual-arity, element-type]

funs-in-scope record mut
	fun-specs specs
	funs-map funs-map
	ctx check-ctx
funs-in-non-expr-scope funs-in-scope(ctx check-ctx, funs-map funs-map)
	(), funs-map, ctx
funs-in-expr-scope funs-in-scope(ctx expr-ctx)
	ctx.specs, ctx.funs-map, ctx.check-ctx

-each-fun-in-expr-scope void(ctx expr-ctx, fun-name symbol, cb void mut(x called-decl))
	ctx.funs-in-expr-scope each-fun-in-scope fun-name, cb
each-fun-in-scope void(a funs-in-scope, fun-name symbol, cb void mut(x called-decl))
	for sig in a.fun-specs instantiated-sigs
		if sig.name == fun-name
			cb[sig]
	for f in a.funs-map[fun-name]
		cb[f]
	for exports in a.ctx imports-and-re-exports
		for f in exports.funs[fun-name]
			cb[f]

test-candidate-for-spec-sig bool
	spec-candidate candidate
	return-and-param-types return-and-param-types
	call-type-context type-context
	conv allow-implicit-conversions
do
	return-type = return-and-param-types return-type
	return-conv implicit-conversions = match conv
	as no-conversions
		exact
	as allow-conversions
		a-to-b
	(spec-candidate.called.return-type, spec-candidate.type-context-for-candidate) match-types (return-type, call-type-context), return-conv and
	return-and-param-types.param-types.with-index every of arg-idx, param-type
		spec-candidate test-candidate-param-type arg-idx, (param-type, call-type-context), no-conversions

| Also does type inference on the candidate
test-candidate-return-type bool(expected expected, candidate candidate, conversions allow-implicit-conversions)
	expected match-expected-vs-return-type-no-diagnostic (candidate.called.return-type, candidate.type-context-for-candidate), conversions
| Also does type inference on the candidate
test-candidate-param-type bool(candidate candidate, arg-idx nat, actual-arg-type type-and-context, conversions allow-implicit-conversions)
	candidate get-candidate-expected-parameter-type arg-idx match-types actual-arg-type, match conversions
	as allow-conversions
		b-to-a
	else
		exact

get-candidate-expected-parameter-type type-and-context(candidate candidate, arg-index nat)
	decl-type = candidate.param-types[arg-index]
	if instantiated ?= (decl-type, candidate.type-context-for-candidate) try-get-exact-non-inferring-type
		instantiated non-inferring
	else
		decl-type, candidate.type-context-for-candidate

candidate-bogus-called called(candidate candidate)
	:: called-bogus
	decl: candidate called
	return-type: candidate get-candidate-type-or-bogus candidate.called.return-type
	param-types: for t in candidate param-types
		candidate get-candidate-type-or-bogus t

-get-candidate-type-or-bogus type(candidate candidate, declared-type type)
	(declared-type, candidate.type-context-for-candidate) try-get-inexact-non-inferring-type else bogus-type
