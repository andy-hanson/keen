use-prefix
import
	crow/col/mut-slice
	../../../model/ast
	../../../model/model
	../../../model/source-range
	../../../util/util
	../allocators
	../check-ctx
	../expr-ctx
	../inferring-type
	../instantiate
	../maps
	../type-from-ast
	./candidates
	./check-call-specs

check-expr spec
	check-expr expr(ctx expr-ctx, ast expr-ast, expected expected)
check-lambda spec
	check-lambda expr
		ctx expr-ctx
		source lambda-source
		param-ast destructure-ast
		body-ast expr-ast
		expected expected

check-call expr(ctx expr-ctx, ast call-ast, expected expected) check-expr
	check-call-should-use-syntax ctx, ast
	if is-option-call ast.style
		check-option-call ctx, ast, expected
	else
		type-arg type? = if x = ast.type-arg
			type-from-ast ctx, x
		check-call-common ctx, expected, ast, ast.name-range, ast.fun-name.name, type-arg, ast.args

# Used for a list expression with no '--' parts
check-call-list-no-multi expr
	ctx expr-ctx
	ast call-expr-source
	range source-range
	parts expr-ast[]
	expected expected
do check-expr
	check-call-common ctx, expected, ast, range, list-new, (), parts

check-call-named expr(ctx expr-ctx, ast call-named-ast, expected expected) check-expr
	use-names, use-args = filter-together ast.names, ast.args, of name, _
		if name name
			true
		else
			add-diag ctx, ast.range, diag-named-new-interpolated
			false
	n named-new = (map use-names, it.name!), ctx.common-types
	check-call-common ctx, expected, ast, ast.range, n, (), use-args

check-call-special expr
	ctx expr-ctx
	source call-expr-source
	range source-range
	fun-name symbol
	args expr-ast[]
	expected expected
do check-expr
	check-call-common ctx, expected, source, range, fun-name, (), args

-check-call-common expr
	ctx expr-ctx
	expected expected
	source call-expr-source
	diag-range source-range
	fun-name fun-name
	type-arg type?
	arg-asts expr-ast[]
do check-expr
	cb-before-check bool mut(candidates candidates) = of candidates
		every arg-asts.with-index, of arg-idx, arg
			infer-candidate-type-args-from-explicitly-typed-argument ctx, candidates, arg-idx, arg
	check-call-special-cb-n ctx, source, diag-range, fun-name, expected, type-arg, arg-asts.size, \
		(of i, arg-expected then check-expr ctx, arg-asts[i], arg-expected), \
		cb-before-check

check-for-or-with expr
	ctx expr-ctx
	ast for-or-with-ast
	expected expected
do check-expr, check-lambda
	check-call-special-cb2 ctx, ast, ast.keyword-range, ast.called-function, expected, \
		(of arg-expected then check-expr ctx, ast.arg, arg-expected), \
		(of arg-expected then check-lambda ctx, ast, ast.param, ast.body, arg-expected), \
		of candidates then infer-candidate-type-args-from-lambda-parameter ctx, candidates, 1, ast.param

find-function-for-interpolate-or-list-new called?
	ctx expr-ctx
	diag-range source-range
	fun-name symbol
	return-type type
do
	initial-filter bool mut(x candidate) = of candidate
		called = called candidate
		guard as-list-new called
		match-types (called.return-type, candidate.type-context-for-candidate), (return-type, non-inferring), a-to-b
	with-candidates ctx.funs-in-expr-scope, fun-name, 1, initial-filter, of candidates
		if x = opt-only candidates
			check-call-after-choosing-overload ctx, x, diag-range
		else
			add-diag ctx, diag-range, if is-empty candidates
				diag-call-no-match-for-interpolate-or-list-new fun-name, type-with-container ctx, return-type
			else
				diag-call-multiple-matches fun-name, ctx.type-container, candidates.candidates-for-diag
			()

check-call-special-cb1 expr
	ctx expr-ctx
	source call-expr-source
	diag-range source-range
	fun-name symbol
	expected expected
	cb-arg expr mut(x expected)
do
	check-call-special-cb-n ctx, source, diag-range, fun-name, expected, 1, of i, arg-expected
		i is 0
		cb-arg[arg-expected]

check-call-special-cb2 expr
	ctx expr-ctx
	source call-expr-source
	diag-range source-range
	fun-name symbol
	expected expected
	cb-arg0 expr mut(x expected)
	cb-arg1 expr mut(x expected)
	cb-before-check bool mut(x candidates)
do
	check-arg expr mut(i nat, arg-expected expected) = of i, arg-expected
		match i
		as 0
			cb-arg0[arg-expected]
		as 1
			cb-arg1[arg-expected]
		else
			throw unreachable
	check-call-special-cb-n ctx, source, diag-range, fun-name, expected, (), 2, check-arg, cb-before-check

check-call-special-cb-n expr
	ctx expr-ctx
	source call-expr-source
	diag-range source-range
	fun-name symbol
	expected expected
	n-args nat
	cb-check-arg expr mut(i nat, arg-expected expected)
do
	check-call-special-cb-n ctx, source, diag-range, fun-name, expected, (), n-args, cb-check-arg, of _ then true
-check-call-special-cb-n expr
	ctx expr-ctx
	source call-expr-source
	diag-range source-range
	fun-name fun-name
	expected expected
	type-arg type?
	n-args nat
	cb-check-arg expr mut(i nat, arg-expected expected)
	cb-before-check bool mut(candidates candidates)
do
	args expr mut-slice = trusted gc-safe-mut-slice n-args
	check-arg void mut(i nat, arg-expected expected) = of i, arg-expected
		args[i] := cb-check-arg[i, arg-expected]
	if called = check-call-cb ctx, diag-range, fun-name, type-arg, n-args, expected, check-arg, cb-before-check
		# Check should always succeed, but we need it to set the inferred type
		check ctx, expected, called.return-type, make-call source, called, trusted cast-immutable args
	else
		candidates = get-candidate-decls-for-bogus ctx, fun-name
		if is-empty candidates
			bogus expected, source.range
		else
			set-to-bogus-if-inferring expected
			bogus-call-expr source, candidates, (trusted cast-immutable args), expected.inferred
-get-candidate-decls-for-bogus called-decl[](ctx expr-ctx, fun-name fun-name)
	with out in build
		match fun-name
		as symbol
			each-fun-in-scope ctx.funs-in-expr-scope, fun-name, of called
				out ~= called
		as list-new
			() # TODO ------------------------------------------------------------------------------------------------------
		as named-new
			() # TODO ------------------------------------------------------------------------------------------------------

-make-call expr(source call-expr-source, called called, args expr[])
	match source
	as call-named-ast
		match called.name
		as new
			call-expr source, called, args
		as named-new
			call-named-new-expr source, called, args
		else
			throw unreachable
	as if-ast
		make-list-call source, called, args
	as list-ast
		make-list-call source, called, args
	else
		call-expr source, called, args

-make-list-call expr(source list-expr-source, called called, args expr[])
	match called.name
	as new
		call-expr source.to, called, args
	as list-new
		list-expr source, called, for arg in args then arg
	else
		throw unreachable

-cb-check-arg alias
	void mut(arg-index nat, arg-expected expected)
-check-call-cb called?
	ctx expr-ctx
	diag-range source-range
	fun-name fun-name
	type-arg type?
	n-args nat
	expected expected
	cb-check-arg cb-check-arg
	cb-before-check bool mut(x candidates)
do
	initial-filter bool mut(x candidate) = of candidate
		filter-candidate-by-explicit-type-arg ctx.common-types, candidate, type-arg and
		test-candidate-return-type expected, candidate, allow-conversions
	with-candidates ctx.funs-in-expr-scope, fun-name, n-args, initial-filter, of candidates
		if cb-before-check[candidates]
			check-call-inner ctx, diag-range, fun-name, type-arg, candidates, expected, n-args, cb-check-arg

check-call-identifier expr(ctx expr-ctx, ast name-and-range, expected expected) check-expr
	if ast.name == "new"
		add-diag ctx, ast.range, diag-call-should-use-syntax 0, new_
	check-call-special ctx, ast, ast.range, ast.name, (), expected

check-method-impl called?
	ctx check-ctx
	funs-map funs-map
	struct struct-decl
	method-name symbol
	return-and-param-types return-and-param-types
	diag-range source-range
do
	arity = return-and-param-types.param-types.size
	initial-filter bool mut(x candidate) = of candidate
		test-candidate-for-spec-sig candidate, return-and-param-types, non-inferring, no-conversions # TODO: allow conversions here (and prefer exact)
	funs-in-scope = funs-in-non-expr-scope ctx, struct.specs, funs-map
	with-candidates funs-in-scope, method-name, arity, initial-filter, of candidates
		if x = opt-only candidates
			check-call-specs ctx, struct, funs-in-scope, never-trusted, diag-range, x
		else
			add-diag ctx, diag-range, if is-empty candidates
				diag-function-with-signature-not-found method-name, struct, return-and-param-types
			else
				diag-call-multiple-matches method-name, struct, candidates.candidates-for-diag
			()

-check-option-call expr(ctx expr-ctx, ast call-ast, outer-expected expected) check-expr
	check-with-modify-expected ctx, outer-expected, it.as-void-or-option-type, of inner-expected
		args expr mut-slice = trusted gc-safe-mut-slice ast.args.size
		check-arg void mut(index nat, arg-expected expected) = of index, arg-expected
			arg-ast = ast.args[index]
			if index == 0
				# For the first argument: It's opposite of for the return type.
				# The call is expecting a non-option, but change that to be expecting an option.
				_ = check-with-modify-expected ctx, arg-expected, ctx.common-types.option[it.as-type-args], of optional-arg-expected
					expr = check-expr ctx, arg-ast, optional-arg-expected
					option = inferred optional-arg-expected
					args[index] := expr
					expr, option.unwrap-if-option-type
			else
				args[index] := check-expr ctx, arg-ast, arg-expected
		if called = check-call-cb ctx, ast.fun-name.range, ast.fun-name.name, (), ast.args.size, inner-expected, check-arg, of _ then true
			type = if is-void called.return-type or is-option called.return-type
				called.return-type
			else
				ctx.common-types.option[as-type-args called.return-type]
			arg0-type = type args[0], ctx.available-types
			all-args = trusted cast-immutable args
			if is-option arg0-type
				- call-option-expr ast, called, all-args, type
				- type
			else
				add-diag ctx, args[0].range,
					diag-call-option-non-option called.name, type-with-container ctx, arg0-type
				- call-expr ast, called, all-args
				- called.return-type
		else
			(bogus inner-expected, ast.fun-name.range), bogus-type
-as-void-or-option-type type?(a type)
	if is-void a or is-option a then a

-check-call-inner called?
	ctx expr-ctx
	diag-range source-range
	fun-name fun-name
	explicit-type-arg type?
	candidates candidates
	expected expected
	n-args nat
	cb-check-arg cb-check-arg
do
	some-arg-is-bogus mut bool = false
	arg-index mut nat = 0
	# TODO:PERF Since this is only needed conditionally, consider getting this from the args
	arg-types type mut-slice = trusted gc-safe-mut-slice n-args
	loop
		guard arg-index != n-args else break
		guard !is-empty candidates else break
		filter-unordered-but-dont-remove-all candidates, of candidate
			# The point of this function is to infer one type arg from another,
			# e.g. given type params `[col, elem]` and spec `(col, elem) iterate` infer `elem` from `col`.
			# There's no point to doing this if we haven't inferred any type args.
			if has-some-inferred candidate
				pre-check-candidate-specs ctx, candidate
			else
				true
		arg-type = with-param-expected candidates, arg-index, cb-check-arg
		# If it failed to check, don-t continue, just stop there
		if is-bogus arg-type
			some-arg-is-bogus := true
			clear-candidates candidates
			break
		else
			arg-types[arg-index] := arg-type
			filter-unordered-tri candidates, of candidate
				if test-candidate-param-type candidate, arg-index, arg-type.non-inferring, no-conversions
					prefer
				elif test-candidate-param-type candidate, arg-index, arg-type.non-inferring, allow-conversions
					allow
				else
					reject
			arg-index +:= 1
			continue

	guard !some-arg-is-bogus

	filter-unordered-but-dont-remove-all candidates, of x
		pre-check-candidate-specs ctx, x

	if candidates.size > 1
		# If there are multiple candidates, prefer the one with no implicit conversions.
		filter-unordered-but-dont-remove-all candidates, of candidate
			test-candidate-return-type expected, candidate, no-conversions and
			every 0::nat .. arg-index, of i
				test-candidate-param-type candidate, i, arg-types[i].non-inferring, no-conversions

	if x = opt-only candidates
		check-call-after-choosing-overload ctx, x, diag-range
	else
		add-diag ctx, diag-range, if is-empty candidates
			all-candidates = get-all-candidates-as-called-decls ctx, fun-name
			:: diag-call-no-match
			type-container: ctx.type-container
			fun-name: fun-name
			expected-return-type: get-expected-for-diag ctx, expected
			actual-n-type-args: get-n-type-args-for-diagnostic ctx.common-types, explicit-type-arg
			actual-arity: n-args
			actual-arg-types: arg-types[0 .. arg-index].to
			all-candidates: all-candidates
		else
			diag-call-multiple-matches fun-name, ctx.type-container, candidates.candidates-for-diag
		()

-check-call-should-use-syntax void(ctx expr-ctx, ast call-ast)
	guard ast.style == dot or ast.style == prefix or ast.style == infix
	guard kind = should-use-syntax-kind ast
	add-diag ctx, ast.fun-name.range,
		diag-call-should-use-syntax ast.args.size, kind
-should-use-syntax-kind diag-call-should-use-syntax-kind?(ast call-ast)
	match ast.fun-name.name
	as force
		force
	as for-loop
		if second-arg-is-lambda ast
			for-loop
	as list-new
		if ?list-ast opt-only ast.args
			list-new
	as new
		new_
	as set-subscript
		set-subscript
	as subscript
		subscript
	as with-block
		if second-arg-is-lambda ast
			with-block
	else
		()
-second-arg-is-lambda bool(a call-ast)
	a.args.size == 2 and is-lambda a.args[1]
-is-lambda bool(a expr-ast)
	match a
	as it-scope-ast then true
	as lambda-ast then true
	else then false

-filter-candidate-by-explicit-type-arg bool(common-types common-types, candidate candidate, type-arg type?)
	guard type-arg else true
	n-type-params = candidate.type-args.size
	args = unpack-tuple-if-needed common-types, n-type-params, type-arg
	ok = args.size == n-type-params
	if ok
		for i, arg in with-index args
			candidate.type-args[i] := exact, arg
	ok

-with-param-expected type
	candidates candidates
	arg-index nat
	cb-check-arg void mut(arg-index nat, x expected)
do
	out type-and-context mut[] = allocate
	for candidate in candidates
		expected = get-candidate-expected-parameter-type candidate, arg-index
		is-duplicate =
			!is-inferring expected.context and
			exists out, of x
				!is-inferring x.context and x.type == expected.type
		unless is-duplicate
			out ~= expected
	arg-expected expected = out.to
	cb-check-arg[arg-index, arg-expected]
	res = inferred arg-expected
	clear out
	free out
	res

-infer-candidate-type-args-from-checked-spec-sig void
	spec-candidate candidate
	spec-sig signature
	sig-types return-and-param-types
	call-inferring-type-args type-context
do
	infer-type-args-from sig-types.return-type, call-inferring-type-args,
		spec-candidate.called.return-type, spec-candidate.type-context-for-candidate
	for arg-idx in 0::nat .. spec-sig.params.size
		infer-type-args-from sig-types.param-types[arg-idx], call-inferring-type-args,
			get-candidate-expected-parameter-type spec-candidate, arg-idx

-infer-candidate-type-args-from-explicitly-typed-argument bool
	ctx expr-ctx
	candidates candidates
	arg-index nat
	arg expr-ast
do
	if arg.lambda-ast
		infer-candidate-type-args-from-lambda-parameter ctx, candidates, arg-index, arg.param
	else
		true
-infer-candidate-type-args-from-lambda-parameter bool
	ctx expr-ctx
	candidates candidates
	arg-index nat
	param-ast destructure-ast
do
	# TODO: this means we may do 'typeFromDestructure' twice, once here and once when checking,
	# leading to duplicate diagnostics
	if lambda-param-type = type-from-destructure ctx, param-ast
		if is-bogus lambda-param-type
			false
		else
			for candidate in candidates
				param-type = get-candidate-expected-parameter-type candidate, arg-index
				infer-type-args-from-lambda-parameter-type param-type.type, candidate.type-context-for-candidate, lambda-param-type
			true
	else
		true

# This is not the final check, but we do filter out some candidates or infer type arguments early based on specs.
-pre-check-candidate-specs bool(ctx expr-ctx, candidate candidate)
	match called = candidate.called
	as fun-decl
		every called.specs.instantiated-sigs, of sig
			infer-candidate-type-args-from-spec-sig ctx, candidate, sig.non-instantiated-sig, sig.instantiated-sig
	as called-spec-sig
		true
-has-some-inferred bool(a candidate)
	exists a.type-args, !!it

-infer-candidate-type-args-from-spec-sig bool
	ctx expr-ctx
	call-candidate candidate
	spec-sig signature
	return-and-param-types return-and-param-types
do
	call-context = type-context-for-candidate call-candidate
	initial-filter bool mut(x candidate) = of candidate
		test-candidate-for-spec-sig candidate, return-and-param-types, call-context, allow-conversions
	with-candidates ctx.funs-in-expr-scope, spec-sig.name, spec-sig.params.size, initial-filter, of spec-candidates
		match spec-candidates.size
		as 0
			false
		as 1
			infer-candidate-type-args-from-checked-spec-sig spec-candidates.only, spec-sig, return-and-param-types, call-context
			true
		else
			true

-check-call-after-choosing-overload called(ctx expr-ctx, candidate candidate, diag-range source-range)
	check-call-specs ctx.check-ctx, ctx.type-container, ctx.funs-in-expr-scope, ctx, diag-range, candidate
