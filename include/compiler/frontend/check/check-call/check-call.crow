import
	../../../model/ast
	../../../model/model
	../../../model/source-range
	../../../util/util
	../allocators
	../check-ctx
	../expr-ctx
	../inferring-type
	../instantiate
	../type-from-ast
	./candidates
	./check-call-specs

check-expr spec
	check-expr expr
		instantiate-ctx instantiate-ctx
		check-ctx check-context
		common-types common-types
		expr-ctx expr-ctx
		ast expr-ast
		expected expected
-check-expr expr(ast expr-ast, expected expected) check-expr-ctx, common-types, check-expr
	check-expr the::instantiate-ctx, the::check-context, the::common-types, the::expr-ctx, ast, expected

check-lambda spec
	check-lambda expr
		instantiate-ctx instantiate-ctx
		check-ctx check-context
		common-types common-types
		expr-ctx expr-ctx
		source lambda-source
		expected expected
-check-lambda expr(source lambda-source, expected expected) check-expr-ctx, check-lambda
	check-lambda the::instantiate-ctx, the::check-context, the::common-types, the::expr-ctx, source, expected

check-call expr(ast call-ast, expected expected) check-expr-ctx, check-expr
	check-call-should-use-syntax ast
	if is-option-call ast
		check-option-call ast, expected, ast.fun-name.range, ast.fun-name.name, ast.args
	else
		check-call-common ast.args, expected,
			ast, ast.name-range, ast.fun-name.name, ast.type-arg.?type-from-ast, ast.args.size

check-call-subscript expr(ast call-subscript-ast, expected expected) check-expr-ctx, check-expr
	args expr-ast[] = ast.left, ast.right
	if ast.is-question-subscript
		check-option-call ast, expected, ast.subscript-range, "subscript", args
	else
		check-call-common args, expected,
			ast, ast.subscript-range, "subscript", (), args.size

# Used for a list expression with no '--' parts
check-call-list-no-multi expr
	ast call-expr-source
	range source-range
	parts expr-ast[]
	expected expected
do check-expr-ctx, check-expr
	check-call-common parts, expected,
		ast, range, fun-name-list-new, (), parts.size

check-call-named expr(ast call-named-ast, expected expected) check-expr-ctx, check-expr
	use-names, use-args = filter-together ast.names, ast.args, of index, name, _
		name-symbol = name.name
		if name-symbol
			if some ast.names[0 .. index], it.name == name-symbol
				add-diag name.range, diag-named-new-duplicate-name name-symbol
				false
			else
				true
		else
			add-diag name.range, diag-named-new-interpolated
			false
	check-call-common use-args, expected,
		ast, (names: map use-names, it.name!), use-args.size

check-call-special expr
	source call-expr-source
	range source-range
	fun-name symbol
	args expr-ast[]
	expected expected
do check-expr-ctx, check-expr
	check-call-common args, expected,
		source, range, fun-name, (), args.size

candidates-filter alias
	bool mut(candidates candidate stack-array)
candidate-filter alias
	bool mut(candidate candidate)

-check-call-common expr
	arg-asts expr-ast[]
	expected expected
	info call-info
do check-expr-ctx, check-expr
	cb-before-check candidates-filter = of candidates
		every arg-asts.with-index, of arg-idx, arg
			infer-candidate-type-args-from-explicitly-typed-argument candidates, arg-idx, arg
	check-call-special-cb-n info, expected, cb-before-check, of i, arg-expected
		check-expr arg-asts[i], arg-expected

check-for-or-with expr(ast for-or-with-ast, expected expected) check-expr-ctx, check-expr, check-lambda
	info call-info = ast, ast.keyword-range, ast.called-function, 2
	candidates-filter candidates-filter = of candidates
		infer-candidate-type-args-from-lambda-parameter candidates, 1, ast.param
	check-call-special-cb-n info, expected, candidates-filter, of i, arg-expected
		match i
		as 0
			check-expr ast.arg, arg-expected
		as 1
			check-lambda ast, arg-expected
		else
			throw unreachable

find-function-for-interpolate-or-list-new called?
	diag-range source-range
	fun-name symbol
	return-type type
do check-expr-ctx
	initial-filter candidate-filter = of candidate
		called = called candidate
		do if as-list-new called
		!!(match-types (called.return-type, candidate.inferring-type-args), (return-type, non-inferring), a-to-b)
	with-candidates funs-in-expr-scope, fun-name, 1, initial-filter, of candidates
		prefer-exact-candidates candidates, return-type.expect, ()
		if x = only candidates
			check-call-after-choosing-overload x, diag-range
		else
			add-diag diag-range, if is-empty candidates
				diag-call-no-match-for-interpolate-or-list-new fun-name, type-with-container return-type
			else
				diag-call-multiple-matches fun-name, type-container, candidates-for-diag candidates
			()

-prefer-exact-candidates void(candidates candidates, expected expected, arg-types type buffer-view) common-types
	# If there are multiple candidates, prefer the one with no implicit conversions.
	filter-unordered-max-priority candidates, of candidate
		res mut = 0
		for i in 0 .. arg-types.size
			res *:= type-match-kind-enum-size
			res +:= to test-candidate-param-type! candidate, i, arg-types[i].non-inferring, allow-conversions
		res *:= type-match-kind-enum-size
		# Candidates can sometimes infer 'bogus', which will cause 'test-candidate-return-type' to fail.
		?to test-candidate-return-type expected, candidate else 0

	filter-partial-compare candidates, of c1, c2
		r1 = c1.called.return-type
		r2 = c2.called.return-type
		if class1, pri1 = return-priority r1 and class2, pri2 = return-priority r2 and class1 == class2
			pri1 <=> pri2
		else
			equal

# Within the same category, larger number types are preferred.
# There is no preference across categories so int8 vs nat64 is ambiguous.
-number-category enum(int, nat, float)
- == bool(a number-category, b number-category)
-return-priority (number-category, nat32)?(type type)
	do if b = as-builtin-type type
	match b
	as int8 then int, 0
	as int16 then int, 1
	as int32 then int, 2
	as int64 then int, 3
	as nat8 then nat, 0
	as nat16 then nat, 1
	as nat32 then nat, 2
	as nat64 then nat, 3
	as float32 then float, 0
	as float64 then float, 1
	else then ()

check-call-special-cb1 expr
	source call-expr-source
	diag-range source-range
	fun-name symbol
	expected expected
	cb-arg expr mut(x expected)
do check-expr-ctx
	check-call-special-cb-n (source, diag-range, fun-name, 1), expected, of i, arg-expected
		i is 0
		cb-arg[arg-expected]

cb-check-arg alias
	expr mut(arg-index nat, arg-expected expected)
check-call-special-cb-n expr(info call-info, expected expected, cb-check-arg cb-check-arg) check-expr-ctx
	check-call-special-cb-n info, expected, (of _ then true), cb-check-arg

call-info record
	source call-expr-source
	diag-range source-range
	fun-name fun-name
	type-arg type?
	n-args nat
new call-info(source call-expr-source, diag-range source-range, fun-name fun-name, n-args nat)
	source, diag-range, fun-name, (), n-args
new call-info(source call-expr-source, fun-name fun-name, n-args nat)
	source, source.range, fun-name, n-args

-check-call-special-cb-n expr
	info call-info
	expected expected
	cb-before-check candidates-filter
	cb-check-arg cb-check-arg
do check-expr-ctx
	args expr buffer = trusted uninitialized-buffer info.n-args
	check-arg cb-check-arg-void = of i, arg-expected
		args[i] := cb-check-arg[i, arg-expected]
	if called = check-call-cb info, expected, check-arg, cb-before-check
		# Check should always succeed, but we need it to set the inferred type
		check expected, called.return-type, make-call info.source, called, trusted cast-immutable args
	else
		candidates = get-candidate-decls-for-bogus info.fun-name
		if is-empty candidates
			bogus expected, info.source.range
		else
			set-to-bogus-if-inferring expected
			bogus-call-expr info.source, candidates, (trusted cast-immutable args), expected.inferred
-get-candidate-decls-for-bogus called-decl[](fun-name fun-name) check-expr-ctx
	do with out in build
	match fun-name
	as symbol
		each-fun-in-scope funs-in-expr-scope, fun-name, of called
			out ~= called
	as fun-name-list-new
		() # TODO
	as named-new
		() # TODO

-make-call expr(source call-expr-source, called called, args expr[])
	match source
	as call-named-ast
		match called.name
		as new
			call-expr source, called, args
		as named-new
			call-named-new-expr source, called, args
		else
			throw unreachable
	as if-ast
		make-list-call source, called, args
	as list-ast
		make-list-call source, called, args
	else
		call-expr source, called, args

-make-list-call expr(source list-expr-source, called called, args expr[])
	match called.name
	as new
		call-expr source.to, called, args
	as list-new
		list-expr source, called, for arg in args then arg
	else
		throw unreachable

-cb-check-arg-void alias
	void mut(arg-index nat, arg-expected expected)
-check-call-cb called?
	info call-info
	expected expected
	cb-check-arg cb-check-arg-void
	cb-before-check bool mut(x candidates)
do check-expr-ctx
	initial-filter candidate-filter = of candidate
		filter-candidate-by-explicit-type-arg candidate, info.type-arg and
		test-candidate-return-type expected, candidate
	with-candidates funs-in-expr-scope, info.fun-name, info.n-args, initial-filter, of candidates
		if cb-before-check[candidates]
			check-call-inner info, candidates, expected, cb-check-arg

check-call-identifier expr(ast name-and-range, expected expected) check-expr-ctx, check-expr
	if ast.name == "new"
		add-diag ast.range, diag-call-should-use-syntax 0, new_
	check-call-special ast, ast.range, ast.name, (), expected

check-method-impl fun-inst?
	struct struct-decl
	method-name symbol
	return-and-param-types return-and-param-types
	diag-range source-range
do check-ctx, common-types, funs-map
	arity = return-and-param-types.param-types.size
	initial-filter bool mut(x candidate) = of candidate
		test-candidate-for-spec-sig candidate, return-and-param-types, non-inferring, no-conversions
	funs-in-scope = funs-in-non-expr-scope struct.specs
	with-candidates funs-in-scope, method-name, arity, initial-filter, of candidates
		if x = only candidates
			res = check-call-specs-except-contexts struct, funs-in-scope, never-trusted, diag-range, x
			match res
			as called-bogus
				()
			as fun-inst
				if check-no-contexts struct, method-impl, diag-range, res
					res
			as called-spec-sig
				()
		else
			add-diag diag-range, if is-empty candidates
				diag-function-with-signature-not-found method-name, struct, return-and-param-types
			else
				diag-call-multiple-matches method-name, struct, candidates.candidates-for-diag
			()

-check-option-call expr
	ast call-option-source
	outer-expected expected
	diag-range source-range
	fun-name symbol
	arg-asts expr-ast[]
do check-expr-ctx, check-expr
	check-with-modify-expected outer-expected, it.as-void-or-option-type, of inner-expected
		args expr buffer = trusted uninitialized-buffer arg-asts.size
		check-arg void mut(index nat, arg-expected expected) = of index, arg-expected
			arg-ast = arg-asts[index]
			# The call is expecting a non-option, but change that to be expecting an option.
			_ = check-with-modify-expected arg-expected, it.to-option, of optional-arg-expected
				expr = check-expr arg-ast, optional-arg-expected
				option = inferred optional-arg-expected
				args[index] := expr
				expr, option.unwrap-if-option-type
		info call-info = ast.to, diag-range, fun-name, args.size
		if called = check-call-cb info, inner-expected, check-arg, of _ then true
			type = if is-void called.return-type then called.return-type else to-option called.return-type
			all-args = trusted cast-immutable args
			if some all-args, of x then is-option type-not-json x
				- call-option-expr ast, called, all-args, type
				- type
			else
				add-diag args[0].range, diag-call-option-non-option called.name
				- call-expr ast.to, called, all-args
				- called.return-type
		else
			(bogus inner-expected, ast.range), bogus-type
-as-void-or-option-type type?(a type)
	if is-void a or is-option a then a

-to-option type(a type) common-types
	if is-option a then a else option[a]

-check-call-inner called?
	info call-info
	candidates candidates
	expected expected
	cb-check-arg cb-check-arg-void
do check-expr-ctx
	diag-range = info.diag-range
	fun-name = info.fun-name
	n-args = info.n-args
	some-arg-is-bogus mut bool = false
	arg-index mut = 0
	# TODO:PERF Since this is only needed conditionally, consider getting this from the args
	arg-types type buffer = trusted uninitialized-buffer n-args
	loop
		do if arg-index != n-args else break
		do unless is-empty candidates else break
		filter-unordered-but-dont-remove-all candidates, of candidate
			# The point of this function is to infer one type arg from another,
			# e.g. given type params `[col, elem]` and spec `(col, elem) some` infer `elem` from `col`.
			# There's no point to doing this if we haven't inferred any type args.
			if has-some-inferred candidate
				pre-check-candidate-specs candidate
			else
				true
		arg-type = with-param-expected candidates, arg-index, cb-check-arg
		# If it failed to check, don-t continue, just stop there
		if is-bogus arg-type
			some-arg-is-bogus := true
			clear-candidates candidates
			break
		else
			arg-types[arg-index] := arg-type
			filter-unordered-tri candidates, of candidate
				if test-candidate-param-type candidate, arg-index, arg-type.non-inferring, no-conversions
					prefer
				elif test-candidate-param-type candidate, arg-index, arg-type.non-inferring, allow-conversions
					allow
				else
					reject
			arg-index +:= 1
			continue

	do unless some-arg-is-bogus

	filter-unordered-but-dont-remove-all candidates, of x
		pre-check-candidate-specs x

	prefer-exact-candidates candidates, expected, arg-types[0 .. arg-index]

	if x = only candidates
		check-call-after-choosing-overload x, diag-range
	else
		add-diag diag-range, if is-empty candidates
			:: diag-call-no-match
			type-container: type-container
			fun-name: fun-name
			expected-return-type: get-expected-for-diag expected
			actual-n-type-args: get-n-type-args-for-diagnostic info.type-arg
			actual-arity: n-args
			actual-arg-types: arg-types[0 .. arg-index].to
			all-candidates: get-all-candidates-for-diag fun-name
		else
			diag-call-multiple-matches fun-name, type-container, candidates.candidates-for-diag
		()

-check-call-should-use-syntax void(ast call-ast) check-ctx
	do if ast.style == dot or ast.style == prefix or ast.style == infix
	do if kind = should-use-syntax-kind ast
	add-diag ast.fun-name.range,
		diag-call-should-use-syntax ast.args.size, kind
-should-use-syntax-kind diag-call-should-use-syntax-kind?(ast call-ast)
	match ast.fun-name.name
	as for-loop
		if second-arg-is-lambda ast
			for-loop
	as list-new
		if ?list-ast only ast.args
			list-new
	as new
		new_
	as set-subscript
		set-subscript
	as subscript
		subscript
	as with-block
		if second-arg-is-lambda ast
			with-block
	else
		if ast.args.size == 2 and starts-with ast.fun-name.name.to::string, "set-"
			set-name
-second-arg-is-lambda bool(a call-ast)
	a.args.size == 2 and is-lambda a.args[1]
-is-lambda bool(a expr-ast)
	match a
	as it-scope-ast then true
	as lambda-ast then true
	else then false

-filter-candidate-by-explicit-type-arg bool(candidate candidate, type-arg type?) common-types
	do if type-arg else true
	n-type-params = candidate.inferring-type-args.size
	args = unpack-tuple-if-needed n-type-params, type-arg
	ok = args.size == n-type-params
	if ok
		for i, arg in with-index args
			candidate.inferring-type-args[i] := exact, arg
	ok

-with-param-expected type(candidates candidates, arg-index nat, cb-check-arg cb-check-arg-void)
	out type-and-context mut[] = allocate
	for candidate in candidates
		expected = get-candidate-expected-parameter-type candidate, arg-index
		is-duplicate =
			!is-inferring expected.context and
			some out, of x
				!is-inferring x.context and x.type == expected.type
		unless is-duplicate
			out ~= expected
	arg-expected expected = out.to
	cb-check-arg[arg-index, arg-expected]
	res = inferred arg-expected
	clear out
	free out
	res

-infer-type-args-from-spec-impl void
	spec-candidate candidate
	spec-sig signature
	sig-types return-and-param-types
	call-inferring-type-args type-context
	max-depth nat
do check-expr-ctx
	check-types = of
		:: void
		infer-type-args-bidirectional (sig-types.return-type, call-inferring-type-args),
			spec-candidate.called.return-type, spec-candidate.inferring-type-args
		for arg-idx in 0::nat .. spec-sig.params.size
			infer-type-args-bidirectional (sig-types.param-types[arg-idx], call-inferring-type-args),
				get-candidate-expected-parameter-type spec-candidate, arg-idx
	check-types[]
	if max-depth != 0 and !is-fully-inferred spec-candidate.inferring-type-args
		_ = pre-check-candidate-specs spec-candidate, max-depth - 1
		check-types[]

-infer-candidate-type-args-from-explicitly-typed-argument bool
	candidates candidates
	arg-index nat
	arg expr-ast
do check-expr-ctx
	if arg.lambda-ast
		infer-candidate-type-args-from-lambda-parameter candidates, arg-index, arg.param
	else
		true
-infer-candidate-type-args-from-lambda-parameter bool
	candidates candidates
	arg-index nat
	param-ast destructure-ast
do check-expr-ctx
	# TODO: this means we may do 'type-from-destructure' twice, once here and once when checking,
	# leading to duplicate diagnostics
	if lambda-param-type = type-from-destructure param-ast
		if is-bogus lambda-param-type
			false
		else
			for candidate in candidates
				param-type = get-candidate-expected-parameter-type candidate, arg-index
				if is-inferring param-type.context
					infer-type-args-from-lambda-parameter-type param-type, lambda-param-type
			true
	else
		true

# This is not the final check, but we do filter out some candidates or infer type arguments early based on specs.
-pre-check-candidate-specs bool(candidate candidate) check-expr-ctx
	pre-check-candidate-specs candidate, 2
-pre-check-candidate-specs bool(candidate candidate, max-depth nat) check-expr-ctx
	match called = candidate.called
	as fun-decl
		every called.specs.instantiated-sigs, of sig
			pre-check-spec candidate, sig.non-instantiated-sig, sig.instantiated-sig, max-depth
	as called-spec-sig
		true
-has-some-inferred bool(a candidate)
	some a.inferring-type-args, !!it

-pre-check-spec bool
	call-candidate candidate
	spec-sig signature
	sig-types return-and-param-types
	max-depth nat
do check-expr-ctx
	call-context = inferring-type-args call-candidate
	initial-filter candidate-filter = of candidate
		test-candidate-for-spec-sig candidate, sig-types, call-context, allow-conversions
	with-candidates funs-in-expr-scope, spec-sig.name, spec-sig.params.size, initial-filter, of spec-candidates
		match spec-candidates.size
		as 0
			false
		as 1
			infer-type-args-from-spec-impl spec-candidates.only!, spec-sig, sig-types, call-context, max-depth
			true
		else
			true

-check-call-after-choosing-overload called(candidate candidate, diag-range source-range) check-expr-ctx
	res = check-call-specs-except-contexts type-container, funs-in-expr-scope, the::expr-ctx, diag-range, candidate
	check-contexts diag-range, res
	res
