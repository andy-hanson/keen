import
	crow/col/mut-slice
	../../../model/ast
	../../../model/model
	../../../model/source-range
	../../../util/util
	../allocators
	../check-ctx
	../expr-ctx
	../inferring-type
	../instantiate
	../type-from-ast
	./candidates
	./check-call-specs

check-expr spec
	check-expr expr(ctx expr-ctx, ast expr-ast, expected expected)
check-lambda spec
	check-lambda expr
		ctx expr-ctx
		source lambda-source
		param-ast destructure-ast
		body-ast expr-ast
		expected expected

check-call expr(ctx expr-ctx, ast call-ast, expected expected) check-expr
	ctx check-call-should-use-syntax ast
	if ast.style is-option-call
		ctx check-option-call ast, expected
	else
		type-arg type? = if x ?= ast type-arg
			ctx type-from-ast x
		ctx check-call-common expected, ast, ast.name-range, ast.fun-name.name, type-arg, ast.args

check-call-named expr(ctx expr-ctx, ast call-named-ast, expected expected) check-expr
	use-names, use-args = ast.names filter-together ast.args, of name, _
		if _ ?= name name
			true
		else
			ctx add-diag ast.range, diag-named-new-interpolated
			false
	n named-new = (use-names map it.name!), ctx.common-types
	ctx check-call-common expected, ast, ast.range, n, (), use-args

check-call-special expr
	ctx expr-ctx
	source call-expr-source
	range source-range
	fun-name symbol
	args expr-ast[]
	expected expected
do check-expr
	ctx check-call-common expected, source, range, fun-name, (), args

-check-call-common expr
	ctx expr-ctx
	expected expected
	source call-expr-source
	diag-range source-range
	fun-name fun-name
	type-arg type?
	arg-asts expr-ast[]
do check-expr
	cb-before-check bool mut(candidates candidates) = of candidates
		arg-asts.with-index every of arg-idx, arg
			ctx infer-candidate-type-args-from-explicitly-typed-argument candidates, arg-idx, arg
	ctx check-call-special-cb-n source, diag-range, fun-name, expected, type-arg, arg-asts.size, \
		(of i, arg-expected then ctx check-expr arg-asts[i], arg-expected), \
		cb-before-check

check-call-arg-and-lambda expr
	ctx expr-ctx
	call-source call-expr-source
	lambda-source lambda-source
	diag-range source-range
	fun-name symbol
	arg-ast expr-ast
	param-ast destructure-ast
	body-ast expr-ast
	expected expected
do check-expr, check-lambda
	ctx check-call-special-cb2 call-source, diag-range, fun-name, expected, \
		(of arg-expected then ctx check-expr arg-ast, arg-expected), \
		(of arg-expected then ctx check-lambda lambda-source, param-ast, body-ast, arg-expected), \
		of candidates then ctx infer-candidate-type-args-from-lambda-parameter candidates, 1, param-ast

find-function-for-list-new called?
	ctx expr-ctx
	diag-range source-range
	return-type type
do
	initial-filter bool mut(x candidate) = of candidate
		called = candidate called
		guard fun ?= called fun-decl
		param = fun.params.array! only
		guard param.type is-array
		(called.return-type, candidate.type-context-for-candidate) match-types (return-type, non-inferring), a-to-b
	ctx.funs-in-expr-scope with-candidates "list-new", 1, initial-filter, of candidates
		if x ?= candidates opt-only
			ctx.check-ctx check-call-after-choosing-overload ctx.common-types, \
				ctx.type-container, ctx.funs-in-expr-scope, ctx.cur-flags, ctx.externs, x, diag-range, of then ctx check-is-trusted
		else
			ctx add-diag diag-range, if candidates is-empty
				ctx type-with-container return-type diag-call-no-match-for-list
			else
				"list-new" diag-call-multiple-matches ctx.type-container, for x in candidates then x called
			()

check-call-special-cb1 expr
	ctx expr-ctx
	source call-expr-source
	diag-range source-range
	fun-name symbol
	expected expected
	cb-arg expr mut(x expected)
do
	ctx check-call-special-cb-n source, diag-range, fun-name, expected, 1, of i, arg-expected
		i is 0
		cb-arg[arg-expected]

check-call-special-cb2 expr
	ctx expr-ctx
	source call-expr-source
	diag-range source-range
	fun-name symbol
	expected expected
	cb-arg0 expr mut(x expected)
	cb-arg1 expr mut(x expected)
	cb-before-check bool mut(x candidates)
do
	check-arg expr mut(i nat, arg-expected expected) = of i, arg-expected
		match i
		as 0
			cb-arg0[arg-expected]
		as 1
			cb-arg1[arg-expected]
		else
			throw unreachable
	ctx check-call-special-cb-n source, diag-range, fun-name, expected, (), 2, check-arg, cb-before-check

check-call-special-cb-n expr
	ctx expr-ctx
	source call-expr-source
	diag-range source-range
	fun-name symbol
	expected expected
	n-args nat
	cb-check-arg expr mut(i nat, arg-expected expected)
do
	ctx check-call-special-cb-n source, diag-range, fun-name, expected, (), n-args, cb-check-arg, of _ then true
-check-call-special-cb-n expr
	ctx expr-ctx
	source call-expr-source
	diag-range source-range
	fun-name fun-name
	expected expected
	type-arg type?
	n-args nat
	cb-check-arg expr mut(i nat, arg-expected expected)
	cb-before-check bool mut(candidates candidates)
do
	args expr mut-slice = trusted n-args gc-safe-mut-slice
	check-arg void mut(i nat, arg-expected expected) = of i, arg-expected
		args[i] := cb-check-arg[i, arg-expected]
	if called ?= ctx check-call-cb diag-range, fun-name, type-arg, n-args, expected, check-arg, cb-before-check
		# Check should always succeed, but we need it to set the inferred type
		ctx check expected, called.return-type, do source make-call called, trusted args cast-immutable
	else
		candidates = ctx get-candidate-decls-for-bogus fun-name
		if candidates is-empty
			expected bogus source.range
		else
			expected set-to-bogus-if-inferring
			source bogus-call-expr candidates, (trusted args cast-immutable), expected.inferred
-get-candidate-decls-for-bogus called-decl[](ctx expr-ctx, fun-name fun-name)
	with out in build
		match fun-name
		as symbol x
			ctx.funs-in-expr-scope each-fun-in-scope x, of called
				out ~= called
		as named-new _
			() # TODO ------------------------------------------------------------------------------------------------------

-make-call expr(source call-expr-source, called called, args expr[])
	match source
	as call-named-ast x
		match called name
		as new
			source call-expr called, args
		as named-new
			x call-named-new-expr called, args
		else
			throw unreachable
	else
		source call-expr called, args

-cb-check-arg alias
	void mut(arg-index nat, arg-expected expected)
-check-call-cb called?
	ctx expr-ctx
	diag-range source-range
	fun-name fun-name
	type-arg type?
	n-args nat
	expected expected
	cb-check-arg cb-check-arg
	cb-before-check bool mut(x candidates)
do
	initial-filter bool mut(x candidate) = of candidate
		ctx.common-types filter-candidate-by-explicit-type-arg candidate, type-arg and
		expected test-candidate-return-type candidate, allow-conversions
	ctx.funs-in-expr-scope with-candidates fun-name, n-args, initial-filter, of candidates
		if cb-before-check[candidates]
			ctx check-call-inner diag-range, fun-name, type-arg, candidates, expected, n-args, cb-check-arg

check-call-identifier expr(ctx expr-ctx, ast name-and-range, expected expected) check-expr
	if ast.name == "new"
		ctx add-diag ast.range, do 0 diag-call-should-use-syntax new_
	ctx check-call-special ast, ast.range, ast.name, (), expected

find-function-for-return-and-param-types called?
	ctx check-ctx
	common-types common-types
	type-container type-container
	funs-in-scope funs-in-scope
	fun-flags fun-flags
	externs symbol-set
	name symbol
	diag-range source-range
	type-arg type?
	return-and-param-types return-and-param-types
	is-trusted bool mut() # TODO: I think this is always false ----------------------------------------------------------------
do
	arity = return-and-param-types.param-types size
	initial-filter bool mut(x candidate) = of candidate
		common-types filter-candidate-by-explicit-type-arg candidate, type-arg and
		candidate test-candidate-for-spec-sig return-and-param-types, non-inferring, no-conversions # TODO: allow conversions here (and prefer exact)
	funs-in-scope with-candidates name, arity, initial-filter, of candidates
		if x ?= candidates opt-only
			ctx check-call-after-choosing-overload common-types, type-container, funs-in-scope, fun-flags, externs, x, diag-range, is-trusted
		else
			ctx add-diag diag-range, if candidates is-empty
				name diag-function-with-signature-not-found type-container, return-and-param-types
			else
				name diag-call-multiple-matches type-container, for x in candidates then x called
			()

-check-option-call expr(ctx expr-ctx, ast call-ast, outer-expected expected) check-expr
	ctx check-with-modify-expected outer-expected, it.as-void-or-option-type, of inner-expected
		assert ast.args.size != 0
		args expr mut-slice = trusted ast.args.size gc-safe-mut-slice
		check-arg void mut(index nat, arg-expected expected) = of index, arg-expected
			arg-ast = ast.args[index]
			if index == 0
				# For the first argument: It's opposite of for the return type.
				# The call is expecting a non-option, but change that to be expecting an option.
				_ = ctx check-with-modify-expected arg-expected, ctx.common-types.option[it.as-type-args], of optional-arg-expected
					expr = ctx check-expr arg-ast, optional-arg-expected
					option = optional-arg-expected inferred
					args[index] := expr
					expr, option.unwrap-if-option-type
			else
				args[index] := ctx check-expr arg-ast, arg-expected
		if called ?= ctx check-call-cb ast.fun-name.range, ast.fun-name.name, (), ast.args.size, inner-expected, check-arg, of _ then true
			type = if called.return-type is-void
				called return-type
			else
				ctx.instantiate-ctx make-option-if-not-already ctx.common-types, called.return-type
			arg0-type = args[0] type ctx.available-types
			all-args = trusted args cast-immutable
			if arg0-type is-option-type
				- ast call-option-expr called, all-args, type
				- type
			else
				ctx add-diag args[0].range,
					called.name diag-call-option-non-option do ctx type-with-container arg0-type
				- ast call-expr called, all-args
				- called return-type
		else
			(inner-expected bogus ast.fun-name.range), bogus-type
-as-void-or-option-type type?(a type)
	if a is-void or a is-option-type then a

-check-call-inner called?
	ctx expr-ctx
	diag-range source-range
	fun-name fun-name
	explicit-type-arg type?
	candidates candidates
	expected expected
	n-args nat
	cb-check-arg cb-check-arg
do
	some-arg-is-bogus mut bool = false
	arg-index mut nat = 0
	# TODO:PERF Since this is only needed conditionally, consider getting this from the args
	arg-types type mut-slice = trusted n-args gc-safe-mut-slice
	loop
		guard arg-index != n-args else break
		guard candidates !is-empty else break
		candidates filter-unordered-but-dont-remove-all of candidate
			# The point of this function is to infer one type arg from another,
			# e.g. given type params `[col, elem]` and spec `(col, elem) iterate` infer `elem` from `col`.
			# There's no point to doing this if we haven't inferred any type args.
			if candidate has-some-inferred
				ctx pre-check-candidate-specs candidate
			else
				true
		arg-type = candidates with-param-expected arg-index, cb-check-arg
		# If it failed to check, don-t continue, just stop there
		if arg-type is-bogus
			some-arg-is-bogus := true
			candidates clear-candidates
			break
		else
			arg-types[arg-index] := arg-type
			candidates filter-unordered-tri of candidate
				if candidate.called.name == "list-new" # TODO: RM (this is to prefer list-new over variadic) ----------------------------------------------------------
					prefer
				elif candidate test-candidate-param-type arg-index, arg-type.non-inferring, no-conversions
					prefer
				elif candidate test-candidate-param-type arg-index, arg-type.non-inferring, allow-conversions
					allow
				else
					reject
			arg-index +:= 1
			continue

	guard !some-arg-is-bogus

	candidates filter-unordered-but-dont-remove-all of x
		ctx pre-check-candidate-specs x

	if candidates.size > 1
		# If there are multiple candidates, prefer the one with no implicit conversions.
		candidates filter-unordered-but-dont-remove-all of candidate
			expected test-candidate-return-type candidate, no-conversions and
			0::nat .. arg-index every of i
				candidate test-candidate-param-type i, arg-types[i].non-inferring, no-conversions

	if x ?= candidates opt-only
		ctx.check-ctx check-call-after-choosing-overload ctx.common-types, ctx.type-container, ctx.funs-in-expr-scope, \
			ctx.cur-flags, ctx.externs, x, diag-range, of then ctx check-is-trusted
	else
		ctx add-diag diag-range, if candidates is-empty
			all-candidates = ctx get-all-candidates-as-called-decls fun-name
			:: diag-call-no-match
			type-container: ctx type-container
			fun-name: fun-name
			expected-return-type: ctx get-expected-for-diag expected
			actual-n-type-args: ctx.common-types get-n-type-args-for-diagnostic explicit-type-arg
			actual-arity: n-args
			actual-arg-types: arg-types[0 .. arg-index] to
			all-candidates: all-candidates
		else
			fun-name diag-call-multiple-matches ctx.type-container, candidates.candidates-for-diag
		()

-check-call-should-use-syntax void(ctx expr-ctx, ast call-ast)
	guard ast.style == dot or ast.style == infix
	guard kind ?= ast should-use-syntax-kind
	ctx add-diag ast.fun-name.range,
		ast.args.size diag-call-should-use-syntax kind
-should-use-syntax-kind diag-call-should-use-syntax-kind?(ast call-ast)
	match ast.fun-name name
	as force
		force
	as for-loop
		if ast second-arg-is-lambda
			for-loop
	as new
		new_
	as not
		not
	as set-subscript
		set-subscript
	as subscript
		subscript
	as with-block
		if ast second-arg-is-lambda
			with-block
	else
		()
-second-arg-is-lambda bool(a call-ast)
	guard a.args.size == 2
	match a.args[1]
	as it-scope-ast _
		true
	as lambda-ast _
		true
	else
		false

-filter-candidate-by-explicit-type-arg bool(common-types common-types, candidate candidate, opt-type-arg type?)
	guard type-arg ?= opt-type-arg else true
	n-type-params = candidate.type-args size
	args = common-types unpack-tuple-if-needed n-type-params, type-arg
	ok = args.size == n-type-params
	if ok
		for i, arg in args with-index
			candidate.type-args[i] := exact, arg
	ok

-with-param-expected type
	candidates candidates
	arg-index nat
	cb-check-arg void mut(arg-index nat, x expected)
do
	out type-and-context mut[] = allocate
	for candidate in candidates
		expected = candidate get-candidate-expected-parameter-type arg-index
		is-duplicate =
			expected.context !is-inferring and
			out exists of x
				x.context !is-inferring and x.type == expected.type
		unless is-duplicate
			out ~= expected
	arg-expected expected = out to
	cb-check-arg[arg-index, arg-expected]
	res = arg-expected inferred
	out clear
	out free
	res

-infer-candidate-type-args-from-checked-spec-sig void
	spec-candidate candidate
	spec-sig signature
	sig-types return-and-param-types
	call-inferring-type-args type-context
do
	sig-types.return-type infer-type-args-from call-inferring-type-args,
		spec-candidate.called.return-type, spec-candidate.type-context-for-candidate
	for arg-idx in 0::nat .. spec-sig.params.size
		sig-types.param-types[arg-idx] infer-type-args-from call-inferring-type-args, do spec-candidate get-candidate-expected-parameter-type arg-idx

-infer-candidate-type-args-from-explicitly-typed-argument bool
	ctx expr-ctx
	candidates candidates
	arg-index nat
	arg expr-ast
do
	if lambda ?= arg lambda-ast
		ctx infer-candidate-type-args-from-lambda-parameter candidates, arg-index, lambda.param
	else
		true
-infer-candidate-type-args-from-lambda-parameter bool
	ctx expr-ctx
	candidates candidates
	arg-index nat
	param-ast destructure-ast
do
	# TODO: this means we may do 'typeFromDestructure' twice, once here and once when checking,
	# leading to duplicate diagnostics
	if lambda-param-type  ?= ctx type-from-destructure param-ast
		if lambda-param-type is-bogus
			false
		else
			for candidate in candidates
				param-type = candidate get-candidate-expected-parameter-type arg-index
				param-type.type infer-type-args-from-lambda-parameter-type candidate.type-context-for-candidate, lambda-param-type
			true
	else
		true

# This is not the final check, but we do filter out some candidates or infer type arguments early based on specs.
-pre-check-candidate-specs bool(ctx expr-ctx, candidate candidate)
	match candidate called
	as fun-decl called
		called.specs.instantiated-sigs every of sig
			ctx infer-candidate-type-args-from-spec-sig candidate, sig.non-instantiated-sig, sig.instantiated-sig
	as called-spec-sig _
		true
-has-some-inferred bool(a candidate)
	a.type-args exists (_ ?= it)

-infer-candidate-type-args-from-spec-sig bool
	ctx expr-ctx
	call-candidate candidate
	spec-sig signature
	return-and-param-types return-and-param-types
do
	call-context = call-candidate type-context-for-candidate
	initial-filter bool mut(x candidate) = of candidate
		candidate test-candidate-for-spec-sig return-and-param-types, call-context, allow-conversions # TODO: prefer a candidate that converts exactly
	ctx.funs-in-expr-scope with-candidates spec-sig.name, spec-sig.params.size, initial-filter, of spec-candidates
		match spec-candidates size
		as 0
			false
		as 1
			spec-candidates.only infer-candidate-type-args-from-checked-spec-sig spec-sig, return-and-param-types, call-context
			true
		else
			true

check-call-after-choosing-overload called
	ctx check-ctx
	common-types common-types
	type-container type-container
	funs-in-scope funs-in-scope
	fun-flags fun-flags
	externs symbol-set
	candidate candidate
	diag-range source-range
	is-trusted bool mut()
do
	called = ctx check-call-specs common-types, type-container, funs-in-scope, diag-range, candidate
	# TODO: should we really ignore this? ------------------------------------------------------------------------------------------------------------
	_ = ctx check-called diag-range, called, fun-flags, externs, is-trusted
	called
