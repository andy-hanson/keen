import
	crow/col/mut-slice
	../../../model/model
	../../../model/source-range
	../../lang
	../../../util/util
	../allocators
	../check-ctx
	../inferring-type
	../instantiate
	../maps
	./candidates

is-shared bool(fun-specs specs, type type)
	fun-specs is-purity-always-compatible-considering-specs type, shared_

is-purity-always-compatible-considering-specs bool(fun-specs specs, type type, expected purity)
	type-purity = type purity-range
	expected is-purity-always-compatible type-purity or
	fun-specs specs-provide-purity type, expected or
	match type
	as bogus-type
		false
	as type-param-index
		false
	as struct-inst
		expected is-purity-compatible type-purity.best-case and
		type.type-args every of type-arg
			fun-specs is-purity-always-compatible-considering-specs type-arg, expected

check-call-specs called
	ctx check-ctx
	type-container type-container
	funs-in-scope funs-in-scope
	check-trusted check-trusted
	diag-range source-range
	candidate candidate
do
	check-specs-ctx check-specs-ctx = ctx, funs-in-scope, check-trusted, false
	match called = check-specs-ctx get-called-from-candidate-after-type-checks candidate, 0.dummy-trace
	as called
		if check-specs-ctx has-errors
			ctx check-call-specs-with-real-trace type-container, funs-in-scope, check-trusted, diag-range, candidate
		else
			called
	as no-match
		ctx check-call-specs-with-real-trace type-container, funs-in-scope, check-trusted, diag-range, candidate

check-spec-and-get-last-impl called(ctx check-ctx, funs-map funs-map, decl fun-decl, spec_ spec-inst)
	ctx check-spec-and-get-last-impl funs-map, decl.name-range.range, decl, decl.specs, never-trusted, spec_
check-spec-and-get-last-impl called
	ctx check-ctx
	funs-map funs-map
	diag-range source-range
	caller type-container
	caller-specs specs
	check-trusted check-trusted
	spec_ spec-inst
do
	check-specs-ctx check-specs-ctx =
		check-ctx: ctx
		funs-in-scope: caller-specs, funs-map, ctx
		check-trusted: check-trusted
		has-errors: false
	trace real-trace = ctx, caller, diag-range, ()
	match impls = check-specs-ctx check-spec-impls-inner trace, (spec_,).get-or-add-specs
	as array
		impls[end - 1]
	as no-match
		ctx add-diag diag-range, impls.diag!
		types = spec_.sig-types[end - 1]
		sig called-spec-sig = 1, spec_.decl, spec_.all-sigs[end - 1], types.return-type, types.param-types
		sig called-bogus sig.return-type, sig.param-types

-check-call-specs-with-real-trace called
	ctx check-ctx
	type-container type-container
	funs-in-scope funs-in-scope
	check-trusted check-trusted
	range source-range
	candidate candidate
do
	check-specs-ctx check-specs-ctx = ctx, funs-in-scope, check-trusted, false
	trace real-trace = ctx, type-container, range, ()
	match x = check-specs-ctx get-called-from-candidate-after-type-checks candidate, trace
	as called
		x
	as no-match
		ctx add-diag range, x.diag!
		candidate candidate-bogus-called

check-trusted interface mut
	check-trusted bool()
	context-forbids-summon bool()
	check-extern bool(a build-target)
never-trusted record(x nat) check-trusted case # TODO: I added this silly variable to prevent the interface from being 'nullable', since methods on those aren't implemented yet
never-trusted never-trusted()
	0,
check-trusted bool(_ never-trusted)
	false
context-forbids-summon bool(_ never-trusted)
	false
check-extern bool(_ never-trusted, _ build-target)
	false

-check-specs-ctx record mut
	check-ctx check-ctx
	funs-in-scope funs-in-scope
	check-trusted check-trusted
	has-errors mut bool
instantiate-ctx instantiate-ctx(a check-specs-ctx)
	a.check-ctx instantiate-ctx

-spec-result union(called, no-match)
-no-match record
	depth nat
	diag diag?

# TODO: I think this is not necessary now that I have a GC available ......................................................
-trace union(dummy-trace, real-trace) mut
-dummy-trace record mut
	depth mut nat
-real-trace record mut
	check-ctx check-ctx
	type-container type-container
	range source-range
	trace fun-decl-and-type-args mut[]

-depth nat(a trace)
	match a
	as dummy-trace
		a depth
	as real-trace
		a.trace size
-trace-push void(a trace, called fun-decl-and-type-args)
	match a
	as dummy-trace
		a.depth +:= 1
	as real-trace
		a.trace ~= called
-trace-pop void(a trace)
	match a
	as dummy-trace
		a.depth -:= 1
	as real-trace
		_ = a.trace pop!
-spec-no-match diag?(a trace, reason spec-no-match-reason)
	match a
	as dummy-trace
		()
	as real-trace
		a.type-container diag-spec-no-match reason, a.trace.to

-check-candidate spec-result
	ctx check-specs-ctx
	sig-decl signature # TODO: I think I could avoid passing this all the way down here .......................................
	sig-type return-and-param-types
	candidate candidate
	trace trace
	conv allow-implicit-conversions
do
	if candidate test-candidate-for-spec-sig sig-type, non-inferring, conv
		ctx get-called-from-candidate-after-type-checks candidate, trace
	else
		trace.depth no-match do trace spec-no-match do sig-decl spec-impl-not-found sig-type

-get-called-from-candidate-after-type-checks spec-result(ctx check-specs-ctx, candidate candidate, trace trace)
	guard candidate.type-args every !!it else
		depth: trace depth
		diag: trace spec-no-match candidate.called.fun-decl!.spec-cant-infer-type-args
	match called = candidate called
	as fun-decl
		guard trace.depth < max-spec-depth else
			depth: trace depth
			diag: trace spec-no-match spec-too-deep
		candidate-type-args type-args = candidate.type-args make-type-args it!.type #(for x in candidate type-args then x! type)::type[] to
		match impls = ctx check-spec-impls called, candidate-type-args, trace
		as array
			called instantiate-fun candidate-type-args, impls
		as no-match
			impls
	as called-spec-sig
		called

-find-spec-sig-implementation spec-result
	ctx check-specs-ctx
	sig-decl signature
	sig-type return-and-param-types
	trace trace
do
	res mut called? = ()
	# TODO: perf avoid allocating this for dummy-trace? ------------------------------------------------------------------
	multiple-matches called mut[] = ()
	deepest-no-match mut no-match? = ()
	doit void mut(x allow-implicit-conversions) = of allow-implicit-conversions
		ctx.funs-in-scope each-candidate sig-decl.name, sig-type.param-types.size, of candidate
			match checked = ctx check-candidate sig-decl, sig-type, candidate, trace, allow-implicit-conversions
			as called
				if res
					multiple-matches ~= checked
				else
					res := checked
			as no-match
				if deepest-no-match
					if deepest-no-match!.depth < checked.depth
						deepest-no-match := checked
				else
					deepest-no-match := checked
	doit[allow-conversions]
	unless multiple-matches is-empty
		# TODO:PERF can I do this in a single pass? Would need to track the quality of each result ................................
		res := ()
		deepest-no-match := ()
		multiple-matches clear
		doit[no-conversions]
		unless res
			# The multiple matches error is more useful
			assert multiple-matches is-empty
			deepest-no-match := ()
			doit[allow-conversions]

	if res
		unless multiple-matches is-empty
			ctx.has-errors := true
		match trace
		as dummy-trace
			()
		as real-trace
			unless multiple-matches is-empty
				multiple-matches ~= res!
				diag = trace.type-container diag-spec-match-multiple sig-decl.name, multiple-matches.move-to, trace.trace.to
				trace.check-ctx add-diag trace.range, diag
		res!
	elif deepest-no-match
		deepest-no-match!
	else
		trace.depth no-match do trace spec-no-match do sig-decl spec-impl-not-found sig-type

-check-builtin-spec bool(ctx check-specs-ctx, kind builtin-spec, type-args type-args)
	fun-specs = ctx.funs-in-scope fun-specs
	match kind
	as data_
		fun-specs is-purity-always-compatible-considering-specs type-args.only, data_
	as java
		ctx check-extern java
	as js
		ctx check-extern js
	as shared_
		fun-specs is-purity-always-compatible-considering-specs type-args.only, shared_
	as summon_
		# TODO: There should probably be different 'trusted' for different builtin specs. 'trusted unsafe', 'trusted summon' ----------------------------------------------
		(fun-specs is-summon and ctx.check-trusted !context-forbids-summon) or ctx.check-trusted check-trusted
	as unsafe_
		fun-specs is-unsafe or ctx.check-trusted check-trusted

-check-extern bool(ctx check-specs-ctx, kind build-target)
	ctx.funs-in-scope.fun-specs has-extern kind or ctx.check-trusted check-extern kind

| Whether {specs} tells us that {type} has purity at least {expected}
-specs-provide-purity bool(specs specs, type type, expected purity)
	specs.all-builtin exists of builtin_, type-args
		(p = builtin_.to::purity?) and type-args.only == type and expected is-purity-compatible p

-specs-result union(called[], no-match)
-check-spec-impls specs-result(ctx check-specs-ctx, called fun-decl, called-type-args type-args, trace trace)
	trace trace-push (called, called-type-args)
	specs = ctx.instantiate-ctx instantiate-specs called.specs, called-type-args
	res = ctx check-spec-impls-inner trace, specs
	trace trace-pop
	res

-check-spec-impls-inner specs-result(ctx check-specs-ctx, trace trace, specs specs)
	builtin-no-match specs-result? = specs.all-builtin first of b, t
		if ctx !check-builtin-spec b, t
			trace.depth no-match do trace spec-no-match do b spec-builtin-not-satisfied t
	builtin-no-match else
		sigs = specs instantiated-sigs
		no-match mut no-match? = ()
		result called[]? = sigs map-every of sig
			match found = ctx find-spec-sig-implementation sig.non-instantiated-sig, sig.instantiated-sig, trace
			as called
				found
			as no-match
				no-match := found
				()
		result else no-match!
