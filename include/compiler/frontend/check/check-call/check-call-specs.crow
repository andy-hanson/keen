import
	crow/col/mut-slice
	../../../model/model
	../../../model/source-range
	../../lang
	../../../util/util
	../allocators
	../check-ctx
	../expr-ctx
	../inferring-type
	../instantiate
	./candidates

is-shared bool(fun-specs specs, type type)
	is-purity-always-compatible-considering-specs fun-specs, type, shared_

is-purity-always-compatible-considering-specs bool(fun-specs specs, type type, expected purity)
	type-purity = purity-range type
	is-purity-always-compatible expected, type-purity or
	specs-provide-purity fun-specs, type, expected or
	match type
	as bogus-type
		false
	as type-param-index
		false
	as struct-inst
		is-purity-compatible expected, type-purity.best-case and
		every type.type-args, of type-arg
			is-purity-always-compatible-considering-specs fun-specs, type-arg, expected

check-call-specs called
	ctx check-ctx
	type-container type-container
	funs-in-scope funs-in-scope
	check-trusted check-trusted
	diag-range source-range
	candidate candidate
do
	check-specs-ctx check-specs-ctx = ctx, funs-in-scope, check-trusted, false
	match called = get-called-from-candidate-after-type-checks check-specs-ctx, candidate, 0.dummy-trace
	as called
		if has-errors check-specs-ctx
			check-call-specs-with-real-trace ctx, type-container, funs-in-scope, check-trusted, diag-range, candidate
		else
			called
	as no-match
		check-call-specs-with-real-trace ctx, type-container, funs-in-scope, check-trusted, diag-range, candidate

check-spec-and-get-last-impl called(ctx check-ctx, funs-map funs-map, decl fun-decl, spec_ spec-inst)
	_ never-trusted = () # TODO: I had to add this so that it would not be considered unused ........................................................
	check-spec-and-get-last-impl ctx, funs-map, decl.name-range.range, decl, decl.specs, never-trusted, spec_
check-spec-and-get-last-impl called
	ctx check-ctx
	funs-map funs-map
	diag-range source-range
	caller type-container
	caller-specs specs
	check-trusted check-trusted
	spec_ spec-inst
do
	check-specs-ctx check-specs-ctx =
		check-ctx: ctx
		funs-in-scope: caller-specs, funs-map, ctx
		check-trusted: check-trusted
		has-errors: false
	trace real-trace = ctx, caller, diag-range, ()
	match impls = check-spec-impls-inner check-specs-ctx, trace, (spec_,).get-or-add-specs
	as array
		impls[end - 1]
	as no-match
		add-diag ctx, diag-range, impls.diag!
		types = spec_.sig-types[end - 1]
		sig called-spec-sig = 1, spec_.decl, spec_.all-sigs[end - 1], types.return-type, types.param-types
		called-bogus sig, sig.return-type, sig.param-types

-check-call-specs-with-real-trace called
	ctx check-ctx
	type-container type-container
	funs-in-scope funs-in-scope
	check-trusted check-trusted
	range source-range
	candidate candidate
do
	check-specs-ctx check-specs-ctx = ctx, funs-in-scope, check-trusted, false
	trace real-trace = ctx, type-container, range, ()
	match x = get-called-from-candidate-after-type-checks check-specs-ctx, candidate, trace
	as called
		x
	as no-match
		add-diag ctx, range, x.diag!
		candidate-bogus-called candidate

-check-specs-ctx record mut
	check-ctx check-ctx
	funs-in-scope funs-in-scope
	check-trusted check-trusted
	has-errors mut bool
instantiate-ctx instantiate-ctx(a check-specs-ctx)
	a.check-ctx.instantiate-ctx

-spec-result union(called, no-match)
-no-match record
	depth nat
	diag diag?

# TODO: I think this is not necessary now that I have a GC available ......................................................
-trace union(dummy-trace, real-trace) mut
-dummy-trace record mut
	depth mut nat
-real-trace record mut
	check-ctx check-ctx
	type-container type-container
	range source-range
	trace fun-decl-and-type-args mut[]

-depth nat(a trace)
	match a
	as dummy-trace
		a.depth
	as real-trace
		a.trace.size
-trace-push void(a trace, called fun-decl-and-type-args)
	match a
	as dummy-trace
		a.depth +:= 1
	as real-trace
		a.trace ~= called
-trace-pop void(a trace)
	match a
	as dummy-trace
		a.depth -:= 1
	as real-trace
		_ = pop! a.trace
-spec-no-match diag?(a trace, reason spec-no-match-reason)
	match a
	as dummy-trace
		()
	as real-trace
		diag-spec-no-match a.type-container, reason, a.trace.to

-check-candidate spec-result
	ctx check-specs-ctx
	sig-decl signature # TODO: I think I could avoid passing this all the way down here .......................................
	sig-type return-and-param-types
	candidate candidate
	trace trace
	conv allow-implicit-conversions
do
	if test-candidate-for-spec-sig candidate, sig-type, non-inferring, conv
		get-called-from-candidate-after-type-checks ctx, candidate, trace
	else
		no-match trace.depth, spec-no-match trace, spec-impl-not-found sig-decl, sig-type

-get-called-from-candidate-after-type-checks spec-result(ctx check-specs-ctx, candidate candidate, trace trace)
	do if every candidate.type-args, !!it else
		depth: trace.depth
		diag: spec-no-match trace, candidate.called.fun-decl!.spec-cant-infer-type-args
	match called = candidate.called
	as fun-decl
		do if trace.depth < max-spec-depth else
			depth: trace.depth
			diag: spec-no-match trace, spec-too-deep
		candidate-type-args = make-type-args candidate.type-args, it!.type
		match impls = check-spec-impls ctx, called, candidate-type-args, trace
		as array
			instantiate-fun called, candidate-type-args, impls
		as no-match
			impls
	as called-spec-sig
		called

-find-spec-sig-implementation spec-result
	ctx check-specs-ctx
	sig-decl signature
	sig-type return-and-param-types
	trace trace
do
	res mut called? = ()
	# TODO: perf avoid allocating this for dummy-trace? ------------------------------------------------------------------
	multiple-matches called mut[] = ()
	deepest-no-match mut no-match? = ()
	doit void mut(x allow-implicit-conversions) = of allow-implicit-conversions
		each-candidate ctx.funs-in-scope, sig-decl.name, sig-type.param-types.size, of candidate
			match checked = check-candidate ctx, sig-decl, sig-type, candidate, trace, allow-implicit-conversions
			as called
				if res
					multiple-matches ~= checked
				else
					res := checked
			as no-match
				if deepest-no-match
					if deepest-no-match!.depth < checked.depth
						deepest-no-match := checked
				else
					deepest-no-match := checked
	doit[allow-conversions]
	unless is-empty multiple-matches
		# TODO:PERF can I do this in a single pass? Would need to track the quality of each result ................................
		res := ()
		deepest-no-match := ()
		clear multiple-matches
		doit[no-conversions]
		unless res
			# The multiple matches error is more useful
			assert is-empty multiple-matches
			deepest-no-match := ()
			doit[allow-conversions]

	if res
		unless is-empty multiple-matches
			ctx.has-errors := true
		match trace
		as dummy-trace
			()
		as real-trace
			unless is-empty multiple-matches
				multiple-matches ~= res!
				diag = diag-spec-match-multiple trace.type-container, sig-decl.name, multiple-matches.move-to, trace.trace.to
				add-diag trace.check-ctx, trace.range, diag
		res!
	elif deepest-no-match
		deepest-no-match!
	else
		no-match trace.depth, spec-no-match trace, spec-impl-not-found sig-decl, sig-type

-check-builtin-spec bool(ctx check-specs-ctx, kind builtin-spec, type-args type-args)
	fun-specs = ctx.funs-in-scope.fun-specs
	match kind
	as data_
		is-purity-always-compatible-considering-specs fun-specs, type-args.only!, data_
	as global_
		is-global fun-specs and !context-forbids-global ctx.check-trusted or check-trusted ctx.check-trusted
	as java
		check-extern ctx, java
	as js
		check-extern ctx, js
	as shared_
		is-purity-always-compatible-considering-specs fun-specs, type-args.only!, shared_
	as unsafe
		is-unsafe fun-specs or check-trusted ctx.check-trusted

-check-extern bool(ctx check-specs-ctx, kind build-target)
	has-build-target ctx.funs-in-scope.fun-specs, kind

| Whether {specs} tells us that {type} has purity at least {expected}
-specs-provide-purity bool(specs specs, type type, expected purity)
	exists specs.all-builtin, of builtin_, type-args
		(p = builtin_.to::purity?) and type-args.only! == type and is-purity-compatible expected, p

-specs-result union(called[], no-match)
-check-spec-impls specs-result(ctx check-specs-ctx, called fun-decl, called-type-args type-args, trace trace)
	trace-push trace, (called, called-type-args)
	specs = instantiate-specs ctx.instantiate-ctx, called.specs, called-type-args
	res = check-spec-impls-inner ctx, trace, specs
	trace-pop trace
	res

-check-spec-impls-inner specs-result(ctx check-specs-ctx, trace trace, specs specs)
	builtin-no-match specs-result? = first specs.all-builtin, of b, t
		if !check-builtin-spec ctx, b, t
			no-match trace.depth, spec-no-match trace, spec-builtin-not-satisfied b, t
	builtin-no-match else
		sigs = instantiated-sigs specs
		no-match mut no-match? = ()
		result called[]? = map-every sigs, of sig
			match found = find-spec-sig-implementation ctx, sig.non-instantiated-sig, sig.instantiated-sig, trace
			as called
				found
			as no-match
				no-match := found
				()
		result else no-match!
