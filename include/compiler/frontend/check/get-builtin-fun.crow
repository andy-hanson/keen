import
	../../model/model
	../../model/source-range
	./check-ctx

get-builtin-fun fun-body(ctx check-ctx, fun fun-decl)
	fun.name try-get-builtin-fun fun.return-type, (fun.params map it.type) else
		ctx add-diag fun.name-range.range, (function_ diag-builtin-unsupported fun.name)
		fun-body-bogus

-type-at type(params type[], index nat)
	if index < params.size then params[index] else bogus-type

-try-get-builtin-fun builtin-fun?(name symbol, rt type, params type[])
	arity = params size
	p0 = params type-at 0
	p1 = params type-at 1
	p2 = params type-at 2
	is-binary-float32 = arity == 2 and rt is-float32 and p0 is-float32 and p1 is-float32
	is-binary-float64 = arity == 2 and rt is-float64 and p0 is-float64 and p1 is-float64
	is-binary-float32-or-64 = is-binary-float32 or is-binary-float64
	match name
	as "+"
		if rt is-js-any and arity == 2 and p0 is-js-any and p1 is-js-any
			plus::js-fun
		else
			arity binary if is-binary-float32-or-64
				add-float
	as "-"
		arity binary if is-binary-float32-or-64
			sub-float
	as "*"
		arity binary if is-binary-float32-or-64
			mul-float
	as "=="
		guard rt is-bool
		guard arity == 2
		if p0 is-js-any and p1 is-js-any
			eq-eq-eq::js-fun
		elif p0 == p1
			arity binary if p0 is-bool or p0 is-char8 or p0 is-char32 or p0 as-integral-type or p0 is-float32-or-64
				equal-exact
	as "<"
		if rt is-bool and arity == 2 and p0 is-js-any and p1 is-js-any
			less::js-fun
	as "&"
		arity binary if rt as-integral-type
			bitwise-and
	as "~"
		arity unary if rt as-integral-type
			bitwise-not
	as "|"
		arity binary if rt as-integral-type
			bitwise-or
	as "^"
		arity binary if rt as-integral-type
			bitwise-xor
	as array-get
		if rt is-type-param-0 and p0 is-type-param-0-array-or-mut-slice and p1 is-nat64
			arity binary array-get
	as array-set
		if arity == 3 and rt is-void and p0 is-type-param-0-mut-slice and p1 is-nat64 and p2 is-type-param-0
			arity ternary array-set
	as array-size
		if rt is-nat64 and p0 is-array
			arity unary array-size
	as bits-of
		arity unary if rt is-nat32 and p0 is-float32
			bits-of-float32
		elif rt is-nat64 and p0 is-float64
			bits-of-float64
	as call
		if rt is-js-any
			call::js-fun
	as call-new
		if rt is-js-any # TODO: check more ...........................................................................................
			call-new::js-fun
	as call-property
		if rt is-js-any and arity >= 2 and p0 is-js-any and p1 is-js-any # TODO: remaining args should be js-any too --------------------------------
			call-property::js-fun
	as call-property-spread
		if arity == 3  and rt is-js-any and p0 is-js-any and p1 is-js-any and p2 is-js-any-array
			call-property-spread::js-fun
	as eval
		if rt is-js-any and arity == 1 and p0 is-js-any
			eval::js-fun
	as false
		if rt is-bool
			arity constant false
	as float-equal
		arity binary if p0 is-float32-or-64
			equal-float-ieee
	as float-less
		arity binary if p0 is-float32-or-64
			less-float-ieee
	as from-bits
		arity unary if rt is-float32 and p0 is-nat32
			float32-from-bits
		elif rt is-float64 and p0 is-nat64
			float64-from-bits
	as gc-safe-mut-slice
		arity unary if rt is-mut-slice and p0 is-nat64
			gc-safe-mut-slice
	as gc-safe-value
		arity constant builtin-fun-constant-gc-safe-value
	as get
		if rt is-type-param-0-option and p0 is-weak-ref
			arity unary weak-ref-get
	as infinity
		if rt is-float32-or-64
			arity constant infinity
	as instanceof
		if arity == 2 and rt is-bool and p0 is-js-any and p1 is-js-any
			instanceof::js-fun
	as is-empty-type
		builtin-fun-is-empty-type
	as java
		java builtin-fun-is-target
	as js
		js builtin-fun-is-target
	as is-less
		arity binary if p0 as-integral-type
			less
	as await
		if arity == 1 and rt is-js-any and p0 is-js-any
			await::js-fun
	as js-global
		if rt is-js-any and (arity == 0 or arity == 1 and p0 is-js-any)
			js-global::js-fun
	as mut-slice-size
		if rt is-nat64 and p0 is-mut-slice
			arity unary array-size
	as nan
		if rt is-float32-or-64
			arity constant trusted nan::float64
	as new
		if rt is-option-type
			arity constant builtin-fun-constant-empty-option
		elif rt is-void
			arity constant builtin-fun-constant-gc-safe-value
	as new-weak-ref
		if rt is-weak-ref
			if arity == 0
				arity constant builtin-fun-constant-gc-safe-value
			elif p0 is-type-param-0
				arity unary weak-ref-new
	as not
		if rt is-bool and p0 is-bool
			arity unary not
	as null
		if arity == 0 and rt is-js-any
			null::js-fun
	as js-import
		if arity == 1 and rt is-js-any and p0 is-js-any
			import_::js-fun
	as reference-equal
		if rt is-bool and p0 is-type-param-0 and p1 is-type-param-0
			arity binary equal-exact
	as reinterpret-cast
		if rt is-type-param-0 and p0 is-type-param-1
			arity unary reinterpret-cast
	as set-subscript
		if arity == 3 and rt is-void and p0 is-js-any and p1 is-js-any and p2 is-js-any
			set::js-fun
	as subscript
		if arity == 2 and rt is-js-any and p0 is-js-any and p1 is-js-any
			get::js-fun
		elif p0 is-lambda-type
			builtin-fun-call-lambda
	as to
		arity unary if rt is-float32
			if p0 is-float64
				to-float32-from-float64
		elif rt is-float64
			if p0 is-int64
				to-float64-from-int64
			elif p0 is-nat64
				to-float64-from-nat64
			elif p0 is-float32
				to-float64-from-float32
		elif rt is-char-or-integral and p0 is-char-or-integral
			wrap-convert-integral
	as true
		if rt is-bool
			arity constant true
	as truncate-to
		if p0 is-float64
			arity unary truncate-to-int64-from-float64
	as typeof
		if arity == 1 and rt is-js-any and p0 is-js-any
			typeof::js-fun
	as undefined
		if arity == 0 and rt is-js-any
			undefined::js-fun
	as unsafe-bit-shift-left
		if rt as-integral-type and p0 == rt and p1 == rt
			arity binary unsafe-bit-shift-left
	as unsafe-bit-shift-right
		if rt as-integral-type and p0 == rt and p1 == rt
			arity binary unsafe-bit-shift-right
	as unsafe-div
		arity binary if is-binary-float32 or is-binary-float64 or rt as-integral-type
			unsafe-div
	as unsafe-mod
		if rt is-float64
			arity binary unsafe-mod-float64
		elif rt is-nat64
			arity binary unsafe-mod-nat64
	as unsafe-to
		arity unary if rt is-char32
			if p0 is-nat32
				wrap-convert-integral
			elif p0 is-char8
				wrap-convert-integral
	as wrap-add
		arity binary if rt as-integral-type
			wrap-add
	as wrap-mul
		arity binary if rt as-integral-type
			wrap-mul
	as wrap-sub
		arity binary if rt as-integral-type
			wrap-sub
	as wrap-to
		if rt as-integral-type and p0 as-integral-type
			arity unary wrap-convert-integral
	else
		()

-constant builtin-fun-constant?(arity nat, value builtin-fun-constant)
	if arity == 0 then value
-unary builtin-unary?(arity nat, kind builtin-unary?)
	if arity == 1 then kind
-binary builtin-binary?(arity nat, kind builtin-binary?)
	if arity == 2 then kind
-ternary builtin-ternary?(arity nat, kind builtin-ternary?)
	if arity == 3 then kind

-is-float32-or-64 bool(a type)
	a is-float32 or a is-float64

-is-js-any-array bool(a type)
	(t = a array-element-type) and t is-js-any
-is-type-param-0-mut-slice bool(a type)
	(t = a mut-slice-element-type) and t is-type-param-0
-is-type-param-0-array-or-mut-slice bool(a type)
	(t = a array-or-mut-slice-element-type) and t is-type-param-0
-is-type-param-0-option bool(a type)
	(t = a try-unwrap-option-type) and t is-type-param-0
-is-type-param-0 bool(a type)
	a == (0,)::type-param-index
-is-type-param-1 bool(a type)
	a == (1,)::type-param-index
