import
	../../model/model
	../../model/source-range
	../../util/sym
	./check-ctx

get-builtin-fun fun-body(ctx check-ctx, fun fun-decl)
	params = fun.params params-array
	if res ?= fun.name get-builtin-fun-no-diag fun.return-type, params.size, (params type-at 0), (params type-at 1), (params type-at 2)
		res to
	else
		ctx add-diag fun.name-range.range, (function_ diag-builtin-unsupported fun.name)
		fun-body-bogus

-type-at type(params destructure[], index nat)
	params.size > index ? params[index].type : bogus-type

-get-builtin-fun-no-diag builtin-fun?
	name sym
	rt type
	arity nat
	p0 type
	p1 type
	p2 type
do
	is-unary-float32 = arity == 1 && rt is-float32 && p0 is-float32
	is-unary-float64 = arity == 1 && rt is-float64 && p0 is-float64
	is-binary-float32 = arity == 2 && rt is-float32 && p0 is-float32 && p1 is-float32
	is-binary-float64 = arity == 2 && rt is-float64 && p0 is-float64 && p1 is-float64

	unary-math builtin-fun? data(kind32 builtin-unary-math, kind64 builtin-unary-math) = (kind32, kind64) =>
		if is-unary-float32
			kind32.to,
		elif is-unary-float64
			kind64.to,
	binary-math builtin-fun? data(kind32 builtin-binary-math, kind64 builtin-binary-math) = (kind32, kind64) =>
		if is-binary-float32
			kind32.to,
		elif is-binary-float64
			kind64.to,

	match name matchable
	as "+"
		if rt is-js-any && arity == 2 && p0 is-js-any && p1 is-js-any
			plus::js-fun.to,
		else
			arity binary if is-binary-float32
				add-float32,
			elif is-binary-float64
				add-float64,
	as "-"
		arity binary if is-binary-float32
			sub-float32,
		elif is-binary-float64
			sub-float64,
	as "*"
		arity binary if is-binary-float32
			mul-float32,
		elif is-binary-float64
			mul-float64,
	as "=="
		guard rt is-bool
		guard arity == 2
		if p0 is-java-any && p1 is-java-any
			equal::java-fun.to,
		elif p0 is-js-any && p1 is-js-any
			eq-eq-eq::js-fun.to,
		elif p0 == p1
			arity binary if p0 is-bool
				equal-bool,
			elif p0 is-char8
				equal-char8,
			elif p0 is-char32
				equal-char32,
			elif p0 is-nat8
				equal-nat8,
			elif p0 is-nat16
				equal-nat16,
			elif p0 is-nat32
				equal-nat32,
			elif p0 is-nat64
				equal-nat64,
			elif p0 is-int8
				equal-int8,
			elif p0 is-int16
				equal-int16,
			elif p0 is-int32
				equal-int32,
			elif p0 is-int64
				equal-int64,
			elif p0 is-float32
				equal-float32,
			elif p0 is-float64
				equal-float64,
	as "<"
		if rt is-bool && arity == 2 && p0 is-js-any && p1 is-js-any
			less::js-fun.to,
	as "&&"
		if rt is-bool && p0 is-bool && p1 is-bool
			arity binary-lazy bool-and
	as "||"
		if rt is-bool && p0 is-bool && p1 is-bool
			arity binary-lazy bool-or
		elif rt is-option-type && p0 is-option-type && p1 is-option-type
			arity binary-lazy option-or
	as "??"
		if p0 is-option-type
			arity binary-lazy option-question-2
	as "&"
		arity binary if rt is-int8
			bitwise-and-int8,
		elif rt is-int16
			bitwise-and-int16,
		elif rt is-int32
			bitwise-and-int32,
		elif rt is-int64
			bitwise-and-int64,
		elif rt is-nat8
			bitwise-and-nat8,
		elif rt is-nat16
			bitwise-and-nat16,
		elif rt is-nat32
			bitwise-and-nat32,
		elif rt is-nat64
			bitwise-and-nat64,
	as "~"
		arity unary if rt is-nat8
			bitwise-not-nat8,
		elif rt is-nat16
			bitwise-not-nat16,
		elif rt is-nat32
			bitwise-not-nat32,
		elif rt is-nat64
			bitwise-not-nat64,
	as "|"
		arity binary if rt is-int8
			bitwise-or-int8,
		elif rt is-int16
			bitwise-or-int16,
		elif rt is-int32
			bitwise-or-int32,
		elif rt is-int64
			bitwise-or-int64,
		elif rt is-nat8
			bitwise-or-nat8,
		elif rt is-nat16
			bitwise-or-nat16,
		elif rt is-nat32
			bitwise-or-nat32,
		elif rt is-nat64
			bitwise-or-nat64,
	as "^"
		arity binary if rt is-int8
			bitwise-xor-int8,
		elif rt is-int16
			bitwise-xor-int16,
		elif rt is-int32
			bitwise-xor-int32,
		elif rt is-int64
			bitwise-xor-int64,
		elif rt is-nat8
			bitwise-xor-nat8,
		elif rt is-nat16
			bitwise-xor-nat16,
		elif rt is-nat32
			bitwise-xor-nat32,
		elif rt is-nat64
			bitwise-xor-nat64,
	as acos
		unary-math[acos-float32, acos-float64]
	as acosh
		unary-math[acosh-float32, acosh-float64]
	as array-size
		if rt is-nat64 && p0 is-array
			arity unary array-size
	as asin
		unary-math[asin-float32, asin-float64]
	as asinh
		unary-math[asinh-float32, asinh-float64]
	as as-mut-array
		if rt is-mut-array && p0 is-probably-mut-array-impl
			arity unary as-mut-array
	as as-mut-array-impl
		if rt is-probably-mut-array-impl && p0 is-mut-array
			arity unary as-mut-array-impl
	as as-java
		if arity == 1 && rt is-java-any && p0 is-type-param-0
			as-java-any::java-fun.to,
	as as-js
		if arity == 1 && rt is-js-any && p0 is-type-param-0
			as-js-any::js-fun.to,
	as atan
		unary-math[atan-float32, atan-float64]
	as atan2
		binary-math[atan2-float32, atan2-float64]
	as atanh
		unary-math[atanh-float32, atanh-float64]
	as bits-of
		arity unary if rt is-nat32 && p0 is-float32
			bits-of-float32,
		elif rt is-nat64 && p0 is-float64
			bits-of-float64,
	as call
		if rt is-js-any
			call::js-fun.to,
	as call-instance
		if rt is-type-param-0 && p0 is-type-param-1 && p1 is-string
			call-instance::java-fun.to,
	as call-new
		if rt is-java-any && p0 is-string
			call-new::java-fun.to,
		elif rt is-js-any
			call-new::js-fun.to,
	as call-property
		if rt is-js-any && arity >= 2 && p0 is-js-any && p1 is-string # other args are type params
			call-property::js-fun.to,
	as call-property-spread
		if arity == 3  && rt is-js-any && p0 is-js-any && p1 is-string && p2 is-type-param-0-array
			call-property-spread::js-fun.to,
	as call-static
		if rt is-type-param-0 && p0 is-string && p1 is-string
			call-static::java-fun.to,
	as call-static-varargs
		if arity == 3 && rt is-type-param-0 && p0 is-string && p1 is-string && p2 is-java-any-array
			call-static-varargs::java-fun.to,
	as cast
		if arity == 1 && rt is-type-param-0
			if p0 is-java-any
				cast::java-fun.to,
			elif p0 is-js-any
				cast::js-fun.to,
	as count-ones
		if p0 is-nat64
			arity unary count-ones-nat64
	as cos
		unary-math[cos-float32, cos-float64]
	as cosh
		unary-math[cosh-float32, cosh-float64]
	as false
		if rt is-bool
			arity constant false.to
	as fmod
		binary-math[fmod-float32, fmod-float64]
	as from-bits
		arity unary if rt is-float32 && p0 is-nat32
			float32-from-bits,
		elif rt is-float64 && p0 is-nat64
			float64-from-bits,
	as gc-safe-value
		builtin-fun-gc-safe-value,
	as get
		if rt is-type-param-0-option && p0 is-weak-ref
			arity unary weak-ref-get
	as get-static-field
		if arity == 2 && rt is-java-any && p0 is-string && p1 is-string
			get-static-field::java-fun.to,
	as global-init
		global_::builtin-fun-init.to,
	as infinity
		if rt is-float32-or-64
			arity constant infinity.to
	as instanceof
		if arity == 2 && rt is-bool && p0 is-js-any && p1 is-js-any
			instanceof::js-fun.to,
	as is-empty-type
		builtin-fun-is-empty-type,
	as is-less
		arity binary if p0 is-int8
			less-int8,
		elif p0 is-int16
			less-int16,
		elif p0 is-int32
			less-int32,
		elif p0 is-int64
			less-int64,
		elif p0 is-nat8
			less-nat8,
		elif p0 is-nat16
			less-nat16,
		elif p0 is-nat32
			less-nat32,
		elif p0 is-nat64
			less-nat64,
		elif p0 is-float32
			less-float32,
		elif p0 is-float64
			less-float64,
	as is-nan
		arity unary if rt is-bool && p0 is-float32
			is-nan-float32,
		elif rt is-bool && p0 is-float64
			is-nan-float64,
	as await
		if arity == 1 && rt is-js-any && p0 is-js-any
			await::js-fun.to,
	as java-array-get
		if arity == 2 && rt is-type-param-0 && p0 is-type-param-0-array-or-mut-slice && p1 is-nat32
			array-get::java-fun.to,
	as java-array-set
		if arity == 3 && rt is-void && p0 is-type-param-0-mut-slice && p1 is-nat32 && p2 is-type-param-0
			array-set::java-fun.to,
	as java-change-exclusion
		if arity == 1 && rt is-void && p0 is-java-exclusion
			change-exclusion::java-fun.to,
	as java-class-of
		if arity == 0 && rt is-java-any
			class-of::java-fun.to,
	as java-cur-exclusion
		if arity == 0 && rt is-java-exclusion
			cur-exclusion::java-fun.to,
	as java-new-array
		if arity == 1 && rt is-type-param-0-array-or-mut-slice && p0 is-nat32
			new-array::java-fun.to,
	as java-null
		if arity == 0 && rt is-java-any
			null::java-fun.to,
	as js-global
		if arity == 0 && rt is-js-any
			js-global::js-fun.to,
	as mark-root
		builtin-fun-mark-root,
	as mark-visit
		builtin-fun-mark-visit,
	as mut-slice-size
		if rt is-nat64 && p0 is-mut-slice
			arity unary array-size
	as nan
		if rt is-float32-or-64
			arity constant trusted nan.to
	as new
		if rt is-option-type
			if arity == 0
				builtin-fun-new-empty-option,
			elif arity == 1 && p0 is-type-param-0
				builtin-fun-new-non-empty-option,
	as new-weak-ref
		if rt is-weak-ref
			if arity == 0
				builtin-fun-gc-safe-value,
			elif p0 is-type-param-0
				arity unary weak-ref-new
	as not
		if rt is-bool && p0 is-bool
			arity unary not
	as new-void
		if rt is-void
			arity constant builtin-fun-constant-void
	as per-thread-init
		if arity == 0
			per-thread::builtin-fun-init.to,
	as unsafe-pow
		binary-math[unsafe-pow-float32, unsafe-pow-float64]
	as reference-equal
		arity binary reference-equal
	as require
		# TODO: validate the signature
		require::js-fun.to,
	as round
		unary-math[round-float32, round-float64]
	as round-down
		unary-math[round-down-float32, round-down-float64]
	as round-up
		unary-math[round-up-float32, round-up-float64]
	as set-subscript
		if arity == 3 && rt is-void && p0 is-js-any && p1 is-string && p2 is-type-param-0
			set::js-fun.to,
	as sin
		unary-math[sin-float32, sin-float64]
	as sinh
		unary-math[sinh-float32, sinh-float64]
	as static-symbols
		builtin-fun-static-symbols,
	as subscript
		if arity == 2 && rt is-js-any && p0 is-js-any && p1 is-string
			get::js-fun.to,
		elif p0 is-lambda-type
			builtin-fun-call-lambda,
	as sqrt
		unary-math[sqrt-float32, sqrt-float64]
	as tan
		unary-math[tan-float32, tan-float64]
	as tanh
		unary-math[tanh-float32, tanh-float64]
	as to
		arity unary if rt is-char8
			if p0 is-nat8
				to-char8-from-nat8,
		elif rt is-char8-array
			if p0 is-string
				to-char8-array-from-string,
		elif rt is-float32
			if p0 is-float64
				to-float32-from-float64,
		elif rt is-float64
			if p0 is-int64
				to-float64-from-int64,
			elif p0 is-nat64
				to-float64-from-nat64,
			elif p0 is-float32
				to-float64-from-float32,
		elif rt is-int64
			if p0 is-int8
				to-int64-from-int8,
			elif p0 is-int16
				to-int64-from-int16,
			elif p0 is-int32
				to-int64-from-int32,
		elif rt is-nat8
			if p0 is-char8
				to-nat8-from-char8,		
		elif rt is-nat32
			if p0 is-char32
				to-nat32-from-char32,
		elif rt is-nat64
			if p0 is-nat8
				to-nat64-from-nat8,
			elif p0 is-nat16
				to-nat64-from-nat16,
			elif p0 is-nat32
				to-nat64-from-nat32,
	as true
		if rt is-bool
			arity constant true.to
	as truncate-to
		if p0 is-float64
			arity unary truncate-to-int64-from-float64
	as trust-as-string
		if rt is-string && p0 is-char8-array
			arity unary trust-as-string
	as typeof
		if arity == 1 && rt is-string && p0 is-js-any
			typeof::js-fun.to,
	as unsafe-bit-shift-left
		if rt is-nat64
			arity binary unsafe-bit-shift-left-nat64		
	as unsafe-bit-shift-right
		if rt is-nat64
			arity binary unsafe-bit-shift-right-nat64
	as unsafe-div
		arity binary if is-binary-float32
			unsafe-div-float32,
		elif is-binary-float64
			unsafe-div-float64,
		elif rt is-int8
			unsafe-div-int8,
		elif rt is-int16
			unsafe-div-int16,
		elif rt is-int32
			unsafe-div-int32,
		elif rt is-int64
			unsafe-div-int64,
		elif rt is-nat8
			unsafe-div-nat8,
		elif rt is-nat16
			unsafe-div-nat16,
		elif rt is-nat32
			unsafe-div-nat32,
		elif rt is-nat64
			unsafe-div-nat64,
	as unsafe-log
		unary-math[unsafe-log-float32, unsafe-log-float64]
	as unsafe-mod
		if rt is-nat64
			arity binary unsafe-mod-nat64
	as unsafe-to
		arity unary if rt is-char32
			if p0 is-nat32
				unsafe-to-char32-from-nat32,
			elif p0 is-char8
				unsafe-to-char32-from-char8,
	as wrap-add
		arity binary if rt is-int8
			wrap-add-int8,
		elif rt is-int16
			wrap-add-int16,
		elif rt is-int32
			wrap-add-int32,
		elif rt is-int64
			wrap-add-int64,
		elif rt is-nat8
			wrap-add-nat8,
		elif rt is-nat16
			wrap-add-nat16,
		elif rt is-nat32
			wrap-add-nat32,
		elif rt is-nat64
			wrap-add-nat64,
	as wrap-mul
		arity binary if rt is-int8
			wrap-mul-int8,
		elif rt is-int16
			wrap-mul-int16,
		elif rt is-int32
			wrap-mul-int32,
		elif rt is-int64
			wrap-mul-int64,
		elif rt is-nat8
			wrap-mul-nat8,
		elif rt is-nat16
			wrap-mul-nat16,
		elif rt is-nat32
			wrap-mul-nat32,
		elif rt is-nat64
			wrap-mul-nat64,
	as wrap-sub
		arity binary if rt is-int8
			wrap-sub-int8,
		elif rt is-int16
			wrap-sub-int16,
		elif rt is-int32
			wrap-sub-int32,
		elif rt is-int64
			wrap-sub-int64,
		elif rt is-nat8
			wrap-sub-nat8,
		elif rt is-nat16
			wrap-sub-nat16,
		elif rt is-nat32
			wrap-sub-nat32,
		elif rt is-nat64
			wrap-sub-nat64,
	as wrap-to
		arity unary if rt is-int8
			if p0 is-int64
				wrap-to-int8-from-int64,
		elif rt is-int16
			if p0 is-int64
				wrap-to-int16-from-int64,
		elif rt is-int32
			if p0 is-int64
				wrap-to-int32-from-int64,
		elif rt is-int64
			if p0 is-nat64
				wrap-to-int64-from-nat64,
		elif rt is-nat8
			if p0 is-nat64
				wrap-to-nat8-from-nat64,
		elif rt is-nat16
			if p0 is-nat64
				wrap-to-nat16-from-nat64,
		elif rt is-nat32
			if p0 is-int32
				wrap-to-nat32-from-int32,
			elif p0 is-nat64
				wrap-to-nat32-from-nat64,
		elif rt is-nat64
			if p0 is-int64
				wrap-to-nat64-from-int64,
	else
		()

-constant builtin-fun?(arity nat, value builtin-fun-constant)
	if arity == 0
		value.to,
-unary builtin-fun?(arity nat, kind builtin-unary)
	if arity == 1
		kind.to,
-unary builtin-fun?(arity nat, kind builtin-unary?)
	if k ?= kind
		arity unary k
-binary builtin-fun?(arity nat, kind builtin-binary)
	if arity == 2
		kind.to,
-binary builtin-fun?(arity nat, kind builtin-binary?)
	if k ?= kind
		arity binary k
-binary-lazy builtin-fun?(arity nat, kind builtin-binary-lazy)
	if arity == 2
		kind.to,

-is-probably-mut-array-impl bool(a type)
	if x ?= a struct-inst
		x.decl.name == sym-mut-array-impl

-is-float32-or-64 bool(a type)
	a is-float32 || a is-float64

-is-char8-array bool(a type)
	if t ?= a array-element-type
		t is-char8
-is-java-any-array bool(a type)
	if t ?= a array-element-type
		t is-java-any
-is-type-param-0-array bool(a type)
	if t ?= a array-element-type
		t is-type-param-0
-is-type-param-0-mut-slice bool(a type)
	if t ?= a mut-slice-element-type
		t is-type-param-0
-is-type-param-0-array-or-mut-slice bool(a type)
	if t ?= a array-or-mut-slice-element-type
		t is-type-param-0
-is-type-param-0-option bool(a type)
	if t ?= a try-unwrap-option-type
		t is-type-param-0
-is-type-param-0 bool(a type)
	a == 0.type-param-index
-is-type-param-1 bool(a type)
	a == 1.type-param-index
