import
	../../model/model
	../../model/source-range
	./check-ctx

get-builtin-fun fun-body(ctx check-ctx, common-types common-types, fun fun-decl)
	params = fun.params params-array
	if res ?= fun.name get-builtin-fun-no-diag common-types, fun.return-type, params.size, (params type-at 0), (params type-at 1), (params type-at 2)
		res
	else
		ctx add-diag fun.name-range.range, (function_ diag-builtin-unsupported fun.name)
		fun-body-bogus

-type-at type(params destructure[], index nat)
	params.size > index and params[index] type else bogus-type

-get-builtin-fun-no-diag builtin-fun?
	name symbol
	common-types common-types
	rt type
	arity nat
	p0 type
	p1 type
	p2 type
do
	string = common-types string
	is-binary-float32 = arity == 2 and rt is-float32 and p0 is-float32 and p1 is-float32
	is-binary-float64 = arity == 2 and rt is-float64 and p0 is-float64 and p1 is-float64
	is-binary-float32-or-64 = is-binary-float32 or is-binary-float64
	match name
	as "+"
		if rt is-js-any and arity == 2 and p0 is-js-any and p1 is-js-any
			plus::js-fun
		else
			arity binary if is-binary-float32-or-64
				add-float
	as "-"
		arity binary if is-binary-float32-or-64
			sub-float
	as "*"
		arity binary if is-binary-float32-or-64
			mul-float
	as "=="
		guard rt is-bool
		guard arity == 2
		if p0 is-js-any and p1 is-js-any
			eq-eq-eq::js-fun
		elif p0 == p1
			arity binary if p0 is-bool or p0 is-char8 or p0 is-char32 or p0 is-integral-type or p0 is-float32-or-64
				equal-exact
	as "<"
		if rt is-bool and arity == 2 and p0 is-js-any and p1 is-js-any
			less::js-fun
	as "&"
		arity binary if rt is-integral-type
			bitwise-and
	as "~"
		arity unary if rt is-integral-type
			bitwise-not
	as "|"
		arity binary if rt is-integral-type
			bitwise-or
	as "^"
		arity binary if rt is-integral-type
			bitwise-xor
	as array-get
		if rt is-type-param-0 and p0 is-type-param-0-array-or-mut-slice and p1 is-nat64
			arity binary array-get
	as array-set
		if arity == 3 and rt is-void and p0 is-type-param-0-mut-slice and p1 is-nat64 and p2 is-type-param-0
			arity ternary array-set
	as array-size
		if rt is-nat64 and p0 is-array
			arity unary array-size
	as as-js
		if arity == 1 and rt is-js-any and p0 is-type-param-0
			as-js-any::js-fun
	as bits-of
		arity unary if rt is-nat32 and p0 is-float32
			bits-of-float32
		elif rt is-nat64 and p0 is-float64
			bits-of-float64
	as call
		if rt is-js-any
			call::js-fun
	as call-new
		if rt is-js-any # TODO: check more ...........................................................................................
			call-new::js-fun
	as call-property
		if rt is-js-any and arity >= 2 and p0 is-js-any and p1 == string # other args are type params
			call-property::js-fun
	as call-property-spread
		if arity == 3  and rt is-js-any and p0 is-js-any and p1 == string and p2 is-type-param-0-array
			call-property-spread::js-fun
	as cast
		if arity == 1 and rt is-type-param-0 and p0 is-js-any
			cast::js-fun
	as eval
		if rt is-js-any and arity == 1 and p0 == string
			eval::js-fun
	as false
		if rt is-bool
			arity constant false
	as float-equal
		arity binary if p0 is-float32-or-64
			equal-float-ieee
	as float-less
		arity binary if p0 is-float32-or-64
			less-float-ieee
	as from-bits
		arity unary if rt is-float32 and p0 is-nat32
			float32-from-bits
		elif rt is-float64 and p0 is-nat64
			float64-from-bits
	as gc-safe-mut-slice
		arity unary if rt is-mut-slice and p0 is-nat64
			gc-safe-mut-slice
	as gc-safe-value
		arity constant builtin-fun-constant-gc-safe-value
	as get
		if rt is-type-param-0-option and p0 is-weak-ref
			arity unary weak-ref-get
	as infinity
		if rt is-float32-or-64
			arity constant infinity
	as instanceof
		if arity == 2 and rt is-bool and p0 is-js-any and p1 is-js-any
			instanceof::js-fun
	as is-empty-type
		builtin-fun-is-empty-type
	as is-less
		arity binary if p0 is-integral-type
			less
	as await
		if arity == 1 and rt is-js-any and p0 is-js-any
			await::js-fun
	as js-global
		if rt is-js-any and (arity == 0 or arity == 1 and p0 == string)
			js-global::js-fun
	as mut-slice-size
		if rt is-nat64 and p0 is-mut-slice
			arity unary array-size
	as nan
		if rt is-float32-or-64
			arity constant trusted nan::float64
	as new
		if rt is-option-type
			arity constant builtin-fun-constant-empty-option
		elif rt is-void
			arity constant builtin-fun-constant-gc-safe-value
	as new-weak-ref
		if rt is-weak-ref
			if arity == 0
				arity constant builtin-fun-constant-gc-safe-value
			elif p0 is-type-param-0
				arity unary weak-ref-new
	as not
		if rt is-bool and p0 is-bool
			arity unary not
	as null
		if arity == 0 and rt is-js-any
			null::js-fun
	as js-import
		if arity == 1 and rt is-js-any and p0 == string
			import_::js-fun
	as reference-equal
		if rt is-bool and p0 is-type-param-0 and p1 is-type-param-0
			arity binary equal-exact
	as reinterpret-cast
		if rt is-type-param-0 and p0 is-type-param-1
			arity unary reinterpret-cast
	as set-subscript
		if arity == 3 and rt is-void and p0 is-js-any and p1 is-js-key common-types and p2 is-type-param-0
			set::js-fun
	as subscript
		if arity == 2 and rt is-js-any and p0 is-js-any and p1 is-js-key common-types
			get::js-fun
		elif p0 is-lambda-type
			builtin-fun-call-lambda
	as to
		arity unary if rt is-float32
			if p0 is-float64
				to-float32-from-float64
		elif rt is-float64
			if p0 is-int64
				to-float64-from-int64
			elif p0 is-nat64
				to-float64-from-nat64
			elif p0 is-float32
				to-float64-from-float32
		elif rt is-char-or-integral and p0 is-char-or-integral
			wrap-convert-integral
	as true
		if rt is-bool
			arity constant true
	as truncate-to
		if p0 is-float64
			arity unary truncate-to-int64-from-float64
	as typeof
		if arity == 1 and rt == string and p0 is-js-any
			typeof::js-fun
	as undefined
		if arity == 0 and rt is-js-any
			undefined::js-fun
	as unsafe-bit-shift-left
		if rt is-nat64
			arity binary unsafe-bit-shift-left-nat64		
	as unsafe-bit-shift-right
		if rt is-nat64
			arity binary unsafe-bit-shift-right-nat64
	as unsafe-div
		arity binary if is-binary-float32 or is-binary-float64 or rt is-integral-type
			unsafe-div
	as unsafe-mod
		if rt is-float64
			arity binary unsafe-mod-float64
		elif rt is-nat64
			arity binary unsafe-mod-nat64
	as unsafe-to
		arity unary if rt is-char32
			if p0 is-nat32
				wrap-convert-integral
			elif p0 is-char8
				wrap-convert-integral
	as wrap-add
		arity binary if rt is-integral-type
			wrap-add
	as wrap-mul
		arity binary if rt is-integral-type
			wrap-mul
	as wrap-sub
		arity binary if rt is-integral-type
			wrap-sub
	as wrap-to
		if rt is-integral-type and p0 is-integral-type
			arity unary wrap-convert-integral
	else
		()

-is-js-key bool(a type, common-types common-types)
	a == common-types.string or a is-nat64 or a is-float64

-constant builtin-fun?(arity nat, value builtin-fun-constant)
	if arity == 0
		value
-unary builtin-fun?(arity nat, kind builtin-unary?)
	guard arity == 1
	guard k ?= kind
	k
-binary builtin-fun?(arity nat, kind builtin-binary?)
	guard arity == 2
	guard k ?= kind
	k
-ternary builtin-fun?(arity nat, kind builtin-ternary?)
	guard arity == 3
	guard k ?= kind
	k

-is-float32-or-64 bool(a type)
	a is-float32 or a is-float64

-is-type-param-0-array bool(a type)
	if t ?= a array-element-type
		t is-type-param-0
-is-type-param-0-mut-slice bool(a type)
	if t ?= a mut-slice-element-type
		t is-type-param-0
-is-type-param-0-array-or-mut-slice bool(a type)
	if t ?= a array-or-mut-slice-element-type
		t is-type-param-0
-is-type-param-0-option bool(a type)
	if t ?= a try-unwrap-option-type
		t is-type-param-0
-is-type-param-0 bool(a type)
	a == (0,)::type-param-index
-is-type-param-1 bool(a type)
	a == (1,)::type-param-index
