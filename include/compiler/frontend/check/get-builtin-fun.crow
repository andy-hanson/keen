import
	../../model/model
	../../model/source-range
	./check-ctx

get-builtin-fun fun-body(ctx check-ctx, common-types common-types, fun fun-decl)
	params = fun.params params-array
	if res ?= fun.name get-builtin-fun-no-diag common-types, fun.return-type, params.size, (params type-at 0), (params type-at 1), (params type-at 2)
		res
	else
		ctx add-diag fun.name-range.range, (function_ diag-builtin-unsupported fun.name)
		fun-body-bogus

-type-at type(params destructure[], index nat)
	params.size > index ? params[index].type : bogus-type

-get-builtin-fun-no-diag builtin-fun?
	name symbol
	common-types common-types
	rt type
	arity nat
	p0 type
	p1 type
	p2 type
do
	string = common-types string
	is-binary-float32 = arity == 2 && rt is-float32 && p0 is-float32 && p1 is-float32
	is-binary-float64 = arity == 2 && rt is-float64 && p0 is-float64 && p1 is-float64
	is-binary-float32-or-64 = is-binary-float32 || is-binary-float64
	match name
	as "+"
		if rt is-js-any && arity == 2 && p0 is-js-any && p1 is-js-any
			plus::js-fun
		else
			arity binary if is-binary-float32-or-64
				add-float
	as "-"
		arity binary if is-binary-float32-or-64
			sub-float
	as "*"
		arity binary if is-binary-float32-or-64
			mul-float
	as "=="
		guard rt is-bool
		guard arity == 2
		if p0 is-java-any && p1 is-java-any
			equal::java-fun
		elif p0 is-js-any && p1 is-js-any
			eq-eq-eq::js-fun
		elif p0 == p1
			arity binary if p0 is-bool || p0 is-char8 || p0 is-char32 || p0 is-integral-type || p0 is-float32-or-64
				equal
	as "<"
		if rt is-bool && arity == 2 && p0 is-js-any && p1 is-js-any
			less::js-fun
	as "&&"
		if rt is-bool && p0 is-bool && p1 is-bool
			arity binary-lazy bool-and
	as "||"
		if rt is-bool && p0 is-bool && p1 is-bool
			arity binary-lazy bool-or
		elif rt is-option-type && p0 is-option-type && p1 is-option-type
			arity binary-lazy option-or
	as "??"
		if p0 is-option-type
			arity binary-lazy option-question-2
	as "&"
		arity binary if rt is-integral-type
			bitwise-and
	as "~"
		arity unary if rt is-integral-type
			bitwise-not
	as "|"
		arity binary if rt is-integral-type
			bitwise-or
	as "^"
		arity binary if rt is-integral-type
			bitwise-xor
	as array-size
		if rt is-nat64 && p0 is-array
			arity unary array-size
	as as-mut-array
		if rt is-mut-array && p0 is-probably-mut-array-impl
			arity unary as-mut-array
	as as-mut-array-impl
		if rt is-probably-mut-array-impl && p0 is-mut-array
			arity unary as-mut-array-impl
	as as-java
		if arity == 1 && rt is-java-any && p0 is-type-param-0
			as-java-any::java-fun
	as as-js
		if arity == 1 && rt is-js-any && p0 is-type-param-0
			as-js-any::js-fun
	as bits-of
		arity unary if rt is-nat32 && p0 is-float32
			bits-of-float32
		elif rt is-nat64 && p0 is-float64
			bits-of-float64
	as call
		if rt is-js-any
			call::js-fun
	as call-instance
		if rt is-type-param-0 && p0 is-type-param-1 && p1 == string
			call-instance::java-fun
	as call-new
		if rt is-java-any && p0 == string
			call-new::java-fun
		elif rt is-js-any
			call-new::js-fun
	as call-property
		if rt is-js-any && arity >= 2 && p0 is-js-any && p1 == string # other args are type params
			call-property::js-fun
	as call-property-spread
		if arity == 3  && rt is-js-any && p0 is-js-any && p1 == string && p2 is-type-param-0-array
			call-property-spread::js-fun
	as call-static
		if rt is-type-param-0 && p0 == string && p1 == string
			call-static::java-fun
	as call-static-varargs
		if arity == 3 && rt is-type-param-0 && p0 == string && p1 == string && p2 is-java-any-array
			call-static-varargs::java-fun
	as cast
		if arity == 1 && rt is-type-param-0
			if p0 is-java-any
				cast::java-fun
			elif p0 is-js-any
				cast::js-fun
	as eval
		if rt is-js-any && arity == 1 && p0 == string
			eval::js-fun
	as false
		if rt is-bool
			arity constant false
	as float-equal
		arity binary if p0 is-float32-or-64
			equal-float-ieee
	as float-less
		arity binary if p0 is-float32-or-64
			less-float-ieee
	as from-bits
		arity unary if rt is-float32 && p0 is-nat32
			float32-from-bits
		elif rt is-float64 && p0 is-nat64
			float64-from-bits
	as gc-safe-value
		arity constant builtin-fun-constant-gc-safe-value
	as get
		if rt is-type-param-0-option && p0 is-weak-ref
			arity unary weak-ref-get
	as get-static-field
		if arity == 2 && rt is-java-any && p0 == string && p1 == string
			get-static-field::java-fun
	as infinity
		if rt is-float32-or-64
			arity constant infinity
	as instanceof
		if arity == 2 && rt is-bool && p0 is-js-any && p1 is-js-any
			instanceof::js-fun
	as is-empty-type
		builtin-fun-is-empty-type
	as is-less
		arity binary if p0 is-integral-type
			less
	as await
		if arity == 1 && rt is-js-any && p0 is-js-any
			await::js-fun
	as java-array-get
		if arity == 2 && rt is-type-param-0 && p0 is-type-param-0-array-or-mut-slice && p1 is-nat32
			array-get::java-fun
	as java-array-set
		if arity == 3 && rt is-void && p0 is-type-param-0-mut-slice && p1 is-nat32 && p2 is-type-param-0
			array-set::java-fun
	as java-change-exclusion
		if arity == 1 && rt is-void && p0 is-java-exclusion
			change-exclusion::java-fun
	as java-class-of
		if arity == 0 && rt is-java-any
			class-of::java-fun
	as java-cur-exclusion
		if arity == 0 && rt is-java-exclusion
			cur-exclusion::java-fun
	as java-new-array
		if arity == 1 && rt is-type-param-0-array-or-mut-slice && p0 is-nat32
			new-array::java-fun
	as java-null
		if arity == 0 && rt is-java-any
			null::java-fun
	as js-global
		if rt is-js-any && (arity == 0 || (arity == 1 && p0 == string))
			js-global::js-fun
	as mut-slice-size
		if rt is-nat64 && p0 is-mut-slice
			arity unary array-size
	as nan
		if rt is-float32-or-64
			arity constant trusted nan::float64
	as new
		if rt is-option-type
			arity constant builtin-fun-constant-empty-option
		elif rt is-void
			arity constant builtin-fun-constant-gc-safe-value
	as new-weak-ref
		if rt is-weak-ref
			if arity == 0
				arity constant builtin-fun-constant-gc-safe-value
			elif p0 is-type-param-0
				arity unary weak-ref-new
	as not
		if rt is-bool && p0 is-bool
			arity unary not
	as null
		if arity == 0 && rt is-js-any
			null::js-fun
	as reference-equal
		arity binary reference-equal
	as require
		# TODO: validate the signature ------------------------------------------------------------------------------------
		require::js-fun
	as set-subscript
		if arity == 3 && rt is-void && p0 is-js-any && p1 is-js-key common-types && p2 is-type-param-0
			set::js-fun
	as subscript
		if arity == 2 && rt is-js-any && p0 is-js-any && p1 is-js-key common-types
			get::js-fun
		elif p0 is-lambda-type
			builtin-fun-call-lambda
	as to
		arity unary if rt is-float32
			if p0 is-float64
				to-float32-from-float64
		elif rt is-float64
			if p0 is-int64
				to-float64-from-int64
			elif p0 is-nat64
				to-float64-from-nat64
			elif p0 is-float32
				to-float64-from-float32
		elif rt is-char-or-integral && p0 is-char-or-integral
			wrap-convert-integral
	as true
		if rt is-bool
			arity constant true
	as truncate-to
		if p0 is-float64
			arity unary truncate-to-int64-from-float64
	as typeof
		if arity == 1 && rt == string && p0 is-js-any
			typeof::js-fun
	as undefined
		if arity == 0 && rt is-js-any
			undefined::js-fun
	as unsafe-bit-shift-left
		if rt is-nat64
			arity binary unsafe-bit-shift-left-nat64		
	as unsafe-bit-shift-right
		if rt is-nat64
			arity binary unsafe-bit-shift-right-nat64
	as unsafe-div
		arity binary if is-binary-float32 || is-binary-float64 || rt is-integral-type
			unsafe-div
	as unsafe-mod
		if rt is-float64
			arity binary unsafe-mod-float64
		elif rt is-nat64
			arity binary unsafe-mod-nat64
	as unsafe-to
		arity unary if rt is-char32
			if p0 is-nat32
				wrap-convert-integral
			elif p0 is-char8
				wrap-convert-integral
	as wrap-add
		arity binary if rt is-integral-type
			wrap-add
	as wrap-mul
		arity binary if rt is-integral-type
			wrap-mul
	as wrap-sub
		arity binary if rt is-integral-type
			wrap-sub
	as wrap-to
		if rt is-integral-type && p0 is-integral-type
			arity unary wrap-convert-integral
	else
		()

-is-js-key bool(a type, common-types common-types)
	a == common-types.string || a is-nat64 || a is-float64

-constant builtin-fun?(arity nat, value builtin-fun-constant)
	if arity == 0
		value
-unary builtin-fun?(arity nat, kind builtin-unary?)
	guard arity == 1
	guard k ?= kind
	k
-binary builtin-fun?(arity nat, kind builtin-binary?)
	guard arity == 2
	guard k ?= kind
	k
-binary-lazy builtin-fun?(arity nat, kind builtin-binary-lazy)
	if arity == 2
		kind

-is-probably-mut-array-impl bool(a type)
	if x ?= a struct-inst
		x.decl.name == "mut-array-impl"

-is-float32-or-64 bool(a type)
	a is-float32 || a is-float64

-is-java-any-array bool(a type)
	if t ?= a array-element-type
		t is-java-any
-is-type-param-0-array bool(a type)
	if t ?= a array-element-type
		t is-type-param-0
-is-type-param-0-mut-slice bool(a type)
	if t ?= a mut-slice-element-type
		t is-type-param-0
-is-type-param-0-array-or-mut-slice bool(a type)
	if t ?= a array-or-mut-slice-element-type
		t is-type-param-0
-is-type-param-0-option bool(a type)
	if t ?= a try-unwrap-option-type
		t is-type-param-0
-is-type-param-0 bool(a type)
	a == 0.type-param-index
-is-type-param-1 bool(a type)
	a == 1.type-param-index
