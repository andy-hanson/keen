import
	crow/col/mut-slice
	../../../crow/col/mut-set: hint-size
	../../../crow/parse: parse-float
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/by-name
	../../util/enum-map
	../../util/util
	./check-call/check-call
	./check-call/check-call-specs
	./check-ctx
	./allocators
	./check-util
	./expr-ctx
	./inferring-type
	./instantiate
	./maps
	./type-from-ast

check-fun-or-test-body expr
	check-ctx check-ctx
	types types-and-specs
	funs-map funs-map
	container expr-container
	return-type type
	params destructure[]
	ast expr-ast?
	source-for-empty-new call-expr-source?
do
	logged = container.fun-decl.?name == "LOGME"
	if logged
		enable-inference-log

	expr-ctx expr-ctx =
		check-ctx: check-ctx
		structs-and-aliases-map: types structs-and-aliases-map
		specs-map: types specs-map
		funs-map: funs-map
		common-types: types common-types
		container: container
	for param in params
		expr-ctx add-locals-for-destructure param
	res = if ast
		expr-ctx check-and-expect ast, return-type
	else
		expr-ctx check-empty-new source-for-empty-new!, source-for-empty-new!.name-range, return-type.expect
	expr-ctx restore-locals 0
	if logged
		disable-inference-log
	res

-check-expr expr(ctx expr-ctx, ast expr-ast, expected expected)
	match ast
	as assert-or-forbid-ast
		ctx check-assert-or-forbid ast, expected
	as assignment-ast
		ctx check-assignment ast, ast.left, ast.keyword-range, expected, of right-expected
			ctx check-expr ast.right, right-expected
	as assignment-call-ast
		ctx check-assignment-call ast, expected
	as bogus-ast
		expected bogus ast
	as call-ast
		ctx check-call ast, expected
	as call-named-ast
		ctx check-call-named ast, expected
	as do-ast
		ctx check-expr ast.body, expected
	as finally-ast
		ctx check-finally ast, expected
	as force-ast
		ctx check-force ast, expected
	as for-or-with-ast
		ctx check-for-or-with ast, expected
	as name-and-range
		ctx check-identifier ast, expected
	as if-ast
		ctx check-if ast, expected
	as interpolated-ast
		ctx check-interpolated ast, expected
	as it-ast
		ctx check-it ast, expected
	as it-scope-ast
		ctx check-it-scope ast, expected
	as lambda-ast
		ctx check-lambda ast, ast.param, ast.body, expected
	as let-ast
		ctx check-let ast, expected
	as list-ast
		ctx check-list ast, expected
	as literal-number
		ctx check-literal-number ast.range, expected
	as literal-string-ast
		ctx check-literal-string ast, expected
	as logical-ast
		ctx check-logical ast, expected
	as loop-ast
		ctx check-loop ast, expected
	as loop-break-ast
		ctx check-loop-break ast, expected
	as loop-continue-ast
		ctx check-loop-continue ast, expected
	as loop-while-or-until-ast
		ctx check-loop-while-or-until ast, expected
	as match-ast
		ctx check-match ast, expected
	as parenthesized-ast
		ctx check-expr ast.inner, expected
	as seq-ast
		ctx check-seq ast, expected
	as shared-ast
		ctx check-shared ast, expected
	as throw-ast
		ctx check-throw ast, expected
	as trusted-ast
		ctx check-trusted ast, expected
	as try-ast
		ctx check-try ast, expected
	as try-let-ast
		ctx check-try-let ast, expected
	as typed-ast
		ctx check-typed ast, expected
	as unpack-option-ast
		ctx check expected, ctx.common-types.bool, do ctx check-unpack-option ast
	as underscore-ast
		ctx add-diag ast.range, diag-underscore
		expected bogus ast.range

-check-and-infer (expr, type)(ctx expr-ctx, ast expr-ast)
	expected expected = infer
	- ctx check-expr ast, expected
	- expected inferred

-check-and-expect-or-infer (expr, type)(ctx expr-ctx, ast expr-ast, expected type?)
	if expected
		(ctx check-and-expect ast, expected), expected
	else
		ctx check-and-infer ast

-check-and-expect expr(ctx expr-ctx, ast expr-ast, expected type)
	ctx check-expr ast, expected.expect

-void-type type(ctx expr-ctx)
	ctx.common-types void

-check-if expr(ctx expr-ctx, ast if-ast, expected expected)
	if (ast.first-branch is-throw or ast.second-branch is-throw) and ast !is-else-of-parent
		ctx add-diag ast.first-keyword-range, diag-if-throw
	condition = ctx check-condition ast.condition
	is-negated = ast is-condition-negated
	empty-new-range = ast first-keyword-range
	first-branch = ctx with-extern-from-condition condition, is-negated, of
		ctx check-expr-with-condition-or-empty-new ast, (unless is-negated then condition), ast.first-branch, empty-new-range, expected
	if is-inference-log-enabled
		error log "check-if after first branch: expected is {expected debug}"
	second-branch = ctx with-extern-from-condition condition, !is-negated, of
		ctx check-expr-with-condition-or-empty-new ast, (if is-negated then condition), ast.second-branch, empty-new-range, expected
	type = expected inferred
	if ast is-guard and !ast.second-branch and type !is-void
		ctx add-diag ast.first-keyword-range, guard_::diag-required-after
	ast: ast
	condition: condition
	true-branch: if is-negated then second-branch else first-branch
	false-branch: if is-negated then first-branch else second-branch
	type: type
-is-throw bool(a expr-ast?)
	!!a.?throw-ast

-check-condition expr(ctx expr-ctx, ast expr-ast)
	if ast.skip-parentheses logical-ast
		ctx check-and-expect ast, ctx.common-types.bool
	else
		# Since anything can implicitly convert to 't?', any expression can match this.
		# But having this will guide code to prefer to exactly match 'bool' instead of converting to option.
		choices type-and-context mut[] =
			- ctx.common-types.bool, ()
			- ctx.common-types.option.instantiated-with-own-type-params, ((),)
		res = ctx check-expr ast, choices.to
		# It may implicitly convert to an option and that's what 'expected inferred' gives.
		# So use 'res type' to get the actual type.
		type = res type ctx.available-types
		if type is-bool or type is-option-type
			res
		else
			ctx add-diag ast.range, do ctx type-with-container type diag-condition-type
			ast.range bogus-expr ctx.common-types.bool

-check-unpack-option unpack-option(ctx expr-ctx, ast unpack-option-ast)
	expr, type = ctx check-and-expect-or-infer ast.option,
		if t = ctx type-from-destructure ast.destructure
			ctx.common-types.option[t as-type-args]
	destructure  = ctx check-destructure ast.destructure, type.unwrap-option-or-same, local
	ast: ast
	destructure: destructure
	option: if type is-option-type
		if option = expr local-get-expr and option.local !is-mutable and unpacked = destructure local
			ctx add-diag ast.option.range, do unpacked.name diag-unpack-option-unnecessary option.local.name
		expr
	else
		range = ast.option range
		ctx add-diag range, do ctx type-with-container type diag-unpack-option-must-be-option
		range bogus-expr ctx.common-types.option[type as-type-args]

-check-force expr(ctx expr-ctx, ast force-ast, expected expected)
	is-option mut bool = true
	arg = ctx check-with-modify-expected-option ast.arg, expected, of actual
		is-option := false
		ctx add-diag ast.keyword-range, actual.diag-option-force-non-option
	if is-option then ast force-expr arg else arg

-check-throw expr(ctx expr-ctx, ast throw-ast, expected expected)
	if type = expected try-get-inexact-non-inferring-type-including-loop
		thrown = ctx check-and-expect ast.thrown, ctx.common-types.exception
		ast throw-expr thrown, type
	else
		ctx add-diag ast.range, throw_::diag-needs-expected-type
		expected bogus ast.range

-check-trusted trusted-expr(ctx expr-ctx, ast trusted-ast, expected expected)
	ast, do ctx with-trusted ast, of
		ctx check-expr ast.inner, expected

-check-assert-or-forbid expr(ctx expr-ctx, ast assert-or-forbid-ast, expected expected)
	condition = ctx check-condition ast.condition
	is-forbid = ast is-forbid
	thrown expr? = if thrown-ast = ast thrown
		if x = thrown-ast.expr throw-ast
			ctx add-diag x.keyword-range, diag-assert-or-forbid-message-is-throw
		ctx with-extern-from-condition condition, !is-forbid, of
			ctx check-expr-with-context (if is-forbid then condition), thrown-ast.expr, ctx.common-types.exception.expect
	after = ctx with-extern-from-condition condition, is-forbid, of
		diag diag-required-after = if is-forbid then forbid_ else assert_
		ctx check-required-after ast.keyword-range, (unless is-forbid then condition), ast.after, diag, expected
	ast assert-or-forbid-expr is-forbid, condition, thrown, after

-check-assignment expr
	ctx expr-ctx
	source call-expr-source
	left expr-ast
	keyword-range source-range
	expected expected
	cb-right expr mut(x expected)
do
	match left
	as name-and-range
		ctx check-assign-identifier left, keyword-range, left.name, expected, cb-right
	as call-ast
		name symbol? = match left style
		as dot
			"set-{left.fun-name name}"
		as subscript
			"set-subscript"
		else
			()
		if name
			ctx check-call-special-cb-n source, keyword-range, name, expected, left.args.size + 1, of i, arg-expected
				if i == left.args.size
					cb-right[arg-expected]
				else
					ctx check-expr left.args[i], arg-expected
		else
			ctx add-diag left.range, diag-assignment-not-allowed
			expected bogus source.range
	else
		ctx add-diag left.range, diag-assignment-not-allowed
		expected bogus source.range

-check-assignment-call expr(ctx expr-ctx, ast assignment-call-ast, expected expected)
	ctx check-assignment ast, ast.left, ast.keyword-range, expected, of arg-expected
		ctx check-call-special ast, ast.fun-name.range, ast.fun-name.name, (ast.left, ast.right), arg-expected

-check-interpolated expr(ctx expr-ctx, ast interpolated-ast, expected expected)
	ctx check-interpolated-inner ast, ast.range, ast.template, ast.interpolated, expected

-check-interpolated-inner expr
	ctx expr-ctx
	source list-expr-source
	range source-range
	template interpolated-template-part[]
	interpolated-exprs expr-ast[]
	expected expected
do
	guard called = ctx called-for-interpolate-or-list-new range, "interpolate", expected else
		expected bogus range
	arg-element-type = called.param-types.only array-element-type!
	arg-expected = arg-element-type expect
	args expr[] = for arg-index in 0 .. template.size + interpolated-exprs.size
		if arg-index is-even
			part = template[arg-index / 2]
			range2 = if part.range is-empty then part range else part.range[0 .. 1]
			ctx check-call-special-cb1 part, range2, "interpolate-string", arg-expected, of inner2
				ctx check-literal-string-only-string part, inner2
		else
			part = interpolated-exprs[arg-index / 2]
			range2 = if part.range is-empty then part range else part.range[0 .. 1]
			ctx check-call-special source.to, range2, "interpolate-value", (part,), arg-expected
	source list-expr called, for arg in args then arg

-access-local local?(ctx expr-ctx, diag-range source-range, name symbol)
	# This traverses from the innermost lambda outwards, checking if it was already added to a closure.
	# Then we walk back inwards adding to inner lambdas.
	i mut = ctx.lambdas size
	loop
		if i == 0
			break if index = ctx.locals find-index it.name == name
				local = ctx.locals[index]
				i := ctx.lambdas size
				until i == 0 or index >= ctx.lambdas[i - 1].first-local-index
					ctx add-to-closure diag-range, ctx.lambdas[i - 1], local
					i -:= 1
				local
		else
			lambda = ctx.lambdas[i - 1]
			if local = lambda.closure find it.name == name
				for j in i .. ctx.lambdas.size
					ctx add-to-closure diag-range, ctx.lambdas[j], local
				break local
			else
				i -:= 1
				continue

-add-to-closure void(ctx expr-ctx, diag-range source-range, lambda lambda-info, local local)
	forbid lambda.closure exists it.name == local.name # RM -----------------------------------------------------------------------
	lambda.closure ~= local
	if local is-mutable
		local.closure-reference-type := ctx.common-types.reference[local.type as-type-args]
	ctx check-lambda-can-reference-local diag-range, lambda.kind, local

-check-lambda-can-reference-local void(ctx expr-ctx, diag-range source-range, lambda-kind lambda-kind, local local)
	expected-purity purity = match lambda-kind
	as data_ then data_
	as shared_ then shared_
	as mut_ then mut_
	as explicit-shared then mut_
	if expected-purity != mut_
		if local is-mutable
			ctx add-diag diag-range,
				lambda-kind diag-lambda-closure-purity local.name, mut_, ()
		elif ctx.specs !is-purity-always-compatible-considering-specs local.type, expected-purity
			ctx add-diag diag-range,
				lambda-kind diag-lambda-closure-purity local.name, local.type.purity-range.worst-case, do ctx type-with-container local.type

-check-identifier expr(ctx expr-ctx, ast name-and-range, expected expected)
	if local = ctx access-local ast.range, ast.name
		type-refinements type[] = with out in build
			for r in ctx refined-types
				if r.local == local
					out ~= r.refined-type
		expr expr, type type = if type-refinements is-empty
			(ast local-get-expr local), local.type
		else
			(ast local-get-and-refine-expr local, type-refinements), type-refinements[end - 1]
		ctx check expected, type, expr
	else
		ctx check-call-identifier ast, expected

-check-assign-identifier expr
	ctx expr-ctx
	source name-and-range
	keyword-range source-range
	left symbol
	expected expected
	cb-right expr mut(x expected)
do
	if local = ctx access-local source.range, left
		if local is-mutable
			ctx check expected, ctx.void-type,
				source local-set-expr local, cb-right[local.type.expect]
		else
			ctx add-diag source.range, local.diag-local-not-mutable
			expected bogus source.range
	else
		ctx check-call-special-cb1 source, keyword-range, "set-{left}", expected, cb-right

-as-float expr
	ctx expr-ctx
	range source-range
	float-type float-type-or-js-or-json
	inst struct-inst
	expected expected
do
	ctx check expected, inst,
		range literal-scalar-expr float-type, do (ctx.check-ctx get-text range parse-float) to

# TODO: these could use 'mebmers'? --------------------------------------------------------------------------------------------
# ALSO, it's important that this matches the order of 'integral-type' in model.crow -----------------------------------------------
-nat-types integral-type[]()
	nat8, nat16, nat32, nat64
-int-types integral-type[]()
	int8, int16, int32, int64
-integral-types integral-type[]()
	nat-types ~~ int-types
-float-types float-type-or-js-or-json[]()
	members

-check-literal-number expr(ctx expr-ctx, range source-range, expected expected)
	integrals = ctx.common-types integrals
	integrals.all.size is integral-types.size
	# TODO:PERF this array is always the same, so precompute it! ------------------------------------------------------------------------------------
	allowed-types struct-inst[] =
		-- integrals all
		-- ctx.common-types all-floats
		- ctx.common-types js-any
		-- ctx.check-ctx.json-type from-option
	if type-index = ctx find-expected-struct-for-literal range, expected, allowed-types
		number-type = allowed-types[type-index]
		if type-index < integral-types.size
			integral-type = integral-types[type-index]
			value = ctx.check-ctx check-literal-integral-value integral-type, range
			ctx check expected, number-type, do range literal-scalar-expr integral-type, value
		else
			float-type = float-types[type-index - integral-types.size]
			ctx as-float range, float-type, number-type, expected
	else
		expected bogus range

-allowed-literal-string-types struct-inst[](ctx expr-ctx, include-chars bool)
	types = ctx common-types
	-- if include-chars
		- types char8
		- types char32
	- types char8-array
	- types char32-array
	- types java-String
	- types js-any
	- types string
	- types symbol
	-- ctx.check-ctx.json-type from-option

-check-literal-string expr(ctx expr-ctx, ast literal-string-ast, expected expected)
	range = ast range
	value = ast value
	allowed-types struct-inst[] = ctx allowed-literal-string-types true
	if type-index = ctx find-expected-struct-for-literal-allow-none range, expected, allowed-types
		if type-index == 0
			range literal-scalar-expr char8, do ctx char8-literal-value range, value to
		elif type-index == 1
			range literal-scalar-expr char32, do ctx char32-literal-value range, value to
		else
			ctx check-literal-string-inner ast.range, ast.value, type-index - 2, expected
	else
		ctx check-interpolated-inner ast, ast.range, (ast.to,), (), expected
-to interpolated-template-part(a literal-string-ast)
	a.range, a.value

-check-literal-string-only-string expr(ctx expr-ctx, ast interpolated-template-part, expected expected)
	allowed-types = ctx allowed-literal-string-types false
	if type-index = ctx find-expected-struct-for-literal ast.range, expected, allowed-types
		ctx check-literal-string-inner ast.range, ast.value, type-index, expected
	else
		expected bogus ast.range

-check-literal-string-inner expr(ctx expr-ctx, range source-range, value string, type-index nat, expected expected)
	kinds string-like-type[] = char8-array, char32-array, java-String, js-any, string, symbol, json
	string-type = kinds[type-index]
	if string-type != js-any or ctx check-is-js range
		ctx check expected, (ctx allowed-literal-string-types false)[type-index],
			range literal-string-like-expr string-type, value
	else
		expected bogus range

-check-is-js bool(ctx expr-ctx, range source-range)
	res = ctx.specs has-extern js or ctx.additional-externs[js]
	unless res
		ctx add-diag range, not-extern-js
	res

-char8-literal-value char8(ctx expr-ctx, diag-range source-range, value string)
	value.to::char8[] opt-only else
		ctx add-diag diag-range, diag-char-literal-must-be-one-char
		"a"
-char32-literal-value char32(ctx expr-ctx, diag-range source-range, value string)
	value decode-as-single-unicode-char else
		ctx add-diag diag-range, diag-char-literal-must-be-one-char
		"a"
-decode-as-single-unicode-char char32?(a string)
	a.to::char32[] opt-only

| If {expr}, that is a condition that is true within this context.
-expression-context union(expr, destructure, void)
-new expression-context()
	()::void
-check-expr-with-context expr
	ctx expr-ctx
	context expression-context
	ast expr-ast
	expected expected
do
	ctx check-with-condition context, of
		ctx check-expr ast, expected
-check-with-condition[t] t(ctx expr-ctx, context expression-context, f t mut())
	restore-locals = ctx.locals size
	restore-refined-types = ctx.refined-types.size
	match context
	as expr
		for x in context condition-destructures-and-refinements
			match x
			as local
				ctx add-local x
			as local-refinement
				ctx.refined-types ~= x
	as destructure
		ctx add-locals-for-destructure context
	as void
		()
	res = f[]
	ctx restore-locals restore-locals
	while ctx.refined-types.size > restore-refined-types
		_ = ctx.refined-types pop!
	res
-add-locals-for-destructure void(ctx expr-ctx, destructure destructure)
	for x in destructure locals
		ctx add-local x

-add-local void(ctx expr-ctx, local local)
	if ctx.locals exists it.name == local.name
		ctx add-diag local.local-must-have-name-range, (param-or-local diag-duplicate-declaration local.name)
	ctx.locals ~= local
-restore-locals void(ctx expr-ctx, size nat)
	while ctx.locals.size > size
		ctx pop-local
-pop-local void(ctx expr-ctx)
	_ = ctx.locals pop!

-check-shared expr(ctx expr-ctx, ast shared-ast, expected expected)
	diag void mut(diag diag) = of diag
		ctx add-diag ast.keyword-range, diag
	diag-bogus expr mut(diag diag) = of x
		ctx add-diag ast.keyword-range, x
		expected bogus ast.range

	guard inner = ast.inner lambda-ast else diag-bogus[diag-shared-arg-is-not-lambda]
	guard et = ctx get-expected-lambda ast.range, (ctx type-from-destructure inner.param), expected else
		expected bogus ast.range
	guard et.fun-type.kind == shared_ else
		diag-bogus[ctx get-expected-for-diag expected diag-shared-not-expected]
	param = ctx check-destructure inner.param, et.instantiated-param-type, param
	res = ctx check-lambda-inner inner, param, inner.body, expected, \
		ctx.common-types.fun-structs[mut_][et.fun-type.struct-inst.type-args], \
		et.fun-type.return-type, \
		et.type-context, \
		et.fun-type.fun-struct, \
		explicit-shared

	if ctx.specs !is-shared et.instantiated-param-type
		diag[param-type diag-shared-lambda-type-is-not-shared (ctx type-with-container et.instantiated-param-type)]
	if ctx.specs !is-shared res.return-type
		diag[return-type diag-shared-lambda-type-is-not-shared (ctx type-with-container res.return-type)]

	all-shared = res.expr.lambda-expr!.closure every of x
		x !is-mutable and ctx.specs is-shared x.type
	if all-shared
		diag[diag-shared-lambda-unused]
	res expr

-check-it expr
	ctx expr-ctx
	ast it-ast
	expected expected
do
	local = ctx access-local! ast.range, "it"
	ctx check expected, local.type, do ast local-get-expr local

-check-it-scope expr
	ctx expr-ctx
	ast it-scope-ast
	expected expected
do
	if ast.inner it-ast
		ctx add-diag ast.range, diag-it-identity
		expected bogus ast
	else
		diag-range = ast range
		guard et = ctx get-expected-lambda diag-range, (), expected else
			expected bogus diag-range
		kind = et.fun-type kind
		param local = ast, et.instantiated-param-type
		ctx check-lambda-inner ast, param, ast.inner, expected, (), \
			et.fun-type.return-type, et.type-context, et.fun-type.fun-struct, kind.to-lambda-kind
		then expr

-check-lambda expr
	ctx expr-ctx
	source lambda-source
	param-ast destructure-ast
	body-ast expr-ast
	expected expected
do
	diag-range = source range
	guard et = ctx get-expected-lambda diag-range, (ctx type-from-destructure param-ast), expected else
		expected bogus diag-range
	kind = et.fun-type kind
	param = ctx check-destructure param-ast, et.instantiated-param-type, param
	ctx check-lambda-inner source, param, body-ast, expected, (), \
		et.fun-type.return-type, et.type-context, et.fun-type.fun-struct, kind.to-lambda-kind
	then expr

-to-lambda-kind lambda-kind(a fun-kind)
	match a
	as data_
		data_
	as shared_
		shared_
	as mut_
		mut_

-lambda-and-return-type record(expr expr, return-type type)
-check-lambda-inner lambda-and-return-type
	ctx expr-ctx
	source lambda-source
	param destructure
	body-ast expr-ast
	expected expected
	mut-type-for-explicit-shared struct-inst?
	# TODO: Pass these together as a type-and-context? ---------------------------------------------------------------------------
	non-instantiated-return-type type
	return-type-context type-context
	fun-struct struct-decl
	kind lambda-kind
do
	lambda-info lambda-info = kind, ctx.locals.size, ()
	# Checking the body of the lambda may fill in candidate type args
	# if the expected return type contains candidate's type params
	body-expected = non-instantiated-return-type expect-with-context return-type-context

	ctx.lambdas ~= lambda-info
	body = ctx check-expr-with-context param, body-ast, body-expected
	_ = ctx.lambdas.pop!

	# Can't just use `body-expected inferred` since that may be a narrower type than requested.
	body-type = (non-instantiated-return-type, return-type-context) try-get-inexact-non-inferring-type else
		error log "GOT A BOGUS BODY. THIS SHOULD ONLY HAPPEN IF THERE IS AN ERROR, RIGHT?" # ---------------------------------------------------
		bogus-type
	inst-fun-struct = fun-struct[(body-type, param.type) to-type-array]
	lambda lambda-expr =
		ast: source
		kind: kind
		param: param
		mut-type-for-explicit-shared: mut-type-for-explicit-shared
		body: body
		closure: lambda-info.closure move-to
		type: inst-fun-struct
	# TODO:PERF this check should never fail, so could just set inferred directly with no check ----------------------------------------
	res = ctx check expected, inst-fun-struct, lambda
	res, body-type

-check-let expr(ctx expr-ctx, ast let-ast, expected expected)
	value-expr, value-type = ctx check-and-expect-or-infer ast.value, (ctx type-from-destructure ast.destructure)
	destructure = ctx check-destructure ast.destructure, value-type, local
	then_ = ctx check-required-after ast.destructure.range, destructure, ast.then_, let, expected
	ast let-expr destructure, value-expr, then_

-check-required-after expr?
	ctx expr-ctx
	diag-range source-range
	locals expression-context
	ast expr-ast?
	kind diag-required-after
	expected expected
do
	if ast
		ctx check-expr-with-context locals, ast, expected
	else
		unless t = expected.try-get-inexact-non-inferring-type and t is-void
			ctx add-diag diag-range, kind
			expected bogus diag-range

-check-list expr(ctx expr-ctx, ast list-ast, expected expected)
	if args expr-ast[] = ast.parts map-every it.expr-ast
		ctx check-call-list-no-multi ast, ast.range, args, expected
	else
		guard called = ctx called-for-interpolate-or-list-new ast.range, "list-new", expected else
			expected bogus ast.range
		arg-array-type = called.param-types only
		ast list-expr called, for part in ast parts
			match part
			as expr-ast
				ctx check-and-expect part, arg-array-type.array-element-type!
			as list-ast-part-multi
				ctx check-and-expect part.arg, arg-array-type list-expr-part-multi

-called-for-interpolate-or-list-new called?(ctx expr-ctx, range source-range, name symbol, expected expected)
	guard result-type = expected try-get-inexact-non-inferring-type else
		ctx add-diag range, list::diag-needs-expected-type
		()
	ctx find-function-for-interpolate-or-list-new range, name, result-type

-check-logical expr(ctx expr-ctx, ast logical-ast, expected expected)
	common-types = ctx common-types
	bool =  common-types bool
	match ast kind
	as and_
		left = ctx check-condition ast.left
		right = ctx check-with-condition left, of
			ctx check-condition ast.right
		ctx check expected, bool, (ast, bool-and-bool, bool, left, right)::logical-expr
	as else_
		left = ctx check-with-modify-expected-option ast.left, expected, of actual
			ctx add-diag ast.keyword-range, actual.diag-option-else-left-non-option
		right = ctx check-expr ast.right, expected
		(ast, option-else, expected.inferred, left, right)::logical-expr
	as or_
		if expected.try-get-inexact-non-inferring-type == bool
			left = ctx check-condition ast.left
			right = ctx check-condition ast.right
			(ast, bool-or-bool, bool, left, right)::logical-expr
		else
			left = ctx check-expr ast.left, expected
			right = ctx check-expr ast.right, expected
			left-type = left type ctx.available-types
			right-type = right type ctx.available-types
			type = expected inferred
			kind = if type == bool
				bool-or-bool
			else
				if left-type !is-option-type
					ctx add-diag ast.range,
						ctx type-with-container left-type diag-option-or-left-non-option
				elif right-type !is-option-type
					ctx add-diag ast.range,
						ctx type-with-container right-type diag-option-or-right-non-option
				option-or
			(ast, kind, type, left, right)::logical-expr

| Outer expected is 't?', inner expected is 't'
-check-with-modify-expected-option expr
	ctx expr-ctx
	ast expr-ast
	outer expected
	warn-non-option void mut(actual type-with-container)
do
	ctx check-with-modify-expected outer, ctx.common-types.option[it.as-type-args], of inner
		arg = ctx check-expr ast, inner
		arg-type = arg type ctx.available-types
		un-option = arg-type try-unwrap-option-type else
			warn-non-option[ctx type-with-container arg-type]
			arg-type
		arg, un-option

-check-loop expr(ctx expr-ctx, ast loop-ast, expected expected)
	if type = expected try-get-inexact-non-inferring-type
		loop_ loop-expr = ast, type, (ast.range bogus-expr bogus-type)
		info loop-info = loop_, type, false
		loop_.body := ctx check-expr ast.body, info.to
		if info !has-break
			ctx add-diag ast.keyword-range, diag-loop-without-break
		loop_
	else
		ctx add-diag ast.range, loop_::diag-needs-expected-type
		expected bogus ast.range

-check-loop-break expr(ctx expr-ctx, ast loop-break-ast, expected expected)
	if loop_ = expected try-get-loop
		loop_.has-break := true
		value = ctx check-or-empty-new ast, ast.range, ast.value, loop_.type.expect
		ast loop-break-expr loop_.loop_, value
	else
		ctx add-diag ast.range, break_::diag-loop-break-or-continue-outside-loop
		expected bogus ast

-check-loop-continue expr(ctx expr-ctx, ast loop-continue-ast, expected expected)
	if loop_ = expected try-get-loop
		ast loop-continue-expr loop_.loop_
	else
		ctx add-diag ast.range, continue_::diag-loop-break-or-continue-outside-loop
		expected bogus ast

-check-loop-while-or-until expr(ctx expr-ctx, ast loop-while-or-until-ast, expected expected)
	condition = ctx check-condition ast.condition
	body = ctx check-expr-with-context (unless ast is-until then condition), ast.body, ctx.void-type.expect
	diag diag-required-after = if ast is-until then until_ else while_
	after = ctx check-required-after ast.keyword-range, (if ast is-until then condition), ast.after, diag, expected
	ast loop-while-or-until-expr condition, body, after

-check-match expr(ctx expr-ctx, ast match-ast, expected expected)
	matched, matched-type = ctx check-and-infer ast.matched
	local local? = if local = ast local
		local, matched-type
	if local then ctx add-local local
	# Use an arbitrary non-matchable inst as default
	inst = matched-type struct-inst else ctx.common-types void
	decl = inst decl
	not-matchable expr mut() = of
		if matched-type !is-bogus
			ctx add-diag ast.matched.range, (ctx type-with-container matched-type).diag-match-on-non-matchable
		expected bogus ast.matched
	res = match body = decl body
	as struct-body-bogus
		not-matchable[]
	as struct-body-extern-java
		not-matchable[]
	as builtin-type
		if char-type = body.to::char-type?
			ctx check-match-char ast, expected, local, matched, char-type
		elif integral = body.to::integral-type?
			ctx check-match-scalar ast, expected, local, matched, integral
		else
			not-matchable[]
	as enum_
		ctx check-match-enum ast, expected, local, matched, decl, body
	as flags_
		not-matchable[]
	as record_
		if string-like = ctx.common-types get-matchable-string-like-from-record inst
			ctx check-match-string-like ast, expected, local, matched, string-like
		else
			not-matchable[]
	as sum-type
		if body.kind can-match-sum-type
			ctx check-match-sum-type ast, expected, local, matched, inst
		else
			not-matchable[]
	if local then ctx pop-local
	res

-can-match-sum-type bool(a sum-type-kind)
	match a
	as interface_
		false
	as java-interface
		true
	as union_
		true
	as variant_
		true

-check-match-enum expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched-local local?
	matched expr
	matched-enum struct-decl
	body enum_
do
	remaining enum-or-flags-member mut-set = body.members to
	has-case-diag mut bool = false
	cases match-enum-case[] = with out in ast.cases.size build
		for case-ast in ast cases
			# TODO: NEATER (break into a function and use 'guard') ---------------------------------------------------------------------
			as-name = ctx name-from-case-member-ast case-ast.member
			name = as-name.?name ?name
			member enum-member? = if name then body.members-by-name[name]
			if member
				if remaining remove member
					out ~= member, (ctx check-expr case-ast.then_, expected)
				else
					has-case-diag := true
					ctx add-diag case-ast.name-range, name!::diag-match-case-duplicate
			else
				has-case-diag := true
				if name
					ctx add-diag case-ast.name-range,
						name diag-match-case-name-not-in-enum matched-enum

	guard !has-case-diag else expected bogus ast.range

	else_ expr? = if remaining is-empty
		if x = ast else_
			ctx add-diag x.keyword-range, diag-match-unnecessary-else
		()
	else
		ctx check-match-else-required ast, expected, of
			remaining.to diag-match-unhandled-enum-members
	ast match-enum-expr matched-local, matched, cases, else_, expected.inferred

-check-match-sum-type expr
	ctx expr-ctx
	ast match-ast
	expected expected
	local local?
	matched expr
	sum-type struct-inst
do
	matched-local = local or matched as-immut-local-get
	cases = ctx check-match-sum-type-cases matched-local, sum-type, ast.cases, expected
	body = sum-type.decl.body sum-type!
	is-union = body.kind == union_
	else_ expr? = if is-union
		if cases.size == body.listed-members.size
			if x = ast else_
				ctx add-diag x.keyword-range, diag-match-unnecessary-else
			()
		else
			ctx check-match-else-required ast, expected, of
				sum-type list-missing-union-cases body, cases diag-match-unhandled-union-case-types
	else
		ctx check-match-else-required ast, expected, of then variant_::diag-match-needs-else
	ast match-sum-type-expr local, matched, cases, else_, expected.inferred
-list-missing-union-cases struct-inst[](union_ struct-inst, body sum-type, cases match-sum-type-case[])
	for* member in body listed-members
		member-inst = member.member instantiate-struct-inst union_.type-args
		if cases !exists it.case-type == member-inst
			- member-inst

-as-immut-local-get local?(a expr)
	guard res = a as-local-get
	guard res !is-mutable
	res

-check-match-sum-type-cases match-sum-type-case[]
	ctx expr-ctx
	matched-local local?
	matched-variant struct-inst
	case-asts case-ast[]
	expected expected
do
	seen struct-inst mut-set = ()
	seen hint-size case-asts.size
	with out in case-asts.size build
		for case-ast in case-asts
			if res = ctx check-match-sum-type-case matched-local, matched-variant, case-ast.member, case-ast.then_, expected
				if seen try-add res.case-type
					out ~= res
				else
					ctx add-diag case-ast.name-range, res.case-type.decl.name::diag-match-case-duplicate

-check-catches catch_[](ctx expr-ctx, asts catch-ast[], expected expected)
	seen struct-inst mut-set = ()
	seen hint-size asts.size
	with out in asts.size build
		for index, ast in asts with-index
			guard res = ctx check-catch ast, expected, index < asts.size - 1
			if seen try-add res.caught-type
				out ~= res
			else
				ctx add-diag ast.keyword-range, res.caught-type.decl.name::diag-match-case-duplicate

-check-catch catch_?(ctx expr-ctx, ast catch-ast, expected expected, require-type bool)
	explicit-caught-type struct-inst? = if as_ = ast as_
		ctx.check-ctx inst-struct-from-ast ctx.types, as_.type-name.name, as_.type-name.range, (), ctx.type-params, yes
	if require-type and !explicit-caught-type
		ctx add-diag ast.keyword-range, diag-catch-else-must-come-last
	caught-type = explicit-caught-type else ctx.common-types exception
	destructure simple-destructure = if name = ast name
		(name, caught-type)::local
	else
		ast destructure-ignore caught-type
	destructure, do ctx check-expr-with-context destructure.to, ast.then_, expected

-check-match-sum-type-case match-sum-type-case?
	ctx expr-ctx
	matched-local local?
	matched-variant struct-inst
	member-ast case-member-ast
	then-ast expr-ast
	expected expected
do
	as-name = ctx name-from-case-member-ast member-ast
	name = as-name.?name ?name
	guard case-type = if name then ctx get-sum-type-case-from-name matched-variant, name, member-ast.name-range
	if matched-local
		ctx.refined-types ~= matched-local, case-type
	expr = ctx check-expr then-ast, expected
	if matched-local
		_ = ctx.refined-types pop!
	case-type, expr

-get-sum-type-case-from-name struct-inst?
	ctx expr-ctx
	sum-type struct-inst
	name symbol
	name-range source-range
do
	listed-members = sum-type.decl.body.sum-type! listed-members
	guard sa = ctx.check-ctx struct-or-alias-from-name name, name-range, ctx.structs-and-aliases-map, false
	match sa
	as struct-alias
		target = sa target
		is-listed = listed-members exists it.member == target
		has-membership = target.decl.sum-type-memberships exists it.sum-type == sum-type
		if is-listed or has-membership
			target
		else
			ctx add-diag name-range, (ctx type-with-container sum-type diag-match-sum-type-no-member target.decl)
			()
	as struct-decl
		# TODO: NEATER -------------------------------------------------------------------------------------------------------------------
		from-listed struct-inst? = listed-members first of x
			if x.member.decl == sa
				x.member instantiate-struct-inst sum-type.type-args
		if from-listed
			from-listed
		else
			from-membership = sa.sum-type-memberships first of x
				ctx compare-sum-types name-range, sa, x.sum-type, sum-type
			if from-membership
				match from-membership
				as struct-inst then from-membership
				as sum-type-case-bogus then ()
			else
				ctx add-diag name-range,
					ctx type-with-container sum-type diag-match-sum-type-no-member sa
				()

-instantiated-sum-type-case-or-bogus union(struct-inst, sum-type-case-bogus)
-sum-type-case-bogus record

| Returns instantiated case type if the declared sum-type matches the actual
-compare-sum-types instantiated-sum-type-case-or-bogus?
	ctx expr-ctx
	range source-range
	case_ struct-decl
	declared-sum-type struct-inst
	actual-sum-type struct-inst
do
	guard declared-sum-type.decl == actual-sum-type.decl
	case_.n-type-params with-type-context-for of inferring-context
		inferring-declared-sum-type type-and-context = declared-sum-type, inferring-context
		guard inferring-declared-sum-type match-types actual-sum-type.non-inferring, exact
		if inferred-types = inferring-context map-every-type-args it.?type
			case_[inferred-types]
		else
			ctx add-diag range, case_.diag-match-sum-type-cant-infer-type-args
			sum-type-case-bogus

-check-match-char expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched-local local?
	matched expr
	char-type char-type
do
	seen scalar-value mut-set = ()
	seen hint-size ast.cases.size
	cases match-scalar-case[] = with out in ast.cases.size build
		for case-ast in ast cases
			guard string-value = ctx string-from-case-ast case-ast.member
			value scalar-value = match char-type
			as char8
				ctx char8-literal-value case-ast.name-range, string-value to
			as char32
				ctx char32-literal-value case-ast.name-range, string-value to
			if seen try-add value
				out ~= value, do ctx check-expr case-ast.then_, expected
			else
				ctx add-diag case-ast.name-range, string-value::diag-match-case-duplicate
	else_ = ctx check-match-else-required ast, expected, of then integral::diag-match-needs-else
	ast match-scalar-expr char-type, matched-local, matched, cases, else_, expected.inferred

-check-match-scalar expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched-local local?
	matched expr
	integral-type integral-type
do
	seen scalar-value mut-set = ()
	seen hint-size ast.cases.size
	cases match-scalar-case[] = with out in build
		for case-ast in ast cases
			value scalar-value? = match x = case-ast member
			as as-name-ast
				ctx add-diag x.name.range, numeric::diag-match-case-for-type
				()
			as literal-number
				ctx.check-ctx check-literal-integral-value integral-type, x.range
			as literal-string-ast
				ctx add-diag x.range, numeric::diag-match-case-for-type
				()
			as as-bogus-ast
				()
			if value
				if seen try-add value
					out ~= value, do ctx check-expr case-ast.then_, expected
				else
					ctx add-diag case-ast.name-range, if integral-type is-signed
						value.to::int64::diag-match-case-duplicate
					else
						value.to::nat64::diag-match-case-duplicate
	else_ = ctx check-match-else-required ast, expected, of then integral::diag-match-needs-else
	ast match-scalar-expr integral-type, matched-local, matched, cases, else_, expected.inferred

-get-matchable-string-like-from-record string-like-type?(common-types common-types, inst struct-inst)
	if inst == common-types.char32-array
		char32-array
	elif inst == common-types.char8-array
		char8-array
	elif inst == common-types.symbol
		symbol
	elif inst == common-types.string
		string

-check-match-string-like expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched-local local?
	matched expr
	string-type string-like-type
do
	guard spec_ = ctx.check-ctx get-spec-from-common-module ctx.specs-map, ast.keyword-range, "equal", compare else
		expected bogus ast.range

	matched-type = matched type ctx.available-types struct-inst!
	equals = ctx.check-ctx check-spec-and-get-last-impl ctx.funs-map, ast.keyword-range, ctx.type-container, \
		ctx.specs, ctx.expr-ctx-check-trusted, \
		(ctx.instantiate-ctx instantiate-spec spec_, matched-type)
	seen string mut-set = ()
	cases match-string-like-case[] = with out in build
		for case-ast in ast cases
			if value = ctx string-from-case-ast case-ast.member
				if seen try-add value
					out ~= value, do ctx check-expr case-ast.then_, expected
				else
					ctx add-diag case-ast.name-range, value::diag-match-case-duplicate
	else_ = ctx check-match-else-required ast, expected, of then string-like::diag-match-needs-else
	ast match-string-like-expr string-type, matched-local, matched, equals, cases, else_, expected.inferred

-check-match-else-required expr
	ctx expr-ctx
	ast match-ast
	expected expected
	cb-diag diag mut()
do
	if else_ = ast else_
		ctx check-expr else_.expr, expected
	else
		ctx add-diag ast.keyword-range, cb-diag[]
		expected bogus ast.range

# TODO: use a with-block ---------------------------------------------------------------------------------------------------------
-with-extern-from-condition[out] out(ctx expr-ctx, condition expr, is-negated bool, cb out mut())
	guard extern_ = condition as-extern else cb[]
	guard !(is-negated xor extern_.is-negated) else cb[]
	original-externs = ctx additional-externs
	ctx.additional-externs |:= extern_ required-externs
	res = cb[]
	ctx.additional-externs := original-externs
	res

-check-expr-with-condition-or-empty-new expr
	ctx expr-ctx
	parent call-expr-source
	condition expression-context
	ast expr-ast?
	empty-new-range source-range
	expected expected
do
	if ast
		ctx check-expr-with-context condition, ast, expected
	else
		ctx check-empty-new parent, empty-new-range, expected
-check-empty-new expr
	ctx expr-ctx
	parent call-expr-source
	range source-range
	expected expected
do
	ctx check-call-list-no-multi parent, range, (), expected
-check-or-empty-new expr
	ctx expr-ctx
	parent call-expr-source
	empty-new-range source-range
	ast expr-ast?
	expected expected
do
	if ast
		ctx check-expr ast, expected
	else
		ctx check-empty-new parent, empty-new-range, expected

-string-from-case-ast string?(ctx expr-ctx, ast case-member-ast)
	match ast
	as as-name-ast
		ast.name.name to
	as literal-number
		ctx add-diag ast.range, string-like::diag-match-case-for-type
		()
	as literal-string-ast
		ast value
	as as-bogus-ast
		()

-name-from-case-member-ast as-name-ast?(ctx expr-ctx, ast case-member-ast)
	res as-name-ast? = ast as-name-ast
	unless res
		ctx add-diag ast.name-range, enum-or-union::diag-match-case-for-type
	res

-check-seq expr(ctx expr-ctx, ast seq-ast, expected expected)
	first = ctx check-and-expect ast.first, ctx.void-type
	then_ = ctx check-expr ast.then_, expected
	first seq-expr then_

-check-finally expr(ctx expr-ctx, ast finally-ast, expected expected)
	if expected try-get-loop
		ctx add-diag ast.finally-keyword-range, finally_::diag-loop-disallowed-body
		expected bogus ast.range
	else
		right = ctx check-and-expect ast.right, ctx.void-type
		below = ctx check-expr ast.below, expected
		ast finally-expr right, below

-check-try expr(ctx expr-ctx, ast try-ast, expected expected)
	if expected try-get-loop
		ctx add-diag ast.try-keyword-range, try_::diag-loop-disallowed-body
		expected bogus ast.range
	else
		body = ctx check-expr ast.tried, expected
		catches = ctx check-catches ast.catches, expected
		ast try-expr body, catches, expected.inferred

-check-try-let expr(ctx expr-ctx, ast try-let-ast, expected expected)
	value-expr, value-type = ctx check-and-expect-or-infer ast.value, (ctx type-from-destructure ast.destructure)
	destructure = ctx check-destructure ast.destructure, value-type, local
	catch_ = ctx check-catch! ast.catch_, expected, false
	then_ = ctx check-required-after ast.try-keyword-range, destructure, ast.after, try-let, expected
	ast try-let-expr destructure, value-expr, catch_, then_, expected.inferred

-check-typed expr(ctx expr-ctx, ast typed-ast, expected expected)
	type = ctx type-from-ast ast.type
	guard type !is-bogus else expected bogus ast.range
	expr = ctx check-or-empty-new ast, ast.keyword-range, ast.expr, type.expect
	ctx check expected, type, do ast typed-expr expr, type
