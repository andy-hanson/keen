import
	crow/col/mut-slice
	crow/js
	java/lang/Double
	../../../crow/col/mut-set: hint-size
	../../model/ast
	../../model/integral-values
	../../model/model
	../../model/source-range
	../../util/by-name
	../../util/enum-map
	../../util/util
	./check-call/check-call
	./check-call/check-call-specs
	./check-ctx
	./allocators
	./check-util
	./expr-ctx
	./inferring-type
	./instantiate
	./maps
	./type-from-ast

check-fun-or-test-body expr
	check-ctx check-ctx
	types types-and-specs
	funs-map funs-map
	container expr-container
	return-type type
	params params
	flags_ fun-flags
	externs symbol-set
	ast expr-ast
do
	# ---------------------------------------------------------------------------------------------------------------------------------------------------------
	logit = match container
	as fun-decl x
		x.name == "LOGME"
	as test_ _
		false
	as var-decl _
		false
	if logit
		enable-inference-log

	expr-ctx expr-ctx =
		check-ctx: check-ctx
		structs-and-aliases-map: types structs-and-aliases-map
		specs-map: types specs-map
		funs-map: funs-map
		common-types: types common-types
		container: container
		flags_: flags_
		externs: externs
	for param : params params-array
		expr-ctx add-locals-for-destructure param
	res = expr-ctx check-and-expect ast, return-type
	expr-ctx restore-locals 0
	if logit
		disable-inference-log
	res

-check-expr expr(ctx expr-ctx, ast expr-ast, expected expected)
	match ast
	as arrow-access-ast x
		ctx check-arrow-access x, expected
	as assert-or-forbid-ast x
		ctx check-assert-or-forbid x, expected
	as assignment-ast x
		ctx check-assignment x, x.left, x.keyword-range, expected, right-expected =>
			ctx check-expr x.right, right-expected
	as assignment-call-ast x
		ctx check-assignment-call x, expected
	as bogus-ast _
		expected bogus ast
	as call-ast x
		ctx check-call x, expected
	as call-named-ast x
		ctx check-call-named x, expected
	as do-ast x
		ctx check-expr x.body, expected
	as empty-ast x
		ctx check-empty-new x, ast.range, expected
	as extern-ast x
		ctx check-extern x, expected
	as finally-ast x
		ctx check-finally x, expected
	as for-ast x
		ctx check-for x, expected
	as name-and-range x
		ctx check-identifier x, expected
	as if-ast x
		ctx check-if x, expected
	as interpolated-ast x
		ctx check-interpolated x, expected
	as lambda-ast x
		ctx check-lambda x, x.param, x.body, expected
	as let-ast x
		ctx check-let x, expected
	as list-ast x
		ctx check-list x, expected
	as literal-float-and-range x
		ctx check-literal-float x, expected
	as literal-integral-and-range x
		ctx check-literal-integral x, expected
	as literal-string-ast x
		ctx check-literal-string x, expected
	as loop-ast x
		ctx check-loop x, expected
	as loop-break-ast x
		ctx check-loop-break x, expected
	as loop-continue-ast x
		ctx check-loop-continue x, expected	
	as loop-while-or-until-ast x
		ctx check-loop-while-or-until x, expected
	as match-ast x
		ctx check-match x, expected
	as seq-ast x
		ctx check-seq x, expected
	as shared-ast x
		ctx check-shared x, expected
	as throw-ast x
		ctx check-throw x, expected
	as trusted-ast x
		ctx check-trusted x, expected
	as try-ast x
		ctx check-try x, expected
	as try-let-ast x
		ctx check-try-let x, expected
	as typed-ast x
		ctx check-typed x, expected
	as with-ast x
		ctx check-with x, expected

-check-and-infer (expr, type)(ctx expr-ctx, ast expr-ast)
	expected expected = infer
	expr = ctx check-expr ast, expected
	expr, expected.inferred

-check-and-expect-or-infer (expr, type)(ctx expr-ctx, ast expr-ast, opt-expected type?)
	if e ?= opt-expected
		(ctx check-and-expect ast, e), e
	else
		ctx check-and-infer ast

-check-and-expect expr(ctx expr-ctx, ast expr-ast, expected type)
	ctx check-expr ast, expected.expect

-void-type type(ctx expr-ctx)
	ctx.common-types void

-check-arrow-access expr(ctx expr-ctx, ast arrow-access-ast, expected expected)
	ctx check-call-special-cb1 ast, ast.arrow-range, ast.name.name, expected, arg-expected =>
		ctx check-call-special ast, ast.arrow-range, "*", (ast.left,), arg-expected

-check-if expr(ctx expr-ctx, ast if-ast, expected expected)
	if is-inference-log-enabled
		error log "top of check-if: expected is {expected debug}"
	if (ast.first-branch is-throw || ast.second-branch is-throw) && ast !is-else-of-parent
		ctx add-diag ast.first-keyword-range, diag-if-throw
	condition = ctx check-condition ast.condition
	destructure = condition opt-destructure
	is-negated = ast is-condition-negated
	empty-new-range = ast first-keyword-range
	first-branch = ctx with-extern-from-condition condition, is-negated, () =>
		ctx check-expr-with-opt-destructure-or-empty-new ast, \
			(!is-negated ? destructure), ast.first-branch, empty-new-range, expected
	if is-inference-log-enabled
		error log "check-if after first branch: expected is {expected debug}"
	second-branch = ctx with-extern-from-condition condition, !is-negated, () =>
		ctx check-expr-with-opt-destructure-or-empty-new ast, \
			(is-negated ? destructure), ast.second-branch, empty-new-range, expected
	ast if-expr condition, (is-negated ? second-branch : first-branch), (is-negated ? first-branch : second-branch), expected.inferred
-is-throw bool(a expr-ast?)
	a?.throw-ast !is-empty

-opt-destructure destructure?(a condition)
	match a
	as expr _
		()
	as unpack-option x
		x destructure

-check-condition condition(ctx expr-ctx, ast condition-ast)
	match ast
	as expr-ast x
		ctx check-and-expect x, ctx.common-types.bool
	as unpack-option-ast x
		ctx check-unpack-option x
-check-unpack-option unpack-option(ctx expr-ctx, cond-ast unpack-option-ast)
	expr, type = ctx check-and-infer cond-ast.option
	destructure = ctx check-destructure cond-ast.destructure, (type.try-unwrap-option-type ?? type), local
	option-expr = if type is-option-type
		expr
	else
		range = cond-ast.option range
		ctx add-diag range, do ctx type-with-container type diag-unpack-option-must-be-option
		range bogus-expr ctx.common-types.option[type]
	destructure, option-expr

-check-throw expr(ctx expr-ctx, ast throw-ast, expected expected)
	if type ?= expected try-get-inexact-non-inferring-type-including-loop
		thrown = ctx check-and-expect ast.thrown, ctx.common-types.exception
		ast throw-expr thrown, type
	else
		ctx add-diag ast.range, throw_::diag-needs-expected-type
		expected bogus ast.range

-check-trusted expr(ctx expr-ctx, ast trusted-ast, expected expected)
	inner = ctx with-trusted ast, () =>
		ctx check-expr ast.inner, expected
	ast trusted-expr inner

-check-extern expr(ctx expr-ctx, ast extern-ast, expected expected)
	unless ctx check-can-do-unsafe
		ctx add-diag ast.range, diag-extern-is-unsafe
	ok mut = true
	names symbol-set = for name-ast : ast names
		if name ?= ctx.check-ctx check-extern-name name-ast, ctx.externs
			name
		else
			ok := false
			"bogus"
	if ok
		ctx check expected, ctx.common-types.bool, (ast extern-expr names)
	else
		expected bogus ast.range

-check-assert-or-forbid expr(ctx expr-ctx, ast assert-or-forbid-ast, expected expected)
	condition = ctx check-condition ast.condition
	destructure = condition opt-destructure
	is-forbid = ast is-forbid
	thrown expr? = if thrown-ast ?= ast thrown
		if x ?= thrown-ast.expr throw-ast
			ctx add-diag x.keyword-range, diag-assert-or-forbid-message-is-throw
		ctx with-extern-from-condition condition, !is-forbid, () =>
			ctx check-expr-with-opt-destructure (is-forbid ? destructure), thrown-ast.expr, ctx.common-types.exception.expect	
	after = ctx with-extern-from-condition condition, is-forbid, () =>
		ctx check-expr-with-opt-destructure (!is-forbid ? destructure), ast.after, expected
	ast assert-or-forbid-expr is-forbid, condition, thrown, after

-check-assignment expr
	ctx expr-ctx
	source call-expr-source
	left expr-ast
	keyword-range source-range
	expected expected
	cb-right expr mut(x expected)
do
	match left
	as name-and-range x
		ctx check-assign-identifier x, keyword-range, x.name, expected, cb-right
	as call-ast left-call
		name symbol? = match left-call style
		as dot
			"set-{left-call.fun-name name}"
		as prefix-operator
			left-call.fun-name.name == "*" ? "set-deref"
		as subscript
			"set-subscript"
		else
			()
		if x ?= name
			ctx check-call-special-cb-n source, keyword-range, x, expected, left-call.args.size + 1, (i, arg-expected) =>
				if i == left-call.args.size
					cb-right[arg-expected]
				else
					ctx check-expr left-call.args[i], arg-expected
		else
			ctx add-diag left.range, diag-assignment-not-allowed
			expected bogus source.range
	as arrow-access-ast left-arrow
		check-arg expr mut(x expected) = arg-expected =>
			ctx check-expr left-arrow.left, arg-expected
		ctx check-call-special-cb2 source, keyword-range, "set-deref-{left-arrow.name name}", expected, check-arg, cb-right, _ => true
	else
		ctx add-diag left.range, diag-assignment-not-allowed
		expected bogus source.range

-check-assignment-call expr(ctx expr-ctx, ast assignment-call-ast, expected expected)
	ctx check-assignment ast, ast.left, ast.keyword-range, expected, arg-expected =>
		ctx check-call-special ast, ast.fun-name.range, ast.fun-name.name, (ast.left, ast.right), arg-expected

-check-empty-new expr(ctx expr-ctx, source call-expr-source, range source-range, expected expected)
	ctx check-call-special source, range, "new", (), expected

-check-interpolated expr(ctx expr-ctx, ast interpolated-ast, expected expected)
	ctx check-call-special-cb-n ast, ast.range[0 .. 1], "interpolate", expected, ast.parts.size, (i, arg-expected) =>
		match ast.parts[i]
		as literal-string-ast x
			ctx check-literal-string x, arg-expected
		else part
			ctx check-call-special ast, part.range, "show", (part,), arg-expected

-access-local local?(ctx expr-ctx, diag-range source-range, name symbol)
	# This traverses from the innermost lambda outwards, checking if it was already added to a closure.
	# Then we walk back inwards adding to inner lambdas.
	i mut = ctx.lambdas size
	loop
		if i == 0
			break if index ?= ctx.locals find-index x => x.name == name
				local = ctx.locals[index]
				i := ctx.lambdas size
				until i == 0 || index >= ctx.lambdas[i - 1].first-local-index
					ctx add-to-closure diag-range, ctx.lambdas[i - 1], local
					i -:= 1
				local
		else
			lambda = ctx.lambdas[i - 1]
			if local ?= lambda.closure find x => x.name == name
				for j : i .. ctx.lambdas.size
					ctx add-to-closure diag-range, ctx.lambdas[j], local
				break local
			else
				i -:= 1
				continue

-add-to-closure void(ctx expr-ctx, diag-range source-range, lambda lambda-info, local local)
	forbid lambda.closure exists x => x.name == local.name # RM -----------------------------------------------------------------------
	lambda.closure ~= local
	local.is-used-in-closure := true
	ctx check-lambda-can-reference-local diag-range, lambda.kind, local

-check-lambda-can-reference-local void(ctx expr-ctx, diag-range source-range, lambda-kind lambda-kind, local local)
	expected-purity purity = match lambda-kind
	as data_
		data_
	as shared_
		shared_
	as mut_
		mut_
	as explicit-shared
		mut_
	if expected-purity != mut_
		if local.mutability != immut
			ctx add-diag diag-range, (lambda-kind diag-lambda-closure-purity local.name, mut_, ())
		elif ctx.specs !is-purity-always-compatible-considering-specs local.type, expected-purity
			ctx add-diag diag-range,
				lambda-kind diag-lambda-closure-purity local.name, local.type.purity-range.worst-case, do ctx type-with-container local.type

-check-identifier expr(ctx expr-ctx, ast name-and-range, expected expected)
	if local ?= ctx access-local ast.range, ast.name
		local.is-read := true
		ctx check expected, local.type, (ast.range local-get-expr local)
	else
		ctx check-call-identifier ast, expected

-check-assign-identifier expr
	ctx expr-ctx
	source name-and-range
	keyword-range source-range
	left symbol
	expected expected
	cb-right expr mut(x expected)
do
	if local ?= ctx access-local source.range, left
		match local mutability
		as immut
			ctx add-diag source.range, local.diag-local-not-mutable
			expected bogus source.range
		as mut_
			local.is-written := true
			value = cb-right[local.type.expect]
			ctx check expected, ctx.void-type, (source.range local-set-expr local, value)
	else
		ctx check-call-special-cb1 source, keyword-range, "set-{left}", expected, cb-right

-check-literal-float expr(ctx expr-ctx, ast literal-float-and-range, expected expected)
	allowed-types struct-inst[] = ctx.common-types.float32, ctx.common-types.float64
	if index ?= ctx find-expected-struct-for-literal ast.range, expected, allowed-types
		ctx as-float ast.range, float-types[index], allowed-types[index], ast.literal.value, expected
	else
		expected bogus ast.range

-as-float expr
	ctx expr-ctx
	range source-range
	float-type float-type
	inst struct-inst
	value high-precision-float?
	expected expected
do
	if value is-empty
		ctx add-diag range, float-type.diag-literal-float-accuracy
	ctx check expected, inst, do range literal-float-expr float-type, (value ?? ()).to

-to float(a high-precision-float)
	s string = "{a sign}{a unsigned-value ?? 0}e{a exponent}"
	trusted
	res float = if extern js
		"Number".js-global call s.to-js-string cast
	elif extern java
		s.to-java-string parseDouble
	else
		throw todo
	forbid res == nan
	res

# TODO: these could use 'mebmers'? --------------------------------------------------------------------------------------------
# ALSO, it's important that this matches the order of 'integral-type' in model.crow -----------------------------------------------
-nat-types integral-type[]()
	nat8, nat16, nat32, nat64
-int-types integral-type[]()
	int8, int16, int32, int64
integral-types integral-type[]()
	nat-types ~~ int-types
-float-types float-type[]()
	float32, float64

-check-literal-integral expr(ctx expr-ctx, ast literal-integral-and-range, expected expected)
	integrals = ctx.common-types integrals
	allowed-types struct-inst[] = integrals.all ~~ ctx.common-types.all-floats
	if type-index ?= ctx find-expected-struct-for-literal ast.range, expected, allowed-types
		number-type = allowed-types[type-index]
		if type-index < integral-types.size
			integral-type = integral-types[type-index]
			value = ctx.check-ctx check-literal-integral-value integral-type, ast
			ctx check expected, number-type, do ast.range literal-integral-expr integral-type, value
		else
			float-type = float-types[type-index - integral-types.size]
			float-literal high-precision-float? = if u ?= ast.literal unsigned-value
				ast.literal.sign, u, 0
			ctx as-float ast.range, float-type, number-type, float-literal, expected
	else
		expected bogus ast.range

-check-literal-string expr(ctx expr-ctx, ast literal-string-ast, expected expected)
	range = ast range
	value = ast value
	types = ctx common-types
	allowed-types struct-inst[] = types.char8, types.char32, types.char8-array, types.char32-array, types.js-any, types.string, types.symbol
	# First 2 kinds won't be used
	kinds string-like-type[] = string, string, char8-array, char32-array, js-any, string, symbol
	guard type-index ?= ctx find-expected-struct-for-literal range, expected, allowed-types : expected bogus range
	expr expr? = if type-index == 0
		range literal-integral-expr char8, ((ctx char8-literal-value range, value).to,)
	elif type-index == 1
		range literal-integral-expr char32, ((ctx char32-literal-value range, value).to,)
	else
		check-no-nul string mut(diag diag-string-literal-invalid) = diag =>
			if index ?= value.to::char8[] index-of "\0"
				ctx add-diag range, diag
				(value.to::char8[])[0 .. index] to
			else
				value
		string-type = kinds[type-index]
		fixed-value string? = match string-type
		as char8-array
			value
		as char32-array
			value
		as string
			check-no-nul[string-contains-nul]
		as symbol
			check-no-nul[symbol-contains-nul]
		as js-any
			if "js"::symbol in ctx.externs
				value
			else
				ctx add-diag range, not-extern-js
				()
		if x ?= fixed-value
			range literal-string-like-expr string-type, x
	if x ?= expr
		ctx check expected, allowed-types[type-index], x
	else
		expected bogus range

-char8-literal-value char8(ctx expr-ctx, diag-range source-range, value string)
	char8s = value.to::char8[]
	char8s opt-only ??
		ctx add-diag diag-range, diag-char-literal-must-be-one-char
		"a"
-char32-literal-value char32(ctx expr-ctx, diag-range source-range, value string)
	value.decode-as-single-unicode-char ??
		ctx add-diag diag-range, diag-char-literal-must-be-one-char
		"a"
-decode-as-single-unicode-char char32?(a string)
	a.to::char32[] opt-only

-check-expr-with-opt-destructure expr
	ctx expr-ctx
	destructure destructure?
	ast expr-ast
	expected expected
do
	if x ?= destructure
		ctx check-expr-with-destructure x, ast, expected
	else
		ctx check-expr ast, expected

-check-expr-with-destructure expr
	ctx expr-ctx
	destructure destructure
	ast expr-ast
	expected expected
do
	restore = ctx.locals size
	ctx add-locals-for-destructure destructure
	res = ctx check-expr ast, expected
	ctx restore-locals restore
	res

-add-locals-for-destructure void(ctx expr-ctx, destructure destructure)
	match destructure
	as destructure-ignore _
		()
	as local x
		ctx add-local x
	as destructure-split x
		for part : x parts
			ctx add-locals-for-destructure part

-add-local void(ctx expr-ctx, local local)
	if ctx.locals exists x => x.name == local.name
		ctx add-diag local.local-must-have-name-range, (param-or-local diag-duplicate-declaration local.name)
	ctx.locals ~= local
-restore-locals void(ctx expr-ctx, size nat)
	while ctx.locals.size > size
		ctx pop-local
-pop-local void(ctx expr-ctx)
	local = ctx.locals pop!
	if local is-used-in-closure && local is-mutable
		local.closure-reference-type := ctx.common-types.reference[local type]
	if local !is-read || (local !is-written && local is-mutable)
		ctx add-diag local.local-must-have-name-range, local.diag-unused-local

-check-shared expr(ctx expr-ctx, ast shared-ast, expected expected)
	diag void mut(diag diag) = diag =>
		ctx add-diag ast.keyword-range, diag
	diag-bogus expr mut(diag diag) = x =>
		ctx add-diag ast.keyword-range, x
		expected bogus ast.range

	guard inner ?= ast.inner lambda-ast : diag-bogus[diag-shared-arg-is-not-lambda]
	guard et ?= ctx get-expected-lambda ast.range, (ctx type-from-destructure inner.param), expected : expected bogus ast.range
	guard et.fun-type.kind == shared_ : diag-bogus[ctx get-expected-for-diag expected diag-shared-not-expected]
	res = ctx check-lambda-inner inner, inner.param, inner.body, expected, \
		ctx.common-types.fun-structs[mut_][et.fun-type.struct-inst.type-args], \
		et.instantiated-param-type, \
		et.fun-type.return-type, \
		et.type-context, \
		et.fun-type.fun-struct, \
		explicit-shared
	
	if ctx.specs !is-shared et.instantiated-param-type
		diag[param-type diag-shared-lambda-type-is-not-shared (ctx type-with-container et.instantiated-param-type)]
	if ctx.specs !is-shared res.return-type
		diag[return-type diag-shared-lambda-type-is-not-shared (ctx type-with-container res.return-type)]
	
	all-shared = res.expr.lambda-expr!.closure every x =>
		x.mutability == immut && ctx.specs is-shared x.type
	if all-shared
		diag[diag-shared-lambda-unused]
	res expr

-check-lambda expr
	ctx expr-ctx
	source lambda-source
	param-ast destructure-ast
	body-ast expr-ast
	expected expected
do
	diag-range = source range
	guard et ?= ctx get-expected-lambda diag-range, (ctx type-from-destructure param-ast), expected : expected bogus diag-range
	kind = et.fun-type kind
	res = ctx check-lambda-inner source, param-ast, body-ast, expected, (), \
		et.instantiated-param-type, et.fun-type.return-type, et.type-context, et.fun-type.fun-struct, kind.to-lambda-kind
	res expr

-to-lambda-kind lambda-kind(a fun-kind)
	match a
	as data_
		data_
	as shared_
		shared_
	as mut_
		mut_

-lambda-and-return-type record(expr expr, return-type type)
-check-lambda-inner lambda-and-return-type
	ctx expr-ctx
	source lambda-source
	param-ast destructure-ast
	body-ast expr-ast
	expected expected
	mut-type-for-explicit-shared struct-inst?
	param-type type
	# TODO: Pass these together as a type-and-context? ---------------------------------------------------------------------------
	non-instantiated-return-type type
	return-type-context type-context
	fun-struct struct-decl
	kind lambda-kind
do
	param = ctx check-destructure param-ast, param-type, param
	lambda-info lambda-info = kind, ctx.locals.size, ()
	# Checking the body of the lambda may fill in candidate type args
	# if the expected return type contains candidate's type params
	body-expected = non-instantiated-return-type expect-with-context return-type-context

	flags_ = ctx cur-flags
	if kind == data_
		ctx.cur-flags := flags_ & ~summon_
	ctx.lambdas ~= lambda-info
	body = ctx check-expr-with-destructure param, body-ast, body-expected
	_ = ctx.lambdas.pop!
	ctx.cur-flags := flags_

	# Can't just use `body-expected inferred` since that may be a narrower type than requested.
	body-type = (non-instantiated-return-type, return-type-context) try-get-inexact-non-inferring-type ??
		error log "GOT A BOGUS BODY. THIS SHOULD ONLY HAPPEN IF THERE IS AN ERROR, RIGHT?" # ---------------------------------------------------
		bogus-type
	inst-fun-struct = fun-struct[body-type, param.type]
	lambda lambda-expr =
		ast: source
		kind: kind
		param: param
		mut-type-for-explicit-shared: mut-type-for-explicit-shared
		body: body
		closure: lambda-info.closure move-to
		type: inst-fun-struct
	# TODO:PERF this check should never fail, so could just set inferred directly with no check ----------------------------------------
	res = ctx check expected, inst-fun-struct, lambda
	res, body-type

-check-let expr(ctx expr-ctx, ast let-ast, expected expected)
	value-expr, value-type = ctx check-and-expect-or-infer ast.value, (ctx type-from-destructure ast.destructure)
	destructure = ctx check-destructure ast.destructure, value-type, local
	then = ctx check-expr-with-destructure destructure, ast.then, expected
	ast let-expr destructure, value-expr, then

-check-list expr(ctx expr-ctx, ast list-ast, expected expected) check-expr
	guard result-type ?= expected try-get-inexact-non-inferring-type :
		ctx add-diag ast.range, list::diag-needs-expected-type
		expected bogus ast.range
	guard called ?= ctx find-function-for-list-new ast.range, result-type : expected bogus ast.range
	arg-array-type = called.param-types only
	parts list-expr-part[] = for part : ast parts
		match part
		as expr-ast x
			ctx check-and-expect x, arg-array-type.array-element-type!
		as list-ast-part-multi x
			ctx check-and-expect x.arg, arg-array-type list-expr-part-multi
	ast, called, parts

-check-loop expr(ctx expr-ctx, ast loop-ast, expected expected)
	if type ?= expected try-get-inexact-non-inferring-type
		loop_ loop-expr = ast, type, (ast.range bogus-expr bogus-type)
		info loop-info = loop_, type, false
		loop_.body := ctx check-expr ast.body, info.to
		if info !has-break
			ctx add-diag ast.keyword-range, diag-loop-without-break
		loop_
	else
		ctx add-diag ast.range, loop_::diag-needs-expected-type
		expected bogus ast.range

-check-loop-break expr(ctx expr-ctx, ast loop-break-ast, expected expected)
	if loop_ ?= expected try-get-loop
		loop_.has-break := true
		value = ctx check-and-expect ast.value, loop_.type
		ast loop-break-expr loop_.loop_, value
	else
		ctx check-call-special ast, ast.keyword-range, "loop-break", (ast.value,), expected

-check-loop-continue expr(ctx expr-ctx, ast loop-continue-ast, expected expected)
	if loop_ ?= expected try-get-loop
		ast loop-continue-expr loop_.loop_
	else
		ctx check-call-special ast, ast.keyword-range, "loop-continue", (), expected

-check-loop-while-or-until expr(ctx expr-ctx, ast loop-while-or-until-ast, expected expected)
	condition = ctx check-condition ast.condition
	destructure = condition opt-destructure
	body = ctx check-expr-with-opt-destructure (ast !is-until ? destructure), ast.body, ctx.void-type.expect
	after = ctx check-expr-with-opt-destructure (ast is-until ? destructure), ast.after, expected
	ast loop-while-or-until-expr condition, body, after

-check-match expr(ctx expr-ctx, ast match-ast, expected expected)
	matched, matched-type = ctx check-and-infer ast.matched
	# Use an arbitrary non-matchable inst as default
	inst = matched-type.struct-inst ?? ctx.common-types.void
	decl = inst decl
	not-matchable expr mut() = () =>
		if matched-type !is-bogus
			ctx add-diag ast.matched.range, (ctx type-with-container matched-type).diag-match-on-non-matchable
		expected bogus ast.matched
	match decl body
	as struct-body-bogus _
		not-matchable[]
	as struct-body-extern-java _
		not-matchable[]
	as builtin-type builtin_
		if char-type ?= builtin_.to::char-type?
			ctx check-match-char ast, expected, matched, matched-type, char-type
		elif integral ?= builtin_.to::integral-type?
			ctx check-match-integral ast, expected, matched, matched-type, integral
		else
			not-matchable[]
	as enum_ x
		ctx check-match-enum ast, expected, matched, matched-type, decl, x
	as flags_ _
		not-matchable[]
	as record_ _
		if string-like ?= ctx.common-types get-matchable-string-like-from-record inst
			ctx check-match-string-like ast, expected, matched, string-like
		else
			not-matchable[]
	as sum-type x
		if x.kind can-match-sum-type
			ctx check-match-sum-type ast, expected, matched, inst
		else
			not-matchable[]

-can-match-sum-type bool(a sum-type-kind)
	match a
	as interface_
		false
	as java-interface
		true
	as union_
		true
	as variant_
		true

-check-match-enum expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched expr
	matched-type type
	matched-enum struct-decl
	body enum_
do
	remaining enum-or-flags-member mut-set = body.members to
	has-case-diag mut = false
	cases match-enum-case[] = with out : ast.cases.size build
		for case-ast : ast cases
			# TODO: NEATER (break into a function and use 'guard') ---------------------------------------------------------------------
			as-name = ctx name-from-case-member-ast case-ast.member
			name = as-name?.name?.name
			opt-member enum-member? = if x ?= name
				body.members-by-name[x]
			if member ?= opt-member
				if remaining remove member
					name-ast = as-name!
					if d ?= name-ast destructure
						ctx add-diag d.range, matched-enum.diag-match-case-no-value-for-enum-or-symbol
					out ~= member, (ctx check-expr case-ast.then, expected)
				else
					has-case-diag := true
					ctx add-diag case-ast.name-range, name!::diag-match-case-duplicate
			else
				has-case-diag := true
				if n ?= name
					ctx add-diag case-ast.name-range, do n diag-match-case-name-not-in-enum matched-enum

	guard !has-case-diag : expected bogus ast.range
	
	else_ match-else? = if remaining is-empty
		if x ?= ast else_
			ctx add-diag x.keyword-range, diag-match-unnecessary-else
		()
	else
		ctx check-match-else-required ast, expected, matched-type, () =>
			remaining.to diag-match-unhandled-enum-members
	ast match-enum-expr matched, cases, else_, expected.inferred

-check-match-sum-type expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched expr
	sum-type struct-inst
do
	cases = ctx check-match-sum-type-cases sum-type, ast.cases, expected
	body = sum-type.decl.body sum-type!
	is-union = body.kind == union_
	else_ match-else? = if is-union
		if cases.size == body.listed-members.size
			if x ?= ast.else_
				ctx add-diag x.keyword-range, diag-match-unnecessary-else
			()
		else
			ctx check-match-else-required ast, expected, sum-type, () =>
				(sum-type list-missing-union-cases body, cases) diag-match-unhandled-union-case-types
	else
		ctx check-match-else-required ast, expected, sum-type, () => variant_::diag-match-needs-else
	ast match-sum-type-expr matched, cases, else_, expected.inferred
-list-missing-union-cases struct-inst[](union_ struct-inst, body sum-type, cases match-sum-type-case[])
	for* member : body listed-members
		member-inst = member.member instantiate-struct-inst union_.type-args.inner
		if cases !exists x => x.case-type == member-inst
			- member-inst

-check-match-sum-type-cases match-sum-type-case[]
	ctx expr-ctx
	matched-variant struct-inst
	case-asts case-ast[]
	expected expected
do
	seen struct-inst mut-set = ()
	seen hint-size case-asts.size
	with out : case-asts.size build
		for case-ast : case-asts
			if res ?= ctx check-match-sum-type-case matched-variant, case-ast.member, case-ast.then, expected
				if seen try-add res.case-type
					out ~= res
				else
					ctx add-diag case-ast.name-range, res.case-type.decl.name::diag-match-case-duplicate

-check-match-sum-type-case match-sum-type-case?
	ctx  expr-ctx
	matched-variant struct-inst
	member-ast case-member-ast
	then-ast expr-ast
	expected expected
do
	as-name = ctx name-from-case-member-ast member-ast
	name = as-name?.name?.name
	opt-case-type struct-inst? = if n ?= name
		ctx get-sum-type-case-from-name matched-variant, n, member-ast.name-range, () =>
			if d ?= as-name?.destructure
				ctx type-from-destructure d
	guard case-type ?= opt-case-type
	
	destructure = if ast ?= member-ast.as-name-ast!.destructure
		ctx check-destructure ast, case-type, local
	else
		if case-type !is-empty-type
			ctx add-diag member-ast.name-range, case-type.diag-match-case-should-use-ignore
		member-ast destructure-ignore member-ast.name-range.start, case-type
	if destructure.type !is-bogus
		expr = ctx check-expr-with-destructure destructure, then-ast, expected
		destructure, expr

-get-sum-type-case-from-name struct-inst?
	ctx expr-ctx
	sum-type struct-inst
	name symbol
	name-range source-range
	expected-member-type type? mut()
do
	listed-members = sum-type.decl.body.sum-type! listed-members
	guard sa ?= ctx.check-ctx struct-or-alias-from-name name, name-range, ctx.structs-and-aliases-map, false
	match sa
	as struct-alias alias_
		target = alias_ target
		is-listed = listed-members exists x => x.member == target
		has-membership = target.decl.sum-type-memberships exists x => x.sum-type == sum-type
		if is-listed || has-membership
			target
		else
			ctx add-diag name-range, (ctx type-with-container sum-type diag-match-sum-type-no-member target.decl)
			()
	as struct-decl decl
		# TODO: NEATER -------------------------------------------------------------------------------------------------------------------
		from-listed struct-inst? = listed-members first x =>
			if x.member.decl == decl
				x.member instantiate-struct-inst sum-type.type-args.inner
		if x ?= from-listed
			x
		else
			from-membership = decl.sum-type-memberships first x =>
				ctx compare-sum-types name-range, decl, x.sum-type, sum-type, expected-member-type
			if res ?= from-membership
				match res
				as struct-inst x
					x
				as sum-type-case-bogus
					()
			else
				ctx add-diag name-range, (ctx type-with-container sum-type diag-match-sum-type-no-member decl)
				()

-instantiated-sum-type-case-or-bogus union(struct-inst, sum-type-case-bogus)
-sum-type-case-bogus record

| Returns instantiated case type if the declared sum-type matches the actual
-compare-sum-types instantiated-sum-type-case-or-bogus?
	ctx expr-ctx
	range source-range
	case_ struct-decl
	declared-sum-type struct-inst
	actual-sum-type struct-inst
	expected-case-type type? mut()
do
	guard declared-sum-type.decl == actual-sum-type.decl
	case_.n-type-params with-type-context-for inferring-context =>
		inferring-declared-sum-type type-and-context = declared-sum-type, inferring-context
		guard inferring-declared-sum-type match-types actual-sum-type.non-inferring, exact
		if inferring-context exists x => x is-empty
			if t ?= expected-case-type[]
				# Just using this for inference
				_ = (case_.instantiated-with-own-type-params, inferring-context) match-types t.non-inferring, exact
		if inferred-types ?= inferring-context map-or-none x => x?.type
			case_[inferred-types]
		else
			ctx add-diag range, case_.diag-match-sum-type-cant-infer-type-args
			sum-type-case-bogus

-check-match-char expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched expr
	matched-type type
	char-type char-type
do
	seen integral-value mut-set = ()
	seen hint-size ast.cases.size
	cases match-integral-case[] = with out : ast.cases.size build
		for case-ast : ast cases
			guard string-value ?= ctx string-from-case-ast case-ast.member
			value integral-value = match char-type
			as char8
				(ctx char8-literal-value case-ast.name-range, string-value).to,
			as char32
				(ctx char32-literal-value case-ast.name-range, string-value).to,
			if seen try-add value
				out ~= value, (ctx check-expr case-ast.then, expected)
			else
				ctx add-diag case-ast.name-range, string-value::diag-match-case-duplicate
	else_ = ctx check-match-else-required ast, expected, matched-type, () => integral::diag-match-needs-else
	ast match-integral-expr char-type, matched, cases, else_, expected.inferred

-check-match-integral expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched expr
	matched-type type
	integral-type integral-type
do
	seen integral-value mut-set = ()
	seen hint-size ast.cases.size
	cases match-integral-case[] = with out : build
		for case-ast : ast cases
			opt-value integral-value? = match case-ast member
			as as-name-ast x
				ctx add-diag x.name.range, numeric::diag-match-case-for-type
				()
			as literal-integral-and-range x
				ctx.check-ctx check-literal-integral-value integral-type, x
			as as-string-ast x
				ctx add-diag x.range, numeric::diag-match-case-for-type
				()
			as as-bogus-ast _
				()
			if value ?= opt-value
				if seen try-add value
					out ~= value, (ctx check-expr case-ast.then, expected)
				else
					ctx add-diag case-ast.name-range, if integral-type is-signed
						value.as-signed::diag-match-case-duplicate
					else
						value.as-unsigned::diag-match-case-duplicate
	else_ = ctx check-match-else-required ast, expected, matched-type, () => integral::diag-match-needs-else
	ast match-integral-expr integral-type, matched, cases, else_, expected.inferred

-get-matchable-string-like-from-record string-like-type?(common-types common-types, inst struct-inst)
	if inst == common-types.char32-array
		char32-array
	elif inst == common-types.char8-array
		char8-array
	elif inst == common-types.symbol
		symbol
	elif inst == common-types.string
		string

-check-match-string-like expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched expr
	string-type string-like-type
do
	guard spec_ ?= ctx.check-ctx get-spec-from-common-module ctx.specs-map, ast.keyword-range, "equal", compare : expected bogus ast.range

	matched-type = matched type ctx.common-types struct-inst!
	equals = ctx.check-ctx check-spec-and-get-last-impl ctx.funs-map, ast.keyword-range, ctx.type-container, \
		ctx.specs, ctx.cur-flags, ctx.externs, \
		(ctx.instantiate-ctx instantiate-spec spec_, (matched-type,))
	seen string mut-set = ()
	cases match-string-like-case[] = with out : build
		for case-ast : ast cases
			if value ?= ctx string-from-case-ast case-ast.member
				if seen try-add value
					out ~= value, (ctx check-expr case-ast.then, expected)
				else
					ctx add-diag case-ast.name-range, value::diag-match-case-duplicate
	else_ = ctx check-match-else-required ast, expected, matched-type, () => string-like::diag-match-needs-else
	ast match-string-like-expr string-type, matched, equals, cases, else_, expected.inferred

-check-match-else-required match-else
	ctx expr-ctx
	ast match-ast
	expected expected
	matched-type type
	cb-diag diag mut()
do
	if else_ ?= ast else_
		ctx check-match-else else_.destructure, else_.expr, expected, matched-type
	else
		ctx add-diag ast.keyword-range, cb-diag[]
		(), do expected bogus ast.range
-check-match-else match-else
	ctx expr-ctx
	destructure-ast destructure-ast?
	then-ast expr-ast
	expected expected
	matched-type type
do
	destructure destructure? = if d ?= destructure-ast
		ctx check-destructure d, matched-type, local
	destructure, do ctx check-expr-with-opt-destructure destructure, then-ast, expected

# TODO: use a with-block ---------------------------------------------------------------------------------------------------------
-with-extern-from-condition[out] out(ctx expr-ctx, condition condition, is-negated bool, cb out mut())
	guard extern_ ?= condition as-extern : cb[]
	guard !(is-negated xor extern_.is-negated) : cb[]
	original-externs = ctx externs
	ctx.externs |:= extern_ required-externs
	res = cb[]
	ctx.externs := original-externs
	res

-check-expr-with-opt-destructure-or-empty-new expr
	ctx expr-ctx
	parent call-expr-source
	destructure destructure?
	ast expr-ast?
	empty-new-range source-range
	expected expected
do
	if x ?= ast
		ctx check-expr-with-opt-destructure destructure, x, expected
	else
		ctx check-empty-new parent, empty-new-range, expected

-string-from-case-ast string?(ctx expr-ctx, ast case-member-ast)
	match ast
	as as-name-ast x
		if d ?= x destructure
			ctx add-diag d.range, ().diag-match-case-no-value-for-enum-or-symbol
		x.name.name to
	as literal-integral-and-range x
		ctx add-diag x.range, string-like::diag-match-case-for-type
		()
	as as-string-ast x
		x value
	as as-bogus-ast _
		()

-name-from-case-member-ast as-name-ast?(ctx expr-ctx, ast case-member-ast)
	res as-name-ast? = ast as-name-ast
	if res is-empty
		ctx add-diag ast.name-range, enum-or-union::diag-match-case-for-type
	res

-check-seq expr(ctx expr-ctx, ast seq-ast, expected expected)
	first = ctx check-and-expect ast.first, ctx.void-type
	then = ctx check-expr ast.then, expected
	first seq-expr then

-has-break-or-continue bool(a expr-ast)
	match a
	as arrow-access-ast _
		false
	as assert-or-forbid-ast x
		x.after has-break-or-continue
	as assignment-ast _
		false
	as assignment-call-ast _
		false
	as bogus-ast _
		false
	as call-ast _
		false
	as call-named-ast _
		false
	as do-ast x
		x.body has-break-or-continue
	as empty-ast _
		false
	as extern-ast _
		false
	as finally-ast _
		false
	as for-ast _
		false
	as name-and-range _
		false
	as if-ast x
		x.all-branches exists y => y has-break-or-continue
	as interpolated-ast _
		false
	as lambda-ast _
		false
	as let-ast x
		x.then has-break-or-continue
	as list-ast _
		false
	as literal-float-and-range _
		false
	as literal-integral-and-range _
		false
	as literal-string-ast _
		false
	as loop-ast _
		false
	as loop-break-ast _
		true
	as loop-continue-ast _
		true
	as loop-while-or-until-ast x
		x.after has-break-or-continue
	as match-ast x
		x.cases exists case_ => case_.then has-break-or-continue
	as seq-ast x
		x.then has-break-or-continue
	as shared-ast _
		false
	as throw-ast _
		false
	as trusted-ast _
		false
	as try-ast _
		false
	as try-let-ast x
		x.then has-break-or-continue
	as typed-ast _
		false
	as with-ast _
		false

-check-for expr(ctx expr-ctx, ast for-ast, expected expected)
	fun-name symbol = if ast.body has-break-or-continue
		match ast kind
		as for_
			"for-break"
		as for-star
			"for-star-break"
	else
		match ast kind
		as for_
			"for-loop"
		as for-star
			"for-star"
	keyword-range = ast for-keyword-range
	if else_ ?= ast else_
		ctx check-call-arg-and-2-lambdas ast, ast, keyword-range, fun-name, \
			ast.collection, ast.param, ast.body, else_, expected
	else
		ctx check-call-arg-and-lambda ast, ast, keyword-range, fun-name, \
			ast.collection, ast.param, ast.body, expected

-check-with expr(ctx expr-ctx, ast with-ast, expected expected)
	keyword-range = ast with-keyword-range
	if _ ?= ast else_
		ctx add-diag keyword-range, diag-with-has-else
	ctx check-call-arg-and-lambda ast, ast, keyword-range, "with-block", ast.arg, ast.param, ast.body, expected

-check-finally expr(ctx expr-ctx, ast finally-ast, expected expected)
	if _ ?= expected try-get-loop
		ctx add-diag ast.finally-keyword-range, finally_::diag-loop-disallowed-body
		expected bogus ast.range
	else
		right = ctx check-and-expect ast.right, ctx.void-type
		below = ctx check-expr ast.below, expected
		ast finally-expr right, below

-check-try expr(ctx expr-ctx, ast try-ast, expected expected)
	if _ ?= expected try-get-loop
		ctx add-diag ast.try-keyword-range, try_::diag-loop-disallowed-body
		expected bogus ast.range
	else
		body = ctx check-expr ast.tried, expected
		exception = ctx.common-types exception
		catches = ctx check-match-sum-type-cases exception, ast.catches, expected
		else_ match-else? = if x ?= ast catch-else
			ctx check-match-else x.destructure, x.expr, expected, exception
		ast try-expr body, catches, else_, expected.inferred

-check-try-let expr(ctx expr-ctx, ast try-let-ast, expected expected)
	value-expr, value-type = ctx check-and-expect-or-infer ast.value, (ctx type-from-destructure ast.destructure)
	destructure = ctx check-destructure ast.destructure, value-type, local
	guard catch_ ?= ctx check-match-sum-type-case ctx.common-types.exception, ast.catch-member, ast.catch_, expected : expected bogus ast.range
	then = ctx check-expr-with-destructure destructure, ast.then, expected
	ast try-let-expr destructure, value-expr, catch_, then, expected.inferred

-check-typed expr(ctx expr-ctx, ast typed-ast, expected expected)
	type = ctx type-from-ast ast.type
	guard type !is-bogus : expected bogus ast.range
	expr = ctx check-and-expect ast.expr, type
	ctx check expected, type, do ast typed-expr expr, type
