import
	crow/col/mut-slice
	../../../crow/col/mut-set: hint-size
	../../../crow/parse: parse-float
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/by-name
	../../util/enum-map
	../../util/util
	./check-call/check-call
	./check-call/check-call-specs
	./check-ctx
	./allocators
	./check-util
	./expr-ctx
	./inferring-type
	./instantiate
	./type-from-ast

check-fun-or-test-body expr-maybe-allocated-locals
	check-ctx check-ctx
	types types-get
	funs-map funs-map
	container expr-container
	return-type type
	params destructure[]
	ast expr-ast?
	source-for-empty-new call-expr-source?
do
	logged = container.fun-decl.?name == "LOGME"
	if logged
		enable-inference-log

	expr-ctx expr-ctx =
		check-ctx: check-ctx
		types-and-specs-map: types.types-and-specs-map
		funs-map: funs-map
		common-types: types.common-types
		container: container
	for param in params
		add-locals-for-destructure expr-ctx, param
	res = if ast
		check-and-expect expr-ctx, ast, return-type
	else
		check-empty-new expr-ctx, source-for-empty-new!, source-for-empty-new!.name-range, return-type.expect
	restore-locals expr-ctx, 0
	if logged
		disable-inference-log
	if is-empty expr-ctx.allocated-locals
		res
	else
		expr-with-allocated-locals res, expr-ctx.allocated-locals.move-to

-check-expr expr(ctx expr-ctx, ast expr-ast, expected expected)
	match ast
	as assert-or-forbid-ast
		check-assert-or-forbid ctx, ast, expected
	as assignment-ast
		check-assignment ctx, ast, ast.left, ast.keyword-range, expected, of right-expected
			check-expr ctx, ast.right, right-expected
	as assignment-call-ast
		check-assignment-call ctx, ast, expected
	as bogus-ast
		bogus expected, ast
	as call-ast
		check-call ctx, ast, expected
	as call-named-ast
		check-call-named ctx, ast, expected
	as call-subscript-ast
		check-call-subscript ctx, ast, expected
	as finally-ast
		check-finally ctx, ast, expected
	as force-ast
		check-force ctx, ast, expected
	as for-or-with-ast
		check-for-or-with ctx, ast, expected
	as name-and-range
		check-identifier ctx, ast, expected
	as if-ast
		check-if ctx, ast, expected
	as interpolated-ast
		check-interpolated ctx, ast, expected
	as it-ast
		check-it ctx, ast, expected
	as it-scope-ast
		check-it-scope ctx, ast, expected
	as lambda-ast
		check-lambda ctx, ast, ast.param, ast.body, expected
	as let-ast
		check-let ctx, ast, expected
	as list-ast
		check-list ctx, ast, expected
	as literal-number
		check-literal-number ctx, ast.range, expected
	as literal-string-ast
		check-literal-string ctx, ast, expected
	as logical-ast
		check-logical ctx, ast, expected
	as loop-ast
		check-loop ctx, ast, expected
	as loop-break-ast
		check-loop-break ctx, ast, expected
	as loop-continue-ast
		check-loop-continue ctx, ast, expected
	as loop-while-or-until-ast
		check-loop-while-or-until ctx, ast, expected
	as match-ast
		check-match ctx, ast, expected
	as not-ast
		check-not ctx, ast, expected
	as parenthesized-ast
		check-expr ctx, ast.inner, expected
	as seq-ast
		check-seq ctx, ast, expected
	as shared-ast
		check-shared ctx, ast, expected
	as throw-ast
		check-throw ctx, ast, expected
	as trusted-ast
		check-trusted ctx, ast, expected
	as try-ast
		check-try ctx, ast, expected
	as try-let-ast
		check-try-let ctx, ast, expected
	as typed-ast
		check-typed ctx, ast, expected
	as unpack-option-ast
		check ctx, expected, ctx.common-types.bool, check-unpack-option ctx, ast
	as underscore-ast
		add-diag ctx, ast.range, diag-underscore
		bogus expected, ast.range

-check-and-infer (expr, type)(ctx expr-ctx, ast expr-ast)
	expected expected = infer
	- check-expr ctx, ast, expected
	- expected.inferred

-check-and-expect-or-infer (expr, type)(ctx expr-ctx, ast expr-ast, expected type?)
	if expected
		(check-and-expect ctx, ast, expected), expected
	else
		check-and-infer ctx, ast

-check-and-expect expr(ctx expr-ctx, ast expr-ast, expected type)
	check-expr ctx, ast, expected.expect

-void-type type(ctx expr-ctx)
	ctx.common-types.void

-check-not expr(ctx expr-ctx, ast not-ast, expected expected)
	check ctx, expected, ctx.common-types.bool,
		not-expr ast, check-condition ctx, ast.arg

-check-if if-expr(ctx expr-ctx, ast if-ast, expected expected)
	if (ast.first-branch.is-throw or ast.second-branch.is-throw) and !ast.is-else-of-parent
		add-diag ctx, ast.first-keyword-range, diag-if-throw
	condition = check-condition ctx, ast.condition
	is-negated = ast.is-condition-negated
	empty-new-range = ast.first-keyword-range
	first-branch = check-expr-with-condition-or-empty-new ctx, ast, (known-value condition, !is-negated), ast.first-branch, empty-new-range, expected
	type = expected.inferred
	second-branch expr = if is-bogus type
		bogus-expr empty-new-range, type
	else
		check-expr-with-condition-or-empty-new ctx, ast, (known-value condition, is-negated), ast.second-branch, empty-new-range, expected
	ast: ast
	condition: condition
	true-branch: if is-negated then second-branch else first-branch
	false-branch: if is-negated then first-branch else second-branch
	type: type
-is-throw bool(a expr-ast?)
	!!a.?throw-ast

-check-condition expr(ctx expr-ctx, ast expr-ast)
	if ast.skip-parentheses.logical-ast
		check-and-expect ctx, ast, ctx.common-types.bool
	else
		# Since anything can implicitly convert to 't?', any expression can match this.
		# But having this will guide code to prefer to exactly match 'bool' instead of converting to option.
		choices type-and-context mut[] =
			- ctx.common-types.bool, ()
			- ctx.common-types.t-option, ((),)
		res = check-expr ctx, ast, choices.to
		# It may implicitly convert to an option and that's what 'expected inferred' gives.
		# So use 'res type' to get the actual type.
		type = type res, ctx.available-types
		if is-bool type or is-option type
			res
		else
			unless is-bogus type
				add-diag ctx, ast.range, diag-condition-type type-with-container ctx, type
			bogus-expr ast.range, ctx.common-types.bool

-check-unpack-option unpack-option(ctx expr-ctx, ast unpack-option-ast)
	expr, type = check-and-expect-or-infer ctx, ast.option,
		if t = type-from-destructure ctx, ast.destructure
			ctx.common-types.option[as-type-args t]
	destructure  = check-destructure ctx, ast.destructure, type.unwrap-option-or-same, local
	ast: ast
	destructure: destructure
	option: if is-option type
		match expr
		as local-get-expr
			if !expr.local.is-mutable and destructure.local
				add-diag ctx, ast.option.range,
					diag-unpack-option-unnecessary destructure.name, expr.local.name, ()
		as call-expr
			if x = as-call-sum-type-member-get-on-local expr and destructure.local
				add-diag ctx, ast.option.range,
					diag-unpack-option-unnecessary destructure.name, x.local.name,  x.refined-type.struct-inst!.decl.name
		else
			()
		expr
	else
		range = ast.option.range
		unless is-bogus type
			add-diag ctx, range, diag-unpack-option-must-be-option type-with-container ctx, type
		bogus-expr range, ctx.common-types.option[as-type-args type]

-check-force expr(ctx expr-ctx, ast force-ast, expected expected)
	is-option mut bool = true
	arg = check-with-modify-expected-option ctx, ast.arg, expected, of actual
		is-option := false
		add-diag ctx, ast.keyword-range, actual.diag-option-force-non-option
	if is-option then force-expr ast, arg else arg

-check-throw expr(ctx expr-ctx, ast throw-ast, expected expected)
	if type = try-get-inexact-non-inferring-type-including-loop expected
		thrown = check-and-expect ctx, ast.thrown, ctx.common-types.exception
		throw-expr ast, thrown, type
	else
		add-diag ctx, ast.range, throw_::diag-needs-expected-type
		bogus expected, ast.range

-check-trusted trusted-expr(ctx expr-ctx, ast trusted-ast, expected expected)
	ast, with-trusted ctx, ast, of
		check-expr ctx, ast.inner, expected

-check-assert-or-forbid expr(ctx expr-ctx, ast assert-or-forbid-ast, expected expected)
	condition = check-condition ctx, ast.condition
	is-forbid = ast.is-forbid
	thrown expr? = if thrown-ast = ast.thrown
		if x = thrown-ast.expr.throw-ast
			add-diag ctx, x.keyword-range, diag-assert-or-forbid-message-is-throw
		check-expr-with-context ctx, (known-value condition, is-forbid), thrown-ast.expr, ctx.common-types.exception.expect
	after =
		diag diag-required-after = if is-forbid then forbid_ else assert_
		check-required-after ctx, ast.keyword-range, (known-value condition, !is-forbid), ast.after, diag, expected
	assert-or-forbid-expr ast, is-forbid, condition, thrown, after

-check-assignment expr
	ctx expr-ctx
	source call-expr-source
	left expr-ast
	keyword-range source-range
	expected expected
	cb-right expr mut(x expected)
do
	cant-assign expr mut() = of
		add-diag ctx, left.range, diag-assignment-not-allowed
		bogus expected, source.range
	match left
	as name-and-range
		check-assign-identifier ctx, left, keyword-range, left.name, expected, cb-right
	as call-ast
		name symbol? = match style left
		as dot
			"set-{left.fun-name.name}"
		else
			()
		do if name else cant-assign[]
		check-call-special-cb-n ctx, source, keyword-range, name, expected, left.args.size + 1, of i, arg-expected
			if i == left.args.size
				cb-right[arg-expected]
			else
				check-expr ctx, left.args[i], arg-expected
	as call-subscript-ast
		do unless left.is-question-subscript else cant-assign[]
		check-call-special-cb-n ctx, source, keyword-range, "set-subscript", expected, 3, of i, arg-expected
			match i
			as 0
				check-expr ctx, left.left, arg-expected
			as 1
				check-expr ctx, left.right, arg-expected
			as 2
				cb-right[arg-expected]
			else
				throw unreachable
	else
		cant-assign[]

-check-assignment-call expr(ctx expr-ctx, ast assignment-call-ast, expected expected)
	check-assignment ctx, ast, ast.left, ast.keyword-range, expected, of arg-expected
		check-call-special ctx, ast, ast.fun-name.range, ast.fun-name.name, (ast.left, ast.right), arg-expected

-check-interpolated expr(ctx expr-ctx, ast interpolated-ast, expected expected)
	check-interpolated-inner ctx, ast, ast.range, ast.template, ast.interpolated, expected

-check-interpolated-inner expr
	ctx expr-ctx
	source list-expr-source
	range source-range
	template interpolated-template-part[]
	interpolated-exprs expr-ast[]
	expected expected
do
	do if called = called-for-interpolate-or-list-new ctx, range, "interpolate", expected else
		bogus expected, range
	arg-element-type = array-element-type! only! called.param-types
	arg-expected = expect arg-element-type
	args expr[] = for arg-index in 0 .. template.size + interpolated-exprs.size
		if is-even arg-index
			part = template[arg-index / 2]
			range2 = if is-empty part.range then part.range else part.range[0 .. 1]
			check-call-special-cb1 ctx, part, range2, "interpolate-string", arg-expected, of inner2
				check-literal-string-only-string ctx, part, inner2
		else
			part = interpolated-exprs[arg-index / 2]
			range2 = if is-empty part.range then part.range else part.range[0 .. 1]
			check-call-special ctx, source.to, range2, "interpolate-value", (part,), arg-expected
	list-expr source, called, for arg in args then arg

-access-local local?(ctx expr-ctx, diag-range source-range, name symbol)
	# This traverses from the innermost lambda outwards, checking if it was already added to a closure.
	# Then we walk back inwards adding to inner lambdas.
	i mut = ctx.lambdas.size
	do loop
	if i == 0
		break if index = find-index ctx.locals, it.name == name
			local = ctx.locals[index]
			i := ctx.lambdas.size
			until i == 0 or index >= ctx.lambdas[i - 1].first-local-index
				add-to-closure ctx, diag-range, ctx.lambdas[i - 1], local
				i -:= 1
			local
	else
		lambda = ctx.lambdas[i - 1]
		if local = find lambda.closure, it.name == name
			for j in i .. ctx.lambdas.size
				add-to-closure ctx, diag-range, ctx.lambdas[j], local
			break local
		else
			i -:= 1
			continue

-add-to-closure void(ctx expr-ctx, diag-range source-range, lambda lambda-info, local local)
	forbid exists lambda.closure, it.name == local.name # RM -----------------------------------------------------------------------
	lambda.closure ~= local
	if is-mutable local
		_ = ensure ctx.allocated-locals, local, of then ctx.common-types.reference[as-type-args local.type]
	check-lambda-can-reference-local ctx, diag-range, lambda.kind, local

-check-lambda-can-reference-local void(ctx expr-ctx, diag-range source-range, lambda-kind lambda-kind, local local)
	expected-purity purity = match lambda-kind
	as data_ then data_
	as shared_ then shared_
	as mut_ then mut_
	as explicit-shared then mut_
	if expected-purity != mut_
		if is-mutable local
			add-diag ctx, diag-range,
				diag-lambda-closure-purity lambda-kind, local.name, mut_, ()
		elif !is-purity-always-compatible-considering-specs ctx.specs, local.type, expected-purity
			add-diag ctx, diag-range,
				diag-lambda-closure-purity lambda-kind, local.name, local.type.purity-range.worst-case, type-with-container ctx, local.type

-check-identifier expr(ctx expr-ctx, ast name-and-range, expected expected)
	if local = access-local ctx, ast.range, ast.name
		type-refinements type[] = with out in build
			for r in ctx.refined-types
				if r.local == local
					out ~= r.refined-type
		expr expr, type type = if is-empty type-refinements
			(local-get-expr ast, local), local.type
		else
			(local-get-and-refine-expr ast, local, type-refinements), type-refinements[end - 1]
		check ctx, expected, type, expr
	else
		check-call-identifier ctx, ast, expected

-check-assign-identifier expr
	ctx expr-ctx
	source name-and-range
	keyword-range source-range
	left symbol
	expected expected
	cb-right expr mut(x expected)
do
	if local = access-local ctx, source.range, left
		if is-mutable local
			check ctx, expected, ctx.void-type,
				local-set-expr source, local, cb-right[local.type.expect]
		else
			add-diag ctx, source.range, local.diag-local-not-mutable
			bogus expected, source.range
	else
		check-call-special-cb1 ctx, source, keyword-range, "set-{left}", expected, cb-right

-as-float expr
	ctx expr-ctx
	range source-range
	float-type float-type-or-js-or-json
	inst struct-inst
	expected expected
do
	check ctx, expected, inst,
		literal-scalar-expr range, float-type,
			parse-float get-text ctx.check-ctx, range 'to

# TODO: these could use 'mebmers'? --------------------------------------------------------------------------------------------
# ALSO, it's important that this matches the order of 'integral-type' in model.crow -----------------------------------------------
-nat-types integral-type[]()
	nat8, nat16, nat32, nat64
-int-types integral-type[]()
	int8, int16, int32, int64
-integral-types integral-type[]()
	nat-types ~~ int-types
-float-types float-type-or-js-or-json[]()
	members

-check-literal-number expr(ctx expr-ctx, range source-range, expected expected)
	integrals = ctx.common-types.integrals
	integrals.all.size is integral-types.size
	# TODO:PERF this array is always the same, so precompute it! ------------------------------------------------------------------------------------
	allowed-types struct-inst[] =
		-- integrals.all
		-- ctx.common-types.all-floats
		- ctx.common-types.js-any
		-- from-option ctx.check-ctx.json-type
	if type-index = find-expected-struct-for-literal ctx, range, expected, allowed-types
		number-type = allowed-types[type-index]
		if type-index < integral-types.size
			integral-type = integral-types[type-index]
			value = check-literal-integral-value ctx.check-ctx, integral-type, range
			check ctx, expected, number-type, literal-scalar-expr range, integral-type, value
		else
			float-type = float-types[type-index - integral-types.size]
			as-float ctx, range, float-type, number-type, expected
	else
		bogus expected, range

-allowed-literal-string-types struct-inst[](ctx expr-ctx, include-chars bool)
	types = ctx.common-types
	-- if include-chars
		- types.char8
		- types.char32
	- types.char8-array
	- types.char32-array
	- types.java-String
	- types.js-any
	- types.string
	- types.symbol
	-- from-option ctx.check-ctx.json-type

-check-literal-string expr(ctx expr-ctx, ast literal-string-ast, expected expected)
	range = ast.range
	value = ast.value
	allowed-types struct-inst[] = allowed-literal-string-types ctx, true
	if type-index = find-expected-struct-for-literal-allow-none ctx, range, expected, allowed-types
		if type-index == 0
			literal-scalar-expr range, char8,
				char8-literal-value ctx, range, value 'to
		elif type-index == 1
			literal-scalar-expr range, char32,
				char32-literal-value ctx, range, value 'to
		else
			check-literal-string-inner ctx, ast.range, ast.value, type-index - 2, expected
	else
		check-interpolated-inner ctx, ast, ast.range, (ast.to,), (), expected
-to interpolated-template-part(a literal-string-ast)
	a.range, a.value

-check-literal-string-only-string expr(ctx expr-ctx, ast interpolated-template-part, expected expected)
	allowed-types = allowed-literal-string-types ctx, false
	if type-index = find-expected-struct-for-literal ctx, ast.range, expected, allowed-types
		check-literal-string-inner ctx, ast.range, ast.value, type-index, expected
	else
		bogus expected, ast.range

-check-literal-string-inner expr(ctx expr-ctx, range source-range, value string, type-index nat, expected expected)
	kinds string-like-type[] = char8-array, char32-array, java-String, js-any, string, symbol, json
	string-type = kinds[type-index]
	if string-type != js-any or check-is-js ctx, range
		check ctx, expected, (allowed-literal-string-types ctx, false)[type-index],
			literal-string-like-expr range, string-type, value
	else
		bogus expected, range

-check-is-js bool(ctx expr-ctx, range source-range)
	res = has-build-target ctx.specs, js or ctx.additional-externs[js]
	unless res
		add-diag ctx, range, not-extern-js
	res

-char8-literal-value char8(ctx expr-ctx, diag-range source-range, value string)
	only value.to::char8[] else
		add-diag ctx, diag-range, diag-char-literal-must-be-one-char
		"a"
-char32-literal-value char32(ctx expr-ctx, diag-range source-range, value string)
	decode-as-single-unicode-char value else
		add-diag ctx, diag-range, diag-char-literal-must-be-one-char
		"a"
-decode-as-single-unicode-char char32?(a string)
	only a.to::char32[]

-expression-context union(known-value, destructure)
| Context where {expr} is known to be {expr-value}
-known-value record(expr expr, expr-value bool)
-check-expr-with-context expr
	ctx expr-ctx
	context expression-context
	ast expr-ast
	expected expected
do
	check-with-condition ctx, context, of
		check-expr ctx, ast, expected
-check-with-condition[t] t(ctx expr-ctx, context expression-context, f t mut())
	restore-locals = ctx.locals.size
	restore-refined-types = ctx.refined-types.size
	original-externs build-target set = ctx.additional-externs
	match context
	as known-value
		for x in condition-knowledge context.expr, context.expr-value
			match x
			as local
				add-local ctx, x
			as local-refinement
				ctx.refined-types ~= x
			as build-target
				ctx.additional-externs ~:= x
	as destructure
		add-locals-for-destructure ctx, context
	res = f[]
	restore-locals ctx, restore-locals
	while ctx.refined-types.size > restore-refined-types
		_ = pop! ctx.refined-types
	ctx.additional-externs := original-externs
	res
-add-locals-for-destructure void(ctx expr-ctx, destructure destructure)
	for x in destructure.locals
		add-local ctx, x

-add-local void(ctx expr-ctx, local local)
	if exists ctx.locals, it.name == local.name
		add-diag ctx, local.local-must-have-name-range, diag-duplicate-declaration param-or-local, local.name
	ctx.locals ~= local
-restore-locals void(ctx expr-ctx, size nat)
	while ctx.locals.size > size
		pop-local ctx
-pop-local void(ctx expr-ctx)
	_ = pop! ctx.locals

-check-shared expr(ctx expr-ctx, ast shared-ast, expected expected)
	diag void mut(diag diag) = of diag
		add-diag ctx, ast.keyword-range, diag
	diag-bogus expr mut(diag diag) = of x
		add-diag ctx, ast.keyword-range, x
		bogus expected, ast.range

	do if inner = lambda-ast ast.inner else diag-bogus[diag-shared-arg-is-not-lambda]
	do if et = get-expected-lambda ctx, ast.range, (type-from-destructure ctx, inner.param), expected else
		bogus expected, ast.range
	do if et.fun-type.kind == shared_ else
		diag-bogus[diag-shared-not-expected get-expected-for-diag ctx, expected]
	param = check-destructure ctx, inner.param, et.instantiated-param-type, param
	res = check-lambda-inner ctx, inner, param, inner.body, expected, \
		ctx.common-types.fun-structs[mut_][et.fun-type.struct-inst.type-args], \
		et.fun-type.return-type, \
		et.type-context, \
		et.fun-type.fun-struct, \
		explicit-shared

	if !is-shared ctx.specs, et.instantiated-param-type
		diag[diag-shared-lambda-type-is-not-shared param-type, type-with-container ctx, et.instantiated-param-type]
	if !is-shared ctx.specs, res.return-type
		diag[diag-shared-lambda-type-is-not-shared return-type, type-with-container ctx, res.return-type]

	all-shared = every res.expr.lambda-expr!.closure, of x
		!x.is-mutable and is-shared ctx.specs, x.type
	if all-shared
		diag[diag-shared-lambda-unused]
	res.expr

-check-it expr
	ctx expr-ctx
	ast it-ast
	expected expected
do
	local = access-local! ctx, ast.range, "it"
	check ctx, expected, local.type, local-get-expr ast, local

-check-it-scope expr
	ctx expr-ctx
	ast it-scope-ast
	expected expected
do
	if ast.inner.it-ast
		add-diag ctx, ast.range, diag-it-identity
		bogus expected, ast
	else
		diag-range = ast.range
		do if et = get-expected-lambda ctx, diag-range, (), expected else
			bogus expected, diag-range
		kind = et.fun-type.kind
		param local = ast, et.instantiated-param-type
		expr check-lambda-inner ctx, ast, param, ast.inner, expected, (), \
			et.fun-type.return-type, et.type-context, et.fun-type.fun-struct, kind.to-lambda-kind

-check-lambda expr
	ctx expr-ctx
	source lambda-source
	param-ast destructure-ast
	body-ast expr-ast
	expected expected
do
	diag-range = source.range
	do if et = get-expected-lambda ctx, diag-range, (type-from-destructure ctx, param-ast), expected else
		bogus expected, diag-range
	kind = et.fun-type.kind
	param = check-destructure ctx, param-ast, et.instantiated-param-type, param
	expr check-lambda-inner ctx, source, param, body-ast, expected, (), \
		et.fun-type.return-type, et.type-context, et.fun-type.fun-struct, kind.to-lambda-kind

-to-lambda-kind lambda-kind(a fun-kind)
	match a
	as data_
		data_
	as shared_
		shared_
	as mut_
		mut_

-lambda-and-return-type record(expr expr, return-type type)
-check-lambda-inner lambda-and-return-type
	ctx expr-ctx
	source lambda-source
	param destructure
	body-ast expr-ast
	expected expected
	mut-type-for-explicit-shared struct-inst?
	# TODO: Pass these together as a type-and-context? ---------------------------------------------------------------------------
	non-instantiated-return-type type
	return-type-context type-context
	fun-struct struct-decl
	kind lambda-kind
do
	lambda-info lambda-info = kind, ctx.locals.size, ()
	# Checking the body of the lambda may fill in candidate type args
	# if the expected return type contains candidate's type params
	body-expected = expect-with-context non-instantiated-return-type, return-type-context

	ctx.lambdas ~= lambda-info
	body = check-expr-with-context ctx, param, body-ast, body-expected
	_ = ctx.lambdas.pop!

	# Can't just use `body-expected inferred` since that may be a narrower type than requested.
	body-type = try-get-inexact-non-inferring-type (non-instantiated-return-type, return-type-context) else
		log error, "GOT A BOGUS BODY. THIS SHOULD ONLY HAPPEN IF THERE IS AN ERROR, RIGHT?" # ---------------------------------------------------
		bogus-type
	inst-fun-struct = fun-struct[(body-type, param.type).to-type-array]
	lambda lambda-expr =
		ast: source
		kind: kind
		param: param
		mut-type-for-explicit-shared: mut-type-for-explicit-shared
		body: body
		closure: lambda-info.closure.move-to
		type: inst-fun-struct
	# TODO:PERF this check should never fail, so could just set inferred directly with no check ----------------------------------------
	res = check ctx, expected, inst-fun-struct, lambda
	res, body-type

-check-let expr(ctx expr-ctx, ast let-ast, expected expected)
	value-expr, value-type = check-and-expect-or-infer ctx, ast.value, type-from-destructure ctx, ast.destructure
	destructure = check-destructure ctx, ast.destructure, value-type, local
	then_ = check-required-after ctx, ast.destructure.range, destructure, ast.then_, let, expected
	let-expr ast, destructure, value-expr, then_

-check-required-after expr?
	ctx expr-ctx
	diag-range source-range
	locals expression-context
	ast expr-ast?
	kind diag-required-after
	expected expected
do
	if ast
		check-expr-with-context ctx, locals, ast, expected
	else
		unless t = expected.try-get-inexact-non-inferring-type and is-void t
			add-diag ctx, diag-range, kind
			bogus expected, diag-range

-check-list expr(ctx expr-ctx, ast list-ast, expected expected)
	if args expr-ast[] = map-every ast.parts, it.expr-ast
		check-call-list-no-multi ctx, ast, ast.range, args, expected
	else
		do if called = called-for-interpolate-or-list-new ctx, ast.range, "list-new", expected else
			bogus expected, ast.range
		arg-array-type = only! called.param-types
		list-expr ast, called, for part in ast.parts
			match part
			as expr-ast
				check-and-expect ctx, part, arg-array-type.array-element-type!
			as list-ast-part-multi
				list-expr-part-multi check-and-expect ctx, part.arg, arg-array-type

-called-for-interpolate-or-list-new called?(ctx expr-ctx, range source-range, name symbol, expected expected)
	do if result-type = try-get-inexact-non-inferring-type expected else
		add-diag ctx, range, list::diag-needs-expected-type
		()
	find-function-for-interpolate-or-list-new ctx, range, name, result-type

-check-logical expr(ctx expr-ctx, ast logical-ast, expected expected)
	common-types = ctx.common-types
	bool =  common-types.bool
	match ast.kind
	as and_
		left = check-condition ctx, ast.left
		right = check-with-condition ctx, (known-value left, true), of
			check-condition ctx, ast.right
		check ctx, expected, bool, (ast, bool-and-bool, bool, left, right)::logical-expr
	as else_
		left = check-with-modify-expected-option ctx, ast.left, expected, of actual
			add-diag ctx, ast.keyword-range, actual.diag-option-else-left-non-option
		right = check-expr ctx, ast.right, expected
		(ast, option-else, expected.inferred, left, right)::logical-expr
	as or_
		if expected.try-get-inexact-non-inferring-type == bool
			left = check-condition ctx, ast.left
			right = check-condition ctx, ast.right
			(ast, bool-or-bool, bool, left, right)::logical-expr
		else
			left = check-expr ctx, ast.left, expected
			right = check-expr ctx, ast.right, expected
			left-type = type left, ctx.available-types
			right-type = type right, ctx.available-types
			type = expected.inferred
			kind = if type == bool
				bool-or-bool
			else
				if !is-option left-type
					add-diag ctx, ast.range,
						diag-option-or-left-non-option type-with-container ctx, left-type
				elif !is-option right-type
					add-diag ctx, ast.range,
						diag-option-or-right-non-option type-with-container ctx, right-type
				option-or
			(ast, kind, type, left, right)::logical-expr

| Outer expected is 't?', inner expected is 't'
-check-with-modify-expected-option expr
	ctx expr-ctx
	ast expr-ast
	outer expected
	warn-non-option void mut(actual type-with-container)
do
	check-with-modify-expected ctx, outer, ctx.common-types.option[it.as-type-args], of inner
		arg = check-expr ctx, ast, inner
		arg-type = type arg, ctx.available-types
		un-option = unwrap-option-allow-bogus arg-type else
			warn-non-option[type-with-container ctx, arg-type]
			arg-type
		arg, un-option

-check-loop expr(ctx expr-ctx, ast loop-ast, expected expected)
	if type = try-get-inexact-non-inferring-type expected
		loop_ loop-expr = ast, type, bogus-expr ast.range, bogus-type
		info loop-info = loop_, type, false
		loop_.body := check-expr ctx, ast.body, info.to
		if !info.has-break
			add-diag ctx, ast.keyword-range, diag-loop-without-break
		loop_
	else
		add-diag ctx, ast.range, loop_::diag-needs-expected-type
		bogus expected, ast.range

-check-loop-break expr(ctx expr-ctx, ast loop-break-ast, expected expected)
	if loop_ = try-get-loop expected
		loop_.has-break := true
		value = check-or-empty-new ctx, ast, ast.range, ast.value, loop_.type.expect
		loop-break-expr ast, loop_.loop_, value
	else
		add-diag ctx, ast.range, break_::diag-loop-break-or-continue-outside-loop
		bogus expected, ast

-check-loop-continue expr(ctx expr-ctx, ast loop-continue-ast, expected expected)
	if loop_ = try-get-loop expected
		loop-continue-expr ast, loop_.loop_
	else
		add-diag ctx, ast.range, continue_::diag-loop-break-or-continue-outside-loop
		bogus expected, ast

-check-loop-while-or-until expr(ctx expr-ctx, ast loop-while-or-until-ast, expected expected)
	condition = check-condition ctx, ast.condition
	body = check-expr-with-context ctx, (known-value condition, !ast.is-until), ast.body, ctx.void-type.expect
	diag diag-required-after = if ast.is-until then until_ else while_
	after = check-required-after ctx, ast.keyword-range, (known-value condition, ast.is-until), ast.after, diag, expected
	loop-while-or-until-expr ast, condition, body, after

-check-match expr(ctx expr-ctx, ast match-ast, expected expected)
	matched, matched-type = check-and-infer ctx, ast.matched
	local local? = if local = ast.local
		local, matched-type
	if local then add-local ctx, local
	# Use an arbitrary non-matchable inst as default
	inst = matched-type.struct-inst else ctx.common-types.void
	decl = inst.decl
	not-matchable expr mut() = of
		if !is-bogus matched-type
			add-diag ctx, ast.matched.range, (type-with-container ctx, matched-type).diag-match-on-non-matchable
		bogus expected, ast.matched
	res = match body = decl.body
	as struct-body-bogus
		not-matchable[]
	as struct-body-extern-java
		not-matchable[]
	as builtin-type
		if char-type = body.to::char-type?
			check-match-char ctx, ast, expected, local, matched, char-type
		elif integral = body.to::integral-type?
			check-match-scalar ctx, ast, expected, local, matched, integral
		else
			not-matchable[]
	as enum_
		check-match-enum ctx, ast, expected, local, matched, decl, body
	as flags_
		not-matchable[]
	as record_
		if string-like = get-matchable-string-like-from-record ctx.common-types, inst
			check-match-string-like ctx, ast, expected, local, matched, string-like
		else
			not-matchable[]
	as sum-type
		if can-match-sum-type body.kind
			check-match-sum-type ctx, ast, expected, local, matched, inst
		else
			not-matchable[]
	if local
		pop-local ctx
	res

-can-match-sum-type bool(a sum-type-kind)
	match a
	as interface_
		false
	as java-interface
		true
	as union_
		true
	as variant_
		true

-check-match-enum expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched-local local?
	matched expr
	matched-enum struct-decl
	body enum_
do
	remaining enum-or-flags-member mut-set = body.members.to
	has-case-diag mut bool = false
	cases match-enum-case[] = with out in build ast.cases.size
		for case-ast in ast.cases
			as-name = name-from-case-member-ast ctx, case-ast.member
			name = as-name.?name.?name
			if member = (if name then body.members-by-name[name])
				if remove remaining, member
					out ~= member, (check-expr ctx, case-ast.then_, expected)
				else
					has-case-diag := true
					add-diag ctx, case-ast.name-range, name!::diag-match-case-duplicate
			else
				has-case-diag := true
				if name
					add-diag ctx, case-ast.name-range,
						diag-match-case-name-not-in-enum name, matched-enum

	do unless has-case-diag else bogus expected, ast.range

	else_ expr? = if is-empty remaining
		if x = ast.else_
			add-diag ctx, x.keyword-range, diag-match-unnecessary-else
		()
	else
		check-match-else-required ctx, ast, expected, of
			diag-match-unhandled-enum-members remaining.to
	match-enum-expr ast, matched-local, matched, cases, else_, expected.inferred

-check-match-sum-type match-sum-type-expr
	ctx expr-ctx
	ast match-ast
	expected expected
	local local?
	matched expr
	sum-type struct-inst
do
	matched-local = local or as-immut-local-get matched
	cases = check-match-sum-type-cases ctx, matched-local, sum-type, ast.cases, expected
	body = sum-type.decl.body.sum-type!
	is-union = body.kind == union_
	else_ expr? = if is-union
		if cases.size == body.listed-members.size
			if x = ast.else_
				add-diag ctx, x.keyword-range, diag-match-unnecessary-else
			()
		else
			check-match-else-required ctx, ast, expected, of
				diag-match-unhandled-union-case-types list-missing-union-cases sum-type, body, cases
	else
		check-match-else-required ctx, ast, expected, of then variant_::diag-match-needs-else
	match-sum-type-expr ast, local, matched, cases, else_, expected.inferred
-list-missing-union-cases struct-inst[](union_ struct-inst, body sum-type, cases match-sum-type-case[])
	for* member in body.listed-members
		member-inst = instantiate-struct-inst member.member, union_.type-args
		if !exists cases, it.case-type == member-inst
			- member-inst

-as-immut-local-get local?(a expr)
	if res = a.as-local-get and !is-mutable res
		res

-check-match-sum-type-cases match-sum-type-case[]
	ctx expr-ctx
	matched-local local?
	matched-variant struct-inst
	case-asts case-ast[]
	expected expected
do
	seen struct-inst mut-set = ()
	hint-size seen, case-asts.size
	do with out in build case-asts.size
	do for case-ast in case-asts
	do if res = check-match-sum-type-case ctx, matched-local, matched-variant, case-ast.member, case-ast.then_, expected
	if try-add seen, res.case-type
		out ~= res
	else
		add-diag ctx, case-ast.name-range, res.case-type.decl.name::diag-match-case-duplicate

-check-catches catch_[](ctx expr-ctx, asts catch-ast[], expected expected)
	seen struct-inst mut-set = ()
	hint-size seen, asts.size
	do with out in build asts.size
	do for index, ast in with-index asts
	do if res = check-catch ctx, ast, expected, index < asts.size - 1
	if try-add seen, res.caught-type
		out ~= res
	else
		add-diag ctx, ast.keyword-range, res.caught-type.decl.name::diag-match-case-duplicate

-check-catch catch_?(ctx expr-ctx, ast catch-ast, expected expected, require-type bool)
	explicit-caught-type struct-inst? = if as_ = ast.as_
		inst-struct-from-ast ctx.check-ctx, ctx.types, as_.type-name.name, as_.type-name.range, (), ctx.type-params, yes
	if require-type and !explicit-caught-type
		add-diag ctx, ast.keyword-range, diag-catch-else-must-come-last
	caught-type = explicit-caught-type else ctx.common-types.exception
	destructure simple-destructure = if name = ast.name
		(name, caught-type)::local
	else
		destructure-ignore ast, caught-type
	destructure, check-expr-with-context ctx, destructure.to, ast.then_, expected

-check-match-sum-type-case match-sum-type-case?
	ctx expr-ctx
	matched-local local?
	matched-variant struct-inst
	member-ast case-member-ast
	then-ast expr-ast
	expected expected
do
	as-name = name-from-case-member-ast ctx, member-ast
	name = as-name.?name.?name
	do if name
	do if case-type = get-sum-type-case-from-name ctx, matched-variant, name, member-ast.name-range
	if matched-local
		ctx.refined-types ~= matched-local, case-type
	expr = check-expr ctx, then-ast, expected
	if matched-local
		_ = pop! ctx.refined-types
	case-type, expr

-get-sum-type-case-from-name struct-inst?
	ctx expr-ctx
	sum-type struct-inst
	name symbol
	name-range source-range
do
	listed-members = sum-type.decl.body.sum-type!.listed-members
	do if sa = struct-or-alias-from-name ctx.check-ctx, name, name-range, ctx.types-and-specs-map
	match sa
	as struct-alias
		target = sa.target
		is-listed = exists listed-members, it.member == target
		has-membership = exists target.decl.sum-type-memberships, it.sum-type == sum-type
		if is-listed or has-membership
			target
		else
			add-diag ctx, name-range, diag-match-sum-type-no-member (type-with-container ctx, sum-type), target.decl
			()
	as struct-decl
		# TODO: NEATER -------------------------------------------------------------------------------------------------------------------
		from-listed struct-inst? = first listed-members, of x
			if x.member.decl == sa
				instantiate-struct-inst x.member, sum-type.type-args
		if from-listed
			from-listed
		else
			from-membership = first sa.sum-type-memberships, of x
				compare-sum-types ctx, name-range, sa, x.sum-type, sum-type
			if from-membership
				match from-membership
				as struct-inst then from-membership
				as sum-type-case-bogus then ()
			else
				add-diag ctx, name-range,
					diag-match-sum-type-no-member (type-with-container ctx, sum-type), sa
				()

-instantiated-sum-type-case-or-bogus union(struct-inst, sum-type-case-bogus)
-sum-type-case-bogus record

| Returns instantiated case type if the declared sum-type matches the actual
-compare-sum-types instantiated-sum-type-case-or-bogus?
	ctx expr-ctx
	range source-range
	case_ struct-decl
	declared-sum-type struct-inst
	actual-sum-type struct-inst
do
	do if declared-sum-type.decl == actual-sum-type.decl
	with-type-context-for case_.n-type-params, of inferring-context
		inferring-declared-sum-type type-and-context = declared-sum-type, inferring-context
		do if match-types inferring-declared-sum-type, actual-sum-type.non-inferring, exact
		if inferred-types = map-every-type-args inferring-context, it.?type
			case_[inferred-types]
		else
			add-diag ctx, range, case_.diag-match-sum-type-cant-infer-type-args
			sum-type-case-bogus

-check-match-char expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched-local local?
	matched expr
	char-type char-type
do
	seen scalar-value mut-set = ()
	hint-size seen, ast.cases.size
	cases match-scalar-case[] = with out in build ast.cases.size
		do for case-ast in ast.cases
		do if string-value = string-from-case-ast ctx, case-ast.member
		value scalar-value = match char-type
		as char8
			char8-literal-value ctx, case-ast.name-range, string-value 'to
		as char32
			char32-literal-value ctx, case-ast.name-range, string-value 'to
		if try-add seen, value
			out ~= value, check-expr ctx, case-ast.then_, expected
		else
			add-diag ctx, case-ast.name-range, string-value::diag-match-case-duplicate
	else_ = check-match-else-required ctx, ast, expected, of then integral::diag-match-needs-else
	match-scalar-expr ast, char-type, matched-local, matched, cases, else_, expected.inferred

-check-match-scalar expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched-local local?
	matched expr
	integral-type integral-type
do
	seen scalar-value mut-set = ()
	hint-size seen, ast.cases.size
	cases match-scalar-case[] = with out in build
		do for case-ast in ast.cases
		value scalar-value? = match x = case-ast.member
		as as-name-ast
			add-diag ctx, x.name.range, numeric::diag-match-case-for-type
			()
		as literal-number
			check-literal-integral-value ctx.check-ctx, integral-type, x.range
		as literal-string-ast
			add-diag ctx, x.range, numeric::diag-match-case-for-type
			()
		as as-bogus-ast
			()
		do if value
		if try-add seen, value
			out ~= value, check-expr ctx, case-ast.then_, expected
		else
			add-diag ctx, case-ast.name-range, if is-signed integral-type
				value.to::int64::diag-match-case-duplicate
			else
				value.to::nat64::diag-match-case-duplicate
	else_ = check-match-else-required ctx, ast, expected, of then integral::diag-match-needs-else
	match-scalar-expr ast, integral-type, matched-local, matched, cases, else_, expected.inferred

-get-matchable-string-like-from-record string-like-type?(common-types common-types, inst struct-inst)
	if inst == common-types.char32-array
		char32-array
	elif inst == common-types.char8-array
		char8-array
	elif inst == common-types.symbol
		symbol
	elif inst == common-types.string
		string

-check-match-string-like expr
	ctx expr-ctx
	ast match-ast
	expected expected
	matched-local local?
	matched expr
	string-type string-like-type
do
	do if spec_ = get-spec-from-common-module ctx.check-ctx, ctx.types-and-specs-map, ast.keyword-range, "equal", compare else
		bogus expected, ast.range

	matched-type = struct-inst! type matched, ctx.available-types
	equals = check-spec-and-get-last-impl ctx.check-ctx, ctx.funs-map, ast.keyword-range, ctx.type-container, \
		ctx.specs, ctx, instantiate-spec ctx.instantiate-ctx, spec_, matched-type
	seen string mut-set = ()
	cases match-string-like-case[] = with out in build
		do for case-ast in ast.cases
		do if value = string-from-case-ast ctx, case-ast.member
		if try-add seen, value
			out ~= value, check-expr ctx, case-ast.then_, expected
		else
			add-diag ctx, case-ast.name-range, value::diag-match-case-duplicate
	else_ = check-match-else-required ctx, ast, expected, of then string-like::diag-match-needs-else
	match-string-like-expr ast, string-type, matched-local, matched, equals, cases, else_, expected.inferred

-check-match-else-required expr
	ctx expr-ctx
	ast match-ast
	expected expected
	cb-diag diag mut()
do
	if else_ = ast.else_
		check-expr ctx, else_.expr, expected
	else
		add-diag ctx, ast.keyword-range, cb-diag[]
		bogus expected, ast.range

-check-expr-with-condition-or-empty-new expr
	ctx expr-ctx
	parent call-expr-source
	condition expression-context
	ast expr-ast?
	empty-new-range source-range
	expected expected
do
	if ast
		check-expr-with-context ctx, condition, ast, expected
	else
		check-empty-new ctx, parent, empty-new-range, expected
-check-empty-new expr
	ctx expr-ctx
	parent call-expr-source
	range source-range
	expected expected
do
	check-call-list-no-multi ctx, parent, range, (), expected
-check-or-empty-new expr
	ctx expr-ctx
	parent call-expr-source
	empty-new-range source-range
	ast expr-ast?
	expected expected
do
	if ast
		check-expr ctx, ast, expected
	else
		check-empty-new ctx, parent, empty-new-range, expected

-string-from-case-ast string?(ctx expr-ctx, ast case-member-ast)
	match ast
	as as-name-ast
		ast.name.name.to
	as literal-number
		add-diag ctx, ast.range, string-like::diag-match-case-for-type
		()
	as literal-string-ast
		ast.value
	as as-bogus-ast
		()

-name-from-case-member-ast as-name-ast?(ctx expr-ctx, ast case-member-ast)
	res as-name-ast? = ast.as-name-ast
	unless res
		add-diag ctx, ast.name-range, enum-or-union::diag-match-case-for-type
	res

-check-seq expr(ctx expr-ctx, ast seq-ast, expected expected)
	first = check-and-expect ctx, ast.first, ctx.void-type
	then_ = check-expr ctx, ast.then_, expected
	seq-expr first, then_

-check-finally expr(ctx expr-ctx, ast finally-ast, expected expected)
	if try-get-loop expected
		add-diag ctx, ast.finally-keyword-range, finally_::diag-loop-disallowed-body
		bogus expected, ast.range
	else
		right = check-and-expect ctx, ast.right, ctx.void-type
		below = check-expr ctx, ast.below, expected
		finally-expr ast, right, below

-check-try expr(ctx expr-ctx, ast try-ast, expected expected)
	if try-get-loop expected
		add-diag ctx, ast.try-keyword-range, try_::diag-loop-disallowed-body
		bogus expected, ast.range
	else
		body = check-expr ctx, ast.tried, expected
		catches = check-catches ctx, ast.catches, expected
		try-expr ast, body, catches, expected.inferred

-check-try-let expr(ctx expr-ctx, ast try-let-ast, expected expected)
	value-expr, value-type = check-and-expect-or-infer ctx, ast.value, type-from-destructure ctx, ast.destructure
	destructure = check-destructure ctx, ast.destructure, value-type, local
	catch_ = check-catch! ctx, ast.catch_, expected, false
	then_ = check-required-after ctx, ast.try-keyword-range, destructure, ast.after, try-let, expected
	try-let-expr ast, destructure, value-expr, catch_, then_, expected.inferred

-check-typed expr(ctx expr-ctx, ast typed-ast, expected expected)
	type = type-from-ast ctx, ast.type
	do unless is-bogus type else bogus expected, ast.range
	expr = check-or-empty-new ctx, ast, ast.keyword-range, ast.expr, type.expect
	check ctx, expected, type, typed-expr ast, expr, type
