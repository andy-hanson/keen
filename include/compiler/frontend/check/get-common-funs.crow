import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	../../util/enum-map
	../../util/util
	../lang
	./check-ctx
	./get-common-types
	./instantiate

get-common-funs (common-funs, uri-and-diagnostic[])
	modules (common-module, crow-module) enum-map
do instantiate-ctx, common-types
	diags uri-and-diagnostic mut[] = ()
	get-type = of module common-module, name symbol
		only-inst get-struct-decl-or-add-diag diags, modules[module], name, 0
	get-fun-inner = of module crow-module, name symbol, return-type type, params type[]
		instantiate-non-template-fun get-fun-decl diags, module, name,
			type-params: (), return-type: return-type, params: params
	get-fun = of module common-module, name symbol, return-type type, params type[]
		get-fun-inner[modules[module], name, return-type, params]

	json-type = get-type[json, "json"]
	r-shared-of-p = lambda-shared[type-param0, type-param1]
	r-mut-of-p = lambda-mut[type-param0, type-param1]
	json-array = array[json-type]
	t-array = array[type-param0]
	t-array-view = array-view[type-param0]
	t-array-view-array = array[t-array-view]
	t-buffer = buffer[type-param0]
	t-buffer-view = buffer-view[type-param0]
	hash-state = get-type[hash, "hash-state"]
	-
		error: get-type[exception, "error"]
		json-array: json-array
		lambda-subscript: get-lambda-subscript-funs modules[misc]
		shared-of-mut-lambda: get-fun-decl diags, modules[runtime], "shared-of-mut-lambda",
			type-params: two-type-params
			return-type: r-shared-of-p
			params: r-mut-of-p,
		to-array-view: get-fun-decl diags, modules[array-low-level], "to-array-view",
			type-params: one-type-param
			return-type: t-array-view
			params: t-array,
		to-buffer-view: get-fun-decl diags, modules[array-low-level], "to-buffer-view",
			type-params: one-type-param
			return-type: t-buffer-view
			params: t-buffer,
		to-symbol-from-string: get-fun[symbol, "to", symbol, (string,)]
		to-string-from-js-any: get-fun[js, "to", string, (js-any,)]
		hash-nat: for nat-type in make-enum-map
			get-fun[hash, "hash", void, (nat-type.to, hash-state)]
		json-named-new: get-fun[json, "named-new", json-type, (symbol-array, json-array)]
		equal-symbol: get-fun[symbol, "==", bool, (symbol, symbol)]
		show-exception: get-fun[bootstrap, "show", string, (exception,)]
		start-runtime: instantiate-non-template-fun get-fun-decl diags, modules[runtime], "start-runtime",
			type-params: (), return-type: void, params: (), allow-global: true, allow-unsafe: true
		stop-runtime: instantiate-non-template-fun get-fun-decl diags, modules[runtime], "stop-runtime",
			type-params: (), return-type: void, params: (nat64,), allow-global: true, allow-unsafe: true
		concat-array-views: get-fun-decl diags, modules[array], "concat-array-views",
			type-params: one-type-param
			return-type: t-array
			params: t-array-view-array,
	- move-to diags

get-main-fun-and-diagnostics main-fun-and-diagnostics
	program program
	kind main-kind
	targets build-target set
do instantiate-ctx
	diags-builder uri-and-diagnostic mut[] = ()
	the common-types = common-types program
	res main-fun = match kind
	as main-kind-main-function
		get-main-fun diags-builder, module-at-uri program, kind.uri
	as main-kind-tests-in-config
		config = config-at-uri program, kind.config-uri
		if kind.all then test-selector-all config else config
	as main-kind-tests-at-uri
		test-selector test-selector = if line = kind.line
			test-at-line diags-builder, program, kind.crow-uri, line
		elif kind.all
			test-selector-all config module-at-uri program, kind.crow-uri
		else
			kind.crow-uri
		test-selector
	for target in targets
		unless can-run-in-target res, target
			diags-builder ~= res.range-for-diag, target.diag-main-incompatible-with-target
	res, diags-builder.move-to

make-param destructure(name symbol, type type)
	name.local-source-generated, type
make-params destructure[](params type[])
	for index, type in with-index params
		index.name.local-source-generated, type
-name symbol(index nat)
	match index
	as 0 then "a"
	as 1 then "b"
	else then throw unreachable

-test-at-line test-selector(diags-builder uri-and-diagnostic mut[], program program, uri uri, line nat)
	module = module-at-uri program, uri
	lcg = program.line-and-character-getters[uri]
	if test_ = find module.tests, of x then line == line-of-pos lcg, x.range.range.start
		test_
	else
		diags-builder ~= (uri, (range-of-line lcg, line)), line.diag-main-test-missing
		uri

-one-type-param type-params()
	(0, "t"),
-two-type-params type-params()
	(0, "r"), (0, "p")
-type-param0 type()
	(0,)::type-param-index
-type-param1 type()
	(1,)::type-param-index

-get-lambda-subscript-funs (purity, fun-decl) enum-map(misc module)
	subscripts = get-funs misc, "subscript"
	for kind in make-enum-map
		fun = subscripts[kind.to::nat]
		assert fun.params[0].type.as-lambda-type! == kind
		fun

-get-struct-decl-or-add-diag struct-decl
	diags-builder uri-and-diagnostic mut[]
	module crow-module
	name symbol
	n-type-params nat8
do instantiate-ctx
	if res = get-struct-decl module, name and res.n-type-params == n-type-params
		res
	else
		diags-builder ~= (module.uri, ()), name.diag-common-type-missing
		bogus-struct-decl module.uri, name, n-type-params

-get-struct-decl struct-decl?(a module, name symbol)
	a.public-and-internal-exports.types-and-specs[name].?struct-decl

-signature-matches-template bool(actual fun-decl, expected type-params-and-sig)
	actual.specs.instantiated-sigs.size == 0 and
	(!actual.is-global or expected.allow-global) and
	(!actual.is-unsafe or expected.allow-unsafe) and
	actual.n-type-params == expected.type-params.size.to and
	actual.return-type == expected.return-type and
	arrays-correspond actual.params, expected.params, of x, y
		x.type == y

-get-fun-decl fun-decl
	diags-builder uri-and-diagnostic mut[]
	module crow-module
	name symbol
	expected-sig type-params-and-sig
do instantiate-ctx
	get-fun-decl-multi diags-builder, module, name, (expected-sig,) 'decl

-get-main-fun main-fun(diags-builder uri-and-diagnostic mut[], main-module crow-module) instantiate-ctx, common-types
	sig0 type-params-and-sig =
		type-params: ()
		return-type: void
		params: ()
		allow-global: true
		allow-unsafe: true
	sig1 type-params-and-sig =
		type-params: ()
		return-type: nat64
		params: (string-array,)
		allow-global: true
		allow-unsafe: true
	decl = get-fun-decl-multi diags-builder, main-module, "main", (sig0, sig1)
	inst = instantiate-non-template-fun decl.decl
	specs = inst.decl.specs
	unless is-empty specs.all-contexts and is-empty specs.instantiated-sigs
		diags-builder ~= inst.decl.name-range, diag-main-has-specs
	match decl.sig-index
	as 0
		main-fun-void inst
	as 1
		main-fun-nat64-of-args inst
	else
		throw unreachable

-fun-decl-and-sig-index record(decl fun-decl, sig-index nat)
-get-fun-decl-multi fun-decl-and-sig-index
	diags-builder uri-and-diagnostic mut[]
	module crow-module
	name symbol
	expected-sigs type-params-and-sig[]
do instantiate-ctx
	res mut fun-decl-and-sig-index? = ()
	for x in get-funs module, name
		do if index = find-index expected-sigs, of sig then signature-matches-template x, sig
		if res
			diags-builder ~= x.range, name.diag-common-fun-duplicate
		else
			res := x, index
	res else bogus-fun-decl-multi diags-builder, module, name, expected-sigs
-bogus-fun-decl-multi fun-decl-and-sig-index
	diags-builder uri-and-diagnostic mut[]
	module crow-module
	name symbol
	expected-sigs type-params-and-sig[]
do instantiate-ctx
	decl fun-decl =
		hash: next-hash
		source: fun-source-bogus module.uri, name, expected-sigs[0].type-params
		visibility: public
		return-type: expected-sigs[0].return-type
		params: expected-sigs[0].params.make-params
		specs: ()
		doc-comment-references: ()
		body: fun-body-bogus
	diag diag = diag-common-fun-missing decl, expected-sigs
	diags-builder ~= (module.uri, ()), diag
	decl, 0

-get-funs fun-decl array-view(a module, name symbol)
	a.public-and-internal-exports.funs[name]

-instantiate-non-template-fun fun-inst(decl fun-decl)
	instantiate-fun decl, (), decl.specs, ()
