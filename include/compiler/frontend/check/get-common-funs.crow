import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	../../util/enum-map
	../../util/util
	../lang
	./check-ctx
	./get-common-types
	./instantiate

get-common-funs (common-funs, uri-and-diagnostic[])
	ctx instantiate-ctx
	common-types common-types
	modules (common-module, crow-module) enum-map
do
	diags uri-and-diagnostic mut[] = ()
	get-type type mut(module common-module, name symbol) = of module, name
		ctx get-non-template-type diags, modules[module], name
	instantiate-type type mut(decl struct-decl, type-args type-args) = of decl, type-args # todo: inline ------------------------------
		decl[type-args]
	get-fun-inner fun-inst mut(module crow-module, name symbol, return-type type, params type[]) = of module, name, return-type, params
		ctx get-fun diags, module, name, (), return-type, params, 0 instantiate-non-template-fun
	get-fun fun-inst mut(module common-module, name symbol, return-type type, params type[]) = of module, name, return-type, params
		get-fun-inner[modules[module], name, return-type, params]

	array-decl = ctx get-struct-decl-or-add-diag diags, modules[bootstrap], "array", 1
	bool-type = common-types bool
	nat64 = common-types.integrals nat64
	string-type = common-types string
	void = common-types void
	json-type = get-type[json, "json"]
	r-shared-of-p = instantiate-type[common-types.fun-structs[shared_], (type-param0, type-param1).to-type-array]
	r-mut-of-p = instantiate-type[common-types.fun-structs[mut_], (type-param0, type-param1).to-type-array]
	symbol-type = common-types symbol
	symbol-array = instantiate-type[array-decl, symbol-type]
	json-array = instantiate-type[array-decl, json-type.as-type-args]
	t-array = instantiate-type[common-types.array, type-param0.as-type-args]
	-
		error: get-type[exception, "error"] struct-inst!
		json-array: json-array struct-inst!
		lambda-subscript: common-types get-lambda-subscript-funs modules[misc]
		shared-of-mut-lambda: ctx get-fun diags, modules[runtime], "shared-of-mut-lambda", \
			two-type-params, r-shared-of-p, (r-mut-of-p,), 2
		to-symbol-from-string: get-fun[symbol, "to", symbol-type, (string-type,)]
		to-string-from-js-any: get-fun[string, "to", string-type, (common-types.js-any,)]
		json-named-new: get-fun[json, "named-new", json-type, (symbol-array, json-array)]
		equal-symbol: get-fun[symbol, "==", bool-type, (symbol-type, symbol-type)]
		show-exception: get-fun[bootstrap, "show", string-type, (common-types.exception,)]
		start-runtime: get-fun[runtime, "start-runtime", void, ()]
		stop-runtime: get-fun[runtime, "stop-runtime", void, (nat64,)]
		concat-arrays: ctx get-fun diags, modules[array], "~~", one-type-param, t-array, (t-array, t-array), 0
	- diags move-to
-get-fun fun-decl
	ctx instantiate-ctx
	diags-builder uri-and-diagnostic mut[]
	module crow-module
	name symbol
	type-params type-params
	return-type type
	params type[]
	count-specs nat
do
	ctx get-fun-decl diags-builder, module, name, do type-params, return-type, params, count-specs

get-main-fun-and-diagnostics main-fun-and-diagnostics
	ctx instantiate-ctx
	program program
	kind main-kind
	targets build-target set
do
	diags-builder uri-and-diagnostic mut[] = ()
	common-types = program common-types
	res main-fun = match kind
	as main-kind-main-function
		ctx get-main-fun diags-builder, (program module-at-uri kind.uri), common-types
	as main-kind-tests-in-config
		config = program config-at-uri kind.config-uri
		if kind all then config test-selector-all else config
	as main-kind-tests-at-uri
		test-selector test-selector = if line = kind line
			diags-builder test-at-line program, kind.crow-uri, line
		elif kind all
			(program module-at-uri kind.crow-uri).config test-selector-all
		else
			kind crow-uri
		test-selector
	available-externs = (res main-config program) all-externs-for-main-config targets.opt-only
	if res.required-externs !is-subset-of available-externs
		diags-builder ~= res.range-for-diag, (res.required-externs - available-externs).to.diag-main-missing-externs
	res, diags-builder.move-to

make-param destructure(name symbol, type type)
	name.local-source-generated, type
make-params destructure[](params type[])
	for index, type in params with-index
		index.name.local-source-generated, type
-name symbol(index nat)
	match index
	as 0 then "a"
	as 1 then "b"
	else then throw unreachable

-test-at-line test-selector(diags-builder uri-and-diagnostic mut[], program program, uri uri, line nat)
	module = program module-at-uri uri
	lcg = program.line-and-character-getters[uri]
	if test_ = module.tests find lcg[it.range.range.start, start-of-range].line.to::nat64 == line
		test_
	else
		diags-builder ~= (uri, (lcg range-of-line line)), line.diag-main-test-missing
		uri

-one-type-param type-params()
	(0, "t"),
-two-type-params type-params()
	(0, "r"), (0, "p")
-type-param0 type()
	(0,)::type-param-index
-type-param1 type()
	(1,)::type-param-index

-get-lambda-subscript-funs (fun-kind, fun-decl) enum-map(common-types common-types, misc module)
	res (fun-kind, fun-decl?) mut-enum-map = ()
	for x in misc get-funs "subscript"
		# TODO: check the type more thoroughly
		fun-kind = common-types first-arg-fun-kind x
		forbid res[fun-kind]
		res[fun-kind] := x
	for _, x in res
		x!

-first-arg-fun-kind fun-kind(common-types common-types, f fun-decl)
	# TODO: since fun types are builtins now, we don't need common-types for this ........................................................
	actual = f.params[0].type.struct-inst! decl
	members::fun-kind[] find! actual == common-types.fun-structs[it]

-get-non-template-type type(ctx instantiate-ctx, diags-builder uri-and-diagnostic mut[], module crow-module, name symbol)
	decl = ctx get-struct-decl-or-add-diag diags-builder, module, name, 0
	decl only-inst

-get-struct-decl-or-add-diag struct-decl
	ctx instantiate-ctx
	diags-builder uri-and-diagnostic mut[]
	module crow-module
	name symbol
	n-type-params nat
do
	if res = module get-struct-decl name and res.n-type-params == n-type-params
		res
	else
		diags-builder ~= (module.uri, ()), name.diag-common-type-missing
		ctx bogus-struct-decl name, n-type-params

-get-struct-decl struct-decl?(a module, name symbol)
	a.public-and-internal-exports.structs-and-aliases[name] ?struct-decl

-signature-matches-template bool(actual fun-decl, expected type-params-and-sig)
	actual.specs.inner.size == expected.count-specs and
	actual.n-type-params == expected.type-params.size and
	actual.return-type == expected.return-type and
	actual.params arrays-correspond expected.params, of x, y
		x.type == y

-get-fun-decl fun-decl
	ctx instantiate-ctx
	diags-builder uri-and-diagnostic mut[]
	module crow-module
	name symbol
	expected-sig type-params-and-sig
do
	ctx get-fun-decl-multi diags-builder, module, name, (expected-sig,) decl

-get-main-fun main-fun(ctx instantiate-ctx, diags-builder uri-and-diagnostic mut[], main-module crow-module, common-types common-types)
	sig0 type-params-and-sig = (), common-types.void, (), 0
	sig1 type-params-and-sig = (), common-types.integrals.nat64, (common-types.string-array,), 0
	decl = ctx get-fun-decl-multi diags-builder, main-module, "main", (sig0, sig1)
	inst = decl.decl instantiate-non-template-fun
	match decl sig-index
	as 0
		inst main-fun-void
	as 1
		inst main-fun-nat64-of-args
	else
		throw unreachable

-fun-decl-and-sig-index record(decl fun-decl, sig-index nat)
-get-fun-decl-multi fun-decl-and-sig-index
	ctx instantiate-ctx
	diags-builder uri-and-diagnostic mut[]
	module crow-module
	name symbol
	expected-sigs type-params-and-sig[]
do
	res mut fun-decl-and-sig-index? = ()
	for x in module get-funs name
		guard index = expected-sigs find-index of sig then x signature-matches-template sig
		if res
			diags-builder ~= x.range, name.diag-common-fun-duplicate
		else
			res := x, index
	res else ctx bogus-fun-decl-multi diags-builder, module, name, expected-sigs
-bogus-fun-decl-multi fun-decl-and-sig-index
	ctx instantiate-ctx
	diags-builder uri-and-diagnostic mut[]
	module crow-module
	name symbol
	expected-sigs type-params-and-sig[]
do
	decl fun-decl =
		hash: ctx next-hash
		source: module.uri fun-source-bogus name, expected-sigs[0].type-params
		visibility: public
		n-type-params: expected-sigs[0].type-params.size
		return-type: expected-sigs[0].return-type
		params: expected-sigs[0].params.make-params
		flags_: ()
		externs: ()
		specs: ()
		doc-comment-references: ()
		body: fun-body-bogus
	diag diag = decl diag-common-fun-missing for sig in expected-sigs
		sig.type-params, sig.return-type, sig.params, 0
	diags-builder ~= (module.uri, ()), diag
	decl, 0

-get-funs fun-decl array-view(a module, name symbol)
	a.public-and-internal-exports.funs[name]

-instantiate-non-template-fun fun-inst(decl fun-decl)
	decl instantiate-fun (), ()
