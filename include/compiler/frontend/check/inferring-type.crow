import
	crow/col/mut-slice
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/util
	./allocators
	./check-ctx
	./expr-ctx
	./instantiate

| This is logically a *union* of its fields. At most one should be set, or none for inferring.
| Since unions can't be mutable we would have had to wrap, and using a single record is more performant as it avoids indirection.
expected record mut
	| If empty, use 'choices'
	-opt-inferred mut type?
	| If empty, use 'loop'
	-opt-choices mut type-and-context mut[]?
	| If empty, this is purely inferring
	-opt-loop loop-info?
infer expected()
	(), (), ()
expect expected(type type)
	type, (), ()
expect-with-context expected(type type-and-context)
	(), (type,), ()
| Also writes to {info}.{has-break}
to expected(info loop-info)
	(), (), info
to expected(choices type-and-context mut[])
	(), choices, ()

loop-info record mut
	loop_ loop-expr
	type type
	has-break mut bool

to expected(a type-and-context[])
	(), a.to, ()

# TODO:PERF see if it would be faster to just return the 'expr' and call it to get its 'type'
# (reason it might not be: That sometimes requires delving throught it)
expr-and-type record(expr expr, type type)

check-with-modify-expected expr
	outer expected
	# If this returns an empty option, the expected type can't be satisfied.
	cb-modify-expected-type type? mut(x type)
	# This can return a modified type. E.g., if expecting a non-option, it would return the option.
	cb-inner expr-and-type mut(x expected)
do check-expr-ctx
	if x = outer.opt-inferred
		if new-expected = cb-modify-expected-type[x]
			inner expected = expect new-expected
			check inner, cb-inner[inner]
		else
			check outer, cb-inner[infer]
	elif outer-types = outer.opt-choices
		modified-types type-and-context[] = with out in build
			for outer-type in outer-types
				if new-expected = cb-modify-expected-type[outer-type.type]
					out ~= new-expected, outer-type.context
		check outer, cb-inner[if is-empty modified-types then infer else modified-types.to]
	elif outer.opt-loop
		expr cb-inner[outer]
	else
		check outer, cb-inner[infer]

debug string(a expected)
	#show-ctx show-type-ctx = ((), (), (), (false,)), ctx.common-types
	if x = a.opt-inferred
		"local type {debug x}"
	elif choices = a.opt-choices
		x string = join ", ", for choice in choices
			debug choice
		"choices: {x}"
	elif x = a.opt-loop
		"loop returning {debug x.type}"
	else
		"<<inferring>>"

try-get-loop loop-info?(a expected)
	a.opt-loop

| If there is a single supported type, sets 'expected' and returns it.
| If there is no unambiguous choice, adds a diagnostic and returns an empty option.
choose-type nat?
	range source-range
	expected expected
	choices struct-inst[]
do check-expr-ctx
	res = choose-type-allow-none range, expected, choices
	unless res
		add-diag range, diag-literal-not-expected get-expected-for-diag expected
	res

| Same as {choose-type} but does not add a diagnostic if no literal types match.
choose-type-allow-none nat?(range source-range, expected expected, choices struct-inst[]) check-expr-ctx
	res mut nat? = ()
	# For diag
	multiple struct-inst mut[] = ()

	each-choice expected, of choice
		each-narrowed-struct choice, of struct
			do if here = index-of choices, struct
			if res
				rslt-struct = choices[res!]
				if struct != rslt-struct
					if is-empty multiple
						multiple ~= rslt-struct
					elif !contains multiple, struct
						multiple ~= struct
			else
				res := here

	if res
		unless is-empty multiple
			add-diag range, diag-literal-multiple-match type-container, multiple.move-to
		must-check expected, choices[res!]
	res

-each-narrowed-struct void(a type-and-context, f void mut(x struct-inst))
	match type = a.type
	as bogus-type
		()
	as type-param-index
		if is-inferring a.context and inferred = a.context[type.index]
			each-narrowed-struct inferred.type.non-inferring, f
	as struct-inst
		match body = type.decl.body
		as builtin-type
			if body == option
				each-narrowed-struct (type.unwrap-option!, a.context), f
			else
				f[type]
		as sum-type
			if body.kind == union_
				for m in body.listed-members
					# TODO:PERF It would probably help to have all instantiated members precomputed
					inst = instantiate-struct-inst m.member, type.type-args
					each-narrowed-struct (inst, a.context), f
			else
				# This is only used for the expected type for a literal, so don't worry about interface/variant since literals can't implement those
				f[type]
		else
			f[type]
-can-widen-to bool(narrow struct-inst, wide struct-inst)
	# TODO: Can this just use 'match-struct-insts'? ---------------------------------------------------------------------------------------
	# 'narrow' can widen to 'wide' if 'wide' is 'narrow?', or 'wide' is a sum-type containing 'narrow', or transitive
	match body = wide.decl.body
	as builtin-type
		do if body == option
		match w = only! wide.type-args
		as bogus-type
			true
		as type-param-index
			false
		as struct-inst
			is-or-can-widen-to narrow, w
	as sum-type
		if body.kind == union_
			exists body.listed-members, of x
				# TODO:PERF It would probably help to have all instantiated members precomputed
				narrow 'is-or-can-widen-to instantiate-struct-inst x.member, wide.type-args
		else
			exists narrow.decl.sum-type-memberships, of x
				# TODO:PERF It would probably help to have all instantiated members precomputed
				st = instantiate-struct-inst x.sum-type, narrow.type-args
				# TODO:PERF could have a simpler recursion since we already know we're looking for a sum-type.
				# Or could just cache all implemented interfaces
				st 'is-or-can-widen-to wide
	else
		false
-is-or-can-widen-to bool(narrow struct-inst, wide struct-inst)
	narrow == wide or narrow 'can-widen-to wide

-set void(a expected, type type)
	a.opt-inferred := type

set-to-bogus-if-inferring void(a expected)
	if a.opt-inferred
		()
	elif a.opt-choices
		set a, bogus-type
	elif a.opt-loop
		()
	else
		set a, bogus-type

expected-lambda record mut
	lambda-decl struct-decl
	return-type type-and-context
	| Fully inferred, not in type-context.
	instantiated-param-type type
get-expected-lambda expected-lambda?
	source lambda-source
	param-ast destructure-ast?
	expected expected
do check-expr-ctx
	declared-param-type = ?type-from-destructure param-ast
	do unless declared-param-type == bogus-type
	res mut expected-lambda? = ()
	multiple struct-inst mut[] = ()
	any-diag bool reference = false,
	each-choice expected, of choice
		each-narrowed-struct choice, of struct
			do if as-lambda-type struct
			return-type, param-type = only2! struct.type-args
			do if actual-param = get-lambda-param-type source.diag-range, declared-param-type, (param-type, choice.context), any-diag
			prev = res
			res := struct.decl, (return-type, choice.context), actual-param
			if prev
				if is-empty multiple
					multiple ~= apply-inferred prev
				multiple ~= apply-inferred res!
				any-diag set= true
	if any-diag.get
		unless is-empty multiple
			add-diag source.diag-range, diag-lambda-multiple-match ((map multiple, it.identity), type-container)
		()
	else
		if res
			freeze-expected-return-type res!.return-type
		else
			add-diag source.diag-range, diag-lambda-not-expected get-expected-for-diag expected
		res
diag-range source-range(a lambda-source)
	match a
	as for-or-with-ast
		a.keyword-range
	as it-scope-ast
		a.first-it.range
	as lambda-ast
		a.keyword-range
-apply-inferred struct-inst(a expected-lambda)
	return-type = apply-inferred a.return-type
	param-type = a.instantiated-param-type
	a.lambda-decl[to-type-array (return-type, param-type)]

###
If we have an expected type, we should freeze it at this point (to forbid narrowing).
If the user wrote `xs nat?[] = for x in xs ...`, they presumably want the body to have a type of `nat?` not `nat`.
###
-freeze-expected-return-type void(return-type type-and-context)
	if trusted LOG
		log error, "top of freeze-expected-return-type: it is {debug return-type}"
	match type = return-type.type
	as bogus-type
		()
	as type-param-index
		type-context = return-type.context
		if trusted LOG
			log error, "is it inferring? {is-inferring type-context}"
		do if is-inferring type-context
		do if inferred = type-context[type.index]
		if trusted LOG
			log error, "inferred {inferred.debug}"
		do unless inferred.kind == exact
		if trusted LOG
			log error, "overwrite with {(exact, inferred.type)::inference.debug}"
		type-context[type.index] := exact, inferred.type
	as struct-inst
		()

-get-lambda-param-type type?
	diag-range source-range
	declared-param-type type?
	expected-lambda-type-param-type type-and-context
	any-diag bool reference
do check-ctx
	if expected-param-type = try-get-inexact-non-inferring-type expected-lambda-type-param-type
		unless declared-param-type and expected-param-type != declared-param-type
			expected-param-type
	elif declared-param-type
		declared-param-type
	else
		add-diag diag-range, diag-lambda-cant-infer-param-type
		any-diag set= true
		()

-each-choice void(a expected, cb void mut(x type-and-context))
	if x = a.opt-inferred
		cb[non-inferring x]
	elif x = a.opt-choices
		for-loop x, cb

try-get-inexact-non-inferring-type-including-loop type?(expected expected)
	if x = expected.opt-loop
		x.type
	else
		try-get-inexact-non-inferring-type expected

try-get-inexact-non-inferring-type type?(expected expected)
	opt-inferred expected or ?try-get-inexact-non-inferring-type ?only expected.opt-choices

allow-implicit-conversions enum
	no-conversions
	allow-conversions
match-expected-vs-return-type-no-diagnostic bool
	expected expected
	candidate-return-type type-and-context
	conversions allow-implicit-conversions
do
	if trusted LOG # RM ---------------------------------------------------------------------------------------------------------
		log error, "top of match-expected-vs-return-type-no-diagnostic"
		log error, "expected is {debug expected}, candidate-return-type is {debug candidate-return-type}"
	conv implicit-conversions = match conversions
	as no-conversions
		exact
	as allow-conversions
		a-to-b
	res = if x = expected.opt-inferred
		# We have a particular expected type, so infer candidate-return-type's type args
		match-types candidate-return-type, x.non-inferring, conv
	elif choices = expected.opt-choices
		match res = none-or-one-or-many choices, of x then is-type-match-possible candidate-return-type, x, conv
		as none
			false
		as one
			match-types candidate-return-type, res.value, conv
		as many
			# Else don't infer any type args; multiple candidates and multiple possible return types.
			true
	elif expected.opt-loop
		false
	else
		true
	if trusted LOG
		log error, "match-expected-vs-return-type-no-diagnostic returned {res}"
	res

bogus expr(expected expected, ast expr-ast)
	bogus expected, ast.range
bogus expr(expected expected, range source-range)
	set-to-bogus-if-inferring expected
	bogus-expr range, expected.inferred

inferred type(expected expected)
	if x = expected.opt-inferred
		x
	elif choices = expected.opt-choices
		type only! choices
	else
		expected.opt-loop!.type

check expr(expected expected, expr-type type, expr expr) check-expr-ctx
	check expected, (expr, expr-type)
-check expr(expected expected, a expr-and-type) check-expr-ctx
	if try-set-no-diagnostic expected, a.type
		a.expr
	else
		add-diag a.expr.range,
			diag-type-conflict expected.get-expected-for-diag, type-with-container a.type
		set-to-bogus-if-inferring expected
		bogus-wrong-type-expr a.expr, expected.inferred

get-expected-for-diag expected-for-diag(expected expected) check-expr-ctx
	if x = expected.opt-inferred
		expected-for-diag-choices (x,), type-container
	elif choices = expected.opt-choices
		expected-for-diag-choices (map choices, it.apply-inferred), type-container
	elif expected.opt-loop
		expected-for-diag-loop
	else
		expected-for-diag-infer

| Call this when you are certain 'type' satisfies 'expected'. (But it may still be necessary to update expected with a more precise type.)_
must-check void(expected expected, actual type)
	assert try-set-no-diagnostic expected, actual
| This may infer type parameters
-try-set-no-diagnostic bool(expected expected, actual type)
	if trusted LOG
		log error, "top of set-type-no-diagnostic: expected is {debug expected}, actual is {debug actual}"
	if x = expected.opt-inferred
		match-types x.non-inferring, actual.non-inferring, b-to-a
	elif choices = opt-choices expected
		# TODO:PERF: use none-or-one-or-many? -------------------------------------------------------------------------------------------------------
		matching-choices type-and-context[] = filter choices, of x
			match-types x, actual.non-inferring, b-to-a
		match matching-choices.size
		as 0
			false
		as 1
			choice = only! matching-choices
			if trusted LOG
				log error, "choice is {debug choice}"
			t = choice.try-get-inexact-non-inferring-type else
				if trusted LOG
					log error, "choice type is inferring, so set to actual"
				actual
			if trusted LOG
				log error, "Gonna set it to {debug t}"
			# If we're expecting 't' that is inferred to 'nat? exact' preserve that instead of unnecessarily narrowing.
			# TODO: maybe we should just not have 'choices' in the case where there is a single type .................................
			set expected, t
			true
		else
			set expected, actual
			true
	elif expected.opt-loop
		false
	else
		set expected, actual
		true

try-get-exact-non-inferring-type type?(a type-and-context)
	try-get-exact-or-inexact-non-inferring-type a, true
try-get-inexact-non-inferring-type type?(a type-and-context)
	try-get-exact-or-inexact-non-inferring-type a, false
-try-get-exact-or-inexact-non-inferring-type type?(a type-and-context, require-exact bool)
	match type = a.type
	as bogus-type
		bogus-type
	as type-param-index
		if is-inferring a.context
			do if inferred = a.context[type.index]
			do if inferred.kind == exact or !require-exact
			inferred.type
		else
			type
	as struct-inst
		if is-empty type.type-args
			type
		else
			do if new-type-args = map-every-type-args type.type-args, of x
				try-get-exact-or-inexact-non-inferring-type (x, a.context), require-exact
			type.decl[new-type-args]

-replace-uninferred-with-bogus type(a type-and-context)
	match type = a.type
	as bogus-type
		bogus-type
	as type-param-index
		assert is-inferring a.context
		if inferred = a.context[type.index]
			inferred.type
		else
			bogus-type
	as struct-inst
		new-type-args = map-type-args type.type-args, of arg
			replace-uninferred-with-bogus (arg, a.context)
		type.decl[new-type-args]

-try-get-non-inferring inference?(a type-and-context)
	match type = a.type
	as bogus-type
		exact, a.type
	as type-param-index
		if is-inferring a.context
			a.context[type.index]
		else
			exact, a.type
	as struct-inst
		if is-empty type.type-args
			exact, a.type
		else
			do if new-type-args = map-every-type-args type.type-args, of x
				try-get-exact-non-inferring-type (x, a.context)
			exact, type.decl[new-type-args]

| For diagnostics. Applies types that have been inferred, otherwise uses {bogus-type}.
| This is like {try-get-inexact-non-inferring-type} but returns a type with {bogus-type} in it instead of an empty option.
apply-inferred type(a type-and-context)
	match type = a.type
	as bogus-type
		bogus-type
	as type-param-index
		if is-inferring a.context
			a.context[type.index].?type else bogus-type
		else
			type
	as struct-inst
		new-type-args = map-type-args type.type-args, of x
			apply-inferred (x, a.context)
		type.decl[new-type-args]

implicit-conversions enum
	| The type parameter should not be changed any more.
	exact
	| 'b' may be a union, allow converting 'a' to it
	a-to-b
	| 'a' may be a union, allow converting 'b' to it
	b-to-a
== bool(a implicit-conversions, b implicit-conversions)
to symbol(a implicit-conversions)
show string(a implicit-conversions)
	a.to::symbol.show

# Infer information about a candidate based on the declared type on a lambda parameter
infer-type-args-from-lambda-parameter-type void
	expected type-and-context
	declared-lambda-parameter-type type
do
	expected-type = expected.type
	do if struct-inst expected-type and as-lambda-type expected-type
	_, param-type = only2! expected-type.type-args
	infer-type-args-from (param-type, expected.context), declared-lambda-parameter-type.non-inferring
| Infers to {a}.{context}. Doesn't change {b}.
infer-type-args-from void(a type-and-context, b type-and-context)
	do unless is-inferring-non-inferred-type-param b
	b2 = maybe-inferred b
	match a-type = a.type
	as bogus-type
		()
	as type-param-index
		unless a.context[a-type.index] # TODO: are there situations where we want to refine it if the kind is not 'exact'?
			if t = try-get-inexact-non-inferring-type b2
				a.context[a-type.index] := exact, t
	as struct-inst
		do if bi = struct-inst b2.type
		do if a-type.decl == bi.decl
		for i in 0::nat .. a-type.type-args.size
			ta = a-type.type-args[i]
			tb = bi.type-args[i]
			infer-type-args-from (ta, a.context), (tb, b2.context)

is-type-match-possible-for-completions bool(param-type type-with-container, actual-arg-type type)
	inferring type-context = trusted gc-safe-mut-slice param-type.container.n-type-params
	is-type-match-possible (param-type.type, inferring), actual-arg-type.non-inferring, b-to-a

-is-type-match-possible bool(a type-and-context, b type-and-context, conv implicit-conversions)
	# TODO: PERF Avoid the clone! -----------------------------------------------------------------------------------------------
	a-clone type-and-context = a.type, a.context.copy
	match-types a-clone, b, conv

| True for a type param with no inference yet
-is-inferring-non-inferred-type-param bool(a type-and-context)
	if x = a.type.type-param-index
		is-inferring a.context and !a.context[x.index]

-maybe-inferred type-and-context(a type-and-context)
	if x = a.type.type-param-index
		if is-inferring a.context
			# force because we tested 'is-inferring-non-inferred-type-param' before
			non-inferring a.context[x.index]!.type
		else
			a
	else
		a

# RM --------------------------------------------------------------------------------------------------------------------------
enable-inference-log void()
	trusted
	LOG := true
disable-inference-log void()
	trusted
	LOG := false

-LOG global(bool) # RM --------------------------------------------------------------------------------------------------------------

| Returns true if 'a' and 'b' are possibly compatible.
| 'a' may have its type args be inferred, 'b' may not. Unknown types in 'b' are always possibly compatible.
match-types bool(a type-and-context, b type-and-context, conv implicit-conversions)
	if trusted LOG
		log error, "match-types a=({debug a}) b=({debug b}) conv={conv}"
	if is-inferring a.context
		if is-inferring b.context
			match-types-both-inferring a, b, conv
		else
			match-types-no-b-context a, b.type, conv
	elif is-inferring b.context
		!!(match-types-no-a-context (exact, a.type), b, conv)
	else
		!!(match-types-no-context (exact, a.type), b.type, conv)

-match-types-both-inferring bool(a type-and-context, b type-and-context, conv implicit-conversions)
	res bool = match tb = b.type
	as bogus-type
		true
	as type-param-index
		if b-inferred = b.context[tb.index]
			inner-conv implicit-conversions = match conv
			as exact
				match b-inferred.kind
				as exact
					exact
				as allow-narrower
					a-to-b
				as allow-wider
					b-to-a
			as a-to-b
				a-to-b
			as b-to-a
				b-to-a
			match-types-no-b-context a, b-inferred.type, inner-conv
		else
			true
	as struct-inst
		match ta = a.type
		as bogus-type
			false
		as type-param-index
			if a-inferred = a.context[ta.index]
				if x = match-types-no-a-context a-inferred, b, conv
					a.context[ta.index] := x
					true
			elif x = try-get-non-inferring b
				if x.kind == exact
					kind inference-kind = match conv
					as exact
						exact
					as a-to-b
						allow-wider
					as b-to-a
						allow-narrower
					a.context[ta.index] := kind, x.type
				true
			else
				true
		as struct-inst
			match-struct-insts ta, tb, conv, (of x, y, conv2 then match-types (x, a.context), (y, b.context), conv2), of x, y
				match-types (x, a.context), (y, b.context), conv
	if trusted LOG
		log error, "match-types returns {res} from a=({debug a}) b=({debug b}) conv={conv}"
	res

| Returns new inference value for 'a'.
-match-types-no-a-context inference?(a inference, b type-and-context, conv implicit-conversions)
	if trusted LOG
		log error, "match-types-no-a-context a={debug a} b={debug b} conv={conv}"
	match tb = b.type
	as bogus-type
		a
	as type-param-index
		# This function isn't called when 'b' is non-inferring
		assert is-inferring b.context
		if b-inferred = b.context[tb.index]
			match-types-no-context a, b-inferred.type, conv
		else
			# We haven't inferred anything about 'b', so it could match
			a
	as struct-inst
		match ta = a.type
		as bogus-type
			()
		as type-param-index
			()
		as struct-inst
			if ta.decl == tb.decl
				res = zip-every-type-args ta.type-args, tb.type-args, of x, y
					!!(match-types-no-a-context (exact, x), (y, b.context), conv)
				if res
					exact, a.type
			else
				match-types-no-context a, b.replace-uninferred-with-bogus, conv

-match-types-no-b-context bool(a type-and-context, b type, conv implicit-conversions)
	if trusted LOG
		log error, "match-types-no-b-context a=({debug a}) b=({debug b}) conv={conv}"
	res bool = match ta = a.type
	as bogus-type
		false
	as type-param-index
		if is-inferring a.context
			if a-inferred = a.context[ta.index]
				if new-a = match-types-no-context a-inferred, b, conv
					a.context[ta.index] := new-a
					true
			else
				kind inference-kind = match conv
				as exact
					exact
				as a-to-b
					allow-narrower
				as b-to-a
					allow-wider
				a.context[ta.index] := kind, b
				true
		else
			b == a.type
	as struct-inst
		match b
		as bogus-type
			true
		as type-param-index
			if is-option ta.decl and conv == b-to-a
				match-types-no-b-context (ta.type-args.only!, a.context), b, conv
		as struct-inst
			match-struct-insts ta, b, conv, (of x, y, conv2 then match-types-no-b-context (x, a.context), y, conv2), of x, y
				match-types-no-b-context (x, a.context), y, conv
	if trusted LOG
		log error, "match-types-no-b-context returns {res} for a=({debug a}) b=({debug b}) conv={conv}"
	res

-match-struct-insts bool
	sa struct-inst
	sb struct-inst
	conv implicit-conversions
	# TODO: it seems that these callbacks are often nearly the same, is there a better way to do it? ----------------------------
	match-type-args bool mut(x type, y type, conv implicit-conversions)
	match-after-unwrap bool mut(x type, y type)
do
	if trusted LOG
		log error, "match-struct-insts {sa.to::json} {sb.to::json}"
	if sa.decl == sb.decl
		conv2 = if is-option sa.decl then conv else exact
		zip-every-type-args sa.type-args, sb.type-args, of x, y
			match-type-args[x, y, conv2]
	else
		match conv
		as exact
			false
		as a-to-b
			match-struct-insts-a-to-b sa, sb, match-after-unwrap
		as b-to-a
			match-struct-insts-a-to-b sb, sa, of y, x then match-after-unwrap[x, y]
-match-struct-insts-a-to-b bool
	sa struct-inst
	sb struct-inst
	match-after-unwrap bool mut(x type, y type)
do
	match body = sb.decl.body
	as builtin-type
		if body == option
			match-after-unwrap[sa, sb.unwrap-option!]
	as sum-type
		if body.kind == union_
			exists body.listed-members, of x
				member = instantiate-struct-inst x.member, sb.type-args
				match-after-unwrap[sa, member]
		else
			# TODO: interface/variant ... but where is this needed? --------------------------------------------------------------
			false
	else
		false

| Returns new inference value for 'a', or none if they can't match
-match-types-no-context inference?(a inference, b type, conv implicit-conversions)
	if trusted LOG
		log error, "match-types-no-context a={debug a} b={debug b} conv={conv}"
	res inference? = match ta = a.type
	as bogus-type
		()
	as type-param-index
		match b
		as bogus-type
			a
		as type-param-index
			if ta == b
				a
		as struct-inst
			can-widen-a = match conv
			as exact
				a.kind == allow-wider
			as a-to-b
				true
			as b-to-a
				false
			if can-widen-a and is-option b
				match-types-no-context a, b.unwrap-option!, conv
	as struct-inst
		match b
		as bogus-type
			a
		as type-param-index
			can-widen-b = match conv
			as exact
				a.kind == allow-narrower
			as a-to-b
				false
			as b-to-a
				true
			if can-widen-b and is-option ta
				match-types-no-context (a.kind, ta.unwrap-option!), b, conv
		as struct-inst
			if ta.decl == b.decl
				if ta.type-args == b.type-args
					# Need to choose the new inference kind based on 'a.kind' and 'conv'
					(kind-combine a.kind, conv), a.type
				elif is-option ta.decl and conv != exact
					if inner = match-types-no-context (a.kind, ta.type-args.only!), b.type-args.only!, conv
						inner.kind, ta.decl[as-type-args inner.type]
			else
				match conv
				as exact
					match a.kind
					as exact
						()
					as allow-wider
						if can-widen-to ta, b then exact, b
					as allow-narrower
						if can-widen-to b, ta then exact, b
				as a-to-b
					if can-widen-to ta, b then a
				as b-to-a
					if can-widen-to b, ta then a
	if trusted LOG
		log error, "match-types-no-context returns {debug res} for a={debug a} b={debug b} conv={conv}"
	res

-debug string(a inference?)
	if a then debug a else "none"
-debug string(a inference)
	"{a.kind} {debug a.type}"

-kind-combine inference-kind(a inference-kind, conv implicit-conversions)
	match a
	as exact
		exact
	as allow-wider
		match conv
		as a-to-b
			allow-wider
		else
			exact
	as allow-narrower
		match conv
		as b-to-a
			allow-narrower
		else
			exact
