import
	crow/col/mut-slice
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/util
	./allocators
	./expr-ctx
	./instantiate

| This is logically a *union* of its fields. At most one should be set, or none for inferring.
| Since unions can't be mutable we would have had to wrap, and using a single record is more performant as it avoids indirection.
expected record mut, -new
	| If empty, use 'choices'
	opt-inferred mut type?
	| If empty, use 'loop'
	opt-choices mut type-and-context mut[]?
	| If empty, this is purely inferring
	opt-loop loop-info?
infer expected()
	(), (), ()
expect expected(type type)
	type, (), ()
expect-with-context expected(type type, context type-context)
	choice type-and-context = type, context
	(), (choice,), ()
| Also writes to {info}.{has-break}
to expected(info loop-info)
	(), (), info
to expected(choices type-and-context mut[])
	(), choices, ()

loop-info record mut
	loop_ loop-expr
	type type
	has-break mut bool

to expected(a type-and-context[])
	(), a.to, ()

# TODO:PERF see if it would be faster to just return the 'expr' and call it to get its 'type'
# (reason it might not be: That sometimes requires delving throught it)
expr-and-type record(expr expr, type type)

check-with-modify-expected expr
	ctx expr-ctx
	outer expected
	# If this returns an empty option, the expected type can't be satisfied.
	cb-modify-expected-type type? mut(x type)
	# This can return a modified type. E.g., if expecting a non-option, it would return the option.
	cb-inner expr-and-type mut(x expected)
do
	if x ?= outer opt-inferred
		if new-expected ?= cb-modify-expected-type[x]
			inner expected = new-expected expect
			ctx check inner, cb-inner[inner]
		else
			ctx check outer, cb-inner[infer]
	elif outer-types ?= outer opt-choices
		modified-types type-and-context[] = with out in build
			for outer-type in outer-types
				if new-expected ?= cb-modify-expected-type[outer-type type]
					out ~= new-expected, outer-type.context
		inner expected = if modified-types is-empty
			infer 
		else
			modified-types to
		ctx check outer, cb-inner[inner]
	elif _ ?= outer opt-loop
		cb-inner[outer] expr
	else
		inner expected = infer
		ctx check outer, cb-inner[inner]

debug string(a expected)
	#show-ctx show-type-ctx = ((), (), (), (false,)), ctx.common-types
	if x ?= a opt-inferred
		"local type {x debug}"
	elif choices ?= a opt-choices
		x string = ", " join for choice in choices
			choice debug
		"choices: {x}"
	elif x ?= a opt-loop
		"loop returning {x.type debug}"
	else
		"<<inferring>>"

try-get-loop loop-info?(a expected)
	a opt-loop

| Returns an index into {choices} if it is the only allowed choice.
| If there is no unambiguous choice, adds a diagnostic and returns an empty option.
find-expected-struct-for-literal nat?
	ctx expr-ctx
	range source-range
	expected expected
	choices struct-inst[]
do
	ctx find-expected-struct-for-literal-common range, expected, choices, true

find-expected-struct-for-literal-allow-none nat?
	ctx expr-ctx
	range source-range
	expected expected
	choices struct-inst[]
do
	ctx find-expected-struct-for-literal-common range, expected, choices, false

-find-expected-struct-for-literal-common nat?
	ctx expr-ctx
	range source-range
	expected expected
	choices struct-inst[]
	should-add-diag-none bool
do
	res mut nat? = ()
	# For diag
	multiple struct-inst mut[] = ()

	expected each-choice of choice
		choice each-narrowed-struct of struct
			guard here ?= choices index-of struct
			if x ?= res
				rslt-struct = choices[x]
				if struct != rslt-struct
					if multiple is-empty
						multiple ~= rslt-struct
					if struct !in multiple
						multiple ~= struct
			else
				res := here

	if x ?= res
		unless multiple is-empty
			ctx add-diag range,
				ctx.type-container diag-literal-multiple-match multiple.move-to
			expected set-to-type choices[x]
		x
	else
		if should-add-diag-none
			ctx add-diag range,
				ctx get-expected-for-diag expected diag-literal-not-expected
		()


-each-narrowed-struct void(a type-and-context, f void mut(x struct-inst))
	match type = a type
	as bogus-type
		()
	as type-param-index
		guard a.context is-inferring
		guard inferred ?= a.context[type index]
		inferred.type.non-inferring each-narrowed-struct f
	as struct-inst
		match body = type.decl body
		as builtin-type
			if body == option
				(type.unwrap-option!, a.context) each-narrowed-struct f
			else
				f[type]
		as sum-type
			if body.kind == union_
				for m in body listed-members
					# TODO:PERF It would probably help to have all instantiated members precomputed
					inst = m.member instantiate-struct-inst type.type-args
					(inst, a.context) each-narrowed-struct f
			else
				# This is only used for the expected type for a literal, so don't worry about interface/variant since literals can't implement those
				f[type]
		else
			f[type]
-can-widen-to bool(narrow struct-inst, wide struct-inst)
	# TODO: Can this just use 'match-struct-insts'? ---------------------------------------------------------------------------------------
	# 'narrow' can widen to 'wide' if 'wide' is 'narrow?', or 'wide' is a sum-type containing 'narrow', or transitive
	match body = wide.decl body
	as builtin-type
		guard body == option
		match w = wide.type-args only
		as bogus-type
			true
		as type-param-index
			false
		as struct-inst
			narrow is-or-can-widen-to w
	as sum-type
		if body.kind == union_
			body.listed-members exists of x
				# TODO:PERF It would probably help to have all instantiated members precomputed
				member = x.member instantiate-struct-inst wide.type-args
				narrow is-or-can-widen-to member
		else
			narrow.decl.sum-type-memberships exists of x
				# TODO:PERF It would probably help to have all instantiated members precomputed
				st = x.sum-type instantiate-struct-inst narrow.type-args
				# TODO:PERF could have a simpler recursion since we already know we're looking for a sum-type.
				# Or could just cache all implemented interfaces
				st is-or-can-widen-to wide
	else
		false
-is-or-can-widen-to bool(narrow struct-inst, wide struct-inst)
	narrow == wide or narrow can-widen-to wide

-set-to-type void(a expected, type type)
	a.opt-inferred := type

-set-to-bogus void(a expected)
	a set-to-type bogus-type
set-to-bogus-if-inferring void(a expected)
	if _ ?= a opt-inferred
		()
	elif _ ?= a opt-choices
		a set-to-bogus
	elif _ ?= a opt-loop
		()
	else
		a set-to-bogus

expected-lambda-type record mut
	type-context type-context
	fun-type fun-type
	instantiated-param-type type
get-expected-lambda expected-lambda-type?
	ctx expr-ctx
	diag-range source-range
	declared-param-type type?
	expected expected
do
	guard declared-param-type != bogus-type
	res mut expected-lambda-type? = ()
	multiple type mut[] = ()
	any-diag bool reference = false,
	expected each-choice of choice
		choice each-narrowed-struct of struct
			guard fun-type ?= struct get-fun-type
			if actual-param-type ?= ctx get-expected-param-type-from-fun-type diag-range, choice.context, declared-param-type, fun-type, any-diag
				if x ?= res
					if multiple is-empty
						prev = x
						multiple ~= (prev.fun-type.struct-inst, prev.type-context) apply-inferred
					multiple ~= choice apply-inferred
					any-diag set true
				res := choice.context, fun-type, actual-param-type

	if any-diag get
		if multiple !is-empty
			ctx add-diag diag-range, (multiple.move-to, ctx.type-container).diag-lambda-multiple-match
		()
	else
		if x ?= res
			x freeze-expected-return-type
		else
			ctx add-diag diag-range, (ctx get-expected-for-diag expected).diag-lambda-not-expected
		res

###
If we have an expected type, we should freeze it at this point (to forbid narrowing).
If the user wrote `xs nat?[] = for x in xs ...`, they presumably want the body to have a type of `nat?` not `nat`.
###
-freeze-expected-return-type void(a expected-lambda-type)
	if trusted LOG
		error log "top of freeze-expected-return-type: it is {a.fun-type.return-type debug}"
	match type = a.fun-type return-type
	as bogus-type
		()
	as type-param-index
		if trusted LOG
			error log "is it inferring? {a.type-context is-inferring}"
		guard a.type-context is-inferring
		guard inferred ?= a.type-context[type index]
		if trusted LOG
			error log "inferred {inferred debug}"
		guard inferred.kind != exact
		if trusted LOG
			error log "overwrite with {(exact, inferred.type)::inference debug}"
		a.type-context[type index] := exact, inferred.type
	as struct-inst
		()

-get-expected-param-type-from-fun-type type?
	ctx expr-ctx
	diag-range source-range
	type-context type-context
	declared-param-type type?
	fun-type fun-type
	any-diag bool reference
do
	if expected-param-type ?= (fun-type.param-type, type-context) try-get-inexact-non-inferring-type
		unless x ?= declared-param-type and expected-param-type != x
			expected-param-type
	elif x ?= declared-param-type
		x
	else
		ctx add-diag diag-range, diag-lambda-cant-infer-param-type
		any-diag set true
		()

-each-choice void(a expected, cb void mut(x type-and-context))
	if x ?= a opt-inferred
		cb[x non-inferring]
	elif x ?= a opt-choices
		x for-loop cb

try-get-inexact-non-inferring-type-including-loop type?(expected expected)
	if x ?= expected opt-loop
		x type
	else
		expected try-get-inexact-non-inferring-type

try-get-inexact-non-inferring-type type?(expected expected)
	expected opt-inferred or expected.opt-choices.?opt-only ?try-get-inexact-non-inferring-type

allow-implicit-conversions enum
	no-conversions
	allow-conversions
match-expected-vs-return-type-no-diagnostic bool
	expected expected
	candidate-return-type type-and-context
	conversions allow-implicit-conversions
do
	if trusted LOG # RM ---------------------------------------------------------------------------------------------------------
		error log "top of match-expected-vs-return-type-no-diagnostic"
		error log "expected is {expected debug}, candidate-return-type is {candidate-return-type debug}"
	conv implicit-conversions = match conversions
	as no-conversions
		exact
	as allow-conversions
		a-to-b
	res = if x ?= expected opt-inferred
		# We have a particular expected type, so infer candidate-return-type's type args
		candidate-return-type match-types x.non-inferring, conv
	elif choices ?= expected opt-choices
		match res = choices none-or-one-or-many of x then candidate-return-type is-type-match-possible x, conv
		as none
			false
		as one
			candidate-return-type match-types res.value, conv
		as many
			# Else don't infer any type args; multiple candidates and multiple possible return types.
			true
	elif _ ?= expected opt-loop
		false
	else
		true
	if trusted LOG
		error log "match-expected-vs-return-type-no-diagnostic returned {res}"
	res

bogus expr(expected expected, ast expr-ast)
	expected bogus ast.range
bogus expr(expected expected, range source-range)
	expected set-to-bogus-if-inferring
	range bogus-expr expected.inferred

inferred type(expected expected)
	if x ?= expected opt-inferred
		x
	elif choices ?= expected opt-choices
		choices.only type
	else
		expected.opt-loop! type

check expr(ctx expr-ctx, expected expected, expr-type type, expr expr)
	ctx check expected, (expr, expr-type)
-check expr(ctx expr-ctx, expected expected, a expr-and-type)
	if expected set-type-no-diagnostic a.type
		a expr
	else
		ctx add-diag a.expr.range,
			ctx get-expected-for-diag expected diag-type-conflict (ctx type-with-container a.type)
		expected set-to-bogus-if-inferring
		a.expr bogus-wrong-type-expr expected.inferred

get-expected-for-diag expected-for-diag(ctx expr-ctx, expected expected)
	if x ?= expected opt-inferred
		(x,) expected-for-diag-choices ctx.type-container
	elif choices ?= expected opt-choices
		(for x in choices then x apply-inferred) expected-for-diag-choices ctx.type-container
	elif _ ?= expected opt-loop
		expected-for-diag-loop
	else
		expected-for-diag-infer

| This may infer type parameters
-set-type-no-diagnostic bool(expected expected, actual type)
	if trusted LOG
		error log "top of set-type-no-diagnostic: expected is {expected debug}, actual is {actual debug}"
	if x ?= expected opt-inferred
		x.non-inferring match-types actual.non-inferring, b-to-a
	elif choices ?= expected opt-choices
		# TODO:PERF: use none-or-one-or-many? -------------------------------------------------------------------------------------------------------
		matching-choices type-and-context[] = choices filter of x
			x match-types actual.non-inferring, b-to-a
		match matching-choices size
		as 0
			false
		as 1
			choice = matching-choices only
			if trusted LOG
				error log "choice is {choice debug}"
			t = choice.try-get-inexact-non-inferring-type else
				if trusted LOG
					error log "choice type is inferring, so set to actual"
				actual
			if trusted LOG
				error log "Gonna set it to {t debug}"
			# If we're expecting 't' that is inferred to 'nat? exact' preserve that instead of unnecessarily narrowing.
			# TODO: maybe we should just not have 'choices' in the case where there is a single type .................................
			expected set-to-type t
			true
		else
			expected set-to-type actual
			true
	elif _ ?= expected opt-loop
		false
	else
		expected set-to-type actual
		true

try-get-exact-non-inferring-type type?(a type-and-context)
	a try-get-exact-or-inexact-non-inferring-type true
try-get-inexact-non-inferring-type type?(a type-and-context)
	a try-get-exact-or-inexact-non-inferring-type false
-try-get-exact-or-inexact-non-inferring-type type?(a type-and-context, require-exact bool)
	match type = a type
	as bogus-type
		bogus-type
	as type-param-index
		if a.context is-inferring
			guard inferred ?= a.context[type index]
			guard inferred.kind == exact or !require-exact
			inferred type
		else
			type
	as struct-inst
		if type.type-args is-empty
			type
		else
			new-type-args type-args? = type.type-args map-every-type-args of x
				(x, a.context) try-get-exact-or-inexact-non-inferring-type require-exact
			if x ?= new-type-args
				type.decl[x]

-replace-uninferred-with-bogus type(a type-and-context)
	match type = a type
	as bogus-type
		bogus-type
	as type-param-index
		assert a.context is-inferring
		if inferred ?= a.context[type index]
			inferred type
		else
			bogus-type
	as struct-inst
		type.decl[type.type-args map-type-args (it, a.context).replace-uninferred-with-bogus]

-try-get-non-inferring inference?(a type-and-context)
	match type = a type
	as bogus-type
		exact, a.type
	as type-param-index
		if a.context is-inferring
			a.context[type index]
		else
			exact, a.type
	as struct-inst
		if type.type-args is-empty
			exact, a.type
		else
			new-type-args = type.type-args map-every-type-args of x
				(x, a.context) try-get-exact-non-inferring-type
			if ta ?= new-type-args
				exact, type.decl[ta]

fun-type record(kind fun-kind, struct-inst struct-inst)
fun-struct struct-decl(a fun-type)
	a.struct-inst decl
return-type type(a fun-type)
	a.struct-inst.type-args.only2 a
param-type type(a fun-type)
	a.struct-inst.type-args.only2 b

get-fun-type fun-type?(a type)
	a.struct-inst ?get-fun-type
get-fun-type fun-type?(a struct-inst)
	guard x ?= a.decl.body builtin-type
	guard kind ?= x.to::fun-kind?
	kind, a # TODO: returning its own input is kind of silly......................................................................

| For diagnostics. Applies types that have been inferred, otherwise uses {bogus-type}.
| This is like {try-get-inexact-non-inferring-type} but returns a type with {bogus-type} in it instead of an empty option.
apply-inferred type(a type-and-context)
	match type = a type
	as bogus-type
		bogus-type
	as type-param-index
		if a.context is-inferring
			a.context[type index] ?type else bogus-type
		else
			type
	as struct-inst
		type.decl[type.type-args map-type-args (it, a.context).apply-inferred]

implicit-conversions enum
	| The type parameter should not be changed any more.
	exact
	| 'b' may be a union, allow converting 'a' to it
	a-to-b
	| 'a' may be a union, allow converting 'b' to it
	b-to-a
== bool(a implicit-conversions, b implicit-conversions)
to symbol(a implicit-conversions)
show string(a implicit-conversions)
	a.to::symbol show

| TODO: this would probably be more readable if it took a {type-and-context} ----------------------------------------------------
infer-type-args-from-lambda-parameter-type void
	a type
	a-context type-context
	lambda-parameter-type type
do
	if fun-type ?= a get-fun-type
		fun-type.param-type infer-type-args-from a-context, lambda-parameter-type.non-inferring
| Infers to {a-context}. Doesn't change {b}.
infer-type-args-from void(a type, a-context type-context, b type-and-context)
	guard b !is-inferring-non-inferred-type-param
	b2 = b maybe-inferred
	match a
	as bogus-type
		()
	as type-param-index
		unless _ ?= a-context[a index] # TODO: are there situations where we want to refine it if the kind is not 'exact'?
			if t ?= b2 try-get-inexact-non-inferring-type
				a-context[a index] := exact, t
	as struct-inst
		guard bi ?= b2.type struct-inst
		guard a.decl == bi.decl
		for i in 0::nat .. a.type-args.size
			ta = a.type-args[i]
			tb = bi.type-args[i]
			ta infer-type-args-from a-context, (tb, b2.context)

is-type-match-possible-for-completions bool(param-type type-with-container, actual-arg-type type)
	inferring type-context = trusted param-type.container.n-type-params gc-safe-mut-slice
	(param-type.type, inferring) is-type-match-possible actual-arg-type.non-inferring, b-to-a

-is-type-match-possible bool(a type-and-context, b type-and-context, conv implicit-conversions)
	# TODO: PERF Avoid the clone! -----------------------------------------------------------------------------------------------
	a-clone type-and-context = a.type, a.context.copy
	a-clone match-types b, conv

| True for a type param with no inference yet
-is-inferring-non-inferred-type-param bool(a type-and-context)
	if x ?= a.type type-param-index
		a.context is-inferring and !(_ ?= a.context[x index])

-maybe-inferred type-and-context(a type-and-context)
	if x ?= a.type type-param-index
		if a.context is-inferring
			# force because we tested 'is-inferring-non-inferred-type-param' before
			a.context[x index]!.type non-inferring
		else
			a
	else
		a

# RM --------------------------------------------------------------------------------------------------------------------------
enable-inference-log void()
	trusted
	LOG := true
disable-inference-log void()
	trusted
	LOG := false
is-inference-log-enabled bool()
	trusted
	LOG

-LOG global(bool) # RM --------------------------------------------------------------------------------------------------------------

| Returns true if 'a' and 'b' are possibly compatible.
| 'a' may have its type args be inferred, 'b' may not. Unknown types in 'b' are always possibly compatible.
match-types bool(a type-and-context, b type-and-context, conv implicit-conversions)
	if trusted LOG
		error log "match-types a=({a debug}) b=({b debug}) conv={conv}"
	if a.context is-inferring
		if b.context is-inferring
			a match-types-both-inferring b, conv
		else
			a match-types-no-b-context b.type, conv
	elif b.context is-inferring
		_ ?= (exact, a.type) match-types-no-a-context b, conv
	else
		_ ?= (exact, a.type) match-types-no-context b.type, conv

-match-types-both-inferring bool(a type-and-context, b type-and-context, conv implicit-conversions)
	res bool = match tb = b type
	as bogus-type
		true
	as type-param-index
		if b-inferred ?= b.context[tb index]
			inner-conv implicit-conversions = match conv
			as exact
				match b-inferred kind
				as exact
					exact
				as allow-narrower
					a-to-b
				as allow-wider
					b-to-a
			as a-to-b
				a-to-b
			as b-to-a
				b-to-a
			a match-types-no-b-context b-inferred.type, inner-conv
		else
			true
	as struct-inst
		match ta = a type
		as bogus-type
			false
		as type-param-index
			if a-inferred ?= a.context[ta index]
				if x ?= a-inferred match-types-no-a-context b, conv
					a.context[ta index] := x
					true
			elif x ?= b try-get-non-inferring
				if x.kind == exact
					kind inference-kind = match conv
					as exact
						exact
					as a-to-b
						allow-wider
					as b-to-a
						allow-narrower
					a.context[ta index] := kind, x.type
				true
			else
				true
		as struct-inst
			ta match-struct-insts tb, conv, (of x, y, conv2 then (x, a.context) match-types (y, b.context), conv2), of x, y
				(x, a.context) match-types (y, b.context), conv
	if trusted LOG
		error log "match-types returns {res} from a=({a debug}) b=({b debug}) conv={conv}"
	res

| Returns new inference value for 'a'.
-match-types-no-a-context inference?(a inference, b type-and-context, conv implicit-conversions)
	if trusted LOG
		error log "match-types-no-a-context a={a debug} b={b debug} conv={conv}"
	match tb = b type
	as bogus-type
		a
	as type-param-index
		# This function isn't called when 'b' is non-inferring
		assert b.context is-inferring
		if b-inferred ?= b.context[tb index]
			a match-types-no-context b-inferred.type, conv
		else
			# We haven't inferred anything about 'b', so it could match
			a
	as struct-inst
		match ta = a type
		as bogus-type
			()
		as type-param-index
			()
		as struct-inst
			if ta.decl == tb.decl
				res = ta.type-args zip-every-type-args tb.type-args, of x, y
					_ ?= (exact, x) match-types-no-a-context (y, b.context), conv
				if res
					exact, a.type
			else
				a match-types-no-context b.replace-uninferred-with-bogus, conv

-match-types-no-b-context bool(a type-and-context, b type, conv implicit-conversions)
	if trusted LOG
		error log "match-types-no-b-context a=({a debug}) b=({b debug}) conv={conv}"
	res bool = match ta = a type
	as bogus-type
		false
	as type-param-index
		if a.context is-inferring
			if a-inferred ?= a.context[ta index]
				if new-a ?= a-inferred match-types-no-context b, conv
					a.context[ta index] := new-a
					true
			else
				kind inference-kind = match conv
				as exact
					exact
				as a-to-b
					allow-narrower
				as b-to-a
					allow-wider
				a.context[ta index] := kind, b
				true
		else
			b == a.type
	as struct-inst
		match b
		as bogus-type
			true
		as type-param-index
			if ta.decl is-option and conv == b-to-a
				(ta.type-args.only, a.context) match-types-no-b-context b, conv
		as struct-inst
			ta match-struct-insts b, conv, (of x, y, conv2 then (x, a.context) match-types-no-b-context y, conv2), of x, y
				(x, a.context) match-types-no-b-context y, conv
	if trusted LOG
		error log "match-types-no-b-context returns {res} for a=({a debug}) b=({b debug}) conv={conv}"
	res

-match-struct-insts bool
	sa struct-inst
	sb struct-inst
	conv implicit-conversions
	# TODO: it seems that these callbacks are often nearly the same, is there a better way to do it? ----------------------------
	match-type-args bool mut(x type, y type, conv implicit-conversions)
	match-after-unwrap bool mut(x type, y type)
do
	if trusted LOG
		error log "match-struct-insts {sa.to::json} {sb.to::json}"
	if sa.decl == sb.decl
		conv2 = if sa.decl is-option then conv else exact
		sa.type-args zip-every-type-args sb.type-args, of x, y
			match-type-args[x, y, conv2]
	else
		match conv
		as exact
			false
		as a-to-b
			sa match-struct-insts-a-to-b sb, match-after-unwrap
		as b-to-a
			sb match-struct-insts-a-to-b sa, of y, x then match-after-unwrap[x, y]
-match-struct-insts-a-to-b bool
	sa struct-inst
	sb struct-inst
	match-after-unwrap bool mut(x type, y type)
do
	match body = sb.decl body
	as builtin-type
		guard body == option
		match-after-unwrap[sa, sb.unwrap-option!]
	as sum-type
		if body.kind == union_
			body.listed-members exists of x
				member = x.member instantiate-struct-inst sb.type-args
				match-after-unwrap[sa, member]
		else
			# TODO: interface/variant ... but where is this needed? --------------------------------------------------------------
			false
	else
		false

| Returns new inference value for 'a', or none if they can't match
-match-types-no-context inference?(a inference, b type, conv implicit-conversions)
	if trusted LOG
		error log "match-types-no-context a={a debug} b={b debug} conv={conv}"
	res inference? = match ta = a type
	as bogus-type
		()
	as type-param-index
		match b
		as bogus-type
			a
		as type-param-index
			if ta == b
				a
		as struct-inst
			can-widen-a = match conv
			as exact
				a.kind == allow-wider
			as a-to-b
				true
			as b-to-a
				false
			if can-widen-a and b is-option-type
				a match-types-no-context b.unwrap-option!, conv
	as struct-inst
		match b
		as bogus-type
			a
		as type-param-index
			can-widen-b = match conv
			as exact
				a.kind == allow-narrower
			as a-to-b
				false
			as b-to-a
				true
			if can-widen-b and ta is-option-type
				(a.kind, ta.unwrap-option!) match-types-no-context b, conv
		as struct-inst
			if ta.decl == b.decl
				if ta.type-args == b.type-args
					# Need to choose the new inference kind based on 'a.kind' and 'conv'
					(a.kind kind-combine conv), a.type
				elif ta.decl is-option and conv != exact
					if inner ?= (a.kind, ta.type-args.only) match-types-no-context b.type-args.only, conv
						inner.kind, ta.decl[inner.type as-type-args]
			else
				match conv
				as exact
					match a kind
					as exact
						()
					as allow-wider
						if ta can-widen-to b then exact, b
					as allow-narrower
						if b can-widen-to ta then exact, b
				as a-to-b
					if ta can-widen-to b then a
				as b-to-a
					if b can-widen-to ta then a
	if trusted LOG
		error log "match-types-no-context returns {res debug} for a={a debug} b={b debug} conv={conv}"
	res

-debug string(a inference?)
	if x ?= a
		x debug
	else
		"none"
-debug string(a inference)
	"{a kind} {a.type debug}"

-kind-combine inference-kind(a inference-kind, conv implicit-conversions)
	match a
	as exact
		exact
	as allow-wider
		match conv
		as a-to-b
			allow-wider
		else
			exact
	as allow-narrower
		match conv
		as b-to-a
			allow-narrower
		else
			exact
