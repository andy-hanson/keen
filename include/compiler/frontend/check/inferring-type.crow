import
	crow/col/mut-slice
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/util
	../show-model
	./allocators
	./expr-ctx
	./instantiate

| This is logically a *union* of its fields. At most one should be set, or none for inferring.
| Since unions can't be mutable we would have had to wrap, and using a single record is more performant as it avoids indirection.
expected record mut, -new
	| If empty, use 'choices'
	opt-inferred mut type?
	| If empty, use 'loop'
	opt-choices mut type-and-context mut[]?
	| If empty, this is purely inferring
	opt-loop loop-info?
infer expected()
	(), (), ()
expect expected(type type)
	(type,), (), ()
expect-with-context expected(type type, context type-context)
	(), (((type, context),),), ()
| Also writes to {info}.{has-break}
to expected(info loop-info)
	(), (), (info,)

loop-info record mut
	loop_ loop-expr
	type type
	has-break mut bool

to expected(a type-and-context[])
	(), (a.to,), ()

-set-inferred void(a type-context, param type-param-index, type type)
	forbid _ ?= a[param index]
	a[param index] := type,
-try-get-inferred type?(a type-context, param type-param-index) # TODO: just inline it ----------------------------------------------
	a[param index]

| In the type checker, an expression 'type' funciton might not be callable due to late initialization/
| For example, a {closure-get-expr} accesses its type from the lambda, which might not be initialized yet.
| So we instead pass the type explicitly.
expr-and-type record(expr expr, type type)

check-with-modify-expected expr(
	ctx expr-ctx,
	outer expected,
	# If this returns an empty option, the expected type can't be satisfied.
	cb-modify-expected-type type[]? mut(x type),
	# This can return a modified type. E.g., if expecting a non-option, it would return the option.
	cb-inner expr-and-type mut(x expected),
)
	if x ?= outer opt-inferred
		if new-expected ?= cb-modify-expected-type[x]
			with-context type-and-context[] = for xx : new-expected; xx non-inferring
			inner expected = with-context to
			ctx check inner, cb-inner[inner]
		else
			inner expected = infer
			ctx check outer, cb-inner[inner]
	elif outer-types ?= outer opt-choices
		modified-types type-and-context[] = with out : build
			for outer-type : outer-types
				if new-expected ?= cb-modify-expected-type[outer-type type]
					for t : new-expected
						out ~= (t, outer-type.context)
		inner expected = if modified-types is-empty
			infer 
		else
			modified-types to
		ctx check outer, cb-inner[inner]
	elif _ ?= outer opt-loop
		cb-inner[outer] expr
	else
		inner expected = infer
		ctx check outer, cb-inner[inner]

with-expect expr(type type, cb expr mut(x expected)			)
	expected = infer
	expected.opt-inferred := type,
	cb[expected]
with-expect expr-and-type(type type, context type-context, cb expr mut(x expected))
	t type-and-context mut[] = (type, context),
	expected = infer
	expected.opt-choices := t,
	expr = cb[expected]
	expr, expected.inferred

expr-and-option-type record(option expr, non-option-type type)
with-expect-option expr-and-option-type(
	allocators allocators,
	instantiate-ctx instantiate-ctx,
	common-types common-types,
	cb expr mut(x expected),
)
	type-args type[] = 0.type-param-index,
	option-t type = instantiate-ctx instantiate-struct common-types.option, type-args to
	allocators with-type-context-for 1, inferring-types =>
		inner = cb[option-t expect-with-context inferring-types]
		inner-type = inferring-types[0] ?? bogus-type
		inner, inner-type

with-expect-candidates type(candidates type-and-context mut[], cb void mut(x expected)) # TODO: avoid the 'with'? -----------------------------
	expected = infer
	expected.opt-choices := candidates,
	cb[expected]
	expected inferred

debug-show string(ctx expr-ctx, a expected)
	show-ctx show-type-ctx = ((), (), (), (false,)), ctx.common-types
	if x ?= a opt-inferred
		"local type {show-ctx show-type-unquoted (ctx type-with-container x)}"
	elif choices ?= a opt-choices
		x string = ", " join for choice : choices
			show-ctx debug-show-expected-choice ctx.type-container, choice
		"choices: {x}"
	elif x ?= a opt-loop
		"loop returning {show-ctx show-type-unquoted (ctx type-with-container x.type)}"
	else
		"<<inferring>>"
-debug-show-expected-choice string(show-ctx show-type-ctx, container type-container, choice type-and-context)
	match choice type
	as bogus-type 
		"<<bogus>>"
	as type-param-index x
		desc string = if choice.context is-inferring
			if inferred ?= choice.context try-get-inferred x
				"inferred as {show-ctx show-type-unquoted (inferred, container)}"
			else
				"with no inferernce"
		else
			"with no inference"
		"type param {x index} {desc}"
	as struct-inst x
		name = x.decl name
		if x.type-args is-empty
			"{name}"
		else
			args string = ", " join for type-arg : x.type-args inner
				show-ctx debug-show-expected-choice container, (type-arg, choice.context)
			if x.type-args.size == 1
				"{args} {name}"
			else
				"({args}) {name}"

try-get-loop loop-info?(a expected)
	a opt-loop

| Returns an index into {choices} if it is the only allowed choice.
| If there is no unambiguous choice, adds a diagnostic and returns an empty option.
find-expected-struct-for-literal nat?(
	ctx expr-ctx,
	range source-range,
	expected expected,
	choices struct-inst[],
)
	rslt mut nat? = ()
	ambiguous mut = false
	# For diag
	multiple struct-inst mut[] = ()

	handle-struct void mut(x struct-inst) = struct =>
		if here ?= choices index-of struct
			if x ?= rslt
				rslt-struct = choices[x]
				if struct != rslt-struct
					if multiple is-empty
						multiple ~= rslt-struct
					if struct !in multiple
						multiple ~= struct
			else
				rslt := here,

	expected each-choice choice =>
		match choice type
		as bogus-type
			ambiguous := true
		as type-param-index index
			if inferred ?= choice.context try-get-inferred index
				match inferred
				as bogus-type
					ambiguous := true
				as type-param-index _
					()
				as struct-inst x
					handle-struct[x]
			else
				ambiguous := true
		as struct-inst x
			handle-struct[x]

	if ambiguous || rslt is-empty
		ctx add-diag range, (ctx get-expected-for-diag expected).diag-literal-not-expected
		()
	elif multiple is-empty
		rslt
	else
		ctx add-diag range, (ctx.type-container diag-literal-multiple-match multiple.move-to)
		()

-set-to-type void(a expected, type type)
	a.opt-inferred := type,

-set-to-bogus void(a expected)
	a set-to-type bogus-type
set-to-bogus-if-inferring void(a expected)
	if _ ?= a opt-inferred
		()
	elif _ ?= a opt-choices
		a set-to-bogus
	elif _ ?= a opt-loop
		()
	else
		a set-to-bogus

expected-lambda-type record(type-context type-context, fun-type fun-type, instantiated-param-type type) mut
get-expected-lambda expected-lambda-type?(
	ctx expr-ctx,
	diag-range source-range,
	declared-param-type type?,
	expected expected
)
	guard declared-param-type != (bogus-type,) : ()
	res mut expected-lambda-type? = ()
	multiple type mut[] = ()
	any-diag bool reference = false,
	expected each-choice choice =>
		if fun-type ?= ctx get-expected-fun-type diag-range, choice
			if actual-param-type ?= ctx get-expected-param-type-from-fun-type diag-range, choice.context, declared-param-type, fun-type, any-diag
				if x ?= res
					if multiple is-empty
						prev = x
						multiple ~= ctx.instantiate-ctx apply-inferred (prev.fun-type.struct-inst.to, prev.type-context)
					multiple ~= ctx.instantiate-ctx apply-inferred choice
					*any-diag := true
				res := (choice.context, fun-type, actual-param-type),

	if *any-diag
		if multiple !is-empty
			ctx add-diag diag-range, (multiple.move-to, ctx.type-container).diag-lambda-multiple-match
		()
	else
		if res is-empty
			ctx add-diag diag-range, (ctx get-expected-for-diag expected).diag-lambda-not-expected
		res

-get-expected-fun-type fun-type?(ctx expr-ctx, diag-range source-range, choice type-and-context)
	t type? = if x ?= choice.type type-param-index
		choice.context try-get-inferred x
	else
		choice.type,
	if x ?= t
		x get-fun-type
	else
		ctx add-diag diag-range, diag-lambda-cant-infer-param-type
		()

-get-expected-param-type-from-fun-type type?(
	ctx expr-ctx,
	diag-range source-range,
	type-context type-context,
	declared-param-type type?,
	fun-type fun-type,
	any-diag bool reference,
)
	if expected-param-type ?= ctx.instantiate-ctx try-get-non-inferring-type (fun-type.param-type, type-context)
		if declared-param-type is-empty || expected-param-type == declared-param-type! # TODO: simplify (just use == on options)
			expected-param-type,
	elif x ?= declared-param-type
		x,
	else
		ctx add-diag diag-range, diag-lambda-cant-infer-param-type
		*any-diag := true
		()

-each-choice void(a expected, cb void mut(x type-and-context))
	if x ?= a opt-inferred
		cb[x non-inferring]
	elif x ?= a opt-choices
		x for-loop cb

try-get-non-inferring-type-including-loop type?(ctx instantiate-ctx, expected expected)
	if x ?= expected opt-loop
		x.type,
	else
		ctx try-get-non-inferring-type expected

try-get-non-inferring-type type?(ctx instantiate-ctx, expected expected)
	if x ?= expected opt-inferred
		x,
	elif x ?= expected opt-choices
		if x.size == 1
			ctx try-get-non-inferring-type x.only

match-expected-vs-return-type-no-diagnostic bool(
	ctx instantiate-ctx,
	expected expected,
	candidate-return-type type-and-context,
)
	if x ?= expected opt-inferred
		# We have a particular expected type, so infer its type args
		# TODO: Above comment isn't right, in D the expected is 'const' .......................................................
		ctx match-types candidate-return-type, x.non-inferring
	elif choices ?= expected opt-choices
		match choices none-or-one-or-many x => x is-type-match-possible candidate-return-type
		as none
			false
		as one x
			ctx match-types candidate-return-type, x.value
		as many
			# Else don't infer any type args; multiple candidates and multiple possible return types.
			true
	elif _ ?= expected opt-loop
		false
	else
		true

bogus expr(expected expected, ast expr-ast)
	expected bogus ast.range
bogus expr(expected expected, range source-range)
	expected set-to-bogus-if-inferring
	range bogus-expr expected.inferred

inferred type(expected expected)
	if x ?= expected opt-inferred
		x
	elif choices ?= expected opt-choices
		choices.only type
	else
		expected.opt-loop! type

check expr(ctx expr-ctx, expected expected, expr-type type, expr expr)
	ctx check expected, (expr, expr-type)
-check expr(ctx expr-ctx, expected expected, a expr-and-type)
	if ctx.instantiate-ctx set-type-no-diagnostic expected, a.type
		a expr
	else
		ctx add-diag a.expr.range, do
			ctx get-expected-for-diag expected diag-type-conflict (ctx type-with-container a.type)
		expected set-to-bogus-if-inferring
		a.expr bogus-wrong-type-expr expected.inferred

get-expected-for-diag expected-for-diag(ctx expr-ctx, expected expected)
	if x ?= expected opt-inferred
		(x,) expected-for-diag-choices ctx.type-container
	elif choices ?= expected opt-choices
		(for x : choices; ctx.instantiate-ctx apply-inferred x) expected-for-diag-choices ctx.type-container
	elif _ ?= expected opt-loop
		expected-for-diag-loop
	else
		expected-for-diag-infer

| This may infer type parameters
-set-type-no-diagnostic bool(ctx instantiate-ctx, expected expected, actual type)
	if x ?= expected opt-inferred
		ctx match-types x.non-inferring, actual.non-inferring
	elif choices ?= expected opt-choices
		# TODO: this could use 'exists'...........................................................................................
		any-ok mut = false
		for x : choices
			if ctx match-types x, actual.non-inferring
				any-ok := true
		if any-ok
			expected set-to-type actual
		any-ok
	elif _ ?= expected opt-loop
		false
	else
		expected set-to-type actual
		true

try-get-non-inferring-type type?(ctx instantiate-ctx, a type-and-context)
	match a type
	as bogus-type
		bogus-type,
	as type-param-index x
		if a.context is-inferring
			a.context try-get-inferred x
		else
			a.type,
	as struct-inst i
		new-type-args = for x : i.type-args.inner map-or-none
			ctx try-get-non-inferring-type (x, a.context)
		if x ?= new-type-args
			(ctx instantiate-struct i.decl, x).to,

fun-type record(kind fun-kind, struct-inst struct-inst)
fun-struct struct-decl(a fun-type)
	a.struct-inst decl
return-type type(a fun-type)
	a.struct-inst.type-args.only2 a
param-type type(a fun-type)
	a.struct-inst.type-args.only2 b

get-fun-type fun-type?(a type)
	if struct-inst ?= a struct-inst
		if x ?= struct-inst.decl.body builtin-type
			if kind ?= x fun-kind-from-builtin-type
				(kind, struct-inst),

| For diagnostics. Applies types that have been inferred, otherwise uses {bogus-type}.
| This is like {try-get-non-inferring-type} but returns a type with {bogus-type} in it instead of an empty option.
apply-inferred type(ctx instantiate-ctx, a type-and-context)
	match a type
	as bogus-type
		bogus-type
	as type-param-index x
		if a.context is-inferring
			a.context try-get-inferred x ?? bogus-type
		else
			x to
	as struct-inst i
		args type[] = for x : i.type-args inner
			ctx apply-inferred (x, a.context)
		ctx instantiate-struct i.decl, args to

| Tries to find a way for {a} and {b} to be the same type.
| It can fill in type arguments for {a}. But for unknown types in {b} it will assume compatibility.
match-types bool(ctx instantiate-ctx, a type-and-context, b type-and-context)
	match a type
	as bogus-type
		# TODO: make sure to infer type params in this case!
		()
	as type-param-index pa
		ctx match-types-type-param-a pa, a.context, b
	as struct-inst ai
		match b type
		as bogus-type
			true
		as type-param-index pb
			ctx match-types-type-param-b a, pb, b.context
		as struct-inst bi
			ai.decl == bi.decl && (ai.type-args.inner zip bi.type-args.inner) every (arg-a, arg-b) =>
				ctx match-types (arg-a, a.context), (arg-b, b.context)
-match-types-type-param-a bool(ctx instantiate-ctx, a type-param-index, a-context type-context, b type-and-context)
	if a-context is-inferring
		matches = if inferred ?= a-context try-get-inferred a
			ctx match-types (inferred, non-inferring), b
		else
			true
		if matches
			if b-inferred ?= ctx try-get-non-inferring-type b
				a-context[a.index] := b-inferred,
		matches
	else
		# It's an outer type param (not in either inferring).
		match b type
		as bogus-type
			true
		as type-param-index bp
			if b.context is-inferring
				if inferred ?= b.context try-get-inferred bp
					if x ?= inferred.type-param-index
						x == a
				else
					true
			else
				a == bp
		as struct-inst _
			false
-match-types-type-param-b bool(ctx instantiate-ctx, a type-and-context, b type-param-index, b-context type-context)
	if b-context is-inferring
		if inferred ?= b-context try-get-inferred b
			ctx match-types a, inferred.non-inferring
		else
			true

infer-type-args-from-lambda-parameter-type void(
	ctx instantiate-ctx,
	a type,
	a-context type-context,
	lambda-parameter-type type,
)
	if fun-type ?= a get-fun-type
		ctx infer-type-args-from fun-type.param-type, a-context, lambda-parameter-type.non-inferring
# Infers to 'a-context'. Doesn't change 'b'.
infer-type-args-from void(ctx instantiate-ctx, a type, a-context type-context, b type-and-context)
	guard b !is-inferring-non-inferred-type-param
	b2 = b maybe-inferred
	match a
	as bogus-type
		()
	as type-param-index ap
		unless _ ?= a-context try-get-inferred ap
			if t ?= ctx try-get-non-inferring-type b2
				a-context set-inferred ap, t
	as struct-inst ai
		if bi ?= b2.type struct-inst
			if ai.decl == bi.decl
				for ta, tb : ai.type-args.inner zip bi.type-args.inner
					ctx infer-type-args-from ta, a-context, (tb, b2.context)

is-type-match-possible-for-completions bool(param-type type-with-container, actual-arg-type type) trusted
	inferring type-context = param-type.container.n-type-params gc-safe-mut-slice
	(param-type.type, inferring) is-type-match-possible actual-arg-type.non-inferring

-is-type-match-possible bool(a type-and-context, b type-and-context)
	if a is-inferring-non-inferred-type-param || b is-inferring-non-inferred-type-param
		true
	else
		a2 = a maybe-inferred
		b2 = b maybe-inferred
		(a2.type == b2.type && a2.context !is-inferring && b2.context !is-inferring) ||
		a2.type is-bogus ||
		b2.type is-bogus ||
		a2.type types-are-corresponding-struct-insts b2.type, (x, y) =>
			(x, a2.context) is-type-match-possible (y, b2.context)

| True for a type param with no inference yet
-is-inferring-non-inferred-type-param bool(a type-and-context)
	if x ?= a.type type-param-index
		a.context is-inferring && a.context try-get-inferred x is-empty

maybe-inferred type-and-context(a type-and-context)
	if x ?= a.type type-param-index
		if a.context is-inferring
			# force because we tested 'is-inferring-non-inferred-type-param' before
			a.context try-get-inferred! x non-inferring
		else
			a
	else
		a

types-are-corresponding-struct-insts bool(a type, b type, types-correspond bool mut(x type, y type))
	if sa ?= a struct-inst
		if sb ?= b struct-inst
			sa.decl == sb.decl && (sa.type-args.inner zip sb.type-args.inner) every types-correspond
