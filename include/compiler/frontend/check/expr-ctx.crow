import
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/sym
	./check-ctx
	./instantiate
	./maps
	./type-from-ast

lambda-info record mut
	kind lambda-kind
	# Index into locals on expr-ctx. This is the first local inside the lambda (or an inner lambda).
	first-local-index nat
	closure local mut[]

expr-ctx record mut
	check-ctx check-ctx
	structs-and-aliases-map structs-and-aliases-map
	specs-map specs-map
	funs-map funs-map
	common-types common-types
	| For diags. This will be a {fun-decl} or {test_}.
	# TODO: instead of commenting the type, use a more appropriate type! ----------------------------------------------------------
	type-container type-container
	# TODO: this name is redundant. Crow doesn't have nested functions, so the function is always the outermost .........................
	outermost-fun-specs specs
	outermost-fun-type-params type-params
	cur-flags mut fun-flags
	externs mut symbol-set
	# TODO: make these private --------------------------------------------------------------------------------------------------
	is-in-trusted mut bool
	used-trusted mut bool
	locals local mut[]
	# When we access a local in a lambda, we need to make sure it's added to the closure of each lambda it's in
	lambdas lambda-info mut[]
instantiate-ctx instantiate-ctx(a expr-ctx)
	a.check-ctx instantiate-ctx

type-with-container type-with-container(ctx expr-ctx, a type)
	a, ctx.type-container

# TODO: use a 'with-block' --------------------------------------------------------------------------------------------------------------
with-trusted[out] out(ctx expr-ctx, ast trusted-ast, cb out mut())
	reason diag-trusted-unnecessary? = if ctx.cur-flags.safety != safe
		in-unsafe-function,
	elif ctx is-in-trusted
		in-trusted,
	if x ?= reason
		ctx add-diag ast.keyword-range, x.to
		cb[]
	else
		ctx.is-in-trusted := true
		res = cb[]
		ctx.is-in-trusted := false
		if ctx !used-trusted
			ctx add-diag ast.keyword-range, unused::diag-trusted-unnecessary.to
		ctx.used-trusted := false
		res

check-can-do-unsafe bool(ctx expr-ctx)
	if ctx.cur-flags.safety allows-unsafe
		true
	else
		res = ctx is-in-trusted
		if res
			ctx.used-trusted := true
		res

allows-unsafe bool(a fun-safety)
	match a
	as safe
		false
	as unsafe_
		true
	as trusted_
		true

add-diag void(ctx expr-ctx, range source-range, diag diag)
	ctx.check-ctx add-diag range, diag
add-diag void(ctx expr-ctx, source expr-ast, diag diag)
	ctx add-diag source.range, diag

type-from-destructure type?(ctx expr-ctx, ast destructure-ast)
	ctx.check-ctx type-from-destructure ctx.common-types, ast, ctx.structs-and-aliases-map, ctx.outermost-fun-type-params

check-destructure destructure(ctx expr-ctx, ast destructure-ast, type type, kind destructure-kind)
	ctx.check-ctx check-destructure ctx.common-types, ctx.structs-and-aliases-map,
		ctx.type-container, ctx.outermost-fun-type-params,
		ast, (type,), kind

type-from-ast type(ctx expr-ctx, ast type-ast)
	ctx.check-ctx type-from-ast ctx.common-types, ctx.structs-and-aliases-map, ast, ctx.outermost-fun-type-params, yes
