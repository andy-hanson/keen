import
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/util
	./check-ctx
	./instantiate
	./type-from-ast

lambda-info record mut
	kind lambda-kind
	# Index into locals on expr-ctx. This is the first local inside the lambda (or an inner lambda).
	first-local-index nat
	closure-locals local mut[]
	closure-contexts struct-inst mut[]

check-trusted interface mut
	check-trusted bool()
	context-forbids-global bool()
never-trusted record check-trusted case
check-trusted bool(_ never-trusted)
	false
context-forbids-global bool(_ never-trusted)
	false

expr-ctx record mut, check-trusted case
	check-ctx check-ctx
	types-and-specs-map types-and-specs-map
	funs-map funs-map
	common-types common-types
	| For diags. This will be a {fun-decl} or {test_}.
	# TODO: instead of commenting the type, use a more appropriate type! ----------------------------------------------------------
	container expr-container
	specs mut specs
	type-params type-params
	-is-in-trusted mut bool
	-used-trusted mut bool
	locals local mut[]
	refined-types (local, type-args) mut[]
	# When we access a local in a lambda, we need to make sure it's added to the closure of each lambda it's in
	lambdas lambda-info mut[]
	allocated-locals struct-inst mut[local]
new expr-ctx
	check-ctx check-ctx
	types-and-specs-map types-and-specs-map
	funs-map funs-map
	common-types common-types
	container expr-container
do
	check-ctx: check-ctx
	types-and-specs-map: types-and-specs-map
	funs-map: funs-map
	common-types: common-types
	container: container
	specs: container.specs
	type-params: container.type-param-asts
	is-in-trusted: false
	used-trusted: false
	locals: ()
	refined-types: ()
	lambdas: ()
	allocated-locals: ()

available-types available-types(a expr-ctx)
	common-types: a.common-types
	json: a.check-ctx.json-type

type-container type-container(a expr-ctx)
	a.container.to

instantiate-ctx instantiate-ctx(a expr-ctx)
	a.check-ctx.instantiate-ctx

type-with-container type-with-container(ctx expr-ctx, a type)
	a, ctx.container.to

# TODO: use a 'with-block' --------------------------------------------------------------------------------------------------------------
with-trusted[out] out(ctx expr-ctx, ast trusted-ast, cb out mut())
	ctx.is-in-trusted := true
	res = cb[]
	ctx.is-in-trusted := false
	if !ctx.used-trusted
		add-diag ctx, ast.keyword-range, diag-trusted-unused
	ctx.used-trusted := false
	res

check-trusted bool(ctx expr-ctx)
	res = ctx.is-in-trusted
	if res
		ctx.used-trusted := true
	res

context-forbids-global bool(a expr-ctx)
	exists a.lambdas, it.kind == data_

add-diag void(ctx expr-ctx, range source-range, diag diag)
	add-diag ctx.check-ctx, range, diag

types types-get(a expr-ctx)
	a.common-types, a.types-and-specs-map

type-from-destructure type?(ctx expr-ctx, ast destructure-ast)
	type-from-destructure ctx.check-ctx, ctx.types, ast, ctx.type-params

check-destructure destructure(ctx expr-ctx, ast destructure-ast, type type, kind destructure-kind)
	check-destructure ctx.check-ctx, ctx.types, ctx.type-container, ctx.type-params, ast, type, kind

type-from-ast type(ctx expr-ctx, ast type-ast)
	type-from-ast ctx.check-ctx, ctx.types, ast, ctx.type-params, yes

ensure-context-in-closure void(ctx expr-ctx, diag-range source-range, context-type struct-inst)
	i mut = ctx.lambdas.size
	until i == 0 or contains ctx.lambdas[i - 1].closure-contexts, context-type
		ctx.lambdas[i - 1].closure-contexts ~= context-type
		check-lambda-can-reference-local ctx, diag-range, ctx.lambdas[i - 1].kind, "the", context-type, false
		i -:= 1

check-lambda-can-reference-local void
	ctx expr-ctx
	diag-range source-range
	lambda-kind lambda-kind
	local-name symbol
	local-type type
	local-is-mutable bool
do
	expected-purity purity = match lambda-kind
	as data_ then data_
	as shared_ then shared_
	as mut_ then mut_
	as explicit-shared then mut_
	if expected-purity != mut_
		if local-is-mutable
			add-diag ctx, diag-range,
				diag-lambda-closure-purity lambda-kind, local-name, mut_, ()
		elif !is-purity-always-compatible-considering-specs ctx.specs, local-type, expected-purity
			add-diag ctx, diag-range,
				diag-lambda-closure-purity lambda-kind, local-name, local-type.purity-range.worst-case, type-with-container ctx, local-type

is-purity-always-compatible-considering-specs bool(fun-specs specs, type type, expected purity)
	type-purity = purity-range type
	is-purity-always-compatible expected, type-purity or
	specs-provide-purity fun-specs, type, expected or
	match type
	as bogus-type
		false
	as type-param-index
		false
	as struct-inst
		is-purity-compatible expected, type-purity.best-case and
		every type.type-args, of type-arg
			is-purity-always-compatible-considering-specs fun-specs, type-arg, expected

| Whether {specs} tells us that {type} has purity at least {expected}
-specs-provide-purity bool(specs specs, type type, expected purity)
	exists specs.all-builtin, of builtin_, type-args
		(p = builtin_.to::purity?) and type-args.only! == type and is-purity-compatible expected, p

get-the bool(ctx expr-ctx, range source-range, the-type struct-inst)
	if contains ctx.specs.all-contexts, the-type
		ensure-context-in-closure ctx, range, the-type
		true
	else
		add-diag ctx, range,
			diag-context-type-missing ctx.type-container, ctx.specs.all-contexts.slow-to-array, the-type
		false
