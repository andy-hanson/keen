import
	../../model/ast
	../../model/model
	../../model/source-range
	./check-call/candidates
	./check-ctx
	./type-from-ast

check-doc-comments void
	types-and-specs-map types-and-specs-map
	funs-map funs-map
	struct-aliases struct-alias[]
	structs struct-decl[]
	spec-decls spec-decl[]
	vars var-decl[]
	funs fun-decl[]
	tests test_[]
do check-ctx
	check-ref = of type-params type-params, specs specs, ast name-and-range
		check-doc-comment-reference types-and-specs-map, funs-map, type-params, specs, ast
	check-ref-for-sig = of type-params type-params, specs specs, params destructure[], ast name-and-range
		reference-in-params params, ast.name else check-ref[type-params, specs, ast]
	check-refs = of type-params type-params, specs specs, ast doc-comment-ast
		check-doc-comment-references types-and-specs-map, funs-map, type-params, specs, ast
	check-refs-for-decl = of decl any-decl
		check-refs[decl.type-param-asts, decl.specs, decl.doc-comment-ast]
	check-refs-for-struct = of struct struct-decl, ast doc-comment-ast
		check-refs[struct.type-param-asts, (), ast]

	for x in struct-aliases
		x.doc-comment-references := check-refs-for-decl[x]
	for struct in structs
		struct.doc-comment-references := check-refs-for-decl[struct]
		match body = struct.body
		as struct-body-bogus
			()
		as struct-body-extern-java
			()
		as builtin-type
			()
		as enum_
			for member in body.members
				member.doc-comment-references := check-refs-for-struct[struct, member.doc-comment-ast]
		as flags_
			for member in body.members
				member.doc-comment-references := check-refs-for-struct[struct, member.doc-comment-ast]
		as record_
			for field in body.fields
				field.doc-comment-references := check-refs-for-struct[struct, field.doc-comment-ast]
		as sum-type
			for sig in body.methods
				sig.doc-comment-references := for ast in sig.doc-comment-ast.references
					check-ref-for-sig[struct.type-param-asts, (), sig.params, ast]
	for spec_ in spec-decls
		spec_.doc-comment-references := check-refs-for-decl[spec_]
		for sig in spec_.sigs
			sig.doc-comment-references := for ast in sig.doc-comment-ast.references
				reference-spec-sig spec_, ast.name else check-ref-for-sig[spec_.type-param-asts, spec_.parents, sig.params, ast]
	for x in vars
		x.doc-comment-references := check-refs-for-decl[x]
	for x in funs
		x.doc-comment-references := for ast in x.doc-comment-ast.references
			check-ref-for-sig[x.type-param-asts, x.specs, x.params, ast]
	for x in tests
		x.doc-comment-references := check-refs-for-decl[x]

check-doc-comment-references doc-comment-references
	types-and-specs-map types-and-specs-map
	funs-map funs-map
	type-params type-params
	specs specs
	ast doc-comment-ast
do check-ctx
	for name in ast.references
		check-doc-comment-reference types-and-specs-map, funs-map, type-params, specs, name

-check-doc-comment-reference doc-comment-reference
	types-and-specs-map types-and-specs-map
	funs-map funs-map
	type-params type-params
	specs specs
	ast name-and-range
do check-ctx
	name = ast.name
	if x = find-index type-params, it.name == name
		(x,)::type-param-index
	elif x = spec-or-type-from-name name, ast.range, types-and-specs-map, true
		x.to
	elif x = reference-fun funs-map, specs, name
		x
	else
		add-diag ast.range, diag-name-not-found doc-comment-reference, name
		doc-comment-reference-bogus

-reference-in-params doc-comment-reference?(params destructure[], name symbol)
	first params, of param
		:: local? # TODO: type annotation should not be necessary
		find param.locals, it.name == name

-reference-spec-sig doc-comment-reference?(cur-spec spec-decl, name symbol)
	::signature? # TODO: type annotation should not be necessary
	find cur-spec.sigs, it.name == name

-reference-fun doc-comment-reference?(funs-map funs-map, specs specs, name symbol) check-ctx
	do if called = first-fun-in-scope funs-map, specs, name
	match called
	as fun-decl then doc-comment-reference-for-fun-decl called
	as called-spec-sig then called

-doc-comment-reference-for-fun-decl doc-comment-reference(a fun-decl)
	return-struct = of
		a.return-type.struct-inst!.decl
	match body = a.body
	as fun-body-uninitialized
		throw unreachable
	as fun-body-extern-java
		throw unreachable
	as fun-body-bogus
		a
	as auto-fun
		a
	as builtin-fun
		a
	as create-enum-or-flags
		return-struct[]
	as create-record
		return-struct[]
	as expr
		a
	as expr-with-allocated-locals
		a
	as fun-body-file-import
		a
	as flags-function
		return-struct[]
	as fun-body-method
		body.method
	as record-field-get
		body.field
	as record-field-set
		body.field
	as sum-type-member-get
		return-struct[]
	as var-get
		body.var
	as var-set
		body.var

-first-fun-in-scope called-decl?(funs-map funs-map, specs specs, name symbol) check-ctx
	res mut called-decl? = ()
	each-fun-in-scope (specs, funs-map), name, of x
		unless r = res and r.range < x.range
			res := x
	res
