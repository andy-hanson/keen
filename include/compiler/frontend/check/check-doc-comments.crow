import
	../../model/ast
	../../model/model
	../../model/source-range
	./check-call/candidates
	./check-ctx
	./maps
	./type-from-ast

check-doc-comments void
	ctx check-ctx
	structs-and-aliases-map structs-and-aliases-map
	specs-map specs-map
	funs-map funs-map
	struct-aliases struct-alias[]
	structs struct-decl[]
	spec-decls spec-decl[]
	vars var-decl[]
	funs fun-decl[]
	tests test_[]
do
	check-ref doc-comment-reference mut(type-params type-params, specs specs, ast name-and-range) = of type-params, specs, ast
		ctx check-doc-comment-reference structs-and-aliases-map, specs-map, funs-map, type-params, specs, ast
	check-ref-for-sig doc-comment-reference mut(type-params type-params, specs specs, params destructure[], ast name-and-range) =
		of type-params, specs, params, ast
			params reference-in-params ast.name else check-ref[type-params, specs, ast]
	check-refs doc-comment-references mut(type-params type-params, specs specs, ast doc-comment-ast) = of type-params, specs, ast
		ctx check-doc-comment-references structs-and-aliases-map, specs-map, funs-map, type-params, specs, ast
	check-refs-for-decl doc-comment-references mut(decl any-decl) = of decl
		check-refs[decl.type-param-asts, decl.specs, decl.doc-comment-ast]
	check-refs-for-struct doc-comment-references mut(struct struct-decl, ast doc-comment-ast) = of struct, ast
		check-refs[struct.type-param-asts, (), ast]
	
	for x in struct-aliases
		x.doc-comment-references := check-refs-for-decl[x]
	for struct in structs
		struct.doc-comment-references := check-refs-for-decl[struct]
		match struct body
		as struct-body-bogus _
			()
		as struct-body-extern-java _
			()
		as builtin-type _
			()
		as enum_ x
			for member in x members
				member.doc-comment-references := check-refs-for-struct[struct, member.doc-comment-ast]
		as flags_ x
			for member in x members
				member.doc-comment-references := check-refs-for-struct[struct, member.doc-comment-ast]
		as record_ x
			for field in x fields
				field.doc-comment-references := check-refs-for-struct[struct, field.doc-comment-ast]
		as sum-type x
			for sig in x methods
				sig.doc-comment-references := for ast in sig.doc-comment-ast.references
					check-ref-for-sig[struct.type-param-asts, (), sig.params, ast]
	for spec_ in spec-decls
		spec_.doc-comment-references := check-refs-for-decl[spec_]
		for sig in spec_ sigs
			sig.doc-comment-references := for ast in sig.doc-comment-ast references
				spec_ reference-spec-sig ast.name else check-ref-for-sig[spec_.type-param-asts, spec_.parents, sig.params, ast]
	for x in vars
		x.doc-comment-references := check-refs-for-decl[x]
	for x in funs
		x.doc-comment-references := for ast in x.doc-comment-ast references
			check-ref-for-sig[x.type-param-asts, x.specs, x.params, ast]
	for x in tests
		x.doc-comment-references := check-refs-for-decl[x]

check-doc-comment-references doc-comment-references
	ctx check-ctx
	structs-and-aliases-map structs-and-aliases-map
	specs-map specs-map
	funs-map funs-map
	type-params type-params
	specs specs
	ast doc-comment-ast
do
	for name in ast references
		ctx check-doc-comment-reference structs-and-aliases-map, specs-map, funs-map, type-params, specs, name

-check-doc-comment-reference doc-comment-reference
	ctx check-ctx
	structs-and-aliases-map structs-and-aliases-map
	specs-map specs-map
	funs-map funs-map
	type-params type-params
	specs specs
	ast name-and-range
do
	name = ast name
	if x ?= type-params find-index it.name == name
		(x,)::type-param-index
	elif sa ?= ctx struct-or-alias-from-name name, ast.range, structs-and-aliases-map, true
		sa to
	elif spec_ ?= ctx try-find-spec ast, specs-map, true
		spec_
	elif x ?= ctx reference-fun funs-map, specs, name
		x
	else
		ctx add-diag ast.range, (doc-comment-reference diag-name-not-found name)
		doc-comment-reference-bogus

-to doc-comment-reference(a struct-or-alias)
	match a
	as struct-decl x
		x
	as struct-alias x
		x

-reference-in-params doc-comment-reference?(params destructure[], name symbol)
	params first of param
		:: local? # TODO: type annotation should not be necessary
		param.locals find it.name == name

-reference-spec-sig doc-comment-reference?(cur-spec spec-decl, name symbol)
	::signature? # TODO: type annotation should not be necessary
	cur-spec.sigs find it.name == name

-reference-fun doc-comment-reference?(ctx check-ctx, funs-map funs-map, specs specs, name symbol)
	if called ?= ctx first-fun-in-scope funs-map, specs, name
		match called
		as fun-decl x
			x doc-comment-reference-for-fun-decl
		as called-spec-sig x
			x

-doc-comment-reference-for-fun-decl doc-comment-reference(a fun-decl)
	return-struct doc-comment-reference mut() = of
		a.return-type.struct-inst! decl
	match a body
	as fun-body-uninitialized
		throw unreachable
	as fun-body-extern-java _
		throw unreachable
	as fun-body-bogus
		a
	as auto-fun _
		a
	as builtin-fun _
		a
	as create-enum-or-flags _
		return-struct[]
	as create-record _
		return-struct[]
	as expr _
		a
	as fun-body-file-import _
		a
	as flags-function _
		return-struct[]
	as fun-body-method x
		x method
	as record-field-get x
		x field
	as record-field-set x
		x field
	as sum-type-member-get _
		return-struct[]
	as var-get x
		x var
	as var-set x
		x var

-first-fun-in-scope called-decl?(ctx check-ctx, funs-map funs-map, specs specs, name symbol)
	res mut called-decl? = ()
	(specs, funs-map, ctx) each-fun-in-scope name, of x
		unless r ?= res and r.range < x.range
			res := x
	res
