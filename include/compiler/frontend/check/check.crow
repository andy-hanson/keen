import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	../../util/perf
	../all-insts
	../lang
	../show-model
	./allocators
	./check-doc-comments
	./check-expr
	./check-funs
	./check-ctx
	./check-struct-bodies
	./detect-unused-private
	./get-common-types
	./maps
	./instantiate
	./type-from-ast

uri-and-ast record(uri uri, config config, ast file-ast)
resolved-import union(module, imported-file, diag-import-file)
imported-file record(uri uri, content nat8 array-view)

check-bootstrap (crow-module, common-types)
	show-ctx show-ctx
	all-insts all-insts
	common-uris common-uris
	uri-and-ast uri-and-ast
	java-String struct-inst
do
	start = perf-now
	finally start end-check
	show-ctx check-worker all-insts, common-uris, (), uri-and-ast, of ctx, structs-and-aliases-map
		ctx.instantiate-ctx get-common-types ctx.diagnostics-builder, structs-and-aliases-map, java-String

check crow-module
	show-ctx show-ctx
	all-insts all-insts
	common-uris common-uris
	uri-and-ast uri-and-ast
	imports resolved-import[]
	common-types common-types
do
	start = perf-now
	finally start end-check
	module, _ = show-ctx check-worker all-insts, common-uris, imports, uri-and-ast, (of _ then common-types)
	module

-get-builtin-spec builtin-spec?(ctx check-ctx, range source-range, name symbol)
	match name
	as "data"
		data_
	as "shared"
		shared_
	else
		ctx add-diag range, (spec_ diag-builtin-unsupported name)
		()

-check-spec-decl-body spec-decl-body
	ctx check-ctx
	types types-and-specs
	spec_ spec-decl
	type-params type-params
	delay-spec-insts delay-spec-insts
	ast spec-decl-ast
do
	modifiers = ctx check-spec-modifiers types, delay-spec-insts, ast.type-params, ast.modifiers
	builtin_ builtin-spec? = if modifiers is-builtin
		ctx get-builtin-spec ast.name-range, ast.name.name
	sigs = ctx check-signatures types.types, spec_, type-params, ast.sigs
	builtin_, modifiers.parents, sigs

-check-spec-decls-initial spec-decl[](ctx check-ctx, asts spec-decl-ast[])
	for ast in asts
		ctx check-type-params ast.type-params
		ctx.next-hash, ctx.cur-uri, ast, ast.visibility.visibility-from-explicit-top-level

-check-spec-bodies void
	ctx check-ctx
	types types-and-specs
	asts spec-decl-ast[]
	specs spec-decl[]
do
	delay-spec-insts delay-spec-insts = ()
	for i in 0::nat .. specs.size
		spec_ = specs[i]
		ast = asts[i]
		spec_.body := ctx check-spec-decl-body types, spec_, ast.type-params, delay-spec-insts, ast
	for decl in specs
		ctx detect-and-fix-spec-recursion decl
	while x ?= delay-spec-insts pop
		ctx.instantiate-ctx instantiate-spec-body x, delay-spec-insts

-detect-and-fix-spec-recursion void(ctx check-ctx, decl spec-decl)
	trace spec-decl mut[] = ()
	if decl recur-detect-spec-recursion trace
		ctx add-diag-assert-same-uri decl.range, trace.move-to.diag-spec-recursion
		decl overwrite-parents-to-empty
-recur-detect-spec-recursion bool(cur spec-decl, trace spec-decl mut[])
	cur.parents !is-empty and trace.size >= max-spec-depth or
	cur.parents.inner exists of parent
		trace ~= parent decl
		if parent.decl recur-detect-spec-recursion trace
			true
		else
			_ = trace.pop!
			false

-check-struct-aliases-initial struct-alias[](ctx check-ctx, asts struct-alias-ast[])
	for ast in asts
		ctx check-no-type-params ast.type-params, alias_
		ctx.next-hash, ast, ctx.cur-uri, ast.visibility.visibility-from-explicit-top-level, (), ()

-check-struct-alias-targets void
	ctx check-ctx
	types types-get
	aliases struct-alias[]
	asts struct-alias-ast[]
do
	for i in 0::nat .. aliases.size
		struct-alias = aliases[i]
		ast = asts[i]
		type = ctx type-from-ast types, ast.target, ast.type-params, different-module
		struct-alias.target := match type
		as bogus-type
			types.common-types void	
		as struct-inst
			type
		as type-param-index
			throw unreachable

-build-structs-and-aliases-map structs-and-aliases-map
	ctx check-ctx
	structs struct-decl[]
	aliases struct-alias[]
do
	xs struct-or-alias[] = with out in build
		for x in structs
			out ~= x
		for x in aliases
			out ~= x
	xs to-by-name of _, y
		ctx add-diag-assert-same-uri y.name-range,
			struct-or-alias diag-duplicate-declaration y.name

-check-var-initial var-decl(ctx check-ctx, types types-get, ast var-decl-ast)
	type = ctx type-from-ast-no-type-params types, ast.type
	ctx check-no-type-params ast.type-params, ast.kind.to
	ctx check-var-modifiers ast.kind, ast.modifiers
	hash: ctx next-hash
	ast: ast
	module-uri: ctx cur-uri
	visibility: ast.visibility visibility-from-explicit-top-level
	type: type
	initializer: ast.range bogus-expr type
	doc-comment-references: ()
-to decl-kind(a var-kind)
	match a
	as global_
		global_
	as thread-local_
		thread-local_
-check-var-modifiers void(ctx check-ctx, kind var-kind, modifiers modifier-ast[])
	for modifier in modifiers
		match modifier
		as modifier-keyword-ast
			ctx add-diag modifier.range, do modifier.keyword diag-modifier-invalid kind.to
		as spec-use-ast
			ctx add-diag modifier.range, kind.to.diag-spec-use-invalid
-check-var-initializer void # TODO: probably inline ---------------------------------------------------------------------------
	ctx check-ctx
	types types-and-specs
	funs-map funs-map
	var var-decl
do
	var.initializer := ctx check-fun-or-test-body types, funs-map, var, var.type, (), (summon_ | unsafe_), (), var.ast.initializer

-spec-flags-and-parents record(is-builtin bool, parents specs)
-check-spec-modifiers spec-flags-and-parents
	ctx check-ctx
	types types-and-specs
	delay-spec-insts delay-spec-insts
	type-params-scope type-params
	asts modifier-ast[]
do
	is-builtin mut bool = false
	parents spec-inst[] = with out in build
		for ast in asts
			match ast
			as modifier-keyword-ast
				match ast keyword
				as builtin_
					if is-builtin
						ctx add-diag ast.keyword-range, ast.keyword.diag-modifier-duplicate
					ctx modifier-type-arg-invalid ast
					is-builtin := true
				else
					ctx add-diag ast.keyword-range, do ast.keyword diag-modifier-invalid spec_
			as spec-use-ast
				if spec_ ?= ctx spec-from-ast types, type-params-scope, ast, delay-spec-insts
					out ~= spec_
	is-builtin, parents.get-or-add-specs

-types record
	structs-and-aliases-map structs-and-aliases-map
	struct-aliases struct-alias[]
	structs struct-decl[]
	common-types common-types

-check-worker-after-common-types crow-module
	ctx check-ctx
	types types
	uri uri
	config config
	imports-and-re-exports imports-and-re-exports
	ast file-ast
do
	structs-and-aliases-map = types structs-and-aliases-map
	struct-aliases = types struct-aliases
	structs = types structs
	common-types = types common-types
	types-get types-get = common-types, types.structs-and-aliases-map
	ctx check-struct-bodies types-get, structs, ast.structs
	vars var-decl[] = for x in ast vars
		ctx check-var-initial types-get, x
	specs = ctx check-spec-decls-initial ast.specs
	specs-map = specs to-by-name of _, y
		ctx add-diag-assert-same-uri y.range,
			spec_ diag-duplicate-declaration y.name
	ts types-and-specs = types-get, specs-map
	ctx check-spec-bodies ts, ast.specs, specs
	funs-and-map = ctx check-funs ts, structs, vars, imports-and-re-exports.file-imports, imports-and-re-exports.file-exports, ast.funs, ast.tests
	for var in vars
		ctx check-var-initializer ts, funs-and-map.funs-map, var
	ctx check-doc-comments structs-and-aliases-map, specs-map, funs-and-map.funs-map, \
		struct-aliases, structs, specs, vars, funs-and-map.funs, funs-and-map.tests
	module-doc-comment-references = ctx check-doc-comment-references structs-and-aliases-map, \
		specs-map, funs-and-map.funs-map, (), (), ast.doc-comment
	public-exports, public-and-internal-exports =
		ctx get-all-exports imports-and-re-exports.module-re-exports, structs-and-aliases-map, specs-map, funs-and-map.funs-map
	res crow-module =
		uri: uri
		config: config
		ast: ast
		imports-and-re-exports: with out in build
			for x in imports-and-re-exports module-imports
				out ~= x module
			for x in imports-and-re-exports module-re-exports
				out ~= x module
		file-imports-and-exports:
			-- imports-and-re-exports.file-imports map it.uri
			-- imports-and-re-exports.file-exports map it.uri
		diagnostics: ()
		aliases: struct-aliases
		structs: structs
		vars: vars
		specs: specs
		funs: funs-and-map funs
		tests: funs-and-map tests
		public-exports: public-exports
		public-and-internal-exports: public-and-internal-exports
		doc-comment-references: module-doc-comment-references
	ctx detect-unused-private common-types, res
	res.diagnostics := ctx finish-diagnostics
	res

-get-all-exports (exports, exports)
	ctx check-ctx
	re-exports import-or-export[]
	structs-and-aliases-map structs-and-aliases-map
	specs-map specs-map
	funs-map funs-map
do
	exported-funs fun-decl mut[] = ()
	exported-types struct-or-alias mut[] = ()
	exported-specs spec-decl mut[] = ()

	for e in re-exports
		its-exports = match e.source! kind
		as import-whole-module-ast
			# TODO: if this is a re-export of another library, only re-export the public members ---------------------------
			e.module public-and-internal-exports
		as array
			e named-imported
		as import-file-ast
			throw unreachable
		for x in its-exports funs
			exported-funs ~= x
		for x in its-exports structs-and-aliases
			exported-types ~= x
		for x in its-exports specs
			exported-specs ~= x

	for x in structs-and-aliases-map
		if x.visibility != private
			exported-types ~= x
	for x in specs-map
		if x.visibility != private
			exported-specs ~= x
	for x in funs-map
		if x.visibility != private
			exported-funs ~= x

	public-and-internal-exports exports =
		funs: exported-funs move-to
		structs-and-aliases: exported-types move-to-by-name of _, y
			ctx add-diag-assert-same-uri y.range,
				type diag-duplicate-exports y.name
		specs: exported-specs move-to-by-name of _, y
			ctx add-diag-assert-same-uri y.range,
				type diag-duplicate-exports y.name
	public-exports exports =
		funs: public-and-internal-exports.funs filter it.visibility == public
		structs-and-aliases: public-and-internal-exports.structs-and-aliases filter it.visibility == public
		specs: public-and-internal-exports.specs filter it.visibility == public
	public-exports, public-and-internal-exports

-check-worker (crow-module, common-types)
	show-ctx show-ctx
	all-insts all-insts
	common-uris common-uris
	resolved-imports resolved-import[]
	uri-and-ast uri-and-ast
	get-common-types common-types mut(ctx check-ctx, types structs-and-aliases-map)
do
	diags-builder diagnostic mut[] = ()
	imports-and-re-exports = diags-builder check-imports-and-re-exports uri-and-ast.ast, resolved-imports
	ast = uri-and-ast ast
	all-imports = imports-and-re-exports collect-imports-and-re-exports
	ctx check-ctx =
		show-ctx: show-ctx
		instantiate-ctx: all-insts,
		common-uris: common-uris
		cur-uri: uri-and-ast uri
		config: uri-and-ast config
		cur-file-text: show-ctx.file-content-getters[uri-and-ast uri]
		imports-and-re-exports: all-imports
		json-type: unless ast no-std_ then all-imports[0] get-json-type
		diagnostics-builder: diags-builder
	assert-all-allocated-freed
	# Since structs may refer to each other, first get a structs-and-aliases-map, *then* fill in bodies.
	structs = ctx check-structs-initial ast.structs
	struct-aliases = ctx check-struct-aliases-initial ast.struct-aliases
	structs-and-aliases-map = ctx build-structs-and-aliases-map structs, struct-aliases
	common-types = get-common-types[ctx, structs-and-aliases-map]
	ctx check-struct-alias-targets (common-types, structs-and-aliases-map), struct-aliases, ast.struct-aliases
	types types =
		structs-and-aliases-map: structs-and-aliases-map
		struct-aliases: struct-aliases
		structs: structs
		common-types: common-types
	res = ctx check-worker-after-common-types types, uri-and-ast.uri, uri-and-ast.config, imports-and-re-exports, ast
	assert-all-allocated-freed
	res, common-types

-get-json-type struct-inst?(std exports)
	std.structs-and-aliases["json"].?struct-decl ?only-inst

-imports-and-re-exports record
	module-imports import-or-export[]
	module-re-exports import-or-export[]
	file-imports import-or-export-file[]
	file-exports import-or-export-file[]
-collect-imports-and-re-exports exports[](a imports-and-re-exports)
	with out in build
		for x in a module-imports
			out ~= x exports-for-import
		for x in a module-re-exports
			out ~= x exports-for-import
-exports-for-import exports(import_ import-or-export)
	if import_ is-std
		import_.module public-exports
	else
		match import_.source! kind
		as import-whole-module-ast
			import_.module exports import_.import-visibility
		as array
			import_ named-imported
		as import-file-ast
			throw unreachable

-check-imports-and-re-exports imports-and-re-exports
	diags-builder diagnostic mut[]
	ast file-ast
	resolved-imports resolved-import[]
do
	resolved-imports-left resolved-import array-view reference = resolved-imports.to,
	imports = diags-builder check-imports-or-re-exports ast.imports, resolved-imports-left, !ast.no-std_
	re-exports = diags-builder check-imports-or-re-exports ast.re-exports, resolved-imports-left, false
	assert resolved-imports-left.get is-empty
	imports.modules, re-exports.modules, imports.files, re-exports.files

-imports-or-re-exports record(modules import-or-export[], files import-or-export-file[])
-check-imports-or-re-exports imports-or-re-exports
	diags-builder diagnostic mut[]
	ast imports-or-exports-ast?
	resolved-imports resolved-import array-view reference
	include-std bool
do
	imports import-or-export mut[] = ()
	file-imports import-or-export-file mut[] = ()
	next-resolved-import resolved-import mut() = of
		res = resolved-imports.get[0]
		resolved-imports set resolved-imports.get[1 .. end]
		res

	if include-std
		diags-builder handle-module-import imports, next-resolved-import[], (), public, it.noop

	if a ?= ast
		for import-ast in a paths
			import-visibility = import-ast import-min-visibility
			match kind = import-ast kind
			as import-whole-module-ast
				diags-builder handle-module-import imports, next-resolved-import[], import-ast, import-visibility, it.noop
			as array
				diags-builder handle-module-import imports, next-resolved-import[], import-ast, import-visibility, of x
					x.named-imported := diags-builder check-named-imports import-visibility, x.module, kind
			as import-file-ast
				match x = next-resolved-import[]
				as module
					throw unreachable
				as imported-file
					file-imports ~= import-ast, x.uri, x.content
				as diag-import-file
					diags-builder ~= import-ast.path-range, x

	modules: imports move-to
	files: file-imports move-to
-handle-module-import void
	diags-builder diagnostic mut[]
	imports import-or-export mut[]
	resolved-import resolved-import
	source import-or-export-ast?
	min-visibility export-visibility
	cb-init-imported void mut(x import-or-export)
do
	match resolved-import
	as module
		imports ~= source, resolved-import, min-visibility, ()
		cb-init-imported[imports peek!]
	as imported-file
		throw unreachable
	as diag-import-file
		diags-builder ~=
			range: source ?path-range else ()
			kind: resolved-import

-import-min-visibility export-visibility(a import-or-export-ast)
	match a path
	as path
		public
	as rel-path
		internal

-check-named-imports exports
	diags-builder diagnostic mut[]
	import-visibility export-visibility
	module module
	names name-and-range[]
do
	set symbol set = for x in names then x name # TODO: I don't use this as a set except to check the size ....................
	exports = module exports import-visibility
	if set.size != names.size
		assert set.size < names.size
		for name in names
			if (names count it.name == name.name) != 1
				diags-builder ~= name.range, name.name.diag-duplicate-import-name
	for name in set
		if name !in exports.funs and name !in exports.structs-and-aliases and name !in exports.specs
			ast = names find! it.name == name
			diags-builder ~= ast.range, name.diag-import-refers-to-nothing
	funs: exports.funs choose-keys set
	structs-and-aliases: exports.structs-and-aliases choose-keys set
	specs: exports.specs choose-keys set
