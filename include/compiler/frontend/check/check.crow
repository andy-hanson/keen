import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/by-name
	../../util/perf
	../all-insts
	../lang
	../show-model
	./allocators
	./check-doc-comments
	./check-expr
	./check-funs
	./check-ctx
	./check-struct-bodies
	./detect-unused-private
	./get-common-types
	./maps
	./instantiate
	./type-from-ast

uri-and-ast record(uri uri, config config, ast file-ast)
resolved-import union(module, imported-file, diag-import-file)
imported-file record(uri uri, content nat8 array-view)

check-bootstrap (crow-module, common-types)
	show-ctx show-ctx
	all-insts all-insts
	common-uris common-uris
	uri-and-ast uri-and-ast
	java-String struct-inst
do
	start = perf-now
	finally end-check start
	check-worker show-ctx, all-insts, common-uris, (), uri-and-ast, of ctx, structs-and-aliases-map, specs-map
		get-common-types ctx.instantiate-ctx, ctx.diagnostics-builder, structs-and-aliases-map, specs-map, java-String

check crow-module
	show-ctx show-ctx
	all-insts all-insts
	common-uris common-uris
	uri-and-ast uri-and-ast
	imports resolved-import[]
	common-types common-types
do
	start = perf-now
	finally end-check start
	module, _ = check-worker show-ctx, all-insts, common-uris, imports, uri-and-ast, (of _ then common-types)
	module

-get-builtin-spec builtin-spec?(ctx check-ctx, range source-range, name symbol)
	name.to or
		add-diag ctx, range, diag-builtin-unsupported spec_, name
		()

-check-spec-decl-body spec-decl-body
	ctx check-ctx
	types types-and-specs
	spec_ spec-decl
	type-params type-params
	delay-spec-insts delay-spec-insts
	ast spec-decl-ast
do
	modifiers = check-spec-modifiers ctx, types, delay-spec-insts, ast.type-params, ast.modifiers
	builtin_ builtin-spec? = if modifiers.is-builtin
		get-builtin-spec ctx, ast.name-range, ast.name.name
	sigs = check-signatures ctx, types.types, spec_, type-params, ast.sigs
	builtin_, modifiers.parents, sigs

-check-spec-decls-initial spec-decl[](ctx check-ctx, asts spec-decl-ast[])
	for ast in asts
		check-type-params ctx, ast.type-params
		ctx.next-hash, ctx.cur-uri, ast, ast.visibility.visibility-from-explicit-top-level

-check-spec-bodies void
	ctx check-ctx
	types types-and-specs
	asts spec-decl-ast[]
	specs spec-decl[]
do
	delay-spec-insts delay-spec-insts = ()
	for i in 0::nat .. specs.size
		spec_ = specs[i]
		ast = asts[i]
		spec_.body := check-spec-decl-body ctx, types, spec_, ast.type-params, delay-spec-insts, ast
	for decl in specs
		detect-and-fix-spec-recursion ctx, decl
	while x = pop delay-spec-insts
		instantiate-spec-body ctx.instantiate-ctx, x, delay-spec-insts

-detect-and-fix-spec-recursion void(ctx check-ctx, decl spec-decl)
	trace spec-decl mut[] = ()
	if recur-detect-spec-recursion decl, trace
		add-diag-assert-same-uri ctx, decl.range, trace.move-to.diag-spec-recursion
		overwrite-parents-to-empty decl
-recur-detect-spec-recursion bool(cur spec-decl, trace spec-decl mut[])
	!is-empty cur.parents and trace.size >= max-spec-depth or
	exists cur.parents.inner, of parent
		trace ~= parent.decl
		if recur-detect-spec-recursion parent.decl, trace
			true
		else
			_ = trace.pop!
			false

-check-struct-aliases-initial struct-alias[](ctx check-ctx, asts struct-alias-ast[])
	for ast in asts
		check-no-type-params ctx, ast.type-params, alias_
		ctx.next-hash, ast, ctx.cur-uri, ast.visibility.visibility-from-explicit-top-level, (), ()

-check-struct-alias-targets void
	ctx check-ctx
	types types-get
	aliases struct-alias[]
	asts struct-alias-ast[]
do
	for i in 0::nat .. aliases.size
		struct-alias = aliases[i]
		ast = asts[i]
		type = type-from-ast ctx, types, ast.target, ast.type-params, different-module
		struct-alias.target := match type
		as bogus-type
			types.common-types.void
		as struct-inst
			type
		as type-param-index
			throw unreachable

-build-structs-and-aliases-map structs-and-aliases-map
	ctx check-ctx
	structs struct-decl[]
	aliases struct-alias[]
do
	res struct-or-alias[] = with out in build
		for x in structs
			out ~= x
		for x in aliases
			out ~= x
	to-by-name res, of _, y
		add-diag-assert-same-uri ctx, y.name-range,
			diag-duplicate-declaration struct-or-alias, y.name

-check-var-initial var-decl(ctx check-ctx, types types-get, ast var-decl-ast)
	type = type-from-ast-no-type-params ctx, types, ast.type
	check-no-type-params ctx, ast.type-params, ast.kind.to
	check-var-modifiers ctx, ast.kind, ast.modifiers
	hash: next-hash ctx
	ast: ast
	module-uri: ctx.cur-uri
	visibility: visibility-from-explicit-top-level ast.visibility
	type: type
	initializer: bogus-expr ast.range, type
	doc-comment-references: ()
-to decl-kind(a var-kind)
	match a
	as global_
		global_
	as thread-local_
		thread-local_
-check-var-modifiers void(ctx check-ctx, kind var-kind, modifiers modifier-ast[])
	for modifier in modifiers
		match modifier
		as modifier-keyword-ast
			add-diag ctx, modifier.range, diag-modifier-invalid modifier.keyword, kind.to
		as spec-use-ast
			add-diag ctx, modifier.range, diag-spec-use-invalid kind.to
-check-var-initializer void # TODO: probably inline ---------------------------------------------------------------------------
	ctx check-ctx
	types types-and-specs
	funs-map funs-map
	var var-decl
do
	var.initializer :=
		check-fun-or-test-body ctx, types, funs-map, var, var.type, (), var.ast.initializer, var.ast

-spec-flags-and-parents record(is-builtin bool, parents specs)
-check-spec-modifiers spec-flags-and-parents
	ctx check-ctx
	types types-and-specs
	delay-spec-insts delay-spec-insts
	type-params-scope type-params
	asts modifier-ast[]
do
	is-builtin mut bool = false
	parents spec-inst[] = with out in build
		for ast in asts
			match ast
			as modifier-keyword-ast
				match ast.keyword
				as builtin_
					if is-builtin
						add-diag ctx, ast.keyword-range, diag-modifier-duplicate ast.keyword.to
					modifier-type-arg-invalid ctx, ast
					is-builtin := true
				else
					add-diag ctx, ast.keyword-range, diag-modifier-invalid ast.keyword, spec_
			as spec-use-ast
				if spec_ = spec-from-ast ctx, types, type-params-scope, ast, delay-spec-insts
					out ~= spec_
	is-builtin, parents.get-or-add-specs

-types record
	structs-and-aliases-map structs-and-aliases-map
	struct-aliases struct-alias[]
	structs struct-decl[]
	common-types common-types

-check-worker-after-common-types crow-module
	ctx check-ctx
	types types
	uri uri
	config config
	imports-and-re-exports imports-and-re-exports
	ast file-ast
	specs spec-decl[]
	specs-map specs-map
do
	structs-and-aliases-map = types.structs-and-aliases-map
	struct-aliases = types.struct-aliases
	structs = types.structs
	common-types = types.common-types
	types-get types-get = common-types, types.structs-and-aliases-map
	check-struct-bodies ctx, types-get, structs, ast.structs
	vars var-decl[] = for x in ast.vars
		check-var-initial ctx, types-get, x
	ts types-and-specs = types-get, specs-map
	check-spec-bodies ctx, ts, ast.specs, specs
	funs-and-map = check-funs ctx, ts, structs, vars, imports-and-re-exports.file-imports, imports-and-re-exports.file-exports, ast.funs, ast.tests
	for var in vars
		check-var-initializer ctx, ts, funs-and-map.funs-map, var
	check-doc-comments ctx, structs-and-aliases-map, specs-map, funs-and-map.funs-map, \
		struct-aliases, structs, specs, vars, funs-and-map.funs, funs-and-map.tests
	module-doc-comment-references = check-doc-comment-references ctx, structs-and-aliases-map, \
		specs-map, funs-and-map.funs-map, (), (), ast.doc-comment
	exports =
		get-all-exports ctx, imports-and-re-exports.module-re-exports, structs-and-aliases-map, specs-map, funs-and-map.funs-map
	res crow-module =
		uri: uri
		config: config
		ast: ast
		imports-and-re-exports: with out in build
			for x in imports-and-re-exports.module-imports
				out ~= x.module
			for x in imports-and-re-exports.module-re-exports
				out ~= x.module
		file-imports-and-exports:
			-- map imports-and-re-exports.file-imports, it.uri
			-- map imports-and-re-exports.file-exports, it.uri
		diagnostics: ()
		aliases: struct-aliases
		structs: structs
		vars: vars
		specs: specs
		funs: funs-and-map.funs
		tests: funs-and-map.tests
		public-exports: exports.public
		public-and-internal-exports: exports.public-and-internal
		doc-comment-references: module-doc-comment-references
	detect-unused-private ctx, common-types, res
	res.diagnostics := finish-diagnostics ctx
	res

-all-exports record(public exports, public-and-internal exports)
-get-all-exports all-exports
	ctx check-ctx
	re-exports import-or-export[]
	structs-and-aliases-map structs-and-aliases-map
	specs-map specs-map
	funs-map funs-map
do
	exported-funs fun-decl mut[] = ()
	exported-types struct-or-alias mut[] = ()
	exported-specs spec-decl mut[] = ()

	for e in re-exports
		its-exports = match e.source!.kind
		as import-whole-module-ast
			# TODO: if this is a re-export of another library, only re-export the public members ---------------------------
			e.module.public-and-internal-exports
		as array
			e.named-imported
		as import-file-ast
			throw unreachable
		for x in its-exports.funs
			exported-funs ~= x
		for x in its-exports.structs-and-aliases
			exported-types ~= x
		for x in its-exports.specs
			exported-specs ~= x

	for x in structs-and-aliases-map
		if x.visibility != private
			exported-types ~= x
	for x in specs-map
		if x.visibility != private
			exported-specs ~= x
	for x in funs-map
		if x.visibility != private
			exported-funs ~= x

	public-and-internal exports =
		funs: exported-funs.move-to
		structs-and-aliases: move-to-by-name exported-types, of _, y
			add-diag-assert-same-uri ctx, y.range, diag-duplicate-exports type, y.name
		specs: move-to-by-name exported-specs, of _, y
			add-diag-assert-same-uri ctx, y.range, diag-duplicate-exports type, y.name
	public:
		funs: filter public-and-internal.funs, it.visibility == public
		structs-and-aliases: filter public-and-internal.structs-and-aliases, it.visibility == public
		specs: filter public-and-internal.specs, it.visibility == public
	public-and-internal: public-and-internal

-check-worker (crow-module, common-types)
	show-ctx show-ctx
	all-insts all-insts
	common-uris common-uris
	resolved-imports resolved-import[]
	uri-and-ast uri-and-ast
	get-common-types common-types mut(ctx check-ctx, types structs-and-aliases-map, specs specs-map)
do
	diags-builder diagnostic mut[] = ()
	imports-and-re-exports = check-imports-and-re-exports diags-builder, uri-and-ast.ast, resolved-imports
	ast = uri-and-ast.ast
	all-imports = collect-imports-and-re-exports imports-and-re-exports
	ctx check-ctx =
		show-ctx: show-ctx
		instantiate-ctx: all-insts,
		common-uris: common-uris
		cur-uri: uri-and-ast.uri
		config: uri-and-ast.config
		cur-file-text: show-ctx.file-content-getters[uri-and-ast.uri]
		imports-and-re-exports: all-imports
		json-type: unless ast.no-std_ then get-json-type all-imports[0]
		diagnostics-builder: diags-builder
	assert-all-allocated-freed
	# Since structs may refer to each other, first get a structs-and-aliases-map, *then* fill in bodies.
	structs = check-structs-initial ctx, ast.structs
	struct-aliases = check-struct-aliases-initial ctx, ast.struct-aliases
	structs-and-aliases-map = build-structs-and-aliases-map ctx, structs, struct-aliases
	specs = check-spec-decls-initial ctx, ast.specs
	specs-map = to-by-name specs, of _, y
		add-diag-assert-same-uri ctx, y.range, diag-duplicate-declaration spec_, y.name
	common-types = get-common-types[ctx, structs-and-aliases-map, specs-map]
	check-struct-alias-targets ctx, (common-types, structs-and-aliases-map), struct-aliases, ast.struct-aliases
	types types =
		structs-and-aliases-map: structs-and-aliases-map
		struct-aliases: struct-aliases
		structs: structs
		common-types: common-types
	res = check-worker-after-common-types ctx, types, uri-and-ast.uri, uri-and-ast.config, imports-and-re-exports, ast, specs, specs-map
	assert-all-allocated-freed
	res, common-types

-get-json-type struct-inst?(std exports)
	std.structs-and-aliases["json"].?struct-decl.?only-inst

-imports-and-re-exports record
	module-imports import-or-export[]
	module-re-exports import-or-export[]
	file-imports import-or-export-file[]
	file-exports import-or-export-file[]
-collect-imports-and-re-exports exports[](a imports-and-re-exports)
	with out in build
		for x in a.module-imports
			out ~= x.exports-for-import
		for x in a.module-re-exports
			out ~= x.exports-for-import
-exports-for-import exports(import_ import-or-export)
	if import_.is-std
		import_.module.public-exports
	else
		match import_.source!.kind
		as import-whole-module-ast
			exports import_.module, import_.import-visibility
		as array
			import_.named-imported
		as import-file-ast
			throw unreachable

-check-imports-and-re-exports imports-and-re-exports
	diags-builder diagnostic mut[]
	ast file-ast
	resolved-imports resolved-import[]
do
	resolved-imports-left resolved-import array-view reference = resolved-imports.to,
	imports = check-imports-or-re-exports diags-builder, ast.imports, resolved-imports-left, !ast.no-std_
	re-exports = check-imports-or-re-exports diags-builder, ast.re-exports, resolved-imports-left, false
	assert is-empty resolved-imports-left.get
	imports.modules, re-exports.modules, imports.files, re-exports.files

-imports-or-re-exports record(modules import-or-export[], files import-or-export-file[])
-check-imports-or-re-exports imports-or-re-exports
	diags-builder diagnostic mut[]
	ast imports-or-exports-ast?
	resolved-imports resolved-import array-view reference
	include-std bool
do
	imports import-or-export mut[] = ()
	file-imports import-or-export-file mut[] = ()
	next-resolved-import resolved-import mut() = of
		res = resolved-imports.get[0]
		set resolved-imports, resolved-imports.get[1 .. end]
		res

	if include-std
		handle-module-import diags-builder, imports, next-resolved-import[], (), public, it.noop

	if ast
		for import-ast in ast.paths
			import-visibility = import-min-visibility import-ast
			match kind = import-ast.kind
			as import-whole-module-ast
				handle-module-import diags-builder, imports, next-resolved-import[], import-ast, import-visibility, it.noop
			as array
				handle-module-import diags-builder, imports, next-resolved-import[], import-ast, import-visibility, of x
					x.named-imported := check-named-imports diags-builder, import-visibility, x.module, kind
			as import-file-ast
				match x = next-resolved-import[]
				as module
					throw unreachable
				as imported-file
					file-imports ~= import-ast, x.uri, x.content
				as diag-import-file
					diags-builder ~= import-ast.path-range, x

	modules: imports.move-to
	files: file-imports.move-to
-handle-module-import void
	diags-builder diagnostic mut[]
	imports import-or-export mut[]
	resolved-import resolved-import
	source import-or-export-ast?
	min-visibility export-visibility
	cb-init-imported void mut(x import-or-export)
do
	match resolved-import
	as module
		imports ~= source, resolved-import, min-visibility, ()
		cb-init-imported[imports.peek!]
	as imported-file
		throw unreachable
	as diag-import-file
		diags-builder ~=
			range: source.?path-range else ()
			kind: resolved-import

-import-min-visibility export-visibility(a import-or-export-ast)
	match a.path
	as path
		public
	as rel-path
		internal

-check-named-imports exports
	diags-builder diagnostic mut[]
	import-visibility export-visibility
	module module
	names name-and-range[]
do
	set symbol set = map names, it.name # TODO: I don't use this as a set except to check the size ..............................
	exports = exports module, import-visibility
	if set.size != names.size
		assert set.size < names.size
		for name in names
			if (count names, it.name == name.name) != 1
				diags-builder ~= name.range, name.name.diag-duplicate-import-name
	for name in set
		if exports.funs[name].is-empty and !exports.structs-and-aliases[name] and !exports.specs[name]
			ast = find! names, it.name == name
			diags-builder ~= ast.range, name.diag-import-refers-to-nothing
	funs: choose-keys exports.funs, set
	structs-and-aliases: choose-keys exports.structs-and-aliases, set
	specs: choose-keys exports.specs, set
