import
	crow/col/mut-queue
	../../model/ast
	../../model/model
	../../model/uri
	../../util/perf
	../walk-model
	./detect-unused-private: ok-if-unused

detect-unused-internal uri-and-diagnostic[]
	all-modules crow-module[uri]
	common-types common-types
	fully-loaded-configs uri set
do
	guard fully-loaded-configs !is-empty

	start = perf-now
	finally start end-detect-unused-internal
	ctx ctx = (), ()
	all-modules each-decl of decl
		ctx.states[decl] := if decl is-public-or-main-or-test
			ctx.queue ~= decl
			public, true
		else
			(), false

	while x = ctx.queue dequeue
		common-types walk-any-decl x, of _, kind, ref
			guard kind != comment
			guard decl = ref as-any-decl
			# TODO: for *private* sum types we could still consider it private
			usage visibility = if x.module-uri == decl.module-uri and kind != explicit-internal and kind != sum-type-method-impl
				private
			else
				internal
			guard old-state = ctx.states[decl]
			ctx.states[decl] := (usage max old-state.usage), true
			unless old-state.added-to-queue
				ctx.queue ~= decl

	for* decl, state in ctx states
		guard !decl.struct-alias
		diag diag? = if u = state usage
			if u < decl.visibility
				if false # This was generating too many errors ...............................................................
					decl.name diag-unused-internal-decl true
		elif decl !ok-if-unused and decl.visibility != private # Privates handled by detect-unused-private
			decl.name diag-unused-internal-decl false
		guard diag
		guard config-uri = all-modules[decl module-uri]!.config config-uri
		guard fully-loaded-configs[config-uri]
		- decl.name-range, diag

-each-decl void(modules crow-module[uri], f void mut(x any-decl))
	for _, module in modules
		module each-decl f

-as-any-decl any-decl?(a doc-comment-reference)
	match a
	as doc-comment-reference-bogus then ()
	as called-spec-sig then ()
	as enum-or-flags-member then ()
	as fun-decl then a
	as local then ()
	as record-field then ()
	as signature then ()
	as struct-alias then ()
	as struct-decl then a
	as spec-decl then a
	as type-param-index then ()
	as var-decl then a

-is-public-or-main-or-test bool(a any-decl)
	a.visibility == public or a is-main or a test_
-is-main bool(a any-decl)
	(f = a fun-decl) and f.visibility != private and f.name == "main"

-decl-state record
	usage visibility?
	added-to-queue bool
-ctx record mut
	states decl-state mut[any-decl]
	queue any-decl mut-queue
