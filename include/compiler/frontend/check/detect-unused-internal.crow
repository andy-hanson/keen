import
	crow/col/mut-queue
	../../model/ast
	../../model/model
	../../model/uri
	../../util/perfhax
	../walk-model

detect-unused-internal uri-and-diagnostic[](all-modules crow-module[uri], common-types common-types)
	start = perf-now
	ctx ctx = (), ()
	all-modules each-decl decl =>
		ctx.states[decl] := if decl is-public-or-main-or-test
			ctx.queue ~= decl
			public, true
		else
			(), false	

	while x ?= ctx.queue dequeue
		common-types walk-any-decl x, (_, kind, ref) =>
			guard kind != comment
			guard decl ?= ref as-any-decl
			usage visibility = if x.module-uri == decl.module-uri && kind != explicit-internal && kind != sum-type-method-impl # TODO: for *private* sum types we could still consider it private
				private
			else
				internal
			guard old-state ?= ctx.states[decl]
			ctx.states[decl] := (usage max old-state.usage), true
			unless old-state.added-to-queue
				ctx.queue ~= decl

	res uri-and-diagnostic[] = with out : build
		for decl, state : ctx states
			guard decl.struct-alias is-empty
			if u ?= state.usage
				if u < decl.visibility
					if false # This was generating too many errors ...............................................................
						out ~= decl.name-range, do decl.name diag-unused-internal-decl true
			elif decl !ok-if-unused && decl.visibility != private # Privates handled by detect-unused-private
				out ~= decl.name-range, do decl.name diag-unused-internal-decl false

	start end-detect-unused-internal

	res

-ok-if-unused bool(a any-decl)
	guard f ?= a fun-decl
	f ok-if-unused

-each-decl void(modules crow-module[uri], f void mut(x any-decl))
	for _, module : modules
		module each-decl f

-as-any-decl any-decl?(a doc-comment-reference)
	match a
	as doc-comment-reference-bogus
		()
	as called-spec-sig _
		()
	as enum-or-flags-member _
		()
	as fun-decl x
		x
	as local _
		()
	as record-field _
		()
	as signature _
		()
	as struct-alias _
		()
	as struct-decl x
		x
	as spec-decl x
		x
	as type-param-index _
		()
	as var-decl x
		x

-is-public-or-main-or-test bool(a any-decl)
	a.visibility == public || a is-main || a.test_ !is-empty
-is-main bool(a any-decl)
	guard f ?= a fun-decl
	guard f.visibility != private
	guard f.name == "main"
	true # TODO: also check the signature. Or better, just have 'main' passed into 'detect-unused-internal' ---------------------------------------------------------------------------------

-decl-state record
	usage visibility?
	added-to-queue bool
-ctx record mut
	states decl-state mut[any-decl]
	queue any-decl mut-queue
