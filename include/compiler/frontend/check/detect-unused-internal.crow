import
	crow/col/mut-queue
	../../model/ast
	../../model/model
	../../model/uri
	../../util/perfhax
	../walk-model
	./detect-unused-private: ok-if-unused

detect-unused-internal uri-and-diagnostic[]
	all-modules crow-module[uri]
	common-types common-types
	fully-loaded-configs uri set
do
	guard fully-loaded-configs !is-empty

	start = perf-now
	ctx ctx = (), ()
	all-modules each-decl decl =>
		ctx.states[decl] := if decl is-public-or-main-or-test
			ctx.queue ~= decl
			public, true
		else
			(), false	

	while x ?= ctx.queue dequeue
		common-types walk-any-decl x, (_, kind, ref) =>
			guard kind != comment
			guard decl ?= ref as-any-decl
			# TODO: for *private* sum types we could still consider it private
			usage visibility = if x.module-uri == decl.module-uri && kind != explicit-internal && kind != sum-type-method-impl
				private
			else
				internal
			guard old-state ?= ctx.states[decl]
			ctx.states[decl] := (usage max old-state.usage), true
			unless old-state.added-to-queue
				ctx.queue ~= decl

	res uri-and-diagnostic[] = for* decl, state : ctx states
		guard decl.struct-alias is-empty
		opt-diag diag? = if u ?= state.usage
			if u < decl.visibility
				if false # This was generating too many errors ...............................................................
					decl.name diag-unused-internal-decl true
		elif decl !ok-if-unused && decl.visibility != private # Privates handled by detect-unused-private
			decl.name diag-unused-internal-decl false
		guard diag ?= opt-diag
		guard config-uri ?= all-modules[decl module-uri]!.config config-uri
		guard config-uri in fully-loaded-configs
		- decl.name-range, diag

	start end-detect-unused-internal

	res

-each-decl void(modules crow-module[uri], f void mut(x any-decl))
	for _, module : modules
		module each-decl f

-as-any-decl any-decl?(a doc-comment-reference)
	match a
	as doc-comment-reference-bogus
		()
	as called-spec-sig _
		()
	as enum-or-flags-member _
		()
	as fun-decl x
		x
	as local _
		()
	as record-field _
		()
	as signature _
		()
	as struct-alias _
		()
	as struct-decl x
		x
	as spec-decl x
		x
	as type-param-index _
		()
	as var-decl x
		x

-is-public-or-main-or-test bool(a any-decl)
	a.visibility == public || a is-main || a.test_ !is-empty
-is-main bool(a any-decl)
	guard f ?= a fun-decl
	guard f.visibility != private
	guard f.name == "main"
	true

-decl-state record
	usage visibility?
	added-to-queue bool
-ctx record mut
	states decl-state mut[any-decl]
	queue any-decl mut-queue
