import
	../../model/ast
	../../model/model
	./check-ctx
	./instantiate
	./get-common-funs

funs-out alias
	fun-decl builder

add-funs-for-struct void(out funs-out, struct struct-decl) check-ctx, common-types
	inst = instantiated-with-own-type-params struct
	match body = struct.body
	as struct-body-bogus
		()
	as struct-body-extern-java
		throw unreachable
	as builtin-type
		()
	as enum_
		add-funs-for-enum out, struct, body
	as flags_
		add-funs-for-flags out, struct, body
	as record_
		add-funs-for-record out, struct, inst, body
	as sum-type
		add-funs-for-sum-type out, struct, inst, body
	add-funs-for-sum-type-memberships out, struct, inst

-add-funs-for-sum-type-memberships void(out funs-out, struct struct-decl, inst struct-inst) check-ctx, common-types
	for x in struct.sum-type-memberships
		if can-convert-back x.sum-type.decl
			add-funs-for-sum-type-member out, struct, x.sum-type, inst

-add-funs-for-sum-type-member void
	out funs-out
	source-struct struct-decl
	sum-type struct-inst
	case-type struct-inst
do check-ctx, common-types
	params = make-params (sum-type,)
	out ~= fun-for-struct source-struct, option[case-type], params, sum-type-member-get

-can-convert-back bool(a struct-decl)
	can-convert-back a.body.sum-type!.kind
-can-convert-back bool(a sum-type-kind)
	match a
	as interface_
		false
	as java-interface
		false
	as union_
		true
	as variant_
		true

add-funs-for-var void(out funs-out, var var-decl) check-ctx, common-types
	out ~=
		hash: next-hash
		source: var
		visibility: var.visibility
		return-type: var.type
		params: ()
		specs: global-unsafe-specs
		doc-comment-references: ()
		body: var-get var
	out ~=
		hash: next-hash
		source: var
		visibility: var.visibility
		return-type: void
		params: make-params (var.type,)
		specs: global-unsafe-specs
		doc-comment-references: ()
		body: var-set var

-fun-for-struct fun-decl
	struct struct-decl
	return-type type
	params destructure[]
	body fun-body
do check-ctx
	hash: next-hash
	source: struct
	visibility: struct.visibility
	return-type: return-type
	params: params
	specs: struct.specs
	doc-comment-references: ()
	body: body

-add-funs-for-enum void(out funs-out, struct struct-decl, enum_ enum_) check-ctx
	inst = struct.only-inst
	for member in enum_.members
		out ~= enum-or-flags-constructor struct.visibility, inst, member

-add-funs-for-flags void(out funs-out, struct struct-decl, flags_ flags_) check-ctx, common-types
	inst = struct.only-inst
	out ~= flags-function struct, inst, (), none
	out ~= flags-function struct, inst, (inst,), negate
	out ~= flags-function struct, inst, (inst, inst), union_
	out ~= flags-function struct, inst, (inst, inst), intersect
	out ~= flags-function struct, bool, (inst, inst), subscript
	for member in flags_.members
		out ~= enum-or-flags-constructor struct.visibility, inst, member
-flags-function fun-decl(struct struct-decl, return-type type, params type[], fun flags-function) check-ctx # INLINE? -------------------------------
	fun-for-struct struct, return-type, params.make-params, fun

-enum-or-flags-constructor fun-decl(visibility visibility, enum_ struct-inst, member enum-or-flags-member) check-ctx
	hash: next-hash
	source: member
	visibility: visibility
	return-type: enum_
	params: ()
	specs: enum_.decl.specs
	doc-comment-references: ()
	body: create-enum-or-flags member

-add-funs-for-record void(out funs-out, struct struct-decl, inst struct-inst, record_ record_) check-ctx, common-types
	out ~= record-constructor struct, record_, inst, false
	out ~= record-constructor struct, record_, inst, true
	for field in record_.fields
		add-funs-for-record-field out, struct, inst, field

-record-constructor fun-decl(struct struct-decl, record_ record_, struct-type type, nominal_ bool) check-ctx
	hash: next-hash
	source: struct
	visibility: record_.new-visibility
	return-type: struct-type
	params: for x in record_.fields
		make-param x.name, x.type
	specs: specs struct
	doc-comment-references: ()
	body: create-record nominal_

-add-funs-for-record-field void
	out funs-out
	struct struct-decl
	record-type type
	field record-field
do check-ctx, common-types
	out ~=
		hash: next-hash
		source: field
		visibility: field.visibility
		return-type: field.type
		params: make-params (record-type,)
		specs: struct.specs
		doc-comment-references: ()
		body: record-field-get field

	if set-visibility = field.mutability
		out ~=
			hash: next-hash
			source: field
			visibility: set-visibility
			return-type: void
			params:
				- make-param "a", record-type
				- make-param field.name, field.type
			specs: struct.specs
			doc-comment-references: ()
			body: record-field-set field

-add-funs-for-sum-type void(out funs-out, struct struct-decl, inst struct-inst, sum-type sum-type) check-ctx, common-types
	if can-convert-back struct and !is-empty sum-type.listed-members
		for x in sum-type.listed-members
			add-funs-for-sum-type-member out, struct, inst, x.member
	for index, method in with-index sum-type.methods
		out ~= fun-for-method struct, inst, index, method
