import
	../../model/ast
	../../model/model
	./check-ctx
	./instantiate
	./get-common-funs

funs-out alias
	fun-decl array-builder

add-funs-for-struct void(ctx check-ctx, out funs-out, common-types common-types, struct struct-decl)
	match body = struct body
	as struct-body-bogus
		()
	as struct-body-extern-java
		throw unreachable
	as builtin-type
		()
	as enum_
		ctx add-funs-for-enum out, struct, body
	as flags_
		ctx add-funs-for-flags out, common-types, struct, body
	as record_
		ctx add-funs-for-record out, common-types, struct, body
	as sum-type
		ctx add-funs-for-sum-type out, common-types, struct, body
	ctx add-funs-for-sum-type-memberships out, common-types, struct

-add-funs-for-sum-type-memberships void(ctx check-ctx, out funs-out, common-types common-types, struct struct-decl)
	for x in struct.sum-type-memberships
		ctx add-funs-for-sum-type-member out, common-types, struct, x.sum-type, struct.instantiated-with-own-type-params

-add-funs-for-sum-type-member void
	ctx check-ctx
	out funs-out
	common-types common-types
	source-struct struct-decl
	sum-type struct-inst
	case-type struct-inst
do
	guard sum-type.decl.body.sum-type!.kind can-convert-back
	params = (("a", sum-type),) make-params
	out ~= ctx fun-for-struct source-struct, common-types.option[case-type], params, (), sum-type-member-get

-can-convert-back bool(a sum-type-kind)
	match a
	as interface_
		false
	as java-interface
		false
	as union_
		true
	as variant_
		true

add-funs-for-var void(ctx check-ctx, out funs-out, common-types common-types, var var-decl)
	out ~=
		hash: ctx next-hash
		source: var
		visibility: var visibility
		n-type-params: 0
		return-type: var type
		params: ()
		flags_: unsafe_
		externs: ()
		specs: ()
		doc-comment-references: ()
		body: var var-get
	out ~=
		hash: ctx next-hash
		source: var
		visibility: var visibility
		n-type-params: 0
		return-type: common-types void
		params: (("a", var.type),) make-params
		flags_: unsafe_
		externs: ()
		specs: ()
		doc-comment-references: ()
		body: var var-set

-fun-for-struct fun-decl
	ctx check-ctx
	struct struct-decl
	return-type type
	params destructure[]
	flags_ fun-flags
	body fun-body
do
	forbid flags_ summon_
	hash: ctx next-hash
	source: struct
	visibility: struct visibility
	n-type-params: struct n-type-params
	return-type: return-type
	params: params
	flags_: flags_ | if struct is-summon then summon_
	externs: struct extern_
	specs: ()
	doc-comment-references: ()
	body: body

-add-funs-for-enum void(ctx check-ctx, out funs-out, struct struct-decl, enum_ enum_)
	inst = struct only-inst
	for member in enum_ members
		out ~= ctx enum-or-flags-constructor struct.visibility, inst, member

-add-funs-for-flags void(ctx check-ctx, out funs-out, common-types common-types, struct struct-decl, flags_ flags_)
	inst = struct only-inst
	out ~= ctx flags-function struct, inst, (), none
	out ~= ctx flags-function struct, inst, (("a", inst),), negate
	out ~= ctx flags-function struct, inst, (("a", inst), ("b", inst)), union_
	out ~= ctx flags-function struct, inst, (("a", inst), ("b", inst)), intersect
	out ~= ctx flags-function struct, common-types.bool, (("a", inst), ("b", inst)), in_
	for member in flags_ members
		out ~= ctx enum-or-flags-constructor struct.visibility, inst, member
-flags-function fun-decl(ctx check-ctx, struct struct-decl, return-type type, params param-short[], fun flags-function)
	ctx fun-for-struct struct, return-type, params.make-params, (), fun

-enum-or-flags-constructor fun-decl(ctx check-ctx, visibility visibility, enum_ struct-inst, member enum-or-flags-member)
	hash: ctx next-hash
	source: member
	visibility: visibility
	n-type-params: enum_.type-args size
	return-type: enum_
	params: ()
	flags_: if enum_.decl is-summon then summon_
	externs: enum_.decl.extern_
	specs: ()
	doc-comment-references: ()
	body: member create-enum-or-flags

-add-funs-for-record void(ctx check-ctx, out funs-out, common-types common-types, struct struct-decl, record_ record_)
	struct-type = struct instantiated-with-own-type-params
	out ~= ctx record-constructor struct, record_, struct-type, false
	out ~= ctx record-constructor struct, record_, struct-type, true
	for field in record_ fields
		ctx add-funs-for-record-field out, common-types, struct, struct-type, field

-record-constructor fun-decl(ctx check-ctx, struct struct-decl, record_ record_, struct-type type, nominal_ bool)
	hash: ctx next-hash
	source: struct
	visibility: record_ new-visibility
	n-type-params: struct n-type-params
	return-type: struct-type
	params: for x in record_ fields
		(x.name, x.type) make-param
	flags_: if struct is-summon then summon_
	externs: struct extern_
	specs: ()
	doc-comment-references: ()
	body: nominal_ create-record

-add-funs-for-record-field void
	ctx check-ctx
	out funs-out
	common-types common-types
	struct struct-decl
	record-type type
	field record-field
do
	n-type-params = struct n-type-params
	out ~=
		hash: ctx next-hash
		source: field
		visibility: field visibility
		n-type-params: n-type-params
		return-type: field type
		params: (("a", record-type),) make-params
		flags_: if struct is-summon then summon_
		externs: struct extern_
		specs: ()
		doc-comment-references: ()
		body: field record-field-get
	
	if set-visibility = field mutability
		out ~=
			hash: ctx next-hash
			source: field
			visibility: set-visibility
			n-type-params: n-type-params
			return-type: common-types void
			params: (("a", record-type), (field.name, field.type)) make-params
			flags_: if struct is-summon then summon_
			externs: struct extern_
			specs: ()
			doc-comment-references: ()
			body: field record-field-set

-add-funs-for-sum-type void(ctx check-ctx, out funs-out, common-types common-types, struct struct-decl, sum-type sum-type)
	sum-type-inst = struct instantiated-with-own-type-params
	for x in sum-type listed-members
		ctx add-funs-for-sum-type-member out, common-types, struct, sum-type-inst, x.member
	for index, method in sum-type.methods with-index
		out ~= ctx.instantiate-ctx fun-for-method struct, index, method
