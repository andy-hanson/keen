import
	../../model/ast
	../../model/model
	./check-ctx
	./instantiate
	./get-common-funs

funs-out alias
	fun-decl builder

add-funs-for-struct void(ctx check-ctx, out funs-out, common-types common-types, struct struct-decl)
	inst = instantiated-with-own-type-params struct
	match body = struct.body
	as struct-body-bogus
		()
	as struct-body-extern-java
		throw unreachable
	as builtin-type
		()
	as enum_
		add-funs-for-enum ctx, out, struct, body
	as flags_
		add-funs-for-flags ctx, out, common-types, struct, body
	as record_
		add-funs-for-record ctx, out, common-types, struct, inst, body
	as sum-type
		add-funs-for-sum-type ctx, out, common-types, struct, inst, body
	add-funs-for-sum-type-memberships ctx, out, common-types, struct, inst

-add-funs-for-sum-type-memberships void(ctx check-ctx, out funs-out, common-types common-types, struct struct-decl, inst struct-inst)
	for x in struct.sum-type-memberships
		if can-convert-back x.sum-type.decl
			add-funs-for-sum-type-member ctx, out, common-types, struct, x.sum-type, inst

-add-funs-for-sum-type-member void
	ctx check-ctx
	out funs-out
	common-types common-types
	source-struct struct-decl
	sum-type struct-inst
	case-type struct-inst
do
	params = make-params (sum-type,)
	out ~= fun-for-struct ctx, source-struct, common-types.option[case-type], params, sum-type-member-get

-can-convert-back bool(a struct-decl)
	can-convert-back a.body.sum-type!.kind
-can-convert-back bool(a sum-type-kind)
	match a
	as interface_
		false
	as java-interface
		false
	as union_
		true
	as variant_
		true

add-funs-for-var void(ctx check-ctx, out funs-out, common-types common-types, var var-decl)
	out ~=
		hash: next-hash ctx
		source: var
		visibility: var.visibility
		n-type-params: 0
		return-type: var.type
		params: ()
		specs: common-types.global-unsafe-specs
		doc-comment-references: ()
		body: var-get var
	out ~=
		hash: next-hash ctx
		source: var
		visibility: var.visibility
		n-type-params: 0
		return-type: common-types.void
		params: make-params (var.type,)
		specs: common-types.global-unsafe-specs
		doc-comment-references: ()
		body: var-set var

-fun-for-struct fun-decl
	ctx check-ctx
	struct struct-decl
	return-type type
	params destructure[]
	body fun-body
do
	hash: next-hash ctx
	source: struct
	visibility: struct.visibility
	n-type-params: struct.n-type-params
	return-type: return-type
	params: params
	specs: struct.specs
	doc-comment-references: ()
	body: body

-add-funs-for-enum void(ctx check-ctx, out funs-out, struct struct-decl, enum_ enum_)
	inst = struct.only-inst
	for member in enum_.members
		out ~= enum-or-flags-constructor ctx, struct.visibility, inst, member

-add-funs-for-flags void(ctx check-ctx, out funs-out, common-types common-types, struct struct-decl, flags_ flags_)
	inst = struct.only-inst
	out ~= flags-function ctx, struct, inst, (), none
	out ~= flags-function ctx, struct, inst, (inst,), negate
	out ~= flags-function ctx, struct, inst, (inst, inst), union_
	out ~= flags-function ctx, struct, inst, (inst, inst), intersect
	out ~= flags-function ctx, struct, common-types.bool, (inst, inst), subscript
	for member in flags_.members
		out ~= enum-or-flags-constructor ctx, struct.visibility, inst, member
-flags-function fun-decl(ctx check-ctx, struct struct-decl, return-type type, params type[], fun flags-function) # INLINE? -------------------
	fun-for-struct ctx, struct, return-type, params.make-params, fun

-enum-or-flags-constructor fun-decl(ctx check-ctx, visibility visibility, enum_ struct-inst, member enum-or-flags-member)
	hash: next-hash ctx
	source: member
	visibility: visibility
	n-type-params: enum_.type-args.size
	return-type: enum_
	params: ()
	specs: enum_.decl.specs
	doc-comment-references: ()
	body: create-enum-or-flags member

-add-funs-for-record void(ctx check-ctx, out funs-out, common-types common-types, struct struct-decl, inst struct-inst, record_ record_)
	out ~= record-constructor ctx, struct, record_, inst, false
	out ~= record-constructor ctx, struct, record_, inst, true
	for field in record_.fields
		add-funs-for-record-field ctx, out, common-types, struct, inst, field

-record-constructor fun-decl(ctx check-ctx, struct struct-decl, record_ record_, struct-type type, nominal_ bool)
	hash: next-hash ctx
	source: struct
	visibility: record_.new-visibility
	n-type-params: struct.n-type-params
	return-type: struct-type
	params: for x in record_.fields
		make-param x.name, x.type
	specs: specs struct
	doc-comment-references: ()
	body: create-record nominal_

-add-funs-for-record-field void
	ctx check-ctx
	out funs-out
	common-types common-types
	struct struct-decl
	record-type type
	field record-field
do
	n-type-params = struct.n-type-params
	out ~=
		hash: next-hash ctx
		source: field
		visibility: field.visibility
		n-type-params: n-type-params
		return-type: field.type
		params: make-params (record-type,)
		specs: struct.specs
		doc-comment-references: ()
		body: record-field-get field

	if set-visibility = field.mutability
		out ~=
			hash: next-hash ctx
			source: field
			visibility: set-visibility
			n-type-params: n-type-params
			return-type: common-types.void
			params:
				- make-param "a", record-type
				- make-param field.name, field.type
			specs: struct.specs
			doc-comment-references: ()
			body: record-field-set field

-add-funs-for-sum-type void(ctx check-ctx, out funs-out, common-types common-types, struct struct-decl, inst struct-inst, sum-type sum-type)
	if can-convert-back struct and !is-empty sum-type.listed-members
		for x in sum-type.listed-members
			add-funs-for-sum-type-member ctx, out, common-types, struct, inst, x.member
	for index, method in with-index sum-type.methods
		out ~= fun-for-method ctx.instantiate-ctx, struct, inst, index, method
