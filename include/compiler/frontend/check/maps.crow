import
	../../model/ast
	../../model/model
	../../util/multi-set
	../../util/sym

structs-and-aliases-map alias
	struct-or-alias[sym]
specs-map alias
	spec-decl[sym]
funs-map alias
	(fun-decl, sym) multi-set

funs-and-map record(funs fun-decl[], tests test_[], funs-map funs-map)

import-or-export-file record(source import-or-export-ast, content file-content)
