import
	crow/col/mut-slice
	crow/unsafe
	../../model/model
	../../util/stack-alloc
	../lang

-type-contexts global(inference? mut-slice-allocator)
-all-candidates global(candidates) 
-candidate-pools global(candidate mut[][])
-n-live-candidates global(nat)
-type-and-context-arrays global(type-and-context mut-array-allocator)

init-allocators void() trusted
	type-contexts := ()
	all-candidates := 1024.gc-safe-mut-slice, 0, 0
	candidate-pools := for _ : 0::nat .. max-type-args + 1; ()
	n-live-candidates := ()
	type-and-context-arrays := ()

assert-all-allocated-freed void() trusted
	type-contexts assert-all-free
	all-candidates assert-all-free
	n-live-candidates is 0
	type-and-context-arrays assert-all-free

# TODO: for 'allow-wider' and 'allow-narrower', the type will always be a 'struct-inst'. Maybe I should make this a union to clarify. ---
inference-kind enum
	| The type must be exactly as specified
	exact
	| The type may be widened (for example, from `nat` to `nat?`).
	| Suppose we are calling `push[t] void(value t, a t mut[])`.
	| When we check the first arg, we might infer the type as `nat allow-wider`.
	| Then if the argument turns out to be a `nat? mut[]`, we would upgrade `t` to `nat?` with `exact`.
	allow-wider
	| The type may be narrowed (for example, from `nat?` to `nat`).
	| Suppose we are calling `first[t] t(a t[])` and the expected type is `nat?`.
	| We would check the return type first. Then `t` would be inferred at `nat?` with `allow-narrower`.
	| Then if the argument turns out to be a `nat[]`, we would upgrade `t` to `nat` with `exact`.
	allow-narrower
== bool(a inference-kind, b inference-kind)
to symbol(a inference-kind)
show string(a inference-kind)
	a.to::symbol to
inference record
	kind inference-kind
	type type

type-context alias
	inference? mut-slice

with-type-context-for[t] t(n-type-params nat, f t mut(x type-context)) trusted
	context = type-contexts allocate-gc-safe-values n-type-params
	finally type-contexts free context
	f[context]

candidate record mut, -new
	called -mut called-decl
	| This is always empty if calling a {called-spec-sig}
	type-args type-context

| Remember to call {free-candidate}
init-candidate candidate(called called-decl) unsafe
	n-type-args = called n-type-params
	candidate-pool = candidate-pools[n-type-args]
	res = if x ?= candidate-pool pop
		x.called := called
		x
	else
		called, n-type-args.gc-safe-mut-slice
	n-live-candidates +:= 1
	res
free-candidate void(candidate candidate) unsafe # TODO: ideally this would be private to this module ---------
	candidate.called := gc-safe-value
	n-type-args = candidate.type-args size
	for i : 0::nat .. n-type-args
		candidate.type-args[i] := ()
	candidate-pools[n-type-args] ~= candidate
	n-live-candidates -:= 1

type-and-context record mut
	type -mut type
	context -mut type-context
non-inferring type-and-context(type type)
	type, ()
allocate type-and-context mut[]() trusted
	type-and-context-arrays allocate
free void(value type-and-context mut[]) trusted
	type-and-context-arrays free value

debug string(a type-and-context)
	"{a.type debug} @ {a.context debug}"

debug string(a type-context)
	if a is-empty
		"non-inferring"
	else
		"inferring({", " join for x : a; x debug})"
-debug string(a inference?)
	if x ?= a
		"{x kind} {x.type debug}"
	else
		"uninferred"
non-inferring type-context()
	()
is-inferring bool(a type-context)
	a !is-empty

| This is used for candidates arrays.
| Since only one candidates array is active at a time, we store them all together concatenated.
candidates record mut
	| Remember to access this between {cur-array-start} and {cur-array-end}
	-all-entries candidate mut-slice
	-cur-array-start mut nat
	-cur-array-end mut nat

assert-all-free void(a candidates)
	a.cur-array-start is 0
	a.cur-array-end is 0

iterate bool(a candidates, f bool mut(x candidate))
	a.cur-array-start .. a.cur-array-end iterate i =>
		f[a.all-entries[i]]

is-empty bool(a candidates)
	a.cur-array-start == a.cur-array-end

size nat(a candidates)
	a.cur-array-end - a.cur-array-start

only candidate(a candidates)
	assert a.size == 1
	a.all-entries[a.cur-array-start]

opt-only candidate?(a candidates)
	if a.size == 1
		a only

| Remember to call {free-candidates}
allocate-candidates (candidates, nat)() unsafe
	restore = all-candidates push-context
	all-candidates, restore

free-candidates void(candidates candidates, restore nat) unsafe
	assert candidates reference-equal all-candidates
	all-candidates pop-context restore

clear-candidates void(a candidates) trusted
	for i : a.cur-array-start .. a.cur-array-end
		a.all-entries[i] free-candidate
		a.all-entries[i] := gc-safe-value
	a.cur-array-end := a.cur-array-start

| Returns the restore info. Pass this into {pop-context}.
push-context nat(a candidates)
	res = a cur-array-start
	a.cur-array-start := a cur-array-end
	res

pop-context void(a candidates, restore nat) trusted
	a clear-candidates
	a.cur-array-start := restore

~= void(a candidates, value candidate)
	a.all-entries[a cur-array-end] := value
	a.cur-array-end +:= 1

filter-candidates void(a candidates, f bool mut(x candidate))
	i mut = a cur-array-start
	until i == a.cur-array-end
		if f[a.all-entries[i]]
			i +:= 1
		else
			a remove-at-unordered i

tri-state enum # TODO: better name ------------------------------------------------------------------------------------------
	prefer
	allow
	reject
== bool(a tri-state, b tri-state)
filter-candidates-tri void(a candidates, f tri-state mut(x candidate))
	# TODO:PERF do it in a single pass -----------------------------------------------------------------------------------------------------
	if a exists x => f[x] == prefer
		a filter-candidates x => f[x] == prefer
	else
		a filter-candidates x => f[x] != reject

filter-candidates-but-dont-remove-all void(a candidates, f bool mut(x candidate))
	i mut nat = a cur-array-start
	loop
		if i == a.cur-array-end
			# Got to the end and no candidate passed the test
			break
		elif f[a.all-entries[i]]
			# All previous candidates failed the test
			while i != a.cur-array-start
				a remove-at-unordered i - 1
				i -:= 1
			# We already confirmed that this one passes the test
			i +:= 1
			until i == a.cur-array-end
				if f[a.all-entries[i]]
					i +:= 1
				else
					a remove-at-unordered i
			break
		else
			i +:= 1
			continue
###
TODO: RESTORE THIS TEST ---------------------------------------------------------------------------------------------------------
test
	xs nat mut[] = 1, 2, 3, 4, 5
	xs filter-unordered-but-dont-remove-all x => x is-even
	xs.to::nat[] is (2, 4)
	xs filter-unordered-but-dont-remove-all x => x !is-even
	xs.to::nat[] is (2, 4)
###

-remove-at-unordered void(a candidates, i nat) trusted
	a.all-entries[i] free-candidate
	take-from = a.cur-array-end - 1
	a.all-entries[i] := a.all-entries[take-from]
	a.all-entries[take-from] := gc-safe-value
	a.cur-array-end := take-from
