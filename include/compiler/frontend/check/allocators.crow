import
	../../model/model
	../../util/stack-alloc

allocators record mut
	type-contexts type? stack-alloc
	candidates candidate stack-alloc

new allocators()
	type-contexts: 4096,
	candidates: 4096,

assert-empty void(a allocators)
	a.type-contexts assert-empty
	a.candidates assert-empty

type-context alias
	type? mut-stack-alloced-array

candidate record mut
	called called-decl
	| This is always empty if calling a {called-spec-sig}
	type-args type-context
