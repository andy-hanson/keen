import
	../../model/ast
	../../model/model
	../../util/by-name
	../../util/perfhax
	../walk-model
	./check-ctx

detect-unused-private void(ctx check-ctx, common-types common-types, module crow-module)
	start = perf-now
	used = common-types gather-used module
	for fun : module funs
		guard fun.visibility == private
		guard fun !ok-if-unused
		guard fun !in used
		ctx add-diag-assert-same-uri fun.name-range, fun.name.diag-unused-private-decl
	for struct : module structs
		guard struct.visibility == private
		guard struct !in used
		guard struct.sum-type-memberships !exists m => module.funs sum-type-member-getter struct, m in used
		ctx add-diag-assert-same-uri struct.name-range, struct.name.diag-unused-private-decl
	for spec_ : module specs
		guard spec_.visibility == private
		guard spec_ !in used
		ctx add-diag-assert-same-uri spec_.name-range, spec_.name.diag-unused-private-decl
	
	for x : used unused-locals
		kind = if x.mutability == mut_
			x in used.unused-mut-locals and completely-unused else write-only
		else
			completely-unused
		ctx add-diag x.local-must-have-name-range, (x diag-unused-local kind)
	for x : used unused-mut-locals
		unless x in used.unused-locals
			ctx add-diag x.local-must-have-name-range, (x diag-unused-local read-only)

	# TODO: for vars we need to look for the getter function ---------------------------------------------------------------------
	#for var : module vars
	#	guard var.visibility == private
	#	guard var !in used
	#	ctx add-diag-assert-same-uri var.name-range, var.name.diag-unused-private-decl

	module zip-ast-and-module-imports (ast, imported) =>
		match ast kind
		as import-whole-module-ast
			unless imported has used
				ctx add-diag ast.range, (imported diag-unused-import ())
		as array names
			for name : names
				unless imported has-for-name name.name, used
					ctx add-diag name.range, (imported diag-unused-import name.name)
		as import-file-ast _
			()
	start end-detect-unused-private

ok-if-unused bool(a any-decl)
	guard f ?= a fun-decl
	f ok-if-unused
ok-if-unused bool(a fun-decl)
	match a body
	as fun-body-uninitialized
		throw unreachable
	as fun-body-bogus
		false
	as fun-body-extern-java _
		true
	as auto-fun _
		false
	as builtin-fun _
		false
	as create-enum-or-flags _
		true
	as create-record _
		true
	as expr _
		false
	as fun-body-file-import _
		false
	as flags-function _
		true
	as fun-body-method _
		false
	as record-field-get _
		true
	as record-field-set _
		true
	as sum-type-member-get _
		true
	as var-get _
		true
	as var-set _
		true

-used record
	funs fun-decl set
	structs struct-decl set
	specs spec-decl set
	vars var-decl set
	unused-locals local set
	unused-mut-locals local set
-in bool(a fun-decl, used used)
	a in used.funs
-in bool(a struct-decl, used used)
	a in used.structs
-in bool(a spec-decl, used used)
	a in used.specs

-gather-used used(common-types common-types, module crow-module)
	funs fun-decl mut-set = ()
	structs struct-decl mut-set = ()
	specs spec-decl mut-set = ()
	vars var-decl mut-set = ()

	unused-locals local mut-set = ()
	unused-mut-locals local mut-set = ()

	common-types walk-module module, (_, kind, ref) =>
		match ref
		as doc-comment-reference-bogus
			()
		as called-spec-sig _
			()
		as enum-or-flags-member _
			()
		as fun-decl x
			funs ~= x
		as local x
			match kind
			as declare-local
				unused-locals ~= x
				if x.mutability == mut_
					unused-mut-locals ~= x
			as get-local
				_ = unused-locals remove x
			as set-local
				_ = unused-mut-locals remove x
			as comment
				()
			else
				info log "LE KIND: {kind}"
				throw unreachable
		as record-field _
			()
		as signature _
			()
		as struct-alias _
			()
		as struct-decl x
			structs ~= x
		as spec-decl x
			specs ~= x
		as type-param-index _
			()
		as var-decl x
			vars ~= x
	funs.move-to, structs.move-to, specs.move-to, vars.move-to, unused-locals.move-to, unused-mut-locals.move-to

-has bool(module module, used used)
	exports = module public-and-internal-exports
	exports.funs exists (x => x in used) or
	exports.structs-and-aliases exists (x => x in used) or
	exports.specs exists x => x in used
-in bool(a struct-or-alias, used used)
	match a
	as struct-decl x
		x in used
	as struct-alias x
		x.target.decl in used

-has-for-name bool(module module, name symbol, used used)
	exports = module public-and-internal-exports
	a = exports.funs[name] exists x => x in used
	b = if x ?= exports.structs-and-aliases[name]
		match x
		as struct-decl s
			s in used
		as struct-alias s
			s.target.decl in used
	c = if x ?= exports.specs[name]
		x in used
	a or b or c or name == "compare" or name == "equal" # 'equal' and 'compare' are needed when checking certain auto-funs
