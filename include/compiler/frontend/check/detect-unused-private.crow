import
	../../model/ast
	../../model/model
	../../util/by-name
	../../util/perf
	../walk-model
	./check-ctx

detect-unused-private void(ctx check-ctx, common-types common-types, module crow-module)
	start = perf-now
	used = gather-used common-types, module
	for fun in module.funs
		guard fun.visibility == private
		guard !ok-if-unused fun
		guard !used[fun]
		add-diag-assert-same-uri ctx, fun.name-range, fun.name.diag-unused-private-decl
	for struct in module.structs
		guard struct.visibility == private
		guard !used[struct]
		guard !exists struct.sum-type-memberships, of m
			used[sum-type-member-getter module.funs, struct, m]
		add-diag-assert-same-uri ctx, struct.name-range, struct.name.diag-unused-private-decl
	for spec_ in module.specs
		guard spec_.visibility == private
		guard !used[spec_]
		add-diag-assert-same-uri ctx, spec_.name-range, spec_.name.diag-unused-private-decl

	for x in used.unused-locals
		kind = if x.is-mutable and !used.unused-mut-locals[x]
			write-only
		else
			completely-unused
		add-diag ctx, x.local-must-have-name-range, diag-unused-local x, kind
	for x in used.unused-mut-locals
		unless used.unused-locals[x]
			add-diag ctx, x.local-must-have-name-range, diag-unused-local x, read-only

	# TODO: for vars we need to look for the getter function ---------------------------------------------------------------------
	#for var in module vars
	#	guard var.visibility == private
	#	guard var !in used
	#	ctx add-diag-assert-same-uri var.name-range, var.name.diag-unused-private-decl

	zip-ast-and-module-imports module, of ast, imported
		match kind = ast.kind
		as import-whole-module-ast
			unless has imported, used
				add-diag ctx, ast.range, diag-unused-import imported, ()
		as array
			for name in kind
				unless has-for-name imported, name.name, used
					add-diag ctx, name.range, diag-unused-import imported, name.name
		as import-file-ast
			()
	end-detect-unused-private start

ok-if-unused bool(a any-decl)
	a.fun-decl and ok-if-unused a
ok-if-unused bool(a fun-decl)
	match a.body
	as fun-body-uninitialized then throw unreachable
	as fun-body-bogus then false
	as fun-body-extern-java then true
	as auto-fun then false
	as builtin-fun then false
	as create-enum-or-flags then true
	as create-record then true
	as expr then false
	as expr-with-allocated-locals then false
	as fun-body-file-import then false
	as flags-function then true
	as fun-body-method then false
	as record-field-get then true
	as record-field-set then true
	as sum-type-member-get then true
	as var-get then true
	as var-set then true

-used record
	funs fun-decl set
	structs struct-decl set
	specs spec-decl set
	vars var-decl set
	unused-locals local set
	unused-mut-locals local set
-subscript bool(a used, x fun-decl)
	a.funs[x]
-subscript bool(a used, x struct-decl)
	a.structs[x]
-subscript bool(a used, x spec-decl)
	a.specs[x]

-gather-used used(common-types common-types, module crow-module)
	funs fun-decl mut-set = ()
	structs struct-decl mut-set = ()
	specs spec-decl mut-set = ()
	vars var-decl mut-set = ()

	unused-locals local mut-set = ()
	unused-mut-locals local mut-set = ()

	walk-module common-types, module, of _, kind, ref
		match ref
		as doc-comment-reference-bogus
			()
		as called-spec-sig
			()
		as enum-or-flags-member
			()
		as fun-decl
			funs ~= ref
		as local
			match kind
			as declare-local
				unused-locals ~= ref
				if is-mutable ref
					unused-mut-locals ~= ref
			as get-local
				_ = remove unused-locals, ref
			as set-local
				_ = remove unused-mut-locals, ref
			as comment
				()
			else
				throw unreachable
		as record-field
			()
		as signature
			()
		as struct-alias
			()
		as struct-decl
			structs ~= ref
		as spec-decl
			specs ~= ref
		as type-param-index
			()
		as var-decl
			vars ~= ref
	funs.move-to, structs.move-to, specs.move-to, vars.move-to, unused-locals.move-to, unused-mut-locals.move-to

-has bool(module module, used used)
	exports = module.public-and-internal-exports
	exists exports.funs, used[it] or
	exists exports.structs-and-aliases, used[it] or
	exists exports.specs, used[it]
-subscript bool(a used, sa struct-or-alias)
	match sa
	as struct-decl
		a[sa]
	as struct-alias
		a[sa.target.decl]

-has-for-name bool(module module, name symbol, used used)
	exports = module.public-and-internal-exports
	exists exports.funs[name], used[it] or
	x = exports.structs-and-aliases[name] and used[x] or
	x = exports.specs[name] and used[x] or
	name == "compare" or name == "equal" # 'equal' and 'compare' are needed when checking certain auto-funs
