import
	crow/bits
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/by-name
	../../util/util
	./check-call/check-call
	./check-ctx
	./check-util
	./instantiate
	./maps
	./type-from-ast

modifier-type-arg-invalid void(ctx check-ctx, modifier modifier-ast)
	if modifier type-arg
		ctx add-diag modifier.range, modifier.diag-modifier-type-arg-invalid

check-structs-initial struct-decl[](ctx check-ctx, asts struct-decl-ast[])
	for ast in asts
		ctx check-type-params ast.type-params
		purity = ctx get-struct-purity ast
		hash: ctx next-hash
		source: ast
		module-uri: ctx cur-uri
		visibility: ast.visibility visibility-from-explicit-top-level
		purity: purity purity
		purity-is-forced: purity forced
		doc-comment-references: ()
		sum-type-memberships: ()
		body: struct-body-bogus
check-struct-bodies void
	ctx check-ctx
	types types-get
	structs struct-decl[]
	asts struct-decl-ast[]
do
	for struct, ast in structs zip asts
		struct.specs := ctx check-struct-specs types.common-types, ast
		struct.sum-type-memberships := ctx check-sum-type-memberships-initial types, struct, ast
		struct.body := match x = ast body
		as builtin-type-ast
			ctx check-only-common-modifiers builtin_, ast.modifiers
			ctx get-builtin-type struct
		as enum-ast
			ctx check-no-type-params ast.type-params, enum_
			ctx check-only-common-modifiers enum_, ast.modifiers
			ctx check-enum struct, x
		as flags-ast
			ctx check-no-type-params ast.type-params, flags_
			ctx check-only-common-modifiers flags_, ast.modifiers
			ctx check-flags struct, x
		as record-ast
			ctx check-record types, struct, ast.modifiers, x
		as sum-type-ast
			ctx check-sum-type types, struct, ast, x

-check-sum-type sum-type
	ctx check-ctx
	types-get types-get
	struct struct-decl
	ast struct-decl-ast
	ast-body sum-type-ast
do
	ctx check-only-common-modifiers ast-body.kind.decl-kind-for-sum-type, ast.modifiers
	listed-members = ctx check-sum-type-listed-members-initial types-get, struct, ast-body
	sigs = ctx check-signatures types-get, struct, ast.type-params, ast-body.methods
	ast-body.kind, listed-members, sigs

check-signatures signature[]
	ctx check-ctx
	types types-get
	container signature-container
	type-params type-params
	asts signature-ast[]
do
	for ast in asts
		return-type, params = ctx check-return-type-and-params types, container.to, ast.return-type, ast.params, type-params
		container, ast, return-type, params, ()

-check-sum-type-listed-members-initial sum-type-member-and-method-impls[]
	ctx check-ctx
	types types-get
	sum-type struct-decl
	ast sum-type-ast
do
	if ast.kind == union_
		if ast.types is-empty
			ctx add-diag sum-type.keyword-range.range, diag-empty-enum-or-union
		res sum-type-member-and-method-impls mut[] = ()
		for type-ast in ast types
			type = ctx type-from-ast types, type-ast, sum-type.type-param-asts, yes
			if type struct-inst
				if res exists it.member.decl == type.decl
					ctx add-diag type-ast.range, (union-member diag-duplicate-declaration type.decl.name)
				else
					res ~= type, ()
			elif type !is-bogus
				ctx add-diag type-ast.range, diag-union-member-type-parameter
		res move-to
	else
		unless ast.types is-empty
			ctx add-diag ast.types-range, diag-sum-type-listed-members-non-union
		()

-check-struct-specs specs(ctx check-ctx, common-types common-types, ast struct-decl-ast)
	for* modifier in ast modifiers
		match modifier
		as modifier-keyword-ast
			()
		as spec-use-ast
			name = modifier.name name
			if name == "summon"
				- common-types summon
			elif value build-target = name to
				- common-types extern-spec value
			else
				ctx add-diag modifier.name.range, ast.body.get-decl-kind.diag-spec-use-invalid
				()
	then get-or-add-specs

-check-sum-type-memberships-initial sum-type-membership[]
	ctx check-ctx
	types types-get
	struct struct-decl
	ast struct-decl-ast
do
	res sum-type-membership mut[] = ()
	for mod in ast modifiers
		guard membership = ctx sum-type-membership-from-modifier types, struct, mod
		if struct is-template
			ctx add-diag mod.range, struct.diag-case-type-is-template
		elif res exists it.sum-type.decl == membership.sum-type.decl
			ctx add-diag mod.range, (struct diag-case-duplicate membership.sum-type.decl)
		else
			res ~= membership
	res move-to
-sum-type-membership-from-modifier sum-type-membership?
	ctx check-ctx
	types types-get
	struct struct-decl
	mod modifier-ast
do
	guard mod modifier-keyword-ast
	guard mod.keyword == case_
	if type-ast = mod type-arg
		type = ctx type-from-ast types, type-ast, struct.type-param-asts, yes
		if type is-interface-or-variant
			mod, type.struct-inst!, ()
		else
			if type !is-bogus
				ctx add-diag mod.range, do struct diag-case-invalid-sum-type type
			()
	else
		ctx add-diag mod.range, diag-case-missing-type
		()

-is-interface-or-variant bool(a type) # TODO: probably rename to 'allow-declare-sum-type-membership' ????????????????????????????????
	a struct-inst and a.decl.body is-interface-or-variant
-is-interface-or-variant bool(a struct-body)
	a sum-type and match a kind
	as interface_
		true
	as java-interface
		true
	as variant_
		true
	as union_
		false

check-method-impls void(ctx check-ctx, funs-map funs-map, structs struct-decl[])
	for struct in structs
		if sum = struct.body sum-type
			members = sum listed-members
			guard members !is-empty
			inst = struct instantiated-with-own-type-params
			member-asts = struct.source.struct-decl-ast!.body.sum-type-ast! types
			for i, x in members with-index
				x.method-impls := ctx check-method-impls-for-case funs-map, \
					struct, x.member, \
					(if members.size == member-asts.size then member-asts[i] range else struct.name-range range), \
					inst, \
					struct.body.sum-type!.methods

		unless struct.sum-type-memberships is-empty
			member-type = struct instantiated-with-own-type-params
			for x in struct sum-type-memberships
				x.method-impls := ctx check-method-impls-for-case funs-map, \
					struct, member-type, x.ast!.range, x.sum-type, x.sum-type-decl-methods

-check-method-impls-for-case called?[]
	ctx check-ctx
	funs-map funs-map
	struct struct-decl
	member-type struct-inst
	diag-range source-range
	sum-type struct-inst
	method-decls signature[]
do
	member = member-type decl
	# Use the best case for the member type, because:
	# * Union cases have the same type parameters as the union.
	# * Interface or variant cases can't be templates anyway.
	unless sum-type.purity-range is-purity-always-compatible member-type.purity-range.best-case
		ctx add-diag diag-range, (member diag-purity-worse-than-sum-type sum-type)

	for sig in method-decls
		types return-and-param-types =
			- sig.return-type instantiate-type sum-type.type-args
			- with out in build
				out ~= member-type
				for x in sig params
					out ~= x.type instantiate-type sum-type.type-args
		called = ctx check-method-impl funs-map, struct, sig.name, types, diag-range
		if fun = called ?fun-inst
			if fun.decl.visibility < (sum-type.decl.visibility min member.visibility)
				ctx add-diag diag-range, (member diag-method-impl-visibility sum-type, fun)
		called

-purity-and-forced record(purity purity, forced bool)
-get-struct-purity purity-and-forced(ctx check-ctx, ast struct-decl-ast)
	if modifier = ctx get-purity-modifier ast
		pf = modifier.keyword purity-and-forced-from-modifier!
		if pf.purity == data_ and pf !forced
			ctx add-diag modifier.keyword-range,
				modifier.keyword diag-modifier-redundant-due-to-decl-kind ast.body.get-decl-kind
		pf
	else
		data_, false

-get-purity-modifier modifier-keyword-ast?(ctx check-ctx, ast struct-decl-ast)
	res modifier-ast mut[void] = ()
	for modifier in ast modifiers
		match modifier
		as modifier-keyword-ast
			guard modifier.keyword !is-new-visibility and modifier.keyword != case_
			if modifier.keyword purity-and-forced-from-modifier
				ctx modifier-type-arg-invalid modifier
				ctx accumulate-modifier res, (), modifier, true
			else
				ctx add-diag modifier.keyword-range,
					modifier.keyword diag-modifier-invalid ast.body.get-decl-kind
		as spec-use-ast
			()
	res[] ?modifier-keyword-ast

-decl-kind-for-sum-type decl-kind(a sum-type-kind)
	match a
	as interface_
		interface_
	as java-interface
		java-interface
	as union_
		union_
	as variant_
		variant_

-get-decl-kind decl-kind(a struct-body-ast)
	match a
	as builtin-type-ast
		builtin_
	as enum-ast
		enum_
	as flags-ast
		flags_
	as record-ast
		record_
	as sum-type-ast
		a.kind decl-kind-for-sum-type

-purity-and-forced-from-modifier purity-and-forced?(a modifier-keyword)
	match a
	as data_
		data_, false
	as force-data_
		data_, true
	as force-shared_
		shared_, true
	as mut_
		mut_, false
	as shared_
		shared_, false
	else
		()

-check-only-common-modifiers void(ctx check-ctx, decl-kind decl-kind, modifiers modifier-ast[])
	for modifier in modifiers
		unless modifier is-common-modifier
			ctx add-diag-modifier-invalid decl-kind, modifier

-add-diag-modifier-invalid void(ctx check-ctx, decl-kind decl-kind, modifier modifier-ast)
	ctx add-diag modifier.range, match modifier
	as modifier-keyword-ast
		modifier.keyword diag-modifier-invalid decl-kind
	as spec-use-ast
		decl-kind diag-spec-use-invalid

-is-common-modifier bool(a modifier-ast)
	match a
	as modifier-keyword-ast
		a.keyword == case_ or a.keyword purity-and-forced-from-modifier
	as spec-use-ast
		a.name.name == "summon" or a.name.name.to::build-target?

-check-enum enum_(ctx check-ctx, struct struct-decl, ast enum-ast)
	members = ctx check-enum-or-flags-members struct, ast.params, ast.members, enum-member, of diag-range, last-value, declared-value
		if declared-value
			if last-value and declared-value <= last-value
				ctx add-diag diag-range, last-value.diag-enum-value-not-sorted
				ctx next-enum-value diag-range, last-value
			else
				declared-value
		else
			ctx next-enum-value diag-range, last-value
	if members.members is-empty
		ctx add-diag struct.name-range.range, diag-empty-enum-or-union
	members.storage, members.members, members.members-by-name
-next-enum-value nat(ctx check-ctx, diag-range source-range, last-value nat?)
	if last-value
		try
			last-value + 1
		catch as binary-out-of-range
			ctx add-diag diag-range, nat64.to.diag-literal-overflow
			0
	else
		0

-check-flags flags_(ctx check-ctx, struct struct-decl, ast flags-ast)
	members = ctx check-enum-or-flags-members struct, ast.params, ast.members, flags-member, of diag-range, last-value, declared-value
		if declared-value
			if declared-value is-power-of-two
				if last-value and declared-value <= last-value
					ctx add-diag diag-range, last-value.diag-enum-value-not-sorted
					ctx next-flags-value diag-range, last-value
				else
					declared-value
			else
				ctx add-diag diag-range, diag-flags-value-not-power-of-2
				ctx next-flags-value diag-range, last-value
		else
			ctx next-flags-value diag-range, last-value
	members.storage, members.members
-next-flags-value nat(ctx check-ctx, diag-range source-range, last-value nat?)
	if last-value
		try
			last-value * 2
		catch as binary-out-of-range
			ctx add-diag diag-range, nat64.to.diag-literal-overflow
			()
	else
		1

-enum-or-flags-members record(storage nat-type, members enum-or-flags-member[], members-by-name enum-or-flags-member by-name)
-check-enum-or-flags-members enum-or-flags-members
	ctx check-ctx
	struct struct-decl
	params destructure-ast[]?
	member-asts enum-or-flags-member-ast[]
	member-kind diag-duplicate-declaration-kind
	cb-get-next-value nat mut(diag-range source-range, last-value nat?, declared-value nat?)
do
	if params and member-asts !is-empty
		ctx add-diag struct.name-range.range,
			struct diag-struct-params-syntax-error has-params-and-fields

	last-value mut nat? = ()
	cb-value cb-enum-value = of value-range, literal
		declared-value nat? = if literal
			ctx check-literal-nat-value nat64, literal.range
		value = cb-get-next-value[value-range, last-value, declared-value]
		last-value := value
		value

	members = if params
		ctx enum-or-flags-members-from-params struct, params, cb-value
	else
		with out in member-asts.size build
			for x in member-asts
				guard value = cb-value[x.range, x.value]
				out ~= x, struct, value, ()

	members-by-name enum-or-flags-member by-name = members to-by-name of _, duplicate
		ctx add-diag duplicate.name-range.range,
			member-kind diag-duplicate-declaration duplicate.name
	members.enum-storage-type, members, members-by-name

-cb-enum-value alias
	nat? mut(range source-range, explicit literal-number?)

-enum-or-flags-members-from-params enum-or-flags-member[]
	ctx check-ctx
	enum-or-flags struct-decl
	params destructure-ast[]
	cb-value cb-enum-value
do
	with out in params.size build
		for x in params
			guard value = cb-value[x.range, ()]
			guard member = ctx enum-member-from-param enum-or-flags, x, value
			out ~= member

-enum-storage-type nat-type(members enum-or-flags-member[])
	max nat = if members is-empty then 0 else members[end - 1].value
	if max <= max-value::nat8.to
		nat8
	elif max <= max-value::nat16.to
		nat16
	elif max <= max-value::nat32.to
		nat32
	else
		nat64

-check-record record_
	ctx check-ctx
	types types-get
	struct struct-decl
	modifier-asts modifier-ast[]
	ast record-ast
do
	modifiers = ctx accumulate-record-modifiers modifier-asts
	fields = ctx check-record-fields types, struct, ast
	new-visibility: ctx record-new-visibility struct, fields, modifiers
	fields: fields

-check-record-fields record-field[]
	ctx check-ctx
	types types-get
	struct struct-decl
	ast record-ast
do
	if ast params and ast.fields !is-empty
		ctx add-diag struct.name-range.range, (struct diag-struct-params-syntax-error has-params-and-fields)
	res record-field[] = if params = ast params
		for* param in params
			ctx record-field-from-param types, struct, param from-option
	else
		for x in ast fields
			ctx check-record-field types, struct, x, x.visibility, x.name, x.mutability, x.type
	res each-pair of x, y
		if x.name == y.name
			ctx add-diag-assert-same-uri y.range,
				record-field diag-duplicate-declaration y.name
	res

# TODO: move closer to where it is used? ------------------------------------------------------------------------------------------
-enum-member-from-param enum-or-flags-member?
	ctx check-ctx
	enum_ struct-decl
	ast destructure-ast
	value nat
do
	if ast single-destructure-ast
		if x = ast mut-range
			ctx add-diag x, enum-member-mutability::diag-unsupported-syntax
		if x = ast type
			ctx add-diag x.range, enum-member-type::diag-unsupported-syntax
		ast, enum_, value, ()
	else
		ctx add-diag ast.range, (enum_ diag-struct-params-syntax-error destructure)
		()

-record-field-from-param record-field?
	ctx check-ctx
	types types-get
	record_ struct-decl
	ast destructure-ast
do
	if ast single-destructure-ast
		mutability field-mutability-ast? = if x = ast mut_ then x, ()
		ctx check-record-field types, record_, ast, (), ast.name, mutability, ast.type
	else
		ctx add-diag ast.range, (record_ diag-struct-params-syntax-error destructure)
		()

# Shared in common between {single-destructure-ast} and {record-field-ast}
-check-record-field record-field
	ctx check-ctx
	types types-get
	record_ struct-decl
	source record-field-source
	visibility-ast visibility-and-range?
	name name-and-range
	mutability-ast field-mutability-ast?
	type-ast type-ast?
do
	member-type = if type-ast
		ctx type-from-ast types, type-ast, record_.type-param-asts, yes
	else
		ctx add-diag name.range, name.name.diag-record-field-needs-type
		bogus-type
	ctx check-reference-purity record_, source.range, member-type

	visibility = ctx visibility-from-default-with-diag record_.visibility, visibility-ast,
		record_ visibility-warning-field name.name
	mutability visibility? = if mutability-ast
		if record_.purity != mut_ and record_ !purity-is-forced
			ctx add-diag mutability-ast.range, diag-mut-field-not-allowed
		ctx visibility-from-default-with-diag visibility, mutability-ast.visibility,
			name.name visibility-warning-field-mutability
	source, record_, visibility, mutability, member-type, ()

-record-modifiers record
	new-visibility modifier-ast?

-accumulate-modifier[k] void(ctx check-ctx, res modifier-ast mut[k], key k, new modifier-ast, diags bool) k key
	if diags and old = res[key]
		ctx add-diag new.range, if new.name-or-keyword == old.name-or-keyword
			new.name-or-keyword diag-modifier-duplicate
		else
			old.name-or-keyword diag-modifier-conflict new.name-or-keyword
	res[key] := new

-accumulate-record-modifiers record-modifiers(ctx check-ctx, modifiers modifier-ast[])
	res modifier-ast mut[symbol] = ()
	for modifier in modifiers
		guard modifier modifier-keyword-ast
		keyword = modifier keyword
		if keyword is-new-visibility
			ctx modifier-type-arg-invalid modifier
			ctx accumulate-modifier res, "new", modifier, true
		elif modifier !is-common-modifier
			ctx add-diag modifier.keyword-range, do keyword diag-modifier-invalid record_
	new-visibility: res["new"]

-is-new-visibility bool(a modifier-keyword)
	a == new-internal or a == new-private or a == new-public

-check-reference-purity void(ctx check-ctx, struct struct-decl, range source-range, referenced-type type)
	unless struct.purity is-purity-possibly-compatible referenced-type.purity-range or struct purity-is-forced
		ctx add-diag range, (struct diag-purity-worse-than-parent referenced-type.struct-inst!)

-record-new-visibility visibility
	ctx check-ctx
	record_ struct-decl
	fields record-field[]
	modifiers record-modifiers
do
	default mut = record_ visibility
	for field in fields
		default min:= field visibility
	explicit visibility-and-range? = if x = modifiers new-visibility
		kw = x modifier-keyword-ast!
		kw.keyword.visibility-from-new-visibility, kw.keyword-pos
	ctx visibility-from-default-with-diag default, explicit, record_.visibility-warning-new

-visibility-from-new-visibility visibility(a modifier-keyword)
	match a
	as new-private
		private
	as new-internal
		internal
	as new-public
		public
	else
		throw unreachable

-get-builtin-type builtin-type(ctx check-ctx, struct struct-decl)
	struct.name to else
		ctx add-diag-assert-same-uri struct.name-range, (type diag-builtin-unsupported struct.name)
		void
