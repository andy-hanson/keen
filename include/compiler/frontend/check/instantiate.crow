import
	../../model/model
	../../model/source-range
	../all-insts

# TODO: This doesn't need its own type, just use all-insts? -------------------------------------------------------------------------------------
instantiate-ctx record mut
	all-insts all-insts

next-hash nat32(a instantiate-ctx)
	next-hash a.all-insts

delay-spec-insts alias
	spec-inst mut[]
may-delay-spec-insts alias
	spec-inst mut[]?
no-delay-spec-insts may-delay-spec-insts()
	()

instantiate-type-args type-args(a type-args, type-args type-args)
	map-type-args a, of x
		instantiate-type x, type-args
instantiate-type type(type type, type-args type-args)
	match type
	as bogus-type
		bogus-type
	as type-param-index
		type-args[type.index]
	as struct-inst
		instantiate-struct-inst type, type-args

instantiate-fun fun-inst(decl fun-decl, type-args type-args, specs specs, spec-impls spec-impls)
	get-or-add-fun-inst decl, type-args, spec-impls, of
		- instantiate-return-and-param-types decl.return-type, decl.params, type-args
		- specs

instantiate-spec-or-type spec-or-type-inst(ctx instantiate-ctx, decl spec-or-type, type-args type-args, delay-spec-insts may-delay-spec-insts)
	match decl
	as spec-decl
		instantiate-spec ctx, decl, type-args, delay-spec-insts
	as struct-alias
		decl.target
	as struct-decl
		decl[type-args]

instantiate-struct-inst struct-inst(struct-inst struct-inst, type-args type-args)
	do unless is-empty type-args else struct-inst
	struct-inst.decl[instantiate-type-args struct-inst.type-args, type-args]

instantiate-spec spec-inst(ctx instantiate-ctx, decl spec-decl, type-args type-args)
	instantiate-spec ctx, decl, type-args, ()
instantiate-spec spec-inst(ctx instantiate-ctx, decl spec-decl, type-args type-args, delay-spec-insts may-delay-spec-insts)
	value, did-add = get-or-add-spec-inst decl, type-args
	if did-add
		if decl.body-is-set
			instantiate-spec-body ctx, value, delay-spec-insts
		else
			delay-spec-insts! ~= value
	value

instantiate-spec-body void(ctx instantiate-ctx, a spec-inst, delay-spec-insts may-delay-spec-insts)
	parents spec-or-type-inst[] = for parent in a.decl.parents.inner
		instantiate-spec-or-type-inst ctx, parent, a.type-args, delay-spec-insts
	a.builtin_ := with out in build
		for parent in parents
			if parent.spec-inst
				out ~~= parent.builtin_
		if b = a.decl.builtin_
			out ~= b, a.type-args
	a.all-contexts := to-type-args for* parent in parents
		match parent
		as spec-inst
			parent.all-contexts.slow-to-array
		as struct-inst
			- parent
	a.all-sigs := with out in build
		for parent in parents
			if parent.spec-inst
				out ~~= parent.all-sigs
		out ~~= a.decl.sigs
	a.sig-types := with out in build
		for parent in parents
			if parent.spec-inst
				out ~~= parent.sig-types
		for sig in a.decl.sigs
			out ~= instantiate-return-and-param-types sig.return-type, sig.params, a.type-args

instantiate-specs specs(ctx instantiate-ctx, specs specs, type-args type-args)
	do unless is-empty type-args else specs
	get-or-add-specs for x in specs.inner
		instantiate-spec-or-type-inst ctx, x, type-args, no-delay-spec-insts

instantiate-spec-or-type-inst spec-or-type-inst
	ctx instantiate-ctx
	inst spec-or-type-inst
	type-args type-args
	delay-spec-insts may-delay-spec-insts
do
	match inst
	as spec-inst
		instantiate-spec-inst ctx, inst, type-args, delay-spec-insts
	as struct-inst
		instantiate-struct-inst inst, type-args

instantiate-spec-inst spec-inst(ctx instantiate-ctx, spec-inst spec-inst, type-args type-args, delay-spec-insts may-delay-spec-insts)
	instantiated-type-args = instantiate-type-args spec-inst.type-args, type-args
	instantiate-spec ctx, spec-inst.decl, instantiated-type-args, delay-spec-insts

-instantiate-return-and-param-types return-and-param-types
	decl-return-type type
	decl-params destructure[]
	type-args type-args
do
	- instantiate-type decl-return-type, type-args
	- for x in decl-params
		instantiate-type x.type, type-args

fun-for-method fun-decl(ctx instantiate-ctx, struct struct-decl, inst struct-inst, method-index nat, method signature)
	hash: next-hash ctx
	source: method
	visibility: struct.visibility
	n-type-params: struct.n-type-params
	return-type: method.return-type
	params:
		- destructure-ignore struct, inst
		-- method.params
	specs: struct.specs
	doc-comment-references: ()
	body: fun-body-method method-index, method
