import
	../../model/model
	../../model/source-range
	../all-insts

# TODO: This doesn't need its own type, just use all-insts? -------------------------------------------------------------------------------------
instantiate-ctx record mut
	all-insts all-insts

next-hash nat32(a instantiate-ctx)
	a.all-insts next-hash

delay-spec-insts alias
	spec-inst mut[]
may-delay-spec-insts alias
	spec-inst mut[]?
no-delay-spec-insts may-delay-spec-insts()
	()

instantiate-type-args type-args(a type-args, type-args type-args)
	a map-type-args of x then x instantiate-type type-args
instantiate-type type(type type, type-args type-args)
	match type
	as bogus-type
		bogus-type
	as type-param-index
		type-args[type index]
	as struct-inst
		type instantiate-struct-inst type-args

instantiate-fun fun-inst(decl fun-decl, type-args type-args, spec-impls spec-impls)
	decl get-or-add-fun-inst type-args, spec-impls, of
		decl.return-type instantiate-return-and-param-types decl.params, type-args

instantiate-struct-inst struct-inst(struct-inst struct-inst, type-args type-args)
	struct-inst.decl[struct-inst.type-args instantiate-type-args type-args]

instantiate-spec spec-inst(ctx instantiate-ctx, decl spec-decl, type-args type-args)
	ctx instantiate-spec decl, type-args, ()
instantiate-spec spec-inst(ctx instantiate-ctx, decl spec-decl, type-args type-args, delay-spec-insts may-delay-spec-insts)
	value, did-add = decl get-or-add-spec-inst type-args
	if did-add
		if decl body-is-set
			ctx instantiate-spec-body value, delay-spec-insts
		else
			delay-spec-insts! ~= value
	value

instantiate-spec-body void(ctx instantiate-ctx, a spec-inst, delay-spec-insts may-delay-spec-insts)
	parents spec-inst[] = for parent in a.decl.parents inner
		ctx instantiate-spec-inst parent, a.type-args, delay-spec-insts
	a.builtin_ := with out in build
		for parent in parents
			out ~~= parent builtin_
		if b = a.decl builtin_
			out ~= b, a.type-args
	a.all-sigs := with out in build
		for parent in parents
			out ~~= parent all-sigs
		out ~~= a.decl sigs
	a.sig-types := with out in build
		for parent in parents
			out ~~= parent sig-types
		for sig in a.decl sigs
			out ~= sig.return-type instantiate-return-and-param-types sig.params, a.type-args

instantiate-specs specs(ctx instantiate-ctx, specs specs, type-args type-args)
	guard type-args !is-empty else specs
	for x in specs inner
		ctx instantiate-spec-inst x, type-args, no-delay-spec-insts
	then get-or-add-specs

instantiate-spec-inst spec-inst(ctx instantiate-ctx, spec-inst spec-inst, type-args type-args, delay-spec-insts may-delay-spec-insts)
	instantiated-type-args = spec-inst.type-args instantiate-type-args type-args
	ctx instantiate-spec spec-inst.decl, instantiated-type-args, delay-spec-insts

-instantiate-return-and-param-types return-and-param-types
	decl-return-type type
	decl-params destructure[]
	type-args type-args
do
	- decl-return-type instantiate-type type-args
	- for x in decl-params
		x.type instantiate-type type-args

fun-for-method fun-decl(ctx instantiate-ctx, struct struct-decl, method-index nat, method signature)
	hash: ctx next-hash
	source: method
	visibility: struct visibility
	n-type-params: struct n-type-params
	return-type: method return-type
	params:
		- struct destructure-ignore struct.instantiated-with-own-type-params
		-- method.params
	specs: struct specs
	doc-comment-references: ()
	body: method-index fun-body-method method
