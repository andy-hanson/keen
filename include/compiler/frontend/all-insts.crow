import
	../model/model
	../util/object-memoizer
	../util/util

all-insts record mut
	-struct-insts struct-inst object-memoizer
	-spec-insts spec-inst object-memoizer
	-fun-insts fun-inst object-memoizer
	upcoming-id mut nat64 # KILL -----------------------------------------------------------------------------------------------------------
new all-insts()
	(), (), (), 1

# TODO: just name this 'subscript' --------------------------------------------------------------------------------------------
get-or-add-struct-inst struct-inst(a all-insts, decl struct-decl, type-args type-args)
	hash = do
		hasher hasher = ()
		hasher hash-mix decl
		hasher hash-mix type-args
		hasher finish
	a.struct-insts[decl, type-args, hash]

get-or-add-spec-inst spec-inst value-and-did-add(a all-insts, decl spec-decl, type-args type-args)
	hash = do
		hasher hasher = ()
		hasher hash-mix decl
		hasher hash-mix type-args
		hasher finish
	a.spec-insts get-and-did-add (decl, type-args, hash, ())

get-or-add-fun-inst fun-inst(
	a all-insts,
	decl fun-decl,
	type-args type-args,
	spec-impls spec-impls, 
	cb-return-and-param-types return-and-param-types mut(),
)
	res = a.fun-insts get-and-did-add (decl, type-args, spec-impls, ((),))
	if res did-add
		res.value.instantiated-sig := cb-return-and-param-types[]
	res value

get-all-future-and-mut-array-impls struct-inst[struct-inst](
	a all-insts,
	cb-make-future-impl struct-inst mut(args type-args),
	cb-make-mut-array-impl struct-inst mut(args type-args),
)
	keys struct-inst[] = with out : build
		for x : a struct-insts
			if x is-future || x is-mut-array
				out ~= x
	for x : keys
		x, if x is-future
			cb-make-future-impl[x type-args]
		elif x is-mut-array
			cb-make-mut-array-impl[x type-args]
		else
			throw unreachable
