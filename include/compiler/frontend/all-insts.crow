import
	crow/crypto/pseudo-random
	../model/model
	../model/uri
	../util/object-memoizer
	../util/util

all-insts record mut
	-prng prng
	-type-arrays type-array object-memoizer
	-spec-insts spec-inst object-memoizer
new all-insts()
	(), (), ()

perf-report json[symbol](a all-insts)
	("type-arrays", a.type-arrays.perf-report), \
	("spec-insts", a.spec-insts.perf-report)

next-hash nat(a all-insts)
	a.prng next

get-or-add-type-array type-array(a all-insts, types type[])
	unless types is-empty
		a.type-arrays[types, types.get-hash]

# TODO: just name this 'subscript' --------------------------------------------------------------------------------------------
get-or-add-struct-inst struct-inst(a all-insts, decl struct-decl, type-args type[])
	match decl insts
	as struct-inst x
		assert type-args is-empty
		x
	as object-memoizer x
		types = a get-or-add-type-array type-args
		x[decl, types]

get-or-add-spec-inst spec-inst value-and-did-add(a all-insts, decl spec-decl, type-args type[])
	types = a get-or-add-type-array type-args
	hash = do
		hasher hasher = ()
		hasher hash-mix decl
		hasher hash-mix types
		hasher finish
	a.spec-insts get-and-did-add (decl, types, hash, ())

get-or-add-fun-inst fun-inst(
	a all-insts,
	decl fun-decl,
	type-args type[],
	spec-impls spec-impls, 
	cb-return-and-param-types return-and-param-types mut(),
)
	match decl insts
	as fun-inst x
		x
	as object-memoizer x
		res = x get-and-did-add (decl, (a get-or-add-type-array type-args), spec-impls, ((),))
		if res did-add
			res.value.instantiated-sig := cb-return-and-param-types[]
		res value

get-all-future-and-mut-array-impls struct-inst[struct-inst](
	future struct-decl,
	mut-array struct-decl,
	cb-make-future-impl struct-inst mut(args type-args),
	cb-make-mut-array-impl struct-inst mut(args type-args),
)
	keys struct-inst[] = with out : build
		for x : future.insts object-memoizer!
			out ~= x
		for x : mut-array.insts object-memoizer!
			out ~= x
	for x : keys
		x, if x is-future
			cb-make-future-impl[x type-args]
		elif x is-mut-array
			cb-make-mut-array-impl[x type-args]
		else
			throw unreachable
