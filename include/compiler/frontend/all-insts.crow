import
	crow/crypto/pseudo-random
	../../crow/col/experimental/object-memoizer
	../model/model

all-insts record mut
	-prng prng
	-type-arrays (type-array, type-array-key) object-memoizer
	-spec-arrays (specs, specs-key) object-memoizer
new all-insts()
	(), (), ()

perf-report json[symbol](a all-insts)
	("type-arrays", a.type-arrays.perf.to),

-to json(a object-memoizer-perf)

next-hash nat32(a all-insts)
	a.prng next

get-or-add-type-array type-array(a all-insts, types type[])
	unless types is-empty
		hash = do
			hasher hasher = ()
			hasher hash-mix types
			hasher finish
		trusted a.type-arrays memoize (types, hash), () => (types, hash)

get-or-add-specs specs(a all-insts, specs spec-inst[])
	unless specs is-empty
		hash = do
			hasher hasher = ()
			hasher hash-mix specs
			hasher finish
		trusted a.spec-arrays memoize (specs, hash), () => (specs, hash)

# TODO: just name this 'subscript' --------------------------------------------------------------------------------------------
get-or-add-struct-inst struct-inst(a all-insts, decl struct-decl, type-args type[])
	match decl insts
	as struct-inst x
		assert type-args is-empty
		x
	as object-memoizer x
		types = a get-or-add-type-array type-args
		trusted x memoize types, () => (decl, types)

get-or-add-spec-inst (spec-inst, bool)(a all-insts, decl spec-decl, type-args type[])
	types = a get-or-add-type-array type-args
	did-add mut = false
	res = trusted decl.insts memoize types, () =>
		did-add := true
		decl, types, ()
	res, did-add

get-or-add-fun-inst fun-inst(
	a all-insts,
	decl fun-decl,
	type-args type[],
	spec-impls spec-impls, 
	cb-return-and-param-types return-and-param-types mut(),
)
	match decl insts
	as fun-inst x
		x
	as object-memoizer x
		types = a get-or-add-type-array type-args
		trusted x memoize (types, spec-impls), () =>
			decl, types, spec-impls, cb-return-and-param-types[]
get-all-future-and-mut-array-impls struct-inst[struct-inst](
	future struct-decl,
	mut-array struct-decl,
	cb-make-future-impl struct-inst mut(args type-args),
	cb-make-mut-array-impl struct-inst mut(args type-args),
)
	keys struct-inst[] = with out : build
		trusted for x : future.insts object-memoizer!
			out ~= x
		trusted for x : mut-array.insts object-memoizer!
			out ~= x
	for x : keys
		x, if x is-future
			cb-make-future-impl[x type-args]
		elif x is-mut-array
			cb-make-mut-array-impl[x type-args]
		else
			throw unreachable
