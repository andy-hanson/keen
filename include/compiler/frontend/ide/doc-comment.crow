import
	crow/parse
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri

doc-comment-string string(file-contents file-content-getters, uri uri, a doc-comment)
	unless is-empty a
		strip-doc-comment file-contents[uri, a.ast.range!]
-strip-doc-comment string(a char8 array-view)
	iter string-iterator = begin a
	res char8[] = with out in build
		until iter.is-at-end
			while is-whitespace-or-bar iter.peek8
				_ = take-char8 iter
			while !iter.is-at-end and iter.peek8 != "\n"
				out ~= take-char8 iter
			while try-take iter, "\n"
				out ~= "\n"
	res.to
-is-whitespace-or-bar bool(a char8)
	is-whitespace a or a == "|"
