import
	crow/parse
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri

doc-comment-string string(file-contents file-content-getters, uri uri, a doc-comment)
	unless is-empty a
		strip-doc-comment file-contents[uri, a.ast.range!]
-strip-doc-comment string(a char8 array-view)
	# This filters out '| ' at the beginning of lines
	do with out in build
	iter = begin a
	until is-at-end iter
		while x = peek iter and x == "|" or is-whitespace x
			_ = take-char8 iter
		while x = peek iter and x != "\n"
			out ~= take-char8 iter
		unless is-at-end iter
			out ~= take-char8 iter
