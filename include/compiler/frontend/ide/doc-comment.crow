import
	crow/parse
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri

doc-comment-string string(file-contents file-content-getters, uri uri, a doc-comment)
	unless a is-empty
		file-contents[uri, a.ast.range!] strip-doc-comment
-strip-doc-comment string(a char8 array-view)
	iter string-mut-iterator = a,
	res char8[] = with out in build
		until iter is-at-end
			while iter.peek8 is-whitespace-or-bar
				_ = iter take-char8
			while iter !is-at-end and iter.peek8 != "\n"
				out ~= iter take-char8
			while iter try-take "\n"
				out ~= "\n"
	res to
-is-whitespace-or-bar bool(a char8)
	a is-whitespace or a == "|"
