import
	crow/parse
	../../../crow/private/parse-util
	../../frontend/parse/parse
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/parse-diag
	../../model/source-range

syntax-translate syntax-translate-result(params syntax-translate-params)
	if "\n"::char32 in params.source
		"", (0,)
	elif params.from-language == params.to-language
		params.source, ()
	elif params.to-language == crow
		expr, diags = params.source parse-java-expr
		result string = with out in build
			out translate-to-crow expr, root, ()
		result, diags
	elif params.from-language == crow
		res = params.source parse-single-line-expression
		result mut string = ""
		diagnostics pos[] = with diags-out in build
			for x in res diags
				diags-out ~= x.range.start
			result := with out in build
				out translate-crow-to-c-or-java diags-out, res.expr, params.to-language == java
		result, diagnostics
	else
		expr, diags = params.source parse-java-expr
		result string = with out in build
			out output-c-or-java (expr translate-between-c-or-java params.to-language == java)
		result, diags

-translate-crow-to-c-or-java void
	out string-builder
	diags-out pos array-builder
	a expr-ast
	is-java bool
do
	match a
	as call-ast
		out translate-call-to-c-or-java diags-out, a.fun-name.name, a.args, is-java
	as force-ast
		out translate-call-to-c-or-java diags-out, "force", (a.arg,), is-java
	as name-and-range
		out ~~= a.name to
	as parenthesized-ast
		out translate-crow-to-c-or-java diags-out, a.inner, is-java
	else
		diags-out ~= a.range.start
-translate-call-to-c-or-java void
	out string-builder
	diags-out pos array-builder
	fun-name symbol
	args expr-ast[]
	is-java bool
do
	remaining-args = if is-java and args !is-empty
		out translate-crow-to-c-or-java diags-out, args[0], is-java
		out ~= "."
		args[1 .. end]
	else
		args to
	out ~~= fun-name to
	out write-parenthesized remaining-args, of x
		out translate-crow-to-c-or-java diags-out, x, is-java

-output-c-or-java void(out string-builder, a java-expr)
	match a
	as java-bogus
		out ~~= "bogus"
	as symbol
		out ~~= a to
	as java-call
		out output-c-or-java a.called
		out write-parenthesized a.args, of arg
			out output-c-or-java arg
	as java-dot
		out output-c-or-java a.left
		out ~= "."
		out ~~= a.name to

-translate-between-c-or-java java-expr(a java-expr, output-java bool)
	match a
	as java-call
		match called = a called
		as java-bogus
			a
		as symbol
			if output-java and a.args !is-empty
				arg0 = a.args[0] translate-between-c-or-java output-java
				left = arg0 java-dot called translate-between-c-or-java output-java
				left java-call for arg in a.args[1 .. end]
					arg translate-between-c-or-java output-java
			else
				a
		as java-call
			a
		as java-dot
			if output-java
				a
			else
				called.name java-call
					- called.left translate-between-c-or-java output-java
					-- for arg in a args then arg translate-between-c-or-java output-java
	else
		a

-write-parenthesized[col, elem] void(out string-builder, values col, f void mut(x elem)) (col, elem) iterate
	out ~= "("
	out write-with-commas values, f
	out ~= ")"
-write-with-commas[col, elem] void(out string-builder, values col, f void mut(x elem)) (col, elem) iterate
	for i, x in values with-index
		if i != 0
			out ~~= ", "
		f[x]

-position enum(root, first-arg, non-first-arg, before-dot)
-== bool(a position, b position)
-augment enum(not, force)
-to augment?(a symbol)
-== bool(a augment, b augment)
-with-augment void(out string-builder, augment augment?, name symbol)
	out with-augment augment, of
		out ~~= name to
-with-augment void(out string-builder, augment augment?, f void mut())
	if augment == not
		out ~= "!"
	f[]
	if augment == force
		out ~= "!"

-translate-to-crow void(out string-builder, a java-expr, position position, augment augment?)
	match a
	as java-bogus
		out ~~= "bogus"
	as symbol
		out with-augment augment, a
	as java-call
		out translate-call-to-crow a, position, augment
	as java-dot
		out write-crow-call a.left, a.name, (), position, augment
-translate-call-to-crow void(out string-builder, a java-call, position position, augment augment?)
	args = a args
	match called = a called
	as java-bogus
		out ~~= "bogus"
	as symbol
		if args is-empty
			out with-augment augment, called
		else
			out write-crow-call args[0], called, args[1 .. end], position, augment
	as java-call
		out with-augment augment, of
			out translate-to-crow called, position, ()
			out ~= "["
			out write-with-commas args, of arg
				out translate-to-crow arg, non-first-arg, ()
			out ~= "]"
	as java-dot
		out write-crow-call called.left, called.name, args.to, position, augment
-write-crow-call void
	out string-builder
	arg0 java-expr
	name symbol
	rest-args java-expr array-view
	position position
	augment augment?
do
	if rest-args is-empty
		new-augment augment? = if augment
			()
		else
			name to
		if new-augment
			out translate-to-crow arg0, position, new-augment
		elif position == root
			out translate-to-crow arg0, first-arg, ()
			out ~= " "
			out with-augment augment, name
		else
			out with-augment augment, of
				out translate-to-crow arg0, before-dot, ()
				out ~= "."
				out ~~= name to
	else
		needs-parens bool = match position
		as root
			false
		as first-arg
			false
		as non-first-arg
			true
		as before-dot
			true
		if needs-parens
			out ~= "("
		out translate-to-crow arg0, first-arg, ()
		out ~= " "
		out with-augment augment, name
		out ~= " "
		out write-with-commas rest-args, of arg
			out translate-to-crow arg, non-first-arg, ()
		if needs-parens
			out ~= ")"

| Also represents C expressions
-java-expr union(java-bogus, symbol, java-call, java-dot)
-java-bogus record
-java-call record(called java-expr, args java-expr[])
-java-dot record(left java-expr, name symbol)

-parse-ctx record(diags pos mut[]) mut
-add-diag void(ctx parse-ctx, cur string-iterator)
	ctx.diags ~= cur.pos

-parse-java-expr (java-expr, pos[])(source string)
	ctx parse-ctx = (),
	iter = source begin
	res = ctx parse-java-expr-recur iter
	iter skip-whitespace
	unless iter is-at-end
		ctx add-diag iter
	res, ctx.diags.move-to

-parse-java-expr-recur java-expr(ctx parse-ctx, ptr string-iterator)
	ptr skip-whitespace
	if name ?= ptr try-take-crow-identifier
		ctx parse-java-expr-suffixes ptr, name
	else
		ctx add-diag ptr
		java-bogus
-parse-java-expr-suffixes java-expr(ctx parse-ctx, ptr string-iterator, lhs java-expr)
	ptr skip-whitespace
	if ptr try-take "."
		if name ?= ptr try-take-crow-identifier
			ctx parse-java-expr-suffixes ptr, (lhs java-dot name)
		else
			ctx add-diag ptr
			lhs
	elif ptr try-take "("
		args java-expr[] = if ptr try-take ")"
			()
		else
			with out in build
				loop
					out ~= ctx parse-java-expr-recur ptr
					ptr skip-whitespace
					if ptr try-take ","
						continue
					else
						break
				unless ptr try-take ")"
					ctx add-diag ptr
		ctx parse-java-expr-suffixes ptr, (lhs java-call args)
	else
		lhs

test
	"a" test-all-ways "a", "a"
	"a f" test-all-ways "f(a)", "a.f()"
	"a.f.g h" test-all-ways "h(g(f(a)))", "a.f().g().h()"
	"a f b" test-all-ways "f(a, b)", "a.f(b)"
	"a f b, c" test-all-ways "f(a, b, c)", "a.f(b, c)"
	"a.g f b, c" test-all-ways "f(g(a), b, c)", "a.g().f(b, c)"
	"a.g f b.h, c" test-all-ways "f(g(a), h(b), c)", "a.g().f(b.h(), c)"
	"a g b f c, d" test-all-ways "f(g(a, b), c, d)", "a.g(b).f(c, d)"
	"a g b, c f d, e" test-all-ways "f(g(a, b, c), d, e)", "a.g(b, c).f(d, e)"
	"a g b f (c h d), e.i" test-all-ways "f(g(a, b), h(c, d), i(e))", "a.g(b).f(c.h(d), e.i())"
	"a !f b" test-all-ways "not(f(a, b))", "a.f(b).not()"
	"a f! b" test-all-ways "force(f(a, b))", "a.f(b).force()"

	c test-one-way "f(a) x", crow, "a f", (5,)
	crow test-one-way "x\n", c, "", (0,)

-test-all-ways void(crow-src string, c-src string, java-src string)
	crow test-one-way crow-src, c, c-src, ()
	crow test-one-way crow-src, java, java-src, ()
	c test-one-way c-src, crow, crow-src, ()
	c test-one-way c-src, java, java-src, ()
	java test-one-way java-src, crow, crow-src, ()
	java test-one-way java-src, c, c-src, ()

-test-one-way void(from language, source string, to language, expected string, expected-diagnostics pos[])
	result = (source, from, to) syntax-translate
	result.diagnostics is expected-diagnostics
	result.output is expected
