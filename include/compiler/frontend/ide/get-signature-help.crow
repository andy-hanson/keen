use-prefix
import
	../../frontend/show-model
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/model
	./doc-comment
	./position

get-signature-help-for-position signature-help?(show-ctx show-type-ctx, position position)
	if e = position.kind.expression-position
		signature-help-at-expression-position show-ctx, e

-signature-help-at-expression-position signature-help?(show-ctx show-type-ctx, a expression-position)
	if x = a.kind.bogus-call-expr
		signature-help-at-bogus-call show-ctx, a.container.to, x

-signature-help-at-bogus-call signature-help
	show-ctx show-type-ctx
	outer-type-container type-container
	a bogus-call-expr
do
	active-parameter = active-parameter a.ast
	signatures: for x in a.candidates
		signature-information show-ctx, outer-type-container, x, active-parameter
	activeSignature: ()
	activeParameter: active-parameter

-active-parameter nat?(a call-expr-source)
	match a
	as call-ast
		a.args.size
	else
		()

-signature-information signature-information
	show-ctx show-type-ctx
	outer-type-container type-container
	a called-decl
	active-parameter nat?
do
	type-container type-container = match a
	as fun-decl
		a
	as called-spec-sig
		outer-type-container
	shown = show-called-decl-parts show-ctx, type-container, a
	out char8 mut[] = ()
	out ~~= shown.name-and-return-type.to::char8[]
	out ~= "("
	first mut bool = true
	parameter-info parameter-information[] = for param in shown.params
		if first
			first := false
		else
			out ~~= ", "
		begin = out.size
		out ~~= param.to::char8[]
		end = out.size
		begin .. end, ""
	out ~= ")"
	unless is-empty shown.rest
		out ~= " "
		out ~~= shown.rest.to::char8[]

	label: out.move-to
	documentation: doc-comment-string show-ctx.file-content-getters, a.module-uri, a.doc-comment
	parameters: parameter-info
	activeParameter: active-parameter
