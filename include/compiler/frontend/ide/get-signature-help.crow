import
	../../frontend/show-model
	../../lib/lsp/lsp-types
	../../document/document
	../../model/ast
	../../model/model
	./position

get-signature-help-for-position signature-help?(show-ctx show-type-ctx, position position)
	if e ?= position.kind expression-position
		show-ctx signature-help-at-expression-position e

-signature-help-at-expression-position signature-help?(show-ctx show-type-ctx, a expression-position)
	if x ?= a.kind bogus-call-expr
		show-ctx signature-help-at-bogus-call a.container.to, x

-signature-help-at-bogus-call signature-help
	show-ctx show-type-ctx
	outer-type-container type-container
	a bogus-call-expr
do
	active-parameter = a.ast active-parameter
	signatures: for x : a candidates
		show-ctx signature-information outer-type-container, x, active-parameter
	activeSignature: ()
	activeParameter: active-parameter

-active-parameter nat?(a call-expr-source)
	match a
	as call-ast x
		x.args size
	else
		()

-signature-information signature-information
	show-ctx show-type-ctx
	outer-type-container type-container
	a called-decl
	active-parameter nat?
do
	type-container type-container = match a
	as fun-decl x
		x to
	as called-spec-sig _
		outer-type-container
	shown = show-ctx show-called-decl-parts type-container, a
	out char8 mut[] = ()
	out ~~= shown.name-and-return-type to
	out ~= "("
	first mut = true
	parameter-info parameter-information[] = for param : shown params
		if first
			first := false
		else
			out ~~= ", "
		begin = out size
		out ~~= param to
		end = out size
		begin .. end, ""
	out ~= ")"
	unless shown.rest is-empty
		out ~= " "
		out ~~= shown.rest to

	label: out move-to
	documentation: show-ctx.file-content-getters doc-comment-string a.module-uri, a.doc-comment
	parameters: parameter-info
	activeParameter: active-parameter
