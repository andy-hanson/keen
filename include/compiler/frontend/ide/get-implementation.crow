import
	../../model/model
	../../model/source-range
	../../model/uri
	./get-definition
	./get-target
	./position

get-implementation-for-position uri-and-line-and-character-range[](program program, pos position)
	guard target = target-for-position pos
	for x in implementation-for-target program, pos.module.uri, target
		program.line-and-character-getters[x]

-implementation-for-target uri-and-range[](program program, uri uri, target target)
	if signature target and struct = struct-decl target.container
		implementation-for-method program, struct, target
	else
		with out in build
			definition-for-target uri, target, of x
				out ~= x

-implementation-for-method uri-and-range[](program program, sum-type struct-decl, method signature)
	for* _, module in program.all-modules
		for* struct in module.structs
			for* x in struct.sum-type-memberships
				guard x.sum-type.decl == sum-type
				guard inst = x.method-impls[method.index-of-signature].?fun-inst
				- inst.decl.name-range
