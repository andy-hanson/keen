import
	../../model/model
	../../model/source-range
	../../model/uri
	./get-definition
	./get-target
	./position

get-implementation-for-position uri-and-line-and-character-range[](program program, pos position)
	guard target ?= pos target-for-position
	for x : program implementation-for-target pos.module.uri, target
		program.line-and-character-getters[x]

-implementation-for-target uri-and-range[](program program, uri uri, target target)
	for-method uri-and-range[]? = if sig ?= target signature and struct ?= sig.container struct-decl
		program implementation-for-method struct, sig
	for-method else with out : build
		uri definition-for-target target, x =>
			out ~= x

-implementation-for-method uri-and-range[](program program, sum-type struct-decl, method signature)
	sig-index = method index-of-signature
	for* _, module : program all-modules
		for* struct : module structs
			for* x : struct sum-type-memberships
				guard x.sum-type.decl == sum-type
				guard called ?= x.method-impls[sig-index]
				guard inst ?= called fun-inst
				- inst.decl.name-range
