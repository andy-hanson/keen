import
	../../lib/lsp/lsp-types
	../../model/model
	../../model/source-range
	../../model/uri
	./get-definition
	./get-position
	./get-target
	./position

get-implementation uri-and-line-and-character-range[](program program, params implementation-params)
	if position = get-position program, params.params, exact
		get-implementation-for-position program, position

get-implementation-for-position uri-and-line-and-character-range[](program program, pos position)
	do if target = target-for-position pos
	for x in implementation-for-target program, pos.module.uri, target
		program.line-and-character-getters[x]

-implementation-for-target uri-and-range[](program program, uri uri, target target)
	if signature target and struct = struct-decl target.container
		implementation-for-method program, struct, target
	else
		with out in build
			definition-for-target uri, target, of x
				out ~= x

-implementation-for-method uri-and-range[](program program, sum-type struct-decl, method signature)
	do for* _, module in program.crow-modules
	do for* struct in module.structs
	do for* x in struct.sum-type-memberships
	do if x.sum-type.decl == sum-type
	do if inst = x.method-impls[method.index-of-signature].?fun-inst
	- inst.decl.name-range
