import
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/util

walk-ast-in-order void(ast file-ast, f void mut(x any-ast))
	if x ?= ast imports
		f[x to]
	if x ?= ast re-exports
		f[x to]
	all any-ast[] = with out : build
		for x : ast specs
			out ~= x to
		for x : ast struct-aliases
			out ~= x to
		for x : ast structs
			out ~= x to
		for x : ast funs
			out ~= x to
		for x : ast tests
			out ~= x to
		for x : ast vars
			out ~= x to
	for x : all sort x => x range
		f[x]
any-ast union(
	imports-or-exports-ast,
	spec-decl-ast,
	struct-alias-ast,
	struct-decl-ast,
	fun-decl-ast,
	test-ast,
	var-decl-ast)
	range source-range()
