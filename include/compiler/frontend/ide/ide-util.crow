import
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/util

walk-ast-in-order void(ast file-ast, f void mut(x any-ast))
	if x ?= ast imports
		f[x to]
	if x ?= ast re-exports
		f[x to]
	all any-ast[] = with out : build
		for x : ast specs
			out ~= x to
		for x : ast struct-aliases
			out ~= x to
		for x : ast structs
			out ~= x to
		for x : ast funs
			out ~= x to
		for x : ast tests
			out ~= x to
		for x : ast vars
			out ~= x to
	for x : all sort x => x range
		f[x]
any-ast union(
	imports-or-exports-ast,
	spec-decl-ast,
	struct-alias-ast,
	struct-decl-ast,
	fun-decl-ast,
	test-ast,
	var-decl-ast)
	range source-range()

reference-cb alias
	void mut(where uri-and-range)
spec-cb alias
	void mut(x spec-inst, ast spec-use-ast)

each-spec-parent void(a spec-decl, f spec-cb)
	res bool? = a.parents each-spec a.ast.modifiers, (x, ast) =>
		f[x, ast]
		()
	res is ()

each-fun-spec void(a fun-decl, f spec-cb)
	if source ?= a.source fun-source-ast
		res bool? = a.specs each-spec source.ast.modifiers, (x, ast) =>
			f[x, ast]
			()
		res is ()

specs-match bool(specs spec-inst[], modifiers modifier-ast[])
	specs.size == (modifiers count x => x.spec-use-ast !is-empty)

# TODO: better to define an 'iterate' function -----------------------------------------------------------------------------
each-spec[out] out?(
	specs spec-inst[],
	modifiers modifier-ast[],
	f out? mut(x spec-inst, ast spec-use-ast),
)
	if specs specs-match modifiers
		spec-i mut nat = 0
		res out? = for mod : modifiers
			if use ?= mod spec-use-ast
				res = f[specs[spec-i], use]
				spec-i +:= 1
				if x ?= res
					break x
				else
					continue
			else
				continue
		spec-i is specs.size
		res

type-cb alias
	void mut(x type, ast type-ast)

each-type-component[out] out?(type type, ast type-ast, f out? mut(x type, ast type-ast))
	match type
	as bogus-type _
		()
	as type-param-index _
		()
	as struct-inst x
		x.type-args find-in-type-args ast, f

each-packed-type-arg void(type-args type-args, ast type-ast, f type-cb)
	type-args each-packed-type-arg (ast,), f
each-packed-type-arg void(type-args type-args, ast type-ast?, f type-cb)
	res bool? = type-args find-in-packed-type-args ast, (arg-type, arg-ast) =>
		f[arg-type, arg-ast]
		()
	res is ()

find-in-packed-type-args[out] out?(
	type-args type-args,
	ast type-ast?,
	f out? mut(x type, ast type-ast),
)
	if x ?= ast
		type-args zip-each-type-arg-may-unpack-tuple x, f
	else
		assert type-args is-empty
		()

-find-in-type-args[out] out?(type-args type-args, ast type-ast, f out? mut(x type, ast type-ast))
	match ast
	as bogus-type-ast _
		()
	as fun-type-ast x
		return-type, param-type = type-args only2
		f[return-type, x.return-type] || (param-type each-fun-type-parameter x.params, f)
	as map-type-ast x
		type-args zip-each-type-arg (x.key, x.value), f
	as name-and-range _
		# For a type alias, 'typeArgs' may be non-empty as it comes from the alias' target type.
		# But ignore them in any case.
		()
	as suffix-name-type-ast x
		type-args zip-each-type-arg-may-unpack-tuple x.left, f
	as suffix-special-type-ast x
		type-args zip-each-type-arg-may-unpack-tuple x.left, f
	as tuple-type-ast x
		type-args zip-each-type-arg x.members, f

-zip-each-type-arg-may-unpack-tuple[out] out?(
	type-args type-args,
	type-arg-ast type-ast,
	f out? mut(x type, ast type-ast),
)
	type-arg-asts type-ast[] = if type-args.size == 1
		type-arg-ast,
	else
		type-arg-ast.tuple-type-ast! members
	type-args zip-each-type-arg type-arg-asts, f

-zip-each-type-arg[out] out?(
	type-args type-args,
	type-arg-asts type-ast[],
	f out? mut(x type, ast type-ast),
) # TODO: this is a one-liner now, so just inline? -------------------------------------------------------------------------------
	type-args.inner zip type-arg-asts first f

-each-fun-type-parameter[out] out?( # TODO: rename to each-type-in-fun-parameters ---------------------------------------------------
	params-type type,
	params-ast params-ast,
	f out? mut(x type, ast type-ast),
)
	match params-ast
	as array params
		if params.size == 1
			params-type each-type-in-destructure params.only, f
		else
			params-type each-type-in-destructure-parts params, f
	as varargs-ast _
		() # TODO

-each-type-in-destructure-parts[out] out?(
	type type,
	parts destructure-ast[],
	f out? mut(x type, ast type-ast),
)
	unless type is-bogus
		for type-arg, param : type.struct-inst!.type-args.inner zip parts
			if res ?= type-arg each-type-in-destructure param, f
				break res

-each-type-in-destructure[out] out?(
	type type,
	ast destructure-ast,
	f out? mut(x type, ast type-ast),
)
	match ast
	as single-destructure-ast x
		if t ?= x type
			f[type, t]
	as void-destructure-ast _
		()
	as array parts
		type each-type-in-destructure-parts parts, f
