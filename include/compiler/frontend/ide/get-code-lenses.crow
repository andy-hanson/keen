import
	../../lib/lsp/lsp-types
	../../model/model
	../../model/source-range
	../../model/uri
	../walk-model

| This returns a single code lens, listing all users of this module
get-code-lenses code-lens-result(program program, params code-lens-params)
	module = program module-at-uri params.textDocument
	users uri set = with out : build
		program walk-program (where, thing) =>
			guard uri ?= thing uri
			guard uri == module.uri
			out ~= where.uri
	guard users !is-empty
	# TODO: also collect all re-exporters
	max-uris nat = 4
	message = "Used by " uris-or-count users, max-uris
	lens code-lens = (top-of-file, (message,))
	(lens,),

-uris-or-count string(description string, uris uri set, max nat)
	if uris.size > max
		"{description}{uris size} other modules"
	else
		"{description}{", " join for x : uris; "{x base-name}"}"
