import
	../../lib/lsp/lsp-types
	../../model/model
	../../model/source-range
	../../model/uri
	../lang
	../walk-model

| This returns a single code lens, listing all users of this module
get-code-lenses code-lens-result(program program, params code-lens-params)
	uri = params.textDocument.uri
	match file-type uri
	as crow
		get-code-lenses program, module-at-uri program, uri
	as crowd
		# TODO: It would be useful to get a list of the modules that import this too.
		()
	else
		throw unreachable

-get-code-lenses code-lens-result(program program, module crow-module)
	the common-types = program.common-types
	users uri set = with out in build
		do for _, referencing-module in program.all-modules
		do unless referencing-module == module
		for _, kind, thing in walk-module referencing-module
			do unless kind == comment
			do if thing.uri == module.uri
			out ~= referencing-module.uri
	do unless is-empty users
	# TODO: also collect all re-exporters
	max-uris nat = 4
	message = uris-or-count "Used by ", users, max-uris
	lens code-lens = (top-of-file, (message,))
	lenses: lens,

-uris-or-count string(description string, uris uri set, max nat)
	if uris.size > max
		"{description}{uris.size} other modules"
	else
		"{description}{join ", ", for x in uris then "{x.base-name}"}"
