import
	../../lib/lsp/lsp-types
	../../model/model
	../../model/source-range
	../../model/uri
	./import-references

get-code-lenses code-lens-result(program program, params code-lens-params)
	module = program module-at-uri params.textDocument
	lenses code-lens[] = with out : build
		x = program imports-and-re-exports-of-module module
		guard x !is-empty
		max-uris nat = 4
		show-re-exported = "Module re-exported by " uris-or-count x.re-exports, max-uris
		show-imported = "Module used by " uris-or-count x.imports, max-uris
		message string = "; " join (show-re-exported.to ~~ show-imported.to)
		out ~= (top-of-file, (message,))
	lenses,

-uris-or-count string?(description string, uris uri[], max nat)
	guard uris !is-empty
	if uris.size > max
		"{description}{uris size} other modules",
	else
		(", " join for x : uris; "{x base-name}"),
