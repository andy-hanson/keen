import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	./ide-util

imports-and-re-exports record(imports uri[], re-exports uri[])
is-empty bool(a imports-and-re-exports)
	a.imports is-empty && a.re-exports is-empty
imports-and-re-exports-of-module imports-and-re-exports(program program, module module)
	with out : build
		program each-module-referencing module, (x, kind, _) =>
			out ~= (x.uri, kind)

imports-and-re-exports-of imports-and-re-exports(program program, decl any-decl)
	with out : build
		if decl.visibility != private
			program each-import (decl.module-uri, decl.name), (uri, kind) =>
				out ~= (uri, kind)


each-named-import void(
	program program,
	exporting-module module,
	name symbol,
	f void mut(where uri-and-range, kind is-import-or-export),
)
	program each-module-referencing exporting-module, (importing-module, kind, import_) =>
		unless import_ is-std
			source = import_ source!
			if names ?= source.kind array
				for x : names
					if x.name == name
						f[(importing-module.uri, x.range), kind]

uri-and-name record(module-uri uri, name symbol)

references-for-module void(program program, target module, f reference-cb)
	program each-module-referencing target, (importer, _, import_) =>
		unless import_ is-std
			f[importer.uri, import_.source!.path-range]

each-module-referencing void(
	program program,
	exporting-module module,
	f void mut(module module, kind is-import-or-export, impot_ import-or-export),
)
	exporters = program exporters-set exporting-module
	for _, importing-module : program all-modules
		importing-module each-import-or-re-export-with-kind (kind, x) =>
			if x.module.uri in exporters
				f[importing-module, kind, x]

-imports-and-re-exports-builder record mut
	imports uri array-builder
	exports uri array-builder
-build imports-and-re-exports(_ build-options, f void mut(out imports-and-re-exports-builder))
	exports mut uri[] = ()
	imports uri[] = with out-imports : build
		exports := with out-exports : build
			f[out-imports, out-exports]
	imports, exports
~= void(a imports-and-re-exports-builder, (uri uri, kind is-import-or-export))
	out = match kind
	as import_
		a imports
	as export_
		a exports
	out ~= uri

# Unlike 'eachNamedImport', this works for un-named imports; so it does not pass a location to the callback.
-each-import void(
	program program,
	imported uri-and-name,
	f void mut(importer uri, kind is-import-or-export),
)
	program each-module-referencing (program module-at-uri imported.module-uri), (importing-module, kind, import_) =>
		if imported.name in (import_.imported ?? ())
			f[importing-module.uri, kind]

-exporters-set uri set(program program, exporting-module module)
	res uri mut-set = ()
	res ~= exporting-module uri
	did-add mut = true
	while did-add
		did-add := false
		for _, module : program all-modules
			for ex : module re-exports
				if ex.module.uri in res
					if res try-add module.uri
						did-add := true
	res move-to
