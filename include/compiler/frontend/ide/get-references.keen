import
	../../model/ast
	../../model/lsp
	../../model/model
	../../model/source-range
	../../model/uri
	../walk-model
	./get-definition
	./get-position
	./get-target
	./position

get-references uri-and-line-and-character-range[](program program, params reference-params)
	if position = get-position program, params.params, exact-or-end
		get-references program, position, all-references

get-document-highlights document-highlight-result?(program program, params document-highlight-params)
	do if position = get-position program, params.params, exact-or-end
	uri = position.module.uri
	highlights document-highlight[] = for* x in get-references program, position, document-highlights
		if x.uri == uri
			- x.range, Read
	highlights: sort highlights, it.range.start

references-kind enum(all-references, rename, document-highlights)
== bool(a references-kind, b references-kind)
get-references uri-and-line-and-character-range[](program program, pos position, kind references-kind)
	the common-types = program.common-types
	do if target = target-for-position pos
	lcgs = program.line-and-character-getters
	sort with out in build
		definition-for-target target, of where
			out ~= lcgs[where]
		match target
		as position-imported-name
			# TODO: Walk everything in this module.
			# If it matches the name and comes from this module, count it as a reference.
			throw todo
		as position-local
			for ref in references-for-local target
				out ~= lcgs[pos.module.uri, ref]
		as keen-module
			for ref in references-for-module program, target
				out ~= lcgs[ref]
		as type-param-with-container
			walk-any-decl target.container, of where, _, what
				do if what.type-param-index == target.type-param
				out ~= lcgs[pos.module.uri, where.reference-range]
		else
			walk-program program, of uri, where, _, thing
				do if references thing, target, kind, where
				out ~= lcgs[uri, where.reference-range]


-references-for-module uri-and-range[](program program, module keen-module)
	do with out in build
	do for _, importer in keen-modules program
	do for ast, imported in walk-explicit-imports-and-re-exports importer
	do if imported.keen-module == module
	out ~= importer.uri, ast.range

-references bool(ref doc-comment-reference, target target, kind references-kind, where reference-ast)
	match target
	as enum-or-flags-member
		match ref
		as fun-decl
			ref.body.create-enum-or-flags.?member == target
		as enum-or-flags-member
			ref == target
		else
			()
	as fun-decl
		ref.fun-decl == target
	as position-imported-name
		throw unreachable
	as position-local
		throw unreachable
	as keen-module
		throw unreachable
	as record-field
		match ref
		as fun-decl
			match body = ref.body
			as record-field-get
				body.field == target
			as record-field-set
				body.field == target
			else
				()
		as record-field
			ref == target
		else
			()
	as signature
		ref.called-spec-sig.?non-instantiated-sig == target
	as spec-decl
		ref.spec-decl == target
	as type-alias
		ref.type-decl == target.target.decl and where.type-ast and where.name-and-range and where.name == target.name
	as type-decl
		match ref
		as type-decl
			ref == target
		as doc-comment-reference-context
			if kind == document-highlights
				ref.type.decl == target
		else
			()
	as type-param-with-container
		throw unreachable
	as var-decl
		match ref
		as fun-decl
			match body = ref.body
			as var-get
				body.var == target
			as var-set
				body.var == target
			else
				()
		as var-decl
			ref == target
		else
			()

-references-for-local source-range[](a position-local)
	do if container, body = a.container.container-and-body
	do with out in build
	walk-doc-comment container.doc-comment, of where, _, ref
		do if ref.local
		do if ref.local-must-have-name-range == a.local.local-must-have-name-range
		out ~= reference-range where
	# Deduplicate the 'local-get' and 'local-set' in `x +:= 1`
	seen pos mut-set = ()
	for x in all-exprs-in-tree body
		do if ref = x.expr-local-reference
		do if ref.local == a.local and try-add seen, x.start
		out ~= ref.name-range
-container-and-body (expr-container, expr)?(a local-container)
	match a
	as fun-decl
		if expr = a.body.as-expr
			a, expr
	as test_
		a, a.body.expr
	as spec-decl
		()
	as type-decl
		()
	as var-decl
		a, a.initializer.expr

-local-reference record(local local, name-range source-range)
-expr-local-reference local-reference?(a expr)
	match a
	as local-get-expr
		a.local, a.range
	as local-get-and-refine-expr
		a.local, a.range
	as local-set-expr
		a.local, a.assignee-ast.range
	else
		()
