import
	../../model/model
	../../util/util
	./position

target union mut
	enum-or-flags-member
	fun-decl
	position-imported-name
	position-local
	loop-target
	crow-module
	record-field
	spec-decl
	signature
	struct-alias
	struct-decl
	type-param-with-container
	var-decl
loop-target record(container expr-container, loop_ loop-expr) # TODO: container used? ---------------------------------------

target-for-position target?(pos position)
	match x = pos kind
	as position-catch
		()
	as position-doc-ref
		match ref = x ref
		as doc-comment-reference-bogus
			()
		as called-spec-sig
			ref non-instantiated-sig
		as enum-or-flags-member
			ref
		as fun-decl
			ref
		as local
			x.container.assert-local-container position-local ref
		as record-field
			ref
		as signature
			ref
		as struct-alias
			ref
		as struct-decl
			ref
		as spec-decl
			ref
		as type-param-index
			ref type-param-with-container x.container.type-container-for.forbid-module
		as var-decl
			ref
	as enum-or-flags-member
		x
	as expression-position
		x expr-target
	as fun-decl
		x
	as position-imported-module
		x module
	as position-imported-name
		x
	as position-keyword
		()
	as position-local
		x
	as position-match-enum-case
		x member
	as position-match-scalar-case
		()
	as position-match-string-like-case
		()
	as position-match-sum-type-case
		x.member decl
	as position-modifier
		()
	as position-modifier-extern
		()
	as position-module
		pos module
	as record-field
		x
	as position-record-field-mutability
		()
	as spec-decl
		x
	as signature
		x
	as position-spec-use
		x.spec_ decl
	as struct-alias
		x
	as struct-decl
		x
	as test_
		()
	as type-with-container
		match type = x type
		as bogus-type
			()
		as type-param-index
			type type-param-with-container x.container.forbid-module
		as struct-inst
			type decl
	as type-param-with-container
		x
	as var-decl
		x
	as position-visibility-mark
		()

-expr-target target?(a expression-position)
	match x = a kind
	as assert-or-forbid-expr
		()
	as bogus-call-expr
		x.candidates.opt-only.?called-decl-target
	as call-expr
		x.called called-target
	as call-named-new-expr
		x.called called-target
	as call-option-expr
		x.called called-target
	as expr-keyword
		()
	as if-expr
		()
	as expression-position-literal
		()
	as lambda-expr
		()
	as list-expr
		x.called called-target
	as local-ref
		a.container.to position-local x.local
	as logical-expr
		()
	as loop-expr
		a.container loop-target x
	as loop-break-expr
		a.container loop-target x.loop_
	as loop-continue-expr
		a.container loop-target x.loop_
	as loop-while-or-until-expr
		()
	as match-enum-expr
		()
	as match-scalar-expr
		()
	as match-string-like-expr
		()
	as match-sum-type-expr
		()
	as not-expr
		()
	as try-expr
		()
	as try-let-expr
		()

-called-decl-target target(a called-decl)
	match a
	as fun-decl
		a fun-decl-target
	as called-spec-sig
		a non-instantiated-sig

-called-target target?(a called)
	match a
	as called-bogus
		()
	as fun-inst
		a.decl fun-decl-target
	as called-spec-sig
		a non-instantiated-sig

-fun-decl-target target(a fun-decl)
	match body = a body
	as fun-body-bogus
		a
	as fun-body-extern-java
		a
	as auto-fun
		a
	as builtin-fun
		a
	as create-enum-or-flags
		body member
	as create-record
		a return-type-target
	as expr
		a
	as fun-body-file-import
		a
	as flags-function
		a return-type-target
	as fun-body-method
		body method
	as record-field-get
		body field
	as record-field-set
		body field
	as sum-type-member-get
		a.return-type.unwrap-option!.struct-inst! decl
	as var-get
		body var
	as var-set
		body var
	as fun-body-uninitialized
		throw unreachable
-return-type-target target(a fun-decl)
	a.return-type.struct-inst! decl

