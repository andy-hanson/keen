import
	../../model/model
	../../util/util
	./position

target union(
	enum-or-flags-member,
	fun-decl,
	position-imported-name,
	position-local,
	loop-target,
	module,
	record-field,
	spec-decl,
	signature,
	struct-alias,
	struct-decl,
	type-param-with-container,
	var-decl
) mut
loop-target record(container expr-container, loop_ loop-expr) # TODO: container used? ---------------------------------------

target-for-position target?(pos position)
	match pos kind
	as position-doc-ref doc-ref
		match doc-ref ref
		as doc-comment-reference-bogus
			()
		as called-spec-sig x
			x.non-instantiated-sig to,
		as enum-or-flags-member x
			x to,
		as fun-decl x
			x to,
		as local x
			(doc-ref.container.assert-local-container position-local x),
		as record-field x
			x to,
		as signature x
			x to,
		as struct-alias x
			x to,
		as struct-decl x
			x to,
		as spec-decl x
			x to,
		as type-param-index x
			(x type-param-with-container doc-ref.container.type-container-for.forbid-module),
		as var-decl x
			x to,
	as enum-or-flags-member x
		x to,
	as expression-position x
		x expr-target
	as fun-decl x
		x to,
	as position-imported-module x
		x.module to,
	as position-imported-name x
		x to,
	as position-keyword _
		()
	as position-local x
		x to,
	as position-match-enum-case x
		x.member to,
	as position-match-integral-case _
		()
	as position-match-string-like-case _
		()
	as position-match-sum-type-case x
		x.member.decl to,
	as position-modifier _
		()
	as position-modifier-extern _
		()
	as position-module _
		pos.module to,
	as record-field x
		x to,
	as position-record-field-mutability _
		()
	as spec-decl x
		x to,
	as signature x
		x to,
	as position-spec-use x
		x.spec_.decl to,
	as struct-alias x
		x to,
	as struct-decl x
		x to,
	as test_ _
		()
	as type-with-container tc
		match tc type
		as bogus-type
			()
		as type-param-index x
			(x type-param-with-container tc.container.forbid-module),
		as struct-inst x
			x.decl to,
	as type-param-with-container x
		x to,
	as var-decl x
		x to,
	as position-visibility-mark _
		()

-expr-target target?(a expression-position)
	match a kind
	as assert-or-forbid-expr _
		()
	as bogus-call-expr x
		if c ?= x.candidates opt-only
			c.called-decl-target,
	as call-expr x
		x.called called-target
	as call-option-expr x
		x.called called-target
	as expr-keyword _
		()
	as extern-expr _
		()
	as fun-pointer-expr x
		x.called called-target
	as if-expr _
		()
	as expression-position-literal
		()
	as lambda-expr _
		()
	as local-ref x
		(a.container.to position-local x.local),
	as loop-expr _
		()
	as loop-break-expr x
		(a.container loop-target x.loop_),
	as loop-continue-expr x
		(a.container loop-target x.loop_),
	as loop-while-or-until-expr _
		()
	as match-enum-expr _
		()
	as match-integral-expr _
		()
	as match-string-like-expr _
		()
	as match-sum-type-expr _
		()
	as try-expr _
		()
	as try-let-expr _
		()

-called-decl-target target(a called-decl)
	match a
	as fun-decl x
		x fun-decl-target
	as called-spec-sig x
		x.non-instantiated-sig to

-called-target target?(a called)
	match a
	as called-bogus _
		()
	as fun-inst x
		x.decl fun-decl-target,
	as called-spec-sig x
		x.non-instantiated-sig to,

-fun-decl-target target(a fun-decl)
	match a body
	as fun-body-bogus _
		a to
	as auto-fun _
		a to
	as builtin-fun _
		a to
	as create-enum-or-flags x
		x.member to
	as create-extern _
		a return-type-target
	as create-record _
		a return-type-target
	as create-record-and-convert-to-sum-type x
		x.member.decl to
	as create-sum-type _
		a.params.array!.only.type.struct-inst!.decl to # TODO: this should be a helper function in model.crow ..............
	as expr _
		a to
	as fun-body-extern _
		a to
	as fun-body-file-import _
		a to
	as flags-function _
		a return-type-target
	as fun-body-method x
		x.method to
	as record-field-call x
		x.field to
	as record-field-get x
		x.field to
	as record-field-pointer x
		x.field to
	as record-field-set x
		x.field to
	as sum-type-member-get _
		a.return-type.must-unwrap-option-type.struct-inst!.decl to
	as var-get x
		x.var to
	as var-set x
		x.var to
	as fun-body-uninitialized
		throw unreachable
-return-type-target target(a fun-decl)
	a.return-type.struct-inst!.decl to

