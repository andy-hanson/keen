use-prefix
import
	../../model/model
	../../util/util
	./position

target union mut
	enum-or-flags-member
	fun-decl
	position-imported-name
	position-local
	loop-target
	crow-module
	record-field
	spec-decl
	signature
	struct-alias
	struct-decl
	type-param-with-container
	var-decl
loop-target record(container expr-container, loop_ loop-expr) # TODO: container used? ---------------------------------------

target-for-position target?(pos position)
	match x = pos.kind
	as position-catch
		()
	as position-doc-ref
		match ref = x.ref
		as doc-comment-reference-bogus
			()
		as called-spec-sig
			non-instantiated-sig ref
		as enum-or-flags-member
			ref
		as fun-decl
			ref
		as local
			position-local x.container.assert-local-container, ref
		as record-field
			ref
		as signature
			ref
		as struct-alias
			ref
		as struct-decl
			ref
		as spec-decl
			ref
		as type-param-index
			type-param-with-container ref, x.container.type-container-for.forbid-module
		as var-decl
			ref
	as enum-or-flags-member
		x
	as expression-position
		x.expr-target
	as fun-decl
		x
	as position-imported-module
		x.module
	as position-imported-name
		x
	as position-keyword
		()
	as position-local
		x
	as position-match-enum-case
		x.member
	as position-match-scalar-case
		()
	as position-match-string-like-case
		()
	as position-match-sum-type-case
		x.member.decl
	as position-modifier
		()
	as position-modifier-extern
		()
	as position-module
		pos.module
	as record-field
		x
	as position-record-field-mutability
		()
	as spec-decl
		x
	as signature
		x
	as position-spec-use
		x.spec_.decl
	as struct-alias
		x
	as struct-decl
		x
	as test_
		()
	as type-with-container
		match type = x.type
		as bogus-type
			()
		as type-param-index
			type-param-with-container type, x.container.forbid-module
		as struct-inst
			type.decl
	as type-param-with-container
		x
	as var-decl
		x
	as position-visibility-mark
		()

-expr-target target?(a expression-position)
	match x = a.kind
	as assert-or-forbid-expr
		()
	as bogus-call-expr
		x.candidates.opt-only.?called-decl-target
	as call-expr
		called-target x.called
	as call-named-new-expr
		called-target x.called
	as call-option-expr
		called-target x.called
	as expr-keyword
		()
	as if-expr
		()
	as expression-position-literal
		()
	as lambda-expr
		()
	as list-expr
		called-target x.called
	as local-ref
		position-local a.container.to, x.local
	as logical-expr
		()
	as loop-expr
		loop-target a.container, x
	as loop-break-expr
		loop-target a.container, x.loop_
	as loop-continue-expr
		loop-target a.container, x.loop_
	as loop-while-or-until-expr
		()
	as match-enum-expr
		()
	as match-scalar-expr
		()
	as match-string-like-expr
		()
	as match-sum-type-expr
		()
	as not-expr
		()
	as try-expr
		()
	as try-let-expr
		()

-called-decl-target target(a called-decl)
	match a
	as fun-decl
		fun-decl-target a
	as called-spec-sig
		a.non-instantiated-sig

-called-target target?(a called)
	match a
	as called-bogus
		()
	as fun-inst
		fun-decl-target a.decl
	as called-spec-sig
		a.non-instantiated-sig

-fun-decl-target target(a fun-decl)
	match body = a.body
	as fun-body-bogus
		a
	as fun-body-extern-java
		a
	as auto-fun
		a
	as builtin-fun
		a
	as create-enum-or-flags
		body.member
	as create-record
		return-type-target a
	as expr
		a
	as expr-with-allocated-locals
		a
	as fun-body-file-import
		a
	as flags-function
		return-type-target a
	as fun-body-method
		body.method
	as record-field-get
		body.field
	as record-field-set
		body.field
	as sum-type-member-get
		a.return-type.unwrap-option!.struct-inst!.decl
	as var-get
		body.var
	as var-set
		body.var
	as fun-body-uninitialized
		throw unreachable
-return-type-target target(a fun-decl)
	a.return-type.struct-inst!.decl
