import
	../../frontend/check/inferring-type
	../../frontend/show-model
	../../model/lsp
	../../model/model
	../../model/source-range
	./get-position
	./position

get-completion completion-list?(program program, params completion-params) show-ctx
	do if position = get-position program, params.params, after
	the common-types = program.common-types
	match x = position.kind
	as expression-position
		completion-at-expression-position position.module, x
	else
		()

-completion-at-expression-position completion-list?
	module crow-module
	a expression-position
do show-type-ctx
	match x = kind a
	as local-ref
		completion-after-type module, a.container, x.local.type
	else
		()

-completion-after-type completion-list?
	module crow-module
	container expr-container
	type type
do show-type-ctx
	items completion-item[] = with out in build
		each-fun-in-expr-scope module, container, of fun
			do if t = first-param-type fun
			# Don't include a function that accepts any type, since this results in too many functions matching
			do if struct-inst t and is-type-match-possible-for-completions (t, fun.type-container-for), type
			out ~= completion-for-called-decl container.to, fun
	unless is-empty items
		items,

-type-container-for type-container(a called-decl)
	match a
	as fun-decl
		a
	as called-spec-sig
		throw todo

-completion-for-called-decl completion-item(type-container type-container, a called-decl) show-type-ctx
	the file-content-getters = file-content-getters
	label: a.name.to
	detail: show-called-decl unquoted, type-container, a
	documentation: doc-comment-string a.module-uri, a.doc-comment

-first-param-type type?(a called-decl)
	param-types = match a
	as fun-decl
		a.param-types
	as called-spec-sig
		a.instantiated-sig.param-types
	unless is-empty param-types
		param-types[0]

-each-fun-in-expr-scope void(module crow-module, _ expr-container, f void mut(x called-decl))
	# TODO: specs, imports
	for x in module.funs
		f[x]
