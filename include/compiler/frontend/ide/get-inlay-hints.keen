import
	../../frontend/lang
	../../frontend/show-model
	../../model/ast
	../../model/lsp
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/exit-code
	../walk-model

get-inlay-hints inlay-hint-result
	program program
	test-states test-states
	params inlay-hint-params
do show-ctx
	the common-types = program.common-types
	uri = params.textDocument.uri
	do if uri.file-type == keen
	module = module-at-uri program, uri

	fun-refs uri mut-set[fun-decl] = for x in module.funs then x, ()
	struct-refs uri mut-set[struct-decl] = for x in module.structs then x, ()
	spec-refs uri mut-set[spec-decl] = for x in module.specs then x, ()
	# TODO: record field refs, enum member refs, spec sigs
	for _, referencing-module in program.keen-modules
		do unless referencing-module == module
		for _, kind, x in walk-module referencing-module
			do if kind != comment
			match x
			as fun-decl
				if set = fun-refs[x]
					set ~= referencing-module.uri
			as struct-decl
				if set = struct-refs[x]
					set ~= referencing-module.uri
			as spec-decl
				if set = spec-refs[x]
					set ~= referencing-module.uri
			else
				()

	lcg = program.line-and-character-getters[uri]
	res inlay-hint[] = with out in build
		inlay-hints-for-imports out, program, module
		for x in module.funs
			add-inlay-hints-for-ref out, lcg, x, fun-refs[x]!.move-to
			get-inlay-hints-for-fun out, x
		for x in module.structs
			add-inlay-hints-for-ref out, lcg, x, struct-refs[x]!.move-to
		for x in module.specs
			add-inlay-hints-for-ref out, lcg, x, spec-refs[x]!.move-to
		for x in module.tests
			get-inlay-hints-for-test out, lcg, test-states, x
	- sort res, it.position

# For this, just track the location of the first thing
-inlay-hints-for-imports void(out inlay-hint builder, program program, module keen-module)
	the common-types = program.common-types
	# Maps a module URI to a map from imported names to the first import location
	imports uri-and-range mut[symbol] mut[uri] = ()
	for _, kind, what in walk-module module
		do unless kind == comment
		do if uri = what.uri
		do if name = what.name
		do unless uri == module.uri
		x = ensure imports, uri
		loc = what.name-range
		if existing = x[name]
			if loc < existing
				x[name] := loc
		else
			x[name] := loc
	for ast, imported in walk-explicit-imports module
		match ast.kind
		as import-whole-module-ast
			do if imported.keen-module
			sorted (symbol, uri-and-range)[] = sort (imports[imported.uri] else ()).to, it.a
			do if x = inlay-hint-for-import program.line-and-character-getters, module.uri, ast, sorted
			out ~= x
		as array
			()
		as import-file-ast
			throw unreachable
-name-range uri-and-range(a doc-comment-reference)
	match a
	as doc-comment-reference-bogus
		throw unreachable
	as doc-comment-reference-context
		a.type.decl.name-range
	as called-spec-sig
		a.name-range
	as enum-or-flags-member
		a.name-range
	as fun-decl
		a.name-range
	as local
		throw unreachable
	as record-field
		a.name-range
	as signature
		a.name-range
	as struct-alias
		a.name-range
	as struct-decl
		a.name-range
	as spec-decl
		a.name-range
	as type-param-index
		throw unreachable
	as var-decl
		a.name-range

-add-inlay-hints-for-ref void(out inlay-hint builder, lcg line-and-character-getter, decl any-decl, uses uri set)
	do unless is-empty uses
	parts inlay-hint-label-part[] = uris-or-count-label-parts "Used by ", uses, 3
	out ~=
		position: end-of-line-for-decl lcg, decl
		label: parts
		kind: ()
		paddingLeft: true

-inlay-hint-for-import inlay-hint?
	lcgs line-and-character-getters
	importer-uri uri
	ast import-or-export-ast
	imported (symbol, uri-and-range)[]
do
	do if import-whole-module-ast ast.kind
	position: end-of-line lcgs[importer-uri], ast.range.start
	label:
		if imported.size > 5
			-
				value: "{imported.size} imported names"
				tooltip: join ", ", for x, _ in imported then x.to
		else
			imported-name-label-parts lcgs, imported
	kind: ()
	paddingLeft: true
-imported-name-label-parts inlay-hint-label-part[](lcgs line-and-character-getters, imported (symbol, uri-and-range)[])
	with-commas for name, range in imported
		value: name.to
		tooltip: ()
		location: lcgs[range]
		command: ()

-uris-or-count-label-parts inlay-hint-label-part[](description string, uris uri set, max-uris nat)
	if uris.size > max-uris
		-
			value: "{description}{uris.size} other modules"
			tooltip: join ", ", map uris, it.base-name
	else
		- description,
		-- with-commas for uri in uris
			value: uri.base-name
			location: uri.top-of-file

-with-commas inlay-hint-label-part[](a inlay-hint-label-part[])
	# TODO: std function to help?
	first mut bool = true
	do with out in build
	do for x in a
	if first
		first := false
	else
		out ~= (", ",)
	out ~= x

-get-inlay-hints-for-fun void(out inlay-hint builder, fun fun-decl) show-type-ctx
	do if fun.source.fun-decl-ast
	for param in fun.params
		get-inlay-hints-for-destructure out, fun, param
	if expr = as-expr fun.body
		get-inlay-hints-for-fun-body out, fun, expr

-get-inlay-hints-for-fun-body void(out inlay-hint builder, container type-container, body expr) show-type-ctx
	for expr in all-exprs-in-tree body
		each-destructure-at-expr-for-inlay expr, of destructure
			get-inlay-hints-for-destructure out, container, destructure

-each-destructure-at-expr-for-inlay void(a expr, f void mut(x destructure))
	match a
	as lambda-expr
		f[a.param]
	as let-expr
		f[a.destructure]
	as match-enum-expr
		if l = a.matched-local then f[l]
	as match-scalar-expr
		if l = a.matched-local then f[l]
	as match-string-like-expr
		if l = a.matched-local then f[l]
	as match-sum-type-expr
		if l = a.matched-local then f[l]
	as unpack-option
		f[a.destructure]
	else
		# Ignore 'match-sum-type-expr' since the type is explicit
		()

-get-inlay-hints-for-destructure void
	out inlay-hint builder
	type-container type-container
	a destructure
do show-type-ctx
	to-line-and-character = line-and-character-getters[type-container.module-uri]
	match a
	as destructure-ignore
		()
	as local
		do if name, type-ast = as-simple-destructure a.source
		unless type-ast
			out ~=
				position: to-line-and-character[name.range.end]
				label: show-type-unquoted (a.type, type-container)
				kind: Type
				paddingLeft: true
		purity = best-case-purity a.type
		if purity != data_
			out ~=
				end = if type-ast then type-ast.range.end else name.range.end
				position: to-line-and-character[end]
				label: purity.to
				kind: ()
				paddingLeft: true
	as destructure-split
		for part in a.parts
			get-inlay-hints-for-destructure out, type-container, part

-as-simple-destructure (name-and-range, type-ast?)?(a local-source)
	match a
	as it-scope-ast
		()
	as catch-ast
		()
	as name-and-range
		a, ()
	as single-destructure-ast
		a.name, a.type
	as local-source-generated
		()

-end-of-line-for-decl line-and-character(lcg line-and-character-getter, decl any-decl)
	end-of-line lcg, decl.range.range.start

-get-inlay-hints-for-test void
	out inlay-hint builder
	lcg line-and-character-getter
	test-states test-states
	test_ test_
do show-type-ctx
	uri = module-uri test_
	where uri-and-line = uri, line-of-pos lcg, test_.range.start.pos
	position = end-of-line-for-decl lcg, test_
	out ~=
		position: position
		label: if result = test-states[where]
			label-for-test-result result
		else
			label-for-run-test where
		kind: ()
		paddingLeft: true
	get-inlay-hints-for-fun-body out, test_, test_.body.expr

-label-for-test-result inlay-hint-label(a run-test-result)
	-
		value: if is-ok a.exit then "OK" else "Test failed"
		tooltip: tooltip-for-run-result a

-label-for-run-test inlay-hint-label(where uri-and-line)
	-
		value: "Run test"
		command:
			title: ""
			tooltip: ()
			arguments: run-test where

-tooltip-for-run-result string?(result run-test-result)
	do if is-ok result.exit or !is-empty result.writes
	lines string[] = if every result.writes, it.pipe == out
		for x in result.writes
			x.text
	else
		for x in result.writes
			"{x.pipe}: {x.text}"
	exit = unless is-ok result.exit
		"\nExit code {result.exit.value}"
	"{join "\n", lines}{exit}"
