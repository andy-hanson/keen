import
	../../frontend/check/inferring-type
	../../frontend/show-model
	../../lib/lsp/lsp-types
	../../model/model
	./doc-comment
	./position

get-completion-for-position completion-list?(show-ctx show-type-ctx, pos position)
	match x = pos kind
	as expression-position
		show-ctx completion-at-expression-position pos.module, x
	else
		error log "get-completion-for-position: not at an expression" # ------------------------------------------------------------------------------
		()

-completion-at-expression-position completion-list?
	show-ctx show-type-ctx
	module crow-module
	a expression-position
do
	match x = a kind
	as local-ref
		show-ctx completion-after-type module, a.container, x.local.type
	else
		error log "completion-at-expression-position: not at a local-ref" # -----------------------------------------------------------
		()

-completion-after-type completion-list?
	show-ctx show-type-ctx
	module crow-module
	container expr-container
	type type
do
	items completion-item[] = with out in build
		module each-fun-in-expr-scope container, of fun
			guard t = fun first-param-type
			# Don't include a function that accepts any type, since this results in too many functions matching
			guard t struct-inst and (t, fun.type-container-for) is-type-match-possible-for-completions type
			out ~= show-ctx completion-for-called-decl container.to, fun
	if items is-empty
		error log "completion-after-type: no items" # -----------------------------------------------------------------------------------
	unless items is-empty
		items,

-type-container-for type-container(a called-decl)
	match a
	as fun-decl
		a
	as called-spec-sig
		throw todo

-completion-for-called-decl completion-item(show-ctx show-type-ctx, type-container type-container, a called-decl)
	label: a.name to
	detail: show-ctx show-called-decl unquoted, type-container, a
	documentation: show-ctx.file-content-getters doc-comment-string a.module-uri, a.doc-comment

-first-param-type type?(a called-decl)
	param-types = match a
	as fun-decl
		a param-types
	as called-spec-sig
		a.instantiated-sig param-types
	unless param-types is-empty
		param-types[0]

-each-fun-in-expr-scope void(module crow-module, _ expr-container, f void mut(x called-decl))
	# TODO ------------------------------------------------------------------------------------------------------------------------
	#for spec_ in container.specs inner
	#	spec_ each-called-spec-sig of x
	#		f[x to]
	for x in module funs
		f[x]
	# TODO ------------------------------------------------------------------------------------------------------------------------
	#module each-import-or-re-export of x
	#	for _, refs in x named-imported
	#		for fun in refs funs
	#			f[fun to]
