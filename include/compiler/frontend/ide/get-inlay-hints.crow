import
	crow/io/print
	../../frontend/lang
	../../frontend/show-model
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/exit-code
	../walk-model

get-inlay-hints inlay-hint-result
	program program
	show-ctx show-model-ctx
	test-states test-states
	params inlay-hint-params
do
	uri = params.textDocument uri
	guard uri.file-type == crow
	module = program module-at-uri uri

	fun-refs uri mut-set[fun-decl] = for x in module funs then x, ()
	struct-refs uri mut-set[struct-decl] = for x in module structs then x, ()
	spec-refs uri mut-set[spec-decl] = for x in module specs then x, ()
	# TODO: record field refs, enum member refs, spec sigs --------------------------------------------------------------------------------
	for _, referencing-module in program all-modules
		guard referencing-module != module
		program.common-types walk-module referencing-module, of _, kind, x
			guard kind != comment
			match x
			as fun-decl
				if set = fun-refs[x]
					set ~= referencing-module uri
			as struct-decl
				if set = struct-refs[x]
					set ~= referencing-module uri
			as spec-decl
				if set = spec-refs[x]
					set ~= referencing-module uri
			else
				()

	lcg = program.line-and-character-getters[uri]
	res inlay-hint[] = with out in build
		out inlay-hints-for-imports program, module
		for x in module funs
			out add-inlay-hints-for-ref lcg, x, fun-refs[x]!.move-to
			out get-inlay-hints-for-fun show-ctx, x
		for x in module structs
			out add-inlay-hints-for-ref lcg, x, struct-refs[x]!.move-to
		for x in module specs
			out add-inlay-hints-for-ref lcg, x, spec-refs[x]!.move-to
		for x in module tests
			out get-inlay-hints-for-test lcg, test-states, x
	- res sort it.position

# For this, just track the location of the first thing
-inlay-hints-for-imports void(out inlay-hint array-builder, program program, module crow-module)
	# Maps a module URI to a map from imported names to the first import location
	imports uri-and-range mut[symbol] mut[uri] = ()
	program.common-types walk-module module, of _, kind, what
		guard kind != comment
		guard uri = what uri
		guard name = what name
		guard uri != module.uri
		x = imports ensure uri
		loc = what name-range
		if existing = x[name]
			if loc < existing
				x[name] := loc
		else
			x[name] := loc
	module zip-ast-and-module-imports of ast, imported
		match ast kind
		as import-whole-module-ast
			guard crow-imported = imported crow-module
			sorted (symbol, uri-and-range)[] = (imports[crow-imported uri] else ()).to sort it.a
			guard x = program.line-and-character-getters inlay-hint-for-import module.uri, ast, sorted
			out ~= x
		as array
			()
		as import-file-ast
			throw unreachable
-name-range uri-and-range(a doc-comment-reference) # TODO: this could just be a method on doc-comment-reference, if not for 'type-param-index'....
	match a
	as doc-comment-reference-bogus
		throw unreachable
	as called-spec-sig
		a name-range
	as enum-or-flags-member
		a name-range
	as fun-decl
		a name-range
	as local
		throw unreachable
	as record-field
		a name-range
	as signature
		a name-range
	as struct-alias
		a name-range
	as struct-decl
		a name-range
	as spec-decl
		a name-range
	as type-param-index
		throw unreachable
	as var-decl
		a name-range

-add-inlay-hints-for-ref void(out inlay-hint array-builder, lcg line-and-character-getter, decl any-decl, uses uri set)
	guard uses !is-empty
	parts inlay-hint-label-part[] = "Used by " uris-or-count-label-parts uses, 3
	out ~=
		position: lcg end-of-line-for-decl decl
		label: parts
		kind: ()
		paddingLeft: true

-inlay-hint-for-import inlay-hint?
	lcgs line-and-character-getters
	importer-uri uri
	ast import-or-export-ast
	imported (symbol, uri-and-range)[]
do
	guard ast.kind import-whole-module-ast
	parts inlay-hint-label-part[] = if imported.size > 5
		("{imported size} imported names", (", " join for x, _ in imported then x to), (), ()),
	else
		lcgs imported-name-label-parts imported
	(lcgs[importer-uri] end-of-line ast.range.start), parts, (), true
-imported-name-label-parts inlay-hint-label-part[](lcgs line-and-character-getters, imported (symbol, uri-and-range)[])
	parts inlay-hint-label-part[] = for name, range in imported
		value: name to
		tooltip: ()
		location: lcgs[range]
		command: ()
	parts with-commas

-uris-or-count-label-parts inlay-hint-label-part[](description string, uris uri set, max-uris nat)
	if uris.size > max-uris
		-
			value: "{description}{uris size} other modules"
			tooltip: ", " join for x in uris sort then x base-name
	else
		parts inlay-hint-label-part[] = for uri in uris sort
			value: uri base-name
			location: uri top-of-file
		- description,
		-- parts with-commas

-with-commas inlay-hint-label-part[](a inlay-hint-label-part[])
	# TODO: std function to help?
	first mut bool = true
	with out in build
		for x in a
			if first
				first := false
			else
				out ~= (", ",)
			out ~= x

-get-inlay-hints-for-fun void(out inlay-hint array-builder, show-ctx show-model-ctx, fun fun-decl)
	guard fun.source fun-decl-ast
	for param in fun params
		out get-inlay-hints-for-destructure show-ctx, fun, param
	if body = fun.body expr
		body each-descendent-expr-including of expr
			expr each-destructure-at-expr-for-inlay of destructure
				out get-inlay-hints-for-destructure show-ctx, fun, destructure

-each-destructure-at-expr-for-inlay void(a expr, f void mut(x destructure))
	match a
	as lambda-expr
		f[a param]
	as let-expr
		f[a destructure]
	as match-enum-expr
		if l = a matched-local then f[l]
	as match-scalar-expr
		if l = a matched-local then f[l]
	as match-string-like-expr
		if l = a matched-local then f[l]
	as match-sum-type-expr
		if l = a matched-local then f[l]
	as unpack-option
		f[a destructure]
	else
		# Ignore 'match-sum-type-expr' since the type is explicit
		()

-get-inlay-hints-for-destructure void
	out inlay-hint array-builder
	show-ctx show-model-ctx
	type-container type-container
	a destructure
do
	to-line-and-character line-and-character mut(pos pos) = of pos
		show-ctx.line-and-character-getters[type-container module-uri][pos, start-of-range]
	match a
	as destructure-ignore
		()
	as local
		guard name, type-ast = a.source as-simple-destructure
		unless type-ast
			out ~=
				position: to-line-and-character[name.range end]
				label: show-ctx show-type-unquoted (a.type, type-container)
				kind: Type
				paddingLeft: true
		purity = a.type best-case-purity
		if purity != data_
			out ~=
				end = if type-ast then type-ast.range end else name.range end
				position: to-line-and-character[end]
				label: purity to
				kind: ()
				paddingLeft: true
	as destructure-split
		for part in a parts
			out get-inlay-hints-for-destructure show-ctx, type-container, part

-as-simple-destructure (name-and-range, type-ast?)?(a local-source)
	match a
	as it-scope-ast
		()
	as catch-ast
		()
	as name-and-range
		a, ()
	as single-destructure-ast
		a.name, a.type
	as local-source-generated
		()

-end-of-line-for-decl line-and-character(lcg line-and-character-getter, decl any-decl)
	lcg end-of-line decl.range.range.start

-get-inlay-hints-for-test void
	out inlay-hint array-builder
	lcg line-and-character-getter
	test-states test-states
	test_ test_
do
	uri = test_ module-uri
	where uri-and-line = uri, (lcg line-of-pos test_.range.start.pos)
	position = lcg end-of-line-for-decl test_
	# TODO: this function should just return a single value then -----------------------------------------------------------
	out ~=
		position: position
		label: if result = test-states[where]
			result label-for-test-result
		else
			where label-for-run-test
		kind: ()
		paddingLeft: true

-label-for-test-result inlay-hint-label(a run-test-result)
	-
		value: if a.exit is-ok then "OK" else "Test failed"
		tooltip: a tooltip-for-run-result

-label-for-run-test inlay-hint-label(where uri-and-line)
	-
		value: "Run test"
		command:
			title: ""
			tooltip: ()
			arguments: where run-test

-tooltip-for-run-result string?(result run-test-result)
	guard result.exit is-ok or result.writes !is-empty
	lines string[] = if result.writes every it.pipe == out
		for x in result writes
			x text
	else
		for x in result writes
			"{x pipe}: {x text}"
	exit string = unless result.exit is-ok
		"\nExit code {result.exit value}"
	"{"\n" join lines}{exit}"
