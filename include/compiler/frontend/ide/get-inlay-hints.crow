import
	crow/io/print
	../../frontend/show-model
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/exit-code
	../../util/sym
	../walk-model

get-inlay-hints inlay-hint-result
	program program
	show-ctx show-model-ctx
	test-states test-states
	params inlay-hint-params
do
	uri = params textDocument
	module = program module-at-uri uri

	fun-refs uri mut-set[fun-decl] = for x : module funs; x, ()
	struct-refs uri mut-set[struct-decl] = for x : module structs; x, ()
	spec-refs uri mut-set[spec-decl] = for x : module specs; x, ()
	# TODO: record field refs, enum member refs, spec sigs --------------------------------------------------------------------------------
	for _, referencing-module : program all-modules
		guard referencing-module != module
		program.common-types walk-module referencing-module, (_, kind, thing) =>
			guard kind != comment
			match thing
			as fun-decl x
				if set ?= fun-refs[x]
					set ~= referencing-module uri
			as struct-decl x
				if set ?= struct-refs[x]
					set ~= referencing-module uri
			as spec-decl x
				if set ?= spec-refs[x]
					set ~= referencing-module uri
			else
				()

	lcg = program.line-and-character-getters[uri]
	res inlay-hint[] = with out : build
		out inlay-hints-for-imports program, module
		for x : module funs
			out add-inlay-hints-for-ref lcg, x.to, fun-refs[x]!.move-to
			out get-inlay-hints-for-fun show-ctx, x
		for x : module structs
			out add-inlay-hints-for-ref lcg, x.to, struct-refs[x]!.move-to
		for x : module specs
			out add-inlay-hints-for-ref lcg, x.to, spec-refs[x]!.move-to
		for x : module tests
			out get-inlay-hints-for-test lcg, test-states, x
	(res sort x => x.position),

# For this, just track the location of the first thing
-inlay-hints-for-imports void(out inlay-hint array-builder, program program, module module)
	# Maps a module URI to a map from imported names to the first import location
	imports uri-and-range mut[sym] mut[uri] = ()
	program.common-types walk-module module, (_, kind, what) =>
		guard kind != comment
		guard uri ?= what uri
		guard name ?= what name
		guard uri != module.uri
		x = imports ensure uri
		loc = what range
		if existing ?= x[name]
			if loc < existing
				x[name] := loc
		else
			x[name] := loc
	module zip-ast-and-module-imports (ast, imported) =>
		match ast kind
		as import-whole-module-ast _
			sorted (sym, uri-and-range)[] = (imports[imported.uri] ?? ()).to sort (x, _) => x
			if x ?= program.line-and-character-getters inlay-hint-for-import module.uri, ast, sorted
				out ~= x
		as array _
			()
		as import-file-ast _
			throw unreachable
-range uri-and-range(a doc-comment-reference)
	match a
	as doc-comment-reference-bogus
		throw unreachable
	as called-spec-sig x
		x range
	as enum-or-flags-member x
		x range
	as fun-decl x
		x range
	as local _
		throw unreachable
	as record-field x
		x range
	as signature x
		x range
	as struct-alias x
		x range
	as struct-decl x
		x range
	as spec-decl x
		x range
	as type-param-index _
		throw unreachable
	as var-decl x
		x range

-add-inlay-hints-for-ref void(out inlay-hint array-builder, lcg line-and-character-getter, decl any-decl, uses uri set)
	guard uses !is-empty
	parts inlay-hint-label-part[] = "Used by " uris-or-count-label-parts uses, 3
	out ~= do
		position: lcg end-of-line-for-decl decl
		label: parts to
		kind: ()
		paddingLeft: true

-inlay-hint-for-import inlay-hint?
	lcgs line-and-character-getters
	importer-uri uri
	ast import-or-export-ast
	imported (sym, uri-and-range)[]
do
	guard _ ?= ast.kind import-whole-module-ast
	parts inlay-hint-label-part[] = if imported.size > 5
		("{imported size} imported names", (", " join for x, _ : imported; x to), (), ()),
	else
		lcgs imported-name-label-parts imported
	(lcgs[importer-uri] end-of-line ast.range.start), parts.to, (), true
-imported-name-label-parts inlay-hint-label-part[](lcgs line-and-character-getters, imported (sym, uri-and-range)[])
	parts inlay-hint-label-part[] = for name, range : imported
		value: name to
		tooltip: ()
		location: lcgs[range]
		command: ()
	parts with-commas

-uris-or-count-label-parts inlay-hint-label-part[](description string, uris uri set, max-uris nat)
	with out : build
		if uris.size > max-uris
			out ~= do
				value: "{description}{uris size} other modules"
				tooltip: ", " join for x : uris sort; x base-name
		else
			out ~= (description,)
			parts inlay-hint-label-part[] = for uri : uris sort
				value: uri base-name
				location: uri top-of-file
			out ~~= parts with-commas

-with-commas inlay-hint-label-part[](a inlay-hint-label-part[])
	# TODO: std function to help?
	first mut = true
	with out : build
		for x : a
			if first
				first := false
			else
				out ~= (", ",)
			out ~= x

-get-inlay-hints-for-fun void(out inlay-hint array-builder, show-ctx show-model-ctx, fun fun-decl)
	guard _ ?= fun.source fun-decl-ast
	type-container type-container = fun to
	for param : fun.params params-array
		out get-inlay-hints-for-destructure show-ctx, type-container, param
	if body ?= fun.body expr
		body each-descendent-expr-including expr =>
			expr each-destructure-at-expr-for-inlay destructure =>
				out get-inlay-hints-for-destructure show-ctx, type-container, destructure

-each-destructure-at-expr-for-inlay void(a expr, f void mut(x destructure))
	match a
	as lambda-expr x
		f[x param]
	as let-expr x
		f[x destructure]
	else
		# Ignore 'match-sum-type-expr' since the type is explicit
		()

-get-inlay-hints-for-destructure void
	out inlay-hint array-builder
	show-ctx show-model-ctx
	type-container type-container
	a destructure
do
	to-line-and-character line-and-character mut(pos pos) = pos =>
		show-ctx.line-and-character-getters[type-container module-uri][pos, start-of-range]
	match a
	as destructure-ignore _
		()
	as local x
		guard ast ?= x.source single-destructure-ast
		unless _ ?= ast type
			out ~= do
				position: to-line-and-character[ast.name.range end]
				label: show-ctx show-type-unquoted (x.type, type-container) to
				kind: Type
				paddingLeft: true
		purity = x.type best-case-purity
		if purity != data_
			out ~= do
				position: to-line-and-character[ast.range end]
				label: purity.to::string to
				kind: ()
				paddingLeft: true
	as destructure-split x
		for part : x parts
			out get-inlay-hints-for-destructure show-ctx, type-container, part

-end-of-line-for-decl line-and-character(lcg line-and-character-getter, decl any-decl)
	lcg end-of-line decl.range.range.start

-get-inlay-hints-for-test void
	out inlay-hint array-builder
	lcg line-and-character-getter
	test-states test-states
	test_ test_
do
	uri = test_ module-uri
	where uri-and-line = uri, (lcg line-of-pos test_.range.start)
	position = lcg end-of-line-for-decl test_.to
	# TODO: this function should just return a single value then -----------------------------------------------------------
	out ~= do
		position: position
		label: if result ?= test-states[where]
			result label-for-test-result
		else
			where label-for-run-test
		kind: ()
		paddingLeft: true

-label-for-test-result inlay-hint-label(a run-result)
	part inlay-hint-label-part = (a.exit is-ok ? "OK" : "Test failed"), a.tooltip-for-run-result
	part,

-label-for-run-test inlay-hint-label(where uri-and-line)
	part inlay-hint-label-part = do
		command command = do
			title: ""
			tooltip: ()
			arguments: where run-test
		value: "Run test"
		command: command
	part,

-tooltip-for-run-result string?(result run-result)
	guard result.exit is-ok || result.writes !is-empty
	lines string[] = if result.writes every x => x.pipe == out
		for x : result writes
			x text
	else
		for x : result writes
			"{x pipe}: {x text}"
	exit string = unless result.exit is-ok
		"\nExit code {result.exit value}"
	"{"\n" join lines}{exit}"
