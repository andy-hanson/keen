import
	../../model/lsp
	../../model/model
	../../model/source-range
	../../model/uri
	./get-position
	./get-references

get-rename workspace-edit?(program program, params rename-params)
	do if pos = get-position program, params.text-document-and-position, exact-or-end
	refs = get-references program, pos, rename
	edits-by-uri text-edit mut[] mut[uri] = ()
	for ref in refs
		ensure edits-by-uri, ref.uri ~= ref.range, params.newName
	res (uri, text-edit[])[] = for uri, edits in edits-by-uri
		uri, edits.move-to
	changes: sort res, it.a
