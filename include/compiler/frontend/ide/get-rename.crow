import
	../../lib/lsp/lsp-types
	../../model/model
	../../model/source-range
	../../model/uri
	./get-position
	./get-references
	./position

get-rename workspace-edit?(program program, params rename-params)
	if position = get-position program, params.text-document-and-position, exact
		get-rename-for-position program, position, params.newName

get-rename-for-position workspace-edit?(program program, pos position, new-name string)
	refs = get-references program, pos, rename
	edits-by-uri text-edit mut[] mut[uri] = ()
	for ref in refs
		ensure edits-by-uri, ref.uri ~= ref.range, new-name
	res (uri, text-edit[])[] = for uri, edits in edits-by-uri
		uri, edits.move-to
	changes: sort res, it.a
