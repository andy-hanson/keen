import
	../../lib/lsp/lsp-types
	../../model/model
	../../model/source-range
	../../model/uri
	./get-references
	./position

get-rename-for-position workspace-edit?(program program, pos position, new-name string)
	refs = program get-references-for-position pos
	edits-by-uri text-edit mut[] mut[uri] = ()
	for ref in refs
		edits-by-uri ensure ref.uri ~= ref.range, new-name
	res (uri, text-edit[])[] = for uri, edits in edits-by-uri
		uri, edits.move-to
	- res sort it.a
