import
	../../lib/lsp/lsp-types
	../../model/model
	../../model/source-range
	../../model/uri
	./get-references
	./get-target
	./position

get-rename-for-position workspace-edit?(program program, pos position, new-name string)
	guard target ?= pos target-for-position
	edits-by-uri text-edit mut[] mut[uri] = ()
	program each-reference-for-target pos.module.uri, target, include, x =>
		range = program.line-and-character-getters[x]
		edits-by-uri ensure range.uri ~= (range.range, new-name)
	res (uri, text-edit[])[] = for uri, edits : edits-by-uri
		uri, edits.move-to
	(res,),
