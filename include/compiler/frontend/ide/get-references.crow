import
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../walk-model
	./get-definition
	./get-target
	./position

get-document-highlights-for-position document-highlight-result?(program program, pos position)
	uri = pos.module uri
	highlights document-highlight[] = for* x in program get-references-for-position pos
		if x.uri == uri
			- x.range, Read
	uri: uri
	highlights: highlights sort it.range.start

get-references-for-position uri-and-line-and-character-range[](program program, pos position)
	guard target = pos target-for-position
	lcgs = program line-and-character-getters
	res uri-and-line-and-character-range[] = with out in build
		pos.module.uri definition-for-target target, of where
			out ~= lcgs[where]
		match target
		as position-imported-name
			# TODO: Walk everything in this module. If it matches the name and comes from this module, count it as a reference.
			throw todo
		as position-local
			for ref in target references-for-local
				out ~= lcgs[pos.module.uri, ref]
		as loop-target
			for ref in target.loop_ references-for-loop
				out ~= lcgs[pos.module.uri, ref]
		as crow-module
			for ref in program references-for-module target
				out ~= lcgs[ref]
		as type-param-with-container
			program.common-types walk-any-decl target.container, of where, _, what
				guard what.type-param-index == target.type-param
				out ~= lcgs[pos.module.uri, where]
		else
			program walk-program of where, _, thing
				guard thing references target
				out ~= lcgs[where]
	res sort

-references-for-module uri-and-range[](program program, module crow-module)
	with out in build
		for _, importer in program all-modules
			importer zip-ast-and-module-imports of ast, imported
				guard imported.crow-module == module
				out ~= importer.uri, ast.range

-references bool(ref doc-comment-reference, target target)
	match target
	as enum-or-flags-member
		match ref
		as fun-decl
			ref.body.create-enum-or-flags.?member == target
		as enum-or-flags-member
			ref == target
		else
			()
	as fun-decl
		ref.fun-decl == target
	as position-imported-name
		throw unreachable
	as position-local
		throw unreachable
	as loop-target
		throw unreachable
	as crow-module
		throw unreachable
	as record-field
		match ref
		as fun-decl
			match body = ref body
			as record-field-get
				body.field == target
			as record-field-set
				body.field == target
			else
				()
		as record-field
			ref == target
		else
			()
	as spec-decl
		ref.spec-decl == target
	as signature
		ref.called-spec-sig.?non-instantiated-sig == target
	as struct-alias
		# TODO: Make sure the name matches too ----------------------------------------------------------------------------------
		ref.struct-decl == target.target.decl
	as struct-decl
		ref.struct-decl == target
	as type-param-with-container
		throw unreachable
	as var-decl
		match ref
		as fun-decl
			match body = ref body
			as var-get
				body.var == target
			as var-set
				body.var == target
			else
				()
		as var-decl
			ref == target
		else
			()

-references-for-local source-range[](a position-local)
	guard container, body = a.container container-and-body
	with out in build
		container.doc-comment walk-doc-comment of where, _, ref
			guard local = ref local
			guard local.local-must-have-name-range == a.local.local-must-have-name-range
			out ~= where
		# Deduplicate the 'local-get' and 'local-set' in `x +:= 1`
		seen pos mut-set = ()
		body each-descendent-expr-including of x
			guard ref = x expr-local-reference
			guard ref.local == a.local and seen try-add x.start
			out ~= ref name-range
-container-and-body (expr-container, expr)?(a local-container)
	match a
	as fun-decl
		if e = a.body expr
			a, e
	as test_
		a, a.body
	as spec-decl
		()
	as struct-decl
		()
	as var-decl
		a, a.initializer

-local-reference record(local local, name-range source-range)
-expr-local-reference local-reference?(a expr)
	match a
	as local-get-expr
		a.local, a.range
	as local-get-and-refine-expr
		a.local, a.range
	as local-set-expr
		a.local, a.assignee-ast.range
	else
		()

-references-for-loop source-range[](loop_ loop-expr)
	with out in build
		loop_ each-descendent-expr-excluding of child
			match child
			as loop-break-expr
				out ~= child range
			as loop-continue-expr
				out ~= child range
			else
				()
