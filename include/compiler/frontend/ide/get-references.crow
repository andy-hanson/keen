import
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../walk-model
	./get-definition
	./get-target
	./position

find-all-references uri-and-line-and-character-range[](program program, pos position)
	get-references program, pos, all-references

find-document-highlights document-highlight-result?(program program, pos position)
	uri = pos.module.uri
	highlights document-highlight[] = for* x in get-references program, pos, document-highlights
		if x.uri == uri
			- x.range, Read
	uri: uri
	highlights: sort highlights, it.range.start

references-kind enum(all-references, rename, document-highlights)
== bool(a references-kind, b references-kind)
get-references uri-and-line-and-character-range[](program program, pos position, kind references-kind)
	the common-types = program.common-types
	do if target = target-for-position pos
	lcgs = program.line-and-character-getters
	sort with out in build
		definition-for-target pos.module.uri, target, of where
			out ~= lcgs[where]
		match target
		as position-imported-name
			# TODO: Walk everything in this module. If it matches the name and comes from this module, count it as a reference.
			throw todo
		as position-local
			for ref in references-for-local target
				out ~= lcgs[pos.module.uri, ref]
		as loop-target
			for ref in references-for-loop target.loop_
				out ~= lcgs[pos.module.uri, ref]
		as crow-module
			for ref in references-for-module program, target
				out ~= lcgs[ref]
		as type-param-with-container
			walk-any-decl target.container, of where, _, what
				do if what.type-param-index == target.type-param
				out ~= lcgs[pos.module.uri, where]
		else
			walk-program program, of where, _, thing
				do if references thing, target, kind
				out ~= lcgs[where]


-references-for-module uri-and-range[](program program, module crow-module)
	do with out in build
	do for _, importer in all-modules program
	zip-ast-and-module-imports importer, of ast, imported
		do if imported.crow-module == module
		out ~= importer.uri, ast.range

-references bool(ref doc-comment-reference, target target, kind references-kind)
	match target
	as enum-or-flags-member
		match ref
		as fun-decl
			ref.body.create-enum-or-flags.?member == target
		as enum-or-flags-member
			ref == target
		else
			()
	as fun-decl
		ref.fun-decl == target
	as position-imported-name
		throw unreachable
	as position-local
		throw unreachable
	as loop-target
		throw unreachable
	as crow-module
		throw unreachable
	as record-field
		match ref
		as fun-decl
			match body = ref.body
			as record-field-get
				body.field == target
			as record-field-set
				body.field == target
			else
				()
		as record-field
			ref == target
		else
			()
	as spec-decl
		ref.spec-decl == target
	as signature
		ref.called-spec-sig.?non-instantiated-sig == target
	as struct-alias
		# TODO: Make sure the name matches too ----------------------------------------------------------------------------------
		ref.struct-decl == target.target.decl
	as struct-decl
		match ref
		as struct-decl
			ref == target
		as doc-comment-reference-context
			if kind == document-highlights
				ref.type.decl == target
		else
			()
	as type-param-with-container
		throw unreachable
	as var-decl
		match ref
		as fun-decl
			match body = ref.body
			as var-get
				body.var == target
			as var-set
				body.var == target
			else
				()
		as var-decl
			ref == target
		else
			()

-references-for-local source-range[](a position-local)
	do if container, body = a.container.container-and-body
	do with out in build
	walk-doc-comment container.doc-comment, of where, _, ref
		do if ref.local
		do if ref.local-must-have-name-range == a.local.local-must-have-name-range
		out ~= where
	# Deduplicate the 'local-get' and 'local-set' in `x +:= 1`
	seen pos mut-set = ()
	each-descendent-expr-including body, of x
		do if ref = x.expr-local-reference
		do if ref.local == a.local and try-add seen, x.start
		out ~= ref.name-range
-container-and-body (expr-container, expr)?(a local-container)
	match a
	as fun-decl
		if expr = a.body.as-expr
			a, expr
	as test_
		a, a.body.expr
	as spec-decl
		()
	as struct-decl
		()
	as var-decl
		a, a.initializer.expr

-local-reference record(local local, name-range source-range)
-expr-local-reference local-reference?(a expr)
	match a
	as local-get-expr
		a.local, a.range
	as local-get-and-refine-expr
		a.local, a.range
	as local-set-expr
		a.local, a.assignee-ast.range
	else
		()

-references-for-loop source-range[](loop_ loop-expr)
	do with out in build
	each-descendent-expr-excluding loop_, of child
		match child
		as loop-break-expr
			out ~= child.keyword-range
		as loop-continue-expr
			out ~= child.range
		else
			()
