import
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/sym
	../../util/util
	../walk-model
	./get-definition
	./get-target
	./ide-util
	./position

get-document-highlights-for-position document-highlight-result?(program program, pos position)
	uri = pos.module uri
	highlights document-highlight[] = with out : build
		for x : program get-references-for-position pos
			if x.uri == uri
				out ~= (x.range, Read)
	(uri, (highlights sort x => x.range.start)),

get-references-for-position uri-and-line-and-character-range[](program program, pos position)
	guard target ?= pos target-for-position
	match target
	as position-imported-name _
		# TODO: Walk everything in this module. If it matches the name and comes from this module, count it as a reference.
		throw todo
	as position-local x
		for ref : x references-for-local
			program.line-and-character-getters[pos.module.uri, ref]
	as loop-target x
		for ref : x.loop_ references-for-loop
			program.line-and-character-getters[pos.module.uri, ref]
	as module _
		throw todo
	as type-param-with-container x
		with out : build
			program.common-types walk-any-decl x.container, (where, what) =>
				guard y ?= what type-param-index
				guard y == x.type-param
				out ~= program.line-and-character-getters[pos.module.uri, where]
	else
		with out : build
			program walk-program (where, thing) =>
				guard thing references target
				out ~= program.line-and-character-getters[where]

-references bool(ref doc-comment-reference, target target)
	match target
	as enum-or-flags-member _
		throw todo # -----------------------------------------------------------------------------------------------------------------------
	as fun-decl x
		if f ?= ref fun-decl
			f == x
	as position-imported-name _
		throw unreachable
	as position-local _
		throw unreachable
	as loop-target _
		throw unreachable
	as module _
		throw unreachable
	as record-field x
		match ref
		as fun-decl f
			match f body
			as record-field-call y
				y.field == x
			as record-field-get y
				y.field == x
			as record-field-set y
				y.field == x
			else
				false
		as record-field y
			y == x
		else
			false
	as spec-decl x
		guard y ?= ref spec-decl
		y == x
	as signature x
		guard c ?= ref called-spec-sig
		c.non-instantiated-sig == x
	as struct-alias x
		guard y ?= ref struct-decl
		# TODO: Make sure the name matches too ----------------------------------------------------------------------------------
		y == x.target.decl
	as struct-decl x
		guard y ?= ref struct-decl
		y == x
	as type-param-with-container _
		throw unreachable
	as var-decl x
		match ref
		as fun-decl f
			match f body
			as var-get y
				y.var == x
			as var-set y
				y.var == x
			else
				false
		as var-decl y
			y == x
		else
			false

-references-for-local source-range[](a position-local)
	guard container, body ?= a.container container-and-body
	with out : build
		container.doc-comment walk-doc-comment (where, ref) =>
			guard local ?= ref local
			guard local.local-must-have-name-range == a.local.local-must-have-name-range
			out ~= where
		# Deduplicate the 'local-get' and 'local-set' in `x +:= 1`
		seen pos mut-set = ()
		body each-descendent-expr-including x =>
			guard ref ?= x expr-local-reference
			guard ref.local == a.local && seen try-add x.start
			out ~= ref name-range
-container-and-body (expr-container, expr)?(a local-container)
	match a
	as fun-decl x
		if e ?= x.body expr
			(x.to, e),
	as test_ x
		(x.to, x.body),
	as spec-decl _
		()
	as struct-decl _
		()

-local-reference record(local local, name-range source-range)
-expr-local-reference local-reference?(a expr)
	match a
	as closure-get-expr x
		(x.local, x.range),
	as closure-set-expr x
		(x.local, x.assignee-range),
	as local-get-expr x
		(x.local, x.range),
	as local-set-expr x
		(x.local, x.assignee-range),
	else
		()

-references-for-loop source-range[](loop_ loop-expr)
	with out : build
		loop_.to each-descendent-expr-excluding child =>
			match child
			as loop-break-expr x
				out ~= x range
			as loop-continue-expr x
				out ~= x range
			else
				()
