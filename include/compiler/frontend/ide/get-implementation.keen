import
	../../model/lsp
	../../model/model
	../../model/source-range
	../../model/uri
	./get-definition
	./get-position
	./get-target

get-implementation uri-and-line-and-character-range[](program program, params implementation-params)
	do if position = get-position program, params.params, exact
	do if target = target-for-position position
	for x in implementation-for-target program, target
		program.line-and-character-getters[x]

-implementation-for-target uri-and-range[](program program, target target)
	if signature target and struct = struct-decl target.container
		implementation-for-method program, struct, target
	else
		with out in build
			definition-for-target target, of x
				out ~= x

-implementation-for-method uri-and-range[](program program, sum-type struct-decl, method signature)
	do for* _, module in program.keen-modules
	do for* struct in module.structs
	do for* x in struct.sum-type-memberships
	do if x.sum-type.decl == sum-type
	do if inst = x.method-impls[method.index-of-signature]
	- inst.decl.name-range
