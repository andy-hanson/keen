use-prefix
import
	crow/parse
	../../../crow/json: try-take-number, try-take-quoted-string # TODO: move this stuff to parse-util ----------------------------------
	../../../crow/private/parse-util
	../../frontend/parse/lex-token
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/source-range
	../../util/util

tokens-of-crowd semantic-tokens(line-and-character-getter line-and-character-getter)
	# For Crowd, we will  just retokenize the whole file
	out tokens-builder = line-and-character-getter,
	iter string-iterator = begin line-and-character-getter.source-text
	until iter.is-at-end
		start = iter.pos
		if try-take-number iter
			out ~= number, (start, iter.pos)
		elif try-take-quoted-string iter
			out ~= string, (start, iter.pos)
		elif try-take-crow-identifier iter
			end = iter.pos
			if try-take-char8 iter, ":"
				out ~= parameter, (start, end)
		else
			# Just skip past anything else
			_ = take-char8 iter
	finish out

tokens-of-ast semantic-tokens(file file-ast)
	out tokens-builder = file.line-and-character-getter,
	add-doc-comment-tokens out, file.doc-comment
	for ast in ast-in-order file
		match ast
		as imports-or-exports-ast
			add-import-tokens out, ast
		as spec-decl-ast
			add-spec-tokens out, ast
		as struct-alias-ast
			add-struct-alias-tokens out, ast
		as struct-decl-ast
			add-struct-tokens out, ast
		as fun-decl-ast
			add-fun-tokens out, ast
		as test-ast
			add-test-tokens out, ast
		as var-decl-ast
			add-var-decl-tokens out, ast
	add-last-tokens out
	finish out

| Used to lex the tokens that appear between AST nodes for syntax highlighting.
lex-tokens-between-asts void
	source char8 array-view
	range source-range
	cb-comment void mut(x source-range)
	cb-keyword void mut(x source-range)
do
	end = range.end
	iter string-iterator = begin source[range.start.to .. end.to]
	until iter.is-at-end
		skip-for-tokens iter, of pos
			cb-comment[range.start + pos, range.start + iter.pos]
		unless iter.is-at-end
			start = iter.pos
			until iter.is-at-end or ignore-char-for-tokens iter.peek8
				_ = take-char8 iter
			cb-keyword[range.start + start, range.start + iter.pos]

-ignore-char-for-tokens bool(a char8)
	is-whitespace a or a == "\\" or a == "#" or is-non-keyword-punctuation a

| Skip mundane punctuation instead of highlighting it as a keyword
-is-non-keyword-punctuation bool(a char8)
	a == "." or a == "," or a == "(" or a == ")" or a == "[" or a == "]"

-skip-for-tokens void(iter string-iterator, cb-comment cb-comment)
	loop
		start = iter.pos
		unless iter.is-at-end
			while is-non-keyword-punctuation iter.peek8
				_ = take-char8 iter
		unless iter.is-at-end
			skip-spaces-and-comments iter, cb-comment, ()
		unless iter.is-at-end
			if iter.peek8 == "\\"
				# Non-comment '\', skip this too
				_ = take-char8 iter
		unless iter.is-at-end
			skip-blank-lines iter, it.noop, cb-comment, ()
		# TODO: allow 'if iter.pos == start then break else continue'
		if iter.pos == start
			break
		else
			continue

json-of-decoded-tokens json(a semantic-tokens)
	(map a.decode-semantic-tokens, it.to)::json[] 'to

get-tokens-legend json()
	tokenTypes: members::token-type[].to

token record
	line nat32
	character nat32
	length nat32
	type token-type
to json(a token)
decode-semantic-tokens record(inner semantic-tokens)
to token[](a decode-semantic-tokens)
	map a, it.identity
size nat(a decode-semantic-tokens)
	a.inner.data_.size / 5
iterate bool(a decode-semantic-tokens, f bool mut(x token))
	line mut nat32 = 0
	character mut nat32 = 0
	i mut nat = 0
	data_ = a.inner.data_
	loop
		guard i != data_.size else break
		delta-line nat32 = data_[i].to
		delta-character nat32 = data_[i + 1].to
		length nat32 = data_[i + 2].to
		type token-type = data_[i + 3].to!
		# data_[i + 4] would be modifiers, but we don't use those
		if delta-line == 0
			character +:= delta-character
		else
			line +:= delta-line
			character := delta-character
		if f[line, character, length, type]
			break
		else
			i +:= 5
			continue

| https://microsoft.github.io/language-server-protocol/specifications/lsp/3.18/specification/#semanticTokenTypes
token-type enum
	comment
	enum_
	enumMember
	function_
	interface_
	keyword
	namespace
	number
	parameter
	property
	string
	type
	typeParameter
	variable
-to token-type?(a nat64)
-to nat(a token-type)
-members token-type[]()
show string(a token-type)
	a.to
to string(a token-type)
	match a
	as comment
		"comment"
	as enum_
		"enum"
	as enumMember
		"enumMember"
	as function_
		"function"
	as interface_
		"interface"
	as keyword
		"keyword"
	as namespace
		"namespace"
	as number
		"number"
	as parameter
		"parameter"
	as property
		"property"
	as string
		"string"
	as type
		"type"
	as typeParameter
		"typeParameter"
	as variable
		"variable"
to json(a token-type)
	a.to::string.to

-tokens-builder record mut
	source char8 array-view
	line-and-character-getter line-and-character-getter
	encoded nat mut[]
	prev-pos mut pos
	prev-line mut nat32
	prev-character mut nat32
-new tokens-builder(line-and-character-getter line-and-character-getter)
	source: line-and-character-getter.source-text
	line-and-character-getter: line-and-character-getter
	encoded: ()
	prev-pos: 0
	prev-line: 0
	prev-character: 0
-finish semantic-tokens(a tokens-builder)
	data_: a.encoded.move-to

-~= void(a tokens-builder, (type token-type, range source-range))
	guard range.length != 0 # This can happen for missing names
	advance-to a, range.start
	assert range.end <= a.source.size.to
	a.prev-pos := range.end
	add-inner a, range, type

-advance-to void(a tokens-builder, pos pos)
	add-tokens-between a, (a.prev-pos, pos)
	a.prev-pos := pos

-add-last-tokens void(a tokens-builder)
	advance-to a, a.source.size.to

-add-inner void(a tokens-builder, range source-range, type token-type)
	lc-range = a.line-and-character-getter[range]
	start = lc-range.start
	end = lc-range.end
	if start.line == end.line
		add-single-line-token a, start, (end.character - start.character).to, type
	else
		first-length = (line-length-in-characters a.line-and-character-getter, start.line.to) - start.character.to
		add-single-line-token a, start, first-length, type
		for line in start.line + 1 .. end.line
			add-single-line-token a, (line, 0), (line-length-in-characters a.line-and-character-getter, line.to), type
		add-single-line-token a, (end.line, 0), end.character.to, type

-add-single-line-token void
	a tokens-builder
	pos line-and-character
	length nat
	type token-type
do
	assert a.prev-line < pos.line or a.prev-line == pos.line and a.prev-character < pos.character or a.prev-line == 0 and a.prev-character == 0
	delta-line nat, delta-character nat = if pos.line == a.prev-line
		0, (pos.character - a.prev-character).to
	else
		(pos.line - a.prev-line).to, pos.character.to
	a.encoded ~~= (delta-line, delta-character, length, type.to, 0)::nat[]
	a.prev-line := pos.line
	a.prev-character := pos.character

-add-tokens-between void(a tokens-builder, range source-range)
	on-comment void mut(comment-range source-range) = of comment-range
		assert range-contains range, comment-range
		add-inner a, comment-range, comment
	lex-tokens-between-asts a.source, range, on-comment, of keyword-range
		assert range-contains range, keyword-range
		add-inner a, keyword-range, keyword

-add-doc-comment-tokens void(out tokens-builder, a doc-comment-ast)
	guard !is-empty a
	range = a.range!
	pos mut = range.start
	for x in a.references
		out ~= comment, (pos, x.range.start)
		out ~= variable, x.range
		pos := x.range.end
	out ~= comment, (pos, range.end)

-add-import-tokens void(out tokens-builder, a imports-or-exports-ast)
	for import-or-export in a.paths
		out ~= namespace, import-or-export.path-range
		match kind = import-or-export.kind
		as import-whole-module-ast
			()
		as array
			for name in kind
				out ~= variable, name.range
		as import-file-ast
			out ~= variable, kind.name.range

-add-spec-tokens void(out tokens-builder, a spec-decl-ast)
	add-doc-comment-tokens out, a.doc-comment
	out ~= interface_, a.name.range
	add-type-params-tokens out, a.type-params
	add-modifier-tokens out, a.modifiers
	for x in a.sigs
		add-signature-tokens out, x

-add-signature-tokens void(out tokens-builder, a signature-ast)
	add-doc-comment-tokens out, a.doc-comment
	out ~= function_, a.name-range
	add-sig-return-type-and-params-tokens out, a.return-type, a.params

-add-sig-return-type-and-params-tokens void(out tokens-builder, return-type type-ast, params destructure-ast[])
	add-type-tokens out, return-type
	add-params-tokens out, params

-add-params-tokens void(out tokens-builder, params destructure-ast[])
	for param in params
		add-param-destructure-tokens out, param

-add-type-tokens void(out tokens-builder, a type-ast)
	match a
	as bogus-type-ast
		()
	as fun-type-ast
		add-type-tokens out, a.return-type
		add-param-destructure-tokens out, a.param
	as map-type-ast
		add-type-tokens out, a.value
		add-type-tokens out, a.key
	as name-and-range
		out ~= type, a.range
	as suffix-name-type-ast
		add-type-tokens out, a.left
		out ~= type, a.name.range
	as suffix-special-type-ast
		add-type-tokens out, a.left
		out ~= type, a.suffix-range
	as tuple-type-ast
		for t in a.members
			add-type-tokens out, t

-add-type-params-tokens void(out tokens-builder, a name-and-range[])
	for type-param in a
		out ~= typeParameter, type-param.range

-add-struct-alias-tokens void(out tokens-builder, a struct-alias-ast)
	add-doc-comment-tokens out, a.doc-comment
	out ~= type, a.name.range
	add-type-params-tokens out, a.type-params
	add-type-tokens out, a.target

-add-struct-tokens void(out tokens-builder, a struct-decl-ast)
	add-doc-comment-tokens out, a.doc-comment
	out ~= type, a.name.range
	add-type-params-tokens out, a.type-params
	match body = a.body
	as builtin-type-ast
		add-modifier-tokens out, a.modifiers
	as enum-ast
		add-enum-or-flags-tokens out, a, body.params, body.members
	as flags-ast
		add-enum-or-flags-tokens out, a, body.params, body.members
	as record-ast
		add-record-tokens out, a, body.params, body.fields
	as sum-type-ast
		for type in body.types
			add-type-tokens out, type
		add-modifier-tokens out, a.modifiers
		for sig in body.methods
			add-signature-tokens out, sig

-add-record-tokens void(out tokens-builder, a struct-decl-ast, params destructure-ast[]?, members record-field-ast[])
	if params
		add-params-tokens out, params
	add-modifier-tokens out, a.modifiers
	for x in members
		add-doc-comment-tokens out, x.doc-comment
		out ~= property, x.name.range
		if t = x.type
			add-type-tokens out, t

-add-modifier-tokens void(out tokens-builder, a modifier-ast[])
	for mod in a
		match mod
		as modifier-keyword-ast
			if t = mod.type-arg
				add-type-tokens out, t
		as spec-use-ast
			if t = mod.type-arg
				add-type-tokens out, t
			out ~= interface_, mod.name.range

-add-enum-or-flags-tokens void(out tokens-builder, a struct-decl-ast, params destructure-ast[]?, members enum-or-flags-member-ast[])
	if params
		add-params-tokens out, params
	add-modifier-tokens out, a.modifiers
	for member in members
		add-doc-comment-tokens out, member.doc-comment
		out ~= enumMember, member.name-range
		if v = member.value
			out ~= number, v.range

-add-var-decl-tokens void(out tokens-builder, a var-decl-ast)
	add-doc-comment-tokens out, a.doc-comment
	out ~= variable, a.name.range
	add-type-params-tokens out, a.type-params
	add-type-tokens out, a.type
	add-modifier-tokens out, a.modifiers
	if i = a.initializer then add-expr-tokens out, i

-add-fun-tokens void(out tokens-builder, a fun-decl-ast)
	add-doc-comment-tokens out, a.doc-comment
	out ~= function_, a.name.range
	add-type-params-tokens out, a.type-params
	add-sig-return-type-and-params-tokens out, a.return-type, a.params
	add-modifier-tokens out, a.modifiers
	if b = a.body then add-expr-tokens out, b

-add-test-tokens void(out tokens-builder, a test-ast)
	add-doc-comment-tokens out, a.doc-comment
	if b = a.body then add-expr-tokens out, b

-add-expr-tokens void(out tokens-builder, a expr-ast)
	match a
	as assert-or-forbid-ast
		add-expr-tokens out, a.condition
		if t = a.thrown
			add-expr-tokens out, t.expr
		if after = a.after
			add-expr-tokens out, after
	as assignment-ast
		add-expr-tokens out, a.left
		add-expr-tokens out, a.right
	as assignment-call-ast
		add-expr-tokens out, a.left
		out ~= function_, a.fun-name.range
		add-expr-tokens out, a.right
	as bogus-ast
		()
	as call-ast
		add-name void mut() = of
			out ~= function_, a.fun-name.range
			if t = a.type-arg
				add-type-tokens out, t
		prefix void mut() = of
			add-name[]
			add-exprs-tokens out, a.args
		name-in-middle void mut() = of
			add-expr-tokens out, a.args[0]
			add-name[]
			for arg in a.args[1 .. end]
				add-expr-tokens out, arg
		match a.style
		as dot
			name-in-middle[]
		as dot-question
			name-in-middle[]
		as infix
			name-in-middle[]
		as prefix
			prefix[]
		as prefix-operator
			add-name[]
			add-exprs-tokens out, a.args
		as single
			add-name[]
		as subscript
			add-exprs-tokens out, a.args
		as question-name
			# TODO: this should always do 'prefix[]', but that causes problems with infix files ... so just add the args for now ...........................................
			add-exprs-tokens out, a.args
		as question-subscript
			add-exprs-tokens out, a.args
	as call-named-ast
		for name, arg in zip a.names, a.args
			out ~= parameter, name.range
			add-expr-tokens out, arg
	as do-ast
		add-expr-tokens out, a.body
	as finally-ast
		add-expr-tokens out, a.right
		add-expr-tokens out, a.below
	as force-ast
		add-expr-tokens out, a.arg
	as for-or-with-ast
		add-param-destructure-tokens out, a.param
		add-expr-tokens out, a.arg
		add-expr-tokens out, a.body
	as name-and-range
		out ~= variable, a.range
	as if-ast
		add-expr-tokens out, a.condition
		if x = a.first-branch
			add-expr-tokens out, x
		if x = a.second-branch
			add-expr-tokens out, x
	as interpolated-ast
		for i, x in with-index a.template
			out ~= string, x.range
			if i != a.template.size - 1
				add-expr-tokens out, a.interpolated[i]
	as it-ast
		()
	as it-scope-ast
		add-expr-tokens out, a.inner
	as lambda-ast
		add-param-destructure-tokens out, a.param
		add-expr-tokens out, a.body
	as let-ast
		add-local-destructure-tokens out, a.destructure
		add-expr-tokens out, a.value
		if t = a.then_
			add-expr-tokens out, t
	as list-ast
		for part in a.parts
			add-expr-tokens out, part.arg
	as literal-number
		out ~= number, a.range
	as literal-string-ast
		out ~= string, a.range
	as logical-ast
		add-expr-tokens out, a.left
		add-expr-tokens out, a.right
	as loop-ast
		add-expr-tokens out, a.body
	as loop-break-ast
		if v = a.value
			add-expr-tokens out, v
	as loop-continue-ast
		()
	as loop-while-or-until-ast
		add-expr-tokens out, a.condition
		add-expr-tokens out, a.body
		if after = a.after
			add-expr-tokens out, after
	as match-ast
		if local = a.local
			out ~= variable, local.range
		add-expr-tokens out, a.matched
		for case_ in a.cases
			add-case-tokens out, case_
		if e = a.else_
			add-expr-tokens out, e.expr
	as not-ast
		add-expr-tokens out, a.arg
	as parenthesized-ast
		add-expr-tokens out, a.inner
	as seq-ast
		add-expr-tokens out, a.first
		add-expr-tokens out, a.then_
	as shared-ast
		add-expr-tokens out, a.inner
	as throw-ast
		add-expr-tokens out, a.thrown
	as trusted-ast
		add-expr-tokens out, a.inner
	as try-ast
		add-expr-tokens out, a.tried
		for case_ in a.catches
			add-catch-tokens out, case_
	as try-let-ast
		add-local-destructure-tokens out, a.destructure
		add-expr-tokens out, a.value
		add-catch-tokens out, a.catch_
		if after = a.after
			add-expr-tokens out, after
	as typed-ast
		if a.is-prefix
			add-type-tokens out, a.type
			if expr = a.expr
				add-expr-tokens out, expr
		else
			add-expr-tokens out, a.expr!
			add-type-tokens out, a.type
	as underscore-ast
		()
	as unpack-option-ast
		add-local-destructure-tokens out, a.destructure
		add-expr-tokens out, a.option

-add-catch-tokens void(out tokens-builder, a catch-ast)
	if n = a.name
		out ~= variable, n.range
	if x = a.as_
		out ~= type, x.type-name.range
	add-expr-tokens out, a.then_

-add-case-tokens void(out tokens-builder, a case-ast)
	add-case-member-tokens out, a.member
	add-expr-tokens out, a.then_

-add-case-member-tokens void(out tokens-builder, a case-member-ast)
	match a
	as as-name-ast
		out ~= enumMember, a.name.range
	as literal-number
		out ~= number, a.range
	as literal-string-ast
		out ~= string, a.range
	as as-bogus-ast
		()

-add-param-destructure-tokens void(out tokens-builder, a destructure-ast)
	add-destructure-tokens-inner out, a, parameter
-add-local-destructure-tokens void(out tokens-builder, a destructure-ast)
	add-destructure-tokens-inner out, a, variable

-add-destructure-tokens-inner void(out tokens-builder, a destructure-ast, kind token-type)
	match a
	as name-and-range
		out ~= kind, a.range
	as single-destructure-ast
		out ~= kind, a.name.range
		if t = a.type
			add-type-tokens out, t
	as ignore-destructure-ast
		out ~= comment, a.underscore-range
		if t = a.type
			add-type-tokens out, t
	as void-destructure-ast
		out ~= keyword, a.range
	as array
		for x in a
			add-destructure-tokens-inner out, x, kind

-add-exprs-tokens void(out tokens-builder, exprs expr-ast[])
	for expr in exprs
		add-expr-tokens out, expr

test
	# ensuring these count as used ------------------------------------------------------------------------------------------------------------------
	a semantic-tokens = (),
	_ token[] = (a,)::decode-semantic-tokens.to
	_ = show comment::token-type
