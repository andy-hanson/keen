import
	../../frontend/storage_
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/source-range

folding-ranges-of-ast folding-range-result(file crow-file-info)
	ctx ctx = file.content.line-and-character-getter, ()
	ctx add-ranges-for-regions file.ast.regions
	file.ast walk-ast-in-order ast =>
		match ast
		as imports-or-exports-ast x
			ctx add-ranges-for-imports x
		as spec-decl-ast x
			ctx add-ranges-for-spec x
		as struct-alias-ast x
			ctx add-ranges-for-struct-alias x
		as struct-decl-ast x
			ctx add-ranges-for-struct-decl x
		as fun-decl-ast x
			ctx add-ranges-for-fun-decl x
		as test-ast x
			ctx add-ranges-for-test x
		as var-decl-ast x
			ctx add-ranges-for-var-decl x
	ctx.out.move-to,

-ctx record mut
	line-and-character-getter line-and-character-getter
	out folding-range mut[]
-add-range void(ctx ctx, range source-range, kind folding-range-kind?)
	lines = ctx.line-and-character-getter[range]
	start = lines.start line
	end = lines.end line
	if start != end
		ctx.out ~= start.to, end.to, kind
-add-range-for-region void(ctx ctx, start-line nat, end-line nat)
	assert start-line <= end-line
	if start-line != end-line
		ctx.out ~= start-line, end-line, region_
-add-range-for-decl void(ctx ctx, range source-range)
	ctx add-range range, ()
-add-range-for-doc-comment void(ctx ctx, ast doc-comment-ast)
	if r ?= ast range
		ctx add-range r, comment

-add-ranges-for-regions void(ctx ctx, regions source-range[])
	prev-line mut nat? = ()
	for region_ in regions
		line nat = ctx.line-and-character-getter[region_].start.line to
		if x ?= prev-line
			ctx add-range-for-region x, line - 1
		prev-line := line
	if x ?= prev-line
		ctx add-range-for-region x, ctx.line-and-character-getter.last-line

-add-ranges-for-imports void(ctx ctx, a imports-or-exports-ast) # TODO:INLINE ------------------------------------------------------
	ctx add-range a.range, imports

-add-ranges-for-spec void(ctx ctx, a spec-decl-ast)
	ctx add-range-for-doc-comment a.doc-comment
	ctx add-range-for-decl a.range

-add-ranges-for-struct-alias void(ctx ctx, a struct-alias-ast)
	ctx add-range-for-doc-comment a.doc-comment
	ctx add-range-for-decl a.range

-add-ranges-for-struct-decl void(ctx ctx, a struct-decl-ast)
	ctx add-range-for-doc-comment a.doc-comment
	ctx add-range-for-decl a.range

-add-ranges-for-fun-decl void(ctx ctx, a fun-decl-ast)
	ctx add-range-for-doc-comment a.doc-comment
	ctx add-range-for-decl a.range

-add-ranges-for-test void(ctx ctx, a test-ast)
	ctx add-range-for-doc-comment a.doc-comment
	ctx add-range-for-decl a.range

-add-ranges-for-var-decl void(ctx ctx, a var-decl-ast)
	ctx add-range-for-doc-comment a.doc-comment
	ctx add-range-for-decl a.range
