import
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/source-range

folding-ranges-of-ast folding-range-result(file file-ast)
	the ctx = file.line-and-character-getter, ()
	add-ranges-for-regions file.regions
	for ast in ast-in-order file
		add-ranges-for-decl ast
	ranges: the::ctx.out.move-to

-ctx record mut
	line-and-character-getter line-and-character-getter
	out folding-range mut[]
-add-range void(range source-range, kind folding-range-kind?) ctx
	lines = the::ctx.line-and-character-getter[range]
	start = lines.start.line
	end = lines.end.line
	if start != end
		the::ctx.out ~= start.to, end.to, kind
-add-range-for-region void(start-line nat, end-line nat) ctx
	assert start-line <= end-line
	if start-line != end-line
		the::ctx.out ~= start-line, end-line, region_
-add-range-for-decl void(range source-range) ctx
	add-range range, ()
-add-range-for-doc-comment void(ast doc-comment-ast) ctx
	if r = ast.range
		add-range r, comment

-add-ranges-for-regions void(regions source-range[]) ctx
	prev-line mut nat? = ()
	for region_ in regions
		line nat = the::ctx.line-and-character-getter[region_].start.line.to
		if prev-line
			add-range-for-region prev-line!, line - 1
		prev-line := line
	if prev-line
		add-range-for-region prev-line!, the::ctx.line-and-character-getter.last-line

-add-ranges-for-decl void(a any-ast) ctx
	match a
	as imports-or-exports-ast
		add-range a.range, imports
	as spec-decl-ast
		add-range-for-doc-comment a.doc-comment
		add-range-for-decl a.range
	as struct-alias-ast
		add-range-for-doc-comment a.doc-comment
		add-range-for-decl a.range
	as struct-decl-ast
		add-range-for-doc-comment a.doc-comment
		add-range-for-decl a.range
	as fun-decl-ast
		add-range-for-doc-comment a.doc-comment
		add-range-for-decl a.range
	as test-ast
		add-range-for-doc-comment a.doc-comment
		add-range-for-decl a.range
	as var-decl-ast
		add-range-for-doc-comment a.doc-comment
		add-range-for-decl a.range
