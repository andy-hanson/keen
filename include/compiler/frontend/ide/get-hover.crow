import
	crow/string/util
	../../frontend/show-model
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/util
	./position

get-hover hover(ctx show-model-ctx, pos position)
	contents:
		kind: plaintext
		value: ctx get-hover pos

-get-hover string(ctx show-model-ctx, pos position)
	match x = pos kind
	as position-catch
		caught-type = x.catch_ caught-type
		catch-all = caught-type == ctx.common-types.exception
		exception-type string = if catch-all
			"all exceptions"
		else
			"exceptions of type {ctx show-type-quoted (caught-type, x.container)}"
		match d = x.catch_ destructure
		as destructure-ignore
			"Catches {exception-type} and ignores the exception value"
		as local
			"Catches {exception-type} exceptions and stores as {ctx show-name d.name}"
	as position-doc-ref
		ctx hover-for-doc-ref x
	as enum-or-flags-member
		e string = match x.containing-enum body # TODO: is there already some function that gets the keyword for a struct body?
		as enum_ then "Enum "
		as flags_ then "Flags "
		else then throw unreachable
		"{e} member {x.containing-enum name}.{x name}"
	as expression-position
		ctx expr-hover pos.module.uri, x
	as fun-decl
		ctx show-fun-decl unquoted, x
	as position-imported-module
		"Import module {ctx.show show-file x.module.uri}"
	as position-imported-name
		ctx imported-name-hover x
	as position-keyword
		match x
		as alias_
			"Declares a type alias."
		as builtin_
			"Declares a type implemented natively by Crow."
		as enum_
			"Declares an enumerated type. The type can only have the values listed."
		as extern_
			"Declares a type implemented by an external library."
		as flags_
			"Declares a type that can have any combination of flags (this would be an 'enum' in C)"
		as global_
			"Declares a mutable global variable (shared between all threads)."
		as interface_
			"An 'interface' is like a 'variant', but does not support 'match' or conversion to case types."
		as local-mut
			"Makes this variable mutable."
		as record_
			"Declares a type combining several named members."
		as spec_
			"Specifies function signatures to be provided by a function's caller."
		as thread-local_
			"Declares a mutable thread-local variable."
		as underscore
			"Ignores the value."
		as union_
			"A union can be one of several listed case types."
		as variant_
			"Declares a union-like type with an extensible set of case types, created by 'case' declarations on the types."
	as position-local
		"Local {ctx show-name x.local.name} of type {ctx show-type-quoted (x.local.type, x.container.to)}"
	as position-match-enum-case
		"Handler for enum {ctx show-name x.member.containing-enum.name} member {ctx show-name x.member.name}"
	as position-match-scalar-case
		value string = match t = x kind
		as char-type
			x.value.to::char32.to quoted
		as integral-type
			if t is-signed then "{x.value.to::int}" else "{x.value.to::nat}"
		"Handler for value {value} :: {x kind}"
	as position-match-string-like-case
		"Handler for value {x.value quoted} :: {ctx show-type-unquoted x.type}"
	as position-match-sum-type-case
		"Handler for type {ctx show-type-unquoted (x.member, x.container.to)}"
	as position-modifier
		match x modifier
		as builtin_
			"This function is implemented natively by Crow."
		as case_
			"Adds a case type to an interface or variant type.\n" ~~
			"The case type must implement the interface/variant type's methods, if any."
		as data_
			"The type is completely immutable."
		as force-data_
			"This type is be considered 'data' even though it has 'shared' or 'mut' content."
		as force-shared_
			"This type is be considered 'shared' even though it has 'mut' content."
		as mut_
			"This type is either directly mutable or references something mutable."
		as new-internal
			"The 'new' function is internal."
		as new-private
			"The 'new' function is private."
		as new-public
			"The 'new' function is public."
		as shared_
			"The type is mutable, but in a way that is safe to share between concurrent tasks."
		as storage_
			"Determines the type of number used to store the enum."
	as position-modifier-extern
		"Function comes from external library {ctx show-name x.library-name}."
	as position-module
		"Module {pos.module uri}"
	as record-field
		type = ctx show-type-unquoted (x.type, x.containing-record)
		"Record field {x.containing-record name}.{x name} :: {type}"
	as position-record-field-mutability
		visibility string = if v = x visibility
			"{ctx.show show-visibility v} "
		"Defines a {visibility}setter."
	as spec-decl
		ctx spec-decl-hover x
	as signature
		desc string = match container = x container
		as spec-decl
			"Spec {ctx show-name container.name} signature "
		as struct-decl
			"{container.body.sum-type!.kind show-sum-type-kind-upper-case} {ctx show-name container.name} method "
		"{desc} {ctx show-name x.name}"
	as position-spec-use
		"Spec {ctx show-spec-inst x.container, x.spec_}"
	as struct-alias
		ctx struct-alias-hover x
	as struct-decl
		ctx struct-decl-hover x
	as test_
		"Declares a unit test."
	as type-with-container
		match type = x type
		as bogus-type
			""
		as type-param-index
			ctx type-param-hover x.container.forbid-module, type
		as struct-inst
			ctx struct-decl-hover type.decl
	as type-param-with-container
		ctx type-param-hover x.container, x.type-param
	as var-decl
		type = ctx show-type-unquoted (x.type, x)
		"{x.kind string-of-var-kind-upper-case} variable {ctx show-name x.name} :: {type}"
	as position-visibility-mark
		"Marks {ctx show-name x.container.name} as {ctx show-visibility x.container.visibility}."

-hover-for-doc-ref string(ctx show-model-ctx, a position-doc-ref)
	match ref = a ref
	as doc-comment-reference-bogus
		""
	as called-spec-sig
		"References {ctx show-called-spec-sig quoted, a.container.type-container-for, ref}"
	as enum-or-flags-member
		e string = match ref.containing-enum body # TODO: is there already some function that gets the keyword for a struct body?
		as enum_ then "enum"
		as flags_ then "flags"
		else then throw unreachable
		"References {e} {ctx show-name ref.containing-enum.name} member {ctx show-name ref.name}."
	as fun-decl
		"References function {ctx show-fun-decl unquoted, ref}."
	as local
		"References parameter {ctx show-name ref.name}."
	as record-field
		"References record {ctx show-name ref.containing-record.name} field {ctx show-name ref.name}."
	as signature
		desc string = match ref container
		as spec-decl
			"spec signature"
		as struct-decl
			"method"
		"References {desc} {ctx show-name ref.name}."
	as struct-alias
		"References alias {ctx show-name ref.name}."
	as struct-decl
		"References type {ctx show-name ref.name}."
	as spec-decl
		"References spec {ctx show-name ref.name}."
	as type-param-index
		name = a.container.type-container-for.type-param-asts[ref index] name
		"References type parameter {ctx show-name name}"
	as var-decl
		"References {ref.kind string-of-var-kind-lower-case} {ctx show-name ref.name}."

-struct-alias-hover string(ctx show-model-ctx, a struct-alias)
	"Alias for {ctx show-type-quoted (a.target, a)}"

-struct-decl-hover string(ctx show-model-ctx, a struct-decl)
	desc string = match body = a body
	as struct-body-bogus
		"Type "
	as struct-body-extern-java
		"Java type "
	as builtin-type
		"Builtin type "
	as enum_
		"Enum type "
	as flags_
		"Flags type "
	as record_
		"Record type "
	as sum-type
		"{body.kind show-sum-type-kind-upper-case} type "
	"{desc}{ctx show-name a.name}"

-spec-decl-hover string(ctx show-model-ctx, a spec-decl)
	"Spec {ctx show-name a.name}"

-imported-name-hover string(ctx show-model-ctx, a position-imported-name)
	guard refs = a referents
	parts string[] =
		-- if s = refs struct-or-alias
			- match s
			as struct-alias
				ctx struct-alias-hover s
			as struct-decl
				ctx struct-decl-hover s
		-- if s = refs spec_
			- ctx spec-decl-hover s
		-- for x in refs funs
			ctx show-fun-decl unquoted, x
	"\n" join parts

-type-param-hover string(ctx show-model-ctx, type-container any-decl, index type-param-index)
	"Type parameter {ctx show-name type-container.type-param-asts[index index].name}"

-expr-keyword-hover string(keyword expr-keyword)
	match keyword
	as ampersand
		"Gets a pointer to an expression. " ~~
		"This does not allocate and so is unsafe. This only works for certain expressions."
	as colon-colon
		"Provides an expected type for the expression to its left."
	as elif_
		"If the first condition is false, evaluates another 'if'."
	as else-after-assert
		"If the condition is false, throws an exception with the message to the right of the ':'."
	as else-after-forbid
		"If the condition is false, throws an exception with the message to the right of the ':'."
	as else-after-if
		"If the condition is false, the 'else' branch is evaluated."
	as else-after-guard
		"If the condition is false, evaluates the expression to the right of the 'else'.\n" ~~
		"If the condition it is true, skips the 'else' clause and continues down."
	as else-after-match
		"If no branch was satisfied, the 'match' evaluates to the 'else' branch."
	as equals-expression
		"The expression to the right of '=' should be an option.\n" ~~
		"The expression to the left of '=' destructures the value inside the option if it is non-empty.\n" ~~
		"The '=' expression as a whole will be 'true' if the option was non-empty."
	as finally_
		"The expression below 'finally' runs first.\n" ~~
		"The expression to the right of 'finally' runs second, even if there was an exception.\n" ~~
		"The result is from the below expression; the right expression must be 'void'."
	as in-after-for
		"The expression to the right of 'in' is the first argument to 'for-loop'.\n" ~~
		"Typically, this is the collection to be iterated.\n" ~~
		"The destructuring to the left of 'in' is usually a collection element."
	as in-after-for-star
		"The expression to the right of 'in' is the first argument to 'for-star'.\n" ~~
		"Typically, this is the collection to be iterated.\n" ~~
		"The destructuring to the left of 'in' is usually a collection element."
	as in-after-with
		"The expression to the right of 'in' is the first argument to 'with-block'."
	as force
		"Unwraps an option. If it is empty, an error will be thrown."
	as question-before-name-or-subscript
		"The expression to the left of '?' is an option.\n" ~~
		"The call is only done if it is non-empty."
	as then-after-for-or-with
		"The expression to the right of 'then' is the implicit lambda's body (whose parameter is to the left of 'in')."
	as then-after-if-with-else
		"The expression between 'then' and 'else' will be evaluated if the expression between 'if' and 'then' is true."
	as then-after-if-without-else
		"The expression after 'then' will be evaluated if the expression between 'if' and 'then' is true."
	as then-after-of
		"The expression after 'then' is the body of the lambda starting at 'of'."
	as then-after-unless
		"The expression to the right of 'then' will be evaluated if the expression between 'unless' and 'then' is false."
	as throw_
		"Throws an exception."
	as trusted_
		"Allows 'unsafe' code to be used anywhere."

-expr-hover string(ctx show-model-ctx, cur-uri uri, a expression-position)
	type-container type-container = a.container to
	without-type string = match x = a kind
	as assert-or-forbid-expr
		match x condition
		as unpack-option
			if x is-forbid
				"Throws if the option is non-empty."
			else
				"Throws if the option is empty."
		else
			if x is-forbid
				"Throws if the condition is true."
			else
				"Throws if the condition is false."
	as bogus-call-expr
		if called = x.candidates opt-only
			"Calls {ctx show-called-decl quoted, type-container, called}."
		else
			"Calls a function named {ctx show-name x.candidates[0].name}"
	as call-expr
		"Calls {ctx show-called quoted, type-container, x.called}."
	as call-named-new-expr
		"Calls {ctx show-called quoted, type-container, x.called}."
	as call-option-expr
		"Calls {ctx show-called quoted, type-container, x.called} if the first argument is non-empty."
	as expr-keyword
		x expr-keyword-hover
	as extern-expr
		match x target
		as java
			"The expression will be 'true' in a Java build."
		as js
			"The expression will be 'true' in a JS build."
	as if-expr
		is-unpack-option = x.condition unpack-option
		guard_ string = if is-unpack-option
			"If the option is non-empty, destructures it and continues down."
		else
			"If the conndition is true, continues down."
		if_ string = if is-unpack-option
			"If the value is a non-empty option, destructures it and evaluates the first branch."
		else
			"If the condition is true, evaluates the first branch."
		match x.ast kind
		as guard-with-else
			"{guard_}\nOtherwise, evaluates the expression after 'else'."
		as guard-without-else
			"{guard_}\nOtherwise, the 'guard' evaluates to '()'."
		as if-elif
			"{if_}\nOtherwise, evaluates the 'elif' branch."
		as if-else
			"{if_}\nOtherwise, evaluates the 'else' branch."
		as if-then
			"{if_}\nOtherwise, the 'if' evaluates to '()'."
		as if-then-else
			"{if_}\nOtherwise, evaluates the 'else' branch."
		as if-without-else
			"{if_}\nOtherwise, the 'if' evaluates to '()'."
		as unless_
			"Evaluates the body if the condition is false. If the condition is true, the 'unless' evaluates to '()'."
		as unless-then
			"Evaluates the expression after 'then' if the condition is false. If the condition is true, the 'unless' evaluates to '()'."
	as expression-position-literal
		"Literal expression."
	as lambda-expr
		match ast = x ast
		as for-or-with-ast
			throw unreachable
		as it-scope-ast
			content string = ctx.show.file-content-getters[cur-uri, ast.range] to
			"'it' creates an implicit lambda in the entire expression '{content}'.\n" ~~
			"The type of 'it' is {ctx show-type-quoted (x.param.type, type-container)}."
		as lambda-ast
			match x kind
			as data_
				"Lambda with 'data' closure and no 'summon'."
			as shared_
				"Lambda with 'shared' closure."
			as mut_
				"Lambda with 'mut' closure."
			as explicit-shared
				"Lambda with 'mut' closure, converted to 'shared' by waiting for exclusion."
	as list-expr
		"Builds a list of arguments to pass to {ctx show-called quoted, type-container, x.called}."
	as local-ref
		desc string = match x kind
		as get
			"Gets local variable"
		as closure-get
			"Gets local variable"
		as set
			"Sets local variable"
		as closure-set
			"Sets local variable"
		as pointer
			"Gets pointer to local variable"
		closure string = match x kind
		as get
			""
		as set
			""
		as pointer
			""
		as closure-get
			" (through closure)"
		as closure-set
			" (through closure)"
		"{desc} {ctx show-name x.local.name}{closure}."
	as logical-expr
		match x kind
		as bool-and-bool
			"The 'and' expression is true if both the left and right sides are true."
		as bool-or-bool
			"The 'or' expression is true if either the left or right side is true."
		as option-else
			"The 'or' expression will be the left option's value if it is non-empty, else the right value."
		as option-or
			"The 'or' expression will be the left option if it is non-empty, else the right option."
	as loop-expr
		"Loop that terminates at a 'break'."
	as loop-break-expr
		"Breaks out of {ctx show-loop cur-uri, x.loop_}."
	as loop-continue-expr
		"Goes back to the start of {ctx show-loop cur-uri, x.loop_}."
	as loop-while-or-until-expr
		match x condition
		as unpack-option
			if x is-until
				"Loop will run as long as the option is empty.\n" ~~
				"Then it is destructured and available after the loop."
			else
				"Loop will run as long as the option is non-empty."
		else
			if x is-until
				"Loop will run as long as the condition is false."
			else
				"Loop will run as long as the condition is true."
	as match-enum-expr
		ctx match-hover type-container, "enum ", x.enum-type
	as match-scalar-expr
		ctx match-hover type-container, "", x.matched-type
	as match-string-like-expr
		ctx match-hover type-container, "", x.matched-type
	as match-sum-type-expr
		type-desc string = match x.sum-type-body kind
		as interface_
			"interface "
		as java-interface
			"Java interface "
		as union_
			"union "
		as variant_
			"variant "
		ctx match-hover type-container, type-desc, x.sum-type
	as try-expr
		caught string = if c = x.catches opt-only
			"a {ctx show-type-quoted (c.caught-type, type-container)}"
		else
			"an exception matching a 'catch' block"
		"Evaluates the 'try' block, but if it throws {caught}, evaluates the 'catch' block instead."
	as try-let-expr
		"Runs the initializer (between '=' and 'catch'). " ~~
		"If it succeeds, destructures it and continues down.\n" ~~
		"If it throws the handled exception, the 'try' evaluates to the expression after 'then'."

	if t = a type
		"{without-type}\nExpression type is: {ctx show-type-quoted (t, type-container)}"
	else
		without-type

-show-loop string(ctx show-model-ctx, cur-uri uri, loop_ loop-expr)
	"the loop at {ctx.line-and-column-getters[cur-uri][loop_.ast.start, start-of-range]}"

-match-hover string
	ctx show-model-ctx
	type-container type-container
	type-desc string
	matched-type struct-inst
do
	"Match on {type-desc}{ctx show-type-quoted (matched-type, type-container)}."
