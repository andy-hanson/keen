import
	../../model/ast
	../../model/model
	../../model/source-range
	../../model/uri
	../../util/util
	./get-target
	./position

get-definition-for-position uri-and-line-and-character-range[](program program, pos position)
	guard target ?= pos target-for-position
	with out in build
		pos.module.uri definition-for-target target, of x
			out ~= program.line-and-character-getters[x]

get-type-definition-for-position uri-and-line-and-character-range[](program program, pos position)
	guard target ?= pos target-for-position
	with out in build
		target type-definition-for-target of x
			out ~= program.line-and-character-getters[x]

reference-cb alias
	void mut(where uri-and-range)

definition-for-target void(cur-uri uri, a target, f reference-cb)
	match a
	as enum-or-flags-member
		f[a name-range]
	as fun-decl
		f[a name-range]
	as position-imported-name
		a definition-for-imported-name f
	as position-local
		f[a.container.module-uri, a.local.local-must-have-name-range]
	as loop-target
		f[cur-uri, a.loop_.ast.keyword-range]
	as crow-module
		f[a range]
	as record-field
		f[a name-range]
	as spec-decl
		f[a name-range]
	as signature
		f[a name-range]
	as struct-alias
		f[a name-range]
	as struct-decl
		f[a name-range]
	as type-param-with-container
		f[a type-param-with-container-range]
	as var-decl
		f[a name-range]

-type-param-with-container-range uri-and-range(a type-param-with-container)
	a.container.module-uri, a.container.type-param-asts[a.type-param index].range

-definition-for-imported-name void(a position-imported-name, f reference-cb)
	guard refs ?= a referents
	if x ?= refs struct-or-alias
		f[x range]
	if x ?= refs spec_
		f[x range]
	for x in refs funs
		f[x range]

-type-definition-for-target void(a target, f reference-cb)
	match a
	as enum-or-flags-member
		a.containing-enum definition-for-struct f
	as fun-decl
		a type-definition-for-fun-decl f
	as position-imported-name
		guard refs ?= a referents
		if s ?= refs struct-or-alias
			s type-definition-for-struct-or-alias f
		elif fun ?= refs.funs opt-only
			fun type-definition-for-fun-decl f
	as position-local
		a.container.to definition-for-type a.local.type, f
	as loop-target
		a.container.to definition-for-type a.loop_.type, f
	as crow-module
		()
	as record-field
		a.containing-record definition-for-type a.type, f
	as spec-decl
		()
	as signature
		a.container.to definition-for-type a.return-type, f
	as struct-alias
		a type-definition-for-struct-alias f
	as struct-decl
		a definition-for-struct f
	as type-param-with-container
		f[a type-param-with-container-range]
	as var-decl
		a definition-for-type a.type, f

-type-definition-for-struct-or-alias void(a struct-or-alias, f reference-cb)
	match a
	as struct-alias
		a type-definition-for-struct-alias f
	as struct-decl
		a definition-for-struct f

-type-definition-for-struct-alias void(a struct-alias, f reference-cb)
	a.target.decl definition-for-struct f

-definition-for-struct void(a struct-decl, f reference-cb)
	f[a name-range]

-type-definition-for-fun-decl void(a fun-decl, f reference-cb)
	a definition-for-type a.return-type, f

-definition-for-type void(container type-container, a type, f reference-cb)
	match a
	as bogus-type
		()
	as type-param-index
		f[(a, container.forbid-module) type-param-with-container-range]
	as struct-inst
		a.decl definition-for-struct f
