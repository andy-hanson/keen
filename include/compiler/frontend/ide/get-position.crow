import
	../../frontend/parse/lex-whitespace
	../../lib/lsp/lsp-types
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/sym
	../../util/util
	./position

get-position-kind enum
	| Expect cursor exactly on the thing. Used for requests like hover.
	exact
	| The cursor may be to the right of the thing; used for speculative requests such as completions.
	after
get-position position?(
	program program,
	where text-document-position-params,
	pos-kind get-position-kind,
)
	pos = program.line-and-character-getters[where]
	pos-adjusted = match pos-kind
	as exact
		pos
	as after
		program.file-content-getters[where.uri] walk-backwards-for-position pos
	ctx ctx = program.common-types,
	module = program module-at-uri where.uri
	if kind ?= ctx get-position-kind module, pos-adjusted, pos-kind
		(module, kind),

-has-pos bool(range source-range, pos pos)
	range.start <= pos && pos <= range.end
-opt-has-pos bool(range source-range?, pos pos)
	(range ?? ()) has-pos pos

-ctx record
	common-types common-types

-get-position-kind position-kind?(ctx ctx, module module, pos pos, pos-kind get-position-kind)
	# module.imports position-in-imports-or-exports pos || ---------------------------------------------------------------------------
	# module.re-exports position-in-imports-or-exports pos || -------------------------------------------------------------------------
	module.to position-in-doc-comment pos ||
	module.aliases first (x => x position-in-alias pos) ||
	module.structs first (x => x position-in-struct pos) ||
	module.vars first (x => x position-in-var pos) ||
	module.specs first (x => x position-in-spec pos) ||
	module.funs first (x => ctx position-in-fun x, pos, pos-kind) ||
	module.tests first (x => ctx position-in-test x, pos, pos-kind) ||
	(pos == 0 ? (position-module,))	# We need a definition at position 0, because inlay hints for "Used by" have that as their location.

-position-in-doc-comment position-kind?(a doc-comment-container, pos pos)
	if index ?= a.doc-comment.ast.references find-index x => x.range has-pos pos
		(a position-doc-ref a.doc-comment.references[index]),

-position-in-fun position-kind?(ctx ctx, a fun-decl, pos pos, pos-kind get-position-kind)
	guard ast ?= a.source fun-decl-ast
	a.to position-in-decl pos, () =>
		a.to position-in-visibility ast.visibility, pos ||
		(ast.name.range has-pos pos ? a.to,) ||
		a.to position-in-type-params ast.type-params, pos ||
		a.to position-in-type a.return-type, ast.return-type, pos ||
		a.to position-in-params a.params, ast.params, pos ||
		a.to position-in-modifiers (a.specs,), ast.modifiers, pos ||
		if expr ?= a.body expr
			ctx position-in-expr a.to, expr, pos, pos-kind

-position-in-test position-kind?(ctx ctx, a test_, pos pos, pos-kind get-position-kind)
	if a.ast.keyword-range has-pos pos
		a.to,
	else
		ctx position-in-expr a.to, a.body, pos, pos-kind

-position-in-params position-kind?(container local-container, params params, ast params-ast, pos pos)
	params.params-array zip ast.params-array first (x, y) =>
		container position-in-destructure x, y, pos

-position-in-modifiers position-kind?(
	container type-container,
	specs specs?,
	modifiers modifier-ast[],
	pos pos,
)
	if index ?= modifiers find-index modifier => modifier.range has-pos pos
		container position-in-modifier specs, modifiers, index, pos

-position-in-modifier position-kind?(
	container type-container,
	specs specs?,
	modifiers modifier-ast[],
	index nat,
	pos pos,
)
	match modifiers[index]
	as modifier-keyword-ast x
		if x.keyword == extern_
			if library-name ?= container as-extern-fun
				library-name.position-modifier-extern,
			else
				(container position-modifier x.keyword),
		else
			(container position-modifier x.keyword),
	as spec-use-ast ast
		guard s ?= specs
		guard s.inner.size == (modifiers count x => x.spec-use-ast !is-empty)
		# Find the corresponding spec
		spec-index = modifiers[0 .. index] count m => m.spec-use-ast !is-empty
		spec_ = s.inner[spec-index]
		if res ?= spec_.type-args find-in-packed-type-args ast.type-arg, (type, type-ast) => container position-in-type type, type-ast, pos
			res,
		elif ast.name-range has-pos pos
			(container position-spec-use spec_),
-as-extern-fun sym?(a type-container)
	if fun ?= a fun-decl
		if x ?= fun.body fun-body-extern
			x.library-name,

-position-in-destructure position-kind?(ctx expr-ctx, a destructure, ast destructure-ast, pos pos)
	ctx.container.to position-in-destructure a, ast, pos
-position-in-destructure position-kind?(
	container local-container,
	a destructure,
	destructure-ast destructure-ast,
	pos pos,
)
	handle-single position-kind? mut(type type, f position-kind mut()) = (type, f) =>
		ast = destructure-ast single-destructure-ast!
		if ast.range has-pos pos
			if ast.name-range has-pos pos
				f[],
			elif ast.mut-range opt-has-pos pos
				local-mut::position-keyword.to,
			elif t ?= ast type
				container.to position-in-type type, t, pos
	match a
	as destructure-ignore x
		unless _ ?= destructure-ast void-destructure-ast
			handle-single[x.type, () => underscore.to]
	as local x
		handle-single[x.type, () => container position-local x]
	as destructure-split x
		unless x.parts is-empty
			x.parts zip destructure-ast.array! first (part, part-ast) =>
				container position-in-destructure part, part-ast, pos

###
-position-in-imports-or-exports position-kind?(imports-or-exports import-or-export[], pos pos)
	guard im ?= imports-or-exports find im => !im.is-std && im.source!.range has-pos pos
	source = im source!
	match source kind
	as import-whole-module-ast
		im.position-imported-module,
	as array names
		if source.path-range has-pos pos
			im.position-imported-module,
		else
			im.module position-in-imported-names names, im.named-imported, pos
	as import-file-ast _
		throw unreachable
-position-in-imported-names position-kind?(
	module module,
	names name-and-range[],
	imported exports,
	pos pos,
)
	names first x =>
		if x.range has-pos pos
			(module position-imported-name x.name, imported[x name]),
###

-position-in-decl position-kind?(a any-decl, pos pos, f position-kind? mut())
	a.to position-in-doc-comment pos || if a.range.range has-pos pos
		f[]

-position-in-var position-kind?(a var-decl, pos pos)
	a.to position-in-decl pos, () =>
		a.to position-in-visibility a.ast.visibility, pos ||
		(a.name-range.range has-pos pos ? a.to,) ||
		(a.ast.keyword-range has-pos pos ? a.kind.to.to,) ||
		a.to position-in-type a.type, a.ast.type, pos
-to position-keyword(a var-kind)
	match a
	as global_
		global_
	as thread-local_
		thread-local_

-position-in-alias position-kind?(a struct-alias, pos pos)
	a.to position-in-decl pos, () =>
		a.to position-in-visibility a.ast.visibility, pos ||
		(a.name-range.range has-pos pos ? a.to,) ||
		(a.ast.keyword-range has-pos pos ? alias_.to,) ||
		a.to position-in-type a.target.to, a.ast.target, pos

-position-in-struct position-kind?(a struct-decl, pos pos)
	match a source
	as struct-decl-ast x
		a position-in-struct x, pos
	as struct-decl-source-bogus _
		()
-position-in-struct position-kind?(a struct-decl, ast struct-decl-ast, pos pos)
	a.to position-in-decl pos, () =>
		a.to position-in-visibility ast.visibility, pos ||
		(a.name-range.range has-pos pos ? a.to,) ||
		(ast.keyword-range has-pos pos ? ast.body.keyword-kind-for-struct-body.to,) ||
		a.to position-in-type-params ast.type-params, pos ||
		a.to position-in-modifiers (), ast.modifiers, pos ||
		a position-in-struct-body ast.body, pos
-keyword-kind-for-struct-body position-keyword(a struct-body-ast)
	match a
	as builtin-type-ast _
		builtin_
	as enum-ast _
		enum_
	as extern-type-ast _
		extern_
	as flags-ast _
		flags_
	as record-ast _
		record_
	as sum-type-ast x
		x.kind to
-to position-keyword(a sum-type-kind)
	match a
	as interface_
		interface_
	as union_
		union_
	as variant_
		variant_

-position-in-visibility position-kind?(a visibility-container, visibility visibility-and-range?, pos pos)
	if v ?= visibility
		if v.range has-pos pos
			a.position-visibility-mark,

-position-in-type-params position-kind?(container any-decl, asts name-and-range[], pos pos)
	if index ?= asts find-index x => x.range has-pos pos
		((index,) type-param-with-container container),

-position-in-spec position-kind?(a spec-decl, pos pos)
	a.to position-in-decl pos, () =>
		a.to position-in-visibility a.ast.visibility, pos ||
		(a.ast.name.range has-pos pos ? a.to,) ||
		a.to position-in-type-params a.ast.type-params, pos ||
		(a.ast.keyword-range has-pos pos ? spec_.to,) ||
		a.to position-in-modifiers (a.parents,), a.ast.modifiers, pos ||
		a.sigs position-in-signatures a.ast.sigs, pos

-position-in-signatures position-kind?(signatures signature[], signature-asts signature-ast[], pos pos)
	signatures zip signature-asts first (sig, sig-ast) =>
		sig position-in-signature sig-ast, pos

-position-in-signature position-kind?(sig signature, ast signature-ast, pos pos)
	sig.to position-in-doc-comment pos ||
	(ast.name-and-range.range has-pos pos ? sig.to,) ||
	sig.container.to position-in-type sig.return-type, ast.return-type, pos ||
	sig.container.to position-in-params sig.params.to, ast.params, pos

-position-in-struct-body position-kind?(decl struct-decl, ast struct-body-ast, pos pos)
	match decl body
	as struct-body-bogus _
		()
	as builtin-type _
		()
	as enum_ x
		x.members position-in-enum-or-flags-body ast.enum-ast!.params, ast.enum-ast!.members, pos
	as extern-type _
		()
	as flags_ x
		x.members position-in-enum-or-flags-body ast.flags-ast!.params, ast.flags-ast!.members, pos
	as record_ x
		decl position-in-record x.fields, ast.record-ast!, pos
	as sum-type x
		decl position-in-sum-type x, ast.sum-type-ast!, pos

-position-in-sum-type position-kind?(decl struct-decl, a sum-type, ast sum-type-ast, pos pos)
	in-members = ast.types first-zip-if-size-eq a.listed-members, (type-ast, x) =>
		decl.to position-in-type x.member.to, type-ast, pos
	in-members || a.methods position-in-signatures ast.methods, pos

-position-in-record position-kind?(
	decl struct-decl,
	fields record-field[],
	ast record-ast,
	pos pos,
)
	guard fields !is-empty
	if params ?= ast params
		fields zip params.array! first (field, param) =>
			decl position-in-record-field-parameter field, param.single-destructure-ast!, pos
	else
		fields zip ast.fields first (field, field-ast) =>
			decl position-in-record-field field, field-ast, pos

-position-in-record-field-parameter position-kind?(
	decl struct-decl,
	field record-field,
	param single-destructure-ast,
	pos pos,
)
	if param.name.range has-pos pos
		field.to,
	elif param.mut-range opt-has-pos pos
		field.mutability.position-record-field-mutability,
	elif t ?= param type
		decl.to position-in-type field.type, t, pos

-position-in-record-field position-kind?(
	decl struct-decl,
	field record-field,
	ast record-field-ast,
	pos pos,
)
	if res ?= field.to position-in-doc-comment pos
		res,
	elif res ?= field.to position-in-visibility ast.visibility, pos
		res,
	elif ast.name.range has-pos pos
		field.to,
	elif ast.mutability?.range opt-has-pos pos
		field.mutability.position-record-field-mutability,
	elif t ?= ast type
		decl.to position-in-type field.type, t, pos

-position-in-enum-or-flags-body position-kind?(
	members enum-or-flags-member[],
	params-ast params-ast?,
	member-asts enum-or-flags-member-ast[],
	pos pos,
)
	guard members !is-empty
	if params ?= params-ast
		members zip params.array! first (member, param) =>
			if param.range has-pos pos
				member.to,
	else
		members zip member-asts first (member, member-ast) =>
			member position-in-enum-or-flags-member member-ast, pos
-position-in-enum-or-flags-member position-kind?(member enum-or-flags-member, ast enum-or-flags-member-ast, pos pos)
	member.to position-in-doc-comment pos ||
	(ast.name-range has-pos pos ? member.to,)

-position-in-expr position-kind?(
	ctx ctx,
	container expr-container,
	a expr,
	pos pos,
	pos-kind get-position-kind,
)
	expr-ctx expr-ctx = ctx.common-types, container
	expr-ctx position-in-expr-recur a, pos, pos-kind
-expr-ctx record(common-types common-types, container expr-container)
-position-in-expr-recur position-kind?(ctx expr-ctx, a expr, pos pos, pos-kind get-position-kind)
	if a.range has-pos pos
		ctx position-at-expr a, pos, pos-kind || ctx position-in-expr-child a, pos, pos-kind
-position-in-expr-child position-kind?(ctx expr-ctx, a expr, pos pos, pos-kind get-position-kind)
	a find-direct-child-expr child =>
		ctx position-in-expr-recur child, pos, pos-kind
-position-at-expr position-kind?(ctx expr-ctx, a expr, pos pos, pos-kind get-position-kind)
	expression-position position-kind mut(x expression-position-kind) = x =>
		ctx.container expression-position ((a type ctx.common-types),), x
	keyword position-kind mut(k expr-keyword) = k =>
		expression-position[k to]
	keyword-at position-kind? mut(range source-range, k expr-keyword) = (range, k) =>
		if range has-pos pos
			keyword[k],
	local position-kind mut(kind local-ref-kind, local local) = (kind, local) =>
		expression-position[kind local-ref local]
	call position-kind? mut(ast call-expr-source, kind expression-position-kind) = (ast, kind) =>
		ok = match pos-kind
		as exact
			ast pos-is-at-call pos
		as after
			true
		if ok
			expression-position[kind],

	match a
	as assert-or-forbid-expr x
		if x.ast.keyword-range has-pos pos
			expression-position[x to],
		elif res ?= ctx position-at-condition x.condition, x.ast.condition, pos
			res,
		elif t ?= x.ast.thrown
			keyword-at[t.colon-range, x.is-forbid ? colon-after-forbid : colon-after-assert]
	as bogus-call-expr x
		call[x.ast, x.to]
	as bogus-expr _
		()
	as bogus-wrong-type-expr _
		()
	as call-expr x
		call[x.ast, x.to]
	as call-option-expr x
		keyword-at[x.ast.keyword-range!, question-dot-or-subscript] || if x.ast pos-is-at-call pos
			expression-position[x to],
	as closure-get-expr x
		local[closure-get, x.local],
	as closure-set-expr x
		if x.assignee-range has-pos pos
			local[closure-set, x.local],
	as extern-expr x
		expression-position[x to],
	as finally-expr x
		keyword-at[x.ast.finally-keyword-range, finally_]
	as if-expr x
		(x.ast.first-keyword-range has-pos pos ? expression-position[x to],) ||
		ctx position-at-condition x.condition, x.ast.condition, pos ||
		if sk ?= x.ast second-keyword-range
			keyword-at[sk, x.ast.kind.if-second-keyword]
	as lambda-expr x
		match x ast
		as for-ast ast
			# 'for' keyword is handled in 'as call-expr'
			(x !is-ignore ? ctx position-in-destructure x.param, ast.param, pos) ||
			keyword-at[ast.colon-range, colon-in-for]
		as lambda-ast ast
			if ast.arrow-range has-pos pos
				expression-position[x to],
			else
				ctx position-in-destructure x.param, ast.param, pos
		as with-ast ast
			# 'with' keyword is handled in 'as call-expr'
			(x !is-ignore ? ctx position-in-destructure x.param, ast.param, pos) ||
			keyword-at[ast.colon-range, colon-in-with]
	as let-expr x
		ctx position-in-destructure x.destructure, x.ast.destructure, pos
	as literal-float-expr _
		expression-position[expression-position-literal],
	as literal-integral-expr _
		expression-position[expression-position-literal],
	as literal-string-like-expr _
		expression-position[expression-position-literal],
	as local-get-expr x
		local[get, x.local],
	as local-set-expr x
		if x.assignee-range has-pos pos
			local[set, x.local],
	as loop-expr x
		if x.ast.keyword-range has-pos pos
			expression-position[x to],
	as loop-break-expr x
		if x.ast.keyword-range has-pos pos
			expression-position[x to],
	as loop-continue-expr x
		if x.ast.keyword-range has-pos pos
			expression-position[x to],
	as loop-while-or-until-expr x
		if x.ast.keyword-range has-pos pos
			expression-position[x to],
		else
			ctx position-at-condition x.condition, x.ast.condition, pos
	as match-enum-expr x
		ctx position-at-match-enum x, pos
	as match-integral-expr x
		ctx position-at-match-integral x, pos
	as match-string-like-expr x
		ctx position-at-match-string-like x, pos
	as match-sum-type-expr x
		ctx position-at-match-sum-type x, pos
	as seq-expr _
		()
	as throw-expr x
		keyword-at[x.ast.keyword-range, throw_]
	as trusted-expr x
		keyword-at[x.ast.keyword-range, trusted_]
	as try-expr x
		ctx position-at-try x, pos
	as try-let-expr x
		ctx position-at-try-let x, pos
	as typed-expr x
		keyword-at[x.ast.keyword-range, colon-colon] ||
		ctx.container.to position-in-type (a type ctx.common-types), x.ast.type, pos

-if-second-keyword expr-keyword(kind if-ast-kind)
	match kind
	as guard-with-colon
		colon-in-if
	as ternary-with-else
		colon-in-if
	as if-elif
		elif_
	as if-else
		else-after-if
	as guard-without-colon
		throw unreachable
	as if-without-else
		throw unreachable
	as ternary-without-else
		throw unreachable
	as unless_
		throw unreachable

-position-at-condition position-kind?(ctx expr-ctx, condition condition, ast condition-ast, pos pos)
	match condition
	as expr _
		()
	as unpack-option x
		unpack-ast = ast unpack-option-ast!
		ctx position-in-destructure x.destructure, unpack-ast.destructure, pos ||
		if unpack-ast.question-equals-range has-pos pos
			(ctx.container expression-position (), question-equals.to),

-pos-is-at-call bool(a call-expr-source, pos pos)
	a.range-for-pos-is-at-call has-pos pos
-pos-is-at-call bool(a call-ast, pos pos)
	a.range-for-pos-is-at-call has-pos pos
-range-for-pos-is-at-call source-range(a call-expr-source)
	match a
	as arrow-access-ast x
		x arrow-and-name-range
	as assignment-ast _
		() # TODO
	as assignment-call-ast _
		() # TODO
	as call-ast x
		x range-for-pos-is-at-call
	as call-named-ast _
		() # TODO
	as empty-ast _
		()
	as for-ast x
		# Handle the colon when handling the LambdaExpr
		x for-keyword-range
	as if-ast _
		()
	as interpolated-ast _
		# This is the call to `interpolate` or `show`, which we don't have a position for.
		()
	as loop-break-ast x
		x range
	as loop-continue-ast x
		x range
	as name-and-range x
		x range
	as with-ast x
		x with-keyword-range
-range-for-pos-is-at-call source-range(ast call-ast)
	has-name bool = match ast style
	as comma
		false
	as empty-parens
		false
	as subscript
		false
	as question-subscript
		false
	as augment
		true
	as dot
		true
	as infix
		true
	as prefix-bang
		true
	as prefix-operator
		true
	as question-dot
		true
	as single
		true
	as suffix-bang
		true
	if has-name
		ast.fun-name.range

-position-at-match-enum position-kind?(ctx expr-ctx, a match-enum-expr, pos pos)
	ctx position-at-match-keyword a.to, (a type (ctx.common-types,)), a.ast, pos ||
	a.cases first-zip-if-size-eq a.ast.cases, (case_, case-ast) =>
		if case-ast.keyword-and-member-name-range has-pos pos
			case_.member.position-match-enum-case,

-position-at-match-integral position-kind?(ctx expr-ctx, a match-integral-expr, pos pos)
	ctx position-at-match-keyword a.to, (a type (ctx.common-types,)), a.ast, pos ||
	a.cases first-zip-if-size-eq a.ast.cases, (case_, case-ast) =>
		if case-ast.keyword-and-member-name-range has-pos pos
			(a.integral-type position-match-integral-case case_.value),

-position-at-match-string-like position-kind?(ctx expr-ctx, a match-string-like-expr, pos pos)
	ctx position-at-match-keyword a.to, (a type (ctx.common-types,)), a.ast, pos ||
	a.cases first-zip-if-size-eq a.ast.cases, (case_, case-ast) =>
		if case-ast.keyword-and-member-name-range has-pos pos
			((a.matched-type.to, ctx.container.to) position-match-string-like-case case_.value),

-position-at-match-sum-type position-kind?(ctx expr-ctx, a match-sum-type-expr, pos pos)
	ctx position-at-match-keyword a.to, (a type (ctx.common-types,)), a.ast, pos ||
	ctx position-at-match-sum-type-cases a.cases, a.ast.cases, pos

-position-at-match-sum-type-cases position-kind?(
	ctx expr-ctx,
	cases match-sum-type-case[],
	case-asts case-ast[],
	pos pos,
)
	cases first-zip-if-size-eq case-asts, (case_, case-ast) =>
		ctx position-at-match-sum-type-case case_, case-ast, pos

-position-at-match-sum-type-case position-kind?(ctx expr-ctx, case_ match-sum-type-case, ast case-ast, pos pos)
	if ast.keyword-and-member-name-range has-pos pos
		(ctx.container position-match-sum-type-case case_.case-type),
	else
		ctx position-in-match-case-destructure case_.destructure, ast.member, pos

-position-in-match-case-destructure position-kind?(
	ctx expr-ctx,
	destructure destructure,
	ast case-member-ast,
	pos pos,
)
	if name ?= ast as-name-ast
		if d ?= name destructure
			ctx position-in-destructure destructure, d, pos

-position-at-match-keyword position-kind?(
	ctx expr-ctx,
	kind expression-position-kind,
	type type,
	ast match-ast,
	pos pos,
)
	if ast.keyword-range has-pos pos
		(ctx.container expression-position (type,), kind),
	elif e ?= ast else_
		if e.keyword-range has-pos pos
			(ctx.container expression-position (type,), else-after-match.to),

-position-at-try position-kind?(ctx expr-ctx, a try-expr, pos pos)
	if a.ast.try-keyword-range has-pos pos
		type = a type (ctx.common-types,)
		(ctx.container expression-position (type,), a.to),
	else
		ctx position-at-match-sum-type-cases a.catches, a.ast.catches, pos

-position-at-try-let position-kind?(ctx expr-ctx, a try-let-expr, pos pos)
	if a.ast.try-keyword-range has-pos pos
		(ctx.container expression-position (), a.to),
	elif res ?= ctx position-in-destructure a.destructure, a.ast.destructure, pos
		res,
	elif a.ast.catch-keyword-range combine-ranges a.ast.catch-member.name-range has-pos pos
		(ctx.container position-match-sum-type-case a.catch_.case-type),
	else
		ctx position-in-match-case-destructure a.catch_.destructure, a.ast.catch-member, pos

-position-in-type position-kind?(container type-container, type type, ast type-ast, pos pos)
	if ast.range has-pos pos
		res = type each-type-component ast, (t, a) =>
			container position-in-type t, a, pos
		res || container position-in-type-not-args type, ast, pos
-position-in-type-not-args position-kind?(container type-container, type type, ast type-ast, pos pos)
	ok bool = match ast
	as bogus-type-ast _
		false
	as fun-type-ast x
		x.kind-range has-pos pos
	as map-type-ast _
		false
	as name-and-range _
		true
	as suffix-name-type-ast x
		x.name.range has-pos pos
	as suffix-special-type-ast x
		x.suffix-range has-pos pos
	as tuple-type-ast _
		false
	if ok
		(type type-with-container container),

-each-type-component[out] out?(type type, ast type-ast, f out? mut(x type, ast type-ast))
	match type
	as bogus-type _
		()
	as type-param-index _
		()
	as struct-inst x
		x.type-args find-in-type-args ast, f

-find-in-packed-type-args[out] out?(
	type-args type-args,
	ast type-ast?,
	f out? mut(x type, ast type-ast),
)
	if x ?= ast
		type-args zip-each-type-arg-may-unpack-tuple x, f
	else
		assert type-args is-empty
		()

-find-in-type-args[out] out?(type-args type-args, ast type-ast, f out? mut(x type, ast type-ast))
	match ast
	as bogus-type-ast _
		()
	as fun-type-ast x
		return-type, param-type = type-args only2
		f[return-type, x.return-type] || (param-type each-fun-type-parameter x.params, f)
	as map-type-ast x
		type-args zip-each-type-arg (x.key, x.value), f
	as name-and-range _
		# For a type alias, 'typeArgs' may be non-empty as it comes from the alias' target type.
		# But ignore them in any case.
		()
	as suffix-name-type-ast x
		type-args zip-each-type-arg-may-unpack-tuple x.left, f
	as suffix-special-type-ast x
		type-args zip-each-type-arg-may-unpack-tuple x.left, f
	as tuple-type-ast x
		type-args zip-each-type-arg x.members, f

-zip-each-type-arg-may-unpack-tuple[out] out?(
	type-args type-args,
	type-arg-ast type-ast,
	f out? mut(x type, ast type-ast),
)
	type-arg-asts type-ast[] = if type-args.size == 1
		type-arg-ast,
	else
		type-arg-ast.tuple-type-ast! members
	type-args zip-each-type-arg type-arg-asts, f

-zip-each-type-arg[out] out?(
	type-args type-args,
	type-arg-asts type-ast[],
	f out? mut(x type, ast type-ast),
) # TODO: this is a one-liner now, so just inline? -------------------------------------------------------------------------------
	type-args.inner zip type-arg-asts first f

-each-fun-type-parameter[out] out?( # TODO: rename to each-type-in-fun-parameters ---------------------------------------------------
	params-type type,
	params-ast params-ast,
	f out? mut(x type, ast type-ast),
)
	match params-ast
	as array params
		if params.size == 1
			params-type each-type-in-destructure params.only, f
		else
			params-type each-type-in-destructure-parts params, f
	as varargs-ast _
		() # TODO

-each-type-in-destructure-parts[out] out?(
	type type,
	parts destructure-ast[],
	f out? mut(x type, ast type-ast),
)
	unless type is-bogus
		for type-arg, param : type.struct-inst!.type-args.inner zip parts
			if res ?= type-arg each-type-in-destructure param, f
				break res

-each-type-in-destructure[out] out?(
	type type,
	ast destructure-ast,
	f out? mut(x type, ast type-ast),
)
	match ast
	as single-destructure-ast x
		if t ?= x type
			f[type, t]
	as void-destructure-ast _
		()
	as array parts
		type each-type-in-destructure-parts parts, f
