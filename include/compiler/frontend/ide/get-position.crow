import
	../../frontend/parse/lex-token
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/util
	./position

get-position-kind enum
	| Expect cursor exactly on the thing. Used for requests like hover.
	exact
	| The cursor may be to the right of the thing; used for speculative requests such as completions.
	after
get-position position?(program program, where uri-line-and-character, pos-kind get-position-kind)
	pos = program.line-and-character-getters[where]
	pos-adjusted = match pos-kind
	as exact
		pos
	as after
		walk-backwards-for-position program.file-content-getters[where.uri], pos
	ctx ctx = program.available-types,
	module = module-at-uri program, where.uri
	if kind = get-position-kind ctx, module, pos-adjusted, pos-kind
		module, kind

-has-pos bool(range source-range, pos pos)
	range.start <= pos and pos <= range.end
-opt-has-pos bool(range source-range?, pos pos)
	range and has-pos range, pos

-ctx record
	available-types available-types

-get-position-kind position-kind?(ctx ctx, module crow-module, pos pos, pos-kind get-position-kind)
	# module.imports position-in-imports-or-exports pos or ---------------------------------------------------------------------------
	# module.re-exports position-in-imports-or-exports pos or -------------------------------------------------------------------------
	position-in-doc-comment module, pos or
	first module.aliases, (of x then position-in-alias x, pos) or
	first module.structs, (of x then position-in-struct x, pos) or
	first module.vars, (of x then position-in-var x, pos) or
	first module.specs, (of x then position-in-spec x, pos) or
	first module.funs, (of x then position-in-fun ctx, x, pos, pos-kind) or
	first module.tests, (of x then position-in-test ctx, x, pos, pos-kind) or
	if pos == 0 then position-module # We need a definition at position 0, because inlay hints for "Used by" have that as their location.

-position-in-doc-comment position-kind?(a doc-comment-container, pos pos)
	if index = find-index a.doc-comment.ast.references, of x then has-pos x.range, pos
		position-doc-ref a, a.doc-comment.references[index]

-position-in-fun position-kind?(ctx ctx, a fun-decl, pos pos, pos-kind get-position-kind)
	guard ast = a.source.fun-decl-ast
	position-in-decl a, pos, of
		position-in-visibility a, ast.visibility, pos or
		(if has-pos ast.name.range, pos then a) or
		position-in-type-params a, ast.type-params, pos or
		position-in-type a, a.return-type, ast.return-type, pos or
		position-in-params a, a.params, ast.params, pos or
		position-in-modifiers a, a.specs, ast.modifiers, pos or
		if expr = a.body.expr
			position-in-expr ctx, a, expr, pos, pos-kind

-position-in-test position-kind?(ctx ctx, a test_, pos pos, pos-kind get-position-kind)
	if has-pos a.ast.keyword-range, pos
		a
	else
		position-in-expr ctx, a, a.body.expr, pos, pos-kind

-position-in-params position-kind?(container local-container, params destructure[], asts destructure-ast[], pos pos)
	first (zip params, asts), of x, y
		position-in-destructure container, x, y, pos

-position-in-modifiers position-kind?
	container type-container
	specs specs?
	modifiers modifier-ast[]
	pos pos
do
	if index = find-index modifiers, of x then has-pos x.range, pos
		position-in-modifier container, specs, modifiers, index, pos

-position-in-modifier position-kind?
	container type-container
	specs specs?
	modifiers modifier-ast[]
	index nat
	pos pos
do
	match ast = modifiers[index]
	as modifier-keyword-ast
		position-modifier container, ast.keyword
	as spec-use-ast
		guard specs and specs.inner.size == (count modifiers, !!it.spec-use-ast)
		# Find the corresponding spec
		spec-index = count modifiers[0 .. index], !!it.spec-use-ast
		spec_ = specs.inner[spec-index]
		if res = find-in-packed-type-args spec_.type-args, ast.type-arg, of type, type-ast then position-in-type container, type, type-ast, pos
			res
		elif has-pos ast.name-range, pos
			position-spec-use container, spec_

-position-in-opt-local position-kind?(ctx expr-ctx, local local?, ast match-ast, pos pos)
	if local and has-pos ast.local!.range, pos
		position-local ctx.container.to, local

-position-in-destructure position-kind?(ctx expr-ctx, a destructure, ast destructure-ast, pos pos)
	position-in-destructure ctx.container.to, a, ast, pos
-position-in-destructure position-kind?
	container local-container
	a destructure
	destructure-ast destructure-ast
	pos pos
do
	match a
	as destructure-ignore
		match ast = a.source
		as catch-ast
			()
		as struct-decl
			()
		as ignore-destructure-ast
			if has-pos ast.underscore-range, pos
				underscore::position-keyword
			elif t = ast.type
				position-in-type container.to, a.type, t, pos
		as void-destructure-ast
			()
	as local
		match destructure-ast
		as name-and-range
			if has-pos destructure-ast.range, pos
				position-local container, a
		as single-destructure-ast
			if has-pos destructure-ast.name-range, pos
				position-local container, a
			elif opt-has-pos destructure-ast.mut-range, pos
				local-mut::position-keyword
			elif t = destructure-ast.type
				position-in-type container.to, a.type, t, pos
		else
			throw unreachable
	as destructure-split
		first (zip a.parts, destructure-ast.array!), of part, part-ast
			position-in-destructure container, part, part-ast, pos

###
-position-in-imports-or-exports position-kind?(imports-or-exports import-or-export[], pos pos) --------------------------------------
	guard im = imports-or-exports find of im then !im.is-std and im.source!.range has-pos pos
	source = im source!
	match ast = source kind
	as import-whole-module-ast
		im.position-imported-module,
	as array
		if source.path-range has-pos pos
			im.position-imported-module,
		else
			im.module position-in-imported-names ast, im.named-imported, pos
	as import-file-ast
		throw unreachable
-position-in-imported-names position-kind?
	module module,
	names name-and-range[],
	imported exports,
	pos pos,
do
	names first of x
		if x.range has-pos pos
			(module position-imported-name x.name, imported[x name]),
###

-position-in-decl position-kind?(a any-decl, pos pos, f position-kind? mut())
	position-in-doc-comment a, pos or if has-pos a.range.range, pos
		f[]

-position-in-var position-kind?(a var-decl, pos pos)
	position-in-decl a, pos, of
		position-in-visibility a, a.ast.visibility, pos or
		(if has-pos a.name-range.range, pos then a) or
		(if has-pos a.ast.keyword-range, pos then a.kind.to) or
		position-in-type a, a.type, a.ast.type, pos
-to position-keyword(a var-kind)
	match a
	as global_
		global_
	as thread-local_
		thread-local_

-position-in-alias position-kind?(a struct-alias, pos pos)
	position-in-decl a, pos, of
		position-in-visibility a, a.ast.visibility, pos or
		(if has-pos a.name-range.range, pos then a) or
		(if has-pos a.ast.keyword-range, pos then alias_) or
		position-in-type a, a.target, a.ast.target, pos

-position-in-struct position-kind?(a struct-decl, pos pos)
	match ast = a.source
	as struct-decl-ast
		position-in-struct a, ast, pos
	as struct-decl-source-bogus
		()
	as struct-decl-source-java
		throw unreachable
-position-in-struct position-kind?(a struct-decl, ast struct-decl-ast, pos pos)
	position-in-decl a, pos, of
		position-in-visibility a, ast.visibility, pos or
		(if has-pos a.name-range.range, pos then a) or
		(if has-pos ast.keyword-range, pos then keyword-kind-for-struct-body ast.body) or
		position-in-type-params a, ast.type-params, pos or
		position-in-modifiers a, (), ast.modifiers, pos or
		position-in-struct-body a, ast.body, pos
-keyword-kind-for-struct-body position-keyword(a struct-body-ast)
	match a
	as builtin-type-ast
		builtin_
	as enum-ast
		enum_
	as flags-ast
		flags_
	as record-ast
		record_
	as sum-type-ast
		a.kind.to
-to position-keyword(a sum-type-kind)
	match a
	as interface_
		interface_
	as java-interface
		throw unreachable
	as union_
		union_
	as variant_
		variant_

-position-in-visibility position-kind?(a visibility-container, visibility visibility-and-range?, pos pos)
	if visibility and has-pos visibility.range, pos
		position-visibility-mark a

-position-in-type-params position-kind?(container any-decl, asts name-and-range[], pos pos)
	if index = find-index asts, of x then has-pos x.range, pos
		type-param-with-container (index,), container

-position-in-spec position-kind?(a spec-decl, pos pos)
	position-in-decl a, pos, of
		position-in-visibility a, a.ast.visibility, pos or
		(if has-pos a.ast.name.range, pos then a) or
		position-in-type-params a, a.ast.type-params, pos or
		(if has-pos a.ast.keyword-range, pos then spec_) or
		position-in-modifiers a, a.parents, a.ast.modifiers, pos or
		position-in-signatures a.sigs, a.ast.sigs, pos

-position-in-signatures position-kind?(signatures signature[], signature-asts signature-ast[], pos pos)
	first (zip signatures, signature-asts), of sig, sig-ast
		position-in-signature sig, sig-ast, pos

-position-in-signature position-kind?(sig signature, ast signature-ast, pos pos)
	position-in-doc-comment sig, pos or
	(if has-pos ast.name-and-range.range, pos then sig) or
	position-in-type sig.container.to, sig.return-type, ast.return-type, pos or
	position-in-params sig.container.to, sig.params, ast.params, pos

-position-in-struct-body position-kind?(decl struct-decl, ast struct-body-ast, pos pos)
	match body = decl.body
	as struct-body-bogus
		()
	as struct-body-extern-java
		throw unreachable
	as builtin-type
		()
	as enum_
		position-in-enum-or-flags-body body.members, ast.enum-ast!.params, ast.enum-ast!.members, pos
	as flags_
		position-in-enum-or-flags-body body.members, ast.flags-ast!.params, ast.flags-ast!.members, pos
	as record_
		position-in-record decl, body.fields, ast.record-ast!, pos
	as sum-type
		position-in-sum-type decl, body, ast.sum-type-ast!, pos

-position-in-sum-type position-kind?(decl struct-decl, a sum-type, ast sum-type-ast, pos pos)
	in-members = first-zip-if-size-eq ast.types, a.listed-members, of type-ast, x
		position-in-type decl, x.member, type-ast, pos
	in-members or position-in-signatures a.methods, ast.methods, pos

-position-in-record position-kind?
	decl struct-decl
	fields record-field[]
	ast record-ast
	pos pos
do
	guard !is-empty fields
	if params = ast.params
		first (zip fields, params), of field, param
			position-in-record-field-parameter decl, field, param.single-destructure-ast!, pos
	else
		first (zip fields, ast.fields), of field, field-ast
			position-in-record-field decl, field, field-ast, pos

-position-in-record-field-parameter position-kind?
	decl struct-decl
	field record-field
	param single-destructure-ast
	pos pos
do
	if has-pos param.name.range, pos
		field
	elif opt-has-pos param.mut-range, pos
		position-record-field-mutability field.mutability
	elif t = param.type
		position-in-type decl, field.type, t, pos

-position-in-record-field position-kind?
	decl struct-decl
	field record-field
	ast record-field-ast
	pos pos
do
	if res = position-in-doc-comment field, pos
		res
	elif res = position-in-visibility field, ast.visibility, pos
		res
	elif has-pos ast.name.range, pos
		field
	elif opt-has-pos ast.mutability.?range, pos
		position-record-field-mutability field.mutability
	elif t = ast.type
		position-in-type decl, field.type, t, pos

-position-in-enum-or-flags-body position-kind?
	members enum-or-flags-member[]
	param-asts destructure-ast[]?
	member-asts enum-or-flags-member-ast[]
	pos pos
do
	guard !is-empty members
	if param-asts
		first (zip members, param-asts), of member, param
			if has-pos param.range, pos then member
	else
		first (zip members, member-asts), of member, member-ast
			position-in-enum-or-flags-member member, member-ast, pos
-position-in-enum-or-flags-member position-kind?(member enum-or-flags-member, ast enum-or-flags-member-ast, pos pos)
	position-in-doc-comment member, pos or if has-pos ast.name-range, pos then member

-position-in-expr position-kind?
	ctx ctx
	container expr-container
	a expr
	pos pos
	pos-kind get-position-kind
do
	position-in-expr-recur (ctx.available-types, container), a, pos, pos-kind
-expr-ctx record(available-types available-types, container expr-container)
-position-in-expr-recur position-kind?(ctx expr-ctx, a expr, pos pos, pos-kind get-position-kind)
	if has-pos a.range, pos
		position-at-expr ctx, a, pos, pos-kind or position-in-expr-child ctx, a, pos, pos-kind
-position-in-expr-child position-kind?(ctx expr-ctx, a expr, pos pos, pos-kind get-position-kind)
	find-direct-child-expr a, of child
		position-in-expr-recur ctx, child, pos, pos-kind
-position-at-expr position-kind?(ctx expr-ctx, a expr, pos pos, pos-kind get-position-kind)
	expression-position position-kind mut(x expression-position-kind) = of x
		expression-position ctx.container, (type a, ctx.available-types), x
	keyword position-kind mut(k expr-keyword) = expression-position[it]
	keyword-at position-kind? mut(range source-range, k expr-keyword) = of range, k
		if has-pos range, pos then keyword[k]
	local position-kind mut(kind local-ref-kind, local local) = of kind, local
		expression-position[local-ref kind, local]
	call position-kind? mut(ast call-expr-source, kind expression-position-kind) = of ast, kind
		ok = match pos-kind
		as exact
			pos-is-at-call ast, pos
		as after
			true
		if ok
			expression-position[kind]

	match a
	as assert-or-forbid-expr
		if has-pos a.ast.keyword-range, pos
			expression-position[a]
		elif t = a.ast.thrown
			keyword-at[t.else-range, if a.is-forbid then else-after-forbid else else-after-assert]
	as bogus-call-expr
		call[a.ast, a]
	as bogus-expr
		()
	as bogus-wrong-type-expr
		()
	as call-expr
		call[a.ast, a]
	as call-named-new-expr
		call[a.ast, a]
	as call-option-expr
		keyword-at[a.ast.question-range!, question-before-name-or-subscript] or
		if pos-is-at-call a.ast.to, pos then expression-position[a]
	as finally-expr
		keyword-at[a.ast.finally-keyword-range, finally_]
	as force-expr
		keyword-at[a.ast.keyword-range, force]
	as if-expr
		(if has-pos a.ast.first-keyword-range, pos then expression-position[a]) or
		(if k = a.ast.second-keyword-range then keyword-at[k, a.ast.kind.if-second-keyword]) or
		(if k = a.ast.third-keyword-range then keyword-at[k, else-after-if])
	as lambda-expr
		match ast = a.ast
		as for-or-with-ast
			# 'for' keyword is handled in 'as call-expr'
			(unless a.is-ignore then position-in-destructure ctx, a.param, ast.param, pos) or
			keyword-at[ast.in-range, ast.keyword.for-or-with-in-kind] or
			if t = ast.then-range then keyword-at[t, then-after-for-or-with]
		as it-scope-ast
			first ast.its, of it_
				if has-pos it_.range, pos then expression-position[a]
		as lambda-ast
			(if has-pos ast.keyword-range, pos then expression-position[a]) or
			(if t = ast.then-range then keyword-at[t, then-after-of]) or
			position-in-destructure ctx, a.param, ast.param, pos
	as let-expr
		position-in-destructure ctx, a.destructure, a.destructure-ast, pos
	as list-expr
		# TODO: if the position is at a '-' or '--', then return expression-position[x] -----------------------------------------
		()
	as literal-scalar-expr
		expression-position[expression-position-literal]
	as literal-string-like-expr
		expression-position[expression-position-literal]
	as local-get-expr
		local[get, a.local]
	as local-get-and-refine-expr
		local[get, a.local]
	as local-set-expr
		if has-pos a.assignee-ast.range, pos
			local[set, a.local]
	as logical-expr
		if has-pos a.keyword-range, pos
			expression-position[a]
	as loop-expr
		if has-pos a.ast.keyword-range, pos
			expression-position[a]
	as loop-break-expr
		if has-pos a.ast.keyword-range, pos
			expression-position[a]
	as loop-continue-expr
		if has-pos a.ast.keyword-range, pos
			expression-position[a]
	as loop-while-or-until-expr
		if has-pos a.ast.keyword-range, pos
			expression-position[a]
	as match-enum-expr
		position-at-match-enum ctx, a, pos
	as match-scalar-expr
		position-at-match-scalar ctx, a, pos
	as match-string-like-expr
		position-at-match-string-like ctx, a, pos
	as match-sum-type-expr
		position-at-match-sum-type ctx, a, pos
	as not-expr
		if has-pos a.keyword-range, pos
			expression-position[a]
	as seq-expr
		()
	as throw-expr
		keyword-at[a.ast.keyword-range, throw_]
	as trusted-expr
		keyword-at[a.ast.keyword-range, trusted_]
	as try-expr
		position-at-try ctx, a, pos
	as try-let-expr
		position-at-try-let ctx, a, pos
	as typed-expr
		keyword-at[a.ast.keyword-range, colon-colon] or
		position-in-type ctx.container.to, (type a, ctx.available-types), a.ast.type, pos
	as unpack-option
		position-at-unpack-option ctx, a, pos

-for-or-with-in-kind expr-keyword(a for-or-with-ast-keyword)
	match a
	as for_
		in-after-for
	as for-star
		in-after-for-star
	as with_
		in-after-with

-if-second-keyword expr-keyword(kind if-ast-kind)
	match kind
	as do-if
		throw unreachable
	as do-if-else
		else-after-guard
	as guard-with-else
		else-after-guard
	as guard-without-else
		throw unreachable
	as if-elif
		elif_
	as if-else
		else-after-if
	as if-then
		then-after-if-without-else
	as if-then-else
		then-after-if-with-else
	as if-without-else
		throw unreachable

-position-at-unpack-option position-kind?(ctx expr-ctx, a unpack-option, pos pos)
	position-in-destructure ctx, a.destructure, a.ast.destructure, pos or
	if has-pos a.ast.keyword-range, pos
		expression-position ctx.container, (), equals-expression

-pos-is-at-call bool(a call-expr-source, pos pos)
	has-pos a.range-for-pos-is-at-call, pos
-range-for-pos-is-at-call source-range(a call-expr-source)
	match a
	as assignment-ast
		() # TODO
	as assignment-call-ast
		() # TODO
	as call-ast
		range-for-pos-is-at-call a
	as call-named-ast
		() # TODO
	as call-subscript-ast
		() # TODO
	as for-or-with-ast
		a.keyword-range
	as if-ast
		()
	as interpolated-ast
		()
	as interpolated-template-part
		()
	as list-ast
		()
	as literal-string-ast
		()
	as logical-ast
		()
	as loop-break-ast
		a.range
	as loop-continue-ast
		a.range
	as name-and-range
		a.range
	as var-decl-ast
		()
	as typed-ast
		()
-range-for-pos-is-at-call source-range(ast call-ast)
	has-name bool = match ast.style
	as dot
		true
	as dot-question
		true
	as infix
		true
	as prefix
		true
	as question-name
		true
	if has-name
		ast.fun-name.range

-position-at-match-enum position-kind?(ctx expr-ctx, a match-enum-expr, pos pos)
	position-at-match-keyword ctx, a, a.type, a.ast, pos or
	position-in-opt-local ctx, a.matched-local, a.ast, pos or
	position-at-match-cases a.cases, a.ast, pos, it.member.position-match-enum-case

-position-at-match-scalar position-kind?(ctx expr-ctx, a match-scalar-expr, pos pos)
	position-at-match-keyword ctx, a, a.type, a.ast, pos or
	position-in-opt-local ctx, a.matched-local, a.ast, pos or
	position-at-match-cases a.cases, a.ast, pos, of x
		position-match-scalar-case a.integral-type, x.value

-position-at-match-string-like position-kind?(ctx expr-ctx, a match-string-like-expr, pos pos)
	position-at-match-keyword ctx, a, a.type, a.ast, pos or
	position-in-opt-local ctx, a.matched-local, a.ast, pos or
	position-at-match-cases a.cases, a.ast, pos, of x
		position-match-string-like-case (a.matched-type, ctx.container.to), x.value

-position-at-match-cases[t] position-kind?(cases t[], ast match-ast,pos pos, get-position position-kind data(case_ t))
	first-zip-if-size-eq cases, ast.cases, of case_, case-ast
		if has-pos case-ast.keyword-and-member-name-range, pos
			get-position[case_]

-position-at-match-sum-type position-kind?(ctx expr-ctx, a match-sum-type-expr, pos pos)
	position-at-match-keyword ctx, a, a.type, a.ast, pos or
	position-in-opt-local ctx, a.matched-local, a.ast, pos or
	position-at-match-sum-type-cases ctx, a.cases, a.ast.cases, pos

-position-at-match-sum-type-cases position-kind?
	ctx expr-ctx
	cases match-sum-type-case[]
	case-asts case-ast[]
	pos pos
do
	first-zip-if-size-eq cases, case-asts, of case_, case-ast
		position-at-match-sum-type-case ctx, case_, case-ast, pos

-position-at-catches position-kind?
	ctx expr-ctx
	catches catch_[]
	catch-asts catch-ast[]
	pos pos
do
	first-zip-if-size-eq catches, catch-asts, of catch_, catch-ast
		position-at-catch ctx, catch_, catch-ast, pos

-position-at-match-sum-type-case position-kind?(ctx expr-ctx, case_ match-sum-type-case, ast case-ast, pos pos)
	if has-pos ast.keyword-and-member-name-range, pos
		position-match-sum-type-case ctx.container, case_.case-type

-position-at-catch position-kind?(ctx expr-ctx, catch_ catch_, ast catch-ast, pos pos)
	if has-pos ast.keyword-range, pos
		position-catch ctx.container.to, catch_
	elif x = ast.name and has-pos x.range, pos
		position-local ctx.container.to, catch_.destructure.local!
	elif x = ast.as_ and has-pos x.keyword-range, pos
		position-catch ctx.container.to, catch_
	elif x = ast.as_ and has-pos x.type-name.range, pos
		position-in-type ctx.container.to, catch_.caught-type, x.type-name, pos

-position-at-match-keyword position-kind?
	ctx expr-ctx
	kind expression-position-kind
	type type
	ast match-ast
	pos pos
do
	if has-pos ast.keyword-range, pos
		expression-position ctx.container, type, kind
	elif e = ast.else_
		if has-pos e.keyword-range, pos
			expression-position ctx.container, type, else-after-match

-position-at-try position-kind?(ctx expr-ctx, a try-expr, pos pos)
	position-in-keyword ctx, a.type, a, a.ast.try-keyword-range, pos or
	position-at-catches ctx, a.catches, a.ast.catches, pos

-position-at-try-let position-kind?(ctx expr-ctx, a try-let-expr, pos pos)
	position-in-keyword ctx, (), a, a.ast.try-keyword-range, pos or
	position-in-destructure ctx, a.destructure, a.ast.destructure, pos or
	position-at-catch ctx, a.catch_, a.ast.catch_, pos

-position-in-keyword position-kind?(ctx expr-ctx, type type?, expr expression-position-kind, keyword-range source-range, pos pos)
	if has-pos keyword-range, pos
		expression-position ctx.container, type, expr

-position-in-type position-kind?(container type-container, type type, ast type-ast, pos pos)
	if has-pos ast.range, pos
		res = each-type-component type, ast, of t, a
			position-in-type container, t, a, pos
		res or position-in-type-not-args container, type, ast, pos
-position-in-type-not-args position-kind?(container type-container, type type, ast type-ast, pos pos)
	ok bool = match ast
	as bogus-type-ast
		false
	as fun-type-ast
		has-pos ast.kind-range, pos
	as map-type-ast
		false
	as name-and-range
		true
	as suffix-name-type-ast
		has-pos ast.name.range, pos
	as suffix-special-type-ast
		has-pos ast.suffix-range, pos
	as tuple-type-ast
		false
	if ok
		type-with-container type, container

-each-type-component[out] out?(type type, ast type-ast, f out? mut(x type, ast type-ast))
	match type
	as bogus-type
		()
	as type-param-index
		()
	as struct-inst
		find-in-type-args type.type-args, ast, f

-find-in-packed-type-args[out] out?
	type-args type-args
	ast type-ast?
	f out? mut(x type, ast type-ast)
do
	if ast
		zip-each-type-arg-may-unpack-tuple type-args, ast, f
	else
		assert is-empty type-args
		()

-find-in-type-args[out] out?(type-args type-args, ast type-ast, f out? mut(x type, ast type-ast))
	match ast
	as bogus-type-ast
		()
	as fun-type-ast
		return-type, param-type = only2! type-args
		f[return-type, ast.return-type] or each-type-in-destructure param-type, ast.param, f
	as map-type-ast
		zip-each-type-arg type-args, (ast.key, ast.value), f
	as name-and-range
		# For a type alias, 'typeArgs' may be non-empty as it comes from the alias' target type.
		# But ignore them in any case.
		()
	as suffix-name-type-ast
		zip-each-type-arg-may-unpack-tuple type-args, ast.left, f
	as suffix-special-type-ast
		zip-each-type-arg-may-unpack-tuple type-args, ast.left, f
	as tuple-type-ast
		zip-each-type-arg type-args, ast.members, f

-zip-each-type-arg-may-unpack-tuple[out] out?
	type-args type-args
	type-arg-ast type-ast
	f out? mut(x type, ast type-ast)
do
	type-arg-asts type-ast[] = if type-args.size == 1
		type-arg-ast,
	else
		type-arg-ast.tuple-type-ast!.members
	zip-each-type-arg type-args, type-arg-asts, f

-zip-each-type-arg[out] out?
	type-args type-args
	type-arg-asts type-ast[]
	f out? mut(x type, ast type-ast)
do
	first (zip type-args.slow-to-array, type-arg-asts), f

-each-type-in-destructure[out] out?
	type type
	ast destructure-ast
	f out? mut(x type, ast type-ast)
do
	match ast
	as name-and-range
		()
	as single-destructure-ast
		if t = ast.type then f[type, t]
	as ignore-destructure-ast
		if t = ast.type then f[type, t]
	as void-destructure-ast
		()
	as array
		guard !is-bogus type
		first (zip type.struct-inst!.type-args.slow-to-array, ast), of type-arg, param
			each-type-in-destructure type-arg, param, f
