import
	../../frontend/parse/lex-whitespace
	../../model/ast
	../../model/model
	../../model/source-range
	../../util/util
	./position

get-position-kind enum
	| Expect cursor exactly on the thing. Used for requests like hover.
	exact
	| The cursor may be to the right of the thing; used for speculative requests such as completions.
	after
get-position position?(program program, where uri-line-and-character, pos-kind get-position-kind)
	pos = program.line-and-character-getters[where]
	pos-adjusted = match pos-kind
	as exact
		pos
	as after
		program.file-content-getters[where uri] walk-backwards-for-position pos
	ctx ctx = program.available-types,
	module = program module-at-uri where.uri
	if kind ?= ctx get-position-kind module, pos-adjusted, pos-kind
		module, kind

-has-pos bool(range source-range, pos pos)
	range.start <= pos and pos <= range.end
-opt-has-pos bool(range source-range?, pos pos)
	(range else ()) has-pos pos

-ctx record
	available-types available-types

-get-position-kind position-kind?(ctx ctx, module crow-module, pos pos, pos-kind get-position-kind)
	# module.imports position-in-imports-or-exports pos or ---------------------------------------------------------------------------
	# module.re-exports position-in-imports-or-exports pos or -------------------------------------------------------------------------
	module position-in-doc-comment pos or
	module.aliases first (of x then x position-in-alias pos) or
	module.structs first (of x then x position-in-struct pos) or
	module.vars first (of x then x position-in-var pos) or
	module.specs first (of x then x position-in-spec pos) or
	module.funs first (of x then ctx position-in-fun x, pos, pos-kind) or
	module.tests first (of x then ctx position-in-test x, pos, pos-kind) or
	if pos == 0 then position-module # We need a definition at position 0, because inlay hints for "Used by" have that as their location.

-position-in-doc-comment position-kind?(a doc-comment-container, pos pos)
	if index ?= a.doc-comment.ast.references find-index of x then x.range has-pos pos
		a position-doc-ref a.doc-comment.references[index]

-position-in-fun position-kind?(ctx ctx, a fun-decl, pos pos, pos-kind get-position-kind)
	guard ast ?= a.source fun-decl-ast
	a position-in-decl pos, of
		a position-in-visibility ast.visibility, pos or
		(if ast.name.range has-pos pos then a) or
		a position-in-type-params ast.type-params, pos or
		a position-in-type a.return-type, ast.return-type, pos or
		a position-in-params a.params, ast.params, pos or
		a position-in-modifiers a.specs, ast.modifiers, pos or
		if expr ?= a.body expr
			ctx position-in-expr a, expr, pos, pos-kind

-position-in-test position-kind?(ctx ctx, a test_, pos pos, pos-kind get-position-kind)
	if a.ast.keyword-range has-pos pos
		a
	else
		ctx position-in-expr a, a.body, pos, pos-kind

-position-in-params position-kind?(container local-container, params params, ast params-ast, pos pos)
	params.params-array zip ast.params-array first of x, y
		container position-in-destructure x, y, pos

-position-in-modifiers position-kind?
	container type-container
	specs specs?
	modifiers modifier-ast[]
	pos pos
do
	if index ?= modifiers find-index of x then x.range has-pos pos
		container position-in-modifier specs, modifiers, index, pos

-position-in-modifier position-kind?
	container type-container
	specs specs?
	modifiers modifier-ast[]
	index nat
	pos pos
do
	match modifiers[index]
	as modifier-keyword-ast x
		container position-modifier x.keyword
	as spec-use-ast ast
		guard s ?= specs
		guard s.inner.size == (modifiers count (_ ?= it.spec-use-ast))
		# Find the corresponding spec
		spec-index = modifiers[0 .. index] count (_ ?= it.spec-use-ast)
		spec_ = s.inner[spec-index]
		if res ?= spec_.type-args find-in-packed-type-args ast.type-arg, of type, type-ast then container position-in-type type, type-ast, pos
			res
		elif ast.name-range has-pos pos
			container position-spec-use spec_

-position-in-opt-destructure position-kind?(ctx expr-ctx, a destructure?, ast destructure-ast?, pos pos)
	guard x ?= a
	guard y ?= ast
	ctx position-in-destructure x, y, pos
-position-in-destructure position-kind?(ctx expr-ctx, a destructure, ast destructure-ast, pos pos)
	ctx.container.to position-in-destructure a, ast, pos
-position-in-destructure position-kind?
	container local-container
	a destructure
	destructure-ast destructure-ast
	pos pos
do
	match a
	as destructure-ignore x
		match x source
		as case-member-ast _
			()
		as struct-decl _
			()
		as ignore-destructure-ast ast
			if ast.underscore-range has-pos pos
				underscore::position-keyword
			elif t ?= ast type
				container.to position-in-type x.type, t, pos
		as void-destructure-ast _
			()
	as local x
		ast = destructure-ast single-destructure-ast!
		if ast.name-range has-pos pos
			container position-local x
		elif ast.mut-range opt-has-pos pos
			local-mut::position-keyword
		elif t ?= ast type
			container.to position-in-type x.type, t, pos
	as destructure-split x
		x.parts zip destructure-ast.array! first of part, part-ast
			container position-in-destructure part, part-ast, pos

###
-position-in-imports-or-exports position-kind?(imports-or-exports import-or-export[], pos pos) --------------------------------------
	guard im ?= imports-or-exports find of im then !im.is-std and im.source!.range has-pos pos
	source = im source!
	match source kind
	as import-whole-module-ast
		im.position-imported-module,
	as array names
		if source.path-range has-pos pos
			im.position-imported-module,
		else
			im.module position-in-imported-names names, im.named-imported, pos
	as import-file-ast _
		throw unreachable
-position-in-imported-names position-kind?(
	module module,
	names name-and-range[],
	imported exports,
	pos pos,
)
	names first of x
		if x.range has-pos pos
			(module position-imported-name x.name, imported[x name]),
###

-position-in-decl position-kind?(a any-decl, pos pos, f position-kind? mut())
	a position-in-doc-comment pos or if a.range.range has-pos pos
		f[]

-position-in-var position-kind?(a var-decl, pos pos)
	a position-in-decl pos, of
		a position-in-visibility a.ast.visibility, pos or
		(if a.name-range.range has-pos pos then a) or
		(if a.ast.keyword-range has-pos pos then a.kind to) or
		a position-in-type a.type, a.ast.type, pos
-to position-keyword(a var-kind)
	match a
	as global_
		global_
	as thread-local_
		thread-local_

-position-in-alias position-kind?(a struct-alias, pos pos)
	a position-in-decl pos, of
		a position-in-visibility a.ast.visibility, pos or
		(if a.name-range.range has-pos pos then a) or
		(if a.ast.keyword-range has-pos pos then alias_) or
		a position-in-type a.target, a.ast.target, pos

-position-in-struct position-kind?(a struct-decl, pos pos)
	match a source
	as struct-decl-ast x
		a position-in-struct x, pos
	as struct-decl-source-bogus _
		()
	as struct-decl-source-java _
		throw unreachable
-position-in-struct position-kind?(a struct-decl, ast struct-decl-ast, pos pos)
	a position-in-decl pos, of
		a position-in-visibility ast.visibility, pos or
		(if a.name-range.range has-pos pos then a) or
		(if ast.keyword-range has-pos pos then ast.body keyword-kind-for-struct-body) or
		a position-in-type-params ast.type-params, pos or
		a position-in-modifiers (), ast.modifiers, pos or
		a position-in-struct-body ast.body, pos
-keyword-kind-for-struct-body position-keyword(a struct-body-ast)
	match a
	as builtin-type-ast _
		builtin_
	as enum-ast _
		enum_
	as flags-ast _
		flags_
	as record-ast _
		record_
	as sum-type-ast x
		x.kind to
-to position-keyword(a sum-type-kind)
	match a
	as interface_
		interface_
	as java-interface
		throw unreachable
	as union_
		union_
	as variant_
		variant_

-position-in-visibility position-kind?(a visibility-container, visibility visibility-and-range?, pos pos)
	if v ?= visibility
		if v.range has-pos pos
			a position-visibility-mark

-position-in-type-params position-kind?(container any-decl, asts name-and-range[], pos pos)
	if index ?= asts find-index of x then x.range has-pos pos
		(index,) type-param-with-container container

-position-in-spec position-kind?(a spec-decl, pos pos)
	a position-in-decl pos, of
		a position-in-visibility a.ast.visibility, pos or
		(if a.ast.name.range has-pos pos then a) or
		a position-in-type-params a.ast.type-params, pos or
		(if a.ast.keyword-range has-pos pos then spec_) or
		a position-in-modifiers a.parents, a.ast.modifiers, pos or
		a.sigs position-in-signatures a.ast.sigs, pos

-position-in-signatures position-kind?(signatures signature[], signature-asts signature-ast[], pos pos)
	signatures zip signature-asts first of sig, sig-ast
		sig position-in-signature sig-ast, pos

-position-in-signature position-kind?(sig signature, ast signature-ast, pos pos)
	sig position-in-doc-comment pos or
	(if ast.name-and-range.range has-pos pos then sig) or
	sig.container.to position-in-type sig.return-type, ast.return-type, pos or
	sig.container.to position-in-params sig.params, ast.params, pos

-position-in-struct-body position-kind?(decl struct-decl, ast struct-body-ast, pos pos)
	match decl body
	as struct-body-bogus _
		()
	as struct-body-extern-java _
		throw unreachable
	as builtin-type _
		()
	as enum_ x
		x.members position-in-enum-or-flags-body ast.enum-ast!.params, ast.enum-ast!.members, pos
	as flags_ x
		x.members position-in-enum-or-flags-body ast.flags-ast!.params, ast.flags-ast!.members, pos
	as record_ x
		decl position-in-record x.fields, ast.record-ast!, pos
	as sum-type x
		decl position-in-sum-type x, ast.sum-type-ast!, pos

-position-in-sum-type position-kind?(decl struct-decl, a sum-type, ast sum-type-ast, pos pos)
	in-members = ast.types first-zip-if-size-eq a.listed-members, of type-ast, x
		decl position-in-type x.member, type-ast, pos
	in-members or a.methods position-in-signatures ast.methods, pos

-position-in-record position-kind?
	decl struct-decl
	fields record-field[]
	ast record-ast
	pos pos
do
	guard fields !is-empty
	if params ?= ast params
		fields zip params.array! first of field, param
			decl position-in-record-field-parameter field, param.single-destructure-ast!, pos
	else
		fields zip ast.fields first of field, field-ast
			decl position-in-record-field field, field-ast, pos

-position-in-record-field-parameter position-kind?
	decl struct-decl
	field record-field
	param single-destructure-ast
	pos pos
do
	if param.name.range has-pos pos
		field
	elif param.mut-range opt-has-pos pos
		field.mutability position-record-field-mutability
	elif t ?= param type
		decl position-in-type field.type, t, pos

-position-in-record-field position-kind?
	decl struct-decl
	field record-field
	ast record-field-ast
	pos pos
do
	if res ?= field position-in-doc-comment pos
		res
	elif res ?= field position-in-visibility ast.visibility, pos
		res
	elif ast.name.range has-pos pos
		field
	elif ast.mutability.?range opt-has-pos pos
		field.mutability position-record-field-mutability
	elif t ?= ast type
		decl position-in-type field.type, t, pos

-position-in-enum-or-flags-body position-kind?
	members enum-or-flags-member[]
	params-ast params-ast?
	member-asts enum-or-flags-member-ast[]
	pos pos
do
	guard members !is-empty
	if params ?= params-ast
		members zip params.array! first of member, param
			if param.range has-pos pos then member
	else
		members zip member-asts first of member, member-ast
			member position-in-enum-or-flags-member member-ast, pos
-position-in-enum-or-flags-member position-kind?(member enum-or-flags-member, ast enum-or-flags-member-ast, pos pos)
	member position-in-doc-comment pos or if ast.name-range has-pos pos then member

-position-in-expr position-kind?
	ctx ctx
	container expr-container
	a expr
	pos pos
	pos-kind get-position-kind
do
	expr-ctx expr-ctx = ctx.available-types, container
	expr-ctx position-in-expr-recur a, pos, pos-kind
-expr-ctx record(available-types available-types, container expr-container)
-position-in-expr-recur position-kind?(ctx expr-ctx, a expr, pos pos, pos-kind get-position-kind)
	if a.range has-pos pos
		ctx position-at-expr a, pos, pos-kind or ctx position-in-expr-child a, pos, pos-kind
-position-in-expr-child position-kind?(ctx expr-ctx, a expr, pos pos, pos-kind get-position-kind)
	a find-direct-child-expr of child
		ctx position-in-expr-recur child, pos, pos-kind
-position-at-expr position-kind?(ctx expr-ctx, a expr, pos pos, pos-kind get-position-kind)
	expression-position position-kind mut(x expression-position-kind) = of x
		ctx.container expression-position (a type ctx.available-types), x
	keyword position-kind mut(k expr-keyword) = expression-position[it]
	keyword-at position-kind? mut(range source-range, k expr-keyword) = of range, k
		if range has-pos pos then keyword[k]
	local position-kind mut(kind local-ref-kind, local local) = of kind, local
		expression-position[kind local-ref local]
	call position-kind? mut(ast call-expr-source, kind expression-position-kind) = of ast, kind
		ok = match pos-kind
		as exact
			ast pos-is-at-call pos
		as after
			true
		if ok
			expression-position[kind]

	match a
	as assert-or-forbid-expr x
		if x.ast.keyword-range has-pos pos
			expression-position[x]
		elif t ?= x.ast.thrown
			keyword-at[t.else-range, if x is-forbid then else-after-forbid else else-after-assert]
	as bogus-call-expr x
		call[x.ast, x]
	as bogus-expr _
		()
	as bogus-wrong-type-expr _
		()
	as call-expr x
		call[x.ast, x]
	as call-named-new-expr x
		call[x.ast, x]
	as call-option-expr x
		keyword-at[x.ast.keyword-range!, question-before-name-or-subscript] or
		if x.ast pos-is-at-call pos then expression-position[x]
	as extern-expr x
		expression-position[x]
	as finally-expr x
		keyword-at[x.ast.finally-keyword-range, finally_]
	as force-expr x
		keyword-at[x.ast.keyword-range, force]
	as if-expr x
		(if x.ast.first-keyword-range has-pos pos then expression-position[x]) or
		(if k ?= x.ast second-keyword-range then keyword-at[k, x.ast.kind.if-second-keyword]) or
		(if k ?= x.ast third-keyword-range then keyword-at[k, else-after-if])
	as lambda-expr x
		match x ast
		as for-or-with-ast ast
			# 'for' keyword is handled in 'as call-expr'
			(unless x is-ignore then ctx position-in-destructure x.param, ast.param, pos) or
			keyword-at[ast.in-range, ast.keyword.for-or-with-in-kind] or
			if t ?= ast then-range then keyword-at[t, then-after-for-or-with]
		as it-scope-ast ast
			ast.its first of it_
				if it_.range has-pos pos then expression-position[x]
		as lambda-ast ast
			(if ast.keyword-range has-pos pos then expression-position[x]) or
			(if t ?= ast then-range then keyword-at[t, then-after-of]) or
			ctx position-in-destructure x.param, ast.param, pos
	as let-expr x
		ctx position-in-destructure x.destructure, x.ast.destructure, pos
	as list-expr _
		# TODO: if the position is at a '-' or '--', then return expression-position[x]
		()
	as literal-scalar-expr _
		expression-position[expression-position-literal]
	as literal-string-like-expr _
		expression-position[expression-position-literal]
	as local-get-expr x
		local[get, x.local]
	as local-set-expr x
		if x.assignee-ast.range has-pos pos
			local[set, x.local]
	as logical-expr x
		if x.keyword-range has-pos pos
			expression-position[x]
	as loop-expr x
		if x.ast.keyword-range has-pos pos
			expression-position[x]
	as loop-break-expr x
		if x.ast.keyword-range has-pos pos
			expression-position[x]
	as loop-continue-expr x
		if x.ast.keyword-range has-pos pos
			expression-position[x]
	as loop-while-or-until-expr x
		if x.ast.keyword-range has-pos pos
			expression-position[x]
	as match-enum-expr x
		ctx position-at-match-enum x, pos
	as match-scalar-expr x
		ctx position-at-match-scalar x, pos
	as match-string-like-expr x
		ctx position-at-match-string-like x, pos
	as match-sum-type-expr x
		ctx position-at-match-sum-type x, pos
	as seq-expr _
		()
	as throw-expr x
		keyword-at[x.ast.keyword-range, throw_]
	as trusted-expr x
		keyword-at[x.ast.keyword-range, trusted_]
	as try-expr x
		ctx position-at-try x, pos
	as try-let-expr x
		ctx position-at-try-let x, pos
	as typed-expr x
		keyword-at[x.ast.keyword-range, colon-colon] or
		ctx.container.to position-in-type (a type ctx.available-types), x.ast.type, pos
	as unpack-option x
		ctx position-at-unpack-option x, pos

-for-or-with-in-kind expr-keyword(a for-or-with-ast-keyword)
	match a
	as for_
		in-after-for
	as for-star
		in-after-for-star
	as with_
		in-after-with

-if-second-keyword expr-keyword(kind if-ast-kind)
	match kind
	as guard-with-else
		else-after-guard
	as guard-without-else
		throw unreachable
	as if-elif
		elif_
	as if-else
		else-after-if
	as if-then
		then-after-if-without-else
	as if-then-else
		then-after-if-with-else
	as if-without-else
		throw unreachable
	as unless_
		throw unreachable
	as unless-then
		then-after-unless

-position-at-unpack-option position-kind?(ctx expr-ctx, a unpack-option, pos pos)
	ctx position-in-destructure a.destructure, a.ast.destructure, pos or
	if a.ast.question-equals-range has-pos pos
		ctx.container expression-position (), question-equals

-pos-is-at-call bool(a call-expr-source, pos pos)
	a.range-for-pos-is-at-call has-pos pos
-pos-is-at-call bool(a call-ast, pos pos)
	a.range-for-pos-is-at-call has-pos pos
-range-for-pos-is-at-call source-range(a call-expr-source)
	match a
	as assignment-ast _
		() # TODO
	as assignment-call-ast _
		() # TODO
	as call-ast x
		x range-for-pos-is-at-call
	as call-named-ast _
		() # TODO
	as empty-ast _
		()
	as for-or-with-ast x
		# Handle the colon when handling the LambdaExpr
		x keyword-range
	as if-ast _
		()
	as interpolated-ast _
		# This is the call to `interpolate` or `show`, which we don't have a position for.
		()
	as list-ast _
		()
	as literal-string-ast _
		()
	as logical-ast _
		()
	as loop-break-ast x
		x range
	as loop-continue-ast x
		x range
	as name-and-range x
		x range
-range-for-pos-is-at-call source-range(ast call-ast)
	has-name bool = match ast style
	as subscript
		false
	as question-subscript
		false
	as augment
		true
	as dot
		true
	as dot-question
		true
	as infix
		true
	as prefix-bang
		true
	as prefix-operator
		true
	as question-name
		true
	as single
		true
	if has-name
		ast.fun-name range

-position-at-match-enum position-kind?(ctx expr-ctx, a match-enum-expr, pos pos)
	ctx position-at-match-keyword a, a.type, a.ast, pos or
	a.cases position-at-match-cases a.ast, pos, (of x then x.member position-match-enum-case) or
	ctx position-in-opt-destructure a.else_.?destructure, a.ast.else_.?destructure, pos

-position-at-match-scalar position-kind?(ctx expr-ctx, a match-scalar-expr, pos pos)
	ctx position-at-match-keyword a, a.type, a.ast, pos or
	a.cases position-at-match-cases a.ast, pos, \
		(of x then a.integral-type position-match-scalar-case x.value) or
	ctx position-in-opt-destructure a.else_.destructure, a.ast.else_.?destructure, pos

-position-at-match-string-like position-kind?(ctx expr-ctx, a match-string-like-expr, pos pos)
	ctx position-at-match-keyword a, a.type, a.ast, pos or
	a.cases position-at-match-cases a.ast, pos, \
		(of x then (a.matched-type, ctx.container.to) position-match-string-like-case x.value) or
	ctx position-in-opt-destructure a.else_.destructure, a.ast.else_.?destructure, pos

-position-at-match-cases[t] position-kind?(cases t[], ast match-ast,pos pos, get-position position-kind data(case_ t))
	cases first-zip-if-size-eq ast.cases, of case_, case-ast
		if case-ast.keyword-and-member-name-range has-pos pos
			get-position[case_]

-position-at-match-sum-type position-kind?(ctx expr-ctx, a match-sum-type-expr, pos pos)
	ctx position-at-match-keyword a, a.type, a.ast, pos or
	ctx position-at-match-sum-type-cases a.cases, a.ast.cases, pos or
	ctx position-in-opt-destructure a.else_.?destructure, a.ast.else_.?destructure, pos

-position-at-match-sum-type-cases position-kind?
	ctx expr-ctx
	cases match-sum-type-case[]
	case-asts case-ast[]
	pos pos
do
	cases first-zip-if-size-eq case-asts, of case_, case-ast
		ctx position-at-match-sum-type-case case_, case-ast, pos

-position-at-match-sum-type-case position-kind?(ctx expr-ctx, case_ match-sum-type-case, ast case-ast, pos pos)
	if ast.keyword-and-member-name-range has-pos pos
		ctx.container position-match-sum-type-case case_.case-type
	else
		ctx position-in-match-case-destructure case_.destructure, ast.member, pos

-position-in-match-case-destructure position-kind?
	ctx expr-ctx
	destructure destructure
	ast case-member-ast
	pos pos
do
	ctx position-in-opt-destructure destructure, ast.as-name-ast.?destructure, pos

-position-at-match-keyword position-kind?
	ctx expr-ctx
	kind expression-position-kind
	type type
	ast match-ast
	pos pos
do
	if ast.keyword-range has-pos pos
		ctx.container expression-position type, kind
	elif e ?= ast else_
		if e.keyword-range has-pos pos
			ctx.container expression-position type, else-after-match

-position-at-try position-kind?(ctx expr-ctx, a try-expr, pos pos)
	if a.ast.try-keyword-range has-pos pos
		ctx.container expression-position a.type, a
	else
		ctx position-at-match-sum-type-cases a.catches, a.ast.catches, pos

-position-at-try-let position-kind?(ctx expr-ctx, a try-let-expr, pos pos)
	if a.ast.try-keyword-range has-pos pos
		ctx.container expression-position (), a
	elif res ?= ctx position-in-destructure a.destructure, a.ast.destructure, pos
		res
	elif (a.ast.catch-keyword-range.start, a.ast.catch-member.name-range.end) has-pos pos
		ctx.container position-match-sum-type-case a.catch_.case-type
	else
		ctx position-in-match-case-destructure a.catch_.destructure, a.ast.catch-member, pos

-position-in-type position-kind?(container type-container, type type, ast type-ast, pos pos)
	if ast.range has-pos pos
		res = type each-type-component ast, of t, a
			container position-in-type t, a, pos
		res or container position-in-type-not-args type, ast, pos
-position-in-type-not-args position-kind?(container type-container, type type, ast type-ast, pos pos)
	ok bool = match ast
	as bogus-type-ast _
		false
	as fun-type-ast x
		x.kind-range has-pos pos
	as map-type-ast _
		false
	as name-and-range _
		true
	as suffix-name-type-ast x
		x.name.range has-pos pos
	as suffix-special-type-ast x
		x.suffix-range has-pos pos
	as tuple-type-ast _
		false
	if ok
		type type-with-container container

-each-type-component[out] out?(type type, ast type-ast, f out? mut(x type, ast type-ast))
	match type
	as bogus-type _
		()
	as type-param-index _
		()
	as struct-inst x
		x.type-args find-in-type-args ast, f

-find-in-packed-type-args[out] out?
	type-args type-args
	ast type-ast?
	f out? mut(x type, ast type-ast)
do
	if x ?= ast
		type-args zip-each-type-arg-may-unpack-tuple x, f
	else
		assert type-args is-empty
		()

-find-in-type-args[out] out?(type-args type-args, ast type-ast, f out? mut(x type, ast type-ast))
	match ast
	as bogus-type-ast _
		()
	as fun-type-ast x
		return-type, param-type = type-args only2
		f[return-type, x.return-type] or param-type each-fun-type-parameter x.params, f
	as map-type-ast x
		type-args zip-each-type-arg (x.key, x.value), f
	as name-and-range _
		# For a type alias, 'typeArgs' may be non-empty as it comes from the alias' target type.
		# But ignore them in any case.
		()
	as suffix-name-type-ast x
		type-args zip-each-type-arg-may-unpack-tuple x.left, f
	as suffix-special-type-ast x
		type-args zip-each-type-arg-may-unpack-tuple x.left, f
	as tuple-type-ast x
		type-args zip-each-type-arg x.members, f

-zip-each-type-arg-may-unpack-tuple[out] out?
	type-args type-args
	type-arg-ast type-ast
	f out? mut(x type, ast type-ast)
do
	type-arg-asts type-ast[] = if type-args.size == 1
		type-arg-ast,
	else
		type-arg-ast.tuple-type-ast! members
	type-args zip-each-type-arg type-arg-asts, f

-zip-each-type-arg[out] out?
	type-args type-args
	type-arg-asts type-ast[]
	f out? mut(x type, ast type-ast)
do # TODO: this is a one-liner now, so just inline? -------------------------------------------------------------------------------
	type-args.slow-to-array zip type-arg-asts first f

-each-fun-type-parameter[out] out? # TODO: rename to each-type-in-fun-parameters ---------------------------------------------------
	params-type type
	params-ast params-ast
	f out? mut(x type, ast type-ast)
do
	match params-ast
	as array params
		if params.size == 1
			params-type each-type-in-destructure params.only, f
		else
			params-type each-type-in-destructure-parts params, f
	as varargs-ast _
		() # TODO

-each-type-in-destructure-parts[out] out?
	type type
	parts destructure-ast[]
	f out? mut(x type, ast type-ast)
do
	guard type !is-bogus
	type.struct-inst!.type-args.slow-to-array zip parts first of type-arg, param
		type-arg each-type-in-destructure param, f

-each-type-in-destructure[out] out?
	type type
	ast destructure-ast
	f out? mut(x type, ast type-ast)
do
	match ast
	as single-destructure-ast x
		if t ?= x type then f[type, t]
	as ignore-destructure-ast x
		if t ?= x type then f[type, t]
	as void-destructure-ast _
		()
	as array parts
		type each-type-in-destructure-parts parts, f
