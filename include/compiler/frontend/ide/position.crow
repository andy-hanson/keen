import
	../../model/ast
	../../model/integral-values
	../../model/model
	../../model/uri

position record
	module crow-module
	kind position-kind
| A SpecDecl* can contain parameters in its signatures, and a StructDecl* for a variant can too
local-container union(fun-decl, test_, spec-decl, struct-decl, var-decl)
to type-container(a local-container)
	match a
	as fun-decl x
		x
	as test_ x
		x
	as spec-decl x
		x
	as struct-decl x
		x
	as var-decl x
		x
to local-container(a expr-container)
	match a
	as fun-decl x
		x
	as test_ x
		x
	as var-decl x
		x
module-uri uri(a local-container)
	a.to::type-container module-uri

assert-local-container local-container(a doc-comment-container)
	match a
	as any-decl x
		x assert-local-container
	as enum-or-flags-member _
		throw unreachable
	as crow-module _
		throw unreachable
	as record-field _
		throw unreachable
	as signature x
		x.container to
assert-local-container local-container(a any-decl)
	match a
	as fun-decl x
		x
	as spec-decl x
		x
	as struct-alias _
		throw unreachable
	as struct-decl x
		x
	as test_ x
		x
	as var-decl _
		throw unreachable
to local-container(a signature-container)
	match a
	as spec-decl x
		x
	as struct-decl x
		x

visibility-container union(fun-decl, record-field, spec-decl, struct-alias, struct-decl, var-decl)
	name symbol()
	visibility visibility()

doc-comment-container union(any-decl, enum-or-flags-member, crow-module, record-field, signature)
	doc-comment doc-comment()
# WARN: typeContainerFor(a).docComment is not always a.docComment
type-container-for type-container(a doc-comment-container)
	match a
	as any-decl x
		x to
	as enum-or-flags-member x
		x containing-enum
	as crow-module x
		x
	as record-field x
		x containing-record
	as signature x
		x.container to

position-kind union
	position-doc-ref
	enum-or-flags-member
	expression-position
	fun-decl
	position-imported-module
	position-imported-name
	position-keyword
	position-local
	position-match-enum-case
	position-match-integral-case
	position-match-string-like-case
	position-match-sum-type-case
	position-modifier
	position-modifier-extern
	position-module
	record-field
	position-record-field-mutability
	spec-decl
	signature
	position-spec-use
	struct-alias
	struct-decl
	test_
	type-with-container
	type-param-with-container
	var-decl
	position-visibility-mark

position-doc-ref record(container doc-comment-container, ref doc-comment-reference)
position-imported-module record(import_ import-or-export)
module crow-module(a position-imported-module)
	a.import_.module crow-module! # TODO: make sure we don't create position-imported-module at a non-crow module -----------------
position-imported-name record(exporting-module module, name symbol, referents name-referents?) # TODO: actually use this ------
name-referents record
	struct-or-alias struct-or-alias?
	spec_ spec-decl?
	funs fun-decl[]

# Non-modifier keywords only
position-keyword enum
	alias_
	builtin_
	enum_
	extern_
	flags_
	global_
	interface_
	local-mut
	record_
	spec_
	thread-local_
	underscore
	union_
	variant_
position-local record(container local-container, local local)
position-match-enum-case record(member enum-or-flags-member)
position-match-integral-case record(kind char-or-integral-type, value integral-value)
position-match-string-like-case record(type type-with-container, value string)
position-match-sum-type-case record(container expr-container, member struct-inst)
position-modifier record(container type-container, modifier modifier-keyword)
position-modifier-extern record(library-name symbol)
position-module record
position-record-field-mutability record(visibility visibility?)
position-spec-use record(container type-container, spec_ spec-inst)
type-param-with-container record(type-param type-param-index, container any-decl)
position-visibility-mark record(container visibility-container)

expression-position record(container expr-container, type type?, kind expression-position-kind)
expression-position-kind union
	assert-or-forbid-expr
	bogus-call-expr
	call-expr
	call-named-new-expr
	call-option-expr
	expr-keyword
	extern-expr
	if-expr
	expression-position-literal
	lambda-expr
	local-ref
	loop-expr
	loop-break-expr
	loop-continue-expr
	loop-while-or-until-expr
	match-enum-expr
	match-integral-expr
	match-string-like-expr
	match-sum-type-expr
	try-expr
	try-let-expr
expression-position-literal record
local-ref record(kind local-ref-kind, local local)
local-ref-kind enum(get, set, closure-get, closure-set, pointer)

expr-keyword enum
	ampersand
	colon-colon
	colon-after-assert
	colon-after-forbid
	colon-in-for
	colon-in-if
	colon-in-with
	elif_
	else-after-if
	else-after-match
	finally_
	question-dot-or-subscript
	question-equals
	throw_
	trusted_
