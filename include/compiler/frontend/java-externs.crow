import
	../model/ast
	../model/model
	../model/uri
	../util/by-name
	./check/instantiate
	./parse-java-class
	../util/java-bytecode-types
	../util/perf

java-ctx interface mut
	instantiate-ctx instantiate-ctx()
	common-types common-types()
	ensure-java-class struct-decl(path path)

fill-java-class-supertypes void(ctx java-ctx, struct struct-decl, class_ parsed-java-class-header)
	start = perf-now
	finally end-fill-java-class-supertypes start
	fill-supertypes ctx, class_, struct

get-java-module java-class-module(ctx java-ctx, path path, struct struct-decl, class_ parsed-java-class-header)
	start = perf-now
	finally end-get-java-module start
	body = parse-java-class-body class_
	fill-interface-methods ctx, class_, body.methods, struct
	funs = funs-for-java-class ctx, path, class_, body, struct
	path: path
	public-exports:
		funs: funs.to
		structs-and-aliases: to-by-name (struct,), of _ then throw unreachable
		specs: ()

initial-struct-for-java-class struct-decl
	instantiate-ctx instantiate-ctx
	path path
do
	hash: next-hash instantiate-ctx
	source: struct-decl-source-java path,
		base = base-name path
		if _, rest = try-split-once base, "$"
			rest.to
		else
			base.to
	module-uri: path.to-java-uri
	visibility: public
	purity: mut_
	purity-is-forced: false
	doc-comment-references: ()
	sum-type-memberships: ()
	body: struct-body-extern-java path

-fill-supertypes void(ctx java-ctx, class_ parsed-java-class-header, type struct-decl)
	type.specs := ctx.common-types.java-summon-unsafe-specs
	# TODO: do a lot more here! I'd like all Java subclasses to implicitly convert to their superclasses! -------------------------------------------
	is-throwable = if super = class_.super-class
		super == "java/lang/Throwable".parse-path or is-throwable ctx, (ensure-java-class ctx, super)
	if is-throwable
		type.sum-type-memberships :=
			-
				ast: ()
				sum-type: ctx.common-types.exception
				method-impls: ((),) # The type will not actually be emitted, so don't bother with this
-is-throwable bool(ctx java-ctx, a struct-decl)
	exists a.sum-type-memberships, it.sum-type == ctx.common-types.exception

-fill-interface-methods void(ctx java-ctx, class_ parsed-java-class-header, parsed-methods parsed-method[], type struct-decl)
	do if class_.access[interface_]
	type.body :=
		:: sum-type
		kind: java-interface
		listed-members: ()
		methods: for* method in parsed-methods
			do if method.access-flags[abstract_]
			# Ignore varargs; they just become normal array parameters
			(method.access-flags & ~varargs) is (abstract_ | public)
			return-type, params = method-return-type-and-params ctx, method
			-
				container: type
				source: signature-source-java method.name
				return-type: return-type
				params: params
				doc-comment-references: ()

-funs-for-java-class fun-decl[](ctx java-ctx, path path, header parsed-java-class-header, class_ parsed-java-class-body, struct struct-decl)
	class-type = only-inst struct
	is-interface = header.access[interface_]
	do with out in build
	for field in class_.fields
		do if field.access-flags[public | static] # TODO: support instance fields
		out ~=
			hash: next-hash ctx.instantiate-ctx
			source: fun-source-java path, field.name
			visibility: public
			n-type-params: 0
			return-type: to-type ctx, field.type
			params: ()
			specs: ctx.common-types.java-summon-unsafe-specs
			doc-comment-references: ()
			body:
				:: fun-body-extern-java
				static-field, path

	for method in class_.methods
		do if method.access-flags[public]
		is-static = method.access-flags[static]
		is-constructor = method.name == "<init>"
		return-type, most-params = method-return-type-and-params ctx, method
		do if body fun-body-extern-java = if is-static
			kind: if is-interface then static-method-of-interface else static-method-of-class
			class_: path
		elif is-constructor
			constructor, path
		elif is-interface
			()
		else
			virtual, path
		out ~=
			hash: next-hash ctx.instantiate-ctx
			source: fun-source-java path, if is-constructor then "new" else method.name
			visibility: public
			n-type-params: 0
			return-type: if is-constructor then class-type else return-type
			params: if is-static or is-constructor
				most-params
			else
				- "this".local-source-generated, class-type
				-- most-params
			specs: ctx.common-types.java-summon-unsafe-specs
			doc-comment-references: ()
			body: body

	if sum = struct.body.sum-type
		sum.kind is java-interface
		for index, method in with-index sum.methods
			out ~= fun-for-method ctx.instantiate-ctx, struct, class-type, index, method

-method-return-type-and-params (type, destructure[])(ctx java-ctx, method parsed-method)
	- to-type ctx, method.descriptor.return-type
	- for i, x in with-index method.descriptor.param-types
		:: local
		source: local-source-generated "p{i}" # TODO: there should be a way to get parameter names from the attributes ------------------------------
		type: to-type ctx, x

-to-type type(ctx java-ctx, type java-type)
	match type
	as void
		ctx.common-types.void
	as java-primitive-type
		type-from-primitive ctx.common-types, type
	as java-array-type
		ctx.common-types.mut-slice[as-type-args to-type ctx, type.element]
	as path
		only-inst ensure-java-class ctx, type
-type-from-primitive type(common-types common-types, type java-primitive-type)
	i = common-types.integrals
	match type
	as T_BOOLEAN
		common-types.bool
	as T_CHAR
		i.nat16
	as T_FLOAT
		common-types.float32
	as T_DOUBLE
		common-types.float64
	as T_BYTE
		i.int8
	as T_SHORT
		i.int16
	as T_INT
		i.int32
	as T_LONG
		i.int64
