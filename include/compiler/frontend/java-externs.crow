import
	crow/bits
	crow/col/mut-slice
	crow/unsafe
	java/lang/Class
	java/lang/reflect/Constructor
	java/lang/reflect/Executable
	java/lang/reflect/Field
	java/lang/reflect/Method
	java/lang/reflect/Modifier
	java/lang/reflect/Parameter
	../model/ast
	../model/model
	../model/uri
	../util/by-name
	./check/instantiate

java-externs record mut
	-java-class-types struct-decl mut[path]
	-java-class-modules java-class-module mut[path]
new java-externs()
	(), ()

finish java-class-module[uri](a java-externs)
	for path, module : a java-class-modules
		path.to-java-uri, module

Object struct-inst(a java-externs, instantiate-ctx instantiate-ctx, common-types common-types)
	assert trusted extern java : todo
	a with-defer-interface-methods instantiate-ctx, common-types, defer-interface-methods =>
		defer-interface-methods struct-for-java-class a, instantiate-ctx, common-types, "java/lang/Object".as-path only-inst

get-java-module java-class-module(a java-externs, instantiate-ctx instantiate-ctx, common-types common-types, path path)
	assert trusted extern java : todo
	a with-defer-interface-methods instantiate-ctx, common-types, deferred =>
		deferred get-java-module-inner a, instantiate-ctx, common-types, path

-get-java-module-inner java-class-module
	deferred deferred
	a java-externs
	instantiate-ctx instantiate-ctx
	common-types common-types
	path path
do java extern
	a.java-class-modules ensure path, () =>
		class_ = deferred struct-for-java-class a, instantiate-ctx, common-types, path
		# It needs to fill in the interface methods for class_ here so we can generate all funs
		deferred fill-all-interface-methods a, instantiate-ctx, common-types
		funs = deferred funs-for-java-class a, instantiate-ctx, common-types, path
		path: path
		public-exports:
			funs: funs to
			structs-and-aliases: (class_,) to-by-name _ => throw unreachable
			specs: ()

-deferred record mut
	interface-methods path mut[]
	interface-modules path mut[]

# TODO: obviously this should be a 'with' function --------------------------------------------------------------------------
-with-defer-interface-methods[t] t
	a java-externs
	instantiate-ctx instantiate-ctx
	common-types common-types
	f t mut(x deferred)
do java extern
	deferred deferred = (), ()
	res = f[deferred]
	loop
		deferred fill-all-interface-methods a, instantiate-ctx, common-types
		# The backend expects every interface to have an associated module with caller functions
		guard path ?= deferred.interface-modules pop : break
		_ = deferred get-java-module-inner a, instantiate-ctx, common-types, path
		continue
	res

-fill-all-interface-methods void(deferred deferred, a java-externs, instantiate-ctx instantiate-ctx, common-types common-types) java extern
	while path ?= deferred.interface-methods pop
		deferred fill-interface-methods a, instantiate-ctx, common-types, path

-struct-for-java-class struct-decl
	deferred deferred
	a java-externs
	instantiate-ctx instantiate-ctx
	common-types common-types
	path path
do java extern
	a.java-class-types ensure path, () =>
		class_ = path get-class
		hash: instantiate-ctx next-hash
		source: path struct-decl-source-java
		module-uri: path to-java-uri
		visibility: public # TODO: get this from the Java visibility ---------------------------------------------------
		extern_: "java",
		is-summon: true
		purity: mut_
		purity-is-forced: false
		doc-comment-references: ()
		sum-type-memberships: with out : build
			supers = class_ superclasses
			if supers exists x => (trusted x getName).to::string == "java.lang.Throwable"
				out ~= (), common-types.exception, ((),) # Since we won't actually emit this type, use bogus method-impls
			# TODO: get more this from declared interfaces ------------------------------------------------
			()
		body: if trusted class_ isInterface
			deferred.interface-methods ~= path
			deferred.interface-modules ~= path
			struct-body-bogus
		else
			path struct-body-extern-java

-fill-interface-methods void
	deferred deferred
	a java-externs
	instantiate-ctx instantiate-ctx
	common-types common-types
	path path
do java extern
	trusted
	class_ = path get-class
	assert class_ isInterface
	type = a.java-class-types[path]!
	type.body :=
		:: sum-type
		kind: java-interface
		listed-members: ()
		methods: for* method : class_ getDeclaredMethods
			guard (method.getModifiers & ABSTRACT) != 0
			assert (method.getModifiers & ~TRANSIENT) == (ABSTRACT | PUBLIC)
			return-type, params = deferred method-return-type-and-params a, instantiate-ctx, common-types, method
			-
				container: type
				source: method.getName.to signature-source-java
				return-type: return-type
				params: params
				doc-comment-references: ()

-superclasses Class[](a Class) java extern
	trusted with out : build
		cur mut = a getSuperclass
		while cur !reference-equal gc-safe-value
			out ~= cur
			cur := cur getSuperclass

-get-class Class(path path) java extern
	trusted path.path-to-java-name.to-java-string forName # TODO: this can throw an exception, so catch and make a diagnostic

-funs-for-java-class fun-decl[]
	deferred deferred
	a java-externs
	instantiate-ctx instantiate-ctx
	common-types common-types
	path path
do
	trusted
	assert extern java
	class_ = path get-class
	with out : build
		fields = class_ getDeclaredFields
		for field : fields
			# TODO: ENSURE IT'S PUBLIC ------------------------------------------------------------------------------------
			type = deferred as-type a, instantiate-ctx, common-types, field.getType
			is-static = field.getModifiers isStatic
			guard is-static # TODO: support instance fields -----------------------------------------------------------------
			out ~=
				hash: instantiate-ctx next-hash
				source: path fun-source-java field.getName.to
				visibility: public
				n-type-params: 0
				return-type: type
				params: ()
				flags_: summon_ | unsafe_
				externs: "java",
				specs: ()
				doc-comment-references: ()
				body: static-field fun-body-extern-java path

		class-type = deferred as-type a, instantiate-ctx, common-types, class_

		for ctor : class_ getDeclaredConstructors
			# TODO: ensure it's public ---------------------------------------------------------------------------------------------
			# TODO: include parameter names, using 'getParameters' --------------------------------------------------------------------
			params destructure[] = for i, x : ctor.getParameterTypes with-index
				"p{i}".local-source-generated, immut, do deferred as-type a, instantiate-ctx, common-types, x
			out ~=
				# TODO: share code with the fun-decl creation for method ------------------------------------------------------
				hash: instantiate-ctx next-hash
				source: path fun-source-java "new"
				visibility: public
				n-type-params: 0
				return-type: class-type
				params: params
				flags_: summon_ | unsafe_
				externs: "java",
				specs: ()
				doc-comment-references: ()
				body: constructor fun-body-extern-java path
			()

		for method : class_ getDeclaredMethods
			# TODO: ENSURE IT'S PUBLIC ------------------------------------------------------------------------------------
			is-static = method.getModifiers isStatic
			return-type, most-params = deferred method-return-type-and-params a, instantiate-ctx, common-types, method
			# TODO: NEATER (should be able to declare 'body' on this line ...) -----------------------------------------------
			opt-body fun-body? = if is-static
				static fun-body-extern-java path
			elif class_ isInterface
				()
			else
				virtual fun-body-extern-java path
			guard body ?= opt-body
			out ~=
				hash: instantiate-ctx next-hash
				source: path fun-source-java method.getName.to
				visibility: public
				n-type-params: 0
				return-type: return-type
				params: if is-static
					most-params
				else
					("this".local-source-generated, immut, class-type) ~ most-params
				flags_: summon_ | unsafe_
				externs: "java",
				specs: ()
				doc-comment-references: ()
				body: body
		
		struct = class-type.struct-inst! decl
		if sum ?= struct.body sum-type
			sum.kind is java-interface
			# forbid sum.methods is-empty # TODO: this is theoretically possible, using it as a sanity check for now --------
			for index, method : sum.methods with-index
				out ~= instantiate-ctx fun-for-method struct, index, method

-method-return-type-and-params (type, destructure[])
	deferred deferred
	a java-externs
	instantiate-ctx instantiate-ctx
	common-types common-types
	method Method
do java extern
	trusted
	parameters = method.reinterpret-cast::Executable getParameters
	- deferred as-type a, instantiate-ctx, common-types, method.getReturnType
	- for i, x : method.getParameterTypes with-index
		:: local
		source: parameters[i].getName.to local-source-generated
		mutability: immut
		type: deferred as-type a, instantiate-ctx, common-types, x
-as-type type
	deferred deferred
	a java-externs
	instantiate-ctx instantiate-ctx
	common-types common-types
	class_ Class
do java extern
	trusted
	if class_ isPrimitive
		common-types type-from-primitive class_
	elif class_ isArray
		elem = deferred as-type a, instantiate-ctx, common-types, class_.componentType
		common-types.mut-slice[elem]
	else
		path = class_.getName.to java-name-to-path
		struct = deferred struct-for-java-class a, instantiate-ctx, common-types, path
		struct only-inst

-path-to-java-name string(path path)
	path.to::string replace-all "/", "."
-java-name-to-path path(a string)
	a replace-all ".", "/" as-path

-type-from-primitive type(common-types common-types, class_ Class) java extern
	i = common-types integrals
	match (trusted class_ getName).to::symbol
	as boolean
		common-types bool
	as char
		i nat16
	as byte
		i int8
	as short
		i int16
	as int
		i int32
	as long
		i int64
	as float
		common-types float32
	as double
		common-types float64
	as void
		common-types void
	else
		throw unreachable
