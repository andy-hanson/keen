import
	crow/col/mut-slice
	java/lang/Class
	java/lang/reflect/Constructor
	java/lang/reflect/Field
	java/lang/reflect/Method
	java/lang/reflect/Modifier
	../model/ast
	../model/model
	../model/uri
	../util/by-name
	./check/instantiate

java-externs record mut
	-java-class-types struct-decl mut[path]
	-java-class-modules java-class-module mut[path]
new java-externs()
	(), ()

Object struct-inst(a java-externs, instantiate-ctx instantiate-ctx)
	a struct-for-java-class instantiate-ctx, "java/lang/Object".as-path only-inst

get-java-module java-class-module(a java-externs, instantiate-ctx instantiate-ctx, common-types common-types, path path)
	a.java-class-modules ensure path, () =>
		class_ = a struct-for-java-class instantiate-ctx, path
		funs = a funs-for-java-class instantiate-ctx, common-types, path
		public-exports exports =
			funs: funs to
			structs-and-aliases: (class_,) to-by-name _ => throw unreachable
			specs: ()
		_ = public-exports
		path: path
		public-exports: public-exports

-struct-for-java-class struct-decl(a java-externs, instantiate-ctx instantiate-ctx, path path) trusted
	assert extern java
	a.java-class-types ensure path, () =>
		hash: instantiate-ctx next-hash
		source: path struct-decl-source-java
		module-uri: path to-java-uri
		visibility: public # TODO: get this from the Java visibility ---------------------------------------------------
		extern_: "java",
		is-summon: true
		purity: mut_
		purity-is-forced: false
		doc-comment-references: ()
		sum-type-memberships: () # TODO: get this from declared interfaces ------------------------------------------------
		body: path struct-body-extern-java

-funs-for-java-class fun-decl[](a java-externs, instantiate-ctx instantiate-ctx, common-types common-types, path path) trusted
	assert extern java
	class_ Class = path.path-to-java-name.to-java-string forName # TODO: this can throw an exception, so catch and make a diagnostic
	with out : build
		fields = class_ getDeclaredFields
		for field : fields
			# TODO: ENSURE IT'S PUBLIC ------------------------------------------------------------------------------------
			name = field.getName string-of-java-string
			type = a as-type instantiate-ctx, common-types, field.getType
			is-static = field.getModifiers isStatic
			guard is-static # TODO: support instance fields -----------------------------------------------------------------
			out ~=
				hash: instantiate-ctx next-hash
				source: path fun-source-java name.to
				visibility: public
				n-type-params: 0
				return-type: type
				params: ()
				flags_: summon_ | unsafe_
				externs: "java",
				specs: ()
				doc-comment-references: ()
				body: static-field fun-body-extern-java path

		class-type type mut() = () =>
			a as-type instantiate-ctx, common-types, class_

		for ctor : class_ getDeclaredConstructors
			# TODO: ensure it's public ---------------------------------------------------------------------------------------------
			# TODO: include parameter names, using 'getParameters' --------------------------------------------------------------------
			params destructure[] = for i, x : ctor.getParameterTypes with-index
				"p{i}".local-source-generated, immut, do a as-type instantiate-ctx, common-types, x
			out ~=
				# TODO: share code with the fun-decl creation for method ------------------------------------------------------
				hash: instantiate-ctx next-hash
				source: path fun-source-java "new"
				visibility: public
				n-type-params: 0
				return-type: class-type[]
				params: params
				flags_: summon_ | unsafe_
				externs: "java",
				specs: ()
				doc-comment-references: ()
				body: constructor fun-body-extern-java path
			()

		for method : class_ getDeclaredMethods
			# TODO: ENSURE IT'S PUBLIC ------------------------------------------------------------------------------------
			name = method.getName string-of-java-string
			return-type = a as-type instantiate-ctx, common-types, method.getReturnType
			is-static = method.getModifiers isStatic
			kind java-method-kind = if is-static
				static
			elif class_ isInterface
				interface_
			else
				virtual
			params destructure[] = with p : build
				if kind != static
					p ~= "this".local-source-generated, immut, class-type[]
				# TODO: get parameter names too, using 'getParameters'  https://docs.oracle.com/en/java/javase/23/docs/api/java.base/java/lang/reflect/Executable.html#getParameters()
				for i, x : method.getParameterTypes with-index
					p ~= "p{i}".local-source-generated, immut, do a as-type instantiate-ctx, common-types, x
			out ~=
				hash: instantiate-ctx next-hash
				source: path fun-source-java name.to
				visibility: public
				n-type-params: 0
				return-type: return-type
				params: params
				flags_: summon_ | unsafe_
				externs: "java",
				specs: ()
				doc-comment-references: ()
				body: kind fun-body-extern-java path

-as-type type(a java-externs, instantiate-ctx instantiate-ctx, common-types common-types, class_ Class) trusted, java extern
	if class_ isPrimitive
		common-types type-from-primitive class_
	elif class_ isArray
		elem = a as-type instantiate-ctx, common-types, class_.componentType
		common-types.mut-slice[elem]
	else
		name = class_.getName string-of-java-string
		struct = a struct-for-java-class instantiate-ctx, name.java-name-to-path
		struct only-inst

-path-to-java-name string(path path)
	path.to::string replace-all "/", "."
-java-name-to-path path(a string)
	a replace-all ".", "/" as-path

-type-from-primitive type(common-types common-types, class_ Class) trusted, java extern
	i = common-types integrals
	match class_.getName string-of-java-string
	as boolean
		common-types bool
	as char
		i nat16
	as byte
		i int8
	as short
		i int16
	as int
		i int32
	as long
		i int64
	as float
		common-types float32
	as double
		common-types float64
	as void
		common-types void
	else
		throw unreachable
