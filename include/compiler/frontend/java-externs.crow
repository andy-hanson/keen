import
	../model/ast
	../model/model
	../model/uri
	../util/by-name
	./check/instantiate
	./parse-java-class
	../util/java-bytecode-types
	../util/perf

java-ctx interface mut
	instantiate-ctx instantiate-ctx()
	common-types common-types()
	ensure-java-class struct-decl(path path)

fill-java-class-supertypes void(ctx java-ctx, struct struct-decl, class_ parsed-java-class-header)
	start = perf-now
	finally start end-fill-java-class-supertypes
	ctx fill-supertypes class_, struct

get-java-module java-class-module(ctx java-ctx, path path, struct struct-decl, class_ parsed-java-class-header)
	start = perf-now
	finally start end-get-java-module
	body = class_ parse-java-class-body
	ctx fill-interface-methods class_, body.methods, struct
	funs = ctx funs-for-java-class path, class_, body, struct
	path: path
	public-exports:
		funs: funs to
		structs-and-aliases: (struct,) to-by-name of _ then throw unreachable
		specs: ()

initial-struct-for-java-class struct-decl
	instantiate-ctx instantiate-ctx
	path path
do
	hash: instantiate-ctx next-hash
	source: path struct-decl-source-java
		base = path base-name
		if _, rest = base try-split-once "$"
			rest to
		else
			base to
	module-uri: path to-java-uri
	visibility: public
	purity: mut_
	purity-is-forced: false
	doc-comment-references: ()
	sum-type-memberships: ()
	body: path struct-body-extern-java

-fill-supertypes void(ctx java-ctx, class_ parsed-java-class-header, type struct-decl)
	type.specs := ctx.common-types java-summon-unsafe-specs
	# TODO: do a lot more here! I'd like all Java subclasses to implicitly convert to their superclasses! -------------------------------------------
	is-throwable = if super = class_ super-class
		super == "java/lang/Throwable".parse-path or ctx is-throwable (ctx ensure-java-class super)
	if is-throwable
		type.sum-type-memberships :=
			-
				ast: ()
				sum-type: ctx.common-types.exception
				method-impls: ((),) # The type will not actually be emitted, so don't bother with this
-is-throwable bool(ctx java-ctx, a struct-decl)
	a.sum-type-memberships exists it.sum-type == ctx.common-types.exception

-fill-interface-methods void(ctx java-ctx, class_ parsed-java-class-header, parsed-methods parsed-method[], type struct-decl)
	guard interface_::class-access in class_.access
	type.body :=
		:: sum-type
		kind: java-interface
		listed-members: ()
		methods: for* method in parsed-methods
			guard abstract_::method-access-flags in method.access-flags
			# Ignore varargs; they just become normal array parameters
			(method.access-flags & ~varargs) is (abstract_ | public)
			return-type, params = ctx method-return-type-and-params method
			-
				container: type
				source: method.name signature-source-java
				return-type: return-type
				params: params
				doc-comment-references: ()

-funs-for-java-class fun-decl[](ctx java-ctx, path path, header parsed-java-class-header, class_ parsed-java-class-body, struct struct-decl)
	class-type = struct only-inst
	is-interface = interface_::class-access in header.access
	with out in build
		for field in class_ fields
			guard public::field-access-flags in field.access-flags
			guard static::field-access-flags in field.access-flags # TODO: support instance fields
			out ~=
				hash: ctx.instantiate-ctx next-hash
				source: path fun-source-java field.name
				visibility: public
				n-type-params: 0
				return-type: ctx to-type field.type
				params: ()
				specs: ctx.common-types java-summon-unsafe-specs
				doc-comment-references: ()
				body:
					:: fun-body-extern-java
					static-field, path

		for method in class_ methods
			guard public::method-access-flags in method.access-flags
			is-static = static::method-access-flags in method.access-flags
			is-constructor = method.name == "<init>"
			return-type, most-params = ctx method-return-type-and-params method
			# TODO: NEATER (should be able to declare 'body' on this line ...) -----------------------------------------------
			body fun-body-extern-java? = if is-static
				kind: if is-interface then static-method-of-interface else static-method-of-class
				class_: path
			elif is-constructor
				constructor, path
			elif is-interface
				()
			else
				virtual, path
			guard body
			out ~=
				hash: ctx.instantiate-ctx next-hash
				source: path fun-source-java if is-constructor then "new" else method.name
				visibility: public
				n-type-params: 0
				return-type: if is-constructor then class-type else return-type
				params: if is-static or is-constructor
					most-params
				else
					- "this".local-source-generated, class-type
					-- most-params
				specs: ctx.common-types java-summon-unsafe-specs
				doc-comment-references: ()
				body: body

		if sum = struct.body sum-type
			sum.kind is java-interface
			for index, method in sum.methods with-index
				out ~= ctx.instantiate-ctx fun-for-method struct, class-type, index, method

-method-return-type-and-params (type, destructure[])(ctx java-ctx, method parsed-method)
	- ctx to-type method.descriptor.return-type
	- for i, x in method.descriptor.param-types with-index
		:: local
		source: "p{i}" local-source-generated # TODO: there should be a way to get parameter names from the attributes ------------------------------
		type: ctx to-type x

-to-type type(ctx java-ctx, type java-type)
	match type
	as void
		ctx.common-types void
	as java-primitive-type
		ctx.common-types type-from-primitive type
	as java-array-type
		ctx.common-types.mut-slice[ctx to-type type.element as-type-args]
	as path
		ctx ensure-java-class type only-inst
-type-from-primitive type(common-types common-types, type java-primitive-type)
	i = common-types integrals
	match type
	as T_BOOLEAN
		common-types bool
	as T_CHAR
		i nat16
	as T_FLOAT
		common-types float32
	as T_DOUBLE
		common-types float64
	as T_BYTE
		i int8
	as T_SHORT
		i int16
	as T_INT
		i int32
	as T_LONG
		i int64
