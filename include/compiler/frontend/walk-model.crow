import
	../model/ast
	../model/model
	../model/source-range
	../model/uri
	../util/util

cb-thing alias
	void mut(range source-range, kind reference-kind, x doc-comment-reference)
reference-kind enum
	| Reference is explicit. We distinguish these if they are part of a declaration.
	explicit-public
	explicit-internal
	explicit-private
	| Function is used as a method implementation
	sum-type-method-impl
	| Function is called by an 'auto' fun
	auto
	| Function is used to implement a spec
	spec-impl
	| Implicit initializer of a var
	var-initializer
	| Thing is referenced in a doc comment
	comment
	declare-local
	get-local
	set-local
== bool(a reference-kind, b reference-kind)

walk-program void(a program, f void mut(where uri-and-range, kind reference-kind, x doc-comment-reference))
	for _, module in a.all-modules
		for range, kind, thing in walk-module module, a.common-types
			f[(module.uri, range), kind, thing]

walk-any-decl void(common-types common-types, decl any-decl, f cb-thing)
	the ctx = common-types,
	match decl
	as fun-decl
		walk-fun decl, f
	as spec-decl
		walk-spec decl, f
	as struct-alias
		walk-struct-alias decl, f
	as struct-decl
		walk-struct-decl decl, f
	as test_
		walk-test decl, f
	as var-decl
		walk-var-decl decl, f

walk-module record(module crow-module, common-types common-types)
for-loop void(a walk-module, f cb-thing) # TODO: expose as a 'for' loop --------------------------------------------------------
	the ctx = a.common-types,
	module = a.module
	for x in module.aliases
		walk-struct-alias x, f
	for x in module.structs
		walk-struct-decl x, f
	for x in module.vars
		walk-var-decl x, f
	for x in module.specs
		walk-spec x, f
	for x in module.funs
		walk-fun x, f
	for x in module.tests
		walk-test x, f
	walk-doc-comment module.doc-comment, f

-ctx record
	common-types common-types
-common-types common-types() ctx
	the::ctx.common-types

-walk-struct-alias void(a struct-alias, f cb-thing) ctx
	walk-doc-comment a.doc-comment, f
	walk-type a.ast.target, a.target, a.visibility.explicit-kind-for-visibility, f

-explicit-kind-for-visibility reference-kind(a visibility)
	match a
	as private
		explicit-private
	as internal
		explicit-internal
	as public
		explicit-public

-walk-struct-decl void(a struct-decl, f cb-thing) ctx
	do if ast = a.source.struct-decl-ast
	walk-doc-comment a.doc-comment, f
	walk-struct-modifiers ast.modifiers, a, f
	match body = ast.body
	as builtin-type-ast
		()
	as enum-ast
		()
	as flags-ast
		()
	as record-ast
		walk-record body, a.body.record_!, f
	as sum-type-ast
		walk-sum-type body, a.body.sum-type!, a.visibility, f

-walk-struct-modifiers void(modifiers modifier-ast[], struct struct-decl, f cb-thing) ctx
	case-modifiers modifier-ast[] = filter modifiers, of mod
		mod.modifier-keyword-ast and mod.keyword == case_
	zip-if-size-eq case-modifiers, struct.sum-type-memberships, of mod, x
		for called in x.method-impls
			if called
				handle-call called, mod.range, (), sum-type-method-impl, f
		walk-type mod.modifier-keyword-ast!.type-arg!, x.sum-type, struct.visibility.explicit-kind-for-visibility, f

-walk-record void(ast record-ast, record_ record_, f cb-thing) ctx
	if params = ast.params
		do if params.size == record_.fields.size
		for field-ast, field in zip params, record_.fields
			type-ast = field-ast.single-destructure-ast.?type
			?walk-type type-ast, field.type, field.visibility.explicit-kind-for-visibility, f
	else
		for field-ast, field in zip ast.fields, record_.fields
			?walk-type field-ast.type, field.type, field.visibility.explicit-kind-for-visibility, f

-walk-sum-type void(ast sum-type-ast, a sum-type, struct-visibility visibility, f cb-thing) ctx
	zip-if-size-eq ast.types, a.listed-members, of type-ast, member
		walk-type type-ast, member.member, struct-visibility.explicit-kind-for-visibility, f
		for called in member.method-impls
			if called
				handle-call called, type-ast.range, (), sum-type-method-impl, f
	for method in a.methods
		walk-signature method, struct-visibility, f

-walk-var-decl void(a var-decl, f cb-thing) ctx
	walk-doc-comment a.doc-comment, f
	walk-type a.ast.type, a.type, a.visibility.explicit-kind-for-visibility, f
	walk-expr a.initializer.expr, f

-walk-spec void(a spec-decl, f cb-thing) ctx
	walk-doc-comment a.doc-comment, f
	walk-spec-uses a.ast.modifiers, a.body.parents, a.visibility, f
	for sig in a.sigs
		walk-signature sig, a.visibility, f

-walk-spec-uses void(modifiers modifier-ast[], specs specs, visibility visibility, f cb-thing) ctx
	spec-uses modifier-ast[] = filter modifiers, !!it.spec-use-ast
	zip-if-size-eq spec-uses, specs.inner, of mod, parent
		kind = visibility.explicit-kind-for-visibility
		if arg = mod.spec-use-ast!.type-arg
			walk-type-args-may-unpack-tuple arg, parent.type-args, kind, f
		f[mod.name-or-keyword-range, kind, parent.decl.to]

-walk-signature void(a signature, visibility visibility, f cb-thing) ctx
	walk-doc-comment a.doc-comment, f
	kind = explicit-kind-for-visibility visibility
	ast = a.source.signature-ast!
	walk-type ast.return-type, a.return-type, kind, f
	walk-params ast.params, a.params, kind, ignore-locals, f

-walk-params void(asts destructure-ast[], params destructure[], kind reference-kind, include-locals include-locals, f cb-thing) ctx
	for x, y in zip asts, params
		walk-destructure x, y, kind, include-locals, f

walk-doc-comment void(a doc-comment, f cb-thing)
	for name, ref in zip a.ast.references, a.references
		f[name.range, comment, ref]

-walk-type void(ast type-ast, type type, kind reference-kind, f cb-thing) ctx
	match type
	as bogus-type
		()
	as type-param-index
		f[ast.range, kind, type]
	as struct-inst
		f[ast.name-range-or-range, kind, type.decl]
		walk-type-args ast, type.type-args, kind, f
-walk-type-args void(ast type-ast, type-args type-args, kind reference-kind, f cb-thing) ctx
	match ast
	as bogus-type-ast
		()
	as fun-type-ast
		return-type, param-type = only2! type-args
		walk-type ast.return-type, return-type, kind, f
		walk-destructure-type ast.param, param-type, kind, f
	as map-type-ast
		do if key, value = only2 type-args
		walk-type ast.key, key, kind, f
		walk-type ast.value, value, kind, f
	as name-and-range
		# For a type alias, 'typeArgs' may be non-empty as it comes from the alias' target type.
		# But ignore them in any case.
		()
	as suffix-name-type-ast
		walk-type-args-may-unpack-tuple ast.left, type-args, kind, f
	as suffix-special-type-ast
		walk-type-args-may-unpack-tuple ast.left, type-args, kind, f
	as tuple-type-ast
		for member, arg in zip ast.members, type-args.slow-to-array
			walk-type member, arg, kind, f
-walk-type-args-may-unpack-tuple void(ast type-ast, type-args type-args, kind reference-kind, f cb-thing) ctx
	do if type-arg-asts type-ast[] =
		if type-args.size == 1
			ast,
		else
			ast.tuple-type-ast.?members
	for member, arg in zip type-arg-asts, type-args.slow-to-array
		walk-type member, arg, kind, f

-walk-simple-destructure void(ast name-and-range?, destructure simple-destructure, f cb-thing)
	if ast
		f[ast.range, declare-local, destructure.local!]

-walk-opt-local void(ast match-ast, local local?, f cb-thing)
	if local
		f[ast.local!.range, declare-local, local]

-include-locals enum(include-locals, ignore-locals)
-walk-destructure void
	ast destructure-ast
	destructure destructure
	kind reference-kind
	include-locals include-locals
	f cb-thing
do ctx
	match ast
	as name-and-range
		match include-locals
		as include-locals
			f[ast.range, declare-local, destructure.local!]
		as ignore-locals
			()
	as single-destructure-ast
		match include-locals
		as include-locals
			f[ast.range, declare-local, destructure.local!]
		as ignore-locals
			()
		?walk-type ast.type, destructure.type, kind, f
	as ignore-destructure-ast
		?walk-type ast.type, destructure.type, kind, f
	as void-destructure-ast
		()
	as array
		do unless is-bogus destructure.type
		zip-if-size-eq ast, destructure.destructure-split!.parts, of part-ast, part
			walk-destructure part-ast, part, kind, include-locals, f
-walk-destructure-type void(ast destructure-ast, type type, kind reference-kind, f cb-thing) ctx
	match ast
	as name-and-range
		()
	as single-destructure-ast
		?walk-type ast.type, type, kind, f
	as ignore-destructure-ast
		?walk-type ast.type, type, kind, f
	as void-destructure-ast
		()
	as array
		do unless is-bogus type
		types = as-tuple! common-types, type
		for part-ast, part-type in zip ast, types.slow-to-array
			walk-destructure-type part-ast, part-type, kind, f

-walk-fun void(a fun-decl, f cb-thing) ctx
	ast = a.source
	do if ast.fun-decl-ast
	walk-doc-comment a.doc-comment, f
	walk-type ast.return-type, a.return-type, a.visibility.explicit-kind-for-visibility, f
	include-locals = if as-expr a.body
		include-locals
	else
		ignore-locals
	walk-params ast.params, a.params, a.visibility.explicit-kind-for-visibility, include-locals, f
	walk-spec-uses ast.modifiers, a.specs, a.visibility, f
	match body = a.body
	as auto-fun
		for c in body.members
			handle-call c, a.name-range.range, (), auto, f
	as expr
		walk-expr body, f
	as expr-with-allocated-locals
		walk-expr body.expr, f
	else
		()

-walk-test void(a test_, f cb-thing) ctx
	walk-doc-comment a.doc-comment, f
	walk-expr a.body.expr, f

-walk-expr void(expr expr, f cb-thing) ctx
	each-descendent-expr-including expr, of e
		match e
		as assert-or-forbid-expr
			()
		as bogus-call-expr
			()
		as bogus-expr
			()
		as bogus-wrong-type-expr
			()
		as call-expr
			handle-call e.called, e.ast.name-range, e.ast.call-ast.?type-arg, explicit-private, f
		as call-named-new-expr
			handle-call e.called, e.ast.name-range, (), explicit-private, f # TODO: name-range doesn't make sense for named-new ........
		as call-option-expr
			handle-call e.called, e.ast.name-or-subscript-range, e.ast.type-arg, explicit-private, f
		as finally-expr
			()
		as force-expr
			()
		as if-expr
			()
		as lambda-expr
			if !e.is-ignore and p = e.ast.param
				walk-destructure p, e.param, explicit-private, include-locals, f
		as let-expr
			walk-destructure e.destructure-ast, e.destructure, explicit-private, include-locals, f
		as let-the-expr
			walk-type e.ast.type, e.the-type, explicit-private, f
		as list-expr
			handle-call e.called, e.ast.range, (), explicit-private, f
		as literal-scalar-expr
			()
		as literal-string-like-expr
			()
		as local-get-expr
			f[e.range, get-local, e.local]
		as local-get-and-refine-expr
			f[e.range, get-local, e.local]
		as local-set-expr
			f[e.range, set-local, e.local]
		as logical-expr
			()
		as loop-expr
			()
		as loop-break-expr
			()
		as loop-continue-expr
			()
		as loop-while-or-until-expr
			()
		as match-enum-expr
			walk-opt-local e.ast, e.matched-local, f
			zip-if-size-eq e.ast.cases, e.cases, of case-ast, case_
				f[case-ast.name-range, explicit-private, case_.member]
		as match-scalar-expr
			walk-opt-local e.ast, e.matched-local, f
		as match-string-like-expr
			walk-opt-local e.ast, e.matched-local, f
		as match-sum-type-expr
			walk-opt-local e.ast, e.matched-local, f
			handle-match-sum-type-cases e.ast.cases, e.cases, f
		as not-expr
			()
		as seq-expr
			()
		as the-expr
			walk-type e.ast.type, e.type, explicit-private, f
		as throw-expr
			()
		as trusted-expr
			()
		as try-expr
			handle-catches e.ast.catches, e.catches, f
		as try-let-expr
			handle-catch e.ast.catch_, e.catch_, f
		as typed-expr
			walk-type e.ast.type, e.type, explicit-private, f
		as unpack-option
			walk-destructure e.ast.destructure, e.destructure, explicit-private, include-locals, f

-handle-call void(called called, range source-range, type-arg type-ast?, kind reference-kind, f cb-thing) ctx
	match called
	as called-bogus
		f[range, kind, called.decl.to]
	as fun-inst
		f[range, kind, called.decl]
		if type-arg
			walk-type-args-may-unpack-tuple type-arg, called.type-args, explicit-private, f
		for impl in called.spec-impls
			handle-call impl, range, (), spec-impl, f
	as called-spec-sig
		f[range, kind, called]

-to doc-comment-reference(a called-decl)
	match a
	as fun-decl then a
	as called-spec-sig then a

-handle-catches void(asts catch-ast[], catches catch_[], f cb-thing)
	zip-if-size-eq asts, catches, of ast, catch_
		handle-catch ast, catch_, f
-handle-catch void(ast catch-ast, catch_ catch_, f cb-thing)
	walk-simple-destructure ast.name, catch_.destructure, f
	if x = ast.as_
		f[x.type-name.range, explicit-private, catch_.caught-type.decl]

-handle-match-sum-type-cases void(case-asts case-ast[], cases match-sum-type-case[], f cb-thing)
	zip-if-size-eq case-asts, cases, of case-ast, case_
		handle-match-sum-type-case case-ast.member, case_, f
-handle-match-sum-type-case void(ast case-member-ast, case_ match-sum-type-case, f cb-thing)
	f[ast.name-range, explicit-private, case_.case-type.decl]
