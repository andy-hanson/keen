import
	../model/ast
	../model/model
	../model/source-range
	../util/util

cb-thing alias
	void mut(range source-range, kind reference-kind, x doc-comment-reference)
reference-kind enum
	| Reference is explicit. We distinguish these if they are part of a declaration.
	explicit-public
	explicit-internal
	explicit-private
	| Function is used as a method implementation
	sum-type-method-impl
	| Function is called by an 'auto' fun
	auto
	| Function is used to implement a spec
	spec-impl
	| Implicit initializer of a var
	var-initializer
	| Thing is referenced in a doc comment
	comment
	declare-local
	get-local
	set-local
== bool(a reference-kind, b reference-kind)
to symbol(a reference-kind)
show string(a reference-kind)
	a.to::symbol to

walk-program void(a program, f void mut(where uri-and-range, kind reference-kind, x doc-comment-reference))
	for _, module in a all-modules
		a.common-types walk-module module, (range, kind, thing) =>
			f[(module.uri, range), kind, thing]

walk-any-decl void(common-types common-types, decl any-decl, f cb-thing)
	ctx walk-ctx = common-types,
	match decl
	as fun-decl x
		x walk-fun f
	as spec-decl x
		x walk-spec f
	as struct-alias x
		x walk-struct-alias f
	as struct-decl x
		ctx walk-struct-decl x, f
	as test_ x
		x walk-test f
	as var-decl x
		x walk-var-decl f

walk-module void(common-types common-types, module crow-module, f cb-thing)
	ctx walk-ctx = common-types,
	for x in module aliases
		x walk-struct-alias f
	for x in module structs
		ctx walk-struct-decl x, f
	for x in module vars
		x walk-var-decl f
	for x in module specs
		x walk-spec f
	for x in module funs
		x walk-fun f
	for x in module tests
		x walk-test f
	module.doc-comment walk-doc-comment f

-walk-ctx record
	common-types common-types

-walk-struct-alias void(a struct-alias, f cb-thing)
	a.doc-comment walk-doc-comment f
	a.ast.target walk-type a.target, a.visibility.explicit-kind-for-visibility, f

-explicit-kind-for-visibility reference-kind(a visibility)
	match a
	as private
		explicit-private
	as internal
		explicit-internal
	as public
		explicit-public

-walk-struct-decl void(ctx walk-ctx, a struct-decl, f cb-thing)
	guard ast ?= a.source struct-decl-ast
	a.doc-comment walk-doc-comment f
	ast.modifiers walk-struct-modifiers a, f
	match ast body
	as builtin-type-ast
		()
	as enum-ast _
		ctx walk-enum-storage ast.modifiers, a.body.enum_!.storage_, f
	as flags-ast _
		ctx walk-enum-storage ast.modifiers, a.body.flags_!.storage_, f
	as record-ast x
		x walk-record a.body.record_!, f
	as sum-type-ast x
		x walk-sum-type a.body.sum-type!, a.visibility, f

-walk-struct-modifiers void(modifiers modifier-ast[], struct struct-decl, f cb-thing)
	case-modifiers modifier-keyword-ast[] = for* mod in modifiers
		guard k ?= mod modifier-keyword-ast
		guard k.keyword == case_
		- k
	case-modifiers zip-if-size-eq struct.sum-type-memberships, (mod, x) =>
		for opt in x method-impls
			guard called ?= opt
			called handle-call mod.range, (), sum-type-method-impl, f
		mod.type-arg! walk-type x.sum-type, struct.visibility.explicit-kind-for-visibility, f

-walk-enum-storage void(ctx walk-ctx, modifiers modifier-ast[], storage-type integral-type, f cb-thing)
	for mod in modifiers
		guard kw ?= mod modifier-keyword-ast
		guard kw.keyword == storage_
		guard type-arg ?= kw type-arg
		f[type-arg.range, explicit-private, ctx.common-types[storage-type].decl]

-walk-record void(ast record-ast, record_ record_, f cb-thing)
	if params ?= ast params
		guard params-array ?= params array
		for field-ast, field in params-array zip record_.fields
			guard type-ast ?= field-ast.single-destructure-ast?.type
			type-ast walk-type field.type, field.visibility.explicit-kind-for-visibility, f
	else
		for field-ast, field in ast.fields zip record_.fields
			guard t ?= field-ast type
			t walk-type field.type, field.visibility.explicit-kind-for-visibility, f

-walk-sum-type void(ast sum-type-ast, a sum-type, struct-visibility visibility, f cb-thing)
	ast.types zip-if-size-eq a.listed-members, (type-ast, member) =>
		type-ast walk-type member.member, struct-visibility.explicit-kind-for-visibility, f
		for opt in member method-impls
			guard called ?= opt
			called handle-call type-ast.range, (), sum-type-method-impl, f
	for method in a methods
		method walk-signature struct-visibility, f

-walk-var-decl void(a var-decl, f cb-thing)
	a.doc-comment walk-doc-comment f
	a.ast.type walk-type a.type, a.visibility.explicit-kind-for-visibility, f
	a.initializer walk-expr f

-walk-spec void(a spec-decl, f cb-thing)
	a.doc-comment walk-doc-comment f
	a.ast.modifiers walk-spec-uses a.body.parents, a.visibility, f
	for sig in a sigs
		sig walk-signature a.visibility, f

-walk-spec-uses void(modifiers modifier-ast[], specs specs, visibility visibility, f cb-thing)
	modifiers.spec-uses zip-if-size-eq specs.inner, (mod, parent) =>
		kind = visibility explicit-kind-for-visibility
		if arg ?= mod type-arg
			arg walk-type-args-may-unpack-tuple parent.type-args, kind, f
		f[mod.name-range, kind, parent.decl]

-spec-uses spec-use-ast[](modifiers modifier-ast[])
	for* mod in modifiers
		guard use ?= mod spec-use-ast
		- use

-walk-signature void(a signature, visibility visibility, f cb-thing)
	a.doc-comment walk-doc-comment f
	kind = visibility explicit-kind-for-visibility
	ast = a.source signature-ast!
	ast.return-type walk-type a.return-type, kind, f
	match ast params
	as array params
		for param-ast, param in params zip a.params
			param-ast walk-destructure param, kind, ignore-locals, f
	as varargs-ast _
		()

-walk-params void(ast params-ast, params params, kind reference-kind, include-locals include-locals, f cb-thing)
	match ast
	as array asts
		for x, y in asts zip params.params-array
			x walk-destructure y, kind, include-locals, f
	as varargs-ast x
		x.param walk-destructure params.varargs!.param, kind, include-locals, f

walk-doc-comment void(a doc-comment, f cb-thing)
	for name, ref in a.ast.references zip a.references
		f[name.range, comment, ref]

-walk-type void(ast type-ast, type type, kind reference-kind, f cb-thing)
	match type
	as bogus-type _
		()
	as type-param-index x
		f[ast.range, kind, x]
	as struct-inst x
		f[ast.name-range-or-range, kind, x.decl]
		ast walk-type-args x.type-args, kind, f
-walk-type-args void(ast type-ast, type-args type-args, kind reference-kind, f cb-thing)
	match ast
	as bogus-type-ast _
		()
	as fun-type-ast x
		return-type, _ = type-args only2
		x.return-type walk-type return-type, kind, f
		# TODO: for the params, we possibly need to destructure 'param-type'
	as map-type-ast x
		guard type-args.size == 2
		key, value = type-args only2
		x.key walk-type key, kind, f
		x.value walk-type value, kind, f
	as name-and-range _
		# For a type alias, 'typeArgs' may be non-empty as it comes from the alias' target type.
		# But ignore them in any case.
		()
	as suffix-name-type-ast x
		x.left walk-type-args-may-unpack-tuple type-args, kind, f
	as suffix-special-type-ast x
		x.left walk-type-args-may-unpack-tuple type-args, kind, f
	as tuple-type-ast x
		for member, arg in x.members zip type-args.inner
			member walk-type arg, kind, f
-walk-type-args-may-unpack-tuple void(ast type-ast, type-args type-args, kind reference-kind, f cb-thing)
	opt-type-arg-asts type-ast[]? = if type-args.size == 1
		ast,
	else
		ast.tuple-type-ast?.members
	guard type-arg-asts ?= opt-type-arg-asts # TODO: should be able to use 'if' in 'guard' directly ---------------------------
	for member, arg in type-arg-asts zip type-args.inner
		member walk-type arg, kind, f

-include-locals enum(include-locals, ignore-locals)
-walk-destructure void(ast destructure-ast, destructure destructure, kind reference-kind, include-locals include-locals, f cb-thing)
	match ast
	as single-destructure-ast x
		match destructure
		as destructure-ignore _
			()
		as local local
			match include-locals
			as include-locals
				f[x.range, declare-local, local]
			as ignore-locals
				()
		as destructure-split _
			throw unreachable
		if t ?= x type
			t walk-type destructure.type, kind, f
	as void-destructure-ast _
		()
	as array parts
		parts walk-destructure-parts destructure, kind, include-locals, f
-walk-destructure-parts void(parts destructure-ast[], destructure destructure, kind reference-kind, include-locals include-locals, f cb-thing)
	guard destructure.type !is-bogus
	parts zip-if-size-eq destructure.destructure-split!.parts, (part-ast, part) =>
		part-ast walk-destructure part, kind, include-locals, f

-walk-fun void(a fun-decl, f cb-thing)
	guard ast ?= a.source fun-decl-ast
	a.doc-comment walk-doc-comment f
	ast.return-type walk-type a.return-type, a.visibility.explicit-kind-for-visibility, f
	include-locals = match a body
	as expr _
		include-locals
	else
		ignore-locals
	ast.params walk-params a.params, a.visibility.explicit-kind-for-visibility, include-locals, f
	ast.modifiers walk-spec-uses a.specs, a.visibility, f
	match a body
	as auto-fun af
		for c in af members
			c handle-call a.name-range.range, (), auto, f
	as expr x
		x walk-expr f
	else
		()

-walk-test void(a test_, f cb-thing)
	a.doc-comment walk-doc-comment f
	a.body walk-expr f

-walk-expr void(expr expr, f cb-thing)
	expr each-descendent-expr-including e =>
		match e
		as assert-or-forbid-expr _
			()
		as bogus-call-expr _
			()
		as bogus-expr _
			()
		as bogus-wrong-type-expr _
			()
		as call-expr x
			x.called handle-call x.ast.name-range, x.ast.call-ast?.type-arg, explicit-private, f
		as call-named-new-expr x
			x.called handle-call x.ast.name-range, (), explicit-private, f # TODO: name-range doesn't make sense for named-new ........
		as call-option-expr x
			x.called handle-call x.ast.name-range, x.ast.type-arg, explicit-private, f
		as extern-expr _
			()
		as finally-expr _
			()
		as force-expr _
			()
		as if-expr _
			()
		as lambda-expr x
			unless x is-ignore
				x.ast.param walk-destructure x.param, explicit-private, include-locals, f
		as let-expr x
			x.ast.destructure walk-destructure x.destructure, explicit-private, include-locals, f
		as list-expr _
			()
		as literal-float-expr _
			()
		as literal-integral-expr _
			()
		as literal-string-like-expr _
			()
		as local-get-expr x
			f[e.range, get-local, x.local]
		as local-set-expr x
			f[e.range, set-local, x.local]
		as logical-expr _
			()
		as loop-expr _
			()
		as loop-break-expr _
			()
		as loop-continue-expr _
			()
		as loop-while-or-until-expr _
			()
		as match-enum-expr x
			x.ast.cases zip-if-size-eq x.cases, (case-ast, case_) =>
				f[case-ast.name-range, explicit-private, case_.member]
		as match-integral-expr _
			()
		as match-string-like-expr _
			()
		as match-sum-type-expr x
			x.ast.cases handle-match-sum-type-cases x.cases, f
		as seq-expr _
			()
		as throw-expr _
			()
		as trusted-expr _
			()
		as try-expr x
			x.ast.catches handle-match-sum-type-cases x.catches, f
		as try-let-expr x
			x.ast.catch-member handle-match-sum-type-case x.catch_, f
		as typed-expr x
			x.ast.type walk-type x.type, explicit-private, f
		as unpack-option x
			x.ast.destructure walk-destructure x.destructure, explicit-private, include-locals, f

-handle-call void(called called, range source-range, type-arg type-ast?, kind reference-kind, f cb-thing)
	match called
	as called-bogus b
		f[range, kind, b.decl.to]
	as fun-inst inst
		f[range, kind, inst.decl]
		if x ?= type-arg
			x walk-type-args-may-unpack-tuple called.fun-inst!.type-args, explicit-private, f
		for impl in inst spec-impls
			impl handle-call range, (), spec-impl, f
	as called-spec-sig sig
		f[range, kind, sig]

-to doc-comment-reference(a called-decl)
	match a
	as fun-decl x
		x
	as called-spec-sig x
		x

-handle-match-sum-type-cases void(case-asts case-ast[], cases match-sum-type-case[], f cb-thing)
	case-asts zip-if-size-eq cases, (case-ast, case_) =>
		case-ast.member handle-match-sum-type-case case_, f
-handle-match-sum-type-case void(ast case-member-ast, case_ match-sum-type-case, f cb-thing)
	f[ast.name-range, explicit-private, case_.destructure.type.struct-inst!.decl]
	if destructure-ast ?= ast.as-name-ast?.destructure
		destructure-ast walk-destructure case_.destructure, explicit-private, include-locals, f
