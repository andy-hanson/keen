import
	../model/ast
	../model/model
	../model/uri
	../util/by-name
	./check/instantiate
	./parse-java-class
	../util/java-bytecode-types
	../util/perf

java-ctx spec instantiate-ctx, java-classes, common-types
java-classes interface mut
	ensure-java-class struct-decl(path path)
-ensure-java-class struct-decl(path path) java-classes
	ensure-java-class the::java-classes, path

fill-java-class-supertypes void(struct struct-decl, class_ parsed-java-class-header) java-ctx
	start = perf-now
	finally end-fill-java-class-supertypes start
	fill-supertypes class_, struct

get-java-module java-class-module(path path, struct struct-decl, class_ parsed-java-class-header) java-ctx
	start = perf-now
	finally end-get-java-module start
	body = parse-java-class-body class_
	fill-interface-methods class_, body.methods, struct
	funs = funs-for-java-class path, class_, body, struct
	path: path
	public-exports:
		funs: funs.to
		types-and-specs: to-by-name (struct,), of _ then throw unreachable

initial-struct-for-java-class struct-decl(path path) instantiate-ctx
	hash: next-hash
	source: struct-decl-source-java path,
		base = base-name path
		if _, rest = try-split-once base, "$"
			rest.to
		else
			base.to
	visibility: public
	purity: mut_
	purity-is-forced: false
	doc-comment-references: ()
	sum-type-memberships: ()
	body: struct-body-extern-java path

-fill-supertypes void(class_ parsed-java-class-header, type struct-decl) java-ctx
	type.specs := global-java-unsafe-specs
	is-throwable = if super = class_.super-class
		super == "java/lang/Throwable".parse-path or is-throwable ensure-java-class super
	if is-throwable
		type.sum-type-memberships :=
			-
				ast: ()
				sum-type: exception
				method-impls: ((),) # The type will not actually be emitted, so don't bother with this
-is-throwable bool(a struct-decl) common-types
	some a.sum-type-memberships, it.sum-type == exception

-fill-interface-methods void(class_ parsed-java-class-header, parsed-methods parsed-method[], type struct-decl) java-ctx
	do if class_.access[interface_]
	type.body :=
		:: sum-type
		kind: java-interface
		listed-members: ()
		methods: for* method in parsed-methods
			do if method.access-flags[abstract_]
			# Ignore varargs; they just become normal array parameters
			(method.access-flags & ~varargs) is (abstract_ | public)
			return-type, params = method-return-type-and-params method
			-
				container: type
				source: signature-source-java method.name
				return-type: return-type
				params: params
				doc-comment-references: ()

-funs-for-java-class fun-decl[]
	path path
	header parsed-java-class-header
	class_ parsed-java-class-body
	struct struct-decl
do java-ctx
	class-type = only-inst struct
	is-interface = header.access[interface_]
	do with out in build
	for field in class_.fields
		do if field.access-flags[public | static] # TODO: support instance fields
		out ~=
			hash: next-hash
			source: fun-source-java path, field.name
			visibility: public
			return-type: to-type field.type
			params: ()
			specs: global-java-unsafe-specs
			doc-comment-references: ()
			body:
				:: fun-body-extern-java
				static-field, path

	for method in class_.methods
		do if method.access-flags[public]
		is-static = method.access-flags[static]
		is-constructor = method.name == "<init>"
		return-type, most-params = method-return-type-and-params method
		do if body fun-body-extern-java = if is-static
			kind: if is-interface then static-method-of-interface else static-method-of-class
			class_: path
		elif is-constructor
			constructor, path
		elif is-interface
			()
		else
			virtual, path
		out ~=
			hash: next-hash
			source: fun-source-java path, if is-constructor then "new" else method.name
			visibility: public
			return-type: if is-constructor then class-type else return-type
			params: if is-static or is-constructor
				most-params
			else
				- "this".local-source-generated, class-type
				-- most-params
			specs: global-java-unsafe-specs
			doc-comment-references: ()
			body: body

	if sum = struct.body.sum-type
		sum.kind is java-interface
		for index, method in with-index sum.methods
			out ~= fun-for-method struct, class-type, index, method

-method-return-type-and-params (type, destructure[])(method parsed-method) java-ctx
	- to-type method.descriptor.return-type
	- for i, x in with-index method.descriptor.param-types
		:: local
		source: local-source-generated "p{i}"
		type: to-type x

-to-type type(type java-type) java-ctx
	match type
	as void
		void
	as java-primitive-type
		type-from-primitive type
	as java-array-type
		buffer[to-type type.element]
	as path
		only-inst ensure-java-class type

-type-from-primitive type(type java-primitive-type) common-types
	match type
	as T_BOOLEAN
		bool
	as T_CHAR
		nat16
	as T_FLOAT
		float32
	as T_DOUBLE
		float64
	as T_BYTE
		int8
	as T_SHORT
		int16
	as T_INT
		int32
	as T_LONG
		int64
