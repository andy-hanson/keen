import
	crow/col/mut-slice
	crow/format/binary
	crow/unsafe
	../../crow/col/private/array-low-level: view-indices
	../model/uri
	../util/java-bytecode-types
	../util/perfhax

parsed-java-class record
	access class-access
	this-class path
	super-class path?
	interfaces path[]
	fields parsed-field[]
	methods parsed-method[]
parse-java-class parsed-java-class(content nat8[])
	start = perf-now
	finally start end-parse-java-class
	reader nat8 array-mut-iterator = content,
	reader.take32 is 0xcafebabe
	version = reader take32
	assert version >= 69
	constants = content.safe-reinterpret-cast read-constant-pool reader
	access class-access = reader.take16.to!
	this-class = reader read-class-reference constants
	super-class = reader read-optional-class-reference constants
	interfaces = reader read-array of then reader read-class-reference constants
	fields = reader read-array of then reader read-field constants
	methods = reader read-array of then reader read-method constants
	_ = reader read-attributes constants
	assert reader is-at-end
	access: access
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: fields
	methods: methods

-read-array[t] t[](reader nat8 array-mut-iterator, f t mut())
	for _ nat in 0 .. reader.take16.to
		f[]

parsed-field record
	access-flags field-access-flags
	name symbol
	type java-type
	attributes read-attribute[]
-read-field parsed-field(reader nat8 array-mut-iterator, constants constants)
	access-flags: reader.take16 to!
	name: reader read-utf8-reference constants to
	type: reader read-utf8-reference constants parse-type
	attributes: reader read-attributes constants

-constants record
	# Use arrays instead of maps for faster lookups
	all-char8s char8[]
	constant-strings nat32 range[]
	constant-classes path[]
-get-string nat32 range(a constants, index nat16)
	a.constant-strings[index to]
-get-class path(a constants, index nat16)
	a.constant-classes[index to]

parsed-method record
	access-flags method-access-flags
	name symbol
	descriptor method-descriptor
-read-method parsed-method(reader nat8 array-mut-iterator, constants constants)
	access-flags method-access-flags = reader.take16 to!
	name symbol = reader read-utf8-reference constants to
	descriptor = constants.all-char8s parse-method-descriptor do reader read-utf8-reference-2 constants
	_ = reader read-attributes constants
	access-flags: access-flags
	name: name
	descriptor: descriptor

method-descriptor record
	return-type java-type
	param-types java-type[]
| string is a class path such as "java/lang/Object"
java-type union(void, java-primitive-type, java-array-type, path)
	show string()
java-array-type record(element java-type)
show string(_ void)
	"void"
show string(a java-array-type)
	"{a.element.show}[]"

-parse-method-descriptor method-descriptor(all-char8s char8[], a nat32 range)
	index mut nat = a.low to
	all-char8s[index] is "("
	index +:= 1
	param-types java-type[] = with out in build
		until all-char8s[index] == ")"
			p, new-index = all-char8s read-type index
			out ~= p
			index := new-index
		index +:= 1
	return-type, new-index2 = all-char8s read-type index
	new-index2 is a.high.to
	return-type, param-types
-wrap-arrays java-type(type java-type, arrays nat)
	if arrays == 0 then type else type.java-array-type wrap-arrays arrays - 1
-parse-type java-type(a char8 array-view)
	char = a[0]
	match char
	as L
		a[end - 1] is ";"
		a[1 .. end - 1] as-path
	as "["
		a[1 .. end].parse-type java-array-type
	else
		char single-char-type
-read-type (java-type, nat)(all-char8s char8[], start nat)
	arrays mut nat = 0
	index mut nat = start
	loop
		char = all-char8s[index]
		match char
		as L
			end = all-char8s must-find index + 1, ";"
			break do # TODO: should be able to just write 'break' ...................................................................................
				- all-char8s[index + 1 .. end].as-path wrap-arrays arrays
				- end + 1
		as "["
			index +:= 1
			arrays +:= 1
			continue
		else
			break (char.single-char-type wrap-arrays arrays), index + 1

-must-find nat(xs char8[], start nat, to-find char8)
	index mut = start
	until xs[index] == to-find
		index +:= 1
	index

-single-char-type java-type(a char8)
	match a
	as B
		T_BYTE
	as C
		T_CHAR
	as D
		T_DOUBLE
	as F
		T_FLOAT
	as I
		T_INT
	as J
		T_LONG
	as S
		T_SHORT
	as V
		()::void
	as Z
		T_BOOLEAN
	else
		throw unreachable

-read-attribute record
	attribute-name symbol
-read-attributes read-attribute[](reader nat8 array-mut-iterator, constants constants)
	reader read-array of
		reader read-attribute constants
-read-attribute read-attribute(reader nat8 array-mut-iterator, constants constants)
	attribute-name = reader read-utf8-reference constants
	reader skip-n reader.take32.to
	attribute-name: attribute-name to

-read-utf8-reference char8 array-view(reader nat8 array-mut-iterator, constants constants)
	range = reader read-utf8-reference-2 constants
	constants.all-char8s[range.low.to .. range.high.to]
-read-utf8-reference-2 nat32 range(reader nat8 array-mut-iterator, constants constants) # TODO:NAME -------------------------------------------------
	constants get-string reader.take16
-read-class-reference path(reader nat8 array-mut-iterator, constants constants)
	constants get-class reader.take16
-read-optional-class-reference path?(reader nat8 array-mut-iterator, constants constants)
	index = reader take16
	unless index == 0
		constants get-class index

# https://docs.oracle.com/javase/specs/jvms/se21/html/jvms-4.html#jvms-4.4
-read-constant-pool constants(all-char8s char8[], reader nat8 array-mut-iterator)
	constants-pool-count = reader take16
	constant-pool-index mut nat16 = 1
	constant-strings-builder nat32 range mut-slice = constants-pool-count.to fill 0 .. 0
	constant-classes nat16 mut-slice = constants-pool-count.to fill 0
	while constant-pool-index < constants-pool-count
		kind = reader take
		constant-pool-index +:= match kind
		as 1
			# CONSTANT_Utf8_info
			bytes = reader take-n reader.take16.to
			# Java does not really use standard UTF8, but this shouldn't matter for method and type names
			indices = bytes view-indices
			constant-strings-builder[constant-pool-index to] := indices.low.to .. indices.high.to
			1
		as 3
			# CONSTANT_Integer_info
			reader skip-n 4
			1
		as 4
			# CONSTANT_Float_info
			reader skip-n 4
			1
		as 5
			# CONSTANT_Long_info
			reader skip-n 8
			2
		as 6
			# CONSTANT_Double_info
			reader skip-n 8
			2
		as 7
			# CONSTANT_Class_info
			constant-classes[constant-pool-index to] := reader take16
			1
		as 8
			# CONSTANT_String_info
			reader skip-n 2
			1
		as 9
			# CONSTANT_Fieldref_info
			reader skip-n 4
			1
		as 10
			# CONSTANT_Methodref_info
			reader skip-n 4
			1
		as 11
			# CONSTANT_InterfaceMethodref_info
			reader skip-n 4
			1
		as 12
			# CONSTANT_NameAndType_info
			reader skip-n 4
			1
		as 15
			# CONSTANT_MethodHandle_info
			reader skip-n 3
			1
		as 16
			# CONSTANT_MethodType_info
			reader skip-n 2
			1
		as 18
			# CONSTANT_InvokeDynamic_info
			reader skip-n 4
			1
		else
			error log "Unexpected constant kind {kind}"
			throw todo
	constant-pool-index is constants-pool-count
	all-char8s: all-char8s
	constant-strings: trusted constant-strings-builder cast-immutable
	constant-classes: for x in constant-classes
		if x == 0
			"" as-path
		else
			range = constant-strings-builder[x to]
			all-char8s[range.low.to .. range.high.to] as-path
