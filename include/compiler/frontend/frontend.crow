import
	../lib/lsp/lsp-types
	../model/ast
	../model/model
	../model/parse-diag
	../model/source-range
	../model/uri
	../util/enum-map
	../util/perf
	../util/util
	./all-insts
	./check/check
	./check/check-ctx
	./check/detect-unused-internal
	./check/get-common-funs
	./check/instantiate
	./config
	./java-externs
	./lang
	./parse/parse
	./parse-java-class
	./show-model

frontend record mut, java-ctx case
	-crow-include-dir uri
	-common-uris common-uris
	-common-files mut (common-module, crow-file) enum-map
	-unknown uri mut-set
	-loading uri mut-set
	-all-insts all-insts
	-line-and-column-getters-map mut line-and-column-getter[uri]
	| Set after 'bootstrap.crow' is compiled
	-common-types-option mut common-types?
	-crow-files crow-file mut[uri]
	| Number of crow-files without {module} set
	-count-uncompiled-crow-files mut nat
	-config-files config-file mut[uri]
	| Key is the Java class path such as "java/lang/Object"
	-java-class-files java-class-file mut[path]
	-other-files other-file mut[uri]
	| Set of crow files which are ready to compile immediately.
	| (Parsing and resolving imports is always done immediately.)
	| This doesn't include files whose imports are not yet compiled.
	| If all import uris are resolved but nothing is workable, there must be a circular import.
	-workable-java path mut-set
	-workable-crow uri mut-set
instantiate-ctx instantiate-ctx(a frontend)
	- a all-insts
common-types common-types(a frontend)
	a common-types-option!
ensure-java-class struct-decl(a frontend, path path)
	a ensure-java-class-file path, header-only type

show-ctx show-ctx(a frontend) # TODO: THIS ONE IS JUST FOR DEBUG _----------------------------------------------------------------
	a show-ctx (), ()
show-ctx show-ctx(a frontend, uris-info uris-info, options show-options)
	line-and-column-getters: a line-and-column-getters
	file-content-getters: a file-content-getters
	uris-info: uris-info
	options: options

line-and-column-getters line-and-column-getters(a frontend)
	a.line-and-column-getters-map my-line-and-column-getters

new frontend(crow-include-dir uri)
	common-uris = crow-include-dir common-uris
	res frontend =
		crow-include-dir: crow-include-dir
		common-uris: common-uris
		common-files: for _, uri in common-uris
			# Dummy value, about to get overwritten
			uri: uri
			referenced-by: ()
			ast-or-diag: unknown
			config-file: unknown, ()
			config: ()
			resolved-imports: ()
			module: ()
		unknown: ()
		loading: ()
		all-insts: ()
		line-and-column-getters-map: ()
		common-types-option: ()
		crow-files: ()
		count-uncompiled-crow-files: 0
		config-files: ()
		java-class-files: ()
		other-files: ()
		workable-java: ()
		workable-crow: ()
	res.common-files := for _, uri in common-uris
		res ensure-crow-file uri
	res

| Note: This is initially empty and the fields fill in from top to bottom in various steps.
| First the file gets content, then it gets parsed, then its config is determined, then imports are resolved, then a module is built.
-crow-file record mut
	uri uri
	| Uris are for {crow-file}s
	referenced-by uri mut-set
	ast-or-diag mut ast-or-diag
	config-file config-file
	config mut config?
	| Also includes re-exports. Set once we have config.
	resolved-imports mut mostly-resolved-import[]?
	module mut crow-module?
has-module bool(a crow-file) # TODO: inline ----------------------------------------------------------------------------------
	_ ?= a module
must-have-module crow-module(a crow-file) # TODO: inline ----------------------------------------------------------------------------------
	a.module!

-config-file record mut
	# If this is 'not-found' (and it usually is not-found), we will ignore it and use the parent
	config mut config-or-diag
	# Missing only for the root file
	parent config-file?
-config-or-diag union(config, read-file-diag)

-java-class-file record mut
	type struct-decl
	parsed mut java-class-or-diag
	work-needed mut java-work-kind
	has-filled-in-supertypes mut bool
	| This will be an empty option if we don't need to import this Java class as a module
	module mut java-class-module?
	| Uris are for {crow-file}s
	referenced-by-crow uri mut-set
	| Subclasses or interface implementers must be processed after their supertypes.
	inheritors path mut-set

| If a Java class has only come up as a type, we can process the header only.
| If it is imported as a module, we must process the entire class including methods.
-java-work-kind enum(header-only, all)
-== bool(a java-work-kind, b java-work-kind)
-<=> comparison(a java-work-kind, b java-work-kind)
-to json(a java-work-kind)

-java-class-or-diag union(parsed-java-class-header, read-file-diag)

-ast-or-diag union(file-ast, read-file-diag)

-other-file record mut
	uri uri
	content mut read-file-result
	| Uris are for {crow-file}s
	referenced-by uri mut-set

make-program-with-main program-with-main(a frontend, main main-kind, targets build-target set)
	configs uri set = match main
	as main-kind-main-function _
		()
	as main-kind-tests-in-config x
		- x config-uri
	as main-kind-tests-at-uri _
		()
	a program-with-main-from-program (a make-program configs), main, targets
program-with-main-from-program program-with-main
	a frontend
	program program
	main main-kind
	targets build-target set
do
	program, do (a.all-insts,) get-main-fun-and-diagnostics program, main, targets

make-program program(a frontend, fully-loaded-configs uri set)
	start = perf-now
	finally start end-make-program
	assert a.files-state == all-loaded
	common-modules (common-module, crow-module) enum-map = for _, x in a common-files
		x module!
	ctx instantiate-ctx = a.all-insts,
	common-types = a common-types
	common-funs, common-funs-diagnostics = ctx get-common-funs common-types, common-modules
	all-modules crow-module[uri] = for uri, file in a crow-files
		uri, file.must-have-module
	unused-diagnostics = all-modules detect-unused-internal common-types, fully-loaded-configs
	all-configs: for* uri, x in a config-files
		if config ?= x.config config
			- uri, config
	all-modules: all-modules
	java-modules: for* k, v in a java-class-files
		if m ?= v module
			- k.to-java-uri, m
	additional-diagnostics: common-funs-diagnostics ~~ unused-diagnostics
	file-content-getters: a file-content-getters
	line-and-column-getters: a.line-and-column-getters-map my-line-and-column-getters
	common-funs: common-funs
	common-types: common-types
	other-types:
		java-Object: a.java-class-files["java/lang/Object" parse-path]!.type only-inst

# TODO: there's no real need for file-content-getters to even be an interface ----------------------------------------------------------------------
-file-content-getters file-content-getters(a frontend)
	a.line-and-column-getters-map my-file-content-getters
-my-file-content-getters record(line-and-column-getters line-and-column-getter[uri]) file-content-getters case
-subscript string(a my-file-content-getters, uri uri)
	(a.line-and-column-getters[uri] else ()).line-and-character-getter.source-text to
-get-file-content string(a frontend, uri uri)
	a.file-content-getters[uri]

# TODO: There's no reason for that to be an interface -----------------------------------------------------------------------------------------------
-my-line-and-column-getters record(lookup line-and-column-getter[uri]) line-and-column-getters case
-subscript line-and-column-getter(a my-line-and-column-getters, uri uri)
	a.lookup[uri] else ()

get-ast file-ast(a frontend, uri uri)
	a.crow-files[uri]! get-ast
-get-ast file-ast(a crow-file)
	a.ast-or-diag to-ast
line-and-character-getter line-and-character-getter(a frontend, uri uri)
	a get-ast uri line-and-character-getter

| Changes them to loading
flush-all-unknown-uris uri[](a frontend)
	res uri[] = a.unknown move-to
	a.loading ~~= res
	res

files-state enum(has-unknown, has-loading, all-loaded)
== bool(a files-state, b files-state)
to json(a files-state)
files-state files-state(a frontend)
	if a.unknown !is-empty
		has-unknown
	elif a.loading !is-empty
		has-loading
	else
		all-loaded

change-file void(a frontend, uri uri, changes text-document-content-change-event[])
	a set-file uri,
		string = a.line-and-column-getters-map[uri]!.line-and-character-getter apply-changes changes
		string.to::nat8[] to

-apply-changes string(lc line-and-character-getter, events text-document-content-change-event[])
	cur mut char8 array-view = lc source-text
	cur-lc mut = lc
	for i, event in events with-index
		if r ?= event range
			range source-range = cur-lc[r]
			cur :=
				-- cur[0 .. range.start.to] to
				-- event.text to
				-- cur[range.end.to .. end] to
		else
			cur := event.text to
		if i != events.size - 1
			cur-lc := cur line-and-character-getter-for-text
	cur to

read-file-result union(nat8 array-view, read-file-diag)
== bool(a read-file-result, b read-file-result)
set-file void(a frontend, uri uri, string string)
	a set-file uri, string.to::nat8[].to::(nat8 array-view)
set-file void(a frontend, uri uri, result read-file-result)
	# Files don't change *to* unknown, only change out of that state
	if d ?= result read-file-diag
		forbid d == unknown

	match uri file-type
	as class_
		path = uri as-java-uri!
		file = a ensure-java-class-file path, header-only
		match result
		as array-view content
			file.parsed := content parse-java-class
			if super ?= file.parsed.parsed-java-class-header! super-class
				(a ensure-java-class-file super, header-only).inheritors ~= path
			a add-to-workable-if-so path, file
		as read-file-diag x
			error log "ERROR READING JAVA CLASS? {path} {x.to::json}"
			# A missing Java module should probably be treated just like a missing Crow module
			throw todo # ------------------------------------------------------------------------------------------------------------------------
	as crow
		file = a ensure-crow-file uri
		file.ast-or-diag := match result
		as array-view content
			text char8 array-view = content safe-reinterpret-cast
			uri parse-file text, text.line-and-column-getter-for-text
		as read-file-diag x
			x
		a.line-and-column-getters-map ~:= uri, file.ast-or-diag.line-and-column-getter
		a updated-ast-or-config file
	as crow-config
		config-file = a ensure-config-file-for uri
		config-file.config := match result
		as array-view x
			uri parse-config x.as-string
		as read-file-diag x
			match x
			as unknown
				throw unreachable
			as not-found
				x
			as error
				uri config-for-diag error
		a.line-and-column-getters-map ~:= uri, config-file.config.line-and-column-getter
		files crow-file[] = for _, v in a crow-files then v
		for file in files
			a update-file-on-config-change file
	as other
		file = a ensure-other-file uri
		file.content := result
		for x in file referenced-by
			a add-to-workable-if-so a.crow-files[x]!

	if a.unknown remove uri
		forbid uri in a.loading
	else
		a.loading -= uri

	a do-dirty-work

-line-and-column-getter line-and-column-getter(a ast-or-diag)
	match a
	as file-ast x
		x line-and-column-getter
	as read-file-diag _
		()
-line-and-column-getter line-and-column-getter(a config-or-diag)
	match a
	as config x
		x line-and-column-getter
	as read-file-diag _
		()

-ensure-crow-file crow-file(a frontend, uri uri)
	assert uri.file-type == crow
	a.crow-files ensure uri, of
		a.unknown ~= uri
		a.count-uncompiled-crow-files +:= 1
		config-file = a ensure-config-file-for uri
		uri: uri
		referenced-by: ()
		ast-or-diag: unknown
		config-file: config-file
		config: config-file find-config
		resolved-imports: ()
		module: ()

-ensure-config-file-for config-file(a frontend, crow-uri uri)
	a ensure-config-file crow-uri.parent! / crow-config-base-name
-ensure-config-file config-file(a frontend, uri uri)
	dir = uri parent!
	parent config-file? = if parent-dir ?= dir parent
		a ensure-config-file parent-dir / crow-config-base-name
	a.config-files ensure uri, of
		a.unknown ~= uri
		config: unknown
		parent: parent

-ensure-java-class-file java-class-file(a frontend, path path, work-needed java-work-kind)
	res = a.java-class-files ensure path, of
		a.unknown ~= path.to-java-uri
		type: (a.all-insts,) initial-struct-for-java-class path
		parsed: unknown
		work-needed: work-needed
		has-filled-in-supertypes: ()
		module: ()
		referenced-by-crow: ()
		inheritors: ()
	if res.work-needed < work-needed
		res.work-needed := work-needed
		a add-to-workable-if-so path, res
	res

-ensure-other-file other-file(a frontend, uri uri)
	forbid uri.file-type == crow
	a.other-files ensure uri, of
		a.unknown ~= uri
		uri, unknown, ()

-to-ast file-ast(a ast-or-diag)
	match a
	as file-ast x
		x
	as read-file-diag x
		x file-ast-for-diag

-do-dirty-work void(a frontend)
	start = perf-now
	finally start end-dirty-work

	bootstrap = a.common-files[bootstrap]
	if a.workable-crow remove bootstrap.uri
		fa uri-and-ast = bootstrap.uri, bootstrap.config!, bootstrap.get-ast
		String = a ensure-java-class-file "java/lang/String".parse-path, header-only type
		module, common-types = a.show-ctx check-bootstrap a.all-insts, a.common-uris, fa, String.only-inst
		a.common-types-option := common-types
		bootstrap.module := module
		a.count-uncompiled-crow-files -:= 1
		a mark-all-non-bootstrap-modules-dirty bootstrap # since they all use common-types

	guard _ ?= a common-types-option
	loop
		if path ?= a.workable-java pop-arbitrary
			file = a.java-class-files[path]!
			header = file.parsed parsed-java-class-header!
			unless file has-filled-in-supertypes
				a fill-java-class-supertypes file.type, header
				file.has-filled-in-supertypes := true

			match file work-needed
			as header-only
				()
			as all
				file.module := a get-java-module path, file.type, header
			for x in file referenced-by-crow
				file.work-needed is all
				a add-to-workable-if-so a.crow-files[x]!
			for x in file inheritors
				inheritor = a.java-class-files[x]!
				unless _ ?= inheritor module
					a add-to-workable-if-so x, inheritor
			continue
		elif uri ?= a.workable-crow pop-arbitrary
			file = a.crow-files[uri]!
			file.module := a compile-non-bootstrap-module file
			a.count-uncompiled-crow-files -:= 1
			for importer in file referenced-by
				a add-to-workable-if-so a.crow-files[importer]!
			continue
		elif a.files-state == all-loaded and a.count-uncompiled-crow-files != 0
			a fix-circular-imports
			continue
		else
			break

| This may not fix all circular imports, but it's run in a loop
-fix-circular-imports void(a frontend)
	guard _, file ?= a.crow-files find !it.b.has-module
	cycle-builder uri mut[] = ()
	_ = a fix-circular-imports-recur cycle-builder, file
-fix-circular-imports-recur uri[](a frontend, cycle-builder uri mut[], file crow-file)
	forbid _ ?= file module
	cycle-builder ~= file uri
	import-index = file.resolved-imports! find-index! !it.is-import-workable
	next = file.resolved-imports![import-index] crow-file!
	cycle uri[] = if next.uri in cycle-builder
		cycle-builder move-to
	else
		a fix-circular-imports-recur cycle-builder, next
	new-import = cycle rotate-to-first file.uri circular-import
	file.resolved-imports := file.resolved-imports! update-at import-index, new-import
	_ = next.referenced-by remove file.uri
	a add-to-workable-if-so file
	cycle

-rotate-to-first[t] t[](values t[], first-value t) t equal
	index = values index-of! first-value
	values[index .. end] ~~ values[0 .. index]

-compile-non-bootstrap-module crow-module(a frontend, file crow-file)
	assert file is-workable
	assert common-types ?= a common-types-option # bootstrap must be compiled first
	ast uri-and-ast = file.uri, file.config!, file.get-ast
	imports = file.resolved-imports! fully-resolve-imports
	a.show-ctx check a.all-insts, a.common-uris, ast, imports, common-types

-update-file-on-config-change void(a frontend, file crow-file)
	guard best-config ?= file.config-file find-config
	unless config ?= file config and config.config-uri == best-config.config-uri
		file.config := best-config
		a updated-ast-or-config file
-find-config config?(a config-file)
	match a config
	as config x
		x
	as read-file-diag d
		match d
		as unknown
			()
		as not-found
			if p ?= a parent
				p find-config
			else
				default-config
		as error
			throw unreachable # It will be a config with diagnostics in this case

-updated-ast-or-config void(a frontend, file crow-file)
	if _ ?= file config
		a recompute-resolved-imports file
	else
		forbid _ ?= file resolved-imports or _ ?= file module

-recompute-resolved-imports void(a frontend, file crow-file)
	a mark-module-dirty file
	circular-import = if _ ?= file resolved-imports
		file clear-resolved-imports
	file.resolved-imports := a resolve-imports file.get-ast, file.config!, file.uri
	for x in file resolved-imports!
		if rb ?= x get-referenced-by
			rb ~= file uri

	if circ ?= circular-import
		if file.resolved-imports! !has-circular-import
			for uri in circ
				if uri != file.uri
					other = a.crow-files[uri]!
					ci = other clear-resolved-imports
					assert _ ?= ci # But ignore since we've already handled it
					a recompute-resolved-imports other
	
	a add-to-workable-if-so file

-clear-resolved-imports uri[]?(file crow-file)
	circular-import mut uri[]? = ()
	for import_ in file resolved-imports!
		if rb ?= import_ get-referenced-by
			_ = rb remove file.uri
		else
			circular-import := import_ as-circular-import
	file.resolved-imports := ()
	circular-import

-has-circular-import bool(a mostly-resolved-import[])
	a exists it.is-circular-import
-is-circular-import bool(a mostly-resolved-import)
	_ ?= a.diag-import-file ?circular-import
-as-circular-import uri[]?(a mostly-resolved-import)
	if a is-circular-import
		a.diag-import-file!.circular-import! cycle

-add-to-workable-if-so void(a frontend, path path, file java-class-file)
	if a is-workable file
		a.workable-java ~= path
-add-to-workable-if-so void(a frontend, file crow-file)
	if file is-workable
		a.workable-crow ~= file uri

-is-workable bool(a frontend, file java-class-file)
	forbid _ ?= file module
	guard parsed ?= file.parsed parsed-java-class-header
	if super ?= parsed super-class
		a ensure-java-class-file super, header-only has-filled-in-supertypes
	else
		true
-is-workable bool(a crow-file)
	forbid a has-module
	a.ast-or-diag.read-file-diag != unknown and
	_ ?= a config and
	a.resolved-imports! every it.is-import-workable
-is-import-workable bool(a mostly-resolved-import)
	match a
	as crow-file x
		_ ?= x module
	as java-class-file x
		_ ?= x module
	as other-file x
		x.content != unknown
	as diag-import-file x
		forbid r ?= x read-error and r.diag == unknown
		true

-resolve-imports mostly-resolved-import[](a frontend, ast file-ast, config config, uri uri)
	with out in ast.count-imports-and-re-exports build
		unless ast no-std_
			out ~= a.common-files[std]
		# TODO: use each-import-or-re-export? ---------------------------------------------------------------------------------------
		if i ?= ast imports
			for x in i paths
				out ~= a try-resolve-import config, uri, x
		if i ?= ast re-exports
			for x in i paths
				out ~= a try-resolve-import config, uri, x

-count-imports-and-re-exports nat(a file-ast)
	x nat = (a !no-std_).to
	y nat = if i ?= a imports
		i.paths size
	z nat = if i ?= a re-exports
		i.paths size
	# TODO: THIS SHOULD WORK: _-------------------------------------------------------------------------------------------------------
	#y nat = a.imports.?paths.?size or 0
	#z nat = a.re-exports.?paths.?size or 0
	x + y + z

# TODO: just take `bootstrap uri`, not `bootstrap crow-file` --------------------------------------------------------------------------
-mark-all-non-bootstrap-modules-dirty void(a frontend, bootstrap crow-file)
	for uri, x in a crow-files
		if uri != bootstrap.uri
			a mark-module-dirty x
	a.workable-crow clear
	for uri, x in a crow-files
		if uri != bootstrap.uri
			a add-to-workable-if-so x

-mark-module-dirty void(a frontend, file crow-file)
	if _ ?= file module
		file.module := ()
		a.count-uncompiled-crow-files +:= 1
		for x in file referenced-by
			a mark-module-dirty a.crow-files[x]!

-fully-resolve-imports resolved-import[](imports mostly-resolved-import[])
	for import_ in imports
		match import_
		as crow-file file
			match file ast-or-diag
			as file-ast _
				file must-have-module
			as read-file-diag d
				file.uri read-error d
		as java-class-file x
			x module!
		as other-file file
			match file content
			as array-view x
				x
			as read-file-diag diag
				file.uri read-error diag
		as diag-import-file x
			x

-common-uris common-uris(include-dir uri)
	include-crow = include-dir / "crow"
	col = include-crow / "col"
	private = include-crow / "private"
	for k in make-enum-map
		match k
		as array
			col / "array.crow"
		as bootstrap
			private / "bootstrap.crow"
		as compare
			include-crow / "compare.crow"
		as exception
			include-crow / "exception.crow"
		as json
			include-crow / "json.crow"
		as misc
			include-crow / "misc.crow"
		as mut-array
			col / "mut-array.crow"
		as runtime
			private / "runtime.crow"
		as std
			include-crow / "std.crow"
		as string
			include-crow / "string.crow"
		as symbol
			include-crow / "symbol.crow"

| For an unknown/loading file, this will still be a {crow-file} or {other-file}
-mostly-resolved-import union mut
	crow-file
	java-class-file
	other-file
	diag-import-file

-get-referenced-by uri mut-set?(import_ mostly-resolved-import)
	match import_
	as crow-file x
		x referenced-by
	as java-class-file x
		x referenced-by-crow
	as other-file x
		x referenced-by
	as diag-import-file _
		()

-try-resolve-import mostly-resolved-import
	a frontend
	config config
	from-uri uri
	ast import-or-export-ast
do
	match ast path
	as path path
		library-name, rest = path first-and-rest
		if library-name == "crow"
			a try-resolve-import-from-uri ast, do a.crow-include-dir concat-uri-and-path path
		elif path.get-extension == ".class"
			a ensure-java-class-file path.without-extension, all
		elif library-name is-java-library
			a ensure-java-class-file path, all
		elif from-config ?= config.include[library-name]
			uri = if r ?= rest
				from-config concat-uri-and-path r
			else
				from-config
			a try-resolve-import-from-uri ast, uri
		else
			library-name library-not-configured
	as rel-path rel-path
		if rel ?= from-uri resolve-uri-from-file rel-path
			a try-resolve-import-from-uri ast, rel
		else
			rel-path relative-import-reaches-past-root

-is-java-library bool(a symbol)
	match a
	as com
		true
	as java
		true
	else
		false

-try-resolve-import-from-uri mostly-resolved-import
	a frontend
	ast import-or-export-ast
	uri uri
do
	crow-file mostly-resolved-import mut() = of
		a ensure-crow-file do uri add-extension ".crow"
	match ast kind
	as import-whole-module-ast
		crow-file[]
	as array _
		crow-file[]
	as import-file-ast _
		if uri.file-type == crow
			cant-import-crow-as-text
		else
			a ensure-other-file uri

test
	a frontend = "test://bin/crow".must-parse-uri,
	uri-a = "test://src/a.crow" must-parse-uri
	do
		a set-file uri-a, "a"
		a get-file-content uri-a is "a"
	do
		a change-file uri-a,
			- "a\nb\nc",
		a get-file-content uri-a is "a\nb\nc"
	do
		a change-file uri-a,
			- ((1, 0), (1, 1)), "y"
		a get-file-content uri-a is "a\ny\nc"
	do
		a change-file uri-a,
			- ((0, 0), (0, 1)), "x"
			- ((2, 0), (2, 1)), "z"
		a get-file-content uri-a is "x\ny\nz"
