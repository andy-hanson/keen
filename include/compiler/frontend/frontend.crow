import
	crow/col/mut-sorted-set
	crow/unsafe
	../../crow/json: crowd-parse-error, expected, parse-crowd, pos
	../model/ast
	../model/lsp
	../model/model
	../model/parse-diag
	../model/source-range
	../model/uri
	../util/enum-map
	../util/perf
	./check/check
	./check/check-ctx
	./check/detect-unused-internal
	./check/get-common-funs
	./check/instantiate
	./config
	./java-externs
	./lang
	./parse/parse
	./parse-java-class
	./show-model

frontend record mut, java-classes case
	-crow-include-dir uri
	-common-uris common-uris
	-common-files mut (common-module, crow-file) enum-map
	-unknown uri mut-set
	-loading uri mut-set
	instantiate-ctx instantiate-ctx
	line-and-column-getters -mut line-and-column-getter[uri]
	| Set after 'bootstrap.crow' is compiled
	-common-types-option mut common-types?
	-crow-files crow-file mut[uri]
	| Number of crow-files without {module} set
	-count-uncompiled-crow-files mut nat
	-crowd-files crowd-file mut[uri]
	-config-files config-file mut[uri]
	| Key is the Java class path such as "java/lang/Object"
	-java-class-files java-class-file mut[path]
	-other-files other-file mut[uri]
	| Set of crow files which are ready to compile immediately.
	| (Parsing and resolving imports is always done immediately.)
	| This doesn't include files whose imports are not yet compiled.
	| If all import uris are resolved but nothing is workable, there must be a circular import.
	-workable-java path mut-sorted-set
	-workable-crow uri mut-sorted-set
common-types common-types(a frontend)
	a.common-types-option!
ensure-java-class struct-decl(a frontend, path path)
	type ensure-java-class-file a, path, header-only

show-ctx show-ctx(a frontend, uris-info uris-info, options show-options)
	line-and-column-getters: a.line-and-column-getters
	uris-info: uris-info
	options: options

new frontend(crow-include-dir uri)
	common-uris = common-uris crow-include-dir
	res frontend =
		crow-include-dir: crow-include-dir
		common-uris: common-uris
		common-files: for _, uri in common-uris
			# Dummy value, about to get overwritten
			uri: uri
			referenced-by: ()
			config-file: unknown, ()
			config: ()
			ast-or-diag: unknown
			resolved-imports: ()
			module: ()
		unknown: ()
		loading: ()
		instantiate-ctx: ()
		line-and-column-getters: ()
		common-types-option: ()
		crow-files: ()
		count-uncompiled-crow-files: 0
		crowd-files: ()
		config-files: ()
		java-class-files: ()
		other-files: ()
		workable-java: ()
		workable-crow: ()
	res.common-files := for _, uri in common-uris
		ensure-crow-file res, uri
	res

|  This is initially empty and the fields fill in from top to bottom in various steps.
| * The config is determined ({config-file}, {config})
| * The file is (attempted) read and parsed and gets ({ast-or-diag})
| * Then imports are resolved ({resolved-imports})
| * Then a {module} is built
-crow-file record mut
	uri uri
	| Uris are for {crow-file}s
	referenced-by uri mut-set
	config-file config-file
	config mut config?
	ast-or-diag mut ast-or-diag
	| Also includes re-exports. Set once we have config.
	resolved-imports mut mostly-resolved-import[]?
	module mut crow-module?

-crowd-file record mut
	line-and-column-getter mut line-and-column-getter
	parsed mut json?
	diagnostics mut diagnostic[]
-config-file record mut
	# If this is 'not-found' (and it usually is not-found), we will ignore it and use the parent
	config mut config-or-diag
	# Missing only for the root file
	parent config-file?
-config-or-diag union(config, read-file-diag)

-java-class-file record mut
	type struct-decl
	parsed mut java-class-or-diag
	work-needed mut java-work-kind
	has-filled-in-supertypes mut bool
	| This will be an empty option if we don't need to import this Java class as a module
	module mut java-class-module?
	| Uris are for {crow-file}s
	referenced-by-crow uri mut-set
	| Subclasses or interface implementers must be processed after their supertypes.
	inheritors path mut-set
-path path(a java-class-file)
	a.type.source.struct-decl-source-java!.path

| If a Java class has only come up as a type, we can process the header only.
| If it is imported as a module, we must process the entire class including methods.
-java-work-kind enum(header-only, all)
- == bool(a java-work-kind, b java-work-kind)
- <=> comparison(a java-work-kind, b java-work-kind)
-to json(a java-work-kind)

-java-class-or-diag union(parsed-java-class-header, read-file-diag)

-ast-or-diag union(file-ast, read-file-diag)

-other-file record mut
	uri uri
	content mut read-file-result
	| Uris are for {crow-file}s
	referenced-by uri mut-set

make-program-with-main program-with-main(a frontend, main main-kind, targets build-target set)
	configs uri set = match main
	as main-kind-main-function
		()
	as main-kind-tests-in-config
		- main.config-uri
	as main-kind-tests-at-uri
		()
	program-with-main-from-program a, (make-program a, configs), main, targets
program-with-main-from-program program-with-main
	a frontend
	program program
	main main-kind
	targets build-target set
do
	the instantiate-ctx = a.instantiate-ctx
	program, get-main-fun-and-diagnostics program, main, targets

make-program program(a frontend, fully-loaded-configs uri set)
	start = perf-now
	finally end-make-program start
	assert a.files-state == all-loaded
	common-modules (common-module, crow-module) enum-map = for _, x in a.common-files
		x.module!
	the instantiate-ctx = a.instantiate-ctx
	the common-types = a.common-types
	common-funs, common-funs-diagnostics = get-common-funs common-modules
	crow-modules crow-module[uri] = for uri, file in a.crow-files
		uri, file.module!
	unused-diagnostics = detect-unused-internal crow-modules, fully-loaded-configs
	crowd-diagnostics uri-and-diagnostic[] = for* uri, file in a.crowd-files
		map file.diagnostics, (uri, it)
	all-configs: for* uri, x in a.config-files
		if config = x.config.config
			- uri, config
	crow-modules: crow-modules
	java-modules: for* k, v in a.java-class-files
		if m = v.module
			- k, m
	all-java-classes: map-values a.java-class-files, it.type
	additional-diagnostics: common-funs-diagnostics ~~ unused-diagnostics ~~ crowd-diagnostics
	line-and-column-getters: a.line-and-column-getters
	common-funs: common-funs
	common-types: a.common-types
	uncommon-types: json: common-funs.json-named-new.return-type.struct-inst!

get-crowd-file line-and-character-getter(a frontend, uri uri)
	a.crowd-files[uri]!.line-and-column-getter.line-and-character-getter
get-ast file-ast(a frontend, uri uri)
	get-ast a.crow-files[uri]!
-get-ast file-ast(a crow-file)
	to-ast a.ast-or-diag
line-and-character-getter line-and-character-getter(a frontend, uri uri)
	a.line-and-column-getters[uri]!.line-and-character-getter

| Changes them to loading
flush-all-unknown-uris uri[](a frontend)
	res uri[] = a.unknown.move-to
	a.loading ~~= res
	res

files-state enum(has-unknown, has-loading, all-loaded)
== bool(a files-state, b files-state)
to json(a files-state)
files-state files-state(a frontend)
	if !is-empty a.unknown
		has-unknown
	elif !is-empty a.loading
		has-loading
	else
		all-loaded

change-file void(a frontend, uri uri, changes text-document-content-change-event[])
	set-file a, uri,
		string = apply-changes (line-and-character-getter a, uri), changes
		string.to::nat8[]

-apply-changes string(lc line-and-character-getter, events text-document-content-change-event[])
	cur mut string-view = source-text lc
	cur-lc mut = lc
	for i, event in with-index events
		if r = range event
			range source-range = cur-lc[r]
			cur :=
				-- cur[0 .. range.start].to
				-- event.text.to
				-- cur[range.end .. end].to
		else
			cur := event.text.to
		if i != events.size - 1
			cur-lc := line-and-character-getter-for-text cur
	cur.to

read-file-result union(nat8 array-view, read-file-diag)
== bool(a read-file-result, b read-file-result)
set-file void(a frontend, uri uri, result read-file-result)
	# Files don't change *to* unknown, only change out of that state
	forbid result.read-file-diag == unknown

	match file-type uri
	as class_
		path = uri.as-java-uri!
		file = ensure-java-class-file a, path, header-only
		match result
		as array-view
			file.parsed := parse-java-class result
			if super = file.parsed.parsed-java-class-header!.super-class
				(ensure-java-class-file a, super, header-only).inheritors ~= path
		as read-file-diag
			file.parsed := result
		add-to-workable-if-so a, path, file
	as crow
		file = ensure-crow-file a, uri
		file.ast-or-diag := match result
		as array-view
			text string-view = safe-reinterpret-cast result
			parse-file uri, text, text.line-and-column-getter-for-text
		as read-file-diag
			result
		a.line-and-column-getters ~:= uri, file.ast-or-diag.line-and-column-getter
		updated-ast-or-config a, file
	as crowd
		file = ensure-crowd-file a, uri
		match result
		as array-view
			text string-view = safe-reinterpret-cast result
			file.line-and-column-getter := line-and-column-getter-for-text text
			match x = parse-crowd text
			as json
				file.parsed := x
				file.diagnostics := ()
			as crowd-parse-error
				file.parsed := null
				file.diagnostics :=
					- range: (x.pos, x.pos + 1), kind: x.expected.parse-diag-crowd
		as read-file-diag
			file.parsed := null
			file.diagnostics :=
				- (), result
		a.line-and-column-getters ~:= uri, file.line-and-column-getter
	as crow-config
		config-file = ensure-config-file-for a, uri
		config-file.config := match result
		as array-view
			parse-config uri, result.as-string
		as read-file-diag
			match result
			as unknown
				throw unreachable
			as not-found
				result
			as error
				config-for-diag uri, error
		a.line-and-column-getters ~:= uri, config-file.config.line-and-column-getter
		for file in values a.crow-files
			update-file-on-config-change a, file
	as other
		file = ensure-other-file a, uri
		file.content := result
		for referencing-uri in file.referenced-by
			# TODO: It's is kind of inefficient to completely recompile referencing files if the content just changed.
			mark-module-dirty a, a.crow-files[referencing-uri]!
		for referencing-uri in file.referenced-by
			add-to-workable-if-so a, a.crow-files[referencing-uri]!

	if remove a.unknown, uri
		forbid a.loading[uri]
	else
		a.loading -= uri

	do-dirty-work a

-line-and-column-getter line-and-column-getter(a ast-or-diag)
	match a
	as file-ast then a.line-and-column-getter
	as read-file-diag then ()
-line-and-column-getter line-and-column-getter(a config-or-diag)
	match a
	as config then a.line-and-column-getter
	as read-file-diag then ()

-ensure-crow-file crow-file(a frontend, uri uri)
	uri.file-type is crow
	ensure a.crow-files, uri, of
		a.unknown ~= uri
		a.count-uncompiled-crow-files +:= 1
		config-file = ensure-config-file-for a, uri
		uri: uri
		referenced-by: ()
		config-file: config-file
		config: find-config config-file
		ast-or-diag: unknown
		resolved-imports: ()
		module: ()

-ensure-crowd-file crowd-file(a frontend, uri uri)
	uri.file-type is crowd
	ensure a.crowd-files, uri, of
		a.unknown ~= uri
		line-and-column-getter: ()
		parsed: ()
		diagnostics: ()

-ensure-config-file-for config-file(a frontend, crow-uri uri)
	ensure-config-file a, crow-uri.parent! / crow-config-base-name
-ensure-config-file config-file(a frontend, uri uri)
	dir = uri.parent!
	parent config-file? = if parent-dir = dir.parent
		ensure-config-file a, parent-dir / crow-config-base-name
	ensure a.config-files, uri, of
		a.unknown ~= uri
		config: unknown, parent: parent

-ensure-java-class-file java-class-file(a frontend, path path, work-needed java-work-kind)
	the instantiate-ctx = a.instantiate-ctx
	res = ensure a.java-class-files, path, of
		a.unknown ~= path.to-java-uri
		type: initial-struct-for-java-class path
		parsed: unknown
		work-needed: work-needed
		has-filled-in-supertypes: ()
		module: ()
		referenced-by-crow: ()
		inheritors: ()
	if res.work-needed < work-needed
		res.work-needed := work-needed
		add-to-workable-if-so a, path, res
	res

-ensure-other-file other-file(a frontend, uri uri)
	forbid uri.file-type == crow
	ensure a.other-files, uri, of
		a.unknown ~= uri
		uri, unknown, ()

-to-ast file-ast(a ast-or-diag)
	match a
	as file-ast then a
	as read-file-diag then file-ast-for-diag a

-do-dirty-work void(a frontend)
	start = perf-now
	finally end-dirty-work start

	the instantiate-ctx = a.instantiate-ctx
	the java-classes = a
	bootstrap = a.common-files[bootstrap]
	if remove a.workable-crow, bootstrap.uri
		fa uri-and-ast = bootstrap.uri, bootstrap.config!, bootstrap.get-ast
		String = type ensure-java-class-file a, "java/lang/String".parse-path, header-only
		module, common-types = check-bootstrap a.crow-include-dir, a.common-uris, fa, String.only-inst
		a.common-types-option := common-types
		bootstrap.module := module
		a.count-uncompiled-crow-files -:= 1
		mark-all-non-bootstrap-modules-dirty a, bootstrap.uri # since they all use common-types

	do if common-types = a.common-types-option
	the common-types = common-types
	do loop
	if path = remove-min a.workable-java
		file = a.java-class-files[path]!
		header = match x = file.parsed
		as parsed-java-class-header
			x
		as read-file-diag
			bogus-java-class-header path
		unless file.has-filled-in-supertypes
			fill-java-class-supertypes file.type, header
			file.has-filled-in-supertypes := true

		match file.work-needed
		as header-only
			()
		as all
			file.module := get-java-module path, file.type, header
		for x in file.referenced-by-crow
			file.work-needed is all
			add-to-workable-if-so a, a.crow-files[x]!
		for x in file.inheritors
			inheritor = a.java-class-files[x]!
			unless inheritor.module
				add-to-workable-if-so a, x, inheritor
		continue
	elif uri = remove-min a.workable-crow
		file = a.crow-files[uri]!
		file.module := compile-non-bootstrap-module a, file
		a.count-uncompiled-crow-files -:= 1
		for importer in file.referenced-by
			add-to-workable-if-so a, a.crow-files[importer]!
		continue
	elif a.files-state == all-loaded and a.count-uncompiled-crow-files != 0
		fix-circular-imports a
		continue
	else
		break

| This may not fix all circular imports, but it's run in a loop
-fix-circular-imports void(a frontend)
	do if _, file = find a.crow-files, !it.b.module
	cycle-builder uri mut[] = ()
	_ = fix-circular-imports-recur a, cycle-builder, file
-fix-circular-imports-recur uri[](a frontend, cycle-builder uri mut[], file crow-file)
	forbid file.module
	cycle-builder ~= file.uri
	import-index = find-index! file.resolved-imports!, !it.is-import-workable
	next = file.resolved-imports![import-index].crow-file!
	cycle uri[] = if contains cycle-builder, next.uri
		cycle-builder.move-to
	else
		fix-circular-imports-recur a, cycle-builder, next
	new-import = circular-import rotate-to-first cycle, file.uri
	file.resolved-imports := update-at file.resolved-imports!, import-index, new-import
	_ = remove next.referenced-by, file.uri
	add-to-workable-if-so a, file
	cycle

-rotate-to-first[t] t[](values t[], first-value t) t equal
	index = index-of! values, first-value
	values[index .. end] ~~ values[0 .. index]

-compile-non-bootstrap-module crow-module(a frontend, file crow-file) instantiate-ctx
	assert file.is-workable
	assert common-types = a.common-types-option # bootstrap must be compiled first
	ast uri-and-ast = file.uri, file.config!, file.get-ast
	imports = fully-resolve-imports file.resolved-imports!
	check a.crow-include-dir, a.common-uris, ast, imports, common-types

-update-file-on-config-change void(a frontend, file crow-file)
	do if best-config = find-config file.config-file
	do unless config = file.config and config.config-uri == best-config.config-uri
	file.config := best-config
	updated-ast-or-config a, file
-find-config config?(a config-file)
	match x = a.config
	as config
		x
	as read-file-diag
		match x
		as unknown
			()
		as not-found
			if p = a.parent
				find-config p
			else
				default-config
		as error
			throw unreachable # It will be a config with diagnostics in this case

-updated-ast-or-config void(a frontend, file crow-file)
	if file.config
		recompute-resolved-imports a, file
	else
		forbid file.resolved-imports or file.module

-recompute-resolved-imports void(a frontend, file crow-file)
	mark-module-dirty a, file
	circular-import = if file.resolved-imports
		clear-resolved-imports file
	file.resolved-imports := resolve-imports a, file.get-ast, file.config!, file.uri
	for x in file.resolved-imports!
		if rb = x.get-referenced-by
			rb ~= file.uri

	if circular-import
		unless has-circular-import file.resolved-imports!
			for uri in circular-import
				if uri != file.uri
					other = a.crow-files[uri]!
					ci = clear-resolved-imports other
					assert ci # But ignore since we've already handled it
					recompute-resolved-imports a, other

	add-to-workable-if-so a, file

-clear-resolved-imports uri[]?(file crow-file)
	circular-import mut uri[]? = ()
	for import_ in file.resolved-imports!
		if rb = import_.get-referenced-by
			_ = remove rb, file.uri
		else
			circular-import := as-circular-import import_
	file.resolved-imports := ()
	circular-import

-has-circular-import bool(a mostly-resolved-import[])
	exists a, it.is-circular-import
-is-circular-import bool(a mostly-resolved-import)
	!!a.diag-import-file.?circular-import
-as-circular-import uri[]?(a mostly-resolved-import)
	if is-circular-import a
		a.diag-import-file!.circular-import!.cycle

-add-to-workable-if-so void(a frontend, path path, file java-class-file)
	if is-workable a, file
		a.workable-java ~= path
-add-to-workable-if-so void(a frontend, file crow-file)
	if is-workable file
		a.workable-crow ~= file.uri

-is-workable bool(a frontend, file java-class-file)
	match parsed = file.parsed
	as parsed-java-class-header
		if super = parsed.super-class
			has-filled-in-supertypes a.java-class-files[super]!
		else
			true
	as read-file-diag
		parsed != unknown
-is-workable bool(a crow-file)
	forbid a.module
	a.ast-or-diag.read-file-diag != unknown and
	a.config and
	every a.resolved-imports!, it.is-import-workable
-is-import-workable bool(a mostly-resolved-import)
	match a
	as crow-file
		!!a.module
	as java-class-file
		!!a.module
	as other-file
		a.content != unknown
	as diag-import-file
		forbid a.read-error.?diag == unknown
		true

-resolve-imports mostly-resolved-import[](a frontend, ast file-ast, config config, uri uri)
	do with out in build ast.count-imports-and-re-exports
	unless ast.no-std_
		out ~= a.common-files[std]
	if i = ast.imports
		for x in i.paths
			out ~= try-resolve-import a, config, uri, x
	if i = ast.re-exports
		for x in i.paths
			out ~= try-resolve-import a, config, uri, x

-count-imports-and-re-exports nat(a file-ast)
	(!a.no-std_).to::nat + (a.imports.?paths.?size else 0) + (a.re-exports.?paths.?size else 0)

-mark-all-non-bootstrap-modules-dirty void(a frontend, bootstrap uri)
	clear a.workable-java
	for path, file in a.java-class-files
		file.module := ()
		# No need to reset files that aren't yet workable, they'll be processed eventually anyway
		add-to-workable-if-so a, path, file
	for uri, x in a.crow-files
		if uri != bootstrap
			mark-module-dirty a, x
	clear a.workable-crow
	for uri, x in a.crow-files
		if uri != bootstrap
			add-to-workable-if-so a, x

-mark-module-dirty void(a frontend, file crow-file)
	if file.module
		file.module := ()
		a.count-uncompiled-crow-files +:= 1
		for x in file.referenced-by
			mark-module-dirty a, a.crow-files[x]!

-fully-resolve-imports resolved-import[](imports mostly-resolved-import[])
	for file in imports
		match file
		as crow-file
			match x = file.ast-or-diag
			as file-ast
				file.module!
			as read-file-diag
				read-error file.uri, x
		as java-class-file
			match x = file.parsed
			as parsed-java-class-header
				file.module!
			as read-file-diag
				read-error file.path.to-java-uri, x
		as other-file
			match x = file.content
			as array-view
				imported-file file.uri, x
			as read-file-diag
				read-error file.uri, x
		as diag-import-file
			file

-common-uris common-uris(include-dir uri)
	include-crow = include-dir / "crow"
	col = include-crow / "col"
	private = include-crow / "private"
	for k in make-enum-map
		match k
		as array
			col / "array.crow"
		as bootstrap
			private / "bootstrap.crow"
		as buffer
			col / "buffer.crow"
		as compare
			include-crow / "compare.crow"
		as exception
			include-crow / "exception.crow"
		as hash
			include-crow / "hash.crow"
		as js
			include-crow / "js.crow"
		as json
			include-crow / "json.crow"
		as misc
			include-crow / "misc.crow"
		as mut-array
			col / "mut-array.crow"
		as runtime
			private / "runtime.crow"
		as std
			include-crow / "std.crow"
		as string
			include-crow / "string.crow"
		as symbol
			include-crow / "symbol.crow"

| For an unknown/loading file, this will still be a {crow-file} or {other-file}
-mostly-resolved-import union mut
	crow-file
	java-class-file
	other-file
	diag-import-file

-get-referenced-by uri mut-set?(a mostly-resolved-import)
	match a
	as crow-file
		a.referenced-by
	as java-class-file
		a.referenced-by-crow
	as other-file
		a.referenced-by
	as diag-import-file
		()

-try-resolve-import mostly-resolved-import
	a frontend
	config config
	from-uri uri
	ast import-or-export-ast
do
	match path = ast.path
	as path
		library-name, rest = path.first-and-rest
		if library-name == "crow"
			try-resolve-import-from-uri a, ast, a.crow-include-dir / path
		elif p = without-extension path, ".class"
			ensure-java-class-file a, p, all
		elif is-java-library library-name
			ensure-java-class-file a, path, all
		elif from-config = config.include[library-name]
			uri = if rest then from-config / rest else from-config
			try-resolve-import-from-uri a, ast, uri
		else
			library-not-configured library-name
	as rel-path
		if rel = resolve-uri-from-file from-uri, path
			try-resolve-import-from-uri a, ast, rel
		else
			relative-import-reaches-past-root path

-is-java-library bool(a symbol)
	match a
	as com
		true
	as java
		true
	else
		false

-try-resolve-import-from-uri mostly-resolved-import
	a frontend
	ast import-or-export-ast
	uri uri
do
	crow-file = of
		ensure-crow-file a, add-extension uri, ".crow"
	match ast.kind
	as import-whole-module-ast
		crow-file[]
	as array
		crow-file[]
	as import-file-ast
		if uri.file-type == crow
			cant-import-crow-as-text
		else
			ensure-other-file a, uri

test
	a frontend = crow-include-dir: parse-uri "test://bin/crow"
	uri-a = parse-uri "test://src/a.crow"
	set-file a, uri-a, "a".to::read-file-result
	get-file-content a, uri-a is "a"::char8[]
	change-file a, uri-a,
		- "a\nb\nc",
	get-file-content a, uri-a is "a\nb\nc"::char8[]
	change-file a, uri-a,
		- ((1, 0), (1, 1)), "y"
	get-file-content a, uri-a is "a\ny\nc"::char8[]
	change-file a, uri-a,
		- ((0, 0), (0, 1)), "x"
		- ((2, 0), (2, 1)), "z"
	get-file-content a, uri-a is "x\ny\nz"::char8[]
-get-file-content string-view(a frontend, uri uri)
	a.line-and-column-getters[uri]!.source-text
