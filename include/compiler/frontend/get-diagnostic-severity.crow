		check-error
	as diag-case-missing-type
		check-error
	as diag-case-type-is-template _
		check-error
	as diag-char-literal-must-be-one-char
		check-error
	as diag-common-fun-duplicate _
		check-error
	as diag-common-fun-missing _
		common-missing
	as diag-common-type-missing _
		common-missing
	as diag-common-var-missing _
		common-missing
	as diag-destructure-type-mismatch _
		check-error
	as diag-duplicate-declaration _
		check-error
	as diag-duplicate-exports _
		check-error
	as diag-duplicate-import-name _
		warning
