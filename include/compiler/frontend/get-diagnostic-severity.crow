	as diag-call-multiple-matches
		check-error
	as diag-call-no-match
		check-error
	as diag-call-no-match-for-interpolate-or-list-new
		check-error
	as diag-call-option-non-option
		warning
	as diag-call-should-use-syntax
		warning
	as diag-case-duplicate
		check-error
	as diag-case-invalid-sum-type
		check-error
	as diag-case-missing-type
		check-error
	as diag-case-type-is-template
		check-error
	as diag-catch-else-must-come-last
		check-error
	as diag-char-literal-must-be-one-char
		check-error
	as diag-common-fun-duplicate
		check-error
	as diag-common-fun-missing
		common-missing
	as diag-common-type-missing
		common-missing
	as diag-common-var-missing
		common-missing
	as diag-condition-type
		check-error
	as diag-config-invalid-json
		parse-error
	as diag-destructure-type-mismatch
		check-error
	as diag-duplicate-declaration
		check-error
	as diag-duplicate-exports
		check-error
	as diag-duplicate-import-name
		warning
	as diag-duplicate-imports
		check-error
