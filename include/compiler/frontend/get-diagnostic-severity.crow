import
	../model/model
	../model/parse-diag

has-fatal-diagnostics bool(a program)
	a exists-diagnostic x =>
		x.kind.get-diagnostic-severity is-fatal
has-fatal-diagnostics bool(a program-with-main)
	a.program has-fatal-diagnostics or a.main-fun-diagnostics !is-empty

get-diagnostic-severity diagnostic-severity(a diag)
