	as diag-alias-not-allowed
		check-error
	as diag-assert-or-forbid-message-is-throw
		warning
	as diag-assignment-not-allowed
		check-error
	as diag-auto-fun-enum-or-flags-to-wrong-storage _
		check-error
	as diag-auto-fun-param-not-simple
		check-error
	as diag-auto-fun-spec-corrupt _
		check-error
	as diag-auto-fun-spec-from-wrong-module
		check-error
	as diag-auto-fun-type-not-fully-visible
		check-error
	as diag-auto-fun-wrong-name
		check-error
	as diag-auto-fun-wrong-params _
		check-error
	as diag-auto-fun-wrong-param-type
		check-error
	as diag-auto-fun-wrong-return-type _
		check-error
	as diag-builtin-fun-cant-have-body
		check-error
	as diag-builtin-unsupported _
		check-error
	as diag-call-deprecated _
