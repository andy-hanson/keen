		check-error
	as diag-flags-signed
		check-error
	as diag-function-with-signature-not-found _
		check-error
	as diag-if-throw
		warning
	as diag-import-file _
		import-error
	as diag-import-refers-to-nothing _
		name-not-found
	as diag-lambda-cant-be-function-pointer
		check-error
	as diag-lambda-cant-infer-param-type
