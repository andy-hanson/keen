-parse-diag-severity diagnostic-severity(a parse-diag)
	match a
	as parse-diag-doc-comment-unused
		lint
	as parse-diag-expected _
		parse-error
	as parse-diag-file-not-utf8
		import-error
	as parse-diag-import-file-type-not-supported
		parse-error
	as parse-diag-indent-not-divisible _
		parse-error
	as parse-diag-indent-too-much
		parse-error
	as parse-diag-indent-wrong-character _
		parse-error
	as parse-diag-invalid-string-escape _
		warning
	as parse-diag-line-too-long _
		lint
	as parse-diag-list-call-needs-hyphen _
		parse-error
	as parse-diag-match-case-interpolated
		parse-error
	as parse-diag-missing-interpolated
		parse-error
	as parse-diag-needs-block-ctx _
		parse-error
	as parse-diag-question-equals-left
		parse-error
	as parse-diag-trailing-comma
		warning
	as parse-diag-type-empty-parens
		parse-error
	as parse-diag-type-trailing-mut
		parse-error
	as parse-diag-type-unnecessary-parens
		warning
	as parse-diag-unexpected-character _
		parse-error
	as parse-diag-unexpected-operator _
		parse-error
	as parse-diag-unexpected-token _
		parse-error
	as read-file-diag _
		import-error
	

