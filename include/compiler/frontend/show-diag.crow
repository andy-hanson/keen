import
	crow/string/util
	../../crow/private/parse-util
	../model/ast
	../model/model
	../model/parse-diag
	../model/source-range
	../model/uri
	../util/util
	./get-diagnostic-severity
	./parse/token
	./show-model

show-diags-options record
	only-for-uris uri set?
	show-options show-options
	show-all-diagnostics bool
new show-diags-options()
	(), (), ()
show-color bool(a show-diags-options)
	a.show-options.color

show-diagnostics string
	ctx show-diag-ctx
	program program-with-opt-main
	options show-diags-options
do
	severity = max-diagnostic-severity program
	first mut bool = true
	with out in build
		for x in sorted-diagnostics program
			guard filter-uri x.uri, options.only-for-uris
			for diagnostic in x.diagnostics
				if options.show-all-diagnostics or diagnostic.kind.get-diagnostic-severity == severity
					if first
						first := false
					else
						out ~= "\n"
					out ~~= show-diagnostic ctx, (x.uri, diagnostic)

-filter-uri bool(a uri, filter uri set?)
	if filter
		filter[a]
	else
		true

show-parse-diagnostics string(ctx show-ctx, uri uri, diagnostics parse-diagnostic[])
	join "\n", for x in diagnostics
		"{ctx.line-and-column-getters[uri][x.range]} {show-parse-diag ctx, x.kind}"

uri-and-diagnostics record(uri uri, diagnostics diagnostic[])

sorted-diagnostics uri-and-diagnostics[](program program-with-opt-main)
	map diagnostic mut[] mut[uri] = ()
	each-diagnostic program, of x
		ensure map, x.uri ~= x.diagnostic
	res uri-and-diagnostics[] = for uri, diags in map
		uri, (sort diags.move-to, it.range)
	sort res, it.uri

-max-diagnostic-severity diagnostic-severity(a program-with-opt-main)
	res mut = lint
	each-diagnostic a, of x
		res max:= get-diagnostic-severity x.kind
	res

-show-parse-diag string(ctx show-ctx, a parse-diag)
	match a
	as parse-diag-doc-comment-unused
		"Doc comment must appear at top of module or before a declaration."
	as parse-diag-equals-left
		"Expected a destructure to left of '='."
	as parse-diag-expected
		show-parse-diag-expected a
	as parse-diag-file-not-utf8
		"File is not encoded as UTF-8 or has encoding errors."
	as parse-diag-import-file-type-not-supported
		"Import file type not allowed; the only supported types are 'nat8 array' and 'string'."
	as parse-diag-indent-too-much
		"Indented too far."
	as parse-diag-indent-wrong
		"Indentation should be {a.expected} (based on first indented line)."
	as parse-diag-invalid-string-escape
		"Invalid escape sequance '{a.actual}'"
	as parse-diag-line-too-long
		"Line is {a.actual} columns wide; the maximum is {a.maximum}."
	as parse-diag-list-call-needs-hyphen
		"Expected a line starting with '- ' or '-- '."
	as parse-diag-match-case-interpolated
		"A branch of a 'match' must be an identifier, number literal, or string literal (without interpolation)."
	as parse-diag-missing-interpolated
		"Expected something inside of the '\{}'."
	as parse-diag-named-new-key
		"Key before a ':' must be an identifier or a quoted string without interpolation."
	as parse-diag-needs-block-ctx
		"'{a}' expression can't appear in this context, because it requires an indented block to follow."
	as parse-diag-number-invalid
		"Not a valid number literal."
	as parse-diag-trailing-comma
		"Remove this trailing comma."
	as parse-diag-trailing-whitespace
		"Remove this trailing whitespace."
	as parse-diag-type-empty-parens
		"'()' is not a type. Did you mean 'void'?"
	as parse-diag-type-trailing-mut
		"To make something mutable, put 'mut' after its name, not after its type."
	as parse-diag-type-unnecessary-parens
		"Parentheses are unnecessary."
	as parse-diag-unexpected-character
		"Unexpected character {a.character.to.quoted} (U+{to-hex-with-padding a.character.to, 4})."
	as parse-diag-unexpected-operator
		"Unexpected operator '{a.operator}'."
	as parse-diag-unexpected-token
		describe-token-for-unexpected a.token
	as read-file-diag
		show-read-file-diag ctx, a, ()

-show string(a parse-diag-needs-block-ctx)
	match a
	as for_
		"'for'"
	as for-star
		"'for*'"
	as if_
		"'if'"
	as match_
		"'match'"
	as loop_
		"'loop'"
	as of_
		"'of'"
	as quote_
		"'quote'"
	as try_
		"'try'"
	as unless_
		"'unless'"
	as with_
		"'with'"

-show-parse-diag-expected string(a parse-diag-expected)
	match a
	as after-finally
		"Expected an expression to come after 'finally'."
	as after-trusted
		"Expected an expression to come after 'trusted'."
	as block-comment-end
		"Expected '###' (then a newline)."
	as catch_
		"Expected 'catch'."
	as close-interpolated
		"Expected '}'."
	as closing-bracket
		"Expected ']'."
	as closing-paren
		"Expected ')'."
	as colon
		"Expected ':'."
	as comma
		"Expected ','."
	as dedent
		"Expected a dedent."
	as end-of-line
		"Expected end of line."
	as expression
		"Expected an expression."
	as equals
		"Expected '='."
	as in_
		"Expected 'in'."
	as indent
		"Expected an indent."
	as literal-integral
		"Expected an integer."
	as name
		"Expected a name (non-operator)."
	as name-colon
		"Expected a name with a colon, like 'name:'."
	as name-or-operator
		"Expected a name or operator."
	as newline-or-dedent
		"Expected a newline or dedent."
	as open-paren
		"Expected '('."
	as quote-double
		"Expected '\"'."
	as slash
		"Expected '/'."

-show-read-file-diag string(ctx show-ctx, a read-file-diag, uri uri?)
	file string = if uri
		"imported file {show-uri ctx, uri}"
	else
		"this file"
	match a
	as not-found
		"{to-upper-first file} does not exist."
	as error
		"There was an error reading {file}."
	as unknown
		"The editor is still loading {file}."

-to-upper-first string(a string)
	iter = a.begin
	try
		first = take-next iter
		first.upper-case ~ (slice iter, a.end)
	catch as iterator-out-of-bounds
		a is ""
		""

-show-spec-trace string(ctx show-diag-ctx, container type-container, trace fun-decl-and-type-args[])
	with out in build
		for i, x in trace.with-index
			out ~~= "\n\t"
			this-container = if i == 0 then container else trace[i - 1].decl
			out ~~= show-fun-decl-and-type-args ctx, this-container, x

-show-call-no-match string(ctx show-diag-ctx, a diag-call-no-match)
	some-candidate-has-correct-arity = exists a.all-candidates, of x
		(a.actual-n-type-args == 0 or x.n-type-params == a.actual-n-type-args) and x.arity == a.actual-arity

	if is-empty a.all-candidates
		show-call-no-candidates ctx, a
	elif !some-candidate-has-correct-arity
		some-candidate-has-correct-n-type-args = a.actual-n-type-args == 0 or exists a.all-candidates, of x
			x.n-type-params == 1 or x.n-type-params == a.actual-n-type-args
		show-call-no-correct-arity ctx, a, some-candidate-has-correct-n-type-args
	else
		show-call-close-match ctx, a

-show-call-no-candidates string(ctx show-diag-ctx, a diag-call-no-match)
	or-var string = if a.actual-arity == 0
		"or variable "
	res string = "There is no function {or-var}named {show-name ctx, a.fun-name}."
	if x = opt-only a.actual-arg-types
		"{res}\nArgument type: {show-type-quoted ctx, (x, a.type-container)}"
	else
		res

-show-name string(ctx show-diag-ctx, a fun-name)
	match a
	as symbol
		show-name ctx, a
	as list-new
		"'new' or 'list-new'"
	as named-new
		"'new' or 'named-new'"

-show-call-no-correct-arity string(ctx show-diag-ctx, a diag-call-no-match, some-candidate-has-correct-n-type-args bool)
	name = show-name ctx, a.fun-name
	n-args string = if some-candidate-has-correct-n-type-args
		"{a.actual-arity} arguments"
	else
		"{a.actual-n-type-args} type arguments"
	candidates = show-called-decls ctx, a.type-container, a.all-candidates
	"There are functions named {name}, but none takes {n-args}. Candidates:{candidates}"

-show-call-close-match string(ctx show-diag-ctx, a diag-call-no-match)
	with out in build
		out ~~= "There are functions named "
		out ~~= show-name ctx, a.fun-name
		out ~~= ", but they do not match the "
		has-ret = expected-for-diag-choices a.expected-return-type
		has-args = !is-empty a.actual-arg-types
		out ~~= if has-ret
			if has-args
				"expected return type and actual argument types"
			else
				"expected return type"
		else
			"actual argument types"
		out ~~= ".\n"
		if has-ret
			out ~~= show-expected ctx, a.expected-return-type, return
		if has-args
			out ~~= "\nActual argument types: "
			out ~~= join ", ", for x in a.actual-arg-types
				show-type-quoted ctx, (x, a.type-container)
			if a.actual-arg-types.size < a.actual-arity
				out ~~= " (Other arguments not checked; gave up early.)"
		out ~~= "\nCandidates (with {a.actual-arity} arguments):"
		out ~~= show-called-decls ctx, a.type-container, a.all-candidates, it.arity == a.actual-arity

# TODO: rename to 'show-diag' --------------------------------------------------------------------------------------------------------
string-of-diag string(ctx show-diag-ctx, a diag)
	match a
	as diag-alias-not-allowed
		"An alias is not allowed to reference another alias in the same module."
	as diag-assert-or-forbid-message-is-throw
		"The expression after the 'else' for an 'assert' or 'forbid' is always thrown; it doesn't need 'throw'."
	as diag-assignment-not-allowed
		"Can't assign to this kind of expression."
	as diag-auto-fun-enum-or-flags-to-wrong-storage
		name = show-name ctx, a.enum-or-flags-type.name
		kind = decl-kind-of-struct a.enum-or-flags-type
		actual = show-name ctx, a.actual-storage-type.to
		expected = show-name ctx, a.expected-storage-type.to
		"{decl-kind-upper-case kind} {name} requires {actual}, so it can't convert to {expected}."
	as diag-auto-fun-param-not-simple
		"An auto fun must have simple parameters (not ignored or destructured)."
	as diag-auto-fun-spec-corrupt
		"Spec {show-name ctx, a.spec-name} does not have the expected content."
	as diag-auto-fun-spec-from-wrong-module
		"Spec for automatic function comes from unexpected module."
	as diag-auto-fun-type-not-fully-visible
		"This function can't be automatic because the type is not fully visible in this context."
	as diag-auto-fun-wrong-name
		"Function needs a body. (An automatic function must be named '==', '<=>', or 'to'.)"
	as diag-auto-fun-wrong-params
		match a.kind
		as compare
			"'<=>' must take two parameters of the same type."
		as equals
			"'==' must take two parameters of the same type."
		as members
			"'members' must take no parameters."
		as to
			"'to' must take a single parameter."
	as diag-auto-fun-wrong-param-type
		"An automatic function parameter must be a {show-keyword ctx, "record"} or {show-keyword ctx, "union"} type."
	as diag-auto-fun-wrong-return-type
		match a.kind
		as compare
			"'<=>' must return 'comparison'."
		as equals
			"'==' must return 'bool'."
		as members
			"'members' must return an array of an 'enum' or 'flags' type."
		as to
			"'to' must be one of:\n" ~~
			"\t'to json(a t)' where 't' is a enum, flags, record, or union type\n" ~~
			"\t'to symbol(a e)' where 'e' is an enum type\n" ~~
			"\t'to e?(a symbol)' where 'e' is an enum or flags type\n" ~~
			"\t'to symbol[](a f)' where 'f' is a flags type"
	as diag-builtin-unsupported
		"Crow does not implement a builtin {a.kind} named {show-name ctx, a.name}."
	as diag-call-deprecated
		"Called a deprecated function {show-fun-decl ctx, quoted, a.callee}"
	as diag-call-multiple-matches
		"Cannot choose an overload of {show-name ctx, a.fun-name}. Multiple functions match:{show-called-decls ctx, a.type-container, a.matches}"
	as diag-call-no-match
		show-call-no-match ctx, a
	as diag-call-no-match-for-interpolate-or-list-new
		"Did not find a function named '{a.name}' returning a {show-type-quoted ctx, a.expected-return-type} taking a single array parameter."
	as diag-call-option-non-option
		quote
			Expected the first argument to '?{a.fun-name}' to be an option type.
			Actual: {show-type-quoted ctx, a.actual}.
	as diag-call-should-use-syntax
		match a.kind
		as force
			"Prefer to write 'x!' instead of 'x.force'."
		as for-loop
			"Prefer to write a 'for' loop instead of calling 'for-loop'."
		as list-new
			"Prefer to write 'x, y' instead of '(x, y) list-new'."
		as new_
			match a.arity
			as 0
				"Prefer to write '()' instead of 'new'."
			as 1
				"Prefer to write 'x,' instead of 'x new'."
			else
				"Prefer to write 'x, y' instead of 'x new y'."
		as set-subscript
			"Prefer to write 'x[i] := y' instead of 'x set-subscript i, y'."
		as subscript
			"Prefer to write 'x[i]' instead of 'x subscript i'."
		as with-block
			"Prefer to write a 'with' block instead of calling 'with-block'."
	as diag-case-duplicate
		case-type = show-name ctx, a.member.name
		sum-type = show-name ctx, a.sum-type.name
		"Type {case-type} can't be declared a case of {sum-type} multiple times."
	as diag-case-invalid-sum-type
		"'case' requires an 'interface' or 'variant' type, not {show-type-quoted ctx, (a.actual, a.member)}."
	as diag-case-missing-type
		"'case' needs a type argument. It should be an 'interface' or 'variant' type."
	as diag-case-type-is-template
		"{show-name ctx, a.case-type.name} can't be a 'case' type because it is a template."
	as diag-catch-else-must-come-last
		"Only the last 'catch' is allowed to be missing 'as'."
	as diag-char-literal-must-be-one-char
		"Value of 'char' type must be a single character."
	as diag-common-fun-duplicate
		"Module contains multiple valid {show-name ctx, a.name} functions."
	as diag-common-fun-missing
		choices = join "\nOr:\n\t", for sig in a.sig-choices
			show-sig-simple ctx, a.dummy-for-context, a.dummy-for-context.name, sig
		"Module should have a function:\n\t{choices}"
	as diag-common-type-missing
		"Expected to find a type named {a.name} in this module."
	as diag-common-var-missing
		"Expected to find a {string-of-var-kind-lower-case a.var-kind} named {show-name ctx, a.name} in this module."
	as diag-condition-type
		"A condition must be a bool or option. Actual: {show-type-quoted ctx, a.actual}."
	as diag-config-invalid-json
		"This file has JSON parse errors."
	as diag-destructure-type-mismatch
		actual = show-type-quoted ctx, a.actual
		expected string = match t = a.expected
		as destructure-expected-tuple
			"a tuple with {t.size} elements"
		as type-with-container
			"type {show-type-quoted ctx, t}"
		"Expected {expected}, but got {actual}."
	as diag-duplicate-declaration
		desc string = match a.kind
		as enum-member
			"Enum member"
		as flags-member
			"Flags member"
		as param-or-local
			"Local"
		as record-field
			"Record field"
		as spec_
			"Spec"
		as struct-or-alias
			"Type"
		as type-param
			"Type parameter"
		as union-member
			"Union case type"
		"{desc} name {show-name ctx, a.name} is already used."
	as diag-duplicate-exports
		kind string = match a.kind
		as spec_
			"specs"
		as type
			"types"
		"There are multiple exported {kind} named {show-name ctx, a.name}."
	as diag-duplicate-import-name
		"{show-name ctx, a.name} is imported twice from the same module."
	as diag-duplicate-imports
		# TODO: use a.kind
		"The symbol {show-name ctx, a.name} appears in multiple modules."
	as diag-flags-value-not-power-of-2
		"A flags member value must be a power of 2."
	as diag-empty-enum-or-union
		"An enum or union type must have at least one member."
	as diag-enum-value-not-sorted
		"An enum member value must be greater than the previous value ({a.prev-value})."
	as diag-expected-type-is-not-a-lambda
		if e = a.expected-type
			"The expected type at the lambda is {show-type-quoted ctx, e}, which is not a lambda type."
		else
			"There is no expected type at this location; lambdas need an expected type."
	as diag-extern-body-multiple
		"This function has multiple 'extern' modifiers, so it's ambiguous which to use for the body."
	as diag-function-with-signature-not-found
		return-type = show-type-unquoted ctx, (a.return-and-param-types.return-type, a.type-container)
		params string = join ", ", for t in a.return-and-param-types.param-types
			"_ {show-type-unquoted ctx, (t, a.type-container)}"
		"Could not find a function '{a.name} {return-type}({params})'."
	as diag-if-throw
		"Instead of throwing from a conditional expression, use 'assert' or 'forbid'."
	as diag-import-file
		# TODO: factor out a function ----------------------------------------------------------------------------------------------
		match a
		as cant-import-crow-as-text
			"Can't import a '.crow' file as content."
		as circular-import
			parts string[] = for uri in a.cycle ~ a.cycle[0]
				show-uri ctx, uri
			"This is part of a circular import:\n\t{join " imports\n\t", parts}"
		as library-not-configured
			"Library {show-name ctx, a.library-name} is not configured.\n" ~~
			"It must be added to \"include\" in 'crow-config.json'."
		as read-error
			show-read-file-diag ctx.show, a.diag, a.uri
		as relative-import-reaches-past-root
			"Relative path {a.imported} reaches above the root directory."
	as diag-import-refers-to-nothing
		"Imported name {show-name ctx, a.name} does not refer to anything."
	as diag-it-identity
		"'it' may not be appear alone.\n" ~~
		"(Hint: Only tightly bound expressions are in the 'it' scope.)\n" ~~
		"If you want an identity function use 'it.identity'."
	as diag-lambda-cant-be-function-pointer
		"A function pointer can't be implemented by a lambda. Write a function and use '&f' instead."
	as diag-lambda-cant-infer-param-type
		"Can't infer the lambda parameter's type."
	as diag-lambda-closure-purity
		reason string = if t = a.type
			"of {show-purity ctx, a.local-purity} type {show-type-quoted ctx, t}"
		else
			"a {show-keyword ctx, "mut"} local"
		"Can't access {show-name ctx, a.local-name} in a {a.lambda-kind} lambda because it is {reason}."
	as diag-lambda-multiple-match
		"Multiple lambda types are possible:{show-types-on-lines ctx, a.choices}\n" ~~
		"Consider explicitly typing the lambda's parameter."
	as diag-lambda-not-expected
		match a.expected
		as expected-for-diag-infer
			"Lambda expression needs an expected type."
		else
			"The lambda doesn't match the expected type at this location.\n" ~~
			(show-expected ctx, a.expected, lambda)
	as diag-lambda-type-missing-param-type
		"Lambda type needs parameter types.\n" ~~
		"(It is parsed as a destructure, so it needs both parameter names and types.)"
	as diag-literal-multiple-match
		types string[] = for type in a.types
			show-struct-inst ctx, a.type-container, type
		"Multiple possible types for literal expression: {join ", ", types}"
	as diag-literal-not-expected
		match a.expected
		as expected-for-diag-infer
			"Literal expression needs an expected type."
		else
			"The literal doesn't match the expected type at this location.\n" ~~
			(show-expected ctx, a.expected, lambda)
	as diag-literal-overflow
		"A value of type {show-name ctx, a.type.to} must be from {a.type.min-value} to {a.type.max-value}."
	as diag-local-not-mutable
		"Local variable {show-name ctx, a.local.name} was not marked 'mut'."
	as diag-loop-break-or-continue-outside-loop
		keyword symbol = match a
		as break_
			"break"
		as continue_
			"continue"
		"{show-keyword ctx, keyword} can not appear outside of a {show-keyword ctx, "loop"}."
	as diag-loop-disallowed-body
		"Loop body cannot be a {show-name ctx, a.to} expression."
	as diag-loop-without-break
		"'loop' is missing a 'break'."
	as diag-main-incompatible-with-target
		"'main' function can not run on a {show-name ctx, a.target.to} target."
	as diag-main-test-missing
		"There is no 'test' keyword on line {a.expected-line + 1}."
	as diag-match-case-duplicate
		desc = match a
		as symbol
			show-name ctx, a
		as string
			quoted a
		as nat
			"{a}"
		as int
			"{a}"
		"Duplicate branch {desc}."
	as diag-match-case-for-type
		match a
		as enum-or-union
			"To match an enum or union, branches must use identifiers."
		as numeric
			"To match a number, branches must use number literals."
		as string-like
			"To match a string-like type, branches must use identifiers or string literals."
	as diag-match-case-name-not-in-enum
		members string[] = for m in a.enum_.body.enum_!.members
			show-name ctx, m.name
		"Enum {show-name ctx, a.enum_.name} has no member {a.actual}.\n" ~~
		"This should be one of: {join ", ", members}."
	as diag-match-needs-else
		desc string = match a
		as integral
			"an integral"
		as string-like
			"a string or symbol"
		as variant_
			"a variant"
		"A 'match' on {desc} must have an explicit 'else'."
	as diag-match-on-non-matchable
		type = show-type-quoted ctx, a.type
		"Can only match on an enum, union, variant, integral, or string-like type, not {type}."
	as diag-match-sum-type-cant-infer-type-args
		"Can't infer type arguments of {a.member.name}."
	as diag-match-sum-type-no-member
		"Type {show-name ctx, a.non-member.name} is not a case of {show-type-quoted ctx, a.sum-type}."
	as diag-match-unhandled-enum-members
		handlers string = if a.members.size == 1
			"handler for enum member"
		else
			"handlers for enum members:"
		members = join ", ", for m in a.members then show-name ctx, m.name
		"'match' is missing {handlers} {members}."
	as diag-match-unhandled-union-case-types
		handlers string = if a.case-types.size == 1
			"handler for union case type"
		else
			"handlers for union case types:"
		case-types = join ", ", for t in a.case-types then show-name ctx, t.decl.name
		"'match' is missing {handlers} {case-types}."
	as diag-match-unnecessary-else
		"The 'match' handles every possible case, so the 'else' is unused."
	as diag-method-impl-visibility
		type = show-type-quoted ctx, (a.sum-type, a.member)
		fun = show-fun-inst ctx, quoted, a.member, a.method-impl
		"A method of {type} is implemented by {fun}, but it is less visible than {a.member.name}."
	as diag-modifier-conflict
		"{show-keyword ctx, a.cur-modifier} conflicts with {show-keyword ctx, a.prev-modifier}."
	as diag-modifier-duplicate
		"Redundant {show-keyword ctx, a.modifier}."
	as diag-modifier-invalid
		"{a-or-an-decl-kind a.decl-kind} can't be {show-modifier ctx, a.modifier}."
	as diag-modifier-redundant-due-to-decl-kind
		"{a-or-an-decl-kind a.decl-kind} is already {show-modifier ctx, a.modifier} by default."
	as diag-modifier-type-arg-invalid
		"{show-keyword ctx, a.modifier.name-or-keyword} does not take a type argument in this context."
	as diag-mut-field-not-allowed
		"This field is 'mut', so the record must be 'mut'."
	as diag-named-new-interpolated
		"Support for an interpolated key in a named-new expression has not yet been implemented."
	as diag-name-not-found
		kind string = match a.kind
		as doc-comment-reference
			"entity"
		as spec_
			"spec"
		as type
			"type"
		"There is no {kind} in scope named {show-name ctx, a.name}."
	as diag-needs-expected-type
		kind string = match a
		as interpolated
			"An interpolated string literal"
		as list
			"A list expression with '-- ' parts"
		as loop_
			"A 'loop' expression"
		as throw_
			"A 'throw' expression"
		"{kind} needs an expected type."
	as diag-option-else-left-non-option
		type = show-type-quoted ctx, a.actual-type
		"The left side of 'else' should be an option type (or the 'else' is pointless). Actual: {type}"
	as diag-option-force-non-option
		type = show-type-quoted ctx, a.actual-type
		"The argument to '!' should be an option type (or the '!' is pointless). Actual: {type}"
	as diag-option-or-left-non-option
		type = show-type-quoted ctx, a.actual-type
		"The left side of 'or' should be 'bool' or an option type. Actual: {type}"
	as diag-option-or-right-non-option
		type = show-type-quoted ctx, a.actual-type
		"The right side of 'or' is a non-option type {type}. This could be 'else' instead of 'or'."
	as diag-param-missing-type
		"This parameter needs a type."
	as diag-param-mutable
		"A parameter can't be mutable."
	as parse-diag
		show-parse-diag ctx.show, a
	as parse-diag-crowd
		"Parse error in '.crowd' file: Expected {a.expected}."
	as diag-purity-worse-than-parent
		# TODO: use different messages for records and unions to make it more clear. -------------------------------------------
		parent = show-name ctx, a.parent.name
		parent-purity = show-purity ctx, a.parent.purity
		child = show-type-quoted ctx, (a.child, a.parent)
		child-purity = show-purity ctx, a.child.best-case-purity
		"Type {parent} has purity {parent-purity}, but member of type {child} has purity {child-purity}."
	as diag-purity-worse-than-sum-type
		sum-type-kind = show-sum-type-kind-upper-case a.sum-type.decl.body.sum-type!.kind
		sum-type-name = show-name ctx, a.sum-type.decl.name
		sum-type-purity = show-purity ctx, a.sum-type.purity-range.best-case
		case-name = show-name ctx, a.case_.name
		case-purity = show-purity ctx, a.case_.purity
		"{sum-type-kind} {sum-type-name} has purity {sum-type-purity}, but case {case-name} has purity {case-purity}."
	as diag-record-field-needs-type
		"Record field {show-name ctx, a.field-name} needs a type."
	as diag-required-after
		kind string = match a
		as assert_ then "'assert'"
		as forbid_ then "'forbid'"
		as guard_ then "'guard'"
		as let then "assignment"
		as try-let then "'try-let'"
		as until_ then "'until'"
		as while_ then "'while'"
		"{kind} expression must be followed by something (unless the type is 'void')"
	as diag-shared-arg-is-not-lambda
		"Argument to 'shared' must be a lambda expression."
	as diag-shared-lambda-type-is-not-shared
		kind string = match a.kind
		as param-type
			"parameter"
		as return-type
			"return"
		"'shared' lambda needs a 'shared' {kind} type, but it is {show-type-quoted ctx, a.actual}."
	as diag-shared-lambda-unused
		"The lambda does not have anything 'mut' in its closure, so it does not need 'shared'."
	as diag-shared-not-expected
		"Expected type is a lambda, but it is not 'shared'.\n{show-expected ctx, a.expected, lambda}"
	as diag-spec-match-multiple
		name = show-name ctx, a.sig-name
		matches = show-calleds ctx, a.type-container, a.matches
		trace = show-spec-trace ctx, a.type-container, a.trace
		"Multiple implementations found for spec signature {name}:{matches}\n\tCalling:{trace}"
	as diag-spec-no-match
		desc string = match r = a.reason
		as spec-builtin-not-satisfied
			match r.kind
			as data_
				"{show-type-quoted ctx, (r.type-args.only, a.type-container)} is not {show-keyword ctx, r.kind.to}."
			as java
				"Trying to call a 'java' function. Either mark the calling function as 'java' too, or check 'if java' around to the call."
			as js
				"Trying to call a 'js' function. Either mark the calling function as 'js' too, or check 'if js' around to the call."
			as shared_
				"{show-type-quoted ctx, (r.type-args.only, a.type-container)} is not {show-keyword ctx, r.kind.to}."
			as summon
				"Trying to call a 'summon' function, but this function is not 'summon'."
			as unsafe
				quote
					Trying to call an 'unsafe' function.
					Either put the call inside of 'trusted' or make the calling function 'unsafe'.
		as spec-cant-infer-type-args
			"Can't infer type arguments to {show-fun-decl ctx, quoted, r.fun}."
		as spec-impl-not-found
			sig = r.sig-decl
			show-sig = show-sig ctx, quoted, a.type-container, sig.name, sig.return-type, sig.params, r.sig-type
			"No implementation was found for spec signature {show-sig}."
		as spec-too-deep
			"Spec instantiation is too deep."
		if is-empty a.trace
			desc
		else
			"{desc}\n\tCalling:{show-spec-trace ctx, a.type-container, a.trace}"
	as diag-spec-recursion
		trace = join ", ", for spec_ in a.trace
			show-name ctx, spec_.name
		"Spec's parents tree is too deep.\n\tTrace:{trace}"
	as diag-spec-use-invalid
		"{a-or-an-decl-kind a.decl-kind} can't have specs."
	as diag-string-literal-invalid
		match a
		as not-extern-js
			"Cant' create a 'js-any' value without 'js'."
	as diag-struct-params-syntax-error
		match a.reason
		as has-params-and-fields
			kind = a-or-an-decl-kind a.struct.decl-kind-of-struct
			"{kind} can't have both parameter-style and indented fields."
		as destructure
			"{a-or-an-member-kind a.struct.member-kind-of-struct} can't use destructuring."
	as diag-sum-type-listed-members-non-union
		"Only 'union' types support listing case types."
	as diag-test-missing-body
		"This test needs a body."
	as diag-trusted-unused
		"There is no 'summon' or 'unsafe' code in this expression; you could remove 'trusted'."
	as diag-tuple-too-big
		"This tuple has {a.actual} elements; the maximum allowed is {a.max-allowed}."
	as diag-type-conflict
		"{show-expected ctx, a.expected, generic}\nActual:{show-type-quoted ctx, a.actual}."
	as diag-type-param-cant-have-type-args
		"Can't provide type arguments to a type parameter."
	as diag-type-params-unsupported
		"{a-or-an-decl-kind a.decl-kind} can't have type parameters."
	as diag-type-should-use-syntax
		match a
		as array
			"Prefer to write 't[]' instead of 't array'."
		as fun-data
			"Prefer to write 'r data(x p)' instead of '(r, p) fun-data'."
		as fun-mut
			"Prefer to write 'r mut(x p)' instead of '(r, p) fun-mut'."
		as fun-shared
			"Prefer to write 'r shared(x p)' instead of '(r, p) fun-shared'."
		as map
			"Prefer to write 'v[k]' instead of '(k, v) map'."
		as mut-array
			"Prefer to write 't mut[]' instead of 't mut-array'."
		as mut-map
			"Prefer to write 'v mut[k]' instead of '(k, v) mut-map'."
		as option
			"Prefer to write 't?' instead of 't option'."
		as shared-array
			"Prefer to write 't shared[]' instead of 't shared-array'."
		as shared-map
			"Prefer to write 'v shared[k]' instead of '(k, v) shared-map'."
		as tuple
			"Prefer to write '(t, u)' instead of '(t, u) tuple2'."
	as diag-underscore
		"Unexpected '_' (does not appear in a destructure)."
	as diag-union-member-type-parameter
		"A type parameter can't be a union member."
	as diag-unpack-option-must-be-option
		"Expression to the right of '=' must be an option type. Got {show-type-quoted ctx, a.actual}."
	as diag-unpack-option-unnecessary
		unpacked = show-name ctx, a.unpacked-name
		original = show-name ctx, a.original-name
		if case-type = a.case-type
			quote
				'{a.unpacked-name} = {a.original-name} {case-type}' is unnecessary.
				Just test for '{a.original-name} {case-type}' and use {original} in place of {unpacked}.
				(It will be converted to {show-name ctx, case-type}.)
		else
			quote
				Unpacking '{a.unpacked-name} = {a.original-name}' is unnecessary.
				Just test for {original} and use {original} in place of {unpacked}.
				(It will be converted to non-optional.)
	as diag-unused-import
		kind string = if n = a.imported-name
			"Imported name {show-name ctx, n}"
		else
			"Imported module {show-name ctx, a.imported-module.name.to}"
		"{kind} is unused."
	as diag-unused-local
		reason string = match a.kind
		as completely-unused
			"is unused"
		as read-only
			"is 'mut' but never reassigned"
		as write-only
			"is assigned to but never read"
		"Local {show-name ctx, a.local.name} {reason}."
	as diag-unused-internal-decl
		if a.is-used-locally
			"{show-name ctx, a.name} is only used locally, could be private."
		else
			"{show-name ctx, a.name} is unused."
	as diag-unused-private-decl
		"{show-name ctx, a.name} is unused."
	as diag-visibility-warning
		show-visibility-warning ctx, a
	as diag-wrong-number-type-args
		"{show-name ctx, a.name} expected to get {a.n-expected-type-args} type arguments, but got {a.n-actual-type-args}."

-show string(a lambda-kind)
	match a
	as data_
		"data"
	as shared_
		"shared"
	as mut_
		"mut"
	as explicit-shared
		"mut"

-show string(a diag-builtin-unsupported-kind)
	match a
	as spec_
		"spec"
	as type
		"type"

-to symbol(a diag-loop-disallowed-body)
	match a
	as finally_
		"finally"
	as try_
		"try"

show-diagnostic string(ctx show-diag-ctx, a uri-and-diagnostic)
	"{show-uri-and-range ctx.show, a.where} {string-of-diag ctx, a.kind}"

-expected-kind enum(generic, lambda, return)
-== bool(a expected-kind, b expected-kind)
-show-expected string(ctx show-diag-ctx, a expected-for-diag, kind expected-kind)
	type string = if kind == return
		"return type"
	else
		"type"
	match a
	as expected-for-diag-choices
		if t = opt-only a.types
			"Expected {type} {show-type-quoted ctx, (t, a.type-container)}."
		else
			"Expected one of these {type}s:{show-types-on-lines ctx, a}"
	as expected-for-diag-infer
		"This location has no expected {type}."
	as expected-for-diag-loop
		"Expected a loop 'break' or 'continue'."

-show-types-on-lines string(ctx show-diag-ctx, choices expected-for-diag-choices)
	join for x in choices.types
		"\n\t{show-type-quoted ctx, (x, choices.type-container)}"

-show-modifier string(ctx show-diag-ctx, kind modifier-keyword)
	show-name ctx, "{kind}"::symbol

-decl-kind-of-struct decl-kind(a struct-decl)
	match a.body
	as struct-body-bogus then throw unreachable
	as struct-body-extern-java then throw unreachable
	as builtin-type then throw unreachable
	as enum_ then enum_
	as flags_ then flags_
	as record_ then record_
	as sum-type then variant_

-member-kind enum(enum-member, flags-member, record-field)
-member-kind-of-struct member-kind(a struct-decl)
	match a.body
	as struct-body-bogus then throw unreachable
	as struct-body-extern-java then throw unreachable
	as builtin-type then throw unreachable
	as enum_ then enum-member
	as flags_ then flags-member
	as record_ then record-field
	as sum-type then throw unreachable

-a-or-an-decl-kind string(a decl-kind)
	match a
	as alias_
		"A type alias"
	as builtin_
		"A builtin type"
	as enum_
		"An enum type"
	as flags_
		"A flags type"
	as function_
		"A function"
	as global_
		"A global variable"
	as interface_
		"An interface type"
	as java-interface
		"A Java interface type "
	as record_
		"A record type"
	as spec_
		"A spec"
	as test_
		"A test"
	as thread-local_
		"A thread-local variable"
	as union_
		"A union type"
	as variant_
		"A variant type"

-decl-kind-upper-case string(a decl-kind)
	match a
	as alias_
		"Type alias"
	as builtin_
		"Builtin type"
	as enum_
		"Enum type "
	as flags_
		"Flags type "
	as function_
		"Function "
	as global_
		"Global variable "
	as interface_
		"Interface type "
	as java-interface
		"Java interface type "
	as record_
		"Record type "
	as spec_
		"Spec "
	as test_
		"Test "
	as thread-local_
		"Thread-local variable "
	as union_
		"Union type "
	as variant_
		"Variant type "

-a-or-an-member-kind string(a member-kind)
	match a
	as enum-member
		"An enum member"
	as flags-member
		"A flags member"
	as record-field
		"A record field"

-show-visibility-warning string(ctx show-diag-ctx, a diag-visibility-warning)
	actual string = show-visibility ctx, a.actual-visibility
	default = show-visibility ctx, a.default-visibility
	if a.actual-visibility > a.default-visibility
		match x = a.kind
		as visibility-warning-field
			field = show-name ctx, x.field-name
			record_ = show-name ctx, x.record_.name
			"Field {field} should not be more visible than record {record_} which is only {default}."
		as visibility-warning-field-mutability
			field = show-name ctx, x.field-name
			"Field {field} can't have {actual} mutability when the field itself is {default}."
		as visibility-warning-new
			"{show-name ctx, "new"} function for record {show-name ctx, x.record_.name} " ~~
			"should not have greater visibility than {default} (derived from visibility of fields)."
	else
		assert a.actual-visibility == a.default-visibility
		match x = a.kind
		as visibility-warning-field
			"Fields of record {show-name ctx, x.record_.name} are already {default} by default."
		as visibility-warning-field-mutability
			"Field {show-name ctx, x.field-name} mutability would already be {default} by default."
		as visibility-warning-new
			"The 'new' function for {show-name ctx, x.record_.name} is already " ~~
			"{default} by default (derived from visibility of fields)."

-describe-token-for-unexpected string(a token)
	match a
	as alias_
		"Unexpected keyword 'alias'."
	as and_
		"Unexpected keyword 'and'."
	as as_
		"Unexpected keyword 'as'."
	as assert_
		"Unexpected keyword 'assert'."
	as at
		"Unexpected '@'."
	as bang
		"Unexpected '!'."
	as break_
		"Unexpected keyword 'break'."
	as builtin_
		"Unexpected keyword 'builtin'."
	as brace-left
		"Unexpected '\{'."
	as brace-right
		"Unexpected '}'."
	as bracket-left
		"Unexpected '['."
	as bracket-right
		"Unexpected ']'."
	as case_
		"Unexpected keyword 'case'."
	as catch_
		"Unexpected keyword 'catch'."
	as colon
		"Unexpected ':'."
	as colon2
		"Unexpected ''."
	as colon-equal
		"Unexpected '='."
	as comma
		"Unexpected ','."
	as continue_
		"Unexpected keyword 'continue'."
	as data_
		"Unexpected keyword 'data'."
	as do_
		"Unexpected keyword 'do'."
	as dollar
		"Unexpected '$'."
	as dot
		"Unexpected '.'."
	as elif_
		"Unexpected keyword 'elif'."
	as else_
		"Unexpected keyword 'else'."
	as enum_
		"Unexpected keyword 'enum'."
	as export_
		"Unexpected keyword 'export'."
	as equal
		"Unexpected '='."
	as end-of-file
		"Unexpected end of file."
	as finally_
		"Unexpected keyword 'finally'."
	as flags_
		"Unexpected keyword 'flags'."
	as for_
		"Unexpected keyword 'for'."
	as for-star
		"Unexpected keyword 'for*'."
	as force-data_
		"Unexpected keyword 'force-data'."
	as force-shared_
		"Unexpected keyword 'force-shared'."
	as forbid_
		"Unexpected keyword 'forbid'."
	as global_
		"Unexpected keyword 'global'."
	as guard_
		"Unexpected keyword 'guard'."
	as if_
		"Unexpected keyword 'if'."
	as import_
		"Unexpected keyword 'import'."
	as in_
		"Unexpected keyword 'in'."
	as is_
		"Unexpected keyword 'is'."
	as it_
		"Unexpected keyword 'it'."
	as interface_
		"Unexpected keyword 'interface'."
	as list-dash
		"Unexpected '- '."
	as list-dash-dash
		"Unexpected '-- '."
	as literal-number
		"Unexpected number literal expression."
	as loop_
		"Unexpected keyword 'loop'."
	as match_
		"Unexpected keyword 'match'."
	as mut_
		"Unexpected keyword 'mut'."
	as name
		"Did not expect a name here."
	as name-colon
		"Did not expect a 'name:' here."
	as name-after-bang
		"Did not expect a '!name' here."
	as name-after-question
		"Unexpected '?name'."
	as name-after-tick
		"Unexpected `'name`."
	as name-bang
		"Did not expect a 'name!' here."
	as name-colon-equals
		"Did not expect a 'name=' here."
	as name-equals
		"Did not expect a 'name=' here."
	as newline-dedent
		"Unexpected newline."
	as newline-indent
		"Unexpected newline."
	as newline-same-indent
		"Unexpected newline."
	as no-std_
		"Unexpected keyword 'no-std'."
	as of_
		"Unexpected keyword 'of'."
	as operator-binary
		# This is parse-diag-unexpected-operator instead
		throw unreachable
	as operator-colon-equals
		"Did not expect an operator here."
	as operator-equals
		"Did not expect an operator here."
	as operator-prefix
		"Unexpected prefix operator. (It is only a binary operator if there is a space after it.)"
	as or_
		"Unexpected keyword 'or'."
	as paren-left
		"Unexpected '('."
	as paren-right
		"Unexpected ')'."
	as pure_
		"Unexpected keyword 'pure'."
	as question
		"Unexpected '?'."
	as question-bracket
		"Unexpected '?['."
	as quote-bar-no-interpolated
		"Unexpected '|' string."
	as quote-bar-then-interpolated
		"Unexpected '|' string."
	as quote-block-no-interpolated
		"Unexpected string literal."
	as quote-block-then-interpolated
		"Unexpected string literal."
	as quote-double-no-interpolated
		"Unexpected string literal."
	as quote-double-then-interpolated
		"Unexpected string literal."
	as quote-keyword
		throw unreachable
	as record_
		"Unexpected keyword 'record'."
	as region_
		"Unexpected keyword 'region'."
	as reserved
		"Unexpected reserved keyword."
	as shared_
		"Unexpected keyword 'shared'."
	as spec_
		"Unexpected keyword 'spec'."
	as test_
		"Unexpected keyword 'test'."
	as then_
		"Unexpected keyword 'then'."
	as thread-local_
		"Unexpected keyword 'thread-local'."
	as throw_
		"Unexpected keyword 'throw'."
	as trusted_
		"Unexpected keyword 'trusted'."
	as try_
		"Unexpected keyword 'try'."
	as underscore
		"Unexpected '_'."
	as union_
		"Unexpected keyword 'union'."
	as unless_
		"Unexpected keyword 'unless'."
	as until_
		"Unexpected keyword 'until'."
	as variant_
		"Unexpected keyword 'variant'."
	as while_
		"Unexpected keyword 'while'."
	as with_
		"Unexpected keyword 'with'."

-to-hex-with-padding string(a nat, size nat)
	"0x{pad-left a.to-hex, size, "0"}"
