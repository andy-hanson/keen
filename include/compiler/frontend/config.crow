import
	crow/parse
	../model/model
	../model/uri

parse-config config(config-uri uri, text char8[])
	try x = json parse text.to catch parse-error _ : throw todo # config-uri config-for-diag (throw todo) ----------------------------------
	assert o ?= x json-object : todo
	diags diagnostic mut[] = ()
	content = config-uri.parent-or-empty parse-config-recur diags, o
	(config-uri,), diags.move-to, content.include, content.extern_

-config-content record(include config-import-uris, extern_ config-extern-uris)
-new config-content()
	(), ()
-with-include config-content(a config-content, include config-import-uris)
	include, a.extern_
-with-extern config-content(a config-content, extern_ config-extern-uris)
	a.include, extern_

-parse-config-recur config-content(dir-containing-config uri, diags diagnostic mut[], o json-object)
	res mut config-content = ()
	for key, value : o fields
		res := match key
		as "include"
			res with-include (dir-containing-config parse-include diags, value)
		as "extern"
			res with-extern (dir-containing-config parse-extern diags, value)
		else
			throw todo
	res

-parse-include config-import-uris(dir-containing-config uri, diags diagnostic mut[], json json)
	diags parse-symbol-map json, value =>
		dir-containing-config parse-uri-or-bogus diags, value

-parse-extern config-extern-uris(dir-containing-config uri, diags diagnostic mut[], json json)
	diags parse-symbol-map json, value =>
		if value != null
			(dir-containing-config parse-uri-or-bogus diags, value),

-parse-uri-or-bogus uri(dir-containing-config uri, diags diagnostic mut[], value json)
	dir-containing-config parse-uri diags, value ?? bogus-uri
-parse-uri uri?(dir-containing-config uri, diags diagnostic mut[], json json)
	_ = diags
	assert x ?= json string : todo
	(dir-containing-config parse-uri-with-cwd x),

-parse-symbol-map[t] t[symbol](diags diagnostic mut[], json json, cb-value t mut(x json))
	_ = diags
	res t mut[symbol] = ()
	if o ?= json json-object
		for key, json-value : o fields
			forbid _ ?= res[key] : todo
			res[key] := cb-value[json-value]
	res move-to
