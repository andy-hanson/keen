import
	crow/col/mut-slice
	../../crow/pointer: as-any-mut-pointer, reference-from-pointer
	../interpret/bytecode
	../interpret/run-bytecode: synthetic-call
	../interpret/stacks
	../interpret/extern_
	../model/low-model
	../model/uri
	../util/util

real-extern extern_() summon, unsafe, (dyncall, dynload, native) extern
	debug-names mut debug-names = ()
	load-extern-pointers: (libraries, write-error) =>
		res = libraries load-libraries write-error
		debug-names := res debug-names
		res fun-pointers
	make-synthetic-fun-pointers: inputs =>
		inputs make-synthetic-fun-pointers
	aggregate-cbs: do
		new-aggregate: (count-fields, size-bytes) => count-fields new-aggregate size-bytes
		add-field: (aggr, field-offset, field-type) => aggr aggregate-add-field field-offset, field-type
		close: x => x dcCloseAggr
	do-dyn-call: (fun-pointer, sig) =>
		fun-pointer dynamic-call-fun-pointer debug-names[fun-pointer.pointer.to], sig

-debug-names alias
	symbol[nat]

-loaded-libraries record(debug-names debug-names, fun-pointers extern-pointers-for-all-libraries?) # TODO: just use tuple?
-load-libraries loaded-libraries(
	libraries extern-libraries,
	write-error write-error,
) summon, unsafe, (dynload, native) extern
	success mut = true
	libs DLLib*[] = for x : libraries
		if library ?= x.library-name get-library x.configured-dir, write-error
			library
		else
			success := false
			null
	if success
		libraries load-libraries-inner libs, write-error
	else
		(), ()

-get-library DLLib*?(
	library-name symbol,
	configured-dir uri?,
	write-error write-error,
) summon, unsafe, (dynload, native) extern
	file-name = library-name dll-or-so-name
	from-uri = if dir ?= configured-dir
		dir / file-name try-load-library-from-uri
	if uri ?= from-uri
		uri,
	else
		default-library DLLib*? mut() = () =>
			if extern windows
				"ucrtbase.dll" load-library-from-name write-error
			else
				(),
		match library-name
		as libc
			default-library[]
		as linux
			default-library[]
		as posix
			default-library[]
		as pthread
			"libpthread.so.0" load-library-from-name write-error
		as windows
			"kernel32.dll" load-library-from-name write-error
		else
			file-name load-library-from-name write-error

-dll-or-so-name symbol(library-name symbol) unsafe
	if extern windows
		"{library-name}.dll"
	else
		"lib{library-name}.so"

-try-load-library-from-uri DLLib*?(uri uri) summon, unsafe, (dynload, native) extern
	guard uri uri-is-file
	res = uri.as-file-path.to dlLoadLibrary
	unless res == null
		res,

-load-library-from-name DLLib*?(name symbol, write-error write-error) summon, unsafe, (dynload, native) extern
	res = name.to dlLoadLibrary
	if res == null
		write-error["Could not load library {name.to quote}."]
		()
	else
		res,

-to c-string(a symbol) unsafe, native extern # TODO: should this be in std somewhere? --------------------------------------------
	a.to::string to

-load-libraries-inner loaded-libraries(
	libraries extern-libraries,
	libs DLLib*[],
	write-error write-error,
) summon, unsafe, (dynload, native) extern
	debug-names symbol mut[nat] = ()
	failures (symbol, symbol) mut[] = ()
	res extern-pointers-for-all-libraries = for x, lib : libraries zip libs
		x.library-name, for import-name : x import-names
			import-name, if p ?= lib get-extern-pointer import-name
				# sometimes two names refer to the same function -- just go with an arbitrary one
				debug-names[p.pointer to] := import-name
				p
			else
				failures ~= (x.library-name, import-name)
				null,
	for fun, lib : failures
		write-error["Could not load extern function {fun.to quote} from library {lib.to quote}"]
	debug-names.move-to, (failures is-empty ? (res,))

-get-extern-pointer extern-pointer?(library DLLib*, name symbol) summon, unsafe, (dynload, native) extern
	ptr = library dlFindSymbol name.to
	unless ptr == null
		(ptr,),

-dc-vm global(DCCallVM mut*)

-dynamic-call-fun-pointer void(fun fun-pointer, debug-name symbol?, sig dyn-call-sig) summon, unsafe, (dyncall, native) extern
	_ = debug-name
	if dc-vm == null
		# first time an extern function called on this thread
		# TODO: dyncall doesn't seem to have any internal checking,
		# so overflowing this just leads to wierd behavior.
		# (this happens if you call a native function that calls back into crow,
		# which calls another native function, etc, growing the dyncall stack indefinitely.)
		# TODO: manually track the stack size and abort on failure
		dc-vm = 0x1000 dcNewCallVM
		forbid dc-vm == null
		dc-vm dcMode DC_CALL_C_DEFAULT
	
	ptr DCpointer = fun.pointer.as-mut pointer-cast
	dc-vm dcReset

	if ag ?= sig.return-type dyn-call-type-aggregate
		dc-vm dcBeginCallAggr ag.dc-aggr

	stacks = load-stacks
	args word mut-slice reference = (stacks data-pop-n sig.count-parameter-entries),
	for type : sig parameter-types
		dc-vm add-arg-for-dyn-call args, type
	assert *args is-empty
	dc-vm do-dyn-call-for-type ptr, sig.return-type, stacks
	dc-vm dcReset
	stacks save-stacks

-add-arg-for-dyn-call void(
	dc-vm DCCallVM mut*,
	args word mut-slice reference,
	parameter-type dyn-call-type,
) summon, unsafe, (dyncall, native) extern
	match parameter-type
	as primitive-type x
		value = (*args)[0]
		*args := (*args)[1 .. end]
		match x
		as bool
			dc-vm dcArgBool value.to
		as char8
			dc-vm dcArgChar value.to
		as int8
			dc-vm dcArgChar value.to
		as nat8
			dc-vm dcArgChar value.to
		as int16
			dc-vm dcArgShort value.to
		as nat16
			dc-vm dcArgShort value.to
		as char32
			dc-vm dcArgInt value.to
		as int32
			dc-vm dcArgInt value.to
		as nat32
			dc-vm dcArgInt value.to
		as int64
			dc-vm dcArgLongLong value.to
		as nat64
			dc-vm dcArgLongLong value.to
		as float32
			dc-vm dcArgFloat value.to
		as float64
			dc-vm dcArgFloat value.to
		as void
			throw unreachable
	as dyn-call-type-pointer
		dc-vm dcArgPointer (*args)[0].to
		*args := (*args)[1 .. end]
	as dyn-call-type-aggregate x
		dc-vm dcArgAggr x.dc-aggr, args->begin-pointer.pointer-cast
		*args := (*args)[x.size-words .. end]

-do-dyn-call-for-type void(
	dc-vm DCCallVM mut*,
	ptr DCpointer,
	return-type dyn-call-type,
	stacks stacks,
) summon, unsafe, (dyncall, native) extern
	match return-type
	as primitive-type x
		dc-vm dc-call-primitive ptr, x, stacks
	as dyn-call-type-pointer
		stacks data-push (dc-vm dcCallPointer ptr to)
	as dyn-call-type-aggregate x
		out = stacks data-push-uninitialized x.size-words
		ret = dc-vm dcCallAggr ptr, x.dc-aggr, out.pointer-cast
		assert ret == out.pointer-cast

-dc-call-primitive void(dc-vm DCCallVM mut*, ptr DCpointer, type primitive-type, stacks stacks) summon, unsafe, (dyncall, native) extern
	match type
	as bool
		stacks data-push (dc-vm dcCallBool ptr to)
	# TODO: could simplify the code by having a function to combine 'type' into what dyncall cares about (which is just the size and int vs float)
	as char8
		stacks data-push (dc-vm dcCallChar ptr to)
	as int8
		stacks data-push (dc-vm dcCallChar ptr to)
	as nat8
		stacks data-push (dc-vm dcCallChar ptr to)
	as int16
		stacks data-push (dc-vm dcCallShort ptr to)
	as nat16
		stacks data-push (dc-vm dcCallShort ptr to)
	as char32
		stacks data-push (dc-vm dcCallInt ptr to)
	as int32
		stacks data-push (dc-vm dcCallInt ptr to)
	as nat32
		stacks data-push (dc-vm dcCallInt ptr to)
	as int64
		stacks data-push (dc-vm dcCallLongLong ptr to)
	as nat64
		stacks data-push (dc-vm dcCallLongLong ptr to)
	as float32
		stacks data-push (dc-vm dcCallFloat ptr to)
	as float64
		stacks data-push (dc-vm dcCallDouble ptr to)
	as void
		dc-vm dcCallVoid ptr

-user-data record(sig dyn-call-sig, operation-ptr operation*) mut, by-ref

-make-synthetic-fun-pointers fun-pointer[](inputs fun-pointer-inputs[]) summon, unsafe, (dyncall, native) extern
	for x : inputs
		x.sig synthetic-fun-pointer-for-sig x.operation-pointer
-synthetic-fun-pointer-for-sig fun-pointer(
	sig dyn-call-sig,
	operation-ptr operation*,
) summon, unsafe, (dyncall, native) extern
	aggrs DCaggr* mut[] = ()
	sig-str string = with sig-out : build
		throw todo # TODO: I need to make sure 'aggrs' is non-temporary -----------------------------------------------------------
		write-to-sig void mut(x dyn-call-type) = x =>
			sig-out ~= x.dyn-call-sig-char to
			if ag ?= x dyn-call-type-aggregate
				aggrs ~= ag dc-aggr
		for x : sig parameter-types
			write-to-sig[x]
		sig-out ~= ")"
		write-to-sig[sig return-type]
	user-data user-data = sig, operation-ptr
	res = sig-str.to dcbNewCallback2 &callback-handler, user-data.as-any-mut-pointer, aggrs.move-to.begin-pointer
	res.as-const.pointer-cast,

callback-handler char8(
	_ DCCallback mut*,
	args DCArgs mut*,
	result DCValue mut*,
	user-data-ptr any-mut-pointer,
) bare, summon, unsafe, (dyncall, native) extern
	user-data user-data = user-data-ptr reference-from-pointer
	sig = user-data sig
	fill-stacks void mut(stacks stacks) = stacks =>
		for arg-type : sig parameter-types
			args dyncall-get-arg arg-type, stacks
	user-data.operation-ptr synthetic-call fill-stacks, stacks =>
		args dyncall-set-result result, sig.return-type, stacks
	sig.return-type dyn-call-sig-char

-dyn-call-sig-char char8(a dyn-call-type) bare
	match a
	as primitive-type x
		match x
		as bool
			"B"
		as char8
			"c"
		as char32
			"i"
		as int8
			"c"
		as int16
			"s"
		as int32
			"i"
		as int64
			"l"
		as float32
			"f"
		as float64
			"d"
		as nat8
			"C"
		as nat16
			"S"
		as nat32
			"I"
		as nat64
			"L"
		as void
			"v"
	as dyn-call-type-pointer
		"p"
	as dyn-call-type-aggregate _
		# Aggregate is sent out-of-band in 'dcArgAggr' or 'dcCallAggr'
		"A"

-dyncall-get-arg void(
	args DCArgs mut*,
	type dyn-call-type,
	stacks stacks,
) summon, unsafe, (dyncall, native) extern
	match type
	as primitive-type x
		stacks data-push match x
		as bool
			args.dcbArgBool to
		as char8
			args.dcbArgChar to
		as char32
			args.dcbArgInt to
		as int8
			args.dcbArgChar to
		as int16
			args.dcbArgShort to
		as int32
			args.dcbArgInt to
		as int64
			args.dcbArgLongLong to
		as float32
			args.dcbArgFloat to
		as float64
			args.dcbArgDouble to
		as nat8
			args.dcbArgUChar to
		as nat16
			args.dcbArgUShort to
		as nat32
			args.dcbArgUInt to
		as nat64
			args.dcbArgULongLong to
		as void
			throw unreachable
	as dyn-call-type-pointer
		stacks data-push args.dcbArgPointer.to
	as dyn-call-type-aggregate x
		ptr = stacks data-push-uninitialized x.size-words
		out = args dcbArgAggr ptr.pointer-cast
		assert out == ptr.pointer-cast

-dyncall-set-result void(
	args DCArgs mut*,
	result DCValue mut*,
	type dyn-call-type,
	stacks stacks,
) summon, unsafe, (dyncall, native) extern
	match type
	as primitive-type x
		match x
		as bool
			result->B := stacks.data-pop to
		as char8
			result->c := stacks.data-pop to
		as int8
			result->c := stacks.data-pop to
		as int16
			result->s := stacks.data-pop to
		as char32
			result->i := stacks.data-pop to
		as int32
			result->i := stacks.data-pop to
		as int64
			result->l := stacks.data-pop to
		as float32
			result->f := stacks.data-pop to
		as float64
			result->d := stacks.data-pop to
		as nat8
			result->C := stacks.data-pop to
		as nat16
			result->S := stacks.data-pop to
		as nat32
			result->I := stacks.data-pop to
		as nat64
			result->L := stacks.data-pop to
		as void
			()
	as dyn-call-type-pointer
		result->p := stacks.data-pop to
	as dyn-call-type-aggregate x
		args dcbReturnAggr result, (stacks data-pop-n x.size-words).begin-pointer.as-any-mut-pointer

-new-aggregate DCaggr mut*(count-fields nat, size-bytes nat) summon, unsafe, dyncall extern # TODO: inline? ------------------------------------------------------
	count-fields dcNewAggr size-bytes

-aggregate-add-field void(aggr DCaggr mut*, field-offset nat, field-type dyn-call-type) summon, unsafe, dyncall extern
	forbid _ ?= field-type dyn-call-type-aggregate
	aggr dcAggrField field-type.dyn-call-sig-char, field-offset.to, 1

