dcCallBool DCbool(vm DCCallVM mut*, funcptr DCpointer) dyncall extern
dcCallChar DCchar(vm DCCallVM mut*, funcptr DCpointer) dyncall extern
dcCallShort DCshort(vm DCCallVM mut*, funcptr DCpointer) dyncall extern
dcCallInt DCint(vm DCCallVM mut*, funcptr DCpointer) dyncall extern
