dcArgChar void(vm DCCallVM mut*, value DCchar) dyncall extern
dcArgShort void(vm DCCallVM mut*, value DCshort) dyncall extern
dcArgInt void(vm DCCallVM mut*, value DCint) dyncall extern
dcArgLongLong void(vm DCCallVM mut*, value DClonglong) dyncall extern
dcArgFloat void(vm DCCallVM mut*, value DCfloat) dyncall extern
dcArgDouble void(vm DCCallVM mut*, value DCdouble) dyncall extern
dcArgPointer void(vm DCCallVM mut*, value DCpointer) dyncall extern
dcArgAggr void(vm DCCallVM mut*, ag DCaggr*, value any-mut-pointer) dyncall extern
