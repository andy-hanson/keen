import
	../frontend/lang
	../model/source-range
	../model/uri
	../model/version-info
	../util/exit-code

command record(kind command-kind, options command-options)
| Options common to all comands
command-options record
	perf bool
new command-options()
	false,
command-kind union
	build-command
	check-command
	document-command
	help-command
	lsp-command
	print-command
	run-command
	version-command
build-command record
	main main-kind
	options crow-build-options
	times nat
check-command record
	| May include '.crow' or 'crow-config.json' URIs
	root-uris uri[]
	times nat
document-command record(root-uris uri[])
| Used for either explicit '--help' or for any command parse error
help-command record(help-text string, exit-code exit-code)
lsp-command record
print-command record(kind print-kind, main-uri uri)
print-kind union
	print-ast
	print-model
	print-concrete-model
	print-ide-at-pos
	print-ide-whole-file
print-ast record
print-model record
print-concrete-model record
print-ide-at-pos record(kind print-ide-at-pos-kind, line-and-column line-and-column)
print-ide-at-pos-kind enum
	completion
	definition
	document-highlight
	hover
	implementation
	references
	rename
	signature-help
	type-definition
to print-ide-at-pos-kind?(a symbol)
print-ide-whole-file enum
	code-lenses
	folding-ranges
	inlay-hints
	tokens
to print-ide-whole-file?(a symbol)
run-command record(main main-kind, options run-options)
run-options record
version-command record

crow-build-options record
	out single-build-output[]

single-build-output record
	kind single-build-output-kind
	path file-path
single-build-output-kind enum
	java
	js-script
	js-modules # RM ----------------------------------------------------------------------------------------------------------
	node-js-script
	node-js-modules # RM -----------------------------------------------------------------------------------------------------
== bool(a single-build-output-kind, b single-build-output-kind)

targets-for-build build-target[](command build-command)
	res build-target mut[] = ()
	for output : command.options out
		target = output.kind target-for-build-output
		unless target in res
			res ~= target
	res move-to
-target-for-build-output build-target(a single-build-output-kind)
	match a
	as java
		java
	as js-script
		web
	as js-modules
		web
	as node-js-script
		node-js
	as node-js-modules
		node-js
