import
	../frontend/lang
	../model/model
	../model/source-range
	../model/uri
	../util/exit-code

command record(kind command-kind, options command-options)
| Options common to all comands
command-options record
	perf bool
new command-options()
	false,
command-kind union
	build-command
	check-command
	document-command
	help-command
	lsp-command
	print-ast-command
	print-concrete-model-command
	print-dependencies-command
	print-ide-at-pos-command
	print-ide-whole-file-command
	print-model-command
	run-command
	version-command
build-command record
	main main-kind
	out single-build-output[]
	options build-command-options
	times nat
	watch bool
build-command-options record
	sanity-checks sanity-checks
sanity-checks enum
	no-sanity-checks
	all-sanity-checks
== bool(a sanity-checks, b sanity-checks)
single-build-output record
	path file-path
	kind build-target
check-command record
	| May include '.crow' or 'crow-config.json' URIs
	root-uris uri[]
	times nat
	show-color bool
	show-all-diagnostics bool
document-command record(root-uris uri[])
| Used for either explicit '--help' or for any command parse error
help-command record(help-text string, exit-code exit-code)
lsp-command record
print-ast-command record(uri uri)
print-dependencies-command record(root-uris uri[], format print-dependencies-format)
print-dependencies-format enum(dot, flat)
print-model-command record(root-uris uri[])
print-concrete-model-command record(main uri)
print-ide-at-pos-command record(kind print-ide-at-pos-kind, where uri-line-and-column)
print-ide-whole-file-command record(kind print-ide-whole-file-kind, uri uri)
to print-dependencies-format?(a symbol)
to print-dependencies-format?(a string)
	a.to::symbol to
print-ide-at-pos record(kind print-ide-at-pos-kind, line-and-column line-and-column)
print-ide-at-pos-kind enum
	completion
	definition
	document-highlight
	hover
	implementation
	references
	rename
	signature-help
	type-definition
to print-ide-at-pos-kind?(a symbol)
to print-ide-at-pos-kind?(a string)
	a.to to
print-ide-whole-file-kind enum
	code-lenses
	folding-ranges
	inlay-hints
	tokens
== bool(a print-ide-whole-file-kind, b print-ide-whole-file-kind)
to print-ide-whole-file-kind?(a symbol)
to print-ide-whole-file-kind?(a string)
	a.to to
run-command record(main main-kind, options run-options)
run-options record
	node-js bool
	watch bool
new run-options()
	node-js: false
	watch: false
version-command record
