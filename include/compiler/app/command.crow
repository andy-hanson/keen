import
	../frontend/lang
	../model/model
	../model/source-range
	../model/uri
	../util/exit-code

command record(kind command-kind, options command-options)
| Options common to all comands
command-options record
	perf bool
new command-options()
	false,
command-kind union
	build-command
	check-command
	document-command
	help-command
	lsp-command
	print-command
	run-command
	version-command
build-command record
	main main-kind
	out single-build-output[]
	options build-command-options
	times nat
	watch bool
build-command-options record
	sanity-checks sanity-checks
sanity-checks enum
	no-sanity-checks
	all-sanity-checks
== bool(a sanity-checks, b sanity-checks)
single-build-output record
	path file-path
	kind build-target
check-command record
	| May include '.crow' or 'crow-config.json' URIs
	root-uris uri[]
	times nat
	show-color bool
	show-all-diagnostics bool
document-command record(root-uris uri[])
| Used for either explicit '--help' or for any command parse error
help-command record(help-text string, exit-code exit-code)
lsp-command record
print-command record(kind print-kind, main-uri uri)
print-kind union
	print-ast
	print-model
	print-concrete-model
	print-ide-at-pos
	print-ide-whole-file
print-ast record
print-model record
print-concrete-model record
print-ide-at-pos record(kind print-ide-at-pos-kind, line-and-column line-and-column)
print-ide-at-pos-kind enum
	completion
	definition
	document-highlight
	hover
	implementation
	references
	rename
	signature-help
	type-definition
to print-ide-at-pos-kind?(a symbol)
print-ide-whole-file enum
	code-lenses
	folding-ranges
	inlay-hints
	tokens
to print-ide-whole-file?(a symbol)
run-command record(main main-kind, options run-options)
run-options record
	node-js bool
new run-options()
	node-js: false
version-command record
