import
	../frontend/lang
	../model/model
	../model/source-range
	../model/uri
	../model/version-info
	../util/exit-code

command record(kind command-kind, options command-options)
| Options common to all comands
command-options record
	perf bool
new command-options()
	false,
command-kind union(
	build-command,
	check-command,
	document-command,
	help-command,
	lsp-command,
	print-command,
	run-command,
	version-command
)
build-command record(main main-kind, options crow-build-options)
check-command record(root-uris uri[])
document-command record(root-uris uri[])
| Used for either explicit '--help' or for any command parse error
help-command record(help-text string, exit-code exit-code)
lsp-command record
print-command record(kind print-kind, main-uri uri)
print-kind union(
	print-ast,
	print-model,
	print-concrete-model,
	print-low-model,
	print-ide-at-pos,
	print-ide-whole-file
)
print-ast record
print-model record
print-concrete-model record
print-low-model record
print-ide-at-pos record(kind print-ide-at-pos-kind, line-and-column line-and-column)
print-ide-at-pos-kind enum
	completion
	definition
	document-highlight
	hover
	implementation
	references
	rename
	signature-help
	type-definition
to print-ide-at-pos-kind?(a symbol)
print-ide-whole-file enum
	code-lenses
	folding-ranges
	inlay-hints
	tokens
to print-ide-whole-file?(a symbol)
run-command record(main main-kind, options run-options)
version-command record

run-options union(
	aot-run-options,
	interpret-run-options,
	jit-run-options,
	node-js-run-options
)
aot-run-options record(version version-options, compile-options c-compile-options)
interpret-run-options record(fake-extern bool, version version-options)
node-js-run-options record
jit-run-options record(version version-options, options jit-options)

is-fake-extern bool(a run-options)
	if x ?= a interpret-run-options
		x fake-extern

crow-build-options record
	version version-options
	out single-build-output[]
	c-compile-options c-compile-options

single-build-output record
	kind single-build-output-kind
	path file-path
single-build-output-kind enum
	c
	executable
	js-script
	js-modules
	node-js-script
	node-js-modules

targets-for-build build-target[](os os, command build-command)
	res build-target mut[] = ()
	for output : command.options out
		target = os target-for-build-output output.kind
		unless target in res
			res ~= target
	res move-to
-target-for-build-output build-target(os os, a single-build-output-kind)
	match a
	as c
		os build-target-native
	as executable
		os build-target-native
	as js-script
		build-target-js
	as js-modules
		build-target-js
	as node-js-script
		build-target-js
	as node-js-modules
		build-target-js
