import
	crow/parse-command
	crow/string/util
	../../crow/parse
	../../crow/private/parse-util
	../frontend/lang
	../model/model: build-target, java, js
	../model/source-range
	../model/uri
	../util/exit-code
	../util/util
	./command

-os enum(posix, windows)
-get-os os() summon
	if trusted extern windows
		windows
	else
		posix

parse-command command(cwd file-path, args string[]) summon
	cwd parse-command-inner get-os, args

parse-command-inner command(cwd file-path, os os, args string[])
	arg0 string = unless args is-empty then args[0]
	if arg0 ends-with ".crow"
		main main-kind = (cwd parse-uri-with-cwd arg0) main-kind-main-function args[1 .. end].to
		kind command-kind = main run-command ()
		kind, ()
	elif name = arg0 command-name
		cwd parse-command-from-name os, name, args[1 .. end].to.parse-command
	else
		kind: help-all-text help-command if arg0 == "help" or arg0 == "--help" then ok else error
		options: ()

-parse-command-from-name command(cwd file-path, os os, name command-name, all-args parsed-command)
	args, help, options = all-args extract-options
	if help
		(name.help-for-command help-command ok), options
	else
		diags diags = ()
		res = cwd parse-command-kind os, name, args, diags
		if diags is-empty
			res, options
		else
			show-diags string = "\n" join for x in diags then "{x}"
			help-str string = "Command syntax error:\n{show-diags}\n{name help-for-command}"
			(help-str help-command error), options

-extract-options (parsed-command, bool, command-options)(a parsed-command)
	args2, help = a extract "help"
	args3, perf = args2 extract "perf"
	- args3
	- _ = help
	- !!perf,

-extract (parsed-command, string[]?)(a parsed-command, name symbol)
	if value, rest = a.named try-remove name
		(a.nameless, rest, a.after), value
	else
		a, ()

-bogus command-kind()
	"This should not appear" help-command error

-command-name enum
	build
	check
	lsp
	print
	run
	test_
	version
-show string(a command-name)
	match a
	as build
		"build"
	as check
		"check"
	as lsp
		"lsp"
	as print
		"print"
	as run
		"run"
	as test_
		"test"
	as version
		"version"
-== bool(a command-name, b command-name)
-members command-name[]()
-command-name command-name?(a string)
	match a
	as build
		build
	as check
		check
	as lsp
		lsp
	as print
		print
	as run
		run
	as "test"
		test_
	as version
		version
	else
		()

-diags alias
	diag mut[]
-diag union
	build-out-bad-file-extension
	expected-crow-uri
	expected-crow-or-crow-config-uri
	expected-nat
	expected-paths
	needs-single-path
	parse-file-path
	print-kind-invalid
	redundant-part
	test-line-number-invalid
	unexpected-part
	unexpected-part-args
	unexpected-before
-build-out-bad-file-extension record(executable-extension symbol)
-expected-crow-uri record(actual string)
-expected-crow-or-crow-config-uri record(actual string)
-expected-nat record(tag symbol?, actual string)
-expected-paths record(tag string?)
-needs-single-path record(actual nat)
-parse-file-path record(actual string)
-print-kind-invalid record
-redundant-part record
	redundant-tag string
	| This causes {redundant-tag} to be redundant
	other-tag string
-test-line-number-invalid record
-unexpected-part record(tag symbol)
-unexpected-part-args record(tag symbol, args string[])
-unexpected-before record(arg string)

-show string(a diag)
	match a
	as build-out-bad-file-extension
		"Build output must be a '.c', '.java', '.js', or '{a.executable-extension}' file."
	as expected-crow-uri
		"Expected path to a '.crow' file, instead got {a.actual quoted}."
	as expected-crow-or-crow-config-uri
		"Expected path to a '.crow' or '.crow-config' file, instead got {a.actual quoted}."
	as expected-nat
		if tag = a tag
			"Expected argument to '--{tag}' to be a natural number, instead got {a.actual quoted}."
		else
			"This command expects a natural number, instead got {a.actual quoted}."
	as expected-paths
		if tag = a tag
			"Argument '--{tag}' expects a list of paths."
		else
			"This command expects a list of paths."
	as needs-single-path
		if a.actual == 0
			"This command needs a path."
		else
			"This command expects a single path. Instead got {a actual}."
	as parse-file-path
		"Not a valid file path: {a.actual quoted}."
	as print-kind-invalid
		"Not a valid print command."
	as redundant-part
		"{a.redundant-tag quoted} is redundant given '--{a other-tag}'."
	as test-line-number-invalid
		"Specifying a test line number only works when there is a single test file."
	as unexpected-part
		"Unexpected argument '--{a tag}'."
	as unexpected-part-args
		"Argument '--{a tag}' is a flag and should not have any values (starting with {a.args[0] quoted}."
	as unexpected-before
		"Unexpected un-named argument {a.arg quoted}."

-parse-command-kind command-kind
	cwd file-path
	os os
	command-name command-name
	args parsed-command
	diags diags
do
	match command-name
	as build
		cwd parse-build-command diags, os, args
	as check
		options = diags parse-check-options args.named
		diags expect-empty-after-dash-dash args.after
		paths = cwd parse-root-uris diags, args.nameless
		::check-command
		root-uris: paths
		times: options times
		show-color: options !no-color
		show-all-diagnostics: options show-all-diags
	as lsp
		diags expect-all-empty args
		lsp-command
	as print
		cwd parse-print-command diags, args
	as run
		options = diags parse-run-options args.named, false run-options
		main = cwd parse-main-uri diags, args.nameless.to
		main main-kind-main-function args.after run-command options
	as test_
		options = diags parse-run-options args.named, true
		diags expect-empty-after-dash-dash args.after
		main = cwd parse-main-kind-for-test diags, args.nameless, options.all
		main run-command options.run-options
	as version
		diags expect-all-empty args
		version-command

-expect-all-empty void(diags diags, args parsed-command)
	diags expect-empty-before args.nameless
	diags expect-empty-parts args.named
	diags expect-empty-after-dash-dash args.after
-expect-empty-before void(diags diags, before string[])
	unless before is-empty
		diags ~= before[0] unexpected-before
-expect-empty-parts void(diags diags, parts string[][symbol])
	for tag, _ in parts
		diags ~= tag unexpected-part
-expect-empty-after-dash-dash void(diags diags, after string[])
	unless after is-empty
		diags ~= "--" unexpected-part

default-executable-extension symbol(os os)
	match os
	as posix
		""
	as windows
		".exe"

-parse-main-kind-for-test main-kind(cwd file-path, diags diags, args string[], all bool)
	line nat? = if args.size == 2
		args[1] parse-line
	if args.size == 2 and !line
		diags ~= () expected-nat args[1]
	if args.size != 1 and args.size != 2
		diags ~= args.size needs-single-path
		bogus
	else
		uri = cwd parse-uri-with-cwd args[0]
		match uri file-type
		as crow
			if all and line
				diags ~= test-line-number-invalid
			all main-kind-tests-at-uri uri, line
		as crow-config
			if line
				diags ~= test-line-number-invalid
			all main-kind-tests-in-config uri
		else
			diags ~= args[0] expected-crow-or-crow-config-uri
			bogus
-bogus main-kind()
	() main-kind-tests-at-uri (), ()

-parse-main-uri uri(cwd file-path, diags diags, args string array-view)
	if arg = args opt-only
		cwd parse-crow-uri diags, arg
	else
		diags ~= args.size needs-single-path
		()

-parse-crow-or-crowd-uri uri(cwd file-path, diags diags, arg string)
	uri = cwd parse-uri-with-cwd arg
	match uri file-type
	as crow
		()
	as crowd
		()
	else
		diags ~= arg expected-crow-uri
	uri

-parse-crow-uri uri(cwd file-path, diags diags, arg string)
	uri = cwd parse-uri-with-cwd arg
	if uri.file-type != crow
		diags ~= arg expected-crow-uri
	uri

-parse-crow-or-crow-config-uri uri(cwd file-path, diags diags, arg string)
	uri = cwd parse-uri-with-cwd arg
	unless uri is-crow-or-crow-config
		diags ~= arg expected-crow-or-crow-config-uri
	uri
-is-crow-or-crow-config bool(a uri)
	type = a file-type
	type in (crow, crow-config)::file-type[]

-parse-root-uris uri[](cwd file-path, diags diags, args string[])
	if args is-empty
		diags ~= () expected-paths
	for arg in args
		cwd parse-crow-or-crow-config-uri diags, arg

-parse-print-command command-kind(cwd file-path, diags diags, args parsed-command)
	diags expect-empty-after-dash-dash args.after
	subcommand = args.nameless[0]
	res command-kind? = match subcommand
	as ast
		guard args.named is-empty
		cwd parse-main-uri diags, args.nameless[1 .. end] print-ast-command
	as dependencies
		uris = cwd parse-root-uris diags, args.nameless[1 .. end].to
		guard format print-dependencies-format = if args.named is-empty
			dot
		elif args.named.size == 1
			args.named["format"].?opt-only ?to
		uris print-dependencies-command format
	as model
		guard args.named is-empty
		uris = cwd parse-root-uris diags, args.nameless[1 .. end].to
		uris print-model-command
	as concrete-model
		guard args.named is-empty
		main = cwd parse-main-uri diags, args.nameless.to
		main print-concrete-model-command
	else
		guard args.named is-empty
		if kind = subcommand.to::print-ide-at-pos-kind?
			guard args.nameless.size == 3
			guard lc = args.nameless[2] parse-line-and-column
			main = cwd parse-main-uri diags, args.nameless[1 .. 2]
			kind print-ide-at-pos-command (main, lc)
		elif kind = subcommand.to::print-ide-whole-file-kind?
			guard args.nameless.size == 2
			arg = args.nameless[1]
			kind print-ide-whole-file-command if kind == tokens
				cwd parse-crow-or-crowd-uri diags, arg
			else
				cwd parse-crow-uri diags, arg
	res else
		diags ~= print-kind-invalid
		bogus

parse-line-and-column line-and-column?(a string) # TODO: make it neater using a grammar -------------------------------------------------------
	iter = a begin
	guard line = iter.try-take-nat convert-from-1-indexed
	guard iter try-take-char8 ":"
	guard column = iter.try-take-nat convert-from-1-indexed
	guard iter is-at-end
	line, column
-parse-line nat?(a string) # TODO: make it neater using a grammar -------------------------------------------------------
	iter = a begin
	guard line = iter.try-take-nat convert-from-1-indexed
	guard iter is-at-end
	line to
-convert-from-1-indexed nat32?(a nat?) # TODO: this would be better if it caught exceptions? ---------------------------------
	guard a and a != 0
	n = a - 1
	guard n <= max-value::nat32.to
	n to
-try-take-nat nat?(a string-iterator)
	if a.peek8 is-digit
		a take-nat

-parse-build-command command-kind(cwd file-path, diags diags, os os, args parsed-command)
	diags expect-empty-after-dash-dash args.after
	out mut single-build-output[] = ()
	test_ mut bool = false
	all mut bool = false
	sanity-checks mut = no-sanity-checks
	times mut nat = 1
	watch mut bool = false
	for part in args named
		tag, values = part
		match tag
		as out
			out := cwd parse-build-out os, diags, values
		as "test"
			diags expect-flag part
			test_ := true
		as all
			diags expect-flag part
			all := true
		as sanity-checks
			diags expect-flag part
			sanity-checks := all-sanity-checks
		as times
			times := diags expect-nat part
		as watch
			diags expect-flag part
			watch := true
		else
			diags ~= tag unexpected-part

	if all and !test_
		diags ~= "all" unexpected-part

	main main-kind = if test_
		cwd parse-main-kind-for-test diags, args.nameless, all
	else
		cwd parse-main-uri diags, args.nameless.to main-kind-main-function ()
	res-out single-build-output[] = if out is-empty
		- (main default-executable-path-for-main cwd, os), java
	else
		out
	main: main
	out: res-out
	options: sanity-checks: sanity-checks
	times: times
	watch: watch

-check-options record(times nat, no-color bool, show-all-diags bool)
-parse-check-options check-options(diags diags, args string[][symbol])
	times mut nat = 1
	no-color mut bool = false
	all-errors mut bool = false
	for part in args
		tag, _ = part
		match tag
		as all-errors
			all-errors := true
		as no-color
			no-color := true
		as times
			times := diags expect-nat part
		else
			diags ~= tag unexpected-part
	times, no-color, all-errors

-run-options-and-all record(run-options run-options, all bool)
-parse-run-options run-options-and-all(diags diags, args string[][symbol], allow-all bool)
	node-js mut bool = false
	watch mut bool = false
	all mut bool = false
	for part in args
		tag, _ = part
		match tag
		as all
			if allow-all
				diags expect-flag part
				all := true
			else
				diags ~= tag unexpected-part
		as node-js
			diags expect-flag part
			node-js := true
		as watch
			diags expect-flag part
			watch := true
		else
			diags ~= tag unexpected-part
	run-options:
		node-js: node-js
		watch: watch
	all: all

-expect-nat nat(diags diags, (tag symbol, values string[]))
	value = values opt-only else "multiple values"
	try
		nat parse value
	catch as parse-error
		diags ~= tag expected-nat value
		()

-expect-flag void(diags diags, (tag symbol, args string[]))
	unless args is-empty
		diags ~= tag unexpected-part-args args

-parse-build-out single-build-output[](cwd file-path, os os, diags diags, args string[])
	if args is-empty
		diags ~= "out" expected-paths
	for* arg in args
		cwd parse-single-build-out os, diags, arg from-option
-parse-single-build-out single-build-output?(cwd file-path, os os, diags diags, arg string)
	path = diags parse-file-path-with-cwd-or-diag cwd, arg
	if kind = path.get-extension build-kind-from-extension os
		path, kind
	else
		diags ~= os.default-executable-extension build-out-bad-file-extension
		()

-build-kind-from-extension build-target?(extension symbol, os os)
	match extension
	as ".jar"
		java
	as ".js"
		js
	else
		if extension == os.default-executable-extension
			java

-parse-file-path-with-cwd-or-diag file-path(diags diags, cwd file-path, arg string)
	cwd parse-file-path-with-cwd arg else
		diags ~= arg parse-file-path
		cwd / "bogus"

-default-executable-path-for-main file-path(main main-kind, cwd file-path, os os)
	base = if main.main-uri-for-all-args uri-is-file
		main.main-uri-for-all-args as-file-path
	else
		cwd / "main"
	base default-executable-path os
default-executable-path file-path(base file-path, os os)
	base alter-extension os.default-executable-extension

-main-uri-for-all-args uri(a main-kind)
	match a
	as main-kind-main-function
		a uri
	as main-kind-tests-in-config
		a config-uri
	as main-kind-tests-at-uri
		a crow-uri

-help-all-text string()
	commands string = "" join for name in members::command-name[]
		unless name is-internal-command
			"\n\t{name show-command}"
	"Command must be one of:" ~~
	"\n\tcrow hello.crow (or any '.crow' file)" ~~
	commands ~~
	".\nFor more info, run e.g. 'crow build --help'."

-is-internal-command bool(a command-name)
	a == print
-help-for-command string(name command-name)
	"Command: {name show-command}\n\n{name command-description}"
-show-command string(name command-name)
	options = name describe-command-options
	show-options string = unless options is-empty then " {options}"
	"crow {name}{show-options}"
-describe-command-options string(name command-name)
	match name
	as build
		"PATH [--out PATH] [--optimize]"
	as check
		"PATHS"
	as lsp
		""
	as print
		"[kind] PATH [LINE:COLUMN]"
	as run
		"PATH -- [program-args]"
	as test_
		"PATH [line number] [--all]"
	as version
		""
-command-description string(name command-name)
	match name
	as build
		quote
			Compiles the program at PATH.
			Options are:
				--out: Output path. Defaults to the input path with the extension removed.
					This normally produces an executable JAR.
					If this has a '.js' extension, it will output JS source code instead.
				--test: Ignore the 'main' function and compile a program that runs tests.
					(You probably don't need this and should just use `crow test`.)
				--all: Works with '--test'. Runs all tests in all included files.
	as check
		quote
			Prints any diagnostics for the module(s) at PATH(s) or their imports.
			No options.
	as lsp
		quote
			This runs the Language Server Protocol through stdin/stdout.
			No options.
	as print
		quote
			Prints various information about the program.

			crow print dependencies PATH [--format flat]
				Outputs all dependencies. By default this uses the '.dot' format.
				With '--format flat', this just lists all files that were included.

			The following print internal compiler data:
				crow print ast PATH
				crow print model PATH
				crow print concrete-model PATH

			The following perform a single LSP query and print the result:
				crow print code-lenses PATH
				crow print definition PATH LINE:COLUMN
				crow print document-highlights PATH LINE:COLUMN
				crow print folding-ranges PATH
				crow print hover PATH LINE:COLUMN
				crow print inlay-hints PATH
				crow print references PATH LINE:COLUMN
				crow print rename PATH LINE:COLUMN
				crow print signature-help PATH LINE:COLUMN
				crow print tokens PATH
				crow print type-definition PATH LINE:COL
	as run
		quote
			Runs the program at PATH.
			Command-line arguments to the program should come after a `--`, as in `crow run foo.crow -- arg1 arg2`.
			This can equivalently be written as `crow foo.crow arg1 arg2`.
	as test_
		quote
			Runs tests at PATH.
			If PATH is a 'crow-config' file, searches its directory (recursively) for '.crow' files that would have it as their config.
			If PATH is a file, runs tests in that file.
			You can also specify the line number of a 'test' keyword to run only that test.
			If '--all' is specified, runs all tests in reachable files, including library tests.
	as version
		quote
			Prints information about the version of 'crow'.
			No options.
