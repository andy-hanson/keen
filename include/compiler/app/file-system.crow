# TODO: most of this code should be moved to the std library ------------------------------------------------------------------

exit record(exit-code int32) exception case # TODO: I don't think this is needed any more -----------------------------------
exit exception()
	1 exit
show string(a exit)
	"Should exit with exit code {a exit-code}"

-path-exists bool(path file-path) summon
	trusted
	if extern java
		(path.to,)::File exists
	elif extern js
		fs call-property "existsSync", path.to to
	else
		throw todo

-to String(a file-path) java extern
	a.to to

-to js-any(a file-path) js extern
	a.to::string to

-do-write-file void(path string, content nat8[]) summon
	trusted
	if extern java
		# TODO: catch exceptions -----------------------------------------------------------------------------------------		
		content2 int8 mut-slice = for x in content then x wrap-to # TODO:PERF do a cast instead since these have the same representation
		_ = path.to-java-path write content2, ()
	elif extern js
		fs call-property "writeFileSync", path.to, content.to to
	else
		throw todo

allow-overwrite enum(allow, disallow)
write-file void(path file-path, content string, permissions permissions, overwrite allow-overwrite) summon
	match overwrite
	as allow
		()
	as disallow
		# TODO: this could be integrated with opening the file! See 'openFileForWrite' in 'fileSystem.d' --------------------------------------
		forbid path path-exists else path.to path-already-exists
	path.to do-write-file content.to
	path set-permissions permissions.user-only

-set-permissions void(path file-path, permissions file-permissions) summon
	trusted
	if extern java
		args = permissions java-permissions
		values Enum mut-slice = for x in args then x reinterpret-cast
		perms EnumSet = values.reinterpret-cast::(Object mut-slice).asList.reinterpret-cast::Collection copyOf
		_ = path.to-java-path setPosixFilePermissions perms.reinterpret-cast # TODO: most reinterpret-casts in this file should be unnecssary
	elif extern js
		_ = fs call-property "chmodSync", path.to, permissions.to::nat.to::float.as-js
	else
		throw todo

-java-permissions PosixFilePermission[](a file-permissions) summon, java extern
	trusted
	-- if a.user read
		- OWNER_READ
	-- if a.user write
		- OWNER_WRITE
	-- if a.user execute
		- OWNER_EXECUTE
	-- if a.group read
		- GROUP_READ
	-- if a.group write
		- GROUP_WRITE
	-- if a.group execute
		- GROUP_EXECUTE
	-- if a.public read
		- OTHERS_READ
	-- if a.public write
		- OTHERS_WRITE
	-- if a.public execute
		- OTHERS_EXECUTE

write-jar void(path file-path, files java-compiled-class[]) summon
	trusted
	assert extern java else todo
	start = perf-now
	manifest Manifest = ()
	attr = manifest getMainAttributes
	_ = attr putValue "Manifest-Version", "1.0"
	_ = attr putValue "Main-Class", "Main"
	do
		file-out FileOutputStream = path.to,
		finally file-out close
		buf-out BufferedOutputStream = file-out.reinterpret-cast::OutputStream,
		out-out = buf-out.reinterpret-cast::OutputStream
		out-out write "#!/usr/bin/java -jar\n"::char8[].to
		jar-out JarOutputStream = out-out, manifest
		for file in files
			entry JarEntry = file.path.to,
			jar-out putNextEntry entry.reinterpret-cast::ZipEntry
			jar-out.reinterpret-cast::OutputStream write file.bytes.safe-reinterpret-cast.cast-mutable
			jar-out.reinterpret-cast::ZipOutputStream closeEntry
		jar-out.reinterpret-cast::ZipOutputStream finish
		buf-out flush
	path set-permissions all.user-only
	start end-write-jar

-to int8 mut-slice(a char8[])
	a map it.wrap-to
-wrap-to int8(a char8)
	a.to::nat8 wrap-to

# TODO: have this in std- -------------------------------------------------------------------------------------------------------------
files-in-directory-recursive file-path[](dir-path file-path) summon
	for* path in dir-path get-paths-in-dir
		match path get-path-kind
		as other
			()
		as file
			- path
		as directory
			path files-in-directory-recursive

-get-path-kind path-kind(path file-path) summon
	trusted
	if extern java
		jpath = path to-java-path
		if jpath isRegularFile ()
			file
		elif jpath isDirectory ()
			directory
		else
			other
	elif extern js
		# TODO: handle dir not found exception ------------------------------------------------------------------------------
		stat = fs call-property "lstatSync", path.to
		if stat call-property "isDirectory" to
			directory
		elif stat call-property "isFile" to
			file
		else
			other
	else
		throw todo

get-paths-in-dir file-path[](dir-path file-path) summon
	trusted
	if extern java
		stream = dir-path.to-java-path list
		for path in stream toArray
			path.toString.to must-parse-file-path
	elif extern js
		# TODO: handle dir not found exception ------------------------------------------------------------------------------
		names js-any[] = fs call-property "readdirSync", dir-path.to to
		for name in names
			dir-path / name.to
	else
		throw todo

file-reader record mut
	path-to-crow file-path
	| Only used when '--watch' is passed
	-watch-service WatchService?
	-watched-files file-path mut-set
	-watched-dirs WatchKey mut[file-path]
	-read-file-inner read-file-result mut(path string)
	-read-java-class read-file-result mut(class-path path)
	-files-in-directory-recursive file-path[] mut(root file-path)
with-file-reader record(path-to-crow file-path, watch bool)
file-reader with-file-reader(path-to-crow file-path, watch bool)
	path-to-crow, watch
with-block[t] t(a with-file-reader, f t mut(a file-reader)) summon
	with read-java-class in a.path-to-crow with-java-class-reader
		watch-service WatchService? = if a watch
			trusted
			assert extern java else todo
			getDefault::FileSystem newWatchService
		finally if w ?= watch-service
			trusted
			assert extern java
			w close
		reader file-reader =
			path-to-crow: a path-to-crow
			watch-service: watch-service
			watched-files: ()
			watched-dirs: ()
			read-file-inner: it.read-file-inner
			read-java-class: read-java-class
			files-in-directory-recursive: it.files-in-directory-recursive
		f[reader]

-watch-file void(a file-reader, file file-path) # TODO: better name. This won't watch the file if we don't have watch-service set up. ---------------
	guard service ?= a watch-service
	guard a.watched-files try-add file
	dir = file parent!
	_ = a.watched-dirs ensure dir, of
		trusted
		assert extern java else todo
		dir.to-java-path register service, (ENTRY_CREATE, ENTRY_DELETE, ENTRY_MODIFY), ()

| Returns the path of watched files that changed.
wait-for-change file-path set(a file-reader)
	trusted
	assert extern java else todo
	assert service ?= a watch-service
	loop
		key = service take
		files mut = a take-events key
		if files is-empty
			continue
		else
			while extra ?= a poll-and-take-events
				files |:= extra
			break files

-poll-and-take-events file-path set?(a file-reader) java extern
	trusted
	polled = a.watch-service! poll
	unless polled is-null
		a take-events polled

-take-events file-path set(a file-reader, key WatchKey) java extern
	trusted
	watchable = key watchable
	dir file-path = watchable.reinterpret-cast::Path to # TODO: this is a Java downcast, don't call it 'reinterpret-cast'
	events = key.pollEvents toArray
	assert key reset
	for* o in events
		event WatchEvent = o reinterpret-cast
		# TODO: this is a regular Java cast, so maybe don't call it 'reinterpret-cast'? ------------------
		name string = event.context.reinterpret-cast::Path.toString.to
		file-path = dir / name
		if file-path in a.watched-files
			- file-path

-java-class-reader alias
	read-file-result mut(path path)
-with-java-class-reader record(path-to-crow file-path)
-with-block[t] t(a with-java-class-reader, f t mut(a java-class-reader)) # TODO: use a with-block ------------------------------------------
	trusted
	if extern java
		base-jmod = find-java-base-jmod
		jmods FileSystem mut[file-path] = ()
		finally for _, fs in jmods
			fs close
		f[of path then base-jmod read-java-class path, jmods]
	elif extern js
		tar-path = a.path-to-crow.parent!.parent! / "site" / "java-classes.tar"
		tar = tar-path.to.read-file read-entire-tar
		f[of path then tar["{path}.class"] else not-found]
	else
		throw todo

files-in-directory-recursive file-path[](a file-reader, root file-path)
	a.files-in-directory-recursive[root]

-find-java-base-jmod file-path() summon
	trusted
	if extern java
		Object Class = "java.lang.Object" forName
		module = Object getModule
		assert module isNamed
		finder ModuleFinder = ofSystem
		ref ModuleReference = (finder find module.getName).get reinterpret-cast
		uri URI = ref.location.get reinterpret-cast
		# e.g. "java.base"
		jmod-name = uri.toString.to::string try-remove-start! "jrt:/"
		java-home string = "java.home".getProperty to
		"{java-home}/jmods/{jmod-name}.jmod" must-parse-file-path
	elif extern js
		"/usr/lib/jvm/java-25-openjdk-amd64/jmods/java.base.jmod" must-parse-file-path # TODO -------------------------------------------------------
	else
		throw todo

-read-java-class read-file-result(base-jmod file-path, class_ path, jmods FileSystem mut[file-path]) summon, java extern
	trusted
	# TODO: hax. Use a better method to determine which jmod the class belongs to -------------------------------------------------------------------
	jmod = if class_.to::string starts-with "com/sun/"
		"/usr/lib/jvm/java-25-openjdk-amd64/jmods/jdk.httpserver.jmod" must-parse-file-path
	else
		base-jmod
	file-system = jmods ensure jmod, of
		"jar:file://{jmod}".create newFileSystem emptyMap
	path = file-system getPath "classes/{class_}.class", ()
	path.readAllBytes.cast-immutable.safe-reinterpret-cast::nat8[] to

try-read-file read-file-result(a file-reader, uri uri)
	if path ?= uri as-java-uri
		a try-read-java-class path
	elif uri uri-is-file # TODO: 'is-as' is not as good as 'as' returning an option -----------------------------------------------------------------
		file = uri as-file-path
		a watch-file file
		a.read-file-inner[file to]
	else
		not-found

try-read-java-class read-file-result(a file-reader, path path)
	if path.to::symbol == "CrowClassLoader"
		crow string = a.path-to-crow.parent!.parent! to
		full-path string = "{crow}/include/compiler/backend/java/lib/CrowClassLoader.class"
		a.read-file-inner[full-path]
	else
		start = perf-now
		finally start end-read-file
		a.read-java-class[path]

-read-file-inner read-file-result(path string) summon
	start = perf-now
	finally start end-read-file
	try
		path.read-file to
	catch path-not-found _
		not-found
	catch file-system-error _
		error

cwd file-path() summon
	trusted
	if extern java
		"".to-java-path.toAbsolutePath.toString.to must-parse-file-path
	elif extern js
		(process call-property "cwd" to) must-parse-file-path
	else
		throw todo

-process js-any() js extern
	trusted "process" js-global

-fs js-any() js extern
	trusted "fs" js-import

this-executable file-path() summon
	trusted
	if extern java
		class_ = "Crow".forName
		path = class_.getProtectionDomain.getCodeSource.getLocation.getPath decode "UTF-8"
		path.to must-parse-file-path
	elif extern js
		process["argv"]["1"].to must-parse-file-path
	else
		throw todo

-to-java-path Path(a file-path) java extern
	a.to::string to-java-path
-to-java-path Path(a string) java extern
	trusted a.to get ()
-to file-path(a Path) java extern
	(trusted a toString).to must-parse-file-path
