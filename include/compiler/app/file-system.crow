# TODO: most of this code should be moved to the std library ------------------------------------------------------------------

exit record(exit-code int32) exception case # TODO: I don't think this is needed any more -----------------------------------
exit exception()
	exit 1
show string(a exit)
	"Should exit with exit code {a.exit-code}"

-path-exists bool(path file-path) summon
	trusted
	if java
		exists (path.to,)::File
	elif js
		call-property fs, "existsSync", path.to 'to
	else
		throw todo

-to String(a file-path) java
	a.to.to

-to js-any(a file-path) js
	a.to::string.to

-do-write-file void(path string, content nat8[]) summon
	trusted
	if java
		# TODO: catch exceptions -----------------------------------------------------------------------------------------
		content2 int8 mut-slice = for x in content then x.wrap-to # TODO:PERF do a cast instead since these have the same representation
		_ = write path.to-java-path, content2, ()
	elif js
		call-property fs, "writeFileSync", path.to, content.to 'to
	else
		throw todo

allow-overwrite enum(allow, disallow)
write-file void(path file-path, content string, permissions permissions, overwrite allow-overwrite) summon
	match overwrite
	as allow
		()
	as disallow
		# TODO: this could be integrated with opening the file! See 'openFileForWrite' in 'fileSystem.d' --------------------------------------
		forbid path-exists path else path-already-exists path.to
	do-write-file path.to, content.to
	set-permissions path, permissions.user-only

-set-permissions void(path file-path, permissions file-permissions) summon
	trusted
	if java
		args = java-permissions permissions
		values Enum mut-slice = map args, it.reinterpret-cast
		perms EnumSet = values.reinterpret-cast::(Object mut-slice).asList.reinterpret-cast::Collection.copyOf
		_ = setPosixFilePermissions path.to-java-path, perms.reinterpret-cast # TODO: most reinterpret-casts in this file should be unnecssary
	elif js
		_ = call-property fs, "chmodSync", path.to, permissions.to::nat.to::float.as-js
	else
		throw todo

-java-permissions PosixFilePermission[](a file-permissions) summon, java
	trusted
	-- if a.user.read
		- OWNER_READ
	-- if a.user.write
		- OWNER_WRITE
	-- if a.user.execute
		- OWNER_EXECUTE
	-- if a.group.read
		- GROUP_READ
	-- if a.group.write
		- GROUP_WRITE
	-- if a.group.execute
		- GROUP_EXECUTE
	-- if a.public.read
		- OTHERS_READ
	-- if a.public.write
		- OTHERS_WRITE
	-- if a.public.execute
		- OTHERS_EXECUTE

write-jar void(path file-path, files java-compiled-class[]) summon
	trusted
	assert java else todo
	start = perf-now
	manifest Manifest = ()
	attr = getMainAttributes manifest
	_ = putValue attr, "Manifest-Version", "1.0"
	_ = putValue attr, "Main-Class", "Main"
	do
		file-out FileOutputStream = path.to,
		finally close file-out
		buf-out BufferedOutputStream = file-out.reinterpret-cast::OutputStream,
		out-out = buf-out.reinterpret-cast::OutputStream
		write out-out, "#!/usr/bin/java -jar\n"::char8[].to
		jar-out JarOutputStream = out-out, manifest
		for file in files
			entry JarEntry = file.path.to,
			putNextEntry jar-out, entry.reinterpret-cast::ZipEntry
			write jar-out.reinterpret-cast::OutputStream, file.bytes.safe-reinterpret-cast.cast-mutable
			closeEntry jar-out.reinterpret-cast::ZipOutputStream
		finish jar-out.reinterpret-cast::ZipOutputStream
		flush buf-out
	set-permissions path, all.user-only
	end-write-jar start

-to int8 mut-slice(a char8[])
	map a, it.wrap-to
-wrap-to int8(a char8)
	a.to::nat8.wrap-to

# TODO: have this in std- -------------------------------------------------------------------------------------------------------------
files-in-directory-recursive file-path[](dir-path file-path) summon
	for* path in get-paths-in-dir dir-path
		match get-path-kind path
		as other
			()
		as file
			- path
		as directory
			files-in-directory-recursive path

-get-path-kind path-kind(path file-path) summon
	trusted
	if java
		jpath = to-java-path path
		if isRegularFile jpath, ()
			file
		elif isDirectory jpath, ()
			directory
		else
			other
	elif js
		# TODO: handle dir not found exception ------------------------------------------------------------------------------
		stat = call-property fs, "lstatSync", path.to
		if call-property stat, "isDirectory" 'to
			directory
		elif call-property stat, "isFile" 'to
			file
		else
			other
	else
		throw todo

get-paths-in-dir file-path[](dir-path file-path) summon
	trusted
	if java
		stream = list to-java-path dir-path
		for path in toArray stream
			must-parse-file-path path.toString.to
	elif js
		# TODO: handle dir not found exception ------------------------------------------------------------------------------
		names js-any[] = call-property fs, "readdirSync", dir-path.to 'to
		for name in names
			dir-path / name.to
	else
		throw todo

file-reader record mut
	path-to-crow file-path
	| Only used when '--watch' is passed
	-watch-service WatchService?
	-watched-files file-path mut-set
	-watched-dirs WatchKey mut[file-path]
	-read-file-inner read-file-result mut(path string)
	-read-java-class read-file-result mut(class-path path)
	-files-in-directory-recursive file-path[] mut(root file-path)
with-file-reader record(path-to-crow file-path, watch bool)
file-reader with-file-reader(path-to-crow file-path, watch bool)
	path-to-crow, watch
with-block[t] t(a with-file-reader, f t mut(a file-reader)) summon
	with read-java-class in with-java-class-reader path-to-crow a
		watch-service WatchService? = if watch a
			trusted
			assert java else todo
			newWatchService getDefault::FileSystem
		finally if watch-service
			trusted
			assert java
			close watch-service
		reader file-reader =
			path-to-crow: path-to-crow a
			watch-service: watch-service
			watched-files: ()
			watched-dirs: ()
			read-file-inner: it.read-file-inner
			read-java-class: read-java-class
			files-in-directory-recursive: it.files-in-directory-recursive
		f[reader]

-watch-file void(a file-reader, file file-path)
	guard service = watch-service a
	guard try-add a.watched-files, file
	dir = parent! file
	_ = ensure a.watched-dirs, dir, of
		trusted
		assert java else todo
		register dir.to-java-path, service, (ENTRY_CREATE, ENTRY_DELETE, ENTRY_MODIFY), ()

| Returns the path of watched files that changed.
wait-for-change file-path set(a file-reader)
	trusted
	assert java else todo
	assert service = a.watch-service
	loop
		key = take service
		files mut = take-events a, key
		if is-empty files
			continue
		else
			while extra = poll-and-take-events a
				files |:= extra
			break files

-poll-and-take-events file-path set?(a file-reader) java
	trusted
	polled = poll a.watch-service!
	unless is-null polled
		take-events a, polled

-take-events file-path set(a file-reader, key WatchKey) java
	trusted
	watchable = key.watchable
	dir file-path = watchable.reinterpret-cast::Path.to # TODO: this is a Java downcast, don't call it 'reinterpret-cast'
	events = key.pollEvents.toArray
	assert reset key
	for* o in events
		event WatchEvent = reinterpret-cast o
		# TODO: this is a regular Java cast, so maybe don't call it 'reinterpret-cast'? ------------------
		name string = event.context.reinterpret-cast::Path.toString.to
		file-path = dir / name
		if a.watched-files[file-path]
			- file-path

-java-class-reader alias
	read-file-result mut(path path)
-with-java-class-reader record(path-to-crow file-path)
-with-block[t] t(a with-java-class-reader, f t mut(a java-class-reader)) # TODO: use a with-block ------------------------------------------
	trusted
	if java
		base-jmod = find-java-base-jmod
		jmods FileSystem mut[file-path] = ()
		finally for _, fs in jmods
			# TODO: we should not do this if we got it through 'getFileSystem' instead of 'newFileSystem'
			close fs
		f[of path then read-java-class base-jmod, path, jmods]
	elif js
		tar-path = a.path-to-crow.parent!.parent! / "site" / "java-classes.tar"
		tar = read-entire-tar read-file tar-path.to
		f[of path then tar["{path}.class"] else not-found]
	else
		throw todo

files-in-directory-recursive file-path[](a file-reader, root file-path)
	a.files-in-directory-recursive[root]

-find-java-base-jmod file-path() summon
	trusted
	if java
		path-to-jmod "java.base"
	elif js
		must-parse-file-path "/usr/lib/jvm/java-25-openjdk-amd64/jmods/java.base.jmod" # TODO: JS code to find this
	else
		throw todo

-path-to-jmod file-path(jmod-name string) unsafe, summon, java
	java-home string = "java.home".getProperty.to
	must-parse-file-path "{java-home}/jmods/{jmod-name}.jmod"

-read-java-class read-file-result(base-jmod file-path, class_ path, jmods FileSystem mut[file-path]) summon, java
	trusted
	# TODO: hax. Use a better method to determine which jmod the class belongs to -------------------------------------------------------------------
	jmod = if starts-with class_.to::string, "com/sun/"
		path-to-jmod "jdk.httpserver"
	else
		base-jmod
	file-system = ensure jmods, jmod, of
		# Even though we cache the jmods, if we are running a client program with 'crow run', it might want to create a file system for the jar too
		get-or-create-file-system "jar:file://{jmod}".create
	path = getPath file-system, "classes/{class_}.class", ()
	path.readAllBytes.cast-immutable.safe-reinterpret-cast::nat8[].to

-get-or-create-file-system FileSystem(uri URI) java, summon
	trusted
	try
		newFileSystem uri, emptyMap
	catch as FileSystemAlreadyExistsException
		getFileSystem uri

try-read-file read-file-result(a file-reader, uri uri)
	if path = as-java-uri uri
		try-read-java-class a, path
	elif uri-is-file uri # TODO: 'is-as' is not as good as 'as' returning an option -----------------------------------------------------------------
		file = as-file-path uri
		watch-file a, file
		a.read-file-inner[file.to]
	else
		not-found

try-read-java-class read-file-result(a file-reader, path path)
	if path.to::symbol == "CrowClassLoader"
		crow string = a.path-to-crow.parent!.parent!.to
		full-path string = "{crow}/include/compiler/backend/java/lib/CrowClassLoader.class"
		a.read-file-inner[full-path]
	else
		start = perf-now
		finally end-read-file start
		a.read-java-class[path]

-read-file-inner read-file-result(path string) summon
	start = perf-now
	finally end-read-file start
	try
		read-file path 'to
	catch as path-not-found
		not-found
	catch as file-system-error
		error

cwd file-path() summon
	trusted
	must-parse-file-path if java
		"".to-java-path.toAbsolutePath.toString.to
	elif js
		call-property process, "cwd" 'to
	else
		throw todo

-process js-any() js
	trusted js-global "process"

-fs js-any() js
	trusted js-import "fs"

this-executable file-path() summon
	trusted
	if java
		class_ = "Crow".forName
		path = class_.getProtectionDomain.getCodeSource.getLocation.getPath
		must-parse-file-path (decode path, "UTF-8").to
	elif js
		must-parse-file-path process["argv"]["1"].to
	else
		throw todo

-to-java-path Path(a file-path) java
	to-java-path a.to::string
-to-java-path Path(a string) java
	trusted get a.to, ()
-to file-path(a Path) java
	must-parse-file-path (trusted a.toString).to
