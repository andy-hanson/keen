import
	crow/io/file
	crow/io/process
	crow/java
	crow/js
	crow/result
	../backend/write-to-c
	../frontend/storage_
	../model/low-model
	../model/model
	../model/parse-diag
	../model/uri

# TODO: most of this code should be moved to the std library ------------------------------------------------------------------

exit record(exit-code int32) exception case
exit exception()
	1 exit
show string(a exit)
	"Should exit with exit code {a exit-code}"
exit-signal record(signal int32) exception case
show string(a exit-signal)
	"Should exit with signal {a signal}"

path-exists bool(path file-path) summon, trusted
	if extern native
		path.to path-exists
	elif extern java
		file java-any = "java.io.File" call-new path.to::string
		file call-instance "exists"
	elif extern js
		fs call-property "existsSync", path.to::string cast
	else
		throw todo

ensure-directory void(path file-path) summon, trusted
	if extern native
		path.to ensure-directory
	elif extern java
		attrs = "java.nio.file.attribute.FileAttribute" empty-array-of
		"java.nio.file.Files" call-static "createDirectories", path.to-java-path, attrs
	else
		throw todo

-empty-array-of java-any[](class-name string) unsafe, java extern
	class_ java-any = "java.lang.Class" call-static "forName", class-name
	"java.lang.reflect.Array" call-static "newInstance", class_, 0::int32

-do-write-file void(path string, content nat8[]) summon, trusted
	if extern native
		path write-file content
	elif extern java
		# TODO: catch exceptions -----------------------------------------------------------------------------------------		
		_ void = "java.nio.file.Files" call-static "write", path.to-java-path, content, "java.nio.file.OpenOption".empty-array-of
	elif extern js
		fs call-property "writeFileSync", path, content cast
	else
		throw todo

allow-overwrite enum(allow, disallow)
write-file void(path file-path, content string, permissions permissions, overwrite allow-overwrite) summon
	match overwrite
	as allow
		()
	as disallow
		# TODO: this could be integrated with opening the file! See 'openFileForWrite' in 'fileSystem.d' --------------------------------------
		forbid path path-exists : path.to path-already-exists
	path.to do-write-file content.to-bytes
	path set-permissions permissions.user-only

set-permissions void(path file-path, permissions file-permissions) summon, trusted
	if extern native
		path.to set-permissions permissions
	elif extern java
		args java-any[] = for name : permissions java-permission-names
			"java.nio.file.attribute.PosixFilePermission" get-static-field name
		perms java-any = "java.util.EnumSet" call-static-varargs "of", args
		_ void = "java.nio.file.Files" call-static "setPosixFilePermissions", path.to-java-path, perms
	elif extern js
		_ = fs call-property "chmodSync", path.to::string, permissions.to::nat32.to::nat64.to::float
	else
		throw todo

-java-permission-names string[](a file-permissions)
	with out : build
		for x : a.user java-permission-names
			out ~= "OWNER_{x}"
		for x : a.group java-permission-names
			out ~= "GROUP_{x}"
		for x : a.public java-permission-names
			out ~= "OTHERS_{x}"
-java-permission-names string[](a permissions)
	with out : build
		if a read
			out ~= "READ"
		if a write
			out ~= "WRITE"
		if a execute
			out ~= "EXECUTE"

remove-file-if-exists void(a file-path) summon
	try
		a remove-file
	catch path-not-found _
		()
remove-file void(a file-path) summon, trusted
	if extern native
		a.to remove-file
	elif extern js
		_ = fs call-property "unlinkSync", a.to::string
	else
		throw todo

write-files-to-dir void(dir file-path, files (string, nat8[])[]) summon
	dir ensure-directory
	for name, text : files
		"{dir}/{name}" do-write-file text

run-compiler void(path-and-args path-and-args) summon
	assert trusted extern (native, libc, posix) : todo
	# Extern library linker arguments are already in args
	match path-and-args.path.to spawn-and-wait path-and-args.args
	as exited x
		assert x.exit-code == 0 : x.exit-code exit
	as signaled x
		throw x.signal exit-signal

run-program void(_ extern-libraries, _ path-and-args) summon
	# TODO: needs to set up environment for child processes ... see the D version
	throw todo

run-node-js-program void(_ path-and-args) summon
	# See the D version
	throw todo

# TODO: have this in std- -------------------------------------------------------------------------------------------------------------
each-file-in-directory-recursive void(
	dir-path file-path,
	f void mut(x file-path),
) summon
	for path : dir-path get-paths-in-dir
		match path get-path-kind
		as other
			()
		as file
			f[path]
		as directory
			path each-file-in-directory-recursive f

get-path-kind path-kind(path file-path) summon, trusted
	if extern native
		path.to get-path-kind
	elif extern java
		jpath = path to-java-path
		link-options = "java.nio.file.LinkOption" empty-array-of
		if "java.nio.file.Files" call-static "isRegularFile", jpath, link-options
			file
		elif "java.nio.file.Files" call-static "isDirectory", jpath, link-options
			directory
		else
			other
	elif extern js
		# TODO: handle dir not found exception ------------------------------------------------------------------------------
		stat = fs call-property "lstatSync", path.to::string
		if stat call-property "isDirectory" js-cast
			directory
		elif stat call-property "isFile" js-cast
			file
		else
			other
	else
		throw todo

get-paths-in-dir file-path[](dir-path file-path) summon, trusted
	if extern native
		for x : dir-path.to paths-in-dir
			x must-parse-file-path
	elif extern java
		stream java-any = "java.nio.file.Files" call-static "list", dir-path.to-java-path
		paths java-any[] = stream call-instance "toArray"
		for path : paths
			str string = path call-instance "toString"
			str must-parse-file-path
	elif extern js
		# TODO: handle dir not found exception ------------------------------------------------------------------------------
		names string[] = fs call-property "readdirSync", dir-path.to::string js-cast
		for name : names
			dir-path / name
	else
		throw todo

try-read-file read-file-result(uri uri) summon
	guard uri uri-is-file : not-found::read-file-diag.to
	try
		bytes nat8[] = uri.as-file-path.to do-read-file
		content file-content = bytes,
		content to
	catch path-not-found _
		not-found::read-file-diag to
	catch not-a-text-file _
		error::read-file-diag to
	catch file-system-error _
		error::read-file-diag to

cwd file-path() summon, trusted
	if extern native
		current-directory must-parse-file-path
	elif extern java
		path java-any = "".to-java-path call-instance "toAbsolutePath"
		path call-instance "toString" must-parse-file-path
	elif extern js
		res string = process call-property "cwd" cast
		res must-parse-file-path
	else
		throw todo

-process js-any() js extern
	trusted "process" js-global

-fs js-any() trusted, js extern
	"fs" require

-require js-any(name string) builtin, bare, unsafe, js extern # TODO: NEATER --------------------------------------------------------

this-executable file-path() summon, trusted
	if extern native
		assert extern posix : todo
		current-executable-path must-parse-file-path
	elif extern java
		"/home/andy/crow/bin/crow" must-parse-file-path # ---------------------------------------------------------------------------------------------
	elif extern js
		"/home/andy/crow/bin/crow" must-parse-file-path # ---------------------------------------------------------------------------------------------
		#res string = fs call-property "readlinkSync", "/proc/self/exe"::string cast
		#res must-parse-file-path
	else
		throw todo

do-read-file nat8[](path string) summon, trusted
	if extern native
		path read-file
	elif extern java
		# TODO: would be better to catch a file-not-found exception
		assert path.must-parse-file-path path-exists : path path-not-found
		"java.nio.file.Files" call-static "readAllBytes", path.to-java-path
	elif extern js
		match (() => fs call-property "readFileSync", path) catch-all
		as ok x
			bytes float64[] = "Array".js-global call-property "from", x.value cast
			for byte : bytes; byte to
		as fail x
			exception = x.value exception
			code string = exception.threw-non-exception!.thrown["code"] cast
			throw if code == "ENOENT"
				path path-not-found
			else
				exception
	else
		throw todo

-to-java-path java-any(a file-path) java extern
	a.to::string to-java-path
-to-java-path java-any(a string) trusted, java extern
	"java.nio.file.Paths" call-static "get", a, ()::string[]

cleanup-compile void(cwd file-path, c-path file-path, exe-path file-path) summon
	guard trusted extern windows
	exe-path alter-extension ".ilk" remove-file-if-exists
	exe-path alter-extension ".pdb" remove-file-if-exists
	obj-base-name = c-path alter-extension ".obj" base-name
	cwd / obj-base-name remove-file-if-exists

find-path-to-c-compiler file-path?()
	forbid trusted extern windows : todo # See D version
	"/usr/bin/cc".must-parse-file-path,
