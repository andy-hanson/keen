import
	crow/col/mut-slice
	crow/io/file
	crow/java
	crow/js
	crow/result
	java/nio/file/Files
	java/nio/file/Path
	java/nio/file/Paths
	java/lang/Object
	java/util/stream/Stream
	../frontend/storage_
	../model/model
	../model/parse-diag
	../model/uri
	../util/perfhax

# TODO: most of this code should be moved to the std library ------------------------------------------------------------------

exit record(exit-code int32) exception case # TODO: I don't think this is needed any more -----------------------------------
exit exception()
	1 exit
show string(a exit)
	"Should exit with exit code {a exit-code}"

path-exists bool(path file-path) summon, trusted
	if extern java
		file java-any = "java.io.File" call-new path.to::string.to-java-string
		file call-instance "exists"
	elif extern js
		fs call-property "existsSync", path.to::string cast
	else
		throw todo

ensure-directory void(path file-path) summon, trusted
	assert extern java : todo
	attrs = "java.nio.file.attribute.FileAttribute" empty-array-of
	"java.nio.file.Files" call-static "createDirectories", path.to-java-path, attrs

-empty-array-of java-any[](class-name string) unsafe, java extern
	class_ java-any = "java.lang.Class" call-static "forName", class-name.to-java-string
	"java.lang.reflect.Array" call-static "newInstance", class_, 0::int32

-do-write-file void(path string, content nat8[]) summon, trusted
	if extern java
		# TODO: catch exceptions -----------------------------------------------------------------------------------------		
		content2 int8 mut-slice = for x : content; x wrap-to # TODO:PERF do a cast instead since these have the same representation
		_ = path.to-java-path write content2, ()
	elif extern js
		fs call-property "writeFileSync", path, content cast
	else
		throw todo

allow-overwrite enum(allow, disallow)
write-file void(path file-path, content string, permissions permissions, overwrite allow-overwrite) summon
	match overwrite
	as allow
		()
	as disallow
		# TODO: this could be integrated with opening the file! See 'openFileForWrite' in 'fileSystem.d' --------------------------------------
		forbid path path-exists : path.to path-already-exists
	path.to do-write-file content.to-bytes
	path set-permissions permissions.user-only

set-permissions void(path file-path, permissions file-permissions) summon, trusted
	if extern java
		args java-any[] = for name : permissions java-permission-names
			"java.nio.file.attribute.PosixFilePermission" get-static-field name
		perms java-any = "java.util.EnumSet" call-static-varargs "of", args
		"java.nio.file.Files" call-static "setPosixFilePermissions", path.to-java-path, perms
	elif extern js
		_ = fs call-property "chmodSync", path.to::string, permissions.to::nat.to::float
	else
		throw todo

-java-permission-names string[](a file-permissions)
	with out : build
		for x : a.user java-permission-names
			out ~= "OWNER_{x}"
		for x : a.group java-permission-names
			out ~= "GROUP_{x}"
		for x : a.public java-permission-names
			out ~= "OTHERS_{x}"
-java-permission-names string[](a permissions)
	with out : build
		if a read
			out ~= "READ"
		if a write
			out ~= "WRITE"
		if a execute
			out ~= "EXECUTE"

write-jar void(path file-path, files (string, nat8[])[]) summon, trusted
	assert extern java : todo
	start = perf-now
	manifest java-any = "java.util.jar.Manifest" call-new
	attr java-any = manifest call-instance "getMainAttributes"
	_ java-any = attr call-instance "putValue", "Manifest-Version"::string.to-java-string, "1.0"::string.to-java-string
	_ java-any = attr call-instance "putValue", "Main-Class"::string.to-java-string, "Main"::string.to-java-string
	do
		file-out java-any = "java.io.FileOutputStream" call-new path.to::string.to-java-string
		finally file-out call-instance "close"
		buf-out java-any = "java.io.BufferedOutputStream" call-new file-out
		jar-out java-any = "java.util.jar.JarOutputStream" call-new buf-out, manifest
		for name, content : files
			entry java-any = "java.util.jar.JarEntry" call-new name.to-java-string
			jar-out call-instance "putNextEntry", entry
			jar-out call-instance "write", content
			jar-out call-instance "closeEntry"
		jar-out call-instance "finish"
		buf-out call-instance "flush"
	path set-permissions all.user-only
	start end-write-jar

# TODO: have this in std- -------------------------------------------------------------------------------------------------------------
each-file-in-directory-recursive void
	dir-path file-path
	f void mut(x file-path)
do summon
	for path : dir-path get-paths-in-dir
		match path get-path-kind
		as other
			()
		as file
			f[path]
		as directory
			path each-file-in-directory-recursive f

get-path-kind path-kind(path file-path) summon, trusted
	if extern java
		jpath = path to-java-path
		if jpath isRegularFile ()
			file
		elif jpath isDirectory ()
			directory
		else
			other
	elif extern js
		# TODO: handle dir not found exception ------------------------------------------------------------------------------
		stat = fs call-property "lstatSync", path.to::string
		if stat call-property "isDirectory" js-cast
			directory
		elif stat call-property "isFile" js-cast
			file
		else
			other
	else
		throw todo

get-paths-in-dir file-path[](dir-path file-path) summon, trusted
	if extern java
		stream = dir-path.to-java-path list
		paths = stream toArray
		for path : paths
			str = path.toString.as-java string-of-java-string
			str must-parse-file-path
	elif extern js
		# TODO: handle dir not found exception ------------------------------------------------------------------------------
		names string[] = fs call-property "readdirSync", dir-path.to::string js-cast
		for name : names
			dir-path / name
	else
		throw todo

try-read-file read-file-result(uri uri) summon
	guard uri uri-is-file : not-found
	try
		uri.as-file-path.to.do-read-file,
	catch path-not-found _
		not-found
	catch not-a-text-file _ # TODO: this wouldn't be thrown if we're reading a nat8[] ! --------------------------------------------------
		error
	catch file-system-error _
		error

cwd file-path() summon, trusted
	if extern java
		path java-any = "".to-java-path call-instance "toAbsolutePath"
		(path call-instance "toString" string-of-java-string) must-parse-file-path
	elif extern js
		res string = process call-property "cwd" cast
		res must-parse-file-path
	else
		throw todo

-process js-any() js extern
	trusted "process" js-global

-fs js-any() trusted, js extern
	"fs" require

-require js-any(name string) builtin, unsafe, js extern # TODO: NEATER --------------------------------------------------------

this-executable file-path() summon, trusted
	if extern java
		"/home/andy/crow/bin/crow" must-parse-file-path # ---------------------------------------------------------------------------------------------
	elif extern js
		"/home/andy/crow/bin/crow" must-parse-file-path # ---------------------------------------------------------------------------------------------
		#res string = fs call-property "readlinkSync", "/proc/self/exe"::string cast
		#res must-parse-file-path
	else
		throw todo

do-read-file nat8[](path string) summon, trusted
	if extern java
		# TODO: would be better to catch a file-not-found exception
		assert path.must-parse-file-path path-exists : path path-not-found
		res = path.to-java-path readAllBytes
		for x : res; x wrap-to # TODO:PERF this converts an int8 mut-slice to a nat8[], but that could actually just be a cast?
	elif extern js
		match (() => fs call-property "readFileSync", path) catch-all
		as ok x
			bytes float64[] = "Array".js-global call-property "from", x.value cast
			for byte : bytes; byte to
		as fail x
			exception = x value
			code string = exception.threw-non-exception!.thrown["code"] cast
			throw if code == "ENOENT"
				path path-not-found
			else
				exception
	else
		throw todo

-to-java-path Path(a file-path) java extern
	a.to::string to-java-path
-to-java-path Path(a string) trusted, java extern
	a.to-java-string get ()
