# TODO: most of this code should be moved to the std library ------------------------------------------------------------------

exit record(exit-code int32) exception case # TODO: I don't think this is needed any more -----------------------------------
exit exception()
	1 exit
show string(a exit)
	"Should exit with exit code {a exit-code}"

-path-exists bool(path file-path) summon, trusted
	if extern java
		(path.to::string.to-java-string,)::File exists
	elif extern js
		fs call-property "existsSync", path.to::string cast
	else
		throw todo

-do-write-file void(path string, content nat8[]) summon, trusted
	if extern java
		# TODO: catch exceptions -----------------------------------------------------------------------------------------		
		content2 int8 mut-slice = for x : content; x wrap-to # TODO:PERF do a cast instead since these have the same representation
		_ = path.to-java-path write content2, ()
	elif extern js
		fs call-property "writeFileSync", path, content cast
	else
		throw todo

allow-overwrite enum(allow, disallow)
write-file void(path file-path, content string, permissions permissions, overwrite allow-overwrite) summon
	match overwrite
	as allow
		()
	as disallow
		# TODO: this could be integrated with opening the file! See 'openFileForWrite' in 'fileSystem.d' --------------------------------------
		forbid path path-exists : path.to path-already-exists
	path.to do-write-file content.to-bytes
	path set-permissions permissions.user-only

-set-permissions void(path file-path, permissions file-permissions) summon, trusted
	if extern java
		args = permissions java-permissions
		perms EnumSet = args[0].reinterpret-cast of (for x : args[1 .. end]; x reinterpret-cast)::(Enum mut-slice)
		_ = path.to-java-path setPosixFilePermissions perms.reinterpret-cast # TODO: most reinterpret-casts in this file should be unnecssary
	elif extern js
		_ = fs call-property "chmodSync", path.to::string, permissions.to::nat.to::float
	else
		throw todo

-java-permissions PosixFilePermission[](a file-permissions) summon, trusted, java extern
	with out : build
		if a.user read
			out ~= OWNER_READ
		if a.user write
			out ~= OWNER_WRITE
		if a.user execute
			out ~= OWNER_EXECUTE
		if a.group read
			out ~= GROUP_READ
		if a.group write
			out ~= GROUP_WRITE
		if a.group execute
			out ~= GROUP_EXECUTE
		if a.public read
			out ~= OTHERS_READ
		if a.public write
			out ~= OTHERS_WRITE
		if a.public execute
			out ~= OTHERS_EXECUTE

write-jar void(path file-path, files (string, nat8[])[]) summon, trusted
	assert extern java : todo
	start = perf-now
	manifest Manifest = ()
	attr = manifest getMainAttributes
	_ = attr putValue "Manifest-Version"::string.to-java-string, "1.0"::string.to-java-string
	_ = attr putValue "Main-Class"::string.to-java-string, "Main"::string.to-java-string
	do
		file-out FileOutputStream = path.to::string.to-java-string,
		finally file-out close
		buf-out BufferedOutputStream = file-out.reinterpret-cast::OutputStream,
		jar-out JarOutputStream = buf-out.reinterpret-cast::OutputStream, manifest
		for name, content : files
			entry JarEntry = name.to-java-string,
			jar-out putNextEntry entry.reinterpret-cast::ZipEntry # TODO: this casts JarEntry to ZipEntry. Crow should realize that as an implicit conversion?
			content2 int8 mut-slice = for x : content; x wrap-to # TODO:PERF do a cast instead since these have the same representation
			jar-out.reinterpret-cast::OutputStream write content2
			jar-out.reinterpret-cast::ZipOutputStream closeEntry
		jar-out.reinterpret-cast::ZipOutputStream finish
		buf-out flush
	path set-permissions all.user-only
	start end-write-jar

# TODO: have this in std- -------------------------------------------------------------------------------------------------------------
each-file-in-directory-recursive void
	dir-path file-path
	f void mut(x file-path)
do summon
	for path : dir-path get-paths-in-dir
		match path get-path-kind
		as other
			()
		as file
			f[path]
		as directory
			path each-file-in-directory-recursive f

-get-path-kind path-kind(path file-path) summon, trusted
	if extern java
		jpath = path to-java-path
		if jpath isRegularFile ()
			file
		elif jpath isDirectory ()
			directory
		else
			other
	elif extern js
		# TODO: handle dir not found exception ------------------------------------------------------------------------------
		stat = fs call-property "lstatSync", path.to::string
		if stat call-property "isDirectory" js-cast
			directory
		elif stat call-property "isFile" js-cast
			file
		else
			other
	else
		throw todo

get-paths-in-dir file-path[](dir-path file-path) summon, trusted
	if extern java
		stream = dir-path.to-java-path list
		paths = stream toArray
		for path : paths
			path.toString.string-of-java-string must-parse-file-path
	elif extern js
		# TODO: handle dir not found exception ------------------------------------------------------------------------------
		names string[] = fs call-property "readdirSync", dir-path.to::string js-cast
		for name : names
			dir-path / name
	else
		throw todo

try-read-file read-file-result(uri uri) summon
	guard uri uri-is-file : not-found
	try
		uri.as-file-path.to.do-read-file,
	catch path-not-found _
		not-found
	catch not-a-text-file _ # TODO: this wouldn't be thrown if we're reading a nat8[] ! --------------------------------------------------
		error
	catch file-system-error _
		error

cwd file-path() summon, trusted
	if extern java
		"".to-java-path.toAbsolutePath.toString.string-of-java-string must-parse-file-path
	elif extern js
		res string = process call-property "cwd" cast
		res must-parse-file-path
	else
		throw todo

-process js-any() js extern
	trusted "process" js-global

-fs js-any() trusted, js extern
	"fs" require

-require js-any(name string) builtin, unsafe, js extern # TODO: NEATER --------------------------------------------------------

this-executable file-path() summon, trusted
	if extern java
		"/home/andy/crow/bin/crow" must-parse-file-path # ---------------------------------------------------------------------------------------------
	elif extern js
		"/home/andy/crow/bin/crow" must-parse-file-path # ---------------------------------------------------------------------------------------------
		#res string = fs call-property "readlinkSync", "/proc/self/exe"::string cast
		#res must-parse-file-path
	else
		throw todo

do-read-file nat8[](path string) summon, trusted
	if extern java
		# TODO: would be better to catch a file-not-found exception
		assert path.must-parse-file-path path-exists : path path-not-found
		res = path.to-java-path readAllBytes
		for x : res; x wrap-to # TODO:PERF this converts an int8 mut-slice to a nat8[], but that could actually just be a cast?
	elif extern js
		try
			x = fs call-property "readFileSync", path
			bytes float64[] = "Array".js-global call-property "from", x cast
			for byte : bytes; byte to
		catch else exception
			code string = exception.as-js["code"] cast # TODO: first check if the property exists??????????????????????????????
			throw if code == "ENOENT"
				path path-not-found
			else
				exception
	else
		throw todo

-to-java-path Path(a file-path) java extern
	a.to::string to-java-path
-to-java-path Path(a string) trusted, java extern
	a.to-java-string get ()
