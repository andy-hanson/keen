import
	CrowClassLoader.class
	crow/col/mut-queue
	crow/col/mut-slice
	crow/io/file
	crow/io/print
	crow/io/process
	crow/io/stdin
	crow/parse
	crow/unsafe
	java/lang/Class
	java/lang/ClassLoader
	java/lang/String
	java/lang/reflect/InvocationTargetException
	java/lang/reflect/Method
	java/lang/StackTraceElement
	java/lang/Throwable
	../../crow/col/mut-slice: cast-mutable
	../backend/js/source-map
	../frontend/get-diagnostic-severity
	../frontend/lang
	../frontend/show-diag
	../frontend/show-model
	../frontend/storage_
	../lib/lsp/lsp-parse
	../lib/lsp/lsp-types
	../lib/server
	../model/model
	../model/parse-diag
	../model/source-range
	../model/uri
	../util/exit-code
	../util/perfhax
	./command
	./file-system
	./parse-command

main nat(args string[]) summon
	start = perf-now
	cwd = cwd
	this-executable = this-executable # TODO: just move to where its' used? -----------------------------------------------------
	command = cwd parse-command args
	server-settings server-settings =
		include-dir: this-executable.get-crow-include-dir to
		cwd: cwd to
		show-options:
			color: !(_ ?= command.kind lsp-command)
	server server = server-settings,
	try
		server go this-executable, command.kind
		if command.options perf
			info log "Performance: {start perf-report}"
		0
	catch exit x
		x.exit-code to

-run-lsp void(server server, this-executable file-path) summon
	error log this-executable.crow-version.show
	error log "Running language server protocol"
	e exit-code = loop
		log-lsp = true # TODO: get this from specified trace level ---------------------------------------------------------------
		if exit ?= server handle-one-message-in log-lsp
			break exit
		else
			continue
	throw e.value.to exit

-handle-one-message-in exit-code?(server server, log-lsp bool) summon
	buffered-messages lsp-in-message mut-queue = ()
	buffered-messages ~= log-lsp lsp-read
	loop
		message = buffered-messages dequeue!
		action = server handle-lsp-message message
		for out-message in action out-messages
			if server.lsp-state !supports-unknown-uris and out-message is-unknown-uris
				error log "Server will load unknown URIs itself (since client does not support them)"
				for uri in out-message.lsp-out-notification!.unknown-uris! unknownUris
					buffered-messages ~= uri read-file-locally
			else
				out-message.to lsp-write log-lsp
		if exit ?= action.exit-code
			break exit
		elif buffered-messages is-empty
			break ()
		else
			continue

# TODO: it would be better to return an option ...............................................................................
-is-unknown-uris bool(a lsp-out-message)
	_ ?= a.lsp-out-notification?.unknown-uris

-lsp-read lsp-in-message(log-lsp bool) summon
	line0 = read-stdin
	stripped = line0 try-remove-start! "Content-Length: "
	content-length = nat parse stripped
	line1 = read-stdin strip
	line1 is ""
	content = content-length.read-n-bytes-from-stdin as-string
	if log-lsp
		error log "LSP message in: {content}"
	json parse content to

-lsp-write void(content-json json, log-lsp bool) summon
	content-string string = "{content-json}"
	if log-lsp
		err print "LSP out: {content-string}"
	out print-no-newline "Content-Length: {content-string.size}\r\n\r\n{content-string}"

-load-all-files-for-main void(server server, main main-kind) summon
	match main
	as main-kind-main-function x
		server load-all-files (x.uri,)
	as main-kind-tests-in-config x
		server load-all-files-for-config x.config-uri
	as main-kind-tests-at-uri x
		server load-all-files (x.crow-uri,)

-load-all-files-for-config void(server server, config-uri uri) summon
	if config-uri !uri-is-file
		err print "Can't list test files at non-file URI {config-uri}"
		throw exit
	config-uri.as-file-path.parent! each-file-in-directory-recursive of file
		if file.get-extension == ".crow"
			server load-single-file file.to
	server load-until-no-unknown-uris

-load-all-files void(server server, root-uris uri[]) summon
	start = perf-now
	for uri in root-uris
		if uri is-crow-config
			server load-all-files-for-config uri
		else
			server load-single-file uri
	server load-until-no-unknown-uris
	start end-load-all-files

-read-file-locally read-file-result-params(uri uri) summon
	match uri try-read-file
	as file-content x
		uri, ok, x.bytes
	as read-file-diag x
		type read-file-result-type = match x
		as unknown
			throw unreachable
		as loading
			throw unreachable
		as not-found
			notFound
		as error
			error
		uri, type, ()

-load-until-no-unknown-uris void(server server) summon
	until server.files-state == all-loaded
		for uri in server all-unknown-uris
			server load-single-file uri

-load-single-file void(server server, uri uri) summon
	server set-file uri, uri.try-read-file

-go void
	server server
	this-executable file-path
	command command-kind
do summon
	match command
	as build-command x
		program = server check-main-and-print-diags x.main, for t in x out then t kind
		server build-all-outputs x.out, x.times, program
	as check-command x
		for _ in 0::nat .. x.times
			options show-diags-options =
				only-for-uris: ()
				show-options: x.show-color,
				show-all-diagnostics: x show-all-diagnostics
			program = server check-and-print-diags x.root-uris, options
			forbid program has-any-diagnostics else exit
			out print "OK"
			server reset
	as document-command x
		program = server check-and-print-diags x.root-uris
		out print "{server document program, x.root-uris}"
	as help-command x
		out print x.help-text
		throw x.exit-code.value.to exit
	as lsp-command
		server run-lsp this-executable
	as print-command x
		server do-print x
	as run-command x
		assert (trusted extern java) else "Can only run code from a Java build" error
		trusted server run x
	as version-command
		out print "{this-executable crow-version}"

-run void(server server, run run-command) summon, unsafe, java extern
	is-js = run.options node-js
	program = server check-main-and-print-diags run.main,
		- if is-js then js else java
	if is-js
		server run-node-js program, run.main
	else
		server run-java program, run.main

-run-java void(server server, program program-with-main, run-main main-kind) summon, unsafe, java extern
	loader CrowClassLoader = getSystemClassLoader,
	for class_ in server build-to-java program, "crowrun_"
		ints int8 mut-slice = class_.bytecode.safe-reinterpret-cast cast-mutable
		loader addClassBytecode class_.name-without-extension.to-java-string, ints
	Main = loader.reinterpret-cast::ClassLoader loadClass "crowrun_Main".to-java-string
	String = "java.lang.String".to-java-string forName
	String-array Class = String arrayType
	main = Main getMethod "main".to-java-string, (String-array,)
	args String mut-slice = for arg in run-main program-args then arg to-java-string
	# First argument is ignored, so pass an arbitrary object
	try
		_ = main invoke Main.reinterpret-cast, (args.reinterpret-cast,)
	catch InvocationTargetException e
		cause = e.getCause
		cause omit-runtime-stack-trace
		throw cause reinterpret-cast

-omit-runtime-stack-trace void(a Throwable) summon, unsafe, java extern
	original StackTraceElement[] = a.getStackTrace to
	if i ?= original find-index it.is-run-java
		a setStackTrace original[0 .. i - 2].to
-is-run-java bool(a StackTraceElement) summon, unsafe, java extern
	a.getMethodName.to::string == "run__45java"

-run-node-js void(server server, program program-with-main, run-main main-kind) summon, unsafe
	with temp in "crow-" temp-file ".js"
		js = server build-to-js program, ()
		temp write-file js.js
		args string[] = ("node", temp)::string[] ~~ run-main.program-args
		exit = "/usr/bin/env" spawn-and-inherit-io args
		assert exit == 0 else exit exit

-get-crow-include-dir file-path(this-executable file-path) summon
	this-dir = this-executable parent-or-empty
	this-dir-dir = this-dir parent-or-empty
	if trusted extern windows
		this-dir-dir.base-name is "crow"
		this-dir-dir / "include"
	else
		usr = "usr" root-file-path
		if this-dir == usr / "bin"
			usr / "include" / "crow"
		elif this-dir == usr / "local" / "bin"
			usr / "local" / "include" / "crow"
		else
			this-dir-dir.base-name is "crow"
			this-dir-dir / "include"

-do-print void(server server, command print-command) summon
	main-uri = command main-uri
	match command kind
	as print-ast
		server load-single-file main-uri
		server print-ast main-uri print-diags-and-json
	as print-model
		program = server check-and-print-diags (main-uri,)
		out print "{server json-of-model program, main-uri}"
	as print-concrete-model
		program = server check-main-and-print-diags (main-uri main-kind-main-function ()), ()
		out print "{server json-of-concrete-model java, program}"
	as print-ide-at-pos x
		program = server check-and-print-diags (main-uri,)
		out print "{server json-for-print-ide-at-pos program, (main-uri, x.line-and-column), x.kind}"
	as print-ide-whole-file x
		program = server check-and-print-diags (main-uri,)
		out print "{server json-for-print-ide-whole-file program, main-uri, x}"

-build-all-outputs void
	server server
	outputs single-build-output[]
	times nat
	program program-with-main
do summon
	for x in outputs
		match x kind
		as java
			x.path write-jar do server build-to-java program, "", times
		as js
			server write-to-js program, x.path, true

-write-to-js void
	server server
	program program-with-main
	out-file file-path
	include-source-map bool
do summon
	source-map-path file-path? = if include-source-map
		out-file add-extension ".map"
	result = server build-to-js program, source-map-path?.base-name
	out-file write-file result.js, all, allow
	if map ?= source-map-path
		map write-file result.map!, read-write, allow

-check-main-and-print-diags program-with-main
	server server
	main main-kind
	targets build-target set
do summon
	server load-all-files-for-main main
	program = server get-program-for-main main, targets
	if program has-any-diagnostics
		err print do server show-diagnostics program
	if program has-fatal-diagnostics
		err print "Stopping due to compile errors."
		throw exit
	program

-check-and-print-diags program(server server, roots uri[]) summon
	server check-and-print-diags roots, ()
-check-and-print-diags program(server server, roots uri[], options show-diags-options) summon
	server load-all-files roots
	crow-configs uri set = roots filter it.is-crow-config
	program = server get-program crow-configs
	if program has-any-diagnostics
		err print do server show-diagnostics program, options
	program

-print-diags-and-json void(a diags-and-result-json) summon
	unless a.diagnostics is-empty
		err print a.diagnostics
	out print "{a.result}"
