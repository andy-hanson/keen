use-prefix
import
	CrowClassLoader.class
	crow/col/mut-slice
	crow/io/file
	crow/io/print
	crow/io/process
	crow/io/stdin
	crow/parse
	crow/string/util
	crow/unsafe
	java/lang/Class
	java/lang/ClassLoader
	java/lang/String
	java/lang/reflect/InvocationTargetException
	java/lang/reflect/Method
	java/lang/StackTraceElement
	java/lang/Throwable
	../backend/js/source-map
	../frontend/frontend
	../frontend/get-diagnostic-severity
	../frontend/lang
	../frontend/parse/lex-token
	../frontend/parse/parse
	../frontend/show-diag
	../frontend/show-model
	../lib/lsp/lsp-parse
	../lib/lsp/lsp-types
	../lib/server
	../model/model
	../model/parse-diag
	../model/source-range
	../model/uri
	../util/exit-code
	../util/perf
	../util/util
	./command
	./file-system
	./parse-command

main nat(args string[]) summon
	start = perf-now
	cwd = cwd
	this-executable = this-executable # TODO: just move to where its' used? -----------------------------------------------------
	command = parse-command cwd, args
	finally if command.options.perf
		log "Performance: {perf-report start}"
	server-settings server-settings =
		include-dir: get-crow-include-dir this-executable 'to
		cwd: cwd.to
		show-options: color: !lsp-command command.kind
	with reader in file-reader this-executable, command.kind.needs-watch
		server server = trusted server-settings,
		ctx main-ctx =
			server: server
			reader: reader
			print: of pipe, text then print pipe, text
		try
			go ctx, this-executable, command.kind
			0
		catch e as exit
			e.exit-code 'to

-needs-watch bool(a command-kind)
	match a
	as build-command
		a.watch
	as run-command
		a.options.watch
	else
		false

main-ctx record mut
	server mut server
	reader file-reader
	print void mut(pipe pipe, text string)
print void(a main-ctx, pipe pipe, text string)
	a.print[pipe, text]

-run-lsp void(server server, reader file-reader, this-executable file-path) summon
	log error, this-executable.crow-version.show
	log error, "Running language server protocol"
	log-lsp bool = true # TODO: get this from specified trace level ---------------------------------------------------------------
	until exit = handle-one-message-in server, reader, log-lsp
		()
	throw exit exit.value.to
-handle-one-message-in exit-code?(server server, reader file-reader, log-lsp bool) summon
	handle-one-lsp-message server, log-lsp.lsp-read, (of x then read-file-locally reader, x), of message
		lsp-write message.to, log-lsp

-lsp-read lsp-in-message(log-lsp bool) summon
	line0 = read-stdin
	stripped = try-remove-start! line0, "Content-Length: "
	content-length = parse nat, stripped
	line1 = strip read-stdin
	line1 is ""
	content = as-string read-n-bytes-from-stdin content-length
	if log-lsp
		log error, "LSP message in: {content}"
	parse json, content 'to

-lsp-write void(content-json json, log-lsp bool) summon
	content-string = to-json-strict content-json
	if log-lsp
		print err, "LSP out: {content-string}"
	print-no-newline out, "Content-Length: {content-string.to::char8[].size}\r\n\r\n{content-string}"

# VSCode seems to crash on unusual characters like ▶
-to-json-strict string(a json)
	with out in build
		for x in to-json a
			v nat32 = x.to
			if v > 0xff
				out ~~= (if v <= 0xffff then "\\u" else "\\U")
				out ~~= to-hex v
			else
				out ~= x

-load-all-files-for-main void(ctx main-ctx, main main-kind)
	match main
	as main-kind-main-function
		load-all-files ctx,
			- main.uri
	as main-kind-tests-in-config
		load-all-files-for-config ctx, main.config-uri
	as main-kind-tests-at-uri
		load-all-files ctx,
			- main.crow-uri

-load-all-files-for-config void(ctx main-ctx, config-uri uri)
	unless uri-is-file config-uri
		print ctx, err, "Can't list test files at non-file URI {config-uri}"
		throw exit
	for file in files-for-config ctx.reader, config-uri
		load-single-file ctx.server, ctx.reader, file.to
	load-until-no-unknown-uris ctx.server, ctx.reader

-files-for-config file-path[](reader file-reader, config-uri uri)
	files = files-in-directory-recursive reader, config-uri.as-file-path.parent!
	filter files, it.file-type == crow

-load-all-files void(ctx main-ctx, root-uris uri[])
	start = perf-now
	finally end-load-all-files start
	for uri in root-uris
		if is-crow-config uri
			load-all-files-for-config ctx, uri
		else
			load-single-file ctx.server, ctx.reader, uri
	load-until-no-unknown-uris ctx.server, ctx.reader

-read-file-locally read-file-result-params(reader file-reader, uri uri)
	match res = try-read-file reader, uri
	as array-view
		uri, ok, res
	as read-file-diag
		type read-file-result-type = match res
		as unknown
			throw unreachable
		as not-found
			notFound
		as error
			error
		uri, type, ()

-load-until-no-unknown-uris void(server server, reader file-reader)
	until server.files-state == all-loaded
		for uri in flush-all-unknown-uris server
			load-single-file server, reader, uri

-load-single-file void(server server, reader file-reader, uri uri)
	set-file server, uri, do try-read-file reader, uri

-go void(ctx main-ctx, this-executable file-path, command command-kind) summon
	match command
	as build-command
		targets build-target set = map command.out, it.kind
		do-and-watch ctx, command.main, command.watch, of
			program = check-main-and-print-diags ctx, command.main, targets
			if has-fatal-diagnostics program
				print err, "Due to compile errors, nothing will be built."
				for out in command.out
					try
						remove-file out.path.to
					catch as path-not-found
						()
				throw exit
			else
				build-all-outputs ctx.server, command.out, command.options, command.times, program
	as check-command
		for _ in 0::nat .. command.times
			options show-diags-options =
				only-for-uris: ()
				show-options: color: command.show-color
				show-all-diagnostics: command.show-all-diagnostics
			program = check-and-print-diags ctx, command.root-uris, options
			forbid has-any-diagnostics program else exit
			ctx.server := trusted ctx.server.settings,
	as help-command
		print command.help-text
		throw exit command.exit-code.value.to
	as lsp-command
		run-lsp ctx.server, ctx.reader, this-executable
	as perf-test-parse-command
		files file-path[] = for* uri in command.root-uris
			if is-crow-config uri
				files-for-config ctx.reader, uri
			else
				- as-file-path uri
		file-contents line-and-column-getter[] = for file in files
			line-and-column-getter-for-text match x = try-read-file ctx.reader, file.to
			as array-view
				safe-reinterpret-cast x
			as read-file-diag
				print ctx, err, "error reading {file}"
				()
		for _ in 0 .. command.times
			for file, lcg in zip files, file-contents
				_ = parse-file file.to, lcg.source-text, lcg
		log "Parsed {files.size} files {command.times} times."
	as print-ast-command
		load-single-file ctx.server, ctx.reader, command.uri
		diagnostics, json = print-ast ctx.server, command.uri
		unless is-empty diagnostics
			print ctx, err, diagnostics
		print ctx, out, "{json}"
	as print-tokens-command
		match content = try-read-file ctx.reader, command.uri
		as array-view
			source = content.safe-reinterpret-cast::(char8 array-view)
			diagnostics parse-diagnostic mut[] = ()
			tokens = lex-tokens source, diagnostics
			unless is-empty diagnostics
				show-ctx = show-ctx-for-single-file command.uri, source, ctx.server.uris-info, ctx.server.show-options
				print ctx, err, show-parse-diagnostics show-ctx, command.uri, diagnostics.move-to
			print ctx, out, tokens.to-crowd
		as read-file-diag
			log error, "Can't read file"
	as print-concrete-model-command
		main = main-kind-main-function command.main, ()
		load-all-files-for-main ctx, main
		program = check-main-and-print-diags ctx, main, ()
		print ctx, out, "{json-of-concrete-model ctx.server, java, program}"
	as print-dependencies-command
		program = check-and-print-diags ctx, command.root-uris
		print ctx, out, print-dependencies ctx.server, program, command.format
	as print-ide-at-pos-command
		program = check-and-print-diags ctx, (command.where.uri,)
		print ctx, out, "{json-for-print-ide-at-pos ctx.server, program, command.where, command.kind}"
	as print-ide-whole-file-command
		program = check-and-print-diags ctx, (command.uri,)
		print ctx, out, "{json-for-print-ide-whole-file ctx.server, program, command.uri, command.kind}"
	as print-model-command
		program = check-and-print-diags ctx, command.root-uris
		print ctx, out, "{json-of-model ctx.server, program, command.root-uris}"
	as run-command
		do-and-watch ctx, command.main, command.options.watch, of then run ctx, command
	as version-command
		print "{crow-version this-executable}"


-do-and-watch void(ctx main-ctx, main main-kind, watch bool, f void mut())
	load-all-files-for-main ctx, main
	f[]
	guard watch
	log "watching for changes..."
	for in infinite
		changed = wait-for-change ctx.reader
		log "{get-arbitrary! changed} changed, building again..."
		load-all-files ctx, do map changed, it.to
		f[]

-run void(ctx main-ctx, run run-command) summon
	is-js = run.options.node-js
	program = check-main-and-print-diags ctx, run.main,
		- if is-js then js else java
	forbid has-fatal-diagnostics program else
		print err, "Stopping due to compile errors."
		exit
	trusted if is-js
		run-node-js ctx.server, program, run.main
	else
		assert java else error "This is a JS build, so 'run' only works when the '--node-js' option is passed."
		run-java ctx.server, program, run.main

-run-java void(server server, program program-with-main, run-main main-kind) summon, unsafe, java
	loader CrowClassLoader = getSystemClassLoader,
	for file in build-to-java server, program, "crowrun_"
		bytes int8 mut-slice = file.bytes.safe-reinterpret-cast.cast-mutable
		if x = try-remove-end file.path, ".class"
			addClassBytecode loader, x.to, bytes
		else
			addResource loader, file.path.to, bytes

	Main = loadClass loader.reinterpret-cast::ClassLoader, "crowrun_Main"
	main = getMethod Main, "main",
		- arrayType forName "java.lang.String"
	args String mut-slice = map run-main.program-args, it.to
	# First argument is ignored, so pass an arbitrary object
	try
		_ = invoke main, Main.reinterpret-cast,
			- reinterpret-cast args
	catch e as InvocationTargetException
		cause = getCause e
		omit-runtime-stack-trace cause
		throw reinterpret-cast cause

-omit-runtime-stack-trace void(a Throwable) summon, unsafe, java
	original StackTraceElement[] = a.getStackTrace.to
	if i = find-index original, it.is-run-java
		setStackTrace a, original[0 .. i - 2].to
-is-run-java bool(a StackTraceElement) summon, unsafe, java
	a.getMethodName.to::string == "run__45java"

-run-node-js void(server server, program program-with-main, run-main main-kind) summon, unsafe
	with temp in temp-file "crow-", ".js"
		js = build-to-js server, program, no-sanity-checks, ()
		write-file temp, js.js
		args string[] = ("node", temp)::string[] ~~ run-main.program-args
		exit = spawn-and-inherit-io "/usr/bin/env", args
		assert exit == 0 else exit exit

-get-crow-include-dir file-path(this-executable file-path)
	this-dir = parent-or-empty this-executable
	this-dir-dir = parent-or-empty this-dir
	usr = root-file-path "usr"
	if this-dir == usr / "bin"
		usr / "include" / "crow"
	elif this-dir == usr / "local" / "bin"
		usr / "local" / "include" / "crow"
	else
		this-dir-dir.base-name is "crow"
		this-dir-dir / "include"

-build-all-outputs void
	server server
	outputs single-build-output[]
	options build-command-options
	times nat
	program program-with-main
do summon
	for x in outputs
		match x.kind
		as java
			write-jar x.path, build-to-java server, program, "", times
		as js
			write-to-js server, program, options, x.path, true

-write-to-js void
	server server
	program program-with-main
	options build-command-options
	out-file file-path
	include-source-map bool
do summon
	source-map-path file-path? = if include-source-map
		add-extension out-file, ".map"
	result = build-to-js server, program, options.sanity-checks, source-map-path.?base-name
	write-file out-file, result.js, all, allow
	?write-file source-map-path, result.map!, read-write, allow

-check-main-and-print-diags program-with-main(ctx main-ctx, main main-kind, targets build-target set)
	program = get-program-for-main ctx.server, main, targets
	if has-any-diagnostics program
		print ctx, err, do show-diagnostics ctx.server, program
	program

-check-and-print-diags program(ctx main-ctx, roots uri[])
	check-and-print-diags ctx, roots, ()
-check-and-print-diags program(ctx main-ctx, roots uri[], options show-diags-options)
	load-all-files ctx, roots
	crow-configs uri set = filter roots, it.is-crow-config
	program = get-program ctx.server, crow-configs
	if has-any-diagnostics program
		print ctx, err, do show-diagnostics ctx.server, program, options
	program

-print-dependencies string(server server, program program, format print-dependencies-format)
	ctx = get-show-diag-ctx server, program
	match format
	as dot
		deps = join "\n\t", sort for* from, to in all-dependencies program
			for t in to
				"{quoted show-uri ctx, from} -> {quoted show-uri ctx, t}"
		"digraph \{\n\t{deps}\n}"
	as flat
		join "\n", sort for uri in all-uris program
			show-uri ctx, uri
