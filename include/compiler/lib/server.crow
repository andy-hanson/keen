handle-one-lsp-message exit-code?
	server server
	message-in lsp-in-message
	read-file-locally read-file-result-params mut(uri uri)
	output void mut(x lsp-out-message)
do
	start = perf-now
	finally start end-handle-one-lsp-message
	buffered-messages lsp-in-message mut-queue = ()
	buffered-messages ~= message-in
	loop
		message = buffered-messages dequeue!
		action = server handle-lsp-message message
		for out-message in action out-messages
			if u = out-message.lsp-out-notification ?unknown-uris
				for uri in u unknownUris
					buffered-messages ~= read-file-locally[uri]
			else
				output[out-message]
		if exit = action exit-code
			break exit
		elif buffered-messages is-empty
			break ()
		else
			continue

handle-lsp-message lsp-out-action(server server, message lsp-in-message)
	match message
	as lsp-in-notification
		server handle-lsp-notification message
	as lsp-in-request
		server handle-lsp-request message
	as lsp-in-response
		()

-handle-lsp-notification lsp-out-action(server server, a lsp-in-notification)
	match a
	as cancel-request-params
		# Ignore because according to documentation,
		# "A request that got canceled still needs to return from the server and send a response back"
		()
	as did-change-text-document-params
		server change-file a.textDocument.uri, a.contentChanges
		server handle-file-changed
	as did-close-text-document-params
		()
	as did-open-text-document-params
		server set-file a.textDocument.uri, a.textDocument.text
		server handle-file-changed
	as did-save-text-document-params
		()
	as exit-params
		(), ok
	as initialized-params
		initialized-action
	as read-file-result-params
		server set-file a.uri, match a type
		as ok
			a content
		as notFound
			not-found
		as error
			error
		server handle-file-changed
	as set-trace-params
		# TODO: implement this
		()

-handle-file-changed lsp-out-action(server server)
	match server files-state
	as has-unknown
		(server.flush-all-unknown-uris.unknown-uris,), ()
	as has-loading
		()
	as all-loaded
		program = server get-program ()
		messages lsp-out-message mut[] = ()
		exit-code mut exit-code? = ()
		for request in server.lsp-state pending-requests
			action = server handle-lsp-request-with-program program, request
			messages ~~= action.out-messages
			if e = action exit-code
				# TODO: If exit-code is already set, use the worse exit code?
				exit-code := e
		server.lsp-state.pending-requests clear
		messages notify-diagnostics server, program
		messages.move-to, exit-code

-handle-lsp-request lsp-out-action(server server, request lsp-in-request)
	res lsp-out-result? = match params = request params
	as build-js-script-params
		()
	as code-lens-params
		()
	as completion-params
		()
	as definition-params
		()
	as document-highlight-params
		()
	as execute-command-params
		()
	as folding-range-params
		server folding-ranges params.textDocument.uri
	as hover-params
		()
	as implementation-params
		()
	as initialize-params
		initialize-capabilities initialize-result
	as inlay-hint-params
		()
	as reference-params
		()
	as rename-params
		()
	as perf-report-params
		perf-report perf-report-result
	as semantic-tokens-params
		server encoded-tokens params.textDocument.uri
	as shutdown-params
		null-lsp-out-result
	as signature-help-params
		()
	as syntax-translate-params
		params syntax-translate
	as type-definition-params
		()
	if res
		request single-response res
	else
		server respond-with-program request

-initialize-capabilities json()
	textDocumentSync: 2
	codeLensProvider: true
	completionProvider:
		triggerCharacters:
			- "."
	definitionProvider: true
	documentHighlightProvider: true
	executeCommandProvider:
		commands:
			- "run-test"
	foldingRangeProvider: true
	hoverProvider: true
	implememtationProvider: true
	inlayHintProvider: true
	referencesProvider: true
	renameProvider: true
	semanticTokensProvider:
		full: true
		legend: get-tokens-legend
	signatureHelpProvider:
		triggerCharacters:
			- ","
	typeDefinitionProvider: true

folding-ranges folding-range-result(server server, uri uri)
	match uri file-type
	as crow
		server.frontend get-ast uri folding-ranges-of-ast
	as crowd
		()
	else
		throw unreachable

-single-response lsp-out-action(request lsp-in-request, response lsp-out-result)
	((request message-for-response response),), ()
-message-for-response lsp-out-message(request lsp-in-request, result lsp-out-result)
	request.id lsp-out-response result

-respond-with-program lsp-out-action(server server, request lsp-in-request)
	if server.files-state == all-loaded
		server handle-lsp-request-with-program (server get-program ()), request
	else
		server.lsp-state.pending-requests ~= request
		()

-handle-lsp-request-with-program lsp-out-action
	server server
	program program
	request lsp-in-request
do
	program-with-main program-with-main mut(main main-kind, target build-target) = of main, target
		server.frontend program-with-main-from-program program, main, (target,)
	respond lsp-out-action mut(x lsp-out-result) = of x
		request single-response x
	match params = request params
	as build-js-script-params
		pwm = program-with-main[(params.uri main-kind-main-function ()), js]
		diags = server show-diagnostics pwm, params.diagnosticsOnlyForUris.?to
		script string? = unless pwm has-fatal-diagnostics
			server build-to-js pwm, no-sanity-checks, () js
		respond[diags build-js-script-result script]
	as code-lens-params
		respond[program get-code-lenses params]
	as completion-params
		respond[if res = server get-completion-for-program program, params then res]
	as definition-params
		respond[(server get-definition-for-program program, params) ranges-result]
	as document-highlight-params
		respond[if res = server get-document-highlights-for-program program, params then res]
	as execute-command-params
		server execute-command program, request, params
	as folding-range-params
		throw unreachable
	as hover-params
		respond[if res = server get-hover-for-program program, params then res]
	as implementation-params
		respond[server get-implementation-for-program program, params ranges-result]
	as initialize-params
		throw unreachable
	as inlay-hint-params
		respond[server get-inlay-hints-for-program program, params]
	as perf-report-params
		throw unreachable
	as reference-params
		respond[server get-references-for-program program, params ranges-result]
	as rename-params
		respond[if res = server get-rename-for-program program, params then res]
	as semantic-tokens-params
		throw unreachable
	as shutdown-params
		throw unreachable
	as signature-help-params
		respond[if res = server get-signature-help-for-program program, params then res]
	as syntax-translate-params
		throw unreachable
	as type-definition-params
		respond[server get-type-definition-for-program program, params ranges-result]

-execute-command lsp-out-action
	server server
	program program
	request lsp-in-request
	params execute-command-params
do
	match params
	as run-test
		main-kind = false main-kind-tests-at-uri params.where.uri, params.where.line.to
		pwm = server.frontend program-with-main-from-program program, main-kind, (java,)
		writes write mut[] = ()
		exit = server run-from-lsp pwm, (), of pipe, text
			writes ~= pipe, text
		server.lsp-state.test-states[params.where] := (exit, writes.move-to)
		message0 = request message-for-response null-lsp-out-result
		message1 lsp-out-message = 1 lsp-out-request inlay-hint-refresh
		(message0, message1), ()

run-from-lsp exit-code
	_ server
	program program-with-main
	_ uri[]? # diagnostics-only-for-uris
	write-cb void mut(pipe pipe, text string)
do
	if program has-fatal-diagnostics
		write-cb[err, "Can't run due to compile errors"]
		error
	else
		()
		throw todo # TODO: load it in and run as a Java program. We should probably sandbox it too! ----------------------------

server record mut
	settings server-settings
	lsp-state lsp-state
	frontend frontend
show-options show-options(a server)
	a.settings show-options
uris-info uris-info(a server)
	cwd: a.settings cwd
	crow-include: a.settings include-dir
server-settings record
	include-dir uri
	cwd uri
	show-options show-options
new server(settings server-settings) unsafe
	clear-object-memoizers
	settings: settings
	lsp-state: ()
	frontend: settings.include-dir,

lsp-state record mut
	uris-with-diagnostics mut uri[]
	pending-requests lsp-in-request mut[]
	test-states test-states
-new lsp-state()
	(), (), ()

crow-version json(this-executable file-path)
	path: this-executable to
	built-on: build-date to
	commit-hash: commit-hash to

-content-changed void(server server)
	server.lsp-state.test-states clear

set-file void(server server, uri uri, result read-file-result)
	server content-changed
	server.frontend set-file uri, result
set-file void(server server, uri uri, result string)
	server set-file uri, result.to::nat8[].to::(nat8 array-view)
change-file void(server server, uri uri, changes text-document-content-change-event[])
	server content-changed
	server.frontend change-file uri, changes

files-state files-state(server server)
	server.frontend files-state
flush-all-unknown-uris uri[](server server)
	server.frontend flush-all-unknown-uris

show-diagnostics string(server server, program program)
	server show-diagnostics-common program.as-program-with-opt-main, ()
show-diagnostics string(server server, program program-with-main)
	server show-diagnostics-common program.as-program-with-opt-main, ()
show-diagnostics string(server server, program program-with-main, only-for-uris uri set?)
	server show-diagnostics-common program.as-program-with-opt-main,
		only-for-uris: only-for-uris
		show-options:
			color: true
		show-all-diagnostics: false
show-diagnostics string(server server, program program, options show-diags-options)
	server show-diagnostics-common program.as-program-with-opt-main, options
-show-diagnostics-common string
	server server
	program program-with-opt-main
	options show-diags-options
do
	server get-show-diag-ctx program.program, !options.show-color show-diagnostics program, options

-get-completion-for-program completion-list?(server server, program program, params completion-params)
	if position = server server-get-position program, params.params, after
		server get-show-diag-ctx program, true get-completion-for-position position

-get-definition-for-program uri-and-line-and-character-range[]
	server server
	program program
	params definition-params
do
	if position = server server-get-position program, params.params, exact
		program get-definition-for-position position

-get-implementation-for-program uri-and-line-and-character-range[]
