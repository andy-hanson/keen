do
	if position = server server-get-position program, params.params, exact
		program get-implementation-for-position position

-get-type-definition-for-program uri-and-line-and-character-range[]
	server server
	program program
	params type-definition-params
do
	if position = server server-get-position program, params.text-document-and-position, exact
		program get-type-definition-for-position position

-get-document-highlights-for-program document-highlight-result?
	server server
	program program
	params document-highlight-params
do
	if position = server server-get-position program, params.params, exact
		program get-document-highlights-for-position position

-get-references-for-program uri-and-line-and-character-range[]
	server server
	program program
	params reference-params
do
	if position = server server-get-position program, params.params, exact
		program get-references-for-position position

-get-rename-for-program workspace-edit?(server server, program program, params rename-params)
	if position = server server-get-position program, params.text-document-and-position, exact
		program get-rename-for-position position, params.newName

-get-signature-help-for-program signature-help?
	server server
	program program
	params signature-help-params
do
	if position = server server-get-position program, params.text-document-and-position, after
		server get-show-diag-ctx program, true get-signature-help-for-position position

-get-hover-for-program hover?(server server, program program, params hover-params)
	if position = server server-get-position program, params.params, exact
		server get-show-diag-ctx program, true get-hover position

-get-inlay-hints-for-program inlay-hint-result
	server server
	program program
	params inlay-hint-params
do
	program get-inlay-hints (server get-show-diag-ctx program), server.lsp-state.test-states, params

get-program program(server server, fully-loaded-configs uri set)
	server.frontend make-program fully-loaded-configs

get-program-for-main program-with-main(server server, main main-kind, targets build-target set)
	server.frontend make-program-with-main main, targets

-server-get-position position?
	_ server # TODO: if this is not used, simplify code! --------------------------------------------------------------------------
	program program
	where text-document-position-params
	kind get-position-kind
do
	if where.textDocument.uri in program.all-modules
		program get-position where.to, kind

print-ast (string, json)(server server, uri uri)
	file = server.frontend get-ast uri
	- server.get-show-ctx show-parse-diagnostics uri, file.parse-diagnostics
	- file to

json-of-model json(_ server, program program, uris uri[])
	if uri = uris opt-only
		program module-at-uri uri to
	else
		for uri in uris
			program module-at-uri uri to

json-of-concrete-model json(server server, target build-target, program program-with-main)
	server.get-show-ctx concretize target, program to

json-for-print-ide-at-pos json
	server server
	program program
	where uri-line-and-column
	kind print-ide-at-pos-kind
do
	params text-document-position-params =
		textDocument: uri: where uri
		position: server.frontend.line-and-column-getters[where uri] to-line-and-character where.pos
	match kind
	as completion
		server get-completion-for-program program, (params,) ?to else null
	as definition
		server get-definition-for-program program, (params,) to
	as document-highlight
		server get-document-highlights-for-program program, (params,) ?to else null
	as hover
		server get-hover-for-program program, (params,) ?to else null
	as implementation
		server get-implementation-for-program program, (params,) to
	as rename
		server get-rename-for-program program, (params, "new-name") ?to else null
	as references
		server get-references-for-program program, (params,) to
	as signature-help
		server get-signature-help-for-program program, (params,) ?to else null
	as type-definition
		server get-type-definition-for-program program, (params,) to

json-for-print-ide-whole-file json
	server server
	program program
	uri uri
	kind print-ide-whole-file-kind
do
	match kind
	as code-lenses
		(program get-code-lenses textDocument: uri: uri) to
	as folding-ranges
		server folding-ranges uri to
	as inlay-hints
		range line-and-character-range = top-of-file
		res = server get-inlay-hints-for-program program,
			textDocument: uri: uri
			range: range
		res to
	as tokens
		server decoded-tokens uri

decoded-tokens json(server server, uri uri)
	server encoded-tokens uri json-of-decoded-tokens
encoded-tokens semantic-tokens(server server, uri uri)
	match uri file-type
	as crow
		server.frontend get-ast uri tokens-of-ast
	as crowd
		server.frontend get-crowd-file uri tokens-of-crowd
	else
		throw unreachable

build-to-java java-compiled-class[](server server, program program-with-main, prefix string)
	server build-to-java program, prefix, 1
build-to-java java-compiled-class[](server server, program program-with-main, prefix string, times nat)
	show-ctx = server get-show-diag-ctx program.program, true
	concrete-program = show-ctx.show concretize java, program
	res mut = program.program translate-to-java-classes concrete-program, show-ctx, prefix
	for _ in 1 .. times
		res := program.program translate-to-java-classes concrete-program, show-ctx, prefix
	res

build-to-js js-and-map
	server server
	program program-with-main
	sanity-checks sanity-checks
	source-map-name string?
do
	forbid program has-fatal-diagnostics
	show-ctx = server get-show-diag-ctx program.program, true
	concrete-program = show-ctx.show concretize js, program
	program translate-to-js concrete-program, show-ctx, sanity-checks, source-map-name

get-show-diag-ctx show-diag-ctx(server server, program program)
	server get-show-diag-ctx program, false
get-show-diag-ctx show-diag-ctx(server server, program program, force-no-color bool)
	show: server get-show-ctx force-no-color
	common-types: program common-types

get-show-ctx show-ctx(server server)
	server get-show-ctx false
get-show-ctx show-ctx(server server, force-no-color bool)
	options = if force-no-color then server.show-options without-color else server show-options
	server.frontend show-ctx server.uris-info, options

-notify-diagnostics void(res lsp-out-message mut[], server server, program program)
	diags = program.as-program-with-opt-main sorted-diagnostics
	state = server lsp-state
	new-uris uri set = for x in diags then x uri
	all uri-and-diagnostics[] =
		-- diags
		-- for* uri in state uris-with-diagnostics
			unless uri in new-uris
				- uri, ()
	state.uris-with-diagnostics := new-uris to
	ctx = server get-show-diag-ctx program
	for ud in all
		res ~= ud.uri publish-diagnostics-params for x in ud diagnostics
			range: (server.frontend line-and-character-getter ud.uri)[x.range]
			severity: x.kind.get-diagnostic-severity to-lsp-diagnostic-severity
			message: ctx string-of-diag x.kind

-to-lsp-diagnostic-severity lsp-diagnostic-severity(a diagnostic-severity)
	match a
	as lint
		Hint
	as warning
		Warning
	as check-error
		Error
	as name-not-found
		Error
	as import-error
		Error
	as common-missing
		Error
	as parse-error
		Error

-initialized-action lsp-out-action()
	methods string[] =
		- "textDocument/codeLens"
		- "textDocument/completion"
		- "textDocument/definition"
		- "textDocument/documentHighlight"
		- "textDocument/foldingRange"
		- "textDocument/hover"
		- "textDocument/implementation"
		- "textDocument/inlayHint"
		- "textDocument/rename"
		- "textDocument/references"
		- "textDocument/semanticTokens/full"
		- "textDocument/signatureHelp"
		- "textDocument/typeDefinition"
		- "workspace/executeCommand"
	messages lsp-out-message[] = for method in methods
		method register-capability method
	messages, ()
