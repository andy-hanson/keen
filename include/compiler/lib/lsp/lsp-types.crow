import
	crow/io/print: ==, pipe, to
	../../model/source-range
	../../model/uri
	../../util/exit-code

location alias
	uri-and-line-and-character-range
text-document-identifier record(uri uri)
to json(a text-document-identifier)
to text-document-identifier(a json)
	uri: a["uri"] to

text-document-position-params record
	textDocument text-document-identifier
	position line-and-character
to text-document-position-params(a json)
	textDocument: a["textDocument"] to
	position: a["position"] to
to json(a text-document-position-params)
to uri-line-and-character(a text-document-position-params)
	a.textDocument.uri, a.position

lsp-in-message union(lsp-in-notification, lsp-in-request, lsp-in-response)

lsp-in-notification union
	cancel-request-params
	did-change-text-document-params
	did-close-text-document-params
	did-open-text-document-params
	did-save-text-document-params
	exit-params
	initialized-params
	read-file-result-params
	set-trace-params
to json(a lsp-in-notification)

lsp-in-request record(id nat, params lsp-in-request-params)
lsp-in-request-params union
	build-js-script-params
	code-lens-params
	completion-params
	definition-params
	document-highlight-params
	execute-command-params
	folding-range-params
	hover-params
	implementation-params
	initialize-params
	inlay-hint-params
	perf-report-params
	reference-params
	rename-params
	semantic-tokens-params
	shutdown-params
	signature-help-params
	syntax-translate-params
	type-definition-params
to json(a lsp-in-request-params)
| Nothing here for now since we don't need the response
lsp-in-response record()

lsp-out-action record(out-messages lsp-out-message[], exit-code exit-code?)
new lsp-out-action()
	(), ()
lsp-out-message union(lsp-out-notification, lsp-out-request, lsp-out-response)
	to json()
== bool(a lsp-out-message, b lsp-out-message)
lsp-out-notification union(publish-diagnostics-params, register-capability, unknown-uris)
== bool(a lsp-out-notification, b lsp-out-notification)
to json(a lsp-out-notification)
	method string = match a
	as publish-diagnostics-params _
		"textDocument/publishDiagnostics"
	as register-capability _
		"client/registerCapability"
	as unknown-uris _
		"custom/unknownUris"
	method: method to
	params: match a
	as publish-diagnostics-params x
		x to
	as register-capability x
		x to
	as unknown-uris x
		x to
lsp-out-request record(id nat, params lsp-out-request-params)
== bool(a lsp-out-request, b lsp-out-request)
to json(a lsp-out-request)
	match a params
	as inlay-hint-refresh
		id: a.id to
		method: "workspace/inlayHint/refresh"
lsp-out-request-params union(inlay-hint-refresh)
== bool(a lsp-out-request-params, b lsp-out-request-params)
inlay-hint-refresh record
== bool(a inlay-hint-refresh, b inlay-hint-refresh) 

lsp-out-response record(id nat, result lsp-out-result)
== bool(a lsp-out-response, b lsp-out-response)
to json(a lsp-out-response)
lsp-out-result union
	build-js-script-result
	code-lens-result
	completion-list
	document-highlight-result
	folding-range-result
	initialize-result
	inlay-hint
	inlay-hint-result
	hover
	perf-report-result
	ranges-result
	run-test-result
	semantic-tokens
	signature-help
	syntax-translate-result
	workspace-edit
	null-lsp-out-result
do
	to json()
== bool(a lsp-out-result, b lsp-out-result) 
null-lsp-out-result record # TODO: just use json-null directly? --------------------------------------------------------------------
== bool(a null-lsp-out-result, b null-lsp-out-result)
to json(_ null-lsp-out-result)
	null
new lsp-out-result()
	null-lsp-out-result
perf-report-result record(to json)
== bool(a perf-report-result, b perf-report-result)

register-capability record(id string, method string)
== bool(a register-capability, b register-capability)
to json(a register-capability)

| This is used internally to indicate that the context should send files to the server.
| The editor should send back a 'readFileResult' notification for each unknown URI.
unknown-uris record(unknownUris uri[])
== bool(a unknown-uris, b unknown-uris)
to json(a unknown-uris)

# For simplicity, this will just have a hardcoded result
initialize-result record(capabilities json)
== bool(a initialize-result, b initialize-result)
to json(a initialize-result)

set-trace-params record(value trace-value)
to json(a set-trace-params)
trace-value enum(off, messages, verbose)
to json(a trace-value)
to trace-value(a json)
	a.to::symbol.to else throw a deserialize-error
to trace-value?(a symbol)

syntax-translate-params record(source string, from-language language, to-language language)
to json(a syntax-translate-params)
to syntax-translate-params(a json)
	source: a["source"] to
	from-language: a["from-language"] to
	to-language: a["to-language"] to
language enum(c, crow, java)
== bool(a language, b language)
to json(a language)
to language(a json)
	a.to::symbol.to else throw a deserialize-error
to language?(a symbol)
syntax-translate-result record(output string, diagnostics pos[])
== bool(a syntax-translate-result, b syntax-translate-result)
to json(a syntax-translate-result)
to syntax-translate-result(a json)
	output: a["output"] to
	diagnostics: a["diagnostics"] to

| Parameter to "custom/readFileResult"
read-file-result-params record(uri uri, type read-file-result-type, content nat8 array-view)
to json(a read-file-result-params)
read-file-result-type enum(ok, notFound, error)
to json(a read-file-result-type)
| Parameter to "custom/build-js-script"
build-js-script-params record(uri uri, diagnosticsOnlyForUris uri[]?)
to json(a build-js-script-params)
to build-js-script-params(a json)
	uri: a["uri"] to
	diagnosticsOnlyForUris: a["diagnosticsOnlyForUris"] to
build-js-script-result record(diagnostics string, script string?)
== bool(a build-js-script-result, b build-js-script-result)
to json(a build-js-script-result)
to build-js-script-result(a json)
	diagnostics: a["diagnostics"] to
	script: unless a["script"] == null then a["script"] to
| Parameter to "custom/perf-report"
perf-report-params record
to json(a perf-report-params)

test-states alias
	run-test-result mut[uri-and-line]
| Response to "custom/run"
run-test-result record(exit exit-code, writes write[])
== bool(a run-test-result, b run-test-result)
to json(a run-test-result)
write record(pipe pipe, text string)
== bool(a write, b write)
to json(a write)
-to json(a pipe)
	a.to::string to

cancel-request-params record(id nat)
to json(a cancel-request-params)

exit-params record
to json(a exit-params)

initialize-params record(trace trace-value)
to json(a initialize-params)
to initialize-params(a json)
	trace: if a["trace"] == null then off else a["trace"] to
initialized-params record
to json(a initialized-params)
shutdown-params record
to json(a shutdown-params)
code-lens-params record(textDocument text-document-identifier)
to json(a code-lens-params)
code-lens-result record(lenses code-lens[])
new code-lens-result()
	(),
== bool(a code-lens-result, b code-lens-result)
to json(a code-lens-result)
	a.lenses to
code-lens record
	range line-and-character-range
	| // WARN: The documentation says this is a Command, but it doesn't seem to support a 'tooltip' when on a CodeLens.
	command command
== bool(a code-lens, b code-lens)
to json(a code-lens)
command record
	title string
	tooltip string?
	| This also determines 'command'.
	| Arguments must be represented as an array.
	arguments execute-command-params?
== bool(a command, b command)
to json(a command)
	base json[symbol] =
		title: a.title to
		tooltip: a.tooltip to
	rest json[symbol] = if args ?= a arguments
		match args
		as run-test x
			command: "run-test"
			arguments: x.where.to,
	base.omit-null ~~ rest to
new command(title string)
	title, (), ()
execute-command-params union(run-test)
to json(a execute-command-params)
== bool(a execute-command-params, b execute-command-params)
run-test record(where uri-and-line)
to json(a run-test)
== bool(a run-test, b run-test)

completion-params record(params text-document-position-params)
to json(a completion-params)
completion-list record(items completion-item[])
== bool(a completion-list, b completion-list)
to json(a completion-list)
completion-item record(label string, detail string, documentation string)
== bool(a completion-item, b completion-item)
to json(a completion-item)

| For {definition-params}, {implementation-params}, or {reference-params}
ranges-result record(ranges uri-and-line-and-character-range[])
== bool(a ranges-result, b ranges-result)
to json(a ranges-result)
	a.ranges to

definition-params record(params text-document-position-params)
to json(a definition-params)
	a.params to
implementation-params record(params text-document-position-params)
to json(a implementation-params)
did-change-text-document-params record
	textDocument text-document-identifier
	contentChanges text-document-content-change-event[]
to json(a did-change-text-document-params)
did-close-text-document-params record
to json(a did-close-text-document-params)
did-open-text-document-params record(textDocument text-document-item)
to json(a did-open-text-document-params)
did-save-text-document-params record(textDocument text-document-identifier)
to json(a did-save-text-document-params)
text-document-item record(uri uri, text string)
to json(a text-document-item)

hover-params record(params text-document-position-params)
to json(a hover-params)
	a.params to
hover record(contents markup-content)
== bool(a hover, b hover)
to json(a hover)
markup-content record(kind markup-kind, value string)
== bool(a markup-content, b markup-content)
to json(a markup-content)
markup-kind enum(plaintext, markdown)
== bool(a markup-kind, b markup-kind)
to json(a markup-kind)

publish-diagnostics-params record(uri uri, diagnostics lsp-diagnostic[])
== bool(a publish-diagnostics-params, b publish-diagnostics-params)
to json(a publish-diagnostics-params)
to publish-diagnostics-params(a json)
	uri: a["uri"] to
	diagnostics: a["diagnostics"] to

text-document-content-change-event record(range line-and-character-range?, text string)
new text-document-content-change-event(text string)
	(), text
to json(a text-document-content-change-event)
lsp-diagnostic record(range line-and-character-range, severity lsp-diagnostic-severity, message string)
== bool(a lsp-diagnostic, b lsp-diagnostic)
to json(a lsp-diagnostic)
to lsp-diagnostic(a json)
	range: a["range"] to
	severity: a["severity"] to
	message: a["message"] to
lsp-diagnostic-severity enum
	Error = 1
	Warning = 2
	Information = 3
	Hint = 4
== bool(a lsp-diagnostic-severity, b lsp-diagnostic-severity)
to nat32(a lsp-diagnostic-severity)
to lsp-diagnostic-severity?(a nat32)
to json(a lsp-diagnostic-severity)
	a.to::nat32 to
to lsp-diagnostic-severity(a json)
	a.to::nat32 to!

rename-params record
	| This appears in JSON as two separate properties
	text-document-and-position text-document-position-params
	newName string
to json(a rename-params)
to rename-params(a json)
	text-document-and-position: a to
	newName: a["newName"] to
reference-params record
	params text-document-position-params
to json(a reference-params)
	a.params to
document-highlight-params record
	params text-document-position-params
to json(a document-highlight-params)
	a.params to
| Result for a document highlight can also be {null-lsp-out-result} instead of this
document-highlight-result record
	uri uri
	highlights document-highlight[]
== bool(a document-highlight-result, b document-highlight-result)
to json(a document-highlight-result)
	a.highlights to # TODO: is 'uri' ever used then? ------------------------------------------------------------------------
document-highlight record(range line-and-character-range, kind document-highlight-kind)
== bool(a document-highlight, b document-highlight)
to json(a document-highlight)
document-highlight-kind enum
	Text = 1
	Read = 2
	Write = 3
== bool(a document-highlight-kind, b document-highlight-kind)
to nat32(a document-highlight-kind)
to json(a document-highlight-kind)
	a.to::nat32 to
semantic-tokens-params record(textDocument text-document-identifier)
to json(a semantic-tokens-params)
workspace-edit record(changes (uri, text-edit[])[])
== bool(a workspace-edit, b workspace-edit)
to json(a workspace-edit)
	changes json[symbol] = for uri, changes in a changes
		uri.to, changes.to
	changes: changes to
text-edit record(range line-and-character-range, newText string)
== bool(a text-edit, b text-edit) 
to json(a text-edit)
semantic-tokens record(data_ nat[])
== bool(a semantic-tokens, b semantic-tokens)
to json(a semantic-tokens)
	data: a.data_ to
signature-help-params record(text-document-and-position text-document-position-params)
to json(a signature-help-params)
signature-help record
	signatures signature-information[]
	activeSignature nat?
	activeParameter nat?
== bool(a signature-help, b signature-help) 
to json(a signature-help)
	res json =
		signatures: a.signatures to
		activeSignature: a.activeSignature to
		activeParameter: a.activeParameter to
	res omit-null
signature-information record
	label string
	documentation string
	parameters parameter-information[]
	activeParameter nat?
== bool(a signature-information, b signature-information)
to json(a signature-information)
	res json =
		label: a.label to
		documentation: a.documentation to
		parameters: a.parameters to
		activeParameter: a.activeParameter to
	res omit-null

-omit-null json(a json)
	try obj json[symbol] = a to catch deserialize-error _ then a
	obj.omit-null::json[symbol] to
-omit-null json[symbol](a json[symbol])
	a filter it.b != null

parameter-information record
	| This is a range of UTF-16 characters
	label nat range
	| Omitted if empty
	documentation string
== bool(a parameter-information, b parameter-information)
to json(a parameter-information)
	res json =
		label:
			- a.label.low to
			- a.label.high to
		documentation: unless a.documentation is-empty
			a.documentation to
	res omit-null

type-definition-params record(text-document-and-position text-document-position-params)
to json(a type-definition-params)
inlay-hint-params record(textDocument text-document-identifier, range line-and-character-range)
to json(a inlay-hint-params)
inlay-hint-result record(hints inlay-hint[])
new inlay-hint-result()
	(),
== bool(a inlay-hint-result, b inlay-hint-result)
to json(a inlay-hint-result)
	a.hints to
inlay-hint record
	position line-and-character
	label inlay-hint-label
	kind inlay-hint-kind?
	paddingLeft bool
== bool(a inlay-hint, b inlay-hint)
to json(a inlay-hint)
	res json =
		position: a.position to
		label: a.label to
		kind: a.kind to
		paddingLeft: a.paddingLeft to
	res omit-null
inlay-hint-kind enum
	Type = 1
	Parameter = 2
== bool(a inlay-hint-kind, b inlay-hint-kind)
to json(a inlay-hint-kind)
inlay-hint-label union(string, inlay-hint-label-part[])
	to json()
== bool(a inlay-hint-label, b inlay-hint-label)
inlay-hint-label-part record
	value string
	tooltip string?
	location location?
	command command?
== bool(a inlay-hint-label-part, b inlay-hint-label-part)
new inlay-hint-label-part(value string)
	value, (), (), ()
new inlay-hint-label-part(value string, tooltip string?)
	value, tooltip, (), ()
new inlay-hint-label-part(value string, location location?)
	value, (), location, ()
new inlay-hint-label-part(value string, command command?)
	value, (), (), command
to json(a inlay-hint-label-part)
	res json =
		value: a.value to
		tooltip: a.tooltip to
		location: a.location to
		command: a.command to
	res omit-null
folding-range-params record(textDocument text-document-identifier)
to json(a folding-range-params)
folding-range-result record(ranges folding-range[])
new folding-range-result()	
	(),
== bool(a folding-range-result, b folding-range-result)
to json(a folding-range-result)
	a.ranges to
folding-range record(startLine nat, endLine nat, kind folding-range-kind?)
== bool(a folding-range, b folding-range) 
to json(a folding-range)
	res json =
		startLine: a.startLine to
		endLine: a.endLine to
		kind: a.kind to
	res omit-null
folding-range-kind enum(comment, imports, region_)
== bool(a folding-range-kind, b folding-range-kind)
to symbol(a folding-range-kind)
	match a
	as comment
		"comment"
	as imports
		"imports"
	as region_
		"region"
to json(a folding-range-kind)
	a.to::symbol to

test
	# ensuring these count as used ------------------------------------------------------------------------------------------------------------------
	if false
		_ json = shutdown-params::lsp-in-request-params to
		_ json = exit-params::lsp-in-notification to
		_ build-js-script-result = null::json to
		_ syntax-translate-result = null::json to
		_ publish-diagnostics-params = null::json to
		_ text-document-content-change-event = "a",
