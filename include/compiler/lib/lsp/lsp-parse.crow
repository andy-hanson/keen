import
	./lsp-types
	../../model/source-range
	../../model/uri
	../../util/util

# TODO: most of this code should be 'to x(a json)' functions in lsp-types.crow
to lsp-in-message(message json)
	do unless has-key message, "result" else lsp-in-response
	request = of req lsp-in-request-params
		lsp-in-request message["id"].to, req
	params = message["params"]
	match message["method"].to::string
	as "$/cancelRequest"
		cancel-request-params params["id"].to
	as "$/setTrace"
		set-trace-params params["value"].to::trace-value
	as "custom/syntaxTranslate"
		request[params.to::syntax-translate-params]
	as "custom/build-js-script"
		request[params.to::build-js-script-params]
	as "custom/perf-report"
		request[perf-report-params]
	as exit
		exit-params
	as initialize
		request[params.to::initialize-params]
	as initialized
		initialized-params
	as shutdown
		request[shutdown-params]
	as "textDocument/codeLens"
		request[code-lens-params parse-text-document-identifier params["textDocument"]]
	as "textDocument/completion"
		request[completion-params parse-text-document-position-params params]
	as "textDocument/definition"
		request[definition-params parse-text-document-position-params params]
	as "textDocument/didChange"
		parse-did-change-text-document-params params
	as "textDocument/didClose"
		did-close-text-document-params
	as "textDocument/didOpen"
		did-open-text-document-params parse-text-document-item params["textDocument"]
	as "textDocument/didSave"
		did-save-text-document-params parse-text-document-identifier params["textDocument"]
	as "textDocument/documentHighlight"
		request[document-highlight-params parse-text-document-position-params params]
	as "textDocument/foldingRange"
		request[folding-range-params parse-text-document-identifier params["textDocument"]]
	as "textDocument/hover"
		request[hover-params parse-text-document-position-params params]
	as "textDocument/implementation"
		request[implementation-params parse-text-document-position-params params]
	as "textDocument/inlayHint"
		request[parse-inlay-hint-params params]
	as "textDocument/references"
		request[reference-params parse-text-document-position-params params]
	as "textDocument/rename"
		request[params.to::rename-params]
	as "textDocument/semanticTokens/full"
		request[semantic-tokens-params parse-text-document-identifier params["textDocument"]]
	as "textDocument/signatureHelp"
		request[signature-help-params parse-text-document-position-params params]
	as "textDocument/typeDefinition"
		request[type-definition-params parse-text-document-position-params params]
	as "workspace/executeCommand"
		request[parse-execute-command-params params]
	else
		throw unreachable

-parse-did-change-text-document-params did-change-text-document-params(a json)
	textDocument: parse-text-document-identifier a["textDocument"]
	contentChanges: map a["contentChanges"].to::json[], it.parse-text-document-content-change-event

-parse-text-document-item text-document-item(a json)
	uri: parse-uri-property a
	text: parse-text-property a

-parse-text-property string(a json)
	a["text"].to

-parse-text-document-position-params text-document-position-params(a json)
	textDocument: parse-text-document-identifier a["textDocument"]
	position: parse-line-and-character a["position"]

-parse-inlay-hint-params inlay-hint-params(a json)
	textDocument: parse-text-document-identifier a["textDocument"]
	range: parse-line-and-character-range a["range"]

-parse-text-document-identifier text-document-identifier(a json)
	uri: parse-uri-property a

-parse-uri-property uri(a json)
	a["uri"].to

-parse-text-document-content-change-event text-document-content-change-event(a json)
	range = a["range"]
	range: unless range == null then parse-line-and-character-range range
	text: parse-text-property a

-parse-line-and-character-range line-and-character-range(a json)
	a["start"].parse-line-and-character, a["end"].parse-line-and-character

-parse-line-and-character line-and-character(a json)
	a["line"].to, a["character"].to

-parse-execute-command-params execute-command-params(params json)
	arguments json[] = params["arguments"].to
	match params["command"].to::string
	as run-test
		where: arguments.only!.to
	else
		throw unreachable
