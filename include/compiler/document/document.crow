import
	crow/parse
	../frontend/show-model
	../model/ast
	../model/model
	../model/source-range
	../model/uri
	../util/parse-util

document-modules json(_ program, _ show-model-ctx, _ uri[])
	throw todo

doc-comment-string string(file-contents file-content-getters, uri uri, a doc-comment)
	if a is-empty
		""
	else
		file-contents[uri, a.ast.range!] strip-doc-comment
strip-doc-comment string(a char8 array-view)
	ptr string-mut-iterator = a.to::char8[].to,
	res char8[] = with out in build
		until ptr is-at-end
			while ptr.peek8 is-whitespace-or-bar
				_ = ptr take-char8
			while ptr !is-at-end and ptr.peek8 != "\n"
				out ~= ptr take-char8
			while ptr try-take "\n"
				out ~= "\n"
	res to
-is-whitespace-or-bar bool(a char8)
	a is-whitespace or a == "|"
