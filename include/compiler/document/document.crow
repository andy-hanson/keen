import
	../frontend/show-model
	../model/ast
	../model/model
	../model/source-range
	../model/uri
	../util/string-walker

document-modules json(_ program, _ show-model-ctx, _ uri[])
	throw todo

doc-comment-string string(file-contents file-content-getters, uri uri, a doc-comment)
	if a is-empty
		""
	else
		file-contents[uri, a.ast.range!] strip-doc-comment
strip-doc-comment string(a char8 array-view)
	ptr string-walker = a.to,
	res char8[] = with out : build
		until ptr is-at-end
			while *ptr is-whitespace-or-bar
				ptr advance
			while ptr !is-at-end && *ptr != "\n"
				out ~= ptr take-char
			while ptr try-take-char "\n"
				out ~= "\n"
	res to
-is-whitespace-or-bar bool(a char8)
	a is-whitespace || a == "|"
