import
	../../model/concrete-model
	../../model/model
	../../model/uri
	./class-builder
	./class-code-builder
	./java-names
	./union-representation
	./util

| Can generate a constant pool reference for a Crow entity.
| This should only be used within the same class file,
| since constant pool references are not the same in different files.
java-refs record mut
	-mangled-names java-names
	constants constants-builder
start-new-class java-refs(mangled-names java-names)
	mangled-names, ()

build-code build-code(a java-refs)
	a.constants build-code
finish cp_info[](a java-refs)
	a.constants finish

union-info union-info(a java-refs)
	a.mangled-names union-info

constant-name utf8-reference(a java-refs, constant any-constant)
	a.constants[a.mangled-names.constant-names[constant] member]

constant-symbols-class-name symbol()
	"_constant_symbols"
constant-symbols-class class-reference(a java-refs)
	a.constants class_ "_constant_symbols"
constant-symbol-name utf8-reference(a java-refs, index nat)
	a.constants["s{index}"]

constant-symbol-field field-reference(a java-refs, symbol concrete-type, index nat)
	symbol-type = a.constants[a.mangled-names descriptor-for-field-type symbol]
	name-and-type = a.constants name-and-type (a constant-symbol-name index), symbol-type
	a.constants field a.constant-symbols-class, name-and-type

module-class class-reference(a java-refs, uri uri)
	a.constants class_ do a.mangled-names module-class-name uri
module-class-name symbol(a java-refs, uri uri)
	a.mangled-names module-class-name uri

lambda-impl-class-name symbol(a java-refs, containing-fun concrete-fun, lambda-index nat)
	a.mangled-names lambda-impl-class-name containing-fun, lambda-index

# Static "instance" field on a singleton class
instance-field field-reference(a java-refs, type concrete-type)
	a instance-field (a class_ type), do a.mangled-names boxed-class-name type
instance-field field-reference(a java-refs, class_ class-reference, class-name symbol)
	a instance-field class_, do a instance-field-descriptor class-name
-instance-field field-reference(a java-refs, class_ class-reference, descriptor utf8-reference)
	a.constants field class_, do a.constants name-and-type a.instance-field-name, descriptor
instance-field-name utf8-reference(a java-refs)
	a.constants["instance"]
instance-field-descriptor utf8-reference(a java-refs, class-name symbol)
	a.constants["L{class-name};"]

lambda-impl-field field-reference
	a java-refs
	lambda-class class-reference
	closure-local concrete-local
do
	name-and-type = a.constants name-and-type (a lambda-impl-field-name closure-local), do
		a descriptor-for-field-type closure-local.type
	a.constants field lambda-class, name-and-type

lambda-impl-field-name utf8-reference(a java-refs, closure-field concrete-local)
	match closure-field source
	as local x
		a.constants[x name]
	as concrete-local-source-reference x
		a.constants[x.original name]
	as concrete-generated-local-kind _
		throw unreachable

switchable-kind-field field-reference(a java-refs, union-type concrete-type)
	a.union-info union-representation union-type is switch
	a switchable-kind-field do a class_ union-type
switchable-kind-field field-reference(a java-refs, sum-type class-reference)
	a.constants field sum-type, do a.constants name-and-type a.switchable-kind-name, a.switchable-kind-descriptor
switchable-kind-name utf8-reference(a java-refs)
	a.constants["kind"]
switchable-kind-descriptor utf8-reference(a java-refs)
	a.constants["I"]
switchable-value-field field-reference(a java-refs, sum-type concrete-type)
	a.union-info union-representation sum-type is switch
	a switchable-value-field do a class_ sum-type
switchable-value-field field-reference(a java-refs, sum-type class-reference)
	a.constants field sum-type, do a.constants name-and-type a.value, a.java-Object-descriptor

class_ class-reference(a java-refs, type concrete-type)
	a.constants class_ do a.mangled-names boxed-class-name type	
class-name symbol(a java-refs, type concrete-type)
	a.mangled-names[type]

case-index-method method-reference(a java-refs, union-type concrete-type)
	a.constants interface-method-ref (a class_ union-type), do
		a.constants name-and-type (a case-index-method-name union-type), a.case-index-method-descriptor

case-index-method-descriptor utf8-reference(a java-refs)
	a.constants["()I"]

case-index-method-name utf8-reference(a java-refs, sum-type concrete-type)
	a.constants["{a.mangled-names[sum-type]}_index"]

crow-reference-equal method-reference(a java-refs)
	a crow-method "referenceEqual", "(Ljava/lang/Object;Ljava/lang/Object;)Z"

extern-instance-method method-reference
	a java-refs
	method-name symbol
	return-type concrete-type
	object-type concrete-type
	param-types concrete-type[]
do
	descriptor string = with out : build
		out ~= "("
		for x : param-types
			out ~~= a.mangled-names descriptor-for-param-type x
		out ~= ")"
		out ~~= a.mangled-names descriptor-for-return-type return-type
	a.constants method-ref (a class_ object-type), method-name, descriptor.to

extern-constructor method-reference(a java-refs, class_ class-reference, param-types concrete-type[])
	descriptor string = with out : build
		out ~= "("
		for x : param-types
			out ~~= a.mangled-names descriptor-for-param-type x
		out ~~= ")V"
	a.constants method-ref class_, do a.constants name-and-type "<init>", descriptor.to

valueOf utf8-reference(a java-refs)
	a.constants["valueOf"]
boxed-class-valueOf-descriptor utf8-reference(a java-refs, type concrete-type)
	param = a.mangled-names descriptor-for-param-type type
	return = a.mangled-names boxed-class-name type
	a.constants["({param})L{return};"]
boxed-class-valueOf method-reference(a java-refs, type concrete-type)
	a.constants method-ref (a class_ type), a.constants["valueOf"], do a boxed-class-valueOf-descriptor type
primitive-unboxer method-reference(a java-refs, type concrete-type, p java-primitive-type)
	a.constants method-ref (a class_ type), (a primitive-getter-name p), (a primitive-getter-descriptor p)
primitive-getter-name utf8-reference(a java-refs, type java-primitive-type)
	name symbol = match type
	as T_BOOLEAN
		"booleanValue"
	as T_CHAR
		throw todo
	as T_FLOAT
		"floatValue"
	as T_DOUBLE
		"doubleValue"
	as T_BYTE
		"byteValue"
	as T_SHORT
		"shortValue"
	as T_INT
		"intValue"
	as T_LONG
		"longValue"
	a.constants[name]
primitive-getter-descriptor utf8-reference(a java-refs, type java-primitive-type)
	a.constants["(){type primitive-descriptor}"]

array-copy method-reference(a java-refs)
	a.constants method-ref "java/lang/System", "arraycopy", "(Ljava/lang/Object;ILjava/lang/Object;II)V"

extern-static-method method-reference
	a java-refs
	class-name symbol
	method-name symbol
	return-type concrete-type
	param-types concrete-type[]
do
	descriptor string = if class-name == "java/lang/System" && method-name == "arraycopy"
		# HAX: In this case we need to specify the type as Object and not an array type. A Java compiler would do this upcast implicitly.
		"(Ljava/lang/Object;ILjava/lang/Object;II)V"
	else
		# TODO: java-names should handle this ------------------------------------------------------------------------------------
		with out : build
			out ~= "("
			for x : param-types
				out ~~= a.mangled-names descriptor-for-param-type x
			out ~= ")"
			out ~~= a.mangled-names descriptor-for-return-type return-type
	a.constants method-ref class-name, method-name, descriptor.to

interface-method-ref method-reference(a java-refs, fun concrete-fun)
	a.union-info java-method-kind fun is interface_
	class_ = a class_ fun.params[0].type
	a.constants interface-method-ref class_, do a.constants name-and-type (a instance-method-name fun), (a instance-method-descriptor fun)

virtual-method-ref method-reference(a java-refs, fun concrete-fun)
	a.union-info java-method-kind fun is virtual
	class_ = a class_ fun.params[0].type
	a.constants method-ref class_, do a.constants name-and-type (a instance-method-name fun), (a instance-method-descriptor fun)

instance-method-name utf8-reference(a java-refs, fun concrete-fun)
	a.constants[a.mangled-names instance-method-name fun]

fun-name utf8-reference(a java-refs, fun concrete-fun)
	a.constants[a.mangled-names[fun] member]
static-method-ref method-reference(a java-refs, fun concrete-fun) # TODO: this whole thing should be cached -------------------
	a.union-info java-method-kind fun is static
	m = a.mangled-names[fun]
	a.constants method-ref (a.constants class_  m.class_), a.constants[m.member], do a static-method-descriptor fun
static-method-descriptor utf8-reference(a java-refs, fun concrete-fun)
	a.constants[a.mangled-names static-method-descriptor fun]

constructor-method-ref method-reference(a java-refs, fun concrete-fun)
	a.union-info java-method-kind fun is constructor
	m = a.mangled-names[fun]
	a.constants method-ref (a.constants class_ m.class_), a.init, do a constructor-descriptor fun

instance-method-descriptor utf8-reference(a java-refs, fun concrete-fun)
	assert a.union-info java-method-kind fun is-instance
	a.constants[a.mangled-names instance-method-descriptor fun]

constructor-descriptor utf8-reference(a java-refs, fun concrete-fun)
	a.union-info java-method-kind fun is constructor
	a.constants[a.mangled-names constructor-descriptor fun]

boxed-class-init method-reference(a java-refs, type concrete-type)
	a.constants method-ref (a class_ type), a.init, do a boxed-class-init-descriptor type
boxed-class-init-descriptor utf8-reference(a java-refs, type concrete-type)
	a.constants["({a.mangled-names descriptor-for-param-type type})V"]
boxed-class-value field-reference(a java-refs, type concrete-type)
	a.constants field (a class_ type), do a.constants name-and-type a.constants["value"], do a descriptor-for-field-type type

record-init-descriptor utf8-reference(a java-refs, fields concrete-field[])
	a.constants[a.mangled-names record-init-descriptor fields]
-record-init-descriptor symbol(a java-names, fields concrete-field[])
	res string = with out : build
		out ~= "("
		for field : fields
			out ~~= a descriptor-for-param-type field.type
		out ~~= ")V"
	res to

record-init-reference method-reference(a java-refs, record_ concrete-type)
	descriptor = a record-init-descriptor record_.body.concrete-record!.fields
	name-and-type = a.constants name-and-type a.constants["<init>"], descriptor
	a.constants method-ref (a class_ record_), name-and-type

record-field field-reference(a java-refs, record_ concrete-type, field concrete-field)
	a field (a.mangled-names[record_], field.debug-name), field.type
record-field-name utf8-reference(a java-refs, field concrete-field)
	a.constants[field debug-name]
record-field-descriptor utf8-reference(a java-refs, field concrete-field)
	a descriptor-for-field-type field.type

lambda-init-reference method-reference(a java-refs, class_ class-reference, lambda lambda-concrete-expr)
	a.constants method-ref class_, a.constants["<init>"], do a lambda-init-descriptor lambda
lambda-init-descriptor utf8-reference(a java-refs, lambda lambda-concrete-expr)
	a.constants[a.mangled-names lambda-init-descriptor lambda]

lambda-call method-reference(a java-refs, lambda-type concrete-type)
	lambda-class = a class_ lambda-type
	a.constants method-ref lambda-class, a.run, do a lambda-call-descriptor lambda-type
lambda-call-descriptor utf8-reference(a java-refs, lambda-type concrete-type)
	a.constants[a.mangled-names lambda-call-descriptor lambda-type]

descriptor-for-field-type utf8-reference(a java-refs, type concrete-type)
	a.constants[a.mangled-names descriptor-for-field-type type]

primitive-descriptor utf8-reference(a java-refs, type java-primitive-type)
	a.constants[type primitive-descriptor]

-crow-method method-reference(a java-refs, (name symbol, descriptor symbol))
	a crow-method name, descriptor
-crow-method method-reference(a java-refs, name symbol, descriptor symbol)
	a.constants method-ref "Crow", name, descriptor

crow-equal-float method-reference(a java-refs, type float-type)
	a crow-method match type
	as float32
		"equalFloat32", "(FF)Z"
	as float64
		"equalFloat64", "(DD)Z"
crow-equal-float-ieee method-reference(a java-refs, type float-type)
	a crow-method match type
	as float32
		"equalFloat32IEEE", "(FF)Z"
	as float64
		"equalFloat64IEEE", "(DD)Z"
crow-equal-integral method-reference(a java-refs, type integral-type)
	a crow-method match type to-signed
	as int8
		"equalInt8", "(BB)Z"
	as int16
		"equalInt16", "(SS)Z"
	as int32
		"equalInt32", "(II)Z"
	as int64
		"equalInt64", "(JJ)Z"
crow-less-float-ieee method-reference(a java-refs, type float-type)
	a crow-method match type
	as float32
		"lessFloat32IEEE", "(FF)Z"
	as float64
		"lessFloat64IEEE", "(DD)Z"
crow-less-integral method-reference(a java-refs, type integral-type)
	a crow-method match type
	as int8
		"lessInt8", "(BB)Z"
	as int16
		"lessInt16", "(SS)Z"
	as int32
		"lessInt32", "(II)Z"
	as int64
		"lessInt64", "(JJ)Z"
	as nat8
		"lessNat8", "(BB)Z"
	as nat16
		"lessNat16", "(SS)Z"
	as nat32
		"lessNat32", "(II)Z"
	as nat64
		"lessNat64", "(JJ)Z"

java-Error class-reference(a java-refs)
	a.constants class_ "java/lang/Error"
java-Runnable class-reference(a java-refs)
	a.constants class_ "java/lang/Runnable"

crow-fits-in-nat32 method-reference(a java-refs)
	a crow-method "fitsInNat32", "(J)Z"
crow-fits-in-int32 method-reference(a java-refs)
	a crow-method "fitsInInt32", "(J)Z"	
crow-float64FromNat64 method-reference(a java-refs)
	a crow-method "float64FromNat64", "(J)D"
crow-assert-non-null method-reference(a java-refs)
	a crow-method "assertNonNull", "(Ljava/lang/Object;)V"
crow-one-if-not-null method-reference(a java-refs)
	a crow-method "oneIfNotNull", "(Ljava/lang/Object;)L"
crow-nat32-from-nat64 method-reference(a java-refs)
	a crow-method "nat32FromNat64", "(J)I"
crow-string-array-from-java-string-array method-reference(a java-refs)
	a crow-method "stringArrayFromJavaStringArray", "([Ljava/lang/String;)[[B"
crow-weakRefGet method-reference(a java-refs)
	a crow-method "weakRefGet", "(Ljava/lang/ref/WeakReference;)Ljava/lang/Object;"
crow-newWeakRef method-reference(a java-refs)
	a crow-method "newWeakRef", "(Ljava/lang/Object;)Ljava/lang/ref/WeakReference;"
java-divideUnsigned method-reference(a java-refs, type signed-integral-type)
	match type
	as int8
		a.constants method-ref "java/lang/Byte", "divideUnsigned", "(BB)B"
	as int16
		a.constants method-ref "java/lang/Short", "divideUnsigned", "(SS)S"
	as int32
		a.constants method-ref "java/lang/Integer", "divideUnsigned", "(II)I"
	as int64
		a.constants method-ref "java/lang/Long", "divideUnsigned", "(JJ)J"
java-remainderUnsigned method-reference(a java-refs, type signed-integral-type)
	match type
	as int8
		throw todo
	as int16
		throw todo
	as int32
		throw todo
	else
		a.constants method-ref "java/lang/Long", "remainderUnsigned", "(JJ)J"
java-Class-getResourceAsStream method-reference(a java-refs)
	a.constants method-ref "java/lang/Class", "getResourceAsStream", "(Ljava/lang/String;)Ljava/io/InputStream;"
java-doubleToRawLongBits method-reference(a java-refs)
	a.constants method-ref "java/lang/Double", "doubleToRawLongBits", "(D)J"
java-floatToRawIntBits method-reference(a java-refs)
	a.constants method-ref "java/lang/Float", "floatToRawIntBits", "(F)I"
java-InputStream-readAllBytes method-reference(a java-refs)
	a.constants method-ref "java/io/InputStream", "readAllBytes", "()[B"
java-intBitsToFloat method-reference(a java-refs)
	a.constants method-ref "java/lang/Float", "intBitsToFloat", "(I)F"
java-longBitsToDouble method-reference(a java-refs)
	a.constants method-ref "java/lang/Double", "longBitsToDouble", "(J)D"
java-Object class-reference(a java-refs)
	a.constants class_ "java/lang/Object"
java-Object-descriptor utf8-reference(a java-refs)
	a.constants["Ljava/lang/Object;"]
java-String class-reference(a java-refs)
	a.constants class_ "java/lang/String"
java-String-init-from-bytes method-reference(a java-refs)
	a.constants method-ref "java/lang/String", "<init>", "([B)V"
java-String-getBytes method-reference(a java-refs)
	a.constants method-ref "java/lang/String", "getBytes", "()[B"
java-System-exit method-reference(a java-refs)
	a.constants method-ref "java/lang/System", "exit", "(I)V"
java-Throwable class-reference(a java-refs)
	a.constants class_ "java/lang/Throwable"
java-Void-TYPE field-reference(a java-refs)
	a.constants field "java/lang/Void", "TYPE", "Ljava/lang/Class;"
java-primitive-TYPE field-reference(a java-refs, type concrete-type)
	assert _ ?= type.as-runtime-type java-primitive-type
	a.constants field (a class_ type), do a.constants name-and-type "TYPE", "Ljava/lang/Class;"
toString utf8-reference(a java-refs)
	a.constants["toString"]

SourceFile utf8-reference(a java-refs)
	a.constants["SourceFile"]

init-no-args method-reference(a java-refs, class_ class-reference)
	a.constants method-ref class_, a.init, a.init-no-args-descriptor
init utf8-reference(a java-refs)
	a.constants["<init>"]
clinit utf8-reference(a java-refs)
	a.constants["<clinit>"]
run utf8-reference(a java-refs)
	a.constants["run"]
init-no-args-descriptor utf8-reference(a java-refs)
	a.constants["()V"]
init-union-switch method-reference(a java-refs, class_ class-reference)
	a.constants method-ref class_, a.init, a.init-union-switch-descriptor
init-union-switch-descriptor utf8-reference(a java-refs)
	a.constants["(ILjava/lang/Object;)V"]

value utf8-reference(a java-refs)
	a.constants["value"]

constant-field field-reference(a java-refs, constant any-constant)
	a field a.mangled-names.constant-names[constant], constant.type
constant-array-field field-reference(a java-refs, type concrete-type, value constant-array)
	a field a.mangled-names.constant-names.arrays[type]![value index]!, type
constant-record-field field-reference(a java-refs, type concrete-type, value constant-record)
	a field a.mangled-names.constant-names.records[type]![value]!, type

var-field field-reference(a java-refs, var concrete-var)
	a field a.mangled-names[var], var.type
var-name utf8-reference(a java-refs, var concrete-var)
	a.constants[a.mangled-names[var] member]

field field-reference(a java-refs, name class-and-member, type concrete-type) # TODO: should be private ----------------------
	typedesc = a descriptor-for-field-type type
	name-and-type = a.constants name-and-type a.constants[name.member], typedesc
	class_ = a.constants class_ name.class_
	a.constants field class_, name-and-type
