-translate-builtin-binary java-expr-or-block-statement(ctx to-java-ctx, type concrete-struct, a builtin-binary, (arg0 java-expr, arg1 java-expr))
	cast java-expr mut(arg java-expr) = arg =>
		ctx as-type type java-cast arg
	binary java-expr data(kind java-binary-kind) = kind =>
		kind java-binary arg0, arg1
	static java-expr data(name string) = name =>
		name java-call-static-method (arg0, arg1)
	compare-less java-expr data(name string) = name =>
		comparison = name java-call-static-method (arg0, arg1)
		less java-binary comparison, zero
	match a
	as add-float32
		binary[plus] to
	as add-float64
		binary[plus] to
	as add-pointer-and-nat64
		throw unreachable
	as bitwise-and-int8
		cast[binary[bitwise-and]] to
	as bitwise-and-int16
		cast[binary[bitwise-and]] to
	as bitwise-and-int32
		binary[bitwise-and] to
	as bitwise-and-int64
		binary[bitwise-and] to
	as bitwise-and-nat8
		cast[binary[bitwise-and]] to
	as bitwise-and-nat16
		cast[binary[bitwise-and]] to
	as bitwise-and-nat32
		binary[bitwise-and] to
	as bitwise-and-nat64
		binary[bitwise-and] to
	as bitwise-or-int8
		cast[binary[bitwise-or]] to
	as bitwise-or-int16
		cast[binary[bitwise-or]] to
	as bitwise-or-int32
		binary[bitwise-or] to
	as bitwise-or-int64
		binary[bitwise-or] to
	as bitwise-or-nat8
		cast[binary[bitwise-or]] to
	as bitwise-or-nat16
		cast[binary[bitwise-or]] to
	as bitwise-or-nat32
		binary[bitwise-or] to
	as bitwise-or-nat64
		binary[bitwise-or] to
	as bitwise-xor-int8
		cast[binary[bitwise-xor]] to
	as bitwise-xor-int16
		cast[binary[bitwise-xor]] to
	as bitwise-xor-int32
		binary[bitwise-xor] to
	as bitwise-xor-int64
		binary[bitwise-xor] to
	as bitwise-xor-nat8
		cast[binary[bitwise-xor]] to
	as bitwise-xor-nat16
		cast[binary[bitwise-xor]] to
	as bitwise-xor-nat32
		binary[bitwise-xor] to
	as bitwise-xor-nat64
		binary[bitwise-xor] to
	as equal-char8
		binary[eq-eq] to
	as equal-char32
		binary[eq-eq] to
	as equal-float32
		binary[eq-eq] to
	as equal-float64
		binary[eq-eq] to
	as equal-int8
		binary[eq-eq] to
	as equal-int16
		binary[eq-eq] to
	as equal-int32
		binary[eq-eq] to
	as equal-int64
		binary[eq-eq] to
	as equal-nat8
		binary[eq-eq] to
	as equal-nat16
		binary[eq-eq] to
	as equal-nat32
		binary[eq-eq] to
	as equal-nat64
		binary[eq-eq] to
	as equal-pointer
		throw unreachable
	as less-char8
		binary[less] to
	as less-float32
		binary[less] to
	as less-float64
		binary[less] to
	as less-int8
		binary[less] to
	as less-int16
		binary[less] to
	as less-int32
		binary[less] to
	as less-int64
		binary[less] to
	as less-nat8
		compare-less["java.lang.Byte.compareUnsigned"] to
	as less-nat16
		compare-less["java.lang.Short.compareUnsigned"] to
	as less-nat32
		compare-less["java.lang.Integer.compareUnsigned"] to
	as less-nat64
		compare-less["java.lang.Long.compareUnsigned"] to
	as less-pointer
		throw unreachable
	as mul-float32
		binary[times] to
	as mul-float64
		binary[times] to
	as new-array
		throw unreachable
	as reference-equal
		binary[eq-eq] to
	as seq
		throw unreachable
	as sub-float32
		binary[minus] to
	as sub-float64
		binary[minus] to
	as sub-pointer-and-nat64
		throw unreachable
	as switch-fiber
		throw unreachable
	as unsafe-add-int8
		cast[binary[plus]] to
	as unsafe-add-int16
		cast[binary[plus]] to
	as unsafe-add-int32
		binary[plus] to
	as unsafe-add-int64
		binary[plus] to
	as unsafe-add-nat8
		cast[binary[plus]] to
	as unsafe-add-nat16
		cast[binary[plus]] to
	as unsafe-add-nat32
		binary[plus] to
	as unsafe-add-nat64
		binary[plus] to
	as unsafe-bit-shift-left-nat64
		binary[bit-shift-left] to
	as unsafe-bit-shift-right-nat64
		binary[bit-shift-right] to
	as unsafe-div-float32
		binary[divide] to
	as unsafe-div-float64
		binary[divide] to
	as unsafe-div-int8
		cast[binary[divide]] to
	as unsafe-div-int16
		cast[binary[divide]] to
	as unsafe-div-int32
		binary[divide] to
	as unsafe-div-int64
		binary[divide] to
	as unsafe-div-nat8
		static["java.lang.Byte.divideUnsigned"] to
	as unsafe-div-nat16
		static["java.lang.Short.divideUnsigned"] to
	as unsafe-div-nat32
		static["java.lang.Integer.divideUnsigned"] to
	as unsafe-div-nat64
		static["java.lang.Long.divideUnsigned"] to
	as unsafe-mod-nat64
		static["java.lang.Long.remainderUnsigned"] to
	as unsafe-mul-int8
		cast[binary[times]] to
	as unsafe-mul-int16
		cast[binary[times]] to
	as unsafe-mul-int32
		binary[times] to
	as unsafe-mul-int64
		binary[times] to
	as unsafe-mul-nat8
		cast[binary[times]] to
	as unsafe-mul-nat16
		cast[binary[times]] to
	as unsafe-mul-nat32
		binary[times] to
	as unsafe-mul-nat64
		binary[times] to
	as unsafe-sub-int8
		cast[binary[minus]] to
	as unsafe-sub-int16
		cast[binary[minus]] to
	as unsafe-sub-int32
		binary[minus] to
	as unsafe-sub-int64
		binary[minus] to
	as unsafe-sub-nat8
		cast[binary[minus]] to
	as unsafe-sub-nat16
		cast[binary[minus]] to
	as unsafe-sub-nat32
		binary[minus] to
	as unsafe-sub-nat64
		binary[minus] to
	as wrap-add-nat8
		cast[binary[plus]] to
	as wrap-add-nat16
		cast[binary[plus]] to
	as wrap-add-nat32
		binary[plus] to
	as wrap-add-nat64
		binary[plus] to
	as wrap-mul-nat8
		cast[binary[times]] to
	as wrap-mul-nat16
		cast[binary[times]] to
	as wrap-mul-nat32
		binary[times] to
	as wrap-mul-nat64
		binary[times] to
	as wrap-sub-nat8
		cast[binary[minus]] to
	as wrap-sub-nat16
		cast[binary[minus]] to
	as wrap-sub-nat32
		binary[minus] to
	as wrap-sub-nat64
		binary[minus] to
	as write-to-pointer
		throw unreachable

-translate-builtin-binary-math java-expr-or-block-statement(
	a builtin-binary-math,
	(arg0 java-expr, arg1 java-expr),
)
	match a
	as atan2-float32
		"float".to java-cast ("Math.atan2" java-call-static-method (arg0, arg1)) to
	as atan2-float64
		"Math.atan2" java-call-static-method (arg0, arg1) to
	as fmod-float32
		modulo java-binary arg0, arg1 to
	as fmod-float64
		modulo java-binary arg0, arg1 to
	as unsafe-pow-float32
		"Math.pow" java-call-static-method (arg0, arg1) to
	as unsafe-pow-float64
		"Math.pow" java-call-static-method (arg0, arg1) to
