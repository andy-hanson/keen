import
	../../frontend/show-model
	../../model/concrete-model
	../../model/integral-values
	../../model/model
	../../model/show-low-model
	../../model/uri
	../../model/version-info
	../../util/full-index-map
	../../util/util
	../mangle
	./java-ast
	./mangle-for-java
	./write-java-ast

# Output is a map from file name to text
translate-to-java (string, string)[](
	program program,
	concrete-program concrete-program,
	show-ctx show-type-ctx,
)
	ctx to-java-ctx = do
		model-program: program
		program: concrete-program
		show-ctx: show-ctx
		funs-lookup: concrete-program.funs-lookup
		mangled-names: concrete-program build-mangled-names
		structs-for-integrals: concrete-program.get-structs-for-integrals
		constant-names: ()

	classes java-type-decl[] = with out : build
		for x : ctx translate-constants
			out ~= x to
		for struct : concrete-program all-structs
			out ~~= ctx translate-struct struct
		for x : ctx translate-functions-and-vars concrete-program
			out ~= x to
		main-class java-class = do
			comment: ""
			kind: final
			name: "Main"
			extends: ()
			implements: ()
			fields: ()
			constructor: ()
			methods: (ctx.call-main,)
		out ~= main-class to
	classes write-java-ast

# Since having all constants in one class would be too big, put the constants with their struct
-translate-constants java-class[](ctx to-java-ctx)
	constant-array-names class-and-member mut[nat] mut[concrete-struct-id] = ()
	constant-record-names class-and-member mut[constant-record] mut[concrete-struct-id] = ()
	constant-union-names class-and-member mut[constant-union] mut[concrete-struct-id] = ()

	cur-class-index mut nat = 0
	cur-class-name mut string = "constants{cur-class-index}"
	field-index mut nat = 0
	ctx.show-ctx.show each-constant-in-dependency-order ctx.program, constant =>
		if field-index >= max-constants-per-class
			cur-class-index +:= 1
			cur-class-name := "constants{cur-class-index}"
			field-index := 0
		class-and-member class-and-member = cur-class-name, "x{field-index}"
		field-index +:= 1
		match constant
		as single-constant-array x
			(constant-array-names ensure constant.type.id)[x index] := class-and-member
		as single-constant-record x
			(constant-record-names ensure constant.type.id)[x constant] := class-and-member
		as single-constant-union x
			(constant-union-names ensure constant.type.id)[x constant] := class-and-member

	ctx.constant-names := do
		arrays: for k, v : constant-array-names
			k, v.move-to
		records: for k, v : constant-record-names
			k, v.move-to
		unions: for k, v : constant-union-names
			k, v.move-to
	
	fields-per-class java-field mut[] mut[string] = ()
	ctx.show-ctx.show each-constant-in-dependency-order ctx.program, constant =>
		name class-and-member, value java-expr = match constant
		as single-constant-array x
			java-element-type = ctx as-type x.element-type
			v = java-element-type java-literal-array for e : x.elements
				ctx translate-constant-reference x.element-type.struct, e
			ctx.constant-names.arrays[constant.type id]![x index]!, v
		as single-constant-record x
			# TODO: I'm also generating '.instance' members for empty records, so don't redundantly generate those here -----------------------
			v = ctx as-class x.record-type java-new for arg, field : x.args zip x.fields
				ctx translate-constant-reference field.type.struct, arg
			ctx.constant-names.records[constant.type id]![x constant]!, v
		as single-constant-union x
			case-type = x.member-type
			value = ctx translate-constant-reference x.member-type, x.value.member
			boxed-value = ctx box case-type, value
			v = match ctx union-representation x.union-type
			as direct
				ctx as-type x.union-type java-cast boxed-value
			as switch
				"Union" java-new (x.value.member-index.to.java-literal-int32-or-less, boxed-value)
			as nullable
				match x.value member-index
				as 0
					java-null
				as 1
					boxed-value
				else
					throw unreachable
			ctx.constant-names.unions[constant.type id]![x constant]!, v
		fields-per-class ensure name.class_ ~= do
			visibility: internal
			kind: static
			field-kind: final
			type: ctx as-type constant.type
			name: name member
			initializer: value,

	for class-name, fields : fields-per-class
		"", final, class-name, (), (), fields.move-to, (), ()

# TODO: this may be simpler (and faster) as a single dictionary class-ane-member[nat][concrete-struct-id ----------------------------------------
-constant-names record
	arrays class-and-member[nat][concrete-struct-id]
	records class-and-member[constant-record][concrete-struct-id]
	unions class-and-member[constant-union][concrete-struct-id] # TODO: could this be a full-index-map? ---------------------
-new constant-names()
	(), (), ()

-max-constants-per-class nat()
	# Java allows 65535 constants, but large arrays include many individual constants, so use this as a limit that seems to work
	32

# TODO: MOVE, will need this for the JS build too ------------------------------------------------------------------------------
-each-constant-in-dependency-order void(show-ctx show-ctx, program concrete-program, emit void mut(x any-constant))
	# TODO:PERF this could use a full-index-set -----------------------------------------------------------------------------
	seen-arrays (concrete-struct-id, nat) mut-set = ()
	seen-records (concrete-struct-id, constant-record) mut-set = ()
	seen-unions (concrete-struct-id, constant-union) mut-set = ()
	can-reference bool mut(type concrete-struct, c constant) = (type, c) =>
		match c
		as constant-array x
			# TODO: We should stop storing strings as arrays!
			type is-string || type is-symbol || (type.id, x.index) in seen-arrays
		as constant-c-string _
			true
		as constant-float _
			true
		as constant-fun-pointer _
			true
		as integral-value _
			true
		as constant-record x
			(type.id, x) in seen-records
		as constant-union x
			(type.id, x) in seen-unions
		as constant-gc-safe-value
			true
		as constant-null
			true

	all-constants = program all-constants
	did-something mut bool = true
	while did-something
		did-something := false
		for arr : all-constants arrs
			for array-id, xs : arr.constants with-index
				key = arr.arr-type.id, array-id
				guard key !in seen-arrays
				guard xs every x => can-reference[arr.element-type.struct, x]
				seen-arrays ~= key
				emit[arr.arr-type single-constant-array arr.element-type, array-id, xs]
				did-something := true
		for struct-id, map : all-constants records
			for constant, args : map
				key = struct-id, constant
				guard key !in seen-records
				record-type = program.structs-by-id[struct-id]!
				fields = record-type.body.concrete-record! fields
				guard args zip fields every (arg, field) => can-reference[field.type.struct, arg]
				seen-records ~= key
				emit[record-type single-constant-record constant, args, fields]
				did-something := true
		for struct-id, map : all-constants unions
			for constant, value : map
				key = struct-id, constant
				guard key !in seen-unions
				union-type = program.structs-by-id[struct-id]!
				members = union-type.body.concrete-union! members
				member-type = members[value member-index]
				guard can-reference[member-type.struct, value.member]
				seen-unions ~= key
				emit[union-type single-constant-union constant, value, member-type.struct]
				did-something := true
		
	# TODO: RM this debugging code ------------------------------------------------------------------------------------------------------------------
	for struct-id, map : all-constants records	
		for constant, args : map
			key = struct-id, constant
			if key !in seen-records
				record-type = program.structs-by-id[struct-id]!
				fields = record-type.body.concrete-record! fields
				error log "Could not emit constant record {show-ctx show-concrete-struct record-type}"
				for arg, field : args zip fields
					if !can-reference[field.type.struct, arg]
						error log "  Can not emit field of type {show-ctx show-concrete-struct field.type.struct}"

	n-constant-arrays = all-constants.arrs sum x => x.constants.size
	n-constant-records = all-constants.records sum (_, map) => map.size
	n-constant-unions = all-constants.unions sum (_, map) => map.size
	seen-arrays.size is n-constant-arrays
	seen-records.size is n-constant-records
	seen-unions.size is n-constant-unions

-any-constant union(single-constant-array, single-constant-record, single-constant-union) mut
-type concrete-struct(a any-constant)
	# TODO: this could be simplified if the type was always called 'type'! --------------------------------------------------
	match a
	as single-constant-array x
		x array-type
	as single-constant-record x
		x record-type
	as single-constant-union x
		x union-type
-single-constant-array record mut
	array-type concrete-struct
	element-type concrete-type
	index nat
	elements constant[]
-single-constant-record record mut
	record-type concrete-struct
	constant constant-record
	args constant[]
	fields concrete-field[]
-single-constant-union record mut
	union-type concrete-struct
	constant constant-union
	value constant-union-value
	member-type concrete-struct

-funs-lookup concrete-fun[concrete-fun-id](a concrete-program)
	for fun : a all-funs
		fun.id, fun	

-call-main java-method(ctx to-java-ctx)
	# TODO: I don't think I need the catch ....................................................................................
	###
	public static void main(String[] args) \{
		try {
			int exit = (int) MainModule.main123(args);
			if (exit != 0) System.exit(exit);
		} catch (crow_exception e) {
			System.err.println(show(e));
			e.printStackTrace();
			System.exit(1);
		}
	}
	###
	common-funs = ctx.program.common-funs concrete-common-funs-java!
	main = common-funs main
	string-array java-type = "java.lang.String".to java-array-type
	params java-param[] = (string-array, "args"),
	get-args = "args" java-local-access
	call-main = ctx.mangled-names[main] java-call-static-method (get-args,)
	declare-exit = "int".to java-var-decl "exit", (("int".to java-cast call-main),)
	get-exit = "exit" java-local-access
	exit-not-zero = not-equal java-binary get-exit, zero
	system-exit = ("java.lang.System", "exit") java-call-static-method (get-exit,)
	maybe-exit = exit-not-zero java-if-statement (system-exit.to,), ()

	tried java-statement[] = declare-exit, maybe-exit
	e = "e" java-local-access
	show-e = ctx.mangled-names[common-funs show-exception] java-call-static-method (e,)
	println-show-e = ("java.lang.System", "err").java-access-static-field java-call-instance-method "println", (show-e,)
	print-stack-trace = e java-call-instance-method "printStackTrace", ()
	exit-1 = ("java.lang.System", "exit") java-call-static-method (1.java-literal-int32-or-less,)
	catch-block java-statement[] = println-show-e.to, print-stack-trace.to, exit-1.to
	catch_ java-catch = "java.lang.Throwable", "e", catch-block
	try_ = tried java-try-statement (catch_,), ()

	"", public, static, "void".to, "main", params, ((try_,),)

-zero java-expr()
	0 java-literal-int32-or-less

-exception concrete-struct(ctx to-java-ctx)
	ctx.program.common-funs.concrete-common-funs-java!.exception
-string concrete-struct(ctx to-java-ctx)
	ctx.program.common-funs.concrete-common-funs-java!.string
-symbol concrete-struct(ctx to-java-ctx)
	ctx.program.common-funs.concrete-common-funs-java!.symbol
-is-exception bool(ctx to-java-ctx, type concrete-struct)
	type == ctx.exception

-translate-vars java-field[][uri](ctx to-java-ctx, program concrete-program)
	res java-field mut[] mut[uri] = ()
	for var : program all-vars
		name = ctx.mangled-names[var].member
		field java-field = match var kind
		as global_
			private, static, non-final, (ctx as-type var.type), name, ()
		as thread-local_
			init = "java.lang.ThreadLocal" java-new ()
			private, static, final, "java.lang.ThreadLocal".to, name, (init,)
		res ensure var.module-uri ~= field
	for uri, fields : res
		uri, fields.move-to

-translate-functions-and-vars java-class[](ctx to-java-ctx, program concrete-program)
	methods = ctx translate-methods program
	fields = ctx translate-vars program
	for uri : methods.keys.to | fields.keys.to
		comment: uri to
		kind: final
		name: ctx.mangled-names[uri]
		extends: ()
		implements: ()
		fields: fields[uri] ?? ()
		constructor: ()
		methods: methods[uri] ?? ()

-translate-methods java-method[][uri](ctx to-java-ctx, program concrete-program)
	res java-method mut[] mut[uri] = ()
	for fun : program all-funs
		expr-ctx to-expr-ctx = ctx, (), 0
		params java-param[] = for param : fun params
			(ctx as-type param.type), (expr-ctx local-name param)
		body java-statement[] = match fun body
		as concrete-fun-body-builtin builtin_
			args concrete-expr[] = for param : fun params
				param.type, fun.range, param.local-get-concrete-expr
			expr-ctx translate-builtin return, builtin_.kind, builtin_.type-args, fun.return-type.struct, args
		as concrete-fun-body-extern _
			throw-bogus,
		as concrete-expr x
			expr-ctx translate-expr return, x
		as concrete-fun-body-var-get x
			params.size is 0
			access = ctx.mangled-names[x.var] java-access-static-field
			match x.var kind
			as thread-local_
				expr = ctx cast-and-unbox x.var.type.struct, (access java-call-instance-method "get", ())
				expr.java-return-statement,
			as global_
				access.java-return-statement,
		as concrete-fun-body-var-set x
			params.size is 1
			access = ctx.mangled-names[x.var] java-access-static-field 
			arg = expr-ctx get-local fun.params.only
			statement java-statement = match x.var kind
			as thread-local_
				access java-call-instance-method "set", ((ctx box fun.params.only.type.struct, arg),) to
			as global_
				access java-assign-statement arg
			statement, return-void
		as concrete-fun-body-deferred
			throw unreachable
		comment = ctx.show-ctx.show show-concrete-fun-name-and-range fun
		res ensure fun.module-uri ~= (comment, internal, static, (ctx as-type fun.return-type), ctx.mangled-names[fun].member, params, (body,))
	for uri, methods : res
		uri, methods.move-to

-get-local java-expr(ctx to-expr-ctx, local concrete-local)
	ctx local-name local java-local-access
-local-name string(ctx to-expr-ctx, local concrete-local)
	ctx.local-names ensure local.id, () =>
		base string = match local source
		as local l
			l.name.mangle
		as concrete-local-source-closure
			"_closure"
		as concrete-generated-local-kind x
			x to
		"{base}{ctx take-next-temp-index}"

-throw-message java-statement(message string)
	"java.lang.RuntimeException" java-new (message.java-literal-string,) java-throw-statement
-throw-bogus java-statement()
	"BOGUS" throw-message
-throw-unreachable java-statement()
	"Should be unreachable" throw-message

-to-java-ctx record mut
	model-program program
	program concrete-program
	show-ctx show-type-ctx
	funs-lookup concrete-fun[concrete-fun-id]
	mangled-names java-mangled-names
	structs-for-integrals concrete-struct[integral-type]
	constant-names mut constant-names

-union-representation enum
	| Upcast case types to the union type, and test using 'instanceof'
	direct
	| Use a 'new Union(i, x)' where 'i' is the index of the case type
	switch
	| The union has 2 case types, and the first is empty. Use 'null' for the first case.
	nullable

# TODO:PERF compute this once up front for each union type (use a full-index-map) --------------------------------------------------------------------------
-union-representation union-representation(ctx to-expr-ctx, union_ concrete-type)
	ctx.ctx union-representation union_.struct
-union-representation union-representation(ctx to-java-ctx, union_ concrete-struct)
	assert u ?= union_.body concrete-union
	members = u members
	members-set concrete-struct-id set = for x : members; x.struct id
	if union_ == ctx.exception
		direct
	elif members-set.size != members.size
		# Union has duplicate members, so can't use 'instanceof' to distinguish
		switch
	elif members.size > 4
		# It's slow to use a long sequence of 'instanceof' tests
		switch
	elif ctx.string.id in members-set && ctx.symbol.id in members-set
		# These also can't be distinguished since they both compile to 'java.lang.String'
		switch
	elif members exists x => x is-union
		switch
	elif members.size == 2 && members[0] is-empty-type
		nullable
	else
		direct
-is-union bool(a concrete-type)
	a.struct.body.concrete-union !is-empty

-get-structs-for-integrals concrete-struct[integral-type](a concrete-program)
	res concrete-struct mut[integral-type] = ()
	for struct : a all-structs
		if builtin_ ?= struct.body concrete-builtin-type
			if i ?= builtin_.kind.to::integral-type?
				forbid i in res
				res[i] := struct
	res move-to

-to-expr-ctx record mut
	ctx to-java-ctx
	local-names string mut[concrete-local-id]
	upcoming-temp-index mut nat
-mangled-names java-mangled-names(a to-expr-ctx)
	a.ctx mangled-names
-take-next-temp-index nat(a to-expr-ctx)
	res = a upcoming-temp-index
	a.upcoming-temp-index +:= 1
	res

-translate-struct java-type-decl?(ctx to-java-ctx, struct concrete-struct)
	super-class string? = match struct source
	as concrete-struct-source-bogus
		()
	as concrete-struct-source-inst inst
		if inst.decl.sum-type-memberships exists x => x.sum-type == ctx.model-program.common-types.exception
			"java.lang.Throwable",
	as concrete-struct-source-lambda _
		()

	comment = ctx.show-ctx.show show-concrete-struct struct
	class-name = ctx.mangled-names[struct]
	match struct body
	as concrete-builtin-type x
		unless _ ?= x.kind as-java-lang-class
			if x.kind is-array-type
				()
			elif x.kind is-lambda-type
				return-type, param-type = x.type-args only2
				cls = comment lambda-class class-name, super-class, (ctx as-type return-type.struct), (ctx as-type param-type.struct)
				cls to,
			else
				primitive-type java-type = x.kind.as-primitive-type! to
				(comment boxing-record class-name, super-class, primitive-type to),
	as concrete-enum x
		(comment boxing-record class-name, super-class, x.storage_.as-type to),
	as concrete-extern-type _
		()
	as concrete-flags x
		(comment boxing-record class-name, super-class, x.storage_.as-type to),
	as concrete-record r
		if r.fields is-empty
			instance java-field = class-name static-instance r
			res java-class = do
				comment: comment
				kind: final
				name: class-name
				extends: super-class
				implements: ()
				fields: instance,
				constructor: ()
				methods: ()
			res to,
		elif super-class !is-empty || r is-some-field-mutable
			fields java-field[] = for field : r fields
				visibility: internal
				kind: instance
				field-kind: final
				type: ctx as-type field.type
				name: field.debug-name mangle
				initializer: ()
			res java-class = comment basic-class class-name, super-class, fields
			res to,
		else
			res java-record = do
				comment: comment
				name: class-name
				fields: for field : r fields
					forbid field is-mutable
					type: ctx as-type field.type
					name: field.debug-name mangle
				implements: ()
				static-fields: if struct is-empty-struct
					(class-name static-instance r),
			res to,
	as concrete-union _
		# Unions all compile to 'Union'
		()
	as concrete-struct-body-deferred
		throw unreachable

# Used to define a static 'instance' for an empty type
-static-instance java-field(class-name string, r concrete-record)
	# TODO: this has to deal with types that are supposed to be empty, but have a field, e.g. a type with a field that is 'void'.
	# Should concretize be responsible for removing unnecessary fields? -----------------------------------------------
	args java-expr[] = for field : r fields
		field.type.struct gc-safe-value
	visibility: internal
	kind: static
	field-kind: final
	type: class-name to
	name: "instance"
	initializer: (class-name java-new args),

-is-array-type bool(a builtin-type)
	match a
	as array
		true
	as mut-slice
		true
	else
		false

-mangle string(a symbol)
	if a is-java-keyword
		"_{a}"
	else
		a.to mangle-name-common

-is-java-keyword bool(a symbol)
	match a
	as "abstract"
		true
	as "assert"
		true
	as boolean
		true
	as "break"
		true
	as byte
		true
	as "case"
		true
	as "catch"
		true
	as char
		true
	as "class"
		true
	as const
		true
	as "continue"
		true
	as default
		true
	as "do"
		true
	as double
		true
	as "else"
		true
	as "enum"
		true
	as extends
		true
	as final
		true
	as "finally"
		true
	as float
		true
	as "for"
		true
	as goto
		true
	as "if"
		true
	as implements
		true
	as "import"
		true
	as instanfeof
		true
	as int
		true
	as "interface"
		true
	as long
		true
	as native
		true
	as new
		true
	as package
		true
	as private
		true
	as protected
		true
	as public
		true
	as return
		true
	as short
		true
	as static
		true
	as strictfp
		true
	as super
		true
	as switch
		true
	as synchronized
		true
	as this
		true
	as "throw"
		true
	as throws
		true
	as transient
		true
	as "try"
		true
	as void
		true
	as volatile
		true
	as "while"
		true
	else
		false

-lambda-class java-class(comment string, name string, super string?, return-type java-type, param-type java-type)
	###
	abstract class foo {
		abstract rt call(p x)
	}
	###
	method java-method = do
		comment: ""
		visibility: internal
		kind: abstract-instance
		return-type: return-type
		name: "call"
		params: ((param-type, "x"),)
		body: ()
	comment: comment
	kind: abstract_
	name: name
	extends: super
	implements: ()
	fields: ()
	constructor: ()
	methods: (method,)

-boxing-record java-record(comment string, name string, extends string?, primitive-type java-type)
	forbid _ ?= extends # TODO: if this happens, I need to make it a class instead ------------------------------------------
	comment: comment
	name: name
	fields: (primitive-type, "value"),
	implements: ()
	static-fields: ()

-basic-class java-class(comment string, name string, super-class string?, fields java-field[])
	methods java-method[] = for field : fields
		body = field.name.java-local-access java-return-statement # TODO: this is not actually a local access but it uses the same syntax
		comment: ""
		visibility: internal
		kind: instance
		return-type: field type
		name: field name
		params: ()
		body: (body,),
	comment, final, name, super-class, (), fields, (fields.constructor-for-fields,), methods

-constructor-for-fields java-constructor(fields java-field[])
	assigns java-statement[] = for field : fields
		java-this java-property-access field.name java-assign-statement field.name.java-local-access
	params java-param[] = for field : fields
		field.type, field.name
	params, assigns

-as-type java-type(ctx to-java-ctx, struct concrete-struct, a concrete-builtin-type)
	if primitive ?= a.kind as-primitive-type
		primitive to
	else
		ctx as-boxed-type struct, a

-as-primitive-type string?(a builtin-type)
	match a
	as array
		()
	as bool
		"boolean",
	as catch-point
		()
	as char8
		"byte",
	as char32
		"int",
	as const-pointer
		()
	as float32
		"float",
	as float64
		"double",
	as fun-pointer
		()
	as future
		()
	as int8
		"byte",
	as int16
		"short",
	as int32
		"int",
	as int64
		"long",
	as java-any
		()
	as java-exclusion
		()
	as js-any
		()
	as fun-data
		()
	as fun-mut
		()
	as fun-shared
		()
	as mut-array
		()
	as mut-pointer
		()
	as mut-slice
		()
	as nat8
		"byte",
	as nat16
		"short",
	as nat32
		"int",
	as nat64
		"long",
	as option
		throw unreachable
	as string
		()
	as symbol
		()
	as void
		()
	
-as-type java-type(a integral-type)
	a.to.as-primitive-type! to

-as-type-expr java-expr(ctx to-java-ctx, type concrete-type)
	ctx as-type type java-class-expr
-as-class string(ctx to-java-ctx, type concrete-struct)
	ctx as-type type string!
-as-type java-type(ctx to-java-ctx, type concrete-type)
	ctx as-type type.struct
-as-type java-type(ctx to-java-ctx, type concrete-struct)
	match type body
	as concrete-builtin-type x
		ctx as-type type, x
	as concrete-enum x
		x.storage_ as-type
	as concrete-extern-type
		throw todo
	as concrete-flags x
		x.storage_ as-type
	as concrete-record _
		ctx.mangled-names[type] to
	as concrete-union x
		match ctx union-representation type
		as direct
			if ctx is-exception type
				"java.lang.Throwable" to
			else
				# TODO: Ideally a crow 'interface' would become a java 'interface' so methods could be called directly --------------------------------------------------
				"Object" to
		as switch
			"Union" to
		as nullable
			_, non-null = x.members only2
			ctx as-boxed-type non-null
	as concrete-struct-body-deferred
		throw unreachable
-as-type java-type(ctx to-expr-ctx, type concrete-struct)
	ctx.ctx as-type type
-as-boxed-type java-type(ctx to-java-ctx, type concrete-type)
	ctx as-boxed-type type.struct
-as-boxed-type java-type(ctx to-java-ctx, type concrete-struct)
	match type body
	as concrete-builtin-type x
		ctx as-boxed-type type, x
	as concrete-enum _
		ctx.mangled-names[type] to
	as concrete-extern-type
		throw todo
	as concrete-flags _
		ctx.mangled-names[type] to
	as concrete-record _
		ctx as-type type
	as concrete-union _
		ctx as-type type
	as concrete-struct-body-deferred
		throw unreachable

-box java-expr(ctx to-java-ctx, struct concrete-struct, arg java-expr)
	match struct body
	as concrete-builtin-type x
		ctx box struct, x.kind, arg
	as concrete-enum x
		ctx box struct, x.storage_.to, arg
	as concrete-flags x
		ctx box struct, x.storage_.to, arg
	else
		arg
-box java-expr(ctx to-java-ctx, struct concrete-struct, type builtin-type, arg java-expr)
	if type is-array-type || type is-lambda-type
		arg
	elif x ?= type as-java-lang-class
		x.to java-cast arg
	else
		ctx.mangled-names[struct] java-new (arg,)

-unbox java-expr(ctx to-java-ctx, type concrete-struct, arg java-expr)
	match type body
	as concrete-builtin-type x
		ctx unbox type, x.kind, arg
	as concrete-enum x
		ctx unbox type, x.storage_.to, arg
	as concrete-flags x
		ctx unbox type, x.storage_.to, arg
	else
		arg
-unbox java-expr(ctx to-java-ctx, struct concrete-struct, type builtin-type, arg java-expr)
	if type is-array-type || type is-lambda-type
		arg
	elif _ ?= type as-java-lang-class
		ctx as-type struct java-cast arg
	else
		arg get-value

-get-kind java-expr(a java-expr)
	a java-call-instance-method "kind", ()
-get-value java-expr(a java-expr)
	a java-call-instance-method "value", ()

-cast-and-unbox java-expr(ctx to-java-ctx, type concrete-struct, arg java-expr)
	ctx unbox type, (ctx as-boxed-type type java-cast arg)

-as-boxed-type java-type(ctx to-java-ctx, struct concrete-struct, a concrete-builtin-type)
	if a.kind is-array-type
		ctx as-type a.type-args.only java-array-type
	elif x ?= a.kind as-java-lang-class
		x to
	else
		ctx.mangled-names[struct] to

-as-java-lang-class string?(a builtin-type)
	match a
	as array
		()
	as bool
		"java.lang.Boolean",
	as catch-point
		"java.lang.Object",
	as char8
		()
	as char32
		()
	as const-pointer
		# TODO: throw unreachable? ---------------------------------------------------------------------------------------------------------------
		"java.lang.Object",
	as float32
		"java.lang.Float",
	as float64
		"java.lang.Double",
	as fun-pointer
		"java.lang.invoke.MethodHandle",
	as future
		"java.util.concurrent.Future",
	as int8
		"java.lang.Byte",
	as int16
		"java.lang.Short",
	as int32
		"java.lang.Integer",
	as int64
		"java.lang.Long",
	as java-any
		"java.lang.Object",
	as java-exclusion
		"java.util.concurrent.locks.ReentrantLock",
	as js-any
		"java.lang.Object",
	as fun-data
		()
	as fun-mut
		()
	as fun-shared
		()
	as mut-array
		"java.util.ArrayList",
	as mut-pointer
		"java.lang.Object",
	as mut-slice
		()
	as nat8
		()
	as nat16
		()
	as nat32
		()
	as nat64
		()
	as option
		throw unreachable
	as string
		"java.lang.String",
	as symbol
		"java.lang.String",
	as void
		"Void",

-expr-pos union(void, loop-pos, write-to, return)
-void expr-pos()
	()::void to
-loop-pos record(loop-label string, outer-pos expr-pos)
-write-to record(assignee java-expr)
-return record

-translate-expr java-statement[](ctx to-expr-ctx, pos expr-pos, a concrete-expr)
	type = a.type struct
	match a kind
	as builtin-concrete-expr x
		ctx translate-builtin pos, x.fun, x.type-args, type, x.args
	as call-concrete-expr x
		# TODO: builtin functions should just always be inlined....
		match x.called.body 
		as concrete-fun-body-builtin b
			ctx translate-builtin pos, b.kind, b.type-args, type, x.args
		else
			ctx with-args x.args, args =>
				pos simple-expr (ctx.mangled-names[x called] java-call-static-method args)
	as cast-concrete-expr x
		# This is currently only used to cast an enum to an integral. In Java we just use integrals for enums directly. --------
		ctx translate-expr pos, x.inner
	as constant x
		pos simple-expr (ctx.ctx translate-constant-reference type, x)
	as create-array-concrete-expr x
		ctx with-args x.args, args =>
			pos simple-expr (ctx as-type type.array-element-type.struct java-literal-array args)
	as create-record-concrete-expr x
		ctx with-args x.args, args =>
			pos simple-expr (ctx.mangled-names[type] java-new args)
	as create-union-concrete-expr x
		ctx with-temp x.arg, arg =>
			boxed = ctx.ctx box x.arg.type.struct, arg
			pos simple-expr match ctx union-representation a.type
			as direct
				boxed
			as switch
				"Union" java-new (x.member-index.to.java-literal-int32-or-less, boxed)
			as nullable
				match x member-index
				as 0
					java-null
				as 1
					boxed
				else
					unreachable
	as drop-concrete-expr x
		ctx translate-expr void, x.arg
	as finally-concrete-expr x
		tried = ctx translate-expr pos, x.below
		finally_ = ctx translate-expr void, x.right
		(tried java-try-statement (), (finally_,)),
	as if-concrete-expr x
		ctx with-temp x.cond, cond =>
			then = ctx translate-expr pos, x.then
			else_ = ctx translate-expr pos, x.else_
			(cond java-if-statement then, else_),
	as let-concrete-expr x
		local = ctx local-name x.local
		needs-final = x.local needs-to-be-effectively-final
		write-to string = if needs-final
			# Write to a temporary mutable variable, so that the local is effectively final
			"{local}__TEMP" # TODO: NEATTER --------------------------------------------------------------------------------
		else
			local
		with out : build
			local-type = ctx as-type x.local.type.struct
			out ~= (local-type java-var-decl write-to, ())
			out ~~= ctx translate-expr write-to.java-local-access.write-to, x.value
			if needs-final
				out ~= (local-type java-var-decl local, (write-to.java-local-access,))
			out ~~= ctx translate-expr pos, x.then
	as lambda-concrete-expr x
		interface_ = ctx as-type type string!
		return-type, param-type = type.source.concrete-struct-source-inst!.type-args.only2 # TODO: helper fn for this ------------
		param-name = ctx local-name x.param
		aic java-anonymous-inner-class = do
			interface_: interface_
			method-return-type: ctx as-type return-type.struct
			method-name: "call"
			param-type: ctx as-type param-type.struct
			param-name: param-name
			body: ctx translate-expr return, x.body
		pos simple-expr aic.to
	as local-get-concrete-expr x
		pos simple-expr (ctx local-name x.local java-local-access)
	as local-pointer-concrete-expr _
		throw unreachable
	as local-set-concrete-expr x
		write-it = ctx translate-expr (ctx local-name x.local).java-local-access.write-to, x.value
		write-it ~~ pos.maybe-return-void
	as loop-concrete-expr x
		match pos
		as return
			body = ctx translate-expr pos, x.body
			(() java-while true.java-literal-boolean, body),
		else
			label string = "loop{ctx take-next-temp-index}"
			body = ctx translate-expr (label loop-pos pos), x.body
			((label,) java-while true.java-literal-boolean, body),
	as loop-break-concrete-expr x
		ctx translate-expr pos, x.value
	as loop-continue-concrete-expr
		java-continue,
	as match-enum-or-integral-concrete-expr x
		matched-type = x matched-integral-type
		ctx with-temp x.matched, matched =>
			if matched-type != nat64.to && matched-type != int64.to # Java doesn't allow switch on long
				cases java-switch-case[] = for value, expr : x.case-values zip x.case-exprs
					integer = nat32 constant-integral value
					integer, ctx translate-expr pos, expr maybe-break-switch-case pos
				default = if e ?= x else_
					ctx translate-expr pos, e maybe-break-switch-case pos
				else
					throw-unreachable,
				(matched java-switch-statement cases, default),
			else
				res mut = if e ?= x else_
					ctx translate-expr pos, e
				else
					throw-unreachable,
				for value, expr : x.case-values zip x.case-exprs
					integer = nat64 constant-integral value
					eq = eq-eq java-binary matched, integer
					then = ctx translate-expr pos, expr
					res := (eq java-if-statement then, res),
				res
	as match-string-like-concrete-expr x
		ctx with-temp x.matched, matched =>
			cases java-switch-case[] = for case_ : x cases
				value = ctx.ctx translate-constant-reference case_.value.type.struct, case_.value.kind.constant! # TODO: case values shouldn't be concrete-expr ............................................
				value, (ctx translate-expr pos, case_.then maybe-break-switch-case pos)
			default = ctx translate-expr pos, x.else_
			(matched java-switch-statement cases, default),
	as match-union-concrete-expr x
		ctx with-temp x.matched, matched =>
			match ctx union-representation x.matched.type
			as direct
				###
				matched = ...
				if (matched instanceof x) {
					Foo x = (Foo) matched;
					...
				} else (if matched instanceof y)
					Bar x = (Bar) matched;
				etc ...
				###
				res mut = if e ?= x else_
					ctx translate-expr pos, e
				elif x.matched.type.struct == ctx.ctx.exception
					# The only exception method is 'show'. For non-Crow exceptions, just use 'toString()'.
					pos simple-expr (matched java-call-instance-method "toString", ())
				else
					throw-unreachable,
				for member-index, case_ : x.member-indices zip x.cases
					case-type = x.union_.members[member-index as-unsigned]
					cond = matched java-instanceof (ctx.ctx as-boxed-type case-type)
					declare java-statement[] = if local ?= case_ local
						value = ctx.ctx cast-and-unbox case-type.struct, matched
						decl = ctx as-type local.type.struct java-var-decl (ctx local-name local), (value,)
						decl,
					then = declare ~~ (ctx translate-expr pos, case_.then)
					res := (cond java-if-statement then, res),
				res
			as switch
				###
				matched = ...
				switch (matched.kind) {
					case 0: {
						foo x = (foo) matched.value;
						...
					}
					etc ...
				}
				###
				cases java-switch-case[] = for member-index, case_ : x.member-indices zip x.cases
					case-type = x.union_.members[member-index as-unsigned]
					decl java-statement[] = if local ?= case_ local
						value = ctx.ctx cast-and-unbox case-type.struct, matched.get-value
						(ctx as-type local.type.struct java-var-decl (ctx local-name local), (value,)),
					expr = ctx translate-expr pos, case_.then
					member-index.as-unsigned.to.java-literal-int32-or-less, (decl ~~ expr maybe-break-switch-case pos)
				default = if e ?= x else_
					ctx translate-expr pos, e
				else
					throw-unreachable,
				(matched.get-kind java-switch-statement cases, default),
			as nullable
				###
				if (matched === null) {
					foo x = foo.instance;
					...
				} else {
					bar x = matched;
					...
				}
				###
				case-null, case-non-null = x.cases only2
				cond = eq-eq java-binary matched, java-null
				declare-null java-statement[] = if local ?= case-null local
					null-type = ctx.ctx as-class local.type.struct
					instance = (null-type, "instance") java-access-static-field
					(null-type.to java-var-decl (ctx local-name local), (instance,)),
				then = declare-null ~~ (ctx translate-expr pos, case-null.then)
				declare-non-null java-statement[] = if local ?= case-non-null local
					non-null-type = ctx.ctx as-type local.type.struct
					unbox-matched = ctx.ctx unbox local.type.struct, matched
					(non-null-type java-var-decl (ctx local-name local), (unbox-matched,)), # TODO: this duplicates some code from above
				else_ = declare-non-null ~~ (ctx translate-expr pos, case-non-null.then)
				(cond java-if-statement then, else_),
	as record-field-get-concrete-expr x
		ctx with-temp x.record_, record_ =>
			pos simple-expr (record_ java-call-instance-method x.field.debug-name.mangle, ())
	as record-field-pointer-concrete-expr _
		throw unreachable
	as record-field-set-concrete-expr x
		ctx with-temp x.record_, record_ =>
			access = record_ java-property-access x.field.debug-name.mangle
			assign = ctx translate-expr access.write-to, x.value
			assign ~~ pos.maybe-return-void
	as seq-concrete-expr x
		(ctx translate-expr void, x.first) ~~ (ctx translate-expr pos, x.then)
	as throw-concrete-expr x
		ctx with-temp x.thrown, thrown =>
			thrown.java-throw-statement,
	as try-concrete-expr x
		tried = ctx translate-expr pos, x.tried
		catch-clauses java-catch[] = for exception-case-index, case_ : x.exception-member-indices zip x.catch-cases
			local string = if l ?= case_ local
				ctx local-name l
			else
				"_{ctx take-next-temp-index}"
			then = ctx translate-expr pos, case_.then
			(ctx.ctx exception-case-type-from-index exception-case-index), local, then
		(tried java-try-statement catch-clauses, ()),
	as try-let-concrete-expr x
		###
		x = try value catch err local : catch_
		then
		==>
		T local = null;
		boolean ok = false;
		try {
			local = value;
			ok = true;
		} catch (err catch_local) {
			catch_then;
		}
		if (ok) then
		###
		catch-exits = match pos
		as void
			true
		as loop-pos _
			false
		as write-to _
			true
		as return
			false
		local = if concrete-local ?= x local
			ctx local-name concrete-local
		else
			"ignore{ctx take-next-temp-index}"
		local-type = x.value.type struct
		# Give it a dummy initializer because otherwise Java will complain that it might be uninitialized
		declare-local = (ctx as-type local-type) java-var-decl local, (local-type.gc-safe-value,)
		ok string? = if catch-exits
			"ok{ctx take-next-temp-index}",
		declare-ok java-statement? = if o ?= ok
			("boolean".to java-var-decl  o, (false.java-literal-boolean,)),
		set-local = ctx translate-expr local.java-local-access.write-to, x.value
		set-ok java-statement[] = if o ?= ok
			(o.java-local-access java-assign-statement true.java-literal-boolean),
		caught-local = if l ?= x.catch_.local
			ctx local-name l
		else
			"temp{ctx take-next-temp-index}"
		catch-then = ctx translate-expr pos, x.catch_.then
		catch_ java-catch = (ctx.ctx exception-case-type-from-index x.exception-member-index), caught-local, catch-then
		then = ctx translate-expr pos, x.then
		after java-statement[] = if o ?= ok
			(o.java-local-access java-if-statement then, ()),
		else
			then
		try_ = set-local ~~ set-ok java-try-statement (catch_,), ()
		with out : build
			# Initialize the result with a dummy value. I know it will be overwritten, but Java thinks it may be uninitialized
			if w ?= pos write-to
				# Give it a dummy initializer because otherwise Java will complain that it might be uninitialized
				out ~= w.assignee java-assign-statement type.gc-safe-value
			out ~= declare-local
			out ~~= declare-ok
			out ~= try_
			out ~~= after
	as union-as-concrete-expr x
		ctx with-temp x.union_, union_ =>
			value = match ctx union-representation x.union_.type
			as direct
				union_
			as switch
				union_ get-value
			as nullable
				throw todo
			pos simple-expr (ctx.ctx cast-and-unbox x.case-type.struct, value)
	as union-kind-concrete-expr x
		match ctx union-representation x.union_.type
		as direct
			###
			matched =  ...
			if (matched instanceof x)
				return 0;
			else if (matched instanceof y)
				return 1;
			...
			else
				throw new Error("Unreachable"); 
			###
			ctx with-temp x.union_, matched =>
				res mut java-statement[] = throw-unreachable,
				for case-index, case-type : x.union-members with-index
					is-case = matched java-instanceof (ctx.ctx as-boxed-type case-type)
					return-index = pos simple-expr case-index.to.java-literal-int32-or-less
					res := (is-case java-if-statement return-index, res),
				res
		as switch
			ctx with-temp x.union_, union_ =>
				pos simple-expr union_.get-kind
		as nullable
			throw todo

-needs-to-be-effectively-final bool(local concrete-local)
	match local source
	as local x
		x is-used-in-closure
	as concrete-local-source-closure
		false
	as concrete-generated-local-kind _
		false

-exception-case-type-from-index string(ctx to-java-ctx, exception-case-index integral-value)
	exception-types = ctx.exception.body.concrete-union! members
	ctx as-type exception-types[exception-case-index as-unsigned].struct string!

-maybe-break-switch-case java-statement[](before java-statement[], pos expr-pos)
	if before needs-break pos
		before ~ ().java-break
	else
		before
-needs-break bool(before java-statement[], pos expr-pos)
	match pos
	as void
		before !ends-with-throw
	as write-to _
		before !ends-with-throw
	as loop-pos _
		()
	as return
		()
-ends-with-throw bool(before java-statement[])
	unless before is-empty
		before[end - 1].java-throw-statement !is-empty

-simple-expr java-statement[](pos expr-pos, expr java-expr)
	match pos
	as void
		expr.as-statement to
	as loop-pos l
		match l outer-pos
		as void
			(l.outer-pos simple-expr expr) ~ (l.loop-label,).java-break
		as loop-pos _
			l.outer-pos simple-expr expr
		as write-to _
			(l.outer-pos simple-expr expr) ~ (l.loop-label,).java-break
		as return
			l.outer-pos simple-expr expr
	as write-to x
		(x.assignee java-assign-statement expr),
	as return
		expr.java-return-statement,

-with-args java-statement[](
	ctx to-expr-ctx,
	args concrete-expr[],
	f java-statement[] mut(get-args java-expr[]),
)
	with out : build
		exprs java-expr[] = for arg : args
			if simple ?= ctx as-simple-expr arg
				simple
			else
				arg-name string = "_arg{ctx take-next-temp-index}"
				out ~= ctx as-type arg.type.struct java-var-decl arg-name, ()
				out ~~= ctx translate-expr arg-name.java-local-access.write-to, arg
				arg-name java-local-access
		out ~~= f[exprs]

-as-simple-expr java-expr?(ctx to-expr-ctx, a concrete-expr)
	match a kind
	as constant x
		(ctx.ctx translate-constant-reference a.type.struct, x),
	as local-get-concrete-expr x
		# For a mutable local, it matters *when* we access it, so it can't be delayed until the call
		if x.local !is-mutable
			(ctx local-name x.local java-local-access),
	else
		()

-with-temp java-statement[](
	ctx to-expr-ctx,
	value concrete-expr,
	f java-statement[] mut(get-temp java-expr),
)
	if simple ?= ctx as-simple-expr value
		f[simple]
	else
		name string = "temp{ctx take-next-temp-index}"
		declare = ctx as-type value.type.struct java-var-decl name, ()
		statements = ctx translate-expr name.java-local-access.write-to, value
		then = f[name java-local-access]
		declare ~ statements ~~ then

-translate-constant-reference java-expr(ctx to-java-ctx, type concrete-struct, a constant)
	match type body
	as concrete-builtin-type x
		ctx translate-constant-builtin type, x, a
	as concrete-enum x
		x.storage_ constant-integral a
	as concrete-extern-type
		throw todo
	as concrete-flags x
		x.storage_ constant-integral a
	as concrete-record _
		match a
		as constant-record r
			assert rrr ?= ctx.constant-names.records[type id] : "Can't find constant records for type {ctx.show-ctx.show show-concrete-struct type}" error
			rrr[r]! java-access-static-field
		as constant-gc-safe-value
			java-null
		as constant-null
			java-null
		else
			throw unreachable
	as concrete-union _
		match a
		as constant-union u
			ctx.constant-names.unions[type id]![u]! java-access-static-field
		as constant-gc-safe-value
			java-null
		as constant-null
			java-null
		else
			throw unreachable
	as concrete-struct-body-deferred
		throw unreachable
-translate-constant-builtin java-expr(ctx to-java-ctx, type concrete-struct, builtin_ concrete-builtin-type, a constant)
	error java-expr mut(message string) = message => # TODO: none of these should be reachable -------------------------------
		(ctx as-type type) java-throw-expression "SHOULD NOT BE A CONSTANT {message}?????"
	string java-expr mut() = () =>
		value string = match a
		as constant-array ca
			elements = ctx.program.all-constants.arrs[ca type-index].constants[ca index] # TODO: have a helper function for this
			chars char8[] = for x : elements
				x.as-integral.as-unsigned.to to
			chars to
		as constant-c-string x
			ctx.program.all-constants.c-strings[x index]
		as constant-gc-safe-value
			"" # TODO: use null? ----------------------------------------------------------------------------------------------------------
		else
			throw unreachable
		value java-literal-string
	array java-expr mut() = () =>
		assert asdf ?= ctx.constant-names.arrays[type id] : "Can't find constant array for type {ctx.show-ctx.show show-concrete-struct type}" error # ----------
		assert arr ?= a constant-array : "The constant is not a constant-array" error
		assert array-at-index ?= asdf[arr index] : "No constant at index {arr index}" error
		array-at-index java-access-static-field
	match builtin_ kind
	as array
		array[]
	as bool
		a.as-bool java-literal-boolean
	as catch-point
		error["CATCH-POINT"]
	as char8
		int8 constant-integral a
	as char32
		nat32 constant-integral a
	as const-pointer
		error["CONST-POINTER"]
	as float32
		true constant-float a
	as float64
		false constant-float a
	as fun-pointer
		id = a.constant-fun-pointer! fun
		fun = ctx.funs-lookup[id]!
		args java-expr[] = with out : build
			name = ctx.mangled-names[fun]
			out ~= name.class_ java-literal-string
			out ~= name.member java-literal-string
			out ~= ctx as-type-expr fun.return-type
			for param : fun params
				out ~= ctx as-type-expr param.type
		("Crow", "funPointer") java-call-static-method args
	as future
		error["FUTURE"]
	as int8
		int8 constant-integral a
	as int16
		int16 constant-integral a
	as int32
		int32 constant-integral a
	as int64
		int64 constant-integral a
	as java-any
		error["JAVA-ANY"]
	as java-exclusion
		error["JAVA-EXCLUSION"]
	as js-any
		error["JS-ANY"]
	as fun-data
		error["FUN-DATA"]
	as fun-mut
		error["FUN-MUT"]
	as fun-shared
		error["FUN-SHARED"]
	as mut-array
		error["MUT-ARRAY"]
	as mut-pointer
		error["MUT-POINTER"]
	as mut-slice
		array[]
	as nat8
		nat8 constant-integral a
	as nat16
		nat16 constant-integral a
	as nat32
		nat32 constant-integral a
	as nat64
		nat64 constant-integral a
	as option
		throw unreachable
	as string
		string[]
	as symbol
		string[]
	as void
		# TODO: 'concretize' should be responsible for removing all void values, except function return values. --------------------------
		void-expr

-maybe-return-void java-statement[](pos expr-pos)
	match pos
	as void
		()
	as loop-pos _
		()
	as write-to x
		(x.assignee java-assign-statement void-expr),
	as return
		return-void,
-return-void java-statement()
	void-expr java-return-statement
-void-expr java-expr()
	("Void", "instance") java-access-static-field

-constant-float java-expr(is-float32 bool, a constant) # TODO: inilne -------------------------------------------------------
	is-float32 java-literal-float a.as-float
-constant-integral java-expr(type integral-type, a constant)
	type constant-integral a.as-integral
-constant-integral java-expr(type integral-type, value integral-value)
	match type
	as int8
		"byte".to java-cast (value.as-signed.to java-literal-int32-or-less)
	as int16
		"short".to java-cast (value.as-signed.to java-literal-int32-or-less)
	as int32
		value.as-signed.to java-literal-int32-or-less
	as int64
		value.as-signed java-literal-int64
	as nat8
		"byte".to java-cast (value.as-unsigned.to::nat8.wrap-to::int8.to java-literal-int32-or-less)
	as nat16
		"short".to java-cast (value.as-unsigned.to::nat16.wrap-to::int16.to java-literal-int32-or-less)
	as nat32
		value.as-unsigned.to.wrap-to java-literal-int32-or-less
	as nat64
		value.as-unsigned.wrap-to java-literal-int64

-translate-builtin java-statement[](ctx to-expr-ctx, pos expr-pos, fun builtin-fun, type-args concrete-type[], type concrete-struct, args concrete-expr[])
	match fun
	as builtin-fun-all-tests
		throw unreachable
	as builtin-unary x
		ctx with-temp args.only, arg =>
			pos simple-expr (x translate-builtin-unary arg)
	as builtin-unary-math x
		ctx with-temp args.only, arg =>
			pos simple-expr (x translate-builtin-unary-math arg)
	as builtin-binary x
		ctx with-args args, get-args =>
			pos simple-expr (ctx.ctx translate-builtin-binary type, x, get-args.only2)
	as builtin-binary-lazy _
		throw unreachable
	as builtin-binary-math x
		ctx with-args args, get-args =>
			pos simple-expr (x translate-builtin-binary-math get-args.only2)
	as builtin-ternary x
		match x
		as interpreter-backtrace
			"Reached interpreter-backtrace?????".throw-message, # TODO: should be unreachable ----------------------------------------------------------------------
	as builtin-4ary x
		match x
		as switch-fiber-initial
			"Reached switch-fiber-initial?????".throw-message, # TODO: should be unreachable ----------------------------------------------------------------------
	as builtin-fun-call-lambda
		ctx with-args args, get-args =>
			pos simple-expr (get-args[0] java-call-instance-method "call", get-args[1 .. end].to)
	as builtin-fun-call-fun-pointer
		ctx with-args args, get-args =>
			fn, param = get-args only2
			param-type = args[1].type
			invoke = fn java-call-instance-method "invoke", if param-type is-void
				()
			elif param-type is-tuple
				fields = param-type.must-be-by-val.body.concrete-record! fields
				for field : fields
					param java-property-access field.debug-name.mangle
			else
				param,
			# Note: Not using 'cast-and-unbox' because the MethodHandle uses java's automatic boxing, so it won't box a nat8 as a Nat8 but as a java.lang.Byte
			pos simple-expr (ctx.ctx as-type type java-cast invoke)
	as builtin-fun-constant _
		throw unreachable
	as builtin-fun-gc-safe-value
		throw unreachable
	as builtin-fun-init _
		throw unreachable
	as java-fun x
		ctx with-args args, get-args =>
			ctx.ctx translate-java-fun pos, x, type, type-args, get-args
	as js-fun _
		throw unreachable
	as builtin-fun-mark-root
		throw unreachable
	as builtin-fun-mark-visit
		throw unreachable
	as builtin-fun-new-empty-option
		throw unreachable
	as builtin-fun-new-non-empty-option
		throw unreachable
	as builtin-fun-pointer-cast
		throw unreachable
	as builtin-fun-size-of
		throw unreachable
	as builtin-fun-static-symbols
		throw unreachable
	as version-fun _
		throw unreachable	

-gc-safe-value java-expr(type concrete-struct)
	match type body
	as concrete-builtin-type x
		match x kind
		as array
			java-null
		as bool
			false java-literal-boolean
		as char8
			zero
		as char32
			zero
		as catch-point
			java-null
		as const-pointer
			java-null
		as float32
			zero
		as float64
			zero
		as fun-data
			java-null
		as fun-mut
			java-null
		as fun-pointer
			java-null
		as fun-shared
			java-null
		as future
			java-null
		as int8
			zero
		as int16
			zero
		as int32
			zero
		as int64
			zero
		as java-exclusion
			java-null
		as js-any
			java-null
		as java-any
			java-null
		as mut-array
			java-null
		as mut-pointer
			java-null
		as mut-slice
			java-null
		as nat8
			zero
		as nat16
			zero
		as nat32
			zero
		as nat64
			zero
		as option
			throw unreachable
		as string
			"" java-literal-string
		as symbol
			"" java-literal-string
		as void
			java-null
	as concrete-enum _
		zero
	as concrete-flags _
		zero
	else
		java-null

-translate-builtin-unary java-expr(a builtin-unary, arg java-expr)
	cast java-expr data(name string) = name =>
		name.to java-cast arg
	static java-expr data(name class-and-member) = name =>
		name java-call-static-method (arg,)
	unary java-expr data(kind java-unary-kind) = kind =>
		kind java-unary arg
	match a
	as array-pointer
		throw unreachable
	as array-size
		"long".to java-cast (arg java-property-access "length")
	as as-any-pointer
		throw unreachable
	as as-future
		throw unreachable
	as as-future-impl
		throw unreachable
	as as-mut-array
		arg
	as as-mut-array-impl
		arg
	as bits-of-float32
		static["java.lang.Float", "floatToRawIntBits"]
	as bits-of-float64
		static["java.lang.Double", "doubleToRawLongBits"]
	as bitwise-not-nat8
		unary[bitwise-not]
	as bitwise-not-nat16
		unary[bitwise-not]
	as bitwise-not-nat32
		unary[bitwise-not]
	as bitwise-not-nat64
		unary[bitwise-not]
	as count-ones-nat64
		"long".to java-cast (("java.lang.Long", "bitCount") java-call-static-method (arg,))
	as c-string-of-symbol
		throw unreachable
	as deref
		throw unreachable
	as drop
		throw unreachable
	as float32-from-bits
		static["java.lang.Float", "intBitsToFloat"]
	as float64-from-bits
		static["java.lang.Double", "longBitsToDouble"]
	as is-nan-float32
		static["java.lang.Float", "isNaN"]
	as is-nan-float64
		static["java.lang.Double", "isNaN"]
	as not
		unary[not]
	as jump-to-catch
		throw unreachable
	as reference-from-pointer
		throw unreachable
	as setup-catch
		throw unreachable
	as symbol-of-c-string
		throw unreachable
	as to-char8-from-nat8
		arg
	as to-char8-array-from-string
		arg java-call-instance-method "getBytes", (charset-utf8,)
	as to-float32-from-float64
		cast["float"]
	as to-float64-from-float32
		cast["double"]
	as to-float64-from-int64
		cast["double"]
	as to-float64-from-nat64
		static["Crow", "float64FromNat64"]
	as to-int64-from-int8
		cast["long"]
	as to-int64-from-int16
		cast["long"]
	as to-int64-from-int32
		cast["long"]
	as to-nat8-from-char8
		arg
	as to-nat32-from-char32
		arg
	as to-nat64-from-nat8
		static["java.lang.Byte", "toUnsignedLong"]
	as to-nat64-from-nat16
		static["java.lang.Short", "toUnsignedLong"]
	as to-nat64-from-nat32
		static["java.lang.Integer", "toUnsignedLong"]
	as to-nat64-from-ptr
		throw unreachable
	as to-ptr-from-nat64
		throw unreachable
	as truncate-to-int64-from-float64
		cast["long"]
	as trust-as-string
		"java.lang.String" java-new (arg, charset-utf8)
	as unsafe-to-char32-from-char8
		("java.lang.Byte", "toUnsignedInt") java-call-static-method (arg,)
	as unsafe-to-char32-from-nat32
		arg
	as unsafe-to-nat32-from-int32
		arg
	as unsafe-to-int8-from-int64
		cast["byte"]
	as unsafe-to-int16-from-int64
		cast["short"]
	as unsafe-to-int32-from-int64
		cast["int"]
	as unsafe-to-nat64-from-int64
		arg
	as unsafe-to-int64-from-nat64
		arg
	as unsafe-to-nat8-from-nat64
		cast["byte"]
	as unsafe-to-nat16-from-nat64
		cast["short"]
	as unsafe-to-nat32-from-nat64
		cast["int"]

-charset-utf8 java-expr()
	("java.nio.charset.StandardCharsets", "UTF_8") java-access-static-field

