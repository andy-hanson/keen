import
	crow/col/mut-stack
	../../frontend/show-model
	../../model/concrete-model
	../../model/integral-values
	../../model/model
	../../model/show-concrete-model
	../../model/source-range
	../../model/uri
	../../util/full-index-map
	../../util/perfhax
	../../util/util
	./class-builder
	./class-code-builder
	./lib/Crow.class as Crow-class nat8 array
	./lib/CrowClassLoader.class as CrowClassLoader-class nat8 array
	./lib/ThreadLocalReentrantLock.class as ThreadLocalReentrantLock-class nat8 array
	./mangle-for-java
	./union-representation
	./util

translate-to-java-classes (string, nat8[])[]
	program program
	concrete-program concrete-program
	show-ctx show-type-ctx
do
	start = perf-now
	union-info = concrete-program plan-unions
	ctx to-java-ctx = do
		res: ()
		next-lambda-index: 0
		next-resource-index: 0
		model-program: program
		program: concrete-program
		show-ctx: show-ctx
		names: show-ctx.show build-mangled-names concrete-program, union-info
		structs-for-integrals: concrete-program get-structs-for-integrals
		union-info: union-info
	start-constants = perf-now
	ctx translate-constants
	start-constants end-translate-constants
	start-types = perf-now
	for type : concrete-program all-structs
		ctx translate-type type
	start-types end-translate-types
	start-funs = perf-now
	for uri, (funs, vars) : concrete-program funs-and-vars-by-uri
		ctx translate-funs-for-uri uri, funs, vars
	start-funs end-translate-funs
	ctx add-class "Main", ctx.main-class
	res (string, nat8[])[] = (for name, bytes : ctx res; name.to, bytes)::(string, nat8[])[] ~~ lib-classes
	start end-translate-to-java
	res

-lib-classes (string, nat8[])[]()
	("Crow.class", Crow-class), ("CrowClassLoader.class", CrowClassLoader-class), ("ThreadLocalReentrantLock.class", ThreadLocalReentrantLock-class)

-main-class ClassFile(ctx to-java-ctx)
	###
	public static void main(String[] args) \{
		try {
			int exit = (int) MainModule.main123(args);
			if (exit != 0) System.exit(exit);
		} catch (crow_exception e) {
			System.err.println(show(e));
			e.printStackTrace();
			System.exit(1);
		}
	}
	###
	constants constants-builder = ()
	names mangled-names-with-constants = ctx.names, constants
	this-class = constants class_ "Main"
	main method_info = do
		code = with out : constants build-code
			out aload 0
			out invokestatic names.crow-string-array-from-java-string-array 
			main = ctx.program.common-funs.concrete-common-funs-java! main
			out call-concrete-fun names, main
			out l2i # TODO: this throws away information ------------------------------------------------------------------------------------
			out dup32
			# If it's == 0, jump to end
			jmp = out ifeq
			out invokestatic names.java-System-exit
			out return void
			jmp jumps-to-here out, do
				locals: ()
				stack: integer,
			out pop T_INT # ignore the exit code since it's 0
			out return void
		access-flags: public | static | synthetic
		name: constants["main"]
		descriptor: constants["([Ljava/lang/String;)V"]
		attributes: code,
	Object = names java-Object
	constant-pool: constants finish
	access: final
	this-class: this-class
	super-class: Object
	interfaces: ()
	fields: ()
	methods: main,
	attributes: ()

-funs-and-vars-by-uri (concrete-fun[], concrete-var[])[uri](a concrete-program)
	res (concrete-fun mut[], concrete-var mut[]) mut[uri] = ()
	for x : a all-funs
		funs, _ = res ensure x.module-uri
		funs ~= x
	for x : a all-vars
		_, vars = res ensure x.module-uri
		vars ~= x
	for key, (funs, vars) : res
		key, (funs.move-to, vars.move-to)
-new (concrete-fun mut[], concrete-var mut[])()
	(), ()

-to-java-ctx record mut
	res nat8[] mut[symbol]
	next-lambda-index mut nat
	next-resource-index mut nat
	model-program program
	program concrete-program
	show-ctx show-type-ctx
	names java-mangled-names
	structs-for-integrals concrete-type[integral-type]
	union-info union-info
-constant-names constant-names(a to-java-ctx)
	a.names constant-names
-add-class void(ctx to-java-ctx, name symbol, class_ ClassFile)
	name-dot-class symbol = "{name}.class"
	forbid name-dot-class in ctx.res : "Already have class {name-dot-class}" error
	start = perf-now
	bytes nat8[] = class_ to
	start end-class-to-bytes
	ctx.res[name-dot-class] := bytes
-union-representation union-representation(ctx to-java-ctx, type concrete-type)
	ctx.union-info union-representation type
-add-resource symbol(ctx to-java-ctx, value nat8[])
	name symbol = "_resource{ctx next-resource-index}.bin"
	ctx.next-resource-index +:= 1
	ctx.res[name] := value
	name

-expr-ctx record mut
	ctx to-java-ctx
	constants constants-builder
	this-class class-reference
	cur-fun-for-debug concrete-fun?
	closure field-reference[concrete-local]
	stack concrete-type mut-stack
	has-this bool
	| Does not include the 'this' param
	locals local-entry mut-stack
	loop-pos mut jump-target?
-names mangled-names-with-constants(a expr-ctx)
	a.ctx.names, a.constants
| Use 'concrete-type' for a synthetic local
-local-entry union(concrete-local, concrete-type)
-to json(a local-entry)
-type concrete-type(a local-entry)
	match a
	as concrete-local x
		x type
	as concrete-type x
		x
-== bool(a local-entry, b local-entry)
-new expr-ctx
	ctx to-java-ctx
	constants constants-builder
	this-class class-reference
	cur-fun concrete-fun?
	closure field-reference[concrete-local]
	has-this bool
	params concrete-local[]
do
	locals local-entry mut-stack = ()
	for x : params
		forbid x.type is-empty-type
		locals ~= x
	ctx, constants, this-class, cur-fun, closure, (), has-this, locals, ()
-program concrete-program(a expr-ctx)
	a.ctx program
-union-representation union-representation(ctx expr-ctx, type concrete-type)
	ctx.ctx union-representation type
| Index of a local, or reference to a closure field
-local-or-closure union(nat, field-reference)
-explain-local local-or-closure(a expr-ctx, local concrete-local)
	if x ?= a.closure[local]
		x
	else
		res mut nat = a.has-this to
		for x : a locals
			if x == local
				break
			else
				res +:= x.type number-of-locals
				continue
		else
			throw unreachable # We shouldn't get index-for-local for a local not already in a.locals
		res
-next-local-index nat(ctx expr-ctx)
	res mut nat = ctx.has-this to
	for x : ctx locals
		res +:= x.type number-of-locals
	res
-cur-stack-frame stack-frame(ctx expr-ctx)
	locals: with out : build
		if ctx has-this
			out ~= ctx.this-class Object_variable_info
		for x : ctx locals
			out ~= ctx verification-type x.type
	stack: for x : ctx stack
		ctx verification-type x

-verification-type verification_type_info(ctx expr-ctx, a concrete-type)
	match a as-runtime-type
	as void
		error log "Unexpected verification-type {ctx.ctx.show-ctx.show show-concrete-type a}" # ------------------------
		throw unreachable
	as java-primitive-type p
		match p
		as T_BOOLEAN
			integer
		as T_CHAR
			integer
		as T_FLOAT
			float
		as T_DOUBLE
			double
		as T_BYTE
			integer
		as T_SHORT
			integer
		as T_INT
			integer
		as T_LONG
			long
	as reference-type
		if f ?= a as-wrapper
			ctx verification-type f.type
		else
			ctx.names class_ a Object_variable_info

-translate-constants void(ctx to-java-ctx)
	ctx add-class constant-symbols-class-name, do ctx constant-symbols-class
	for name, constants : ctx.constant-names class-to-constants
		ctx add-class name, do ctx constants-class name, constants

-constant-symbols-class ClassFile(ctx to-java-ctx)
	constants constants-builder = ()
	names mangled-names-with-constants = ctx.names, constants
	constant-symbols = ctx.program.all-constants symbols
	fields field_info[] = for index : 0 .. constant-symbols.size
		access-flags: static | final
		name: names constant-symbol-name index
		descriptor: names descriptor-for-field-type ctx.program.symbol
		attributes: ()
	this-class = names constant-symbols-class
	static-init method_info = do
		code = with out : constants build-code
			for index, symbol : constant-symbols with-index
				out ldc do out.constants string-ref symbol.to
				out invokevirtual names.java-String-getBytes
				out invokestatic do
					names static-method-ref ctx.program.common-funs.concrete-common-funs-java!.to-symbol-from-string
				out putstatic do names constant-symbol-field ctx.program.symbol, index
			out return void
		access-flags: static | final | synthetic
		name: names clinit
		descriptor: names init-no-args-descriptor
		attributes: code,
	Object = names java-Object
	constant-pool: constants finish
	access: final
	this-class: this-class
	super-class: Object
	interfaces: ()
	fields: fields
	methods: static-init,
	attributes: ()

-constants-class ClassFile(ctx to-java-ctx, name symbol, constants any-constant[])
	filtered-constants any-constant[] = constants filter x =>
		# TODO: remove union from any-constant once I've removed the old translate-to-java
		match x
		as single-constant-array _
			true
		as single-constant-record _
			true
		as single-constant-union _
			throw unreachable
	pool constants-builder = ()
	names mangled-names-with-constants = ctx.names, pool
	fields field_info[] = with out : build
		for x : filtered-constants
			forbid x.type is-empty-type || x.type is-wrapper
			out ~= do
				access-flags: static | final
				name: names constant-name x
				descriptor: names descriptor-for-field-type x.type
				attributes: ()
	this-class = pool class_ name
	static-init method_info = do
		code = with out : pool build-code
			expr-ctx expr-ctx = ctx, pool, this-class, (), (), (), ()
			for constant : filtered-constants
				forbid constant.type is-empty-type || constant.type is-wrapper
				out init-constant expr-ctx, constant
			out return void
		access-flags: static | final | synthetic
		name: names clinit
		descriptor: names init-no-args-descriptor
		attributes: code,
	Object = names java-Object
	constant-pool: pool finish
	access: final
	this-class: this-class
	super-class: Object
	interfaces: ()
	fields: fields
	methods: static-init,
	attributes: ()

-init-constant void(out code-builder, ctx expr-ctx, constant any-constant) # TODO: does this really need an expr-ctx? -----------------
	assert ctx.stack is-empty
	match constant
	as single-constant-array x
		element = x element-type
		if element is-nat8 && x.elements.size > 16
			resource = ctx.ctx add-resource for e : x elements
				e.integral-value!.as-unsigned to
			out ldc ctx.this-class
			out ldc do out.constants string-ref resource
			out invokevirtual ctx.names.java-Class-getResourceAsStream
			out invokevirtual ctx.names.java-InputStream-readAllBytes
			ctx pushed x.array-type
		else
			out make-array ctx, x.elements.size, x.array-type, x.element-type, i =>
				out push-constant ctx, x.elements[i], x.element-type
	as single-constant-record x
		out new-record ctx, x.record-type, (i, field) =>
			out push-constant ctx, x.args[i], field.type
	as single-constant-union _
		throw unreachable
	out putstatic do ctx.names constant-field constant
	ctx must-pop constant.type
	assert ctx.stack is-empty

-emit-unreachable void(out code-builder, names mangled-names-with-constants)
	Error = names java-Error
	out makenew Error
	out dup32
	out invokespecial do names init-no-args Error
	out athrow

-new-record void
	out code-builder
	ctx expr-ctx
	record-type concrete-type
	emit-arg void mut(i nat, field concrete-field)
do
	record_ = record-type.body concrete-record!
	fields = record_ fields
	if record-type is-empty-type
		before = ctx.stack size
		for i, field : fields with-index
			emit-arg[i, field]
		ctx.stack.size is before
	elif field ?= record_ as-wrapper
		emit-arg[0, field]
		ctx must-refine field.type, record-type
	else
		out makenew do ctx.names class_ record-type
		ctx pushed record-type
		out dup32
		ctx pushed record-type
		for i, field : fields with-index
			emit-arg[i, field]
			ctx must-peek field.type
		out invokespecial do ctx.names record-init-reference record-type
		for field : fields reverse
			ctx must-pop field.type
		ctx must-pop record-type
		ctx must-peek record-type

-make-array void
	out code-builder
	ctx expr-ctx
	size nat
	array-type concrete-type
	element-type concrete-type
	emit-element void mut(i nat)
do
	out iconst size.to
	out new-array-for-type ctx, element-type
	ctx pushed array-type
	for i : 0::nat .. size
		out dup32
		ctx pushed array-type
		out iconst i.to
		ctx pushed ctx.program.nat32
		emit-element[i]
		out astore element-type.as-runtime-type
		ctx must-pop element-type
		ctx must-pop ctx.program.nat32
		ctx must-pop array-type
	ctx must-peek array-type

-push-constant void(out code-builder, ctx expr-ctx, constant constant, type concrete-type)
	match type body
	as concrete-builtin-type x
		out push-constant-builtin ctx, constant, type, x
		ctx pushed type
	as concrete-enum x
		out push-constant-integral x.storage_, constant
		ctx pushed type
	as concrete-flags x
		out push-constant-integral x.storage_, constant
		ctx pushed type
	as concrete-record _
		guard type !is-empty-type
		if field ?= type as-wrapper
			wrapped = field type
			match constant
			as constant-record cr
				inner = ctx.program.all-constants.records[type]![cr] only
				out push-constant ctx, inner, wrapped
				ctx must-refine field.type, type
			as constant-gc-safe-value
				out push-constant ctx, constant-gc-safe-value, wrapped
				ctx must-refine field.type, type
			else
				throw unreachable
		else
			match constant
			as constant-record r
				out getstatic do ctx.names constant-record-field type, r
			as constant-gc-safe-value
				out aconst_null
			as constant-symbol x
				out getstatic do ctx.names constant-symbol-field ctx.program.symbol, x.index
			else
				throw unreachable
			ctx pushed type
	as concrete-union _
		match constant
		as constant-union u
			value = ctx.program.all-constants.unions[type]![u]
			out new-union ctx, type, value.member-index, case-type =>
				out push-constant ctx, value.member, case-type
		as constant-gc-safe-value
			out aconst_null
			ctx pushed type
		else
			throw unreachable
	as concrete-type-body-deferred
		throw unreachable

-new-union void
	out code-builder
	ctx expr-ctx
	type concrete-type
	member-index nat
	emit-member void mut(case-type concrete-type)
do
	case-type = type.body.concrete-union!.members[member-index]
	emit-member-object void mut() = () =>
		emit-member[case-type]
		out box ctx, case-type, type
	repr = ctx.ctx union-representation type
	match repr
	as direct
		emit-member-object[]
	as sealed-interface
		emit-member-object[]
	as switch
		emit-member-object[]
		local = ctx next-local-index
		out astore local
		union-class = ctx.names class_ type
		out makenew union-class
		out dup32
		out push-constant-integral nat32, member-index.integral-value
		out aload local
		out invokespecial do ctx.names init-union-switch union-class
	as nullable
		match member-index
		as 0
			emit-member[case-type] # for the side effect
			out aconst_null
			ctx pushed type
		as 1
			emit-member-object[]
		else
			throw unreachable

-push-constant-builtin void
	out code-builder
	ctx expr-ctx
	constant constant
	type concrete-type
	builtin_ concrete-builtin-type
do
	array void mut() = () =>
		match constant
		as constant-array x
			out getstatic do ctx.names constant-array-field type, x
		as constant-gc-safe-value
			out aconst_null
		else
			throw unreachable
	match builtin_ kind
	as array
		if type.array-element-type is-empty-type
			ca = constant constant-array!
			elements = ctx.ctx.program.all-constants.arrs[ca type-index].constants[ca index] # TODO: have a helper function for this!
			out push-constant-integral nat32, elements.size.integral-value
		else
			array[]
	as bool
		out push-constant-integral int8, constant
	as char8
		out push-constant-integral int8, constant
	as char32
		out push-constant-integral int32, constant
	as float32
		out fconst constant.constant-float!.value.to
	as float64
		out dconst constant.constant-float!.value
	as future
		throw unreachable
	as int8
		out push-constant-integral int8, constant
	as int16
		out push-constant-integral int16, constant
	as int32
		out push-constant-integral int32, constant
	as int64
		out push-constant-integral int64, constant
	as java-any
		assert _ ?= constant constant-gc-safe-value
		out aconst_null
	as java-exclusion
		throw unreachable
	as js-any
		throw unreachable
	as fun-data
		throw unreachable
	as fun-mut
		throw unreachable
	as fun-shared
		throw unreachable
	as mut-array
		throw unreachable
	as mut-slice
		array[]
	as nat8
		out push-constant-integral nat8, constant
	as nat16
		out push-constant-integral nat16, constant
	as nat32
		out push-constant-integral nat32, constant
	as nat64
		out push-constant-integral nat64, constant
	as option
		throw unreachable
	as void
		()
	as weak-ref
		assert _ ?= constant constant-gc-safe-value
		out aconst_null

-push-constant-integral void(out code-builder, type integral-type, constant constant)
	value = match constant
	as integral-value x
		x as-signed
	as constant-gc-safe-value
		0
	else
		throw unreachable
	if type is-64-bit
		out lconst value
	else
		# Use 'wrap-to' instead of 'to' since we may actually be dealing with an unsigned type
		out iconst value.wrap-to

-is-64-bit bool(a integral-type)
	match a to-signed
	as int8
		false
	as int16
		false
	as int32
		false
	as int64
		true

-translate-type void(ctx to-java-ctx, type concrete-type)
	constants constants-builder = ()
	names mangled-names-with-constants = ctx.names, constants
	super-class = match type source
	as concrete-type-source-bogus
		names java-Object
	as concrete-type-source-inst inst
		if inst.decl.sum-type-memberships exists x => x.sum-type == ctx.model-program.common-types.exception
			names java-Throwable
		else
			names java-Object
	interface-structs = ctx.union-info.type-to-interfaces[type] ?? ()
	interfaces class-reference[] = for x : interface-structs; names class_ x
	this-class-name = names class-name type
	this-class = names class_ type

	method-impls method_info[] = with out : build
		all-supertypes = if type in ctx.union-info.exception-case-types
			ctx.program.exception ~ interface-structs
		else
			interface-structs
		for interface_ : all-supertypes
			if (ctx union-representation interface_) == sealed-interface
				case-index = interface_.body.concrete-union!.members index-of! type
				# Implement the case-type-index-method
				out ~= names case-index-method-impl interface_, case-index
			info = ctx.program.method-impls[interface_] ?? ()
			unless info is-empty
				for method, impl : info.methods zip info.cases[type]!
					out ~= ctx method-impl constants, method, impl

	class_ ClassFile? = match type body
	as concrete-builtin-type x
		lambda ClassFile mut() = () =>
			assert method-impls is-empty : todo
			names lambda-class type, this-class, super-class, interfaces
		match x kind
		as array
			()
		as fun-data
			lambda[]
		as fun-mut
			lambda[]
		as fun-shared
			lambda[]
		as void
			# Can't use java.lang.Void since that has no instances
			names record-class type, false, (), this-class-name, this-class, super-class, interfaces, method-impls
		else
			() # TODO: could use a boxing-record for unsigned integer types ........................................................
	as concrete-enum _
		# TODO: we only need the boxing class if an enum is used in a union (including Option) -----------------------------
		names boxing-record type, super-class, interfaces, method-impls
	as concrete-flags _
		# TODO: we only need the boxing class if an enum is used in a union (including Option) -----------------------------
		names boxing-record type, super-class, interfaces, method-impls
	as concrete-record x
		names record-class type, x.is-wrapper, x.fields, this-class-name, this-class, super-class, interfaces, method-impls
	as concrete-union _
		method-decls method_info[] = with out : build
			for m : ctx.program.method-impls[type]?.methods ?? ()
				if (ctx.union-info java-method-representation m) == instance
					out ~= names interface-method-decl m
		all-methods = method-decls ~~ method-impls
		match ctx union-representation type
		as direct
			()
		as sealed-interface
			names union-sealed-interface this-class, super-class, interfaces, all-methods, do names case-index-method-name type
		as switch
			assert all-methods is-empty : todo
			names union-switchable this-class, super-class, interfaces
		as nullable
			()
	as concrete-type-body-deferred
		throw unreachable
	if x ?= class_
		ctx add-class this-class-name, x

-interface-method-decl method_info(names mangled-names-with-constants, method concrete-fun)
	access-flags: public | abstract_
	name: names instance-method-name method
	descriptor: names instance-method-descriptor method
	attributes: ()

| Creates the instance method that implements an interface method by calling a static function
-method-impl method_info(ctx to-java-ctx, constants constants-builder, method concrete-fun, impl concrete-fun?)
	names mangled-names-with-constants = ctx.names, constants
	code = with out : constants build-code
		assert i ?= impl : todo # TODO: generate code that will throw an error --------------------------------------------------
		java-param-index mut nat = 0
		for index, param : method.params with-index
			if index == 0
				out aload 0
				out unbox-if-necessary ctx, i.params[0].type
			else
				forbid index == 0 && param.type is-wrapper : todo # Need to unwrap it in this case ----------------------
				out xload param.type.as-runtime-type, java-param-index
			java-param-index +:= param.type number-of-locals
		out call-concrete-fun names, i
		out return method.return-type.as-runtime-type
	access-flags: public | final
	name: names instance-method-name method
	descriptor: names instance-method-descriptor method
	attributes: code,

-lambda-class ClassFile
	names mangled-names-with-constants
	type concrete-type
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
do
	init = names record-initializer super-class, (), names.init-no-args-descriptor
	call method_info = do
		access-flags: abstract_
		name: names call
		descriptor: names lambda-call-descriptor type
		attributes: ()
	constant-pool: names.constants finish
	access: abstract_
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: ()
	methods: init, call
	attributes: ()

-union-sealed-interface ClassFile
	names mangled-names-with-constants
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
	methods method_info[]
	case-type-method-name utf8-reference
do
	all-methods = methods ~ do
		access-flags: public | abstract_
		name: case-type-method-name
		descriptor: names case-index-method-descriptor
		attributes: ()
	assert interfaces is-empty
	constant-pool: names.constants finish
	access: interface_ | abstract_
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: ()
	methods: all-methods
	attributes: ()

-case-index-method-impl method_info(names mangled-names-with-constants, sum-type concrete-type, index nat)
	code = with out : names.constants build-code
		out iconst index.to
		out return T_INT
	access-flags: public | final
	name: names case-index-method-name sum-type
	descriptor: names case-index-method-descriptor
	attributes: code,

-call-case-index void(out code-builder, ctx expr-ctx, union-type concrete-type)
	out invokeinterface (ctx.names case-index-method union-type), 1

-union-switchable ClassFile
	names mangled-names-with-constants
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
do
	constants = names constants
	kind field_info = do
		access-flags: final
		name: names switchable-kind-name
		descriptor: names switchable-kind-descriptor
		attributes: ()
	kind-field = names switchable-kind-field this-class
	value field_info = do
		access-flags: final
		name: names value
		descriptor: names java-Object-descriptor
		attributes: ()
	value-field = names switchable-value-field this-class
	constructor method_info = do
		code Code_attribute = with out : constants build-code
			out aload 0
			out invokespecial do names init-no-args super-class
			out aload 0
			out xload T_INT, 1
			out putfield kind-field
			out aload 0
			out aload 2
			out putfield value-field
			out return void
		access-flags: ()
		name: names init
		descriptor: names init-union-switch-descriptor
		attributes: code,
	constant-pool: constants finish
	access: final
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: kind, value
	methods: constructor,
	attributes: ()

-record-class ClassFile
	names mangled-names-with-constants
	type concrete-type
	is-wrapper bool
	concrete-fields concrete-field[]
	this-class-name symbol
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
	method-impls method_info[]
do
	constants = names constants
	fields field_info[] = if type is-empty-type
		(constants instance-field this-class-name),
	else
		with out : build
			for field : concrete-fields
				guard field.type !is-empty-type
				out ~= do
					access-flags: field.is-mutable ? () : final
					name: names record-field-name field
					descriptor: names record-field-descriptor field
					attributes: ()
	methods method_info[] = with methods-out : build
		field-refs (field-reference, java-runtime-type)[] = with out : build
			for x : concrete-fields
				# TODO: we should just not concretize empty fields --------------------------------------------------------------
				guard x.type !is-empty-type
				out ~= (names record-field type, x), x.type.as-runtime-type
		methods-out ~= names record-initializer super-class, field-refs, do
			names record-init-descriptor concrete-fields
		if type is-empty-type
			methods-out ~= names clinit-for-instance-field this-class-name, this-class
		elif is-wrapper
			methods-out ~= names make-valueOf type
			if p ?= concrete-fields.only.type as-java-primitive-type
				field = concrete-fields only
				field-ref = names record-field type, field
				methods-out ~= names make-getValue field-ref, p # TODO: it's wasteful to always generate this ...................................................
		methods-out ~~= method-impls
	constant-pool: constants finish
	access: final
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: fields
	methods: methods
	attributes: ()

-instance-field field_info(constants constants-builder, this-class-name symbol)
	access-flags: final | static
	name: constants["instance"]
	descriptor: constants["L{this-class-name};"]
	attributes: ()
-clinit-for-instance-field method_info(names mangled-names-with-constants, this-class-name symbol, this-class class-reference)
	class-init-code Code_attribute = with out : names.constants build-code
		out makenew this-class
		out dup32
		out invokespecial do names init-no-args this-class
		out putstatic do names instance-field this-class, this-class-name
		out return void
	access-flags: static
	name: names clinit
	descriptor: names.constants["()V"]
	attributes: class-init-code,

-record-initializer method_info
	names mangled-names-with-constants
	super-class class-reference
	fields (field-reference, java-runtime-type)[]
	descriptor utf8-reference
do
	code = with out : names.constants build-code
		out aload 0
		out invokespecial do names init-no-args super-class
		local-index mut nat = 1 # 0 is the object
		for field, field-type : fields
			out aload 0
			out xload field-type, local-index
			local-index +:= field-type number-of-locals
			out putfield field
		out return void
	access-flags: ()
	name: names.constants["<init>"]
	descriptor: descriptor
	attributes: code,

-boxing-record ClassFile
	names mangled-names-with-constants
	type concrete-type
	super-class class-reference
	interfaces class-reference[]
	methods method_info[]
do
	constants = names constants
	this-class = names class_ type
	primitive = type as-java-primitive-type!
	descriptor = names primitive-descriptor primitive
	field field_info = do
		access-flags: final
		name: names value
		descriptor: descriptor
		attributes: ()
	field-ref = names boxed-class-value type
	constructor-descriptor = names boxed-class-init-descriptor type
	constructor method_info = do
		code = with out : constants build-code
			out aload 0
			out invokespecial do names init-no-args super-class
			out aload 0
			out xload type.as-runtime-type, 1
			out putfield field-ref
			out return void
		access-flags: ()
		name: names init
		descriptor: constructor-descriptor
		attributes: code,
	valueOf = names make-valueOf type
	getValue = names make-getValue field-ref, primitive
	constant-pool: constants finish
	access: final
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: field,
	methods: (constructor, valueOf, getValue)::method_info[] ~~ methods
	attributes: ()

-make-valueOf method_info
	names mangled-names-with-constants
	type concrete-type
do
	this-class = names class_ type
	# TODO: this should have a cache. For enums, statically generate all members. For flags or integrals, just cache the 10 most recent?
	code = with out : names.constants build-code
		out makenew this-class
		out dup32
		out xload type.as-runtime-type, 0
		out invokespecial do names boxed-class-init type
		out return reference-type
	access-flags: static
	name: names valueOf
	descriptor: names boxed-class-valueOf-descriptor type
	attributes: code,

-make-getValue method_info(names mangled-names-with-constants, field-ref field-reference, primitive java-primitive-type)
	code = with out : names.constants build-code
		out aload 0
		out getfield field-ref
		out return primitive
	access-flags: final
	name: names primitive-getter-name primitive
	descriptor: names primitive-getter-descriptor primitive
	attributes: code,

-new-array-for-type void(out code-builder, ctx expr-ctx, element-type concrete-type)
	match element-type as-runtime-type
	as void
		# Void array represented as the size which is already on stack
		()
	as java-primitive-type p
		out newarray p
	as reference-type
		if field ?= element-type as-wrapper
			out new-array-for-type ctx, field.type
		else
			out anewarray do ctx.names class_ element-type

# Pushes a reference to the Class for this type
-push-unboxed-class-reference void(out code-builder, names mangled-names-with-constants, type concrete-type)
	match type as-runtime-type
	as void
		out getstatic names.java-Void-TYPE
	as java-primitive-type _
		out getstatic do names java-primitive-TYPE type
	as reference-type
		out ldc do names class_ type

-number-of-locals nat(type concrete-type)
	type.as-runtime-type number-of-locals
-number-of-locals nat(type java-runtime-type)
	match type
	as void
		0
	as java-primitive-type p
		match p
		as T_DOUBLE
			2
		as T_LONG
			2
		else
			1
	else
		1

-box void(out code-builder, ctx expr-ctx, in-type concrete-type, out-type concrete-type)
	assert out-type.as-runtime-type == reference-type
	if in-type is-java-primitive-type || in-type is-wrapper
		out invokestatic do ctx.names boxed-class-valueOf in-type
	elif in-type is-empty-type
		out getstatic do ctx.names instance-field in-type
	ctx must-refine in-type, out-type

-cast-and-unbox-if-necessary void(out code-builder, ctx expr-ctx, type concrete-type)
	guard type !is-java-any
	if type is-empty-type
		out pop reference-type
	else
		out checkcast do ctx.names class_ type
		out unbox-if-necessary ctx.ctx, type

-unbox-if-necessary void(out code-builder, ctx to-java-ctx, type concrete-type)
	names mangled-names-with-constants = ctx.names, out.constants
	if p ?= type as-java-primitive-type
		out invokevirtual do names primitive-unboxer type, p
	elif field ?= type as-wrapper
		out getfield do names record-field type, field # TODO: doesn't this need to apply recursively? ----------------------

-translate-funs-for-uri void(ctx to-java-ctx, uri uri, funs concrete-fun[], vars concrete-var[])
	constants constants-builder = ()
	names mangled-names-with-constants = ctx.names, constants
	this-class-name = names module-class-name uri
	this-class = names module-class uri
	fields field_info[] = for var : vars
		match var kind
		as thread-local_
			throw todo
		as global_
			access-flags: static
			name: names var-name var
			descriptor: names descriptor-for-field-type var.type
			attributes: ()
	methods method_info[] = with methods-out : build
		for fun : funs
			guard (ctx.union-info java-method-representation fun) == static
			expr-ctx expr-ctx = ctx, constants, this-class, fun, (), (), (fun.params filter x => x.type !is-empty-type)
			# error log "GONNA TRANSLATE FUN {ctx.show-ctx.show show-concrete-fun-sig fun, false}" # ---------------------------------------------------------------------------------------------------------------------
			code = with out : constants build-code
				out emit-fun-body expr-ctx, fun
			expr-ctx verify-expr-ctx-finished fun.return-type, fun.params
			methods-out ~= do
				access-flags: static
				name: names fun-name fun
				descriptor: names static-method-descriptor fun
				attributes: code,
		methods-out ~= ctx init-vars constants, this-class, vars
	Object = names java-Object
	source SourceFile_attribute = names.SourceFile, constants[uri to]
	ctx add-class this-class-name, do		
		constant-pool: constants finish
		access: ()
		this-class: this-class
		super-class: Object
		interfaces: ()
		fields: fields
		methods: methods
		attributes: source,

-init-vars method_info(ctx to-java-ctx, constants constants-builder, this-class class-reference, vars concrete-var[])
	names mangled-names-with-constants = ctx.names, constants
	expr-ctx expr-ctx = do
		ctx: ctx
		constants: constants
		this-class: this-class
		cur-fun: ()
		closure: ()
		has-this: false
		params: ()
	code = with out : constants build-code
		for var : vars
			match var kind
			as thread-local_
				throw todo
			as global_
				out emit-and-continue expr-ctx, var.initializer
				out putstatic do names var-field var
				expr-ctx must-pop var.type
			assert expr-ctx.stack is-empty
		out return void
	access-flags: static | final
	name: names clinit
	descriptor: names init-no-args-descriptor
	attributes: code,

-verify-expr-ctx-finished void(expr-ctx expr-ctx, return-type concrete-type, params concrete-local[])
	expr-ctx must-pop return-type
	unless expr-ctx.stack is-empty
		error log "You left something on the stack: "
		for x : expr-ctx.stack
			error log "{expr-ctx.ctx.show-ctx.show show-concrete-type x}"
	assert expr-ctx.stack is-empty
	expr-ctx.locals.size is (params count x => x.type !is-empty-type)

-emit-fun-body void(out code-builder, ctx expr-ctx, fun concrete-fun)
	names = ctx names
	match fun body
	as concrete-fun-body-builtin x # TODO: this should go away, always use the concrete-expr form
		args concrete-expr[] = for param : fun params
			param.type, fun.range, param.local-get-concrete-expr
		out translate-builtin ctx, x.kind, x.type-args, fun.return-type, args
		out return fun.return-type.as-runtime-type
	as concrete-expr x
		# info log "GONNA EMIT FUNCTION {ctx.ctx.show-ctx.show show-concrete-fun-sig fun, false}" -----------------------------------
		out emit-expr ctx, return, x
	as concrete-fun-body-method _
		union_ = fun.params[0] type
		info = ctx.program.method-impls[union_]!
		cases = info cases
		method-index = info.methods index-of! fun

		load-rest-params void mut() = () =>
			local-index mut nat = 1
			for param : fun.params[1 .. end]
				out xload param.type.as-runtime-type, local-index
				local-index +:= param.type number-of-locals
		match ctx union-representation union_
		as direct
			jump mut deferred-jump? = ()
			for case-index, (case-type, case-impls) : cases with-index
				is-last-case = case-index == cases.size - 1
				if j ?= jump
					j jumps-to-here out, ctx.cur-stack-frame
				case-impl = case-impls[method-index] ?? throw todo # TODO: if missing, emit code that throws an exception -----------------------
				unless is-last-case
					out aload 0
					out instanceof do names class_ case-type
					jump := out ifeq
				out aload 0
				out cast-and-unbox-if-necessary ctx, case-type
				load-rest-params[]
				out call-concrete-fun names, case-impl
				out return fun.return-type.as-runtime-type
			ctx pushed fun.return-type
		as sealed-interface
			throw unreachable
		as switch
			out aload 0
			out get-switchable-kind-nat32 ctx, union_
			jump-to-case, jump-to-default = out tableswitch 0 .. cases.size.to
			for case-index, (case-type, case-impls) : cases with-index
				jump-to-case[case-index] jumps-to-here out, ctx.cur-stack-frame
				out aload 0
				out get-switchable-value ctx, union_
				out cast-and-unbox-if-necessary ctx, case-type
				load-rest-params[]
				case-impl = case-impls[method-index] ?? throw todo
				out call-concrete-fun names, case-impl
				out return fun.return-type.as-runtime-type
			jump-to-default jumps-to-here out, ctx.cur-stack-frame
			out emit-unreachable names
			ctx pushed fun.return-type
		as nullable
			throw todo
	as concrete-fun-body-deferred
		throw unreachable

-expr-pos union(continue_, jump, return) mut
| When the code is done, it should jump to the end (which will be determined after compiling the whole expression)
-continue_ record
-jump record mut
	jumps deferred-jump mut[]
| When the code is done, it should return from the function
| WARN: The returned type may be different from this expression's type.
| Maybe this expression is void but the value that was pushed on the stack before should be returned.
-return record

-emit-and-continue void(out code-builder, ctx expr-ctx, expr concrete-expr)
	out emit-expr ctx, continue_, expr

# TODO: the last use of inner-pos could be different, since if can just continue with no jump instruction ......................
-with-inner-pos void(out code-builder, ctx expr-ctx, pos expr-pos, f void mut(inner-pos expr-pos))
	match pos
	as continue_
		jump jump = (),
		f[jump]
		for j : jump jumps
			j jumps-to-here out, ctx.cur-stack-frame
	as jump _
		f[pos]
	as return
		f[pos]

-handle-pos void(out code-builder, pos expr-pos, type concrete-type)
	match pos
	as continue_
		()
	as jump x
		x.jumps ~= out goto
	as return
		out return type.as-runtime-type

-call-concrete-fun void(out code-builder, names mangled-names-with-constants, fun concrete-fun)
	match names.union-info java-method-representation fun
	as instance
		count = fun.params sum param =>
			param.type.as-runtime-type stack-entry-count
		out invokeinterface (names interface-method-ref fun), count.to
	as static
		out invokestatic do names static-method-ref fun

-emit-expr void(out code-builder, ctx expr-ctx, pos expr-pos, a concrete-expr)
	names = ctx names
	out mark-line-number ctx.ctx.show-ctx.line-and-character-getters[a range].range.start.line.to + 1
	type = a type
	match a kind
	as array-op-concrete-expr x
		out emit-for-loop ctx, pos, a, x
	as builtin-concrete-expr x
		out translate-builtin ctx, x.fun, x.type-args, type, x.args
		out handle-pos pos, type
	as call-concrete-expr x
		match x.called body
		as concrete-fun-body-builtin b
			out translate-builtin ctx, b.kind, b.type-args, type, x.args
		else
			out function-like ctx, type, x.args, () =>
				out call-concrete-fun names, x.called
		out handle-pos pos, type
	as cast-concrete-expr x
		# This is currently only used to cast an enum to an integral. In Java we just use integrals for enums directly. --------
		out emit-expr ctx, pos, x.inner
		ctx must-refine x.inner.type, type
	as constant x
		out push-constant ctx, x, type
		out handle-pos pos, type
	as create-array-concrete-expr x
		out make-array ctx, x.args.size, type, type.array-element-type, i =>
			out emit-and-continue ctx, x.args[i]
		out handle-pos pos, type
	as create-record-concrete-expr x
		out new-record ctx, type, (i, _) =>
			out emit-and-continue ctx, x.args[i]
		out handle-pos pos, type
	as create-union-concrete-expr x
		out new-union ctx, type, x.member-index, _ =>
			out emit-and-continue ctx, x.arg
		out handle-pos pos, type
	as drop-concrete-expr x
		out emit-and-continue ctx, x.arg
		out pop x.arg.type.as-runtime-type
		ctx must-pop x.arg.type
		out handle-pos pos, type
	as finally-concrete-expr x
		out with-inner-pos ctx, pos, inner-pos =>
			start-pc = out next-index
			out emit-and-continue ctx, x.below # Leave the result on the stack
			end-pc = out next-index
			unless x.below always-throws # No point compiling the happy path if it always throws
				out emit-and-continue ctx, x.right
				unless x.right always-throws
					out handle-pos inner-pos, type
			if start-pc == end-pc
				# Edge case: empty code below the 'finally'. Since empty code can't throw, don't handle exceptions
				()
			else
				# TODO: there might be a more efficient way than to emit it twice ...................................................
				ctx must-pop type
				exception = ctx.program exception
				ctx pushed exception
				out add-to-exception-table start-pc, end-pc, (names class_ exception), ctx.cur-stack-frame
				out emit-and-continue ctx, x.right
				# 'x.right' is void, so the exception should be at the top of the stack.
				ctx must-pop exception
				unless x.right always-throws
					out athrow
				# Treat the stack effect as if it was successful
				ctx pushed type
	as if-concrete-expr x
		out emit-and-continue ctx, x.cond
		out with-inner-pos ctx, pos, inner-pos =>
			jump-if-false = out ifeq
			ctx must-pop ctx.program.bool
			out emit-expr ctx, inner-pos, x.then
			ctx must-pop type # The value is not actually popped, be we are now doing the other branch where it wasn't pushed in the first place
			jump-if-false jumps-to-here out, ctx.cur-stack-frame
			out emit-expr ctx, inner-pos, x.else_
			ctx must-peek type
	as let-concrete-expr x
		out emit-and-continue ctx, x.value
		out emit-with-local ctx, x.local, pos, x.then
	as lambda-concrete-expr x
		class-name = ctx.ctx create-lambda-implementation-class a.range.uri, ctx.cur-fun-for-debug!, type, x
		class_ = out.constants class_ class-name
		# All we do here is call 'new' or 'instance'
		if x.closure is-empty
			out getstatic do names instance-field class_, class-name
		else
			out makenew class_
			out dup32
			for local : x closure
				out get-local ctx, local
			out invokespecial do names lambda-init-reference class_, x
		ctx pushed type
		out handle-pos pos, type
	as local-get-concrete-expr x
		out get-local ctx, x.local
		ctx pushed type
		out handle-pos pos, type
	as local-set-concrete-expr x
		out emit-and-continue ctx, x.value
		local-type = x.local type
		unless local-type is-empty-type
			match ctx explain-local x.local
			as nat index
				out xstore local-type.as-runtime-type, index
			as field-reference field
				out putfield field
		ctx must-pop local-type
		out handle-pos pos, type
	as loop-concrete-expr x
		###
		loop
			if x
				break
			else
				continue
		==>
		loop:
		x
		ifeq goto else_
		goto end
		else_:
		goto loop
		end:
		###
		prev-loop-pos = ctx loop-pos
		ctx.loop-pos := out can-jump-back-to-here ctx.cur-stack-frame
		out emit-expr ctx, pos, x.body
		ctx.loop-pos := prev-loop-pos
	as loop-break-concrete-expr x
		out emit-expr ctx, pos, x.value
	as loop-continue-concrete-expr
		out go-back-to ctx.loop-pos!
		ctx pushed type # Treat the stack effect as if the loop completed
	as match-enum-or-integral-concrete-expr x
		# TODO: If <= 3 cases, it's probably better to just use ifeq instructions --------------------------------------------------------------------
		# TODO: if integer values are dense, use a table switch
		# TODO: handle integers larger than 2>>32
		out emit-and-continue ctx, x.matched
		out with-inner-pos ctx, pos, inner-pos =>
			matched-type = x matched-integral-type
			is-signed = matched-type is-signed
			ok = x.case-values every value =>
				if is-signed
					value.as-signed fits-in-int32
				else
					value.as-unsigned fits-in-nat32
			assert ok : todo # If some values don't fit in 32 bits, we can't use a switch
			# IF it's a 64-bit type: First check that it's in the range. If not, jump to default.
			jump-to-pop-then-default deferred-jump? = match matched-type integral-type ?? nat8
			as nat64
				out dup64
				out invokestatic names.crow-fits-in-nat32
				# If false, go to an instruction just before 'default' that pops
				res = out ifeq
				out l2i
				res
			as int64
				out dup64
				out invokestatic names.crow-fits-in-int32
				res = out ifeq
				out l2i
				res
			else
				()
			assert x.case-values is-sorted
			jump-to-case, jump-to-default = if x.case-values is-range
				out tableswitch 0 .. x.case-values.size.to
			else
				out lookupswitch for value : x case-values
					value.as-signed to
			ctx must-pop x.matched.type
			for target, expr : jump-to-case zip x.case-exprs
				target jumps-to-here out, ctx.cur-stack-frame
				out emit-expr ctx, inner-pos, expr
				ctx must-pop type
			if j ?= jump-to-pop-then-default
				# In this case it will still have the long value on the stack
				ctx pushed x.matched.type
				j jumps-to-here out, ctx.cur-stack-frame
				out pop T_LONG
				ctx must-pop x.matched.type
			jump-to-default jumps-to-here out, ctx.cur-stack-frame
			if e ?= x else_
				out emit-expr ctx, inner-pos, e
			else
				out emit-unreachable names
				ctx pushed type
	as match-string-like-concrete-expr x
		out emit-and-continue ctx, x.matched
		matched-type = x.matched type
		out with-inner-pos ctx, pos, inner-pos =>
			jump mut deferred-jump? = ()
			for index, case_ : x.cases with-index
				if j ?= jump
					j jumps-to-here out, ctx.cur-stack-frame
				is-last-case = index == x.cases.size - 1
				unless is-last-case
					out dup32
					ctx pushed matched-type
				out emit-and-continue ctx, case_.value
				# TODO:PERF in the case of a 'string' or 'symbol' input, we could 'intern' and then just use refernce equality
				out call-concrete-fun names, x.equals
				ctx must-pop matched-type
				ctx must-pop matched-type
				# Jump to next if the equality test returned 0 (false)
				jump := out ifeq
				unless is-last-case
					# If the equality test returned 'true', discard the original string
					out pop reference-type
					ctx must-pop matched-type
				out emit-expr ctx, inner-pos, case_.then
				# Reset the stack to handle after the jump
				ctx must-pop type
				unless is-last-case
					ctx pushed matched-type

			jump! jumps-to-here out, ctx.cur-stack-frame
			out emit-expr ctx, inner-pos, x.else_
	as match-union-concrete-expr x
		out emit-match-union ctx, pos, type, x
	as record-field-get-concrete-expr x
		out emit-and-continue ctx, x.record_
		unless x.record_.type is-wrapper
			out getfield do names record-field x.record_.type, x.field
		ctx must-pop x.record_.type
		ctx pushed x.field.type
		out handle-pos pos, type
	as record-field-set-concrete-expr x
		out emit-and-continue ctx, x.record_
		out emit-and-continue ctx, x.value
		out putfield do names record-field x.record_.type, x.field
		ctx must-pop x.value.type
		ctx must-pop x.record_.type
		out handle-pos pos, type
	as seq-concrete-expr x
		locals-size = ctx.locals.size # TODO: remove some excessive checking ---------------------------------------------------------
		stack-size = ctx.stack.size
		out emit-and-continue ctx, x.first
		ctx.locals.size is locals-size
		ctx.stack.size is stack-size
		ctx.locals.size is locals-size
		out emit-expr ctx, pos, x.then
		ctx.locals.size is locals-size
		unless type is-empty-type
			ctx.stack.size is stack-size + 1
	as throw-concrete-expr x
		out emit-and-continue ctx, x.thrown
		ctx must-pop ctx.program.exception
		out athrow
		# Treat the stack effect as if it was successful
		ctx pushed type
	as try-concrete-expr x
		out with-inner-pos ctx, pos, inner-pos =>
			start = out next-index
			out emit-expr ctx, inner-pos, x.tried
			end = out next-index
			for exception-case-index, case_ : x.exception-member-indices zip x.catch-cases
				ctx must-pop type
				catch-type = ctx exception-case-type-from-index exception-case-index
				frame-before = ctx cur-stack-frame
				boxed-catch-type = names class_ catch-type
				out add-to-exception-table start, end, boxed-catch-type, do
					locals: frame-before locals
					stack: frame-before.stack ~ boxed-catch-type.Object_variable_info
				ctx pushed ctx.program.exception # just use an arbitrary type here, we're about to pop it
				out emit-with-unboxed-opt-local ctx, ctx.program.exception, case_.local, inner-pos, case_.then
	as try-let-concrete-expr x
		start = out next-index
		out emit-and-continue ctx, x.value
		end = out next-index
		out with-inner-pos ctx, pos, inner-pos =>
			out emit-with-opt-local ctx, x.local, x.value.type, inner-pos, x.then
			# TODO: this is very similar to the code for try-concrete-expr, share code! ---------------------------------------------
			ctx must-pop type
			catch-type = ctx exception-case-type-from-index x.exception-member-index
			frame-before = ctx cur-stack-frame
			boxed-catch-type = names class_ catch-type
			out add-to-exception-table start, end, boxed-catch-type, do
				locals: frame-before locals
				stack: frame-before.stack ~ boxed-catch-type.Object_variable_info
			ctx pushed ctx.program.exception # just use an arbitrary type here, we're about to pop it
			out emit-with-unboxed-opt-local ctx, ctx.program.exception, x.catch_.local, inner-pos, x.catch_.then
	as var-get-concrete-expr x
		match x.var kind
		as thread-local_
			throw todo
		as global_
			out getstatic do names var-field x.var
		ctx pushed type
		out handle-pos pos, type
	as var-set-concrete-expr x
		out emit-and-continue ctx, x.value
		match x.var kind
		as thread-local_
			throw todo
		as global_
			out putstatic do names var-field x.var
			ctx must-pop x.value.type
		out handle-pos pos, type
	as union-as-concrete-expr x
		out emit-and-continue ctx, x.union_
		cast void mut() = () =>
			out checkcast do names class_ x.case-type
			out unbox-if-necessary ctx.ctx, x.case-type
			ctx must-refine x.union_.type, x.case-type
			out handle-pos pos, type
		match ctx union-representation x.union_.type
		as direct
			cast[]
		as sealed-interface
			cast[]
		as switch
			# This is an unsafe operation, so no need to check the 'kind'
			out get-switchable-value ctx, x.union_.type
			cast[]
		as nullable
			out dup32
			match x member-index
			as 0
				# Get instance of the empty type
				throw todo
			as 1
				out invokevirtual names.crow-assert-non-null
			else
				throw unreachable
	as union-kind-concrete-expr x
		assert type.body.concrete-builtin-type!.kind == nat64
		out emit-and-continue ctx, x.union_
		union-type = x.union_ type
		check-instanceof void mut() = () =>
			# TODO: this should probably be emitted into a helper method?
			out with-inner-pos ctx, pos, inner-pos =>
				for case-index, case-type : x.union-members with-index
					out dup32
					out instanceof do names class_ case-type
					jump = out ifeq
					out pop reference-type
					out lconst case-index.to
					out handle-pos inner-pos, type
					jump jumps-to-here out, ctx.cur-stack-frame
				out pop reference-type # TODO:PERF the very last case could just not dup it ----------------------------------
				ctx must-pop union-type
				out emit-unreachable names
				ctx pushed type
		match ctx union-representation union-type
		as direct
			check-instanceof[]
		as sealed-interface
			out call-case-index ctx, union-type
			out i2l
			ctx must-pop union-type
			ctx pushed type
		as switch
			out get-switchable-kind-nat64 ctx, union-type
			ctx must-pop union-type
			ctx pushed type
		as nullable
			out invokestatic names.crow-one-if-not-null

-emit-for-loop void(out code-builder, ctx expr-ctx, pos expr-pos, a concrete-expr, x array-op-concrete-expr)
	names = ctx names
	type = a type
	out emit-and-continue ctx, x.input
	input-type = x.input type
	ctx must-pop input-type
	in-array local-index? = match x input-kind
	as array
		out begin-synthetic-local ctx, input-type
	as range
		()

	range-fields = if x.input-kind == range
		x.input.type.body.concrete-record! fields

	empty-out-elem = x.out-element is-empty-type
	output-kind = x output-kind a.type
	is-void = match output-kind
	as array
		false
	as void
		true

	nat32 = ctx.program nat32
	integral-type = match x input-kind
	as array
		nat32
	as range
		x in-element
	ir = integral-type as-runtime-type # TODO: NAME --------------------------------------------------------------------------------

	match x input-kind
	as array
		out iconst 0
	as range
		out dup32
		out getfield do names record-field input-type, range-fields[0]
	cur = out begin-synthetic-local ctx, integral-type

	match x input-kind
	as array
		out get-array-size x.in-element, in-array!
	as range
		# Don't dup, this finishes using the range
		out getfield do names record-field input-type, range-fields[1]
	end = out begin-synthetic-local ctx, integral-type

	match output-kind
	as void
		()
	as array
		out push-constant ctx, x.empty-out-array!, type
	out-array = out begin-synthetic-local ctx, type

	# If cur == end: goto bottom
	# TODO: helper function for this (compares two integrals) --------------------------------------------------------------
	out xload ir, cur
	out xload ir, end
	match ir java-primitive-type!
	as T_LONG
		out lcmp
	as T_INT
		out isub
	else
		throw unreachable
	goto-bottom = out ifeq

	# If non-empty: assign out-array to a non-empty array
	unless is-void
		out xload ir, end
		match x input-kind
		as array
			()
		as range
			# size is end - cur
			out xload ir, cur
			out xsub ir
		out checked-to-nat32 names, integral-type
		unless empty-out-elem
			out new-array-for-type ctx, x.out-element
		out xstore type.as-runtime-type, out-array
		ctx must-pop type

	out-offset local-index? = match x input-kind
	as array
		()
	as range
		unless is-void
			out xload ir, cur
			out begin-synthetic-local ctx, integral-type

	loop-body void mut() = () =>
		unless empty-out-elem
			out aload out-array
			ctx pushed type
			out xload ir, cur
			if o ?= out-offset
				out xload ir, o
				out xsub ir
			out unchecked-to-nat32 integral-type
			ctx pushed nat32
		match x input-kind
		as array
			unless x.in-element is-empty-type
				out aload in-array!
				out xload ir, cur
				out unchecked-to-nat32 integral-type
				out xaload x.in-element.as-runtime-type
				ctx pushed x.in-element
		as range
			out xload ir, cur
			ctx pushed integral-type
		# TODO: in the case of looping over a range, it could be more efficient to reuse 'cur' as the local for 'x.local' instead of copying it to a new local
		out emit-with-opt-local ctx, x.local, x.in-element, continue_, x.body
		unless empty-out-elem
			out astore x.out-element.as-runtime-type
			ctx must-pop x.out-element
			ctx must-pop nat32
			ctx must-pop type
	out loop-non-empty-range ctx, pos, type, integral-type, cur, end, loop-body, () => # TODO: now that there is only one caller of this, maybe I should inline it ....
		# If there is no return type, make sure the stack frame does not include locals (since it may be the same bytecode pos as the beginning stack frame of a loop)
		if o ?= out-offset
			ctx end-synthetic-local integral-type, o
		goto-bottom jumps-to-here out, ctx.cur-stack-frame
		unless is-void
			out xload type.as-runtime-type, out-array
			ctx pushed type
		ctx end-synthetic-local type, out-array
		ctx end-synthetic-local integral-type, end
		ctx end-synthetic-local integral-type, cur
		if i ?= in-array
			ctx end-synthetic-local input-type, i

-emit-match-union void(out code-builder, ctx expr-ctx, pos expr-pos, type concrete-type, x match-union-concrete-expr)
	out emit-and-continue ctx, x.matched
	matched-type = x.matched type
	ctx must-peek matched-type
	match ctx union-representation matched-type
	as direct
		out emit-match-union-using-instanceof ctx, pos, type, x
	as sealed-interface
		out emit-match-union-using-instanceof ctx, pos, type, x
	as switch
		out dup32
		out get-switchable-kind-nat32 ctx, matched-type
		out swap
		out get-switchable-value ctx, matched-type
		out swap
		ctx must-refine matched-type, ctx.program.java-any
		ctx pushed ctx.program.nat32
		out emit-match-union-using-switch ctx, pos, type, ctx.program.java-any, x
	as nullable
		out with-inner-pos ctx, pos, inner-pos =>
			null-case concrete-match-union-case, non-null-case concrete-match-union-case = if x.member-indices[0] == (0::nat,)
				x.member-indices is ((0::nat,), (1::nat,))
				x.cases only2
			else
				x.member-indices is ((1::nat,), (0::nat,))
				x.cases[1], x.cases[0]
			forbid _ ?= x else_

			out dup32
			jump = out ifnonnull
			# Null types are always empty types. Don't leave a 'null' on the stack, just pop it.
			out pop reference-type
			ctx must-pop matched-type
			out emit-expr ctx, inner-pos, null-case.then # ignore null-case.local since it is an empty type

			# Change the stack to have the state from before the jump
			ctx must-pop type
			ctx pushed matched-type
			jump jumps-to-here out, ctx.cur-stack-frame
			out emit-with-unboxed-opt-local ctx, matched-type, non-null-case.local, inner-pos, non-null-case.then

-emit-match-union-using-instanceof void(out code-builder, ctx expr-ctx, pos expr-pos, type concrete-type, x match-union-concrete-expr)
	# Note: I tested using a 'switch' on the 'case-index' method, but it didn't improve performance.
	matched-type = x.matched type
	out with-inner-pos ctx, pos, inner-pos =>
		for member-index, case_ : x.member-indices zip x.cases
			case-type = x.union_.members[member-index as-unsigned]
			# TODO: we could avoid the dup for the last case (see match-string-like-concrete-expr) --------------------
			out dup32
			out instanceof do ctx.names class_ case-type
			# Jump to next if the equality test returned 0 (false)
			jump = out ifeq
			# The case comsumes that matched value. The next case will still have it since it jumped over this.
			ctx must-refine matched-type, case-type
			out cast-and-unbox-if-necessary ctx, case-type
			out emit-with-opt-local ctx, case_.local, case-type, inner-pos, case_.then

			# Change the stack to have the state from before 'jump'
			ctx must-pop type
			ctx pushed matched-type
			jump jumps-to-here out, ctx.cur-stack-frame
		out pop reference-type
		ctx must-pop matched-type
		if e ?= x else_
			out emit-expr ctx, inner-pos, e
			ctx must-peek type
		else
			# TODO: If the type is 'exception' and we're calling 'show', we should call 'toString' in this case? -----------
			out emit-unreachable ctx.names
			# Treat the stack effect as if it was successful
			ctx pushed type

| Stack before calling this should be the value and its kind
-emit-match-union-using-switch void
	out code-builder
	ctx expr-ctx
	pos expr-pos
	type concrete-type
	matched-type concrete-type
	x match-union-concrete-expr
do
	out with-inner-pos ctx, pos, inner-pos =>
		# This consumes 'kind'
		ctx must-pop ctx.program.nat32
		jump-to-case, jump-to-default = out lookupswitch for index : x member-indices # TODO: use a table switch usually
			index.as-unsigned to
		for target, member-index, case_ : jump-to-case zip3 x.member-indices, x.cases
			target jumps-to-here out, ctx.cur-stack-frame
			case-type = x.union_.members[member-index as-unsigned]
			if l ?= case_ local # TODO: should I use a 'with-opt-local' helper? ----------------------------------------------------
				out cast-and-unbox-if-necessary ctx, case-type
				ctx must-refine matched-type, case-type
				out emit-with-local ctx, l, inner-pos, case_.then
			else
				out pop reference-type
				ctx must-pop matched-type
				out emit-expr ctx, inner-pos, case_.then

			# Change the stack to have the state from before 'jump'
			ctx must-pop type
			ctx pushed matched-type
		
		# default case
		jump-to-default jumps-to-here out,  ctx.cur-stack-frame
		out pop reference-type
		ctx must-pop matched-type
		if e ?= x else_
			out emit-expr ctx, inner-pos, e
			ctx must-peek type
		else
			out emit-unreachable ctx.names
			ctx pushed type

-xsub void(out code-builder, type java-runtime-type)
	match type java-primitive-type!
	as T_INT
		out isub
	as T_LONG
		out lsub
	else
		throw unreachable

-checked-to-nat32 void(out code-builder, names mangled-names-with-constants, integral-type concrete-type)
	match integral-type.as-runtime-type java-primitive-type!
	as T_LONG
		out invokestatic names.crow-nat32-from-nat64
	as T_INT
		()
	else
		throw unreachable
-unchecked-to-nat32 void(out code-builder, integral-type concrete-type)
	match integral-type.as-runtime-type java-primitive-type!
	as T_LONG
		out l2i
	as T_INT
		()
	else
		throw unreachable

| Caller should push two integrals 'cur' and 'end' on the stack before calling this.
-loop-non-empty-range void
	out code-builder
	ctx expr-ctx
	pos expr-pos
	type concrete-type
	integral-type concrete-type
	cur local-index
	end local-index
	loop-body void mut()
	after-loop void mut()
do
	###
	loop:
	<<loop body>>
	cur++
	if cur != end: goto loop
	###

	ir = integral-type as-runtime-type
	cur-and-end void mut() = () =>
		out xload ir, cur
		out xload ir, end
	is-64-bit = match ir java-primitive-type!
	as T_LONG
		true
	as T_INT
		false
	else
		throw unreachable

	loop_ = out can-jump-back-to-here ctx.cur-stack-frame
	loop-body[]

	out increment-integral cur, integral-type
	cur-and-end[]
	if is-64-bit
		out lcmp
		out ifne loop_
	else
		out if_icmpne loop_

	before = out next-index
	after-loop[]
	if out.next-index == before
		# Give it space for a stack frame after the loop
		out nop
	out handle-pos pos, type # TODO: then there is a double jump in some cases, improve? -------------------

-increment-integral void(out code-builder, local nat, integral-type concrete-type)
	java-type = integral-type as-runtime-type
	out xload java-type, local
	match java-type java-primitive-type!
	as T_LONG
		out lconst 1
		out ladd
	as T_INT
		out iconst 1
		out iadd
	else
		throw unreachable
	out xstore java-type, local

-get-local void(out code-builder, ctx expr-ctx, local concrete-local)
	guard local.type !is-empty-type
	match ctx explain-local local
	as nat index
		out xload local.type.as-runtime-type, index
	as field-reference field
		out aload 0
		out getfield field

-create-lambda-implementation-class symbol
	ctx to-java-ctx
	uri uri
	containing-fun concrete-fun
	lambda-type concrete-type
	a lambda-concrete-expr
do
	constants constants-builder = ()
	names mangled-names-with-constants = ctx.names, constants
	this-class-name = ctx.names lambda-impl-class-name containing-fun, ctx.next-lambda-index
	ctx.next-lambda-index +:= 1
	this-class = constants class_ this-class-name
	closure field-reference[concrete-local] = for x : a closure
		assert x.type !is-empty-type
		x, do names lambda-impl-field this-class, x
	super-class = names class_ lambda-type
	fields field_info[] = if a.closure is-empty
		(constants instance-field this-class-name),
	else
		for x : a.closure
			assert x.type !is-empty-type
			access-flags: final
			name: names lambda-impl-field-name x
			descriptor: names descriptor-for-field-type x.type
			attributes: ()
	methods method_info[] = with methods-out : build
		field-refs (field-reference, java-runtime-type)[] = for local, field : closure
			field, local.type.as-runtime-type
		methods-out ~= names record-initializer super-class, field-refs, do names lambda-init-descriptor a
		if a.closure is-empty
			methods-out ~= names clinit-for-instance-field this-class-name, this-class
		methods-out ~= do
			expr-ctx expr-ctx = ctx, constants, this-class, containing-fun, closure, true, (!a.param.type.is-empty-type ? (a.param,))
			code = with out : constants build-code
				out emit-expr expr-ctx, return, a.body
			expr-ctx verify-expr-ctx-finished a.body.type, (a.param,)
			access-flags: ()
			name: names call
			descriptor: names lambda-call-descriptor lambda-type
			attributes: code,
	ctx add-class this-class-name, do
		source SourceFile_attribute = names.SourceFile, constants[uri to]
		constant-pool: constants finish
		access: final
		this-class: this-class
		super-class: super-class
		interfaces: ()
		fields: fields
		methods: methods
		attributes: source,
	this-class-name

-always-throws bool(a concrete-expr)
	match a kind
	as finally-concrete-expr x
		x.below always-throws
	as seq-concrete-expr x
		x.first always-throws || x.then always-throws
	as throw-concrete-expr _
		true
	else
		false

-get-switchable-kind-nat64 void(out code-builder, ctx expr-ctx, union-type concrete-type)
	out get-switchable-kind-nat32 ctx, union-type
	out i2l
-get-switchable-kind-nat32 void(out code-builder, ctx expr-ctx, union-type concrete-type)
	out getfield do ctx.names switchable-kind-field union-type
-get-switchable-value void(out code-builder, ctx expr-ctx, union-type concrete-type)
	out getfield do ctx.names switchable-value-field union-type

-fits-in-int32 bool(a int64)
	min-value::int32.to::int64 <= a && a <= max-value::int32.to
-fits-in-nat32 bool(a nat64)
	a <= max-value::nat32.to

-emit-with-unboxed-opt-local void
	out code-builder
	ctx expr-ctx
	unboxed-type concrete-type
	local concrete-local?
	pos expr-pos
	expr concrete-expr
do
	assert unboxed-type.as-runtime-type == reference-type
	if l ?= local
		out unbox-if-necessary ctx.ctx, l.type
		ctx must-refine unboxed-type, l.type
		out emit-with-local ctx, l, pos, expr
	else
		out pop reference-type
		ctx must-pop unboxed-type
		out emit-expr ctx, pos, expr
			
-emit-with-opt-local void(out code-builder, ctx expr-ctx, local concrete-local?, local-type concrete-type, pos expr-pos, expr concrete-expr)
	if l ?= local
		l.type is local-type
		out emit-with-local ctx, l, pos, expr
	else
		out pop local-type.as-runtime-type
		ctx must-pop local-type
		out emit-expr ctx, pos, expr

-emit-with-local void(out code-builder, ctx expr-ctx, local concrete-local, pos expr-pos, expr concrete-expr)
	unless local.type is-empty-type
		out xstore local.type.as-runtime-type, ctx.next-local-index
		ctx must-pop local.type
		ctx.locals ~= local
	out emit-expr ctx, pos, expr
	unless local.type is-empty-type
		ctx.locals.pop! is local

-local-index alias
	nat
-begin-synthetic-local nat(out code-builder, ctx expr-ctx, local-type concrete-type)
	local = ctx next-local-index
	unless local-type is-empty-type
		out xstore local-type.as-runtime-type, local
		ctx.locals ~= local-type
	local
-end-synthetic-local void(ctx expr-ctx, local-type concrete-type, local nat)
	unless local-type is-empty-type
		ctx.locals.pop! is local-type
	ctx.next-local-index is local

-exception-case-type-from-index concrete-type(ctx expr-ctx, exception-case-index integral-value)
	exception-types = ctx.program.exception.body.concrete-union! members
	exception-types[exception-case-index as-unsigned]

| Used before an instruction that will use the args
-emit-args void(out code-builder, ctx expr-ctx, args concrete-expr[])
	for arg : args
		out emit-and-continue ctx, arg
		ctx must-peek arg.type
| Does not actually pop args, just acknowledges that some operation took values off of the stack
-popped-args void(ctx expr-ctx, args concrete-expr[])
	for arg : args reversed
		ctx must-pop arg.type
-popped-object-args void(ctx expr-ctx, args concrete-expr[])
	for _ : args
		_ = ctx.stack.pop!
-pushed void(ctx expr-ctx, type concrete-type)
	unless type is-empty-type
		ctx.stack ~= type
-must-pop void(ctx expr-ctx, type concrete-type)
	unless type is-empty-type
		ctx.stack.pop! is type
-must-peek void(ctx expr-ctx, type concrete-type)
	unless type is-empty-type
		if ctx.stack.peek! != type
			error log "Expected: {ctx.ctx.show-ctx.show show-concrete-type type}, actual: {ctx.ctx.show-ctx.show show-concrete-type ctx.stack.peek!}" # TODO: RM
		ctx.stack.peek! is type
| Can use this for an up or down cast
-must-refine void(ctx expr-ctx, old-type concrete-type, new-type concrete-type)
	unless old-type is-empty-type
		ctx.stack.pop! is old-type
	unless new-type is-empty-type
		ctx.stack ~= new-type
-function-like void(out code-builder, ctx expr-ctx, return-type concrete-type, args concrete-expr[], f void mut())
	out emit-args ctx, args
	f[]
	ctx popped-args args
	ctx pushed return-type
-function-like-convert-args-to-objects void
	out code-builder
	ctx expr-ctx
	return-type concrete-type
	args concrete-expr[]
	should-convert-to-object bool data(index nat)
	f void mut()
do
	for index, arg : args with-index
		out emit-and-continue ctx, arg
		if should-convert-to-object[index]
			out box ctx, arg.type, ctx.program.java-any
	f[]
	ctx popped-object-args args
	ctx pushed return-type

-translate-builtin void
	out code-builder
	ctx expr-ctx
	fun builtin-fun
	type-args concrete-type[]
	type concrete-type
	args concrete-expr[]
do
	match fun
	as builtin-unary x
		out function-like ctx, type, args, () =>
			out translate-builtin-unary ctx, type, args.only.type, x, type-args
	as builtin-binary x
		out function-like ctx, type, args, () =>
			out translate-builtin-binary ctx.names, type, args[0].type, x
	as builtin-binary-lazy _
		throw unreachable
	as builtin-fun-call-lambda
		out function-like ctx, type, args, () =>
			lambda, _ = args only2
			out invokevirtual do ctx.names lambda-call lambda.type
	as builtin-fun-constant _
		throw unreachable
	as builtin-fun-is-empty-type
		throw unreachable
	as java-fun x
		out translate-java-fun ctx, x, type, type-args, args
	as js-fun _
		throw unreachable

-translate-builtin-unary void(out code-builder, ctx expr-ctx, return-type concrete-type, arg-type concrete-type, kind builtin-unary, type-args concrete-type[])
	names = ctx names
	match kind
	as array-size
		unless type-args.only is-empty-type
			out arraylength
		out i2l
	as as-mut-array
		()
	as as-mut-array-impl
		()
	as bits-of-float32
		out invokestatic names.java-floatToRawIntBits
	as bits-of-float64
		out invokestatic names.java-doubleToRawLongBits
	as bitwise-not
		match return-type.as-integral-type! to-signed
		as int8
			out iconst -1
			out ixor
			out i2b
		as int16
			out iconst -1
			out ixor
			out i2s
		as int32
			out iconst -1
			out ixor
		as int64
			out lconst -1
			out lxor
	as float32-from-bits
		out invokestatic names.java-intBitsToFloat
	as float64-from-bits
		out invokestatic names.java-longBitsToDouble
	as not
		# Negate all bits, then mask back to a single bit
		out iconst -1
		out ixor
		out iconst 1
		out iand
	as to-char8-from-nat8
		()
	as to-float32-from-float64
		out d2f
	as to-float64-from-float32
		out f2d
	as to-float64-from-int64
		out l2d
	as to-float64-from-nat64
		out invokestatic names.crow-float64FromNat64
	as truncate-to-int64-from-float64
		out d2l
	as weak-ref-get
		out invokestatic names.crow-weakRefGet
		out cast-and-unbox-if-necessary ctx, type-args.only
	as weak-ref-new
		out invokestatic names.crow-newWeakRef
	as wrap-convert-integral
		out convert-integral return-type.as-integral-type-allow-char!, arg-type.as-integral-type-allow-char!

-convert-integral void(out code-builder, return-type integral-type, arg-type integral-type)
	return-signed = return-type to-signed
	arg-signed, arg-is-signed = arg-type to-signed-and-is-signed
	if arg-is-signed
		out convert-signed-integral return-signed, arg-signed
	else
		out convert-unsigned-integral return-signed, arg-signed
	# If the sign differs, just let it wrap
-convert-unsigned-integral void(out code-builder, return-type signed-integral-type, arg-type signed-integral-type)
	out convert-signed-integral return-type, arg-type
	guard return-type > arg-type
	match arg-type
	as int8
		if return-type == int64
			out lconst 0xff
			out land
		else
			out iconst 0xff
			out iand
	as int16
		if return-type == int64
			out lconst 0xffff
			out land
		else
			out iconst 0xffff
			out iand
	as int32
		assert return-type == int64
		out lconst 0xffffffff
		out land
	as int64
		throw unreachable
-convert-signed-integral void(out code-builder, return-type signed-integral-type, arg-type signed-integral-type)
	match return-type
	as int8
		match arg-type
		as int8
			()
		as int16
			# There's no 's2b' because integers are always stored as int32 at miminum
			out i2b
		as int32
			out i2b
		as int64
			out l2i
			out i2b
	as int16
		match arg-type
		as int8
			()
		as int16
			()
		as int32
			out i2s
		as int64
			out l2i
			out i2s
	as int32
		if arg-type == int64
			out l2i
	as int64
		if arg-type != int64
			out i2l

-translate-builtin-binary void(out code-builder, names mangled-names-with-constants, return-type concrete-type, param0-type concrete-type, kind builtin-binary)
	match kind
	as add-float
		match return-type as-float-type!
		as float32
			out fadd
		as float64
			out dadd
	as bitwise-and
		if return-type.as-integral-type! is-64-bit
			out land
		else
			out iand
	as bitwise-or
		if return-type.as-integral-type! is-64-bit
			out lor
		else
			out ior
	as bitwise-xor
		if return-type.as-integral-type! is-64-bit
			out lxor
		else
			out ixor
	as equal
		out invokestatic if f ?= param0-type as-float-type
			names crow-equal-float f
		else 
			names crow-equal-integral param0-type.as-integral-type-allow-bool-char!
	as equal-float-ieee
		out invokestatic do names crow-equal-float-ieee param0-type.as-float-type!
	as less
		out invokestatic do names crow-less-integral param0-type.as-integral-type-allow-bool-char!
	as less-float-ieee
		out invokestatic do names crow-less-float-ieee param0-type.as-float-type!
	as mul-float
		match return-type as-float-type!
		as float32
			out fmul
		as float64
			out dmul
	as reference-equal
		out invokestatic names.crow-reference-equal
	as sub-float
		match return-type as-float-type!
		as float32
			out fsub
		as float64
			out dsub
	as unsafe-bit-shift-left-nat64
		out l2i # second argument must be an int. TODO: then make that the function signature for unsafe-bit-shift-left?????
		out lshl
	as unsafe-bit-shift-right-nat64
		out l2i # second argument must be an int. TODO: then make that the function signature for unsafe-bit-shift-left?????
		out lushr
	as unsafe-div
		if f ?= return-type as-float-type
			match f
			as float32
				out fdiv
			as float64
				out ddiv
		else
			i = return-type as-integral-type!
			if i is-signed
				if i == int64
					out ldiv
				else
					out idiv
			else
				out invokestatic do names java-divideUnsigned i.to-signed
	as unsafe-mod-float64
		out drem
	as unsafe-mod-nat64
		out invokestatic do names java-remainderUnsigned int64
	as wrap-add
		if return-type.as-integral-type! is-64-bit
			out ladd
		else
			out iadd
	as wrap-mul
		if return-type.as-integral-type! is-64-bit
			out lmul
		else
			out imul
	as wrap-sub
		if return-type.as-integral-type! is-64-bit
			out lsub
		else
			out isub

-as-integral-type-allow-bool-char integral-type?(a concrete-type)
	if a is-bool
		nat8
	else
		a as-integral-type-allow-char

-translate-java-fun void(out code-builder, ctx expr-ctx, kind java-fun, type concrete-type, type-args concrete-type[], args concrete-expr[])
	match kind
	as array-get
		out function-like ctx, type, args, () =>
			if type is-empty-type
				out pop T_INT
			else
				out xaload type-args.only.as-runtime-type
	as array-set
		out function-like ctx, type, args, () =>
			element = type-args only
			if element is-empty-type
				out pop T_INT
				out pop reference-type
			else
				out astore element.as-runtime-type
	as as-java-any
		out function-like-convert-args-to-objects ctx, type, args, (_ => true), () =>
			()
	as call-instance
		# TODO: if args are string literals, specialize
		method-name = ctx as-constant-string args[1]
		if type !is-java-any && args every (arg => arg.type !is-java-any) && method-name !is-empty
			out function-like-convert-args-to-objects ctx, type, (args omit-index 1), (index => index == 0), () =>
				param-types concrete-type[] = for x : args[2 .. end]; x type
				method = ctx.names extern-instance-method method-name!, type, args[0].type, param-types
				out invokevirtual method
		else
			out function-like-convert-args-to-objects ctx, type, args, (index => index != 1), () =>
				out invokestatic do ctx.names crow-call-instance args.size
				out cast-and-unbox-if-necessary ctx, type
	as call-new
		class-name-with-dots = ctx as-constant-string args[0]
		if args every (arg => arg.type !is-java-any) && class-name-with-dots !is-empty
			class_ = out.constants class_ class-name-with-dots!.dots-to-slashes
			out makenew class_
			out dup32
			out function-like ctx, type, args[1 .. end].to, () =>
				out invokespecial do ctx.names extern-constructor class_, for x : args[1 .. end]; x type
		else
			out function-like-convert-args-to-objects ctx, type, args, (index => index != 0), () =>
				out invokestatic do ctx.names crow-call-new args.size
	as call-static
		class-name = ctx as-constant-string args[0]
		method-name = ctx as-constant-string args[1]
		if class-name !is-empty && method-name !is-empty && type !is-java-any && class-name! can-call-static method-name!, args
			out function-like ctx, type, args[2 .. end].to, () =>
				if class-name! == "java.util.Arrays" && method-name! == "copyOfRange"
					out copy-of-range ctx, type
				else
					out invokestatic do ctx.names extern-static-method class-name!.dots-to-slashes, method-name!, type, for x : args[2 .. end]; x type
		else
			out function-like-convert-args-to-objects ctx, type, args, (index => index >= 2), () =>
				out invokestatic do ctx.names crow-call-static args.size
				out cast-and-unbox-if-necessary ctx, type
	as call-static-varargs
		out function-like ctx, type, args, () =>
			out invokestatic ctx.names.crow-call-static-varargs
			out cast-and-unbox-if-necessary ctx, type
	as cast
		out function-like ctx, type, args, () =>
			out cast-and-unbox-if-necessary ctx, type
	as change-exclusion
		out function-like ctx, type, args, () =>
			out invokestatic ctx.names.crow-change-exclusion
	as class-of
		args.size is 0
		out function-like ctx, type, args, () =>
			out push-unboxed-class-reference ctx.names, type-args.only
	as cur-exclusion
		args.size is 0
		out function-like ctx, type, args, () =>
			out invokestatic ctx.names.crow-get-exclusion
	as equal
		out function-like ctx, type, args, () =>
			out invokestatic ctx.names.crow-reference-equal
	as get-static-field
		# TODO: we can avoid reflection if we know the return type ......................................................
		#class-name-expr, field-name-expr = args only2
		#class-name = ctx as-constant-string class-name-expr
		#field-name = ctx as-constant-string field-name-expr
		#if class-name !is-empty && field-name !is-empty
		#	out function-like ctx, type, (), () =>
		#		out get-static-field class-name!.to, field-name!.to, 
		#		class_ = out.constants class
		#else
		out function-like ctx, type, args, () =>
			out invokestatic ctx.names.crow-get-static-field
	as new-array
		out function-like ctx, type, args, () =>
			out new-array-for-type ctx, type-args.only
	as null
		args.size is 0
		out function-like ctx, type, args, () =>
			out aconst_null

-can-call-static bool(class-name symbol, method-name symbol, args concrete-expr[])
	if class-name == "java.lang.System" && method-name == "identityHashCode"
		true
	else
		args every (arg => arg.type !is-java-any)

-get-array-size void(out code-builder, element concrete-type, local nat)
	if element is-empty-type
		out iload local
	else
		out aload local
		out arraylength

-copy-of-range void(out code-builder, ctx expr-ctx, return-type concrete-type) # TODO: this is HAX to deal with a generic method
	element-type = return-type array-element-type
	match element-type as-runtime-type
	as void
		()
	as java-primitive-type p
		out invokestatic do ctx.names arrays-copy-of-range-for-primitive p
	as reference-type
		out invokestatic ctx.names.arrays-copy-of-range-for-object
		unless element-type is-java-any
			out checkcast do ctx.names class_ return-type

-dots-to-slashes symbol(a symbol)
	a.to replace-all ".", "/" to

-as-constant-string symbol?(ctx expr-ctx, a concrete-expr)
	guard a.type == ctx.program.string
	guard x ?= a.kind constant
	ctx.program as-string x to
