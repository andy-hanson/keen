	match a
	as atan2-float32
		"float".to java-cast (("Math", "atan2") java-call-static-method (arg0, arg1))
	as atan2-float64
		("Math", "atan2") java-call-static-method (arg0, arg1)
	as fmod-float32
		modulo java-binary arg0, arg1
	as fmod-float64
		modulo java-binary arg0, arg1
	as unsafe-pow-float32
		("Math", "pow") java-call-static-method (arg0, arg1)
	as unsafe-pow-float64
		("Math", "pow") java-call-static-method (arg0, arg1)

-translate-java-fun java-statement[](ctx to-java-ctx, pos expr-pos, a java-fun, type concrete-struct, type-args concrete-type[], args java-expr[])
	match a
	as array-get
		array, index = args only2
		pos simple-expr (array java-array-get index)
	as array-set
		array, index, value = args only3
		assign = array java-array-get index java-assign-statement value
		assign ~ pos.maybe-return-void
	as as-java-any
		pos simple-expr ("java.lang.Object".to java-cast (ctx box type-args.only.struct, args.only))
	as call-instance
		pos simple-expr if simple ?= ctx as-simple-call-instance type-args, args
			simple
		else
			ctx cast-and-unbox type, (("Crow", "callInstance") java-call-static-method args)
	as call-new
		pos simple-expr (("Crow", "callNew") java-call-static-method args)
	as call-static
		need-cast mut = false
		call = if simple ?= type-args as-simple-call-static args
			simple
		else
			need-cast := true
			("Crow", "callStatic") java-call-static-method args
		# HAX -- a java void is not a crow void
		if type is-void
			call.to ~ (pos simple-expr void-expr)
		else
			pos simple-expr if need-cast
				ctx cast-and-unbox type, call
			else
				call
	as call-static-varargs
		args.size is 3
		pos simple-expr (ctx cast-and-unbox type, (("Crow", "callStaticVarargs") java-call-static-method args))
	as cast
		pos simple-expr (ctx cast-and-unbox type, args.only)
	as cur-exclusion
		args.size is 0
		pos simple-expr (("Crow", "getExclusion") java-call-static-method ())
	as change-exclusion
		args.size is 1
		pos simple-expr (("Crow", "changeExclusion") java-call-static-method args)
	as equal
		args.size is 2
		pos simple-expr (eq-eq java-binary args[0], args[1])
	as get-static-field
		args.size is 2
		pos simple-expr (("Crow", "getStaticField") java-call-static-method args)
	as new-array
		pos simple-expr ((ctx as-type type-args.only.struct) java-new-array args.only)
	as null
		pos simple-expr java-null

-as-simple-call-instance java-expr?(ctx to-java-ctx, type-args concrete-type[], args java-expr[])
	if method ?= args[1] java-literal-string
		# We can only do this if we know the types of all arguments
		if type-args[1 .. end] every x => x !is-java-any
			(ctx box type-args[1].struct, args[0] java-call-instance-method method.value, args[2 .. end].to),

-as-simple-call-static java-expr?(type-args concrete-type[], args java-expr[])
	if class_ ?= args[0] java-literal-string
		if method ?= args[1] java-literal-string
			# We can only do this if we know the types of all arguments
			if type-args[1 .. end] every x => x !is-java-any
				((class_.value, method.value) java-call-static-method args[2 .. end].to),
