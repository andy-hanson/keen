		f64["java.lang.Math", "cosh"]
	as round-down-float64
		f64["java.lang.Math", "floor"]
	as round-float64
		("Crow", "round") java-call-static-method (arg,)
	as round-up-float64
		f64["java.lang.Math", "ceil"]
	as sin-float64
