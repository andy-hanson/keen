import
	crow/col/mut-stack
	../../frontend/show-model
	../../model/concrete-model
	../../model/model
	../../model/show-concrete-model
	../../model/source-range
	../../model/uri
	../../util/full-index-map
	../../util/java-bytecode-types
	../../util/perf
	../../util/util
	../util
	./class-builder
	./class-code-builder
	./java-names: build-mangled-names, constant-names, constant-symbols-class-name, java-names
	./lib/Crow.class as Crow-class nat8[]
	./lib/CrowClassLoader.class as CrowClassLoader-class nat8[] # TODO: USED? -------------------------------------------------
	./java-refs
	./union-representation
	./util

translate-to-java-classes java-compiled-class[]
	program program
	concrete-program concrete-program
	show-ctx show-type-ctx
	class-prefix string
do
	start = perf-now
	union-info = show-ctx.show plan-unions concrete-program
	ctx to-java-ctx =
		res: ()
		next-lambda-index: 0
		next-resource-index: 0
		model-program: program
		program: concrete-program
		show-ctx: show-ctx
		names: show-ctx.show build-mangled-names concrete-program, class-prefix, union-info
		structs-for-integrals: concrete-program get-types-for-integrals
		union-info: union-info
	start-constants = perf-now
	ctx translate-constants
	start-constants end-translate-constants
	start-types = perf-now
	for type in concrete-program all-non-extern-types
		ctx translate-type type
	start-types end-translate-types
	start-funs = perf-now
	for uri, (funs, vars) in concrete-program funs-and-vars-by-uri
		ctx translate-funs-for-uri uri, funs, vars
	start-funs end-translate-funs
	main-name symbol = "{class-prefix}Main"
	ctx add-class main-name, do ctx main-class main-name
	if class-prefix == ""
		ctx.res ~~= lib-classes
	res java-compiled-class[] = ctx.res move-to
	start end-translate-to-java
	res

# TODO: CrowClassLoader is only needed for Crow itself, shouldn't be included in other programs built by Crow ---------------------------------------
-lib-classes java-compiled-class[]()
	- "Crow.class", Crow-class
	- "CrowClassLoader.class", CrowClassLoader-class

-main-class ClassFile(ctx to-java-ctx, name symbol)
	names java-refs = ctx.names start-new-class
	this-class = names.constants class_ name
	main method_info =
		code = with out in names build-code
			# TODO: break this out into its own function --------------------------------------------------------------------------
			out aload 0
			out invokestatic names.crow-string-array-from-java-string-array 
			funs = ctx.program.common-funs concrete-common-funs-java!
			out call-concrete-fun names, funs.start-runtime
			start-pc = out next-index
			out call-concrete-fun names, funs.main
			end-pc = out next-index
			out call-concrete-fun names, funs.stop-runtime
			out return void

			# Catch exceptions (temporarily) and ensure the runtime still shuts down. This is basically a 'finally'.
			out add-to-exception-table start-pc, end-pc, names.java-Throwable,
				locals: ()
				stack: names.java-Throwable.Object_variable_info,
			# Shut down the runtime with a 0 exit code so it doesn't call System.exit, then throw the exception so it fails anyway
			out lconst 0
			out call-concrete-fun names, funs.stop-runtime
			out athrow
		access-flags: public | static | synthetic
		name: names.constants["main"]
		descriptor: names.constants["([Ljava/lang/String;)V"]
		attributes: code,
	Object = names java-Object
	constant-pool: names finish
	access: final | public
	this-class: this-class
	super-class: Object
	interfaces: ()
	fields: ()
	methods: main,
	attributes: ()

-funs-and-vars-by-uri (concrete-fun[], concrete-var[])[uri](a concrete-program)
	res (concrete-fun mut[], concrete-var mut[]) mut[uri] = ()
	for x in a all-non-extern-funs
		funs, _ = res ensure x.module-uri
		funs ~= x
	for x in a all-vars
		_, vars = res ensure x.module-uri
		vars ~= x
	for key, (funs, vars) in res
		key, (funs.move-to, vars.move-to)
-new (concrete-fun mut[], concrete-var mut[])()
	(), ()

-to-java-ctx record mut
	res java-compiled-class mut[]
	next-lambda-index mut nat
	next-resource-index mut nat
	model-program program
	program concrete-program
	show-ctx show-type-ctx
	names java-names
	structs-for-integrals concrete-type[integral-type]
	union-info union-info
-add-class void(ctx to-java-ctx, name symbol, class_ ClassFile)
	start = perf-now
	bytes nat8[] = class_ to
	start end-class-to-bytes
	ctx.res ~= "{name}.class", bytes
-union-representation union-representation(ctx to-java-ctx, type concrete-type)
	ctx.union-info union-representation type
-add-resource symbol(ctx to-java-ctx, value nat8[])
	name string = "_resource{ctx next-resource-index}.bin"
	ctx.next-resource-index +:= 1
	ctx.res ~= name, value
	name to

-expr-ctx record mut
	ctx to-java-ctx
	names java-refs # TODO: rename to 'refs' ------------------------------------------------------------------------------
	this-class class-reference
	cur-fun-for-debug concrete-fun?
	closure field-reference[concrete-local]
	stack concrete-type mut-stack
	has-this bool
	| Does not include the 'this' param
	locals local-entry mut-stack
	loop-pos mut jump-target?
| Use 'concrete-type' for a synthetic local
-local-entry union(concrete-local, concrete-type)
-to json(a local-entry)
-type concrete-type(a local-entry)
	match a
	as concrete-local
		a type
	as concrete-type
		a
-== bool(a local-entry, b local-entry)
-new expr-ctx
	ctx to-java-ctx
	names java-refs
	this-class class-reference
	cur-fun concrete-fun?
	closure field-reference[concrete-local]
	has-this bool
	params concrete-local[]
do
	locals local-entry mut-stack = ()
	for x in params
		forbid x.type is-empty-type
		locals ~= x
	ctx, names, this-class, cur-fun, closure, (), has-this, locals, ()
-program concrete-program(a expr-ctx)
	a.ctx program
-union-representation union-representation(ctx expr-ctx, type concrete-type)
	ctx.ctx union-representation type
| Index of a local, or reference to a closure field
-local-or-closure union(nat, field-reference)
-explain-local local-or-closure(a expr-ctx, local concrete-local)
	a.closure[local] else
		res mut nat = a.has-this to
		assert a.locals exists of x
			found = x == local
			unless found
				res +:= x.type number-of-locals
			found
		res
-next-local-index nat(ctx expr-ctx)
	res mut nat = ctx.has-this to
	for x in ctx locals
		res +:= x.type number-of-locals
	res
-cur-stack-frame stack-frame(ctx expr-ctx)
	locals: with out in build
		if ctx has-this
			out ~= ctx.this-class Object_variable_info
		for x in ctx locals
			out ~= ctx verification-type x.type
	stack: for x in ctx stack
		ctx verification-type x

-verification-type verification_type_info(ctx expr-ctx, a concrete-type)
	match rt = a as-runtime-type
	as void
		error log "Unexpected verification-type {ctx.ctx.show-ctx.show show-concrete-type a}" # ------------------------
		throw unreachable
	as java-primitive-type
		match rt
		as T_BOOLEAN then integer
		as T_CHAR then integer
		as T_FLOAT then float
		as T_DOUBLE then double
		as T_BYTE then integer
		as T_SHORT then integer
		as T_INT then integer
		as T_LONG then long
	as reference-type
		if f ?= a as-wrapper
			ctx verification-type f.type
		else
			ctx.names class_ a Object_variable_info

-translate-constants void(ctx to-java-ctx)
	ctx add-class ctx.names.constant-symbols-class-name, do ctx constant-symbols-class
	for name, constants in ctx.names.constant-names class-to-constants
		ctx add-class name, do ctx constants-class name, constants

-constant-symbols-class ClassFile(ctx to-java-ctx)
	names java-refs = ctx.names start-new-class
	constant-symbols = ctx.program.all-constants symbols
	fields field_info[] = for index in 0 .. constant-symbols.size
		access-flags: static | final
		name: names constant-symbol-name index
		descriptor: names descriptor-for-field-type ctx.program.symbol
		attributes: ()
	this-class = names constant-symbols-class
	static-init method_info =
		code = with out in names build-code
			for index, symbol in constant-symbols with-index
				out ldc do out.constants string-ref symbol.to
				out invokevirtual names.java-String-getBytes
				out call-concrete-fun names, ctx.program.common-funs.concrete-common-funs-java!.to-symbol-from-string
				out putstatic do names constant-symbol-field ctx.program.symbol, index
			out return void
		access-flags: static | final | synthetic
		name: names clinit
		descriptor: names init-no-args-descriptor
		attributes: code,
	Object = names java-Object
	constant-pool: names finish
	access: final
	this-class: this-class
	super-class: Object
	interfaces: ()
	fields: fields
	methods: static-init,
	attributes: ()

-constants-class ClassFile(ctx to-java-ctx, name symbol, constants any-constant[])
	names java-refs = ctx.names start-new-class
	fields field_info[] = for x in constants
		forbid x.type is-empty-type or x.type is-wrapper
		access-flags: static | final
		name: names constant-name x
		descriptor: names descriptor-for-field-type x.type
		attributes: ()
	this-class = names.constants class_ name
	static-init method_info =
		code = with out in names build-code
			expr-ctx expr-ctx = ctx, names, this-class, (), (), (), ()
			for constant in constants
				forbid constant.type is-empty-type or constant.type is-wrapper
				out init-constant expr-ctx, constant
			out return void
		access-flags: static | final | synthetic
		name: names clinit
		descriptor: names init-no-args-descriptor
		attributes: code,
	Object = names java-Object
	constant-pool: names finish
	access: final
	this-class: this-class
	super-class: Object
	interfaces: ()
	fields: fields
	methods: static-init,
	attributes: ()

-init-constant void(out code-builder, ctx expr-ctx, constant any-constant) # TODO: does this really need an expr-ctx? -----------------
	assert ctx.stack is-empty
	match constant
	as single-constant-array
		array = constant array-type
		element = constant element-type
		elements = constant elements
		if (element is-nat8 or element is-char8) and elements.size > 16
			resource = ctx.ctx add-resource for e in elements
				e.scalar-value! to
			out ldc ctx.this-class
			out ldc do out.constants string-ref resource
			out invokevirtual ctx.names.java-Class-getResourceAsStream
			out invokevirtual ctx.names.java-InputStream-readAllBytes
			ctx pushed array
		else
			out make-array ctx, elements.size, array, element, of i
				out push-constant ctx, elements[i], element
	as single-constant-record
		out new-record ctx, constant.record-type, of i, field
			out push-constant ctx, constant.args[i], field.type
	out putstatic do ctx.names constant-field constant
	ctx must-pop constant.type
	assert ctx.stack is-empty

-emit-unreachable void(out code-builder, names java-refs)
	Error = names java-Error
	out makenew Error
	out dup32
	out invokespecial do names init-no-args Error
	out athrow

-new-record void
	out code-builder
	ctx expr-ctx
	record-type concrete-type
	emit-arg void mut(i nat, field concrete-field)
do
	record_ = record-type.body concrete-record!
	fields = record_ fields
	if record-type is-empty-type
		before = ctx.stack size
		for i, field in fields with-index
			emit-arg[i, field]
		ctx.stack.size is before
	elif field ?= record_ as-wrapper
		emit-arg[0, field]
		ctx must-refine field.type, record-type
	else
		out makenew do ctx.names class_ record-type
		ctx pushed record-type
		out dup32
		ctx pushed record-type
		for i, field in fields with-index
			emit-arg[i, field]
			ctx must-peek field.type
		out invokespecial do ctx.names record-init-reference record-type
		for field concrete-field in fields reverse # TODO: should not need type annotation
			ctx must-pop field.type
		ctx must-pop record-type
		ctx must-peek record-type

-make-array void
	out code-builder
	ctx expr-ctx
	size nat
	array-type concrete-type
	element-type concrete-type
	emit-element void mut(i nat)
do
	out iconst size.to
	out new-array-for-type ctx, element-type
	ctx pushed array-type
	for i in 0::nat .. size
		out dup32
		ctx pushed array-type
		out iconst i.to
		ctx pushed ctx.program.nat32
		emit-element[i]
		out astore element-type.as-runtime-type
		ctx must-pop element-type
		ctx must-pop ctx.program.nat32
		ctx must-pop array-type
	ctx must-peek array-type

-push-constant void(out code-builder, ctx expr-ctx, constant constant, type concrete-type)
	match body = type body
	as concrete-builtin-type
		out push-constant-builtin ctx, constant, type, body
		ctx pushed type
	as concrete-enum
		out push-constant-integral body.storage_, constant
		ctx pushed type
	as struct-body-extern-java
		match constant
		as constant-gc-safe-value
			out aconst_null
		as constant-native-string
			body.path is "java/lang/String".parse-path
			out ldc do out.constants string-ref constant.value.to
		else
			throw unreachable
		ctx pushed type
	as concrete-flags
		out push-constant-integral body.storage_, constant
		ctx pushed type
	as concrete-record
		guard type !is-empty-type
		if field ?= type as-wrapper
			wrapped = field type
			match constant
			as constant-record 
				inner = ctx.program.all-constants.records[type]![constant] only
				out push-constant ctx, inner, wrapped
				ctx must-refine field.type, type
			as constant-gc-safe-value
				out push-constant ctx, constant-gc-safe-value, wrapped
				ctx must-refine field.type, type
			else
				throw unreachable
		else
			match constant
			as constant-record
				out getstatic do ctx.names constant-record-field type, constant
			as constant-gc-safe-value
				out aconst_null
			as constant-symbol
				out getstatic do ctx.names constant-symbol-field ctx.program.symbol, constant.index
			else
				throw unreachable
			ctx pushed type
	as concrete-union
		match constant
		as constant-union
			value = ctx.program.all-constants.unions[type]![constant]
			out new-union ctx, type, value.member-index, of case-type
				out push-constant ctx, value.member, case-type
		as constant-gc-safe-value
			out aconst_null
			ctx pushed type
		else
			throw unreachable
	as concrete-type-body-deferred
		throw unreachable

-new-union void
	out code-builder
	ctx expr-ctx
	type concrete-type
	member-index nat
	emit-member void mut(case-type concrete-type)
do
	case-type = type.body.concrete-union!.members[member-index]
	emit-member-object void mut() = of
		emit-member[case-type]
		out box ctx, case-type, type
	match ctx.ctx union-representation type
	as exception
		emit-member-object[]
	as sealed-interface
		emit-member-object[]
	as switch
		emit-member-object[]
		local = ctx next-local-index
		out astore local
		union-class = ctx.names class_ type
		out makenew union-class
		out dup32
		out push-constant-integral nat32, member-index.to
		out aload local
		out invokespecial do ctx.names init-union-switch union-class
	as nullable
		match member-index
		as 0
			emit-member[case-type] # for the side effect
			out aconst_null
			ctx pushed type
		as 1
			emit-member-object[]
		else
			throw unreachable

-push-constant-builtin void
	out code-builder
	ctx expr-ctx
	constant constant
	type concrete-type
	builtin_ concrete-builtin-type
do
	array void mut() = of
		if type.array-element-type is-empty-type
			out push-constant-integral nat32, match constant
			as constant-array
				elements = ctx.ctx.program.all-constants.arrays[constant type-index].constants[constant index] # TODO: helper function for this!
				elements.size to
			as constant-gc-safe-value
				0::nat to
			else
				throw unreachable
		else
			match constant
			as constant-array
				out getstatic do ctx.names constant-array-field type, constant
			as constant-gc-safe-value
				out aconst_null
			else
				throw unreachable
	match builtin_ kind
	as array
		array[]
	as bool
		out push-constant-integral int8, constant
	as char8
		out push-constant-integral int8, constant
	as char32
		out push-constant-integral int32, constant
	as float32
		out fconst constant.scalar-value!.to::float64.to
	as float64
		out dconst constant.scalar-value!.to::float64
	as future
		throw unreachable
	as int8
		out push-constant-integral int8, constant
	as int16
		out push-constant-integral int16, constant
	as int32
		out push-constant-integral int32, constant
	as int64
		out push-constant-integral int64, constant
	as js-any
		throw unreachable
	as fun-data
		throw unreachable
	as fun-mut
		throw unreachable
	as fun-shared
		throw unreachable
	as mut-slice
		array[] # TODO: I think this is only for constant-gc-safe-value, so I should just handle that?
	as nat8
		out push-constant-integral nat8, constant
	as nat16
		out push-constant-integral nat16, constant
	as nat32
		out push-constant-integral nat32, constant
	as nat64
		out push-constant-integral nat64, constant
	as option
		throw unreachable
	as void
		()
	as weak-ref
		assert _ ?= constant constant-gc-safe-value
		out aconst_null

-push-constant-integral void(out code-builder, type integral-type, constant constant)
	value int = match constant
	as scalar-value
		constant to
	as constant-gc-safe-value
		0
	else
		throw unreachable
	if type is-64-bit
		out lconst value
	else
		# Use 'wrap-to' instead of 'to' since we may actually be dealing with an unsigned type
		out iconst value.wrap-to

-translate-type void(ctx to-java-ctx, type concrete-type)
	forbid type is-extern
	names java-refs = ctx.names start-new-class
	is-exception-case = type in ctx.union-info.exception-case-types
	super-class = if is-exception-case then names java-Throwable else names java-Object
	interface-structs = ctx.union-info.type-to-interfaces[type] else ()
	interfaces class-reference[] = for x in interface-structs then names class_ x
	this-class-name = names class-name type
	this-class = names class_ type

	method-impls method_info[] = with out in build
		for interface_ in interface-structs
			info = ctx.program.method-impls[interface_] else ()
			unless info is-empty
				# TODO:PERF have the index handy so we don't have to search for it again
				index = interface_.body.concrete-union!.members index-of! type
				for method, impl in info.methods zip info.cases[index]
					kind = ctx.union-info java-method-kind method
					if kind is-instance
						out ~= names method-impl method, impl
		if is-exception-case
			impls = ctx.program.method-impls[ctx.program.exception]!
			# TODO:PERF have the index handy so we don't have to search for it again
			case-index = ctx.program.exception.body.concrete-union!.members index-of! type
			# 'show' is not a Java method (since we don't control the Throwable type), but while we're here, define 'toString' in terms of it
			if impl ?= impls.cases[case-index] only
				out ~= names toString-method-impl impl

	class_ ClassFile? = match body = type body
	as concrete-builtin-type
		lambda ClassFile mut() = of
			assert method-impls is-empty else todo
			names lambda-class type, this-class, super-class, interfaces
		match body kind
		as array
			()
		as fun-data
			lambda[]
		as fun-mut
			lambda[]
		as fun-shared
			lambda[]
		as void
			# Can't use java.lang.Void since that has no instances
			names record-class type, false, (), this-class-name, this-class, super-class, interfaces, method-impls
		else
			() # TODO: could use a boxing-record for unsigned integer types ........................................................
	as concrete-enum
		# TODO: we only need the boxing class if an enum is used in a union (including Option) -----------------------------
		names boxing-record type, super-class, interfaces, method-impls
	as struct-body-extern-java
		throw unreachable
	as concrete-flags
		# TODO: we only need the boxing class if an enum is used in a union (including Option) -----------------------------
		names boxing-record type, super-class, interfaces, method-impls
	as concrete-record
		names record-class type, body.is-wrapper, body.fields, this-class-name, this-class, super-class, interfaces, method-impls
	as concrete-union
		method-decls method_info[] = with out in build
			for m in ctx.program.method-impls[type] ?methods else ()
				match ctx.union-info java-method-kind m
				as interface_
					out ~= names interface-method-decl m
				as virtual
					throw todo
				as static-method-of-class
					()
				as static-method-of-interface
					()
				# TODO: a union method can't be implemented as the below three, so use a more specific type for 'java-method-kind'!
				as constructor
					throw unreachable
				as static-field
					throw unreachable
				as instance-field
					throw unreachable
		all-methods = method-decls ~~ method-impls
		match ctx union-representation type
		as exception
			()
		as sealed-interface
			names union-sealed-interface this-class, super-class, interfaces, all-methods
		as switch
			assert all-methods is-empty else todo
			names union-switchable this-class, super-class, interfaces
		as nullable
			()
	as concrete-type-body-deferred
		throw unreachable
	if class_
		ctx add-class this-class-name, class_

-interface-method-decl method_info(names java-refs, method concrete-fun)
	access-flags: public | abstract_
	name: names instance-method-name method
	descriptor: names instance-method-descriptor method
	attributes: ()

| Creates the instance method that implements an interface method by calling a static function
-method-impl method_info(names java-refs, method concrete-fun, impl concrete-fun?)
	code = with out in names build-code
		assert i ?= impl else todo # TODO: generate code that will throw an error --------------------------------------------------
		java-param-index mut nat = 0
		for index, param in method.params with-index
			if index == 0
				out aload 0
				out unbox-if-necessary names, i.params[0].type
			else
				out xload param.type.as-runtime-type, java-param-index
			java-param-index +:= param.type number-of-locals
		out call-concrete-fun names, i
		out return method.return-type.as-runtime-type
	access-flags: public | final
	name: names instance-method-name method
	descriptor: names instance-method-descriptor method
	attributes: code,

-toString-method-impl method_info(names java-refs, show concrete-fun)
	code = with out in names build-code
		out makenew names.java-String
		out dup32
		case-type = show.params.only type
		unless case-type is-empty-type
			out aload 0
			out unbox-if-necessary names, case-type
		out call-concrete-fun names, show
		out invokespecial names.java-String-init-from-bytes
		out return reference-type
	access-flags: public | final
	name: names toString
	descriptor: names.constants["()Ljava/lang/String;"]
	attributes: code,

-lambda-class ClassFile
	names java-refs
	type concrete-type
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
do
	is-runnable = type lambda-type-is-runnable
	all-interfaces = if is-runnable then names.java-Runnable ~ interfaces else interfaces
	init = names record-initializer super-class, (), names.init-no-args-descriptor
	call method_info =
		access-flags: abstract_ | if is-runnable then public
		name: names run
		descriptor: names lambda-call-descriptor type
		attributes: ()
	constant-pool: names.constants finish
	access: abstract_
	this-class: this-class
	super-class: super-class
	interfaces: all-interfaces
	fields: ()
	methods: init, call
	attributes: ()

-lambda-type-is-runnable bool(type concrete-type)
	assert r, p ?= type as-lambda-type
	r is-void and p is-void

-union-sealed-interface ClassFile
	names java-refs
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
	methods method_info[]
do
	constant-pool: names.constants finish
	access: interface_ | abstract_
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: ()
	methods: methods
	attributes: ()

-union-switchable ClassFile
	names java-refs
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
do
	constants = names constants
	kind field_info =
		access-flags: final
		name: names switchable-kind-name
		descriptor: names switchable-kind-descriptor
		attributes: ()
	kind-field = names switchable-kind-field this-class
	value field_info =
		access-flags: final
		name: names value
		descriptor: names java-Object-descriptor
		attributes: ()
	value-field = names switchable-value-field this-class
	constructor method_info =
		code Code_attribute = with out in constants build-code
			out aload 0
			out invokespecial do names init-no-args super-class
			out aload 0
			out xload T_INT, 1
			out putfield kind-field
			out aload 0
			out aload 2
			out putfield value-field
			out return void
		access-flags: ()
		name: names init
		descriptor: names init-union-switch-descriptor
		attributes: code,
	constant-pool: constants finish
	access: final
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: kind, value
	methods: constructor,
	attributes: ()

-record-class ClassFile
	names java-refs
	type concrete-type
	is-wrapper bool
	concrete-fields concrete-field[]
	this-class-name symbol
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
	method-impls method_info[]
do
	constants = names constants
	fields field_info[] = if type is-empty-type
		- names instance-field this-class-name
	else
		for* field in concrete-fields
			guard field.type !is-empty-type
			-
				access-flags: unless field is-mutable then final
				name: names record-field-name field
				descriptor: names record-field-descriptor field
				attributes: ()
	methods method_info[] = with methods-out in build
		field-refs (field-reference, java-runtime-type)[] = for* x in concrete-fields
			# TODO: we should just not concretize empty fields --------------------------------------------------------------
			guard x.type !is-empty-type
			- (names record-field type, x), x.type.as-runtime-type
		methods-out ~= names record-initializer super-class, field-refs,
			names record-init-descriptor concrete-fields
		if type is-empty-type
			methods-out ~= names clinit-for-instance-field this-class-name, this-class
		elif is-wrapper
			methods-out ~= names make-valueOf type
			if p ?= concrete-fields.only.type as-java-primitive-type
				field = concrete-fields only
				field-ref = names record-field type, field
				methods-out ~= names make-getValue field-ref, p
		methods-out ~~= method-impls
	constant-pool: constants finish
	access: final
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: fields
	methods: methods
	attributes: ()

-instance-field field_info(names java-refs, this-class-name symbol)
	access-flags: final | static
	name: names instance-field-name
	descriptor: names instance-field-descriptor this-class-name
	attributes: ()
-clinit-for-instance-field method_info(names java-refs, this-class-name symbol, this-class class-reference)
	class-init-code Code_attribute = with out in names.constants build-code
		out makenew this-class
		out dup32
		out invokespecial do names init-no-args this-class
		out putstatic do names instance-field this-class, this-class-name
		out return void
	access-flags: static
	name: names clinit
	descriptor: names init-no-args-descriptor
	attributes: class-init-code,

-record-initializer method_info
	names java-refs
	super-class class-reference
	fields (field-reference, java-runtime-type)[]
	descriptor utf8-reference
do
	code = with out in names.constants build-code
		out aload 0
		out invokespecial do names init-no-args super-class
		local-index mut nat = 1 # 0 is the object
		for field, field-type in fields
			out aload 0
			out xload field-type, local-index
			local-index +:= field-type number-of-locals
			out putfield field
		out return void
	access-flags: ()
	name: names init
	descriptor: descriptor
	attributes: code,

-boxing-record ClassFile
	names java-refs
	type concrete-type
	super-class class-reference
	interfaces class-reference[]
	methods method_info[]
do
	constants = names constants
	this-class = names class_ type
	primitive = type as-java-primitive-type!
	descriptor = names primitive-descriptor primitive
	field field_info =
		access-flags: final
		name: names value
		descriptor: descriptor
		attributes: ()
	field-ref = names boxed-class-value type
	constructor-descriptor = names boxed-class-init-descriptor type
	constructor method_info =
		code = with out in constants build-code
			out aload 0
			out invokespecial do names init-no-args super-class
			out aload 0
			out xload type.as-runtime-type, 1
			out putfield field-ref
			out return void
		access-flags: ()
		name: names init
		descriptor: constructor-descriptor
		attributes: code,
	valueOf = names make-valueOf type
	getValue = names make-getValue field-ref, primitive
	constant-pool: constants finish
	access: final
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: field,
	methods: (constructor, valueOf, getValue)::method_info[] ~~ methods
	attributes: ()

-make-valueOf method_info
	names java-refs
	type concrete-type
do
	this-class = names class_ type
	# TODO: this should have a cache. For enums, statically generate all members. For flags or integrals, just cache the 10 most recent?
	code = with out in names.constants build-code
		out makenew this-class
		out dup32
		out xload type.as-runtime-type, 0
		out invokespecial do names boxed-class-init type
		out return reference-type
	access-flags: static
	name: names valueOf
	descriptor: names boxed-class-valueOf-descriptor type
	attributes: code,

-make-getValue method_info(names java-refs, field-ref field-reference, primitive java-primitive-type)
	code = with out in names.constants build-code
		out aload 0
		out getfield field-ref
		out return primitive
	access-flags: final
	name: names primitive-getter-name primitive
	descriptor: names primitive-getter-descriptor primitive
	attributes: code,

-new-array-for-type void(out code-builder, ctx expr-ctx, element-type concrete-type)
	match rt = element-type as-runtime-type
	as void
		# Void array represented as the size which is already on stack
		()
	as java-primitive-type
		out newarray rt
	as reference-type
		if field ?= element-type as-wrapper
			out new-array-for-type ctx, field.type
		else
			out anewarray do ctx.names class_ element-type

-number-of-locals nat(type concrete-type)
	type.as-runtime-type number-of-locals
-number-of-locals nat(type java-runtime-type)
	match type
	as void
		0
	as java-primitive-type
		match type
		as T_DOUBLE then 2
		as T_LONG then 2
		else then 1
	else
		1

-box void(out code-builder, ctx expr-ctx, in-type concrete-type, out-type concrete-type)
	out box-no-refine ctx.names, in-type, out-type
	ctx must-refine in-type, out-type

-box-no-refine void(out code-builder, names java-refs, in-type concrete-type, out-type concrete-type)
	assert out-type.as-runtime-type == reference-type
	if in-type is-empty-type
		out getstatic do names instance-field in-type
	elif _ ?= in-type as-java-primitive-type or in-type is-wrapper
		out invokestatic do names boxed-class-valueOf in-type

-cast-and-unbox-if-necessary void(out code-builder, ctx expr-ctx, type concrete-type)
	if type is-empty-type
		out pop reference-type
	else
		out checkcast do ctx.names class_ type
		out unbox-if-necessary ctx.names, type

-unbox-if-necessary void(out code-builder, names java-refs, type concrete-type)
	if p ?= type as-java-primitive-type
		out invokevirtual do names primitive-unboxer type, p
	elif field ?= type as-wrapper
		out getfield do names record-field type, field # TODO: doesn't this need to apply recursively? ----------------------

-translate-funs-for-uri void(ctx to-java-ctx, uri uri, funs concrete-fun[], vars concrete-var[])
	names java-refs = ctx.names start-new-class
	this-class-name = names module-class-name uri
	this-class = names module-class uri
	fields field_info[] = for var in vars
		match var kind
		as thread-local_
			throw todo
		as global_
			access-flags: static
			name: names var-name var
			descriptor: names descriptor-for-field-type var.type
			attributes: ()
	methods method_info[] = with methods-out in build
		for fun in funs
			guard (ctx.union-info java-method-kind fun) == static-method-of-class
			expr-ctx expr-ctx = ctx, names, this-class, fun, (), (), (fun.params filter !it.type.is-empty-type)
			code = with out in names build-code
				out emit-fun-body expr-ctx, fun
			expr-ctx verify-expr-ctx-finished fun.return-type, fun.params
			methods-out ~=
				access-flags: static
				name: names fun-name fun
				descriptor: names static-method-descriptor fun
				attributes: code,
		methods-out ~= ctx init-vars names, this-class, vars
	Object = names java-Object
	source SourceFile_attribute = names.SourceFile, names.constants[uri to]
	ctx add-class this-class-name, do		
		constant-pool: names finish
		access: ()
		this-class: this-class
		super-class: Object
		interfaces: ()
		fields: fields
		methods: methods
		attributes: source,

-init-vars method_info(ctx to-java-ctx, names java-refs, this-class class-reference, vars concrete-var[])
	expr-ctx expr-ctx =
		ctx: ctx
		names: names
		this-class: this-class
		cur-fun: ()
		closure: ()
		has-this: false
		params: ()
	code = with out in names build-code
		for var in vars
			match var kind
			as thread-local_
				throw todo
			as global_
				out emit-and-continue expr-ctx, var.initializer
				out putstatic do names var-field var
				expr-ctx must-pop var.type
			assert expr-ctx.stack is-empty
		out return void
	access-flags: static | final
	name: names clinit
	descriptor: names init-no-args-descriptor
	attributes: code,

-verify-expr-ctx-finished void(expr-ctx expr-ctx, return-type concrete-type, params concrete-local[])
	expr-ctx must-pop return-type
	# RM --------------------------------------------------------------------------------------------------------------------------
	unless expr-ctx.stack is-empty
		error log "You left something on the stack: "
		for x in expr-ctx.stack
			error log "{expr-ctx.ctx.show-ctx.show show-concrete-type x}"
	assert expr-ctx.stack is-empty
	expr-ctx.locals.size is (params count !it.type.is-empty-type)

-emit-fun-body void(out code-builder, ctx expr-ctx, fun concrete-fun)
	names = ctx names
	match body = fun body
	as concrete-fun-body-builtin # TODO: this should go away, always use the concrete-expr form
		args concrete-expr[] = for param in fun params
			param.type, fun.range, param.local-get-concrete-expr
		out translate-builtin ctx, body.kind, body.type-args, fun.return-type, args
		out return fun.return-type.as-runtime-type
	as concrete-expr
		# info log "GONNA EMIT FUNCTION {ctx.ctx.show-ctx.show show-concrete-fun-sig fun, false}" -----------------------------------
		out emit-expr ctx, return, body
	as fun-body-extern-java
		throw unreachable
	as concrete-fun-body-method
		union_ = fun.params[0] type
		info = ctx.program.method-impls[union_]!
		cases = info cases
		method-index = info.methods index-of! fun

		load-rest-params void mut() = of
			local-index mut nat = 1
			for param in fun.params[1 .. end]
				out xload param.type.as-runtime-type, local-index
				local-index +:= param.type number-of-locals
		match ctx union-representation union_
		as exception
			jump mut deferred-jump? = ()
			for case-index, case-impls in cases with-index
				case-type = union_.body.concrete-union!.members[case-index]
				guard case-impl ?= case-impls[method-index]
				jump ?jumps-to-here out, ctx.cur-stack-frame
				out aload 0
				out instanceof do names class_ case-type
				jump := out ifeq
				out aload 0
				out cast-and-unbox-if-necessary ctx, case-type
				load-rest-params[]
				out call-concrete-fun names, case-impl
				out return fun.return-type.as-runtime-type
			jump! jumps-to-here out, ctx.cur-stack-frame
			# To 'show' Java exceptions, call 'toString' and convert
			out aload 0
			out invokevirtual names.java-Object-toString
			out invokevirtual names.java-String-getBytes
			out return fun.return-type.as-runtime-type
			ctx pushed fun.return-type
		as sealed-interface
			throw unreachable
		as switch
			out aload 0
			out get-switchable-kind ctx, union_
			jump-to-case, jump-to-default = out tableswitch 0 .. cases.size.to
			for case-index, case-impls in cases with-index
				case-type = union_.body.concrete-union!.members[case-index]
				jump-to-case[case-index] jumps-to-here out, ctx.cur-stack-frame
				out aload 0
				out get-switchable-value ctx, union_
				out cast-and-unbox-if-necessary ctx, case-type
				load-rest-params[]
				case-impl = case-impls[method-index] else throw todo
				out call-concrete-fun names, case-impl
				out return fun.return-type.as-runtime-type
			jump-to-default jumps-to-here out, ctx.cur-stack-frame
			out emit-unreachable names
			ctx pushed fun.return-type
		as nullable
			throw todo
	as concrete-fun-body-deferred
		throw unreachable

-expr-pos union(continue_, jump, return) mut
| When the code is done, it should jump to the end (which will be determined after compiling the whole expression)
-continue_ record
-jump record mut
	jumps deferred-jump mut[]
| When the code is done, it should return from the function
| WARN: The returned type may be different from this expression's type.
| Maybe this expression is void but the value that was pushed on the stack before should be returned.
-return record

-emit-and-continue void(out code-builder, ctx expr-ctx, expr concrete-expr)
	out emit-expr ctx, continue_, expr

# TODO: the last use of inner-pos could be different, since if can just continue with no jump instruction ...................... also use a with-block
-with-inner-pos void(out code-builder, ctx expr-ctx, pos expr-pos, f void mut(inner-pos expr-pos))
	match pos
	as continue_
		jump jump = (),
		f[jump]
		for j in jump jumps
			j jumps-to-here out, ctx.cur-stack-frame
	as jump
		f[pos]
	as return
		f[pos]

-handle-pos void(out code-builder, pos expr-pos, type concrete-type)
	match pos
	as continue_
		()
	as jump
		pos.jumps ~= out goto
	as return
		out return type.as-runtime-type

-call-concrete-fun void(out code-builder, names java-refs, fun concrete-fun)
	match names.union-info java-method-kind fun
	as interface_
		count = fun.params sum of param
			param.type.as-runtime-type stack-entry-count
		out invokeinterface (names interface-method-ref fun), count.to
	as virtual
		out invokevirtual do names virtual-method-ref fun
	as static-method-of-class
		out invokestatic do names static-method-of-class-ref fun
	as static-method-of-interface
		out invokestatic do names static-method-of-interface-ref fun
	as constructor
		# Calling a constructor is a bit tricky since we need to put the new object first.
		class_ = names class_ fun.return-type
		n-param-slots = fun.params sum it.type.as-runtime-type.number-of-locals
		match n-param-slots
		as 0
			out makenew class_
			out dup32
		# TODO: this should produce smaller bytecode ------------------------------------------------------------------------------------
		#as 1
		#	out makenew class_
		#	out dup_x1
		#	out swap
		else
			l mut nat = 99 - n-param-slots # TODO: pass next param index into call-concrete-fun -----------------------------------
			for param concrete-local in fun.params reverse # TODO: should not need type annotation
				type = param.type as-runtime-type 
				out xstore type, l
				l +:= type number-of-locals
			out makenew class_
			out dup32
			for param in fun.params
				type = param.type as-runtime-type
				l -:= type number-of-locals
				out xload type, l
		out invokespecial do names constructor-method-ref fun
	as static-field
		# TODO: use 'names' for this, not 'names.constants'
		class-name symbol =  fun.body.fun-body-extern-java!.class_.to
		field-type = names descriptor-for-field-type fun.return-type
		out getstatic do names.constants field (names.constants class_ class-name),
			names.constants name-and-type (names fun-name fun), field-type
	as instance-field
		throw todo

-emit-expr void(out code-builder, ctx expr-ctx, pos expr-pos, a concrete-expr)
	names = ctx names
	out mark-line-number do (ctx.ctx.show-ctx.line-and-character-getters get-start-line a.start).to::nat16 + 1
	type = a type
	match x = a kind
	as array-op-concrete-expr
		out emit-for-loop ctx, pos, a, x
	as builtin-concrete-expr
		out translate-builtin ctx, x.fun, x.type-args, type, x.args
		out handle-pos pos, type
	as call-concrete-expr
		match body = x.called body
		as concrete-fun-body-builtin
			out translate-builtin ctx, body.kind, body.type-args, type, x.args
		else
			out function-like ctx, type, x.args, of
				out call-concrete-fun names, x.called
		out handle-pos pos, type
	as cast-concrete-expr
		# This is currently only used to cast an enum to an integral. In Java we just use integrals for enums directly. --------
		out emit-expr ctx, pos, x.inner
		ctx must-refine x.inner.type, type
	as constant
		out push-constant ctx, x, type
		out handle-pos pos, type
	as create-array-concrete-expr
		out make-array ctx, x.args.size, type, type.array-element-type, of i
			out emit-and-continue ctx, x.args[i]
		out handle-pos pos, type
	as create-record-concrete-expr
		out new-record ctx, type, of i, _
			out emit-and-continue ctx, x.args[i]
		out handle-pos pos, type
	as create-union-concrete-expr
		out new-union ctx, type, x.member-index, of _
			out emit-and-continue ctx, x.arg
		out handle-pos pos, type
	as drop-concrete-expr
		out emit-and-continue ctx, x.arg
		out pop x.arg.type.as-runtime-type
		ctx must-pop x.arg.type
		out handle-pos pos, type
	as finally-concrete-expr
		out with-inner-pos ctx, pos, of inner-pos
			start-pc = out next-index
			out emit-and-continue ctx, x.below # Leave the result on the stack
			end-pc = out next-index
			unless x.below always-throws # No point compiling the happy path if it always throws
				out emit-and-continue ctx, x.right
				unless x.right always-throws
					out handle-pos inner-pos, type
			if start-pc == end-pc
				# Edge case: empty code below the 'finally'. Since empty code can't throw, don't handle exceptions
				()
			else
				ctx must-pop type
				exception = ctx.program exception
				ctx pushed exception
				out add-to-exception-table start-pc, end-pc, (names class_ exception), ctx.cur-stack-frame
				out emit-and-continue ctx, x.right
				# 'x.right' is void, so the exception should be at the top of the stack.
				ctx must-pop exception
				unless x.right always-throws
					out athrow
				# Treat the stack effect as if it was successful
				ctx pushed type
	as if-concrete-expr
		out emit-and-continue ctx, x.cond
		out with-inner-pos ctx, pos, of inner-pos
			jump-if-false = out ifeq
			ctx must-pop ctx.program.bool
			out emit-expr ctx, inner-pos, x.then_
			ctx must-pop type # The value is not actually popped, be we are now doing the other branch where it wasn't pushed in the first place
			jump-if-false jumps-to-here out, ctx.cur-stack-frame
			out emit-expr ctx, inner-pos, x.else_
			ctx must-peek type
	as let-concrete-expr
		out emit-and-continue ctx, x.value
		out emit-with-local ctx, x.local, pos, x.then_
	as lambda-concrete-expr
		class-name = ctx.ctx create-lambda-implementation-class a.range.uri, ctx.cur-fun-for-debug!, type, x
		class_ = out.constants class_ class-name
		# All we do here is call 'new' or 'instance'
		if x.closure is-empty
			out getstatic do names instance-field class_, class-name
		else
			out makenew class_
			out dup32
			for local in x closure
				out get-local ctx, local
			out invokespecial do names lambda-init-reference class_, x
		ctx pushed type
		out handle-pos pos, type
	as local-get-concrete-expr
		out get-local ctx, x.local
		ctx pushed type
		out handle-pos pos, type
	as local-set-concrete-expr
		out emit-and-continue ctx, x.value
		local-type = x.local type
		unless local-type is-empty-type
			match l = ctx explain-local x.local
			as nat
				out xstore local-type.as-runtime-type, l
			as field-reference
				out putfield l
		ctx must-pop local-type
		out handle-pos pos, type
	as loop-concrete-expr
		###
		loop
			if x
				break
			else
				continue
		==>
		loop:
		x
		ifeq goto else_
		goto end
		else_:
		goto loop
		end:
		###
		prev-loop-pos = ctx loop-pos
		ctx.loop-pos := out can-jump-back-to-here ctx.cur-stack-frame
		out emit-expr ctx, pos, x.body
		ctx.loop-pos := prev-loop-pos
	as loop-break-concrete-expr
		out emit-expr ctx, pos, x.value
	as loop-continue-concrete-expr
		out go-back-to ctx.loop-pos!
		ctx pushed type # Treat the stack effect as if the loop completed
	as match-scalar-concrete-expr
		# TODO:PERF If <= 3 cases, it's probably better to just use ifeq instructions
		out emit-and-continue ctx, x.matched
		out with-inner-pos ctx, pos, of inner-pos
			matched-type = x matched-integral-type
			is-signed = matched-type is-signed
			ok = x.case-values every of value
				if is-signed
					value.to::int64 fits-in-int32
				else
					value.to::nat64 fits-in-nat32
			assert ok else todo # If some values don't fit in 32 bits, we can't use a switch. Just use jumps instead.
			# IF it's a 64-bit type: First check that it's in the range. If not, jump to default.
			jump-to-pop-then-default deferred-jump? = match matched-type integral-type else nat8
			as nat64
				out dup64
				out invokestatic names.crow-fits-in-nat32
				# If false, go to an instruction just before 'default' that pops
				res = out ifeq
				out l2i
				res
			as int64
				out dup64
				out invokestatic names.crow-fits-in-int32
				res = out ifeq
				out l2i
				res
			else
				()
			assert x.case-values is-sorted
			int-values int32[] = for v in x case-values then v.to::int64 to
			permutation = int-values get-sort-permutation
			jump-to-case, jump-to-default = if x.case-values is-range
				out tableswitch 0 .. x.case-values.size.to
			else
				out lookupswitch do int-values apply-permutation permutation
			ctx must-pop x.matched.type
			for target, expr in jump-to-case zip do x.case-exprs apply-permutation permutation
				target jumps-to-here out, ctx.cur-stack-frame
				out emit-expr ctx, inner-pos, expr
				ctx must-pop type
			if jump-to-pop-then-default
				# In this case it will still have the long value on the stack
				ctx pushed x.matched.type
				jump-to-pop-then-default jumps-to-here out, ctx.cur-stack-frame
				out pop T_LONG
				ctx must-pop x.matched.type
			jump-to-default jumps-to-here out, ctx.cur-stack-frame
			if e ?= x else_
				out emit-expr ctx, inner-pos, e
			else
				out emit-unreachable names
				ctx pushed type
	as match-string-like-concrete-expr
		# TODO: factor out a function -------------------------------------------------------------------------------------------
		out emit-and-continue ctx, x.matched
		matched-type = x.matched type
		out with-inner-pos ctx, pos, of inner-pos
			jump mut deferred-jump? = ()
			for index, case_ in x.cases with-index
				jump ?jumps-to-here out, ctx.cur-stack-frame
				# Final case will consume it
				is-last-case = index == x.cases.size - 1
				unless is-last-case
					out dup32
					ctx pushed matched-type
				out emit-and-continue ctx, case_.value
				# TODO:PERF in the case of a 'string' or 'symbol' input, we could 'intern' and then just use refernce equality
				out call-concrete-fun names, x.equals
				ctx must-pop matched-type
				ctx must-pop matched-type
				# Jump to next if the equality test returned 0 (false)
				jump := out ifeq
				unless is-last-case
					# If the equality test returned 'true', discard the original string
					out pop reference-type
					ctx must-pop matched-type
				out emit-expr ctx, inner-pos, case_.then_
				# Reset the stack to handle after the jump
				ctx must-pop type
				unless is-last-case
					ctx pushed matched-type
			jump! jumps-to-here out, ctx.cur-stack-frame
			out emit-expr ctx, inner-pos, x.else_
	as match-union-concrete-expr
		out emit-match-union ctx, pos, type, x
	as record-field-get-concrete-expr
		out emit-and-continue ctx, x.record_
		unless x.record_.type is-wrapper
			out getfield do names record-field x.record_.type, x.field
		ctx must-pop x.record_.type
		ctx pushed x.field.type
		out handle-pos pos, type
	as record-field-set-concrete-expr
		out emit-and-continue ctx, x.record_
		out emit-and-continue ctx, x.value
		out putfield do names record-field x.record_.type, x.field
		ctx must-pop x.value.type
		ctx must-pop x.record_.type
		out handle-pos pos, type
	as seq-concrete-expr
		locals-size = ctx.locals.size # TODO: remove some excessive checking ---------------------------------------------------------
		stack-size = ctx.stack.size
		for part in x.parts[0 .. end - 1]
			out emit-and-continue ctx, part
		ctx.locals.size is locals-size
		ctx.stack.size is stack-size
		ctx.locals.size is locals-size
		out emit-expr ctx, pos, x.parts[end - 1]
		ctx.locals.size is locals-size
		unless type is-empty-type
			ctx.stack.size is stack-size + 1
	as throw-concrete-expr
		out emit-and-continue ctx, x.thrown
		ctx must-pop ctx.program.exception
		out athrow
		# Treat the stack effect as if it was successful
		ctx pushed type
	as try-concrete-expr
		out with-inner-pos ctx, pos, of inner-pos
			start = out next-index
			out emit-expr ctx, inner-pos, x.tried
			end = out next-index
			for exception-case-index, case_ in x.exception-member-indices.to-array zip x.catch-cases
				ctx must-pop type
				catch-type = ctx exception-case-type-from-index exception-case-index
				frame-before = ctx cur-stack-frame
				boxed-catch-type = names class_ catch-type
				out add-to-exception-table start, end, boxed-catch-type,
					locals: frame-before locals
					stack: frame-before.stack ~ boxed-catch-type.Object_variable_info
				ctx pushed ctx.program.exception # just use an arbitrary type here, we're about to pop it
				out emit-with-unboxed-opt-local ctx, ctx.program.exception, case_.local, inner-pos, case_.expr
			if else_ ?= x catch-else
				ctx must-pop type
				# TODO: this is basicaly the same as for other cases, share code
				frame-before = ctx cur-stack-frame
				exception = names java-Throwable
				out add-to-exception-table start, end, exception,
					locals: frame-before locals
					stack: frame-before.stack ~ exception.Object_variable_info
				ctx pushed ctx.program.exception
				out emit-with-unboxed-opt-local ctx, ctx.program.exception, else_.local, inner-pos, else_.expr
	as try-let-concrete-expr
		start = out next-index
		out emit-and-continue ctx, x.value
		end = out next-index
		out with-inner-pos ctx, pos, of inner-pos
			out emit-with-opt-local ctx, x.local, x.value.type, inner-pos, x.then_
			# TODO: this is very similar to the code for try-concrete-expr, share code!
			ctx must-pop type
			catch-type = ctx exception-case-type-from-index x.exception-member-index
			frame-before = ctx cur-stack-frame
			boxed-catch-type = names class_ catch-type
			out add-to-exception-table start, end, boxed-catch-type,
				locals: frame-before locals
				stack: frame-before.stack ~ boxed-catch-type.Object_variable_info
			ctx pushed ctx.program.exception # just use an arbitrary type here, we're about to pop it
			out emit-with-unboxed-opt-local ctx, ctx.program.exception, x.catch_.local, inner-pos, x.catch_.expr
	as union-assume-case-concrete-expr
		out emit-and-continue ctx, x.arg
		match ctx union-representation x.union-type
		as exception
			out cast-and-unbox-if-necessary ctx, type
		as sealed-interface
			out cast-and-unbox-if-necessary ctx, type
		as switch
			out get-switchable-value ctx, x.union-type
			out cast-and-unbox-if-necessary ctx, type
		as nullable
			null-type, not-null-type = x.union_.members only2
			if type == null-type
				out pop reference-type
			else
				assert type == not-null-type
				out unbox-if-necessary ctx.names, type
		ctx must-refine x.union-type, type
		out handle-pos pos, type
	as var-get-concrete-expr
		match x.var kind
		as thread-local_
			throw todo
		as global_
			out getstatic do names var-field x.var
		ctx pushed type
		out handle-pos pos, type
	as var-set-concrete-expr
		out emit-and-continue ctx, x.value
		match x.var kind
		as thread-local_
			throw todo
		as global_
			out putstatic do names var-field x.var
			ctx must-pop x.value.type
		out handle-pos pos, type

-emit-for-loop void(out code-builder, ctx expr-ctx, pos expr-pos, a concrete-expr, x array-op-concrete-expr)
	names = ctx names
	type = a type
	out emit-and-continue ctx, x.input
	input-type = x.input type
	ctx must-pop input-type
	in-array local-index? = match x input-kind
	as array
		out begin-synthetic-local ctx, input-type
	as range
		()

	range-fields = if x.input-kind == range
		x.input.type.body.concrete-record! fields

	empty-out-elem = x.out-element is-empty-type
	output-kind = x output-kind a.type
	is-void bool = match output-kind
	as array
		false
	as void
		true

	nat32 = ctx.program nat32
	integral-type = match x input-kind
	as array
		nat32
	as range
		x in-element
	ir = integral-type as-runtime-type # TODO: NAME --------------------------------------------------------------------------------

	match x input-kind
	as array
		out iconst 0
	as range
		out dup32
		out getfield do names record-field input-type, range-fields[0]
	cur = out begin-synthetic-local ctx, integral-type

	match x input-kind
	as array
		out get-array-size x.in-element, in-array!
	as range
		# Don't dup, this finishes using the range
		out getfield do names record-field input-type, range-fields[1]
	end = out begin-synthetic-local ctx, integral-type

	match output-kind
	as void
		()
	as array
		out push-constant ctx, x.empty-out-array!, type
	out-array = out begin-synthetic-local ctx, type

	# If cur == end: goto bottom
	# TODO: helper function for this (compares two integrals) --------------------------------------------------------------
	out xload ir, cur
	out xload ir, end
	match ir java-primitive-type!
	as T_LONG
		out lcmp
	as T_INT
		out isub
	else
		throw unreachable
	goto-bottom = out ifeq

	# If non-empty: assign out-array to a non-empty array
	unless is-void
		out xload ir, end
		match x input-kind
		as array
			()
		as range
			# size is end - cur
			out xload ir, cur
			out xsub ir
		out checked-to-nat32 names, integral-type
		unless empty-out-elem
			out new-array-for-type ctx, x.out-element
		out xstore type.as-runtime-type, out-array
		ctx must-pop type

	out-offset local-index? = match x input-kind
	as array
		()
	as range
		unless is-void
			out xload ir, cur
			out begin-synthetic-local ctx, integral-type

	loop-body void mut() = of
		unless empty-out-elem
			out aload out-array
			ctx pushed type
			out xload ir, cur
			if out-offset
				out xload ir, out-offset
				out xsub ir
			out unchecked-to-nat32 integral-type
			ctx pushed nat32
		match x input-kind
		as array
			unless x.in-element is-empty-type
				out aload in-array!
				out xload ir, cur
				out unchecked-to-nat32 integral-type
				out xaload x.in-element.as-runtime-type
				ctx pushed x.in-element
		as range
			out xload ir, cur
			ctx pushed integral-type
		# TODO:PERF in the case of looping over a range,
		# it could be more efficient to reuse 'cur' as the local for 'x.local' instead of copying it to a new local
		out emit-with-opt-local ctx, x.local, x.in-element, continue_, x.body
		unless empty-out-elem
			out astore x.out-element.as-runtime-type
			ctx must-pop x.out-element
			ctx must-pop nat32
			ctx must-pop type

	out loop-non-empty-range ctx, pos, type, integral-type, cur, end, loop-body, of
		# If there is no return type, make sure the stack frame does not include locals
		# (since it may be the same bytecode pos as the beginning stack frame of a loop)
		if out-offset
			ctx end-synthetic-local integral-type, out-offset
		goto-bottom jumps-to-here out, ctx.cur-stack-frame
		unless is-void
			out xload type.as-runtime-type, out-array
			ctx pushed type
		ctx end-synthetic-local type, out-array
		ctx end-synthetic-local integral-type, end
		ctx end-synthetic-local integral-type, cur
		if in-array
			ctx end-synthetic-local input-type, in-array

-emit-match-union void(out code-builder, ctx expr-ctx, pos expr-pos, type concrete-type, a match-union-concrete-expr)
	out emit-and-continue ctx, a.matched
	matched-type = a.matched type
	ctx must-peek matched-type
	match ctx union-representation matched-type
	as exception
		out emit-match-union-using-instanceof ctx, pos, type, a
	as sealed-interface
		out emit-match-union-using-instanceof ctx, pos, type, a
	as switch
		out emit-match-union-using-switch ctx, pos, type, a
	as nullable
		out with-inner-pos ctx, pos, of inner-pos
			null-case, non-null-case = if a.member-indices[0] == 0
				a.member-indices is (0, 1)
				a.cases only2
			else
				a.member-indices is (1, 0)
				a.cases.size is 2
				a.cases[1], a.cases[0]
			forbid _ ?= a else_

			jump = out ifnonnull
			ctx must-pop matched-type
			out emit-expr ctx, inner-pos, null-case # ignore null-case.local since it is an empty type

			# Change the stack to have the state from before the jump
			ctx must-pop type
			jump jumps-to-here out, ctx.cur-stack-frame
			out emit-expr ctx, inner-pos, non-null-case

-emit-match-union-using-instanceof void(out code-builder, ctx expr-ctx, pos expr-pos, type concrete-type, x match-union-concrete-expr)
	# Note: I tested using a 'switch' on the 'case-index' method, but it didn't improve performance.
	matched-type = x.matched type
	out with-inner-pos ctx, pos, of inner-pos
		for member-index, case_ in x.member-indices.to-array zip x.cases
			is-last-case = member-index == x.member-indices[end - 1]
			case-type = x.union_.members[member-index]
			unless is-last-case
				out dup32
			out instanceof do ctx.names class_ case-type
			# Jump to next if the equality test returned 0 (false)
			jump = out ifeq
			unless is-last-case
				out pop matched-type.as-runtime-type
			ctx must-pop matched-type
			out emit-expr ctx, inner-pos, case_

			# Change the stack to have the state from before 'jump'
			ctx must-pop type
			unless is-last-case
				ctx pushed matched-type
			jump jumps-to-here out, ctx.cur-stack-frame
		if e ?= x else_
			out emit-expr ctx, inner-pos, e
			ctx must-peek type
		else
			# TODO: If the type is 'exception' and we're calling 'show', we should call 'toString' in this case? -----------
			out emit-unreachable ctx.names
			# Treat the stack effect as if it was successful
			ctx pushed type

-emit-match-union-using-switch void
	out code-builder
	ctx expr-ctx
	pos expr-pos
	type concrete-type
	a match-union-concrete-expr
do
	out get-switchable-kind ctx, a.matched.type
	ctx must-pop a.matched.type
	ctx pushed ctx.program.nat32
	out with-inner-pos ctx, pos, of inner-pos
		# This consumes 'kind'
		ctx must-pop ctx.program.nat32
		jump-to-case, jump-to-default = out lookupswitch (a.member-indices map it.to) # TODO: use a table switch usually
		for target, case_ in jump-to-case zip a.cases
			target jumps-to-here out, ctx.cur-stack-frame
			out emit-expr ctx, inner-pos, case_
			# Change the stack to have the state from before 'jump'
			ctx must-pop type
		# default case
		jump-to-default jumps-to-here out,  ctx.cur-stack-frame
		if e ?= a else_
			out emit-expr ctx, pos, e
			ctx must-peek type
		else
			out emit-unreachable ctx.names
			ctx pushed type

-xsub void(out code-builder, type java-runtime-type)
	match type java-primitive-type!
	as T_INT
		out isub
	as T_LONG
		out lsub
	else
		throw unreachable

-checked-to-nat32 void(out code-builder, names java-refs, integral-type concrete-type)
	match integral-type.as-runtime-type java-primitive-type!
	as T_LONG
		out invokestatic names.crow-nat32-from-nat64
	as T_INT
		()
	else
		throw unreachable
-unchecked-to-nat32 void(out code-builder, integral-type concrete-type)
	match integral-type.as-runtime-type java-primitive-type!
	as T_LONG
		out l2i
	as T_INT
		()
	else
		throw unreachable

| Caller should push two integrals 'cur' and 'end' on the stack before calling this.
-loop-non-empty-range void
	out code-builder
	ctx expr-ctx
	pos expr-pos
	type concrete-type
	integral-type concrete-type
	cur local-index
	end local-index
	loop-body void mut()
	after-loop void mut()
do
	###
	loop:
	<<loop body>>
	cur++
	if cur != end: goto loop
	###

	ir = integral-type as-runtime-type
	cur-and-end void mut() = of
		out xload ir, cur
		out xload ir, end
	is-64-bit bool = match ir java-primitive-type!
	as T_LONG
		true
	as T_INT
		false
	else
		throw unreachable

	loop_ = out can-jump-back-to-here ctx.cur-stack-frame
	loop-body[]

	out increment-integral cur, integral-type
	cur-and-end[]
	if is-64-bit
		out lcmp
		out ifne loop_
	else
		out if_icmpne loop_

	before = out next-index
	after-loop[]
	if out.next-index == before
		# Give it space for a stack frame after the loop
		out nop
	out handle-pos pos, type # TODO: then there is a double jump in some cases, improve? -------------------

-increment-integral void(out code-builder, local nat, integral-type concrete-type)
	java-type = integral-type as-runtime-type
	out xload java-type, local
	match java-type java-primitive-type!
	as T_LONG
		out lconst 1
		out ladd
	as T_INT
		out iconst 1
		out iadd
	else
		throw unreachable
	out xstore java-type, local

-get-local void(out code-builder, ctx expr-ctx, local concrete-local)
	guard local.type !is-empty-type
	match x = ctx explain-local local
	as nat
		out xload local.type.as-runtime-type, x
	as field-reference
		out aload 0
		out getfield x

-create-lambda-implementation-class symbol
	ctx to-java-ctx
	uri uri
	containing-fun concrete-fun
	lambda-type concrete-type
	a lambda-concrete-expr
do
	names java-refs = ctx.names start-new-class
	this-class-name = names lambda-impl-class-name containing-fun, ctx.next-lambda-index
	ctx.next-lambda-index +:= 1
	this-class = names.constants class_ this-class-name
	closure field-reference[concrete-local] = for x in a closure
		assert x.type !is-empty-type
		x, do names lambda-impl-field this-class, x
	super-class = names class_ lambda-type
	fields field_info[] = if a.closure is-empty
		(names instance-field this-class-name),
	else
		for x in a.closure
			assert x.type !is-empty-type
			access-flags: final
			name: names lambda-impl-field-name x
			descriptor: names descriptor-for-field-type x.type
			attributes: ()
	methods method_info[] = with methods-out in build
		field-refs (field-reference, java-runtime-type)[] = for local in a.closure
			closure[local]!, local.type.as-runtime-type
		methods-out ~= names record-initializer super-class, field-refs, do names lambda-init-descriptor a
		if a.closure is-empty
			methods-out ~= names clinit-for-instance-field this-class-name, this-class
		methods-out ~=
			expr-ctx expr-ctx = ctx, names, this-class, containing-fun, closure, true,
				if a.param.type !is-empty-type 
					- a param
			code = with out in names build-code
				out emit-expr expr-ctx, return, a.body
			expr-ctx verify-expr-ctx-finished a.body.type, (a.param,)
			access-flags: if lambda-type lambda-type-is-runnable then public
			name: names run
			descriptor: names lambda-call-descriptor lambda-type
			attributes: code,
	ctx add-class this-class-name,
		source SourceFile_attribute = names.SourceFile, names.constants[uri to]
		constant-pool: names finish
		access: final
		this-class: this-class
		super-class: super-class
		interfaces: ()
		fields: fields
		methods: methods
		attributes: source,
	this-class-name

-always-throws bool(a concrete-expr)
	match x = a kind
	as finally-concrete-expr
		x.below always-throws
	as seq-concrete-expr
		x.parts exists it.always-throws
	as throw-concrete-expr
		true
	else
		false

-get-switchable-kind void(out code-builder, ctx expr-ctx, union-type concrete-type)
	out getfield do ctx.names switchable-kind-field union-type
-get-switchable-value void(out code-builder, ctx expr-ctx, union-type concrete-type)
	out getfield do ctx.names switchable-value-field union-type

-fits-in-int32 bool(a int64)
	min-value::int32.to::int64 <= a and a <= max-value::int32.to
-fits-in-nat32 bool(a nat64)
	a <= max-value::nat32.to

-emit-with-unboxed-opt-local void
	out code-builder
	ctx expr-ctx
	unboxed-type concrete-type
	local concrete-local?
	pos expr-pos
	expr concrete-expr
do
	assert unboxed-type.as-runtime-type == reference-type
	if local
		out unbox-if-necessary ctx.names, local.type
		ctx must-refine unboxed-type, local.type
		out emit-with-local ctx, local, pos, expr
	else
		out pop reference-type
		ctx must-pop unboxed-type
		out emit-expr ctx, pos, expr

-emit-with-opt-local void(out code-builder, ctx expr-ctx, local concrete-local?, local-type concrete-type, pos expr-pos, expr concrete-expr)
	if local
		local.type is local-type
		out emit-with-local ctx, local, pos, expr
	else
		out pop local-type.as-runtime-type
		ctx must-pop local-type
		out emit-expr ctx, pos, expr

-emit-with-local void(out code-builder, ctx expr-ctx, local concrete-local, pos expr-pos, expr concrete-expr)
	out store-local ctx, local
	out emit-expr ctx, pos, expr
	unless local.type is-empty-type
		ctx.locals.pop! is local
-store-local void(out code-builder, ctx expr-ctx, local concrete-local)
	guard local.type !is-empty-type
	out xstore local.type.as-runtime-type, ctx.next-local-index
	ctx must-pop local.type
	ctx.locals ~= local

-local-index alias
	nat
-begin-synthetic-local nat(out code-builder, ctx expr-ctx, local-type concrete-type)
	local = ctx next-local-index
	unless local-type is-empty-type
		out xstore local-type.as-runtime-type, local
		ctx.locals ~= local-type
	local
-end-synthetic-local void(ctx expr-ctx, local-type concrete-type, local nat)
	unless local-type is-empty-type
		ctx.locals.pop! is local-type
	ctx.next-local-index is local

-exception-case-type-from-index concrete-type(ctx expr-ctx, exception-case-index nat)
	ctx.program.exception.body.concrete-union!.members[exception-case-index]

| Used before an instruction that will use the args
-emit-args void(out code-builder, ctx expr-ctx, args concrete-expr[])
	for arg in args
		out emit-and-continue ctx, arg
		ctx must-peek arg.type
| Does not actually pop args, just acknowledges that some operation took values off of the stack
-popped-args void(ctx expr-ctx, args concrete-expr[])
	for arg concrete-expr in args reverse # TODO: should not need type annotation
		ctx must-pop arg.type
-pushed void(ctx expr-ctx, type concrete-type)
	unless type is-empty-type
		ctx.stack ~= type
-must-pop void(ctx expr-ctx, type concrete-type)
	unless type is-empty-type
		ctx.stack.pop! is type
-must-peek void(ctx expr-ctx, type concrete-type)
	unless type is-empty-type
		ctx.stack.peek! is type
| Can use this for an up or down cast
-must-refine void(ctx expr-ctx, old-type concrete-type, new-type concrete-type)
	unless old-type is-empty-type
		ctx.stack.pop! is old-type
	unless new-type is-empty-type
		ctx.stack ~= new-type
-function-like void(out code-builder, ctx expr-ctx, return-type concrete-type, args concrete-expr[], f void mut())
	out emit-args ctx, args
	f[]
	ctx popped-args args
	ctx pushed return-type

-translate-builtin void
	out code-builder
	ctx expr-ctx
	fun builtin-fun
	type-args concrete-type[]
	type concrete-type
	args concrete-expr[]
do
	match fun
	as builtin-unary
		out function-like ctx, type, args, of
			out translate-builtin-unary ctx, type, args.only.type, fun, type-args
	as builtin-binary
		out function-like ctx, type, args, of
			out translate-builtin-binary ctx.names, type, args[0].type, fun
	as builtin-ternary
		out translate-builtin-ternary ctx, fun, args
	as builtin-fun-call-lambda
		out function-like ctx, type, args, of
			lambda, _ = args only2
			out invokevirtual do ctx.names lambda-call lambda.type
	as builtin-fun-constant
		throw unreachable
	as builtin-fun-is-empty-type
		throw unreachable
	as js-fun
		throw unreachable

-translate-builtin-unary void
	out code-builder
	ctx expr-ctx
	return-type concrete-type
	arg-type concrete-type
	kind builtin-unary
	type-args concrete-type[]
do
	names = ctx names
	match kind
	as array-size
		unless type-args.only is-empty-type
			out arraylength
		out i2l
	as bits-of-float32
		out invokestatic names.java-floatToRawIntBits
	as bits-of-float64
		out invokestatic names.java-doubleToRawLongBits
	as bitwise-not
		match return-type.as-integral-type! to-signed
		as int8
			out iconst -1
			out ixor
			out i2b
		as int16
			out iconst -1
			out ixor
			out i2s
		as int32
			out iconst -1
			out ixor
		as int64
			out lconst -1
			out lxor
	as float32-from-bits
		out invokestatic names.java-intBitsToFloat
	as float64-from-bits
		out invokestatic names.java-longBitsToDouble
	as gc-safe-mut-slice
		out l2i # TODO: throw OOM if it's too big to fit in an int32 -------------------------------------------------------------------------
		out new-array-for-type ctx, type-args.only
	as not
		# Negate all bits, then mask back to a single bit
		out iconst -1
		out ixor
		out iconst 1
		out iand
	as reinterpret-cast
		if return-type is-array-or-mut-array and arg-type is-array-or-mut-array and return-type.array-element-type == arg-type.array-element-type
			# Do nothing, they have the same representation
			()
		elif return-type is-Object
			out box-no-refine ctx.names, arg-type, return-type
		else
			out cast-and-unbox-if-necessary ctx, return-type
	as to-float32-from-float64
		out d2f
	as to-float64-from-float32
		out f2d
	as to-float64-from-int64
		out l2d
	as to-float64-from-nat64
		out invokestatic names.crow-float64FromNat64
	as truncate-to-int64-from-float64
		out d2l
	as weak-ref-get
		out invokestatic names.crow-weakRefGet
		out cast-and-unbox-if-necessary ctx, type-args.only
	as weak-ref-new
		out invokestatic names.crow-newWeakRef
	as wrap-convert-integral
		out convert-integral return-type.as-integral-type-allow-char!, arg-type.as-integral-type-allow-char!

-is-Object bool(a concrete-type)
	guard j ?= a.body struct-body-extern-java
	j.path == "java/lang/Object".as-path

-convert-integral void(out code-builder, return-type integral-type, arg-type integral-type)
	return-signed = return-type to-signed
	arg-signed, arg-is-signed = arg-type to-signed-and-is-signed
	if arg-is-signed
		out convert-signed-integral return-signed, arg-signed
	else
		out convert-unsigned-integral return-signed, arg-signed
	# If the sign differs, just let it wrap
-convert-unsigned-integral void(out code-builder, return-type signed-integral-type, arg-type signed-integral-type)
	out convert-signed-integral return-type, arg-type
	guard return-type > arg-type
	match arg-type
	as int8
		if return-type == int64
			out lconst 0xff
			out land
		else
			out iconst 0xff
			out iand
	as int16
		if return-type == int64
			out lconst 0xffff
			out land
		else
			out iconst 0xffff
			out iand
	as int32
		assert return-type == int64
		out lconst 0xffffffff
		out land
	as int64
		throw unreachable
-convert-signed-integral void(out code-builder, return-type signed-integral-type, arg-type signed-integral-type)
	match return-type
	as int8
		match arg-type
		as int8
			()
		as int16
			# There's no 's2b' because integers are always stored as int32 at miminum
			out i2b
		as int32
			out i2b
		as int64
			out l2i
			out i2b
	as int16
		match arg-type
		as int8
			()
		as int16
			()
		as int32
			out i2s
		as int64
			out l2i
			out i2s
	as int32
		if arg-type == int64
			out l2i
	as int64
		if arg-type != int64
			out i2l

-translate-builtin-binary void(out code-builder, names java-refs, return-type concrete-type, param0-type concrete-type, kind builtin-binary)
	match kind
	as add-float
		match return-type as-float-type!
		as float32
			out fadd
		as float64
			out dadd
	as array-get
		if return-type is-empty-type
			out pop T_LONG
		else
			out l2i
			out xaload return-type.as-runtime-type
	as bitwise-and
		if return-type.as-integral-type! is-64-bit
			out land
		else
			out iand
	as bitwise-or
		if return-type.as-integral-type! is-64-bit
			out lor
		else
			out ior
	as bitwise-xor
		if return-type.as-integral-type! is-64-bit
			out lxor
		else
			out ixor
	as equal-exact
		out reference-equal names, param0-type
	as equal-float-ieee
		out invokestatic do names crow-equal-float-ieee param0-type.as-float-type!
	as less
		out invokestatic do names crow-less-integral param0-type.as-integral-type-allow-bool-char!
	as less-float-ieee
		out invokestatic do names crow-less-float-ieee param0-type.as-float-type!
	as mul-float
		match return-type as-float-type!
		as float32
			out fmul
		as float64
			out dmul
	as sub-float
		match return-type as-float-type!
		as float32
			out fsub
		as float64
			out dsub
	as unsafe-bit-shift-left-nat64
		out l2i # second argument must be an int. TODO: then make that the function signature for unsafe-bit-shift-left?????
		out lshl
	as unsafe-bit-shift-right-nat64
		out l2i # second argument must be an int. TODO: then make that the function signature for unsafe-bit-shift-left?????
		out lushr
	as unsafe-div
		if f ?= return-type as-float-type
			match f
			as float32
				out fdiv
			as float64
				out ddiv
		else
			i = return-type as-integral-type!
			if i is-signed
				if i == int64
					out ldiv
				else
					out idiv
			else
				out invokestatic do names java-divideUnsigned i.to-signed
	as unsafe-mod-float64
		out drem
	as unsafe-mod-nat64
		out invokestatic do names java-remainderUnsigned int64
	as wrap-add
		if return-type.as-integral-type! is-64-bit
			out ladd
		else
			out iadd
	as wrap-mul
		if return-type.as-integral-type! is-64-bit
			out lmul
		else
			out imul
	as wrap-sub
		if return-type.as-integral-type! is-64-bit
			out lsub
		else
			out isub

-translate-builtin-ternary void(out code-builder, ctx expr-ctx, kind builtin-ternary, args concrete-expr[])
	match kind
	as array-set
		array, index, value = args only3
		out emit-and-continue ctx, array
		out emit-and-continue ctx, index
		out l2i
		out emit-and-continue ctx, value
		if value.type is-empty-type
			out pop T_INT
			out pop reference-type
		else
			out astore value.type.as-runtime-type
		ctx popped-args args

-reference-equal void(out code-builder, names java-refs, param-type concrete-type)
	match rt = param-type as-runtime-type
	as void
		throw todo # TODO: if param-type is void, just push 'true' -------------------------------------------------------------------------
	as java-primitive-type
		out invokestatic match rt
		as T_BOOLEAN
			names crow-equal-integral int8
		as T_CHAR
			names crow-equal-integral nat8
		as T_FLOAT
			names crow-equal-float float32
		as T_DOUBLE
			names crow-equal-float float64
		as T_BYTE
			names crow-equal-integral int8
		as T_SHORT
			names crow-equal-integral int16
		as T_INT
			names crow-equal-integral int32
		as T_LONG
			names crow-equal-integral int64
	as reference-type
		out invokestatic names.crow-reference-equal

-as-integral-type-allow-bool-char integral-type?(a concrete-type)
	if a is-bool
		nat8
	else
		a as-integral-type-allow-char

-get-array-size void(out code-builder, element concrete-type, local nat)
	if element is-empty-type
		out iload local
	else
		out aload local
		out arraylength
