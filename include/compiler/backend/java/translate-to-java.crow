import
	../../frontend/show-model
	../../model/concrete-model
	../../model/integral-values
	../../model/model
	../../model/show-low-model
	../../model/version-info
	../../util/util
	../mangle
	../concrete-mangle
	./java-ast
	./write-java-ast

translate-to-java string(
	program program,
	concrete-program concrete-program,
	show-ctx show-type-ctx,
)
	ctx to-java-ctx = do
		model-program: program
		program: concrete-program
		show-ctx: show-ctx
		funs-lookup: concrete-program.funs-lookup
		mangled-names: concrete-program.build-mangled-names
		structs-for-integrals: concrete-program.get-structs-for-integrals
		iife-types: ()
	classes java-class[] = with out : build
		for struct : concrete-program all-structs
			out ~~= ctx translate-struct struct
		out ~= do
			comment: ""
			name: "Functions"
			extends: ()
			fields: ctx translate-vars concrete-program
			constructor: ()
			methods: ctx translate-functions concrete-program
		out ~= do
			comment: ""
			name: "Main"
			extends: ()
			fields: ()
			constructor: ()
			methods: (ctx.call-main,)
	interfaces java-interface[] = for id, type : ctx iife-types
		method java-interface-method = (ctx as-type type), "call", ()
		"Iife{id value}", (method,)
	(classes, interfaces) write-java-ast

-funs-lookup concrete-fun[concrete-fun-id](a concrete-program)
	for fun : a all-funs
		fun.id, fun	

-call-main java-method(ctx to-java-ctx)
	###
	public static void main(String[] args) \{
		try {
			int exit = (int) Functions.main123(args);
			if (exit != 0) System.exit(exit);
		} catch (crow_exception e) {
			System.err.println(show(e));
			e.printStackTrace();
			System.exit(1);
		}
	}
	###
	common-funs = ctx.program.common-funs concrete-common-funs-java!
	main = common-funs main
	string-array java-type = "java.lang.String".to java-array-type
	params java-param[] = (string-array, "args"),
	get-args = "args" java-local-access
	call-main = "Functions.{ctx.mangled-names[main]}" java-call-static-method (get-args,)
	declare-exit = "int".to java-var-decl "exit", (("int".to java-cast call-main),)
	get-exit = "exit" java-local-access
	exit-not-zero = not-equal java-binary get-exit, zero
	system-exit = "java.lang.System.exit" java-call-static-method (get-exit,)
	maybe-exit = exit-not-zero java-if-statement system-exit.to, ()

	tried java-block-statement = (declare-exit, maybe-exit),
	e = "e" java-local-access
	show-e = "Functions.{ctx.mangled-names[common-funs show-exception]}" java-call-static-method (e,)
	println-show-e = "java.lang.System.err.println" java-call-static-method (show-e,)
	print-stack-trace = e java-call-instance-method "printStackTrace", ()
	exit-1 = "java.lang.System.exit" java-call-static-method (1.java-literal-int32-or-less,)
	catch-block java-statement[] = println-show-e.to, print-stack-trace.to, exit-1.to
	catch_ java-catch = "java.lang.RuntimeException", "e", (catch-block,)
	try_ = tried java-try-statement (catch_,), ()

	"", public, static, "void".to, "main", params, try_.to

-zero java-expr()
	0 java-literal-int32-or-less

-exception concrete-struct(ctx to-java-ctx)
	ctx.program.common-funs.concrete-common-funs-java!.exception
-is-exception bool(ctx to-java-ctx, type concrete-struct)
	type == ctx.exception

-translate-vars java-field[](ctx to-java-ctx, program concrete-program)
	for var : program all-vars
		name = ctx.mangled-names[var]
		match var kind
		as global_
			private, static, (ctx as-type var.type), name, ()
		as thread-local_
			init = "java.lang.ThreadLocal<?>" java-new ()
			private, static, "java.lang.ThreadLocal<?>".to, name, (init,)

-translate-functions java-method[](ctx to-java-ctx, program concrete-program)
	for fun : program all-funs
		expr-ctx to-expr-ctx = ctx, (), 0, ()
		params java-param[] = for param : fun params
			(ctx as-type param.type), (expr-ctx local-name param)
		body java-block-statement = match fun body
		as concrete-fun-body-builtin builtin_
			args java-expr[] = for param : fun params; expr-ctx get-local param
			match expr-ctx translate-builtin return, builtin_.kind, builtin_.type-args, fun.return-type.struct, args
			as java-expr x
				x.java-return-statement to
			as java-block-statement x
				x
		as concrete-fun-body-extern _
			throw-bogus to
		as concrete-expr x
			expr-ctx to-block-statement return, x
		as concrete-fun-body-var-get x
			params.size is 0
			access = "Functions" java-access-static-field ctx.mangled-names[x.var]
			match x.var kind
			as thread-local_
				expr = ctx cast-and-unbox x.var.type.struct, (access java-call-instance-method "get", ())
				expr.java-return-statement to
			as global_
				access.java-return-statement to
		as concrete-fun-body-var-set x
			params.size is 1
			access = "Functions" java-access-static-field ctx.mangled-names[x.var]
			arg = expr-ctx get-local fun.params.only
			statement java-statement = match x.var kind
			as thread-local_
				access java-call-instance-method "set", ((ctx box fun.params.only.type.struct, arg),) to
			as global_
				access java-assign-statement arg
			(statement, return-void),
		as concrete-fun-body-deferred
			throw unreachable
		comment = ctx.show-ctx.show show-concrete-fun-sig fun, false
		comment, internal, static, (ctx as-type fun.return-type), ctx.mangled-names[fun], params, body

-get-local java-expr(ctx to-expr-ctx, local concrete-local)
	ctx local-name local java-local-access
-local-name string(ctx to-expr-ctx, local concrete-local)
	match local source
	as local l
		l.name.mangle
	as concrete-local-source-closure
		"_closure"
	as concrete-generated-local-kind x
		index = ctx.temp-local-indices ensure local.id, () =>
			ctx.temp-local-indices size
		"{x.to::symbol}{index}"

-throw-message java-statement(message string)
	"java.lang.RuntimeException" java-new (message.java-literal-string,) java-throw-statement
-throw-bogus java-statement()
	"BOGUS" throw-message
-throw-unreachable java-statement()
	"Should be unreachable" throw-message

-to-java-ctx record mut
	model-program program
	program concrete-program
	show-ctx show-type-ctx
	funs-lookup concrete-fun[concrete-fun-id]
	mangled-names concrete-mangled-names
	structs-for-integrals concrete-struct[integral-type]
	iife-types concrete-struct mut[concrete-struct-id]

-iife-type string(ctx to-java-ctx, a concrete-struct)
	_ = ctx.iife-types ensure a.id, () => a
	"Iife{a.id value}"

-get-structs-for-integrals concrete-struct[integral-type](a concrete-program)
	res concrete-struct mut[integral-type] = ()
	for struct : a all-structs
		if builtin_ ?= struct.body concrete-builtin-type
			if i ?= builtin_.kind.to::integral-type?
				forbid i in res
				res[i] := struct
	res move-to

-to-expr-ctx record mut
	ctx to-java-ctx
	temp-local-indices nat mut[concrete-local-id]
	upcoming-temp-index mut nat
	cur-loop-label mut string?
-mangled-names concrete-mangled-names(a to-expr-ctx)
	a.ctx mangled-names
-take-next-temp-index nat(a to-expr-ctx)
	res = a upcoming-temp-index
	a.upcoming-temp-index +:= 1
	res

-translate-struct java-class?(ctx to-java-ctx, struct concrete-struct)
	super string? = match struct source
	as concrete-struct-source-bogus
		()
	as concrete-struct-source-inst inst
		if inst.decl.sum-type-memberships exists x => x.sum-type == ctx.model-program.common-types.exception
			"java.lang.RuntimeException",
	as concrete-struct-source-lambda _
		()

	comment = ctx.show-ctx.show show-concrete-struct struct
	name = ctx.mangled-names[struct]
	match struct body
	as concrete-builtin-type x
		unless _ ?= x.kind as-java-lang-class
			match x.kind
			as array
				()
			as mut-slice
				()
			else
				primitive-type java-type = x.kind.as-primitive-type! to
				(comment boxing-class name, super, primitive-type),
	as concrete-enum x
		(comment boxing-class name, super, x.storage_.as-type),
	as concrete-extern-type _
		()
	as concrete-flags x
		(comment boxing-class name, super, x.storage_.as-type),
	as concrete-record r
		fields java-field[] = for field : r fields
			internal, instance, (ctx as-type field.type), field.debug-name.mangle, ()
		(comment basic-class name, super, fields),
	as concrete-union _
		# Unions just compile to Object
		()
	as concrete-struct-body-deferred
		throw unreachable

-mangle string(a symbol)
	if a is-java-keyword
		"_{a}"
	else
		a.to mangle-name-common

-is-java-keyword bool(a symbol)
	match a
	as "abstract"
		true
	as "assert"
		true
	as boolean
		true
	as "break"
		true
	as byte
		true
	as "case"
		true
	as "catch"
		true
	as char
		true
	as "class"
		true
	as const
		true
	as "continue"
		true
	as default
		true
	as "do"
		true
	as double
		true
	as "else"
		true
	as "enum"
		true
	as extends
		true
	as final
		true
	as "finally"
		true
	as float
		true
	as "for"
		true
	as goto
		true
	as "if"
		true
	as implements
		true
	as "import"
		true
	as instanfeof
		true
	as int
		true
	as "interface"
		true
	as long
		true
	as native
		true
	as new
		true
	as package
		true
	as private
		true
	as protected
		true
	as public
		true
	as return
		true
	as short
		true
	as static
		true
	as strictfp
		true
	as super
		true
	as switch
		true
	as synchronized
		true
	as this
		true
	as "throw"
		true
	as throws
		true
	as transient
		true
	as "try"
		true
	as void
		true
	as volatile
		true
	as "while"
		true
	else
		false

-boxing-class java-class(comment string, name string, super string?, primitive-type java-type)
	value-field java-field = internal, instance, primitive-type, "value", ()
	comment basic-class name, super, (value-field,)

-basic-class java-class(comment string, name string, super-class string?, fields java-field[])
	assigns java-statement[] = for field : fields
		java-this java-property-access field.name java-assign-statement field.name.java-local-access
	params java-param[] = for field : fields
		field.type, field.name
	constructor java-constructor = params, (assigns,)
	comment, name, super-class, fields, (constructor,), ()

-as-type java-type(ctx to-java-ctx, struct concrete-struct, a concrete-builtin-type)
	if primitive ?= a.kind as-primitive-type
		primitive to
	else
		ctx as-boxed-type struct, a

-as-primitive-type string?(a builtin-type)
	match a
	as array
		()
	as bool
		"boolean",
	as catch-point
		()
	as char8
		"char",
	as char32
		"int",
	as const-pointer
		()
	as float32
		"float",
	as float64
		"double",
	as fun-pointer
		()
	as future
		()
	as int8
		"byte",
	as int16
		"short",
	as int32
		"int",
	as int64
		"long",
	as java-any
		()
	as java-exclusion
		"java.util.concurrent.locks.ReentrantLock", # TODO: I thinkthis will not be reached? --------------------------------------
	as js-any
		()
	as fun-data
		throw unreachable
	as fun-mut
		throw unreachable
	as fun-shared
		throw unreachable
	as mut-array
		()
	as mut-pointer
		()
	as mut-slice
		()
	as nat8
		"byte",
	as nat16
		"short",
	as nat32
		"int",
	as nat64
		"long",
	as option
		throw unreachable
	as string
		()
	as symbol
		()
	as void
		()
	
-as-type java-type(a integral-type)
	a.to.as-primitive-type! to

-as-type-expr java-expr(ctx to-java-ctx, type concrete-type)
	ctx as-type type java-class-expr
-as-class string(ctx to-java-ctx, type concrete-struct)
	ctx as-type type string!
-as-type java-type(ctx to-java-ctx, type concrete-type)
	ctx as-type type.struct
-as-type java-type(ctx to-java-ctx, type concrete-struct)
	match type body
	as concrete-builtin-type x
		ctx as-type type, x
	as concrete-enum x
		x.storage_ as-type
	as concrete-extern-type
		throw todo
	as concrete-flags x
		x.storage_ as-type
	as concrete-record _
		ctx.mangled-names[type] to
	as concrete-union _
		if ctx is-exception type
			"java.lang.RuntimeException" to
		else
			"java.lang.Object" to
	as concrete-struct-body-deferred
		throw unreachable
-as-type java-type(ctx to-expr-ctx, type concrete-struct)
	ctx.ctx as-type type
-as-boxed-type java-type(ctx to-java-ctx, type concrete-type)
	ctx as-boxed-type type.struct
-as-boxed-type java-type(ctx to-java-ctx, type concrete-struct)
	match type body
	as concrete-builtin-type x
		ctx as-boxed-type type, x
	as concrete-enum x
		ctx as-boxed-type x.storage_
	as concrete-extern-type
		throw todo
	as concrete-flags x
		ctx as-boxed-type x.storage_
	as concrete-record _
		ctx as-type type
	as concrete-union _
		ctx as-type type
	as concrete-struct-body-deferred
		throw unreachable

-box java-expr(ctx to-java-ctx, struct concrete-struct, arg java-expr)
	if builtin_ ?= struct.body concrete-builtin-type
		match builtin_ kind
		as array
			arg
		as mut-slice
			arg
		else
			if x ?= builtin_.kind as-java-lang-class
				x.to java-cast arg
			else
				ctx.mangled-names[struct] java-new (arg,)
	else
		arg

-unbox java-expr(ctx to-java-ctx, type concrete-struct, arg java-expr)
	if builtin_ ?= type.body concrete-builtin-type
		match builtin_ kind
		as array
			arg
		as mut-slice
			arg
		else
			if _ ?= builtin_.kind as-java-lang-class
				(ctx as-type type) java-cast arg
			else
				arg java-property-access "value"
	else
		arg

-cast-and-unbox java-expr(ctx to-java-ctx, type concrete-struct, arg java-expr)
	ctx unbox type, (ctx as-boxed-type type java-cast arg)

-as-boxed-type java-type(ctx to-java-ctx, struct concrete-struct, a concrete-builtin-type)
	match a kind
	as array
		ctx as-type a.type-args.only java-array-type
	as mut-slice
		ctx as-type a.type-args.only java-array-type
	else
		if x ?= a.kind as-java-lang-class
			x to
		else
			ctx.mangled-names[struct] to

-as-boxed-type java-type(ctx to-java-ctx, a integral-type)
	if x ?= a.to as-java-lang-class
		x to
	else
		ctx.mangled-names[ctx.structs-for-integrals[a]!] to

-as-java-lang-class string?(a builtin-type)
	match a
	as array
		()
	as bool
		"java.lang.Boolean",
	as catch-point
		"java.lang.Object",
	as char8
		"java.lang.Character",
	as char32
		()
	as const-pointer
		"java.lang.Object",
	as float32
		"java.lang.Float",
	as float64
		"java.lang.Double",
	as fun-pointer
		"java.lang.invoke.MethodHandle",
	as future
		"java.util.concurrent.Future",
	as int8
		"java.lang.Byte",
	as int16
		"java.lang.Short",
	as int32
		"java.lang.Integer",
	as int64
		"java.lang.Long",
	as java-any
		"java.lang.Object",
	as java-exclusion
		"java.util.concurrent.locks.ReentrantLock",
	as js-any
		"java.lang.Object",
	as fun-data
		throw unreachable
	as fun-mut
		throw unreachable
	as fun-shared
		throw unreachable
	as mut-array
		"java.util.ArrayList",
	as mut-pointer
		"java.lang.Object",
	as mut-slice
		()
	as nat8
		()
	as nat16
		()
	as nat32
		()
	as nat64
		()
	as option
		throw unreachable
	as string
		"java.lang.String",
	as symbol
		"java.lang.String",
	as void
		"Void",

-expr-pos enum(no-return, return)

-to-block-statement java-block-statement(ctx to-expr-ctx, pos expr-pos, a concrete-expr)
	match ctx to-expr-or-block-statement pos, a
	as java-expr x
		x return-unless-void pos
	as java-block-statement x
		x
-return-unless-void java-block-statement(expr java-expr, pos expr-pos)
	match pos
	as no-return
		expr as-statement
	as return
		expr.java-return-statement to
-to-expr java-expr(ctx to-expr-ctx, a concrete-expr)
	match ctx to-expr-or-block-statement return, a
	as java-expr x
		x
	as java-block-statement x
		ctx.ctx iife-type a.type.struct java-iife x

-to-expr-or-block-statement java-expr-or-block-statement(ctx to-expr-ctx, pos expr-pos, a concrete-expr)
	type = a.type struct
	match a kind
	as builtin-concrete-expr x
		ctx translate-builtin pos, x.fun, x.type-args, type, for arg : x args
			ctx to-expr arg
	as call-concrete-expr x
		args java-expr[] = for arg : x args
			ctx to-expr arg
		ctx.mangled-names[x called] java-call-static-method args to
	as cast-concrete-expr x
		ctx as-type type java-cast (ctx to-expr x.inner) to
	as constant x
		ctx.ctx translate-constant type, x to
	as create-array-concrete-expr x
		args java-expr[] = for arg : x args
			ctx to-expr arg
		ctx as-type type.array-element-type.struct java-literal-array args to
	as create-record-concrete-expr x
		args java-expr[] = for arg : x args
			ctx to-expr arg
		ctx.mangled-names[type] java-new args to
	as create-union-concrete-expr x
		ctx.ctx box x.arg.type.struct, (ctx to-expr x.arg) to
	as drop-concrete-expr x
		expr = ctx to-expr x.arg
		expr.as-statement to
	as finally-concrete-expr x
		ctx to-block-statement pos, x.below java-try-statement (), ((ctx to-block-statement no-return, x.right),) to
	as if-concrete-expr x
		cond = ctx to-expr x.cond
		match ctx to-expr-or-block-statement pos, x.then
		as java-expr then
			match ctx to-expr-or-block-statement pos, x.else_
			as java-expr else_
				match pos
				as no-return
					cond java-if-statement then.to, else_.as-statement to
				as return
					cond java-ternary then, else_ to
			as java-block-statement else_
				then-statement = then return-unless-void pos
				cond java-if-statement then-statement, else_ to
		as java-block-statement then
			else_ = ctx to-block-statement pos, x.else_
			cond java-if-statement then, else_ to
	as let-concrete-expr x
		local = ctx local-name x.local
		value = ctx to-expr x.value
		then = ctx to-block-statement pos, x.then
		(ctx as-type x.local.type.struct java-var-decl local, (value,)) ~ then to
	as lambda-concrete-expr _
		throw unreachable
	as local-get-concrete-expr x
		(ctx local-name x.local).java-local-access to
	as local-pointer-concrete-expr _
		throw unreachable
	as local-set-concrete-expr x
		assign = (ctx local-name x.local).java-local-access java-assign-statement (ctx to-expr x.value)
		assign maybe-return-void pos to
	as loop-concrete-expr x
		label string? = match pos
		as no-return
			"loop{ctx take-next-temp-index}",
		as return
			()
		prev = ctx cur-loop-label
		ctx.cur-loop-label := label
		res = label java-while true.java-literal-boolean, (ctx to-block-statement pos, x.body)
		ctx.cur-loop-label := prev
		res to
	as loop-break-concrete-expr x
		value = ctx to-block-statement pos, x.value
		match pos
		as no-return
			value ~ ctx.cur-loop-label.java-break to
		as return
			value to
	as loop-continue-concrete-expr
		java-continue to
	as match-enum-or-integral-concrete-expr x
		matched-type = x matched-integral-type
		if matched-type != nat64.to && matched-type != int64.to # Java doesn't allow switch on long
			matched = ctx to-expr x.matched
			cases java-switch-case[] = for value, expr : x.case-values zip x.case-exprs
				integer = nat64 constant-integral value
				integer, pos maybe-break-switch-case (ctx to-block-statement pos, expr)
			default = if e ?= x else_
				ctx to-block-statement pos, e
			else
				throw-unreachable to
			matched java-switch-statement cases, default to
		else
			ctx with-temp "matched", x.matched, matched =>
				res mut = if e ?= x else_
					ctx to-block-statement pos, e
				else
					throw-unreachable to
				for value, expr : x.case-values zip x.case-exprs
					integer = nat64 constant-integral value
					eq = eq-eq java-binary matched, integer
					then = ctx to-block-statement pos, expr
					res := eq java-if-statement then, res to
				res
	as match-string-like-concrete-expr x
		matched = ctx to-expr x.matched
		cases java-switch-case[] = for case_ : x cases
			value = ctx to-expr case_.value
			value, pos maybe-break-switch-case (ctx to-block-statement pos, case_.then)
		default = ctx to-block-statement pos, x.else_
		matched java-switch-statement cases, default to
	as match-union-concrete-expr x
		###
		matched = ...
		if (matched instanceof x) {
			Foo x = (Foo) matched;
			...
		} else (if matched instanceof y)
			Bar x = (Bar) matched;
		etc ...
		###
		ctx with-temp "matched", x.matched, matched =>
			res mut = if e ?= x else_
				ctx to-block-statement pos, e
			else
				throw-unreachable to
			for case-type, case_ : x.case-types zip x.cases
				cond = matched java-instanceof (ctx.ctx as-boxed-type case-type)
				then = if local ?= case_ local
					value = ctx.ctx cast-and-unbox case-type.struct, matched
					decl = ctx as-type local.type.struct java-var-decl (ctx local-name local), (value,)
					decl ~ (ctx to-block-statement pos, case_.then)
				else
					ctx to-block-statement pos, case_.then
				res := cond java-if-statement then, res to
			res
	as record-field-get-concrete-expr x
		(ctx to-expr x.record_) java-property-access x.field.debug-name.mangle to
	as record-field-pointer-concrete-expr _
		throw unreachable
	as record-field-set-concrete-expr x
		access = ctx to-expr x.record_ java-property-access x.field.debug-name.mangle
		assign = access java-assign-statement (ctx to-expr x.value)
		assign maybe-return-void pos to
	as seq-concrete-expr x
		(ctx to-block-statement no-return, x.first) ~~ (ctx to-block-statement pos, x.then) to
	as throw-concrete-expr x
		(ctx to-expr x.thrown).java-throw-statement to
	as try-concrete-expr x
		tried = ctx to-block-statement pos, x.tried
		catch-clauses java-catch[] = for exception-case-index, case_ : x.exception-member-indices zip x.catch-cases
			local string = if l ?= case_ local
				ctx local-name l
			else
				"_{ctx take-next-temp-index}"
			then = ctx to-block-statement pos, case_.then
			(ctx.ctx exception-case-type-from-index exception-case-index), local, then
		tried java-try-statement catch-clauses, () to
	as try-let-concrete-expr x
		###
		x = try value catch err local : catch_
		then
		==>
		T local;
		boolean ok = false;
		try {
			local = value;
			ok = true;
		} catch (err catch_local) {
			catch_then;
		}
		if (ok) then
		###
		is-statement = match pos
		as no-return
			true
		as return
			false
		local = if concrete-local ?= x local
			ctx local-name concrete-local
		else
			"ignore{ctx take-next-temp-index}"
		declare-local = (ctx as-type x.value.type.struct) java-var-decl local, ()
		ok string? = if is-statement
			"ok{ctx take-next-temp-index}",
		declare-ok java-statement? = if o ?= ok
			("boolean".to java-var-decl  o, (false.java-literal-boolean,)),
		set-local = local.java-local-access java-assign-statement (ctx to-expr x.value)
		set-ok java-statement? = if o ?= ok
			(o.java-local-access java-assign-statement true.java-literal-boolean),
		caught-local = if l ?= x.catch_.local
			ctx local-name l
		else
			"temp{ctx take-next-temp-index}"
		catch-then = ctx to-block-statement pos, x.catch_.then
		catch_ java-catch = (ctx.ctx exception-case-type-from-index x.exception-member-index), caught-local, catch-then
		then = ctx to-block-statement pos, x.then
		after java-block-statement = if o ?= ok
			o.java-local-access java-if-statement then, () to
		else
			then
		tried java-statement[] = with out : build
			out ~= set-local
			out ~~= set-ok
		try_ = (tried,) java-try-statement (catch_,), ()
		statements java-statement[] = with out : build
			out ~= declare-local
			out ~~= declare-ok
			out ~= try_
			out ~~= after statements
		(statements,) to
	as union-as-concrete-expr x
		ctx.ctx cast-and-unbox x.case-type.struct, (ctx to-expr x.union_) to
	as union-kind-concrete-expr x
		###
		matched =  ...
		if (matched instanceof x)
			return 0;
		else if (matched instanceof y)
			return 1;
		...
		else
			throw new Error("Unreachable"); 
		###
		ctx with-temp "matched", x.union_, matched =>
			res mut java-block-statement = throw-unreachable to
			for case-index, case-type : x.union-members with-index
				is-case = matched java-instanceof (ctx.ctx as-boxed-type case-type)
				return-index = case-index.to.java-literal-int32-or-less java-return-statement
				res := is-case java-if-statement return-index.to, res to
			res

-exception-case-type-from-index string(ctx to-java-ctx, exception-case-index integral-value)
	exception-types = ctx.exception.body.concrete-union! members
	ctx as-type exception-types[exception-case-index as-unsigned].struct string!

-maybe-break-switch-case java-block-statement(pos expr-pos, a java-block-statement)
	match pos
	as no-return
		a ~ ().java-break
	as return
		a

-with-temp java-expr-or-block-statement(
	ctx to-expr-ctx,
	base-name string,
	value concrete-expr,
	f java-block-statement mut(get-temp java-expr),
)
	ctx with-temp base-name, value.type, (ctx to-expr value), f
-with-temp java-expr-or-block-statement(
	ctx to-expr-ctx,
	base-name string,
	type concrete-type,
	value java-expr,
	f java-block-statement mut(get-temp java-expr),
)
	name string = "{base-name}{ctx take-next-temp-index}"
	declare = ctx as-type type.struct java-var-decl name, (value,)
	then = f[name java-local-access]
	declare ~ then to

-translate-constant java-expr(ctx to-java-ctx, type concrete-struct, a constant)
	match type body
	as concrete-builtin-type x
		ctx translate-constant-builtin type, x, a
	as concrete-enum x
		x.storage_ constant-integral a
	as concrete-extern-type
		throw todo
	as concrete-flags x
		x.storage_ constant-integral a
	as concrete-record x
		# TODO:PERF Since these are allocated, we should probably make them global 'const' values too --------------------------
		class_ = ctx as-class type
		match a
		as constant-record r
			class_ java-new for field, arg : x.fields zip r.args
				ctx translate-constant field.type.struct, arg
		as constant-zero
			if x.fields is-empty
				class_ java-new ()
			else
				java-null
		else
			throw unreachable
	as concrete-union u
		match a
		as constant-union constant
			case-type = u.members[constant member-index]
			value = ctx translate-constant case-type.struct, constant.arg
			boxed-value = ctx box case-type.struct, value
			ctx as-type type java-cast boxed-value
		as constant-zero
			java-null
		else
			throw unreachable
	as concrete-struct-body-deferred
		throw unreachable
-translate-constant-builtin java-expr(ctx to-java-ctx, type concrete-struct, builtin_ concrete-builtin-type, a constant)
	error java-expr mut(message string) = message => # TODO: none of these should be reachable -------------------------------
		ctx iife-type type java-iife "SHOULD NOT BE A CONSTANT {message}?????".throw-message.to
	string java-expr mut() = () =>
		value string = match a
		as constant-array ca
			elements = ctx.program.all-constants.arrs[ca type-index].constants[ca index] # TODO: have a helper function for this
			chars char8[] = for x : elements
				x.as-integral.as-unsigned.to to
			chars to
		as constant-c-string x
			ctx.program.all-constants.c-strings[x index]
		as constant-zero
			""
		else
			throw unreachable
		value java-literal-string
	match builtin_ kind
	as array
		element-type = builtin_.type-args only
		java-element-type = ctx as-type element-type
		match a
		as constant-array ca
			elements = ctx.program.all-constants.arrs[ca type-index].constants[ca index] # TODO: have a helper function for this
			java-element-type java-literal-array for x : elements
				ctx translate-constant element-type.struct, x
		as constant-zero
			java-element-type java-literal-array ()
		else
			throw unreachable
	as bool
		a.as-bool java-literal-boolean
	as catch-point
		error["CATCH-POINT"]
	as char8
		u nat8 = a.as-integral.as-unsigned to
		"char".to java-cast u.wrap-to::int8.to.java-literal-int32-or-less
	as char32
		nat32 constant-integral a
	as const-pointer
		error["CONST-POINTER"]
	as float32
		true constant-float a
	as float64
		false constant-float a
	as fun-pointer
		id = a.constant-fun-pointer! fun
		fun = ctx.funs-lookup[id]!
		args java-expr[] = with out : build
			out ~= ctx.mangled-names[fun] java-literal-string
			out ~= ctx as-type-expr fun.return-type
			for param : fun params
				out ~= ctx as-type-expr param.type
		"Crow.funPointer" java-call-static-method args
	as future
		error["FUTURE"]
	as int8
		int8 constant-integral a
	as int16
		int16 constant-integral a
	as int32
		int32 constant-integral a
	as int64
		int64 constant-integral a
	as java-any
		error["JAVA-ANY"]
	as java-exclusion
		error["JAVA-EXCLUSION"]
	as js-any
		error["JS-ANY"]
	as fun-data
		error["FUN-DATA"]
	as fun-mut
		error["FUN-MUT"]
	as fun-shared
		error["FUN-SHARED"]
	as mut-array
		error["MUT-ARRAY"]
	as mut-pointer
		error["MUT-POINTER"]
	as mut-slice
		error["MUT-SLICE"]
	as nat8
		nat8 constant-integral a
	as nat16
		nat16 constant-integral a
	as nat32
		nat32 constant-integral a
	as nat64
		nat64 constant-integral a
	as option
		throw unreachable
	as string
		string[]
	as symbol
		string[]
	as void
		# TODO: 'concretize' should be responsible for removing all void values, except function return values. --------------------------
		void-expr

-maybe-return-void java-block-statement(statement java-statement, pos expr-pos)
	match pos
	as no-return
		statement to
	as return
		(statement, return-void),
-return-void java-statement()
	void-expr java-return-statement
-void-expr java-expr()
	"Void.get" java-call-static-method ()

-constant-float java-expr(is-float32 bool, a constant) # TODO: inilne -------------------------------------------------------
	is-float32 java-literal-float a.as-float
-constant-integral java-expr(type integral-type, a constant)
	type constant-integral a.as-integral
-constant-integral java-expr(type integral-type, value integral-value)
	match type
	as int8
		"byte".to java-cast (value.as-signed.to java-literal-int32-or-less)
	as int16
		"short".to java-cast (value.as-signed.to java-literal-int32-or-less)
	as int32
		value.as-signed.to java-literal-int32-or-less
	as int64
		if value.as-signed >= min-value::int32.to && value.as-signed <= max-value::int32.to
			value.as-signed.to java-literal-int32-or-less
		else
			value.as-signed java-literal-int64
	as nat8
		"byte".to java-cast (value.as-unsigned.to::nat8.wrap-to::int8.to java-literal-int32-or-less)
	as nat16
		"short".to java-cast (value.as-unsigned.to::nat16.wrap-to::int16.to java-literal-int32-or-less)
	as nat32
		value.as-unsigned.to.wrap-to java-literal-int32-or-less
	as nat64
		if value.as-unsigned <= max-value::nat32.to
			value.as-unsigned.to.wrap-to java-literal-int32-or-less
		else
			value.as-unsigned.wrap-to java-literal-int64

-translate-builtin java-expr-or-block-statement(ctx to-expr-ctx, pos expr-pos, fun builtin-fun, type-args concrete-type[], type concrete-struct, args java-expr[])
	match fun
	as builtin-fun-all-tests
		throw unreachable
	as builtin-unary x
		x translate-builtin-unary args.only
	as builtin-unary-math x
		x translate-builtin-unary-math args.only
	as builtin-binary x
		ctx.ctx translate-builtin-binary type, x, args.only2
	as builtin-binary-lazy _
		throw unreachable
	as builtin-binary-math x
		x translate-builtin-binary-math args.only2
	as builtin-ternary x
		match x
		as interpreter-backtrace
			"Reached interpreter-backtrace?????".throw-message to # TODO: should be unreachable ----------------------------------------------------------------------
	as builtin-4ary x
		match x
		as switch-fiber-initial
			"Reached switch-fiber-initial?????".throw-message to # TODO: should be unreachable ----------------------------------------------------------------------
	as builtin-fun-call-lambda
		args[0] java-call-instance-method "call", args[1 .. end] to
	as builtin-fun-call-fun-pointer
		_, param-type = type-args only2
		# TODO: it should probably be concretize's job to remove void expressions, since 'lower' would benefit from that too ............
		fn, param = args only2
		if param-type is-void
			assert param-type is-void : todo
			invoke = fn java-call-instance-method "invoke", ()
			cast-invoke = ctx.ctx cast-and-unbox type, invoke
			param.as-statement ~~ (cast-invoke return-unless-void pos) to
		elif param-type is-tuple
			# TODO: very similar code in translate-to-js. We could do this in concretize instead? -------------------------------------------------------------
			ctx with-temp "args", param-type, param, temp =>
				fields = param-type.must-be-by-val.body.concrete-record! fields
				invoke = fn java-call-instance-method "invoke", for field : fields
					temp java-property-access field.debug-name.mangle
				ctx.ctx cast-and-unbox type, invoke return-unless-void pos
		else
			invoke = fn java-call-instance-method "invoke", (param,)
			ctx.ctx cast-and-unbox type, invoke return-unless-void pos to
	as builtin-fun-constant _
		throw unreachable
	as builtin-fun-gc-safe-value
		args.size is 0
		type.gc-safe-value to
	as builtin-fun-init _
		throw unreachable
	as java-fun x
		match x
		as array-get
			args.size is 2
			args[0] java-array-get args[1] to
		as array-set
			args.size is 3
			assign = args[0] java-array-get args[1] java-assign-statement args[2]
			assign maybe-return-void pos to
		as as-java-any
			"java.lang.Object".to java-cast (ctx.ctx box type-args.only.struct, args.only) to
		as call-instance
			ctx.ctx cast-and-unbox type, ("Crow.callInstance" java-call-static-method args) to
		as call-new
			"Crow.callNew" java-call-static-method args to
		as call-static
			ctx.ctx cast-and-unbox type, ("Crow.callStatic" java-call-static-method args) to
		as call-static-varargs
			args.size is 3
			ctx.ctx cast-and-unbox type, ("Crow.callStaticVarargs" java-call-static-method args) to
		as cast
			ctx.ctx cast-and-unbox type, args.only to
		as cur-exclusion
			args.size is 0
			"Crow.getExclusion" java-call-static-method () to
		as change-exclusion
			args.size is 1
			"Crow.changeExclusion" java-call-static-method args to
		as equal
			args.size is 2
			eq-eq java-binary args[0], args[1] to
		as get-static-field
			args.size is 2
			"Crow.getStaticField" java-call-static-method args to
		as new-array
			(ctx as-type type-args.only.struct) java-new-array args.only to
	as js-fun _
		throw unreachable
	as builtin-fun-mark-root
		throw unreachable
	as builtin-fun-mark-visit
		throw unreachable
	as builtin-fun-new-empty-option
		throw unreachable
	as builtin-fun-new-non-empty-option
		throw unreachable
	as builtin-fun-pointer-cast
		throw unreachable
	as builtin-fun-size-of
		throw unreachable
	as builtin-fun-static-symbols
		throw unreachable
	as version-fun _
		throw unreachable	

-gc-safe-value java-expr(type concrete-struct)
	match type body
	as concrete-builtin-type x
		match x kind
		as array
			java-null
		as bool
			false java-literal-boolean
		as char8
			zero
		as char32
			zero
		as catch-point
			java-null
		as const-pointer
			java-null
		as float32
			zero
		as float64
			zero
		as fun-data
			throw unreachable
		as fun-mut
			throw unreachable
		as fun-pointer
			java-null
		as fun-shared
			throw unreachable
		as future
			java-null
		as int8
			zero
		as int16
			zero
		as int32
			zero
		as int64
			zero
		as java-exclusion
			java-null
		as js-any
			java-null
		as java-any
			java-null
		as mut-array
			java-null
		as mut-pointer
			java-null
		as mut-slice
			java-null
		as nat8
			zero
		as nat16
			zero
		as nat32
			zero
		as nat64
			zero
		as option
			throw unreachable
		as string
			"" java-literal-string
		as symbol
			"" java-literal-string
		as void
			java-null
	else
		java-null

-translate-builtin-unary java-expr-or-block-statement(a builtin-unary, arg java-expr)
	cast java-expr-or-block-statement data(name string) = name =>
		name.to java-cast arg to
	static java-expr-or-block-statement data(name string) = name =>
		name java-call-static-method (arg,) to
	unary java-expr-or-block-statement data(kind java-unary-kind) = kind =>
		kind java-unary arg to
	match a
	as array-pointer
		throw unreachable
	as array-size
		"long".to java-cast (arg java-property-access "length") to
	as as-any-pointer
		throw unreachable
	as as-future
		throw unreachable
	as as-future-impl
		throw unreachable
	as as-mut-array
		throw unreachable
	as as-mut-array-impl
		throw unreachable
	as bits-of-float32
		static["java.lang.Float.floatToRawIntBits"]
	as bits-of-float64
		static["java.lang.Double.doubleToRawLongBits"]
	as bitwise-not-nat8
		unary[bitwise-not]
	as bitwise-not-nat16
		unary[bitwise-not]
	as bitwise-not-nat32
		unary[bitwise-not]
	as bitwise-not-nat64
