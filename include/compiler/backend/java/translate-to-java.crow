import
	crow/col/mut-stack
	../../frontend/show-model
	../../model/low-model
	../../model/model
	../../model/show-low-model
	../../model/source-range
	../../model/uri
	../../util/full-index-map
	../../util/java-bytecode-types
	../../util/perf
	../../util/util
	../util
	./class-builder
	./class-code-builder
	./java-names
	./lib/Crow.class as Crow-class nat8[]
	./lib/CrowClassLoader.class as CrowClassLoader-class nat8[] # TODO: USED? -------------------------------------------------
	./java-refs
	./union-representation
	./util

translate-to-java-classes java-compiled-class[]
	program program
	low-program low-program
	class-prefix string
do show-type-ctx
	start = perf-now
	union-info = plan-unions low-program
	the java-names = build-mangled-names low-program, class-prefix, union-info
	the to-java-ctx =
		res: ()
		next-lambda-index: 0
		next-resource-index: 0
		model-program: program
		program: low-program
		structs-for-integrals: get-types-for-integrals low-program
	start-constants = perf-now
	translate-constants
	end-translate-constants start-constants
	start-types = perf-now
	for type in all-non-extern-types low-program
		translate-type type
	end-translate-types start-types
	start-funs = perf-now
	for uri, (funs, vars) in funs-and-vars-by-uri low-program
		translate-funs-for-uri uri, funs, vars
	end-translate-funs start-funs
	main-name symbol = "{class-prefix}Main"
	add-class main-name, main-class main-name
	if class-prefix == ""
		the::to-java-ctx.res ~~= lib-classes
	res java-compiled-class[] = the::to-java-ctx.res.move-to
	end-translate-to-java start
	res

# TODO: CrowClassLoader is only needed for Crow itself, shouldn't be included in other programs built by Crow
-lib-classes java-compiled-class[]()
	- "Crow.class", Crow-class
	- "CrowClassLoader.class", CrowClassLoader-class

-main-class ClassFile(name symbol) java-ctx
	the java-refs = start-new-class names
	this-class = class_ constants, name
	main method_info =
		code = with out in build-code
			# TODO: break this out into its own function --------------------------------------------------------------------------
			aload out, 0
			invokestatic out, crow-string-array-from-java-string-array
			funs = program.common-funs.low-common-funs-java!
			call-low-fun out, funs.start-runtime
			start-pc = out.next-index
			call-low-fun out, funs.main
			end-pc = out.next-index
			call-low-fun out, funs.stop-runtime
			return out, void

			# Catch exceptions (temporarily) and ensure the runtime still shuts down. This is basically a 'finally'.
			add-to-exception-table out, start-pc, end-pc, java-Throwable,
				locals: ()
				stack: java-Throwable.Object_variable_info,
			# Shut down the runtime with a 0 exit code so it doesn't call System.exit, then throw the exception so it fails anyway
			lconst out, 0
			call-low-fun out, funs.stop-runtime
			athrow out
		access-flags: public | static | synthetic
		name: constants["main"]
		descriptor: constants["([Ljava/lang/String;)V"]
		attributes: code,
	Object = java-Object
	constant-pool: finish constants
	access: final | public
	this-class: this-class
	super-class: Object
	interfaces: ()
	fields: ()
	methods: main,
	attributes: ()

-funs-and-vars-by-uri (low-fun[], low-var[])[uri](a low-program)
	res (low-fun mut[], low-var mut[]) mut[uri] = ()
	for x in all-non-extern-funs a
		funs, _ = ensure res, x.module-uri
		funs ~= x
	for x in all-vars a
		_, vars = ensure res, x.module-uri
		vars ~= x
	for key, (funs, vars) in res
		key, (funs.move-to, vars.move-to)
-new (low-fun mut[], low-var mut[])()
	(), ()

-java-ctx spec show-ctx, java-names, to-java-ctx
-to-java-ctx record mut
	res java-compiled-class mut[]
	next-lambda-index mut nat
	next-resource-index mut nat
	model-program program
	program low-program
	structs-for-integrals low-type[integral-type]
-program low-program() to-java-ctx
	the::to-java-ctx.program
-add-class void(name symbol, class_ ClassFile) to-java-ctx
	start = perf-now
	bytes nat8[] = class_.to
	end-class-to-bytes start
	the::to-java-ctx.res ~= "{name}.class", bytes
-union-representation union-representation(type low-type) java-ctx
	union-representation union-info, type
-add-resource symbol(value nat8[]) to-java-ctx
	name = "_resource{the::to-java-ctx.next-resource-index}.bin"
	the::to-java-ctx.next-resource-index +:= 1
	the::to-java-ctx.res ~= name, value
	name.to

-java-expr-ctx spec java-ctx, java-refs, expr-ctx
-expr-ctx record mut
	this-class class-reference
	cur-fun-for-debug low-fun?
	closure field-reference[low-local]
	stack low-type mut-stack
	has-this bool
	| Does not include the 'this' param
	locals local-entry mut-stack
	loop-pos mut jump-target?
-stack low-type mut-stack() expr-ctx
	the::expr-ctx.stack
-has-this bool() expr-ctx
	the::expr-ctx.has-this
-locals local-entry mut-stack() expr-ctx
	the::expr-ctx.locals
-loop-pos jump-target?() expr-ctx
	the::expr-ctx.loop-pos
-set-loop-pos void(value jump-target?) expr-ctx
	the::expr-ctx.loop-pos := value
| Use 'low-type' for a synthetic local
-local-entry union(low-local, low-type)
-to json(a local-entry)
-type low-type(a local-entry)
	match a
	as low-local
		a.type
	as low-type
		a
- == bool(a local-entry, b local-entry)
-new expr-ctx
	this-class class-reference
	cur-fun low-fun?
	closure field-reference[low-local]
	has-this bool
	params low-local[]
do
	locals local-entry mut-stack = ()
	for x in params
		forbid is-empty-type x.type
		locals ~= x
	this-class, cur-fun, closure, (), has-this, locals, ()
| Index of a local, or reference to a closure field
-local-or-closure union(nat, field-reference)
-explain-local local-or-closure(local low-local) expr-ctx
	the::expr-ctx.closure[local] else
		res mut nat = has-this.to
		assert exists locals, of x
			found = x == local
			unless found
				res +:= number-of-locals x.type
			found
		res
-next-local-index nat() expr-ctx
	res mut nat = has-this.to
	for x in locals
		res +:= number-of-locals x.type
	res
-cur-stack-frame stack-frame() java-expr-ctx
	locals: with out in build
		if has-this
			out ~= Object_variable_info the::expr-ctx.this-class
		for x in locals
			out ~= verification-type x.type
	stack: map stack, it.verification-type

-verification-type verification_type_info(a low-type) java-expr-ctx
	match rt = as-runtime-type a
	as void
		log error, "Unexpected verification-type {show-low-type a}" # ------------------------
		throw unreachable
	as java-primitive-type
		match rt
		as T_BOOLEAN then integer
		as T_CHAR then integer
		as T_FLOAT then float
		as T_DOUBLE then double
		as T_BYTE then integer
		as T_SHORT then integer
		as T_INT then integer
		as T_LONG then long
	as reference-type
		if f = as-wrapper a
			verification-type f.type
		else
			Object_variable_info class_ a

-translate-constants void() java-ctx
	add-class names.constant-symbols-class-name, constant-symbols-class
	for name, constants in names.constant-names.class-to-constants
		add-class name, constants-class name, constants

-constant-symbols-class ClassFile() java-ctx
	the java-refs = start-new-class names
	constant-symbols = program.all-constants.symbols
	fields field_info[] = for index in 0 .. constant-symbols.size
		access-flags: static | final
		name: constant-symbol-name index
		descriptor: descriptor-for-field-type program.symbol
		attributes: ()
	this-class class-reference = constant-symbols-class
	static-init method_info =
		code = with out in build-code
			for index, symbol in with-index constant-symbols
				ldc out, string-ref out.constants, symbol.to
				invokevirtual out, java-String-getBytes
				call-low-fun out, program.common-funs.low-common-funs-java!.to-symbol-from-string
				putstatic out, constant-symbol-field program.symbol, index
			return out, void
		access-flags: static | final | synthetic
		name: clinit
		descriptor: init-no-args-descriptor
		attributes: code,
	Object = java-Object
	constant-pool: finish constants
	access: final
	this-class: this-class
	super-class: Object
	interfaces: ()
	fields: fields
	methods: static-init,
	attributes: ()

-constants-class ClassFile(name symbol, constants-array any-constant[]) java-ctx
	the java-refs = start-new-class names
	fields field_info[] = for x in constants-array
		forbid is-empty-type x.type or is-wrapper x.type
		access-flags: static | final
		name: constant-name x
		descriptor: descriptor-for-field-type x.type
		attributes: ()
	this-class = class_ constants, name
	static-init method_info =
		code = with out in build-code
			constants-static-init out, this-class, constants-array
		access-flags: static | final | synthetic
		name: clinit
		descriptor: init-no-args-descriptor
		attributes: code,
	Object = java-Object
	constant-pool: finish constants
	access: final
	this-class: this-class
	super-class: Object
	interfaces: ()
	fields: fields
	methods: static-init,
	attributes: ()
-constants-static-init void(out code-builder, this-class class-reference, constants any-constant[]) java-ctx, java-refs
	the expr-ctx = this-class, (), (), (), ()
	for constant in constants
		forbid is-empty-type constant.type or is-wrapper constant.type
		init-constant out, constant
	return out, void

-init-constant void(out code-builder, constant any-constant) java-expr-ctx
	assert is-empty stack
	match constant
	as single-constant-array
		array = array-type constant
		element = element-type constant
		elements = elements constant
		if (is-nat8 element or is-char8 element) and elements.size > 16
			resource = add-resource map elements, it.scalar-value!.to
			ldc out, the::expr-ctx.this-class
			ldc out, string-ref out.constants, resource
			invokevirtual out, java-Class-getResourceAsStream
			invokevirtual out, java-InputStream-readAllBytes
			pushed array
		else
			make-array out, elements.size, array, element, of i
				push-constant out, elements[i], element
	as single-constant-record
		new-record out, constant.record-type, of i, field
			push-constant out, constant.args[i], field.type
	putstatic out, constant-field constant
	must-pop constant.type
	assert is-empty stack

-emit-unreachable void(out code-builder) java-refs
	makenew out, java-Error
	dup32 out
	invokespecial out, init-no-args java-Error
	athrow out

-new-record void
	out code-builder
	record-type low-type
	emit-arg void mut(i nat, field low-field)
do java-expr-ctx
	record_ = record-type.body.low-record!
	fields = record_.fields
	if is-empty-type record-type
		before = size stack
		for i, field in with-index fields
			emit-arg[i, field]
		stack.size is before
	elif field = as-wrapper record_
		emit-arg[0, field]
		must-refine field.type, record-type
	else
		makenew out, class_ record-type
		pushed record-type
		dup32 out
		pushed record-type
		for i, field in with-index fields
			emit-arg[i, field]
			must-peek field.type
		invokespecial out, record-init-reference record-type
		for field low-field in reverse fields # TODO: should not need type annotation
			must-pop field.type
		must-pop record-type
		must-peek record-type

-make-array void
	out code-builder
	size nat
	array-type low-type
	element-type low-type
	emit-element void mut(i nat)
do java-expr-ctx
	iconst out, size.to
	new-array-for-type out, element-type
	pushed array-type
	for i in 0::nat .. size
		dup32 out
		pushed array-type
		iconst out, i.to
		pushed program.nat32
		emit-element[i]
		astore out, element-type.as-runtime-type
		must-pop element-type
		must-pop program.nat32
		must-pop array-type
	must-peek array-type

-push-constant void(out code-builder, constant constant, type low-type) java-expr-ctx
	match body = body type
	as low-builtin-type
		push-constant-builtin out, constant, type, body
		pushed type
	as low-enum
		push-constant-nat out, body.storage, constant
		pushed type
	as struct-body-extern-java
		match constant
		as constant-gc-safe-value
			aconst_null out
		as constant-native-string
			body.path is "java/lang/String".parse-path
			ldc out, string-ref out.constants, constant.value.to
		else
			throw unreachable
		pushed type
	as low-flags
		push-constant-nat out, body.storage, constant
		pushed type
	as low-record
		do unless is-empty-type type
		if field = as-wrapper type
			wrapped = type field
			match constant
			as constant-record
				inner = only! program.all-constants.records[type]![constant]
				push-constant out, inner, wrapped
				must-refine field.type, type
			as constant-gc-safe-value
				push-constant out, constant-gc-safe-value, wrapped
				must-refine field.type, type
			else
				throw unreachable
		else
			match constant
			as constant-record
				getstatic out, constant-record-field type, constant
			as constant-gc-safe-value
				aconst_null out
			as constant-symbol
				getstatic out, constant-symbol-field program.symbol, constant.index
			else
				throw unreachable
			pushed type
	as low-union
		match constant
		as constant-union
			value = program.all-constants.unions[type]![constant]
			new-union out, type, value.member-index, of case-type
				push-constant out, value.member, case-type
		as constant-gc-safe-value
			aconst_null out
			pushed type
		else
			throw unreachable
	as low-type-body-deferred
		throw unreachable

-new-union void
	out code-builder
	type low-type
	member-index nat
	emit-member void mut(case-type low-type)
do java-expr-ctx
	case-type = type.body.low-union!.members[member-index]
	emit-member-object = of
		emit-member[case-type]
		box out, case-type, type
	match union-representation type
	as exception
		emit-member-object[]
	as sealed-interface
		emit-member-object[]
	as switch
		emit-member-object[]
		local = next-local-index
		astore out, local
		union-class = class_ type
		makenew out, union-class
		dup32 out
		push-constant-nat out, nat32, member-index.to
		aload out, local
		invokespecial out, init-union-switch union-class
	as nullable
		match member-index
		as 0
			emit-member[case-type] # for the side effect
			aconst_null out
			pushed type
		as 1
			emit-member-object[]
		else
			throw unreachable

-push-constant-builtin void
	out code-builder
	constant constant
	type low-type
	builtin_ low-builtin-type
do java-expr-ctx
	array = of
		if is-empty-type type.as-array-or-buffer!
			push-constant-nat out, nat32, match constant
			as constant-array
				elements = program.all-constants.arrays[constant.type-index].constants[constant.index] # TODO: helper function for this!
				elements.size.to
			as constant-gc-safe-value
				0::nat.to
			else
				throw unreachable
		else
			match constant
			as constant-array
				getstatic out, constant-array-field type, constant
			as constant-gc-safe-value
				aconst_null out
			else
				throw unreachable
	match builtin_.kind
	as array
		array[]
	as bool
		push-constant-nat out, nat8, constant
	as char8
		push-constant-nat out, nat8, constant
	as char32
		push-constant-integral out, int32, constant
	as float32
		fconst out, constant.scalar-value!.to::float64.to
	as float64
		dconst out, constant.scalar-value!.to::float64
	as future
		throw unreachable
	as int8
		push-constant-integral out, int8, constant
	as int16
		push-constant-integral out, int16, constant
	as int32
		push-constant-integral out, int32, constant
	as int64
		push-constant-integral out, int64, constant
	as js-any
		throw unreachable
	as fun-data
		throw unreachable
	as fun-mut
		throw unreachable
	as fun-shared
		throw unreachable
	as buffer
		array[] # TODO: I think this is only for constant-gc-safe-value, so I should just handle that?
	as nat8
		push-constant-nat out, nat8, constant
	as nat16
		push-constant-nat out, nat16, constant
	as nat32
		push-constant-nat out, nat32, constant
	as nat64
		push-constant-nat out, nat64, constant
	as option
		throw unreachable
	as void
		()
	as weak-ref
		assert constant constant-gc-safe-value
		aconst_null out

-push-constant-nat void(out code-builder, type nat-type, constant constant)
	push-constant-integral out, type.to, constant
-push-constant-integral void(out code-builder, type integral-type, constant constant)
	value int = match constant
	as scalar-value
		to constant
	as constant-gc-safe-value
		0
	else
		throw unreachable
	if is-64-bit type
		lconst out, value
	else
		# Use 'wrap-to' instead of 'to' since we may actually be dealing with an unsigned type
		iconst out, value.wrap-to

-translate-type void(type low-type) java-ctx
	forbid as-extern type
	the java-refs = start-new-class names
	is-exception-case = union-info.exception-case-types[type]
	super-class = if is-exception-case then java-Throwable else java-Object
	interface-structs = union-info.type-to-interfaces[type] else ()
	interfaces class-reference[] = map interface-structs, it.class_
	this-class-name = class-name type
	this-class = class_ type

	method-impls method_info[] = with out in build
		for interface_ in interface-structs
			info = program.method-impls[interface_] else ()
			unless is-empty info
				# TODO:PERF have the index handy so we don't have to search for it again
				index = index-of! interface_.body.low-union!.members, type
				for method, impl in zip info.methods, info.cases[index]
					kind = java-method-kind union-info, method
					if is-instance kind
						out ~= method-impl method, impl
		if is-exception-case
			impls = program.method-impls[program.exception]!
			# TODO:PERF have the index handy so we don't have to search for it again
			case-index = index-of! program.exception.body.low-union!.members, type
			# 'show' is not a Java method (since we don't control the Throwable type), but while we're here, define 'toString' in terms of it
			if impl = only! impls.cases[case-index]
				out ~= toString-method-impl impl

	class_ ClassFile? = match body = body type
	as low-builtin-type
		lambda = of
			assert is-empty method-impls else todo
			lambda-class type, this-class, super-class, interfaces
		match kind body
		as array
			()
		as fun-data
			lambda[]
		as fun-mut
			lambda[]
		as fun-shared
			lambda[]
		as void
			# Can't use java.lang.Void since that has no instances
			record-class type, false, (), this-class-name, this-class, super-class, interfaces, method-impls
		else
			() # TODO: could use a boxing-record for unsigned integer types ........................................................
	as low-enum
		# TODO: we only need the boxing class if an enum is used in a union (including Option) -----------------------------
		boxing-record type, super-class, interfaces, method-impls
	as struct-body-extern-java
		throw unreachable
	as low-flags
		# TODO: we only need the boxing class if an enum is used in a union (including Option) -----------------------------
		boxing-record type, super-class, interfaces, method-impls
	as low-record
		record-class type, body.is-wrapper, body.fields, this-class-name, this-class, super-class, interfaces, method-impls
	as low-union
		method-decls method_info[] = with out in build
			for m in program.method-impls[type].?methods else ()
				match java-method-kind union-info, m
				as interface_
					out ~= interface-method-decl m
				as virtual
					throw todo
				as static-method-of-class
					()
				as static-method-of-interface
					()
				# TODO: a union method can't be implemented as the below three, so use a more specific type for 'java-method-kind'!
				as constructor
					throw unreachable
				as static-field
					throw unreachable
				as instance-field
					throw unreachable
		all-methods = method-decls ~~ method-impls
		match union-representation type
		as exception
			()
		as sealed-interface
			union-sealed-interface this-class, super-class, interfaces, all-methods
		as switch
			assert is-empty all-methods else todo
			union-switchable this-class, super-class, interfaces
		as nullable
			()
	as low-type-body-deferred
		throw unreachable
	if class_
		add-class this-class-name, class_

-interface-method-decl method_info(method low-fun) java-names-and-refs
	access-flags: public | abstract_
	name: instance-method-name method
	descriptor: instance-method-descriptor method
	attributes: ()

| Creates the instance method that implements an interface method by calling a static function
-method-impl method_info(method low-fun, impl low-fun?) java-names-and-refs
	code = with out in build-code
		assert impl else todo # TODO: generate code that will throw an error --------------------------------------------------
		java-param-index mut = 0
		for index, param in with-index method.params
			if index == 0
				aload out, 0
				unbox-if-necessary out, impl.params[0].type
			else
				xload out, param.type.as-runtime-type, java-param-index
			java-param-index +:= number-of-locals param.type
		call-low-fun out, impl
		return out, method.return-type.as-runtime-type
	access-flags: public | final
	name: instance-method-name method
	descriptor: instance-method-descriptor method
	attributes: code,

-toString-method-impl method_info(show low-fun) java-names-and-refs
	code = with out in build-code
		makenew out, java-String
		dup32 out
		case-type = show.params.only!.type
		unless is-empty-type case-type
			aload out, 0
			unbox-if-necessary out, case-type
		call-low-fun out, show
		invokespecial out, java-String-init-from-bytes
		return out, reference-type
	access-flags: public | final
	name: toString
	descriptor: constants["()Ljava/lang/String;"]
	attributes: code,

-lambda-class ClassFile
	type low-type
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
do java-refs
	is-runnable = lambda-type-is-runnable type
	all-interfaces = if is-runnable then java-Runnable ~ interfaces else interfaces
	init = record-initializer super-class, (), init-no-args-descriptor
	call method_info =
		access-flags: abstract_ | if is-runnable then public
		name: run
		descriptor: lambda-call-descriptor type
		attributes: ()
	constant-pool: finish constants
	access: abstract_
	this-class: this-class
	super-class: super-class
	interfaces: all-interfaces
	fields: ()
	methods: init, call
	attributes: ()

-lambda-type-is-runnable bool(type low-type)
	assert r, p = as-lambda-type type
	is-void r and is-void p

-union-sealed-interface ClassFile
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
	methods method_info[]
do java-refs
	constant-pool: finish constants
	access: interface_ | abstract_
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: ()
	methods: methods
	attributes: ()

-union-switchable ClassFile
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
do java-refs
	kind field_info = final, switchable-kind-name, switchable-kind-descriptor
	kind-field = switchable-kind-field this-class
	value field_info = final, value-name, java-Object-descriptor
	value-field = switchable-value-field this-class
	constructor method_info =
		code Code_attribute = with out in build-code constants
			aload out, 0
			invokespecial out, init-no-args super-class
			aload out, 0
			xload out, T_INT, 1
			putfield out, kind-field
			aload out, 0
			aload out, 2
			putfield out, value-field
			return out, void
		access-flags: ()
		name: init
		descriptor: init-union-switch-descriptor
		attributes: code,
	constant-pool: finish constants
	access: final
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: kind, value
	methods: constructor,
	attributes: ()

-record-class ClassFile
	type low-type
	is-wrapper bool
	low-fields low-field[]
	this-class-name symbol
	this-class class-reference
	super-class class-reference
	interfaces class-reference[]
	method-impls method_info[]
do java-names-and-refs
	fields field_info[] = if is-empty-type type
		- instance-field this-class-name
	else
		for* field in low-fields
			do unless is-empty-type field.type
			-
				access-flags: unless is-mutable field then final
				name: record-field-name field
				descriptor: record-field-descriptor field
	methods method_info[] = with methods-out in build
		field-refs (field-reference, java-runtime-type)[] = for* x in low-fields
			# TODO: we should just not lower empty fields --------------------------------------------------------------
			do unless is-empty-type x.type
			- (record-field type, x), x.type.as-runtime-type
		methods-out ~= record-initializer super-class, field-refs,
			record-init-descriptor low-fields
		if is-empty-type type
			methods-out ~= clinit-for-instance-field this-class-name, this-class
		elif is-wrapper
			methods-out ~= make-valueOf type
			if p = as-java-primitive-type low-fields.only!.type
				field = only! low-fields
				field-ref = record-field type, field
				methods-out ~= make-getValue field-ref, p
		methods-out ~~= method-impls
	constant-pool: finish constants
	access: final
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: fields
	methods: methods
	attributes: ()

-instance-field field_info(this-class-name symbol) java-refs
	final | static, instance-field-name, instance-field-descriptor this-class-name
-clinit-for-instance-field method_info(this-class-name symbol, this-class class-reference) java-refs
	class-init-code Code_attribute = with out in build-code
		makenew out, this-class
		dup32 out
		invokespecial out, init-no-args this-class
		putstatic out, instance-field this-class, this-class-name
		return out, void
	access-flags: static
	name: clinit
	descriptor: init-no-args-descriptor
	attributes: class-init-code,

-record-initializer method_info
	super-class class-reference
	fields (field-reference, java-runtime-type)[]
	descriptor utf8-reference
do java-refs
	code = with out in build-code
		aload out, 0
		invokespecial out, init-no-args super-class
		local-index mut = 1 # 0 is the object
		for field, field-type in fields
			aload out, 0
			xload out, field-type, local-index
			local-index +:= number-of-locals field-type
			putfield out, field
		return out, void
	access-flags: ()
	name: init
	descriptor: descriptor
	attributes: code,

-boxing-record ClassFile
	type low-type
	super-class class-reference
	interfaces class-reference[]
	methods method_info[]
do java-refs
	this-class = class_ type
	primitive = as-java-primitive-type! type
	field field_info = final, value-name, primitive-descriptor primitive
	field-ref = boxed-class-value type
	constructor-descriptor = boxed-class-init-descriptor type
	constructor method_info =
		code = with out in build-code constants
			aload out, 0
			invokespecial out, init-no-args super-class
			aload out, 0
			xload out, type.as-runtime-type, 1
			putfield out, field-ref
			return out, void
		access-flags: ()
		name: init
		descriptor: constructor-descriptor
		attributes: code,
	valueOf = make-valueOf type
	getValue = make-getValue field-ref, primitive
	constant-pool: finish constants
	access: final
	this-class: this-class
	super-class: super-class
	interfaces: interfaces
	fields: field,
	methods: (constructor, valueOf, getValue)::method_info[] ~~ methods
	attributes: ()

-make-valueOf method_info(type low-type) java-refs
	this-class = class_ type
	# TODO: this should have a cache. For enums, statically generate all members. For flags or integrals, just cache the 10 most recent?
	code = with out in build-code
		makenew out, this-class
		dup32 out
		xload out, type.as-runtime-type, 0
		invokespecial out, boxed-class-init type
		return out, reference-type
	access-flags: static
	name: valueOf
	descriptor: boxed-class-valueOf-descriptor type
	attributes: code,

-make-getValue method_info(field-ref field-reference, primitive java-primitive-type) java-refs
	code = with out in build-code
		aload out, 0
		getfield out, field-ref
		return out, primitive
	access-flags: final
	name: primitive-getter-name primitive
	descriptor: primitive-getter-descriptor primitive
	attributes: code,

-new-array-for-type void(out code-builder, element-type low-type) java-expr-ctx
	match rt = as-runtime-type element-type
	as void
		# Void array represented as the size which is already on stack
		()
	as java-primitive-type
		newarray out, rt
	as reference-type
		if field = as-wrapper element-type
			new-array-for-type out, field.type
		else
			anewarray out, class_ element-type

-number-of-locals nat(type low-type)
	number-of-locals as-runtime-type type
-number-of-locals nat(type java-runtime-type)
	match type
	as void
		0
	as java-primitive-type
		match type
		as T_DOUBLE then 2
		as T_LONG then 2
		else then 1
	else
		1

-box void(out code-builder, in-type low-type, out-type low-type) java-expr-ctx
	box-no-refine out, in-type, out-type
	must-refine in-type, out-type

-box-no-refine void(out code-builder, in-type low-type, out-type low-type) java-refs
	assert out-type.as-runtime-type == reference-type
	if is-empty-type in-type
		getstatic out, instance-field in-type
	elif as-java-primitive-type in-type or is-wrapper in-type
		invokestatic out, boxed-class-valueOf in-type

-cast-and-unbox-if-necessary void(out code-builder, type low-type) java-expr-ctx
	if is-empty-type type
		pop out, reference-type
	else
		checkcast out, class_ type
		unbox-if-necessary out, type

-unbox-if-necessary void(out code-builder, type low-type) java-refs
	if p = as-java-primitive-type type
		invokevirtual out, primitive-unboxer type, p
	elif field = as-wrapper type
		getfield out, record-field type, field # TODO: doesn't this need to apply recursively? ----------------------

-translate-funs-for-uri void(uri uri, funs low-fun[], vars low-var[]) java-ctx
	the java-refs = start-new-class names
	this-class-name = module-class-name uri
	this-class = module-class uri
	fields field_info[] = for var in vars
		match kind var
		as thread-local_
			throw todo
		as global_
			access-flags: static
			name: var-name var
			descriptor: descriptor-for-field-type var.type
			attributes: ()
	methods method_info[] = with methods-out in build
		for fun in funs
			do if (java-method-kind union-info, fun) == static-method-of-class
			methods-out ~= method-for-fun this-class, fun
		methods-out ~= init-vars this-class, vars
	Object = java-Object
	source SourceFile_attribute =
		attribute-name-index: SourceFile
		source-file: constants[show-uri uri 'to]
	add-class this-class-name,
		constant-pool: finish constants
		access: ()
		this-class: this-class
		super-class: Object
		interfaces: ()
		fields: fields
		methods: methods
		attributes: source,
-method-for-fun method_info(this-class class-reference, fun low-fun) java-ctx, java-refs
	the expr-ctx =
		this-class: this-class
		cur-fun: fun
		closure: ()
		has-this: false
		params: filter fun.params, !it.type.is-empty-type
	code = with out in build-code
		emit-fun-body out, fun
	verify-expr-ctx-finished fun.return-type, fun.params
	access-flags: static
	name: fun-name fun
	descriptor: static-method-descriptor fun
	attributes: code,

-init-vars method_info(this-class class-reference, vars low-var[]) java-ctx, java-refs
	the expr-ctx =
		this-class: this-class
		cur-fun: ()
		closure: ()
		has-this: false
		params: ()
	code = with out in build-code
		for var in vars
			match var.kind
			as thread-local_
				throw todo
			as global_
				emit-and-continue out, var.initializer
				putstatic out, var-field var
				must-pop var.type
			assert is-empty stack
		return out, void
	access-flags: static | final
	name: clinit
	descriptor: init-no-args-descriptor
	attributes: code,

-verify-expr-ctx-finished void(return-type low-type, params low-local[]) java-expr-ctx
	must-pop return-type
	# RM --------------------------------------------------------------------------------------------------------------------------
	unless is-empty stack
		log error, "You left something on the stack: "
		for x in stack
			log error, "{show-low-type x}"
	assert is-empty stack
	locals.size is count params, !it.type.is-empty-type

-emit-fun-body void(out code-builder, fun low-fun) java-expr-ctx
	match body = body fun
	as low-fun-body-builtin # TODO: this should go away, always use the low-expr form
		args low-expr[] = for param in params fun
			param.type, fun.range, param.local-get-low-expr
		translate-builtin out, body.kind, body.type-args, fun.return-type, args
		return out, fun.return-type.as-runtime-type
	as low-expr
		# log "GONNA EMIT FUNCTION {show-low-fun-sig ctx.ctx.show-ctx.show, fun, false}" -----------------------------------
		emit-expr out, return, body
	as fun-body-extern-java
		throw unreachable
	as low-fun-body-method
		union_ = type fun.params[0]
		info = program.method-impls[union_]!
		cases = cases info
		method-index = index-of! info.methods, fun
		return-type = return-type fun
		load-rest-params = of
			:: void
			local-index mut = 1
			for param in fun.params[1 .. end]
				xload out, param.type.as-runtime-type, local-index
				local-index +:= number-of-locals param.type
		match union-representation union_
		as exception
			jump mut deferred-jump? = ()
			for case-index, case-impls in with-index cases
				case-type = union_.body.low-union!.members[case-index]
				do if case-impl = case-impls[method-index]
				?jumps-to-here jump, out, cur-stack-frame
				aload out, 0
				instanceof out, class_ case-type
				jump := ifeq out
				aload out, 0
				cast-and-unbox-if-necessary out, case-type
				load-rest-params[]
				call-low-fun out, case-impl
				return out, return-type.as-runtime-type
			jumps-to-here jump!, out, cur-stack-frame
			# To 'show' Java exceptions, call 'toString' and convert
			aload out, 0
			invokevirtual out, java-Object-toString
			invokevirtual out, java-String-getBytes
			return out, return-type.as-runtime-type
			pushed return-type
		as sealed-interface
			throw unreachable
		as switch
			aload out, 0
			get-switchable-kind out, union_
			jump-to-case, jump-to-default = tableswitch out, 0 .. cases.size.to
			for case-index, case-impls in with-index cases
				case-type = union_.body.low-union!.members[case-index]
				jumps-to-here jump-to-case[case-index], out, cur-stack-frame
				aload out, 0
				get-switchable-value out, union_
				cast-and-unbox-if-necessary out, case-type
				load-rest-params[]
				case-impl = case-impls[method-index] else throw todo
				call-low-fun out, case-impl
				return out, return-type.as-runtime-type
			jumps-to-here jump-to-default, out, cur-stack-frame
			emit-unreachable out
			pushed return-type
		as nullable
			_, non-null-type = only2! union_.body.low-union!.members
			null-case, non-null-case = only2! cases
			null-impl = null-case[method-index] else throw todo
			non-null-impl = non-null-case[method-index] else throw todo
			aload out, 0
			jump = ifnonnull out
			load-rest-params[]
			call-low-fun out, null-impl
			return out, return-type.as-runtime-type
			jumps-to-here jump, out, cur-stack-frame
			aload out, 0
			unbox-if-necessary out, non-null-type
			load-rest-params[]
			call-low-fun out, non-null-impl
			return out, return-type.as-runtime-type
			pushed return-type
	as low-fun-body-deferred
		throw unreachable
	as low-fun-body-always-inline
		throw unreachable

-expr-pos union(continue_, jump, return) mut
| When the code is done, it should jump to the end (which will be determined after compiling the whole expression)
-continue_ record
-jump record mut
	jumps deferred-jump mut[]
| When the code is done, it should return from the function
| WARN: The returned type may be different from this expression's type.
| Maybe this expression is void but the value that was pushed on the stack before should be returned.
-return record

-emit-and-continue void(out code-builder, expr low-expr) java-expr-ctx
	emit-expr out, continue_, expr

# TODO: the last use of inner-pos could be different, since if can just continue with no jump instruction
-inner-pos record(out code-builder, pos expr-pos) mut
-with-block void(a inner-pos, f void mut(inner-pos expr-pos)) java-expr-ctx
	match pos = pos a
	as continue_
		jump jump = (),
		f[jump]
		for j in jumps jump
			jumps-to-here j, a.out, cur-stack-frame
	as jump
		f[pos]
	as return
		f[pos]

-handle-pos void(out code-builder, pos expr-pos, type low-type)
	match pos
	as continue_
		()
	as jump
		pos.jumps ~= goto out
	as return
		return out, type.as-runtime-type

-call-low-fun void(out code-builder, fun low-fun) java-names-and-refs
	match java-method-kind union-info, fun
	as interface_
		count = sum fun.params, of param
			stack-entry-count as-runtime-type param.type
		invokeinterface out, fun.interface-method-ref, count.to
	as virtual
		invokevirtual out, virtual-method-ref fun
	as static-method-of-class
		invokestatic out, static-method-of-class-ref fun
	as static-method-of-interface
		invokestatic out, static-method-of-interface-ref fun
	as constructor
		# Calling a constructor is a bit tricky since we need to put the new object first.
		class_ = class_ fun.return-type
		n-param-slots = sum fun.params, it.type.as-runtime-type.number-of-locals
		match n-param-slots
		as 0
			makenew out, class_
			dup32 out
		# TODO: this should produce smaller bytecode ------------------------------------------------------------------------------------
		#as 1
		#	out makenew class_
		#	out dup_x1
		#	out swap
		else
			l mut = 99 - n-param-slots # TODO: pass next param index into call-low-fun -----------------------------------
			for param low-local in reverse fun.params # TODO: should not need type annotation
				type = as-runtime-type param.type
				xstore out, type, l
				l +:= number-of-locals type
			makenew out, class_
			dup32 out
			for param in fun.params
				type = as-runtime-type param.type
				l -:= number-of-locals type
				xload out, type, l
		invokespecial out, constructor-method-ref fun
	as static-field
		# TODO: use 'refs' for this
		class-name symbol =  fun.body.fun-body-extern-java!.class_.to
		getstatic out, field constants, (class_ constants, class-name),
			name-and-type constants, fun.fun-name, descriptor-for-field-type fun.return-type
	as instance-field
		throw todo

-emit-expr void(out code-builder, pos expr-pos, a low-expr) java-expr-ctx
	mark-line-number out, (get-start-line line-and-character-getters, a.start).to::nat16 + 1
	type = a.type
	match x = a.kind
	as array-op-low-expr
		emit-for-loop out, pos, a, x
	as builtin-low-expr
		translate-builtin out, x.fun, x.type-args, type, x.args
		handle-pos out, pos, type
	as call-low-expr
		match body = x.called.body
		as low-fun-body-builtin
			translate-builtin out, body.kind, body.type-args, type, x.args
		else
			function-like out, type, x.args, of
				call-low-fun out, x.called
		handle-pos out, pos, type
	as cast-low-expr
		# This is currently only used to cast an enum to an integral. In Java we just use integrals for enums directly. --------
		emit-expr out, pos, x.inner
		must-refine x.inner.type, type
	as constant
		push-constant out, x, type
		handle-pos out, pos, type
	as create-array-low-expr
		make-array out, x.args.size, type, type.as-array!, of i
			emit-and-continue out, x.args[i]
		handle-pos out, pos, type
	as create-record-low-expr
		new-record out, type, of i, _
			emit-and-continue out, x.args[i]
		handle-pos out, pos, type
	as create-union-low-expr
		new-union out, type, x.member-index, of _
			emit-and-continue out, x.arg
		handle-pos out, pos, type
	as drop-low-expr
		emit-and-continue out, x.arg
		pop out, x.arg.type.as-runtime-type
		must-pop x.arg.type
		handle-pos out, pos, type
	as finally-low-expr
		with inner-pos in inner-pos out, pos
			start-pc = out.next-index
			emit-and-continue out, x.below # Leave the result on the stack
			end-pc = out.next-index
			unless always-throws x.below # No point compiling the happy path if it always throws
				emit-and-continue out, x.right
				unless always-throws x.right
					handle-pos out, inner-pos, type
			if start-pc == end-pc
				# Edge case: empty code below the 'finally'. Since empty code can't throw, don't handle exceptions
				()
			else
				must-pop type
				exception = program.exception
				pushed exception
				add-to-exception-table out, start-pc, end-pc, exception.class_, cur-stack-frame
				emit-and-continue out, x.right
				# 'x.right' is void, so the exception should be at the top of the stack.
				must-pop exception
				unless always-throws x.right
					athrow out
				# Treat the stack effect as if it was successful
				pushed type
	as if-low-expr
		emit-and-continue out, x.cond
		with inner-pos in inner-pos out, pos
			jump-if-false = ifeq out
			must-pop program.bool
			emit-expr out, inner-pos, x.then_
			must-pop type # The value is not actually popped, be we are now doing the other branch where it wasn't pushed in the first place
			jumps-to-here jump-if-false, out, cur-stack-frame
			emit-expr out, inner-pos, x.else_
			must-peek type
	as let-low-expr
		emit-and-continue out, x.value
		emit-with-local out, x.local, pos, x.then_
	as lambda-low-expr
		class-name = create-lambda-implementation-class a.range.uri, the::expr-ctx.cur-fun-for-debug!, type, x
		class_ = class_ out.constants, class-name
		# All we do here is call 'new' or 'instance'
		if is-empty x.closure
			getstatic out, instance-field class_, class-name
		else
			makenew out, class_
			dup32 out
			for local in x.closure
				get-local out, local
			invokespecial out, lambda-init-reference class_, x
		pushed type
		handle-pos out, pos, type
	as local-get-low-expr
		get-local out, x.local
		pushed type
		handle-pos out, pos, type
	as local-set-low-expr
		emit-and-continue out, x.value
		local-type = x.local.type
		unless is-empty-type local-type
			match l = explain-local x.local
			as nat
				xstore out, local-type.as-runtime-type, l
			as field-reference
				putfield out, l
		must-pop local-type
		handle-pos out, pos, type
	as loop-low-expr
		###
		loop
			if x
				break
			else
				continue
		==>
		loop:
		x
		ifeq goto else_
		goto end
		else_:
		goto loop
		end:
		###
		prev-loop-pos = loop-pos
		loop-pos := can-jump-back-to-here out, cur-stack-frame
		emit-expr out, pos, x.body
		loop-pos := prev-loop-pos
	as loop-break-low-expr
		emit-expr out, pos, x.value
	as loop-continue-low-expr
		go-back-to out, the::expr-ctx.loop-pos!
		pushed type # Treat the stack effect as if the loop completed
	as match-scalar-low-expr
		# TODO:PERF If <= 3 cases, it's probably better to just use ifeq instructions
		emit-and-continue out, x.matched
		with inner-pos in inner-pos out, pos
			matched-type = x.matched-integral-type
			is-signed = is-signed matched-type
			ok = every x.case-values, of value
				if is-signed
					fits-in-int32 value.to::int64
				else
					fits-in-nat32 value.to::nat64
			assert ok else todo # If some values don't fit in 32 bits, we can't use a switch. Just use jumps instead.
			# IF it's a 64-bit type: First check that it's in the range. If not, jump to default.
			jump-to-pop-then-default deferred-jump? = match integral-type matched-type else nat8
			as nat64
				dup64 out
				invokestatic out, crow-fits-in-nat32
				# If false, go to an instruction just before 'default' that pops
				res = ifeq out
				l2i out
				res
			as int64
				dup64 out
				invokestatic out, crow-fits-in-int32
				res = ifeq out
				l2i out
				res
			else
				()
			assert is-sorted x.case-values
			int-values int32[] = for v in x.case-values then v.to::int64.to
			# TODO: doesn't the low-model already sort the case-values? Then this can be omitted?
			permutation = get-sort-permutation int-values
			jump-to-case, jump-to-default = if is-range x.case-values
				tableswitch out, 0 .. x.case-values.size.to
			else
				lookupswitch out, apply-permutation int-values, permutation
			must-pop x.matched.type
			for target, expr in zip jump-to-case, apply-permutation x.case-exprs, permutation
				jumps-to-here target, out, cur-stack-frame
				emit-expr out, inner-pos, expr
				must-pop type
			if jump-to-pop-then-default
				# In this case it will still have the long value on the stack
				pushed x.matched.type
				jumps-to-here jump-to-pop-then-default, out, cur-stack-frame
				pop out, T_LONG
				must-pop x.matched.type
			jumps-to-here jump-to-default, out, cur-stack-frame
			if e = x.else_
				emit-expr out, inner-pos, e
			else
				emit-unreachable out
				pushed type
	as match-string-like-low-expr
		# TODO: factor out a function -------------------------------------------------------------------------------------------
		emit-and-continue out, x.matched
		matched-type = x.matched.type
		with inner-pos in inner-pos out, pos
			jump mut deferred-jump? = ()
			for index, case_ in with-index x.cases
				?jumps-to-here jump, out, cur-stack-frame
				# Final case will consume it
				is-last-case = index == x.cases.size - 1
				unless is-last-case
					dup32 out
					pushed matched-type
				emit-and-continue out, case_.value
				# TODO:PERF in the case of a 'string' or 'symbol' input, we could 'intern' and then just use refernce equality
				call-low-fun out, x.equals
				must-pop matched-type
				must-pop matched-type
				# Jump to next if the equality test returned 0 (false)
				jump := ifeq out
				unless is-last-case
					# If the equality test returned 'true', discard the original string
					pop out, reference-type
					must-pop matched-type
				emit-expr out, inner-pos, case_.then_
				# Reset the stack to handle after the jump
				must-pop type
				unless is-last-case
					pushed matched-type
			jumps-to-here jump!, out, cur-stack-frame
			emit-expr out, inner-pos, x.else_
	as match-union-low-expr
		emit-match-union out, pos, type, x
	as record-field-get-low-expr
		emit-and-continue out, x.record_
		unless is-wrapper x.record_.type
			getfield out, record-field x.record_.type, x.field
		must-pop x.record_.type
		pushed x.field.type
		handle-pos out, pos, type
	as record-field-set-low-expr
		emit-and-continue out, x.record_
		emit-and-continue out, x.value
		putfield out, record-field x.record_.type, x.field
		must-pop x.value.type
		must-pop x.record_.type
		handle-pos out, pos, type
	as seq-low-expr
		locals-size = locals.size # TODO: remove some excessive checking ---------------------------------------------------------
		stack-size = stack.size
		for part in x.parts[0 .. end - 1]
			emit-and-continue out, part
		locals.size is locals-size
		stack.size is stack-size
		locals.size is locals-size
		emit-expr out, pos, x.parts[end - 1]
		locals.size is locals-size
		unless is-empty-type type
			stack.size is stack-size + 1
	as throw-low-expr
		emit-and-continue out, x.thrown
		must-pop program.exception
		athrow out
		# Treat the stack effect as if it was successful
		pushed type
	as try-low-expr
		with inner-pos in inner-pos out, pos
			start = out.next-index
			emit-expr out, inner-pos, x.tried
			end = out.next-index
			for exception-case-index, case_ in zip x.exception-member-indices.to-array, x.catch-cases
				must-pop type
				catch-type = exception-case-type-from-index exception-case-index
				frame-before = cur-stack-frame
				boxed-catch-type = class_ catch-type
				add-to-exception-table out, start, end, boxed-catch-type,
					locals: frame-before.locals
					stack: frame-before.stack ~ boxed-catch-type.Object_variable_info
				pushed program.exception # just use an arbitrary type here, we're about to pop it
				emit-with-unboxed-opt-local out, program.exception, case_.local, inner-pos, case_.expr
			if else_ = x.catch-else
				must-pop type
				# TODO: this is basicaly the same as for other cases, share code
				frame-before = cur-stack-frame
				exception = java-Throwable
				add-to-exception-table out, start, end, exception,
					locals: frame-before.locals
					stack: frame-before.stack ~ exception.Object_variable_info
				pushed program.exception
				emit-with-unboxed-opt-local out, program.exception, else_.local, inner-pos, else_.expr
	as try-let-low-expr
		start = out.next-index
		emit-and-continue out, x.value
		end = out.next-index
		with inner-pos in inner-pos out, pos
			emit-with-opt-local out, x.local, x.value.type, inner-pos, x.then_
			# TODO: this is very similar to the code for try-low-expr, share code!
			must-pop type
			catch-type = exception-case-type-from-index x.exception-member-index
			frame-before = cur-stack-frame
			boxed-catch-type = class_ catch-type
			add-to-exception-table out, start, end, boxed-catch-type,
				locals: frame-before.locals
				stack: frame-before.stack ~ boxed-catch-type.Object_variable_info
			pushed program.exception # just use an arbitrary type here, we're about to pop it
			emit-with-unboxed-opt-local out, program.exception, x.catch_.local, inner-pos, x.catch_.expr
	as union-assume-case-low-expr
		emit-and-continue out, x.arg
		match union-representation x.union-type
		as exception
			cast-and-unbox-if-necessary out, type
		as sealed-interface
			cast-and-unbox-if-necessary out, type
		as switch
			get-switchable-value out, x.union-type
			cast-and-unbox-if-necessary out, type
		as nullable
			null-type, not-null-type = only2! x.union_.members
			if type == null-type
				pop out, reference-type
			else
				assert type == not-null-type
				unbox-if-necessary out, type
		must-refine x.union-type, type
		handle-pos out, pos, type
	as union-is-case-low-expr
		emit-and-continue out, x.arg
		match union-representation x.union-type
		as exception
			instanceof out, class_ x.case-type
		as sealed-interface
			instanceof out, class_ x.case-type
		as switch
			get-switchable-kind out, x.union-type
			push-constant-integral out, int32, x.case-index.to
			invokestatic out, crow-equal-integral int32
		as nullable
			invokestatic out, match x.case-index
			as 0
				crow-is-null
			as 1
				crow-is-not-null
			else
				throw unreachable
		must-pop x.arg.type
		pushed type
		handle-pos out, pos, type
	as var-get-low-expr
		match x.var.kind
		as thread-local_
			throw todo
		as global_
			getstatic out, var-field x.var
		pushed type
		handle-pos out, pos, type
	as var-set-low-expr
		emit-and-continue out, x.value
		match kind x.var
		as thread-local_
			throw todo
		as global_
			putstatic out, var-field x.var
			must-pop x.value.type
		handle-pos out, pos, type

-emit-for-loop void(out code-builder, pos expr-pos, a low-expr, x array-op-low-expr) java-expr-ctx
	type = a.type
	emit-and-continue out, x.input
	input-type = x.input.type
	must-pop input-type
	in-array local-index? = match x.input-kind
	as array
		begin-synthetic-local out, input-type
	as range
		()

	range-fields = if x.input-kind == range
		x.input.type.body.low-record!.fields

	empty-out-elem = is-empty-type x.out-element
	output-kind = output-kind x, a.type
	is-void bool = match output-kind
	as array
		false
	as void
		true

	nat32 = program.nat32
	integral-type = match input-kind x
	as array
		nat32
	as range
		x.in-element
	ir = as-runtime-type integral-type # TODO: NAME --------------------------------------------------------------------------------

	match x.input-kind
	as array
		iconst out, 0
	as range
		dup32 out
		getfield out, record-field input-type, range-fields[0]
	cur = begin-synthetic-local out, integral-type

	match x.input-kind
	as array
		get-array-size out, x.in-element, in-array!
	as range
		# Don't dup, this finishes using the range
		getfield out, record-field input-type, range-fields[1]
	end = begin-synthetic-local out, integral-type

	match output-kind
	as void
		()
	as array
		push-constant out, x.empty-out-array!, type
	out-array = begin-synthetic-local out, type

	# If cur == end: goto bottom
	# TODO: helper function for this (compares two integrals) --------------------------------------------------------------
	xload out, ir, cur
	xload out, ir, end
	match java-primitive-type! ir
	as T_LONG
		lcmp out
	as T_INT
		isub out
	else
		throw unreachable
	goto-bottom = ifeq out

	# If non-empty: assign out-array to a non-empty array
	unless is-void
		xload out, ir, end
		match x.input-kind
		as array
			()
		as range
			# size is end - cur
			xload out, ir, cur
			xsub out, ir
		checked-to-nat32 out, integral-type
		unless empty-out-elem
			new-array-for-type out, x.out-element
		xstore out, type.as-runtime-type, out-array
		must-pop type

	out-offset local-index? = match x.input-kind
	as array
		()
	as range
		unless is-void
			xload out, ir, cur
			begin-synthetic-local out, integral-type

	loop-body = of
		unless empty-out-elem
			aload out, out-array
			pushed type
			xload out, ir, cur
			if out-offset
				xload out, ir, out-offset
				xsub out, ir
			unchecked-to-nat32 out, integral-type
			pushed nat32
		match x.input-kind
		as array
			unless is-empty-type x.in-element
				aload out, in-array!
				xload out, ir, cur
				unchecked-to-nat32 out, integral-type
				xaload out, x.in-element.as-runtime-type
				pushed x.in-element
		as range
			xload out, ir, cur
			pushed integral-type
		# TODO:PERF in the case of looping over a range,
		# it could be more efficient to reuse 'cur' as the local for 'x.local' instead of copying it to a new local
		emit-with-opt-local out, x.local, x.in-element, continue_, x.body
		unless empty-out-elem
			astore out, x.out-element.as-runtime-type
			must-pop x.out-element
			must-pop nat32
			must-pop type

	loop-non-empty-range out, pos, type, integral-type, cur, end, loop-body, of
		# If there is no return type, make sure the stack frame does not include locals
		# (since it may be the same bytecode pos as the beginning stack frame of a loop)
		if out-offset
			end-synthetic-local integral-type, out-offset
		jumps-to-here goto-bottom, out, cur-stack-frame
		unless is-void
			xload out, type.as-runtime-type, out-array
			pushed type
		end-synthetic-local type, out-array
		end-synthetic-local integral-type, end
		end-synthetic-local integral-type, cur
		if in-array
			end-synthetic-local input-type, in-array

-emit-match-union void(out code-builder, pos expr-pos, type low-type, a match-union-low-expr) java-expr-ctx
	emit-and-continue out, a.matched
	matched-type = a.matched.type
	must-peek matched-type
	match union-representation matched-type
	as exception
		emit-match-union-using-instanceof out, pos, type, a
	as sealed-interface
		emit-match-union-using-instanceof out, pos, type, a
	as switch
		emit-match-union-using-switch out, pos, type, a
	as nullable
		with inner-pos in inner-pos out, pos
			null-case, non-null-case = if a.member-indices[0] == 0
				a.member-indices is (0, 1)
				only2! a.cases
			else
				a.member-indices is (1, 0)
				swap only2! a.cases
			forbid a.else_

			jump = ifnonnull out
			must-pop matched-type
			emit-expr out, inner-pos, null-case # ignore null-case.local since it is an empty type

			# Change the stack to have the state from before the jump
			must-pop type
			jumps-to-here jump, out, cur-stack-frame
			emit-expr out, inner-pos, non-null-case

-swap[t, u] (u, t)((a t, b u))
	b, a

-emit-match-union-using-instanceof void(out code-builder, pos expr-pos, type low-type, x match-union-low-expr) java-expr-ctx
	# Note: I tested using a 'switch' on the 'case-index' method, but it didn't improve performance.
	matched-type = x.matched.type
	with inner-pos in inner-pos out, pos
		for member-index, case_ in zip x.member-indices.to-array, x.cases
			is-last-case = member-index == x.member-indices[end - 1]
			case-type = x.union_.members[member-index]
			unless is-last-case
				dup32 out
			instanceof out, class_ case-type
			# Jump to next if the equality test returned 0 (false)
			jump = ifeq out
			unless is-last-case
				pop out, matched-type.as-runtime-type
			must-pop matched-type
			emit-expr out, inner-pos, case_

			# Change the stack to have the state from before 'jump'
			must-pop type
			unless is-last-case
				pushed matched-type
			jumps-to-here jump, out, cur-stack-frame
		if e = x.else_
			emit-expr out, inner-pos, e
			must-peek type
		else
			# TODO: If the type is 'exception' and we're calling 'show', we should call 'toString' in this case? -----------
			emit-unreachable out
			# Treat the stack effect as if it was successful
			pushed type

-emit-match-union-using-switch void
	out code-builder
	pos expr-pos
	type low-type
	a match-union-low-expr
do java-expr-ctx
	get-switchable-kind out, a.matched.type
	must-pop a.matched.type
	pushed program.nat32
	with inner-pos in inner-pos out, pos
		# This consumes 'kind'
		must-pop program.nat32
		jump-to-case, jump-to-default = lookupswitch out, map a.member-indices, it.to # TODO: use a table switch usually
		for target, case_ in zip jump-to-case, a.cases
			jumps-to-here target, out, cur-stack-frame
			emit-expr out, inner-pos, case_
			# Change the stack to have the state from before 'jump'
			must-pop type
		# default case
		jumps-to-here jump-to-default, out, cur-stack-frame
		if e = a.else_
			emit-expr out, pos, e
			must-peek type
		else
			emit-unreachable out
			pushed type

-xsub void(out code-builder, type java-runtime-type)
	match java-primitive-type! type
	as T_INT
		isub out
	as T_LONG
		lsub out
	else
		throw unreachable

-checked-to-nat32 void(out code-builder, integral-type low-type) java-refs
	match java-primitive-type! integral-type.as-runtime-type
	as T_LONG
		invokestatic out, crow-nat32-from-nat64
	as T_INT
		()
	else
		throw unreachable
-unchecked-to-nat32 void(out code-builder, integral-type low-type)
	match java-primitive-type! integral-type.as-runtime-type
	as T_LONG
		l2i out
	as T_INT
		()
	else
		throw unreachable

| Caller should push two integrals 'cur' and 'end' on the stack before calling this.
-loop-non-empty-range void
	out code-builder
	pos expr-pos
	type low-type
	integral-type low-type
	cur local-index
	end local-index
	loop-body void mut()
	after-loop void mut()
do java-expr-ctx
	###
	loop:
	<<loop body>>
	cur++
	if cur != end: goto loop
	###

	ir = as-runtime-type integral-type
	cur-and-end = of
		xload out, ir, cur
		xload out, ir, end
	is-64-bit bool = match java-primitive-type! ir
	as T_LONG
		true
	as T_INT
		false
	else
		throw unreachable

	loop_ = can-jump-back-to-here out, cur-stack-frame
	loop-body[]

	increment-integral out, cur, integral-type
	cur-and-end[]
	if is-64-bit
		lcmp out
		ifne out, loop_
	else
		if_icmpne out, loop_

	before = out.next-index
	after-loop[]
	if out.next-index == before
		# Give it space for a stack frame after the loop
		nop out
	handle-pos out, pos, type # TODO: then there is a double jump in some cases, improve? -------------------

-increment-integral void(out code-builder, local nat, integral-type low-type)
	java-type = as-runtime-type integral-type
	xload out, java-type, local
	match java-primitive-type! java-type
	as T_LONG
		lconst out, 1
		ladd out
	as T_INT
		iconst out, 1
		iadd out
	else
		throw unreachable
	xstore out, java-type, local

-get-local void(out code-builder, local low-local) expr-ctx
	do unless is-empty-type local.type
	match x = explain-local local
	as nat
		xload out, local.type.as-runtime-type, x
	as field-reference
		aload out, 0
		getfield out, x

-create-lambda-implementation-class symbol
	uri uri
	containing-fun low-fun
	lambda-type low-type
	a lambda-low-expr
do java-ctx
	the java-refs = start-new-class names
	this-class-name = lambda-impl-class-name containing-fun, the::to-java-ctx.next-lambda-index
	the::to-java-ctx.next-lambda-index +:= 1
	this-class = class_ constants, this-class-name
	closure field-reference[low-local] = for x in a.closure
		forbid is-empty-type x.type
		- x
		- lambda-impl-field this-class, x
	super-class = class_ lambda-type
	fields field_info[] = if is-empty a.closure
		- instance-field this-class-name
	else
		for x in a.closure
			forbid is-empty-type x.type
			access-flags: final
			name: lambda-impl-field-name x
			descriptor: descriptor-for-field-type x.type
			attributes: ()
	methods method_info[] = with methods-out in build
		field-refs (field-reference, java-runtime-type)[] = for local in a.closure
			closure[local]!, local.type.as-runtime-type
		methods-out ~= record-initializer super-class, field-refs, lambda-init-descriptor a
		if is-empty a.closure
			methods-out ~= clinit-for-instance-field this-class-name, this-class
		methods-out ~= lambda-run-method this-class, containing-fun, closure, lambda-type, a
	add-class this-class-name,
		source SourceFile_attribute = SourceFile, constants[uri.to]
		constant-pool: finish constants
		access: final
		this-class: this-class
		super-class: super-class
		interfaces: ()
		fields: fields
		methods: methods
		attributes: source,
	this-class-name
-lambda-run-method method_info
	this-class class-reference
	containing-fun low-fun
	closure field-reference[low-local]
	lambda-type low-type
	a lambda-low-expr
do java-ctx, java-refs
	the expr-ctx = this-class, containing-fun, closure, true,
		unless is-empty-type a.param.type
			- a.param
	code = with out in build-code
		emit-expr out, return, a.body
	verify-expr-ctx-finished a.body.type, (a.param,)
	access-flags: if lambda-type-is-runnable lambda-type then public
	name: run
	descriptor: lambda-call-descriptor lambda-type
	attributes: code,

-always-throws bool(a low-expr)
	match x = a.kind
	as finally-low-expr
		always-throws x.below
	as seq-low-expr
		exists x.parts, it.always-throws
	as throw-low-expr
		true
	else
		false

-get-switchable-kind void(out code-builder, union-type low-type) java-expr-ctx
	getfield out, switchable-kind-field union-type
-get-switchable-value void(out code-builder, union-type low-type) java-expr-ctx
	getfield out, switchable-value-field union-type

-fits-in-int32 bool(a int64)
	min-value::int32::int64 <= a and a <= max-value::int32
-fits-in-nat32 bool(a nat64)
	a <= max-value::nat32

-emit-with-unboxed-opt-local void
	out code-builder
	unboxed-type low-type
	local low-local?
	pos expr-pos
	expr low-expr
do java-expr-ctx
	assert unboxed-type.as-runtime-type == reference-type
	if local
		unbox-if-necessary out, local.type
		must-refine unboxed-type, local.type
		emit-with-local out, local, pos, expr
	else
		pop out, reference-type
		must-pop unboxed-type
		emit-expr out, pos, expr

-emit-with-opt-local void(out code-builder, local low-local?, local-type low-type, pos expr-pos, expr low-expr) java-expr-ctx
	if local
		local.type is local-type
		emit-with-local out, local, pos, expr
	else
		pop out, local-type.as-runtime-type
		must-pop local-type
		emit-expr out, pos, expr

-emit-with-local void(out code-builder, local low-local, pos expr-pos, expr low-expr) java-expr-ctx
	store-local out, local
	emit-expr out, pos, expr
	unless is-empty-type local.type
		locals.pop! is local
-store-local void(out code-builder, local low-local) expr-ctx
	do unless is-empty-type local.type
	xstore out, local.type.as-runtime-type, next-local-index
	must-pop local.type
	locals ~= local

-local-index alias
	nat
-begin-synthetic-local nat(out code-builder, local-type low-type) expr-ctx
	local = next-local-index
	unless is-empty-type local-type
		xstore out, local-type.as-runtime-type, local
		locals ~= local-type
	local
-end-synthetic-local void(local-type low-type, local nat) expr-ctx
	unless is-empty-type local-type
		locals.pop! is local-type
	next-local-index is local

-exception-case-type-from-index low-type(exception-case-index nat) to-java-ctx
	program.exception.body.low-union!.members[exception-case-index]

| Used before an instruction that will use the args
-emit-args void(out code-builder, args low-expr[]) java-expr-ctx
	for arg in args
		emit-and-continue out, arg
		must-peek arg.type
| Does not actually pop args, just acknowledges that some operation took values off of the stack
-popped-args void(args low-expr[]) expr-ctx
	for arg low-expr in reverse args # TODO: should not need type annotation
		must-pop arg.type
-pushed void(type low-type) expr-ctx
	unless is-empty-type type
		stack ~= type
-must-pop void(type low-type) expr-ctx
	unless is-empty-type type
		stack.pop! is type
-must-peek void(type low-type) expr-ctx
	unless is-empty-type type
		stack.peek! is type
| Can use this for an up or down cast
-must-refine void(old-type low-type, new-type low-type) expr-ctx
	unless is-empty-type old-type
		stack.pop! is old-type
	unless is-empty-type new-type
		stack ~= new-type
-function-like void(out code-builder, return-type low-type, args low-expr[], f void mut()) java-expr-ctx
	emit-args out, args
	f[]
	popped-args args
	pushed return-type

-translate-builtin void
	out code-builder
	fun builtin-fun
	type-args low-type[]
	type low-type
	args low-expr[]
do java-expr-ctx
	match fun
	as builtin-unary
		function-like out, type, args, of
			translate-builtin-unary out, type, args.only!.type, fun, type-args
	as builtin-binary
		function-like out, type, args, of
			translate-builtin-binary out, type, args[0].type, fun
	as builtin-ternary
		translate-builtin-ternary out, fun, args
	as builtin-fun-call-lambda
		function-like out, type, args, of
			lambda, _ = only2! args
			invokevirtual out, lambda-call lambda.type
	as builtin-fun-constant
		throw unreachable
	as builtin-fun-is-empty-type
		throw unreachable
	as builtin-fun-is-target
		throw unreachable
	as js-fun
		throw unreachable

-translate-builtin-unary void
	out code-builder
	return-type low-type
	arg-type low-type
	kind builtin-unary
	type-args low-type[]
do java-expr-ctx
	match kind
	as array-size
		unless is-empty-type only! type-args
			arraylength out
		i2l out
	as bits-of-float32
		invokestatic out, java-floatToRawIntBits
	as bits-of-float64
		invokestatic out, java-doubleToRawLongBits
	as bitwise-not
		match as-nat-type! return-type
		as nat8
			bitwise-not-int32 out
			i2b out
		as nat16
			bitwise-not-int32 out
			i2s out
		as nat32
			bitwise-not-int32 out
		as nat64
			lconst out, -1
			lxor out
	as float32-from-bits
		invokestatic out, java-intBitsToFloat
	as float64-from-bits
		invokestatic out, java-longBitsToDouble
	as uninitialized-buffer
		l2i out # TODO: throw OOM if it's too big to fit in an int32 -------------------------------------------------------------------------
		new-array-for-type out, only! type-args
	as not
		bitwise-not-int32 out
		iconst out, 1
		iand out
	as reinterpret-cast
		if x = as-array-or-buffer return-type and y = as-array-or-buffer arg-type and x == y
			# Do nothing, they have the same representation
			()
		elif is-enum-or-flags return-type
			()
		elif is-Object return-type
			box-no-refine out, arg-type, return-type
		else
			cast-and-unbox-if-necessary out, return-type
	as to-float32-from-float64
		d2f out
	as to-float64-from-float32
		f2d out
	as to-float64-from-int64
		l2d out
	as to-float64-from-nat64
		invokestatic out, crow-float64FromNat64
	as truncate-to-int64-from-float64
		d2l out
	as weak-ref-get
		invokestatic out, crow-weakRefGet
		cast-and-unbox-if-necessary out, only! type-args
	as weak-ref-new
		invokestatic out, crow-newWeakRef
	as wrap-convert-integral
		convert-integral out, return-type.as-integral-type-allow-char!, (if is-bool arg-type then nat8 else arg-type.as-integral-type-allow-char!)

-bitwise-not-int32 void(out code-builder)
	iconst out, -1
	ixor out

-is-Object bool(a low-type)
	body = a.body
	body.struct-body-extern-java and body.path == "java/lang/Object".as-path

-convert-integral void(out code-builder, return-type integral-type, arg-type integral-type)
	match type = arg-type.to::nat-or-int
	as nat-type
		convert-unsigned-integral out, return-type.unsigned, type
	as int-type
		convert-signed-integral out, return-type.signed, type

	# If the sign differs, just let it wrap
-convert-unsigned-integral void(out code-builder, return-type nat-type, arg-type nat-type)
	convert-signed-integral out, return-type.signed, arg-type.signed
	do if return-type > arg-type
	match arg-type
	as nat8
		if return-type == nat64
			lconst out, 0xff
			land out
		else
			iconst out, 0xff
			iand out
	as nat16
		if return-type == nat64
			lconst out, 0xffff
			land out
		else
			iconst out, 0xffff
			iand out
	as nat32
		assert return-type == nat64
		lconst out, 0xffffffff
		land out
	as nat64
		throw unreachable
-convert-signed-integral void(out code-builder, return-type int-type, arg-type int-type)
	match return-type
	as int8
		match arg-type
		as int8
			()
		as int16
			# There's no 's2b' because integers are always stored as int32 at miminum
			i2b out
		as int32
			i2b out
		as int64
			l2i out
			i2b out
	as int16
		match arg-type
		as int8
			()
		as int16
			()
		as int32
			i2s out
		as int64
			l2i out
			i2s out
	as int32
		if arg-type == int64
			l2i out
	as int64
		if arg-type != int64
			i2l out

-translate-builtin-binary void
	out code-builder
	return-type low-type
	param0-type low-type
	kind builtin-binary
do java-refs
	match kind
	as add-float
		match as-float-type! return-type
		as float32
			fadd out
		as float64
			dadd out
	as array-get
		if is-empty-type return-type
			pop out, T_LONG
		else
			l2i out
			xaload out, as-runtime-type return-type
	as bitwise-and
		if is-64-bit as-integral-type! return-type
			land out
		else
			iand out
	as bitwise-or
		if is-64-bit as-integral-type! return-type
			lor out
		else
			ior out
	as bitwise-xor
		if is-64-bit as-integral-type! return-type
			lxor out
		else
			ixor out
	as compare
		if f = as-float-type param0-type
			invokestatic out, crow-compare-float f
		else
			invokestatic out, crow-compare-integral param0-type.as-integral-type-allow-bool-char!
	as equal-exact
		reference-equal out, param0-type
	as equal-float-ieee
		invokestatic out, crow-equal-float-ieee param0-type.as-float-type!
	as less-float-ieee
		invokestatic out, crow-less-float-ieee param0-type.as-float-type!
	as mul-float
		match as-float-type! return-type
		as float32
			fmul out
		as float64
			dmul out
	as sub-float
		match as-float-type! return-type
		as float32
			fsub out
		as float64
			dsub out
	as unsafe-bit-shift-left
		if return-type.as-integral-type! == nat64
			l2i out # second argument must be an int
			lshl out
		else
			ishl out
	as unsafe-bit-shift-right
		match as-integral-type! return-type
		as nat8
			# Need to trim any extra bits before they get shifted right
			swap out
			iconst out, 0xff
			iand out
			swap out
			iushr out
		as nat16
			swap out
			iconst out, 0xffff
			iand out
			swap out
			iushr out
		as nat32
			iushr out
		as nat64
			l2i out # second argument must be an int
			lushr out
		else
			throw unreachable
	as unsafe-div
		if f = as-float-type return-type
			match f
			as float32
				fdiv out
			as float64
				ddiv out
		elif n = as-nat-type return-type
			invokestatic out, java-divideUnsigned n
		else
			i = as-int-type! return-type
			if i == int64
				ldiv out
			else
				idiv out
	as unsafe-mod-float64
		drem out
	as unsafe-mod-nat64
		invokestatic out, java-remainderUnsigned nat64
	as wrap-add
		if is-64-bit as-integral-type! return-type
			ladd out
		else
			iadd out
	as wrap-mul
		if is-64-bit as-integral-type! return-type
			lmul out
		else
			imul out
	as wrap-sub
		if is-64-bit as-integral-type! return-type
			lsub out
		else
			isub out

-translate-builtin-ternary void(out code-builder, kind builtin-ternary, args low-expr[]) java-expr-ctx
	match kind
	as array-set
		array, index, value = only3! args
		emit-and-continue out, array
		emit-and-continue out, index
		l2i out
		emit-and-continue out, value
		if is-empty-type value.type
			pop out, T_INT
			pop out, reference-type
		else
			astore out, value.type.as-runtime-type
		popped-args args

-reference-equal void(out code-builder, param-type low-type) java-refs
	match rt = as-runtime-type param-type
	as void
		throw todo # TODO: if param-type is void, just push 'true' -------------------------------------------------------------------------
	as java-primitive-type
		invokestatic out, match rt
		as T_BOOLEAN
			crow-equal-integral int8
		as T_CHAR
			crow-equal-integral nat8
		as T_FLOAT
			crow-equal-float float32
		as T_DOUBLE
			crow-equal-float float64
		as T_BYTE
			crow-equal-integral int8
		as T_SHORT
			crow-equal-integral int16
		as T_INT
			crow-equal-integral int32
		as T_LONG
			crow-equal-integral int64
	as reference-type
		invokestatic out, crow-reference-equal

-as-integral-type-allow-bool-char integral-type?(a low-type)
	if is-bool a
		nat8
	else
		as-integral-type-allow-char a

-get-array-size void(out code-builder, element low-type, local nat)
	if is-empty-type element
		iload out, local
	else
		aload out, local
		arraylength out
