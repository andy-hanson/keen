import
	../../util/util
	../write-to-c
	./java-ast
	./mangle-for-java

write-java-ast (string, string)[](a java-ast)
	with out : build
		out ~= ("Crow.java", crow-java)
		out ~= ("Union.java", union-java)
		out ~= ("Void.java", void-java)
		for x : a classes
			# TODO: should be able to write these inline ----------------------------------------------------------------------------
			k string = "{x name}.java"
			v string = with b : build; b write-class x
			out ~= (k, v)
		for x : a interfaces
			# TODO: should be able to write these inline ----------------------------------------------------------------------------
			k string = "{x name}.java"
			v string = with b : build; b write-interface x
			out ~= (k, v)

-crow-java string()
	"""class Crow \{
	static ThreadLocal<java.util.concurrent.locks.ReentrantLock> curExclusion = new ThreadLocal<java.util.concurrent.locks.ReentrantLock>() \{
		@Override protected java.util.concurrent.locks.ReentrantLock initialValue() \{
			java.util.concurrent.locks.ReentrantLock res = new java.util.concurrent.locks.ReentrantLock();
			res.lock();
			return res;
		}
	};
	// This must be public because it's called through reflection
	public static Throwable catchAll(Object fn, java.lang.invoke.MethodHandle callIt) \{
		try \{
			callIt.invoke(fn);
			return null;
		} catch (Throwable e) \{
			return e;
		}
	}
	public static void yieldFiber() \{
		java.util.concurrent.locks.ReentrantLock lock = curExclusion.get();
		lock.unlock();
		lock.lock();
	}
	static java.util.concurrent.locks.ReentrantLock getExclusion() \{
		return curExclusion.get();
	}
	static Void changeExclusion(java.util.concurrent.locks.ReentrantLock newExclusion) \{
		java.util.concurrent.locks.ReentrantLock prevExclusion = curExclusion.get();
		prevExclusion.unlock();
		curExclusion.set(newExclusion);
		newExclusion.lock();
		return Void.get();
	}

	static <T> T throw_(java.lang.String message) \{
		throw new Error(message);
	}

	static double float64FromNat64(long a) \{
		return a < 0 ? (double) a + Math.pow(2, 64) : (double) a;
	}
	static double round(double a) \{
		return (a < 0 ? -1 : 1) * Math.round(Math.abs(a));
	}

	static double acosh(double x) \{
		return Math.log(x + Math.sqrt(x * x - 1.0));
	}
	static double asinh(double x) \{
		return Math.log(x + Math.sqrt(x * x + 1.0));
	}
	static double atanh(double x) \{
		return 0.5 * Math.log(Math.abs((x + 1) / (x - 1)));
	}

	static java.lang.invoke.MethodHandle funPointer(String className, String methodName, java.lang.Class returnType, java.lang.Class... args) throws Throwable \{
		return lookup.findStatic(Class.forName(className), methodName, java.lang.invoke.MethodType.methodType(returnType, args));
	}
	private static java.lang.invoke.MethodHandles.Lookup lookup = java.lang.invoke.MethodHandles.lookup();

	static java.lang.Object getStaticField(String className, String fieldName) throws Throwable \{
		return Class.forName(className).getDeclaredField(fieldName).get(null);
	}
	static java.lang.Object callNew(java.lang.String className, java.lang.Object... args) throws Throwable \{
		return getConstructor(Class.forName(className), args).newInstance(args);
	}
	static java.lang.Object callStatic(java.lang.String className, java.lang.String methodName, java.lang.Object... args) throws Throwable \{
		return callStaticVarargs(className, methodName, args);
	}
	static java.lang.Object callStaticVarargs(java.lang.String className, java.lang.String methodName, java.lang.Object[] args) throws Throwable \{
		return getMethod(Class.forName(className), methodName, args).invoke(null, args);
	}
	static java.lang.Object callInstance(Object object, String name, Object... args) throws Throwable \{
		return getMethod(classOf(object), name, args).invoke(object, args);
	}
	private static java.lang.reflect.Constructor getConstructor(java.lang.Class<?> class_, java.lang.Object[] args) throws Throwable \{
		java.lang.Class<?>[] argClasses = classes(args);
		try \{
			return class_.getConstructor(argClasses);
		} catch (java.lang.NoSuchMethodException e) \{
			throw new Error("TODO: advanced search for correct constructor to call");
		}
	}
	private static java.lang.reflect.Method getMethod(java.lang.Class<?> class_, java.lang.String methodName, java.lang.Object[] args) throws Throwable \{
		java.lang.Class<?>[] argClasses = classes(args);
		try \{
			return class_.getMethod(methodName, argClasses);
		} catch (java.lang.NoSuchMethodException e) \{
			java.lang.reflect.Method[] methods = class_.getMethods();
			java.lang.reflect.Method res = null;
			for (int i = 0; i < methods.length; i++) \{
				java.lang.reflect.Method method = methods[i];
				if (method.getName() == methodName && method.getParameterCount() == args.length && canCallMethod(method.getParameterTypes(), argClasses)) \{
					if (res == null)
						res = methods[i];
					else
						throw new Error("Multiple methods could match the given arguments");
				}
			}
			if (res == null) throw e;
			return res;
		}
	}
	private static java.lang.Class<?>[] classes(java.lang.Object[] args) \{
		java.lang.Class<?>[] res = new java.lang.Class<?>[args.length];
		for (int i = 0; i < res.length; i++)
			res[i] = classOf(args[i]);
		return res;
	}
	private static boolean canCallMethod(java.lang.Class<?>[] parameterTypes, java.lang.Class<?>[] argClasses) \{
		for (int i = 0; i < parameterTypes.length; i++) \{
			if (!parameterTypes[i].isAssignableFrom(argClasses[i]))
				return false;
		}
		return true;
	}
	private static java.lang.Class classOf(Object a) \{
		java.lang.Class res = a.getClass();
		if (res == java.lang.Integer.class)
			return int.class;
		// TODO: handle other primitives ---------------------------------------------------------------------------------------
		// TODO: could probably use isAssignableFrom instead of checking the name
		// HAX: Can't directly ask for a method on that class, so have to skip to the Path interface instead ----------------------------------
		else if (res.getName() == "sun.nio.fs.UnixPath")
			return java.nio.file.Path.class;
		// Similar HAX ------------------------------------------------------------------------------------------------------------
		else if (res.getName() == "java.util.stream.ReferencePipeline$Head")
			return java.util.stream.Stream.class;
		// Further HAX ------------------------------------------------------------------------------------------------------------
		else if (res.getName() == "java.io.BufferedInputStream")
			return java.io.InputStream.class;
		else
			return res;
	}
}
"""
union-java string()
	"""class Union \{
	int kind;
	java.lang.Object value;
	Union(int kind, java.lang.Object value) \{
		this.kind = kind;
		this.value = value;
	}
}
"""
void-java string()
	"""class Void \{
	static Void instance = new Void();
	static Void get() \{ return instance; }
}
"""

-write-interface void(out string-builder, a java-interface)
	out ~~= "interface {a name} \{"
	for method : a methods
		out ~~= "\n\t{method return-type} {method name}"
		out write-params method.params
		out ~~= " throws Throwable;"
	out ~~= "\n}\n"

-write-class void(out string-builder, a java-class)
	unless a.comment is-empty
		out ~~= "// {a comment}\n"
	out ~~= "class {a name}"
	if s ?= a extends
		out ~~= " extends {s}"
	for s : a implements
		out ~~= " implements {s}"
	out ~~= " \{"
	for field : a fields
		out ~~= "\n\t"
		out write-visibility field.visibility
		out write-kind field.kind
		out ~~= "{field type} {field name}"
		if i ?= field initializer
			out ~~= " = "
			out write-expr 1, i
		out ~= ";"
	if x ?= a constructor
		out ~~= "\n\t{a name}"
		out write-params x.params
		out write-block-statement 1, x.body
	for method : a methods
		out ~~= "\n\t"
		out write-method 1, method
	out ~~= "\n}\n"

-write-method void(out string-builder, indent nat, a java-method)
	unless a.comment is-empty
		out ~~= "// {a comment}{indent newline}"
	out write-visibility a.visibility
	out write-kind a.kind
	out ~~= "{a return-type} {a name}"
	out write-params a.params
	out ~~= " throws Throwable"
	out write-block-statement indent, a.body

-write-visibility void(out string-builder, a java-visibility)
	out ~~= match a
	as private
		"private "
	as internal
		""
	as public
		"public "

-write-kind void(out string-builder, a java-method-kind)
	match a
	as instance
		()
	as static
		out ~~= "static "

-show string(type java-type)
	match type
	as string x
		x
	as java-array-type x
		"{x element-type}[]"

-write-params void(out string-builder, params java-param[])
	res string = ", " join for param : params
		"{param type} {param name}"
	out ~~= "({res})"

-write-block-statement void(out string-builder, indent nat, a java-statement[])
	out ~~= " \{"
	for statement : a
		out ~~= indent + 1 newline
		out write-statement indent + 1, statement
	out ~~= indent newline
	out ~= "}"

-write-statement void(out string-builder, indent nat, a java-statement)
	match a
	as java-assign-statement x
		out write-expr indent, x.left
		out ~~= " = "
		out write-expr indent, x.right
		out ~= ";"
	as java-break x
		out ~~= "break"
		if label ?= x label
			out ~~= " {label}"
		out ~= ";"
	as java-continue
		out ~~= "continue;"
	as java-expr x
		out write-expr indent, x
		out ~= ";"
	as java-if-statement x
		out ~~= "if ("
		out write-expr indent + 2, x.cond
		out ~~= ")"
		out write-block-statement indent, x.then
		out ~~= " else"
		out write-block-statement indent, x.else_
	as java-return-statement x
		out ~~= "return "
		out write-expr indent, x.returned
		out ~= ";"
	as java-switch-statement x
		out ~~= "switch ("
		out write-expr indent, x.matched
		out ~~= ") \{"
		for case_ : x cases
			out ~~= "{indent + 1 newline}case "
			out write-expr indent, case_.value
			out ~= ":"
			out write-block-statement indent + 1, case_.body
		out ~~= "{indent + 1 newline}default:"
		out write-block-statement indent + 1, x.default
		out ~~= "{indent newline}}"
	as java-throw-statement x
		out ~~= "throw "
		out write-expr indent, x.thrown
		out ~= ";"
	as java-try-statement x
		out ~~= "try"
		out write-block-statement indent, x.tried
		for catch_ : x catches
			out ~~= " catch ({catch_ caught-class} {catch_ caught-local})"
			out write-block-statement indent, catch_.then
		if f ?= x finally_
			out ~~= " finally"
			out write-block-statement indent, f
	as java-var-decl x
		out ~~= "{x type} {x name}"
		if init ?= x initializer
			out ~~= " = "
			out write-expr indent, init
		out ~= ";"
	as java-while x
		if label ?= x label
			out ~~= "{label}: "
		out ~~= "while ("
		out write-expr indent + 2, x.condition
		out ~= ")"
		out write-block-statement indent, x.body

-write-expr void(out string-builder, indent nat, a java-expr)
	match a
	as java-access-static-field x
		out ~~= "{x name}"
	as java-array-get x
		out write-expr indent, x.array
		out ~= "["
		out write-expr indent, x.index
		out ~= "]"
	as java-binary x
		out ~= "("
		out write-expr indent, x.arg0
		out ~~= " {x kind} "
		out write-expr indent, x.arg1
		out ~= ")"
	as java-call-instance-method x
		out write-expr indent, x.object
		out ~~= ".{x method-name}"
		out write-args indent, x.args
	as java-call-static-method x
		out ~~= "{x name}"
		out write-args indent, x.args
	as java-cast x
		out ~~= "(({x type}) "
		out write-expr indent, x.inner
		out ~= ")"
	as java-class-expr x
		out ~~= "{x class_}.class"
	as java-inline-class x
		out ~~= "new {x type}() \{"
		for field : x fields
			out ~~= "{indent + 1 newline}{field type}{field name} = "
			out write-expr indent + 1, field.initializer
			out ~= ";"
		for method : x methods
			out ~~= indent + 1 newline
			out write-method indent + 1, method
		out ~~= "{indent newline}}"
	as java-instanceof x
		out ~= "("
		out write-expr indent, x.value
		out ~~= " instanceof {x type})"
	as java-literal-array x
		out ~~= "new {x element-type}[] \{ "
		first mut = true
		for value : x values
			if first
				first := false
			else
				out ~~= ", "
			out write-expr indent, value
		out ~~= " }"
	as java-literal-boolean x
		out ~~= "{x value}"
	as java-literal-float x
		out ~~= x.value float-literal-for-c-or-java "Double.POSITIVE_INFINITY", "Double.NaN" 
		if x is-float32
			out ~= "f"
	as java-literal-int32-or-less x
		out ~~= "{x value}"
	as java-literal-int64 x
		out ~~= "{x value}L"
	as java-literal-string x
		out ~~= x.value quote
	as java-local-access x
		out ~~= x name
	as java-new x
		out ~~= "new {x class-name}"
		out write-args indent, x.args	
	as java-new-array x
		# TODO: what about at t[][][]? --------------------------------------------------------------------------------------------------
		match x.element-type
		as java-array-type array
			out ~~= "new {array element-type}["
			out write-expr indent, x.size
			out ~~= "][]"
		as string s
			out ~~= "new {s}["
			out write-expr indent, x.size
			out ~= "]"
	as java-null
		out ~~= "null"
	as java-this
		out ~~= "this"
	as java-ternary x
		out ~~= "("
		out write-expr indent, x.cond
		out ~~= " ? "
		out write-expr indent + 1, x.then
		out ~~= " : "
		out write-expr indent + 1, x.else_
		out ~~= ")"
	as java-throw-expression x
		out ~~= "Crow.<{x type}>throw_({x.message quote})"
	as java-property-access x
		out write-expr indent, x.left
		out ~~= ".{x property}"
	as java-unary x
		out ~~= "({x kind}"
		out write-expr indent, x.arg
		out ~= ")"

-write-args void(out string-builder, indent nat, args java-expr[])
	first mut = true
	out ~= "("
	for arg : args
		if first
			first := false
		else
			out ~~= ", "
		out write-expr indent, arg
	out ~= ")"
