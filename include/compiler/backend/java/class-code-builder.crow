import
	./class-builder

build-code record nominal, mut
	constants constants-builder
with-block Code_attribute(a build-code, f void mut(a code-builder))
	exception-table mut exception-table-entry[] = ()
	stack-map mut stack_map_frame[] = ()
	code nat8[] = with out : build
		builder code-builder = (out,), (), ()
		f[builder]
		exception-table := builder.exception-table move-to
		stack-map := builder.stack-map move-to
	attribute-name-index: a.constants["Code"]
	max-stack: 99
	max-locals: 99
	code: code
	exception-table: exception-table
	attributes: unless stack-map is-empty
		(a.constants["StackMapTable"] StackMapTable_attribute stack-map),
# MOVE
code-builder record mut
	-out bytecode-out
	-exception-table exception-table-entry mut[]
	-stack-map stack_map_frame mut[]
add-to-exception-table void(a code-builder, entry exception-table-entry)
	a.exception-table ~= entry
add-to-stack-map void(a code-builder, frame stack_map_frame)
	a.stack-map ~= frame
next-index nat16(a code-builder)
	a.out.next-index to
bipush void(a code-builder, value nat8)
	a.out ~= 0x10
	a.out ~= value
dup void(a code-builder)
	a.out ~= 0x59
aload_0 void(a code-builder)
	a.out ~= 0x2a
iconst_1 void(a code-builder)
	a.out ~= 0x4
idiv void(a code-builder)
	a.out ~= 0x6c
iload_0 void(a code-builder)
	a.out ~= 0x1a
iload_1 void(a code-builder)
	a.out ~= 0x1b
iload_2 void(a code-builder)
	a.out ~= 0x1c
areturn void(a code-builder)
	a.out ~= 0xb0
ireturn void(a code-builder)
	a.out ~= 0xac
makenew void(a code-builder, class_ class-reference)
	a.out ~= 0xbb
	a.out ~~= class_
getfield void(a code-builder, field field-reference)
	a.out ~= 0xb4
	a.out ~~= field
| WARN: To pop a long or double, use pop2 instead
pop void(a code-builder)
	a.out ~= 0x57
putfield void(a code-builder, field field-reference)
	a.out ~= 0xb5
	a.out ~~= field
invokespecial void(a code-builder, ref method-reference)
	a.out ~= 0xb7
	a.out ~~= ref
invokevirtual void(a code-builder, ref method-reference)
	a.out ~= 0xb6
	a.out ~~= ref
| Returns 'void'
return void(a code-builder)
	a.out ~= 0xb1
instanceof void(a code-builder, class_ class-reference)
	a.out ~= 0xc1
	a.out ~~= class_
ifeq void(a code-builder, branch int16)
	a.out ~= 0x99
	a.out ~~= branch
checkcast void(a code-builder, class_ class-reference)
	a.out ~= 0xc0
	a.out ~~= class_
