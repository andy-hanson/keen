import
	./class-builder

build-code record nominal, mut
	constants constants-builder
with-block Code_attribute(a build-code, f void mut(a code-builder))
	builder code-builder = (), a.constants, (), (), (), ()
	f[builder]
	code = builder.out finish
	attribute-name-index: a.constants["Code"]
	max-stack: 99
	max-locals: 99
	code: code
	exception-table: builder.exception-table move-to
	attributes: with out : build
		unless builder.line-number-table is-empty
			out ~= a.constants["LineNumberTable"] LineNumberTable_attribute builder.line-number-table.move-to
		unless builder.stack-map is-empty
			out ~= a.constants["StackMapTable"] StackMapTable_attribute builder.stack-map.move-to
# MOVE
code-builder record mut
	-out bytecode-out
	constants constants-builder
	-exception-table exception-table-entry mut[]
	-next-stack-frame-relative-to mut nat16
	-stack-map stack_map_frame mut[]
	-line-number-table line-number-table-entry mut[]

stack-frame record
	locals verification_type_info[]
	stack verification_type_info[]

deferred-jump record mut
	-jump-from nat16
	# This is a byte index, but the jump offset is a nat16
	-location-of-offset nat16
| Call this when 'out' is at the postion where it should jump to
jumps-to-here void(a deferred-jump, out code-builder, stack-frame stack-frame)
	cur = out next-index
	offset nat16 = cur - a.jump-from
	out.out.out[a.location-of-offset to] := offset >> 8 to
	out.out.out[a.location-of-offset.to + 1] := offset & 0xff to
	out set-stack-frame stack-frame

deferred-jump32 record mut
	-jump-from nat32
	-location-of-offset nat32
jumps-to-here void(a deferred-jump32, out code-builder, stack-frame stack-frame)
	cur = out next-index
	offset nat32 = cur.to - a.jump-from
	out.out.out[a.location-of-offset to] := offset >> 24 to
	out.out.out[a.location-of-offset.to + 1] := ((offset >> 16) & 0xff) to
	out.out.out[a.location-of-offset.to + 2] := ((offset >> 8) & 0xff) to
	out.out.out[a.location-of-offset.to + 3] := (offset & 0xff) to
	out set-stack-frame stack-frame

mark-line-number void(a code-builder, line-number nat16)
	unless a.line-number-table !is-empty && a.line-number-table[end - 1].line-number == line-number
		a.line-number-table ~= a.next-index, line-number

add-to-exception-table void(a code-builder, start nat16, end nat16, catch-type class-reference, frame stack-frame)
	a.exception-table ~= start, end, a.next-index, catch-type
	a set-stack-frame frame
-set-stack-frame void(a code-builder, frame stack-frame)
	cur-pos = a next-index
	guard cur-pos + 1 != a.next-stack-frame-relative-to # In that case it would be a duplicate
	locals = frame locals
	stack = frame stack
	# TODO: for efficiency, use the simpler frames where possible and not always full_frame ----------------------------------
	full full_frame = do
		offset-delta: cur-pos - a.next-stack-frame-relative-to
		locals: locals
		stack: stack
	a.stack-map ~= full
	a.next-stack-frame-relative-to := cur-pos + 1

next-index nat16(a code-builder)
	a.out.next-index to
dup32 void(a code-builder)
	a.out ~= 0x59
dup64 void(a code-builder)
	a.out ~= 0x5c
dup_x1 void(a code-builder)
	a.out ~= 0x5a
xload void(a code-builder, type java-runtime-type, index nat)
	match type
	as void
		()
	as java-primitive-type p
		match p
		as T_BOOLEAN
			a iload index
		as T_CHAR
			a iload index
		as T_FLOAT
			a fload index
		as T_DOUBLE
			a dload index
		as T_BYTE
			a iload index
		as T_SHORT
			a iload index
		as T_INT 
			a iload index
		as T_LONG 
			a lload index
	else
		a aload index
aload void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x2a + index.to # aload_0, aload_1, aload_2, or aload_3
	else
		a.out ~= 0x19 # aload
		a.out ~= index to
-dload void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x26 + index.to # dload_0, dload_1, dload_2, or dload_3
	else
		a.out ~= 0x18 # dload
		a.out ~= index to
-fload void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x22 + index.to # fload_0, fload_1, fload_2, or fload_3
	else
		a.out ~= 0x17 # fload
		a.out ~= index to
iload void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x1a + index.to # iload_0, iload_1, iload_2, or iload_3
	else
		a.out ~= 0x15 # iload
		a.out ~= index to
-lload void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x1e + index.to # lload_0, lload_1, lload_2, or lload_3
	else
		a.out ~= 0x16 # lload
		a.out ~= index to
aconst_null void(a code-builder)
	a.out ~= 0x1
dconst void(a code-builder, value float64)
	if value == 0
		a.out ~= 0xe
	elif value == 1
		a.out ~= 0xf
	else
		a ldc T_DOUBLE, (a.constants float64 value)
fconst void(a code-builder, value float32)
	if value == 0
		a.out ~= 0xb # fconst_0
	elif value == 1
		a.out ~= 0xc
	elif value == 2
		a.out ~= 0xd
	else
		a ldc T_FLOAT, (a.constants float32 value)
iconst void(a code-builder, value int32)
	if value == -1
		a.out ~= 0x2
	elif 0::int32 <= value && value <= 5
		a.out ~= 0x3 + value.to::nat32.to
	elif -128::int32 <= value && value <= 127
		a.out ~= 0x10 # bipush
		a.out ~= value.to.to::int8.wrap-to
	else
		a ldc T_INT, (a.constants int32 value)
lconst void(a code-builder, value int64)
	if value == 0
		a.out ~= 0x9
	elif value == 1
		a.out ~= 0xa
	else
		a ldc T_LONG, (a.constants int64 value)
| 'reference' is a constant index, not the value itself
ldc void(a code-builder, type java-runtime-type, reference nat16)
	forbid reference == 0
	if type is-double-size
		a.out ~= 0x14 # ldc2_w
		a.out ~~= reference
	elif reference <= 0xff
		a.out ~= 0x12 # ldc
		a.out ~= reference.to
	else
		a.out ~= 0x13 # ldc_w
		a.out ~~= reference
idiv void(a code-builder)
	a.out ~= 0x6c
return void(a code-builder, type java-runtime-type)
	match type
	as void
		a.out ~= 0xb1 # return
	as java-primitive-type p
		match p
		as T_BOOLEAN
			a.out ~= 0xac # ireturn
		as T_CHAR
			a.out ~= 0xac # ireturn
		as T_FLOAT
			a.out ~= 0xae # freturn
		as T_DOUBLE
			a.out ~= 0xaf # dreturn
		as T_BYTE
			a.out ~= 0xac # ireturn
		as T_SHORT
			a.out ~= 0xac # ireturn
		as T_INT
			a.out ~= 0xac # ireturn
		as T_LONG
			a.out ~= 0xad # lreturn
	else
		a.out ~= 0xb0 # areturn
arraylength void(a code-builder)
	a.out ~= 0xbe
makenew void(a code-builder, class_ class-reference)
	a.out ~= 0xbb
	a.out ~~= class_
getfield void(a code-builder, field field-reference)
	a.out ~= 0xb4
	a.out ~~= field
pop void(a code-builder, type java-runtime-type)
	match type
	as void
		()
	as java-primitive-type p
		if p is-double-size
			a.out ~= 0x58 # pop2
		else
			a.out ~= 0x57 # pop
	else
		a.out ~= 0x57 # pop
putfield void(a code-builder, field field-reference)
	a.out ~= 0xb5
	a.out ~~= field
getstatic void(a code-builder, field field-reference)
	a.out ~= 0xb2
	a.out ~~= field
putstatic void(a code-builder, field field-reference)
	a.out ~= 0xb3
	a.out ~~= field
invokespecial void(a code-builder, ref method-reference)
	a.out ~= 0xb7
	a.out ~~= ref
invokestatic void(a code-builder, ref method-reference)
	a.out ~= 0xb8
	a.out ~~= ref
invokeinterface void(a code-builder, ref method-reference, count nat8)
	a.out ~= 0xb9
	a.out ~~= ref
	a.out ~= count
	a.out ~= 0
invokevirtual void(a code-builder, ref method-reference)
	a.out ~= 0xb6
	a.out ~~= ref
instanceof void(a code-builder, class_ class-reference)
	a.out ~= 0xc1
	a.out ~~= class_
if_acmpeq deferred-jump(a code-builder)
	jump-from = a.out next-index
	a.out ~= 0xa5 # if_acmpeq
	location-of-offset = a.out next-index
	a.out ~~= 0xffff::nat16
	jump-from.to, location-of-offset.to
ifeq deferred-jump(a code-builder)
	jump-from = a.out next-index
	a.out ~= 0x99 # ifeq
	location-of-offset = a.out next-index
	a.out ~~= 0xffff::nat16
	jump-from.to, location-of-offset.to
ifne deferred-jump(a code-builder)
	jump-from = a.out next-index
	a.out ~= 0x9a # ifne
	location-of-offset = a.out next-index
	a.out ~~= 0xffff::nat16
	jump-from.to, location-of-offset.to
ifne void(a code-builder, target jump-target)
	jump-from = a.out next-index
	a.out ~= 0x9a # ifne
	offset nat16 = jump-from.to - target.offset
	a.out ~~= -offset
if_icmpeq deferred-jump(a code-builder)
	jump-from = a.out next-index
	a.out ~= 0x9f # if_icmpeq
	location-of-offset = a.out next-index
	a.out ~~= 0xffff::nat16
	jump-from.to, location-of-offset.to
if_icmpne void(a code-builder, target jump-target)
	jump-from = a.out next-index
	a.out ~= 0xa0 # if_icmpne
	offset nat16 = jump-from.to - target.offset
	a.out ~~= -offset
ifnonnull deferred-jump(a code-builder)
	jump-from = a.out next-index
	a.out ~= 0xc7 # ifnonnull
	location-of-offset = a.out next-index
	a.out ~~= 0xffff::nat16
	jump-from.to, location-of-offset.to
nop void(a code-builder)
	a.out ~= 0

checkcast void(a code-builder, class_ class-reference)
	a.out ~= 0xc0
	a.out ~~= class_
newarray void(a code-builder, type java-primitive-type)
	a.out ~= 0xbc
	a.out ~= type to

java-runtime-type union(void, java-primitive-type, reference-type)
== bool(a java-runtime-type, b java-runtime-type)
stack-entry-count nat(a java-runtime-type)
	match a
	as void
		0
	as java-primitive-type p
		p.is-double-size ? 2 : 1
	as reference-type
		1
is-double-size bool(a java-runtime-type) # TODO: I should probably just use 'stack-entry-count' -----------------------------------
	match a
	as void
		throw unreachable
	as java-primitive-type p
		p is-double-size
	as reference-type
		false
void java-runtime-type()
	()::void
reference-type record
== bool(a reference-type, b reference-type) 
java-primitive-type enum nat8 storage
	T_BOOLEAN = 4
	T_CHAR = 5
	T_FLOAT = 6
	T_DOUBLE = 7
	T_BYTE = 8
	T_SHORT = 9
	T_INT = 10
	T_LONG = 11
== bool(a java-primitive-type, b java-primitive-type)
to nat8(a java-primitive-type)
is-double-size bool(a java-primitive-type)
	a == T_DOUBLE || a == T_LONG

anewarray void(a code-builder, class_ class-reference)
	a.out ~= 0xbd
	a.out ~~= class_
xaload void(a code-builder, type java-runtime-type)
	match type
	as void
		()
	as java-primitive-type p
		a.out ~= match p
		as T_BOOLEAN
			0x33 # baload
		as T_CHAR
			0x34 # caload
		as T_FLOAT
			0x30 # faload
		as T_DOUBLE
			0x31 # daload
		as T_BYTE
			0x33 # baload
		as T_SHORT
			0x35 # saload
		as T_INT
			0x2e # iaload
		as T_LONG
			0x2f # laload
	as reference-type
		a.out ~= 0x32 # aaload
astore void(a code-builder, type java-runtime-type)
	match type
	as void
		()
	as java-primitive-type p
		a.out ~= match p
		as T_BOOLEAN
			0x54 # bastore
		as T_CHAR
			0x55 # castore
		as T_FLOAT
			0x51 # fastore
		as T_DOUBLE
			0x52 # dastore
		as T_BYTE
			0x54 # bastore
		as T_SHORT
			0x56 # sastore
		as T_INT
			0x4f # iastore
		as T_LONG
			0x50 # lastore
	else
		a.out ~= 0x53 # aastore
iadd void(a code-builder)
	a.out ~= 0x60
ladd void(a code-builder)
	a.out ~= 0x61
lshl void(a code-builder)
	a.out ~= 0x79
lushr void(a code-builder)
	a.out ~= 0x7d
iand void(a code-builder)
	a.out ~= 0x7e
ior void(a code-builder)
	a.out ~= 0x80
ixor void(a code-builder)
	a.out ~= 0x82
land void(a code-builder)
	a.out ~= 0x7f
lor void(a code-builder)
	a.out ~= 0x81
i2b void(a code-builder)
	a.out ~= 0x91
i2s void(a code-builder)
	a.out ~= 0x93
lxor void(a code-builder)
	a.out ~= 0x83
d2f void(a code-builder)
	a.out ~= 0x90
f2d void(a code-builder)
	a.out ~= 0x8d
l2d void(a code-builder)
	a.out ~= 0x8a
i2l void(a code-builder)
	a.out ~= 0x85
d2l void(a code-builder)
	a.out ~= 0x8f
l2i void(a code-builder)
	a.out ~= 0x88

swap void(a code-builder)
	a.out ~= 0x5f

fadd void(a code-builder)
	a.out ~= 0x62
dadd void(a code-builder)
	a.out ~= 0x63
fsub void(a code-builder)
	a.out ~= 0x66
dsub void(a code-builder)
	a.out ~= 0x67
fdiv void(a code-builder)
	a.out ~= 0x6e
ddiv void(a code-builder)
	a.out ~= 0x6f
frem void(a code-builder)
	a.out ~= 0x72
drem void(a code-builder)
	a.out ~= 0x73
fmul void(a code-builder)
	a.out ~= 0x6a
dmul void(a code-builder)
	a.out ~= 0x6b
imul void(a code-builder)
	a.out ~= 0x68
lmul void(a code-builder)
	a.out ~= 0x69
ldiv void(a code-builder)
	a.out ~= 0x6d
isub void(a code-builder)
	a.out ~= 0x64
lsub void(a code-builder)
	a.out ~= 0x65
lcmp void(a code-builder)
	a.out ~= 0x94

jump-target record
	offset nat16
can-jump-back-to-here jump-target(a code-builder, stack-frame stack-frame)
	a set-stack-frame stack-frame
	a.next-index,
go-back-to void(a code-builder, where jump-target)
	assert where.offset < a.next-index
	offset int16 = where.offset.to - a.next-index.to
	a.out ~= 0xa7 # goto
	a.out ~~= offset
goto deferred-jump(a code-builder)
	jump-from = a next-index
	a.out ~= 0xa7 # goto
	location-of-offset = a next-index
	a.out ~~= 0xffff::nat16
	jump-from: jump-from
	location-of-offset: location-of-offset

xstore void(a code-builder, type java-runtime-type, index nat)
	match type
	as void
		()
	as java-primitive-type p
		match p
		as T_BOOLEAN
			a istore index
		as T_CHAR
			a istore index
		as T_FLOAT
			a fstore index
		as T_DOUBLE
			a dstore index
		as T_BYTE
			a istore index
		as T_SHORT
			a istore index
		as T_INT
			a istore index
		as T_LONG
			a lstore index
	else
		a astore index
astore void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x4b + index.to # astore_0, astore_1, astore_2, or astore_3
	else
		a.out ~= 0x3a # astore
		a.out ~= index to
-dstore void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x47 + index.to # dstore_0, dstore_1, dstore_2, or dstore_3
	else
		a.out ~= 0x39
		a.out ~= index to
-fstore void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x43 + index.to # fstore_0, fstore_1, fstore_2, or fstore_3
	else
		a.out ~= 0x38 # fstore
		a.out ~= index to
istore void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x3b + index.to # istore_0, istore_1, istore_2, or istore_3
	else
		a.out ~= 0x36 # istore
		a.out ~= index to
-lstore void(a code-builder, index nat)
	if index < 4
		a.out ~= 0x3f + index.to # lstore_0, lstore_1, lstore_2, or lstore_3
	else
		a.out ~= 0x37 # lstore
		a.out ~= index to

lookupswitch (deferred-jump32[], deferred-jump32)(a code-builder, values int32[])
	jump-from nat32 = a.out.next-index to
	a.out ~= 0xab # lookupswitch
	a pad-to-align 4
	location-of-default nat32 = a.out.next-index to
	a.out ~~= 0xffffffff::nat32
	a.out ~~= values.size.to::nat32
	jumps deferred-jump32[] = for value : values
		a.out ~~= value.wrap-to::nat32
		location-of-offset nat32 = a.out.next-index to
		a.out ~~= 0xffffffff::nat32
		jump-from, location-of-offset
	jumps, (jump-from, location-of-default)

tableswitch (deferred-jump32[], deferred-jump32)(a code-builder, range nat32 range) # TODO: just use same function as lookupswitch?
	forbid range is-empty
	jump-from nat32 = a.out.next-index to
	a.out ~= 0xaa # tableswitch
	a pad-to-align 4
	location-of-default nat32 = a.out.next-index to
	a.out ~~= 0xffffffff::nat32
	a.out ~~= range low
	a.out ~~= range.high - 1
	jumps deferred-jump32[] = for _ : range
		location-of-offset nat32 = a.out.next-index to
		a.out ~~= 0xffffffff::nat32
		jump-from, location-of-offset
	jumps, (jump-from, location-of-default)

-pad-to-align void(a code-builder, align nat)
	until a.out.next-index % align == 0
		a.out ~= 0

athrow void(a code-builder)
	a.out ~= 0xbf
