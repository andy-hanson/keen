import
	../../model/low-model
	../../model/model
	../../util/java-bytecode-types
	../../util/util
	../util
	./class-code-builder

# TODO: these should be in low-model.crow ... and work for all backends ---------------------------------------------------
bool low-type(a low-program)
	a.common-funs.low-common-funs-java!.bool
nat32 low-type(a low-program)
	a.common-funs.low-common-funs-java!.nat32
symbol low-type(a low-program)
	a.common-funs.low-common-funs-java!.symbol

class-and-member record(class_ symbol, member symbol)

java-constant-names record
	names class-and-member constant-names
	class-to-constants any-allocated-constant[][symbol]
subscript class-and-member(a java-constant-names, constant any-allocated-constant)
	a.names[constant]

max-constants-per-class nat()
	# Java allows 65535 constants, but large arrays include many individual constants, so use this as a limit that seems to work
	16

get-types-for-integrals low-type[integral-type](a low-program)
	res low-type mut[integral-type] = ()
	for struct in a.all-non-extern-types
		body = struct.body
		do if body.low-builtin-type
		do if i = body.kind.to::integral-type?
		forbid res[i]
		res[i] := struct
	res.move-to

as-runtime-type java-runtime-type(type low-type)
	if is-empty-type type
		void
	elif p = as-java-primitive-type type
		p
	else
		reference-type
as-java-primitive-type java-primitive-type?(type low-type)
	match x = type.body
	as low-builtin-type
		match x.kind
		as array
			if is-empty-type only! x.type-args
				T_INT
		as buffer
			if is-empty-type only! x.type-args
				T_INT
		as bool then T_BOOLEAN
		as char8 then T_BYTE
		as char32 then T_INT
		as float32 then T_FLOAT
		as float64 then T_DOUBLE
		as int8 then T_BYTE
		as int16 then T_SHORT
		as int32 then T_INT
		as int64 then T_LONG
		as nat8 then T_BYTE
		as nat16 then T_SHORT
		as nat32 then T_INT
		as nat64 then T_LONG
		else then ()
	as low-enum
		primitive-for-nat x.storage
	as low-flags
		primitive-for-nat x.storage
	as low-record
		if wrapped = as-wrapper x
			as-java-primitive-type wrapped.type
	else
		()

-primitive-for-nat java-primitive-type(type nat-type)
	match type
	as nat8 then T_BYTE
	as nat16 then T_SHORT
	as nat32 then T_INT
	as nat64 then T_LONG
