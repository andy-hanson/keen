import
	../../model/concrete-model
	../../model/model
	../../util/java-bytecode-types
	../../util/util
	../util
	./class-code-builder

# TODO: these should be in concrete-model.crow ... and work for all backends ---------------------------------------------------
bool concrete-type(a concrete-program)
	a.common-funs.concrete-common-funs-java! bool
nat32 concrete-type(a concrete-program)
	a.common-funs.concrete-common-funs-java! nat32
symbol concrete-type(a concrete-program)
	a.common-funs.concrete-common-funs-java! symbol

class-and-member record(class_ symbol, member symbol)

java-constant-names record
	names class-and-member constant-names
	class-to-constants any-constant[][symbol]
subscript class-and-member(a java-constant-names, constant any-constant)
	a.names[constant]

max-constants-per-class nat()
	# Java allows 65535 constants, but large arrays include many individual constants, so use this as a limit that seems to work
	16

get-types-for-integrals concrete-type[integral-type](a concrete-program)
	res concrete-type mut[integral-type] = ()
	for struct in a all-non-extern-types
		guard builtin_ = struct.body concrete-builtin-type
		guard i = builtin_.kind.to::integral-type?
		forbid res[i]
		res[i] := struct
	res move-to

as-runtime-type java-runtime-type(type concrete-type)
	if type is-empty-type
		void
	elif p = type as-java-primitive-type
		p
	else
		reference-type
as-java-primitive-type java-primitive-type?(type concrete-type)
	match x = type body
	as concrete-builtin-type
		match x kind
		as array
			if x.type-args.only is-empty-type
				T_INT
		as mut-slice
			if x.type-args.only is-empty-type
				T_INT
		as bool then T_BOOLEAN
		as char8 then T_BYTE
		as char32 then T_INT
		as float32 then T_FLOAT
		as float64 then T_DOUBLE
		as int8 then T_BYTE
		as int16 then T_SHORT
		as int32 then T_INT
		as int64 then T_LONG
		as nat8 then T_BYTE
		as nat16 then T_SHORT
		as nat32 then T_INT
		as nat64 then T_LONG
		else then ()
	as concrete-enum
		x.storage primitive-for-nat
	as concrete-flags
		x.storage primitive-for-nat
	as concrete-record
		if wrapped = x as-wrapper
			wrapped.type as-java-primitive-type
	else
		()

-primitive-for-nat java-primitive-type(type nat-type)
	match type
	as nat8 then T_BYTE
	as nat16 then T_SHORT
	as nat32 then T_INT
	as nat64 then T_LONG
