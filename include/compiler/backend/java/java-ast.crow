java-ast record
	classes java-class-decl[]

java-class-decl record
	name java-class-name
	constructor (java-param[], java-block-statement)

java-class-name record(name string)
java-method-name record(name string)

java-param record
	name string
	type java-type

java-type union(string, java-array)
java-array record(inner java-type)

java-block-statement record(statements java-statement[])

java-statement union(
	java-return-statement
)

java-return-statement record(returned java-expr)

java-expr union(java-static-call-expr)

java-static-call-expr record(
	called-class java-class-name,
	called-method java-method-name,
	args java-expr[]
)
