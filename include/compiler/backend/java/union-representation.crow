use-prefix
import
	../../frontend/show-model
	../../model/concrete-model
	../../model/model
	../../model/show-concrete-model
	../util

union-representation enum
	| Reserved for exceptions (java/lang/Throwable)
	# TODO: WHY? Now that I support Java types this should not need to be special --------------------------------------------------------------
	exception
	sealed-interface # TODO: it will actually not always be sealed, so just rename this to 'interface' ---------------------------------
	| Use a 'new Union(i, x)' where 'i' is the index of the case type
	switch
	| The union has 2 case types, and the first is empty. Use 'null' for the first case.
	nullable
== bool(a union-representation, b union-representation)
to json(a union-representation)

union-info record
	show-ctx show-ctx # RM --------------------------------------------------------------------------------------------------------
	union-to-representation union-representation[concrete-type]
	type-to-interfaces concrete-type[][concrete-type]
	exception-case-types concrete-type set
plan-unions union-info(show-ctx show-ctx, program concrete-program)
	union-to-representation union-representation mut[concrete-type] = ()
	type-to-interfaces concrete-type mut[] mut[concrete-type] = ()
	for s in program.all-types-including-extern
		guard u = concrete-union s.body
		is-interface bool = as-extern s or
			r = choose-union-representation program, s, u
			union-to-representation[s] := r
			r == sealed-interface
		if is-interface
			for member in u.members
				(ensure type-to-interfaces, member) ~= s
	show-ctx: show-ctx
	union-to-representation: union-to-representation.move-to
	type-to-interfaces: for k, v in type-to-interfaces
		k, v.move-to
	exception-case-types: program.exception.body.concrete-union!.members.to

union-representation union-representation(a union-info, type concrete-type)
	a.union-to-representation[type] else
		if as-extern type
			sealed-interface
		else
			log error, "Trying to get union-representation for {show-concrete-type a.show-ctx, type}" # RM ----------------------------------------
			throw todo

java-method-kind java-method-kind(a union-info, fun concrete-fun)
	match body = body fun
	as concrete-fun-body-method
		match union-representation a, fun.params[0].type
		as exception
			static-method-of-class
		as sealed-interface
			interface_
		as switch
			static-method-of-class
		as nullable
			static-method-of-class
	as fun-body-extern-java
		kind body
	else
		static-method-of-class

-choose-union-representation union-representation(program concrete-program, type concrete-type, u concrete-union)
	if type == program.exception
		exception
	elif u.is-nullable-union
		nullable
	elif every u.members, it.can-implement-interface
		sealed-interface
	else
		switch

-is-nullable-union bool(type concrete-type)
	body = type.body
	concrete-union body and is-nullable-union body
-is-nullable-union bool(u concrete-union)
	members = u.members
	guard members.size == 2
	guard members[0].is-empty-type
	non-null = members[1]
	!is-empty-type non-null and !is-nullable-union non-null

-can-implement-interface bool(a concrete-type)
	match a.body
	# TODO: concrete-builtin-types could implement interfaces, we generate a class for them instead of using Java's
	as concrete-builtin-type then false
	as concrete-enum then true
	as struct-body-extern-java then false
	as concrete-flags then true
	as concrete-record then true
	# TODO: This could be allowed in some cases.
	# Just not out for 'union(u1, u2)' where u1 and u2 are unions that have some members in common.
	as concrete-union then false
	as concrete-type-body-deferred then throw unreachable
