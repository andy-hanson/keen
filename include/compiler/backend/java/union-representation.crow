import
	../../model/concrete-model
	./util

union-representation enum
	| This should only be used for exception
	direct
	sealed-interface
	| Use a 'new Union(i, x)' where 'i' is the index of the case type
	switch
	| The union has 2 case types, and the first is empty. Use 'null' for the first case.
	nullable
== bool(a union-representation, b union-representation)
to symbol(a union-representation)
show string(a union-representation)
	a.to::symbol to
to json(a union-representation)

union-info record
	union-to-representation union-representation[concrete-type]
	type-to-interfaces concrete-type[][concrete-type]
	exception-case-types concrete-type set
plan-unions union-info(program concrete-program )
	union-to-representation union-representation mut[concrete-type] = ()
	type-to-interfaces concrete-type mut[] mut[concrete-type] = ()
	for s : program all-structs
		if u ?= s.body concrete-union
			r = program choose-union-representation s, u
			union-to-representation[s] := r
			if r == sealed-interface
				for member : u members
					type-to-interfaces ensure member ~= s
	union-to-representation: union-to-representation move-to
	type-to-interfaces: for k, v : type-to-interfaces
		k, v.move-to
	exception-case-types: program.exception.body.concrete-union!.members to

-choose-union-representation union-representation(program concrete-program, union_ concrete-type, u concrete-union)
	members = u members
	members-set concrete-type set = members to
	if union_ == program.exception
		direct
	elif members-set.size != members.size
		# Union has duplicate members, so can't use 'instanceof' to distinguish (TODO: does this ever happen? -----------------------------------)
		switch
	elif program.string in members-set && program.symbol in members-set
		# These also can't be distinguished since they both compile to 'java.lang.String'
		members.size <= 4 ? direct : switch
	elif members.size == 2 && members[0] is-empty-type && program !is-nullable-union members[1]
		nullable
	elif members exists x => x is-union
		# TODO: Unions that compile to interfaces can implement interfaces too... but we need to check for overlap .......................
		switch
	elif members every x => x can-implement-interface
		sealed-interface
	elif members.size > 4
		# It's slow to use a long sequence of 'instanceof' tests
		switch
	else
		direct

-is-nullable-union bool(program concrete-program, type concrete-type)
	guard u ?= type.body concrete-union
	(program choose-union-representation type, u) == nullable
-is-union bool(a concrete-type)
	a.body.concrete-union !is-empty

-can-implement-interface bool(a concrete-type)
	match a body
	as concrete-builtin-type _
		false # TODO: I guess 'nat' could ----------------------------------------------------------------------------------
	as concrete-enum _
		true
	as concrete-flags _
		true
	as concrete-record _
		true
	as concrete-union _
		false
	as concrete-type-body-deferred
		throw unreachable
