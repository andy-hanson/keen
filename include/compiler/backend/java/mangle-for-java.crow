import
	../../frontend/show-model
	../../model/concrete-model
	../../model/model
	../../model/uri
	../../util/sym
	../mangle

java-mangled-names record
	-show-ctx show-ctx # RM --------------------------------------------------------------------------------------------------------
	-var-to-name string[concrete-var]
	-module-to-class-name string[uri]
	-fun-to-name string[concrete-fun]
	-struct-to-name string[concrete-struct]

build-mangled-names java-mangled-names(show-ctx show-ctx, program concrete-program) # TODO: UNUSED? ------------------------------------------------
	var-to-name string[concrete-var] = for x : program all-vars
		x, "v{x get-hash}" # TODO: include the name in it -------------------------------------------------------------------------------------
	module-to-class-name string mut[uri] = ()
	# TODO: do something fancier -------------------------------------------------------------------------------------------------
	fun-to-name string[concrete-fun] = for fun : program all-funs
		module-to-class-name add-module-name fun.module-uri
		base-name string = match fun source
		as concrete-fun-source-regular x
			x.decl.name.to mangle-name-common
		as concrete-fun-source-lambda _
			"lambda"
		as concrete-fun-source-test _
			"test"
		as concrete-fun-source-wrap-main _
			"main"
		fun, "{base-name}{fun hash}"
	struct-to-name string[concrete-struct] = for type : program all-structs
		base-name string = match type source
		as concrete-struct-source-bogus
			"bogus"
		as concrete-struct-source-inst x
			x.decl.name.to mangle-name-common
		as concrete-struct-source-lambda _
			"lambda"
		type, "{base-name}{type hash}"
	show-ctx, var-to-name, module-to-class-name.move-to, fun-to-name, struct-to-name

-add-module-name void(a string mut[uri], uri uri)
	_ = a ensure uri, () =>
		"{uri.base-name mangle-name-common}{a size}"

class-and-member record(class_ string, member string)
to json(a class-and-member)
show string(a class-and-member)
	"{a class_}.{a member}"

subscript string(a java-mangled-names, uri uri)
	a.module-to-class-name[uri]!
subscript class-and-member(a java-mangled-names, var concrete-var)
	a[var module-uri], a.var-to-name[var]!
subscript class-and-member(a java-mangled-names, fun concrete-fun)
	a[fun module-uri], a.fun-to-name[fun]!
subscript string(a java-mangled-names, struct concrete-struct)
	a.struct-to-name[struct]!

lambda-name string(a java-mangled-names, containing-fun concrete-fun, lambda-index nat)
	"{a[containing-fun module-uri]}_{a.fun-to-name[containing-fun]!}_lambda{lambda-index}"

case-index-method-name string(a java-mangled-names, struct concrete-struct)
	"{a[struct]}_index"

instance-method-name symbol(a java-mangled-names, fun concrete-fun)
	res = fun.source.concrete-fun-source-regular!.decl name
	if res == sym-show # TODO: also check that it has no params and returns void ----------------------------------------------
		"toString"
	else
		"{a[fun.params[0].type struct]}_{res}"
