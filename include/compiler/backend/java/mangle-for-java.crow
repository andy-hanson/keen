import
	../../frontend/show-model
	../../model/concrete-model
	../../model/show-concrete-model
	../../model/model
	../../model/uri

java-mangled-names record
	-show-ctx show-ctx # RM --------------------------------------------------------------------------------------------------------
	-var-to-name string[concrete-var]
	-module-to-class-name string[uri]
	-fun-to-name string[concrete-fun]
	-type-to-name string[concrete-type]

build-mangled-names java-mangled-names(show-ctx show-ctx, program concrete-program) # TODO: UNUSED? ------------------------------------------------
	module-to-class-name string mut[uri] = ()
	type-to-name string[concrete-type] = for type : program all-structs
		# TODO: if there is only 1 struct with the name (globally), just use the decl name
		type, (module-to-class-name gen-type-name type)
	fun-to-name string[concrete-fun] = for fun : program all-funs
		_ = module-to-class-name add-module-name fun.module-uri
		fun, match fun source
		as concrete-fun-source-regular x
			base = x.decl.name do-mangle
			module = program.model-program module-at-uri fun.module-uri
			if x.decl !is-template && (module.funs count f => f.name == x.decl.name) == 1 # TODO:PERF module should store funs-by-name (a multi-by-name)
				base
			else
				"{base}{fun hash}"
		as concrete-fun-source-test _
			"$test{fun hash}"
		as concrete-fun-source-wrap-main _
			"$wrap-main"
	var-to-name string[concrete-var] = for x : program all-vars
		x, "{x.source.name do-mangle}{x get-hash}" # TODO: If only one var of this name in the module, no need to include the hash
	show-ctx, var-to-name, module-to-class-name.move-to, fun-to-name, type-to-name

-gen-type-name string(module-to-class-name string mut[uri], a concrete-type)
	match a source
	as concrete-type-source-bogus
		"$bogus{a hash}"
	as concrete-type-source-inst x
		base string = "{module-to-class-name add-module-name x.decl.module-uri}{x.decl.name do-mangle}"
		type-args string = 	"" join for arg : x type-args
			"_{module-to-class-name gen-type-name arg}"
		"{base}{type-args}"

-do-mangle string(a symbol)
	# Only a few names are not allowed in the JVM:
	# https://docs.oracle.com/javase/specs/jvms/se23/html/jvms-4.html#jvms-4.2
	match a
	as "<"
		"$less"
	as ">"
		"$greater"
	as "<="
		"$less-or-equal"
	as ">="
		"$greater-or-equal"
	as "<=>"
		"$compare"
	as ".."
		"$range"
	as "/"
		"$divide"
	as "<<"
		"$shift-left"
	as ">>"
		"$shift-right"
	else
		a to

-add-module-name string(a string mut[uri], uri uri)
	a ensure uri, () =>
		base-name = uri base-name
		name = base-name try-remove-end! (base-name ends-with ".json" ? ".json" : ".crow")
		"{name}{a size}"

class-and-member record(class_ string, member string)
to json(a class-and-member)
show string(a class-and-member)
	"{a class_}.{a member}"

subscript string(a java-mangled-names, uri uri)
	a.module-to-class-name[uri]!
subscript class-and-member(a java-mangled-names, var concrete-var)
	a[var module-uri], a.var-to-name[var]!
subscript class-and-member(a java-mangled-names, fun concrete-fun)
	# should always have it ----------------------------------------------------------------------------------------------------------
	if _ ?= a.fun-to-name[fun]
		a[fun module-uri], a.fun-to-name[fun]!
	else
		error log "Looking for fun {a.show-ctx show-concrete-fun-sig fun, false}"
		"ERROR", "ERROR"
subscript string(a java-mangled-names, type concrete-type)
	a.type-to-name[type]!

lambda-name string(a java-mangled-names, containing-fun concrete-fun, lambda-index nat)
	"{a[containing-fun module-uri]}_{a.fun-to-name[containing-fun]!}_lambda{lambda-index}"

case-index-method-name string(a java-mangled-names, struct concrete-type)
	"{a[struct]}_index"

instance-method-name symbol(a java-mangled-names, fun concrete-fun)
	res = fun.source.concrete-fun-source-regular!.decl name
	if res == "show" # TODO: also check that it has no params and returns void ----------------------------------------------
		"toString"
	else
		"{a[fun.params[0].type]}_{res}"
