import
	../../frontend/show-model
	../../model/concrete-model
	../../model/model
	../../model/uri
	../../util/util
	./class-builder
	./class-code-builder
	./union-representation
	./util

java-mangled-names record
	-show-ctx show-ctx # RM --------------------------------------------------------------------------------------------------------
	-var-to-name symbol[concrete-var]
	-module-to-class-name symbol[uri]
	-fun-to-name symbol[concrete-fun]
	-type-to-name symbol[concrete-type]
	-type-to-descriptor symbol[concrete-type]
	-type-to-boxed-class-name symbol[concrete-type]
	program concrete-program # TODO: RM, this should only be used when building it ---------------------------------------------------
	union-info union-info # TODO: RM, this should only be used when building it ---------------------------------------------------
	constant-names constant-names

mangled-names-with-constants record mut
	mangled-names java-mangled-names
	constants constants-builder
union-info union-info(a mangled-names-with-constants)
	a.mangled-names union-info

build-mangled-names java-mangled-names
	show-ctx show-ctx
	program concrete-program
	union-info union-info
do
	module-to-class-name symbol mut[uri] = ()
	type-to-name symbol[concrete-type] = for type : program all-structs
		# TODO: if there is only 1 struct with the name (globally), just use the decl name ----------------------------------
		type, do module-to-class-name gen-type-name type
	fun-to-name symbol[concrete-fun] = for fun : program all-funs
		_ = module-to-class-name add-module-name fun.module-uri
		fun, match fun source
		as concrete-fun-source-regular x
			base = x.decl.name do-mangle
			module = program.model-program module-at-uri fun.module-uri
			if x.decl !is-template && (module.funs count f => f.name == x.decl.name) == 1 # TODO:PERF module should store funs-by-name (a multi-by-name)
				base
			else
				"{base}{fun hash}"
		as concrete-fun-source-test _
			"$test{fun hash}"
		as concrete-fun-source-wrap-main _
			"$wrap-main"
	show-ctx: show-ctx
	var-to-name: for x : program all-vars
		x, "{x.source.name do-mangle}{x get-hash}" # TODO: If only one var of this name in the module, no need to include the hash
	module-to-class-name: module-to-class-name move-to
	fun-to-name: fun-to-name
	type-to-name: type-to-name
	type-to-descriptor: for type : program all-structs
		type, do (program, union-info, type-to-name) generate-descriptor-for-return-type type
	type-to-boxed-class-name: for type : program all-structs
		type, do (program, union-info, type-to-name) generate-boxed-class-name type
	program: program
	union-info: union-info
	constant-names: show-ctx get-constant-names program

-get-constant-names constant-names(show-ctx show-ctx, program concrete-program)
	# Since class files can't get too big, we must break up constants between several classes.
	constant-array-names class-and-member mut[nat] mut[concrete-type] = ()
	constant-record-names class-and-member mut[constant-record] mut[concrete-type] = ()
	cur-class-index mut nat = 0
	cur-class-name mut symbol = "_constants{cur-class-index}"
	field-index mut nat = 0
	cur-class-constants any-constant mut[] = ()
	class-to-constants any-constant[] mut[symbol] = ()

	show-ctx each-constant-in-dependency-order program, constant =>
		forbid constant.type is-empty-type
		if field-index >= max-constants-per-class
			class-to-constants[cur-class-name] := cur-class-constants.move-to
			cur-class-index +:= 1
			cur-class-name := "_constants{cur-class-index}"
			field-index := 0
		class-and-member class-and-member = cur-class-name, "x{field-index}"
		ok = match constant
		as single-constant-array x
			forbid x.element-type is-empty-type
			(constant-array-names ensure constant.type)[x index] := class-and-member
			true
		as single-constant-record x
			forbid x.record-type is-empty-type
			forbid x.record-type is-wrapper
			(constant-record-names ensure constant.type)[x constant] := class-and-member
			true
		as single-constant-union _
			# TODO: remove union from any-constant once I've removed the old translate-to-java ------------------------------------------------
			# Since the union member can just upcast to the union, no need to have a field for this
			false
		if ok
			field-index +:= 1
			cur-class-constants ~= constant

	unless cur-class-constants is-empty
		class-to-constants[cur-class-name] := cur-class-constants.move-to

	arrays: for k, v : constant-array-names
		k, v.move-to
	records: for k, v : constant-record-names
		k, v.move-to
	unions: ()
	class-to-constants: class-to-constants to

constant-name utf8-reference(a mangled-names-with-constants, constant any-constant)
	a.constants[a.mangled-names.constant-names[constant] member]

constant-symbols-class-name symbol()
	"_constant_symbols"
constant-symbols-class class-reference(a mangled-names-with-constants)
	a.constants class_ "_constant_symbols"
constant-symbol-name utf8-reference(a mangled-names-with-constants, index nat)
	a.constants["s{index}"]

constant-symbol-field field-reference(a mangled-names-with-constants, symbol concrete-type, index nat)
	symbol-type = a.constants[a.mangled-names descriptor-for-field-type symbol]
	name-and-type = a.constants name-and-type (a constant-symbol-name index), symbol-type
	a.constants field a.constant-symbols-class, name-and-type

-gen-type-name symbol(module-to-class-name symbol mut[uri], a concrete-type)
	match a source
	as concrete-type-source-bogus
		"$bogus{a hash}"
	as concrete-type-source-inst x
		base string = "{module-to-class-name add-module-name x.decl.module-uri}{x.decl.name do-mangle}"
		type-args string = 	"" join for arg : x type-args
			"_{module-to-class-name gen-type-name arg}"
		"{base}{type-args}"

-do-mangle symbol(a symbol)
	# Only a few names are not allowed in the JVM:
	# https://docs.oracle.com/javase/specs/jvms/se23/html/jvms-4.html#jvms-4.2
	match a
	as "<"
		"$less"
	as ">"
		"$greater"
	as "<="
		"$less-or-equal"
	as ">="
		"$greater-or-equal"
	as "<=>"
		"$compare"
	as ".."
		"$range"
	as "/"
		"$divide"
	as "<<"
		"$shift-left"
	as ">>"
		"$shift-right"
	else
		a

-add-module-name symbol(a symbol mut[uri], uri uri)
	a ensure uri, () =>
		base-name = uri base-name
		name = base-name try-remove-end! (base-name ends-with ".json" ? ".json" : ".crow")
		"{name}{a size}"

module-class class-reference(a mangled-names-with-constants, uri uri)
	a.constants class_ do a.mangled-names module-class-name uri
module-class-name symbol(a mangled-names-with-constants, uri uri)
	a.mangled-names module-class-name uri
module-class-name symbol(a java-mangled-names, uri uri)
	a.module-to-class-name[uri]!
subscript class-and-member(a java-mangled-names, var concrete-var)
	(a module-class-name var.module-uri), a.var-to-name[var]!
subscript class-and-member(a java-mangled-names, fun concrete-fun)
	(a module-class-name fun.module-uri), a.fun-to-name[fun]!
-subscript symbol(a java-mangled-names, type concrete-type)
	a.type-to-name[type]!

lambda-impl-class-name symbol(a java-mangled-names, containing-fun concrete-fun, lambda-index nat)
	"{a module-class-name containing-fun.module-uri}_{a.fun-to-name[containing-fun]!}_lambda{lambda-index}"

# Static "instance" field on a singleton class
instance-field field-reference(a mangled-names-with-constants, type concrete-type)
	a instance-field (a class_ type), do a.mangled-names boxed-class-name type
instance-field field-reference(a mangled-names-with-constants, class_ class-reference, class-name symbol)
	name-and-type = a.constants name-and-type "instance", "L{class-name};"
	a.constants field class_, name-and-type

lambda-impl-field field-reference
	a mangled-names-with-constants
	lambda-class class-reference
	closure-local concrete-local
do
	name-and-type = a.constants name-and-type (a lambda-impl-field-name closure-local), do
		a descriptor-for-field-type closure-local.type
	a.constants field lambda-class, name-and-type

lambda-impl-field-name utf8-reference(a mangled-names-with-constants, closure-field concrete-local)
	match closure-field source
	as local x
		a.constants[x name]
	as concrete-local-source-reference x
		a.constants[x.original name]
	as concrete-generated-local-kind _
		throw unreachable

switchable-kind-field field-reference(a mangled-names-with-constants, union-type concrete-type)
	a.union-info union-representation union-type is switch
	a switchable-kind-field do a class_ union-type
switchable-kind-field field-reference(a mangled-names-with-constants, sum-type class-reference)
	a.constants field sum-type, do a.constants name-and-type a.switchable-kind-name, a.switchable-kind-descriptor
switchable-kind-name utf8-reference(a mangled-names-with-constants)
	a.constants["kind"]
switchable-kind-descriptor utf8-reference(a mangled-names-with-constants)
	a.constants["I"]
switchable-value-field field-reference(a mangled-names-with-constants, sum-type concrete-type)
	a.union-info union-representation sum-type is switch
	a switchable-value-field do a class_ sum-type
switchable-value-field field-reference(a mangled-names-with-constants, sum-type class-reference)
	a.constants field sum-type, do a.constants name-and-type a.value, a.java-Object-descriptor

class_ class-reference(a mangled-names-with-constants, type concrete-type)
	a.constants class_ do a.mangled-names boxed-class-name type	
class-name symbol(a mangled-names-with-constants, type concrete-type)
	a.mangled-names[type]

case-index-method method-reference(a mangled-names-with-constants, union-type concrete-type)
	a.constants interface-method-ref (a class_ union-type), do
		a.constants name-and-type (a case-index-method-name union-type), a.case-index-method-descriptor

case-index-method-descriptor utf8-reference(a mangled-names-with-constants)
	a.constants["()I"]

case-index-method-name utf8-reference(a mangled-names-with-constants, sum-type concrete-type)
	a.constants["{a.mangled-names[sum-type]}_index"]

crow-call-instance method-reference(a mangled-names-with-constants, n-args nat)
	descriptor string = with out : build
		out ~= "("
		for index : 0 .. n-args
			out ~~= index == 1 ? string-descriptor : "Ljava/lang/Object;"
		out ~~= ")Ljava/lang/Object;"
	a crow-method "callInstance", descriptor.to

crow-call-static method-reference(a mangled-names-with-constants, n-args nat)
	descriptor string = with d : build
		d ~= "("
		for index : 0 .. n-args
			d ~~= index < 2 ? string-descriptor : "Ljava/lang/Object;"
		d ~~= ")Ljava/lang/Object;"
	a crow-method "callStatic", descriptor.to

crow-call-static-varargs method-reference(a mangled-names-with-constants)
	a crow-method "callStaticVarargs", "({string-descriptor}{string-descriptor}[Ljava/lang/Object;)Ljava/lang/Object;"

crow-get-exclusion method-reference(a mangled-names-with-constants)
	a crow-method "getExclusion", "()L{exclusion-class};"
crow-change-exclusion method-reference(a mangled-names-with-constants)
	a crow-method "changeExclusion", "(L{exclusion-class};)V"
crow-reference-equal method-reference(a mangled-names-with-constants)
	a crow-method "referenceEqual", "(Ljava/lang/Object;Ljava/lang/Object;)Z"
crow-get-static-field method-reference(a mangled-names-with-constants)
	a crow-method "getStaticField", "({string-descriptor}{string-descriptor})Ljava/lang/Object;"

arrays-copy-of-range-for-primitive method-reference(a mangled-names-with-constants, p java-primitive-type)
	a.constants method-ref "java/util/Arrays", "copyOfRange", "([{p primitive-descriptor}II)[{p primitive-descriptor}"
arrays-copy-of-range-for-object method-reference(a mangled-names-with-constants)
	a.constants method-ref "java/util/Arrays", "copyOfRange", "([Ljava/lang/Object;II)[Ljava/lang/Object;"

-string-descriptor string() # TODO: INLINE? _----------------------------------------------------------------------------------------
	"[B"

extern-instance-method method-reference
	a mangled-names-with-constants
	method-name symbol
	return-type concrete-type
	object-type concrete-type
	param-types concrete-type[]
do
	descriptor string = with out : build
		out ~= "("
		for x : param-types
			out ~~= a.mangled-names descriptor-for-param-type x
		out ~= ")"
		out ~~= a.mangled-names descriptor-for-return-type return-type
	a.constants method-ref (a class_ object-type), method-name, descriptor.to

extern-constructor method-reference(a mangled-names-with-constants, class_ class-reference, param-types concrete-type[])
	descriptor string = with out : build
		out ~= "("
		for x : param-types
			out ~~= a.mangled-names descriptor-for-param-type x
		out ~~= ")V"
	a.constants method-ref class_, do a.constants name-and-type "<init>", descriptor.to

crow-call-new method-reference(a mangled-names-with-constants, n-params nat)
	descriptor string = with out : build
		out ~= "("
		for index : 0 .. n-params
			out ~~= index == 0 ? string-descriptor : "Ljava/lang/Object;"
		out ~~= ")Ljava/lang/Object;"
	a crow-method "callNew", descriptor.to

valueOf utf8-reference(a mangled-names-with-constants)
	a.constants["valueOf"]
boxed-class-valueOf-descriptor utf8-reference(a mangled-names-with-constants, type concrete-type)
	param = a.mangled-names descriptor-for-param-type type
	return = a.mangled-names boxed-class-name type
	a.constants["({param})L{return};"]
boxed-class-valueOf method-reference(a mangled-names-with-constants, type concrete-type)
	a.constants method-ref (a class_ type), a.constants["valueOf"], do a boxed-class-valueOf-descriptor type
primitive-unboxer method-reference(a mangled-names-with-constants, type concrete-type, p java-primitive-type)
	a.constants method-ref (a class_ type), (a primitive-getter-name p), (a primitive-getter-descriptor p)
primitive-getter-name utf8-reference(a mangled-names-with-constants, type java-primitive-type)
	name symbol = match type
	as T_BOOLEAN
		"booleanValue"
	as T_CHAR
		throw todo
	as T_FLOAT
		"floatValue"
	as T_DOUBLE
		"doubleValue"
	as T_BYTE
		"byteValue"
	as T_SHORT
		"shortValue"
	as T_INT
		"intValue"
	as T_LONG
		"longValue"
	a.constants[name]
primitive-getter-descriptor utf8-reference(a mangled-names-with-constants, type java-primitive-type)
	a.constants["(){type primitive-descriptor}"]

array-copy method-reference(a mangled-names-with-constants)
	a.constants method-ref "java/lang/System", "arraycopy", "(Ljava/lang/Object;ILjava/lang/Object;II)V"

extern-static-method method-reference
	a mangled-names-with-constants
	class-name symbol
	method-name symbol
	return-type concrete-type
	param-types concrete-type[]
do
	descriptor string = if class-name == "java/lang/System" && method-name == "arraycopy"
		# HAX: In this case we need to specify the type as Object and not an array type. A Java compiler would do this upcast implicitly.
		"(Ljava/lang/Object;ILjava/lang/Object;II)V"
	else
		with out : build
			out ~= "("
			for x : param-types
				out ~~= a.mangled-names descriptor-for-param-type x
			out ~= ")"
			out ~~= a.mangled-names descriptor-for-return-type return-type
	a.constants method-ref class-name, method-name, descriptor.to

interface-method-ref method-reference(a mangled-names-with-constants, fun concrete-fun)
	a.union-info java-method-representation fun is instance
	class_ = a class_ fun.params[0].type
	a.constants interface-method-ref class_, do a.constants name-and-type (a instance-method-name fun), (a instance-method-descriptor fun)

instance-method-name utf8-reference(a mangled-names-with-constants, fun concrete-fun)
	a.constants[a.mangled-names instance-method-name fun]
-instance-method-name symbol(a java-mangled-names, fun concrete-fun)
	res = fun.source.concrete-fun-source-regular!.decl name
	if res == "show" # TODO: also check that it has no params and returns void ----------------------------------------------
		"toString"
	else
		"{a[fun.params[0].type]}_{res}"

fun-name utf8-reference(a mangled-names-with-constants, fun concrete-fun)
	a.constants[a.mangled-names[fun] member]
static-method-ref method-reference(a mangled-names-with-constants, fun concrete-fun)
	a.union-info java-method-representation fun is static
	m = a.mangled-names[fun]
	a.constants method-ref (a.constants class_  m.class_), a.constants[m.member], do a static-method-descriptor fun
static-method-descriptor utf8-reference(a mangled-names-with-constants, fun concrete-fun)
	a.constants[a.mangled-names static-method-descriptor fun]
-static-method-descriptor symbol(a java-mangled-names, fun concrete-fun)
	a.union-info java-method-representation fun is static
	res string = with out : build
		out ~= "("
		for param : fun params
			out ~~= a descriptor-for-param-type param.type
		out ~= ")"
		out ~~= a descriptor-for-return-type fun.return-type
	res to

instance-method-descriptor utf8-reference(a mangled-names-with-constants, fun concrete-fun)
	a.union-info java-method-representation fun is instance
	a.constants[a.mangled-names instance-method-descriptor fun]
-instance-method-descriptor symbol(a java-mangled-names, fun concrete-fun)
	assert (a.union-info java-method-representation fun) == instance
	res string = with d : build # TODO: support building symbols -------------------------------------------------------------
		d ~= "("
		for param : fun.params[1 .. end]
			d ~~= a descriptor-for-param-type param.type
		d ~= ")"
		d ~~= a descriptor-for-return-type fun.return-type
	res to

boxed-class-init method-reference(a mangled-names-with-constants, type concrete-type)
	a.constants method-ref (a class_ type), a.init, do a boxed-class-init-descriptor type
boxed-class-init-descriptor utf8-reference(a mangled-names-with-constants, type concrete-type)
	a.constants["({a.mangled-names descriptor-for-param-type type})V"]
boxed-class-value field-reference(a mangled-names-with-constants, type concrete-type)
	a.constants field (a class_ type), do a.constants name-and-type a.constants["value"], do a descriptor-for-field-type type

record-init-descriptor utf8-reference(a mangled-names-with-constants, fields concrete-field[])
	a.constants[a.mangled-names record-init-descriptor fields]
-record-init-descriptor symbol(a java-mangled-names, fields concrete-field[])
	res string = with out : build
		out ~= "("
		for field : fields
			out ~~= a descriptor-for-param-type field.type
		out ~~= ")V"
	res to

record-init-reference method-reference(a mangled-names-with-constants, record_ concrete-type)
	descriptor = a record-init-descriptor record_.body.concrete-record!.fields
	name-and-type = a.constants name-and-type a.constants["<init>"], descriptor
	a.constants method-ref (a class_ record_), name-and-type

record-field field-reference(a mangled-names-with-constants, record_ concrete-type, field concrete-field)
	a field (a.mangled-names[record_], field.debug-name), field.type
record-field-name utf8-reference(a mangled-names-with-constants, field concrete-field)
	a.constants[field debug-name]
record-field-descriptor utf8-reference(a mangled-names-with-constants, field concrete-field)
	a descriptor-for-field-type field.type

lambda-init-reference method-reference(a mangled-names-with-constants, class_ class-reference, lambda lambda-concrete-expr)
	a.constants method-ref class_, a.constants["<init>"], do a lambda-init-descriptor lambda
lambda-init-descriptor utf8-reference(a mangled-names-with-constants, lambda lambda-concrete-expr)
	a.constants[a.mangled-names lambda-init-descriptor lambda]
-lambda-init-descriptor symbol(a java-mangled-names, lambda lambda-concrete-expr)
	res string = with out : build
		out ~= "("
		for x : lambda closure
			out ~~= a descriptor-for-param-type x.type
		out ~~= ")V"
	res to

lambda-call method-reference(a mangled-names-with-constants, lambda-type concrete-type)
	lambda-class = a class_ lambda-type
	a.constants method-ref lambda-class, a.constants["call"], do a lambda-call-descriptor lambda-type
lambda-call-descriptor utf8-reference(a mangled-names-with-constants, lambda-type concrete-type)
	a.constants[a.mangled-names lambda-call-descriptor lambda-type]
-lambda-call-descriptor symbol(a java-mangled-names, lambda-type concrete-type)
	builtin_ = lambda-type.body.concrete-builtin-type!
	assert builtin_.kind is-lambda-type
	return-type, param-type = builtin_.type-args only2
	"({a descriptor-for-param-type param-type}){a descriptor-for-return-type return-type}"

descriptor-for-field-type utf8-reference(a mangled-names-with-constants, type concrete-type)
	a.constants[a.mangled-names descriptor-for-field-type type]
-descriptor-for-field-type symbol(a java-mangled-names, type concrete-type)
	forbid type is-empty-type
	a descriptor-for-return-type type to
-descriptor-for-param-type string(a java-mangled-names, type concrete-type)
	unless type is-empty-type
		a descriptor-for-return-type type
-generate-descriptor-for-param-type string(ctx gen-ctx, type concrete-type)
	unless type is-empty-type
		ctx generate-descriptor-for-return-type type to
-descriptor-for-return-type string(a java-mangled-names, type concrete-type)
	a.type-to-descriptor[type]! to
-generate-descriptor-for-return-type symbol(ctx gen-ctx, type concrete-type)
	match type as-runtime-type
	as void
		"V"
	as java-primitive-type p
		p.primitive-descriptor to
	as reference-type
		if type is-array-or-mut-array || (type is-option && type.unwrap-option-type is-array-or-mut-array)
			array = type is-option ? type.unwrap-option-type : type
			"[{ctx generate-descriptor-for-return-type array.array-element-type}"
		elif field ?= type as-wrapper
			ctx generate-descriptor-for-return-type field.type
		else
			"L{ctx generate-boxed-class-name type};"

primitive-descriptor utf8-reference(a mangled-names-with-constants, type java-primitive-type)
	a.constants[type primitive-descriptor]
-primitive-descriptor symbol(a java-primitive-type)
	match a
	as T_BOOLEAN
		"Z"
	as T_CHAR
		"C"
	as T_FLOAT
		"F"
	as T_DOUBLE
		"D"
	as T_BYTE
		"B"
	as T_SHORT
		"S"
	as T_INT
		"I"
	as T_LONG
		"J"

boxed-class-name symbol(a java-mangled-names, type concrete-type)
	a.type-to-boxed-class-name[type]!

-gen-ctx record
	program concrete-program
	union-info union-info
	type-to-name symbol[concrete-type]

-generate-boxed-class-name symbol(ctx gen-ctx, type concrete-type)
	mangled symbol mut() = () => ctx.type-to-name[type]!
	match type body
	as concrete-builtin-type x
		array-or-mut-slice symbol mut() = () =>
			element = x.type-args only
			if element is-empty-type
				"java/lang/Integer"
			else
				"[{ctx generate-descriptor-for-param-type element}"
		match x kind
		as array
			array-or-mut-slice[]
		as bool
			"java/lang/Boolean"
		as char8
			"java/lang/Byte"
		as char32
			"java/lang/Integer"
		as float32
			"java/lang/Float"
		as float64
			"java/lang/Double"
		as future
			"java/util/concurrent/Future"
		as int8
			"java/lang/Byte"
		as int16
			"java/lang/Short"
		as int32
			"java/lang/Integer"
		as int64
			"java/lang/Long"
		as java-any
			"java/lang/Object"
		as java-exclusion
			exclusion-class
		as js-any
			"java/lang/Object"
		as fun-data
			mangled[]
		as fun-mut
			mangled[]
		as fun-shared
			mangled[]
		as mut-array
			throw unreachable
		as mut-slice
			array-or-mut-slice[]
		as nat8
			"java/lang/Byte"
		as nat16
			"java/lang/Short"
		as nat32
			"java/lang/Integer"
		as nat64
			"java/lang/Long"
		as option
			throw unreachable
		as void
			mangled[]
		as weak-ref
			"java/lang/ref/WeakReference"
	as concrete-enum _
		mangled[]
	as concrete-flags _
		mangled[]
	as concrete-record _
		mangled[]
	as concrete-union x
		match ctx.union-info.union-to-representation[type]!
		as direct
			if type == ctx.program.exception
				"java/lang/Throwable"
			else
				"java/lang/Object"
		as sealed-interface
			mangled[]
		as switch
			mangled[]
		as nullable
			_, non-null = x.members only2
			ctx generate-boxed-class-name non-null
	as concrete-type-body-deferred
		throw unreachable

-exclusion-class symbol()
	"java/util/concurrent/locks/ReentrantLock"

