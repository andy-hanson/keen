import
	crow/bits
	crow/unsafe
	crow/string/unicode
	../../util/java-bytecode-types

| Reference to a {CONSTANT_Utf8_info}
utf8-reference record(index nat16)
to json(a utf8-reference)
	a.index.to
== bool(a utf8-reference, b utf8-reference)
<=> comparison(a utf8-reference, b utf8-reference)
hash void(a utf8-reference, state hash-state)
| Reference to a {CONSTANT_Class_info}
class-reference record(index nat16)
to json(a class-reference)
	a.index.to
== bool(a class-reference, b class-reference)
<=> comparison(a class-reference, b class-reference)
hash void(a class-reference, state hash-state)
class-reference-size nat()
	2
| Reference to a {CONSTANT_NameAndType_info}
name-and-type-reference record(index nat16)
to json(a name-and-type-reference)
	a.index.to
== bool(a name-and-type-reference, b name-and-type-reference)
<=> comparison(a name-and-type-reference, b name-and-type-reference)
hash void(a name-and-type-reference, state hash-state)
field-reference record(index nat16)
method-reference record(index nat16)
string-reference record(index nat16)

bytecode-out record mut
	out nat8 mut[]
new bytecode-out()
	(),
finish nat8[](a bytecode-out)
	a.out.move-to
next-index nat(a bytecode-out)
	a.out.size
~= void(a bytecode-out, x nat8)
	a.out ~= x
~~= void(a bytecode-out, x nat8[])
	a.out ~~= x
~~= void(a bytecode-out, x nat16)
	a ~= x >> 8 'to
	a ~= x & 0xff 'to
~~= void(a bytecode-out, x int16)
	a ~~= x.wrap-to::nat16
~~= void(a bytecode-out, x nat32)
	a ~~= (x >> 16).to::nat16
	a ~~= (x & 0xffff).to::nat16
~~= void(a bytecode-out, x nat64)
	a ~~= (x >> 32).to::nat32
	a ~~= (x & 0xffffffff).to::nat32
~~= void(a bytecode-out, x utf8-reference)
	a ~~= x.index
~~= void(a bytecode-out, x class-reference)
	a ~~= x.index
~~= void(a bytecode-out, x field-reference)
	a ~~= x.index
~~= void(a bytecode-out, x method-reference)
	a ~~= x.index
~~= void(a bytecode-out, x name-and-type-reference)
	a ~~= x.index

write-out[t] spec
	~~= void(out bytecode-out, a t)
write-array[t] void(out bytecode-out, xs t[]) t write-out
	out ~~= xs.size.to::nat16
	for x in xs
		out ~~= x
array-size[t] nat(xs t[]) t size
	2 + (sum xs, it.size)

| Based on https://docs.oracle.com/javase/specs/jvms/se23/html/jvms-4.html
ClassFile record
	constant-pool cp_info[]
	access class-access
	this-class class-reference
	# Usually java/lang/Object
	super-class class-reference
	interfaces class-reference[]
	fields field_info[]
	methods method_info[]
	attributes attribute_info[]
to nat8[](a ClassFile)
	out bytecode-out = ()
	out ~~= 0xcafebabe::nat32
	out ~~= 0::nat16 # minor
	out ~~= 67::nat16 # major
	# Constant pool indices must be > 0, so add 1 here
	constant-pool-count = 1 + (sum a.constant-pool, it.n-entries)
	out ~~= constant-pool-count.to::nat16
	for x in a.constant-pool
		# TODO: adding this here so it doesn't mark 'to json' as unused. Maybe there should be a way to mark any function as OK if unused.
		if false
			_ json = x.to
			_ class-access? = 0::nat16.to
			_ json = ()::class-access.to
			_ field-access-flags? = 0::nat16.to
			_ json = ()::field-access-flags.to
			_ method-access-flags? = 0::nat16.to
			_ json = ()::method-access-flags.to
		out ~~= x
	out ~~= a.access.to::nat16
	out ~~= a.this-class
	out ~~= a.super-class
	write-array out, a.interfaces
	write-array out, a.fields
	write-array out, a.methods
	write-array out, a.attributes
	finish out

field_info record
	access-flags field-access-flags
	name utf8-reference
	descriptor utf8-reference
	attributes attribute_info[]
new field_info(access-flags field-access-flags, name utf8-reference, descriptor utf8-reference)
	access-flags, name, descriptor, ()
~~= void(out bytecode-out, a field_info)
	out ~~= a.access-flags.to::nat16
	out ~~= a.name
	out ~~= a.descriptor
	write-array out, a.attributes

method_info record
	access-flags method-access-flags
	name utf8-reference
	descriptor utf8-reference
	attributes attribute_info[]
~~= void(out bytecode-out, a method_info)
	out ~~= a.access-flags.to::nat16
	out ~~= a.name
	out ~~= a.descriptor
	write-array out, a.attributes

attribute_info union
	ConstantValue_attribute
	Code_attribute
	LineNumberTable_attribute
	PermittedSubclasses_attribute
	SourceFile_attribute
	StackMapTable_attribute
	Record_attribute
do
	size nat()
	write void(out bytecode-out)
~~= void(out bytecode-out, a attribute_info)
	write a, out

ConstantValue_attribute record
	| Must have value "ConstantValue"
	attribute-name-index utf8-reference
	constant-value-index nat16
size nat(_ ConstantValue_attribute)
	2 + 4 + 2
write void(a ConstantValue_attribute, out bytecode-out)
	out ~~= a.attribute-name-index
	out ~~= 2::nat32
	out ~~= a.constant-value-index

Code_attribute record
	| Must have value "Code"
	attribute-name-index utf8-reference
	max-stack nat16
	max-locals nat16
	code nat8[]
	exception-table exception-table-entry[]
	attributes attribute_info[]
	-dummy void
new Code_attribute
	attribute-name-index utf8-reference
	max-stack nat16
	max-locals nat16
	code nat8[]
	exception-table exception-table-entry[]
	attributes attribute_info[]
do
	assert code.size < 65536
	attribute-name-index, max-stack, max-locals, code, exception-table, attributes, ()
size nat(_ Code_attribute)
	throw todo
write void(a Code_attribute, out bytecode-out)
	assert a.code.size < 65536 # JVM requirement
	out ~~= a.attribute-name-index
	size =
		exception-table-size = 2 + a.exception-table.size * exception-table-entry-size-bytes
		2 + 2 + 4 + a.code.size + exception-table-size + a.attributes.array-size
	out ~~= size.to::nat32
	start = out.next-index
	out ~~= a.max-stack
	out ~~= a.max-locals
	out ~~= a.code.size.to::nat32
	out ~~= a.code
	write-array out, a.exception-table
	write-array out, a.attributes
	out.next-index - start is size

exception-table-entry record
	start-pc nat16
	end-pc nat16
	handler-pc nat16
	catch-type class-reference
exception-table-entry-size-bytes nat()
	2 * 4
~~= void(out bytecode-out, a exception-table-entry)
	out ~~= a.start-pc
	out ~~= a.end-pc
	out ~~= a.handler-pc
	out ~~= a.catch-type

SourceFile_attribute record
	| Must have value "SourceFile"
	attribute-name-index utf8-reference
	source-file utf8-reference
size nat(_ SourceFile_attribute)
	8
write void(a SourceFile_attribute, out bytecode-out)
	out ~~= a.attribute-name-index
	out ~~= 2::nat32
	out ~~= a.source-file

LineNumberTable_attribute record
	| Must have value "LineNumberTable"
	attribute-name-index utf8-reference
	line-number-table line-number-table-entry[]
size nat(a LineNumberTable_attribute)
	2 + 4 + 2 + a.line-number-table.size * 4
write void(a LineNumberTable_attribute, out bytecode-out)
	out ~~= a.attribute-name-index
	out ~~= 2::nat32 + a.line-number-table.size.to * 4
	write-array out, a.line-number-table

line-number-table-entry record
	start-pc nat16
	line-number nat16
~~= void(out bytecode-out, a line-number-table-entry)
	out ~~= a.start-pc
	out ~~= a.line-number

StackMapTable_attribute record
	| Must have value "StackMapTable"
	attribute-name-index utf8-reference
	entries stack_map_frame[]
size nat(a StackMapTable_attribute)
	2 + 4 + a.entries.array-size
write void(a StackMapTable_attribute, out bytecode-out)
	out ~~= a.attribute-name-index
	out ~~= a.entries.array-size.to::nat32
	write-array out, a.entries

Record_attribute record
	| Must be "Record"
	attribute-name-index utf8-reference
	components record_component_info[]
size nat(a Record_attribute)
	2 + 4 + a.components.array-size
write void(a Record_attribute, out bytecode-out)
	out ~~= a.attribute-name-index
	out ~~= a.components.array-size.to::nat32
	write-array out, a.components

record_component_info record
	name-index utf8-reference
	descriptor-index utf8-reference
	attributes attribute_info[]
size nat(a record_component_info)
	2 + 2 + a.attributes.array-size
~~= void(out bytecode-out, a record_component_info)
	out ~~= a.name-index
	out ~~= a.descriptor-index
	write-array out, a.attributes

PermittedSubclasses_attribute record
	| Must be "PermittedSubclasses"
	attribute-name-index utf8-reference
	classes class-reference[]
size nat(a PermittedSubclasses_attribute)
	2 + 4 + 2 + a.classes.size * class-reference-size
write void(a PermittedSubclasses_attribute, out bytecode-out)
	out ~~= a.attribute-name-index
	out ~~= (2::nat + a.classes.size * class-reference-size).to::nat32
	write-array out, a.classes

stack_map_frame union
	same_frame
	same_locals_1_stack_item_frame
	same_locals_1_stack_item_frame_extended
	chop_frame
	same_frame_extended
	append_frame
	full_frame
do
	size nat()
	write void(out bytecode-out)
~~= void(out bytecode-out, a stack_map_frame)
	write a, out
same_frame record(offset-delta nat8)
size nat(_ same_frame)
	1
write void(a same_frame, out bytecode-out)
	assert a.offset-delta <= 63
	out ~= a.offset-delta
same_locals_1_stack_item_frame record
	offset-delta nat8
	stack verification_type_info
size nat(a same_locals_1_stack_item_frame)
	1 + a.stack.size
write void(a same_locals_1_stack_item_frame, out bytecode-out)
	assert a.offset-delta <= 31
	out ~= 64 + a.offset-delta
	out ~~= a.stack
same_locals_1_stack_item_frame_extended record
	offset-delta nat16
	stack verification_type_info
size nat(a same_locals_1_stack_item_frame_extended)
	1 + a.stack.size
write void(a same_locals_1_stack_item_frame_extended, out bytecode-out)
	out ~= 247
	out ~~= a.offset-delta
	out ~~= a.stack
chop_frame record
	n-to-chop nat8
	offset-delta nat16
size nat(_ chop_frame)
	3
write void(a chop_frame, out bytecode-out)
	assert 1::nat8 <= a.n-to-chop and a.n-to-chop <= 3
	out ~= a.n-to-chop + 247
	out ~~= a.offset-delta
same_frame_extended record(offset-delta nat)
size nat(_ same_frame_extended)
	3
write void(a same_frame_extended, out bytecode-out)
	out ~= 251
	out ~~= a.offset-delta
append_frame record
	offset-delta nat16
	locals verification_type_info[]
size nat(a append_frame)
	1 + a.locals.array-size
write void(a append_frame, out bytecode-out)
	assert 1::nat <= a.locals.size and a.locals.size <= 3
	out ~= 251 + a.locals.size.to
	out ~~= a.offset-delta
	for x in a.locals
		out ~~= x
full_frame record
	offset-delta nat16
	locals verification_type_info[]
	stack verification_type_info[]
size nat(a full_frame)
	1 + 2 + a.locals.array-size + a.stack.array-size
write void(a full_frame, out bytecode-out)
	out ~= 255
	out ~~= a.offset-delta
	write-array out, a.locals
	write-array out, a.stack

verification_type_info union(simple-variable-info, Object_variable_info, Uninitialized_variable_info)
	size nat()
	write void(out bytecode-out)
~~= void(out bytecode-out, a verification_type_info)
	write a, out
simple-variable-info record(tag nat8)
size nat(_ simple-variable-info)
	1
write void(a simple-variable-info, out bytecode-out)
	out ~= a.tag
integer simple-variable-info()
	1,
float simple-variable-info()
	2,
long simple-variable-info()
	4,
double simple-variable-info()
	3,
Object_variable_info record(class_ class-reference)
size nat(_ Object_variable_info)
	3
write void(a Object_variable_info, out bytecode-out)
	out ~= 7
	out ~~= a.class_
Uninitialized_variable_info record(offset nat16)
size nat(_ Uninitialized_variable_info)
	3
write void(a Uninitialized_variable_info, out bytecode-out)
	out ~= 8
	out ~~= a.offset

cp_info union
	CONSTANT_Class_info
	CONSTANT_Fieldref_info
	CONSTANT_Methodref_info
	CONSTANT_InterfaceMethodref_info
	CONSTANT_String_info
	CONSTANT_Integer_info
	CONSTANT_Float_info
	CONSTANT_Long_info
	CONSTANT_Double_info
	CONSTANT_NameAndType_info
	CONSTANT_Utf8_info
do
	| Most constants take a single entry, but long and double take 2
	n-entries nat()
	write void(out bytecode-out)
to json(a cp_info)
~~= void(out bytecode-out, a cp_info)
	write a, out

CONSTANT_Class_info record
	name-index utf8-reference
to json(a CONSTANT_Class_info)
n-entries nat(_ CONSTANT_Class_info)
	1
write void(a CONSTANT_Class_info, out bytecode-out)
	out ~= 7
	out ~~= a.name-index

CONSTANT_Fieldref_info record
	class-index class-reference
	name-and-type-index name-and-type-reference
to json(a CONSTANT_Fieldref_info)
n-entries nat(_ CONSTANT_Fieldref_info)
	1
write void(a CONSTANT_Fieldref_info, out bytecode-out)
	out ~= 9
	out ~~= a.class-index
	out ~~= a.name-and-type-index

CONSTANT_Methodref_info record
	class-index class-reference
	name-and-type-index name-and-type-reference
to json(a CONSTANT_Methodref_info)
n-entries nat(_ CONSTANT_Methodref_info)
	1
write void(a CONSTANT_Methodref_info, out bytecode-out)
	out ~= 10
	out ~~= a.class-index
	out ~~= a.name-and-type-index

CONSTANT_InterfaceMethodref_info record
	class-index class-reference
	name-and-type-index name-and-type-reference
to json(a CONSTANT_InterfaceMethodref_info)
n-entries nat(_ CONSTANT_InterfaceMethodref_info)
	1
write void(a CONSTANT_InterfaceMethodref_info, out bytecode-out)
	out ~= 11
	out ~~= a.class-index
	out ~~= a.name-and-type-index

CONSTANT_String_info record(string-index utf8-reference)
to json(a CONSTANT_String_info)
n-entries nat(_ CONSTANT_String_info)
	1
write void(a CONSTANT_String_info, out bytecode-out)
	out ~= 8
	out ~~= a.string-index

CONSTANT_Float_info record(value float32)
to json(a CONSTANT_Float_info)
n-entries nat(_ CONSTANT_Float_info)
	1
write void(a CONSTANT_Float_info, out bytecode-out)
	out ~= 4
	out ~~= a.value.bits-of

CONSTANT_Integer_info record(value nat32)
to json(a CONSTANT_Integer_info)
n-entries nat(_ CONSTANT_Integer_info)
	1
write void(a CONSTANT_Integer_info, out bytecode-out)
	out ~= 3
	out ~~= a.value

CONSTANT_Long_info record(value nat64)
to json(a CONSTANT_Long_info)
n-entries nat(_ CONSTANT_Long_info)
	2
write void(a CONSTANT_Long_info, out bytecode-out)
	out ~= 5
	out ~~= a.value
CONSTANT_Double_info record(value float64)
to json(a CONSTANT_Double_info)
n-entries nat(_ CONSTANT_Double_info)
	2
write void(a CONSTANT_Double_info, out bytecode-out)
	out ~= 6
	out ~~= a.value.bits-of

CONSTANT_NameAndType_info record(name-index utf8-reference, descriptor-index utf8-reference)
to json(a CONSTANT_NameAndType_info)
n-entries nat(_ CONSTANT_NameAndType_info)
	1
write void(a CONSTANT_NameAndType_info, out bytecode-out)
	out ~= 12
	out ~~= a.name-index
	out ~~= a.descriptor-index

CONSTANT_Utf8_info record(value string)
to json(a CONSTANT_Utf8_info)
n-entries nat(_ CONSTANT_Utf8_info)
	1
write void(a CONSTANT_Utf8_info, out bytecode-out)
	out ~= 1
	char8s char8[] = a.value.to
	# JVM uses a modified UTF8, but it's the same as UTF8 for most chars.
	# https://docs.oracle.com/javase/specs/jvms/se23/html/jvms-4.html#jvms-4.4.7
	if exists char8s, it.is-supplementary-character
		bytes = to-modified-utf8 char8s
		out ~~= bytes.size.to::nat16
		out ~~= bytes
	else
		out ~~= char8s.size.to::nat16
		out ~~= safe-reinterpret-cast char8s
-to-modified-utf8 nat8[](char8s char8[])
	do with out in build
	i mut = 0
	do loop
	do unless i == char8s.size else break
	x = char8s[i]
	if is-supplementary-character x
		# This is a high character and must be re-encoded
		iter = begin char8s
		skip-next-n iter, i
		char32 = unicode-decode-one iter
		jvm-encode-supplementary-character out, char32.to
		i := index iter
		continue
	else
		out ~= x.to
		i +:= 1
		continue
-is-supplementary-character bool(a char8)
	a.to::nat8 'has-all-bits 0b11110000
-jvm-encode-supplementary-character void(out nat8 builder, x nat32)
	assert x <= 0xfffff # numbers up to 20 bits
	out ~= 0b11101101
	out ~= 0b10100000 | ((x >> 16) - 1).to # bits 20-16
	out ~= 0b10000000 | ((x >> 10) & 0b111111).to # bits 15-10
	out ~= 0b11101101
	out ~= 0b10110000 | ((x >> 6) & 0b1111).to # bits 9-6
	out ~= 0b10000000 | (x & 0b111111).to # bits 5-0

constants-builder record mut
	-next-index mut nat16
	-utf8-cache utf8-reference mut[symbol]
	-string-cache string-reference mut[utf8-reference]
	-class-cache class-reference mut[symbol]
	-name-and-type-cache name-and-type-reference mut[(utf8-reference, utf8-reference)]
	-field-cache field-reference mut[(class-reference, name-and-type-reference)]
	-method-cache method-reference mut[(class-reference, name-and-type-reference)]
	-float32-cache nat16 mut[float32]
	-float64-cache nat16 mut[float64]
	-int32-cache nat16 mut[int32]
	-int64-cache nat16 mut[int64]
	-constants cp_info mut[]
new constants-builder()
	1, (), (), (), (), (), (), (), (), (), (), ()

float32 nat16(a constants-builder, constant float32)
	ensure a.float32-cache, constant, of
		add a, constant.CONSTANT_Float_info
float64 nat16(a constants-builder, constant float64)
	ensure a.float64-cache, constant, of
		add a, constant.CONSTANT_Double_info
int32 nat16(a constants-builder, constant int32)
	# Use a cache
	ensure a.int32-cache, constant, of
		add a, constant.wrap-to.CONSTANT_Integer_info
int64 nat16(a constants-builder, constant int64) # TODO: return a 'long-reference'? -------------------------------------------------
	# Use a cache. NOTE: These will take up 2 constant pool entries
	ensure a.int64-cache, constant, of
		add a, constant.wrap-to.CONSTANT_Long_info

-add nat16(a constants-builder, constant cp_info)
	res = a.next-index
	a.next-index +:= constant.n-entries.to
	a.constants ~= constant
	res

subscript utf8-reference(a constants-builder, value symbol)
	ensure a.utf8-cache, value, of
		index: add a, CONSTANT_Utf8_info value.to
class_ class-reference(a constants-builder, class-name symbol)
	ensure a.class-cache, class-name, of
		index: add a, CONSTANT_Class_info a[class-name]
name-and-type name-and-type-reference(a constants-builder, name symbol, type symbol)
	name-and-type a, a[name], a[type]
name-and-type name-and-type-reference(a constants-builder, name utf8-reference, type utf8-reference)
	ensure a.name-and-type-cache, (name, type), of
		index: add a, CONSTANT_NameAndType_info name, type
field field-reference(a constants-builder, class_ class-reference, name-and-type name-and-type-reference)
	ensure a.field-cache, (class_, name-and-type), of
		index: add a, CONSTANT_Fieldref_info class_, name-and-type
virtual-method-ref method-reference
	a constants-builder
	class_ class-reference
	name-and-type name-and-type-reference
do
	ensure a.method-cache, (class_, name-and-type), of
		index: add a, CONSTANT_Methodref_info class_, name-and-type
virtual-method-ref method-reference
	a constants-builder
	class_ class-reference
	name utf8-reference
	type utf8-reference
do
	virtual-method-ref a, class_, name-and-type a, name, type
virtual-method-ref method-reference(a constants-builder, class_ symbol, name symbol, type symbol)
	virtual-method-ref a, (class_ a, class_), name-and-type a, name, type
interface-method-ref method-reference(a constants-builder, class_ class-reference, name-and-type name-and-type-reference)
	ensure a.method-cache, (class_, name-and-type), of
		index: add a, CONSTANT_InterfaceMethodref_info class_, name-and-type
string-ref string-reference(a constants-builder, value symbol)
	utf8 = a[value]
	ensure a.string-cache, utf8, of
		index: add a, CONSTANT_String_info utf8

finish cp_info[](a constants-builder)
	a.constants.move-to
