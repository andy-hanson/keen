import
	../model/model

# https//gcc.gnu.org/onlinedocs/gcc/Other-Builtins.html
builtin-function enum
	acos
	acosf
	acosh
	acoshf
	asin
	asinf
	asinh
	asinhf
	atan
	atanf
	atan2
	atan2f
	atanh
	atanhf
	__builtin_isnan
	__builtin_popcountl
	ceil
	ceilf
	cos
	cosf
	cosh
	coshf
	floor
	floorf
	fmod
	fmodf
	log
	logf
	pow
	powf
	round
	roundf
	sin
	sinf
	sinh
	sinhf
	sqrt
	sqrtf
	tan
	tanf
	tanh
	tanhf
to symbol(a builtin-function)
to string(a builtin-function)
	a.to::symbol to
to builtin-function?(a symbol)

builtin-for-unary-math builtin-function(a builtin-unary-math)
	match a
	as acos-float32
		acosf
	as acos-float64
		acos
	as acosh-float32
		acoshf
	as acosh-float64
		acosh
	as asin-float32
		asinf
	as asin-float64
		asin
	as asinh-float32
		asinhf
	as asinh-float64
		asinh
	as atan-float32
		atanf
	as atan-float64
		atan
	as atanh-float32
		atanhf
	as atanh-float64
		atanh
	as cos-float32
		cosf
	as cos-float64
		cos
	as cosh-float32
		coshf
	as cosh-float64
		cosh
	as sin-float32
		sinf
	as sin-float64
		sin
	as sinh-float32
		sinhf
	as sinh-float64
		sinh
	as tan-float32
		tanf
	as tan-float64
		tan
	as tanh-float32
		tanhf
	as tanh-float64
		tanh
	as round-down-float32
		floorf
	as round-down-float64
		floor
	as round-float32
		roundf
	as round-float64
		round
	as round-up-float32
		ceilf
	as round-up-float64
		ceil
	as sqrt-float32
		sqrtf
	as sqrt-float64
		sqrt
	as unsafe-log-float32
		logf
	as unsafe-log-float64
		log

builtin-for-binary-math builtin-function(a builtin-binary-math)
	match a
	as atan2-float32
		atan2f
	as atan2-float64
		atan2
	as fmod-float32
		fmodf
	as fmod-float64
		fmod
	as unsafe-pow-float32
		powf
	as unsafe-pow-float64
		pow
