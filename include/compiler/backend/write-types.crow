import
	../model/concrete-model
	../model/low-model
	../model/model
	../util/full-index-map

# TODO: Instead of this visitor pattern, maybe just take a single callback with a union parameter -------------------------------------
type-writers interface mut
	declare-struct void(x concrete-struct)
	write-extern-with-size void(x concrete-struct, size type-size?)
	write-fun-pointer void(index low-fun-pointer-type-index, type low-fun-pointer-type)
	write-record void(index low-record-index, record_ low-record)
	write-union void(index low-union-index, union_ low-union)

write-types void(program low-program, writers type-writers)
	for _, x : program all-extern-types
		size = x type-size
		writers write-extern-with-size x.source, if size.alignment-bytes != 0
			size,
	struct-states struct-states = do
		fun-pointer-states: program.all-fun-pointer-types.size, false
		record-states: program.all-records.size, none
		union-states: program.all-unions.size, none
	loop
		made-progress mut = false
		some-incomplete mut = false
		for index, fun-pointer-type : program all-fun-pointer-types
			unless struct-states.fun-pointer-states[index]
				if program try-write-fun-pointer-declaration struct-states, writers, index, fun-pointer-type
					struct-states.fun-pointer-states[index] := true
					made-progress := true
				else
					some-incomplete := true
		for record-index, record_ : program all-records
			cur-state = struct-states.record-states[record-index]
			unless cur-state == defined
				did-work = program write-record-declaration-or-definition writers, struct-states, cur-state, record-index, record_
				if did-work > cur-state
					struct-states.record-states[record-index] := did-work
					made-progress := true
				else
					some-incomplete := true
		for union-index, union_ : program all-unions
			cur-state = struct-states.union-states[union-index]
			unless cur-state == defined
				did-work = program write-union-declaration-or-definition writers, struct-states, cur-state, union-index, union_
				if did-work > cur-state
					struct-states.union-states[union-index] := did-work
					made-progress := true
				else
					some-incomplete := true
		if some-incomplete
			assert made-progress
			continue
		else
			break

-struct-state enum(none, declared, defined)
-== bool(a struct-state, b struct-state)
-<=> comparison(a struct-state, b struct-state)

-struct-states record mut
	# No need to define, just declared or not
	fun-pointer-states (low-fun-pointer-type-index, bool) mut-full-index-map
	record-states (low-record-index, struct-state) mut-full-index-map
	union-states (low-union-index, struct-state) mut-full-index-map

# TODO: 'pointer' is unused -------------------------------------------------------------------------------------------------
-can-reference-type-as-value bool(program low-program, states struct-states, a low-type)
	match a combine-pointer
	as low-extern-type _
		true
	as low-fun-pointer-type x
		states.fun-pointer-states[x index]
	as primitive-type _
		true
	as low-pointer-combine x
		program can-reference-type-as-pointee states, x.pointee
	as low-record x
		states.record-states[x index] == defined
	as low-union x
		states.union-states[x index] == defined

# TODO: these two functions are similar. Could combine by having a function to get the state. Can reference as value if defined, can reference as pointee if declared.
-can-reference-type-as-pointee bool(program low-program, states struct-states, a low-type)
	match a combine-pointer
	as low-extern-type _
		true
	as low-fun-pointer-type x
		states.fun-pointer-states[x index]
	as primitive-type _
		true
	as low-pointer-combine x
		program can-reference-type-as-pointee states, x.pointee
	as low-record x
		states.record-states[x index] != none
	as low-union x
		states.union-states[x index] != none

-write-record-declaration-or-definition struct-state(
	program low-program,
	writers type-writers,
	struct-states struct-states,
	prev-state struct-state,
	record-index low-record-index,
	record_ low-record,
)
	forbid prev-state == defined
	can-write-fields = record_.fields every x =>
		program can-reference-type-as-value struct-states, x.type
	if can-write-fields
		writers write-record record-index, record_
		defined
	else
		writers declare-struct record_.source
		declared

-write-union-declaration-or-definition struct-state(
	program low-program,
	writers type-writers,
	struct-states struct-states,
	prev-state struct-state,
	union-index low-union-index,
	union_ low-union,
)
	forbid prev-state == defined
	if union_.members every x => program can-reference-type-as-value struct-states, x
		writers write-union union-index, union_
		defined
	else
		writers declare-struct union_.source
		declared

-try-write-fun-pointer-declaration bool(
	program low-program,
	struct-states struct-states,
	writers type-writers,
	fun-pointer-index low-fun-pointer-type-index,
	fun-pointer-type low-fun-pointer-type,
)
	fun-ptr low-fun-pointer-type = program.all-fun-pointer-types[fun-pointer-index]
	can-declare = program can-reference-type-as-pointee struct-states, fun-ptr.return-type &&
		fun-ptr.param-types every x => program can-reference-type-as-pointee struct-states, x
	if can-declare
		writers write-fun-pointer fun-pointer-index, fun-pointer-type
	can-declare
