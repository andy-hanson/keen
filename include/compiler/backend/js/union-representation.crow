import
	../../model/concrete-model
	../../model/model
	../util
	../../util/util

union-representation enum
	| Discriminate between union members using instanceof / typeof checks.
	direct
	| Need to construct a 'new U(index, value)' and use index to discriminate
	switch

union-info record
	union-to-representation union-representation[concrete-type]
	exception-case-types concrete-type set # TODO: exact same thing was needed for java/union-representation, share code?

union-representation union-representation(a union-info, union_ concrete-type)
	a.union-to-representation[union_]!

plan-unions union-info(program concrete-program)
	res union-representation mut[concrete-type] = ()
	for s in program.all-non-extern-types
		do if u = concrete-union s.body
		res[s] := choose-union-representation program, s, u
	union-to-representation: res.move-to
	exception-case-types: program.exception.body.concrete-union!.members.to

-choose-union-representation union-representation(program concrete-program, type concrete-type, u concrete-union)
	if type == program.exception
		direct
	# TODO ---------------------------------------------------------------------------------------------------------------------
	#elif u is-nullable-union
	#	nullable
	elif !every u.members, it.can-use-in-direct-union
		switch
	elif all-unique-primitives u
		direct
	else
		switch
-all-unique-primitives bool(a concrete-union)
	is-unique for*::js-primitive-kind[] x in a.members
		from-option as-js-primitive x

-can-use-in-direct-union bool(a concrete-type)
	match body = a.body
	as concrete-builtin-type then body.kind != js-any
	as concrete-union then false
	else then true

-is-unique[t] bool(a t[]) t key
	a.to::(t set).size == a.size

# Don't bother with boolean since there is only one type represented that way/
-js-primitive-kind enum(array, bigint, function, number)
-== bool(a js-primitive-kind, b js-primitive-kind)
-<=> comparison(a js-primitive-kind, b js-primitive-kind)
-to nat32(a js-primitive-kind)
-hash void(a js-primitive-kind, state hash-state)
	hash a.to::nat32, state
-as-js-primitive js-primitive-kind?(a concrete-type)
	match body = a.body
	as concrete-builtin-type
		as-js-primitive body.kind
	as concrete-enum
		as-js-primitive body.storage.to
	as concrete-flags
		as-js-primitive body.storage.to
	else
		()
-as-js-primitive js-primitive-kind?(a builtin-type)
	match a
	as array
		array
	as bool
		() # Only one type compiles to 'boolean', so ignore
	as char8
		number
	as char32
		number
	as float32
		number
	as float64
		number
	as future
		()
	as fun-data
		function
	as fun-mut
		function
	as fun-shared
		function
	as js-any
		() # Already handled by 'can-use-in-direct-union'
	as mut-slice
		array
	as int8
		number
	as int16
		number
	as int32
		number
	as int64
		bigint
	as nat8
		number
	as nat16
		number
	as nat32
		number
	as nat64
		bigint
	as option
		throw unreachable
	as void
		() # Only one type compiles to 'undefined', so ignore
	as weak-ref
		()

# TODO: identical code in java/union-representation ...........................................................................
-is-nullable-union bool(type concrete-type)
	body = type.body
	concrete-union body and is-nullable-union body
-is-nullable-union bool(u concrete-union)
	if null, non-null = only2 u.members
		is-empty-type null and !is-empty-type non-null and !is-nullable-union non-null
