import
	../../model/concrete-model

concrete-mangled-names record
	-var-to-name string[concrete-var-id]
	-fun-to-name string[concrete-fun-id]
	-struct-to-name string[concrete-struct-id]

build-mangled-names concrete-mangled-names(program concrete-program)
	var-to-name-index string[concrete-var-id] = for x : program all-vars
		x.id, "v{x.id value}"
	# TODO: do something fancier -------------------------------------------------------------------------------------------------
	fun-to-name-index string[concrete-fun-id] = for x : program all-funs
		x.id, "f{x.id value}"
	struct-to-name-index string[concrete-struct-id] = for x : program all-structs
		x.id, "s{x.id value}"
	var-to-name-index, fun-to-name-index, struct-to-name-index

subscript string(a concrete-mangled-names, var concrete-var)
	a.var-to-name[var id]!
subscript string(a concrete-mangled-names, fun concrete-fun)
	a.fun-to-name[fun id]!
subscript string(a concrete-mangled-names, struct concrete-struct)
	a.struct-to-name[struct id]!
