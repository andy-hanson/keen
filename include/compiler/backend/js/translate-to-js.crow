	as unsafe-log-float64
		f64["log"]

-translate-builtin-binary-math js-expr(source source, a builtin-binary-math, (arg0 js-expr, arg1 js-expr))
	atan2 js-expr mut() = () =>
		source gen-call-math "atan2", (arg0, arg1)
	mod js-expr mut() = () =>
		source gen-binary modulo, arg0, arg1
	pow js-expr mut() = () =>
		source gen-call-math "pow", (arg0, arg1)
	match a
	as atan2-float32
