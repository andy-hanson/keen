import
	../../frontend/show-model
	../../model/concrete-model
	../../model/integral-values
	../../model/model
	../../model/show-concrete-model
	../../model/source-range
	../../model/uri
	../../model/version-info
	../../util/full-index-map
	../../util/util
	./js-ast
	./mangle-for-js
	./source-map
	./write-js-ast

translate-to-js js-and-map
	program program-with-main
	concrete-program concrete-program
	show-ctx show-type-ctx
	target js-target
	source-map-name string?
do
	ctx to-js-ctx = show-ctx, target, concrete-program, concrete-program.build-mangled-names
	shebang shebang = match target
	as browser
		none
	as node
		node
	classes js-class-decl[] = with out : build
		for type : concrete-program all-non-extern-types
			out ~~= ctx translate-type type
	functions js-fun-decl[] = for x : concrete-program all-non-extern-funs
		ctx to-js-function x
	vars js-var-decl[] = with out : build
		for var : concrete-program all-vars
			match var kind
			as thread-local_
				throw todo
			as global_
				destructure js-destructure = ctx js-name var
				expr-ctx to-expr-ctx = do
					ctx: ctx
					is-cur-fun-async: async # TODO: actually detect whether it needs to be async ----------------------------------------------
					cur-fun-debug-name: var.source.name
				value = expr-ctx to-js-expr var.initializer
				out ~= let, destructure, value
		to-symbol = ctx.program.common-funs.concrete-common-funs-js! to-symbol-from-string
		source = ctx source to-symbol
		string = ctx.program string
		to-symbol-is-async = ctx is-async to-symbol
		to-symbol-ref = ctx to-ref source, to-symbol
		for index, sym : concrete-program.all-constants.symbols with-index
			# TODO: repeating the to-string-from-js-string logic over and over is verbose .......................................
			args js-expr[] = (ctx to-string-from-js-string string, source, do source gen-string sym.to),
			out ~= const, index.constant-symbol-name, do source gen-call to-symbol-is-async, to-symbol-ref, args

	statements js-statement[] = (ctx gen-call-main concrete-program.common-funs.concrete-common-funs-js!.main),
	ast js-script-ast = shebang, classes, functions, vars, statements
	module-paths module-paths = program module-paths
	show-ctx write-js-ast module-paths, ast, source-map-name

-constant-symbol-name js-name(index nat)
	"_symbol{index}" no-prefix

-gen-call-main js-statement(ctx to-js-ctx, main concrete-fun)
	###
	main(process.argv.slice(2)).then(exit => {
		if (exit !== 0n) process.exit(Number(exit))
	})
	###
	source = ctx source main
	process = source gen-global "process"
	process-argv = source gen-property-access process, "argv".no-prefix
	process-argv-slice = source gen-call-property-sync process-argv, "slice".no-prefix, ((source gen-number64 2),)
	call-main = source gen-call-sync (ctx to-ref source, main), (process-argv-slice,)
	
	exit js-name = "exit" no-prefix
	params js-params = (exit,), ()
	get-exit = source gen-identifier exit
	Number = source gen-global "Number"
	number-exit = source gen-call-sync Number, (get-exit,)
	call-exit = source gen-call-property-sync process, "exit".no-prefix, (number-exit,)
	exit-neq-0 = source gen-not-eq-eq get-exit, (source gen-integer-unsigned 0)
	body js-statement = source gen-if exit-neq-0, call-exit.expr-statement.to
	fn = source gen-arrow-function sync, params, body.to
	source gen-call-property-sync call-main, "then".no-prefix, (fn,) expr-statement

# TODO: this does expose the URIs on the build machine ......................................................................
-module-paths module-paths(program program-with-main)
	for uri, _ : program.program all-modules
		uri, uri.to

-translate-type js-class-decl?(ctx to-js-ctx, a concrete-type)
	match a body
	as concrete-builtin-type _
		()
	as concrete-enum _
		()
	as struct-body-extern-java _
		throw unreachable
	as concrete-flags _
		()
	as concrete-record x
		ctx class-for-record a, x
	as concrete-union x
		ctx class-for-union a, x
	as concrete-type-body-deferred
		throw unreachable

-gen-type-assert js-statement?(ctx to-js-ctx, source source, get js-expr, a concrete-type) # TODO: Once it's working, put type assertions behind a flag
	match a body
	as concrete-builtin-type x
		source gen-assert-builtin-type get, x
	as concrete-enum _
		source gen-assert-integral get
	as struct-body-extern-java _
		throw unreachable
	as concrete-flags _
		source gen-assert-integral get
	as concrete-record _
		unless a is-empty-type
			source gen-assert-instanceof get, (ctx js-name a)
	as concrete-union _
		source gen-assert-instanceof get, (ctx js-name a)
	as concrete-type-body-deferred
		throw unreachable

-gen-assert-builtin-type js-statement?(source source, get js-expr, a concrete-builtin-type)
	instanceof js-statement? mut(x string) = x =>
		source gen-assert-instanceof get, x.no-prefix
	typeof js-statement? mut(x string) = x =>
		source gen-assert-typeof get, x
	integral js-statement? mut() = () =>
		typeof["bigint"]
	match a kind
	as array
		# TODO: we could use Uint8Array for `nat8[]`s or `char8[]`s to improve performance for those.
		instanceof["Array"]
	as bool
		typeof["boolean"]
	as char8
		integral[]
	as char32
		integral[]
	as float32
		typeof["number"]
	as float64
		typeof["number"]
	as future
		instanceof["Promise"]
	as int8
		integral[]
	as int16
		integral[]
	as int32
		integral[]
	as int64
		integral[]
	as js-any
		()
	as fun-data
		typeof["function"]
	as fun-mut
		typeof["function"]
	as fun-shared
		typeof["function"]
	as mut-array
		instanceof["Array"]
	as mut-slice
		instanceof["Array"]
	as nat8
		integral[]
	as nat16
		integral[]
	as nat32
		integral[]
	as nat64
		integral[]
	as option
		# TODO: for most types, we could represent this as `t` or `null`.
		# The exceptions would be options of 'js-any' or of other options.
		instanceof["Array"]
	as void
		# TODO: we should probably just eliminate these values from concrete-model! -----------------------------------------
		typeof["undefined"]
	as weak-ref
		instanceof["WeakRef"]
-gen-assert-instanceof js-statement(source source, get js-expr, name js-name)
	source gen-assert do
		source gen-or (source gen-instanceof get, do source gen-identifier name), (source gen-eq-eq-eq get, source.gen-null)
-gen-assert-typeof js-statement(source source, get js-expr, type string)
	source gen-assert (source gen-eq-eq-eq (source gen-typeof get), (source gen-string type))
-gen-assert-integral js-statement(source source, get js-expr)
	source gen-assert-typeof get, "bigint"
-gen-assert js-statement(source source, expr js-expr)
	cond = source gen-not expr
	source gen-if cond, source.gen-throw-error.to
-gen-throw-error js-statement(source source)
	Error = source gen-identifier "Error".no-prefix
	thrown = source gen-new Error, ()
	source gen-throw thrown
-throw-message js-statement(source source, message string)
	Error = source gen-identifier "Error".no-prefix
	string = source gen-string message
	thrown = source gen-new Error, (string,)
	source gen-throw thrown
-throw-unreachable js-statement(source source)
	source throw-message "Unreachable"

-source source(ctx to-js-ctx, a concrete-type)
	range uri-and-range = a.source range
	range.uri, (ctx.show-ctx show-concrete-type a to), ctx.line-and-character-getters[range].range.start
-source source(ctx to-js-ctx, a concrete-fun)
	range = a range
	range.uri, (ctx debug-name a), ctx.line-and-character-getters[range].range.start
-debug-name symbol(ctx to-js-ctx, a concrete-fun)
	ctx.show-ctx show-concrete-fun-name a to

-class-for-record js-class-decl(ctx to-js-ctx, a concrete-type ,r concrete-record)
	###
	class R {
		constructor(x, y) {
			if (!(x instanceof Whataver)) throw new Error()
			this.x = x
			this.y = y
		}
	}
	###
	source = ctx source a
	names string[] = for field : r fields
		field.debug-name to
	constructor js-class-member = source gen-constructor (), names, (index, get) =>
		ctx gen-type-assert source, get, r.fields[index].type
	comment = ctx.show-ctx show-concrete-type a
	comment, (ctx js-name a), (), (constructor,)

-class-for-union js-class-decl(ctx to-js-ctx, a concrete-type, _ concrete-union)
	# TODO: for most unions, we could just use the 'value' directly with no class and use 'instanceof' checks for matching
	###
	class U {
		constructor(index, value) {
			this.index = index
			this.value = value
		}
	}
	###
	source = ctx source a
	is-exception = a == ctx.exception
	extends js-name? = if is-exception
		"Error" no-prefix
	super js-statement? = if is-exception
		super = source gen-global "super" # TODO: give this an AST kind? --------------------------------------------------------
		message = source gen-string "Crow exception"
		expr = source gen-call-sync super, (message,)
		expr expr-statement
	constructor = source gen-constructor super, ("index", "value"), _ => ()
	comment = ctx.show-ctx show-concrete-type a
	comment, (ctx js-name a), extends, (constructor,)

-gen-constructor js-class-member
	source source
	super js-statement?
	names string[]
	check-field js-statement? mut(index nat, value js-expr)
do
	params js-destructure[] = for name : names; name no-prefix
	this = source gen-this
	identifiers js-expr[] = for name : names
		source gen-identifier name.no-prefix
	statements js-statement[] = with out : build
		out ~~= super
		for index, value : identifiers with-index
			out ~~= check-field[index, value]
		for name, identifier : names zip identifiers
			this_x = source gen-property-access this, name.no-prefix
			out ~= source gen-assign this_x, identifier
	kind = sync js-class-method params.to, statements.to
	source, instance, "constructor".no-prefix, kind

-js-name js-name(ctx to-js-ctx, fun concrete-fun)
	ctx.mangled-names[fun] no-prefix
-js-name js-name(ctx to-js-ctx, var concrete-var)
	ctx.mangled-names[var] no-prefix
-js-name js-name(ctx to-js-ctx, type concrete-type)
	ctx.mangled-names[type] no-prefix
-to-ref js-expr(ctx to-js-ctx, source source, fun concrete-fun)
	source gen-identifier (ctx js-name fun)
-to-ref js-expr(ctx to-js-ctx, source source, var concrete-var)
	source gen-identifier (ctx js-name var)
-to-ref js-expr(ctx to-js-ctx, source source, type concrete-type)
	source gen-identifier (ctx js-name type)

-to-js-ctx record
	show-type-ctx show-type-ctx
	target js-target
	program concrete-program
	mangled-names js-mangled-names
-show-ctx show-ctx(a to-js-ctx)
	a.show-type-ctx show
-line-and-character-getters line-and-character-getters(a to-js-ctx)
	a.show-ctx line-and-character-getters
-common-funs concrete-common-funs-js(a to-js-ctx)
	a.program.common-funs concrete-common-funs-js!
-exception concrete-type(a to-js-ctx)
	a.common-funs exception
-string concrete-type(a to-js-ctx)
	a.common-funs string
-symbol concrete-type(a to-js-ctx)
	a.common-funs symbol
-is-string-or-symbol bool(ctx to-js-ctx, a concrete-type)
	a == ctx.string || a == ctx.symbol

-to-expr-ctx record mut
	ctx to-js-ctx
	is-cur-fun-async sync-or-async
	cur-fun-debug-name symbol
	cur-loop-label mut js-name?
	temp-local-indices nat mut[concrete-local]
	next-generated-temp-index mut nat
-new to-expr-ctx(ctx to-js-ctx, is-cur-fun-async sync-or-async, cur-fun-debug-name symbol)
	ctx, is-cur-fun-async, cur-fun-debug-name, (), (), ()
-show-ctx show-ctx(a to-expr-ctx)
	a.ctx show-ctx
-take-next-temp-index nat(a to-expr-ctx)
	res = a next-generated-temp-index
	a.next-generated-temp-index +:= 1
	res
-to-ref js-expr(ctx to-expr-ctx, source source, fun concrete-fun)
	ctx.ctx to-ref source, fun
-to-ref js-expr(ctx to-expr-ctx, source source, var concrete-var)
	ctx.ctx to-ref source, var
-to-ref js-expr(ctx to-expr-ctx, source source, type concrete-type)
	ctx.ctx to-ref source, type

-source source(ctx to-expr-ctx, a concrete-expr)
	range = a range
	range.uri, ctx.cur-fun-debug-name, ctx.show-ctx.line-and-character-getters[range].range.start

-is-async sync-or-async(ctx to-js-ctx, a concrete-fun)
	a in ctx.program.yielding-funs ? async : sync

-to-js-function js-fun-decl(ctx to-js-ctx, a concrete-fun)
	async sync-or-async = ctx is-async a
	name js-name = ctx js-name a
	expr-ctx to-expr-ctx = ctx, (ctx is-async a), (ctx debug-name a)
	params js-destructure[] = for param : a params
		expr-ctx local-name param
	body = expr-ctx to-block-statement a
	comment = ctx.show-ctx show-concrete-fun-sig a, ((ctx is-async a) == async)
	comment, name, (async, (params, ()), body)

-to-block-statement js-expr-or-block-statement(ctx to-expr-ctx, a concrete-fun)
	source = ctx.ctx source a
	match a body
	as concrete-fun-body-builtin x
		ctx translate-builtin a.return-type, source, x.kind, x.type-args, for param : a params
			param.type, a.range, param.local-get-concrete-expr # TODO: use param range, not a.range ---------------------------------------
	as concrete-expr x
		# error log "LET'S TRANSLATE {ctx.ctx.show-ctx show-concrete-fun-sig a, false}" # -------------------------------------
		body = ctx to-block-statement x
		statements js-statement[] = with out: build
			for param : a params
				out ~~= ctx.ctx gen-type-assert source, (ctx get-local source, param), param.type
			out ~~= body statements
		(statements,)
	as fun-body-extern-java _
		throw unreachable
	as concrete-fun-body-method _
		throw todo
	as concrete-fun-body-deferred
		throw unreachable

-translate-builtin js-expr-or-block-statement
	ctx to-expr-ctx
	type concrete-type
	source source
	fun builtin-fun
	type-args concrete-type[]
	args concrete-expr[]
do
	match fun
	as builtin-unary x
		ctx translate-builtin-unary type, source, x, type-args, do ctx to-js-expr args.only
	as builtin-binary x
		arg0, arg1 = args only2
		source translate-builtin-binary type, x, do (ctx to-js-expr arg0), (ctx to-js-expr arg1)
	as builtin-ternary x
		arg0, arg1, arg2 = args only3
		source translate-builtin-ternary x, do (ctx to-js-expr arg0), (ctx to-js-expr arg1), (ctx to-js-expr arg2)
	as builtin-binary-lazy _
		throw unreachable
	as builtin-fun-call-lambda
		arg0, arg1 = args only2
		source gen-await do source gen-call-sync (ctx to-js-expr arg0), ((ctx to-js-expr arg1),)
	as builtin-fun-constant _
		throw unreachable
	as builtin-fun-is-empty-type
		throw unreachable
	as js-fun x
		ctx translate-js-fun source, x, type, args

-translate-builtin-unary js-expr-or-block-statement(ctx to-expr-ctx, type concrete-type, source source, a builtin-unary, type-args concrete-type[], arg js-expr)
	unary js-expr mut(op js-unary-kind) = op =>
		source gen-unary op, arg
	match a
	as array-size
		# BigInt(arg.length)
		BigInt = source gen-global "BigInt"
		length = source gen-property-access arg, "length".no-prefix
		source gen-call-sync BigInt, (length,)
	as as-mut-array
		throw unreachable
	as as-mut-array-impl
		throw unreachable
	as bits-of-float32
		number = source gen-convert 4, "Float32Array", "Uint32Array", arg
		source gen-call-sync (source gen-global "BigInt"), (number,)
	as bits-of-float64
		source gen-convert 8, "Float64Array", "BigInt64Array", arg
	as bitwise-not
		source gen-as-integral type.as-integral-type!, unary[bitwise-not]
	as float32-from-bits
		Number = source gen-global "Number"
		source gen-convert 4, "Uint32Array", "Float32Array", (source gen-call-sync Number, (arg,))
	as float64-from-bits
		source gen-convert 8, "BigInt64Array", "Float64Array", arg
	as gc-safe-mut-slice
		# Array(size).fill(null)
		Array = source gen-global "Array"
		Number = source gen-global "Number"
		number-arg = source gen-call-sync Number, (arg,)
		array = source gen-call-sync Array, (number-arg,)
		elem = ctx.ctx translate-constant source, type-args.only, constant-gc-safe-value
		source gen-call-property-sync array, "fill".no-prefix, (elem,)
	as not
		source gen-not arg
	as reinterpret-cast
		arg
	as to-char8-from-nat8
		arg
	as to-float32-from-float64
		source gen-as-float32 arg
	as to-float64-from-float32
		arg
	as to-float64-from-int64
		source gen-call-sync (source gen-global "Number"), (arg,)
	as to-float64-from-nat64
		source gen-call-sync (source gen-global "Number"), (arg,)
	as truncate-to-int64-from-float64
		trunc = source gen-call-math "trunc", arg
		source gen-call-sync (source gen-global "BigInt"), (trunc,)
	as weak-ref-get
		###
		const got = arg?.get()
		return new Option(got === undefined ? 0 : 1, got)
		###
		arg-get js-expr = source gen-optional-call-property-sync arg, "deref".no-prefix, ()
		ctx with-temp "got", source, arg-get, got =>
			got-eq-undefined = source gen-eq-eq-eq got, source.gen-undefined
			zero = source gen-integer-unsigned 0
			one = source gen-integer-unsigned 1
			index = source gen-ternary got-eq-undefined, zero, one
			option = ctx to-ref source, type
			(source gen-return (source gen-new option, (index, got))),
	as weak-ref-new
		WeakRef = source gen-global "WeakRef"
		source gen-new WeakRef, (arg,)
	as wrap-convert-integral
		# TODO: for a strictly widening conversion with same sign (e.g. nat8 to nat16) we could omit this -----------------------------------------------------
		source gen-as-integral type.as-integral-type-allow-char!, arg

-gen-array-from js-expr(source source, arg js-expr)
	source gen-call-property-sync (source gen-global "Array"), "from".no-prefix, (arg,)

-translate-builtin-binary js-expr-or-block-statement(source source, type concrete-type, a builtin-binary, (arg0 js-expr, arg1 js-expr))
	binary js-expr data(op js-binary-kind) = op =>
		source gen-binary op, arg0, arg1
	match a
	as add-float
		match type as-float-type!
		as float32
			# Need to convert to float32
			source gen-as-float32 binary[plus]
		as float64
			binary[plus]
	as array-get
		source gen-property-access-computed arg0, arg1
	as bitwise-and
		binary[bitwise-and]
	as bitwise-or
		binary[bitwise-or]
	as bitwise-xor
		binary[bitwise-xor]
	as equal
		source gen-call-property-sync (source gen-global "Object"), "is".no-prefix, (arg0, arg1)
	as equal-float-ieee
		binary[eq-eq-eq]
	as less
		binary[less]
	as less-float-ieee
		binary[less]
	as mul-float
		match type as-float-type!
		as float32
			source gen-as-float32 binary[times]
		as float64
			binary[times]
	as reference-equal
		binary[eq-eq-eq]
	as sub-float
		match type as-float-type!
		as float32
			source gen-as-float32 binary[minus]
		as float64
			binary[minus]
	as unsafe-bit-shift-left-nat64
		source gen-as-nat 64, binary[bit-shift-left]
	as unsafe-bit-shift-right-nat64
		source gen-as-nat 64, binary[bit-shift-right]
	as unsafe-div
		if f ?= type as-float-type
			match f
			as float32
				source gen-as-float32 binary[divide]
			as float64
				binary[divide]
		else
			assert _ ?= type as-integral-type
			binary[divide]
	as unsafe-mod-float64
		binary[modulo]
	as unsafe-mod-nat64
		binary[modulo]
	as wrap-add
		source gen-as-integral type.as-integral-type!, binary[plus]
	as wrap-mul
		source gen-as-integral type.as-integral-type!, binary[times]
	as wrap-sub
		source gen-as-integral type.as-integral-type!, binary[minus]

-translate-builtin-ternary js-expr-or-block-statement(source source, a builtin-ternary, (arg0 js-expr, arg1 js-expr, arg2 js-expr))
	match a
	as array-set
		access = source gen-property-access-computed arg0, arg1
		source gen-assign access, arg2 to

-translate-js-fun js-expr-or-block-statement(ctx to-expr-ctx, source source, a js-fun, return-type concrete-type, args concrete-expr[])
	arg0 js-expr mut() = () =>
		ctx to-js-expr args[0]
	args-after js-expr[] mut(first nat) = first =>
		for arg : args[first .. end]
			ctx to-js-expr arg
	only-arg js-expr mut() = () =>
		ctx to-js-expr args.only
	only2-args (js-expr, js-expr) mut() = () =>
		x, y = args only2
		(ctx to-js-expr x), (ctx to-js-expr y)
	unary js-expr mut(kind js-unary-kind) = kind =>
		source gen-unary kind, only-arg[]
	binary js-expr mut(kind js-binary-kind) = kind =>
		source gen-binary kind, only2-args[]
	prop01 js-expr mut() = () =>
		source gen-property-access-computed (ctx to-js-expr args[0]), do ctx to-js-key args[1]
	match a
	as as-js-any
		only-arg[]
	as await
		source gen-await only-arg[]
	as call
		source gen-call-sync arg0[], args-after[1]
	as call-new
		source gen-new arg0[], args-after[1]
	as call-property
		source gen-call-sync prop01[], args-after[2]
	as call-property-spread
		args.size is 3
		source gen-call-with-spread sync, prop01[], (), (ctx to-js-expr args[2])
	as cast
		only-arg[]
	as eq-eq-eq
		binary[eq-eq-eq]
	as eval
		code = ctx to-js-string args.only
		source gen-call-sync (source gen-global "eval"), do code,
	as get
		args.size is 2
		prop01[]
	as instanceof
		binary[instanceof]
	as js-global
		global-name string = match ctx.ctx target
		as browser
			"window"
		as node
			"global"
		global_ = source gen-global global-name
		match args size
		as 0
			global_
		as 1
			match ctx to-js-string-or-constant args.only
			as js-expr x
				source gen-property-access-computed global_, x
			as string x
				source gen-global x
		else
			throw unreachable
	as less
		binary[less]
	as null
		source gen-null
	as plus
		binary[plus]
	as require
		arg = source convert-to-js-string only-arg[]
		source gen-call-sync (source gen-global "require"), (arg,)
	as set
		args.size is 3
		source gen-assign prop01[], (ctx to-js-expr args[2]) to
	as typeof
		ctx.ctx to-string-from-js-string return-type, source, unary[typeof]
	as undefined
		source gen-undefined

-to-js-key js-expr(ctx to-expr-ctx, arg concrete-expr)
	if arg.type is-nat64 || arg.type is-float64
		ctx to-js-expr arg
	else
		ctx to-js-string arg

-to-js-string js-expr(ctx to-expr-ctx, arg concrete-expr)
	match ctx to-js-string-or-constant arg
	as js-expr x
		x
	as string x
		ctx source arg gen-string x

-js-expr-or-string union(js-expr, string)
-to-js-string-or-constant js-expr-or-string(ctx to-expr-ctx, arg concrete-expr)
	program = ctx.ctx program
	arg.type is program.string
	if c ?= arg.kind constant
		program as-string c
	else
		ctx source arg convert-to-js-string do ctx to-js-expr arg

-to-string-from-js-string js-expr(ctx to-js-ctx, string concrete-type, source source, arg js-expr)
	chars = source convert-to-char8-array-from-js-string arg
	source gen-new (ctx to-ref source, string), (chars,)

-convert-to-char8-array-from-js-string js-expr(source source, arg js-expr)
	# TODO: just have this call 'string-of-js-string' from string.crow! ------------------------------------------------------
	# new string(Array.from(new TextEncoder().encode(arg)).map(BigInt))
	BigInt = source gen-global "BigInt"
	TextEncoder = source gen-global "TextEncoder"
	text-encoder = source gen-new TextEncoder, ()
	encoded = source gen-call-property-sync text-encoder, "encode".no-prefix, (arg,)
	array = source gen-array-from encoded
	source gen-call-property-sync array, "map".no-prefix, (BigInt,)

-convert-to-js-string js-expr(source source, arg js-expr)
	# TODO: just have this call 'to-js-string' from string.crow! ------------------------------------------------------------------
	# new TextDecoder().decode(new Uint8Array(arg.chars.map(Number)))
	Number = source gen-global "Number"
	TextDecoder = source gen-global "TextDecoder"
	Uint8Array = source gen-global "Uint8Array"
	text-decoder = source gen-new TextDecoder, ()
	chars = source gen-property-access arg, "chars".no-prefix
	numbers = source gen-call-property-sync chars, "map".no-prefix, (Number,)
	array = source gen-new Uint8Array, (numbers,)
	source gen-call-property-sync text-decoder, "decode".no-prefix, (array,)

-to-js-expr js-expr(ctx to-expr-ctx, a concrete-expr)
	ctx to-expr (ctx source a), (ctx to-expr-or-block-statement a)

-to-expr js-expr(ctx to-expr-ctx, source source, a js-expr-or-block-statement)
	match a
	as js-expr x
		x
	as js-block-statement x
		source gen-iife ctx.is-cur-fun-async, x

-to-block-statement js-block-statement(ctx to-expr-ctx, a concrete-expr) # TODO: this should just be 'to-statements' ........................
	match ctx to-expr-or-block-statement a
	as js-expr x
		x return-unless-void a.type.is-void
	as js-block-statement x
		x

-return-unless-void js-block-statement(expr js-expr, is-void bool)
	if is-void
		expr.expr-statement to
	else
		expr.source gen-return expr to

-to-expr-or-block-statement js-expr-or-block-statement(ctx to-expr-ctx, a concrete-expr)
	source = ctx source a
	type = a type
	async = ctx is-cur-fun-async
	match a kind
	as array-op-concrete-expr x
		input-expr = ctx to-js-expr x.input
		match x input-kind
		as array
			match x output-kind type
			as array
				# TODO: PERF I should probably not use 'map' here, do a loop like I do for range ------------------------------------------------------------
				# `xs.map(x => {... })` or `await Array.fromAsync(xs, async x => { ... })`
				params js-params = if l ?= x local
					((ctx local-name l),) to
				body = ctx to-expr-or-block-statement x.body
				arrow js-arrow-function = async, params, body
				fn js-expr = source, arrow
				match async
				as sync
					source gen-call-property-sync input-expr, "map".no-prefix, (fn,)
				as async
					map = source gen-call-property-sync (source gen-global "Array"), "fromAsync".no-prefix, (input-expr, fn)
					source gen-await map
			as void
				local js-name = ctx local-or-ignore-name x.local
				(source, (local js-for-of-statement input-expr, (ctx to-block-statement x.body))) to
		as range
			low, high = x.input.type range-fields
			cur-name js-name = temp, "cur", ctx.take-next-temp-index
			end-name js-name = temp, "end", ctx.take-next-temp-index
			get-cur = source gen-identifier cur-name
			get-end = source gen-identifier end-name
			cur-less-end = source gen-less get-cur, get-end
			match x output-kind type
			as array
				###
				const { low: start, high: end } = range
				const out = new Array(Number(end - start))
				let cur = start
				while (cur < end) {
					out[cur - start] = ...
					cur = cur + 1n
				}
				return out
				###
				start-name js-name = temp, "start", ctx.take-next-temp-index
				get-start = source gen-identifier start-name
				out-name js-name = temp, "out", ctx.take-next-temp-index
				get-out = source gen-identifier out-name
				range-destructure js-object-destructure = ((low.debug-name.to.no-prefix, start-name), (high.debug-name.to.no-prefix, end-name)),
				declare-start-end = source gen-const range-destructure, (ctx to-js-expr x.input)
				Array = source gen-global "Array"
				Number = source gen-global "Number"
				size = source gen-call-sync Number, ((source gen-minus get-end, get-start),)
				new-array = source gen-new Array, (size,)
				declare-out = source gen-const out-name, new-array
				declare-cur = source gen-let cur-name, get-start
				body js-statement[] = with out : build
					if l ?= x local
						out ~= source gen-const (ctx local-name l), get-cur
					out-at-index = source gen-property-access-computed get-out, (source gen-minus get-cur, get-start)
					out ~= source gen-assign out-at-index, (ctx to-js-expr x.body)
					out ~= source gen-increment-integer cur-name
				while_ = source gen-while cur-less-end, body.to
				return-out = source gen-return get-out
				(declare-start-end, declare-out, declare-cur, while_, return-out) js-block-statement
			as void
				range-destructure js-object-destructure = ((low.debug-name.to.no-prefix, cur-name), (high.debug-name.to.no-prefix, end-name)),
				declare-cur-end = source gen-let range-destructure, (ctx to-js-expr x.input)
				###
				let { low: cur, high:end } = range
				while (cur < end) {
					<<body>>
					cur = cur + 1n
				}
				###
				body js-statement[] = with out : build
					if l ?= x local
						out ~= source gen-const (ctx local-name l), get-cur
					out ~~= ctx to-block-statement x.body statements
					out ~= source gen-increment-integer cur-name
				while_ = source gen-while cur-less-end, body.to
				(declare-cur-end, while_) js-block-statement
	as builtin-concrete-expr x
		ctx translate-builtin type, source, x.fun, x.type-args, x.args
	as call-concrete-expr x
		call-async = ctx.ctx is-async x.called
		if call-async == async
			assert ctx.is-cur-fun-async == async
		called = ctx to-ref source, x.called
		args js-expr[] = for arg : x args
			ctx to-js-expr arg
		source gen-call call-async, called, args
	as cast-concrete-expr x
		ctx to-expr-or-block-statement x.inner
	as constant x
		ctx.ctx translate-constant source, type, x
	as create-array-concrete-expr x
		# [x, y]
		args js-expr[] = for arg : x args
			ctx to-js-expr arg
		source gen-array args
	as create-record-concrete-expr x
		# new R(x, y, z)
		record_ = ctx to-ref source, type
		source gen-new record_, for arg : x args
			ctx to-js-expr arg
	as create-union-concrete-expr x
		# new U(index, value)
		union_ = ctx to-ref source, type
		index = source gen-integer-unsigned x.member-index
		value = ctx to-js-expr x.arg
		source gen-new union_, (index, value)
	as drop-concrete-expr x
		value = ctx to-js-expr x.arg
		source gen-unary void, value
	as finally-concrete-expr x
		source gen-try-finally (ctx to-block-statement x.below), (ctx to-block-statement x.right) to
	as if-concrete-expr x
		cond = ctx to-js-expr x.cond
		match ctx to-expr-or-block-statement x.then
		as js-expr then
			match ctx to-expr-or-block-statement x.else_
			as js-expr else_
				source gen-ternary cond, then, else_
			as js-block-statement else_
				then-statement = then return-unless-void type.is-void
				source gen-if cond, then-statement, (source, else_) to
		as js-block-statement then
			else_ = ctx to-block-statement x.else_
			source gen-if cond, then, (source, else_) to
	as let-concrete-expr x
		local = ctx local-name x.local
		value = ctx to-js-expr x.value
		then = ctx to-block-statement x.then
		kind = x.local is-mutable ? let : const
		(source gen-var-decl kind, local, value) ~ then.statements gen-block-statement
	as lambda-concrete-expr x
		params js-destructure[] = (ctx local-name x.param),
		body js-expr-or-block-statement = ctx to-expr-or-block-statement x.body
		arrow js-arrow-function = async, params.to, body
		source, arrow
	as local-get-concrete-expr x
		ctx get-local source, x.local
	as local-set-concrete-expr x
		source gen-assign (ctx get-local source, x.local), (ctx to-js-expr x.value) to
	as loop-concrete-expr x
		###
		loop
			if x
				continue
			else
				break 42
		==>
		while (true) {
			if (x)
				continue
			else
				// In a void context, this will 'break' instead of 'return'
				return 42
		}
		###
		label js-name? = if type is-void
			none, "loop", ctx.take-next-temp-index
		prev = ctx cur-loop-label
		ctx.cur-loop-label := label
		res = source gen-while-true label, (ctx to-block-statement x.body)
		ctx.cur-loop-label := prev
		res to
	as loop-break-concrete-expr x
		value = ctx to-block-statement x.value
		if type is-void
			value ~ (source gen-break ctx.cur-loop-label!)
		else
			value
	as loop-continue-concrete-expr
		source.gen-continue to
	as match-enum-or-integral-concrete-expr x
		matched = ctx to-js-expr x.matched
		is-signed = x.matched-integral-type is-signed
		cases js-switch-case[] = for value, expr : x.case-values zip x.case-exprs
			integer = if is-signed
				source gen-integer-signed value.as-signed
			else
				source gen-integer-unsigned value.as-unsigned
			integer, (source maybe-break-switch-case type, (ctx to-block-statement expr))
		default = if e ?= x else_
			ctx to-block-statement e
		else
			source.throw-unreachable to
		source gen-switch matched, cases, default to
	as match-string-like-concrete-expr x
		unless ctx.ctx is-string-or-symbol x.matched.type
			error log "Match on char8[] or char32[]?"
		assert ctx.ctx is-string-or-symbol x.matched.type : todo
		ctx with-temp "matched", x.matched, matched =>
			res mut = ctx to-block-statement x.else_
			equals = ctx to-ref source, x.equals
			equals-async = ctx.ctx is-async x.equals
			for case_ : x.cases reverse
				value = ctx to-js-expr case_.value
				cond = source gen-call equals-async, equals, (matched, value)
				then = ctx to-block-statement case_.then
				if_ = source gen-if cond, then, (source, res)
				res := if_ to
			res.statements
	as match-union-concrete-expr x
		###
		const temp = u
		switch (temp.index) {
			case 0:
				use(temp.value);
				break;
			...
		}
		###
		ctx with-temp "matched", x.matched, matched =>
			index = source gen-property-access matched, "index".no-prefix
			cases js-switch-case[] = for member-index, case_ : x.member-indices zip x.cases
				ctx translate-case type, source, member-index, case_, matched
			default = if e ?= x else_
				ctx to-block-statement e
			else
				source.throw-unreachable to
			(source gen-switch index, cases, default),
	as record-field-get-concrete-expr x
		source gen-property-access (ctx to-js-expr x.record_), x.field.debug-name.to.no-prefix
	as record-field-set-concrete-expr x
		record_ = ctx to-js-expr x.record_
		value = ctx to-js-expr x.value
		access = source gen-property-access record_, x.field.debug-name.to.no-prefix
		source gen-assign access, value to
	as seq-concrete-expr x
		(ctx to-block-statement x.first) ~~ (ctx to-block-statement x.then)
	as throw-concrete-expr x
		source gen-throw (ctx to-js-expr x.thrown) to
	as try-concrete-expr x
		ctx translate-try source, type, x
	as try-let-concrete-expr x
		ctx translate-try-let source, type, x
	as var-get-concrete-expr x
		ctx to-ref source, x.var
	as var-set-concrete-expr x
		source gen-assign (ctx to-ref source, x.var), (ctx to-js-expr x.value) to
	as union-as-concrete-expr x
		union_ = ctx to-js-expr x.union_
		source gen-property-access union_, "value".no-prefix
	as union-kind-concrete-expr x
		union_ = ctx to-js-expr x.union_
		source gen-property-access union_, "index".no-prefix

-translate-try js-block-statement(ctx to-expr-ctx, source source, type concrete-type, a try-concrete-expr)
	###
	try
		tried
	catch foo x
		x use
	==>
	try {
		tried()
	} catch (error) {
		if (error instanceof crow_exception) {
			switch (error.index) {
				case foo_index:
					return use(error.value)
				default:
					throw error
			}
		} else {
			throw error
		}
	}
	###
	tried = ctx to-block-statement a.tried
	error js-name = "error" special-local
	get-error = source gen-identifier error
	throw-error = source gen-throw get-error
	exception = ctx to-ref source, ctx.ctx.exception
	instanceof-exception = source gen-instanceof get-error, exception
	error-index = source gen-property-access get-error, "index".no-prefix
	cases js-switch-case[] = for member-index, case_ : a.exception-member-indices zip a.catch-cases
		ctx translate-case type, source, member-index, case_, get-error
	switch = source gen-switch error-index, cases, throw-error.to
	if_ = source gen-if instanceof-exception, switch.to, throw-error
	source gen-try-catch tried, error, if_.to to

-translate-try-let js-block-statement(ctx to-expr-ctx, source source, type concrete-type, a try-let-concrete-expr)
	# TODO: dup code in handler for 'translate-try' ------------------------------------------------------------------------
	error js-name = "error" special-local
	get-error = source gen-identifier error
	throw-error = source gen-throw get-error
	exception = ctx to-ref source, ctx.ctx.exception
	instanceof-exception = source gen-instanceof get-error, exception
	error-index = source gen-property-access get-error, "index".no-prefix
	error-value = source gen-property-access get-error, "value".no-prefix
	local js-name? = if l ?= a local
		ctx local-name l
	let-local js-statement[] = if l ?= local
		(source gen-let l),
	# Only needed if void, otherwise 'catch_then' will return
	ok js-name? = type is-void ? "ok" special-local
	let-ok js-statement[] = if o ?= ok
		(source gen-let o),
	tried js-statement[] = with out : build
		out ~~= if l ?= local
			((source gen-assign l, (ctx to-js-expr a.value)),)::js-statement[]
		else
			ctx to-block-statement a.value statements
		if x ?= ok
			out ~= source gen-assign x, (source gen-bool true)
	index-matches = source gen-eq-eq-eq error-index, (source gen-integer-unsigned a.exception-member-index.as-unsigned)
	is-caught-error = source gen-and instanceof-exception, index-matches
	###
	x = try value catch err local : catch_
	then
	==>
	let local, ok
	try {
		local = value
		ok = true
	} catch (error) {
		if (error instanceof crow_exception && e.index == exception_member_index) {
			const catch_local = error.value
			return catch_then
		} else {
			throw error
		}
	}
	if (ok) then
	###
	when-caught js-statement[] = with out : build
		if l ?= a.catch_ local
			out ~= source gen-const (ctx local-name l), error-value
		out ~~= ctx to-block-statement a.catch_.then statements
	if_ = source gen-if is-caught-error, when-caught.to, throw-error
	try_ = source gen-try-catch tried.to, error, if_.to
	then = ctx to-block-statement a.then
	if-ok-then js-block-statement = if x ?= ok
		source gen-if (source gen-identifier x), then to
	else
		then
	let-local.to ~~ let-ok.to ~~ try_.to ~~ if-ok-then

-translate-case js-switch-case
	ctx to-expr-ctx
	type concrete-type
	source source
	member-index integral-value
	case_ concrete-match-union-case
	matched js-expr
do
	matched-value = source gen-property-access matched, "value".no-prefix
	value = source gen-integer-unsigned member-index.as-unsigned
	then = ctx to-block-statement case_.then
	then-block js-block-statement = if l ?= case_ local
		declare = source gen-const (ctx local-name l), matched-value
		(declare ~ then.statements),
	else
		then
	value, (source maybe-break-switch-case type, then-block)

-maybe-break-switch-case js-block-statement(source source, type concrete-type, a js-block-statement)
	if type is-void
		a ~ source.gen-break-no-label
	else
		a

-to js-block-statement(a js-statement)
	(a,),
-to js-block-statement(a js-statement[])
	a,
-to js-expr-or-block-statement(a js-statement)
	a.to::js-block-statement

-get-local js-expr(ctx to-expr-ctx, source source, a concrete-local)
	source gen-identifier (ctx local-name a)
-local-name js-name(ctx to-expr-ctx, a concrete-local)
	match a source
	as local l
		l.name.to local
	as concrete-local-source-reference x
		x.original.name.to local
	as concrete-generated-local-kind x
		index = ctx.temp-local-indices ensure a, () =>
			ctx.temp-local-indices size
		x.to.to temp index

-local-or-ignore-name js-name(ctx to-expr-ctx, a concrete-local?)
	if x ?= a
		ctx local-name x
	else
		none, "ignore", ctx.take-next-temp-index

-translate-constant js-expr(ctx to-js-ctx, source source, type concrete-type, a constant)
	match type body
	as concrete-builtin-type x
		ctx translate-constant-builtin source, x, a
	as concrete-enum x
		source constant-integral x.storage_, a
	as struct-body-extern-java _
		throw unreachable
	as concrete-flags x
		source constant-integral x.storage_, a
	as concrete-record x
		# TODO:PERF Since these are allocated, we should probably make them global 'const' values too --------------------------
		class_ = ctx to-ref source, type
		match a
		as constant-record r
			source gen-new class_, for field, arg : x.fields zip ctx.program.all-constants.records[type]![r] # TODO: use a global const instead of creating a new one each time
				ctx translate-constant source, field.type, arg
		as constant-gc-safe-value
			source gen-null
		as constant-symbol s
			source gen-identifier s.index.constant-symbol-name
		else
			throw unreachable
	as concrete-union u
		match a
		as constant-union constant
			# TODO:PERF Since these are allocated, we should probably make them global 'const' values too -------------------------
			# new U(index, value)
			uv = ctx.program.all-constants.unions[type]![constant]
			case-type = u.members[uv member-index]
			index = source gen-integer-unsigned uv.member-index
			value = ctx translate-constant source, case-type, uv.member
			source gen-new (ctx to-ref source, type), (index, value)
		as constant-gc-safe-value
			source gen-null
		else
			throw unreachable
	as concrete-type-body-deferred
		throw unreachable

-translate-constant-builtin js-expr(ctx to-js-ctx, source source, builtin_ concrete-builtin-type, a constant)
	match builtin_ kind
	as array
		match a
		as constant-array ca
			elements = ctx.program.all-constants.arrs[ca type-index].constants[ca index] # TODO: I type this a lot. have a helper function.
			element-type = builtin_.type-args[0]
			source gen-array for x : elements
				ctx translate-constant source, element-type, x
		as constant-gc-safe-value
			# TODO: use null instead. A gc-safe-value is allowed to be any value that doesn't break the GC! -------------------
			source gen-array ()
		else
			throw unreachable
	as bool
		source gen-bool a.as-bool
	as char8
		source constant-integral nat8, a
	as char32
		source constant-integral nat32, a
	as float32
		source gen-number32 a.as-float
	as float64
		source gen-number64 a.as-float
	as future
		throw unreachable
	as int8
		source constant-integral int8, a
	as int16
		source constant-integral int16, a
	as int32
		source constant-integral int32, a
	as int64
		source constant-integral int64, a
	as js-any
		source gen-string ctx.program.all-constants.symbols[a.constant-symbol! index].to
	as fun-data
		throw unreachable
	as fun-mut
		throw unreachable
	as fun-shared
		throw unreachable
	as mut-array
		throw unreachable
	as mut-slice
		throw unreachable
	as nat8
		source constant-integral nat8, a
	as nat16
		source constant-integral nat16, a
	as nat32
		source constant-integral nat32, a
	as nat64
		source constant-integral nat64, a
	as option
		throw unreachable
	as void
		source gen-undefined
	as weak-ref
		assert _ ?= a constant-gc-safe-value
		source gen-null

-constant-integral js-expr(source source, type integral-type, a constant)
	value = match a
	as integral-value x
		x
	as constant-gc-safe-value
		0::nat,
	else
		throw unreachable
	if type is-signed
		source gen-integer-signed value.as-signed
	else
		source gen-integer-unsigned value.as-unsigned

-with-temp js-expr-or-block-statement
	ctx to-expr-ctx
	name string
	expr concrete-expr
	f js-statement[] mut(get-temp js-expr)
do
	ctx with-temp name, (ctx source expr), (ctx to-js-expr expr), f
-with-temp js-expr-or-block-statement
	ctx to-expr-ctx
	name string
	source source
	expr js-expr
	f js-statement[] mut(get-temp js-expr)
do
	js-name js-name = temp, name, ctx.take-next-temp-index
	declare = source gen-const js-name, expr
	then = f[source gen-identifier js-name]
	(declare ~ then,)

# TODO: move to a helpers module? -------------------------------------------------------------------------------------------------
-gen-as-integral js-expr(source source, type integral-type, arg js-expr)
	match type
	as int8
		source gen-as-int 8, arg
	as int16
		source gen-as-int 16, arg
	as int32
		source gen-as-int 32, arg
	as int64
		source gen-as-int 64, arg
	as nat8
		source gen-as-nat 8, arg
	as nat16
		source gen-as-nat 16, arg
	as nat32
		source gen-as-nat 32, arg
	as nat64
		source gen-as-nat 64, arg
-gen-as-int js-expr(source source, n-bits nat, arg js-expr)
	BigInt = source gen-global "BigInt"
	source gen-call-property-sync BigInt, "asIntN".no-prefix, ((source gen-number64 n-bits.to), arg)
-gen-as-nat js-expr(source source, n-bits nat, arg js-expr)
	BigInt = source gen-global "BigInt"
	source gen-call-property-sync BigInt, "asUintN".no-prefix, ((source gen-number64 n-bits.to), arg)

-gen-as-float32 js-expr(source source, arg js-expr)
	source gen-call-math "fround", arg

-gen-call-math js-expr(source source, name string, arg js-expr)
	source gen-call-math name, (arg,)
-gen-call-math js-expr(source source, name string, args js-expr[])
	source gen-call-property-sync (source gen-global "Math"), name.no-prefix, args

-gen-convert js-expr
	source source
	size-bytes nat
	input-array-type string
	output-array-type string
	arg js-expr
do
	###
	const buf = new ArrayBuffer(size_bytes)
	(new InputArray(buf))[0] = arg
	return (new OutputArray(buf))[0]
	###
	buf-name js-name = "buf" special-local
	buf js-expr = source gen-identifier buf-name
	ArrayBuffer = source gen-global "ArrayBuffer"
	new-buf = source gen-new ArrayBuffer, ((source gen-number64 size-bytes.to),)
	declare-buf = source gen-const buf-name, new-buf
	InputArray = source gen-global input-array-type
	OutputArray = source gen-global output-array-type
	input = source gen-subscript-zero (source gen-new InputArray, (buf,))
	assign-to-input = source gen-assign input, arg
	output = source gen-subscript-zero (source gen-new OutputArray, (buf,))
	return-output = source gen-return output
	source gen-iife sync, ((declare-buf, assign-to-input, return-output),)
-gen-subscript-zero js-expr(source source, arg js-expr)
	source gen-property-access-computed arg, (source gen-number64 0)

-gen-iife js-expr(source source, async sync-or-async, block js-block-statement)
	fn js-expr = source, (async js-arrow-function (), block)
	source gen-call async, fn, ()
