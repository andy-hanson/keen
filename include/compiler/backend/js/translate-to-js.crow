import
	../../app/command
	../../frontend/show-model
	../../model/concrete-model
	../../model/model
	../../model/show-concrete-model
	../../model/source-range
	../../model/uri
	../../util/full-index-map
	../../util/perf
	../../util/util
	../util
	./js-ast
	./mangle-for-js
	./source-map
	./union-representation
	./write-js-ast

translate-to-js js-and-map
	model-program program-with-main
	program concrete-program
	show-ctx show-type-ctx
	sanity-checks sanity-checks
	source-map-name string?
do
	start = perf-now
	finally start end-translate-to-js
	ctx to-js-ctx =
		show-type-ctx: show-ctx
		program: program
		sanity-checks: sanity-checks
		union-info: program plan-unions
		mangled-names: program build-mangled-names
		constant-names: program gen-constant-names show-ctx.show
	shebang shebang = node
	classes js-class-decl[] = for* type in program all-non-extern-types
		ctx translate-type type from-option
	functions js-fun-decl[] = with out in build
		for x in program all-non-extern-funs
			out ~~= ctx to-js-functions x
		for var in program all-vars
			match var kind
			as thread-local_
				throw todo
			as global_
				if var var-needs-getter
					out ~= ctx gen-var-getter var
		show-ctx.show each-constant-in-dependency-order program, of x
			# TODO: This is just an arbitrary source. there should be a way to have a null source?
			source = ctx source program.common-funs.concrete-common-funs-js!.to-symbol-from-string
			out ~= ctx constant-getter source, x

	vars js-var-decl[] = with out in build
		for var in program all-vars
			match var kind
			as thread-local_
				throw todo
			as global_
				if var var-needs-getter
					out ~= let, (ctx js-name var), ()
				elif var has-simple-initializer
					out ~= ctx gen-var-no-getter var	
		to-symbol = program.common-funs.concrete-common-funs-js! to-symbol-from-string
		source = ctx source to-symbol
		string = program string
		to-symbol-ref = ctx to-ref source, to-symbol, sync
		for index, sym in program.all-constants.symbols with-index
			# TODO: repeating the to-string-from-js-string logic over and over is verbose .......................................
			args js-expr[] =
				- ctx to-string-from-js-string string, source, do source gen-string sym.to
			out ~= const, index.constant-symbol-name, do source gen-call-sync to-symbol-ref, args
		for var in program all-vars
			match var kind
			as thread-local_
				throw todo
			as global_
				guard var !var-needs-getter and var !has-simple-initializer
				out ~= ctx gen-var-no-getter var
		
	ast js-script-ast = shebang, classes, functions, vars,
		- ctx gen-call-main program.common-funs.concrete-common-funs-js!.main to
	module-paths module-paths = model-program module-paths
	show-ctx write-js-ast module-paths, ast, sanity-checks, source-map-name

# Emit vars with simple initializers before symbols (this happens to be the only kind of constants that requires)
-has-simple-initializer bool(a concrete-var)
	_ ?= a.initializer.kind.constant ?scalar-value

-gen-var-no-getter js-var-decl(ctx to-js-ctx, var concrete-var)
	# TODO: actually detect whether it needs to be async --------------------------------------------------------------
	let, (ctx js-name var), do (ctx, async, var.source.name) to-js-expr var.initializer

-gen-constant-names nat constant-names(program concrete-program, show-ctx show-ctx)
	out nat constant-names-builder = ()
	constant-index mut nat = 0
	show-ctx each-constant-in-dependency-order program, of x
		out[x] := constant-index
		constant-index +:= 1
	out finish

-constant-symbol-name js-name(index nat)
	"_symbol{index}" no-prefix

-gen-call-main js-expr(ctx to-js-ctx, main concrete-fun)
	###
	main(typeof process === 'undefined' ? [] : process.argv.slice(2).map(x => toString(x)).then(exit => {
		if (exit !== 0n) process.exit(Number(exit))
	})
	###
	source = ctx source main
	process = source gen-global "process"
	argv =
		typeof-process = source gen-typeof process
		process-is-undefined = source gen-eq-eq-eq typeof-process, do source gen-string "undefined"
		empty-array = source gen-array ()
		process-argv-slice =
			process-argv = source gen-property-access process, "argv"
			source gen-call-property-sync process-argv, "slice", ((source gen-number64 2),)
		#to-string-from-js-string
		to-string-lambda =
			x js-name = "x" no-prefix
			params js-params = (x,), ()
			body = ctx to-string-from-js-string ctx.common-funs.string, source, (source gen-identifier x)
			source gen-arrow-function sync, params, body
		process-argv-mapped = source gen-call-property-sync process-argv-slice, "map", (to-string-lambda,)
		source gen-ternary process-is-undefined, empty-array, process-argv-mapped
	main-async sync-or-async = if ctx.async.funs[main] == always-async then async else sync
	call-main = source gen-call-sync (ctx to-ref source, main, main-async), (argv,)
	main-promise = match main-async
	as sync
		# TODO: this should be `Promise.resolve().then(() => main(process.argv))` to ensure exceptions are caught- ----------------------
		source gen-call-property-sync (source gen-global "Promise"), "resolve", (call-main,) 
	as async
		call-main
	source gen-call-property-sync main-promise, "then",
		exit js-name = "exit" no-prefix
		params js-params = (exit,), ()
		get-exit = source gen-identifier exit
		exit-neq-0 = source gen-not-eq-eq get-exit, do source gen-bigint-unsigned 0
		number-exit = source gen-call-sync (source gen-global "Number"), (get-exit,)
		call-exit = source gen-call-property-sync process, "exit", do number-exit,
		body = source gen-if exit-neq-0, call-exit.to
		- source gen-arrow-function sync, params, body.to

# TODO: this does expose the URIs on the build machine ......................................................................
-module-paths module-paths(program program-with-main)
	for uri, _ in program.program all-modules
		uri, uri.to

-translate-type js-class-decl?(ctx to-js-ctx, a concrete-type)
	is-exception = a in ctx.union-info.exception-case-types
	extends js-name? = if is-exception
		ctx js-name ctx.exception
	match body = a body
	as concrete-builtin-type
		()
	as concrete-enum
		()
	as struct-body-extern-java
		throw unreachable
	as concrete-flags
		()
	as concrete-record
		ctx class-for-record a, extends, body
	as concrete-union
		ctx class-for-union a, extends
	as concrete-type-body-deferred
		throw unreachable

-gen-is-type js-expr?(ctx to-js-ctx, source source, get js-expr, a concrete-type)
	match x = a body
	as concrete-builtin-type
		source gen-is-builtin-type get, x
	as concrete-enum
		source gen-is-integral get, x.storage_
	as struct-body-extern-java
		source gen-bool false
	as concrete-flags
		source gen-is-integral get, x.storage_
	as concrete-record
		source gen-instanceof get, do ctx to-ref source, a
	as concrete-union
		()
	as concrete-type-body-deferred
		throw unreachable

-gen-type-assert js-statement?(ctx to-js-ctx, source source, get js-expr, a concrete-type)
	guard ctx.sanity-checks == all-sanity-checks
	guard is-type ?= ctx gen-is-type source, get, a
	# Allow 'gc-safe-value'
	is-type-or-null = source gen-or is-type, do source gen-eq-eq-eq get, source.gen-null
	source gen-call-sync (source gen-identifier "_assert".no-prefix), (is-type-or-null,) to

-gen-is-builtin-type js-expr?(source source, get js-expr, a concrete-builtin-type)
	instanceof js-expr mut(x string) = of x
		source gen-instanceof get, do source gen-identifier x.no-prefix
	typeof js-expr mut(x string) = of x
		source gen-typeof-is get, x
	array js-expr mut() = of
		instanceof[a.type-args.only.js-array-type-for-element-type to]
	match a kind
	as array
		array[]
	as bool
		typeof["boolean"]
	as char8
		typeof["number"]
	as char32
		typeof["number"]
	as float32
		typeof["number"]
	as float64
		typeof["number"]
	as fun-data
		typeof["function"]
	as fun-mut
		typeof["function"]
	as fun-shared
		typeof["function"]
	as future
		instanceof["Promise"]
	as int8
		typeof["number"]
	as int16
		typeof["number"]
	as int32
		typeof["number"]
	as int64
		typeof["bigint"]
	as js-any
		()
	as mut-slice
		array[]
	as nat8
		typeof["number"]
	as nat16
		typeof["number"]
	as nat32
		typeof["number"]
	as nat64
		typeof["bigint"]
	as option
		throw unreachable
	as void
		typeof["undefined"]
	as weak-ref
		instanceof["WeakRef"]

-gen-is-integral js-expr(source source, get js-expr, type integral-type)
	source gen-typeof-is get, match type
	as int8
		"number"
	as int16
		"number"
	as int32
		"number"
	as int64
		"bigint"
	as nat8
		"number"
	as nat16
		"number"
	as nat32
		"number"
	as nat64
		"bigint"

-gen-typeof-is js-expr(source source, get js-expr, expected string)
	source gen-eq-eq-eq (source gen-typeof get), (source gen-string expected)

-unreachable js-expr(source source)
	source gen-call-sync (source gen-identifier "_unreachable".no-prefix), ()

-source source(ctx to-js-ctx, a concrete-type)
	range uri-and-range = a.source range
	uri: range uri
	name: ctx.show-ctx show-concrete-type a to
	pos: ctx.line-and-character-getters[range].range start
-source source(ctx to-js-ctx, a concrete-fun)
	range = a range
	range.uri, (ctx debug-name a), ctx.line-and-character-getters[range].range.start
-source source(ctx to-js-ctx, a concrete-var)
	range = a range
	range.uri, a.source.name, ctx.line-and-character-getters[range].range.start
-debug-name symbol(ctx to-js-ctx, a concrete-fun)
	ctx.show-ctx show-concrete-fun-name a to

-class-for-record js-class-decl
	ctx to-js-ctx
	a concrete-type
	extends js-name?
	r concrete-record
do
	###
	class R {
		constructor(x, y) {
			if (!(x instanceof Whataver)) throw new Error()
			this.x = x
			this.y = y
		}
	}
	###
	source = ctx source a
	names string[] = for field in r fields
		field.debug-name to
	comment = ctx.show-ctx show-concrete-type a
	comment: comment
	name: ctx js-name a
	extends: extends
	members: unless r.fields is-empty
		- source gen-constructor (_ ?= extends), names, of index, get
			ctx gen-type-assert source, get, r.fields[index].type

-class-for-union js-class-decl?(ctx to-js-ctx, a concrete-type, extends js-name?)
	match ctx union-representation a
	as direct
		if a == ctx.exception
			name = ctx js-name a
			forbid _ ?= extends
			comment: ""
			name: name
			extends: "Error" no-prefix
			members:
				-
					source = ctx source a
					source: source
					is-static: instance
					name: "message"
					kind:
						# return new TextDecoder().decode(show(this).chars)
						show-exception = ctx to-ref source, ctx.program.common-funs.show-exception, sync
						show-this = source gen-call-sync show-exception, (source.gen-this,)
						return-show = source gen-return do source convert-to-js-string show-this
						(return-show,).gen-block-statement js-class-getter
	as switch
		###
		class U {
			constructor(index, value) {
				this.index = index
				this.value = value
			}
		}
		###
		comment: ctx.show-ctx show-concrete-type a
		name: ctx js-name a
		extends: extends
		members:
			- ctx source a gen-constructor (_ ?= extends), ("index", "value"), it.noop

-gen-constructor js-class-member
	source source
	call-super bool
	names string[]
	check-field js-statement? mut(index nat, value js-expr)
do
	params js-destructure[] = for name in names then name no-prefix
	this = source gen-this
	identifiers js-expr[] = for name in names
		source gen-identifier name.no-prefix
	statements js-statement[] =
		-- if call-super
			- source gen-call-sync (source gen-global "super"), () to
		-- for* index, value in identifiers with-index
			check-field[index, value] from-option
		-- for name, identifier in names zip identifiers
			this_x = source gen-property-access this, name
			source gen-assign this_x, identifier
	kind = sync js-class-method params.to, statements.to
	source, instance, "constructor", kind

-js-name js-name(ctx to-js-ctx, fun concrete-fun, async sync-or-async)
	ctx.mangled-names[fun, async] no-prefix
-js-name js-name(ctx to-js-ctx, var concrete-var)
	ctx.mangled-names[var] no-prefix
-var-getter-name js-name(ctx to-js-ctx, var concrete-var)
	"_varget_{ctx.mangled-names[var]}" no-prefix
-js-name js-name(ctx to-js-ctx, type concrete-type)
	ctx.mangled-names[type] no-prefix
-to-ref js-expr(ctx to-js-ctx, source source, fun concrete-fun, async sync-or-async)
	source gen-identifier do ctx js-name fun, async
-to-ref js-expr(ctx to-js-ctx, source source, var concrete-var)
	source gen-identifier do ctx js-name var
-to-ref js-expr(ctx to-js-ctx, source source, type concrete-type)
	source gen-identifier do ctx js-name type

-to-js-ctx record
	show-type-ctx show-type-ctx
	program concrete-program
	sanity-checks sanity-checks
	union-info union-info
	mangled-names js-mangled-names
	constant-names nat constant-names
-show-ctx show-ctx(a to-js-ctx)
	a.show-type-ctx show
-line-and-character-getters line-and-character-getters(a to-js-ctx)
	a.show-ctx line-and-character-getters
-common-funs concrete-common-funs-js(a to-js-ctx)
	a.program.common-funs concrete-common-funs-js!
-exception concrete-type(a to-js-ctx)
	a.common-funs exception
-string concrete-type(a to-js-ctx)
	a.common-funs string
-symbol concrete-type(a to-js-ctx)
	a.common-funs symbol
-is-string-or-symbol bool(ctx to-js-ctx, a concrete-type)
	a == ctx.string or a == ctx.symbol
-async concrete-async-info(ctx to-js-ctx)
	ctx.program async!

-to-expr-ctx record mut
	ctx to-js-ctx
	is-cur-fun-async sync-or-async
	cur-fun-debug-name symbol
	cur-loop-label mut js-name?
	top-declared-locals js-name mut[]
	temp-local-indices nat mut[concrete-local]
	next-generated-temp-index mut nat
-with-expr-ctx record(ctx to-js-ctx, is-cur-fun-async sync-or-async, cur-fun-debug-name symbol)
-to-js-expr js-expr(a with-expr-ctx, expr concrete-expr)
	locals, js-expr = with expr-ctx in a
		expr-ctx to-expr-or-block-statement expr
	source = (a.ctx source expr, a.cur-fun-debug-name)
	a.is-cur-fun-async to-expr source, do source with-declare-locals locals, js-expr
-with-declare-locals js-expr-or-block-statement(source source, locals js-name[], expr js-expr-or-block-statement)
	if locals is-empty
		expr
	else
		block js-block-statement = match expr
		as js-expr
			source gen-return expr to
		as js-block-statement
			expr
		decl js-var-decl = let, for x in locals then x, ()
		(source, decl) ~ block
-with-block[t] (js-name[], t)(a with-expr-ctx, f t mut(x to-expr-ctx))
	expr-ctx to-expr-ctx =
		ctx: a ctx
		is-cur-fun-async: a is-cur-fun-async
		cur-fun-debug-name: a cur-fun-debug-name
		cur-loop-label: ()
		top-declared-locals: ()
		temp-local-indices: ()
		next-generated-temp-index: ()
	res = f[expr-ctx]
	expr-ctx.top-declared-locals.move-to, res
-take-next-temp-index nat(a to-expr-ctx)
	res = a next-generated-temp-index
	a.next-generated-temp-index +:= 1
	res
-to-ref js-expr(ctx to-expr-ctx, source source, fun concrete-fun, async sync-or-async)
	ctx.ctx to-ref source, fun, async
-to-ref js-expr(ctx to-expr-ctx, source source, var concrete-var)
	ctx.ctx to-ref source, var
-to-ref js-expr(ctx to-expr-ctx, source source, type concrete-type)
	ctx.ctx to-ref source, type
-union-representation union-representation(a to-js-ctx, union_ concrete-type)
	a.union-info union-representation union_
-union-representation union-representation(a to-expr-ctx, union_ concrete-type)
	a.ctx union-representation union_

-source source(ctx to-expr-ctx, a concrete-expr)
	ctx.ctx source a, ctx.cur-fun-debug-name
-source source(ctx to-js-ctx, a concrete-expr, cur-fun-debug-name symbol)
	range = a range
	range.uri, cur-fun-debug-name, ctx.show-ctx.line-and-character-getters[range].range.start

-is-async sync-or-async(ctx to-expr-ctx, a concrete-fun)
	if _ ?= ctx.ctx.async.funs[a]
		ctx is-cur-fun-async
	else
		sync
-is-async-initializer sync-or-async(ctx to-js-ctx, a concrete-var)
	if a in ctx.async.var-initializers then async else sync

-gen-var-getter js-fun-decl(ctx to-js-ctx, a concrete-var)
	async = ctx is-async-initializer a
	name = ctx var-getter-name a
	initializer = (ctx, async, a.source.name) to-js-expr a.initializer
	###
	if (x === undefined) x = initializer
	return x
	###
	source source = ctx source a
	x = ctx to-ref source, a
	body js-statement[] =
		x-eq-undefined = source gen-eq-eq-eq x, source.gen-undefined
		initialize = source gen-assign x, initializer
		- source gen-if x-eq-undefined, initialize.to
		- source gen-return x
	"", name, no-memoize, do async, (), body.to

-to-js-functions js-fun-decl[](ctx to-js-ctx, a concrete-fun)
	if x ?= ctx.async.funs[a]
		match x
		as always-async
			- ctx to-js-function a, async
		as sync-and-async
			- ctx to-js-function a, sync
			- ctx to-js-function a, async
	else
		- ctx to-js-function a, sync
-to-js-function js-fun-decl(ctx to-js-ctx, a concrete-fun, async sync-or-async)
	name = ctx js-name a, async
	params mut js-destructure[] = ()
	locals, body = with expr-ctx in ctx with-expr-ctx async, (ctx debug-name a)
		params := for param in a params
			expr-ctx local-name param
		expr-ctx to-expr-or-block-statement a
	comment = ctx.show-ctx show-concrete-fun-name a
	comment: comment
	name: name
	memoize: no-memoize
	fun:
		async: async
		params: params, ()
		body: ctx source a with-declare-locals locals, body

-to-expr-or-block-statement js-expr-or-block-statement(ctx to-expr-ctx, a concrete-fun)
	source = ctx.ctx source a
	match body = a body
	as concrete-fun-body-builtin
		ctx translate-builtin a.return-type, source, body.kind, for param in a params
			param.type, a.range, param.local-get-concrete-expr # TODO: use param range, not a.range ---------------------------------------
	as concrete-expr
		res = ctx to-expr-or-block-statement body
		type-asserts js-statement[] = unless ctx.ctx.sanity-checks == no-sanity-checks
			for* param in a params
				ctx.ctx gen-type-assert source, (ctx get-local source, param), param.type from-option
		if type-asserts is-empty
			res
		else
			(type-asserts,) ~~ (res to-block-statement a.return-type)
	as fun-body-extern-java
		throw unreachable
	as concrete-fun-body-method
		throw todo
	as concrete-fun-body-deferred
		throw unreachable

-translate-builtin js-expr-or-block-statement
	ctx to-expr-ctx
	type concrete-type
	source source
	fun builtin-fun
	args concrete-expr[]
do
	match fun
	as builtin-unary
		ctx translate-builtin-unary type, source, fun, args.only
	as builtin-binary
		arg0, arg1 = args only2
		source translate-builtin-binary type, fun, do (ctx to-js-expr arg0), (ctx to-js-expr arg1)
	as builtin-ternary
		arg0, arg1, arg2 = args only3
		source translate-builtin-ternary fun, do (ctx to-js-expr arg0), (ctx to-js-expr arg1), (ctx to-js-expr arg2)
	as builtin-fun-call-lambda
		arg0, arg1 = args only2
		call = source gen-call-sync (ctx to-js-expr arg0), ((ctx to-js-expr arg1),)
		match ctx is-cur-fun-async
		as sync
			call
		as async
			source gen-await call
	as builtin-fun-constant
		throw unreachable
	as builtin-fun-is-empty-type
		throw unreachable
	as js-fun
		ctx translate-js-fun source, fun, args

-translate-builtin-unary js-expr-or-block-statement(ctx to-expr-ctx, type concrete-type, source source, a builtin-unary, arg-expr concrete-expr)
	arg-type = arg-expr type
	arg = ctx to-js-expr arg-expr
	unary js-expr mut(op js-unary-kind) = of op
		source gen-unary op, arg
	match a
	as array-size
		# BigInt(arg.length)
		BigInt = source gen-global "BigInt"
		length = source gen-property-access arg, "length"
		source gen-call-sync BigInt, (length,)
	as bits-of-float32
		ctx gen-convert source, 4, "Float32Array", "Uint32Array", arg
	as bits-of-float64
		ctx gen-convert source, 8, "Float64Array", "BigInt64Array", arg
	as bitwise-not
		source gen-as-integral type.as-integral-type!, unary[bitwise-not]
	as float32-from-bits
		Number = source gen-global "Number"
		ctx gen-convert source, 4, "Uint32Array", "Float32Array", (source gen-call-sync Number, (arg,))
	as float64-from-bits
		ctx gen-convert source, 8, "BigInt64Array", "Float64Array", arg
	as gc-safe-mut-slice
		array-type = type js-array-type
		array = source gen-new (source gen-global array-type.to),
			- source gen-call-sync (source gen-global "Number"), (arg,)
		match array-type
		as Array
			# In JS, a 'new Array' has *missing* values, which perform worse than null values
			source gen-call-property-sync array, "fill", (source.gen-null,)
		else
			# All other array types have sensible default values
			# new Uint8Array(size)
			array
	as not
		source gen-not arg
	as reinterpret-cast
		arg
	as to-float32-from-float64
		source gen-as-float32 arg
	as to-float64-from-float32
		arg
	as to-float64-from-int64
		source gen-call-sync (source gen-global "Number"), (arg,)
	as to-float64-from-nat64
		source gen-call-sync (source gen-global "Number"), (arg,)
	as truncate-to-int64-from-float64
		trunc = source gen-call-math "trunc", arg
		source gen-call-sync (source gen-global "BigInt"), (trunc,)
	as weak-ref-get
		###
		const got = arg?.get()
		return got === undefined ? new Option(0) : new Option(1, got)
		###
		arg-get js-expr = source gen-optional-call-property-sync arg, "deref", ()
		ctx with-temp "got", source, arg-get, of got
			got-eq-undefined = source gen-eq-eq-eq got, source.gen-undefined
			none-type = type.body.concrete-union!.members[0]
			new-none = source gen-new (ctx to-ref source, none-type), () # TODO:PERF don't construct it every time ------------
			none = ctx.ctx gen-create-union source, type, 0, new-none
			some = ctx.ctx gen-create-union source, type, 1, got
			source gen-ternary got-eq-undefined, none, some
	as weak-ref-new
		WeakRef = source gen-global "WeakRef"
		source gen-new WeakRef, do arg,
	as wrap-convert-integral
		out = type as-integral-type-allow-char!
		in_ = arg-type as-integral-type-allow-char!
		source gen-as-integral out, if in_ is-64-bit
			if out is-64-bit
				arg
			else
				source gen-call-sync (source gen-global "Number"), (arg,)
		else
			if out is-64-bit
				source gen-call-sync (source gen-global "BigInt"), (arg,)
			else
				arg

-translate-builtin-binary js-expr-or-block-statement(source source, type concrete-type, a builtin-binary, (arg0 js-expr, arg1 js-expr))
	binary js-expr data(op js-binary-kind) = of op
		source gen-binary op, arg0, arg1
	bitwise js-expr data(op js-binary-kind) = of op
		res = binary[op]
		if type is-nat32 then source gen-to-nat32 res else res
	Object-is js-expr data() = of
		source gen-call-property-sync (source gen-global "Object"), "is", do arg0, arg1
	match a
	as add-float
		match type as-float-type!
		as float32
			# Need to convert to float32
			source gen-as-float32 binary[plus]
		as float64
			binary[plus]
	as array-get
		source gen-property-access-computed arg0, arg1
	as bitwise-and
		bitwise[bitwise-and]
	as bitwise-or
		bitwise[bitwise-or]
	as bitwise-xor
		bitwise[bitwise-xor]
	as equal-exact
		Object-is[]
	as equal-float-ieee
		binary[eq-eq-eq]
	as less
		binary[less]
	as less-float-ieee
		binary[less]
	as mul-float
		match type as-float-type!
		as float32
			source gen-as-float32 binary[times]
		as float64
			binary[times]
	as sub-float
		match type as-float-type!
		as float32
			source gen-as-float32 binary[minus]
		as float64
			binary[minus]
	as unsafe-bit-shift-left-nat64
		source gen-as-nat64 binary[bit-shift-left]
	as unsafe-bit-shift-right-nat64
		source gen-as-nat64 binary[bit-shift-right]
	as unsafe-div
		if f ?= type as-float-type
			match f
			as float32
				source gen-as-float32 binary[divide]
			as float64
				binary[divide]
		else
			assert _ ?= type as-integral-type
			binary[divide]
	as unsafe-mod-float64
		binary[modulo]
	as unsafe-mod-nat64
		binary[modulo]
	as wrap-add
		source gen-as-integral type.as-integral-type!, binary[plus]
	as wrap-mul
		source gen-as-integral type.as-integral-type!, binary[times]
	as wrap-sub
		source gen-as-integral type.as-integral-type!, binary[minus]

-translate-builtin-ternary js-expr-or-block-statement(source source, a builtin-ternary, (arg0 js-expr, arg1 js-expr, arg2 js-expr))
	match a
	as array-set
		access = source gen-property-access-computed arg0, arg1
		source gen-assign access, arg2 to

-translate-js-fun js-expr-or-block-statement(ctx to-expr-ctx, source source, a js-fun, args concrete-expr[])
	arg0 js-expr mut() = of
		ctx to-js-expr args[0]
	args-after js-expr[] mut(first nat) = of first
		for arg in args[first .. end]
			ctx to-js-expr arg
	only-arg js-expr mut() = of
		ctx to-js-expr args.only
	only2-args (js-expr, js-expr) mut() = of
		x, y = args only2
		(ctx to-js-expr x), (ctx to-js-expr y)
	unary js-expr mut(kind js-unary-kind) = of kind
		source gen-unary kind, only-arg[]
	binary js-expr mut(kind js-binary-kind) = of kind
		source gen-binary kind, only2-args[]
	prop01 js-expr mut() = of
		ctx property-access source, args[0], args[1]
	match a
	as await
		source gen-await only-arg[]
	as call
		source gen-call-sync arg0[], args-after[1]
	as call-new
		source gen-new arg0[], args-after[1]
	as call-property
		source gen-call-sync prop01[], args-after[2]
	as call-property-spread
		args.size is 3
		source gen-call-with-spread sync, prop01[], (), (ctx to-js-expr args[2])
	as eq-eq-eq
		binary[eq-eq-eq]
	as eval
		source gen-call-sync (source gen-global "eval"),
			- only-arg[]
	as get
		args.size is 2
		prop01[]
	as import_
		# TODO: 'import' should be its own kind of experssion .......................................................................................
		source gen-call-sync (source gen-global "import"),
			- only-arg[]
	as instanceof
		binary[instanceof]
	as js-global
		global_ = source gen-global "_global" # This is generated at top of write-js-ast
		match args size
		as 0
			global_
		as 1
			source gen-property-access-computed global_, only-arg[]
		else
			throw unreachable
	as less
		binary[less]
	as null
		source gen-null
	as plus
		binary[plus]
	as set
		args.size is 3
		source gen-assign prop01[], (ctx to-js-expr args[2]) to
	as typeof
		unary[typeof]
	as undefined
		source gen-undefined

-property-access js-expr(ctx to-expr-ctx, source source, object concrete-expr, key concrete-expr)
	assert key.type is-js-any
	source gen-property-access-computed (ctx to-js-expr object), (ctx to-js-expr key)

# TODO: instead of repeating this logic, just call 'to string(a js-any)' from 'string.crow' ---------------------------------------------------------
-to-string-from-js-string js-expr(ctx to-js-ctx, string concrete-type, source source, arg js-expr)
	chars = source convert-to-char8-array-from-js-string arg
	source gen-new (ctx to-ref source, string), (chars,)

-convert-to-char8-array-from-js-string js-expr(source source, arg js-expr)
	# new TextEncoder().encode(arg)
	TextEncoder = source gen-global "TextEncoder"
	text-encoder = source gen-new TextEncoder, ()
	source gen-call-property-sync text-encoder, "encode", (arg,)

-convert-to-js-string js-expr(source source, arg js-expr)
	# TODO: just have this call 'to-js-string' from string.crow! ------------------------------------------------------------------
	# new TextDecoder().decode(new Uint8Array(arg.chars.map(Number)))
	Number = source gen-global "Number"
	TextDecoder = source gen-global "TextDecoder"
	Uint8Array = source gen-global "Uint8Array"
	text-decoder = source gen-new TextDecoder, ()
	chars = source gen-property-access arg, "chars"
	numbers = source gen-call-property-sync chars, "map", (Number,)
	array = source gen-new Uint8Array, (numbers,)
	source gen-call-property-sync text-decoder, "decode", (array,)

-to-js-expr js-expr(ctx to-expr-ctx, a concrete-expr)
	ctx to-expr (ctx source a), (ctx to-expr-or-block-statement a)

-to-expr js-expr(ctx to-expr-ctx, source source, a js-expr-or-block-statement)
	ctx.is-cur-fun-async to-expr source, a
-to-expr js-expr(is-cur-fun-async sync-or-async, source source, a js-expr-or-block-statement)
	match a
	as js-expr
		a
	as js-block-statement
		source gen-iife is-cur-fun-async, a

-to-block-statement js-block-statement(ctx to-expr-ctx, a concrete-expr) # TODO: this should just be 'to-statements' ........................
	ctx to-expr-or-block-statement a to-block-statement a.type
-to-block-statement js-block-statement(a js-expr-or-block-statement, type concrete-type)
	match a
	as js-expr
		a return-unless-void type.is-void
	as js-block-statement
		a

-return-unless-void js-block-statement(expr js-expr, is-void bool)
	if is-void
		expr to
	else
		expr.source gen-return expr to

-to-expr-or-block-statement js-expr-or-block-statement(ctx to-expr-ctx, a concrete-expr)
	source = ctx source a
	type = a type
	async = ctx is-cur-fun-async
	match x = a kind
	as array-op-concrete-expr
		input-expr = ctx to-js-expr x.input
		match x input-kind
		as array
			match x output-kind type
			as array
				# TODO: PERF I should probably not use 'map' here, do a loop like I do for range
				# `xs.map(x => {... })` or `await Array.fromAsync(xs, async x => { ... })`
				params js-params = if l ?= x local
					((ctx local-name l),) to
				body = ctx to-expr-or-block-statement x.body
				arrow js-arrow-function = async, params, body
				fn js-expr = source, arrow
				in-array-type = x.input.type js-array-type
				out-array-type = type js-array-type
				out-from js-expr data(x js-expr) = of input
					source gen-call-property-sync (source gen-global out-array-type.to), "from", (input,)
				match async
				as sync
					map js-expr data(x js-expr) = of input
						source gen-call-property-sync input, "map", (fn,)
					if in-array-type == out-array-type
						map[input-expr]
					elif in-array-type == Array
						out-from[map[input-expr]]
					else
						in-array = source gen-call-property-sync (source gen-global "Array"), "from", (input-expr,)
						out-from[map[in-array]]						
				as async
					mapped = source gen-await do source gen-call-property-sync (source gen-global "Array"), "fromAsync", (input-expr, fn)
					if out-array-type == Array
						mapped
					else
						out-from[mapped]
			as void
				local = ctx local-or-temp x.local, "ignore"
				(source, (local js-for-of-statement input-expr, (ctx to-block-statement x.body))) to
		as range
			low, high = x.input.type range-fields
			cur-name = ctx make-temp-local "cur"
			cur-type = low type
			end-name = ctx make-temp-local "end"
			get-cur = source gen-identifier cur-name
			get-end = source gen-identifier end-name
			cur-less-end = source gen-less get-cur, get-end
			match x output-kind type
			as array
				###
				const { low: start, high: end } = range
				const out = new Array(Number(end - start))
				let cur = start
				while (cur < end) {
					out[cur - start] = ...
					cur = cur + 1n
				}
				return out
				###
				start-name = ctx make-temp-local "start"
				get-start = source gen-identifier start-name
				out-name = ctx make-temp-local "out"
				get-out = source gen-identifier out-name
				range-destructure js-object-destructure =
					fields:
						- low.debug-name.to, start-name
						- high.debug-name.to, end-name
				declare-start-end = source gen-const range-destructure, (ctx to-js-expr x.input)
				Array = source array-for-array-type type
				Number = source gen-global "Number"
				size = source gen-call-sync Number, ((source gen-minus get-end, get-start),)
				new-array = source gen-new Array, (size,)
				declare-out = source gen-const out-name, new-array
				declare-cur = source gen-let cur-name, get-start
				body js-statement[] =
					out-at-index = source gen-property-access-computed get-out, (source gen-minus get-cur, get-start)
					-- if l ?= x local
						- source gen-const (ctx local-name l), get-cur
					- source gen-assign out-at-index, (ctx to-js-expr x.body)
					- source gen-increment cur-type, cur-name
				while_ = source gen-while cur-less-end, body.to
				return-out = source gen-return get-out
				(declare-start-end, declare-out, declare-cur, while_, return-out) js-block-statement
			as void
				range-destructure js-object-destructure = ((low.debug-name.to, cur-name), (high.debug-name.to, end-name)),
				declare-cur-end = source gen-let range-destructure, (ctx to-js-expr x.input)
				###
				let { low: cur, high:end } = range
				while (cur < end) {
					<<body>>
					cur = cur + 1n
				}
				###
				body js-statement[] =
					-- if l ?= x local
						- source gen-const (ctx local-name l), get-cur
					-- ctx to-block-statement x.body statements
					- source gen-increment cur-type, cur-name
				while_ = source gen-while cur-less-end, body.to
				(declare-cur-end, while_) js-block-statement
	as builtin-concrete-expr
		ctx translate-builtin type, source, x.fun, x.args
	as call-concrete-expr
		call-async = ctx is-async x.called
		called = ctx to-ref source, x.called, call-async
		source gen-call call-async, called, for arg in x args
			ctx to-js-expr arg
	as cast-concrete-expr
		ctx to-expr-or-block-statement x.inner
	as constant
		ctx.ctx translate-constant source, type, x
	as create-array-concrete-expr
		source array-literal type, for arg in x args
			ctx to-js-expr arg
	as create-record-concrete-expr
		record_ = ctx to-ref source, type
		source gen-new record_, for arg in x args
			ctx to-js-expr arg
	as create-union-concrete-expr
		ctx.ctx gen-create-union source, type, x.member-index, do ctx to-js-expr x.arg
	as drop-concrete-expr
		value = ctx to-js-expr x.arg
		source gen-unary void, value
	as finally-concrete-expr
		source gen-try-finally (ctx to-block-statement x.below), (ctx to-block-statement x.right) to
	as if-concrete-expr
		cond = ctx to-js-expr x.cond
		match ctx to-expr-or-block-statement x.then_
		as js-expr then_
			match else_ = ctx to-expr-or-block-statement x.else_
			as js-expr
				source gen-ternary cond, then_, else_
			as js-block-statement
				then-statement = then_ return-unless-void type.is-void
				source gen-if cond, then-statement, (source, else_) to
		as js-block-statement then_
			else_ = ctx to-block-statement x.else_
			source gen-if cond, then_, (source, else_) to
	as let-concrete-expr
		local = ctx local-name x.local
		value = ctx to-js-expr x.value
		kind = if x.local is-mutable then let else const
		then_ = ctx to-expr-or-block-statement x.then_
		ctx expr-or-block-statement-with-local kind, local, source, value, then_
	as lambda-concrete-expr
		params js-destructure[] = (ctx local-name x.param),
		body js-expr-or-block-statement = ctx to-expr-or-block-statement x.body
		arrow js-arrow-function = async, params.to, body
		source, arrow
	as local-get-concrete-expr
		ctx get-local source, x.local
	as local-set-concrete-expr
		source gen-assign (ctx get-local source, x.local), (ctx to-js-expr x.value) to
	as loop-concrete-expr
		###
		loop
			if x
				continue
			else
				break 42
		==>
		while (true) {
			if (x)
				continue
			else
				// In a void context, this will 'break' instead of 'return'
				return 42
		}
		###
		label js-name? = if type is-void then ctx make-temp-local "loop"
		prev = ctx cur-loop-label
		ctx.cur-loop-label := label
		res = source gen-while-true label, (ctx to-block-statement x.body)
		ctx.cur-loop-label := prev
		res to
	as loop-break-concrete-expr
		value = ctx to-block-statement x.value
		if type is-void
			value ~ (source gen-break ctx.cur-loop-label!)
		else
			value
	as loop-continue-concrete-expr
		source.gen-continue to
	as match-scalar-concrete-expr
		ctx translate-match-integral source, type, x
	as match-string-like-concrete-expr
		# TODO: write some unit tests. This should work the same as other types so I should just need to remove the assertion ...
		unless ctx.ctx is-string-or-symbol x.matched.type
			error log "Match on char8[] or char32[]?"
		assert ctx.ctx is-string-or-symbol x.matched.type else todo
		ctx with-temp-or-local "matched", x.matched, x.else_.local, of matched
			res mut = ctx to-block-statement x.else_.expr
			equals-async = ctx is-async x.equals
			equals = ctx to-ref source, x.equals, equals-async
			for case_ concrete-match-string-like-case in x.cases reverse # TODO: should not need type annotation
				value = ctx to-js-expr case_.value
				cond = source gen-call equals-async, equals, (matched, value)
				then_ = ctx to-block-statement case_.then_
				if_ = source gen-if cond, then_, (source, res)
				res := if_ to
			res
	as match-union-concrete-expr
		ctx translate-match-union source, type, x
	as record-field-get-concrete-expr
		source gen-property-access (ctx to-js-expr x.record_), x.field.debug-name.to
	as record-field-set-concrete-expr
		record_ = ctx to-js-expr x.record_
		value = ctx to-js-expr x.value
		access = source gen-property-access record_, x.field.debug-name.to
		source gen-assign access, value to
	as seq-concrete-expr
		:: js-block-statement
		- for* part in x.parts
			ctx to-block-statement part statements
	as throw-concrete-expr
		source gen-throw (ctx to-js-expr x.thrown) to
	as try-concrete-expr
		ctx translate-try source, type, x
	as try-let-concrete-expr
		ctx translate-try-let source, type, x
	as union-assume-case-concrete-expr
		match ctx union-representation x.arg.type
		as direct
			ctx to-expr-or-block-statement x.arg
		as switch
			source gen-property-access (ctx to-js-expr x.arg), "value"
	as var-get-concrete-expr
		if x.var var-needs-getter
			getter = source gen-identifier do ctx.ctx var-getter-name x.var
			source gen-call (ctx.ctx is-async-initializer x.var), getter, ()
		else
			ctx to-ref source, x.var
	as var-set-concrete-expr
		source gen-assign (ctx to-ref source, x.var), (ctx to-js-expr x.value) to

-gen-increment js-statement(source source, type concrete-type, name js-name)
	source gen-increment name, type.as-integral-type!.is-bigint

-gen-create-union js-expr(ctx to-js-ctx, source source, union_ concrete-type, member-index nat, value js-expr)
	match ctx union-representation union_
	as direct
		value
	as switch
		index = source gen-number64 member-index.to
		source gen-new (ctx to-ref source, union_), (index, value)

-var-needs-getter bool(a concrete-var)
	!(_ ?= a.initializer.kind constant)

-array-literal js-expr(source source, array-type concrete-type, elements js-expr[])
	array = source gen-array elements
	match array-type js-array-type
	as Array
		array
	else x
		source gen-new (source gen-global x.to), (array,)

-translate-match-integral js-expr-or-block-statement(ctx to-expr-ctx, source source, type concrete-type, a match-scalar-concrete-expr)
	case-exprs js-expr-or-block-statement[] = for e in a case-exprs
		ctx to-expr-or-block-statement e
	else_ = if e ?= a else_
		ctx to-expr-or-block-statement e.expr
	else
		source unreachable
	values js-expr[] = for value in a case-values
		source constant-integral a.matched-integral-type, value
	ctx with-temp-or-local "matched", a.matched, a.else_.?local, of matched
		match x = (case-exprs ~ else_) to-exprs-or-block-statements type
		as array
			res mut = x[end - 1]
			for i nat in 0 .. a.case-values.size reverse
				res := source gen-ternary (source gen-eq-eq-eq matched, values[i]), x[i], res
			res
		as block-statements
			cases js-switch-case[] = for i nat in 0 .. a.case-values.size
				- values[i]
				- source maybe-break-switch-case type, x.blocks[i]
			source gen-switch matched, cases, x.blocks[end - 1] to
-translate-match-union js-expr-or-block-statement(ctx to-expr-ctx, source source, type concrete-type, x match-union-concrete-expr)
	else_ = if e ?= x else_
		ctx to-expr-or-block-statement e.expr
	else
		source unreachable
	ctx with-temp-or-local "matched", x.matched, x.else_.?local, of matched
		ctx translate-match-union-inner source, type, matched, else_, x.union_, x.member-indices, x.cases, (ctx union-representation x.union-type)

-translate-match-union-inner js-expr-or-block-statement # TODO: inline? -----------------------------------------------------------------------------
	ctx to-expr-ctx
	source source
	type concrete-type
	matched js-expr
	else_ js-expr-or-block-statement
	union_ concrete-union
	member-indices indices
	cases concrete-local-and-expr[]
	repr union-representation
do
	###
	const matched = ...
	if (matched instanceof foo) {
		const x = matched
		...
	} else if (typeof matched === "number") {
		const x = matched
		...
	} else {
		...
	}
	###
	js-cases js-expr-or-block-statement[] = for case_ in cases
		ctx to-expr-or-block-statement case_.expr
	index = source gen-property-access matched, "index"
	get-cond js-expr mut(i nat) = of i
		member-index = member-indices[i]
		match repr
		as direct
			ctx.ctx gen-is-type! source, matched, union_.members[member-index]
		as switch
			source gen-eq-eq-eq index, do source gen-number64 member-index.to
	matched-value = match repr
	as direct
		matched
	as switch
		source gen-property-access matched, "value"
	match x = (js-cases ~ else_) to-exprs-or-block-statements type
	as array
		x.size is cases.size + 1
		res mut = x[cases size]
		for i nat in 0 .. cases.size reverse
			expr = if l ?= cases[i] local
				ctx add-local-and-assign source, (ctx local-name l), matched-value, x[i]
			else
				x[i]
			res := source gen-ternary get-cond[i], expr, res
		res
	as block-statements
		x.blocks.size is cases.size + 1
		res mut = x.blocks[cases size]
		for i nat in 0 .. cases.size reverse
			block = x.blocks[i]
			full-block = if l ?= cases[i] local
				(source gen-const (ctx local-name l), matched-value) ~ block
			else
				block
			res := source gen-if get-cond[i], full-block, (source, res) to
		res

-exprs-or-block-statements union(js-expr[], block-statements)
-block-statements record(blocks js-block-statement[])
-to-exprs-or-block-statements exprs-or-block-statements(a js-expr-or-block-statement[], type concrete-type)
	(a map-every of x then x js-expr)::js-expr[]? else
		(for x in a then x to-block-statement type) block-statements

-translate-try js-block-statement(ctx to-expr-ctx, source source, type concrete-type, a try-concrete-expr)
	###
	try
		tried
	catch foo x
		...
	==>
	try {
		tried()
	} catch (error) {
		if (error instanceof foo) {
			const x = error
			...
		} else {
			throw error
		}
	}
	###
	tried = ctx to-block-statement a.tried
	error = ctx local-or-temp a.catch-else.?local, "error"
	get-error = source gen-identifier error
	else-block = if e ?= a catch-else
		ctx to-block-statement e.expr
	else
		source gen-throw get-error to
	catch_ = ctx translate-match-union-inner source, type, get-error, else-block, \
		ctx.ctx.exception.body.concrete-union!, a.exception-member-indices, a.catch-cases, direct
	# catch_ will always be a block statement since the else-block is
	source gen-try-catch tried, error, catch_.js-block-statement! to

-translate-try-let js-block-statement(ctx to-expr-ctx, source source, type concrete-type, a try-let-concrete-expr)
	###
	x = try value catch err local then catch_
	after
	==>
	let local, ok
	try {
		local = value
		ok = true
	} catch (error) {
		if (error instanceof foo)
			const catch_local = error
			// For a void output, this won't return and will instead continue to the bottom. That's why it checks 'if (ok)'
			return catch_then
		} else {
			throw error
		}
	}
	if (ok) after
	###
	local js-name? = if l ?= a local
		ctx local-name l
	let-local js-statement[] = if l ?= local
		- source gen-let l
	# Only needed if void, otherwise 'catch_then' will return
	ok js-name? = if type is-void then ctx make-temp-local "ok"
	let-ok js-statement[] = if o ?= ok
		- source gen-let o
	tried js-statement[] =
		-- if l ?= local
			- source gen-assign l, (ctx to-js-expr a.value)
		else
			ctx to-block-statement a.value statements
		-- if x ?= ok
			- source gen-assign x, (source gen-bool true)
	error = ctx local-or-temp a.catch_.local, "error"
	get-error = source gen-identifier error
	instanceof-caught-type = ctx.ctx gen-is-type! source, get-error, do a caught-type ctx.ctx.exception
	catch_ = ctx to-block-statement a.catch_.expr
	if_ = source gen-if instanceof-caught-type, catch_, do source gen-throw get-error
	try_ = source gen-try-catch tried.to, error, if_.to
	then_ = ctx to-block-statement a.then_
	if-ok-then js-block-statement = if x ?= ok
		source gen-if (source gen-identifier x), then_ to
	else
		then_
	let-local.to ~~ let-ok.to ~~ try_.to ~~ if-ok-then

-maybe-break-switch-case js-block-statement(source source, type concrete-type, a js-block-statement)
	if type is-void
		a ~ source.gen-break-no-label
	else
		a

-get-local js-expr(ctx to-expr-ctx, source source, a concrete-local)
	source gen-identifier (ctx local-name a)
-local-name js-name(ctx to-expr-ctx, a concrete-local)
	index = ctx.temp-local-indices ensure a, of
		ctx.temp-local-indices size
	name = match x = a source
	as local
		x name
	as concrete-local-source-reference
		x.original name
	as concrete-generated-local-kind
		x to
	local, name.to, index

-local-or-temp js-name(ctx to-expr-ctx, a concrete-local?, temp-base-name string)
	if x ?= a
		ctx local-name x
	else
		ctx make-temp-local temp-base-name

-constant-getter js-fun-decl(ctx to-js-ctx, source source, a any-constant)
	comment: ""
	name: ctx.constant-names[a] constant
	memoize: memoize
	fun: sync, (), do ctx gen-init-constant source, a
-gen-init-constant js-expr(ctx to-js-ctx, source source, a any-constant)
	match a
	as single-constant-array
		elements = a elements
		element-type = a element-type
		source array-literal a.type,  for e in elements
			ctx translate-constant source, element-type, e
	as single-constant-record
		class_ = ctx to-ref source, a.type
		source gen-new class_, for field, arg in a.fields zip a.args
			ctx translate-constant source, field.type, arg

-translate-constant js-expr(ctx to-js-ctx, source source, type concrete-type, a constant)
	match x = type body
	as concrete-builtin-type
		ctx translate-constant-builtin source, type, x, a
	as concrete-enum
		source constant-integral x.storage_, a
	as struct-body-extern-java
		throw unreachable
	as concrete-flags
		source constant-integral x.storage_, a
	as concrete-record
		match a
		as constant-record
			source gen-get-constant do ctx.constant-names record-name type, a
		as constant-gc-safe-value
			source gen-null
		as constant-symbol
			source gen-identifier a.index.constant-symbol-name
		else
			throw unreachable
	as concrete-union
		match a
		as constant-union
			v = ctx.program.all-constants.unions[type]![a]
			case-type = type.body.concrete-union!.members[v member-index]
			ctx gen-create-union source, type, v.member-index,
				ctx translate-constant source, case-type, v.member
		as constant-gc-safe-value
			source gen-null
		else
			throw unreachable
	as concrete-type-body-deferred
		throw unreachable

-translate-constant-builtin js-expr(ctx to-js-ctx, source source, type concrete-type, builtin_ concrete-builtin-type, a constant)
	match builtin_ kind
	as array
		match a
		as constant-array
			source gen-get-constant do ctx.constant-names array-name type, a
		as constant-gc-safe-value
			source gen-null
		else
			throw unreachable
	as bool
		source gen-bool a.as-bool
	as char8
		source constant-integral nat8, a
	as char32
		source constant-integral nat32, a
	as float32
		source gen-number32 a.as-float
	as float64
		source gen-number64 a.as-float
	as future
		throw unreachable
	as int8
		source constant-integral int8, a
	as int16
		source constant-integral int16, a
	as int32
		source constant-integral int32, a
	as int64
		source constant-integral int64, a
	as js-any
		match a
		as constant-gc-safe-value
			source gen-null
		as constant-native-string
			source gen-string a.value
		as scalar-value
			source gen-number64 a.to
		else
			throw unreachable
	as fun-data
		throw unreachable
	as fun-mut
		throw unreachable
	as fun-shared
		throw unreachable
	as mut-slice
		match a
		as constant-gc-safe-value
			source gen-null
		else
			throw unreachable
	as nat8
		source constant-integral nat8, a
	as nat16
		source constant-integral nat16, a
	as nat32
		source constant-integral nat32, a
	as nat64
		source constant-integral nat64, a
	as option
		throw unreachable
	as void
		source gen-undefined
	as weak-ref
		assert _ ?= a constant-gc-safe-value
		source gen-null

-gen-get-constant js-expr(source source, name nat)
	source gen-call-sync (source gen-identifier name.constant), ()

-constant-integral js-expr(source source, type integral-type, a constant)
	source constant-integral type, match a
	as scalar-value
		a
	as constant-gc-safe-value
		0::nat to
	else
		throw unreachable
-constant-integral js-expr(source source, type char-or-integral-type, value scalar-value)
	source constant-integral type.as-integral, value
-constant-integral js-expr(source source, type integral-type, value scalar-value)
	if type is-signed
		if type is-bigint
			source gen-bigint-signed value.to::int64
		else
			source gen-number64 value.to::int64.to
	else
		if type is-bigint
			source gen-bigint-unsigned value.to::nat64
		else
			source gen-number64 value.to::nat64.to
-is-bigint bool(type integral-type)
	type == int64 or type == nat64

# TODO: use a 'with-block' --------------------------------------------------------------------------------------------------------------------------
-with-temp-or-local js-expr-or-block-statement
	ctx to-expr-ctx
	temp-base-name string
	expr concrete-expr
	root concrete-local?
	f js-expr-or-block-statement mut(get-temp js-expr)
do
	js-name = ctx local-or-temp root, temp-base-name
	ctx with-temp-common js-name, (ctx source expr), (ctx to-js-expr expr), f
-with-temp js-expr-or-block-statement
	ctx to-expr-ctx
	name string
	source source
	expr js-expr
	f js-expr-or-block-statement mut(get-temp js-expr)
do
	ctx with-temp-common (ctx make-temp-local name), source, expr, f
-make-temp-local js-name(ctx to-expr-ctx, base string)
	temp, base, ctx.take-next-temp-index 
-with-temp-common js-expr-or-block-statement
	ctx to-expr-ctx
	local js-name
	source source
	value js-expr
	f js-expr-or-block-statement mut(get-temp js-expr)
do
	ctx expr-or-block-statement-with-local const, local, source, value, f[source gen-identifier local]
-expr-or-block-statement-with-local js-expr-or-block-statement
	ctx to-expr-ctx
	kind js-var-decl-const
	local js-name
	source source
	value js-expr
	then_ js-expr-or-block-statement
do
	match then_
	as js-expr
		ctx add-local-and-assign source, local, value, then_
	as js-block-statement
		(source gen-var-decl kind, local, value) ~ then_

add-local-and-assign js-expr(ctx to-expr-ctx, source source, local js-name, value js-expr, then_ js-expr)
	ctx.top-declared-locals ~= local
	assign js-expr = source, (local js-assign-expr value)
	source gen-binary comma, assign, then_

| This function is run after an arithmetic operation to keep an integral type within its expected range.
-gen-as-integral js-expr(source source, type integral-type, arg js-expr)
	match type
	as int8
		source gen-shift-and-unshift arg, 24
	as int16
		source gen-shift-and-unshift arg, 16
	as int32
		source gen-binary bitwise-or, arg, do source gen-number64 0
	as int64
		source gen-as-int64 arg
	as nat8
		source gen-bitwise-and arg, do source gen-number64 type.max-value.to::float64
	as nat16
		source gen-bitwise-and arg, do source gen-number64 type.max-value.to::float64
	as nat32
		source gen-to-nat32 arg
	as nat64
		source gen-as-nat64 arg
-gen-to-nat32 js-expr(source source, arg js-expr)
	source gen-binary bit-shift-right-unsigned, arg, do source gen-number64 0
-gen-shift-and-unshift js-expr(source source, arg js-expr, amount float64)
	amount-expr = source gen-number64 amount
	x = source gen-binary bit-shift-left, arg, amount-expr
	source gen-binary bit-shift-right, x, amount-expr
-gen-as-int64 js-expr(source source, arg js-expr)
	BigInt = source gen-global "BigInt"
	source gen-call-property-sync BigInt, "asIntN", do (source gen-number64 64), arg
-gen-as-nat64 js-expr(source source, arg js-expr)
	BigInt = source gen-global "BigInt"
	source gen-call-property-sync BigInt, "asUintN", do (source gen-number64 64), arg

-gen-as-float32 js-expr(source source, arg js-expr)
	source gen-call-math "fround", arg

-gen-call-math js-expr(source source, name string, arg js-expr)
	source gen-call-math name, (arg,)
-gen-call-math js-expr(source source, name string, args js-expr[])
	source gen-call-property-sync (source gen-global "Math"), name, args

-gen-convert js-expr
	ctx to-expr-ctx
	source source
	size-bytes nat
	input-array-type string
	output-array-type string
	arg js-expr
do
	###
	const buf = new ArrayBuffer(size_bytes)
	(new InputArray(buf))[0] = arg
	return (new OutputArray(buf))[0]
	###
	buf-name = ctx make-temp-local "buf"
	buf = source gen-identifier buf-name
	ArrayBuffer = source gen-global "ArrayBuffer"
	new-buf = source gen-new ArrayBuffer, ((source gen-number64 size-bytes.to),)
	declare-buf = source gen-const buf-name, new-buf
	InputArray = source gen-global input-array-type
	OutputArray = source gen-global output-array-type
	input = source gen-subscript-zero (source gen-new InputArray, (buf,))
	assign-to-input = source gen-assign input, arg
	output = source gen-subscript-zero (source gen-new OutputArray, (buf,))
	return-output = source gen-return output
	source gen-iife sync, ((declare-buf, assign-to-input, return-output),)
-gen-subscript-zero js-expr(source source, arg js-expr)
	source gen-property-access-computed arg, (source gen-number64 0)

-gen-iife js-expr(source source, async sync-or-async, block js-block-statement)
	fn js-expr = source, (async js-arrow-function (), block)
	source gen-call async, fn, ()

-array-for-array-type js-expr(source source, array-type concrete-type)
	source array-for-element-type array-type.array-element-type
-array-for-element-type js-expr(source source, element concrete-type)
	source gen-global element.js-array-type-for-element-type.to

-js-array-type enum
	Array
	BigInt64Array
	BigUint64Array
	Int8Array
	Int16Array
	Int32Array
	Uint8Array
	Uint16Array
	Uint32Array
	Float32Array
	Float64Array
-== bool(a js-array-type, b js-array-type)
-to symbol(a js-array-type)
-to string(a js-array-type)
	a.to::symbol to
-js-array-type js-array-type(array-type concrete-type)
	array-type.array-element-type js-array-type-for-element-type
-js-array-type-for-element-type js-array-type(element concrete-type)
	match body = element body
	as concrete-builtin-type
		match body kind
		as array then Array
		as bool then Array
		as char8 then Uint8Array
		as char32 then Uint32Array
		as float32 then Float32Array
		as float64 then Float64Array
		as future then Array
		as int8 then Int8Array
		as int16 then Int16Array
		as int32 then Int32Array
		as int64 then BigInt64Array
		as js-any then Array
		as fun-data then Array
		as fun-mut then Array
		as fun-shared then Array
		as mut-slice then Array
		as nat8 then Uint8Array
		as nat16 then Uint16Array
		as nat32 then Uint32Array
		as nat64 then BigUint64Array
		as option then throw unreachable
		as void then Array
		as weak-ref then Array
	as concrete-enum
		body.storage_ array-for-integral-type
	as concrete-flags
		body.storage_ array-for-integral-type
	as concrete-record
		Array
	as concrete-union
		Array
	as struct-body-extern-java
		throw unreachable
	as concrete-type-body-deferred
		throw unreachable
-array-for-integral-type js-array-type(a integral-type)
	match a
	as int8
		Int8Array
	as int16
		Int16Array
	as int32
		Int32Array
	as int64
		BigInt64Array
	as nat8
		Uint8Array
	as nat16
		Uint16Array
	as nat32
		Uint32Array
	as nat64
		BigUint64Array
