import
	../../app/command
	../../frontend/show-model
	../../model/concrete-model
	../../model/model
	../../model/show-concrete-model
	../../model/source-range
	../../model/uri
	../../util/full-index-map
	../../util/perf
	../../util/util
	../util
	./js-ast
	./mangle-for-js
	./source-map
	./union-representation
	./write-js-ast

translate-to-js js-and-map
	model-program program-with-main
	program concrete-program
	show-ctx show-type-ctx
	sanity-checks sanity-checks
	source-map-name string?
do
	start = perf-now
	finally end-translate-to-js start
	ctx to-js-ctx =
		show-type-ctx: show-ctx
		program: program
		sanity-checks: sanity-checks
		union-info: plan-unions program
		mangled-names: build-mangled-names program
		constant-names: gen-constant-names program, show-ctx.show
	shebang shebang = node
	classes js-class-decl[] = for* type in program.all-non-extern-types
		from-option translate-type ctx, type
	functions js-fun-decl[] = with out in build
		for x in program.all-non-extern-funs
			out ~~= to-js-functions ctx, x
		for var in program.all-vars
			match var.kind
			as thread-local_
				throw todo
			as global_
				if var-needs-getter var
					out ~= gen-var-getter ctx, var
		each-constant-in-dependency-order show-ctx.show, program, of x
			# TODO: This is just an arbitrary source. there should be a way to have a null source?
			source = source ctx, program.common-funs.concrete-common-funs-js!.to-symbol-from-string
			out ~= constant-getter ctx, source, x

	vars js-var-decl[] = with out in build
		for var in program.all-vars
			match var.kind
			as thread-local_
				throw todo
			as global_
				if var-needs-getter var
					out ~= let, (js-name ctx, var), ()
				elif has-simple-initializer var
					out ~= gen-var-no-getter ctx, var
		to-symbol = program.common-funs.concrete-common-funs-js!.to-symbol-from-string
		source = source ctx, to-symbol
		to-symbol-ref = to-ref ctx, source, to-symbol, sync
		for index, sym in with-index program.all-constants.symbols
			args js-expr[] =
				- to-string-from-js-string ctx, source, gen-string source, sym.to
			out ~= const, index.constant-symbol-name, gen-call-sync source, to-symbol-ref, args
		for var in program.all-vars
			match var.kind
			as thread-local_
				throw todo
			as global_
				guard !var-needs-getter var and !has-simple-initializer var
				out ~= gen-var-no-getter ctx, var

	ast js-script-ast = shebang, classes, functions, vars,
		- gen-call-main ctx, program.common-funs.concrete-common-funs-js!.main 'to
	module-paths = module-paths model-program
	write-js-ast show-ctx, module-paths, ast, sanity-checks, source-map-name

# Emit vars with simple initializers before symbols (this happens to be the only kind of constants that requires)
-has-simple-initializer bool(a concrete-var)
	!!a.initializer.kind.constant.?scalar-value

-gen-var-no-getter js-var-decl(ctx to-js-ctx, var concrete-var)
	# TODO: actually detect whether it needs to be async --------------------------------------------------------------
	const: let
	destructure: js-name ctx, var
	initializer: to-js-expr (ctx, async, var.source.name), var.initializer

-gen-constant-names nat constant-names(program concrete-program, show-ctx show-ctx)
	out nat constant-names-builder = ()
	constant-index mut nat = 0
	each-constant-in-dependency-order show-ctx, program, of x
		out[x] := constant-index
		constant-index +:= 1
	finish out

-constant-symbol-name js-name(index nat)
	no-prefix "_symbol{index}"

-gen-call-main js-expr(ctx to-js-ctx, main concrete-fun)
	###
	main(typeof process === 'undefined' ? [] : process.argv.slice(2).map(x => toString(x)).then(exit => {
		if (exit !== 0n) process.exit(Number(exit))
	})
	###
	source = source ctx, main
	process = gen-global source, "process"
	argv =
		typeof-process = gen-typeof source, process
		process-is-undefined = gen-eq-eq-eq source, typeof-process, gen-string source, "undefined"
		empty-array = gen-array source, ()
		process-argv-slice =
			process-argv = gen-property-access source, process, "argv"
			gen-call-property-sync source, process-argv, "slice",
				- gen-number64 source, 2
		#to-string-from-js-string
		to-string-lambda =
			x = no-prefix "x"
			params js-params = (x,), ()
			gen-arrow-function source, sync, params,
				to-string-from-js-string ctx, source, gen-identifier source, x
		process-argv-mapped = gen-call-property-sync source, process-argv-slice, "map", (to-string-lambda,)
		gen-ternary source, process-is-undefined, empty-array, process-argv-mapped
	main-async sync-or-async = if ctx.async.funs[main] == always-async then async else sync
	call-main = gen-call-sync source, (to-ref ctx, source, main, main-async), (argv,)
	main-promise = match main-async
	as sync
		# TODO: this should be `Promise.resolve().then(() => main(process.argv))` to ensure exceptions are caught- ----------------------
		gen-call-property-sync source, (gen-global source, "Promise"), "resolve", (call-main,)
	as async
		call-main
	gen-call-property-sync source, main-promise, "then",
		exit js-name = no-prefix "exit"
		params js-params = (exit,), ()
		get-exit = gen-identifier source, exit
		exit-neq-0 = gen-not-eq-eq source, get-exit, gen-bigint-unsigned source, 0
		number-exit = gen-call-sync source, (gen-global source, "Number"), (get-exit,)
		call-exit = gen-call-property-sync source, process, "exit", (number-exit,)
		body = gen-if source, exit-neq-0, call-exit.to
		- gen-arrow-function source, sync, params, body.to

# TODO: this does expose the URIs on the build machine ......................................................................
-module-paths module-paths(program program-with-main)
	for uri, _ in program.program.all-modules
		uri, uri.to

-translate-type js-class-decl?(ctx to-js-ctx, a concrete-type)
	extends js-name? = if ctx.union-info.exception-case-types[a]
		js-name ctx, ctx.exception
	match body = a.body
	as concrete-builtin-type
		()
	as concrete-enum
		()
	as struct-body-extern-java
		throw unreachable
	as concrete-flags
		()
	as concrete-record
		class-for-record ctx, a, extends, body
	as concrete-union
		class-for-union ctx, a, extends
	as concrete-type-body-deferred
		throw unreachable

-gen-is-type js-expr?(ctx to-js-ctx, source source, get js-expr, a concrete-type)
	match x = a.body
	as concrete-builtin-type
		gen-is-builtin-type source, get, x
	as concrete-enum
		gen-is-nat source, get, x.storage
	as struct-body-extern-java
		gen-bool source, false
	as concrete-flags
		gen-is-nat source, get, x.storage
	as concrete-record
		gen-instanceof source, get, to-ref ctx, source, a
	as concrete-union
		()
	as concrete-type-body-deferred
		throw unreachable

-gen-type-assert js-statement?(ctx to-js-ctx, source source, get js-expr, a concrete-type)
	guard ctx.sanity-checks == all-sanity-checks
	guard is-type = gen-is-type ctx, source, get, a
	# Allow 'gc-safe-value'
	is-type-or-null = gen-or source, is-type, gen-eq-eq-eq source, get, source.gen-null
	gen-call-sync source, (gen-identifier source, "_assert".no-prefix), (is-type-or-null,) 'to

-gen-is-builtin-type js-expr?(source source, get js-expr, a concrete-builtin-type)
	instanceof js-expr mut(x string) = of x
		gen-instanceof source, get, gen-identifier source, x.no-prefix
	typeof js-expr mut(x string) = of x
		gen-typeof-is source, get, x
	array js-expr mut() = of
		instanceof[a.type-args.only!.js-array-type-for-element-type.to]
	match a.kind
	as array
		array[]
	as bool
		typeof["boolean"]
	as char8
		typeof["number"]
	as char32
		typeof["number"]
	as float32
		typeof["number"]
	as float64
		typeof["number"]
	as fun-data
		typeof["function"]
	as fun-mut
		typeof["function"]
	as fun-shared
		typeof["function"]
	as future
		instanceof["Promise"]
	as int8
		typeof["number"]
	as int16
		typeof["number"]
	as int32
		typeof["number"]
	as int64
		typeof["bigint"]
	as js-any
		()
	as mut-slice
		array[]
	as nat8
		typeof["number"]
	as nat16
		typeof["number"]
	as nat32
		typeof["number"]
	as nat64
		typeof["bigint"]
	as option
		throw unreachable
	as void
		typeof["undefined"]
	as weak-ref
		instanceof["WeakRef"]

-gen-is-nat js-expr(source source, get js-expr, type nat-type)
	gen-typeof-is source, get, match type
	as nat8
		"number"
	as nat16
		"number"
	as nat32
		"number"
	as nat64
		"bigint"

-gen-typeof-is js-expr(source source, get js-expr, expected string)
	gen-eq-eq-eq source, (gen-typeof source, get), (gen-string source, expected)

-unreachable js-expr(source source)
	gen-call-sync source, (gen-identifier source, "_unreachable".no-prefix), ()

-source source(ctx to-js-ctx, a concrete-type)
	range uri-and-range = a.source.range
	uri: range.uri
	name: show-concrete-type ctx.show-ctx, a 'to
	pos: ctx.line-and-character-getters[range].range.start
-source source(ctx to-js-ctx, a concrete-fun)
	range = a.range
	range.uri, (debug-name ctx, a), ctx.line-and-character-getters[range].range.start
-source source(ctx to-js-ctx, a concrete-var)
	range = a.range
	range.uri, a.source.name, ctx.line-and-character-getters[range].range.start
-debug-name symbol(ctx to-js-ctx, a concrete-fun)
	show-concrete-fun-name ctx.show-ctx, a 'to

-class-for-record js-class-decl
	ctx to-js-ctx
	a concrete-type
	extends js-name?
	r concrete-record
do
	###
	class R {
		constructor(x, y) {
			if (!(x instanceof Whataver)) throw new Error()
			this.x = x
			this.y = y
		}
	}
	###
	source = source ctx, a
	names string[] = map r.fields, it.debug-name.to
	comment: show-concrete-type ctx.show-ctx, a
	name: js-name ctx, a
	extends: extends
	members: unless is-empty r.fields
		- gen-constructor source, !!extends, names, of index, get
			gen-type-assert ctx, source, get, r.fields[index].type

-class-for-union js-class-decl?(ctx to-js-ctx, a concrete-type, extends js-name?)
	match union-representation ctx, a
	as direct
		if a == ctx.exception
			name = js-name ctx, a
			forbid extends
			comment: ""
			name: name
			extends: no-prefix "Error"
			members:
				-
					source = source ctx, a
					source: source
					is-static: instance
					name: "message"
					kind:
						# return new TextDecoder().decode(show(this).chars)
						show-exception = to-ref ctx, source, ctx.program.common-funs.show-exception, sync
						js-class-getter gen-block-statement
							- gen-return source, convert-to-js-string source,
								gen-call-sync source, show-exception,
									- gen-this source
	as switch
		###
		class U {
			constructor(index, value) {
				this.index = index
				this.value = value
			}
		}
		###
		comment: show-concrete-type ctx.show-ctx, a
		name: js-name ctx, a
		extends: extends
		members:
			- gen-constructor (source ctx, a), !!extends, ("index", "value"), it.noop

-gen-constructor js-class-member
	source source
	call-super bool
	names string[]
	check-field js-statement? mut(index nat, value js-expr)
do
	params js-destructure[] = map names, it.no-prefix
	this = gen-this source
	identifiers js-expr[] = for name in names
		gen-identifier source, name.no-prefix
	statements js-statement[] =
		-- if call-super
			- gen-call-sync source, (gen-global source, "super"), () 'to
		-- for* index, value in with-index identifiers
			from-option check-field[index, value]
		-- for name, identifier in zip names, identifiers
			this_x = gen-property-access source, this, name
			gen-assign source, this_x, identifier
	kind = js-class-method sync, params.to, statements.to
	source, instance, "constructor", kind

-js-name js-name(ctx to-js-ctx, fun concrete-fun, async sync-or-async)
	no-prefix ctx.mangled-names[fun, async]
-js-name js-name(ctx to-js-ctx, var concrete-var)
	no-prefix ctx.mangled-names[var]
-var-getter-name js-name(ctx to-js-ctx, var concrete-var)
	no-prefix "_varget_{ctx.mangled-names[var]}"
-js-name js-name(ctx to-js-ctx, type concrete-type)
	no-prefix ctx.mangled-names[type]
-to-ref js-expr(ctx to-js-ctx, source source, fun concrete-fun, async sync-or-async)
	gen-identifier source, js-name ctx, fun, async
-to-ref js-expr(ctx to-js-ctx, source source, var concrete-var)
	gen-identifier source, js-name ctx, var
-to-ref js-expr(ctx to-js-ctx, source source, type concrete-type)
	gen-identifier source, js-name ctx, type

-to-js-ctx record
	show-type-ctx show-type-ctx
	program concrete-program
	sanity-checks sanity-checks
	union-info union-info
	mangled-names js-mangled-names
	constant-names nat constant-names
-show-ctx show-ctx(a to-js-ctx)
	a.show-type-ctx.show
-line-and-character-getters line-and-character-getters(a to-js-ctx)
	a.show-ctx.line-and-character-getters
-common-funs concrete-common-funs-js(a to-js-ctx)
	a.program.common-funs.concrete-common-funs-js!
-exception concrete-type(a to-js-ctx)
	a.common-funs.exception
-string concrete-type(a to-js-ctx)
	a.common-funs.string
-symbol concrete-type(a to-js-ctx)
	a.common-funs.symbol
-is-string-or-symbol bool(ctx to-js-ctx, a concrete-type)
	a == ctx.string or a == ctx.symbol
-async concrete-async-info(ctx to-js-ctx)
	ctx.program.async!

-to-expr-ctx record mut
	ctx to-js-ctx
	is-cur-fun-async sync-or-async
	cur-fun-debug-name symbol
	cur-loop-label mut js-name?
	top-declared-locals js-name mut[]
	temp-local-indices nat mut[concrete-local]
	next-generated-temp-index mut nat
-with-expr-ctx record(ctx to-js-ctx, is-cur-fun-async sync-or-async, cur-fun-debug-name symbol)
-to-js-expr js-expr(a with-expr-ctx, expr concrete-expr)
	locals, js-expr = with expr-ctx in a
		to-expr-or-block-statement expr-ctx, expr
	source = source a.ctx, expr, a.cur-fun-debug-name
	to-expr a.is-cur-fun-async, source, with-declare-locals source, locals, js-expr
-with-declare-locals js-expr-or-block-statement(source source, locals js-name[], expr js-expr-or-block-statement)
	if is-empty locals
		expr
	else
		block js-block-statement = match expr
		as js-expr
			gen-return source, expr 'to
		as js-block-statement
			expr
		decl js-var-decl = let, for x in locals then x, ()
		(source, decl) ~ block
-with-block[t] (js-name[], t)(a with-expr-ctx, f t mut(x to-expr-ctx))
	expr-ctx to-expr-ctx =
		ctx: a.ctx
		is-cur-fun-async: a.is-cur-fun-async
		cur-fun-debug-name: a.cur-fun-debug-name
		cur-loop-label: ()
		top-declared-locals: ()
		temp-local-indices: ()
		next-generated-temp-index: ()
	res = f[expr-ctx]
	expr-ctx.top-declared-locals.move-to, res
-take-next-temp-index nat(a to-expr-ctx)
	res = a.next-generated-temp-index
	a.next-generated-temp-index +:= 1
	res
-to-ref js-expr(ctx to-expr-ctx, source source, fun concrete-fun, async sync-or-async)
	to-ref ctx.ctx, source, fun, async
-to-ref js-expr(ctx to-expr-ctx, source source, var concrete-var)
	to-ref ctx.ctx, source, var
-to-ref js-expr(ctx to-expr-ctx, source source, type concrete-type)
	to-ref ctx.ctx, source, type
-union-representation union-representation(a to-js-ctx, union_ concrete-type)
	union-representation a.union-info, union_
-union-representation union-representation(a to-expr-ctx, union_ concrete-type)
	union-representation a.ctx, union_

-source source(ctx to-expr-ctx, a concrete-expr)
	source ctx.ctx, a, ctx.cur-fun-debug-name
-source source(ctx to-js-ctx, a concrete-expr, cur-fun-debug-name symbol)
	range = a.range
	uri: range.uri
	name: cur-fun-debug-name
	pos: ctx.show-ctx.line-and-character-getters[range].range.start

-is-async sync-or-async(ctx to-expr-ctx, a concrete-fun)
	if ctx.ctx.async.funs[a]
		ctx.is-cur-fun-async
	else
		sync
-is-async-initializer sync-or-async(ctx to-js-ctx, a concrete-var)
	if ctx.async.var-initializers[a] then async else sync

-gen-var-getter js-fun-decl(ctx to-js-ctx, a concrete-var)
	async = is-async-initializer ctx, a
	name = var-getter-name ctx, a
	initializer = to-js-expr (ctx, async, a.source.name), a.initializer
	###
	if (x === undefined) x = initializer
	return x
	###
	source source = source ctx, a
	x = to-ref ctx, source, a
	body js-statement[] =
		x-eq-undefined = gen-eq-eq-eq source, x, source.gen-undefined
		initialize = gen-assign source, x, initializer
		- gen-if source, x-eq-undefined, initialize.to
		- gen-return source, x
	"", name, no-memoize, (async, (), body.to)

-to-js-functions js-fun-decl[](ctx to-js-ctx, a concrete-fun)
	if x = ctx.async.funs[a]
		match x
		as always-async
			- to-js-function ctx, a, async
		as sync-and-async
			- to-js-function ctx, a, sync
			- to-js-function ctx, a, async
	else
		- to-js-function ctx, a, sync
-to-js-function js-fun-decl(ctx to-js-ctx, a concrete-fun, async sync-or-async)
	name = js-name ctx, a, async
	params mut js-destructure[] = ()
	locals, body = with expr-ctx in with-expr-ctx ctx, async, debug-name ctx, a
		params := for param in a.params
			local-name expr-ctx, param
		to-expr-or-block-statement expr-ctx, a
	comment: show-concrete-fun-name ctx.show-ctx, a
	name: name
	memoize: no-memoize
	fun:
		async: async
		params: params, ()
		body: with-declare-locals (source ctx, a), locals, body

-to-expr-or-block-statement js-expr-or-block-statement(ctx to-expr-ctx, a concrete-fun)
	source = source ctx.ctx, a
	match body = a.body
	as concrete-fun-body-builtin
		translate-builtin ctx, a.return-type, source, body.kind, for param in a.params
			param.type, a.range, param.local-get-concrete-expr # TODO: use param range, not a.range ---------------------------------------
	as concrete-expr
		res = to-expr-or-block-statement ctx, body
		type-asserts js-statement[] = unless ctx.ctx.sanity-checks == no-sanity-checks
			for* param in a.params
				from-option gen-type-assert ctx.ctx, source, (get-local ctx, source, param), param.type
		if is-empty type-asserts
			res
		else
			(type-asserts,) ~~ (to-block-statement res, a.return-type)
	as fun-body-extern-java
		throw unreachable
	as concrete-fun-body-method
		throw todo
	as concrete-fun-body-deferred
		throw unreachable
	as concrete-fun-body-always-inline
		throw unreachable

-translate-builtin js-expr-or-block-statement
	ctx to-expr-ctx
	type concrete-type
	source source
	fun builtin-fun
	args concrete-expr[]
do
	arg-exprs js-expr[] mut() = of
		map args, of arg
			to-js-expr ctx, arg
	match fun
	as builtin-unary
		translate-builtin-unary ctx, type, source, fun, args.only!.type, arg-exprs[].only!
	as builtin-binary
		translate-builtin-binary source, type, fun, args[0].type, only2! arg-exprs[]
	as builtin-ternary
		translate-builtin-ternary source, fun, only3! arg-exprs[]
	as builtin-fun-call-lambda
		arg0, arg1 = only2! arg-exprs[]
		call = gen-call-sync source, arg0, (arg1,)
		gen-await-if-async source, ctx.is-cur-fun-async, call
	as builtin-fun-constant
		throw unreachable
	as builtin-fun-is-empty-type
		throw unreachable
	as builtin-fun-is-target
		throw unreachable
	as js-fun
		translate-js-fun ctx, source, fun, args

-translate-builtin-unary js-expr-or-block-statement
	ctx to-expr-ctx
	type concrete-type
	source source
	a builtin-unary
	arg-type concrete-type
	arg js-expr
do
	unary js-expr mut(op js-unary-kind) = of op
		gen-unary source, op, arg
	match a
	as array-size
		# BigInt(arg.length)
		BigInt = gen-global source, "BigInt"
		length = gen-property-access source, arg, "length"
		gen-call-sync source, BigInt, (length,)
	as bits-of-float32
		gen-convert ctx, source, 4, "Float32Array", "Uint32Array", arg
	as bits-of-float64
		gen-convert ctx, source, 8, "Float64Array", "BigInt64Array", arg
	as bitwise-not
		gen-as-integral source, type.as-integral-type!, unary[bitwise-not]
	as float32-from-bits
		Number = gen-global source, "Number"
		gen-convert ctx, source, 4, "Uint32Array", "Float32Array",
			gen-call-sync source, Number, (arg,)
	as float64-from-bits
		gen-convert ctx, source, 8, "BigInt64Array", "Float64Array", arg
	as gc-safe-mut-slice
		array-type = js-array-type type
		array = gen-new source, (gen-global source, array-type.to),
			- gen-call-sync source, (gen-global source, "Number"), (arg,)
		match array-type
		as Array
			# In JS, a 'new Array' has *missing* values, which perform worse than null values
			gen-call-property-sync source, array, "fill",
				- gen-null source
		else
			# All other array types have sensible default values
			# new Uint8Array(size)
			array
	as not
		gen-not source, arg
	as reinterpret-cast
		arg
	as to-float32-from-float64
		gen-as-float32 source, arg
	as to-float64-from-float32
		arg
	as to-float64-from-int64
		gen-call-sync source, (gen-global source, "Number"), (arg,)
	as to-float64-from-nat64
		gen-call-sync source, (gen-global source, "Number"), (arg,)
	as truncate-to-int64-from-float64
		trunc = gen-call-math source, "trunc", arg
		gen-call-sync source, (gen-global source, "BigInt"), (trunc,)
	as weak-ref-get
		###
		const got = arg?.get()
		return got === undefined ? new Option(0) : new Option(1, got)
		###
		arg-get js-expr = gen-optional-call-property-sync source, arg, "deref", ()
		with-temp ctx, "got", source, arg-get, of got
			got-eq-undefined = gen-eq-eq-eq source, got, source.gen-undefined
			none-type = type.body.concrete-union!.members[0]
			new-none = gen-new source, (to-ref ctx, source, none-type), () # TODO:PERF don't construct it every time ------------
			none = gen-create-union ctx.ctx, source, type, 0, new-none
			some = gen-create-union ctx.ctx, source, type, 1, got
			gen-ternary source, got-eq-undefined, none, some
	as weak-ref-new
		WeakRef = gen-global source, "WeakRef"
		gen-new source, WeakRef, (arg,)
	as wrap-convert-integral
		out = as-integral-type-allow-char! type
		if is-bool arg-type
			name string = if is-64-bit out then "BigInt" else "Number"
			gen-call-sync source, (gen-identifier source, name.no-prefix), (arg,)
		else
			in_ = as-integral-type-allow-char! arg-type
			gen-as-integral source, out, if is-64-bit in_
				if is-64-bit out
					arg
				else
					gen-call-sync source, (gen-global source, "Number"), (arg,)
			else
				if is-64-bit out
					gen-call-sync source, (gen-global source, "BigInt"), (arg,)
				else
					arg

-translate-builtin-binary js-expr-or-block-statement
	source source
	type concrete-type
	a builtin-binary
	arg0-type concrete-type
	(arg0 js-expr, arg1 js-expr)
do
	binary js-expr data(op js-binary-kind) = of op
		gen-binary source, op, arg0, arg1
	bitwise js-expr data(op js-binary-kind) = of op
		res = binary[op]
		if is-nat32 type then gen-to-nat32 source, res else res
	match a
	as add-float
		match as-float-type! type
		as float32
			# Need to convert to float32
			gen-as-float32 source, binary[plus]
		as float64
			binary[plus]
	as array-get
		gen-property-access-computed source, arg0, arg1
	as bitwise-and
		bitwise[bitwise-and]
	as bitwise-or
		bitwise[bitwise-or]
	as bitwise-xor
		bitwise[bitwise-xor]
	as compare
		name string = if is-float32-or-64 arg0-type then "_compareFloat" else "_compareIntegral"
		gen-call-sync source, (gen-identifier source, name.no-prefix), (arg0, arg1)
	as equal-exact
		gen-call-property-sync source, (gen-global source, "Object"), "is", (arg0, arg1)
	as equal-float-ieee
		binary[eq-eq-eq]
	as less-float-ieee
		binary[less]
	as mul-float
		match as-float-type! type
		as float32
			gen-as-float32 source, binary[times]
		as float64
			binary[times]
	as sub-float
		match as-float-type! type
		as float32
			gen-as-float32 source, binary[minus]
		as float64
			binary[minus]
	as unsafe-bit-shift-left
		match as-integral-type! type
		as nat32
			gen-to-nat32 source, binary[bit-shift-left]
		as nat64
			gen-as-nat64 source, binary[bit-shift-left]
		else
			throw unreachable
	as unsafe-bit-shift-right
		match as-integral-type! type
		as nat32
			gen-to-nat32 source, binary[bit-shift-right-unsigned]
		as nat64
			gen-as-nat64 source, binary[bit-shift-right]
		else
			throw unreachable
	as unsafe-div
		if f = as-float-type type
			match f
			as float32
				gen-as-float32 source, binary[divide]
			as float64
				binary[divide]
		else
			assert as-integral-type type
			binary[divide]
	as unsafe-mod-float64
		binary[modulo]
	as unsafe-mod-nat64
		binary[modulo]
	as wrap-add
		gen-as-integral source, type.as-integral-type!, binary[plus]
	as wrap-mul
		gen-as-integral source, type.as-integral-type!, binary[times]
	as wrap-sub
		gen-as-integral source, type.as-integral-type!, binary[minus]

-translate-builtin-ternary js-expr-or-block-statement(source source, a builtin-ternary, (arg0 js-expr, arg1 js-expr, arg2 js-expr))
	match a
	as array-set
		access = gen-property-access-computed source, arg0, arg1
		gen-assign source, access, arg2 'to

-translate-js-fun js-expr-or-block-statement(ctx to-expr-ctx, source source, a js-fun, args concrete-expr[])
	arg0 js-expr mut() = of
		to-js-expr ctx, args[0]
	args-after js-expr[] mut(first nat) = of first
		for arg in args[first .. end]
			to-js-expr ctx, arg
	only-arg js-expr mut() = of
		to-js-expr ctx, only! args
	only2-args (js-expr, js-expr) mut() = of
		x, y = only2! args
		- to-js-expr ctx, x
		- to-js-expr ctx, y
	unary js-expr mut(kind js-unary-kind) = of kind
		gen-unary source, kind, only-arg[]
	binary js-expr mut(kind js-binary-kind) = of kind
		gen-binary source, kind, only2-args[]
	prop01 js-expr mut() = of
		property-access ctx, source, args[0], args[1]
	match a
	as await
		gen-await source, only-arg[]
	as call
		gen-call-sync source, arg0[], args-after[1]
	as call-new
		gen-new source, arg0[], args-after[1]
	as call-property
		gen-call-sync source, prop01[], args-after[2]
	as call-property-spread
		args.size is 3
		gen-call-with-spread source, sync, prop01[], (), (to-js-expr ctx, args[2])
	as eq-eq-eq
		binary[eq-eq-eq]
	as eval
		gen-call-sync source, (gen-global source, "eval"),
			- only-arg[]
	as get
		args.size is 2
		prop01[]
	as import_
		gen-call-sync source, (gen-global source, "import"), (only-arg[],)
	as instanceof
		binary[instanceof]
	as js-global
		global_ = gen-global source, "_global" # This is generated at top of write-js-ast
		match size args
		as 0
			global_
		as 1
			gen-property-access-computed source, global_, only-arg[]
		else
			throw unreachable
	as null
		gen-null source
	as plus
		binary[plus]
	as set
		args.size is 3
		gen-assign source, prop01[], (to-js-expr ctx, args[2]) 'to
	as typeof
		unary[typeof]
	as undefined
		gen-undefined source

-property-access js-expr(ctx to-expr-ctx, source source, object concrete-expr, key concrete-expr)
	assert is-js-any key.type
	gen-property-access-computed source, (to-js-expr ctx, object), (to-js-expr ctx, key)

-to-string-from-js-string js-expr(ctx to-js-ctx, source source, arg js-expr)
	gen-call-sync source, (to-ref ctx, source, ctx.common-funs.to-string-from-js-any, sync), (arg,)

-convert-to-js-string js-expr(source source, arg js-expr)
	# TODO: just have this call 'to-js-string' from string.crow! ------------------------------------------------------------------
	# new TextDecoder().decode(new Uint8Array(arg.chars.map(Number)))
	TextDecoder = gen-global source, "TextDecoder"
	text-decoder = gen-new source, TextDecoder, ()
	gen-call-property-sync source, text-decoder, "decode",
		Uint8Array = gen-global source, "Uint8Array"
		- gen-new source, Uint8Array,
			chars = gen-property-access source, arg, "chars"
			- gen-call-property-sync source, chars, "map",
				- gen-global source, "Number"

-to-js-expr js-expr(ctx to-expr-ctx, a concrete-expr)
	to-expr ctx, (source ctx, a), to-expr-or-block-statement ctx, a

-to-expr js-expr(ctx to-expr-ctx, source source, a js-expr-or-block-statement)
	to-expr ctx.is-cur-fun-async, source, a
-to-expr js-expr(is-cur-fun-async sync-or-async, source source, a js-expr-or-block-statement)
	match a
	as js-expr
		a
	as js-block-statement
		gen-iife source, is-cur-fun-async, a

-to-block-statement js-block-statement(ctx to-expr-ctx, a concrete-expr) # TODO: this should just be 'to-statements' ........................
	to-expr-or-block-statement ctx, a 'to-block-statement a.type
-to-block-statement js-block-statement(a js-expr-or-block-statement, type concrete-type)
	match a
	as js-expr
		return-unless-void a, type.is-void
	as js-block-statement
		a

-return-unless-void js-block-statement(expr js-expr, is-void bool)
	if is-void
		expr.to
	else
		gen-return expr.source, expr 'to

-to-expr-or-block-statement js-expr-or-block-statement(ctx to-expr-ctx, a concrete-expr)
	source = source ctx, a
	type = a.type
	async = ctx.is-cur-fun-async
	match x = a.kind
	as array-op-concrete-expr
		input-expr = to-js-expr ctx, x.input
		match x.input-kind
		as array
			match output-kind x, type
			as array
				# TODO: PERF I should probably not use 'map' here, do a loop like I do for range
				# `xs.map(x => {... })` or `await Array.fromAsync(xs, async x => { ... })`
				params js-params = if l = x.local
					((local-name ctx, l),).to
				body = to-expr-or-block-statement ctx, x.body
				arrow js-arrow-function = async, params, body
				fn js-expr = source, arrow
				in-array-type = x.input.type.js-array-type
				out-array-type = type.js-array-type
				out-from js-expr data(x js-expr) = of input
					gen-call-property-sync source, (gen-global source, out-array-type.to), "from", (input,)
				match async
				as sync
					map js-expr data(x js-expr) = of input
						gen-call-property-sync source, input, "map", (fn,)
					if in-array-type == out-array-type
						map[input-expr]
					elif in-array-type == Array
						out-from[map[input-expr]]
					else
						in-array = gen-call-property-sync source, (gen-global source, "Array"), "from", (input-expr,)
						out-from[map[in-array]]
				as async
					mapped = gen-await source, gen-call-property-sync source, (gen-global source, "Array"), "fromAsync", (input-expr, fn)
					if out-array-type == Array
						mapped
					else
						out-from[mapped]
			as void
				local = local-or-temp ctx, x.local, "ignore"
				(source, (js-for-of-statement local, input-expr, (to-block-statement ctx, x.body))) 'to
		as range
			low, high = range-fields x.input.type
			cur-name = make-temp-local ctx, "cur"
			cur-type = low.type
			end-name = make-temp-local ctx, "end"
			get-cur = gen-identifier source, cur-name
			get-end = gen-identifier source, end-name
			cur-less-end = gen-less source, get-cur, get-end
			match output-kind x, type
			as array
				###
				const { low: start, high: end } = range
				const out = new Array(Number(end - start))
				let cur = start
				while (cur < end) {
					out[cur - start] = ...
					cur = cur + 1n
				}
				return out
				###
				start-name = make-temp-local ctx, "start"
				get-start = gen-identifier source, start-name
				out-name = make-temp-local ctx, "out"
				get-out = gen-identifier source, out-name
				range-destructure js-object-destructure =
					fields:
						- low.debug-name.to, start-name
						- high.debug-name.to, end-name
				declare-start-end = gen-const source, range-destructure, (to-js-expr ctx, x.input)
				Array = array-for-array-type source, type
				Number = gen-global source, "Number"
				size = gen-call-sync source, Number, ((gen-minus source, get-end, get-start),)
				new-array = gen-new source, Array, (size,)
				declare-out = gen-const source, out-name, new-array
				declare-cur = gen-let source, cur-name, get-start
				body js-statement[] =
					out-at-index = gen-property-access-computed source, get-out, (gen-minus source, get-cur, get-start)
					-- if l = x.local
						- gen-const source, (local-name ctx, l), get-cur
					- gen-assign source, out-at-index, (to-js-expr ctx, x.body)
					- gen-increment source, cur-type, cur-name
				while_ = gen-while source, cur-less-end, body.to
				return-out = gen-return source, get-out
				js-block-statement (declare-start-end, declare-out, declare-cur, while_, return-out)
			as void
				range-destructure js-object-destructure =
					fields:
						- low.debug-name.to, cur-name
						- high.debug-name.to, end-name
				declare-cur-end = gen-let source, range-destructure, to-js-expr ctx, x.input
				###
				let { low: cur, high:end } = range
				while (cur < end) {
					<<body>>
					cur = cur + 1n
				}
				###
				body js-statement[] =
					-- if l = x.local
						- gen-const source, (local-name ctx, l), get-cur
					-- statements to-block-statement ctx, x.body
					- gen-increment source, cur-type, cur-name
				while_ = gen-while source, cur-less-end, body.to
				js-block-statement (declare-cur-end, while_)
	as builtin-concrete-expr
		translate-builtin ctx, type, source, x.fun, x.args
	as call-concrete-expr
		call-async = is-async ctx, x.called
		called = to-ref ctx, source, x.called, call-async
		gen-call source, call-async, called, for arg in x.args
			to-js-expr ctx, arg
	as cast-concrete-expr
		to-expr-or-block-statement ctx, x.inner
	as constant
		translate-constant ctx.ctx, source, type, x
	as create-array-concrete-expr
		array-literal source, type, for arg in x.args
			to-js-expr ctx, arg
	as create-record-concrete-expr
		record_ = to-ref ctx, source, type
		gen-new source, record_, for arg in x.args
			to-js-expr ctx, arg
	as create-union-concrete-expr
		gen-create-union ctx.ctx, source, type, x.member-index, to-js-expr ctx, x.arg
	as drop-concrete-expr
		value = to-js-expr ctx, x.arg
		gen-unary source, void, value
	as finally-concrete-expr
		gen-try-finally source, (to-block-statement ctx, x.below), (to-block-statement ctx, x.right) 'to
	as if-concrete-expr
		cond = to-js-expr ctx, x.cond
		match then_ = to-expr-or-block-statement ctx, x.then_
		as js-expr
			match else_ = to-expr-or-block-statement ctx, x.else_
			as js-expr
				gen-ternary source, cond, then_, else_
			as js-block-statement
				then-statement = return-unless-void then_, type.is-void
				gen-if source, cond, then-statement, (source, else_) 'to
		as js-block-statement
			else_ = to-block-statement ctx, x.else_
			gen-if source, cond, then_, (source, else_) 'to
	as let-concrete-expr
		local = local-name ctx, x.local
		value = to-js-expr ctx, x.value
		kind js-var-decl-const = if is-mutable x.local then let else const
		then_ = to-expr-or-block-statement ctx, x.then_
		expr-or-block-statement-with-local ctx, kind, local, source, value, then_
	as lambda-concrete-expr
		source: source
		kind:
			:: js-arrow-function
			async: async
			params: (local-name ctx, x.param), 'to
			body: to-expr-or-block-statement ctx, x.body
	as local-get-concrete-expr
		get-local ctx, source, x.local
	as local-set-concrete-expr
		gen-assign source, (get-local ctx, source, x.local), (to-js-expr ctx, x.value) 'to
	as loop-concrete-expr
		###
		loop
			if x
				continue
			else
				break 42
		==>
		while (true) {
			if (x)
				continue
			else
				// In a void context, this will 'break' instead of 'return'
				return 42
		}
		###
		label js-name? = if is-void type then make-temp-local ctx, "loop"
		prev = ctx.cur-loop-label
		ctx.cur-loop-label := label
		res = gen-while-true source, label, to-block-statement ctx, x.body
		ctx.cur-loop-label := prev
		res.to
	as loop-break-concrete-expr
		value = to-block-statement ctx, x.value
		if is-void type
			value ~ (gen-break source, ctx.cur-loop-label!)
		else
			value
	as loop-continue-concrete-expr
		gen-continue source 'to
	as match-scalar-concrete-expr
		translate-match-integral ctx, source, type, x
	as match-string-like-concrete-expr
		# TODO: write some unit tests. This should work the same as other types so I should just need to remove the assertion ...
		unless is-string-or-symbol ctx.ctx, x.matched.type
			log error, "Match on char8[] or char32[]?"
		assert is-string-or-symbol ctx.ctx, x.matched.type else todo
		with-temp ctx, "matched", x.matched, of matched
			res mut = to-block-statement ctx, x.else_
			equals-async = is-async ctx, x.equals
			equals = to-ref ctx, source, x.equals, equals-async
			for case_ concrete-match-string-like-case in x.cases.reverse # TODO: should not need type annotation
				value = to-js-expr ctx, case_.value
				cond = gen-call source, equals-async, equals, (matched, value)
				then_ = to-block-statement ctx, case_.then_
				res := gen-if source, cond, then_, (source, res) 'to
			res
	as match-union-concrete-expr
		translate-match-union ctx, source, type, x
	as record-field-get-concrete-expr
		gen-property-access source, (to-js-expr ctx, x.record_), x.field.debug-name.to
	as record-field-set-concrete-expr
		record_ = to-js-expr ctx, x.record_
		value = to-js-expr ctx, x.value
		access = gen-property-access source, record_, x.field.debug-name.to
		gen-assign source, access, value 'to
	as seq-concrete-expr
		:: js-block-statement
		- for* part in x.parts
			statements to-block-statement ctx, part
	as throw-concrete-expr
		gen-throw source, (to-js-expr ctx, x.thrown) 'to
	as try-concrete-expr
		translate-try ctx, source, type, x
	as try-let-concrete-expr
		translate-try-let ctx, source, type, x
	as union-assume-case-concrete-expr
		match union-representation ctx, x.union-type
		as direct
			to-expr-or-block-statement ctx, x.arg
		as switch
			gen-property-access source, (to-js-expr ctx, x.arg), "value"
	as union-is-case-concrete-expr
		repr = union-representation ctx, x.union-type
		gen-union-is-case ctx, source, (to-js-expr ctx, x.arg), x.union_, repr, x.case-index
	as var-get-concrete-expr
		if var-needs-getter x.var
			getter = gen-identifier source, var-getter-name ctx.ctx, x.var
			gen-call source, (is-async-initializer ctx.ctx, x.var), getter, ()
		else
			to-ref ctx, source, x.var
	as var-set-concrete-expr
		gen-assign source, (to-ref ctx, source, x.var), (to-js-expr ctx, x.value) 'to

-gen-increment js-statement(source source, type concrete-type, name js-name)
	gen-increment source, name, type.as-integral-type!.is-bigint

-gen-create-union js-expr(ctx to-js-ctx, source source, union_ concrete-type, member-index nat, value js-expr)
	match union-representation ctx, union_
	as direct
		value
	as switch
		index = gen-number64 source, member-index.to
		gen-new source, (to-ref ctx, source, union_), (index, value)

-var-needs-getter bool(a concrete-var)
	!a.initializer.kind.constant

-array-literal js-expr(source source, array-type concrete-type, elements js-expr[])
	array = gen-array source, elements
	match x = js-array-type array-type
	as Array
		array
	else
		gen-new source, (gen-global source, x.to), (array,)

-translate-match-integral js-expr-or-block-statement(ctx to-expr-ctx, source source, type concrete-type, a match-scalar-concrete-expr)
	case-exprs js-expr-or-block-statement[] = for e in a.case-exprs
		to-expr-or-block-statement ctx, e
	else_ = if e = a.else_
		to-expr-or-block-statement ctx, e
	else
		unreachable source
	values js-expr[] = for value in a.case-values
		constant-integral source, a.matched-integral-type, value
	with-temp ctx, "matched", a.matched, of matched
		match x = to-exprs-or-block-statements (case-exprs ~ else_), type
		as array
			res mut = x[end - 1]
			for i nat in reverse 0 .. a.case-values.size
				res := gen-ternary source, (gen-eq-eq-eq source, matched, values[i]), x[i], res
			res
		as block-statements
			cases js-switch-case[] = for i nat in 0 .. a.case-values.size
				- values[i]
				- maybe-break-switch-case source, type, x.blocks[i]
			gen-switch source, matched, cases, x.blocks[end - 1] 'to
-translate-match-union js-expr-or-block-statement(ctx to-expr-ctx, source source, type concrete-type, x match-union-concrete-expr)
	else_ = if e = x.else_
		to-expr-or-block-statement ctx, e
	else
		unreachable source
	with-temp ctx, "matched", x.matched, of matched
		cases concrete-local-and-expr[] = map x.cases, ((), it)
		translate-match-union-inner ctx, source, type, matched, else_, x.union_, x.member-indices, cases, (union-representation ctx, x.union-type)

-translate-match-union-inner js-expr-or-block-statement
	ctx to-expr-ctx
	source source
	type concrete-type
	matched js-expr
	else_ js-expr-or-block-statement
	union_ concrete-union
	case-indices indices
	cases concrete-local-and-expr[]
	repr union-representation
do
	###
	const matched = ...
	if (matched instanceof foo) {
		const x = matched
		...
	} else if (typeof matched === "number") {
		const x = matched
		...
	} else {
		...
	}
	###
	js-cases js-expr-or-block-statement[] = for case_ in cases
		to-expr-or-block-statement ctx, case_.expr
	get-cond js-expr mut(i nat) = of i
		gen-union-is-case ctx, source, matched, union_, repr, case-indices[i]
	matched-value = match repr
	as direct
		matched
	as switch
		gen-property-access source, matched, "value"
	match x = to-exprs-or-block-statements js-cases ~ else_, type
	as array
		x.size is cases.size + 1
		res mut = x[cases.size]
		for i nat in reverse 0 .. cases.size
			expr = if l = cases[i].local
				add-local-and-assign ctx, source, (local-name ctx, l), matched-value, x[i]
			else
				x[i]
			res := gen-ternary source, get-cond[i], expr, res
		res
	as block-statements
		x.blocks.size is cases.size + 1
		res mut = x.blocks[cases.size]
		for i nat in reverse 0 .. cases.size
			block = x.blocks[i]
			full-block = if l = cases[i].local
				(gen-const source, (local-name ctx, l), matched-value) ~ block
			else
				block
			res := gen-if source, get-cond[i], full-block, (source, res) 'to
		res

-gen-union-is-case js-expr
	ctx to-expr-ctx
	source source
	union-value js-expr
	union_ concrete-union
	repr union-representation
	case-index nat
do
	match repr
	as direct
		gen-is-type! ctx.ctx, source, union-value, union_.members[case-index]
	as switch
		index = gen-property-access source, union-value, "index"
		gen-eq-eq-eq source, index, gen-number64 source, case-index.to

-exprs-or-block-statements union(js-expr[], block-statements)
-block-statements record(blocks js-block-statement[])
-to-exprs-or-block-statements exprs-or-block-statements(a js-expr-or-block-statement[], type concrete-type)
	map-every::js-expr[]? a, it.js-expr else
		block-statements for x in a then to-block-statement x, type

-translate-try js-block-statement(ctx to-expr-ctx, source source, type concrete-type, a try-concrete-expr)
	###
	try
		tried
	catch x as foo
		...
	==>
	try {
		tried()
	} catch (error) {
		if (error instanceof foo) {
			const x = error
			...
		} else {
			throw error
		}
	}
	###
	tried = to-block-statement ctx, a.tried
	error = local-or-temp ctx, a.catch-else.?local, "error"
	get-error = gen-identifier source, error
	else-block = if e = a.catch-else
		to-block-statement ctx, e.expr
	else
		gen-throw source, get-error 'to
	catch_ = translate-match-union-inner ctx, source, type, get-error, else-block, \
		ctx.ctx.exception.body.concrete-union!, a.exception-member-indices, a.catch-cases, direct
	# catch_ will always be a block statement since the else-block is
	gen-try-catch source, tried, error, catch_.js-block-statement! 'to

-translate-try-let js-block-statement(ctx to-expr-ctx, source source, type concrete-type, a try-let-concrete-expr)
	###
	x = try value catch local as err then catch_
	after
	==>
	let local, ok
	try {
		local = value
		ok = true
	} catch (error) {
		if (error instanceof foo)
			const catch_local = error
			// For a void output, this won't return and will instead continue to the bottom. That's why it checks 'if (ok)'
			return catch_then
		} else {
			throw error
		}
	}
	if (ok) after
	###
	local js-name? = if l = a.local
		local-name ctx, l
	let-local js-statement[] = if local
		- gen-let source, local
	# Only needed if void, otherwise 'catch_then' will return
	ok js-name? = if is-void type then make-temp-local ctx, "ok"
	let-ok js-statement[] = if ok
		- gen-let source, ok
	tried js-statement[] =
		-- if local
			- gen-assign source, local, (to-js-expr ctx, a.value)
		else
			statements to-block-statement ctx, a.value
		-- if ok
			- gen-assign source, ok, (gen-bool source, true)
	error = local-or-temp ctx, a.catch_.local, "error"
	get-error = gen-identifier source, error
	instanceof-caught-type = gen-is-type! ctx.ctx, source, get-error, caught-type a, ctx.ctx.exception
	catch_ = to-block-statement ctx, a.catch_.expr
	if_ = gen-if source, instanceof-caught-type, catch_, gen-throw source, get-error
	try_ = gen-try-catch source, tried.to, error, if_.to
	then_ = to-block-statement ctx, a.then_
	if-ok-then js-block-statement = if ok
		gen-if source, (gen-identifier source, ok), then_ 'to
	else
		then_
	let-local.to ~~ let-ok.to ~~ try_.to ~~ if-ok-then

-maybe-break-switch-case js-block-statement(source source, type concrete-type, a js-block-statement)
	if is-void type
		a ~ source.gen-break-no-label
	else
		a

-get-local js-expr(ctx to-expr-ctx, source source, a concrete-local)
	gen-identifier source, local-name ctx, a
-local-name js-name(ctx to-expr-ctx, a concrete-local)
	kind: local
	crow-name: match source = a.source
	as local
		source.name.to
	as concrete-local-source-reference
		source.original.name.to
	as concrete-generated-local-kind
		source.to
	mangle-index: ensure ctx.temp-local-indices, a, of
		ctx.temp-local-indices.size

-local-or-temp js-name(ctx to-expr-ctx, a concrete-local?, temp-base-name string)
	if a
		local-name ctx, a
	else
		make-temp-local ctx, temp-base-name

-constant-getter js-fun-decl(ctx to-js-ctx, source source, a any-constant)
	comment: ""
	name: ctx.constant-names[a].constant
	memoize: memoize
	fun: sync, (), gen-init-constant ctx, source, a
-gen-init-constant js-expr(ctx to-js-ctx, source source, a any-constant)
	match a
	as single-constant-array
		elements = a.elements
		element-type = a.element-type
		array-literal source, a.type,  for e in elements
			translate-constant ctx, source, element-type, e
	as single-constant-record
		class_ = to-ref ctx, source, a.type
		gen-new source, class_, for field, arg in zip a.fields, a.args
			translate-constant ctx, source, field.type, arg

-translate-constant js-expr(ctx to-js-ctx, source source, type concrete-type, a constant)
	match x = type.body
	as concrete-builtin-type
		translate-constant-builtin ctx, source, type, x, a
	as concrete-enum
		constant-nat source, x.storage, a
	as struct-body-extern-java
		throw unreachable
	as concrete-flags
		constant-nat source, x.storage, a
	as concrete-record
		match a
		as constant-record
			gen-get-constant source, record-name ctx.constant-names, type, a
		as constant-gc-safe-value
			gen-null source
		as constant-symbol
			gen-identifier source, a.index.constant-symbol-name
		else
			throw unreachable
	as concrete-union
		match a
		as constant-union
			v = ctx.program.all-constants.unions[type]![a]
			case-type = type.body.concrete-union!.members[v.member-index]
			gen-create-union ctx, source, type, v.member-index,
				translate-constant ctx, source, case-type, v.member
		as constant-gc-safe-value
			gen-null source
		else
			throw unreachable
	as concrete-type-body-deferred
		throw unreachable

-translate-constant-builtin js-expr(ctx to-js-ctx, source source, type concrete-type, builtin_ concrete-builtin-type, a constant)
	match kind builtin_
	as array
		match a
		as constant-array
			gen-get-constant source, array-name ctx.constant-names, type, a
		as constant-gc-safe-value
			gen-null source
		else
			throw unreachable
	as bool
		gen-bool source, a.as-bool
	as char8
		constant-nat source, nat8, a
	as char32
		constant-nat source, nat32, a
	as float32
		gen-number32 source, a.as-float
	as float64
		gen-number64 source, a.as-float
	as future
		throw unreachable
	as int8
		constant-integral source, int8, a
	as int16
		constant-integral source, int16, a
	as int32
		constant-integral source, int32, a
	as int64
		constant-integral source, int64, a
	as js-any
		match a
		as constant-gc-safe-value
			gen-null source
		as constant-native-string
			gen-string source, a.value
		as scalar-value
			gen-number64 source, a.to
		else
			throw unreachable
	as fun-data
		throw unreachable
	as fun-mut
		throw unreachable
	as fun-shared
		throw unreachable
	as mut-slice
		match a
		as constant-gc-safe-value
			gen-null source
		else
			throw unreachable
	as nat8
		constant-nat source, nat8, a
	as nat16
		constant-nat source, nat16, a
	as nat32
		constant-nat source, nat32, a
	as nat64
		constant-nat source, nat64, a
	as option
		throw unreachable
	as void
		gen-undefined source
	as weak-ref
		assert constant-gc-safe-value a
		gen-null source

-gen-get-constant js-expr(source source, name nat)
	gen-call-sync source, (gen-identifier source, name.constant), ()

-constant-nat js-expr(source source, type nat-type, a constant)
	constant-integral source, type.to, a
-constant-integral js-expr(source source, type integral-type, a constant)
	constant-integral source, type, match a
	as scalar-value
		a
	as constant-gc-safe-value
		0::nat.to
	else
		throw unreachable
-constant-integral js-expr(source source, type char-or-integral-type, value scalar-value)
	constant-integral source, type.as-integral, value
-constant-integral js-expr(source source, type integral-type, value scalar-value)
	if is-signed type
		if is-bigint type
			gen-bigint-signed source, value.to::int64
		else
			gen-number64 source, value.to::int64.to
	else
		if is-bigint type
			gen-bigint-unsigned source, value.to::nat64
		else
			gen-number64 source, value.to::nat64.to
-is-bigint bool(type integral-type)
	type == int64 or type == nat64

# TODO: use a 'with-block' --------------------------------------------------------------------------------------------------------------------------
-with-temp js-expr-or-block-statement
	ctx to-expr-ctx
	name string
	expr concrete-expr
	f js-expr-or-block-statement mut(get-temp js-expr)
do
	with-temp ctx, name, (source ctx, expr), (to-js-expr ctx, expr), f
-with-temp js-expr-or-block-statement
	ctx to-expr-ctx
	name string
	source source
	expr js-expr
	f js-expr-or-block-statement mut(get-temp js-expr)
do
	with-temp-common ctx, (make-temp-local ctx, name), source, expr, f
-make-temp-local js-name(ctx to-expr-ctx, base string)
	temp, base, ctx.take-next-temp-index
-with-temp-common js-expr-or-block-statement
	ctx to-expr-ctx
	local js-name
	source source
	value js-expr
	f js-expr-or-block-statement mut(get-temp js-expr)
do
	expr-or-block-statement-with-local ctx, const, local, source, value, f[gen-identifier source, local]
-expr-or-block-statement-with-local js-expr-or-block-statement
	ctx to-expr-ctx
	kind js-var-decl-const
	local js-name
	source source
	value js-expr
	then_ js-expr-or-block-statement
do
	match then_
	as js-expr
		add-local-and-assign ctx, source, local, value, then_
	as js-block-statement
		(gen-var-decl source, kind, local, value) ~ then_

add-local-and-assign js-expr(ctx to-expr-ctx, source source, local js-name, value js-expr, then_ js-expr)
	ctx.top-declared-locals ~= local
	assign js-expr = source: source, kind: js-assign-expr local, value
	gen-binary source, comma, assign, then_

| This function is run after an arithmetic operation to keep an integral type within its expected range.
-gen-as-integral js-expr(source source, type integral-type, arg js-expr)
	match type
	as int8
		gen-shift-and-unshift source, arg, 24
	as int16
		gen-shift-and-unshift source, arg, 16
	as int32
		gen-binary source, bitwise-or, arg, gen-number64 source, 0
	as int64
		gen-as-int64 source, arg
	as nat8
		gen-bitwise-and source, arg, gen-number64 source, type.max-value.to::float64
	as nat16
		gen-bitwise-and source, arg, gen-number64 source, type.max-value.to::float64
	as nat32
		gen-to-nat32 source, arg
	as nat64
		gen-as-nat64 source, arg
-gen-to-nat32 js-expr(source source, arg js-expr)
	gen-binary source, bit-shift-right-unsigned, arg, gen-number64 source, 0
-gen-shift-and-unshift js-expr(source source, arg js-expr, amount float64)
	amount-expr = gen-number64 source, amount
	x = gen-binary source, bit-shift-left, arg, amount-expr
	gen-binary source, bit-shift-right, x, amount-expr
-gen-as-int64 js-expr(source source, arg js-expr)
	BigInt = gen-global source, "BigInt"
	gen-call-property-sync source, BigInt, "asIntN",
		- gen-number64 source, 64
		- arg
-gen-as-nat64 js-expr(source source, arg js-expr)
	BigInt = gen-global source, "BigInt"
	gen-call-property-sync source, BigInt, "asUintN",
		- gen-number64 source, 64
		- arg

-gen-as-float32 js-expr(source source, arg js-expr)
	gen-call-math source, "fround", arg

-gen-call-math js-expr(source source, name string, arg js-expr)
	gen-call-math source, name, (arg,)
-gen-call-math js-expr(source source, name string, args js-expr[])
	gen-call-property-sync source, (gen-global source, "Math"), name, args

-gen-convert js-expr
	ctx to-expr-ctx
	source source
	size-bytes nat
	input-array-type string
	output-array-type string
	arg js-expr
do
	###
	const buf = new ArrayBuffer(size_bytes)
	(new InputArray(buf))[0] = arg
	return (new OutputArray(buf))[0]
	###
	buf-name = make-temp-local ctx, "buf"
	buf = gen-identifier source, buf-name
	ArrayBuffer = gen-global source, "ArrayBuffer"
	new-buf = gen-new source, ArrayBuffer,
		- gen-number64 source, size-bytes.to
	declare-buf = gen-const source, buf-name, new-buf
	InputArray = gen-global source, input-array-type
	OutputArray = gen-global source, output-array-type
	input = gen-subscript-zero source, gen-new source, InputArray, (buf,)
	assign-to-input = gen-assign source, input, arg
	output = gen-subscript-zero source, gen-new source, OutputArray, (buf,)
	return-output = gen-return source, output
	gen-iife source, sync,
		- declare-buf, assign-to-input, return-output
-gen-subscript-zero js-expr(source source, arg js-expr)
	gen-property-access-computed source, arg, gen-number64 source, 0

-gen-iife js-expr(source source, async sync-or-async, block js-block-statement)
	fn js-expr = source, (js-arrow-function async, (), block)
	gen-call source, async, fn, ()

-array-for-array-type js-expr(source source, array-type concrete-type)
	array-for-element-type source, array-type.array-element-type
-array-for-element-type js-expr(source source, element concrete-type)
	gen-global source, element.js-array-type-for-element-type.to

-js-array-type enum
	Array
	BigInt64Array
	BigUint64Array
	Int8Array
	Int16Array
	Int32Array
	Uint8Array
	Uint16Array
	Uint32Array
	Float32Array
	Float64Array
-== bool(a js-array-type, b js-array-type)
-to symbol(a js-array-type)
-to string(a js-array-type)
	a.to::symbol.to
-js-array-type js-array-type(array-type concrete-type)
	js-array-type-for-element-type array-element-type array-type
-js-array-type-for-element-type js-array-type(element concrete-type)
	match body = element.body
	as concrete-builtin-type
		array-for-builtin-type body.kind
	as concrete-enum
		array-for-nat-type body.storage
	as concrete-flags
		array-for-nat-type body.storage
	as concrete-record
		Array
	as concrete-union
		Array
	as struct-body-extern-java
		throw unreachable
	as concrete-type-body-deferred
		throw unreachable
-array-for-builtin-type js-array-type(a builtin-type)
	match a
	as array then Array
	as bool then Array
	as char8 then Uint8Array
	as char32 then Uint32Array
	as float32 then Float32Array
	as float64 then Float64Array
	as future then Array
	as int8 then Int8Array
	as int16 then Int16Array
	as int32 then Int32Array
	as int64 then BigInt64Array
	as js-any then Array
	as fun-data then Array
	as fun-mut then Array
	as fun-shared then Array
	as mut-slice then Array
	as nat8 then Uint8Array
	as nat16 then Uint16Array
	as nat32 then Uint32Array
	as nat64 then BigUint64Array
	as option then throw unreachable
	as void then Array
	as weak-ref then Array
-array-for-nat-type js-array-type(a nat-type)
	array-for-builtin-type a.to
