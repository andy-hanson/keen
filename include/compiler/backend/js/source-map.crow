import
	../../model/source-range
	../../model/uri
	../../util/util

js-and-map record(js string, map string?)
module-paths alias
	string[uri]

# https://docs.google.com/document/d/1U1RGAehQwRypUTovF1KRlpiOFze0b-_2gc6fAH0KY0k/edit?pli=1
source-map-builder record mut
	mappings char8 mut[]
	sources uri mut[]
	names symbol mut[]
	prev mut single-source-mapping
	prev-source-uri-index mut nat
	prev-source-name-index mut nat
new source-map-builder()
	(), (), (), (), (), ()
finish string(a source-map-builder, files file-content-getters, module-paths module-paths)
	sources uri[] = a.sources move-to
	sources-paths json[] = for source : sources; module-paths[source] to
	sources-content json[] = for source : sources
		files[source].to::string to
	names json[] = for name : a names; name to
	j json = do
		version: 3::nat to
		sources: sources-paths to
		sourceContent: sources-content to
		names: names to
		mappings: a.mappings.move-to::char8[] to
	"{j}"

source record
	dummy void # RM ------------------------------------------------------------------------------------------------------------
	uri uri
	| E.g., a function name
	name symbol
	pos line-and-character
new source(uri uri, name symbol, pos line-and-character)
	forbid uri == ()
	(), uri, name, pos
== bool(a source, b source)

single-source-mapping record(source source, out-pos line-and-character)
new single-source-mapping()
	("file://dummy".must-parse-uri, "", (0, 0)), (0, 0)

~= void(a source-map-builder, mapping single-source-mapping)
	prev = a prev
	guard mapping.source != prev.source
	assert prev.out-pos <= mapping.out-pos

	forbid mapping.source.uri == ()
	
	for _ : prev.out-pos.line .. mapping.out-pos.line
		a.mappings ~= ";"
	
	if prev.out-pos.line == mapping.out-pos.line
		if prev.source.uri != ()
			a.mappings ~= ","
	a.mappings write-base-64-vlq mapping.out-pos.character.to

	if prev.source != mapping.source
		# As an optimization, check if it's the same URI as last time
		if prev.source.uri == mapping.source.uri
			a.mappings write-base-64-vlq 0
		else
			uri-index = a.sources find-index-or-push mapping.source.uri
			a.mappings write-base-64-vlq uri-index.to - a.prev-source-uri-index.to
			a.prev-source-uri-index := uri-index
	
		a.mappings write-base-64-vlq mapping.source.pos.line.to - prev.source.pos.line.to
		a.mappings write-base-64-vlq mapping.source.pos.character.to - prev.source.pos.character.to
		
		if prev.source.name == mapping.source.name
			a.mappings write-base-64-vlq 0
		else
			name-index = a.names find-index-or-push mapping.source.name
			a.mappings write-base-64-vlq name-index.to - a.prev-source-name-index.to
			a.prev-source-name-index := name-index

	a.prev := mapping		

-to int(a nat32)
	a.to::nat64 to

write-base-64-vlq void(out char8 mut[], value int)
	sign-bit = value < 0
	value-remaining mut = value.abs << 1 | sign-bit.to
	loop
		code = value-remaining & 0b11111
		value-remaining >>:= 5
		out ~= (value-remaining == 0 ? 0 : 0b100000) | code base-64-char
		if value-remaining == 0
			break
		else
			continue

-base-64-char char8(number nat64)
	assert number & 0b111111 == number
	base-64-chars[number]

-base-64-chars char8[]()
	"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
