import
	../../model/integral-values
	../../model/model
	./source-map

js-script-ast record
	shebang shebang
	classes js-class-decl[]
	vars js-var-decl[]
	functions js-fun-decl[]
	statements js-statement[]

shebang enum(none, node)

# Names mangled lazily (TODO: why?) ----------------------------------------------------------------------------------------------------
js-name record(kind js-name-kind, crow-name string, mangle-index nat?)
<=> comparison(a js-name, b js-name)
js-name-kind enum
	| This results in a plain symbol (assuming it's a valid JS identifier)
	none
	function_
	| This is for locals from the source code
	local
	special-local
	spec-sig # TODO: this shouldn't be used any more ------------------------------------------------------------------------------------
	| This is for locals generated by the compiler
	temp
	type
== bool(a js-name-kind, b js-name-kind)
<=> comparison(a js-name-kind, b js-name-kind)
no-prefix js-name(name string)
	none, name, ()
local js-name(name string)
	local, name, ()
special-local js-name(name string)
	special-local, name, ()
temp js-name(name string, index nat)
	temp, name, index

js-member-name record(kind js-member-name-kind, crow-name string)
to string(a js-member-name)
	"{a.kind.prefix}{a crow-name}"
js-member-name-kind enum
	none
	enum-member
	record-field
	special
	sum-type-method
	union-constructor
	union-member
no-prefix js-member-name(name string)
	none, name
enum-member js-member-name(name string) # TODO: inline functions like this ----------------------------------------------------------------
	enum-member, name
record-field js-member-name(name string)
	record-field, name
special js-member-name(name string)
	special, name
sum-type-method js-member-name(name string)
	sum-type-method, name
union-constructor js-member-name(name string)
	union-constructor, name
union-member js-member-name(name string)
	union-member, name
prefix string(a js-member-name-kind)
	match a
	as none
		""
	as enum-member
		"e_"
	as record-field
		"f_"
	as special
		"s_"
	as sum-type-method
		"m_"
	as union-constructor
		"uc_"
	as union-member
		"um_"

js-fun-decl record(comment string, name js-name, fun js-arrow-function)

js-class-decl record(comment string, name js-name, extends js-name?, members js-class-member[])
# TODO: so far I'm only using this for constructors. If so this could be greatly simplified. ------------------------------------------------
js-class-member record
	source source
	is-static js-class-member-static
	name js-member-name
	kind js-class-member-kind
js-class-member-static enum(instance, static) # TODO: everything should be instance now ........................................................
js-class-member-kind union(js-class-method, js-expr)
# TODO: are these still used? -------------------------------------------------------------------------------------------------------------------
js-class-method record(async sync-or-async, params js-params, body js-block-statement)
sync-or-async enum(sync, async)
== bool(a sync-or-async, b sync-or-async)
js-arrow-function record(async sync-or-async, params js-params, body js-expr-or-block-statement)
js-params record(params js-destructure[], rest-param js-destructure?) # TODO: do I stlil use rest-param anywhere? -----------------------
new js-params()
	(), ()
to js-params(a js-destructure[])
	a, ()
js-expr-or-block-statement union(js-expr, js-block-statement)

js-destructure union(js-name, js-default-destructure, js-object-destructure) # TODO: Do I use non-simple destructures anywhere?
js-default-destructure record(left js-destructure, default js-expr)
js-object-destructure record(fields (js-member-name, js-destructure)[])

js-statement record(source source, kind js-statement-kind)
js-statement-kind union
	js-assign-statement
	js-block-statement
	js-break-statement
	js-continue-statement
	js-expr
	js-for-of-statement
	js-if-statement
	js-return-statement
	js-switch-statement
	js-throw-statement
	js-try-catch-statement
	js-try-finally-statement
	js-var-decl
	js-while-statement
js-assign-statement record(left js-expr, right js-expr)
js-block-statement record(statements js-statement[])
~~ js-block-statement(a js-block-statement, b js-block-statement)
	a.statements ~~ b.statements,
~ ~ js-block-statement(a js-block-statement, b js-statement)
	a.statements ~ b,
js-break-statement record(label js-name?)
js-continue-statement record
js-for-of-statement record(local js-name, collection js-expr, body js-block-statement)
js-if-statement record(cond js-expr, then js-block-statement, else_ js-statement?)
js-return-statement record(arg js-expr?) # TODO: do I ever use this with no arg? ----------------------------------------------------
js-switch-statement record(arg js-expr, cases js-switch-case[], default js-block-statement)
js-switch-case record
	value js-expr
	| Force a block statement here to ensure each branch has its own scope
	then js-block-statement
js-throw-statement record(arg js-expr)
js-try-catch-statement record(tried js-block-statement, exception js-name, catch_ js-block-statement)
js-try-finally-statement record(tried js-block-statement, finally_ js-block-statement)
js-var-decl record(const js-var-decl-const, destructure js-destructure, initializer js-expr?)
js-var-decl-const enum(const, let)
to symbol(a js-var-decl-const)
show string(a js-var-decl-const)
	a.to::symbol to
js-while-statement record(label js-name?, condition js-expr, body js-block-statement)

js-expr record(source source, kind js-expr-kind) # TODO: remove dummy ----------------------------------------------
js-expr-kind union
	js-array-expr
	js-arrow-function
	js-binary-expr
	js-call-expr
	js-call-with-spread-expr
	js-literal-bool
	js-literal-integer
	js-literal-number
	js-literal-string
	js-name
	js-new-expr
	js-null-expr
	js-object1-expr
	js-optional-property-access-expr
	js-property-access-expr
	js-property-access-computed-expr
	js-ternary-expr
	js-this-expr
	js-unary-expr
js-array-expr record(elements js-expr[])
js-binary-expr record(kind js-binary-kind, left js-expr, right js-expr)
js-binary-kind enum
	and
	bit-shift-left
	bit-shift-right
	bitwise-and
	bitwise-or
	bitwise-xor
	divide
	eq-eq-eq
	in
	instanceof
	less
	minus
	| WARN: Not a true modulo. In JS, 'a % b' may return a negative result.
	modulo
	not-eq-eq # TODO: is this actually used anywhere? -----------------------------------------------------------------------------------
	or
	plus
	times
js-call-expr record(called js-expr, args js-expr[])
js-call-with-spread-expr record(called js-expr, args js-expr[], spread-arg js-expr) # TODO: is this used? ---------------------------
js-literal-bool record(value bool) # TODO: I could just use 'bool' as the expression .......................................
js-literal-integer record(is-signed bool, value integral-value)
js-literal-number record(type float-type, value float)
js-literal-string record(value string)
js-new-expr record(class_ js-expr, arguments js-expr[])
js-null-expr record
js-object1-expr record(key js-member-name, value js-expr)
# `obj?.prop`
js-optional-property-access-expr record(object js-expr, property-name js-member-name)
js-property-access-expr record(object js-expr, property-name js-member-name) # TODO: I think this is not needed. Just get a string and always use js-property-access-computed-expr
js-property-access-computed-expr record(object js-expr, property-name js-expr)
js-ternary-expr record(condition js-expr, then js-expr, else_ js-expr) # TODO: is this ever used? ------------------------------------
js-this-expr record
js-unary-expr record(kind js-unary-kind, arg js-expr)
js-unary-kind enum(await, bitwise-not, not, typeof, void)

expr-statement js-statement(expr js-expr) # TODO: just name it 'to' ----------------------------------------------------------------
	expr.source, expr.to
gen-and js-expr(source source, arg0 js-expr, arg1 js-expr)
	source gen-binary and, arg0, arg1
gen-array js-expr(source source, elements js-expr[])
	source, elements.js-array-expr
gen-arrow-function js-expr
	source source
	async sync-or-async
	params js-params
	body js-expr-or-block-statement
do
	source, (async js-arrow-function params, body)
gen-arrow-function js-expr
	source source
	async sync-or-async
	params js-destructure[]
	body js-expr
do
	source gen-arrow-function async, params.to, body.expr-fun-body
gen-arrow-function js-expr
	source source
	async sync-or-async
	params js-destructure[]
	body js-statement[]
do
	source gen-arrow-function async, params.to, body.gen-block-statement.to

expr-fun-body js-expr-or-block-statement(expr js-expr) # TODO: INLINE ----------------------------------------------------------------
	expr to
gen-assign js-statement(source source, left js-expr, right js-expr)
	source, (left js-assign-statement right)
gen-assign js-statement(source source, left js-name, right js-expr)
	source gen-assign (source gen-identifier left), right
gen-await js-expr(source source, arg js-expr)
	source gen-unary await, arg
-gen-await-if js-expr(source source, async sync-or-async, arg js-expr)
	match async
	as sync
		arg
	as async
		source gen-await arg
gen-binary js-expr(source source, kind js-binary-kind, arg0 js-expr, arg1 js-expr)
	source, (kind js-binary-expr arg0, arg1)
gen-binary js-expr(source source, kind js-binary-kind, (arg0 js-expr, arg1 js-expr))
	source, (kind js-binary-expr arg0, arg1)
gen-bitwise-and js-expr(source source, arg0 js-expr, arg1 js-expr)
	source gen-binary bitwise-and, arg0, arg1
gen-bitwise-not js-expr(source source, arg js-expr)
	source gen-unary bitwise-not, arg
gen-block-statement js-block-statement(statements js-statement[])
	statements,
gen-block-statement-statement js-statement(source source, statements js-statement[])
	source, statements.js-block-statement
gen-bool js-expr(source source, value bool)
	source, value.js-literal-bool
gen-break-no-label js-statement(source source)
	source, ().js-break-statement
gen-break js-statement(source source, label js-name)
	source, label.js-break-statement
gen-call js-expr(source source, await sync-or-async, called js-expr, args js-expr[])
	source gen-await-if await, (source gen-call-sync called, args)
gen-call-await js-expr(source source, called js-expr, args js-expr[])
	source gen-await (source gen-call-sync called, args)
gen-call-sync js-expr(source source, called js-expr, args js-expr[])
	source, (called js-call-expr args)
gen-call-with-spread js-expr(source source, await sync-or-async, called js-expr, args js-expr[], spread-arg js-expr)
	source gen-await-if await, (source, (called js-call-with-spread-expr args, spread-arg))
gen-call-property-sync js-expr(source source, object js-expr, property js-member-name, args js-expr[])
	source gen-call-sync (source gen-property-access object, property), args
gen-optional-call-property-sync js-expr(source source, object js-expr, property js-member-name, args js-expr[])
	source gen-call-sync (source gen-optional-property-access object, property), args
gen-continue js-statement(source source)
	source, js-continue-statement
gen-global js-expr(source source, name string)
	source, name.no-prefix.to
gen-if js-statement(source source, cond js-expr, then js-block-statement)
	source, (cond js-if-statement then, ())
gen-if js-statement(source source, cond js-expr, then js-block-statement, else_ js-statement)
	source, (cond js-if-statement then, else_)
gen-in js-expr(source source, arg0 js-member-name, arg1 js-expr)
	source gen-binary in, (source gen-string-from-member-name arg0), arg1
gen-instanceof js-expr(source source, arg0 js-expr, arg1 js-expr)
	source gen-binary instanceof, arg0, arg1
gen-integer js-expr(source source, is-signed bool, value integral-value)
	source, (is-signed js-literal-integer value)
gen-integer-signed js-expr(source source, value int)
	source gen-integer true, (value,)
gen-integer-unsigned js-expr(source source, value nat)
	source gen-integer false, (value,)
gen-not js-expr(source source, arg js-expr)
	source gen-unary not, arg
gen-not-not js-expr(source source, arg js-expr)
	source gen-not (source gen-not arg)
gen-not-eq-eq js-expr(source source, left js-expr, right js-expr)
	source gen-binary not-eq-eq, left, right
gen-null js-expr(source source)
	source, js-null-expr
gen-number32 js-expr(source source, value float)
	source, (float32 js-literal-number value)
gen-number64 js-expr(source source, value float)
	source, (float64 js-literal-number value)
gen-new js-expr(source source, class_ js-expr, args js-expr[])
	source, (class_ js-new-expr args)
gen-or js-expr(source source, arg0 js-expr, arg1 js-expr)
	source gen-binary or, arg0, arg1
gen-plus js-expr(source source, arg0 js-expr, arg1 js-expr)
	source gen-binary plus, arg0, arg1
gen-minus js-expr(source source, arg0 js-expr, arg1 js-expr)
	source gen-binary minus, arg0, arg1
gen-property-access js-expr(source source, arg js-expr, property-name js-member-name)
	source, (arg js-property-access-expr property-name)
gen-property-access-computed js-expr(source source, object js-expr, property-name js-expr)
	match property-name kind
	as js-literal-string x
		source gen-property-access object, x.value.no-prefix
	else
		source, (object js-property-access-computed-expr property-name)
gen-optional-property-access js-expr(source source, object js-expr, property-name js-member-name)
	source, (object js-optional-property-access-expr property-name) 
gen-return js-statement(source source, arg js-expr)
	source, arg.js-return-statement
gen-switch js-statement(source source, arg js-expr, cases js-switch-case[], default js-block-statement)
	source, (arg js-switch-statement cases, default)
gen-ternary js-expr(source source, cond js-expr, then js-expr, else_ js-expr)
	source, (cond js-ternary-expr then, else_)
gen-throw js-statement(source source, thrown js-expr)
	source, thrown.js-throw-statement
gen-try-finally js-statement(source source, tried js-block-statement, finally_ js-block-statement)
	source, (tried js-try-finally-statement finally_)
gen-typeof js-expr(source source, arg js-expr)
	source gen-unary typeof, arg
gen-eq-eq-eq js-expr(source source, a js-expr, b js-expr)
	source gen-binary eq-eq-eq, a, b
gen-less js-expr(source source, a js-expr, b js-expr)
	source gen-binary less, a, b
gen-try-catch js-statement
	source source
	try-block js-block-statement
	exception js-name
	catch-block js-block-statement
do
	source, (try-block js-try-catch-statement exception, catch-block)
gen-var-decl js-statement(source source, const js-var-decl-const, destructure js-destructure, initializer js-expr?)
	source, (const js-var-decl destructure, initializer)
gen-const js-statement(source source, name js-name, initializer js-expr)
	source gen-const name.to, initializer
gen-const js-statement(source source, destructure js-destructure, initializer js-expr)
	source gen-var-decl const, destructure, initializer
gen-let js-statement(source source, name js-name)
	source gen-var-decl let, name.to, ()
gen-let js-statement(source source, destructure js-destructure, initializer js-expr)
	source gen-var-decl let, destructure, initializer
gen-identifier js-expr(source source, name js-name)
	source, name.to
gen-object js-expr(source source, name js-member-name, value js-expr)
	source, (name js-object1-expr value)
gen-string js-expr(source source, value string)
	source, value.js-literal-string
gen-string-from-symbol js-expr(source source, value symbol)
	source gen-string value.to
-gen-string-from-member-name js-expr(source source, value js-member-name)
	source gen-string value.to
gen-this js-expr(source source)
	source, js-this-expr
gen-times js-expr(source source, left js-expr, right js-expr)
	source gen-binary times, left, right
gen-unary js-expr(source source, kind js-unary-kind, arg js-expr)
	source, (kind js-unary-expr arg)
gen-undefined js-expr(source source)
	source, (void js-unary-expr (source gen-number64 0))
gen-while js-statement(source source, condition js-expr, body js-block-statement)
	source gen-while (), condition, body
gen-while js-statement(source source, label js-name?, condition js-expr, body js-block-statement)
	source, (label js-while-statement condition, body)
gen-while-true js-statement(source source, body js-block-statement)
	source gen-while-true (), body
gen-while-true js-statement(source source, label js-name?, body js-block-statement)
	source gen-while label, (source gen-bool true), body

-gen-method js-class-member
	source source
	static js-class-member-static
	async sync-or-async
	name js-member-name
	params js-params
	body js-block-statement
do
	source, static, name, (async js-class-method params, body)
gen-instance-method js-class-member
	source source
	async sync-or-async
	name js-member-name
	params js-params
	body js-block-statement
do
	source gen-method instance, async, name, params, body
gen-static-method js-class-member
	source source
	async sync-or-async
	name js-member-name
	params js-params
	body js-block-statement
do
	source gen-method static, async, name, params, body
gen-instance-method js-class-member
	source source
	async sync-or-async
	name js-member-name
	params js-destructure[]
	body js-statement[]
do
	source gen-instance-method async, name, params, body.gen-block-statement
gen-instance-method js-class-member
	source source
	async sync-or-async
	name js-member-name
	params js-destructure[]
	body js-block-statement
do
	source gen-instance-method async, name, params, body
gen-instance-method js-class-member
	source source
	async sync-or-async
	name js-member-name
	params js-destructure[]
	body js-expr
do
	source gen-instance-method async, name, params, ((source gen-return body),).gen-block-statement
gen-field js-class-member(source source, static js-class-member-static, name js-member-name, value js-expr)
	source, static, name, value.to

gen-increment-integer js-statement(source source, name js-name)
	source gen-assign name, (source gen-plus (source gen-identifier name), (source gen-integer-unsigned 1))	
