import
	crow/string/util
	../../../crow/parse
	../../app/command
	../../frontend/show-model
	../../model/model
	../../model/source-range
	../../util/util
	./js-ast
	./mangle-for-js
	./source-map

write-js-ast js-and-map
	show-ctx show-type-ctx
	module-paths module-paths
	a js-script-ast
	sanity-checks sanity-checks
	source-map-name string?
do
	show-ctx.show.file-content-getters build-output module-paths, !!source-map-name, of out
		out ~~= "{a shebang}"
		if source-map-name
			out ~~= source-map-name source-map-url
		out ~~= quote
			export \{}
			const _global = typeof self === "undefined" ? global : self
			const _memoize = fn => \{
				let result
				return () => \{
					if (fn) \{
						result = fn()
						fn = undefined
					}
					return result
				}
			}
			const _compareIntegral = (a, b) =>
				a < b ? 0 :
				b < a ? 2 :
				1;
			const _compareFloat = (a, b) =>
				a < b ? 0 :
				b < a ? 2 :
				Object.is(a, b) ? 1 :
				Number.isNaN(a) ? 0 :
				Number.isNaN(b) ? 2 :
				Object.is(a, -0) ? 0 : 2;
		if sanity-checks != no-sanity-checks
			out ~~= "const _assert = cond => \{ if (!cond) throw new Error(\"Assertion failed.\") }"
		for x in a classes
			out write-class x
			out ~= "\n"
		for fun in a functions
			out write-comment fun.comment
			out ~~= "const {fun name} = "
			memoize = fun.memoize == memoize
			if memoize
				out ~~= "_memoize("
			out write-arrow-function 0, expr, fun.fun
			if memoize
				out ~= ")"
			out ~= "\n"
		for var in a vars
			out write-var-decl 0, var
			out ~= "\n"
		out write-statements a.statements

# TODO: inline? -----------------------------------------------------------------------------------------------------------------
-build-output js-and-map
	files file-content-getters
	module-paths module-paths
	include-source-map bool
	f void mut(output output)
do
	map-builder source-map-builder? = if include-source-map then ()::source-map-builder
	js: with text-builder in build
		out output = text-builder, map-builder, 0, 0
		f[out]
	map: if map-builder
		map-builder finish files, module-paths

-output record mut
	text string-builder
	map source-map-builder?
	line mut nat32
	character mut nat32

-~= void(a output, x char32)
	a.text ~= x
	if x == "\n"
		a.line +:= 1
		a.character := 0
	else
		a.character +:= 1
-~~= void(a output, s string)
	for x in s
		a ~= x

-write-with-commas[t] void(a output, xs t[], f void mut(x t))
	for i, x in xs with-index
		if i != 0
			a ~~= ", "
		f[x]

-mark-map void(a output, source source)
	if map = a map
		map ~= source, (a.line, a.character)

-write-on-single-line void(a output, s string) # TODO: this isn't really needed? just use ~~= ............................................
	forbid "\n"::char32 in s
	a.text ~~= s
	a.character +:= s.to::char8[].size.to

-show string(a shebang)
	match a
	as none
		""
	as node
		"#!/usr/bin/env node\n"

-source-map-url string(source-map-name string)
	"//# sourceMappingURL={source-map-name}\n"

-write-statements void(out output, statements js-statement[])
	for x in statements
		out ~= "\n"
		out write-statement 0, x, non-first

-show string(a js-name)
	if a.crow-name is-js-keyword and !a.mangle-index
		"_{a crow-name}"
	else
		suffix string = if x = a mangle-index then "___{x}"
		"{a.kind prefix}{a.crow-name mangle-name-common}{suffix}"
-prefix string(a js-name-kind)
	match a
	as none
		""
	as constant
		"c_"
	as function_
		"f_"
	as local
		"l_"
	as temp
		"x_"

-property-access string(a string)
	if a is-js-identifier then ".{a}" else "[\"{a}\"]"
-member-name string(a string)
	if a is-js-identifier then a else "[\"{a}\"]"

-is-js-identifier bool(a string)
	a !is-js-keyword and
	(a.to::char8[])[0] !is-digit and
	a.to::char8[] every it.is-ascii-identifier-char
-is-js-keyword bool(a string)
	match a
	as arguments
		true
	as await
		true
	as "case"
		true
	as const
		true
	as debugger
		true
	as default
		true
	as delete
		true
	as "enum"
		true
	as extends
		true
	as false
		true
	as function
		true
	as "in"
		true
	as instanceof
		true
	as let
		true
	as new
		true
	as null
		true
	as public
		true
	as return
		true
	as static
		true
	as switch
		true
	as this
		true
	as true
		true
	as typeof
		true
	as var
		true
	as void
		true
	else
		false

-write-class void(out output, a js-class-decl)
	out write-comment a.comment
	out ~~= "class {a name}"
	if x = a extends
		out ~~= " extends {x}"
	out ~~= " \{"
	for member in a members
		out mark-map member.source
		out ~~= "\n\t"
		out write-class-member member
	out ~= "\n"
	out ~= "}"

-write-comment void(out output, comment string)
	unless comment is-empty
		out ~~= "// {comment}\n"

-write-class-member void(out output, member js-class-member)
	match member is-static
	as instance
		()
	as static
		out ~~= "static "
	match x = member kind
	as js-class-method
		out ~~= "{x.async maybe-async}{member.name member-name}"
		out write-params x.params, true
		out ~= " "
		out write-block-statement 1, x.body
	as js-expr
		out ~~= "{member.name member-name} = "
		out write-expr 1, x
	as js-class-getter
		out ~~= "get {member.name member-name}() "
		out write-block-statement 1, x.body

-write-params void(out output, a js-params, always-parens bool)
	parens bool = always-parens or a.params.size != 1 or !a.params.only.js-name or a rest-param
	if parens
		out ~= "("
	out write-with-commas a.params, of x
		out write-destructure x
	if x = a rest-param
		unless a.params is-empty
			out ~~= ", "
		out ~~= "..."
		out write-destructure x
	if parens
		out ~= ")"

-write-destructure void(out output, a js-destructure)
	match a
	as js-name
		out ~~= "{a}"
	as js-default-destructure
		out write-destructure a.left
		out ~~= " = "
		out write-expr 0, a.default, expr
	as js-object-destructure
		out ~~= "\{ "
		out write-with-commas a.fields, of name, destructure
			out ~~= "{name member-name}: "
			out write-destructure destructure
		out ~~= " }"

-write-block-statement void(out output, indent nat, a js-block-statement)
	out ~= "\{"
	for index, x in a.statements with-index
		out ~~= indent + 1 newline
		out write-statement indent + 1, x, if index == 0 then first else non-first
	out ~~= indent newline
	out ~= "}"

-write-expr-or-block-statement-indented void(out output, indent nat, a js-expr-or-block-statement)
	match a
	as js-expr
		out ~~= indent + 1 newline
		out write-expr indent + 1, a
	as js-block-statement
		out ~= " "
		out write-block-statement indent, a

-statement-pos enum(first, non-first)
-write-statement void(out output, indent nat, a js-statement, pos statement-pos)
	out mark-map a.source
	match x = a kind
	as js-assign-statement
		out write-assign indent, x
	as js-block-statement
		out write-block-statement indent, x
	as js-break-statement
		out ~~= "break "
		if l = x label
			out ~~= " {l}"
	as js-continue-statement
		out ~~= "continue"
	as js-expr
		out write-expr indent, x, match pos
		as first
			statement-first
		as non-first
			statement-non-first
	as js-if-statement
		out write-if indent, x
	as js-for-of-statement
		out ~~= "for (const {x local} of "
		out write-expr indent + 2, x.collection
		out ~~= ") "
		out write-block-statement indent, x.body
	as js-return-statement
		if arg = x arg
			out ~~= "return "
			out write-expr indent, arg
		else
			out ~~= "return"
	as js-switch-statement
		out write-switch indent, x
	as js-throw-statement
		out ~~= "throw "
		out write-expr indent, x.arg
	as js-try-catch-statement
		out write-try-catch indent, x
	as js-try-finally-statement
		out write-try-finally indent, x
	as js-var-decl
		out write-var-decl indent, x
	as js-while-statement
		out write-while indent, x

-write-assign void(out output, indent nat, a js-assign-statement)
	out write-expr indent, a.left
	out ~~= " = "
	out write-expr indent, a.right
-write-if void(out output, indent nat, a js-if-statement)
	out ~~= "if ("
	out write-expr indent + 2, a.cond
	out ~~= ") "
	out write-block-statement indent, a.then_
	if else_ = a else_
		out ~~= " else"
		if else_.kind js-if-statement
			out ~= " "
			out write-statement indent, else_, first
		else
			_ = out write-statement-indented indent, else_, first
-write-switch void(out output, indent nat, a js-switch-statement)
	out ~~= "switch ("
	out write-expr indent + 2, a.arg
	out ~~= ") \{"
	for case_ in a cases
		out ~~= indent + 1 newline
		out ~~= "case "
		out write-expr indent, case_.value
		out ~= ":"
		out write-block-statement indent + 1, case_.then_
	out ~~= "{indent + 1 newline}default:"
	out write-block-statement indent + 1, a.default
	out ~~= "{indent newline}}"
-write-try-catch void(out output, indent nat, a js-try-catch-statement)
	out ~~= "try "
	out write-block-statement indent, a.tried
	out ~~= " catch ({a exception}) "
	out write-block-statement indent, a.catch_
-write-try-finally void(out output, indent nat, a js-try-finally-statement)
	out ~~= "try "
	out write-block-statement indent, a.tried
	out ~~= " finally "
	out write-block-statement indent, a.finally_
-write-var-decl void(out output, indent nat, a js-var-decl)
	out ~~= "{a const} "
	for index, var in a.vars with-index
		unless index == 0
			out ~~= ", "
		out write-destructure var.destructure
		if initializer = var initializer
			out ~~= " = "
			out write-expr indent, initializer
-write-while void(out output, indent nat, a js-while-statement)
	if label = a label
		out ~~= "{label}: "
	out ~~= "while ("
	out write-expr indent + 2, a.condition
	out ~= ")"
	out write-block-statement indent, a.body

# Returns true if it was a block
-write-statement-indented bool(out output, indent nat, a js-statement, pos statement-pos)
	match x = a kind
	as js-block-statement
		out ~= " "
		out write-block-statement indent, x
		true
	else
		out ~~= indent + 1 newline
		out write-statement indent + 1, a, pos
		false

-expr-pos record
	| Expression is at the start of a statement and may need ';'
	is-non-first-statement bool
	| Expression is called and may need to be wrapped in '()'
	is-called bool
-with-called expr-pos(a expr-pos)
	a.is-non-first-statement, true
-expr expr-pos()
	false, false
-statement-first expr-pos()
	false, false
-statement-non-first expr-pos()
	true, false
-write-expr void(out output, indent nat, a js-expr)
	out write-expr indent, a, expr
-write-expr void(out output, indent nat, a js-expr, pos expr-pos)
	out mark-map a.source
	write-arg void mut(arg js-expr) = of arg
		out write-expr indent, arg, expr
	write-arg-with-pos void mut(arg js-expr, arg-pos expr-pos) = of arg, arg-pos
		out write-expr indent, arg, arg-pos
	write-args void mut(args js-expr[]) = of args
		out write-with-commas args, of arg
			out write-expr indent + 1, arg
	match x = a kind
	as js-array-expr
		out ~= "["
		write-args[x elements]
		out ~= "]"
	as js-arrow-function
		out write-arrow-function indent, pos, x
	as js-assign-expr
		out ~~= "({x assignee} = "
		write-arg[x value]
		out ~= ")"
	as js-binary-expr
		if pos is-non-first-statement
			out ~= ";"
		out ~= "("
		write-arg[x left]
		out ~= " "
		out ~~= "{x.kind operator}"
		out ~= " "
		write-arg[x right]
		out ~= ")"
	as js-call-expr
		write-arg-with-pos[x.called, pos.with-called]
		out ~= "("
		write-args[x args]
		out ~= ")"
	as js-call-with-spread-expr
		write-arg-with-pos[x.called, pos.with-called]
		out ~= "("
		write-args[x args]
		unless x.args is-empty
			out ~~= ", "
		out ~~= "..."
		write-arg[x spread-arg]
		out ~= ")"
	as js-literal-bigint
		out ~~= if x is-signed
			"{x.value.to::int}"
		else
			"{x.value.to::nat}"
		out ~= "n"
	as js-literal-bool
		out ~~= "{x value}"
	as js-literal-number
		out write-on-single-line (x.value float-literal-for-js x.type)
	as js-literal-string
		out write-on-single-line "{x.value quoted}"
	as js-name
		out ~~= "{x}"
	as js-new-expr
		out ~~= "new ("
		write-arg[x class_]
		out ~~= ")("
		write-args[x arguments]
		out ~= ")"
	as js-null-expr
		out ~~= "null"
	as js-optional-property-access-expr
		write-arg-with-pos[x.object, pos]
		out ~= "?"
		out ~~= x.property-name property-access
	as js-property-access-expr
		write-arg-with-pos[x.object, pos]
		out ~~= x.property-name property-access
	as js-property-access-computed-expr
		write-arg-with-pos[x.object, pos]
		out ~= "["
		write-arg[x property-name]
		out ~= "]"
	as js-ternary-expr
		if pos is-non-first-statement
			out ~= ";"
		out ~= "("
		write-arg[x condition]
		out ~~= " ? "
		write-arg[x then_]
		out ~~= " : "
		write-arg[x else_]
		out ~= ")"
	as js-this-expr
		out ~~= "this"
	as js-unary-expr
		if pos is-non-first-statement
			out ~= ";"
		out ~= "("
		out ~~= x.kind operator
		write-arg[x arg]
		out ~= ")"

-write-arrow-function void(out output, indent nat, pos expr-pos, a js-arrow-function)
	if pos is-non-first-statement
		out ~= ";"
	if pos is-called
		out ~= "("
	out ~~= a.async maybe-async
	out write-params a.params, false
	out ~~= " =>"
	out write-expr-or-block-statement-indented indent, a.body
	if pos is-called
		out ~= ")"

-operator string(a js-binary-kind)
	match a
	as bit-shift-left
		"<<"
	as bit-shift-right
		">>"
	as bit-shift-right-unsigned
		">>>"
	as bitwise-and
		"&"
	as bitwise-or
		"|"
	as bitwise-xor
		"^"
	as comma
		","
	as divide
		"/"
	as eq-eq-eq
		"==="
	as greater
		">"
	as instanceof
		"instanceof"
	as less
		"<"
	as minus
		"-"
	as modulo
		"%"
	as not-eq-eq
		"!=="
	as or_
		"||"
	as plus
		"+"
	as times
		"*"
-operator string(a js-unary-kind)
	match a
	as await
		"await "
	as bitwise-not
		"~"
	as not
		"!"
	as typeof
		"typeof "
	as void
		"void "

-maybe-async string(a sync-or-async)
	match a
	as sync
		""
	as async
		"async "

-float-literal-for-js string(a float, type float-type)
	if a == trusted nan
		"Number.NaN"
	elif a == infinity
		"Number.POSITIVE_INFINITY"
	elif a == -infinity
		"-Number.POSITIVE_INFINITY"
	else
		res string = a show
		# TODO: float parse res is a --------------------------------------------------------------------------------------------------------
		match type
		as float32
			"Math.fround({res})"
		as float64
			res
