import
	../../app/command
	../../frontend/show-model
	../../model/low-model
	../../model/model
	../../model/show-low-model
	../../model/source-range
	../../model/uri
	../../util/perf
	../../util/util
	../util
	./js-ast
	./mangle-for-js
	./source-map
	./union-representation
	./write-js-ast

translate-to-js js-and-map
	program low-program
	sanity-checks sanity-checks
	source-map-name string?
do show-ctx
	start = perf-now
	finally end-translate-to-js start
	the low-common-types = program.common-types
	the to-js-ctx =
		program: program
		sanity-checks: sanity-checks
		union-info: plan-unions program
		mangled-names: build-mangled-names program
		constant-names: gen-constant-names program
	classes js-class-decl[] = for* type in program.all-non-extern-types
		from-option translate-type type
	functions js-fun-decl[] = with out in build
		for x in program.all-non-extern-funs
			out ~~= to-js-functions x
		for var in program.all-vars
			match var.kind
			as thread-local_
				throw todo
			as global_
				if var-needs-getter var
					out ~= gen-var-getter var
		each-constant-in-dependency-order program, of x
			# TODO: This is just an arbitrary source. there should be a way to have a null source?
			source source = source program.common-funs.low-common-funs-js!.to-symbol-from-string
			out ~= constant-getter source, x

	vars js-var-decl[] = with out in build
		for var in program.all-vars
			match var.kind
			as thread-local_
				throw todo
			as global_
				if var-needs-getter var
					out ~= let, var.js-name, ()
				elif has-simple-initializer var
					out ~= gen-var-no-getter var
		to-symbol = program.common-funs.low-common-funs-js!.to-symbol-from-string
		source source = source to-symbol
		to-symbol-ref = to-ref source, to-symbol, sync
		for index, sym in with-index program.all-constants.symbols
			args js-expr[] =
				- to-string-from-js-string source, gen-string source, sym.to
			out ~= const, index.constant-symbol-name, gen-call-sync source, to-symbol-ref, args
		for var in program.all-vars
			match var.kind
			as thread-local_
				throw todo
			as global_
				unless var-needs-getter var or has-simple-initializer var
					out ~= gen-var-no-getter var

	ast js-script-ast =
		classes: classes
		functions: functions
		vars: vars
		statements:
			gen-call-main program.common-funs.low-common-funs-js!.main 'to
	module-paths = module-paths program.model-program
	write-js-ast file-content-getters, module-paths, ast, sanity-checks, source-map-name

# Emit vars with simple initializers before symbols (this happens to be the only kind of constants that requires)
-has-simple-initializer bool(a low-var)
	!!a.initializer.constant-low-expr.?value.?scalar-value

-gen-var-no-getter js-var-decl(var low-var) to-js
	# TODO: actually detect whether it needs to be async
	the to-expr-ctx = async, var.source::var-decl.name
	const: let
	destructure: js-name var
	initializer: to-js-expr var.initializer

-gen-constant-names nat constant-names(program low-program) show-ctx
	out nat constant-names-builder = ()
	constant-index mut = 0
	each-constant-in-dependency-order program, of x
		out[x] := constant-index
		constant-index +:= 1
	finish out

-constant-symbol-name js-name(index nat)
	no-prefix "_symbol{index}"

-gen-call-main js-statement[](main low-fun) to-js
	###
	const exit = main(typeof process === 'undefined' ? [] : process.argv.slice(2).map(x => toString(x))
	if (exit !== 0n) process.exit(Number(exit))
	###
	source source = source main
	process = gen-global source, "process"
	argv =
		typeof-process = gen-typeof source, process
		process-is-undefined = gen-eq-eq-eq source, typeof-process, gen-string source, "undefined"
		empty-array = gen-array source, ()
		process-argv-slice =
			process-argv = gen-property-access source, process, "argv"
			gen-call-property-sync source, process-argv, "slice",
				- gen-number64 source, 2
		to-string-lambda =
			x = no-prefix "x"
			gen-arrow-function source, sync, (x,),
				to-string-from-js-string source, gen-identifier source, x
		process-argv-mapped = gen-call-property-sync source, process-argv-slice, "map", (to-string-lambda,)
		gen-ternary source, process-is-undefined, empty-array, process-argv-mapped
	main-async sync-or-async = if main.async-fun-kind == always-async then async else sync
	call-main = gen-call-sync source, (to-ref source, main, main-async), (argv,)
	exit js-name = no-prefix "exit"
	get-exit = gen-identifier source, exit
	exit-neq-0 = gen-not-eq-eq source, get-exit, gen-bigint-unsigned source, 0
	call-exit = gen-call-property-sync source, process, "exit",
		- gen-call-sync source, (gen-global source, "Number"), (get-exit,)
	- gen-const source, exit, gen-await-if-async source, main-async, call-main
	- gen-if source, exit-neq-0, call-exit.to

# TODO: this does expose the URIs on the build machine ...
-module-paths module-paths(program program)
	for uri, _ in program.keen-modules
		uri, uri.to

-translate-type js-class-decl?(a low-type) to-js
	extends js-name? = if union-info.exception-case-types[a]
		js-name exception
	match body = a.body
	as low-builtin-type
		()
	as low-enum
		()
	as low-flags
		()
	as low-java-class
		throw unreachable
	as low-record
		class-for-record a, extends, body
	as low-union
		class-for-union a, extends
	as low-type-body-deferred
		throw unreachable

-gen-is-type js-expr?(source source, get js-expr, a low-type) to-js-ctx
	match x = a.body
	as low-builtin-type
		gen-is-builtin-type source, get, x
	as low-enum
		gen-is-nat source, get, x.storage
	as low-flags
		gen-is-nat source, get, x.storage
	as low-java-class
		throw unreachable
	as low-record
		gen-instanceof source, get, to-ref source, a
	as low-union
		()
	as low-type-body-deferred
		throw unreachable

-gen-type-assert js-statement?(source source, get js-expr, a low-type) to-js
	do if sanity-checks == all-sanity-checks
	do if is-type = gen-is-type source, get, a
	# Allow 'gc-safe-value'
	is-type-or-null = gen-or source, is-type, gen-eq-eq-eq source, get, source.gen-null
	gen-call-sync source, (gen-identifier source, "_assert".no-prefix), (is-type-or-null,) 'to

-gen-is-builtin-type js-expr?(source source, get js-expr, a low-builtin-type)
	instanceof = of x string
		gen-instanceof source, get, gen-identifier source, x.no-prefix
	typeof  = of x string
		gen-typeof-is source, get, x
	array = of
		instanceof[a.type-args.only!.js-array-type-for-element-type.to]
	match a.kind
	as array
		array[]
	as bool
		typeof["boolean"]
	as buffer
		array[]
	as char8
		typeof["number"]
	as char32
		typeof["number"]
	as float32
		typeof["number"]
	as float64
		typeof["number"]
	as future
		instanceof["Promise"]
	as int8
		typeof["number"]
	as int16
		typeof["number"]
	as int32
		typeof["number"]
	as int64
		typeof["bigint"]
	as js-any
		()
	as lambda-data
		typeof["function"]
	as lambda-mut
		typeof["function"]
	as lambda-shared
		typeof["function"]
	as nat8
		typeof["number"]
	as nat16
		typeof["number"]
	as nat32
		typeof["number"]
	as nat64
		typeof["bigint"]
	as option
		throw unreachable
	as void
		typeof["undefined"]
	as weak-ref
		instanceof["WeakRef"]

-gen-is-nat js-expr(source source, get js-expr, type nat-type)
	gen-typeof-is source, get, match type
	as nat8
		"number"
	as nat16
		"number"
	as nat32
		"number"
	as nat64
		"bigint"

-gen-typeof-is js-expr(source source, get js-expr, expected string)
	gen-eq-eq-eq source, (gen-typeof source, get), (gen-string source, expected)

-unreachable js-expr(source source)
	gen-call-sync source, (gen-identifier source, "_unreachable".no-prefix), ()

-source source(a low-type) to-js
	range uri-and-range = a.source.range
	uri: range.uri
	name: show-low-type a 'to
	pos: line-and-character-getters[range].range.start
-source source(a low-fun) to-js
	range = a.range
	range.uri, a.debug-name, line-and-character-getters[range].range.start
-source source(a low-var) to-js
	range = a.range
	range.uri, a.source::var-decl.name, line-and-character-getters[range].range.start
-debug-name symbol(a low-fun) to-js
	show-low-fun-name a 'to

-class-for-record js-class-decl(a low-type, extends js-name?, r low-record) to-js
	###
	class R {
		constructor(x, y) {
			if (!(x instanceof Whataver)) throw new Error()
			this.x = x
			this.y = y
		}
	}
	###
	names string[] = map r.fields, it.name.to
	comment: show-low-type a
	name: js-name a
	extends: extends
	members: unless is-empty r.fields
		source source = source a
		- gen-constructor source, !!extends, names, of index, get
			gen-type-assert source, get, r.fields[index].type

-class-for-union js-class-decl?(a low-type, extends js-name?) to-js
	match union-representation a
	as direct
		if a == exception
			name = js-name a
			forbid extends
			comment: ""
			name: name
			extends: no-prefix "Error"
			members:
				-
					source source = source a
					source: source
					name: "message"
					kind:
						# return new TextDecoder().decode(show(this).chars)
						show-exception = to-ref source, program.common-funs.show-exception, sync
						js-class-getter gen-block-statement
							- gen-return source, convert-to-js-string source,
								gen-call-sync source, show-exception,
									- gen-this source
	as switch
		###
		class U {
			constructor(index, value) {
				this.index = index
				this.value = value
			}
		}
		###
		comment: show-low-type a
		name: js-name a
		extends: extends
		members:
			- gen-constructor a.source, !!extends, ("index", "value"), it.noop

-gen-constructor js-class-member
	source source
	call-super bool
	names string[]
	check-field js-statement? mut(index nat, value js-expr)
do
	params js-destructure[] = map names, it.no-prefix
	this = gen-this source
	identifiers js-expr[] = for name in names
		gen-identifier source, name.no-prefix
	statements js-statement[] =
		-- if call-super
			- gen-call-sync source, (gen-global source, "super"), () 'to
		-- for* index, value in with-index identifiers
			from-option check-field[index, value]
		-- for name, identifier in zip names, identifiers
			this_x = gen-property-access source, this, name
			gen-assign source, this_x, identifier
	source, "constructor", js-class-method sync, params.to, statements.to

-js-name js-name(fun low-fun, async sync-or-async) to-js-ctx
	no-prefix mangled-names[fun, async]
-js-name js-name(var low-var) to-js-ctx
	no-prefix mangled-names[var]
-var-getter-name js-name(var low-var) to-js-ctx
	no-prefix "_varget_{mangled-names[var]}"
-js-name js-name(type low-type) to-js-ctx
	no-prefix mangled-names[type]
-to-ref js-expr(source source, fun low-fun, async sync-or-async) to-js-ctx
	gen-identifier source, js-name fun, async
-to-ref js-expr(source source, var low-var) to-js-ctx
	gen-identifier source, js-name var
-to-ref js-expr(source source, type low-type) to-js-ctx
	gen-identifier source, js-name type

-to-js spec show-ctx, low-common-types, to-js-ctx
-to-js-ctx record
	program low-program
	sanity-checks sanity-checks
	union-info union-info
	mangled-names js-mangled-names
	constant-names nat constant-names
-sanity-checks sanity-checks() to-js-ctx
	the::to-js-ctx.sanity-checks
-program low-program() to-js-ctx
	the::to-js-ctx.program
-union-info union-info() to-js-ctx
	the::to-js-ctx.union-info
-mangled-names js-mangled-names() to-js-ctx
	the::to-js-ctx.mangled-names
-constant-names nat constant-names() to-js-ctx
	the::to-js-ctx.constant-names
-common-funs low-common-funs-js() to-js-ctx
	the::to-js-ctx.program.common-funs.low-common-funs-js!
-is-string-or-symbol bool(a low-type) low-common-types
	a == string or a == symbol
-async-info low-async-info() to-js-ctx
	program.async!
-async-fun-kind async-kind?(a low-fun) to-js-ctx
	program.async!.funs[a]

-to-expr spec to-js, to-expr-ctx
-to-expr-ctx record mut
	is-cur-fun-async sync-or-async
	cur-fun-debug-name symbol
	cur-loop-label mut js-name?
	top-declared-locals js-name mut[]
	temp-local-indices nat mut[low-local]
	next-generated-temp-index mut nat
-is-cur-fun-async sync-or-async() to-expr-ctx
	the::to-expr-ctx.is-cur-fun-async
-cur-fun-debug-name symbol() to-expr-ctx
	the::to-expr-ctx.cur-fun-debug-name
-with-declare-locals js-expr-or-block-statement(source source, locals js-name[], expr js-expr-or-block-statement)
	if is-empty locals
		expr
	else
		block js-block-statement = match expr
		as js-expr
			gen-return source, expr 'to
		as js-block-statement
			expr
		decl js-var-decl = let, for x in locals then x, ()
		(source, decl) ~ block
-new to-expr-ctx(is-cur-fun-async sync-or-async, cur-fun-debug-name symbol)
	is-cur-fun-async: is-cur-fun-async
	cur-fun-debug-name: cur-fun-debug-name
	cur-loop-label: ()
	top-declared-locals: ()
	temp-local-indices: ()
	next-generated-temp-index: ()
-finish-locals js-name[]() to-expr-ctx
	the::to-expr-ctx.top-declared-locals.move-to
-take-next-temp-index nat() to-expr-ctx
	res = the::to-expr-ctx.next-generated-temp-index
	the::to-expr-ctx.next-generated-temp-index +:= 1
	res
-union-representation union-representation(union_ low-type) to-js-ctx
	union-representation the::to-js-ctx.union-info, union_

-source source(a low-expr) to-expr
	source a, cur-fun-debug-name
-source source(a low-expr, cur-fun-debug-name symbol) to-js
	uri: a.uri
	name: cur-fun-debug-name
	pos: line-and-character-getters[a.start].pos

-is-async sync-or-async(a low-fun) to-expr
	if async-fun-kind a
		is-cur-fun-async
	else
		sync
-is-async-initializer sync-or-async(a low-var) to-js-ctx
	if async-info.var-initializers[a] then async else sync

-gen-var-getter js-fun-decl(a low-var) to-js
	async = is-async-initializer a
	name = var-getter-name a
	the to-expr-ctx = async, a.source::var-decl.name
	initializer = to-js-expr a.initializer
	###
	if (x === undefined) x = initializer
	return x
	###
	source source = source a
	x = to-ref source, a
	body js-statement[] =
		x-eq-undefined = gen-eq-eq-eq source, x, source.gen-undefined
		initialize = gen-assign source, x, initializer
		- gen-if source, x-eq-undefined, initialize.to
		- gen-return source, x
	name: name
	fun: async, (), body.to

-to-js-functions js-fun-decl[](a low-fun) to-js
	if x = async-fun-kind a
		match x
		as always-async
			- to-js-function a, async
		as sync-and-async
			- to-js-function a, sync
			- to-js-function a, async
	else
		- to-js-function a, sync
-to-js-function js-fun-decl(a low-fun, async sync-or-async) to-js
	the to-expr-ctx = async, debug-name a
	body = to-expr-or-block-statement a
	locals = finish-locals
	comment: show-low-fun-name a
	name: js-name a, async
	fun:
		async: async
		params: map a.params, it.local-name
		body: with-declare-locals a.source, locals, body

-to-expr-or-block-statement js-expr-or-block-statement(a low-fun) to-expr
	source source = source a
	get-params = of
		:: js-expr[]
		map a.params, of x then get-local source, x
	match body = a.body
	as low-expr
		res = to-expr-or-block-statement body
		type-asserts js-statement[] = unless sanity-checks == no-sanity-checks
			for* param in a.params
				from-option gen-type-assert source, (get-local source, param), param.type
		if is-empty type-asserts
			res
		else
			(type-asserts,) ~~ (to-block-statement res, a.return-type)
	as fun-body-extern-java
		throw unreachable
	as low-fun-body-method
		throw todo
	as low-fun-body-deferred
		throw unreachable
	as low-fun-body-always-inline
		throw unreachable
	as low-builtin-unary
		translate-builtin-unary a.return-type, source, body, a.params.only!.type, only! get-params[]
	as low-builtin-binary
		translate-builtin-binary a.return-type, source, body, a.params[0].type, is-cur-fun-async, only2! get-params[]
	as low-builtin-ternary
		translate-builtin-ternary source, body, only3! get-params[]
	as js-fun
		throw todo

-translate-builtin-unary js-expr-or-block-statement
	type low-type
	source source
	a low-builtin-unary
	arg-type low-type
	arg js-expr
do to-expr
	unary = of op js-unary-kind
		gen-unary source, op, arg
	match a
	as array-size
		# BigInt(arg.length)
		BigInt = gen-global source, "BigInt"
		length = gen-property-access source, arg, "length"
		gen-call-sync source, BigInt, (length,)
	as bits-of-float32
		gen-convert source, 4, "Float32Array", "Uint32Array", arg
	as bits-of-float64
		gen-convert source, 8, "Float64Array", "BigInt64Array", arg
	as bitwise-not
		gen-as-integral source, type.as-integral-type!, unary[bitwise-not]
	as drop
		gen-unary source, void, arg
	as float32-from-bits
		Number = gen-global source, "Number"
		gen-convert source, 4, "Uint32Array", "Float32Array",
			gen-call-sync source, Number, (arg,)
	as float64-from-bits
		gen-convert source, 8, "BigInt64Array", "Float64Array", arg
	as uninitialized-buffer
		array-type = js-array-type type
		array = gen-new source, (gen-global source, array-type.to),
			- gen-call-sync source, (gen-global source, "Number"), (arg,)
		match array-type
		as Array
			# In JS, a 'new Array' has *missing* values, which perform worse than null values
			gen-call-property-sync source, array, "fill",
				- gen-null source
		else
			# All other array types have sensible default values
			# new Uint8Array(size)
			array
	as not
		gen-not source, arg
	as reinterpret-cast
		arg
	as to-float32-from-float64
		gen-as-float32 source, arg
	as to-float64-from-float32
		arg
	as to-float64-from-int64
		gen-call-sync source, (gen-global source, "Number"), (arg,)
	as to-float64-from-nat64
		gen-call-sync source, (gen-global source, "Number"), (arg,)
	as truncate-to-int64-from-float64
		trunc = gen-call-math source, "trunc", arg
		gen-call-sync source, (gen-global source, "BigInt"), (trunc,)
	as weak-ref-get
		###
		const got = arg?.get()
		return got === undefined ? new None() : got
		###
		arg-get js-expr = gen-optional-call-property-sync source, arg, "deref", ()
		with got in temp-local "got", source, arg-get
			got-eq-undefined = gen-eq-eq-eq source, got, source.gen-undefined
			none-type = type.body.low-union!.members[0]
			new-none = gen-new source, (to-ref source, none-type), () # TODO:PERF don't construct it every time
			none = gen-create-union source, type, 0, new-none
			some = gen-create-union source, type, 1, got
			gen-ternary source, got-eq-undefined, none, some
	as weak-ref-new
		WeakRef = gen-global source, "WeakRef"
		gen-new source, WeakRef, (arg,)
	as wrap-convert-integral
		out = as-integral-type-allow-char! type
		if is-bool arg-type
			name = if is-64-bit out then "BigInt" else "Number"
			gen-call-sync source, (gen-identifier source, name.no-prefix), (arg,)
		else
			in_ = as-integral-type-allow-char! arg-type
			gen-as-integral source, out, if is-64-bit in_
				if is-64-bit out
					arg
				else
					gen-call-sync source, (gen-global source, "Number"), (arg,)
			else
				if is-64-bit out
					gen-call-sync source, (gen-global source, "BigInt"), (arg,)
				else
					arg

-translate-builtin-binary js-expr-or-block-statement
	type low-type
	source source
	a low-builtin-binary
	arg0-type low-type
	is-cur-fun-async sync-or-async
	(arg0 js-expr, arg1 js-expr)
do
	binary = of op js-binary-kind
		gen-binary source, op, arg0, arg1
	bitwise = of op js-binary-kind
		res = binary[op]
		if is-nat32 type then gen-to-nat32 source, res else res
	match a
	as add-float
		match as-float-type! type
		as float32
			# Need to convert to float32
			gen-as-float32 source, binary[plus]
		as float64
			binary[plus]
	as array-get
		gen-property-access-computed source, arg0, arg1
	as bitwise-and
		bitwise[bitwise-and]
	as bitwise-or
		bitwise[bitwise-or]
	as bitwise-xor
		bitwise[bitwise-xor]
	as call-lambda
		call = gen-call-sync source, arg0, (arg1,)
		gen-await-if-async source, is-cur-fun-async, call
	as compare
		name = if is-float32-or-64 arg0-type then "_compareFloat" else "_compareIntegral"
		gen-call-sync source, (gen-identifier source, name.no-prefix), (arg0, arg1)
	as equal-exact
		gen-call-property-sync source, (gen-global source, "Object"), "is", (arg0, arg1)
	as equal-float-ieee
		binary[eq-eq-eq]
	as less-float-ieee
		binary[less]
	as mul-float
		match as-float-type! type
		as float32
			gen-as-float32 source, binary[times]
		as float64
			binary[times]
	as sub-float
		match as-float-type! type
		as float32
			gen-as-float32 source, binary[minus]
		as float64
			binary[minus]
	as unsafe-bit-shift-left
		gen-as-integral source, type.as-integral-type!, binary[bit-shift-left]
	as unsafe-bit-shift-right
		integral = type.as-integral-type!
		op = if integral == nat64 then bit-shift-right else bit-shift-right-unsigned
		gen-as-integral source, integral, binary[op]
	as unsafe-div
		if f = as-float-type type
			match f
			as float32
				gen-as-float32 source, binary[divide]
			as float64
				binary[divide]
		else
			assert as-integral-type type
			binary[divide]
	as unsafe-mod-float64
		binary[modulo]
	as unsafe-mod-nat64
		binary[modulo]
	as wrap-add
		gen-as-integral source, type.as-integral-type!, binary[plus]
	as wrap-mul
		gen-as-integral source, type.as-integral-type!, binary[times]
	as wrap-sub
		gen-as-integral source, type.as-integral-type!, binary[minus]

-translate-builtin-ternary js-expr-or-block-statement
	source source
	a low-builtin-ternary
	(arg0 js-expr, arg1 js-expr, arg2 js-expr)
do
	match a
	as array-set
		access = gen-property-access-computed source, arg0, arg1
		gen-assign source, access, arg2 'to

-translate-js-fun js-expr-or-block-statement(source source, a js-fun, args low-expr[]) to-expr
	arg0 = of
		to-js-expr args[0]
	args-after = of first nat
		map::js-expr[] args[first .. end], it.to-js-expr
	only-arg = of
		to-js-expr only! args
	only2-args = of
		:: (js-expr, js-expr)
		x, y = only2! args
		x.to-js-expr, y.to-js-expr
	unary = of kind js-unary-kind
		gen-unary source, kind, only-arg[]
	binary = of kind js-binary-kind
		gen-binary source, kind, only2-args[]
	prop01 = of
		property-access source, args[0], args[1]
	match a
	as await
		gen-await source, only-arg[]
	as call
		gen-call-sync source, arg0[], args-after[1]
	as call-new
		gen-new source, arg0[], args-after[1]
	as call-property
		gen-call-sync source, prop01[], args-after[2]
	as call-property-spread
		args.size is 3
		gen-call-with-spread source, sync, prop01[], (), args[2].to-js-expr
	as eq-eq-eq
		binary[eq-eq-eq]
	as eval
		gen-call-sync source, (gen-global source, "eval"),
			- only-arg[]
	as subscript
		args.size is 2
		prop01[]
	as import_
		gen-await source, gen-call-sync source, (gen-global source, "import"), (only-arg[],)
	as instanceof
		binary[instanceof]
	as js-global
		gen-global source, "_global" # This is generated at top of write-js-ast
	as null
		gen-null source
	as plus
		binary[plus]
	as set-subscript
		args.size is 3
		gen-assign source, prop01[], args[2].to-js-expr 'to
	as typeof
		unary[typeof]
	as undefined
		gen-undefined source

-property-access js-expr(source source, object low-expr, key low-expr) to-expr
	assert is-js-any key.type
	gen-property-access-computed source, object.to-js-expr, key.to-js-expr

-to-string-from-js-string js-expr(source source, arg js-expr) to-js-ctx
	gen-call-sync source, (to-ref source, common-funs.to-string-from-js-any, sync), (arg,)

-convert-to-js-string js-expr(source source, arg js-expr)
	# TODO:PERF just have this call 'to-js-string' from string.keen!
	# new TextDecoder().decode(new Uint8Array(arg.chars.map(Number)))
	TextDecoder = gen-global source, "TextDecoder"
	text-decoder = gen-new source, TextDecoder, ()
	gen-call-property-sync source, text-decoder, "decode",
		Uint8Array = gen-global source, "Uint8Array"
		- gen-new source, Uint8Array,
			chars = gen-property-access source, arg, "chars"
			- gen-call-property-sync source, chars, "map",
				- gen-global source, "Number"

-to-js-expr js-expr(a low-expr) to-expr
	to-expr a.source, to-expr-or-block-statement a

-to-expr js-expr(source source, a js-expr-or-block-statement) to-expr
	to-expr is-cur-fun-async, source, a
-to-expr js-expr(is-cur-fun-async sync-or-async, source source, a js-expr-or-block-statement)
	match a
	as js-expr
		a
	as js-block-statement
		gen-iife source, is-cur-fun-async, a

-to-block-statement js-block-statement(a low-expr) to-expr
	to-expr-or-block-statement a 'to-block-statement a.type
-to-block-statement js-block-statement(a js-expr-or-block-statement, type low-type)
	match a
	as js-expr
		return-unless-void a, type.is-void
	as js-block-statement
		a

-return-unless-void js-block-statement(expr js-expr, is-void bool)
	if is-void
		expr.to
	else
		gen-return expr.source, expr 'to

-to-expr-or-block-statement js-expr-or-block-statement(a low-expr) to-expr
	source = source a
	type = a.type
	async = is-cur-fun-async
	match a
	as array-op-low-expr
		array-op a, a
	as builtin-unary-low-expr
		translate-builtin-unary type, source, a.fun, a.arg.type, to-js-expr a.arg
	as builtin-binary-low-expr
		translate-builtin-binary type, source, a.fun, a.arg0.type, async, (a.arg0.to-js-expr, a.arg1.to-js-expr)
	as builtin-ternary-low-expr
		translate-builtin-ternary source, a.fun, (a.arg0.to-js-expr, a.arg1.to-js-expr, a.arg2.to-js-expr)
	as builtin-js-low-expr
		translate-js-fun source, a.fun, a.args
	as call-low-expr
		call-async = is-async a.called
		called = to-ref source, a.called, call-async
		gen-call source, call-async, called, map a.args, it.to-js-expr
	as constant-low-expr
		translate-constant source, type, a.value
	as create-array-low-expr
		array-literal source, type, map a.args, it.to-js-expr
	as create-record-low-expr
		record_ = to-ref source, type
		gen-new source, record_, map a.args, it.to-js-expr
	as create-union-low-expr
		gen-create-union source, type, a.case-index, to-js-expr a.arg
	as finally-low-expr
		gen-try-finally source, a.below.to-block-statement, a.right.to-block-statement 'to
	as if-low-expr
		cond = to-js-expr a.cond
		match then_ = to-expr-or-block-statement a.then_
		as js-expr
			match else_ = to-expr-or-block-statement a.else_
			as js-expr
				gen-ternary source, cond, then_, else_
			as js-block-statement
				then-statement = return-unless-void then_, type.is-void
				gen-if source, cond, then-statement, (source, else_) 'to
		as js-block-statement
			gen-if source, cond, then_, (source, a.else_.to-block-statement) 'to
	as let-low-expr
		local = local-name a.local
		value = to-js-expr a.value
		kind js-var-decl-const = if is-mutable a.local then let else const
		then_ = to-expr-or-block-statement a.then_
		expr-or-block-statement-with-local kind, (local, source, value), then_
	as lambda-low-expr
		source: source
		kind:
			:: js-arrow-function
			async: async
			params: a.param.local-name,
			body: to-expr-or-block-statement a.body
	as local-get-low-expr
		get-local source, a.local
	as local-set-low-expr
		gen-assign source, (get-local source, a.local), (to-js-expr a.value) 'to
	as loop-low-expr
		###
		loop
			if x
				continue
			else
				break 42
		==>
		while (true) {
			if (x)
				continue
			else
				// In a void context, this will 'break' instead of 'return'
				return 42
		}
		###
		label js-name? = if is-void type then make-temp-local "loop"
		prev = the::to-expr-ctx.cur-loop-label
		the::to-expr-ctx.cur-loop-label := label
		res = gen-while-true source, label, to-block-statement a.body
		the::to-expr-ctx.cur-loop-label := prev
		res.to
	as loop-break-low-expr
		value = to-block-statement a.value
		if is-void type
			value ~ (gen-break source, the::to-expr-ctx.cur-loop-label!)
		else
			value
	as loop-continue-low-expr
		gen-continue source 'to
	as match-scalar-low-expr
		translate-match-integral source, type, a
	as match-string-like-low-expr
		assert is-string-or-symbol a.matched.type
		with matched in temp-local "matched", a.matched
			res mut = to-block-statement a.else_
			equals-async = is-async a.equals
			equals = to-ref source, a.equals, equals-async
			for case_ low-match-string-like-case in a.cases.reverse # TODO: should not need type annotation
				value = translate-constant source, a.matched.type, case_.value
				cond = gen-call source, equals-async, equals, (matched, value)
				then_ = to-block-statement case_.then_
				res := gen-if source, cond, then_, (source, res) 'to
			res
	as match-union-low-expr
		translate-match-union source, type, a
	as record-field-get-low-expr
		gen-property-access source, a.record_.to-js-expr, a.field.name.to
	as record-field-set-low-expr
		record_ = to-js-expr a.record_
		value = to-js-expr a.value
		access = gen-property-access source, record_, a.field.name.to
		gen-assign source, access, value 'to
	as seq-low-expr
		:: js-block-statement
		- for* part in a.parts
			statements to-block-statement part
	as throw-low-expr
		gen-throw source, a.thrown.to-js-expr 'to
	as try-low-expr
		translate-try source, type, a
	as try-let-low-expr
		translate-try-let source, type, a
	as union-assume-case-low-expr
		union-as-case source, a.arg, a.union-type
	as union-as-case-or-gc-safe-low-expr
		union-as-case source, a.arg, a.union-type
	as union-is-case-low-expr
		repr = union-representation a.union-type
		gen-union-is-case source, a.arg.to-js-expr, a.union_, repr, a.case-index
	as var-get-low-expr
		if var-needs-getter a.var
			getter = gen-identifier source, var-getter-name a.var
			gen-call source, a.var.is-async-initializer, getter, ()
		else
			to-ref source, a.var
	as var-set-low-expr
		gen-assign source, (to-ref source, a.var), a.value.to-js-expr 'to

-array-op js-expr-or-block-statement(a low-expr, x array-op-low-expr) to-expr
	source = source a
	type = a.type
	async = is-cur-fun-async
	input-expr = to-js-expr x.input
	match x.input-kind
	as array
		match output-kind x, type
		as array
			# TODO: PERF I should probably not use 'map' here, do a loop like I do for range
			# `xs.map(x => {... })` or `await Array.fromAsync(xs, async x => { ... })`
			params js-destructure[] = if l = x.local
				l.local-name,
			body = to-expr-or-block-statement x.body
			arrow js-arrow-function = async, params, body
			fn js-expr = source, arrow
			in-array-type = x.input.type.js-array-type
			out-array-type = type.js-array-type
			out-from = of input js-expr
				gen-call-property-sync source, (gen-global source, out-array-type.to), "from", (input,)
			js-Array = gen-global source, "Array"
			match async
			as sync
				map = of input js-expr
					gen-call-property-sync source, input, "map", (fn,)
				if in-array-type == out-array-type
					map[input-expr]
				elif in-array-type == Array
					out-from[map[input-expr]]
				else
					in-array = gen-call-property-sync source, js-Array, "from", (input-expr,)
					out-from[map[in-array]]
			as async
				mapped = gen-await source, gen-call-property-sync source, js-Array, "fromAsync", (input-expr, fn)
				if out-array-type == Array
					mapped
				else
					out-from[mapped]
		as void
			local = local-or-temp x.local, "ignore"
			(source, (js-for-of-statement local, input-expr, x.body.to-block-statement)) 'to
	as range
		low, high = range-fields x.input.type
		cur-name = make-temp-local "cur"
		cur-type = low.type
		end-name = make-temp-local "end"
		get-cur = gen-identifier source, cur-name
		get-end = gen-identifier source, end-name
		cur-less-end = gen-less source, get-cur, get-end
		match output-kind x, type
		as array
			###
			const { low: start, high: end } = range
			const out = new Array(Number(end - start))
			let cur = start
			while (cur < end) {
				out[cur - start] = ...
				cur = cur + 1n
			}
			return out
			###
			start-name = make-temp-local "start"
			get-start = gen-identifier source, start-name
			out-name = make-temp-local "out"
			get-out = gen-identifier source, out-name
			range-destructure js-object-destructure =
				fields:
					- low.name.to, start-name
					- high.name.to, end-name
			declare-start-end = gen-const source, range-destructure, to-js-expr x.input
			Array = array-for-array-type source, type
			Number = gen-global source, "Number"
			size = gen-call-sync source, Number,
				- gen-minus source, get-end, get-start
			new-array = gen-new source, Array, (size,)
			declare-out = gen-const source, out-name, new-array
			declare-cur = gen-let source, cur-name, get-start
			body js-statement[] =
				out-at-index = gen-property-access-computed source, get-out, (gen-minus source, get-cur, get-start)
				-- if l = x.local
					- gen-const source, l.local-name, get-cur
				- gen-assign source, out-at-index, to-js-expr x.body
				- gen-increment source, cur-type, cur-name
			while_ = gen-while source, cur-less-end, body.to
			return-out = gen-return source, get-out
			js-block-statement (declare-start-end, declare-out, declare-cur, while_, return-out)
		as void
			range-destructure js-object-destructure =
				fields:
					- low.name.to, cur-name
					- high.name.to, end-name
			declare-cur-end = gen-let source, range-destructure, to-js-expr x.input
			###
			let { low: cur, high:end } = range
			while (cur < end) {
				<<body>>
				cur = cur + 1n
			}
			###
			body js-statement[] =
				-- if l = x.local
					- gen-const source, l.local-name, get-cur
				-- statements to-block-statement x.body
				- gen-increment source, cur-type, cur-name
			while_ = gen-while source, cur-less-end, body.to
			js-block-statement (declare-cur-end, while_)

-union-as-case js-expr-or-block-statement(source source, arg low-expr, union-type low-type) to-expr
	match union-representation union-type
	as direct
		to-expr-or-block-statement arg
	as switch
		gen-property-access source, arg.to-js-expr, "value"

-gen-increment js-statement(source source, type low-type, name js-name)
	gen-increment source, name, type.as-integral-type!.is-bigint

-gen-create-union js-expr(source source, union_ low-type, member-index nat, value js-expr) to-js
	match union-representation union_
	as direct
		value
	as switch
		index = gen-number64 source, member-index.to
		gen-new source, (to-ref source, union_), (index, value)

-var-needs-getter bool(a low-var)
	!a.initializer.constant-low-expr

-array-literal js-expr(source source, array-type low-type, elements js-expr[])
	array = gen-array source, elements
	match x = js-array-type array-type
	as Array
		array
	else
		gen-new source, (gen-global source, x.to), (array,)

-translate-match-integral js-expr-or-block-statement(source source, type low-type, a match-scalar-low-expr) to-expr
	case-exprs js-expr-or-block-statement[] = map a.case-exprs, it.to-expr-or-block-statement
	else_ = if e = a.else_
		to-expr-or-block-statement e
	else
		unreachable source
	values js-expr[] = for value in a.case-values
		constant-integral source, a.matched-integral-type, value
	with matched in temp-local "matched", a.matched
		match x = to-exprs-or-block-statements (case-exprs ~ else_), type
		as array
			res mut = x[end - 1]
			for i nat in reverse 0 .. a.case-values.size
				res := gen-ternary source, (gen-eq-eq-eq source, matched, values[i]), x[i], res
			res
		as block-statements
			cases js-switch-case[] = for i nat in 0 .. a.case-values.size
				- values[i]
				- maybe-break-switch-case source, type, x.blocks[i]
			gen-switch source, matched, cases, x.blocks[end - 1] 'to
-translate-match-union js-expr-or-block-statement(source source, type low-type, x match-union-low-expr) to-expr
	else_ = if e = x.else_
		to-expr-or-block-statement e
	else
		unreachable source
	with matched in temp-local "matched", x.matched
		cases low-local-and-expr[] = map x.cases, ((), it)
		match-union source, type, matched, else_, x.union-type, x.case-indices, cases

-match-union js-expr-or-block-statement
	source source
	type low-type
	matched js-expr
	else_ js-expr-or-block-statement
	union-type low-type
	case-indices indices
	cases low-local-and-expr[]
do to-expr
	union_ = low-union! union-type.body
	repr = union-representation union-type
	###
	const matched = ...
	if (matched instanceof foo) {
		const x = matched
		...
	} else if (typeof matched === "number") {
		const x = matched
		...
	} else {
		...
	}
	###
	js-cases js-expr-or-block-statement[] = for case_ in cases
		to-expr-or-block-statement case_.expr
	get-cond = of i nat
		gen-union-is-case source, matched, union_, repr, case-indices[i]
	matched-value = match repr
	as direct
		matched
	as switch
		gen-property-access source, matched, "value"
	match x = to-exprs-or-block-statements js-cases ~ else_, type
	as array
		x.size is cases.size + 1
		res mut = x[cases.size]
		for i nat in reverse 0 .. cases.size
			expr = if l = cases[i].local
				add-local-and-assign (l.local-name, source, matched-value), x[i]
			else
				x[i]
			res := gen-ternary source, get-cond[i], expr, res
		res
	as block-statements
		x.blocks.size is cases.size + 1
		res mut = x.blocks[cases.size]
		for i nat in reverse 0 .. cases.size
			block = x.blocks[i]
			full-block = if l = cases[i].local
				(gen-const source, l.local-name, matched-value) ~ block
			else
				block
			res := gen-if source, get-cond[i], full-block, (source, res) 'to
		res

-gen-union-is-case js-expr
	source source
	union-value js-expr
	union_ low-union
	repr union-representation
	case-index nat
do to-expr
	match repr
	as direct
		gen-is-type! source, union-value, union_.members[case-index]
	as switch
		index = gen-property-access source, union-value, "index"
		gen-eq-eq-eq source, index, gen-number64 source, case-index.to

-exprs-or-block-statements union(js-expr[], block-statements)
-block-statements record(blocks js-block-statement[])
-to-exprs-or-block-statements exprs-or-block-statements(a js-expr-or-block-statement[], type low-type)
	map-every::js-expr[]? a, it.js-expr else
		block-statements for x in a then to-block-statement x, type

-translate-try js-block-statement(source source, type low-type, a try-low-expr) to-expr
	###
	try
		tried
	catch x as foo
		...
	==>
	try {
		tried()
	} catch (error) {
		if (error instanceof foo) {
			const x = error
			...
		} else {
			throw error
		}
	}
	###
	tried = to-block-statement a.tried
	error = local-or-temp a.catch-else.?local, "error"
	get-error = gen-identifier source, error
	else-block = if e = a.catch-else
		to-block-statement e.expr
	else
		gen-throw source, get-error 'to
	catch_ = match-union source, type, get-error, else-block, exception, a.exception-member-indices, a.catch-cases
	# catch_ will always be a block statement since the else-block is
	gen-try-catch source, tried, error, catch_.js-block-statement! 'to

-translate-try-let js-block-statement(source source, type low-type, a try-let-low-expr) to-expr
	###
	x = try value catch local as err then catch_
	after
	==>
	let local, ok
	try {
		local = value
		ok = true
	} catch (error) {
		if (error instanceof foo)
			const catch_local = error
			// For a void output, this won't return and will instead continue to the bottom.
			// That's why it checks 'if (ok)'
			return catch_then
		} else {
			throw error
		}
	}
	if (ok) after
	###
	local js-name? = ?local-name a.local
	let-local js-statement[] = if local
		- gen-let source, local
	# Only needed if void, otherwise 'catch_then' will return
	ok js-name? = if is-void type then make-temp-local "ok"
	let-ok js-statement[] = if ok
		- gen-let source, ok
	tried js-statement[] =
		-- if local
			- gen-assign source, local, to-js-expr a.value
		else
			statements to-block-statement a.value
		-- if ok
			- gen-assign source, ok, (gen-bool source, true)
	error = local-or-temp a.catch_.local, "error"
	get-error = gen-identifier source, error
	instanceof-caught-type = gen-is-type! source, get-error, caught-type a, exception
	catch_ = to-block-statement a.catch_.expr
	if_ = gen-if source, instanceof-caught-type, catch_, gen-throw source, get-error
	try_ = gen-try-catch source, tried.to, error, if_.to
	then_ = to-block-statement a.then_
	if-ok-then js-block-statement = if ok
		gen-if source, (gen-identifier source, ok), then_ 'to
	else
		then_
	let-local.to ~~ let-ok.to ~~ try_.to ~~ if-ok-then

-maybe-break-switch-case js-block-statement(source source, type low-type, a js-block-statement)
	if is-void type
		a ~ source.gen-break-no-label
	else
		a

-get-local js-expr(source source, a low-local) to-expr
	gen-identifier source, local-name a
-local-name js-name(a low-local) to-expr-ctx
	kind: local
	keen-name: match source = a.source
	as local
		source.name.to
	as low-generated-local-kind
		source.to
	mangle-index: ensure the::to-expr-ctx.temp-local-indices, a, of
		the::to-expr-ctx.temp-local-indices.size

-local-or-temp js-name(a low-local?, temp-base-name string) to-expr
	if a
		local-name a
	else
		make-temp-local temp-base-name

-constant-getter js-fun-decl(source source, a any-allocated-constant) to-js
	comment: ""
	name: constant-names[a].constant
	memoize: true
	fun: sync, (), gen-init-constant source, a
-gen-init-constant js-expr(source source, a any-allocated-constant) to-js
	match a
	as single-constant-array
		array-literal source, a.type, for e in a.elements
			translate-constant source, a.element-type, e
	as single-constant-record
		class_ = to-ref source, a.type
		gen-new source, class_, for field, arg in zip a.fields, a.args
			translate-constant source, field.type, arg

-translate-constant js-expr(source source, type low-type, a constant) to-js
	match x = type.body
	as low-builtin-type
		translate-constant-builtin source, type, x, a
	as low-enum
		constant-nat source, x.storage, a
	as low-flags
		constant-nat source, x.storage, a
	as low-java-class
		throw unreachable
	as low-record
		match a
		as constant-record
			gen-get-constant source, record-name constant-names, type, a
		as constant-gc-safe-value
			gen-null source
		as constant-symbol
			gen-identifier source, a.index.constant-symbol-name
		else
			throw unreachable
	as low-union
		match a
		as constant-union
			case-type, member-index, value = get-union program.all-constants, type, a
			gen-create-union source, type, member-index, translate-constant source, case-type, value
		as constant-gc-safe-value
			gen-null source
		else
			throw unreachable
	as low-type-body-deferred
		throw unreachable

-translate-constant-builtin js-expr(source source, type low-type, builtin_ low-builtin-type, a constant) to-js-ctx
	match kind builtin_
	as array
		match a
		as constant-array
			gen-get-constant source, array-name constant-names, type, a
		as constant-gc-safe-value
			gen-null source
		else
			throw unreachable
	as bool
		gen-bool source, a.as-bool
	as buffer
		match a
		as constant-gc-safe-value
			gen-null source
		else
			throw unreachable
	as char8
		constant-nat source, nat8, a
	as char32
		constant-nat source, nat32, a
	as float32
		gen-number32 source, as-float a
	as float64
		gen-number64 source, as-float a
	as future
		throw unreachable
	as int8
		constant-integral source, int8, a
	as int16
		constant-integral source, int16, a
	as int32
		constant-integral source, int32, a
	as int64
		constant-integral source, int64, a
	as js-any
		match a
		as constant-gc-safe-value
			gen-null source
		as constant-native-string
			gen-string source, a.value
		as scalar-value
			gen-number64 source, a.to
		else
			throw unreachable
	as lambda-data
		throw unreachable
	as lambda-mut
		throw unreachable
	as lambda-shared
		throw unreachable
	as nat8
		constant-nat source, nat8, a
	as nat16
		constant-nat source, nat16, a
	as nat32
		constant-nat source, nat32, a
	as nat64
		constant-nat source, nat64, a
	as option
		throw unreachable
	as void
		gen-undefined source
	as weak-ref
		assert constant-gc-safe-value a
		gen-null source

-gen-get-constant js-expr(source source, name nat)
	gen-call-sync source, (gen-identifier source, name.constant), ()

-constant-nat js-expr(source source, type nat-type, a constant)
	constant-integral source, type.to, a
-constant-integral js-expr(source source, type integral-type, a constant)
	constant-integral source, type, match a
	as scalar-value
		a
	as constant-gc-safe-value
		0::nat.to
	else
		throw unreachable
-constant-integral js-expr(source source, type char-or-integral-type, value scalar-value)
	constant-integral source, type.as-integral, value
-constant-integral js-expr(source source, type integral-type, value scalar-value)
	if is-signed type
		if is-bigint type
			gen-bigint-signed source, value.to::int64
		else
			gen-number64 source, value.to::int64.to
	else
		if is-bigint type
			gen-bigint-unsigned source, value.to::nat64
		else
			gen-number64 source, value.to::nat64.to
-is-bigint bool(type integral-type)
	type == int64 or type == nat64

-temp-local record(local js-name, source source, value js-expr)
-temp-local temp-local(name string, expr low-expr) to-expr
	temp-local name.make-temp-local, expr.source, expr.to-js-expr
-temp-local temp-local(name string, source source, expr js-expr) to-expr
	name.make-temp-local, source, expr
-make-temp-local js-name(base string) to-expr
	temp, base, take-next-temp-index
-with-block js-expr-or-block-statement
	a temp-local
	f js-expr-or-block-statement mut(get-temp js-expr)
do to-expr
	expr-or-block-statement-with-local const, a, f[gen-identifier a.source, a.local]
-expr-or-block-statement-with-local js-expr-or-block-statement
	kind js-var-decl-const
	local temp-local
	then_ js-expr-or-block-statement
do to-expr
	match then_
	as js-expr
		add-local-and-assign local, then_
	as js-block-statement
		(gen-var-decl local.source, kind, local.local, local.value) ~ then_

add-local-and-assign js-expr(local temp-local, then_ js-expr) to-expr
	the::to-expr-ctx.top-declared-locals ~= local.local
	assign js-expr = source: local.source, kind: js-assign-expr local.local, local.value
	gen-binary local.source, comma, assign, then_

| This function is run after an arithmetic operation to keep an integral type within its expected range.
-gen-as-integral js-expr(source source, type integral-type, arg js-expr)
	match type
	as int8
		gen-shift-and-unshift source, arg, 24
	as int16
		gen-shift-and-unshift source, arg, 16
	as int32
		gen-binary source, bitwise-or, arg, gen-number64 source, 0
	as int64
		gen-as-int64 source, arg
	as nat8
		gen-bitwise-and source, arg, gen-number64 source, type.max-value.to::float64
	as nat16
		gen-bitwise-and source, arg, gen-number64 source, type.max-value.to::float64
	as nat32
		gen-to-nat32 source, arg
	as nat64
		gen-as-nat64 source, arg
-gen-to-nat32 js-expr(source source, arg js-expr)
	gen-binary source, bit-shift-right-unsigned, arg, gen-number64 source, 0
-gen-shift-and-unshift js-expr(source source, arg js-expr, amount float64)
	amount-expr = gen-number64 source, amount
	x = gen-binary source, bit-shift-left, arg, amount-expr
	gen-binary source, bit-shift-right, x, amount-expr
-gen-as-int64 js-expr(source source, arg js-expr)
	BigInt = gen-global source, "BigInt"
	gen-call-property-sync source, BigInt, "asIntN",
		- gen-number64 source, 64
		- arg
-gen-as-nat64 js-expr(source source, arg js-expr)
	BigInt = gen-global source, "BigInt"
	gen-call-property-sync source, BigInt, "asUintN",
		- gen-number64 source, 64
		- arg

-gen-as-float32 js-expr(source source, arg js-expr)
	gen-call-math source, "fround", arg

-gen-call-math js-expr(source source, name string, arg js-expr)
	gen-call-math source, name, (arg,)
-gen-call-math js-expr(source source, name string, args js-expr[])
	gen-call-property-sync source, (gen-global source, "Math"), name, args

-gen-convert js-expr
	source source
	size-bytes nat
	input-array-type string
	output-array-type string
	arg js-expr
do to-expr
	###
	const buf = new ArrayBuffer(size_bytes)
	(new InputArray(buf))[0] = arg
	return (new OutputArray(buf))[0]
	###
	buf-name = make-temp-local "buf"
	buf = gen-identifier source, buf-name
	ArrayBuffer = gen-global source, "ArrayBuffer"
	new-buf = gen-new source, ArrayBuffer,
		- gen-number64 source, size-bytes.to
	declare-buf = gen-const source, buf-name, new-buf
	InputArray = gen-global source, input-array-type
	OutputArray = gen-global source, output-array-type
	input = gen-subscript-zero source, gen-new source, InputArray, (buf,)
	assign-to-input = gen-assign source, input, arg
	output = gen-subscript-zero source, gen-new source, OutputArray, (buf,)
	return-output = gen-return source, output
	gen-iife source, sync,
		- declare-buf, assign-to-input, return-output
-gen-subscript-zero js-expr(source source, arg js-expr)
	gen-property-access-computed source, arg, gen-number64 source, 0

-gen-iife js-expr(source source, async sync-or-async, block js-block-statement)
	fn js-expr = source, (js-arrow-function async, (), block)
	gen-call source, async, fn, ()

-array-for-array-type js-expr(source source, array-type low-type)
	array-for-element-type source, array-type.as-array-or-buffer!
-array-for-element-type js-expr(source source, element low-type)
	gen-global source, element.js-array-type-for-element-type.to

-js-array-type enum
	Array
	BigInt64Array
	BigUint64Array
	Int8Array
	Int16Array
	Int32Array
	Uint8Array
	Uint16Array
	Uint32Array
	Float32Array
	Float64Array
- == bool(a js-array-type, b js-array-type)
-to symbol(a js-array-type)
-to string(a js-array-type)
	a.to::symbol.to
-js-array-type js-array-type(array-type low-type)
	js-array-type-for-element-type as-array-or-buffer! array-type
-js-array-type-for-element-type js-array-type(element low-type)
	match body = element.body
	as low-builtin-type
		array-for-builtin-type body.kind
	as low-enum
		array-for-nat-type body.storage
	as low-flags
		array-for-nat-type body.storage
	as low-java-class
		throw unreachable
	as low-record
		Array
	as low-union
		Array
	as low-type-body-deferred
		throw unreachable
-array-for-builtin-type js-array-type(a builtin-type)
	match a
	as array then Array
	as bool then Array
	as buffer then Array
	as char8 then Uint8Array
	as char32 then Uint32Array
	as float32 then Float32Array
	as float64 then Float64Array
	as future then Array
	as int8 then Int8Array
	as int16 then Int16Array
	as int32 then Int32Array
	as int64 then BigInt64Array
	as js-any then Array
	as lambda-data then Array
	as lambda-mut then Array
	as lambda-shared then Array
	as nat8 then Uint8Array
	as nat16 then Uint16Array
	as nat32 then Uint32Array
	as nat64 then BigUint64Array
	as option then throw unreachable
	as void then Array
	as weak-ref then Array
-array-for-nat-type js-array-type(a nat-type)
	array-for-builtin-type a.to
