import
	../../model/low-model
	../../model/model
	../../util/util
	./js-ast

js-mangled-names record
	-var-to-name string[low-var]
	-fun-to-name string[low-fun]
	-type-to-name string[low-type]

build-mangled-names js-mangled-names(program low-program)
	var-to-name string[low-var] = for x in program.all-vars
		x, "v{get-hash x}" # TODO: include the name! -----------------------------------------------------------------------
	# TODO: do something fancier -------------------------------------------------------------------------------------------------
	fun-to-name string[low-fun] = for fun in program.all-non-extern-funs
		base-name = match source = fun.source
		as low-fun-source-regular
			mangle-name-common source.decl.name.to
		as low-fun-source-test
			"test"
		as low-fun-source-wrap-main
			"main"
		fun, "{base-name}{fun.hash}"
	type-to-name string[low-type] = for type in program.all-non-extern-types
		base-name = match source = type.source
		as low-type-source-bogus
			"bogus"
		as low-type-source-inst
			mangle-name-common source.decl.name.to
		type, "{base-name}{type.id}"
	var-to-name, fun-to-name, type-to-name # TODO: this would be neater as a named constructor expression ---------------------------

subscript string(a js-mangled-names, var low-var)
	a.var-to-name[var]!
subscript string(a js-mangled-names, (fun low-fun, async sync-or-async))
	res = a.fun-to-name[fun]!
	match async
	as sync
		res
	as async
		"_async_{res}"
subscript string(a js-mangled-names, type low-type)
	a.type-to-name[type]!

mangle-name-common string(a string)
	do unless every a, it.is-ascii-identifier-char else a
	do with out in build
	do for x in a
	if is-ascii-identifier-char x
		out ~= x
	else
		out ~~= "__"
		out ~~= x.to::nat32.show.to
