import
	../../model/concrete-model
	../../model/model
	../../util/util
	./js-ast

js-mangled-names record
	-var-to-name string[concrete-var]
	-fun-to-name string[concrete-fun]
	-type-to-name string[concrete-type]

build-mangled-names js-mangled-names(program concrete-program)
	var-to-name string[concrete-var] = for x in program.all-vars
		x, "v{get-hash x}" # TODO: include the name! -----------------------------------------------------------------------
	# TODO: do something fancier -------------------------------------------------------------------------------------------------
	fun-to-name string[concrete-fun] = for fun in program.all-non-extern-funs
		base-name string = match source = fun.source
		as concrete-fun-source-regular
			mangle-name-common source.decl.name.to
		as concrete-fun-source-test
			"test"
		as concrete-fun-source-wrap-main
			"main"
		fun, "{base-name}{fun.hash}"
	type-to-name string[concrete-type] = for type in program.all-non-extern-types
		base-name string = match source = type.source
		as concrete-type-source-bogus
			"bogus"
		as concrete-type-source-inst
			mangle-name-common source.decl.name.to
		type, "{base-name}{type.id}"
	var-to-name, fun-to-name, type-to-name # TODO: this would be neater as a named constructor expression ---------------------------

subscript string(a js-mangled-names, var concrete-var)
	a.var-to-name[var]!
subscript string(a js-mangled-names, (fun concrete-fun, async sync-or-async))
	res = a.fun-to-name[fun]!
	match async
	as sync
		res
	as async
		"_async_{res}"
subscript string(a js-mangled-names, type concrete-type)
	a.type-to-name[type]!

mangle-name-common string(a string)
	do with out in build
	do for x in a
	if is-ascii-identifier-char x
		out ~= x
	else
		out ~~= "__{x.to::nat32}"
