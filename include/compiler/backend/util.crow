import
	../frontend/show-model
	../model/concrete-model
	../model/model
	../model/show-concrete-model
	../util/full-index-map
	../util/util

exception concrete-type(a concrete-program)
	a.common-funs exception

is-wrapper bool(a concrete-type)
	!!a.as-wrapper
is-wrapper bool(a concrete-record)
	!!a.as-wrapper
as-wrapper concrete-field?(a concrete-type)
	a.body.concrete-record ?as-wrapper
as-wrapper concrete-field?(a concrete-record)
	guard f = a.fields opt-only
	guard f !is-mutable
	f

# TODO: MOVE, will need this for the JS build too ------------------------------------------------------------------------------
each-constant-in-dependency-order void(show-ctx show-ctx, program concrete-program, emit void mut(x any-constant))
	# TODO:PERF this could use a full-index-set -----------------------------------------------------------------------------
	seen-arrays (concrete-type, nat) mut-set = ()
	seen-records (concrete-type, constant-record) mut-set = ()
	can-reference bool mut(type concrete-type, c constant) = of type, c
		program can-reference seen-arrays, seen-records, type, c

	target = program target
	all-constants = program all-constants
	did-something mut bool = true
	while did-something
		did-something := false
		for arr in all-constants arrays
			guard arr array-needs-constant target
			for array-id, xs in arr.constants with-index
				key = arr.array-type, array-id
				guard key !in seen-arrays
				guard xs every can-reference[arr.element-type, it]
				seen-arrays ~= key
				emit[arr.array-type single-constant-array arr.element-type, array-id, xs]
				did-something := true
		for record-type, map in all-constants records
			guard record-type record-needs-constant target
			for constant, args in map
				key = record-type, constant
				guard key !in seen-records
				fields = record-type.body.concrete-record! fields
				guard args zip fields every of arg, field
					can-reference[field.type, arg]
				seen-records ~= key
				emit[record-type single-constant-record constant, args, fields]
				did-something := true
		
	# TODO: RM this debugging code ------------------------------------------------------------------------------------------------------------------
	for record-type, map in all-constants records	
		guard record-type record-needs-constant target
		for constant, args in map
			key = record-type, constant
			if key !in seen-records
				fields = record-type.body.concrete-record! fields
				error log "Could not emit constant record {show-ctx show-concrete-type record-type}"
				for arg, field in args zip fields
					if !can-reference[field.type, arg]
						error log "  Can not emit field of type {show-ctx show-concrete-type field.type}"

	n-constant-arrays nat = all-constants.arrays sum of x
		guard x array-needs-constant target
		x.constants size
	n-constant-records nat = all-constants.records sum of record-type, map
		guard record-type record-needs-constant target
		map size
	seen-arrays.size is n-constant-arrays
	seen-records.size is n-constant-records

-array-needs-constant bool(array arr-type-and-constants-concrete, target build-target)
	target != java or array.element-type !is-empty-type
-record-needs-constant bool(record-type concrete-type, target build-target)
	target != java or record-type !is-empty-type and record-type !is-wrapper

-can-reference bool
	program concrete-program
	seen-arrays (concrete-type, nat) mut-set
	seen-records (concrete-type, constant-record) mut-set
	type concrete-type
	c constant
do
	match c
	as constant-array
		type.array-element-type is-empty-type or (type, c.index) in seen-arrays
	as constant-native-string
		true
	as constant-record
		if type is-empty-type
			true
		elif field = type as-wrapper
			program can-reference seen-arrays, seen-records, field.type, program.all-constants.records[type]![c].only
		else
			(type, c) in seen-records
	as scalar-value
		true
	as constant-symbol
		true
	as constant-union
		value = program.all-constants.unions[type]![c]
		case-type = type.body.concrete-union!.members[value member-index]
		program can-reference seen-arrays, seen-records, case-type, value.member
	as constant-gc-safe-value
		true

# TODO: this may be simpler (and faster) as a single dictionary class-and-member[nat][concrete-type] ------------------------------------------
constant-names[name] record
	arrays name[nat][concrete-type]
	records name[constant-record][concrete-type]
subscript[name] name(a name constant-names, constant any-constant)
	type = constant type
	match constant
	as single-constant-array
		a.arrays[type]![constant index]!
	as single-constant-record
		a.records[type]![constant constant]!
array-name[name] name(a name constant-names, type concrete-type, value constant-array)
	a.arrays[type]![value index]!
record-name[name] name(a name constant-names, type concrete-type, value constant-record)
	a.records[type]![value]!

constant-names-builder[name] record mut
	-arrays name mut[nat] mut[concrete-type]
	-records name mut[constant-record] mut[concrete-type]
new[name] name constant-names-builder()
	(), ()
set-subscript[name] void(a name constant-names-builder, constant any-constant, name name)
	match constant
	as single-constant-array
		(a.arrays ensure constant.type)[constant index] := name
	as single-constant-record
		(a.records ensure constant.type)[constant constant] := name
finish[name] name constant-names(a name constant-names-builder)
	arrays: for k, v in a arrays
		k, v.move-to
	records: for k, v in a records
		k, v.move-to

any-constant union(single-constant-array, single-constant-record) # TODO: rename -- this is any *allocated* constant ----------------------
type concrete-type(a any-constant)
	# TODO: this could be simplified if the type was always called 'type'! --------------------------------------------------
	match a
	as single-constant-array then a array-type
	as single-constant-record then a record-type
single-constant-array record
	array-type concrete-type
	element-type concrete-type
	index nat
	elements constant[]
single-constant-record record
	record-type concrete-type
	constant constant-record
	args constant[]
	fields concrete-field[]

signed-integral-type enum(int8, int16, int32, int64)
== bool(a signed-integral-type, b signed-integral-type)
<=> comparison(a signed-integral-type, b signed-integral-type)

to-signed signed-integral-type(a integral-type)
	res, _ = a.to-signed-and-is-signed
	res
to-signed-and-is-signed (signed-integral-type, bool)(a integral-type)
	match a
	as int8
		int8, true
	as int16
		int16, true
	as int32
		int32, true
	as int64
		int64, true
	as nat8
		int8, false
	as nat16
		int16, false
	as nat32
		int32, false
	as nat64
		int64, false

is-64-bit bool(a integral-type)
	match a to-signed
	as int8
		false
	as int16
		false
	as int32
		false
	as int64
		true
