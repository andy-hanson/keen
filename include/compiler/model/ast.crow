import
	./parse-diag
	./source-range
	./uri

fun-kind enum(data_, shared_, mut_) # TODO: this is just 'purity'! ------------------------------------------------------------------------
== bool(a fun-kind, b fun-kind)
to nat32(a fun-kind)
members fun-kind[]()
to symbol(a fun-kind)
	match a
	as data_
		"data"
	as shared_
		"shared"
	as mut_
		"mut"
show string(a fun-kind)
	a.to::symbol to
to json(a fun-kind)

sum-type-kind enum(java-interface, interface_, union_, variant_)
== bool(a sum-type-kind, b sum-type-kind)
to symbol(a sum-type-kind)
	match a
	as java-interface
		"java-interface"
	as interface_
		"interface"
	as union_
		"union"
	as variant_
		"variant"
to json(a sum-type-kind)
var-kind enum(global_, thread-local_)
to json(a var-kind)

string-of-var-kind-lower-case string(a var-kind)
	match a
	as global_
		"global"
	as thread-local_
		"thread-local"

string-of-var-kind-upper-case string(a var-kind)
	match a
	as global_
		"Global"
	as thread-local_
		"Thread-local"

visibility enum(private, internal, public)
== bool(a visibility, b visibility)
<=> comparison(a visibility, b visibility)
to symbol(a visibility)
to json(a visibility)

name-and-range record(start pos, name symbol)
to json(a name-and-range)
end pos(a name-and-range)
	a.start + a.name.to::char8[].size.to
range source-range(a name-and-range)
	a.start range-of-start-and-length a.name.to::char8[]

field-mutability-ast record(pos pos, visibility_ visibility?)
to json(a field-mutability-ast)
range source-range(a field-mutability-ast)
	a.pos range-of-start-and-length if a visibility_ then "-mut" else "mut"
visibility visibility-and-range?(a field-mutability-ast)
	a.pos get-visibility-and-range a.visibility_

visibility-and-range record(visibility visibility, pos pos)
range source-range(a visibility-and-range)
	a.pos range-of-start-and-length "+"

-get-visibility-and-range visibility-and-range?(pos pos, visibility visibility?)
	if visibility
		visibility, pos

type-ast union
	bogus-type-ast
	fun-type-ast
	map-type-ast
	name-and-range
	suffix-name-type-ast
	suffix-special-type-ast
	tuple-type-ast
do
	range source-range()
to json(a type-ast)
start pos(a type-ast)
	a.range start
end pos(a type-ast)
	a.range end
name-range-or-range source-range(a type-ast)
	match a
	as bogus-type-ast
		a range
	as fun-type-ast
		a kind-range
	as map-type-ast
		a range
	as name-and-range
		a range
	as suffix-name-type-ast
		a suffix-range
	as suffix-special-type-ast
		a suffix-range
	as tuple-type-ast
		a range

bogus-type-ast record(range source-range)
to json(a bogus-type-ast)
fun-type-ast record
	return-type type-ast
	kind-pos pos
	kind fun-kind
	param destructure-ast
to json(a fun-type-ast)
range source-range(a fun-type-ast)
	a.return-type.start, a.param.end
kind-range source-range(a fun-type-ast)
	a.kind-pos range-of-start-and-length a.kind.to::symbol.to

map-type-ast record(kind map-type-ast-kind, value type-ast, key type-ast)
to json(a map-type-ast)
map-type-ast-kind enum(map, mut-map, shared-map) # TODO: just use Purity? ----------------------------------------------------
to json(a map-type-ast-kind)
to symbol(a map-type-ast-kind)
range source-range(a map-type-ast)
	a.value.range.start, a.key.range.end + "]"::char8[].size.to

suffix-name-type-ast record(left type-ast, name name-and-range)
to json(a suffix-name-type-ast)
range source-range(a suffix-name-type-ast)
	a.left.start, a.suffix-range.end
suffix-range source-range(a suffix-name-type-ast)
	a.name range

suffix-special-type-ast record(left type-ast, suffix-pos pos, kind suffix-special-type-ast-kind)
to json(a suffix-special-type-ast)
suffix-special-type-ast-kind enum(array, mut-array, option, shared-array)
== bool(a suffix-special-type-ast-kind, b suffix-special-type-ast-kind)
to symbol(a suffix-special-type-ast-kind)
to json(a suffix-special-type-ast-kind)
range source-range(a suffix-special-type-ast)
	a.left.range.start, a.suffix-end
suffix-range source-range(a suffix-special-type-ast)
	a.suffix-pos, a.suffix-end
-suffix-end pos(a suffix-special-type-ast)
	a.suffix-pos + a.kind.suffix.to::char8[].size.to

-suffix string(a suffix-special-type-ast-kind)
	match a
	as array
		"[]"
	as mut-array
		"mut[]"
	as option
		"?"
	as shared-array
		"shared[]"

tuple-type-ast record(range source-range, members type-ast[])
to json(a tuple-type-ast)

expr-ast union
	assert-or-forbid-ast
	assignment-ast
	assignment-call-ast
	bogus-ast
	call-ast
	call-named-ast
	do-ast
	finally-ast
	force-ast
	for-or-with-ast
	name-and-range
	if-ast
	interpolated-ast
	it-ast
	it-scope-ast
	lambda-ast
	let-ast
	list-ast
	literal-number
	literal-string-ast
	logical-ast
	loop-ast
	loop-break-ast
	loop-continue-ast
	loop-while-or-until-ast
	match-ast
	not-ast
	parenthesized-ast
	seq-ast
	shared-ast
	throw-ast
	trusted-ast
	try-ast
	try-let-ast
	typed-ast
	underscore-ast
	unpack-option-ast
do
	start pos()
	end pos()
to json(a expr-ast)
range source-range(a expr-ast)
	a.start, a.end

assert-or-forbid-ast record
	start pos
	is-forbid bool
	condition expr-ast
	thrown assert-or-forbid-thrown-ast?
	after expr-ast?
to json(a assert-or-forbid-ast)
end pos(a assert-or-forbid-ast)
	if after = a after
		after end
	elif thrown = a thrown
		thrown end
	else
		a.condition end
range source-range(a assert-or-forbid-ast)
	a.start, a.end
keyword-range source-range(a assert-or-forbid-ast)
	"assert"::char8[].size is "forbid"::char8[].size
	a.start range-of-start-and-length "assert"

assert-or-forbid-thrown-ast record(else-pos pos, expr expr-ast)
to json(a assert-or-forbid-thrown-ast)
else-range source-range(a assert-or-forbid-thrown-ast)
	a.else-pos range-of-start-and-length ":"
end pos(a assert-or-forbid-thrown-ast)
	a.expr end

| {left} := {right}
assignment-ast record(left expr-ast, assignment-pos pos, right expr-ast)
to json(a assignment-ast)
start pos(a assignment-ast)
	a.left start
end pos(a assignment-ast)
	a.right end
range source-range(a assignment-ast)
	a.start, a.end
keyword-range source-range(a assignment-ast)
	a.assignment-pos range-of-start-and-length ":="

| {left} {fun-name}:= {right}"
assignment-call-ast record(fun-name name-and-range, left expr-ast, right expr-ast)
to json(a assignment-call-ast)
start pos(a assignment-call-ast)
	a.left start
end pos(a assignment-call-ast)
	a.right end
range source-range(a assignment-call-ast)
	a.start, a.end
keyword-range source-range(a assignment-call-ast)
	a.fun-name.range.end range-of-start-and-length ":="

bogus-ast record(range source-range)
to json(a bogus-ast)
start pos(a bogus-ast)
	a.range start
end pos(a bogus-ast)
	a.range end

call-ast record
	range source-range
	style call-ast-style
	| Position of '.' or '?', otherwise 'max-value'
	keyword-pos pos
	fun-name name-and-range
	args expr-ast[]
	type-arg type-ast?
to json(a call-ast)
call-ast-style enum
	| `a.b`
	dot
	| `a.?b`
	dot-question
	| `a b`, `a b c`, `a b c, d`, etc.
	infix # RM ------------------------------------------------------------------------------------------------------------------------------------------------
	# TODO: Can't this be treated the same as prefix-operator? ------------------------------------------------------------------------------------------------
	prefix
	| `-x`, `~x`
	prefix-operator
	| `a@t` (without the type arg, it would just be a {name-and-range}) (TODO: isn't this just 'prefix' with no args?) -------------------------------------------
	single
	| `a[b]`
	subscript
	| `?foo`
	question-name
	| `a?[b]`
	question-subscript
is-option-call bool(a call-ast-style)
	match a
	as dot-question
		true
	as question-name
		true
	as question-subscript
		true
	else
		false
== bool(a call-ast-style, b call-ast-style)
to json(a call-ast-style)
start pos(a call-ast)
	a.range start
end pos(a call-ast)
	a.range end
keyword-range source-range?(a call-ast)
	match a style
	as dot
		a keyword-range-1
	as dot-question
		a keyword-range-2
	as subscript
		a keyword-range-1
	as question-name
		a keyword-range-1
	as question-subscript
		a keyword-range-2
	else
		()
-keyword-range-1 source-range(a call-ast)
	a.keyword-pos range-of-start-and-length 1
-keyword-range-2 source-range(a call-ast)
	a.keyword-pos range-of-start-and-length 2
name-range source-range(a call-ast)
	a.fun-name range

name-or-string-ast union(name-and-range, literal-string-ast, interpolated-ast, it-scope-ast)
	range source-range()
	start pos()
	to json()
name symbol?(a name-or-string-ast)
	match a
	as it-scope-ast
		()
	as name-and-range
		a name
	as literal-string-ast
		a.value to
	as interpolated-ast
		()
call-named-ast record(names name-or-string-ast[], args expr-ast[])
to json(a call-named-ast)
start pos(a call-named-ast)
	a.names[0] start
end pos(a call-named-ast)
	a.args[end - 1] end
range source-range(a call-named-ast)
	a.start, a.end

do-ast record(start pos, body expr-ast)
to json(a do-ast)
end pos(a do-ast)
	a.body end

finally-ast record(start pos, right expr-ast, below expr-ast)
to json(a finally-ast)
end pos(a finally-ast)
	a.below end
range source-range(a finally-ast)
	a.start, a.end
finally-keyword-range source-range(a finally-ast)
	a.start range-of-start-and-length "finally"

force-ast record
	arg expr-ast
	keyword-pos pos
to json(a force-ast)
start pos(a force-ast)
	a.arg start
end pos(a force-ast)
	a.keyword-range.end max a.arg.end
range source-range(a force-ast)
	a.start, a.end
keyword-range source-range(a force-ast)
	a.keyword-pos, a.keyword-pos + 1

for-or-with-ast record
	start pos
	keyword for-or-with-ast-keyword
	param destructure-ast
	in-pos pos
	| 'max-value' if there was not an 'then' keyword
	then-pos pos
	arg expr-ast
	body expr-ast
for-or-with-ast-keyword enum(for_, for-star, with_)
-size nat32(a for-or-with-ast-keyword)
	match a
	as for_
		3
	as for-star
		4
	as with_
		4
to json(a for-or-with-ast-keyword)
to json(a for-or-with-ast)
end pos(a for-or-with-ast)
	a.body end
range source-range(a for-or-with-ast)
	a.start, a.end
keyword-range source-range(a for-or-with-ast)
	a.start range-of-start-and-length a.keyword.size
called-function symbol(a for-or-with-ast)
	match a keyword
	as for_
		"for-loop"
	as for-star
		"for-star"
	as with_
		"with-block"
in-range source-range(a for-or-with-ast)
	a.in-pos range-of-start-and-length "else"
then-range source-range?(a for-or-with-ast)
	unless a.then-pos == max-value
		a.then-pos range-of-start-and-length "then"

if-ast record
	start pos
	kind if-ast-kind
	| 'ifWithoutElse', 'ifElif', and 'ifElse' could all be the 'else' branch of a preceding 'if'
	is-else-of-parent bool
	| Position of 'then', 'elif', or 'else'. 'max-value' if there is no second keyword.
	second-keyword-pos pos
	| Position of 'else' in 'if ... then ... else'. 'max-value' otherwise.
	third-keyword-pos pos
	condition expr-ast
	| This may not be present for a 'guard'
	first-branch expr-ast?
	second-branch expr-ast?
to json(a if-ast)
if-ast-kind enum
	guard-with-else
	guard-without-else
	if-without-else
	| In this case, the 'elif' expression will be another IfAst
	if-elif
	| Has 'if' and 'else' keywords, no 'elif' (though this may begin as an 'elif')
	if-else
	if-then
	if-then-else
	unless_
	unless-then
== bool(a if-ast-kind, b if-ast-kind)
to json(a if-ast-kind)
end pos(a if-ast)
	if x = a second-branch
		x end
	elif x = a first-branch
		x end
	else
		a.condition end
range source-range(a if-ast)
	a.start, a.end
is-guard bool(a if-ast)
	match a kind
	as guard-with-else then true
	as guard-without-else then true
	else then false
is-condition-negated bool(a if-ast)
	match a kind
	as guard-with-else
		true
	as guard-without-else
		true
	as if-elif
		false
	as if-else
		false
	as if-without-else
		false
	as if-then
		false
	as if-then-else
		false
	as unless_
		true
	as unless-then
		true
first-keyword-range source-range(a if-ast)
	a.start range-of-start-and-length match a kind
	as guard-with-else
		"guard"
	as guard-without-else
		"guard"
	as if-elif
		"if"
	as if-else
		"if"
	as if-then
		"if"
	as if-then-else
		"if"
	as if-without-else
		"if"
	as unless_
		"unless"
	as unless-then
		"unless"
second-keyword-range source-range?(a if-ast)
	keyword char8[]? = match a kind
	as guard-with-else
		":"
	as guard-without-else
		()
	as if-elif
		"else"
	as if-else
		"else"
	as if-then
		"then"
	as if-then-else
		"then"
	as if-without-else
		()
	as unless_
		()
	as unless-then
		"then"
	if keyword
		a.second-keyword-pos range-of-start-and-length keyword
third-keyword-range source-range?(a if-ast)
	if a.kind == if-then-else
		a.third-keyword-pos range-of-start-and-length "else"

interpolated-ast record
	quote-kind quote-kind
	template interpolated-template-part[]
	interpolated expr-ast[]
	-dummy void
interpolated-ast interpolated-ast
	quote-kind quote-kind
	template interpolated-template-part[]
	interpolated expr-ast[]
do
	template.size is interpolated.size + 1
	quote-kind, template, interpolated, ()
to json(a interpolated-ast)
range source-range(a interpolated-ast)
	a.start, a.end
start pos(a interpolated-ast)
	a.template[0].range start
end pos(a interpolated-ast)
	a.template[end - 1].range end
quote-kind enum(bar, double, indented)
== bool(a quote-kind, b quote-kind)
to json(a quote-kind)
interpolated-template-part record
	range source-range
	value string
to json(a interpolated-template-part)

it-ast record(start pos)
to json(a it-ast)
end pos(a it-ast)
	a.range end
range source-range(a it-ast)
	a.start range-of-start-and-length "it"

| Invisible AST node that represents the e scope of the expression containing 'it'
it-scope-ast record(inner expr-ast)
to json(a it-scope-ast)
start pos(a it-scope-ast)
	a.inner start
end pos(a it-scope-ast)
	a.inner end
range source-range(a it-scope-ast)
	a.inner range
first-it it-ast(a it-scope-ast)
	a.its first! it.identity
its record(scope it-scope-ast)
iterate bool(a its, f bool mut(x it-ast))
	a.scope iterate-its f
-iterate-its bool(a expr-ast, f bool mut(x it-ast))
	a.children iterate of child
		child it-ast and f[child] or child iterate-its f

| An 'it' lambda uses an {it-scope-ast} instead.
lambda-ast record
	start pos
	param destructure-ast
	| {max-value} if there is no 'then' keyword.
	then-pos pos
	body expr-ast
to json(a lambda-ast)
end pos(a lambda-ast)
	a.body end
range source-range(a lambda-ast)
	a.start, a.end
keyword-range source-range(a lambda-ast)
	a.start range-of-start-and-length "of"
then-range source-range?(a lambda-ast)
	unless a.then-pos == max-value
		a.then-pos range-of-start-and-length "then"

destructure-ast union
	name-and-range
	single-destructure-ast
	ignore-destructure-ast
	void-destructure-ast
	destructure-ast[]
to json(a destructure-ast)
start pos(a destructure-ast)
	match a
	as name-and-range
		a start
	as single-destructure-ast
		a start
	as ignore-destructure-ast
		a start
	as void-destructure-ast
		a.range start
	as array
		a[0] start
end pos(a destructure-ast)
	match a
	as name-and-range
		a end
	as single-destructure-ast
		a end
	as ignore-destructure-ast
		a end
	as void-destructure-ast
		a.range end
	as array
		a[end - 1] end
range source-range(a destructure-ast)
	a.start, a.end

single-destructure-ast record(name name-and-range, mut_ pos?, type type-ast?, ignore void)
new single-destructure-ast(name name-and-range, mut_ pos?, type type-ast?)
	assert mut_ or type # Otherwise this should be a name-and-range
	name, mut_, type, ()
to json(a single-destructure-ast)
start pos(a single-destructure-ast)
	a.name start
end pos(a single-destructure-ast)
	if x = a type
		x end
	elif x = a mut-range
		x end
	else
		a.name end
doc-comment doc-comment-ast(_ single-destructure-ast)
	()
name-range source-range(a single-destructure-ast)
	a.name range
mut-range source-range?(a single-destructure-ast)
	if x = a mut_
		x range-of-start-and-length "mut"

ignore-destructure-ast record(start pos, type type-ast?)
to json(a ignore-destructure-ast)
end pos(a ignore-destructure-ast)
	a.type ?end else a start
underscore-range source-range(a ignore-destructure-ast)
	a.start range-of-start-and-length "_"

| `()` is a destructure matching only void values
void-destructure-ast record(range source-range)
to json(a void-destructure-ast)

range source-range(a single-destructure-ast)
	end-range = a.type ?range or a mut-range else a.name range
	a.name.start, end-range.end

let-ast record(destructure destructure-ast, value expr-ast, then_ expr-ast?)
to json(a let-ast)
start pos(a let-ast)
	a.destructure start
end pos(a let-ast)
	(a then_ else a value) end

| Could be `()`, `x, y`, or a multi-line list with `- x` and `-- xs`
list-ast record(range source-range, parts list-ast-part[])
to json(a list-ast)
start pos(a list-ast)
	a.range start
end pos(a list-ast)
	a.range end
| Range of the initial '-' or '--'
first-keyword-range source-range(a list-ast)
	if a.parts is-empty
		a range
	else
		size nat = match a.parts[0]
		as expr-ast then 1
		as list-ast-part-multi then 2
		a.range[0 .. size]

# Represent singles directly, since they are the most common
list-ast-part union(expr-ast, list-ast-part-multi)
to json(a list-ast-part)
	match a
	as expr-ast
		single: a to
	as list-ast-part-multi
		multi: a.arg to
list-ast-part-multi record(arg expr-ast)
arg expr-ast(a list-ast-part)
	match a
	as expr-ast
		a
	as list-ast-part-multi
		a arg

literal-number record(range source-range)
to json(a literal-number)
start pos(a literal-number)
	a.range start
end pos(a literal-number)
	a.range end

literal-string-ast record(kind quote-kind, range source-range, value string)
to json(a literal-string-ast)
start pos(a literal-string-ast)
	a.range start
end pos(a literal-string-ast)
	a.range end

logical-ast record(left expr-ast, kind logical-ast-kind, keyword-pos pos, right expr-ast)
to json(a logical-ast)
logical-ast-kind enum(and_, else_, or_)
to json(a logical-ast-kind)
range source-range(a logical-ast)
	a.start, a.end
start pos(a logical-ast)
	a.left start
end pos(a logical-ast)
	a.right end
keyword-range source-range(a logical-ast)
	a.keyword-pos range-of-start-and-length match a kind
	as and_
		"and"
	as else_
		"else"
	as or_
		"or"

loop-ast record(start pos, body expr-ast)
to json(a loop-ast)
end pos(a loop-ast)
	a.body end
range source-range(a loop-ast)
	a.start, a.end
keyword-range source-range(a loop-ast)
	a.start range-of-start-and-length "loop"

loop-break-ast record(start pos, value expr-ast?)
to json(a loop-break-ast)
end pos(a loop-break-ast)
	if v = a value
		v end
	else
		a.keyword-range end
range source-range(a loop-break-ast)
	a.start, a.end
keyword-range source-range(a loop-break-ast)
	a.start range-of-start-and-length "break"

loop-continue-ast record(start pos)
to json(a loop-continue-ast)
end pos(a loop-continue-ast)
	a.keyword-range end
range source-range(a loop-continue-ast)
	a keyword-range
keyword-range source-range(a loop-continue-ast)
	a.start range-of-start-and-length "continue"

loop-while-or-until-ast record
	start pos
	is-until bool
	condition expr-ast
	body expr-ast
	after expr-ast?
to json(a loop-while-or-until-ast)
end pos(a loop-while-or-until-ast)
	(a after else a body) end
range source-range(a loop-while-or-until-ast)
	a.start, a.end
keyword-range source-range(a loop-while-or-until-ast)
	"while"::char8[].size is "until"::char8[].size
	a.start range-of-start-and-length "while"

match-ast record
	start pos
	local name-and-range?
	matched expr-ast
	cases case-ast[]
	else_ match-else-ast?
to json(a match-ast)
end pos(a match-ast)
	if x = a else_
		x end
	elif a.cases !is-empty
		a.cases[end - 1] end
	else
		a.matched end
range source-range(a match-ast)
	a.start, a.end
keyword-range source-range(a match-ast)
	a.start range-of-start-and-length "match"

not-ast record(keyword-pos pos, arg expr-ast)
to json(a not-ast)
start pos(a not-ast)
	a.keyword-pos min a.arg.start
end pos(a not-ast)
	a.arg end
range source-range(a not-ast)
	a.start, a.end
keyword-range source-range(a not-ast)
	a.keyword-pos, a.keyword-pos + 1

parenthesized-ast record(range source-range, inner expr-ast)
to json(a parenthesized-ast)
start pos(a parenthesized-ast)
	a.range start
end pos(a parenthesized-ast)
	a.range end

skip-parentheses expr-ast(a expr-ast)
	if a parenthesized-ast
		a.inner skip-parentheses
	else
		a

case-ast record(keyword-pos pos, member case-member-ast, then_ expr-ast)
to json(a case-ast)
end pos(a case-ast)
	a.then_ end
name-range source-range(a case-ast)
	a.member name-range
keyword-and-member-name-range source-range(a case-ast)
	a.keyword-pos, a.name-range.end

case-member-ast union(as-name-ast, literal-number, literal-string-ast, as-bogus-ast)
to json(a case-member-ast)
name-range source-range(a case-member-ast)
	match a
	as as-name-ast
		a.name range
	as literal-number
		a range
	as literal-string-ast
		a range
	as as-bogus-ast
		a range

as-bogus-ast record(range source-range)
to json(a as-bogus-ast)
as-name-ast record(name name-and-range)
to json(a as-name-ast)

match-else-ast record(keyword-pos pos, expr expr-ast)
to json(a match-else-ast)
end pos(a match-else-ast)
	a.expr end
keyword-range source-range(a match-else-ast)
	a.keyword-pos range-of-start-and-length "else"

seq-ast record(first expr-ast, then_ expr-ast)
to json(a seq-ast)
start pos(a seq-ast)
	a.first start
end pos(a seq-ast)
	a.then_ end

shared-ast record(start pos, inner expr-ast)
to json(a shared-ast)
end pos(a shared-ast)
	a.inner end
range source-range(a shared-ast)
	a.start, a.end
keyword-range source-range(a shared-ast)
	a.start range-of-start-and-length "shared"

throw-ast record(start pos, thrown expr-ast)
to json(a throw-ast)
end pos(a throw-ast)
	a.thrown end
range source-range(a throw-ast)
	a.start, a.end
keyword-range source-range(a throw-ast)
	a.start range-of-start-and-length "throw"

trusted-ast record(start pos, inner expr-ast)
to json(a trusted-ast)
end pos(a trusted-ast)
	a.inner end
range source-range(a trusted-ast)
	a.start, a.end
keyword-range source-range(a trusted-ast)
	a.start range-of-start-and-length "trusted"

try-ast record
	start pos
	tried expr-ast
	catches catch-ast[]
to json(a try-ast)
end pos(a try-ast)
	if a.catches is-empty
		a.tried end
	else
		a.catches[end - 1] end
range source-range(a try-ast)
	a.start, a.end
try-keyword-range source-range(a try-ast)
	a.start range-of-start-and-length "try"

catch-ast record(start pos, name name-and-range?, as_ catch-as-ast?, then_ expr-ast)
to json(a catch-ast)
end pos(a catch-ast)
	a.then_ end
keyword-range source-range(a catch-ast)
	a.start range-of-start-and-length "catch"
catch-as-ast record(start pos, type-name name-and-range)
to json(a catch-as-ast)
keyword-range source-range(a catch-as-ast)
	a.start range-of-start-and-length "as"

try-let-ast record
	start pos
	destructure destructure-ast
	value expr-ast
	catch_ catch-ast
	after expr-ast?
to json(a try-let-ast)
end pos(a try-let-ast)
	if after = a after
		after end
	else
		a.catch_ end
range source-range(a try-let-ast)
	a.start, a.end
try-keyword-range source-range(a try-let-ast)
	a.start range-of-start-and-length "try"

# `expr :: t` or `:: t \n expr`
typed-ast record
	| This may be missing for `:: t` with no line following it
	expr expr-ast?
	colon-pos pos
	type type-ast
to json(a typed-ast)
is-prefix bool(a typed-ast)
	if expr = a expr
		a.type.start < expr.start
	else
		true
start pos(a typed-ast)
	if a is-prefix
		a.type start
	else
		a.expr! start
end pos(a typed-ast)
	if a is-prefix
		if expr = a expr
			expr end
		else
			a.type end
	else
		a.type end
range source-range(a typed-ast)
	a.start, a.end
keyword-range source-range(a typed-ast)
	a.colon-pos range-of-start-and-length "::"

underscore-ast record
	start pos
to json(a underscore-ast)
end pos(a underscore-ast)
	a.start + 1

unpack-option-ast record(destructure destructure-ast, equals-pos pos, option expr-ast)
to json(a unpack-option-ast)
keyword-range source-range(a unpack-option-ast)
	a.equals-pos range-of-start-and-length "="
start pos(a unpack-option-ast)
	a.destructure start
end pos(a unpack-option-ast)
	a.option end

signature-ast record
	doc-comment doc-comment-ast
	range source-range
	name symbol
	return-type type-ast
	params destructure-ast[]
to json(a signature-ast)
name-and-range name-and-range(a signature-ast)
	a.range.start, a.name
name-range source-range(a signature-ast)
	a.name-and-range range

struct-alias-ast record
	doc-comment doc-comment-ast
	range source-range
	visibility_ visibility?
	name name-and-range
	type-params name-and-range[]
	keyword-pos pos
	target type-ast
to json(a struct-alias-ast)
name-range source-range(a struct-alias-ast)
	a.name range
keyword-range source-range(a struct-alias-ast)
	a.keyword-pos range-of-start-and-length "alias"
visibility visibility-and-range?(a struct-alias-ast)
	a.range.start get-visibility-and-range a.visibility_

type-params-range source-range(type-params name-and-range[])
	forbid type-params is-empty
	type-params[0].start, type-params[end - 1].end

modifier-ast union(modifier-keyword-ast, spec-use-ast)
	range source-range()
	type-arg type-ast?()
to json(a modifier-ast)
name-or-keyword-range source-range(a modifier-ast)
	match a
	as modifier-keyword-ast
		a keyword-range
	as spec-use-ast
		a name-range
name-or-keyword symbol(a modifier-ast)
	match a
	as modifier-keyword-ast
		a.keyword to
	as spec-use-ast
		a.name name

modifier-keyword-ast record(type-arg type-ast?, keyword-pos pos, keyword modifier-keyword)
to json(a modifier-keyword-ast)
range source-range(a modifier-keyword-ast)
	if x = a type-arg
		x.start, a.keyword-range.end
	else
		a keyword-range
keyword-range source-range(a modifier-keyword-ast)
	a.keyword-pos range-of-start-and-length a.keyword.to

spec-use-ast record(type-arg type-ast?, name name-and-range)
to json(a spec-use-ast)
range source-range(a spec-use-ast)
	if x = a type-arg
		x.start, a.name.end
	else
		a.name.range
name-range source-range(a spec-use-ast)
	a.name range

modifier-keyword enum
	builtin_
	case_
	data_
	force-data_
	force-shared_
	mut_
	new-internal
	new-public
	new-private
	shared_
== bool(a modifier-keyword, b modifier-keyword)
to modifier-keyword?(a symbol)
to symbol(a modifier-keyword)
	match a
	as builtin_
		"builtin"
	as case_
		"case"
	as data_
		"data"
	as force-data_
		"force-data"
	as force-shared_
		"force-shared"
	as mut_
		"mut"
	as new-internal
		"~new"
	as new-private
		"-new"
	as new-public
		"+new"
	as shared_
		"shared"
to char8[](a modifier-keyword)
	a.to::symbol to
to string(a modifier-keyword)
	a.to::symbol to
show string(a modifier-keyword)
	a to
to json(a modifier-keyword)
	a.to::string to

struct-body-ast union(builtin-type-ast, enum-ast, flags-ast, record-ast, sum-type-ast)
to json(a struct-body-ast)

builtin-type-ast record
to json(a builtin-type-ast)
enum-ast record(params destructure-ast[]?, members enum-or-flags-member-ast[])
to json(a enum-ast)
flags-ast record(params destructure-ast[]?, members enum-or-flags-member-ast[])
to json(a flags-ast)
record-ast record(params destructure-ast[]?, fields record-field-ast[])
to json(a record-ast)
sum-type-ast record(kind sum-type-kind, types type-ast[], methods signature-ast[])
types-range source-range(a sum-type-ast)
	unless a.types is-empty
		a.types[0].start, a.types[end - 1].end
to json(a sum-type-ast)

enum-or-flags-member-ast record
	doc-comment doc-comment-ast
	range source-range
	name symbol
	value literal-number?
to json(a enum-or-flags-member-ast)
name-and-range name-and-range(a enum-or-flags-member-ast)
	a.range.start, a.name
name-range source-range(a enum-or-flags-member-ast)
	a.name-and-range range

record-field-ast record
	doc-comment doc-comment-ast
	range source-range
	visibility_ visibility?
	name name-and-range
	mutability field-mutability-ast?
	type type-ast?
to json(a record-field-ast)
visibility visibility-and-range?(a record-field-ast)
	a.range.start get-visibility-and-range a.visibility_
name-range source-range(a record-field-ast)
	a.name range

struct-decl-ast record
	doc-comment doc-comment-ast
	| Range starts at the visibility (not at the doc comment)
	range source-range
	visibility_ visibility?
	name name-and-range
	type-params name-and-range[]
	keyword-pos pos
	modifiers modifier-ast[]
	body struct-body-ast
to json(a struct-decl-ast)
name-range source-range(a struct-decl-ast)
	a.name range
keyword-range source-range(a struct-decl-ast)
	a.keyword-pos range-of-start-and-length a.body.keyword-for-struct-body.to
-keyword-for-struct-body symbol(a struct-body-ast)
	match a
	as builtin-type-ast
		"builtin"
	as enum-ast
		"enum"
	as flags-ast
		"flags"
	as record-ast
		"record"
	as sum-type-ast
		a.kind to
visibility visibility-and-range?(a struct-decl-ast)
	a.range.start get-visibility-and-range a.visibility_

spec-decl-ast record
	doc-comment doc-comment-ast
	range source-range
	visibility_ visibility?
	name name-and-range
	type-params name-and-range[]
	spec-keyword-pos pos
	modifiers modifier-ast[]
	sigs signature-ast[]
to json(a spec-decl-ast)
name-range source-range(a spec-decl-ast)
	a.name range
keyword-range source-range(a spec-decl-ast)
	a.spec-keyword-pos range-of-start-and-length "spec"
visibility visibility-and-range?(a spec-decl-ast)
	a.range.start get-visibility-and-range a.visibility_

fun-decl-ast record
	module-uri uri
	doc-comment doc-comment-ast
	range source-range
	visibility_ visibility?
	name name-and-range
	type-params name-and-range[]
	return-type type-ast
	params destructure-ast[]
	modifiers modifier-ast[]
	body expr-ast?
to json(a fun-decl-ast)
visibility visibility-and-range?(a fun-decl-ast)
	a.range.start get-visibility-and-range a.visibility_
name-range uri-and-range(a fun-decl-ast)
	a.module-uri, a.name-range
name-range source-range(a fun-decl-ast)
	a.name range

test-ast record
	doc-comment doc-comment-ast
	range source-range
	modifiers modifier-ast[]
	body expr-ast?
to json(a test-ast)
keyword-range source-range(a test-ast)
	a.range.start range-of-start-and-length "test"

| 'global' or 'thread-local'
var-decl-ast record
	doc-comment doc-comment-ast
	range source-range
	visibility_ visibility?
	name name-and-range
	type-params name-and-range[]
	keyword-pos pos
	kind var-kind
	type type-ast
	modifiers modifier-ast[]
	initializer expr-ast?
to json(a var-decl-ast)
name-range source-range(a var-decl-ast)
	a.name range
keyword-range source-range(a var-decl-ast)
	a.keyword-pos range-of-start-and-length a.kind.string-of-var-kind-lower-case.to
visibility visibility-and-range?(a var-decl-ast)
	a.range.start get-visibility-and-range a.visibility_

import-or-export-ast record
	range source-range
	path path-or-rel-path
	path-range source-range
	kind import-or-export-ast-kind
to json(a import-or-export-ast)

path-or-rel-path union(path, rel-path)
	show string()
	to json()

import-or-export-ast-kind union
	import-whole-module-ast
	name-and-range[]
	import-file-ast
to json(a import-or-export-ast-kind)
import-whole-module-ast record
to json(a import-whole-module-ast)
import-file-ast record(name name-and-range, type-ast type-ast, type import-file-type)
to json(a import-file-ast)
import-file-type enum(nat8-array, string)
to json(a import-file-type)

imports-or-exports-ast record(range source-range, paths import-or-export-ast[])
to json(a imports-or-exports-ast)

doc-comment-ast record(content doc-comment-content?)
to json(a doc-comment-ast)
	a.content ?to else null
new doc-comment-ast()
	content: ()
new doc-comment-ast(range source-range)
	content: range, ()
is-empty bool(a doc-comment-ast)
	!a.content
range source-range?(a doc-comment-ast)
	a.content ?range
references name-and-range[](a doc-comment-ast)
	a.content ?references else ()

doc-comment-content record(range source-range, references name-and-range[])
to json(a doc-comment-content)

file-ast record
	is-prefix bool # RM ---------------------------------------------------------------------------------------------------------------------------------------------------
	line-and-column-getter line-and-column-getter
	parse-diagnostics parse-diagnostic[]
	doc-comment doc-comment-ast
	no-std_ bool
	imports imports-or-exports-ast?
	re-exports imports-or-exports-ast?
	| Stores the range of each `region` comment. (Not the range of the region itself.)
	regions source-range[]
	specs spec-decl-ast[]
	struct-aliases struct-alias-ast[]
	structs struct-decl-ast[]
	funs fun-decl-ast[]
	tests test-ast[]
	vars var-decl-ast[]
to json(a file-ast)
	parse-diagnostics: a.parse-diagnostics to
	doc-comment: a.doc-comment to
	no-std_: a.no-std_ to
	imports: a.imports to
	re-exports: a.re-exports to
	regions: a.regions to
	specs: a.specs to
	struct-aliases: a.struct-aliases to
	structs: a.structs to
	funs: a.funs to
	tests: a.tests to
	vars: a.vars to

line-and-character-getter line-and-character-getter(a file-ast)
	a.line-and-column-getter line-and-character-getter

file-ast-for-diag file-ast(diag read-file-diag)
	is-prefix: true
	line-and-column-getter: ()
	parse-diagnostics: ((), diag),
	doc-comment: ()
	no-std_: true
	imports: ()
	re-exports: ()
	regions: ()
	specs: ()
	struct-aliases: ()
	structs: ()
	funs: ()
	tests: ()
	vars: ()

ast-in-order any-ast[](ast file-ast)
	res any-ast[] =
		-- ast.imports from-option
		-- ast.re-exports from-option
		-- ast.specs map it.identity
		-- ast.struct-aliases map it.identity
		-- ast.structs map it.identity
		-- ast.funs map it.identity
		-- ast.tests map it.identity
		-- ast.vars map it.identity
	res sort it.range
any-ast union
	imports-or-exports-ast
	spec-decl-ast
	struct-alias-ast
	struct-decl-ast
	fun-decl-ast
	test-ast
	var-decl-ast
do
	range source-range()

children record(expr expr-ast)
iterate bool(a children, f bool mut(x expr-ast))
	match x = a expr
	as assert-or-forbid-ast
		f[x condition] or thrown = x thrown and f[thrown expr] or after = x after and f[after]
	as assignment-ast
		f[x left] or f[x right]
	as assignment-call-ast
		f[x left] or f[x right]
	as bogus-ast
		()
	as call-ast
		x.args iterate f
	as call-named-ast
		x.args iterate f
	as do-ast
		f[x body]
	as finally-ast
		f[x right] or f[x below]
	as force-ast
		f[x arg]
	as for-or-with-ast
		f[x arg] or f[x body]
	as name-and-range
		()
	as if-ast
		f[x condition] or t = x first-branch and f[t] or e = x second-branch and f[e]
	as interpolated-ast
		x.interpolated iterate f
	as it-ast
		()
	as it-scope-ast
		f[x inner]
	as lambda-ast
		f[x body]
	as let-ast
		f[x value] or t = x then_ and f[t]
	as list-ast
		x.parts iterate f[it.arg]
	as literal-number
		()
	as literal-string-ast
		()
	as logical-ast
		f[x left] or f[x right]
	as loop-ast
		f[x body]
	as loop-break-ast
		(v = x value) and f[v]
	as loop-continue-ast
		()
	as loop-while-or-until-ast
		f[x condition] or f[x body] or after = x after and f[after]
	as match-ast
		f[x matched] or x.cases iterate f[it.then_] or e = x else_ and f[e expr]
	as not-ast
		f[x arg]
	as parenthesized-ast
		f[x inner]
	as seq-ast
		f[x first] or f[x then_]
	as shared-ast
		f[x inner]
	as throw-ast
		f[x thrown]
	as trusted-ast
		f[x inner]
	as try-ast
		f[x tried] or x.catches iterate f[it.then_]
	as try-let-ast
		f[x value] or f[x.catch_ then_] or after = x after and f[after]
	as typed-ast
		(expr = x expr) and f[expr]
	as underscore-ast
		()
	as unpack-option-ast
		f[x option]
