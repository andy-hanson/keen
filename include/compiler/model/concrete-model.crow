import
	crow/unsafe
	../util/full-index-map
	../util/util
	./ast
	./model
	./source-range
	./uri

concrete-type-body union
	concrete-builtin-type
	concrete-enum
	struct-body-extern-java
	concrete-flags
	concrete-record
	concrete-union
	concrete-type-body-deferred
concrete-builtin-type record(kind builtin-type, type-args concrete-type[])
concrete-enum record(storage nat-type)
concrete-flags record(storage nat-type)
concrete-record record
	prevent-constant bool
	fields concrete-field[]
| Lambdas and all {sum-type} kinds compile to this.
| Method impls are stored separately on the {concrete-program}.
concrete-union record force-data
	java-interface path?
	| This may be an empty array for a lambda type with no implementations.
	| WARN: for a Java interface, this is not exhaustive.
	late-members mut concrete-type[]?
concrete-type-body-deferred record
has-members bool(a concrete-union)
	!!a.late-members
members concrete-type[](a concrete-union)
	a.late-members!
set-members void(a concrete-union, members concrete-type[])
	a.late-members := members

is-void bool(a concrete-type)
	a.body.concrete-builtin-type.?kind == void
is-empty-type bool(a concrete-type)
	match body = a.body
	as concrete-builtin-type
		body.kind == void
	as concrete-enum
		false
	as struct-body-extern-java
		false
	as concrete-flags
		false
	as concrete-record
		!prevent-constant body and every body.fields, it.type.is-empty-type
	as concrete-union
		false
	as concrete-type-body-deferred
		false
is-enum-or-flags bool(a concrete-type)
	a.is-enum or a.is-flags
is-enum bool(a concrete-type)
	!!a.body.concrete-enum
is-flags bool(a concrete-type)
	!!a.body.concrete-flags
must-be-enum-or-flags enum-or-flags-member[](a concrete-type)
	a.source.concrete-type-source-inst!.decl.must-be-enum-or-flags
must-be-enum enum-or-flags-member[](a concrete-type)
	a.source.concrete-type-source-inst!.decl.body.enum_!.members
must-be-flags flags_(a concrete-type)
	a.source.concrete-type-source-inst!.decl.body.flags_!

concrete-type-source union(concrete-type-source-inst, concrete-type-source-bogus)
concrete-type-source-bogus record
concrete-type-source-inst record
	decl struct-decl
	type-args concrete-type[]
range uri-and-range(a concrete-type-source)
	match a
	as concrete-type-source-bogus
		()
	as concrete-type-source-inst
		a.decl.range
concrete-type record force-data
	id nat
	purity purity
	source concrete-type-source
	body mut concrete-type-body
to json(a concrete-type)
	"{a.simple-name} {a.id}"
| Not guaranteed to be unique
simple-name symbol(a concrete-type)
	match source = a.source
	as concrete-type-source-bogus
		"BOGUS"
	as concrete-type-source-inst
		source.decl.name.to
== bool(a concrete-type, b concrete-type)
	trusted a 'reference-equal b
<=> comparison(a concrete-type, b concrete-type)
	a.id <=> b.id
hash void(a concrete-type, state hash-state)
	hash a.id, state
as-extern path?(a concrete-type)
	match body = a.body
	as concrete-builtin-type
		()
	as concrete-enum
		()
	as struct-body-extern-java
		body.path
	as concrete-flags
		()
	as concrete-record
		()
	as concrete-union
		body.java-interface
	as concrete-type-body-deferred
		throw unreachable

# Returns return and param types
as-lambda-type (concrete-type, concrete-type)?(a concrete-type)
	body = a.body
	if body.concrete-builtin-type and is-lambda-type body.kind
		only2! body.type-args

is-bool bool(a concrete-type)
	a.body.concrete-builtin-type.?kind == bool
is-char8-or-32 bool(a concrete-type)
	body = a.body
	body.concrete-builtin-type and (body.kind == char8 or body.kind == char32)
is-char8 bool(a concrete-type)
	a.body.concrete-builtin-type.?kind == char8
is-nat8 bool(a concrete-type)
	a.body.concrete-builtin-type.?kind == nat8
is-nat32 bool(a concrete-type)
	a.body.concrete-builtin-type.?kind == nat32
is-nat64 bool(a concrete-type)
	a.body.concrete-builtin-type.?kind == nat64
is-float32-or-64 bool(a concrete-type)
	body = a.body
	body.concrete-builtin-type and (body.kind == float32 or body.kind == float64)
as-char-type char-type?(a concrete-type)
	a.body.concrete-builtin-type.?kind.?to
as-nat-type nat-type?(a concrete-type)
	a.body.concrete-builtin-type.?kind.?to
as-int-type int-type?(a concrete-type)
	a.body.concrete-builtin-type.?kind.?to
as-integral-type integral-type?(a concrete-type)
	a.body.concrete-builtin-type.?kind.?to
as-integral-type-allow-char integral-type?(a concrete-type)
	if x = a.as-char-type
		match x
		as char8 then nat8
		as char32 then nat32
	else
		a.as-integral-type
as-float-type float-type?(a concrete-type)
	a.body.concrete-builtin-type.?kind.?to
is-array bool(a concrete-type)
	a.body.concrete-builtin-type.?kind == array
is-array-or-mut-array bool(a concrete-type) # TODO: should be 'is-array-or-mut-slice' ----------------------------------------------
	guard b = a.body.concrete-builtin-type
	b.kind == array or b.kind == mut-slice

array-element-type concrete-type(array-type concrete-type)
	assert is-array-or-mut-array array-type
	only! array-type.source.concrete-type-source-inst!.type-args
is-option bool(a concrete-type)
	source = a.source
	source.concrete-type-source-inst and is-option source.decl
unwrap-option-type concrete-type?(option-type concrete-type) # TODO:make this return an option -----------------------------
	if option-type.is-option
		only! option-type.source.concrete-type-source-inst!.type-args
unwrap-weak-ref concrete-type(a concrete-type)
	assert is-weak-ref a
	only! a.source.concrete-type-source-inst!.type-args
is-weak-ref bool(a concrete-type)
	source = a.source
	source.concrete-type-source-inst and is-weak-ref source.decl
is-bogus bool(a concrete-type)
	!!a.source.concrete-type-source-bogus
is-js-any bool(a concrete-type)
	a.body.concrete-builtin-type.?kind == js-any

concrete-field record
	debug-name symbol # TODO: rename to just 'name' .........................................................................
	is-mutable bool
	type concrete-type

concrete-local-source union(local, concrete-local-source-reference, concrete-generated-local-kind)
	hash void(state hash-state)
	to json()
is-mutable bool(a concrete-local-source)
	match a
	as local then a.is-mutable
	as concrete-local-source-reference then false
	as concrete-generated-local-kind then false
concrete-local-source-reference record(original local)
to json(a concrete-local-source-reference)
hash void(a concrete-local-source-reference, state hash-state)
	hash a.original, state
concrete-generated-local-kind enum(args, ignore, destruct, member, member2, union-kind)
to nat32(a concrete-generated-local-kind)
to symbol(a concrete-generated-local-kind)
to string(a concrete-generated-local-kind)
	a.to::symbol.to
show string(a concrete-generated-local-kind)
	a.to::symbol.to
to json(a concrete-generated-local-kind)
hash void(a concrete-generated-local-kind, state hash-state)
	hash a.to::nat32, state
concrete-local record
	source concrete-local-source
	type concrete-type
to json(a concrete-local)
	source: a.source.to
	type: a.type.to
== bool(a concrete-local, b concrete-local)
	trusted a 'reference-equal b
<=> comparison(_ concrete-local, _ concrete-local)
	throw todo
hash void(a concrete-local, state hash-state)
	hash a.source, state
is-mutable bool(a concrete-local)
	is-mutable a.source

concrete-fun-body union
	concrete-fun-body-builtin
	concrete-expr
	fun-body-extern-java
	concrete-fun-body-method
	concrete-fun-body-deferred
	concrete-fun-body-always-inline
to json(a concrete-fun-body)
| Use this instead of {builtin-concrete-expr} to ensure it is inlined
concrete-fun-body-builtin record(kind builtin-fun, type-args concrete-type[])
to json(a concrete-fun-body-builtin)
concrete-fun-body-method record(method-index nat)
to json(a concrete-fun-body-method)
concrete-fun-body-deferred record
to json(a concrete-fun-body-deferred)
# Type for a function body that will never be filled in because the function should always be inlined
concrete-fun-body-always-inline record
to json(a concrete-fun-body-always-inline)

concrete-fun-source union
	concrete-fun-source-regular
	concrete-fun-source-test
	concrete-fun-source-wrap-main
to json(a concrete-fun-source)
range uri-and-range(a concrete-fun-source)
	match a
	as concrete-fun-source-regular
		a.decl.range
	as concrete-fun-source-test
		a.test_.range
	as concrete-fun-source-wrap-main
		a.range
concrete-fun-source-test record
	test_ test_
	| Arbitrary index over all tests
	test-index nat
to json(_ concrete-fun-source-test)
	throw todo
concrete-fun-source-wrap-main record(range uri-and-range)
to json(a concrete-fun-source-wrap-main)

concrete-fun record force-data
	hash nat
	source concrete-fun-source
	return-type concrete-type
	params concrete-local[]
	body mut concrete-fun-body
== bool(a concrete-fun, b concrete-fun)
	trusted a 'reference-equal b
<=> comparison(a concrete-fun, b concrete-fun)
	a.range <=> b.range
hash void(a concrete-fun, state hash-state)
	hash a.hash, state
to-json-with-body json(a concrete-fun)
	source: a.source.to
	return-type: a.return-type.to
	params: a.params.to
	body: a.body.to
to json(a concrete-fun)
	"{a.simple-name}{a.hash}"
| Not guaranteed to be unique
simple-name symbol(a concrete-fun)
	match source = a.source
	as concrete-fun-source-regular
		source.decl.name
	as concrete-fun-source-test
		"test"
	as concrete-fun-source-wrap-main
		"wrap-main"
module-uri uri(a concrete-fun)
	a.range.uri
range uri-and-range(a concrete-fun)
	a.source.range
is-extern bool(a concrete-fun)
	match a.body
	as concrete-fun-body-builtin
		false
	as concrete-expr
		false
	as fun-body-extern-java
		true
	as concrete-fun-body-method
		!!a.params[0].type.as-extern
	as concrete-fun-body-deferred
		throw unreachable
	as concrete-fun-body-always-inline
		throw unreachable

concrete-fun-source-regular record
	decl fun-decl
	type-args concrete-type[]
	spec-impls concrete-fun[]
to json(a concrete-fun-source-regular)
concrete-fun-key record
	decl fun-decl
	type-args concrete-type[]
	spec-impls concrete-fun[]
== bool(a concrete-fun-key, b concrete-fun-key)
<=> comparison(_ concrete-fun-key, _ concrete-fun-key)
	throw todo
hash void(a concrete-fun-key, state hash-state)
	hash a.decl, state
	for x in a.type-args
		hash x, state
	for x in a.spec-impls
		hash x, state

name symbol?(a concrete-fun)
	a.source.concrete-fun-source-regular.?decl.?name

concrete-expr record
	type concrete-type
	range uri-and-range
	kind concrete-expr-kind
to json(a concrete-expr)
start uri-and-pos(a concrete-expr)
	a.range.start

concrete-expr-kind union
	array-op-concrete-expr
	builtin-concrete-expr
	call-concrete-expr
	cast-concrete-expr
	constant
	create-array-concrete-expr
	create-record-concrete-expr
	create-union-concrete-expr
	drop-concrete-expr
	finally-concrete-expr
	if-concrete-expr
	let-concrete-expr
	lambda-concrete-expr
	local-get-concrete-expr
	local-set-concrete-expr
	loop-concrete-expr
	loop-break-concrete-expr
	loop-continue-concrete-expr
	match-scalar-concrete-expr
	match-string-like-concrete-expr
	match-union-concrete-expr
	record-field-get-concrete-expr
	record-field-set-concrete-expr
	seq-concrete-expr
	throw-concrete-expr
	try-concrete-expr
	try-let-concrete-expr
	union-assume-case-concrete-expr
	union-is-case-concrete-expr
	var-get-concrete-expr
	var-set-concrete-expr
to json(a concrete-expr-kind)
| Specialization of `for local in in-array then inner` where the input and output collections are both arrays (or {mut-slice})
| If the return type is 'void', this does not return an array.
array-op-concrete-expr record # TODO: rename to 'for-loop-concrete-expr' -------------------------------------------------------
	input concrete-expr
	local concrete-local?
	| Used for performance to avoid allocating empty arrays
	empty-out-array constant-array?
	body concrete-expr
input-kind for-loop-input-kind(a array-op-concrete-expr)
	if is-array-or-mut-array a.input.type
		array
	else
		range
for-loop-input-kind enum(array, range)
== bool(a for-loop-input-kind, b for-loop-input-kind)
output-kind for-loop-output-kind(_ array-op-concrete-expr, type concrete-type)
	if is-array-or-mut-array type
		array
	else
		assert is-void type
		void
for-loop-output-kind enum(array, void)
in-element concrete-type(a array-op-concrete-expr)
	match input-kind a
	as array
		a.input.type.array-element-type
	as range
		a.input.type.range-element-type
range-element-type concrete-type(range-type concrete-type)
	low, high = range-fields range-type
	low.type is high.type
	low.type
range-fields (concrete-field, concrete-field)(range-type concrete-type)
	only2! range-type.body.concrete-record!.fields
out-element concrete-type(a array-op-concrete-expr)
	a.body.type
to json(a array-op-concrete-expr)
builtin-concrete-expr record(fun builtin-fun, type-args concrete-type[], args concrete-expr[])
to json(a builtin-concrete-expr)
call-concrete-expr record(called concrete-fun, args concrete-expr[])
to json(a call-concrete-expr)
| Reinterpret cast between different types with the same size
cast-concrete-expr record(inner concrete-expr) # TODO: this is only used to cast an enum to an integral. Just make that a kind of builtin unary?
to json(a cast-concrete-expr)
create-array-concrete-expr record(args concrete-expr[])
to json(a create-array-concrete-expr)
create-record-concrete-expr record(args concrete-expr[]) # TODO: this is basically the same as create-array-concrete-expr, share?
to json(a create-record-concrete-expr)
create-union-concrete-expr record(member-index nat, arg concrete-expr)
to json(a create-union-concrete-expr)
drop-concrete-expr record(arg concrete-expr)
to json(a drop-concrete-expr)
finally-concrete-expr record(right concrete-expr, below concrete-expr)
to json(a finally-concrete-expr)
if-concrete-expr record(cond concrete-expr, then_ concrete-expr, else_ concrete-expr)
to json(a if-concrete-expr)

let-concrete-expr record(local concrete-local, value concrete-expr, then_ concrete-expr)
to json(a let-concrete-expr)
lambda-concrete-expr record
	closure concrete-local[]
	param concrete-local
	body concrete-expr
to json(a lambda-concrete-expr)
| For a JS target, this can get a local through a closure.
local-get-concrete-expr record(local concrete-local) # TODO: consider perf of just using the 'local' directly .............................
to json(a local-get-concrete-expr)
local-set-concrete-expr record(local concrete-local, value concrete-expr)
to json(a local-set-concrete-expr)
loop-concrete-expr record(body concrete-expr)
to json(a loop-concrete-expr)
loop-break-concrete-expr record(value concrete-expr)
to json(a loop-break-concrete-expr)
loop-continue-concrete-expr record
to json(a loop-continue-concrete-expr)

match-scalar-concrete-expr record # TODO: RENAME TO MATCH_SCALAR -----------------------------------------------------
	-dummy void # TODO:KILL ----------------------------------------------------------------------------------------------
	matched concrete-expr
	case-values scalar-values
	case-exprs concrete-expr[]
	else_ concrete-expr?
new match-scalar-concrete-expr
	matched concrete-expr
	case-values scalar-values
	case-exprs concrete-expr[]
	else_ concrete-expr?
do
	assert is-sorted case-values
	case-values.size is case-exprs.size
	(), matched, case-values, case-exprs, else_
to json(a match-scalar-concrete-expr)
matched-integral-type char-or-integral-type(a match-scalar-concrete-expr)
	match body = a.matched.type.body
	as concrete-builtin-type
		body.kind.to!
	as concrete-enum
		body.storage.to
	else
		throw unreachable

match-string-like-concrete-expr record
	matched concrete-expr
	equals concrete-fun
	cases concrete-match-string-like-case[]
	else_ concrete-expr
to json(a match-string-like-concrete-expr)
# TODO: shouldn't 'value' be a constant? ------------------------------------------------------------------------------------------------
concrete-match-string-like-case record(value concrete-expr, then_ concrete-expr)
to json(a concrete-match-string-like-case)

indices record(values scalar-values)
list-new indices(values nat64[])
	values.to
== bool(a indices, b indices)
to json(a indices)
	a.values.to
to indices(a nat)
	values: (a.to::scalar-value,).to::scalar-values
to indices(a nat range)
	a.to::nat[].to
to indices(a nat[])
	values: a.to
size nat(a indices)
	a.values.size
iterate bool(a indices, f bool mut(x nat))
	iterate a.values, f[it.to]
subscript nat(a indices, index nat)
	a.values[index].to
to-array nat[](a indices)
	map a.values, it.to

match-union-concrete-expr record
	-dummy void
	matched concrete-expr
	member-indices indices
	cases concrete-expr[]
	else_ concrete-expr?
new match-union-concrete-expr
	matched concrete-expr
	case-indices indices
	cases concrete-expr[]
	else_ concrete-expr?
do
	assert matched.type.body.concrete-union
	assert is-sorted case-indices
	forbid is-empty cases
	case-indices.size is cases.size
	(), matched, case-indices, cases, else_
match-union-concrete-expr match-union-concrete-expr
	matched concrete-expr
	case-indices indices
	cases concrete-expr[]
	else_ concrete-expr?
do
	matched, case-indices, cases, else_
to json(a match-union-concrete-expr)
union-type concrete-type(a match-union-concrete-expr)
	a.matched.type
union_ concrete-union(a match-union-concrete-expr)
	a.union-type.body.concrete-union!
| Expression that optionally uses something as a local
concrete-local-and-expr record(local concrete-local?, expr concrete-expr)
to json(a concrete-local-and-expr)
record-field-get-concrete-expr record(record_ concrete-expr, field-index nat)
to json(a record-field-get-concrete-expr)
field concrete-field(a record-field-get-concrete-expr)
	a.record_.type.body.concrete-record!.fields[a.field-index]
record-field-set-concrete-expr record
	record_ concrete-expr
	field-index nat
	value concrete-expr
to json(a record-field-set-concrete-expr)
record-type concrete-type(a record-field-set-concrete-expr) # TODO: inline -----------------------------------------------------
	a.record_.type
field concrete-field(a record-field-set-concrete-expr)
	a.record-type.body.concrete-record!.fields[a.field-index]
seq-concrete-expr record
	| All parts but the last should be of type 'void'
	parts concrete-expr[]
to json(a seq-concrete-expr)
throw-concrete-expr record(thrown concrete-expr)
to json(a throw-concrete-expr)
try-concrete-expr record
	tried concrete-expr
	exception-member-indices indices
	catch-cases concrete-local-and-expr[]
	| For this, the local type is always 'exception'
	catch-else concrete-local-and-expr?
to json(a try-concrete-expr)
# TODO: to avoid duplicating code in translate-to-js / translate-to-java / lower, compile this to a 'try' early --------------------
try-let-concrete-expr record
	local concrete-local?
	value concrete-expr
	exception-member-index nat
	catch_ concrete-local-and-expr
	then_ concrete-expr
caught-type concrete-type(a try-let-concrete-expr, exception concrete-type)
	exception.body.concrete-union!.members[a.exception-member-index]
to json(a try-let-concrete-expr)
| The type of {arg} is a union type and the type of this expression is one of its cases.
| Use only in situations where we know the union value has that case type.
| In a JavaScript build this will usually do nothing. In Java it must insert a cast.
union-assume-case-concrete-expr record(arg concrete-expr)
union-type concrete-type(a union-assume-case-concrete-expr)
	a.arg.type
union_ concrete-union(a union-assume-case-concrete-expr)
	a.union-type.body.concrete-union!
to json(a union-assume-case-concrete-expr)

union-is-case-concrete-expr record(arg concrete-expr, case-index nat)
union-type concrete-type(a union-is-case-concrete-expr)
	a.arg.type
union_ concrete-union(a union-is-case-concrete-expr)
	a.union-type.body.concrete-union!
case-type concrete-type(a union-is-case-concrete-expr)
	a.union_.members[a.case-index]
to json(a union-is-case-concrete-expr)

var-get-concrete-expr record(var concrete-var)
to json(a var-get-concrete-expr)
var-set-concrete-expr record(var concrete-var, value concrete-expr)
to json(a var-set-concrete-expr)

arr-type-and-constants-concrete record
	array-type concrete-type
	element-type concrete-type # TODO: don't need to store this, can get it from arr-type ----------------------------------------
	constants constant[][]

all-constants-concrete record
	symbols symbol[]
	arrays arr-type-and-constants-concrete[]
	| Maps a {constant-record} to the record values.
	records (constant-record, constant[]) full-index-map[concrete-type]
	unions (constant-union, constant-union-value) full-index-map[concrete-type]

concrete-var record
	source var-decl
	initializer concrete-expr
type concrete-type(a concrete-var)
	a.initializer.type
== bool(a concrete-var, b concrete-var)
	trusted a 'reference-equal b
<=> comparison(a concrete-var, b concrete-var)
	a.range <=> b.range
hash void(a concrete-var, state hash-state)
	hash a.source, state
to json(a concrete-var)
	kind: a.kind.to
	name: a.source.name.to
	type: a.type.to
kind var-kind(a concrete-var)
	a.source.kind
range uri-and-range(a concrete-var)
	a.source.range
module-uri uri(a concrete-var)
	a.source.module-uri

concrete-program record
	model-program program
	target build-target
	all-constants all-constants-concrete
	all-non-extern-types concrete-type[]
	all-types-including-extern concrete-type[]
	all-vars concrete-var[]
	all-non-extern-funs concrete-fun[]
	all-funs-including-extern concrete-fun[]
	| Currently only used in a Java build (TODO: use in JS) -----------------------------------------------------------------
	method-impls concrete-method-info[concrete-type]
	| Only used in a JS build
	async concrete-async-info?
	common-funs concrete-common-funs
concrete-async-info record
	funs async-kind[concrete-fun]
	var-initializers concrete-var set
to json(a concrete-program)
	funs json[] = for x in a.all-funs-including-extern # TODO: should be able to 'build' a 'json' directly ---------------------
		x.to-json-with-body
	target: a.target.to
	all-types: a.all-types-including-extern.to
	all-vars: a.all-vars.to
	all-funs: funs.to

# If this is missing it will be always sync
async-kind enum
	always-async
	| This should compile to separate sync and async versions. Async callers will call the async version.
	| This can happen for a function that takes a callback and calls it.
	sync-and-async
== bool(a async-kind, b async-kind)

concrete-method-info record
	| Note: This is not all methods, only the ones that were accessed
	methods concrete-fun[]
	# This matches the order of types in the union
	cases concrete-fun?[][]
new concrete-method-info()
	(), ()
is-empty bool(a concrete-method-info)
	res = is-empty a.methods
	res is a.cases.is-empty
	res
concrete-common-funs union
	concrete-common-funs-java
	concrete-common-funs-js
do
	exception concrete-type()
	main concrete-fun()
	show-exception concrete-fun()
	string concrete-type()
concrete-common-funs-java record
	exception concrete-type
	bool concrete-type
	nat32 concrete-type
	show-exception concrete-fun
	start-runtime concrete-fun
	stop-runtime concrete-fun
	to-symbol-from-string concrete-fun
	main concrete-fun
string concrete-type(a concrete-common-funs-java)
	a.to-symbol-from-string.params.only!.type
symbol concrete-type(a concrete-common-funs-java)
	a.to-symbol-from-string.return-type
concrete-common-funs-js record
	exception concrete-type
	js-any concrete-type
	main concrete-fun
	show-exception concrete-fun
	to-symbol-from-string concrete-fun
	to-string-from-js-any concrete-fun
string concrete-type(a concrete-common-funs-js)
	a.to-symbol-from-string.params.only!.type
symbol concrete-type(a concrete-common-funs-js)
	a.to-symbol-from-string.return-type

direct-child-exprs record(expr concrete-expr)
iterate bool(a direct-child-exprs, f bool mut(x concrete-expr))
	match x = a.expr.kind
	as array-op-concrete-expr
		f[x.input] or f[x.body]
	as builtin-concrete-expr
		iterate x.args, f
	as call-concrete-expr
		iterate x.args, f
	as cast-concrete-expr
		f[x.inner]
	as constant
		false
	as create-array-concrete-expr
		iterate x.args, f
	as create-record-concrete-expr
		iterate x.args, f
	as create-union-concrete-expr
		f[x.arg]
	as drop-concrete-expr
		f[x.arg]
	as finally-concrete-expr
		f[x.right] or f[x.below]
	as if-concrete-expr
		f[x.cond] or f[x.then_] or f[x.else_]
	as lambda-concrete-expr
		f[x.body]
	as let-concrete-expr
		f[x.value] or f[x.then_]
	as local-get-concrete-expr
		false
	as local-set-concrete-expr
		f[x.value]
	as loop-concrete-expr
		f[x.body]
	as loop-break-concrete-expr
		f[x.value]
	as loop-continue-concrete-expr
		false
	as match-scalar-concrete-expr
		f[x.matched] or iterate x.case-exprs, f or cb-option x.else_, f
	as match-string-like-concrete-expr
		f[x.matched] or
		iterate x.cases, (of case_ then f[case_.value] or f[case_.then_]) or
		f[x.else_]
	as match-union-concrete-expr
		f[x.matched] or
		iterate x.cases, f[it] or
		cb-option x.else_, f
	as record-field-get-concrete-expr
		f[x.record_]
	as record-field-set-concrete-expr
		f[x.record_] or f[x.value]
	as seq-concrete-expr
		iterate x.parts, f
	as throw-concrete-expr
		f[x.thrown]
	as try-concrete-expr
		f[x.tried] or
		iterate x.catch-cases, f[it.expr] or
		cb-option x.catch-else.?expr, f
	as try-let-concrete-expr
		f[x.value] or f[x.catch_.expr] or f[x.then_]
	as union-assume-case-concrete-expr
		f[x.arg]
	as union-is-case-concrete-expr
		f[x.arg]
	as var-get-concrete-expr
		false
	as var-set-concrete-expr
		f[x.value]

| The type of a constant is implicit (given by context).
| This means two constants that look equal may not be the same constant if they have different types
| (e.g., IntegralValue has different sizes.)
constant union
	constant-array
	constant-native-string
	constant-record
	scalar-value
	constant-symbol
	constant-union
	constant-gc-safe-value
do
	hash void(state hash-state)
to json(a constant)
# This assumes the constants are for the same type
== bool(a constant, b constant)
<=> comparison(a constant, b constant)
each-nested-constant void
	all-constants all-constants-concrete
	type concrete-type
	a constant
	f void mut(type concrete-type, value constant)
do
	f[type, a]
	match a
	as constant-array
		elem = type.array-element-type
		for x in all-constants.arrays[a.type-index].constants[a.index]
			each-nested-constant all-constants, elem, x, f
	as constant-native-string
		()
	as constant-record
		fields = type.body.concrete-record!.fields
		args = all-constants.records[type]![a]
		for arg, field in zip args, fields
			each-nested-constant all-constants, field.type, arg, f
	as scalar-value
		()
	as constant-symbol
		()
	as constant-union
		value = all-constants.unions[type]![a]
		member-type = type.body.concrete-union!.members[value.member-index]
		each-nested-constant all-constants, member-type, value.member, f
	as constant-gc-safe-value
		()

constant-array record
	| Index of the array type in {all-constants-concrete}.{arrays} (TODO: maybe that should just be a map keyed by {concrete-type}?)
	type-index nat
	| Index within that array type
	index nat
== bool(a constant-array, b constant-array)
<=> comparison(a constant-array, b constant-array)
to json(a constant-array)
hash void(a constant-array, state hash-state)
	hash a.type-index, state
	hash a.index, state
| Constant Java or JS string
constant-native-string record(value string)
== bool(a constant-native-string, b constant-native-string)
<=> comparison(a constant-native-string, b constant-native-string)
hash void(a constant-native-string, state hash-state)
	hash a.value, state
to json(a constant-native-string)
| Index into {all-constants-concrete}.{records}
constant-record record(index nat)
== bool(a constant-record, b constant-record)
<=> comparison(a constant-record, b constant-record)
hash void(a constant-record, state hash-state)
	hash a.index, state
to json(a constant-record)
	a.index.to
constant-symbol record(index nat)
== bool(a constant-symbol, b constant-symbol)
<=> comparison(a constant-symbol, b constant-symbol)
hash void(a constant-symbol, state hash-state)
	hash a.index, state
to json(a constant-symbol)
| Index into {all-constants-concrete}.{unions}
constant-union record(index nat)
== bool(a constant-union, b constant-union)
<=> comparison(a constant-union, b constant-union)
hash void(a constant-union, state hash-state)
	hash a.index, state
to json(a constant-union)
	a.index.to
constant-union-value record(member-index nat, member constant) # TODO: rename 'member-index' to 'case-index' and 'member' to 'value'
== bool(a constant-union-value, b constant-union-value)
<=> comparison(a constant-union-value, b constant-union-value)
hash void(a constant-union-value, state hash-state)
	hash a.member-index, state
	hash a.member, state
constant-gc-safe-value record
== bool(a constant-gc-safe-value, b constant-gc-safe-value)
<=> comparison(a constant-gc-safe-value, b constant-gc-safe-value)
to json(a constant-gc-safe-value)
hash void(_ constant-gc-safe-value, _ hash-state)
	()

as-bool bool(a constant)
	a.scalar-value!.to
as-nat64 nat(a constant)
	a.scalar-value!.to
as-float float64(a constant)
	a.scalar-value!.to
