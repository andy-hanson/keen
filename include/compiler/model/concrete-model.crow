import
	./integral-values
	./ast
	./model
	./source-range
	./uri
	./version-info
	../util/full-index-map
	../util/util

concrete-struct-body union(
	concrete-builtin-type,
	concrete-enum,
	concrete-extern-type,
	concrete-flags,
	concrete-record,
	concrete-union,
	concrete-struct-body-deferred) mut
concrete-builtin-type record(kind builtin-type, type-args concrete-type[]) mut
concrete-enum record(storage_ integral-type)
concrete-flags record(storage_ integral-type)
concrete-extern-type record
concrete-record record(is-some-field-mutable bool, fields concrete-field[]) mut
| Lambdas and all {sum-type} kinds compile to this
concrete-union record mut
	| This may be an empty array for a lambda type with no implementations.
	late-members mut concrete-type[]?
concrete-struct-body-deferred record
has-members bool(a concrete-union)
	a.late-members !is-empty
members concrete-type[](a concrete-union)
	a.late-members!
set-members void(a concrete-union, members concrete-type[])
	a.late-members := (members,)

is-packed bool(a concrete-struct)
	if inst ?= a.source concrete-struct-source-inst
		if r ?= inst.decl.body record_
			r.flags_ packed_

concrete-type-id record(reference reference-kind, struct concrete-struct-id)
== bool(a concrete-type-id, b concrete-type-id)
<=> comparison(a concrete-type-id, b concrete-type-id)
hash-mix void(a hasher, b concrete-type-id)
	a hash-mix b.reference
	a hash-mix b.struct
# TODO: does this just always use the default-reference-kind? -------------------------------------------------------------
concrete-type record(reference reference-kind, struct concrete-struct) mut
to json(a concrete-type)
id concrete-type-id(a concrete-type)
	a.reference, a.struct.id
reference-kind enum(by-val_, by-ref_)
== bool(a reference-kind, b reference-kind)
<=> comparison(a reference-kind, b reference-kind)
to nat32(a reference-kind)
to symbol(a reference-kind)
show string(a reference-kind)
	a.to::symbol to
to json(a reference-kind)
hash-mix void(a hasher, b reference-kind)
	a hash-mix b.to::nat32
by-val_ concrete-type(struct concrete-struct)
	by-val_, struct
== bool(a concrete-type, b concrete-type)
	a.reference == b.reference && a.struct == b.struct
is-bogus bool(a concrete-type)
	a.reference == by-val_ && a.struct is-bogus
is-java-any bool(a concrete-type)
	a.reference == by-val_ && a.struct is-java-any
is-java-any bool(a concrete-struct)
	match a body
	as concrete-builtin-type x
		x.kind == java-any
	else
		false
is-void bool(a concrete-type)
	a.reference == by-val_ && a.struct is-void
is-void bool(a concrete-struct)
	if b ?= a.body concrete-builtin-type
		b.kind == void
is-empty-type bool(a concrete-type)
	a.reference == by-val_ && a.struct is-empty-struct
is-empty-struct bool(a concrete-struct)
	# Don't rely on type-size since that may not be set yet
	match a body
	as concrete-builtin-type x
		x.kind == void
	as concrete-enum _
		false
	as concrete-extern-type _
		false # TODO: it's possible to specify an empty extern type .......................................................
	as concrete-flags _
		false
	as concrete-record x
		x.fields every f => f.type is-empty-type
	as concrete-union _
		false
	as concrete-struct-body-deferred
		false
is-flags bool(a concrete-type)
	a.reference == by-val_ && a.struct is-flags
is-flags bool(a concrete-struct)
	a.body.concrete-flags !is-empty
purity purity(a concrete-type)
	a.struct purity
must-be-by-val concrete-struct(a concrete-type)
	assert a.reference == by-val_
	a struct
must-be-enum-or-flags enum-or-flags-member[](a concrete-type)
	a.must-be-by-val.source.concrete-struct-source-inst!.decl must-be-enum-or-flags
must-be-enum enum-or-flags-member[](a concrete-type)
	a.must-be-by-val.source.concrete-struct-source-inst!.decl.body.enum_! members
must-be-flags flags_(a concrete-type)
	a.must-be-by-val.source.concrete-struct-source-inst!.decl.body flags_!	

concrete-struct-source union(
	concrete-struct-source-bogus,
	concrete-struct-source-inst,
	concrete-struct-source-lambda
) mut
concrete-struct-source-bogus record
concrete-struct-source-inst record mut
	decl struct-decl
	type-args concrete-type[]
== bool(a concrete-struct-source-inst, b concrete-struct-source-inst)
	a.decl == b.decl && a.type-args == b.type-args
concrete-struct-source-lambda record(containing-fun concrete-fun, index nat) mut
concrete-struct-id record(value nat)
== bool(a concrete-struct-id, b concrete-struct-id)
<=> comparison(a concrete-struct-id, b concrete-struct-id)
hash-mix void(a hasher, b concrete-struct-id)
	a hash-mix b.value
range uri-and-range(a concrete-struct-source)
	match a
	as concrete-struct-source-bogus
		()
	as concrete-struct-source-inst x
		x.decl range
	as concrete-struct-source-lambda x
		x.containing-fun range # TODO: more specific source -----------------------------------------------------------------------
concrete-struct record mut
	id concrete-struct-id
	purity purity
	special-kind concrete-struct-special-kind
	source concrete-struct-source
	body mut concrete-struct-body
	| For a JS build, this will always be unset 
	late-default-reference-kind mut reference-kind?
	| For a JS build, this will always be unset 
	late-type-size mut type-size?
	| Only set for records (and native build only) (TODO: Could this go in lower instead?) ---------------------------------------------------------------
	field-offsets mut nat[]
to json(a concrete-struct)
	name symbol = match a source
	as concrete-struct-source-bogus _
		"BOGUS"
	as concrete-struct-source-inst x
		x.decl name
	as concrete-struct-source-lambda _
		"lambda"
	"{name} {a.id value}"::string to
== bool(a concrete-struct, b concrete-struct)
	a.id == b.id
concrete-struct-special-kind enum
	none
	array-or-mut-array
	catch-point
	fiber
	pointer # mut or const
	tuple
== bool(a concrete-struct-special-kind, b concrete-struct-special-kind)
is-self-mutable bool(a concrete-struct)
	if r ?= a.body concrete-record
		r is-some-field-mutable
type-size-is-set bool(a concrete-struct)
	a.late-type-size !is-empty
type-size type-size(a concrete-struct)
	unless _ ?= a late-type-size
		desc string = match a source
		as concrete-struct-source-inst x
			x.decl.name to
		as concrete-struct-source-bogus
			"BOGUS"
		as concrete-struct-source-lambda _
			"some lambda"
		info log "Missing type-size for {desc}" # ----------------------------------------------------------------------------------
	a late-type-size!
set-type-size void(a concrete-struct, type-size type-size)
	a.late-type-size := type-size,
default-reference-kind-is-set bool(a concrete-struct)
	a.late-default-reference-kind !is-empty
default-reference-kind reference-kind(a concrete-struct)
	a late-default-reference-kind!
set-default-reference-kind void(a concrete-struct, value reference-kind)
	a.late-default-reference-kind := value,

# Returns return and param types
as-fun-type (concrete-type, concrete-type)?(a concrete-type)
	if a.reference == by-val_
		a.struct as-fun-type
as-fun-type (concrete-type, concrete-type)?(a concrete-struct)
	guard x ?= a.body concrete-builtin-type
	assert x.kind is-lambda-type
	x.type-args.only2,

is-array-or-mut-array bool(a concrete-struct)
	a.special-kind == array-or-mut-array
array-element-type concrete-type(array-type concrete-type) # TODO: this should return an option (and don't need to check is-array first)
	assert array-type.must-be-by-val is-array-or-mut-array
	array-type.must-be-by-val array-element-type
array-element-type concrete-type(array-type concrete-struct)
	array-type.source.concrete-struct-source-inst!.type-args only
is-option bool(a concrete-type)
	a.reference == by-val_ && a.struct is-option
is-option bool(a concrete-struct)
	if inst ?= a.source concrete-struct-source-inst
		assert _ ?= a.body concrete-union # TODO: RM (sanity check) --------------------------------------------------------
		inst.decl is-option-type
unwrap-option-type concrete-type(option-type concrete-type) # TODO: this should return an option (instead of needing is-option)
	assert option-type.must-be-by-val is-option
	option-type.must-be-by-val.source.concrete-struct-source-inst!.type-args only
is-catch-point bool(a concrete-struct)
	a.special-kind == catch-point
is-fiber bool(a concrete-struct)
	a.special-kind == fiber
is-pointer bool(a concrete-type)
	a.reference == by-val_ && a.struct is-pointer
is-pointer bool(a concrete-struct)
	a.special-kind == pointer
pointee-type concrete-type(pointer-type concrete-type)
	assert pointer-type.must-be-by-val is-pointer
	pointer-type.must-be-by-val.source.concrete-struct-source-inst!.type-args only
pointee-type-if-is-pointer concrete-type(a concrete-type)
	a is-pointer ? a pointee-type : a
is-bogus bool(a concrete-struct)
	a.source.concrete-struct-source-bogus !is-empty
is-string bool(a concrete-type)
	a.reference == by-val_ && a.struct is-string
is-string bool(a concrete-struct)
	if x ?= a.source concrete-struct-source-inst
		x.decl is-string
is-symbol bool(a concrete-type)
	a.reference == by-val_ && a.struct is-symbol
is-symbol bool(a concrete-struct)
	if x ?= a.source concrete-struct-source-inst
		x.decl is-symbol
is-js-any bool(a concrete-type)
	a.reference == by-val_ && a.struct is-js-any
is-js-any bool(a concrete-struct)
	if x ?= a.source concrete-struct-source-inst
		x.decl is-js-any
is-tuple bool(a concrete-type)
	a.reference == by-val_ && a.struct is-tuple
is-tuple bool(a concrete-struct)
	a.special-kind == tuple
unpack-tuple concrete-type[](a concrete-type)
	assert a is-tuple
	a.struct.source.concrete-struct-source-inst! type-args

has-size-or-pointer-size-bytes bool(a concrete-type)
	match a reference
	as by-val_
		a.struct type-size-is-set
	as by-ref_
		true

size-or-pointer-size-bytes type-size(a concrete-type)
	match a reference
	as by-val_
		a.struct type-size
	as by-ref_
		8, 8

concrete-field record mut
	debug-name symbol # TODO: rename to just 'name' .........................................................................
	is-mutable bool
	type concrete-type

concrete-local-source union(local, concrete-local-source-closure, concrete-generated-local-kind) mut
is-mutable bool(a concrete-local-source)
	match a
	as local x
		x is-mutable
	as concrete-local-source-closure _
		false
	as concrete-generated-local-kind _
		false
concrete-local-source-closure record
concrete-generated-local-kind enum(args, ignore, destruct, member, reference)
to symbol(a concrete-generated-local-kind)
to string(a concrete-generated-local-kind)
	a.to::symbol to
show string(a concrete-generated-local-kind)
	a.to::symbol to

concrete-local-id record(value nat)
== bool(a concrete-local-id, b concrete-local-id)
<=> comparison(a concrete-local-id, b concrete-local-id)
hash-mix void(a hasher, b concrete-local-id)
	a hash-mix b.value
to json(a concrete-local-id)
	a.value to

# TODO: maybe instead of using 'id', just ensure all the generated locals have unique names ------------------------------------------------
concrete-local record mut
	id concrete-local-id
	source concrete-local-source
	type concrete-type
to json(a concrete-local)
	("id", a.id.to), ("type", a.type.to)
== bool(a concrete-local, b concrete-local)
	res = a.id == b.id
	if res
		assert a.type == b.type
	res
is-mutable bool(a concrete-local)
	a.source is-mutable

concrete-fun-body union(
	concrete-fun-body-builtin,
	concrete-fun-body-extern,
	concrete-expr,
	concrete-fun-body-var-get,
	concrete-fun-body-var-set,
	concrete-fun-body-deferred) mut
concrete-fun-body-builtin record(kind builtin-fun, type-args concrete-type[]) mut
concrete-fun-body-extern record(library-name symbol)
concrete-fun-body-var-get record(var concrete-var) mut
concrete-fun-body-var-set record(var concrete-var) mut
concrete-fun-body-deferred record

concrete-fun-source union(
	concrete-fun-source-regular,
	concrete-fun-source-lambda,
	concrete-fun-source-test,
	concrete-fun-source-wrap-main) mut
range uri-and-range(a concrete-fun-source)
	match a
	as concrete-fun-source-regular x
		x.decl range
	as concrete-fun-source-lambda x
		x.containing-fun.range.uri, x.body-expr.range
	as concrete-fun-source-test x
		x.test_ range
	as concrete-fun-source-wrap-main x
		x range
concrete-fun-source-lambda record mut
	containing-fun concrete-fun
	param destructure
	body-expr expr
	| # This is the {index}th lambda in the containing function
	index nat
concrete-fun-source-test record mut
	test_ test_
	| Arbitrary index over all tests
	test-index nat
concrete-fun-source-wrap-main record(range uri-and-range)

concrete-fun-id record(value nat)
== bool(a concrete-fun-id, b concrete-fun-id)
<=> comparison(a concrete-fun-id, b concrete-fun-id)
hash-mix void(a hasher, b concrete-fun-id)
	a hash-mix b.value
to json(a concrete-fun-id)
	a.value to
concrete-fun record mut
	id concrete-fun-id
	source concrete-fun-source
	return-type concrete-type
	params concrete-local[]
	-the-body mut concrete-fun-body
	-dummy void # -----------------------------------------------------------------------------------------------------------------------
new concrete-fun(id concrete-fun-id, source concrete-fun-source, return-type concrete-type, params concrete-local[], body concrete-fun-body)
	match body
	as concrete-expr x
		assert x.type == return-type
	else
		()
	id, source, return-type, params, body, ()
to json(a concrete-fun)
	name symbol = match a source
	as concrete-fun-source-regular x
		x.decl name
	as concrete-fun-source-lambda _
		"lambda"
	as concrete-fun-source-test _
		"test"
	as concrete-fun-source-wrap-main _
		"wrap-main"
	"{name}{a.id value}"::string to
body concrete-fun-body(a concrete-fun)
	a the-body
set-body void(a concrete-fun, value concrete-fun-body)
	match value
	as concrete-expr x
		assert x.type == a.return-type
	else
		()
	a.the-body := value
== bool(a concrete-fun, b concrete-fun)
	a.id == b.id
module-uri uri(a concrete-fun)
	a.range uri
range uri-and-range(a concrete-fun)
	a.source range

concrete-fun-source-regular record mut
	decl fun-decl
	type-args concrete-type[]
	spec-impls concrete-fun[]
concrete-fun-key record
	decl decl-id
	type-args concrete-type-id[]
	spec-impls concrete-fun-id[]
== bool(a concrete-fun-key, b concrete-fun-key)
<=> comparison(a concrete-fun-key, b concrete-fun-key)
hash-mix void(a hasher, b concrete-fun-key)
	a hash-mix b.decl
	for x : b type-args
		a hash-mix x
	for x : b spec-impls
		a hash-mix x

# TODO: why would we ever care about this? --------------------------------------------------------------------------------------------
is-variadic bool(a concrete-fun)
	if x ?= a.source concrete-fun-source-regular
		x.decl.params.varargs !is-empty

name symbol?(a concrete-fun)
	a.source.concrete-fun-source-regular?.decl?.name

is-summon bool(a concrete-fun)
	match a source
	as concrete-fun-source-regular x
		x.decl is-summon
	as concrete-fun-source-lambda x
		x.containing-fun is-summon
	as concrete-fun-source-test _
		# 'isSummon' is called for direct calls, but tests are never called directly
		throw unreachable
	as concrete-fun-source-wrap-main _
		throw unreachable

concrete-expr record mut
	type concrete-type
	range uri-and-range
	kind concrete-expr-kind
to json(a concrete-expr)

concrete-expr-kind union(
	builtin-concrete-expr,
	call-concrete-expr,
	cast-concrete-expr,
	constant,
	create-array-concrete-expr,
	create-record-concrete-expr,
	create-union-concrete-expr,
	drop-concrete-expr,
	finally-concrete-expr,
	if-concrete-expr,
	let-concrete-expr,
	lambda-concrete-expr,
	local-get-concrete-expr,
	local-pointer-concrete-expr,
	local-set-concrete-expr,
	loop-concrete-expr,
	loop-break-concrete-expr,
	loop-continue-concrete-expr,
	match-enum-or-integral-concrete-expr,
	match-string-like-concrete-expr,
	match-union-concrete-expr,
	record-field-get-concrete-expr,
	record-field-pointer-concrete-expr,
	record-field-set-concrete-expr,
	seq-concrete-expr,
	throw-concrete-expr,
	try-concrete-expr,
	try-let-concrete-expr,
	union-as-concrete-expr,
	union-kind-concrete-expr) mut
to json(a concrete-expr-kind)
builtin-concrete-expr record(fun builtin-fun, type-args concrete-type[], args concrete-expr[]) mut
to json(a builtin-concrete-expr)
call-concrete-expr record(called concrete-fun, args concrete-expr[]) mut
to json(a call-concrete-expr)
| Reinterpret cast between different types with the same size
cast-concrete-expr record(inner concrete-expr) mut
to json(a cast-concrete-expr)
create-array-concrete-expr record(args concrete-expr[]) mut
to json(a create-array-concrete-expr)
# Note: This can create a by-ref record too
create-record-concrete-expr record(args concrete-expr[]) mut
to json(a create-record-concrete-expr)
create-union-concrete-expr record(member-index nat, arg concrete-expr) mut
to json(a create-union-concrete-expr)
drop-concrete-expr record(arg concrete-expr) mut
to json(a drop-concrete-expr)
finally-concrete-expr record(right concrete-expr, below concrete-expr) mut
to json(a finally-concrete-expr)
if-concrete-expr record(cond concrete-expr, then concrete-expr, else_ concrete-expr) mut
to json(a if-concrete-expr)

let-concrete-expr record(local concrete-local, value concrete-expr, then concrete-expr) mut
to json(a let-concrete-expr)
# This is not used for native backends.
lambda-concrete-expr record mut
	param concrete-local
	body concrete-expr
to json(a lambda-concrete-expr)
# For a JS target, this can get a local through a closure.
local-get-concrete-expr record(local concrete-local) mut
to json(a local-get-concrete-expr)
local-pointer-concrete-expr record(local concrete-local) mut
to json(a local-pointer-concrete-expr)
local-set-concrete-expr record(local concrete-local, value concrete-expr) mut
to json(a local-set-concrete-expr)
loop-concrete-expr record(body concrete-expr) mut
to json(a loop-concrete-expr)
loop-break-concrete-expr record(value concrete-expr) mut
to json(a loop-break-concrete-expr)
loop-continue-concrete-expr record
to json(a loop-continue-concrete-expr)
match-enum-or-integral-concrete-expr record mut
	-dummy void # TODO:KILL ----------------------------------------------------------------------------------------------
	matched concrete-expr
	case-values integral-values
	case-exprs concrete-expr[]
	else_ concrete-expr?
-to json(_ void)
	()
match-enum-or-integral-concrete-expr concrete-expr-kind(matched concrete-expr, case-values integral-values, case-exprs concrete-expr[], else_ concrete-expr?)
	case-values.size is case-exprs.size
	() match-enum-or-integral-concrete-expr matched, case-values, case-exprs, else_
to json(a match-enum-or-integral-concrete-expr)
matched-integral-type char-or-integral-type(a match-enum-or-integral-concrete-expr)
	match a.matched.type.struct.body
	as concrete-builtin-type x
		x.kind.to::char-or-integral-type?!
	as concrete-enum x
		x.storage_ to
	else
		throw unreachable
match-string-like-concrete-expr record mut
	matched concrete-expr
	equals concrete-fun
	cases concrete-match-string-like-case[]
	else_ concrete-expr
to json(a match-string-like-concrete-expr)
# TODO: shouldn't 'value' be a constant? ------------------------------------------------------------------------------------------------
concrete-match-string-like-case record(value concrete-expr, then concrete-expr) mut
to json(a concrete-match-string-like-case)
match-union-concrete-expr record mut
	matched concrete-expr
	member-indices integral-values
	cases concrete-match-union-case[]
	else_ concrete-expr?
to json(a match-union-concrete-expr)
union_ concrete-union(a match-union-concrete-expr)
	a.matched.type.must-be-by-val.body.concrete-union!
concrete-match-union-case record(local concrete-local?, then concrete-expr) mut
to json(a concrete-match-union-case)
record-field-get-concrete-expr record(record_ concrete-expr, field-index nat) mut
to json(a record-field-get-concrete-expr)
field concrete-field(a record-field-get-concrete-expr)
	a.record_.type.struct.body.concrete-record!.fields[a field-index]
record-field-pointer-concrete-expr record(record_ concrete-expr, field-index nat) mut
to json(a record-field-pointer-concrete-expr)
record-type concrete-struct(a record-field-pointer-concrete-expr)
	type = a.record_ type
	match type reference
	as by-val_
		type.pointee-type must-be-by-val
	as by-ref_
		type struct
field concrete-field(a record-field-pointer-concrete-expr)
	a.record-type.body.concrete-record!.fields[a field-index]
record-field-set-concrete-expr record mut
	record_ concrete-expr
	field-index nat
	value concrete-expr
to json(a record-field-set-concrete-expr)
record-type concrete-type(a record-field-set-concrete-expr)
	struct = a.record_.type struct
	if builtin_ ?= struct.body concrete-builtin-type
		assert builtin_.kind == mut-pointer
		builtin_.type-args only
	else
		a.record_ type
field concrete-field(a record-field-set-concrete-expr)
	a.record-type.struct.body.concrete-record!.fields[a field-index]
seq-concrete-expr record(first concrete-expr, then concrete-expr) mut
to json(a seq-concrete-expr)
throw-concrete-expr record(thrown concrete-expr) mut
to json(a throw-concrete-expr)
try-concrete-expr record mut
	tried concrete-expr
	exception-member-indices integral-values
	catch-cases concrete-match-union-case[]
to json(a try-concrete-expr)
# TODO: to avoid duplicating code in translate-to-js / translate-to-java / lower, compile this to a 'try' early --------------------
try-let-concrete-expr record mut
	local concrete-local?
	value concrete-expr
	exception-member-index integral-value
	catch_ concrete-match-union-case
	then concrete-expr
to json(a try-let-concrete-expr)
| Unsafe internal operation for casting a union to a member. Does not check the kind!
union-as-concrete-expr record(union_ concrete-expr, member-index nat) mut
to json(a union-as-concrete-expr)
case-type concrete-type(a union-as-concrete-expr)
	a.union_.type.must-be-by-val.body.concrete-union!.members[a member-index]
| Internal operation for getting the 'kind' of a union. (This is the member index.)
union-kind-concrete-expr record(union_ concrete-expr) mut
to json(a union-kind-concrete-expr)
union-members concrete-type[](a union-kind-concrete-expr)
	a.union_.type.must-be-by-val.body.concrete-union! members

return-type concrete-type(a call-concrete-expr)
	a.called return-type

arr-type-and-constants-concrete record mut
	arr-type concrete-struct
	element-type concrete-type # TODO: don't need to store this, can get it from arr-type ----------------------------------------
	constants constant[][]

# TODO: rename -- this is not all constants, just the ones by-ref
all-constants-concrete record mut
	c-strings string[]
	static-symbols constant
	arrs arr-type-and-constants-concrete[] # TODO: rename to 'arrays' ----------------------------------------------------------------
	| Maps a {constant-record} to the record values.
	| Note a constant record is always by-value, use 'pointers' for pointers.
	records (constant-record, constant[]) full-index-map[concrete-struct-id]
	unions (constant-union, constant-union-value) full-index-map[concrete-struct-id]

concrete-var-id record(value nat)
== bool(a concrete-var-id, b concrete-var-id)
<=> comparison(a concrete-var-id, b concrete-var-id)
hash-mix void(a hasher, b concrete-var-id)
	a hash-mix b.value
concrete-var record(id concrete-var-id, source var-decl, type concrete-type) mut
kind var-kind(a concrete-var)
	a.source kind
range uri-and-range(a concrete-var)
	a.source range
module-uri uri(a concrete-var)
	a.source module-uri

concrete-program record mut
	version version-info
	all-constants all-constants-concrete
	all-structs concrete-struct[]
	structs-by-id concrete-struct[concrete-struct-id]
	all-vars concrete-var[]
	all-funs concrete-fun[]
	funs-by-id concrete-fun[concrete-fun-id] # TODO: I only needed this for debugging --------------------------------------
	yielding-funs concrete-fun-id set	
	common-funs concrete-common-funs
to json(_ concrete-program)
	throw todo
concrete-common-funs union(
	concrete-common-funs-java,
	concrete-common-funs-js,
	concrete-common-funs-native
) mut
concrete-common-funs-java record mut
	exception concrete-struct
	show-exception concrete-fun
	string concrete-struct
	symbol concrete-struct
	main concrete-fun
concrete-common-funs-js record mut
	exception concrete-type
	string concrete-type # TODO: these should probably be concrete-structs ------------------------------------------------------
	symbol concrete-type
	js-await concrete-fun
	main concrete-fun
concrete-common-funs-native record mut
	alloc concrete-fun
	cur-catch-point concrete-fun
	set-cur-catch-point concrete-fun
	cur-thrown concrete-var
	mark concrete-fun
	rethrow-current-exception concrete-fun
	run-fiber concrete-fun
	rt-main concrete-fun
	throw-impl concrete-fun
	user-main concrete-fun
	gc-root concrete-fun
	set-gc-root concrete-fun
	pop-gc-root concrete-fun
fiber-reference-type concrete-type(a concrete-common-funs-native)
	a.run-fiber.params[1] type

direct-child-exprs record(expr concrete-expr) mut, nominal
iterate bool(a direct-child-exprs, f bool mut(x concrete-expr))
	match a.expr kind
	as builtin-concrete-expr x
		x.args iterate f
	as call-concrete-expr x
		x.args iterate f
	as cast-concrete-expr x
		f[x inner]
	as constant _
		false
	as create-array-concrete-expr x
		x.args iterate f
	as create-record-concrete-expr x
		x.args iterate f
	as create-union-concrete-expr x
		f[x arg]
	as drop-concrete-expr x
		f[x arg]
	as finally-concrete-expr x
		f[x right] || f[x below]
	as if-concrete-expr x
		f[x cond] || f[x then] || f[x else_]
	as lambda-concrete-expr x
		f[x body]
	as let-concrete-expr x
		f[x value] || f[x then]
	as local-get-concrete-expr _
		false
	as local-pointer-concrete-expr _
		false
	as local-set-concrete-expr x
		f[x value]
	as loop-concrete-expr x
		f[x body]
	as loop-break-concrete-expr x
		f[x value]
	as loop-continue-concrete-expr _
		false
	as match-enum-or-integral-concrete-expr x
		f[x matched] || x.case-exprs iterate f || x.else_ cb-option f
	as match-string-like-concrete-expr x
		f[x matched] ||
		x.cases iterate (case_ => f[case_ value] || f[case_ then]) ||
		f[x else_]
	as match-union-concrete-expr x
		f[x matched] ||
		x.cases iterate (case_ => f[case_ then]) ||
		x.else_ cb-option f
	as record-field-get-concrete-expr x
		f[x record_]
	as record-field-pointer-concrete-expr x
		f[x record_]
	as record-field-set-concrete-expr x
		f[x record_] || f[x value]
	as seq-concrete-expr x
		f[x first] || f[x then]
	as throw-concrete-expr x
		f[x thrown]
	as try-concrete-expr x
		f[x tried] || x.catch-cases iterate case_ => f[case_ then]
	as try-let-concrete-expr x
		f[x value] || f[x.catch_ then] || f[x then]
	as union-as-concrete-expr x
		f[x union_]
	as union-kind-concrete-expr x
		f[x union_]

| The type of a constant is implicit (given by context).
| This means two constants that look equal may not be the same constant if they have different types
| (e.g., IntegralValue has different sizes.)
| WARN: A Constant.Record is *by value* even if the record usually isn't. Use Constant.Pointer for a pointer.
constant union(
	constant-array,
	constant-c-string,
	constant-float,
	constant-fun-pointer,
	integral-value,
	constant-record,
	constant-union,
	constant-gc-safe-value, # TODO: could I get rid of this and just use a constant of the appropriate type? ---------------------------------
	constant-null # Needed for gc-safe-value of certain types
)
to json(a constant)
# This assumes the constants are for the same type
== bool(a constant, b constant)
<=> comparison(_ constant, _ constant)
	throw todo # This is required by 'mut-map' but not actually used .........................................................
hash-mix void(hasher hasher, a constant)
	match a
	as constant-array x
		hasher hash-mix x
	as constant-c-string x
		hasher hash-mix x
	as constant-float x
		hasher hash-mix x
	as constant-fun-pointer x
		hasher hash-mix x
	as integral-value x
		hasher hash-mix x
	as constant-record x
		hasher hash-mix x
	as constant-union x
		hasher hash-mix x
	as constant-gc-safe-value x
		hasher hash-mix x
	as constant-null
		()
each-nested-constant void(
	all-constants all-constants-concrete,
	type concrete-type,
	a constant,
	f void mut(type concrete-type, value constant),
)
	f[type, a]
	match a
	as constant-array xs
		elem concrete-type = if type is-string || type is-symbol || type is-js-any
			type # TODO: this should be char8, but it doesn't matter right now ----------------------------------------------------------
		else
			type array-element-type
		for x : all-constants.arrs[xs type-index].constants[xs index]
			all-constants each-nested-constant elem, x, f
	as constant-c-string _
		()
	as constant-float _
		()
	as constant-fun-pointer _
		()
	as integral-value _
		()
	as constant-record x
		fields = type.struct.body.concrete-record! fields
		args = all-constants.records[type.struct id]![x]
		for arg, field : args zip fields
			all-constants each-nested-constant field.type, arg, f
	as constant-union x
		value = all-constants.unions[type.struct id]![x]
		member-type = type.must-be-by-val.body.concrete-union!.members[value member-index]
		all-constants each-nested-constant member-type, value.member, f 
	as constant-gc-safe-value
		()
	as constant-null
		()

constant-array record
	| Index of the array type in {all-constants-concrete}.{arrs} (TODO: maybe that should just be a map keyed by concrete-struct-id?)
	type-index nat
	| Index within that array type
	index nat
== bool(a constant-array, b constant-array)
<=> comparison(a constant-array, b constant-array)
to json(a constant-array)
hash-mix void(hasher hasher, a constant-array)
	hasher hash-mix a.type-index
	hasher hash-mix a.index
| Nul-terminated string identified only by its begin pointer.
constant-c-string record
	| Index into {all-constants-concrete}.{c-strings}
	index nat
to json(a constant-c-string)
	a.index to
== bool(a constant-c-string, b constant-c-string)
hash-mix void(hasher hasher, a constant-c-string)
	hasher hash-mix a.index
| Used for float32 or float64
# TODO: using a wrapper type shouldn't be necessary any mroe ..................................................................
constant-float record(value float)
to json(a constant-float)
	a.value to
hash-mix void(hasher hasher, a constant-float)
	hasher hash-mix a.value
# TODO: handle Nan! -------------------------------------------------------------------------------------------------------------
== bool(a constant-float, b constant-float)
constant-fun-pointer record(fun concrete-fun-id)
to json(a constant-fun-pointer)
	a.fun to
== bool(a constant-fun-pointer, b constant-fun-pointer)
hash-mix void(hasher hasher, a constant-fun-pointer)
	hasher hash-mix a.fun
| Index into {all-constants-concrete}.{records}
constant-record record(index nat)
== bool(a constant-record, b constant-record)
<=> comparison(a constant-record, b constant-record)
hash-mix void(hasher hasher, a constant-record)
	hasher hash-mix a.index
to json(a constant-record)
	a.index to
| Index into {all-constants-concrete}.{unions}
constant-union record(index nat)
== bool(a constant-union, b constant-union)
<=> comparison(a constant-union, b constant-union)
hash-mix void(hasher hasher, a constant-union)
	hasher hash-mix a.index
to json(a constant-union)
	a.index to
constant-union-value record(member-index nat, member constant)
== bool(a constant-union-value, b constant-union-value)
<=> comparison(a constant-union-value, b constant-union-value)
hash-mix void(hasher hasher, a constant-union-value)
	hasher hash-mix a.member-index
	hasher hash-mix a.member
# TODO: Shouldn't ever need this, just constant-null! -----------------------------------------------------------------------------
constant-gc-safe-value record
== bool(a constant-gc-safe-value, b constant-gc-safe-value)
to json(a constant-gc-safe-value)
hash-mix void(_ hasher, _ constant-gc-safe-value)
	()
| Also works for 'void'
constant-null record
== bool(a constant-null, b constant-null)
to json(a constant-null)
hash-mix void(_ hasher, _ constant-null)
	()

constant-bool constant(a bool)
	(a.to::nat,)::integral-value to
as-bool bool(a constant)
	match a.as-integral as-unsigned
	as 0
		false
	as 1
		true
	else
		throw unreachable

as-nat64 nat(a constant)
	a.as-integral as-unsigned

as-float float64(a constant)
	a.constant-float! value

as-integral integral-value(a constant)
	a integral-value!
