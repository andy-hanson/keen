import
	../frontend/show-model
	../util/util
	./low-model
	./model
	./source-range
	./uri

show-low-fun-sig string(a low-fun, is-async bool) show-ctx
	name = show-low-fun-name a
	type = show-low-type a.return-type
	params = join ", ", for param in a.params
		param-name string = match source = param.source
		as local
			source.name.to
		as low-local-source-reference
			throw unreachable
		as low-generated-local-kind
			"{source}"
		"{param-name} {show-low-type param.type}"
	range = line-and-column-getters[a.range]
	"{name} {type}({params}){if is-async then " async"} {range.uri} {range.range.start}"

show-low-fun-name string(a low-fun) show-ctx
	where = line-and-column-getters[a.range].start
	match source = a.source
	as low-fun-source-regular
		"{source.decl.name}{show-low-type-args-post source.type-args} {where}" # TODO: include spec impls
	as low-fun-source-test
		"test {where}"
	as low-fun-source-wrap-main
		"wrap-main {where}"

show-low-type string(a low-type) show-ctx
	match source = a.source
	as low-type-source-bogus
		"BOGUS"
	as low-type-source-inst
		"{show-low-type-args-pre source.type-args}{source.decl.name}"

show-low-type-args-pre string(type-args low-type[]) show-ctx
	match type-args.size
	as 0
		""
	as 1
		"{show-low-type only! type-args} "
	else
		"({join ", ", map type-args, it.show-low-type}) "

-show-low-type-args-post string(a low-type[]) show-ctx
	show-type-args-generic a, (of _ then false), of x
		show-low-type x
