# TODO: Memoize these values so that '==' can be 'reference-equal' ------------------------------------------------------------

integral-value record(as-unsigned nat)
new integral-value(a int)
	a.wrap-to,
as-signed int(a integral-value)
	a.as-unsigned wrap-to
== bool(a integral-value, b integral-value)
<=> comparison(a integral-value, b integral-value)
hash-mix void(hasher hasher, a integral-value)
	hasher hash-mix a.as-unsigned
to json(a integral-value)
	a.as-unsigned to

integral-values alias
	integral-value[]

integral-values-range integral-values(n nat)
	for x in 0::nat .. n
		x,

is-range bool(a integral-values)
	a.with-index every of i, x
		i == x.as-unsigned

to integral-values(a nat)
	- (a,)::integral-value
to integral-values(a nat range)
	for x in a
		x,
