import
	crow/string/unicode
	../../crow/private/parse-util
	../../crow/col/util: iters-of-seq
	./uri

pos alias
	nat32

source-range record(to pos range)
to json(a source-range)
	start: a.start.to
	end: a.end.to
== bool(a source-range, b source-range)
<=> comparison(a source-range, b source-range)
# TODO: this should be implemented in stdlib ---------------------------------------------------------------
<=> comparison(a pos range, b pos range)
start pos(a source-range)
	a.to.low
end pos(a source-range)
	a.to.high
new source-range(start pos, end pos)
	start .. end,
new source-range()
	0, 0

length nat(a source-range)
	a.to.size

is-empty bool(a source-range)
	a.to.is-empty

subscript source-range(a source-range, b nat range)
	end = a.start + b.high.to
	assert end <= a.end
	a.start + b.low.to .. end,

range-contains bool(a source-range, b source-range)
	a.start <= b.start and b.end <= a.end

range-of-start-and-length source-range(start pos, length char8[])
	range-of-start-and-length start, length.size.to::nat32
range-of-start-and-length source-range(start pos, length nat32)
	start, start + length

uri-and-pos record(uri uri, pos pos)

uri-and-range record(uri uri, range source-range)
== bool(a uri-and-range, b uri-and-range)
<=> comparison(a uri-and-range, b uri-and-range)
to json(a uri-and-range)
start uri-and-pos(a uri-and-range)
	a.uri, a.range.start
end uri-and-pos(a uri-and-range)
	a.uri, a.range.end
new uri-and-range()
	top-of-file ()
top-of-file uri-and-range(uri uri)
	uri, ()

to uri-and-pos(a uri-and-range)
	a.uri, a.range.start

line-and-character record(line nat32, character nat32)
== bool(a line-and-character, b line-and-character)
top-of-file line-and-character()
	0, 0
<=> comparison(a line-and-character, b line-and-character)
to json(a line-and-character)
to line-and-character(a json)
	line: a["line"].to
	character: a["character"].to

line-and-column-range record(start line-and-column, end line-and-column)
show string(a line-and-column-range)
	"{a.start}-{a.end}"

uri-line-and-character record(uri uri, pos line-and-character)

uri-line-and-column record(uri uri, pos line-and-column)
show string(a uri-line-and-column)
	"{a.uri} {a.pos}"

uri-line-and-column-range record(uri uri, range line-and-column-range)
show string(a uri-line-and-column-range)
	"{a.uri} {a.range}"
start uri-line-and-column(a uri-line-and-column-range)
	a.uri, a.range.start

line-and-column record(line-0-indexed nat32, column-0-indexed nat32)
== bool(a line-and-column, b line-and-column)
line-1-indexed nat32(a line-and-column)
	a.line-0-indexed + 1
column-1-indexed nat32(a line-and-column)
	a.column-0-indexed + 1
show string(a line-and-column)
	"{a.line-1-indexed}:{a.column-1-indexed}"
to json(a line-and-column)
	line: a.line-0-indexed.to
	column: a.column-0-indexed.to

line-and-character-range record(start line-and-character, end line-and-character)
top-of-file line-and-character-range()
	top-of-file, top-of-file
== bool(a line-and-character-range, b line-and-character-range)
<=> comparison(a line-and-character-range, b line-and-character-range)
to json(a line-and-character-range)
to line-and-character-range(a json)
	start: a["start"].to
	end: a["end"].to
has-pos bool(range line-and-character-range, pos line-and-character)
	range.start <= pos and pos < range.end
test
	assert ((0, 0), (1, 0)) 'has-pos (0, 5)

uri-and-line record(uri uri, line nat32)
== bool(a uri-and-line, b uri-and-line)
<=> comparison(a uri-and-line, b uri-and-line)
hash void(a uri-and-line, state hash-state)
to json(a uri-and-line)
to uri-and-line(a json)
	uri: a["uri"].to
	line: a["line"].to

uri-and-line-and-character-range record(uri uri, range line-and-character-range)
== bool(a uri-and-line-and-character-range, b uri-and-line-and-character-range)
<=> comparison(a uri-and-line-and-character-range, b uri-and-line-and-character-range)
top-of-file uri-and-line-and-character-range(uri uri)
	uri, top-of-file
to json(a uri-and-line-and-character-range)

file-content-getters record
	-inner line-and-column-getters
file-content-getters file-content-getters(a line-and-column-getters)
	a,
subscript string-view(a file-content-getters, uri uri)
	a.inner[uri]!.source-text
subscript string-view(a file-content-getters, where uri-and-range)
	unless where.range.is-empty
		a[where.uri][where.start.pos .. where.end.pos]

line-and-character-getters record(lookup line-and-column-getters) mut
subscript line-and-character-getter(a line-and-character-getters, uri uri)
	a.lookup[uri].?line-and-character-getter else ()
subscript pos(a line-and-character-getters, where uri-line-and-character)
	a[where.uri][where.pos]
subscript uri-and-line-and-character-range(a line-and-character-getters, where uri-and-range)
	where.uri, a[where.uri][where.range]
get-start-line nat(a line-and-character-getters, where uri-and-pos)
	get-start-line a[where.uri], where.pos

line-and-column-getters alias
	line-and-column-getter[uri]
subscript uri-line-and-column(a line-and-column-getters, pos uri-and-pos)
	uri: pos.uri
	pos: a[pos.uri]?[pos.pos] else 0, 0
subscript uri-line-and-column-range(a line-and-column-getters, range uri-and-range)
	range.uri, a[range.uri]![range.range]

line-and-character-getter record
	source-text string-view
	line-to-pos nat32[]
new line-and-character-getter()
	""::char8[], (0,)
subscript pos(a line-and-character-getter, lc line-and-character)
	if lc.line >= a.line-to-pos.size.to
		a.end-of-file
	else
		line-text = get-line-text a, lc.line
		a.line-to-pos[lc.line] + (byte-index-of-character-index line-text, lc.character).to
subscript source-range(a line-and-character-getter, lc line-and-character-range)
	a[lc.start], a[lc.end]
get-start-line nat(a line-and-character-getter, pos nat32)
	line-at-pos a.line-to-pos, pos

subscript line-and-character(a line-and-character-getter, pos pos)
	a[pos, start-of-range]

-subscript line-and-character(a line-and-character-getter, (start-pos pos, kind pos-kind))
	pos mut = start-pos
	line mut = get-start-line a, start-pos
	if kind == end-of-range and a.line-to-pos[line] == pos and line != 0
		line -:= 1
		pos -:= 1
	line-start = a.line-to-pos[line]
	assert pos >= line-start and line == a.line-to-pos.size - 1 or pos <= a.line-to-pos[line + 1]
	line: line.to
	character: character-index-of-byte-index (get-line-text a, line), (pos - line-start) 'to

get-line-text string(a line-and-character-getter, line nat)
	a.source-text[a.line-to-pos[line] .. (next-line-pos a, line)].to

last-line nat(a line-and-character-getter)
	unless a.line-to-pos.is-empty
		a.line-to-pos.size - 1

subscript line-and-character-range(a line-and-character-getter, range source-range)
	a[range.start], a[range.end, end-of-range]

end-of-file pos(a line-and-character-getter)
	a.source-text.size.to
start-of-line-pos pos(a line-and-character-getter, line nat)
	if line >= a.line-to-pos.size - 1
		a.end-of-file
	else
		a.line-to-pos[line]
next-line-pos pos(a line-and-character-getter, line nat)
	if line >= a.line-to-pos.size - 1
		a.end-of-file
	else
		a.line-to-pos[line + 1] - 1

range-of-line source-range(a line-and-character-getter, line nat)
	start: start-of-line-pos a, line
	end: next-line-pos a, line
end-of-line line-and-character(a line-and-character-getter, start pos)
	lc = a[start]
	next = next-line-pos a, lc.line
	assert next > start
	lc.line, lc.character + (next - start)

line-of-pos nat32(a line-and-character-getter, pos pos)
	a[pos].line

line-and-column-getter record
	line-and-character-getter line-and-character-getter
	line-to-n-tabs nat8[]
new line-and-column-getter()
	(), (0,)
source-text string-view(a line-and-column-getter)
	a.line-and-character-getter.source-text
subscript pos(a line-and-column-getter, pos line-and-column)
	a.line-and-character-getter[to-line-and-character a, pos]

line-too-long record(pos pos, actual-columns nat)
== bool(a line-too-long, b line-too-long)
to json(a line-too-long)
lines-over-n-columns line-too-long[](a line-and-column-getter, max-columns nat)
	l2p = a.line-and-character-getter.line-to-pos
	source = a.line-and-character-getter.source-text
	do for* line in 0 .. l2p.size
	pos = l2p[line]
	next-pos = if line == l2p.size - 1 then source.size + 1 else l2p[line + 1]
	n-tabs = a.line-to-n-tabs[line]
	tabs-adjustment = n-tabs * (tab-size - 1)
	# For perf: If there aren't at least N char8s, there aren't at least N characters, so avoid calculating the real length
	do if next-pos - 1 - pos + tabs-adjustment > max-columns
	actual = source[pos .. next-pos - 1].to::string.to::char32[].size + tabs-adjustment
	do if actual > max-columns
	- pos.to, actual

subscript line-and-column(a line-and-column-getter, where pos)
	a[where, start-of-range]
-subscript line-and-column(a line-and-column-getter, where (pos, pos-kind))
	x line-and-character = a.line-and-character-getter[where]
	line = x.line
	character = x.character
	n-tabs = a.line-to-n-tabs[line]
	column nat32 = if character <= n-tabs.to
		character * tab-size
	else
		n-tabs.to * (tab-size - 1) + character
	line, column

subscript line-and-column-range(a line-and-column-getter, range source-range)
	a[range.start], a[range.end, end-of-range]

to-line-and-character line-and-character(a line-and-column-getter, lc line-and-column)
	n-tabs = if lc.line-0-indexed::nat64 < a.line-to-n-tabs.size
		a.line-to-n-tabs[lc.line-0-indexed]
	line: lc.line-0-indexed
	character: column-to-character lc.column-0-indexed, n-tabs.to

line-and-character-getter-for-text line-and-character-getter(text string-view)
	text.line-and-column-getter-for-text.line-and-character-getter

line-and-column-getter-for-text line-and-column-getter(text string-view)
	iter string-iterator = text.begin
	line-to-pos pos mut[] = 0,
	line-to-n-tabs nat8 mut[] = iter.advance-and-get-n-tabs,
	until iter.is-at-end
		if try-take-char8 iter, "\n"
			line-to-pos ~= iter.pos
			line-to-n-tabs ~= iter.advance-and-get-n-tabs
		else
			_ = iter.take-next
	line-and-character-getter: text, line-to-pos.move-to
	line-to-n-tabs: line-to-n-tabs.move-to

advance-and-get-n-tabs nat8(a string-iterator)
	begin = a.pos
	while try-take-char8 a, "\t"
		()
	a.pos - begin 'clamp-to

line-length-in-characters nat(a line-and-character-getter, line nat)
	if line < a.line-to-pos.size - 1
		next = a.line-to-pos[line + 1]
		here = a.line-to-pos[line]
		next - here - 1
	elif line == a.line-to-pos.size - 1
		a.source-text.size - a.line-to-pos[line]

column-to-character pos(column nat32, n-tabs nat32)
	if column <= n-tabs * tab-size
		column / tab-size
	else
		column - (n-tabs * (tab-size - 1))

line-at-pos nat(line-to-pos nat32[], pos pos)
	low-line mut = 0
	high-line mut = line-to-pos.size
	while low-line < high-line - 1
		middle-line = (low-line + high-line) / 2
		middle-pos = line-to-pos[middle-line]
		if pos == middle-pos
			low-line := middle-line
			high-line := middle-line
		elif pos < middle-pos
			# Exclusive -- must be on a previous line
			high-line := middle-line
		else
			# Inclusive -- may be on a later character of the same line
			low-line := middle-line
	low-line

# TODO: configurable
tab-size nat32()
	4

-pos-kind enum(start-of-range, end-of-range)
- == bool(a pos-kind, b pos-kind)

-byte-index-of-character-index nat(a string, character-index nat)
	iter = begin a
	cur mut = 0
	until is-at-end iter or cur >= character-index
		_ = must-take-one-unicode-char iter
		cur +:= 1
	iter.index
-character-index-of-byte-index nat(a string, byte-index nat)
	iter = begin a
	res mut = 0
	until is-at-end iter or iter.index >= byte-index
		_ = must-take-one-unicode-char iter
		res +:= 1
	res

region test

test
	assert "$"::char8[].size == 1
	assert "¥"::char8[].size == 2
	assert "₿"::char8[].size == 3
	assert "𝄮"::char8[].size == 4
	text char8[] = "x\n$¥₿𝄮\ny"
	cash = pos-of text, "$"
	cash is 2
	yen = pos-of text, "¥"
	yen is 3
	bitcoin = pos-of text, "₿"
	bitcoin is 5
	natural = pos-of text, "𝄮"
	natural is 8
	y = pos-of text, "y"
	y is 13

	lcg = text.line-and-column-getter-for-text
	verify-convert lcg, cash, 1, 0
	verify-convert lcg, yen, 1, 1
	verify-convert lcg, bitcoin, 1, 2
	verify-convert lcg, natural, 1, 3
	verify-convert lcg, y - 1, 1, 4
	verify-convert lcg, y, 2, 0

test
	text char8[] = quote
		0123456789
			4567890
	lines-over-n-columns text.line-and-column-getter-for-text, 10 is
		- pos: 11, actual-columns: 11
test
	lines-over-n-columns "01234567890".line-and-column-getter-for-text, 10 is
		- pos: 0, actual-columns: 11
	lines-over-n-columns "₿₿₿₿₿₿₿₿₿".line-and-column-getter-for-text, 10 is ()

test
	lcg = line-and-column-getter-for-text "a\n\tbb\nc\n"
	verify-convert lcg, 0, 0, 0 # a
	verify-convert lcg, 1, 0, 1 # \n
	verify-convert lcg, 2, 1, 0 # \t
	verify-convert lcg, 2, end-of-range, 0, 1, 1, 1
	verify-convert lcg, 3, 1, 1, 4 # b
	verify-convert lcg, 4, 1, 2, 5 # b
	verify-convert lcg, 5, 1, 3, 6 # \n
	verify-convert lcg, 6, 2, 0 # c
	verify-convert lcg, 7, 2, 1 # \n
	verify-convert lcg, 8, 3, 0 # end

	chg = lcg.line-and-character-getter
	lcg[(0, 99)::line-and-column] is 1
	chg[(0, 99)::line-and-character] is 1
	lcg[(99, 99)::line-and-column] is 8
	chg[(99, 99)::line-and-character] is 8

	line-length-in-characters chg, 0 is 1
	line-length-in-characters chg, 1 is 3
	line-length-in-characters chg, 2 is 1
	line-length-in-characters chg, 3 is 0

-verify-convert void(lcg line-and-column-getter, pos pos, line nat32, character nat32)
	verify-convert lcg, pos, line, character, character
-verify-convert void(lcg line-and-column-getter, pos pos, line nat32, character nat32, column nat32)
	verify-convert lcg, pos, start-of-range, line, character, column, pos
-verify-convert void
	lcg line-and-column-getter
	pos pos
	kind pos-kind
	line nat32
	character nat32
	column nat32
	convert-back-pos pos
do
	line-and-character line-and-character = line, character
	line-and-column line-and-column = line, column
	lcg.line-and-character-getter[pos, kind] is line-and-character
	lcg[pos, kind] is line-and-column
	lcg.line-and-character-getter[line-and-character] is convert-back-pos
	lcg[line-and-column] is convert-back-pos

-pos-of pos(text char8[], substring char8[])
	assert before, _ = iters-of-seq text, substring
	before.index.to
