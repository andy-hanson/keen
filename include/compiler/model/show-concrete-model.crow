import
	../frontend/show-model
	../util/util
	./concrete-model
	./model
	./source-range
	./uri

show-concrete-fun-sig string(ctx show-ctx, a concrete-fun, may-yield bool)
	name = ctx show-concrete-fun-name a
	type = ctx show-concrete-type a.return-type
	params = ", " join for param : a params
		param-name string = match param source
		as local x
			x.name to
		as concrete-local-source-reference x
			x.original.name to
		as concrete-local-source-closure _
			"<closure>"
		as concrete-generated-local-kind x
			"{x}"
		"{param-name} {ctx show-concrete-type param.type}"
	show-may-yield string = may-yield ? " may-yield"
	range = ctx.line-and-column-getters[a range]
	"{name} {type}({params}){show-may-yield} {range uri} {range.range start}"

show-concrete-fun-name-and-range string(ctx show-ctx, a concrete-fun)
	range = ctx.line-and-column-getters[a range]
	"{ctx show-concrete-fun-name a} {range uri} {range.range start}"

show-concrete-fun-name string(ctx show-ctx, a concrete-fun)
	match a source
	as concrete-fun-source-regular x
		"{x.decl name}{ctx show-concrete-type-args-post x.type-args}" # TODO: include spec impls
	as concrete-fun-source-test _
		"test" # TODO: more info
	as concrete-fun-source-wrap-main _
		"wrap-main"

show-concrete-type string(ctx show-ctx, a concrete-type)
	name string, range uri-and-range = match a source
	as concrete-type-source-bogus _
		"BOGUS", ()
	as concrete-type-source-inst x
		"{ctx show-concrete-type-args-pre x.type-args}{x.decl name}", x.decl.range
	"{name} {range uri} {range.range start}"

show-concrete-type-args-pre string(ctx show-ctx, type-args concrete-type[])
	match type-args size
	as 0
		""
	as 1
		"{ctx show-concrete-type type-args.only} "
	else
		args string = ", " join for arg : type-args
			ctx show-concrete-type arg
		"({args}) "

-show-concrete-type-args-post string(ctx show-ctx, a concrete-type[])
	a show-type-args-generic (_ => false), x =>
		ctx show-concrete-type x
