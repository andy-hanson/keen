use-prefix
import
	../frontend/show-model
	../util/util
	./concrete-model
	./model
	./source-range
	./uri

show-concrete-fun-sig string(ctx show-ctx, a concrete-fun, is-async bool)
	name = show-concrete-fun-name ctx, a
	type = show-concrete-type ctx, a.return-type
	params = join ", ", for param in a.params
		param-name string = match source = param.source
		as local
			source.name.to
		as concrete-local-source-reference
			throw unreachable
		as concrete-generated-local-kind
			"{source}"
		"{param-name} {show-concrete-type ctx, param.type}"
	show-async string = if is-async then " async"
	range = ctx.line-and-column-getters[a.range]
	"{name} {type}({params}){show-async} {range.uri} {range.range.start}"

show-concrete-fun-name string(ctx show-ctx, a concrete-fun)
	where = ctx.line-and-column-getters[a.range].start
	match source = a.source
	as concrete-fun-source-regular
		"{source.decl.name}{show-concrete-type-args-post ctx, source.type-args} {where}" # TODO: include spec impls
	as concrete-fun-source-test
		"test {where}"
	as concrete-fun-source-wrap-main
		"wrap-main {where}"

show-concrete-type string(ctx show-ctx, a concrete-type)
	match source = a.source
	as concrete-type-source-bogus
		"BOGUS"
	as concrete-type-source-inst
		"{show-concrete-type-args-pre ctx, source.type-args}{source.decl.name}"

show-concrete-type-args-pre string(ctx show-ctx, type-args concrete-type[])
	match type-args.size
	as 0
		""
	as 1
		"{show-concrete-type ctx, type-args.only} "
	else
		args string = join ", ", for arg in type-args
			show-concrete-type ctx, arg
		"({args}) "

-show-concrete-type-args-post string(ctx show-ctx, a concrete-type[])
	show-type-args-generic a, (of _ then false), of x
		show-concrete-type ctx, x
