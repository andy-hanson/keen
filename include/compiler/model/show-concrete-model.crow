import
	../frontend/show-model
	../util/util
	./concrete-model
	./model
	./source-range
	./uri

show-concrete-fun-sig string(a concrete-fun, is-async bool) show-ctx
	name = show-concrete-fun-name a
	type = show-concrete-type a.return-type
	params = join ", ", for param in a.params
		param-name string = match source = param.source
		as local
			source.name.to
		as concrete-local-source-reference
			throw unreachable
		as concrete-generated-local-kind
			"{source}"
		"{param-name} {show-concrete-type param.type}"
	show-async string = if is-async then " async"
	range = line-and-column-getters[a.range]
	"{name} {type}({params}){show-async} {range.uri} {range.range.start}"

show-concrete-fun-name string(a concrete-fun) show-ctx
	where = line-and-column-getters[a.range].start
	match source = a.source
	as concrete-fun-source-regular
		"{source.decl.name}{show-concrete-type-args-post source.type-args} {where}" # TODO: include spec impls
	as concrete-fun-source-test
		"test {where}"
	as concrete-fun-source-wrap-main
		"wrap-main {where}"

show-concrete-type string(a concrete-type) show-ctx
	match source = a.source
	as concrete-type-source-bogus
		"BOGUS"
	as concrete-type-source-inst
		"{show-concrete-type-args-pre source.type-args}{source.decl.name}"

show-concrete-type-args-pre string(type-args concrete-type[]) show-ctx
	match type-args.size
	as 0
		""
	as 1
		"{show-concrete-type only! type-args} "
	else
		args string = join ", ", for arg in type-args
			show-concrete-type arg
		"({args}) "

-show-concrete-type-args-post string(a concrete-type[]) show-ctx
	show-type-args-generic a, (of _ then false), of x
		show-concrete-type x
