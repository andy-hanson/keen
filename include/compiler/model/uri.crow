to string(a file-path)
	a.to::symbol to
to c-string(a file-path) unsafe, native extern
	a.to::string to
as-file-path file-path(_ uri)
	throw todo
/ file-path(_ file-path, _ symbol)
	throw todo

uri record(path-including-scheme path)
== bool(a uri, b uri)
<=> comparison(a uri, b uri)
to symbol(a uri)
	a.path-including-scheme to
to json(a uri)
	a.to::symbol to
hash-mix void(a hasher, uri uri)
	a hash-mix uri.path-including-scheme
parent uri?(a uri)
	if x ?= a.path-including-scheme parent
		(x,),
parent-or-empty uri(a uri)
	a.parent ?? a

new uri()
	throw todo
bogus-uri uri()
	"bogus:bogus" must-parse-uri

base-name symbol(_ uri)
	throw todo
