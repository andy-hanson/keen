path record(to symbol)
== bool(a path, b path)
<=> comparison(a path, b path)
to path(a string)
	a.to,
to string(a path)
	a.to to
hash-mix void(a hasher, path path)
	a hash-mix path.to::symbol
show string(a path)
	a.to to

parent path?(_ path)
	throw todo
parent-or-empty path(a path)
	a.parent ?? a

root-path path(first-component symbol)
	first-component,

/ path(a path, b symbol)
	"{a}/{b}" to

first-and-rest (symbol, path?)(_ path)
	throw todo

