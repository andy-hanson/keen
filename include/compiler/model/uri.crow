concat-uri-and-path uri(_ uri, _ path)
	throw todo

must-parse-uri uri(_ string)
	throw todo
# params are: cwd, text
parse-uri-with-cwd uri(_ uri, _ string)
	throw todo
parse-uri-with-cwd uri(cwd file-path, s string)
	cwd.to::uri parse-uri-with-cwd s
parse-file-path-with-cwd file-path?(_ file-path, _ string)
