	throw todo

rel-path record(n-parents nat, path path)
show string(a rel-path)
	parents string = if a.n-parents == 0
		"./"
	else
		"../" repeat a.n-parents
	"{parents}{a path}"

uris-info record
	cwd uri?
new uris-info()
	(),

show-uri-prefer-relative string(uris-info uris-info, a uri)
	is-relative, components = uris-info.cwd?.to components-prefer-relative a.to
	components show-components !is-relative

# params: cwd, path
components-prefer-relative (bool, symbol[])(_ path?, _ path)
	throw todo

show-components string(components symbol[], uri-encode bool)
	"/" join for index, component : components with-index
		# First component of a Uri is the scheme, which is not encoded
		if uri-encode && index != 0
			component encode-path-component
		else
			component to

-encode-path-component string(component symbol)
	chars char8[] = with out : build
		for x : component.to::string.to::char8[]
			if x is-uri-safe-char
				out ~= x
			else
				out ~= "%"
				out ~~= x.to encode-as-hex
	chars to
-is-uri-safe-char bool(a char8)
	a is-ascii-identifier-char || a == "-" || a == "." || a == "~"

encode-as-hex char8[](a nat8)
	(a >> 4).encode-as-hex-digit, (a & 0xf).encode-as-hex-digit
-encode-as-hex-digit char8(a nat8)
	assert a <= 0xf
	res char8 = a <= 9 ? ("0".to + a).to : ("a".to + (a - 10)).to
	res.decode-hex-digit! is a
	res

# TODO: I'm not sure having a type here helps. Just use string ....................................................................
extension enum
	c
	crow
	dll
	exe
	ilk
	js
	json
	lib
	map
	| No extension
	none
	obj
	other
	pdb

add-extension path(a path, extension string)
	"{a}.{extension}",
add-extension uri(a uri, extension string)
	(a.path-including-scheme add-extension extension),

resolve-uri uri?(_ uri, _ rel-path)
	throw todo

file-permissions enum(regular, executable)
path-and-content record(path path, permissions file-permissions, content string)
