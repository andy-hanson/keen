import
	crow/bits
	crow/parse
	../util/parse-util

path record(to symbol) -new
== bool(a path, b path)
<=> comparison(a path, b path)

as-path path(a string)
	a.to,

-parent-and-base-name (path, string)?(a path)
	if left, right ?= a.to::string try-split-once-right "/"
		(left.to,), right
base-name string(a path)
	a.parent-and-base-name?.b ?? a.to
test
	("a/b",)::path.base-name is "b"
to string(a path)
	a.to to
show string(a path)
	a.to to
to json(a path)
	a.to::string to
hash-mix void(a hasher, path path)
	a hash-mix path.to::symbol
parent path?(a path)
	a.parent-and-base-name?.a
test
	("a",)::path.parent is ()
	("a/b",)::path.parent is ("a",)
root-path path(first-component symbol)
	res path = first-component,
	assert res.parent is-empty
	res
/ path(a path, b string)
	"{a}/{b}",
test
	("a",)::path / "b" is ("a/b",)

first-and-rest (symbol, path?)(a path)
	if par, base ?= a parent-and-base-name
		first, mid = par first-and-rest
		first, if x ?= mid
			x / base
		else
			base.to,
	else
		a.to, ()
test
	("a/b/c",).first-and-rest is ("a", ("b/c",))

parse-path path(a string)
	(a parse-path-inner (false, false)).to,
test
	"a/b\\c".parse-path is "a".root-path / "b" / "c"
-parse-path-options record(uri-decode bool, is-uri-file bool)
-parse-path-inner string(a string, options parse-path-options)
	ptr string-mut-iterator = a,
	res string = with out : build
		out parse-path-component ptr, options.uri-decode
		until ptr is-at-end
			out ~= "/"
			out parse-path-component ptr, options.uri-decode
	res is-windows-path ? res lower-case : res
-parse-path-component void(out string-builder, ptr string-mut-iterator, uri-decode bool)
	loop
		guard ptr !is-at-end : break
		x = ptr take-char
		if x == "%" and uri-decode
			out ~= if x0 ?= ptr.take-char-or-nul decode-hex-digit # TODO: factor out a function ----------------------------
				if x1 ?= ptr.take-char-or-nul decode-hex-digit
					decoded char8 = (x0 << 4) | x1 to
					decoded.to lower-case
				else
					"�"
			else
				"�"
			continue
		elif x is-slash
			break
		else
			out ~= x to
			continue

file-path record(to symbol) -new
to path(a file-path)
	a.to,
base-name string(a file-path)
	a.to::path base-name
root-file-path file-path(a symbol)
	a.root-path.to,
== bool(a file-path, b file-path)
to string(a file-path)
	a.to::symbol to
show string(a file-path)
	a to
to json(a file-path)
	a.to::string to
parent file-path?(a file-path)
	if p ?= a.to::path parent
		(p.to,)
parent-or-empty file-path(a file-path)
	a.parent ?? a
/ file-path(a file-path, component string)
	"{a}/{a is-windows-path ? component lower-case : component}",
test
	("/a/b",)::file-path / "CAPS" is ("/a/b/CAPS",)
	("c:/blah",)::file-path / "CAPS" is ("c:/blah/caps",)
is-windows-path bool(a file-path)
	a.to::string is-windows-path

uri record(to symbol) -new
-file-scheme string()
	"file://"
as-file-path file-path(a uri) # TODO: rename to 'to' ---------------------------------------------------------------------------
	res string = a.to::symbol.to::string try-remove-start! file-scheme
	path char8[] = res parse-path-inner (true, true) to
	# A uri has a "/" before a Windows path, like `file:///c%3a`; a file-path does not.
	str string = if path !is-empty and path[0] == "/" and path[1 .. end] is-windows-path
		path[1 .. end] to
	else
		path to
	str.to,
test
	("file:///a/b",).as-file-path is ("/a/b",)
	("file://c:/foo",).as-file-path is ("c:/foo",)
== bool(a uri, b uri)
<=> comparison(a uri, b uri)
to string(a uri)
	a.to::symbol to
show string(a uri)
	a.to::symbol to
to json(a uri)
	a.to::symbol to
hash-mix void(a hasher, uri uri)
	a hash-mix uri.to::symbol
parent uri?(a uri)
	chars char8[] = a.to::string to
	if index ?= chars last-index-of "/"
		first-index = chars index-of! "/"
		unless index == first-index + 1
			res string = chars[0 .. index] to
			res.to,
test
	("file:///home/crow",)::uri.parent is ("file:///home",)
	("file:///home",)::uri.parent is ("file://",)
	("file://",)::uri.parent is ()
parent-or-empty uri(a uri)
	a.parent ?? a

new uri()
	"",
bogus-uri uri()
	"bogus:bogus",

base-name string(a uri)
	(a.to,)::path base-name
# Return value will start with a "." unless it is the empty string
get-extension symbol(a path)
	a.base-name get-extension
without-extension path(a path)
	a.to.without-extension,
test
	("",)::path.get-extension is ""
	("a.txt",)::path.get-extension is ".txt"
	("a.txt.exe",)::path.get-extension is ".exe"
	("a/b",)::path.get-extension is ""
	("a/b.txt",)::path.get-extension is ".txt"
	("a.txt/b",)::path.get-extension is ""

-get-extension symbol(a string)
	if _, r ?= a try-split-once-right "."
		".{r}"
	else
		""
get-extension symbol(a file-path)
	a.to::path get-extension
get-extension symbol(a uri)
	a.to::string get-extension
-alter-extension symbol(a symbol, extension symbol)
	"{a without-extension}{extension}"
-without-extension symbol(a symbol)
	if l, _ ?= a.to::string try-split-once-right "."
		l to
	else
		a
alter-extension file-path(a file-path, extension symbol)
	- a.to alter-extension extension

/ uri(a uri, b string)
	if a is-windows-path
		"{a}/{b lower-case}",
	else
		res symbol = "{a}/{b}"
		# ------------------------------------------------------------------------------------------------------------------------
		forbid res == "test:///b.crow/crow-config.json" : "WTF?" error
		res,
test
	a uri = "file:///c%3a/foo",
	a / "BAR" is ("file:///c%3a/foo/bar",)

# TODO: name '~~' ======================================================================================================================
concat-paths path(a path, b path)
	"{a}/{b}",
concat-uri-and-path uri(a uri, b path)
	fixed-b string = a is-windows-path ? b.to lower-case : b to
	"{a.to::string}/{fixed-b}",

must-parse-uri uri(a string) # TODO: can just use parse-uri now ----------------------------------------------------------------
	a parse-uri
-parse-uri uri(a string)
	chars char8[] = a to
	assert colon ?= chars index-of ":" : a parse-error a.begin, "URI"
	start = if colon < chars.size - 2 and chars[colon + 1] == "/" and chars[colon + 2] == "/"
		colon + 3
	else
		colon + 1
	schema string = chars[0 .. start] to
	if schema == file-scheme and chars.size >= start + 5 and chars[start .. start + 5].to::char8[] == "/C%3A"
		a.lower-case.to,
	else
		a.to,
is-windows-path bool(a uri)
	a uri-is-file and a.as-file-path is-windows-path
test
	("file:///",)::uri.is-windows-path is false
	("file://c%3a",)::uri.is-windows-path is true
parse-uri-with-cwd uri(cwd uri, text string)
	if text looks-like-absolute-path
		text.parse-file-path to
	elif text looks-like-uri
		text must-parse-uri
	else
		cwd resolve-uri-from-dir text.parse-rel-path ?? throw todo
-looks-like-absolute-path bool(a string)
	a starts-with "/" or a is-windows-path
-looks-like-uri bool(a string)
	a contains-seq "://"
test
	assert "file://foo" looks-like-uri
	forbid "/a/b" looks-like-uri
-is-windows-path bool(a string)
	a.to.to::(char8 array-view) is-windows-path
-is-windows-path bool(a char8 array-view)
	if a.size >= 3
		a[0 .. 2] is-windows-path-start and a[2] is-slash
	elif a.size == 2
		a is-windows-path-start
test
	assert "C:\\Users" is-windows-path
	assert "c:/users" is-windows-path
	forbid "aa:/b" is-windows-path
is-windows-path-start bool(a char8 array-view)
	a.size == 2 and a[0] is-letter and a[1] == ":"

test
	file-ab uri = "file:///a/b",
	file-xy uri = "file:///x/y",
	file-abxy uri = "file:///a/b/x/y",
	file-axy uri = "file:///a/x/y",
	file-ab parse-uri-with-cwd "file:///x/y" is file-xy
	file-ab parse-uri-with-cwd "x/y" is file-abxy
	file-ab parse-uri-with-cwd "../x/y" is file-axy

parse-uri-with-cwd uri(cwd file-path, text string)
	cwd.to::uri parse-uri-with-cwd text
parse-file-path-with-cwd file-path?(cwd file-path, text string)
	res = cwd parse-uri-with-cwd text
	if res uri-is-file
		res as-file-path
must-parse-file-path file-path(text string)
	text parse-file-path
# TODO: define a grammar? ---------------------------------------------------------------------------------------------------------------
parse-file-path file-path(a string)
	is-windows = a is-windows-path
	fixed-a string = is-windows ? a lower-case : a try-remove-start "/" ?? a
	path = fixed-a parse-path-inner (false, false)
	(is-windows ? path.to : "/{path}"),
test
	"a/b".parse-file-path is ("/a/b",)
	"/a/b".parse-file-path is ("/a/b",)
	"a\\b".parse-file-path is ("/a/b",)
	"C:\\User\\CAPPY".parse-file-path is ("c:/user/cappy",)

to uri(a file-path)
	slash string = a is-windows-path ? "/"
	"{file-scheme}{slash}{a.to uri-encode}",
test
	fp file-path = "/a/b",
	uri uri = fp to
	uri is ("file:///a/b",)

uri-is-file bool(a uri)
	a.to::string uri-is-file
-uri-is-file bool(a string)
	a starts-with file-scheme

rel-path record(n-parents nat, path path)
== bool(a rel-path, b rel-path)
to string(a rel-path)
	parents string = if a.n-parents == 0
		"./"
	else
		"../" repeat a.n-parents
	"{parents}{a path}"
show string(a rel-path)
	a to
to json(a rel-path)
	a.to::string to
test
	(0, ("a",))::rel-path.show is "./a"
	(1, ("a",))::rel-path.show is "../a"
	(2, ("a",))::rel-path.show is "../../a"
parse-rel-path rel-path(text string)
	n-parents mut nat = 0
	cur mut char8 array-view = text.to to
	loop
		if cur.size >= 2 and cur[0] == "." and cur[1] is-slash
			cur := cur[2 .. end]
			continue
		elif cur.size >= 3 and cur[0] == "." and cur[1] == "." and cur[2] is-slash
			n-parents +:= 1
			cur := cur[3 .. end]
			continue
		else
			forbid cur.size >= 1 and cur[0] == "/" : todo
			break n-parents, cur.to.parse-path
test
	"".parse-rel-path is (0, ("",))
	"a".parse-rel-path is (0, ("a",))
	"./a".parse-rel-path is (0, ("a",))
	"../a".parse-rel-path is (1, ("a",))
	".././../a".parse-rel-path is (2, ("a",))
-is-slash bool(a char8)
	a == "/" or a == "\\"

uris-info record
	cwd uri?
new uris-info()
	(),

show-uri-prefer-relative string(uris-info uris-info, a uri)
	is-relative, components = uris-info.cwd?.to components-prefer-relative a.to
	components show-components !is-relative
test
	cwd uri = "file://a/b",
	info uris-info = cwd,
	info show-uri-prefer-relative ("file://a/b/c/d",) is "c/d"
	info show-uri-prefer-relative ("file://x/y/c/d",) is "file://x/y/c/d"

# params: cwd, path
-components string[](a string)
	a split "/"
-components-prefer-relative (bool, string array-view)(opt-cwd string?, path string)
	components = path components
	if cwd ?= opt-cwd
		if rest ?= components try-remove-start cwd.components
			true, rest
		else
			false, components.to
	else
		false, components.to

-show-components string(components string array-view, uri-encode bool)
	"/" join for index, component : components with-index
		# First component of a Uri is the scheme, which is not encoded
		if uri-encode and index != 0
			component encode-path-component
		else
			component
-uri-encode string(a string)
	chars char8[] = with out : build
		for x : a.to::char8[]
			if x == "/"
				out ~= x
			else
				out encode-char x
	chars to

-encode-path-component string(component string)
	chars char8[] = with out : build
		for x : component.to::char8[]
			out encode-char x
	chars to
-encode-char void(out char8 array-builder, a char8)
	if a is-uri-safe-char
		out ~= a
	else
		out ~= "%"
		out ~~= a.to encode-as-hex

-is-uri-safe-char bool(a char8)
	a is-ascii-identifier-char or a == "-" or a == "." or a == "~"

encode-as-hex char8[](a nat8)
	(a >> 4).encode-as-hex-digit, (a & 0xf).encode-as-hex-digit
-encode-as-hex-digit char8(a nat8)
	assert a <= 0xf
	res char8 = a <= 9 ? ("0".to + a).to : ("a".to + (a - 10)).to
	res.decode-hex-digit! is a
	res

add-extension file-path(a file-path, extension symbol)
	- a.to add-extension extension
add-extension uri(a uri, extension symbol)
	- a.to add-extension extension
-add-extension symbol(a symbol, extension symbol)
	"{a}{extension}"

resolve-uri-from-file uri?(from-file uri, relative rel-path)
	if dir ?= from-file parent
		dir resolve-uri-from-dir relative
resolve-uri-from-dir uri?(from-dir uri, relative rel-path)
	if res ?= (from-dir.to,) resolve-path relative
		res.to,
-resolve-path path?(from-dir path, relative rel-path)
	if relative.n-parents == 0
		from-dir concat-paths relative.path
	elif par ?= from-dir parent
		par resolve-path (relative.n-parents - 1, relative.path)
test
	("file:///foo/a.crow",) resolve-uri-from-file (0, ("b.crow",)) is ("file:///foo/b.crow",)
	("file:///a.crow",) resolve-uri-from-file (0, ("b.crow",)) is ("file:///b.crow",)

# TODO: these were in testUri.d. These should probably be broken up to go near the relevant functions
test
	a = "file:///a" must-parse-uri
	a.to::string is "file:///a"
	b = "file:///b" must-parse-uri
	a is a
	a <=> b is less

	a-x = a / "x"
	a / "x" is a-x
	a-y = a / "y"
	a-y.to::string is "file:///a/y"

	z-w = a-x parse-uri-with-cwd "/z/w.crow"
	z-w.to::string is "file:///z/w.crow"
	z-w.base-name is "w.crow"
	z-w.get-extension is ".crow"
	a-x-z-w = a-x parse-uri-with-cwd "./z/w"
	a-x-z-w.to::string is "file:///a/x/z/w"
	a-x parse-uri-with-cwd "z/w" is a-x-z-w
	a-x parse-uri-with-cwd "../y" is a-y

	crow-lang = "http://crow-lang.org" must-parse-uri
	a-x parse-uri-with-cwd "http://crow-lang.org" is crow-lang

	crow-lang.parent is ()
	crow-lang.get-extension is ".org" # TODO: I could fix this ...............................................................

test
	"file:///home/crow/a.txt" verify-file "/home/crow/a.txt", ("home", "crow", "a.txt")
	"file:///C%3A/Users/User/a.txt" verify-file "file:///c%3a/users/user/a.txt", "C:\\Users\\User\\a.txt", "c:/users/user/a.txt",
		"c:", "users", "user", "a.txt"

	a-uri = "file:///C%3A/Users/User/a" must-parse-uri
	a-uri.to::string is "file:///c%3a/users/user/a"
	a-uri.is-windows-path is true
	boo-uri = a-uri / "BOO"
	boo-uri.to::string is "file:///c%3a/users/user/a/boo"
	boo-uri.is-windows-path is true

	a = "C:\\Users\\User\\a" parse-file-path
	"c:/users/user/a".parse-file-path is a
	a.is-windows-path is true
	boo = a / "BOO"
	boo.to::string is "c:/users/user/a/boo"
	boo.is-windows-path is true

	a-txt = "/foo/a.txt" parse-file-path
	a-txt.is-windows-path is false
	a-f00d-json = a-txt alter-extension ".f00d.json"
	a-f00d-json.to::string is "/foo/a.f00d.json"

	a-f00d-crow = a-f00d-json alter-extension ".crow"
	a-f00d-crow.to::string is "/foo/a.f00d.crow"

-verify-file void(uri string, file-path string, components string[])
	uri verify-file uri, file-path, file-path, components
-verify-file void(uri-in string, uri-out string, file-path-in string, file-path-out string, components string[])
	uri = uri-in must-parse-uri
	file-path = file-path-in parse-file-path
	assert uri uri-is-file
	uri.as-file-path is file-path
	file-path.to::uri is uri

	file-path.to.test-components is components

	uri.to::string is uri-out
	file-path.to::string is file-path-out

-test-components string[](a path)
	res string[] = with out : build
		cur mut = a
		while p ?= cur parent
			out ~= cur base-name
			cur := p
		unless cur.to::string is-empty
			out ~= cur base-name
	res.reverse to

