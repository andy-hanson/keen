# TODO: this doesn't really justify its own module any more. --------------------------------------------------------------

os enum(none, linux, windows)
js-target enum(browser, node)

# TODO: isn't this basically just OS? ----------------------------------------------------------------------------------------
build-target enum
	java
	node-js
	web
== bool(a build-target, b build-target)
to json(a build-target)

to build-target(a js-target)
	match a
	as browser
		web
	as node
		node-js

get-os os() trusted, summon
	if extern windows
		windows
	elif extern linux
		linux
	else
		linux # throw todo ----------------------------------------------------------------------------------------------------
