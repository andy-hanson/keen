os enum(none, linux, windows)
== bool(a os, b os)
js-target enum(browser, node)

# TODO: isn't this basically just OS? ----------------------------------------------------------------------------------------
build-target enum
	fake-extern
	java
	linux-native
	node-js
	web
	windows-native
== bool(a build-target, b build-target)
to symbol(a build-target)
show string(a build-target)
	a.to::symbol to

to build-target(a js-target)
	match a
	as browser
		web
	as node
		node-js

native-target build-target(os os)
	match os
	as none
		fake-extern
	as linux
		linux-native
	as windows
		windows-native

get-os os() trusted, summon
	if extern windows
		windows
	elif extern linux
		linux
	else
		linux # throw todo ----------------------------------------------------------------------------------------------------

version-fun enum
	is-big-endian
	is-interpreted
	is-single-threaded
	is-stack-trace-enabled
to version-fun?(a symbol)
to json(a version-fun)

version-options record
	is-single-threaded bool
	stack-trace-enabled bool
default version-options()
	is-single-threaded: false
	stack-trace-enabled: true

version-info record
	target build-target
	options version-options
	is-interpreted bool
	is-jit bool

is-native bool(a version-info)
	match a target
	as fake-extern
		throw unreachable
	as java
		false
	as linux-native
		true
	as node-js
		false
	as web
		false
	as windows-native
		true
is-java bool(a version-info)
	a.target == java
is-js bool(a version-info)
	match a target
	as node-js
		true
	as web
		true
	else
		false

version-info-for-interpret version-info(os os, options version-options)
	target: os native-target
	options: options
	is-interpreted: true
	is-jit: false

version-info-for-jit version-info(os os, options version-options)
	target: os native-target
	options: options
	is-interpreted: false
	is-jit: true
version-info-for-build-to-c version-info(os os, options version-options)
	target: os native-target
	options: options
	is-interpreted: false
	is-jit: false
version-info-for-build-to-java version-info()
	target: java
	options: do
		is-single-threaded: false
		stack-trace-enabled: true
	is-interpreted: false
	is-jit: false
version-info-for-build-to-js version-info(target js-target)
	target: target to
	options: version-options-for-js
	is-interpreted: false
	is-jit: false
-version-options-for-js version-options()
	is-single-threaded: true
	stack-trace-enabled: true

is-version bool(a version-info, fun version-fun)
	match fun
	as is-big-endian
		throw todo
	as is-interpreted
		a is-interpreted
	as is-single-threaded
		a.options is-single-threaded
	as is-stack-trace-enabled
		a.options stack-trace-enabled
