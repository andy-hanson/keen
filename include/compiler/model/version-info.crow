os enum(none, linux, node-js, web, windows)
== bool(a os, b os)
js-target enum(browser, node)

version-fun enum
	is-big-endian
	is-interpreted
	is-single-threaded
	is-stack-trace-enabled
to version-fun?(a symbol)

version-options record
	is-single-threaded bool
	stack-trace-enabled bool
default version-options()
	is-single-threaded: false
	stack-trace-enabled: true

version-info record
	os os
	options version-options
	is-interpreted bool
	is-jit bool
