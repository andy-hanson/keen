import
	../interpret/bytecode # TODO: this shouldn't really depend on the interpreter ..........................................
	./low-model
	./model

is-empty-type bool(types all-low-types, a low-type)
	(types type-size-bytes a) == 0

type-size-bytes nat(program low-program, a low-type)
	program.all-types type-size-bytes a
type-size-bytes nat(types all-low-types, a low-type)
	types size-of-type a size-bytes

size-of-type type-size(program low-program, a low-type)
	program.all-types size-of-type a
size-of-type type-size(_ all-low-types, a low-type)
	match a combine-pointer
	as low-extern-type x
		x type-size
	as low-fun-pointer-type _
		fun-pointer-size
	as primitive-type x
		x primitive-size
	as low-pointer-combine _
		pointer-size
	as low-record x
		x type-size
	as low-union x
		x type-size

n-stack-entries-for-type nat(program low-program, a low-type)
	program type-size-bytes a n-stack-entries-for-bytes
n-stack-entries-for-record nat(_ low-program, a low-record)
	a.type-size.size-bytes n-stack-entries-for-bytes
n-stack-entries-for-union nat(_ low-program, a low-union)
	a.type-size.size-bytes n-stack-entries-for-bytes
-n-stack-entries-for-bytes nat(bytes nat)
	bytes divide-and-round-up stack-entry-size

pack record(in-entries nat, out-entries nat, fields pack-field[])
pack-field record(in-offset nat, out-offset nat, size nat)

opt-pack pack?(program low-program, record_ low-record)
	unless record_.fields every x => x.offset is-multiple-of 8
		in-offset-entries mut nat = 0
		fields pack-field[] = for field : record_ fields
			field-in-offset-bytes = in-offset-entries * 8
			field-size-bytes = program type-size-bytes field.type
			in-offset-entries +:= field-size-bytes n-stack-entries-for-bytes
			field-in-offset-bytes, field.offset, field-size-bytes
		(in-offset-entries, (program n-stack-entries-for-record record_), fields),

-pointer-size type-size()
	8, 8
-fun-pointer-size type-size()
	8, 8

# TODO: this kind of duplicates get-builtin-struct-size
primitive-size type-size(a primitive-type)
	match a
	as void
		0, 1
	as bool
		1, 1
	as char8
		1, 1
	as int8
		1, 1
	as nat8
		1, 1
	as int16
		2, 2
	as nat16
		2, 2
	as char32
		4, 4
	as float32
		4, 4
	as int32
		4, 4
	as nat32
		4, 4
	as float64
		8, 8
	as int64
		8, 8
	as nat64
		8, 8
