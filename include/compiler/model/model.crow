# TODO: this is not actualy stored on the model anywhere, should I move it to where it's used? -----------------------------------------
import-or-export record force-data
	| Empty for an automatic import of std
	source import-or-export-ast?
	module module
	| If this is {internal}, import internal and public exports.
	| If this is {public}, import only public exports.
	import-visibility export-visibility
	# TODO: doc comment is out of date. This no longer tracks anything .....................................................................
	| If the ast was {name-and-range}[], this will have an entry for each name (except when there was nothing to import).
	| For an import of a whole module, this tracks what was actually used in this module.
	| For a re-export of a whole module, this is not used.
	named-imported mut exports
is-std bool(a import-or-export)
