import
	../util/enum-map
	../util/util
	./ast
	./integral-values
	./parse-diag
	./source-range
	./uri
	./version-info

purity enum(data_, shared_, mut_)
== bool(a purity, b purity)
<=> comparison(a purity, b purity)
to symbol(a purity)
	match a
	as data_
		"data"
	as shared_
		"shared"
	as mut_
		"mut"

is-purity-compatible bool(expected purity, actual purity)
	actual <= expected

purity-range record(best-case purity, worst-case purity)

-combine-purity-range purity-range(a purity-range, b purity-range)
	(a.best-case worse-purity b.best-case), (a.worst-case worse-purity b.worst-case)

is-purity-always-compatible bool(referencer purity, referenced purity-range)
	referenced.worst-case <= referencer
is-purity-always-compatible bool(referencer purity-range, referenced purity)
	referenced <= referencer.best-case
is-purity-possibly-compatible bool(referencer purity, referenced purity-range)
	referenced.best-case <= referencer

worse-purity purity(a purity, b purity)
	a max b

type-params alias
	name-and-range[]
type-args alias
	type[]
spec-impls alias
	called[]
specs alias
	spec-inst[]

type union(bogus-type, type-param-index, struct-inst) mut
== bool(a type, b type)
bogus-type record
== bool(a bogus-type, b bogus-type)
<=> comparison(a bogus-type, b bogus-type)
| Represent type parameter as the index, so we don't generate different types for every `t[]`.
| (These are disambiguated in the type checker using `TypeAndContext`)
type-param-index record(index nat)
== bool(a type-param-index, b type-param-index)
<=> comparison(a type-param-index, b type-param-index)

is-bogus bool(a type)
	a.bogus-type !is-empty

is-empty-type bool(a type)
	if x ?= a struct-inst
		x is-empty-type
is-empty-type bool(a struct-inst)
	a.decl is-void || a.decl is-empty-record
-is-empty-record bool(a struct-decl)
	if x ?= a.body record_
		x.fields is-empty

is-enum bool(a type)
	if x ?= a struct-inst
		x.decl.body.enum_ !is-empty
is-flags bool(a type)
	if x ?= a struct-inst
		x.decl.body.flags_ !is-empty

is-array bool(a type)
	a is-builtin-type array
is-mut-array bool(a type)
	a is-builtin-type mut-array
is-mut-array bool(a struct-inst)
	a is-builtin-type mut-array
is-mut-slice bool(a type)
	a is-builtin-type mut-slice
is-array-or-mut-slice bool(a struct-decl)
	a is-builtin-type array || a is-builtin-type mut-slice

is-tuple bool(common-types common-types, a type)
	if x ?= a struct-inst
		common-types is-tuple x.decl
is-tuple bool(common-types common-types, a struct-decl)
	if actual ?= common-types tuple a.type-params.size
		actual == a

as-tuple type[]?(common-types common-types, type type)
	if common-types is-tuple type
		type.struct-inst!.type-args,

is-bool bool(a type)
	a is-builtin-type bool
is-char8 bool(a type)
	a is-builtin-type char8
is-char32 bool(a type)
	a is-builtin-type char32
is-float32 bool(a type)
	a is-builtin-type float32
is-float64 bool(a type)
	a is-builtin-type float64
is-future bool(a type)
	a is-builtin-type future
is-future bool(a struct-inst)
	a is-builtin-type future
is-int8 bool(a type)
	a is-builtin-type int8
is-int16 bool(a type)
	a is-builtin-type int16
is-int32 bool(a type)
	a is-builtin-type int32
is-int64 bool(a type)
	a is-builtin-type int64
is-js-any bool(a type)
	a is-builtin-type js-any
is-nat8 bool(a type)
	a is-builtin-type nat8
is-nat16 bool(a type)
	a is-builtin-type nat16
is-nat32 bool(a type)
	a is-builtin-type nat32
is-nat64 bool(a type)
	a is-builtin-type nat64
is-string bool(a type)
	a is-builtin-type string
is-string bool(a struct-decl)
	a is-builtin-type string
is-symbol bool(a type)
	a is-builtin-type symbol
is-void bool(a type)
	a is-builtin-type void
is-void bool(a struct-decl)
	a is-builtin-type void

as-integral-type integral-type?(a type)
	if builtin_ ?= a as-builtin-type
		builtin_ to

-is-builtin-type bool(a type, builtin_ builtin-type)
	if x ?= a struct-inst
		x is-builtin-type builtin_
-is-builtin-type bool(a struct-inst, builtin_ builtin-type)
	a.decl is-builtin-type builtin_
-is-builtin-type bool(a struct-decl, builtin_ builtin-type)
	if x ?= a.body builtin-type
		x == builtin_
-as-builtin-type builtin-type?(a type)
	if x ?= a struct-inst
		x.decl.body builtin-type

array-element-type type?(a type)
	if a is-array
		a.struct-inst!.type-args.only,

try-unwrap-option-type type?(a type)
	if a is-option-type || a is-bogus
		a.must-unwrap-option-type-or-bogus,
must-unwrap-option-type-or-bogus type(a type)
	a is-bogus ? bogus-type : a must-unwrap-option-type
must-unwrap-option-type type(a type)
	assert a is-option-type
	a.struct-inst!.type-args only

is-option-type bool(a type)
	a is-builtin-type option
is-option-type bool(a struct-decl)
	a is-builtin-type option

is-fun-pointer bool(a type)
	a is-builtin-type fun-pointer
is-lambda-type bool(a type)
	if x ?= a struct-inst
		x.decl is-lambda-type
is-lambda-type bool(a struct-decl)
	if x ?= a.body builtin-type
		x is-lambda

is-pointer-const-or-mut bool(a type)
	a is-pointer-const || a is-pointer-mut
is-pointer-const-or-mut bool(a struct-decl)
	a is-builtin-type pointer-const || a is-builtin-type pointer-mut
is-pointer-const bool(a type)
	a is-builtin-type pointer-const
is-pointer-mut bool(a type)
	a is-builtin-type pointer-mut
pointee-type type(a type)
	a.struct-inst! pointee-type
pointee-type type(a struct-inst)
	assert a.decl is-pointer-const-or-mut
	a.type-args only

purity-range purity-range(a type)
	match a
	as bogus-type
		data_, data_
	as type-param-index _
		data_, mut_
	as struct-inst x
		x purity-range

best-case-purity purity(a type)
	a.purity-range best-case

linkage-range linkage-range(a type)
	match a
	as bogus-type
		extern_, extern_
	as type-param-index _
		internal, extern_
	as struct-inst x
		x linkage-range

params union(destructure[], varargs) mut
new params()
	()::destructure[] to
arity arity(a params)
	match a
	as array xs
		xs.size to
	as varargs _
		arity-varargs
varargs record(param destructure, element-type type) mut # TODO: can't element-type just be param.type.array-element-type ????????
is-empty bool(a params)
	a.arity is-empty

params-array destructure[](a params)
	match a
	as array x
		x
	as varargs x
		x.param,

assert-non-variadic destructure[](a params)
	a.array!

-arity union(nat, arity-varargs)
arity-varargs record

count-param-decls nat(a arity)
	match a
	as nat x
		x
	as arity-varargs
		1
is-variadic bool(a arity)
	match a
	as nat _
		false
	as arity-varargs
		true
is-empty bool(a arity)
	match a
	as nat x
		x == 0
	as arity-varargs
		false
arity-matches bool(sig-arity arity, n-args nat)
	match sig-arity
	as nat x
		x == n-args
	as arity-varargs
		true

signature-container union(spec-decl, struct-decl) mut
	module-uri uri()
	name symbol()
	type-params type-params()
to type-container(a signature-container)
	match a
	as spec-decl x
		x to
	as struct-decl x
		x to

| Function signature without a body. Used in a spec or variant.
signature record mut
	container signature-container
	ast signature-ast
	return-type type
	params destructure[]
	doc-comment-references mut doc-comment-references
name symbol(a signature)
	a.ast name
module-uri uri(a signature)
	a.container module-uri
range uri-and-range(a signature)
	a.module-uri, a.ast.range
name-range uri-and-range(a signature)
	a.module-uri, a.ast.name-and-range.range
doc-comment-ast doc-comment-ast(a signature)
	a.ast doc-comment
doc-comment doc-comment(a signature)
	a.doc-comment-ast, a.doc-comment-references
signature-index nat(a signature)
	match a container
	as spec-decl x
		x.sigs must-have-index-of-pointer a
	as struct-decl x
		x.body.sum-type!.methods must-have-index-of-pointer a

type-params-and-sig record mut
	type-params type-params
	return-type type
	params params-short
	count-specs nat
params-short union(param-short[], params-short-variadic) mut
new params-short()
	()::param-short[] to
params-short-variadic record(param param-short, element-type type) mut
param-short record(name symbol, type type) mut

record-field-source union(single-destructure-ast, record-field-ast)
	doc-comment doc-comment-ast()
	range source-range()
	name-range source-range()
name symbol(a record-field-source)
	match a
	as single-destructure-ast x
		x.name name
	as record-field-ast x
		x.name name

record-field record mut
	source record-field-source
	containing-record struct-decl
	visibility visibility
	mutability visibility?
	type type
	doc-comment-references mut doc-comment-references
module-uri uri(a record-field)
	a.containing-record module-uri
name symbol(a record-field)
	a.source name
range source-range(a record-field)
	a.source range
name-range uri-and-range(a record-field)
	a.module-uri, a.source.name-range
doc-comment-ast doc-comment-ast(a record-field)
	a.source doc-comment
doc-comment doc-comment(a record-field)
	a.doc-comment-ast, a.doc-comment-references

by-val-or-ref enum(by-val_, by-ref_)
== bool(a by-val-or-ref, b by-val-or-ref)

record-flags record
	new-visibility visibility
	nominal_ bool
	packed_ bool
	forced-by-val-or-ref by-val-or-ref?

enum-member-source union(enum-or-flags-member-ast, single-destructure-ast)
	doc-comment doc-comment-ast()
	range source-range()
	name-range source-range()
name symbol(a enum-member-source)
	match a
	as enum-or-flags-member-ast x
		x name
	as single-destructure-ast x
		x.name name

enum-member alias
	enum-or-flags-member
enum-or-flags-member record mut
	source enum-member-source
	containing-enum struct-decl
	value integral-value
	doc-comment-referecnes mut doc-comment-references
storage_ integral-type(a enum-or-flags-member)
	match a.containing-enum body
	as enum_ x
		x storage_
	as flags_ x
		x storage_
	else
		throw unreachable
module-uri uri(a enum-or-flags-member)
	a.containing-enum module-uri
visibility visibility(a enum-or-flags-member)
	a.containing-enum visibility
name symbol(a enum-or-flags-member)
	a.source name
range source-range(a enum-or-flags-member)
	a.source range
name-range uri-and-range(a enum-or-flags-member)
	a.module-uri, a.source.name-range

struct-body union(struct-body-bogus, builtin-type, enum_, extern-type, flags_, record_, sum-type) mut
struct-body-bogus record
enum_ record mut
	storage_ integral-type
	members enum-or-flags-member[]
	members-by-name enum-or-flags-member[symbol]
extern-type record(size type-size?)
flags_ record(storage_ integral-type, members enum-or-flags-member[]) mut
record_ record(flags_ record-flags, fields record-field[]) mut
| interface, union, or variant
sum-type record mut
	kind sum-type-kind
	listed-members sum-type-member-and-method-impls[]
	methods signature[]
as-union sum-type-member-and-method-impls[](a struct-body)
	a.sum-type! as-union
as-union sum-type-member-and-method-impls[](a sum-type)
	assert a.kind == union_
	a listed-members

get-all-flags-value integral-value(body flags_)
	res mut nat = 0
	for member : body members
		res |:= member.value as-unsigned
	res,

builtin-type enum
	array
	bool
	catch-point
	char8
	char32
	float32
	float64
	fun-pointer
	future
	int8
	int16
	int32
	int64
	js-any
	lambda-data
	lambda-mut
	lambda-shared
	mut-array
	mut-slice
	nat8
	nat16
	nat32
	nat64
	option
	pointer-const
	pointer-mut
	string
	symbol
	void
== bool(a builtin-type, b builtin-type)
is-char-or-integral bool(a builtin-type)
	match a
	as char8
		true
	as char32
		true
	as int8
		true
	as int32
		true
	as int64
		true
	as nat8
		true
	as nat16
		true
	as nat32
		true
	as nat64
		true
	else
		false
is-lambda bool(a builtin-type)
	match a
	as lambda-data
		true
	as lambda-mut
		true
	as lambda-shared
		true
	else
		false

type-size record(size-bytes nat, alignment-bytes nat)

struct-alias record mut
	id decl-id
	ast struct-alias-ast
	module-uri uri
	visibility visibility
	doc-comment-references mut doc-comment-references
	target mut struct-inst
doc-comment-ast doc-comment-ast(a struct-alias)
	a.ast doc-comment
doc-comment doc-comment(a struct-alias)
	a.doc-comment-ast, a.doc-comment-references
name symbol(a struct-alias)
	a.ast.name name
type-params type-params(_ struct-alias)
	()
range uri-and-range(a struct-alias)
	a.module-uri, a.ast.range
name-range uri-and-range(a struct-alias)
	a.module-uri, a.ast.name-range

# Sorted least strict to most strict
linkage enum(internal, extern_)
== bool(a linkage, b linkage)
<=> comparison(a linkage, b linkage)

| Range of possible linkage
-linkage-range record(least-strict linkage, most-strict linkage)
-combine-linkage-range linkage-range(referencer linkage-range, referenced linkage-range)
	(referencer.least-strict min referenced.least-strict), (referencer.most-strict min referenced.most-strict)
is-linkage-possibly-compatible bool(referencer linkage, referenced linkage-range)
	referenced.most-strict >= referencer
is-linkage-always-compatible bool(referencer linkage, referenced linkage-range)
	referenced.least-strict >= referencer

struct-decl record mut
	id decl-id
	source struct-decl-source
	module-uri uri
	visibility visibility
	extern_ symbol-set?
	is-summon bool
	| Warn: purity on the decl does not take type args into account
	purity purity
	purity-is-forced bool
	doc-comment-references mut doc-comment-references
	sum-type-memberships mut sum-type-membership[]
	body mut struct-body
== bool(a struct-decl, b struct-decl)
	trusted a reference-equal b
extern-set symbol-set(a struct-decl)
	a.extern_ ?? ()
linkage linkage(a struct-decl)
	a.extern_ == (("js",),) ? extern_ : internal
doc-comment-ast doc-comment-ast(a struct-decl)
	a.source doc-comment
doc-comment doc-comment(a struct-decl)
	a.doc-comment-ast, a.doc-comment-references
type-params type-params(a struct-decl)
	a.source type-params
name symbol(a struct-decl)
	a.source name
range uri-and-range(a struct-decl)
	a.module-uri, a.source.range
keyword-range uri-and-range(a struct-decl)
	a.module-uri, a.source.keyword-range
name-range uri-and-range(a struct-decl)
	a.module-uri, a.source.name-range
is-template bool(a struct-decl)
	a.type-params !is-empty

must-be-enum-or-flags enum-or-flags-member[](a struct-decl)
	if x ?= a.body enum_
		x members
	else
		a.body.flags_! members

sum-type-member-and-method-impls record mut
	member struct-inst
	method-impls mut called?[]

sum-type-membership record mut
	ast modifier-keyword-ast
	sum-type struct-inst
	method-impls mut called?[]

struct-decl-source union(struct-decl-ast, struct-decl-source-bogus)
	type-params type-params()
struct-decl-source-bogus record(name symbol, type-params type-params)
range source-range(a struct-decl-source)
	match a
	as struct-decl-ast x
		x range
	as struct-decl-source-bogus	_
		()
name symbol(a struct-decl-source)
	match a
	as struct-decl-ast x
		x.name name
	as struct-decl-source-bogus x
		x name
doc-comment doc-comment-ast(a struct-decl-source)
	match a
	as struct-decl-ast x
		x doc-comment
	as struct-decl-source-bogus _
		()
keyword-range source-range(a struct-decl-source)
	match a
	as struct-decl-ast x
		x keyword-range
	as struct-decl-source-bogus _
		()
name-range source-range(a struct-decl-source)
	match a
	as struct-decl-ast x
		x name-range
	as struct-decl-source-bogus _
		()

decl-or-inst-id record(value nat)
== bool(a decl-or-inst-id, b decl-or-inst-id)
<=> comparison(a decl-or-inst-id, b decl-or-inst-id)
hash-mix void(hasher hasher, a decl-or-inst-id)
	hasher hash-mix a.value
decl-id alias
	decl-or-inst-id
inst-id alias
	decl-or-inst-id

| WARN: Do not create directly. Go through the functions in 'instantiate.crow'.
struct-inst record(id inst-id, decl struct-decl, type-args type-args) mut
== bool(a struct-inst, b struct-inst)
	trusted a reference-equal b
linkage-range linkage-range(a struct-inst)
	res mut linkage-range = a.decl.linkage, a.decl.linkage
	for x : a type-args
		res combine-linkage-range:= x linkage-range
	res
purity-range purity-range(a struct-inst)
	res mut purity-range = a.decl.purity, a.decl.purity
	for x : a type-args
		res combine-purity-range:= x purity-range
	res
is-definitely-by-ref bool(a struct-inst)
	if x ?= a.decl.body record_
		x.flags_.forced-by-val-or-ref == (by-ref_,)
is-definitely-by-val bool(a record_)
	a.fields is-empty || a.flags_ forced-by-val-or-ref == (by-val_,)

spec-decl-body record(builtin_ builtin-spec?, parents specs, sigs signature[]) mut

builtin-spec enum(data_, shared_)

spec-decl record mut
	id decl-id
	module-uri uri
	ast spec-decl-ast
	visibility visibility
	doc-comment-references mut doc-comment-references
	late-body mut spec-decl-body?
== bool(a spec-decl, b spec-decl)
	trusted a reference-equal b
doc-comment-ast doc-comment-ast(a spec-decl)
	a.ast doc-comment
doc-comment doc-comment(a spec-decl)
	a.doc-comment-ast, a.doc-comment-references
name symbol(a spec-decl)
	a.ast.name name
type-params type-params(a spec-decl)
	a.ast type-params
body-is-set bool(a spec-decl)
	a.late-body !is-empty
body spec-decl-body(a spec-decl)
	a late-body!
set-body void(a spec-decl, value spec-decl-body)
	forbid a body-is-set
	a.late-body := value,
	assert a body-is-set
builtin_ builtin-spec?(a spec-decl)
	a.body builtin_
parents specs(a spec-decl)
	a.body parents
overwrite-parents-to-empty void(a spec-decl)
	a.late-body := (a.builtin_, (), a.sigs),
sigs signature[](a spec-decl)
	a.body sigs
range uri-and-range(a spec-decl)
	a.module-uri, a.ast.range
name-range uri-and-range(a spec-decl)
	a.module-uri, a.ast.name-range

| WARN: Do not create directly. Go through the functions in 'instantiate.crow'.
spec-inst record(id inst-id, decl spec-decl, type-args type-args, body mut spec-inst-body) mut
parents spec-inst[](a spec-inst)
	a.body parents
sig-types return-and-param-types[](a spec-inst)
	a.body sig-types
name symbol(a spec-inst)
	a.decl name
-each-spec-sig void(a spec-inst, cb void mut(x signature))
	for parent : a parents
		parent each-spec-sig cb
	a.decl.sigs for-loop cb
count-sigs nat(a spec-inst[])
	a sum x => x count-sigs
count-sigs nat(a spec-inst)
	a.parents.count-sigs + a.sig-types.size
each-called-spec-sig void(a spec-inst, cb void mut(x called-spec-sig))
	for parent : a parents
		parent each-called-spec-sig cb
	for sig-index : 0::nat .. a.decl.sigs.size
		cb[a, sig-index]

spec-inst-body record mut
	parents specs
	| These correspond to the signatures in decl.body
	sig-types return-and-param-types[]

flags-function enum
	in
	| `&`
	intersect
	| `~`
	negate
	| Function to get an empty member of the flags
	none
	| `|`
	union_

auto-fun record mut
	kind auto-fun-kind
	| e.g., '<=>' implementations for each record/union member
	members called[]

auto-fun-kind enum
	compare
	enum-or-flags-members
	enum-or-flags-to-integral
	enum-to-symbol
	equals
	flags-to-symbol-array
	integral-to-opt-enum-or-flags
	symbol-to-opt-enum-or-flags
	to-json

fun-body union(
	fun-body-bogus,
	auto-fun,
	builtin-fun,
	create-enum-or-flags,
	create-extern,
	create-record,
	create-record-and-convert-to-sum-type,
	create-sum-type,
	expr,
	fun-body-extern,
	fun-body-file-import,
	flags-function,
	fun-body-method,
	record-field-call,
	record-field-get,
	record-field-pointer,
	record-field-set,
	sum-type-member-get,
	var-get,
	var-set
) mut
-is-generated bool(a fun-body)
	match a
	as fun-body-bogus
		false
	as auto-fun _
		false
	as builtin-fun _
		false
	as expr _
		false
	as fun-body-extern _
		false
	as fun-body-file-import _
		false
	else
		true

fun-body-bogus record
create-enum-or-flags record(member enum-or-flags-member) mut
create-extern record
create-record record
create-record-and-convert-to-sum-type record mut
	| This is the sum-type's case type, and the record type
	member struct-inst
create-sum-type record
fun-body-extern record(library-name symbol)
fun-body-file-import record(content import-file-content)
fun-body-method record(method signature) mut
sum-type sum-type(_ fun-body-method, fun fun-decl)
	fun.params.array![0].type.struct-inst!.decl.body.sum-type!
method-index nat(a fun-body-method, fun fun-decl)
	(a sum-type fun).methods must-have-index-of-pointer a.method
record-field-call record(field record-field, fun-kind fun-kind) mut
record-field-get record(field record-field) mut
record-field-pointer record(field record-field) mut
record-field-set record(field record-field) mut
sum-type-member-get record
var-get record(var var-decl) mut
