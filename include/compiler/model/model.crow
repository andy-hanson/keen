try-expr record
	ast try-ast
	tried expr
	catches catch_[]
	type type
to json(a try-expr)
	tried: a.tried.to
	catches: a.catches.to
range source-range(a try-expr)
	a.ast.range
| The local type is the caught type.
| NOTE: We create a local even if the user did not write one.
| The final catch may have a type of {exception}.
catch_ record(destructure simple-destructure, then_ expr)
to json(a catch_)
caught-type struct-inst(a catch_)
	a.destructure.type.struct-inst!

try-let-expr record
	ast try-let-ast
	destructure destructure
	value expr
	catch_ catch_
	then_ expr?
	type type
to json(a try-let-expr)
	destructure: a.destructure.to
	value: a.value.to
	catch: a.catch_.to
	then: a.then_.to
range source-range(a try-let-expr)
	a.ast.range

typed-expr record(ast typed-ast, inner expr, type type)
to json(a typed-expr)
	inner: a.inner.to
	type: a.type.to
range source-range(a typed-expr)
	a.ast.range

unpack-option record(ast unpack-option-ast, destructure destructure, option expr)
to json(a unpack-option)
range source-range(a unpack-option)
	a.destructure.start, a.option.end

each-descendent-expr-including void(a expr, cb void mut(x expr))
	cb[a]
	each-descendent-expr-excluding a, cb
each-descendent-expr-excluding void(a expr, cb void mut(x expr))
	each-direct-child-expr a, of x
		each-descendent-expr-including x, cb
each-direct-child-expr void(a expr, cb void mut(x expr))
	res bool? = find-direct-child-expr a, of x
		cb[x]
		()
	forbid res
# TODO: define a 'direct-child-exprs' type with 'iterate', then don't need to define 'each-direct-child-expr' -----------------
find-direct-child-expr[t] t?(a expr, cb t? mut(x expr))
	match a
	as assert-or-forbid-expr
		cb[a.condition] or cb-option a.thrown, cb or cb-option a.after, cb
	as bogus-call-expr
		()
	as bogus-expr
		()
	as bogus-wrong-type-expr
		cb[a.inner]
	as call-expr
		first a.args, cb
	as call-named-new-expr
		first a.args, cb
	as call-option-expr
		first a.all-args, cb
	as finally-expr
		cb[a.right] or cb[a.below]
	as force-expr
		cb[a.arg]
	as if-expr
		cb[a.condition] or cb[a.first-branch] or cb[a.second-branch]
	as lambda-expr
		cb[a.body]
	as let-expr
		cb[a.value] or cb-option a.then_, cb
	as list-expr
		first a.parts, cb[it.arg]
	as literal-scalar-expr
		()
	as literal-string-like-expr
		()
	as local-get-expr
		()
	as local-get-and-refine-expr
		()
	as local-set-expr
		cb[a.value]
	as logical-expr
		cb[a.left] or cb[a.right]
	as loop-expr
		cb[a.body]
	as loop-break-expr
		cb[a.value]
	as loop-continue-expr
		()
	as loop-while-or-until-expr
		cb[a.condition] or cb[a.body] or cb-option a.after, cb
	as match-enum-expr
		cb[a.matched] or first a.cases, cb[it.then_] or cb-option a.else_, cb
	as match-scalar-expr
		cb[a.matched] or first a.cases, cb[it.then_] or cb[a.else_]
	as match-string-like-expr
		cb[a.matched] or first a.cases, cb[it.then_] or cb[a.else_]
	as match-sum-type-expr
		cb[a.matched] or direct-child-in-match-sum-type-cases a.cases, cb or cb-option a.else_, cb
	as not-expr
		cb[a.arg]
	as seq-expr
		cb[a.first] or cb[a.then_]
	as throw-expr
		cb[a.thrown]
	as trusted-expr
		cb[a.inner]
	as try-expr
		cb[a.tried] or first a.catches, cb[it.then_]
	as try-let-expr
		cb[a.value] or cb[a.catch_.then_] or cb-option a.then_, cb
	as typed-expr
		cb[a.inner]
	as unpack-option
		cb[a.option]
-direct-child-in-match-sum-type-cases[t] t?(cases match-sum-type-case[], cb t? mut(x expr))
	first cases, cb[it.then_]

sum-type-member-getter fun-decl(funs fun-decl[], struct struct-decl, x sum-type-membership)
	must-find-fun-named funs, struct.name, of fun
		fun.body.sum-type-member-get and
		fun.params.only.type == x.sum-type and
		fun.source.struct-decl! == struct

must-find-fun-named fun-decl(funs fun-decl[], name symbol, cb bool mut(x fun-decl)) # TODO: this is slow! ------------------------------
	find! funs, of fun
		fun.name == name and cb[fun]

| In the CLI, we omit diagnostics if there are other more severe ones.
| So e.g., you wouldn't see unused code errors if there are parse errors.
diagnostic-severity enum
	| Unused or unstylish code
	lint
	warning
	check-error
	name-not-found
	| Severe error where a common fun (e.g. 'alloc', 'main') or type (e.g. 'void') is missing
	common-missing
	parse-error
	import-error
== bool(a diagnostic-severity, b diagnostic-severity)
<=> comparison(a diagnostic-severity, b diagnostic-severity)
is-fatal bool(a diagnostic-severity)
	a == common-missing or a == parse-error or a == import-error

uri-and-diagnostic record(uri uri, diagnostic diagnostic)
new uri-and-diagnostic(range uri-and-range, kind diag)
	range.uri, (range.range, kind)
where uri-and-range(a uri-and-diagnostic)
	a.uri, a.diagnostic.range
kind diag(a uri-and-diagnostic)
	a.diagnostic.kind

