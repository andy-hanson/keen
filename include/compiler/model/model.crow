diag-alias-not-allowed record
diag-assert-or-forbid-message-is-throw record
diag-assignment-not-allowed record
diag-auto-fun-bare record
diag-auto-fun-enum-or-flags-to-wrong-storage record mut
	enum-or-flags-type struct-decl
	actual-storage-type integral-type
	expected-storage-type integral-type
diag-auto-fun-param-not-simple record
diag-auto-fun-spec-corrupt record(spec-name symbol)
diag-auto-fun-spec-from-wrong-module record
diag-auto-fun-type-not-fully-visible record
diag-auto-fun-wrong-name record
