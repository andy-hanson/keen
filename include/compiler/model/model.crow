	return-and-param-types return-and-param-types
diag-if-throw record
diag-import-file union
	cant-import-crow-as-text
	circular-import
	library-not-configured
	read-error
	relative-import-reaches-past-root
cant-import-crow-as-text record
circular-import record(cycle uri[])
library-not-configured record(library-name symbol)
| The imported file will also have a ParseDiag for the issue, but we also show the error in the importer.
| (This is important in an IDE.)
read-error record(uri uri, diag read-file-diag)
relative-import-reaches-past-root record(imported rel-path)
diag-import-refers-to-nothing record(name symbol)
diag-it-identity record
diag-lambda-cant-be-function-pointer record
diag-lambda-cant-infer-param-type record
diag-lambda-closure-purity record
	lambda-kind lambda-kind
	local-name symbol
	local-purity purity
	| If missing, the error is that the local itself is 'mut'.
	| If present, the error is that the type is 'mut'.
	type type-with-container?
diag-lambda-multiple-match record
	| This is only the expected types that are lambdas
	choices expected-for-diag-choices
