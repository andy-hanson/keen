	try-expr
	try-let-expr
	typed-expr
do
	range source-range()
to json(a expr)
start pos(a expr)
	a.range start
end pos(a expr)
	a.range end

-type-not-common type(a expr)
	a type ()
type type(a expr, common-types common-types?)
	match a
	as assert-or-forbid-expr x
		x.after type common-types
	as bogus-call-expr x
		x expected-type
	as bogus-expr x
		x expected-type
	as bogus-wrong-type-expr x
		x expected-type
	as call-expr x
		x type
	as call-option-expr x
		x type
	as extern-expr _
		common-types! bool
	as finally-expr x
		x type common-types
	as if-expr x
		x type common-types
	as lambda-expr x
		x.type
	as let-expr x
		x type common-types
	as literal-float-expr x
		x type common-types
	as literal-integral-expr x
		x type common-types
	as literal-string-like-expr x
		x type common-types
	as local-get-expr x
		x type
	as local-set-expr _
		common-types! void
	as loop-expr x
		x type
	as loop-break-expr x
		x.loop_ type
	as loop-continue-expr x
		x.loop_ type
	as loop-while-or-until-expr x
		x.after type common-types
	as match-enum-expr x
		x type
	as match-integral-expr x
		x type
	as match-string-like-expr x
		x type
	as match-sum-type-expr x
		x type
	as seq-expr x
		x type common-types
	as throw-expr x
		x type
	as trusted-expr x
