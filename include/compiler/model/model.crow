crow-module record force-data
	uri uri
	| The config closest to this module. (Not necessarily the main config.)
	config config
	ast file-ast
	| WARN: May contain duplicates. This will match the order in {ast}.imports and {ast}.re-exports, but does not include file imports.
	imports-and-re-exports module[]
	| WARN: This is not every diagnostic. See {each-diagnostic}.
	diagnostics mut diagnostic[]
	aliases struct-alias[]
	structs struct-decl[]
	vars var-decl[]
	specs spec-decl[]
	funs fun-decl[]
	tests test_[]
	| This is derived data based on the funs, specs, and structs/aliases in a module
	public-exports exports
	public-and-internal-exports exports
	doc-comment-references doc-comment-references
== bool(a crow-module, b crow-module)
	trusted a reference-equal b
to json(_ crow-module)
	throw todo
module-uri uri(a crow-module)
	a uri
name string(a crow-module)
	a.uri base-name
n-type-params nat(_ crow-module)
	0
type-param-asts type-params(_ crow-module)
	()
range uri-and-range(a crow-module)
	a.uri top-of-file
doc-comment-ast doc-comment-ast(a crow-module)
	a.ast doc-comment
doc-comment doc-comment(a crow-module)
	a.doc-comment-ast, a.doc-comment-references
export-visibility enum(internal, public)
exports exports(a module, visibility export-visibility)
	match visibility
	as public
		a public-exports
	as internal
		a public-and-internal-exports

exports record
	funs fun-decl multi-by-name
	structs-and-aliases struct-or-alias by-name
	specs spec-decl by-name
new exports()
	(), (), ()

| Excludes derived decls, e.g. FunDecl that is a record field getter
each-decl void(a crow-module, cb void mut(x any-decl))
	for x : a aliases
		cb[x]
	for x : a structs
		cb[x]
	for x : a vars
		cb[x]
	for x : a specs
		cb[x]
	for x : a funs
		if _ ?= x.source fun-decl-ast
			cb[x]
	for x : a tests
		cb[x]

| Does not walk re-exports
zip-ast-and-module-imports void(module crow-module, f void mut(ast import-or-export-ast, imported module))
	ast = module ast
	ast-total = ast.imports.count-non-file-imports + ast.re-exports.count-non-file-imports + (ast no-std_ ? 0 : 1)
	guard ast-total == module.imports-and-re-exports.size
	i mut nat = ast no-std_ ? 0 : 1
	for x : ast.imports?.paths ?? ()
		unless _ ?= x.kind import-file-ast
			f[x, module.imports-and-re-exports[i]]
			i +:= 1
-count-non-file-imports nat(a imports-or-exports-ast?)
	guard ast ?= a
	ast.paths count path => path.kind.import-file-ast is-empty

any-decl union(fun-decl, spec-decl, struct-alias, struct-decl, test_, var-decl)
