import
	crow/bits
	crow/unsafe
	../../crow/col/experimental/object-memoizer
	../util/enum-map
	../util/by-name
	../util/util
	./ast
	./parse-diag
	./source-range
	./uri

purity enum(data_, shared_, mut_)
== bool(a purity, b purity)
<=> comparison(a purity, b purity)
to symbol(a purity)
	match a
	as data_
		"data"
	as shared_
		"shared"
	as mut_
		"mut"
to string(a purity)
	a.to::symbol.to
to json(a purity)
	a.to::string.to

is-purity-compatible bool(expected purity, actual purity)
	actual <= expected

purity-range record(best-case purity, worst-case purity)

-combine-purity-range purity-range(a purity-range, b purity-range)
	best-case: worse-purity a.best-case, b.best-case
	worst-case: worse-purity a.worst-case, b.worst-case

is-purity-always-compatible bool(referencer purity, referenced purity-range)
	referenced.worst-case <= referencer
is-purity-always-compatible bool(referencer purity-range, referenced purity)
	referenced <= referencer.best-case
is-purity-possibly-compatible bool(referencer purity, referenced purity-range)
	referenced.best-case <= referencer

worse-purity purity(a purity, b purity)
	max a, b

-max-type-args nat()
	10

-type-arrays global((type-array, type-array-key) object-memoizer)
-type-params-type-args global(type-args[])
	for n nat in 0 .. max-type-args
		to-type-args for i nat in 0 .. n then (i,)::type-param-index
-spec-arrays global((specs, specs-key) object-memoizer)

| This should only be called if there is nothing from the 'model' alive any more.
clear-object-memoizers void() unsafe
	type-arrays := ()
	spec-arrays := ()

to-type-array type-array(types type[])
	assert types.size >= 2
	hash = get-hash types
	trusted memoize type-arrays, (types, hash), of then types, hash
type-array record
	inner type[]
	hash nat
-type-array-key record
	inner type[]
	hash nat
-== bool(a type-array-key, b type-array-key)
	a.inner == b.inner
-memoizer-key type-array-key(a type-array)
	a.inner, a.hash
size nat(a type-array)
	a.inner.size
subscript type(a type-array, index nat)
	a.inner[index]
map-type-array type-array(a type-array, f type mut(x type))
	to-type-array map a.inner, f
hash void(a type-array, state hash-state)
	hash a.hash, state
to json(a type-array)
	a.inner.to
-type-params-type-args type-args(n nat) # TODO: MOVE? -----------------------------------------------------------------------------------------------
	trusted type-params-type-args[n]

type-params alias
	name-and-range[]
| No type args, one type arg, or many type args.
| This is more efficient than always allocating an array, since most types have <= 1 type args.
# TODO: I'd like to just use `no-type-args, type, type-array`. But currently unions-of-unions have inefficient representation.
type-args union(no-type-args, bogus-type, type-param-index, struct-inst, type-array)
	hash void(state hash-state)
type type?(a type-args)
	match a
	as no-type-args then ()
	as bogus-type then a
	as type-param-index then a
	as struct-inst then a
	as type-array then ()
as-type-args type-args(a type)
	match a
	as bogus-type then a
	as type-param-index then a
	as struct-inst then a
hash nat(a type-args)
	match a
	as no-type-args
		0
	as bogus-type
		0
	as type-param-index
		a.index
	as struct-inst
		a.hash
	as type-array
		a.hash
to json(a type-args)
	match a
	as no-type-args
		null
	as bogus-type
		a.to
	as type-param-index
		a.to
	as struct-inst
		a.to
	as type-array
		a.to
no-type-args record
hash void(_ no-type-args, _ hash-state)
	()
new type-args()
	no-type-args
make-type-args[col, elem] type-args(inputs col, f type mut(x elem)) col size, (col, elem) iterate, (col, elem) at-index
	match inputs.size
	as 0
		()
	as 1
		as-type-args f[inputs[0]]
	else
		to-type-array map inputs, f
map-type-args type-args(a type-args, f type mut(x type)) # TODO: this is basically just 'make-type-args' ............................................
	match a
	as no-type-args
		()
	as bogus-type
		as-type-args f[a]
	as type-param-index
		as-type-args f[a]
	as struct-inst
		as-type-args f[a]
	as type-array
		map-type-array a, f
| Most code should avoid calling this as it means allocating an array
slow-to-array type[](a type-args)
	match a
	as no-type-args
		()
	as bogus-type
		- a
	as type-param-index
		- a
	as struct-inst
		- a
	as type-array
		a.inner
-to-type-args type-args(a type[])
	match a.size
	as 0
		()
	as 1
		as-type-args a[0]
	else
		to-type-array a
== bool(a type-args, b type-args)
	trusted a 'reference-equal b
is-empty bool(a type-args)
	!!a.no-type-args
subscript type(a type-args, index nat)
	match a
	as no-type-args
		throw unreachable
	as bogus-type
		index is 0
		a
	as type-param-index
		index is 0
		a
	as struct-inst
		index is 0
		a
	as type-array
		a[index]
map-every-type-args[col, elem] type-args?
	a col
	f type? mut(x elem)
do (col, elem) array-like, (col, elem) iterate
	match a.size
	as 0
		no-type-args
	as 1
		?as-type-args f[a[0]]
	else
		if res type[] = map-every a, f
			to-type-array res
zip-every-type-args bool(a type-args, b type-args, f bool mut(x type, y type))
	match a
	as no-type-args
		assert b.no-type-args
		true
	as bogus-type
		f[a, b.type!]
	as type-param-index
		f[a, b.type!]
	as struct-inst
		f[a, b.type!]
	as type-array
		every (zip a.inner, b.type-array!.inner), f
iterate bool(a type-args, f bool mut(x type))
	match a
	as no-type-args
		false
	as bogus-type
		f[a]
	as type-param-index
		f[a]
	as struct-inst
		f[a]
	as type-array
		iterate a.inner, f
size nat(a type-args)
	match a
	as no-type-args
		0
	as bogus-type
		1
	as type-param-index
		1
	as struct-inst
		1
	as type-array
		a.inner.size
return-and-param-types record
	return-type type
	param-types type[]
# It doesn't seem to be worth memoizing these
spec-impls alias
	called[]
specs record -new
	inner spec-inst[]
	hash nat
	all-builtin (builtin-spec, type-args)[]
	instantiated-sigs called-spec-sig[]
to json(a specs)
	a.inner.to
new specs()
	(), 0, (), ()
is-empty bool(a specs)
	trusted a 'reference-equal ()
-specs-key record
	inner spec-inst[]
	hash nat
-== bool(a specs-key, b specs-key)
	a.inner == b.inner
-memoizer-key specs-key(a specs)
	a.inner, a.hash
get-or-add-specs specs(specs spec-inst[])
	guard !is-empty specs
	hash = get-hash specs
	trusted memoize spec-arrays, (specs, hash), of
		inner: specs
		hash: hash
		all-builtin: for* x in specs then x.builtin_
		instantiated-sigs:
			index mut nat = 0
			for* x in specs
				for sig, sig-type in zip x.all-sigs, x.sig-types
					res called-spec-sig = index, x.decl, sig, sig-type
					index +:= 1
					res
is-unsafe bool(a specs)
	exists a.all-builtin, it.a == unsafe
is-summon bool(a specs)
	exists a.all-builtin, it.a == summon
has-extern bool(a specs, value build-target)
	exists a.all-builtin, it.a == value.to

type union(bogus-type, type-param-index, struct-inst)
	hash nat()
	hash void(state hash-state)
== bool(a type, b type)
	trusted a 'reference-equal b
to json(a type)
bogus-type record
hash nat(_ bogus-type)
	0
hash void(_ bogus-type, _ hash-state)
	()
to json(a bogus-type)
| Represent type parameter as the index, so we don't generate different types for every 't[]'.
| (These are disambiguated in the type checker using 'type-and-context')
type-param-index record
	-index_ nat
	# This is needed to force this type to be wrapped and not use 'nat' directly.
	-dummy nat
hash nat(a type-param-index)
	a.index
hash void(a type-param-index, state hash-state)
	hash a.index, state
index nat(a type-param-index)
	a.index_
new type-param-index(index nat)
	# This silly-looking code ensures that each type-param-index value is a compile-time constant, avoiding runtime allocation
	match index
	as 0
		0, 0
	as 1
		1, 1
	as 2
		2, 2
	as 3
		3, 3
	as 4
		4, 4
	as 5
		5, 5
	as 6
		6, 6
	as 7
		7, 7
	as 8
		8, 8
	as 9
		9, 9
	as 10
		10, 10
	as 11
		11, 11
	as 12
		12, 12
	as 13
		13, 13
	as 14
		14, 15
	as 15
		15, 15
	else
		throw unreachable
== bool(a type-param-index, b type-param-index)
	trusted a 'reference-equal b
to json(a type-param-index)
	a.index.to

debug string(a type)
	match a
	as bogus-type
		"<<bogus>>"
	as type-param-index
		"t{a.index}"
	as struct-inst
		a.debug
debug string(a struct-inst)
	name = a.decl.name
	if is-empty a.type-args
		"{name}"
	else
		"{debug-type-args a.type-args} {name}"
debug-type-args string(a type-args)
	args string[] = map a, it.debug
	match args.size
	as 0
		""
	as 1
		args.only
	else
		"({join ", ", args}) "

is-bogus bool(a type)
	!!a.bogus-type

is-array bool(a type)
	is-builtin-type a, array
is-mut-slice bool(a type) # TODO: some of these should be moved to get-builtin-fun.crow if they are used nowhere else ---------
	is-builtin-type a, mut-slice
is-array-or-mut-slice bool(a type)
	is-builtin-type a, array or is-builtin-type a, mut-slice

is-tuple bool(common-types common-types, a type)
	a.struct-inst and is-tuple common-types, a.decl
is-tuple bool(common-types common-types, a struct-decl)
	(tuple common-types, a.n-type-params) == a

as-tuple type-args?(common-types common-types, type type)
	if is-tuple common-types, type
		type.struct-inst!.type-args

# TODO: most of these are only used for get-builtin-fun, maybe just move them there -------------------------------------------
is-bool bool(a type)
	is-builtin-type a, bool
is-char8 bool(a type)
	is-builtin-type a, char8
is-char32 bool(a type)
	is-builtin-type a, char32
is-float32 bool(a type)
	is-builtin-type a, float32
is-float64 bool(a type)
	is-builtin-type a, float64
is-int64 bool(a type)
	is-builtin-type a, int64
is-js-any bool(a type)
	is-builtin-type a, js-any
is-nat32 bool(a type)
	is-builtin-type a, nat32
is-nat64 bool(a type)
	is-builtin-type a, nat64
is-void bool(a type)
	is-builtin-type a, void
is-weak-ref bool(a type)
	is-builtin-type a, weak-ref
is-weak-ref bool(a struct-decl)
	is-builtin-type a, weak-ref

as-nat-type nat-type?(a type)
	a.as-builtin-type.?to
as-integral-type integral-type?(a type)
	a.as-builtin-type.?to

-is-builtin-type bool(a type, builtin_ builtin-type)
	a.struct-inst and is-builtin-type a, builtin_
-is-builtin-type bool(a struct-inst, builtin_ builtin-type)
	is-builtin-type a.decl, builtin_
-is-builtin-type bool(a struct-decl, builtin_ builtin-type)
	a.body.builtin-type == builtin_
-as-builtin-type builtin-type?(a type)
	if a.struct-inst
		a.decl.body.builtin-type

array-element-type type?(a type)
	if is-array a
		only a.struct-inst!.type-args
mut-slice-element-type type?(a type)
	if is-mut-slice a
		only a.struct-inst!.type-args
array-or-mut-slice-element-type type?(a type)
	if is-array-or-mut-slice a
		only a.struct-inst!.type-args

try-unwrap-option-type type?(a type)
	if is-bogus a
		a
	else
		unwrap-option a
unwrap-if-option-type type(a type)
	unwrap-option a else a
unwrap-option-or-same type(a type)
	try-unwrap-option-type a else a
unwrap-option type?(a type)
	a.struct-inst.?unwrap-option
unwrap-option type?(a struct-inst)
	if is-option a
		only a.type-args

is-option bool(a type)
	is-builtin-type a, option
is-option bool(a struct-inst)
	is-builtin-type a, option
is-option bool(a struct-decl)
	is-builtin-type a, option

is-lambda-type bool(a type)
	a.struct-inst and is-lambda-type a.decl
is-lambda-type bool(a struct-decl)
	!!(a.body.builtin-type.?to::fun-kind?)

purity-range purity-range(a type)
	match a
	as bogus-type
		data_, data_
	as type-param-index
		data_, mut_
	as struct-inst
		a.purity-range

best-case-purity purity(a type)
	a.purity-range.best-case

signature-container union(spec-decl, struct-decl)
	module-uri uri()
	name symbol()
	type-param-asts type-params()
to type-container(a signature-container)
	match a
	as spec-decl then a
	as struct-decl then a

signature-source union(signature-ast, signature-source-java)
	name symbol()
	name-range source-range()
	range source-range()
signature-source-java record
	name symbol
range source-range(_ signature-source-java)
	()
name-range source-range(_ signature-source-java)
	()

| Function signature without a body. Used in a spec or variant.
signature record force-data
	container signature-container
	source signature-source
	return-type type
	params destructure[]
	doc-comment-references mut doc-comment-references
== bool(a signature, b signature)
	a.range == b.range
to json(a signature)
	a.name.to::json
name symbol(a signature)
	a.source.name
module-uri uri(a signature)
	a.container.module-uri
range uri-and-range(a signature)
	a.module-uri, a.source.range
name-range uri-and-range(a signature)
	a.module-uri, a.source.name-range
doc-comment-ast doc-comment-ast(a signature)
	match source = a.source
	as signature-ast
		source.doc-comment
	as signature-source-java
		()
doc-comment doc-comment(a signature)
	a.doc-comment-ast, a.doc-comment-references
index-of-signature nat(a signature)
	match container = a.container
	as spec-decl
		index-of! container.sigs, a
	as struct-decl
		index-of! container.body.sum-type!.methods, a

type-params-and-sig record
	type-params type-params
	return-type type
	params type[]
	allow-unsafe bool
	allow-summon bool
new type-params-and-sig(type-params type-params, return-type type, params type[])
	type-params, return-type, params, false, false

record-field-source union(single-destructure-ast, record-field-ast)
	doc-comment doc-comment-ast()
	range source-range()
	name-range source-range()
name symbol(a record-field-source)
	match a
	as single-destructure-ast
		a.name.name
	as record-field-ast
		a.name.name

record-field record force-data
	source record-field-source
	containing-record struct-decl
	visibility visibility
	mutability visibility?
	type type
	doc-comment-references mut doc-comment-references
== bool(a record-field, b record-field)
	trusted a 'reference-equal b
to json(a record-field)
	a.name.to::json
module-uri uri(a record-field)
	a.containing-record.module-uri
name symbol(a record-field)
	a.source.name
range uri-and-range(a record-field)
	a.containing-record.module-uri, a.source.range
name-range uri-and-range(a record-field)
	a.module-uri, a.source.name-range
doc-comment-ast doc-comment-ast(a record-field)
	a.source.doc-comment
doc-comment doc-comment(a record-field)
	a.doc-comment-ast, a.doc-comment-references

enum-member-source union(enum-or-flags-member-ast, name-and-range)
	range source-range()
	name symbol()
== bool(a enum-member-source, b enum-member-source)
	a.range == b.range
doc-comment doc-comment-ast(a enum-member-source)
	if a.enum-or-flags-member-ast
		a.doc-comment
name-range source-range(a enum-member-source)
	match a
	as enum-or-flags-member-ast
		a.name-range
	as name-and-range
		a.range

enum-member alias
	enum-or-flags-member
enum-or-flags-member record force-data
	source enum-member-source
	containing-enum struct-decl
	value nat
	doc-comment-references mut doc-comment-references
== bool(a enum-or-flags-member, b enum-or-flags-member)
	a.source == b.source
<=> comparison(a enum-or-flags-member, b enum-or-flags-member)
	a.range <=> b.range
hash void(a enum-or-flags-member, state hash-state)
	hash a.name, state
to json(a enum-or-flags-member)
	a.source.name.to
storage nat-type(a enum-or-flags-member)
	match body = a.containing-enum.body
	as enum_
		body.storage
	as flags_
		body.storage
	else
		throw unreachable
module-uri uri(a enum-or-flags-member)
	a.containing-enum.module-uri
name symbol(a enum-or-flags-member)
	a.source.name
range uri-and-range(a enum-or-flags-member)
	a.containing-enum.module-uri, a.source.range
name-range uri-and-range(a enum-or-flags-member)
	a.module-uri, a.source.name-range
doc-comment-ast doc-comment-ast(a enum-or-flags-member)
	a.source.doc-comment
doc-comment doc-comment(a enum-or-flags-member)
	a.doc-comment-ast, a.doc-comment-references

struct-body union
	struct-body-bogus
	builtin-type
	enum_
	# WARN: This is not the only kind of Java type; A sum-type may also be a Java interface.
	struct-body-extern-java
	flags_
	record_
	sum-type
to json(a struct-body)
struct-body-bogus record
to json(a struct-body-bogus)
enum_ record
	| Inferred type big enough to store all members
	storage nat-type
	| Always sorted by value
	members enum-or-flags-member[]
	members-by-name enum-or-flags-member by-name
to json(a enum_)
	storage: a.storage.to
	members: a.members.to
struct-body-extern-java record(path path)
to json(a struct-body-extern-java)
flags_ record
	| Inferred type big enough to store all members
	storage nat-type
	| Always sorted by value
	members enum-or-flags-member[]
to json(a flags_)
record_ record
	new-visibility visibility
	fields record-field[]
to json(a record_)
| interface, union, or variant
sum-type record
	kind sum-type-kind
	listed-members sum-type-member-and-method-impls[]
	methods signature[]
to json(a sum-type)
as-union sum-type-member-and-method-impls[](a struct-body)
	a.sum-type!.as-union
as-union sum-type-member-and-method-impls[](a sum-type)
	assert a.kind == union_
	a.listed-members

get-all-flags-value nat(body flags_)
	res mut nat = 0
	for member in body.members
		res |:= member.value
	res

builtin-type enum
	array
	bool
	char8
	char32
	float32
	float64
	future
	int8
	int16
	int32
	int64
	js-any
	# TODO: call these 'lambda' (requires changing the name in the struct decl too) -----------------------------------------------
	fun-data
	fun-mut
	fun-shared
	mut-slice
	nat8
	nat16
	nat32
	nat64
	option
	void
	weak-ref
== bool(a builtin-type, b builtin-type)
to json(a builtin-type)
to builtin-type?(a symbol)
is-lambda-type bool(a builtin-type)
	match a
	as fun-data
		true
	as fun-mut
		true
	as fun-shared
		true
	else
		false
is-char-or-integral bool(a builtin-type)
	!!a.to::char-or-integral-type?
is-char-or-integral bool(a type)
	(b = a.as-builtin-type) and b.is-char-or-integral
to char-or-integral-type?(a builtin-type)
	a.to::char-type? or a.to::integral-type?
to char-type?(a builtin-type)
	match a
	as char8
		char8
	as char32
		char32
	else
		()
to float-type?(a builtin-type)
	match a
	as float32
		float32
	as float64
		float64
	else
		()
to nat-type?(a builtin-type)
	match a
	as nat8
		nat8
	as nat16
		nat16
	as nat32
		nat32
	as nat64
		nat64
	else
		()
to int-type?(a builtin-type)
	match a
	as int8
		int8
	as int16
		int16
	as int32
		int32
	as int64
		int64
	else
		()
to integral-type?(a builtin-type)
	match a
	as int8
		int8
	as int16
		int16
	as int32
		int32
	as int64
		int64
	as nat8
		nat8
	as nat16
		nat16
	as nat32
		nat32
	as nat64
		nat64
	else
		()
to fun-kind?(a builtin-type)
	match a
	as fun-data
		data_
	as fun-shared
		shared_
	as fun-mut
		mut_
	else
		()

struct-alias record force-data
	hash nat32 # TODO: USED? ---------------------------------------------------------------------------------------------------------
	ast struct-alias-ast
	module-uri uri
	visibility visibility
	doc-comment-references mut doc-comment-references
	late-target mut struct-inst?
== bool(a struct-alias, b struct-alias)
	trusted a 'reference-equal b
to json(_ struct-alias)
	throw todo
target struct-inst(a struct-alias)
	a.late-target!
set-target void(a struct-alias, value struct-inst)
	forbid a.late-target
	a.late-target := value
doc-comment-ast doc-comment-ast(a struct-alias)
	a.ast.doc-comment
doc-comment doc-comment(a struct-alias)
	a.doc-comment-ast, a.doc-comment-references
name symbol(a struct-alias)
	a.ast.name.name
n-type-params nat(_ struct-alias)
	0
type-param-asts type-params(_ struct-alias)
	()
range uri-and-range(a struct-alias)
	a.module-uri, a.ast.range
name-range uri-and-range(a struct-alias)
	a.module-uri, a.ast.name-range

struct-decl record force-data
	hash nat32
	source struct-decl-source
	module-uri uri # TODO: could get this from the 'source' -------------------------------------------------------------------
	visibility visibility
	n-type-params_ nat8
	| Can only contain 'summon', 'js', 'java'
	late-specs mut specs?
	| Warn: purity on the decl does not take type args into account
	purity purity
	purity-is-forced bool
	doc-comment-references mut doc-comment-references # TODO: this should probably come last ----------------------------------
	sum-type-memberships mut sum-type-membership[]
	body mut struct-body
	-insts mut struct-insts
| For a non-template, this will be its only {struct-inst}
-struct-insts union mut
	struct-inst
	(struct-inst, type-args) object-memoizer
to-json-with-body json(a struct-decl)
	source: a.source.to
	visibility: a.visibility.to
	specs: a.specs.to
	purity: a.purity.to
	purity-is-forced: a.purity-is-forced.to
	doc-comment-references: a.doc-comment-references.to
	sum-type-memberships: a.sum-type-memberships.to
	body: a.body.to
to json(a struct-decl)
	a.name.to::json
only-inst struct-inst(a struct-decl)
	forbid a.is-template
	a.insts.struct-inst!
new struct-decl
	hash nat32
	source struct-decl-source
	module-uri uri
	visibility visibility
	specs specs
	purity purity
	purity-is-forced bool
	doc-comment-references doc-comment-references
	sum-type-memberships sum-type-membership[]
	body struct-body
do
	res struct-decl =
		hash: hash
		source: source
		module-uri: module-uri
		visibility: visibility
		purity: purity
		purity-is-forced: purity-is-forced
		doc-comment-references: doc-comment-references
		sum-type-memberships: sum-type-memberships
		body: body
	res.specs := specs
	res
new struct-decl
	hash nat32
	source struct-decl-source
	module-uri uri
	visibility visibility
	purity purity
	purity-is-forced bool
	doc-comment-references doc-comment-references
	sum-type-memberships sum-type-membership[]
	body struct-body
do
	res struct-decl =
		hash: hash
		source: source
		module-uri: module-uri
		visibility: visibility
		n-type-params_: if can-have-type-params source
			source.type-params.size.to
		late-specs: ()
		purity: purity
		purity-is-forced: purity-is-forced
		doc-comment-references: doc-comment-references
		sum-type-memberships: sum-type-memberships
		body: body
		insts: ()
	res.insts := if res.is-template
		()::((struct-inst, type-args) object-memoizer)
	else
		(res, ())::struct-inst
	res
== bool(a struct-decl, b struct-decl)
	trusted a 'reference-equal b
<=> comparison(a struct-decl, b struct-decl)
	a.range <=> b.range
hash void(a struct-decl, state hash-state)
	hash a.hash, state
doc-comment-ast doc-comment-ast(a struct-decl)
	a.source.doc-comment
doc-comment doc-comment(a struct-decl)
	a.doc-comment-ast, a.doc-comment-references
n-type-params nat(a struct-decl)
	a.n-type-params_.to
type-param-asts type-params(a struct-decl)
	unless a.n-type-params == 0
		a.source.type-params
name symbol(a struct-decl)
	a.source.name
range uri-and-range(a struct-decl)
	a.module-uri, a.source.range
keyword-range uri-and-range(a struct-decl)
	a.module-uri, a.source.keyword-range
name-range uri-and-range(a struct-decl)
	a.module-uri, a.source.name-range
is-template bool(a struct-decl)
	a.n-type-params != 0
| Given a type `foo[t, u], this is the type `(t, u) foo`.
instantiated-with-own-type-params struct-inst(a struct-decl)
	match x = a.insts
	as struct-inst
		x
	as object-memoizer
		a[a.n-type-params.type-params-type-args]

specs specs(a struct-decl)
	a.late-specs!
set-specs void(a struct-decl, value specs)
	forbid a.late-specs
	a.late-specs := value

must-be-enum-or-flags enum-or-flags-member[](a struct-decl)
	match body = a.body
	as enum_
		body.members
	as flags_
		body.members
	else
		throw unreachable

sum-type-member-and-method-impls record force-data
	member struct-inst
	method-impls mut called?[]
to json(a sum-type-member-and-method-impls)

sum-type-membership record force-data
	ast modifier-keyword-ast?
	sum-type struct-inst
	method-impls mut called?[]
to json(a sum-type-membership)
	sum-type: a.sum-type.to
	method-impls: a.method-impls.to
sum-type-body sum-type(a sum-type-membership)
	a.sum-type.decl.body.sum-type!
sum-type-decl-methods signature[](a sum-type-membership)
	a.sum-type-body.methods

struct-decl-source union(struct-decl-ast, struct-decl-source-java, struct-decl-source-bogus)
	type-params type-params()
to json(a struct-decl-source)
	match a
	as struct-decl-ast
		"ast"
	as struct-decl-source-java
		a.to
	as struct-decl-source-bogus
		"bogus"
struct-decl-source-java record(path path, name symbol)
type-params name-and-range[](_ struct-decl-source-java)
	()
struct-decl-source-bogus record(name symbol, type-params type-params)
range source-range(a struct-decl-source)
	match a
	as struct-decl-ast
		a.range
	as struct-decl-source-java
		()
	as struct-decl-source-bogus
		()
name symbol(a struct-decl-source)
	match a
	as struct-decl-ast
		a.name.name
	as struct-decl-source-java
		a.name.to
	as struct-decl-source-bogus
		a.name
doc-comment doc-comment-ast(a struct-decl-source)
	match a
	as struct-decl-ast
		a.doc-comment
	as struct-decl-source-java
		()
	as struct-decl-source-bogus
		()
keyword-range source-range(a struct-decl-source)
	match a
	as struct-decl-ast
		a.keyword-range
	as struct-decl-source-java
		()
	as struct-decl-source-bogus
		()
name-range source-range(a struct-decl-source)
	match a
	as struct-decl-ast
		a.name-range
	as struct-decl-source-java
		()
	as struct-decl-source-bogus
		()
can-have-type-params bool(a struct-decl-source)
	match a
	as struct-decl-ast
		a.can-have-type-params
	as struct-decl-source-java
		true
	as struct-decl-source-bogus
		false
can-have-type-params bool(a struct-decl-ast)
	match a.body
	as builtin-type-ast
		true
	as enum-ast
		false
	as flags-ast
		false
	as record-ast
		true
	as sum-type-ast
		true

struct-inst record(decl struct-decl, type-args type-args) -new
subscript struct-inst(decl struct-decl, type-args type-args)
	match insts = decl.insts
	as struct-inst
		insts
	as object-memoizer
		trusted memoize insts, type-args, of then decl, type-args
memoizer-key type-args(a struct-inst)
	a.type-args
== bool(a struct-inst, b struct-inst)
	trusted a 'reference-equal b
<=> comparison(_ struct-inst, _ struct-inst)
	throw todo
hash nat(a struct-inst)
	get-hash a
hash void(a struct-inst, state hash-state)
	# TODO: just use identity -------------------------------------------------------------------------------------------------------
	hash a.decl, state
	hash a.type-args, state
to json(a struct-inst)
	decl: a.decl.name.to
	type-args: a.type-args.to
purity-range purity-range(a struct-inst)
	res mut purity-range = a.decl.purity, a.decl.purity
	for x in a.type-args
		res combine-purity-range:= x.purity-range
	res

spec-decl-body record # TODO:PERF just store this directly! ----------------------------------------------------------------------------------
	builtin_ builtin-spec?
	parents specs
	sigs signature[]

builtin-spec enum
	data_
	java
	js
	shared_
	summon
	unsafe
== bool(a builtin-spec, b builtin-spec)
to purity?(a builtin-spec)
	match a
	as data_
		data_
	as shared_
		shared_
	else
		()
to symbol(a builtin-spec)
	match a
	as data_
		"data"
	as java
		"java"
	as js
		"js"
	as shared_
		"shared"
	as summon
		"summon"
	as unsafe
		"unsafe"
to builtin-spec?(a symbol)
	match a
	as "data"
		data_
	as java
		java
	as js
		js
	as "shared"
		shared_
	as "summon"
		summon
	as "unsafe"
		unsafe
	else
		()

spec-decl record force-data, -new
	hash nat32
	module-uri uri
	ast spec-decl-ast
	visibility visibility
	doc-comment-references mut doc-comment-references
	late-body mut spec-decl-body?
	insts (spec-inst, type-args) object-memoizer
new spec-decl
	hash nat32
	module-uri uri
	ast spec-decl-ast
	visibility visibility
do
	hash, module-uri, ast, visibility, (), (), ()
== bool(a spec-decl, b spec-decl)
	trusted a 'reference-equal b
<=> comparison(a spec-decl, b spec-decl)
	a.range <=> b.range
hash void(a spec-decl, state hash-state)
	hash a.hash, state
to json(_ spec-decl)
	throw todo
doc-comment-ast doc-comment-ast(a spec-decl)
	a.ast.doc-comment
doc-comment doc-comment(a spec-decl)
	a.doc-comment-ast, a.doc-comment-references
name symbol(a spec-decl)
	a.ast.name.name
n-type-params nat(a spec-decl)
	a.type-param-asts.size
type-param-asts type-params(a spec-decl)
	a.ast.type-params
body-is-set bool(a spec-decl)
	!!a.late-body
body spec-decl-body(a spec-decl)
	a.late-body!
set-body void(a spec-decl, value spec-decl-body)
	forbid a.body-is-set
	a.late-body := value
	assert a.body-is-set
builtin_ builtin-spec?(a spec-decl)
	a.body.builtin_
parents specs(a spec-decl)
	a.body.parents
overwrite-parents-to-empty void(a spec-decl)
	a.late-body := a.builtin_, (), a.sigs
sigs signature[](a spec-decl)
	a.body.sigs
range uri-and-range(a spec-decl)
	a.module-uri, a.ast.range
name-range uri-and-range(a spec-decl)
	a.module-uri, a.ast.name-range

spec-inst record force-data, -new
	decl spec-decl
	type-args type-args
	| This includes builtin parents
	builtin_ mut (builtin-spec, type-args)[]
	| This includes signatures from parents
	all-sigs mut signature[]
	| Corresponds to all-sigs
	sig-types mut return-and-param-types[]
get-or-add-spec-inst (spec-inst, bool)(decl spec-decl, type-args type-args)
	did-add mut bool = false
	- trusted memoize decl.insts, type-args, of
		did-add := true
		decl, type-args, (), (), ()
	- did-add
-memoizer-key type-args(a spec-inst)
	a.type-args
== bool(a spec-inst, b spec-inst)
	trusted a 'reference-equal b
hash void(a spec-inst, state hash-state)
	# TODO: just use identity ------------------------------------------------------------------------------------------------------
	hash a.decl, state
	hash a.type-args, state
to json(a spec-inst)
	decl: a.decl.name.to
	type-args: a.type-args.to

flags-function enum
	intersect
	negate
	| 0-argument 'new' (returning empty flags)
	none
	subscript
	union_
to symbol(a flags-function)
	match a
	as intersect
		"&"
	as negate
		"~"
	as none
		"new"
	as subscript
		"subscript"
	as union_
		"|"
to json(a flags-function)

auto-fun record
	kind auto-fun-kind
	| e.g., '<=>' implementations for each record/union member
	members called[]
to json(a auto-fun)

auto-fun-kind enum
	compare
	equals
	members-of-enum-or-flags
	to-enum-or-flags-option-from-nat
	to-enum-or-flags-option-from-symbol
	to-nat-from-enum-or-flags
	to-symbol-from-enum
	to-symbol-array-from-flags
	to-json
to json(a auto-fun-kind)

fun-body union
	fun-body-uninitialized
	fun-body-bogus
	fun-body-extern-java
	auto-fun
	builtin-fun
	create-enum-or-flags
	create-record
	expr
	expr-with-allocated-locals
	fun-body-file-import
	flags-function
	fun-body-method
	record-field-get
	record-field-set
	sum-type-member-get
	var-get
	var-set
to json(a fun-body)

expr-maybe-allocated-locals union(expr, expr-with-allocated-locals)
	to json()
to fun-body(a expr-maybe-allocated-locals)
	match a
	as expr then a
	as expr-with-allocated-locals then a
allocated-locals struct-inst[local](a expr-maybe-allocated-locals)
	match a
	as expr
		()
	as expr-with-allocated-locals
		a.allocated-locals
expr expr(a expr-maybe-allocated-locals)
	match a
	as expr
		a
	as expr-with-allocated-locals
		a.expr

expr-with-allocated-locals record(expr expr, allocated-locals struct-inst[local])
to json(a expr-with-allocated-locals)
	expr: a.expr.to
	allocated-locals: (for k, v in a.allocated-locals then k.name, v)::struct-inst[symbol].to

fun-body-uninitialized record
to json(a fun-body-uninitialized)
fun-body-bogus record
to json(a fun-body-bogus)
fun-body-extern-java record
	kind java-method-kind
	class_ path
	dummy void
new fun-body-extern-java(kind java-method-kind, class_ path)
	# Interface callers are not 'extern', they are fun-body-method (TODO: maybe improve types to avoid needing an ssertion?)
	forbid kind == interface_
	kind, class_, ()
to json(a fun-body-extern-java)
java-method-kind enum
	static-method-of-class
	static-method-of-interface
	virtual
	interface_
	constructor
	static-field
	instance-field
== bool(a java-method-kind, b java-method-kind)
to json(a java-method-kind)
is-instance bool(a java-method-kind)
	a == virtual or a == interface_
create-enum-or-flags record(member enum-or-flags-member)
to json(a create-enum-or-flags)
create-record record(nominal_ bool)
to json(a create-record)
fun-body-file-import record(type import-file-type, content nat8 array-view)
to json(a fun-body-file-import)
fun-body-method record(method-index nat, method signature) # TODO: is method-index used? -----------------------------------------
to json(a fun-body-method)
	a.method.name.to
record-field-get record(field record-field)
to json(a record-field-get)
	a.field.name.to
record-field-set record(field record-field)
to json(a record-field-set)
	a.field.name.to
sum-type-member-get record
to json(a sum-type-member-get)
var-get record(var var-decl)
to json(a var-get)
	a.var.name.to
var-set record(var var-decl)
to json(a var-set)
	a.var.name.to

js-fun enum
	await
	call
	call-new
	call-property
	call-property-spread
	eq-eq-eq
	eval
	get # TODO: rename to 'subscript' ---------------------------------------------------------------------------------------
	import_
	instanceof
	js-global
	null
	plus
	set # TODO: rename to 'set-subscript' ---------------------------------------------------------------------------------------
	typeof
	undefined
== bool(a js-fun, b js-fun)
to json(a js-fun)

builtin-fun union
	builtin-unary
	builtin-binary
	builtin-ternary
	builtin-fun-call-lambda
	builtin-fun-constant
	builtin-fun-is-empty-type
	builtin-fun-is-target
	js-fun
to json(a builtin-fun)
builtin-fun-call-lambda record
to json(a builtin-fun-call-lambda)
# 'float' works for float32 constants too
builtin-fun-constant union
	bool
	float
	builtin-fun-constant-empty-option
	builtin-fun-constant-gc-safe-value
to json(a builtin-fun-constant)
builtin-fun-constant-empty-option record
to json(a builtin-fun-constant-empty-option)
builtin-fun-constant-gc-safe-value record
to json(a builtin-fun-constant-gc-safe-value)
builtin-fun-is-empty-type record
to json(a builtin-fun-is-empty-type)
builtin-fun-is-target record(target build-target)
to json(a builtin-fun-is-target)

builtin-unary enum
	| works on mut-slice too
	array-size
	bits-of-float32
	bits-of-float64
	bitwise-not
	float32-from-bits
	float64-from-bits
	gc-safe-mut-slice
	not
	reinterpret-cast
	to-float32-from-float64
	to-float64-from-float32
	to-float64-from-int64
	to-float64-from-nat64
	truncate-to-int64-from-float64
	weak-ref-get
	weak-ref-new
	# This includes all conversions from one integral type to another, including char types.
	# When converting from a larger type to a smaller one, higher bits are omitted. For example 257 as a nat8 is 1.
	wrap-convert-integral
== bool(a builtin-unary, b builtin-unary)
to json(a builtin-unary)

builtin-binary enum
	add-float
	array-get
	bitwise-and
	bitwise-or
	bitwise-xor
	compare
	equal-exact
	equal-float-ieee
	less-float-ieee
	mul-float
