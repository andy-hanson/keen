program-with-opt-main record
	program program
	main-fun-and-diagnostics main-fun-and-diagnostics?
has-main bool(a program-with-opt-main)
	!!a.main-fun-and-diagnostics
as-program-with-main program-with-main(a program-with-opt-main)
	a.program, a.main-fun-and-diagnostics!
as-program-with-opt-main program-with-opt-main(a program-with-main)
	a.program, a.main-fun-and-diagnostics
as-program-with-opt-main program-with-opt-main(a program)
	a, ()

main-fun-and-diagnostics record
	main-fun main-fun
	diagnostics uri-and-diagnostic[]

main-fun union(main-fun-nat64-of-args, main-fun-void, test-selector)
main-fun-nat64-of-args record(fun fun-inst)
main-fun-void record(fun fun-inst)

range-for-diag uri-and-range(a main-fun)
	match a
	as main-fun-nat64-of-args
		a.fun.decl.range
	as main-fun-void
		a.fun.decl.range
	as test-selector
		match a
		as test-selector-all
			# We don't get diagnostics for this
			throw unreachable
		as config
			a.config-uri!.top-of-file
		as uri
			a.top-of-file
		as test_
			a.range
can-run-in-target bool(a main-fun, target build-target)
	match a
	as main-fun-nat64-of-args
		specs-allow-target a.fun.decl.specs, target
	as main-fun-void
		specs-allow-target a.fun.decl.specs, target
	as test-selector
		match a
		as test-selector-all
			true
		as config
			true
		as uri
			true
		as test_
			can-include-test a, target

| All tests, tests in a particular config, tests in a single file, or a single test
test-selector union(test-selector-all, config, uri, test_)
test-selector-all record(main-config config)

has-any-diagnostics bool(a program-with-main)
	has-any-diagnostics a.program or !is-empty a.main-fun-diagnostics

program record
	all-configs config[uri]
	# NOTE: Despite the name this does not include java-class-modules ..................................... rename this then .......
	all-modules crow-module[uri] # TODO: the module stores its uri, so this could be a hash-table --------------------------------------------
	java-modules java-class-module[path]
	# Some Java class files are loaded indirectly, so we don't produce a module, just a class type.
	all-java-classes struct-decl[path]
	additional-diagnostics uri-and-diagnostic[]
	file-content-getters file-content-getters
	line-and-column-getters line-and-column-getters
	common-funs common-funs
	common-types common-types
available-types available-types(a program)
	common-types: a.common-types
	json: a.common-funs.json-named-new.return-type.struct-inst!
line-and-character-getters line-and-character-getters(a program)
	a.line-and-column-getters.line-and-character-getters
config-at-uri config(a program, uri uri)
	a.all-configs[uri]!
module-at-uri crow-module(a program, uri uri)
	a.all-modules[uri]!
java-module-at-uri java-class-module(a program, uri uri)
	a.java-modules[uri.as-java-uri!]!
all-uris uri set(a program)
	-- map a.all-configs, it.a
	-- map a.all-modules, it.a
	-- map a.all-java-classes, it.a.to-java-uri
	-- for* _, module in a.all-modules
		module.file-imports-and-exports
all-dependencies uri set[uri](a program)
	map-values a.all-modules, of module
		-- map module.imports-and-re-exports, it.uri
		-- module.file-imports-and-exports

has-any-diagnostics bool(a program)
	exists-diagnostic a, of _ then true
# TODO: define a type with an 'iterate' function -----------------------------------------------------------------------------
each-diagnostic void(a program-with-opt-main, cb void mut(x uri-and-diagnostic))
	res = exists-diagnostic a, of x
		cb[x]
		false
	forbid res
-exists-diagnostic bool(a program-with-opt-main, cb bool mut(x uri-and-diagnostic))
	a.has-main and exists a.as-program-with-main.main-fun-diagnostics, cb or
	exists-diagnostic a.program, cb
exists-diagnostic bool(a program, cb bool mut(x uri-and-diagnostic))
	exists a.additional-diagnostics, cb or
	exists-diagnostic-in-configs a, cb or
	exists-diagnostic-in-modules a, cb
-exists-diagnostic-in-configs bool(a program, cb bool mut(x uri-and-diagnostic))
	exists a.all-configs, of _, config
		exists config.diagnostics, of x
			cb[config.config-uri!, x]
-exists-diagnostic-in-modules bool(a program, cb bool mut(x uri-and-diagnostic))
	exists a.all-modules, of _, module
		exists module.ast.parse-diagnostics, cb[(module.uri, it.range), it.kind] or
		exists module.diagnostics, cb[module.uri, it]

each-test void(a program, target build-target, selector test-selector, cb void mut(x test_))
	match selector
	as test-selector-all
		for _, m in a.all-modules
			for x in m.tests
				if can-include-test x, target
					cb[x]
	as config
		for _, m in a.all-modules
			if m.config == selector
				for x in m.tests
					if can-include-test x, target
						cb[x]
	as uri
		for x in tests module-at-uri a, selector
			if can-include-test x, target
				cb[x]
	as test_
		assert can-include-test selector, target
		cb[selector]

-can-include-test bool(a test_, target build-target)
	specs-allow-target a.specs, target

-specs-allow-target bool(a specs, target build-target)
	every a.all-builtin, of b, _
		match b
		as data_
			throw todo
		as java
			target == java
		as js
			target == js
		as shared_
			throw todo
		as summon
			true
		as unsafe
			true

config record
	| Empty only for {default-config}
	config-uri uri?
	diagnostics diagnostic[]
	line-and-column-getter line-and-column-getter
	include config-import-uris
	extern_ config-extern-uris
== bool(a config, b config)
	a.config-uri == b.config-uri
default-config config()
	(), (), (), (), ()
config-for-diag config(uri uri, diag diag)
	uri, (((), diag),), (), (), ()

config-import-uris alias
	uri[symbol]
config-extern-uris alias
	uri?[symbol]

local-source union(it-scope-ast, catch-ast, name-and-range, single-destructure-ast, local-source-generated)
local-source-generated record(name symbol)

local record force-data
	source local-source
	type type
== bool(a local, b local)
	trusted a 'reference-equal b
<=> comparison(a local, b local)
	a.range <=> b.range
hash void(a local, state hash-state)
	hash a.name, state
to json(a local)
	a.name.to
name symbol(a local)
	match source = a.source
	as catch-ast
		source.name!.name
	as it-scope-ast
		"it"
	as name-and-range
		source.name
	as single-destructure-ast
		source.name.name
	as local-source-generated
		source.name
is-mutable bool(a local)
	source = a.source
	source.single-destructure-ast and source.mut_
local-must-have-name-range source-range(a local)
	match source = a.source
	as catch-ast
		source.name!.range
	as it-scope-ast
		source.first-it.range
	as name-and-range
		source.range
	as single-destructure-ast
		source.name-range
	as local-source-generated
		throw unreachable
-local-must-have-range source-range(a local)
	match source = a.source
	as single-destructure-ast
		source.range
	else
		a.local-must-have-name-range

destructure union(destructure-ignore, local, destructure-split)
to json(a destructure)
destructure-ignore record(source destructure-ignore-source, type type)
to json(a destructure-ignore)
	type: a.type.to
| {struct-decl} only comes up from generated code.
| {void-destructure-ast} is treated as a 'destructure-ignore' in the model since it behaves the same as '_ void'.
destructure-ignore-source union(catch-ast, struct-decl, ignore-destructure-ast, void-destructure-ast)
destructure-split record
	| This will be the type attempted to destructure.
	| If it can't be destructured, each of 'parts' will have a bogus type.
	destructured-type type
	parts destructure[]
to json(a destructure-split)
is-valid-destructure bool(a destructure-split, common-types common-types)
	(types = as-tuple common-types, a.destructured-type) and types.size == a.parts.size

simple-destructure union(destructure-ignore, local)
	type type()
to json(a simple-destructure)
to destructure(a simple-destructure)
	match a
	as destructure-ignore then a
	as local then a

name symbol?(a destructure)
	match a
	as destructure-ignore
		()
	as local
		a.name
	as destructure-split
		()
range source-range(a destructure)
	match a
	as destructure-ignore
		match source = a.source
		as catch-ast
			()
		as struct-decl
			()
		as ignore-destructure-ast
			source.range
		as void-destructure-ast
			source.range
	as local
		a.local-must-have-range
	as destructure-split
		a.parts[0].start, a.parts[end - 1].end
start pos(a destructure)
	a.range.start
end pos(a destructure)
	a.range.end
type type(a destructure)
	match a
	as destructure-ignore
		a.type
	as local
		a.type
	as destructure-split
		a.destructured-type
locals record(destructure destructure)
iterate bool(a locals, f bool mut(x local))
	match d = a.destructure
	as destructure-ignore
		()
	as local
		f[d]
	as destructure-split
		iterate d.parts, of part
			iterate part.locals, f

doc-comment record
	ast doc-comment-ast
	references doc-comment-references
is-empty bool(a doc-comment)
	a.ast.is-empty

doc-comment-reference union
	doc-comment-reference-bogus
	called-spec-sig
	enum-or-flags-member
	fun-decl
	local
	record-field
	signature
	struct-alias
	struct-decl
	spec-decl
	type-param-index
	var-decl
to json(a doc-comment-reference)
doc-comment-reference-bogus record
to json(a doc-comment-reference-bogus)
doc-comment-references alias # TODO: this is silly, just write doc-comment-reference[] directly -------------------------------
	doc-comment-reference[]
name symbol?(a doc-comment-reference)
	match a
	as doc-comment-reference-bogus
		()
	as called-spec-sig
		a.name
	as enum-or-flags-member
		a.name
	as fun-decl
		a.name
	as local
		a.name
	as record-field
		a.name
	as signature
		a.name
	as struct-alias
		a.name
	as struct-decl
		a.name
	as spec-decl
		a.name
	as type-param-index
		()
	as var-decl
		a.name
uri uri?(a doc-comment-reference)
	match a
	as doc-comment-reference-bogus
		()
	as called-spec-sig
		a.containing-spec.module-uri
	as enum-or-flags-member
		a.containing-enum.module-uri
	as fun-decl
		a.module-uri
	as local
		()
	as record-field
		a.containing-record.module-uri
	as signature
		a.container.module-uri
	as struct-alias
		a.module-uri
	as struct-decl
		a.module-uri
	as spec-decl
		a.module-uri
	as type-param-index
		()
	as var-decl
		a.module-uri

expr union
	assert-or-forbid-expr
	bogus-call-expr
	bogus-expr
	bogus-wrong-type-expr
	call-expr
	call-named-new-expr
	call-option-expr
	finally-expr
	force-expr
	if-expr
	lambda-expr
	let-expr
	list-expr
	literal-scalar-expr
	literal-string-like-expr
	local-get-expr
	local-get-and-refine-expr
	local-set-expr
	logical-expr
	loop-expr
	loop-break-expr
	loop-continue-expr
	loop-while-or-until-expr
	match-enum-expr
	match-scalar-expr
	match-string-like-expr
	match-sum-type-expr
	not-expr
	seq-expr
	throw-expr
	trusted-expr
	try-expr
	try-let-expr
	typed-expr
	unpack-option
do
	range source-range()
to json(a expr)
start pos(a expr)
	a.range.start
end pos(a expr)
	a.range.end

available-types record # TODO: better name ----------------------------------------------------------------------------------------------------------
	common-types common-types
	json struct-inst?
-type-not-common type(a expr)
	type a, ()
type type(a expr, types available-types?)
	common-types = types.?common-types
	match a
	as assert-or-forbid-expr
		if after = a.after
			type after, types
		else
			common-types!.void
	as bogus-call-expr
		type a
	as bogus-expr
		type a
	as bogus-wrong-type-expr
		type a
	as call-expr
		type a
	as call-named-new-expr
		type a
	as call-option-expr
		type a
	as finally-expr
		type a, types
	as force-expr
		type a, types
	as if-expr
		type a, types
	as lambda-expr
		type a
	as let-expr
		type a, types
	as list-expr
		a.type
	as literal-scalar-expr
		type a, types
	as literal-string-like-expr
		type a, types
	as local-get-expr
		type a
	as local-get-and-refine-expr
		type a
	as local-set-expr
		common-types!.void
	as logical-expr
		type a
	as loop-expr
		type a
	as loop-break-expr
		type a.loop_
	as loop-continue-expr
		type a.loop_
	as loop-while-or-until-expr
		if after = a.after
			type after, types
		else
			common-types!.void
	as match-enum-expr
		type a
	as match-scalar-expr
		type a
	as match-string-like-expr
		type a
	as match-sum-type-expr
		type a
	as not-expr
		common-types!.bool
	as seq-expr
		type a, types
	as throw-expr
		type a
	as trusted-expr
		type a, types
	as try-expr
		type a
	as try-let-expr
		type a
	as typed-expr
		type a
	as unpack-option
		common-types!.bool

condition-destructures-and-refinements record(expr expr)
local-refinement record(local local, refined-type type)
local-or-refinement union(local, local-refinement)
condition-has-locals bool(a expr)
	exists a.condition-destructures-and-refinements, !!it.local
iterate bool(a condition-destructures-and-refinements, f bool mut(x local-or-refinement))
	match expr = a.expr
	as call-expr
		if x = as-call-sum-type-member-get-on-local expr
			f[x]
	as local-get-expr
		local = expr.local
		if !is-mutable local and inner = local.type.unwrap-option
			f[local, inner]
	as logical-expr
		if expr.kind == bool-and-bool
			iterate expr.left.condition-destructures-and-refinements, f or
			iterate expr.right.condition-destructures-and-refinements, f
	as unpack-option
		iterate expr.destructure.locals, f[it]
	else
		()

as-call-sum-type-member-get-on-local local-refinement?(a call-expr)
	guard local-get = a.args.opt-only.?local-get-expr
	guard case-type = a.called.as-sum-type-member-get
	local-get.local, case-type
-as-sum-type-member-get type?(a called)
	guard a.fun-inst
	guard a.decl.body.sum-type-member-get
	a.return-type.unwrap-option!

assert-or-forbid-expr record
	ast assert-or-forbid-ast
	is-forbid bool
	condition expr
	thrown expr?
	after expr?
to json(a assert-or-forbid-expr)
range source-range(a assert-or-forbid-expr)
	a.ast.range
default-assert-or-forbid-message string
	cur-uri uri
	a assert-or-forbid-expr
	available-types available-types
	content file-content-getters
do
	prefix string, range source-range = match cond = a.condition
	as unpack-option
		- assert-or-forbid-option-message a.is-forbid
		- cond.option.range
	else
		- if is-option type cond, available-types
			assert-or-forbid-option-message a.is-forbid
		else
			if a.is-forbid then "Forbidden expression is true: " else "Asserted expression is false: "
		- a.condition.range
	prefix ~~ content[cur-uri, range].to
-assert-or-forbid-option-message string(is-forbid bool)
	if is-forbid then "Forbidden option is non-empty: " else "Asserted option is empty: "

bogus-expr record(range source-range, type type)
to json(a bogus-expr)

| Wraps an expression that has an invalid type.
bogus-wrong-type-expr record(inner expr, type type)
to json(a bogus-wrong-type-expr)
range source-range(a bogus-wrong-type-expr)
	a.inner.range

call-expr-source union
	assignment-ast
	assignment-call-ast
	call-ast
	call-named-ast
	for-or-with-ast
	if-ast
	interpolated-ast
	interpolated-template-part
	list-ast
	literal-string-ast
	logical-ast
	loop-break-ast
	loop-continue-ast
	name-and-range
	var-decl-ast
	typed-ast
do
	range source-range()
to json(_ call-expr-source)
	null # ------------------------------------------------------------------------------------------------------------------------
name-range source-range(a call-expr-source)
	match a
	as assignment-ast
		a.left.range
	as assignment-call-ast
		a.fun-name.range
	as call-ast
		a.name-range
	as call-named-ast
		a.range
	as for-or-with-ast
		a.keyword-range
	as if-ast
		a.first-keyword-range
	as interpolated-ast
		a.range
	as interpolated-template-part
		a.range
	as list-ast
		a.first-keyword-range
	as literal-string-ast
		a.range
	as logical-ast
		a.keyword-range
	as loop-break-ast
		a.range
	as loop-continue-ast
		a.range
	as name-and-range
		a.range
	as var-decl-ast
		a.name-range
	as typed-ast
		a.keyword-range

bogus-call-expr record
	ast call-expr-source
	candidates called-decl[]
	| Note: It may have given up on checking arguments.
	checked-args expr[]
	type type
to json(a bogus-call-expr)
range source-range(a bogus-call-expr)
	a.ast.range

call-expr record(ast call-expr-source, called called, args expr[])
to json(a call-expr)
range source-range(a call-expr)
	a.ast.range
type type(a call-expr)
	a.called.return-type

| This is for a call to 'named-new' where it provides symbols and args.
| Calls matching parameter names will use {call-expr}.
call-named-new-expr record(ast call-named-ast, called called, args expr[])
to json(a call-named-new-expr)
	called: a.called.to
	args: a.args.to
range source-range(a call-named-new-expr)
	a.ast.range
type type(a call-named-new-expr)
	a.called.return-type
names symbol[](a call-named-new-expr)
	for* x in a.ast.names
		-- from-option x.name

| Expression for 'x ?foo' or 'x.?foo' or 'x?[y]'
call-option-expr record
	ast call-ast
	| May or may not return an option. If not it will be wrapped after calling.
	called called
	| The first arg is an option which is unwrapped before calling. The rest are non-optional.
	all-args expr[]
	| This is the final type, meaining it is void or an option type.
	type type
to json(a call-option-expr)
range source-range(a call-option-expr)
	a.ast.range
first-arg expr(a call-option-expr)
	a.all-args[0]
rest-args expr array-view(a call-option-expr)
	a.all-args[1 .. end]

finally-expr record(ast finally-ast, right expr, below expr)
to json(a finally-expr)
range source-range(a finally-expr)
	a.ast.range
type type(a finally-expr, types available-types?)
	type a.below, types

force-expr record(ast force-ast, arg expr)
to json(a force-expr)
range source-range(a force-expr)
	a.ast.range
type type(a force-expr, types available-types?)
	try-unwrap-option-type! type a.arg, types

if-expr record
	ast if-ast
	condition expr
	true-branch expr
	false-branch expr
	type type
to json(a if-expr)
range source-range(a if-expr)
	a.ast.range
first-branch expr(a if-expr)
	if a.ast.is-condition-negated then a.false-branch else a.true-branch
second-branch expr(a if-expr)
	if a.ast.is-condition-negated then a.true-branch else a.false-branch
type type(a if-expr, _ available-types?)
	type a

lambda-source union(for-or-with-ast, it-scope-ast, lambda-ast)
	range source-range()
param destructure-ast?(a lambda-source)
	match a
	as for-or-with-ast
		a.param
	as it-scope-ast
		()
	as lambda-ast
		a.param

lambda-expr record
	ast lambda-source
	kind lambda-kind
	param destructure
	mut-type-for-explicit-shared struct-inst?
	body expr
	closure local[]
	type struct-inst
to json(a lambda-expr)
	kind: a.kind.to
	param: a.param.to
	body: a.body.to
	closure: a.closure.to
	type: a.type.to
lambda-kind enum(data_, shared_, mut_, explicit-shared)
== bool(a lambda-kind, b lambda-kind)
to json(a lambda-kind)
range source-range(a lambda-expr)
	a.ast.range
return-type type(a lambda-expr)
	a.type.type-args[0]
| We don't know whether this lambda is for the main body or for the optional 'else'.
| But if it is from the 'else', this function will return true.
is-ignore bool(a lambda-expr)
	param = a.param
	param.destructure-ignore and param.source.void-destructure-ast

let-expr-source union(let-ast, match-ast)
let-expr record(ast let-expr-source, destructure destructure, value expr, then_ expr?)
to json(a let-expr)
	destructure: a.destructure.to
	value: a.value.to
	then: a.then_.to
destructure-ast destructure-ast(a let-expr)
	match ast = a.ast
	as let-ast
		ast.destructure
	as match-ast
		ast.local!
range source-range(a let-expr)
	a.destructure.start, (a.then_ else a.value).end
type type(a let-expr, types available-types?)
	if then_ = a.then_
		type then_, types
	else
		types!.common-types.void

list-expr record
	ast list-expr-source
	| Takes a single array parameter
	called called
	parts list-expr-part[]
list-expr-source union(if-ast, interpolated-ast, list-ast, literal-string-ast)
	range source-range()
to call-expr-source(a list-expr-source)
	match a
	as if-ast
		a
	as interpolated-ast
		a
	as list-ast
		a
	as literal-string-ast
		a
range source-range(a list-expr)
	a.ast.range
to json(a list-expr)
	range: a.range.to
	called: a.called.to
	parts: a.parts.to
type type(a list-expr)
	a.called.return-type
array-type type(a list-expr)
	only a.called.param-types
list-expr-part union(expr, list-expr-part-multi)
to json(a list-expr-part)
	match a
	as expr
		single: a.to
	as list-expr-part-multi
		multi: a.arg.to
list-expr-part-multi record(arg expr)
arg expr(a list-expr-part)
	match a
	as expr
		a
	as list-expr-part-multi
		a.arg

scalar-value record
	-bits nat64
to json(a scalar-value)
== bool(a scalar-value, b scalar-value)
<=> comparison(a scalar-value, b scalar-value)
	a.bits <=> b.bits
hash void(a scalar-value, state hash-state)
	hash a.bits, state
to scalar-value(a bool)
	a.to,
to bool(a scalar-value)
	match a.to::nat64
	as 0
		false
	as 1
		true
	else
		throw unreachable
to scalar-value(a nat8)
	a.to,
to scalar-value(a char8)
	a.to,
to scalar-value(a char32)
	a.to,
to char32(a scalar-value)
	a.to::nat64.to::nat32.to
to scalar-value(a int64)
	a.wrap-to,
to int64(a scalar-value)
	a.bits.wrap-to
to scalar-value(a nat64)
	a,
to nat8(a scalar-value)
	a.to::nat64.to
to nat64(a scalar-value)
	a.bits
to scalar-value(a float64)
	a.bits-of,
to float64(a scalar-value)
	from-bits a.bits

scalar-values record
	-bits nat64[]
subscript scalar-value(a scalar-values, index nat)
	a.bits[index].to
== bool(a scalar-values, b scalar-values)
	a.bits == b.bits
to json(a scalar-values)
	a.bits.to
size nat(a scalar-values)
	a.bits.size
iterate bool(a scalar-values, f bool mut(x scalar-value))
	iterate a.bits, f[it.to]
to scalar-values(values nat[])
	bits: values
to scalar-values(values scalar-value[])
	bits: map values, it.to
is-range bool(a scalar-values)
	every a.with-index, of i, x
		i == x.to

literal-scalar-expr record
	range source-range
	type char-or-integral-or-float-type
	value scalar-value
to json(a literal-scalar-expr)
type struct-inst(a literal-scalar-expr, types available-types?) # TODO: INLINE? -------------------------------------------------------------------
	match type = a.type
	as char-type
		types!.common-types[type]
	as integral-type
		types!.common-types[type]
	as float-type-or-js-or-json
		types![type]

literal-string-like-expr record
	range source-range
	string-type string-like-type
	| For char32-array, this will be decoded in concretize.
	value string
to json(a literal-string-like-expr)
string-like-type enum(char8-array, char32-array, java-String, js-any, string, symbol, json)
== bool(a string-like-type, b string-like-type)
to json(a string-like-type)
type struct-inst(a literal-string-like-expr, types available-types?)
	types![a.string-type]

as-local-get local?(a expr)
	match a
	as local-get-expr
		a.local
	as local-get-and-refine-expr
		a.local
	else
		()

local-get-expr record
	ast local-get-source
	local local
local-get-source union(it-ast, name-and-range)
	range source-range()
to json(a local-get-expr)
	local: a.local.name.to
range source-range(a local-get-expr)
	a.ast.range
type type(a local-get-expr)
	a.local.type

local-get-and-refine-expr record
	ast name-and-range
	local local
	| This is an array since the type may be refined through nested 'match'es.
	type-refinements type[]
to json(a local-get-and-refine-expr)
range source-range(a local-get-and-refine-expr)
	a.ast.range
type type(a local-get-and-refine-expr)
	a.type-refinements[end - 1]

local-set-expr record(assignee-ast name-and-range, local local, value expr)
to json(a local-set-expr)
range source-range(a local-set-expr)
	a.assignee-ast.start, a.value.end

logical-expr record
