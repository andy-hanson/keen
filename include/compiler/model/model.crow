to json(a match-sum-type-expr)
	matched: a.matched.to
	cases: a.cases.to
	else: a.else_.to
match-sum-type-case record(case-type struct-inst, then_ expr)
to json(a match-sum-type-case)
range source-range(a match-sum-type-expr)
	a.ast.range
sum-type struct-inst(a match-sum-type-expr)
	a.matched.type-not-common.struct-inst!
sum-type-body sum-type(a match-sum-type-expr)
	a.sum-type.decl.body.sum-type!

not-expr record(ast not-ast, arg expr)
to json(a not-expr)
range source-range(a not-expr)
	a.ast.range
keyword-range source-range(a not-expr)
	a.ast.keyword-range

seq-expr record(first expr, then_ expr)
to json(a seq-expr)
range source-range(a seq-expr)
	a.first.start, a.then_.end
type type(a seq-expr, types available-types?)
	type a.then_, types

throw-expr record(ast throw-ast, thrown expr, type type)
to json(a throw-expr)
	thrown: a.thrown.to
	type: a.type.to
range source-range(a throw-expr)
	a.ast.range

trusted-expr record(ast trusted-ast, inner expr)
to json(a trusted-expr)
	inner: a.inner.to
range source-range(a trusted-expr)
	a.ast.range
type type(a trusted-expr, types available-types?)
