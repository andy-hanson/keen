diag-auto-fun-wrong-param-type record
diag-auto-fun-wrong-return-type record(kind auto-fun-name)
diag-builtin-fun-cant-have-body record
diag-builtin-unsupported record(kind diag-builtin-unsupported-kind, name symbol)
diag-builtin-unsupported-kind enum(function_, spec_, type)
diag-call-missing-extern record(callee fun-decl, missing-extern symbol) mut
| Note: this error is issued *before* resolving specs.
| We don't exclude a candidate based on not having specs.
diag-call-multiple-matches record mut
	fun-name symbol
	type-container type-container
	| Unlike {diag-call-no-match}, these are only the ones that match 
	matches called-decl[]
diag-call-no-match record mut
	type-container type-container
	fun-name symbol
	expected-return-type expected-for-diag
	| 0 for inferred type args.
	| This is the unpacked tuple, actualNTypeArgs > 1 may match candidates with 1 type arg.
	actual-n-type-args nat
	actual-arity nat
	| NOTE: we may have given up early and this may not be as much as actualArity
	actual-arg-types type[]
	| All candidates, including those with wrong arity
	all-candidates called-decl[]
diag-call-should-use-syntax record(arity nat, kind diag-call-should-use-syntax-kind)
diag-call-should-use-syntax-kind enum
	for-break
	force
	for-loop
	new_
	not
	set-subscript
	subscript
	with-block
diag-cant-call record(reason diag-cant-call-reason, callee fun-decl) mut
diag-cant-call-reason enum
	non-bare
	summon_
	summon-in-data-lambda
	unsafe_
	variadic-from-bare
diag-case-duplicate record(member struct-decl, sum-type struct-decl) mut
diag-case-invalid-sum-type record(member struct-decl, actual type) mut
diag-case-missing-type record
diag-case-type-is-template record(case-type struct-decl) mut
diag-char-literal-must-be-one-char record
diag-common-fun-duplicate record(name symbol)
diag-common-fun-missing record(dummy-for-context fun-decl, sig-choices type-params-and-sig[]) mut
diag-common-type-missing record(name symbol)
diag-common-var-missing record(var-kind var-kind, name symbol)
diag-destructure-type-mismatch record mut
	expected destructure-expected-type
	actual type-with-container
