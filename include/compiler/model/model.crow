char-type enum(char8, char32)
float-type enum(float32, float64)
integral-type enum(int8, int16, int32, int64, nat8, nat16, nat32, nat64)
to nat32(a integral-type)
to symbol(a integral-type)
members integral-type[]()
to integral-type?(a builtin-type)
	match a
	as int8
		int8,
	as int16
		int16,
	as int32
		int32,
	as int64
		int64,
	as nat8
		nat8,
	as nat16
		nat16,
	as nat32
		nat32,
	as nat64
		nat64,
	else
		()
is-signed bool(a integral-type)
	match a
	as int8
		true
	as int16
		true
	as int32
		true
	as int64
		true
	as nat8
