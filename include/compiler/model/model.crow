program-with-main record(program program, main-fun-and-diagnostics main-fun-and-diagnostics)
main-fun main-fun(a program-with-main)
	a.main-fun-and-diagnostics main-fun
main-fun-diagnostics uri-and-diagnostic[](a program-with-main)
	a.main-fun-and-diagnostics diagnostics
main-config config(a program-with-main)
	a.main-fun main-config a.program
test-selector test-selector(a program-with-main)
	a.main-fun test-selector a.program

| All 'extern's to compile with for the given target
all-externs symbol-set(program program-with-main, target build-target)
	program.main-config all-externs-for-main-config target
all-externs-for-main-config symbol-set(main-config config, target build-target?) # TODO: does target need to be optional?????
	with out : build
		out ~~= target?.default-symbol-set ?? ()
		for name, uri : main-config extern_
			if _ ?= uri
				out ~= name
-default-symbol-set symbol-set(target build-target)
	match target
	as java
		"java",
	as node-js
		"js", "node-js"
	as web
		"js", "browser"

program-with-opt-main record
	program program
	main-fun-and-diagnostics main-fun-and-diagnostics?
has-main bool(a program-with-opt-main)
	a.main-fun-and-diagnostics !is-empty
as-program-with-main program-with-main(a program-with-opt-main)
	a.program, a.main-fun-and-diagnostics!
as-program program(a program-with-opt-main)
	a program
as-program-with-opt-main program-with-opt-main(a program-with-main)
	a.program, a.main-fun-and-diagnostics
as-program-with-opt-main program-with-opt-main(a program)
	a, ()

main-fun-and-diagnostics record
	main-fun main-fun
	diagnostics uri-and-diagnostic[]

main-fun union(main-fun-nat64-of-args, main-fun-void, test-selector)
main-fun-nat64-of-args record(fun fun-inst)
main-fun-void record(fun fun-inst)

range-for-diag uri-and-range(a main-fun)
	match a
	as main-fun-nat64-of-args x
		x.fun.decl range
	as main-fun-void x
		x.fun.decl range
	as test-selector test_
		match test_
		as test-selector-all _
			# We don't get diagnostics for this
			throw unreachable
		as config x
			x.config-uri! top-of-file
		as uri x
			x top-of-file
		as test_ x
			x range
uri-for-temp-path uri?(a main-fun)
	match a
	as main-fun-nat64-of-args x
		x.fun.decl module-uri
	as main-fun-void x
		x.fun.decl module-uri
	as test-selector test_
		match test_
		as test-selector-all _
			()
		as config x
			x config-uri!
		as uri x
			x
		as test_ x
			x module-uri
required-externs symbol-set(a main-fun)
	match a
	as main-fun-nat64-of-args x
		x.fun.decl externs
	as main-fun-void x
		x.fun.decl externs
	as test-selector s
		match s
		as test-selector-all _
			()
		as config _
			()
		as uri _
			()
		as test_ x
			x externs
main-config config(a main-fun, program program)
	config-for config mut(uri uri) = uri =>
		program module-at-uri uri config
	match a
	as main-fun-nat64-of-args x
		config-for[x.fun.decl module-uri]
	as main-fun-void x
		config-for[x.fun.decl module-uri]
	as test-selector test_
		match test_
		as test-selector-all x
			x main-config
		as config x
			x
		as uri x
			config-for[x]
		as test_ x
			config-for[x module-uri]
test-selector test-selector(a main-fun, program program)
	match a
	as main-fun-nat64-of-args _
		a main-config program test-selector-all
	as main-fun-void _
		a main-config program test-selector-all
	as test-selector x
		x

| All tests, tests in a particular config, tests in a single file, or a single test
test-selector union(test-selector-all, config, uri, test_)
test-selector-all record(main-config config)

has-any-diagnostics bool(a program-with-main)
	a.program has-any-diagnostics || a.main-fun-diagnostics !is-empty

program record
	all-configs config[uri]
	all-modules crow-module[uri] # TODO: the module stores its uri, so this could be a hash-table --------------------------------------------
	file-content-getters file-content-getters
	line-and-column-getters line-and-column-getters
	common-funs-and-diagnostics common-funs-and-diagnostics
	common-types common-types
	other-types other-types
line-and-character-getters line-and-character-getters(a program)
	a.line-and-column-getters line-and-character-getters
common-funs common-funs(a program)
	a.common-funs-and-diagnostics common-funs
config-at-uri config(a program, uri uri)
	a.all-configs[uri]!
module-at-uri crow-module(a program, uri uri)
	a.all-modules[uri]!

has-any-diagnostics bool(a program)
	a exists-diagnostic _ => true
| Iterates in no particular order
each-diagnostic void(a program-with-opt-main, cb void mut(x uri-and-diagnostic))
	res = a exists-diagnostic x =>
		cb[x]
		false
	forbid res
-exists-diagnostic bool(a program-with-opt-main, cb bool mut(x uri-and-diagnostic))
	(a.has-main && a.as-program-with-main.main-fun-diagnostics exists cb) ||
	a.program exists-diagnostic cb
exists-diagnostic bool(a program, cb bool mut(x uri-and-diagnostic))
	a.common-funs-and-diagnostics.diagnostics exists cb ||
	a exists-diagnostic-in-configs cb ||
	a exists-diagnostic-in-modules cb
-exists-diagnostic-in-configs bool(a program, cb bool mut(x uri-and-diagnostic))
	a.all-configs exists (_, config) =>
		config.diagnostics exists x =>
			cb[config.config-uri!, x]
-exists-diagnostic-in-modules bool(a program, cb bool mut(x uri-and-diagnostic))
	a.all-modules exists (_, module) =>
		in-ast = module.ast.parse-diagnostics exists x =>
			cb[(module.uri, x.range), x.kind]
		in-ast || module.diagnostics exists x =>
			cb[module.uri, x]

each-test void(a program, all-externs symbol-set, selector test-selector, cb void mut(x test_))
	match selector
	as test-selector-all _
		for _, m : a all-modules
			for x : m tests
				if x.externs is-subset-of all-externs
					cb[x]
	as config config
		for _, m : a all-modules
			if m.config == config
				for x : m tests
					if x.externs is-subset-of all-externs
						cb[x]
	as uri uri
		for x : a module-at-uri uri tests
			if x.externs is-subset-of all-externs
				cb[x]
	as test_ x
		assert x.externs is-subset-of all-externs
		cb[x]

config record
	config-uri uri?
	diagnostics diagnostic[]
	include config-import-uris
	extern_ config-extern-uris
get-config-uri uri(a config)
	a config-uri!
== bool(a config, b config)
	a.config-uri == b.config-uri
new config()
	(), (), (), ()
config-for-diag config(uri uri, diag diag)
	uri, (((), diag),), (), ()

config-import-uris alias
	uri[symbol]
config-extern-uris alias
	uri?[symbol]

local-source union(single-destructure-ast, local-source-generated)
local-source-generated record(name symbol)

local record force-data
	source local-source
	mutability mutability # TODO: just use a bool --------------------------------------------------------------------------------
	is-read mut bool
	is-written mut bool
	is-used-in-closure mut bool
	# This stores a 'reference' to the local's type, if it needs to be referenced mutably in some closure
	closure-reference-type mut struct-inst?
	type type
new local(source local-source, mutability mutability, type type)
	source, mutability, false, false, false, (), type
== bool(a local, b local)
	trusted a reference-equal b
<=> comparison(_ local, _ local)
	throw todo
hash-mix void(hasher hasher, a local)
	hasher hash-mix a.name
to json(a local)
	a.name to
name symbol(a local)
	match a source
	as single-destructure-ast x
		x.name name
	as local-source-generated x
		x name
is-mutable bool(a local)
	a.mutability == mut_
local-must-have-name-range source-range(a local)
	a.source.single-destructure-ast! name-range
-local-must-have-range source-range(a local)
	a.source.single-destructure-ast! range

mutability enum(immut, mut_) nat8 storage
== bool(a mutability, b mutability)

destructure union(destructure-ignore, local, destructure-split)
to json(a destructure)
| This can come from '_' or '()' (which is the same as '_ void')
# TODO: isn't 'pos' redundant to the source? ------------------------------------------------------------------------------------
destructure-ignore record(source destructure-ignore-source, pos pos, type type)
to json(a destructure-ignore)
	("pos", a.pos.to), ("type", a.type.to)
destructure-ignore-source union(case-member-ast, struct-decl, single-destructure-ast, void-destructure-ast)
destructure-split record
	| This will be the type attempted to destructure.
	| If it can't be destructured, each of 'parts' will have a bogus type.
	destructured-type type
	parts destructure[]
to json(a destructure-split)
is-valid-destructure bool(a destructure-split, common-types common-types)
	if types ?= common-types as-tuple a.destructured-type
		types.size == a.parts.size

name symbol?(a destructure)
	match a
	as destructure-ignore _
		()
	as local x
		x name
	as destructure-split _
		()
range source-range(a destructure)
	match a
	as destructure-ignore x
		x.pos range-of-start-and-length "_"
	as local x
		x local-must-have-range
	as destructure-split x
		x.parts[0].range combine-ranges x.parts[end - 1].range
start pos(a destructure)
	a.range start
end pos(a destructure)
	a.range end
type type(a destructure)
	match a
	as destructure-ignore x
		x type
	as local x
		x type
	as destructure-split x
		x destructured-type
each-local void(a destructure, cb void mut(x local))
	res bool? = a first-local x =>
		cb[x]
		()
	assert res is-empty
first-local[out] out?(a destructure, cb out? mut(x local))
	match a
	as destructure-ignore _
		()
	as local x
		cb[x]
	as destructure-split x
		for part : x.parts
			if res ?= part first-local cb
				break res

doc-comment record
	ast doc-comment-ast
	references doc-comment-references
is-empty bool(a doc-comment)
	a.ast is-empty

doc-comment-reference union
	doc-comment-reference-bogus
	called-spec-sig
	enum-or-flags-member
	fun-decl
	local
	record-field
	signature
	struct-alias
	struct-decl
	spec-decl
	type-param-index
	var-decl
doc-comment-reference-bogus record
doc-comment-references alias
	doc-comment-reference[]
name symbol?(a doc-comment-reference)
	match a
	as doc-comment-reference-bogus _
		()
	as called-spec-sig x
		x name
	as enum-or-flags-member x
		x name
	as fun-decl x
		x name
	as local x
		x name
	as record-field x
		x name
	as signature x
		x name
	as struct-alias x
		x name
	as struct-decl x
		x name
	as spec-decl x
		x name
	as type-param-index _
		()
	as var-decl x
		x name
uri uri?(a doc-comment-reference)
	match a
	as doc-comment-reference-bogus _
		()
	as called-spec-sig x
		x.containing-spec module-uri
	as enum-or-flags-member x
		x.containing-enum module-uri
	as fun-decl x
		x module-uri
	as local _
		()
	as record-field x
		x.containing-record module-uri
	as signature x
		x.container module-uri
	as struct-alias x
		x module-uri
	as struct-decl x
		x module-uri
	as spec-decl x
		x module-uri
	as type-param-index _
		()
	as var-decl x
		x module-uri

expr union
	assert-or-forbid-expr
	bogus-call-expr
	bogus-expr
	bogus-wrong-type-expr
	call-expr
