struct-inst record(decl struct-decl, type-args type-args) -new
subscript struct-inst(decl struct-decl, type-arg type)
	decl[type-arg.to::type-args]
subscript struct-inst(decl struct-decl, type-args type[])
	decl[type-args.to::type-args]
subscript struct-inst(decl struct-decl, type-args type-args)
	if type-args is-empty
		decl instantiated-with-own-type-params
	else
		trusted decl.insts! memoize type-args, () => decl, type-args
memoizer-key type-args(a struct-inst)
	a type-args
== bool(a struct-inst, b struct-inst)
	trusted a reference-equal b
<=> comparison(_ struct-inst, _ struct-inst)
	throw todo
hash-mix void(hasher hasher, a struct-inst)
	# TODO: just use identity -------------------------------------------------------------------------------------------------------
	hasher hash-mix a.decl
	hasher hash-mix a.type-args
to json(a struct-inst)
	("decl", a.decl.name.to), ("type-args", a.type-args.to)
purity-range purity-range(a struct-inst)
	res mut purity-range = a.decl.purity, a.decl.purity
	for x : a.type-args inner
		res combine-purity-range:= x purity-range
	res

