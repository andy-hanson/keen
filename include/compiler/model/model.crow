fun-flags flags nat8 storage
	summon_
	trusted_
	unsafe_
	ok-if-unused # TODO: We could determine this from the fun-body. Only Generated funs are OK to not use. ---------------------------------------------------------------------
new fun-flags(is-summon bool, safety fun-safety, is-ok-if-unused bool)
	res mut fun-flags = ()
	if is-summon
		res |:= summon_
	match safety
	as safe
		()
	as unsafe_
		res |:= unsafe_
	as trusted_
		res |:= trusted_
	if is-ok-if-unused
		res |:= ok-if-unused
	res
summon_ bool(a fun-flags) # TODO: DON'T NEED A FN -------------------------------------------------------------------------------
	summon_::fun-flags in a
unsafe_ bool(a fun-flags) # TODO: DON'T NEED A FN -------------------------------------------------------------------------------
	unsafe_::fun-flags in a
trusted_ bool(a fun-flags) # TODO: DON'T NEED A FN -------------------------------------------------------------------------------
	trusted_::fun-flags in a
safety fun-safety(a fun-flags) # TODO: DON'T NEED A FN -------------------------------------------------------------------------------
	if trusted_::fun-flags in a
		forbid unsafe_::fun-flags in a
		trusted_
	elif unsafe_::fun-flags in a
		unsafe_
	else
		safe
ok-if-unused bool(a fun-flags) # TODO: DON'T NEED A FN -------------------------------------------------------------------------------
	ok-if-unused::fun-flags in a
with-ok-if-unused fun-flags(a fun-flags) # TODO: DON'T NEED A FN -----------------------------------------------------------------
	a | ok-if-unused
with-summon fun-flags(a fun-flags) # TODO: DON'T NEED A FN -----------------------------------------------------------------
	a | summon_
with-not-summon fun-flags(a fun-flags) # TODO: DON'T NEED A FN -----------------------------------------------------------------
	a & ~summon_
with-summon fun-flags(a fun-flags, is-summon bool) # TODO: DON'T NEED A FN -----------------------------------------------------------------
	if is-summon
		a with-summon
	else
		a with-not-summon

regular fun-flags(is-summon bool, safety fun-safety) # TODO: just call this 'new' --------------------------------------------------
	is-summon: is-summon
	safety: safety
	is-ok-if-unused: false
none fun-flags() # TODO: DON'T NEED A FN -----------------------------------------------------------------
	()
generated fun-flags() # TODO: DON'T NEED A FN ----------------------------------------------------------------------------------
	ok-if-unused
generated-unsafe fun-flags() # TODO: DON'T NEED A FN -----------------------------------------------------------------
	unsafe_ | ok-if-unused

fun-safety enum(safe, trusted_, unsafe_)
== bool(a fun-safety, b fun-safety)

fun-decl-source union
	fun-source-bogus
	fun-source-java
	fun-decl-ast
	enum-or-flags-member
	fun-source-file-import
	record-field
	# This is for a variant method
	signature
	struct-decl
	var-decl
do
	module-uri uri()
	name-range uri-and-range()
range uri-and-range(a fun-decl-source)
	match a
	as fun-source-bogus x
		x.module-uri, ()
	as fun-source-java x
		x.module-uri, ()
	as fun-decl-ast x
		x.module-uri, x.range
	as enum-or-flags-member x
		x range
	as fun-source-file-import x
		x.module-uri, x.ast.range
	as record-field x
		x range
	as signature x
		x range
	as struct-decl x
		x range
	as var-decl x
		x range
doc-comment-ast doc-comment-ast(a fun-decl-source)
	if x ?= a fun-decl-ast
		x doc-comment
type-params type-params(a fun-decl-source)
	match a
	as fun-source-bogus x
		x type-params
	as fun-source-java _
		()
	as fun-decl-ast x
		x type-params
	as enum-or-flags-member x
		x.containing-enum type-param-asts
	as fun-source-file-import _
		()
	as record-field x
		x.containing-record type-param-asts
	as signature x
		x.container type-param-asts
	as struct-decl x
		x type-param-asts
	as var-decl x
		x type-param-asts
fun-source-bogus record(module-uri uri, name symbol, type-params type-params)
name-range uri-and-range(a fun-source-bogus)
	a.module-uri top-of-file
fun-source-java record(class-path path, name symbol)
module-uri uri(a fun-source-java)
	a.class-path to-java-uri
to-java-uri uri(a path)
	"java://".must-parse-uri concat-uri-and-path a

name-range uri-and-range(a fun-source-java)
	a.module-uri top-of-file
fun-source-file-import record
	| This is the importing module, not imported
	module-uri uri
	ast import-or-export-ast
name symbol(a fun-source-file-import)
	a.ast.kind.import-file-ast!.name name
name-range uri-and-range(a fun-source-file-import)
	a.module-uri, a.ast.range

fun-decl record force-data, -new
	hash nat32 # TODO: USED? ---------------------------------------------------------------------------------------------------------
	source fun-decl-source
	visibility visibility
	name symbol
	n-type-params-storage nat8
	return-type mut type
	params mut params
	flags_ fun-flags
	externs symbol-set
	specs specs
	doc-comment-references mut doc-comment-references
	body mut fun-body
	insts mut fun-decl-insts
	deprecated mut bool # RM -----------------------------------------------------------------------------------------------------
| For a non-template, this will be its only {fun-inst}.
fun-decl-insts union(fun-inst, (fun-inst, fun-inst-key) object-memoizer) mut
-fun-name symbol(return-type type, source fun-decl-source, body fun-body)
	match source
	as fun-source-bogus x
		x name
	as fun-source-java x
		x name
	as fun-decl-ast x
		x.name name
	as enum-or-flags-member x
		x name
	as fun-source-file-import x
		x name
	as record-field x
		if s ?= body record-field-set
			"set-{s.is-set-deref ? "deref-"::string}{x name}"
		else
			x name
	as signature x
		x name
	as struct-decl struct
		match body
		as create-record x
			x nominal_ ? struct name : "new"
		as flags-function x
			match x
			as in
				"in"
			as intersect
				"&"
			as negate
				"~"
			as none
				"new"
			as union_
				"|"
		as sum-type-member-get
			return-type.must-unwrap-option-type.struct-inst!.decl name
		else
			throw unreachable
	as var-decl x
		match body
		as var-get _
			x name
		as var-set _
			"set-{x name}"
		else
			throw unreachable
new fun-decl
	hash nat32
	source fun-decl-source
	visibility visibility
	n-type-params nat # TODO: this comes from source so it doesn't need to be a constructor param ---------------------------------
	return-type type
	params params
	flags_ fun-flags
	externs symbol-set
	specs specs
	doc-comment-references doc-comment-references
	body fun-body
do
	res fun-decl = do
		hash: hash
		source: source
		visibility: visibility
		name: return-type fun-name source, body
		n-type-params-storage: n-type-params to
		return-type: return-type
		params: params
		flags_: flags_
		externs: externs
		specs: specs
		doc-comment-references: doc-comment-references
		body: body
		insts: trusted gc-safe-value
		deprecated: false
	res.insts := if res is-template
		()::((fun-inst, fun-inst-key) object-memoizer)
	else
		return-and-param-types type[] = with b : build
			b ~= return-type
			for x : params params-array
				b ~= x type
		(res, (), (), return-and-param-types)::fun-inst
	res
get-key symbol(a fun-decl)
	a name
n-type-params nat(a fun-decl)
	a.n-type-params-storage to
== bool(a fun-decl, b fun-decl)
	trusted a reference-equal b
<=> comparison(_ fun-decl, _ fun-decl)
	throw todo
hash-mix void(hasher hasher, a fun-decl)
	hasher hash-mix a.hash
type-param-asts type-params(a fun-decl)
	a.source type-params
module-uri uri(a fun-decl)
	a.source module-uri
range uri-and-range(a fun-decl)
	a.source range
name-range uri-and-range(a fun-decl)
	a.source name-range
doc-comment-ast doc-comment-ast(a fun-decl)
	a.source doc-comment-ast
doc-comment doc-comment(a fun-decl)
	a.doc-comment-ast, a.doc-comment-references
is-generated bool(a fun-decl)
	a.body is-generated
is-summon bool(a fun-decl)
	a.flags_ summon_
is-unsafe bool(a fun-decl)
	a.flags_.safety == unsafe_
ok-if-unused bool(a fun-decl)
	a.flags_ ok-if-unused
is-variadic bool(a fun-decl)
	match a params
	as array _
		false
	as varargs _
		true
is-template bool(a fun-decl)
	a.n-type-params != 0 || a.specs !is-empty
arity arity(a fun-decl)
	a.params arity

test_ record force-data
	hash nat32 # TODO: USED? ---------------------------------------------------------------------------------------------------------
	ast test-ast
	module-uri uri
	flags_ fun-flags
	externs symbol-set
	body mut expr
	doc-comment-references mut doc-comment-references
== bool(a test_, b test_)
	trusted a reference-equal b
doc-comment-ast doc-comment-ast(a test_)
	a.ast doc-comment
doc-comment doc-comment(a test_)
	a.doc-comment-ast, a.doc-comment-references
range uri-and-range(a test_)
	a.module-uri, a.ast.range
name symbol(_ test_)
	"test"
name-range uri-and-range(a test_)
	a.module-uri, a.ast.keyword-range
n-type-params nat(_ test_)
	0
type-param-asts type-params(_ test_)
	()
visibility visibility(_ test_)
	private

expr-container union(fun-decl, test_, var-decl)
	module-uri uri()
	doc-comment doc-comment()
	type-param-asts type-params()
to type-container(a expr-container)
	match a
	as fun-decl x
		x
	as test_ x
		x
	as var-decl x
		x
specs specs(a expr-container)
	match a
	as fun-decl x
		x specs
	as test_ _
		()
	as var-decl _
		()

fun-inst record force-data, -new
	decl fun-decl
	type-args type-args
	spec-impls spec-impls
	instantiated-sig mut return-and-param-types
get-or-add-fun-inst fun-inst
	decl fun-decl
	type-args type-args
	spec-impls spec-impls
	cb-return-and-param-types return-and-param-types mut()
do
	if type-args is-empty && spec-impls is-empty
		decl.insts fun-inst!
	else
		trusted decl.insts.object-memoizer! memoize (type-args, spec-impls), () =>
			decl, type-args, spec-impls, cb-return-and-param-types[]
-fun-inst-key record
	type-args type-args
	spec-impls spec-impls
-== bool(a fun-inst-key, b fun-inst-key)
-hash nat(a fun-inst-key)
	hasher hasher = ()
	hasher hash-mix a.type-args
	hasher hash-mix a.spec-impls
	hasher finish
-memoizer-key fun-inst-key(a fun-inst)
	a.type-args, a.spec-impls
== bool(a fun-inst, b fun-inst) trusted
	a reference-equal b
hash-mix void(hasher hasher, a fun-inst) # TODO: would this be faster if fun-inst had an ID? -------------------------------------
	hasher hash-mix a.decl
	hasher hash-mix a.type-args
	hasher hash-mix a.spec-impls
hash nat((type-args type-args, spec-impls spec-impls))
	hasher hasher = ()
	hasher hash-mix type-args
	hasher hash-mix spec-impls
	hasher finish
to json(a fun-inst)
	("decl", a.decl.name.to), ("type-args", a.type-args.to), ("spec-impls", a.spec-impls.to)
name symbol(a fun-inst)
	a.decl name
return-type type(a fun-inst)
	a.instantiated-sig return-type
param-types type array-view(a fun-inst)
	a.instantiated-sig param-types
arity arity(a fun-inst)
	a.decl arity

| Represents calling the n'th signature on this function's {specs}
called-spec-sig record
	index-in-specs nat
	containing-spec spec-decl
	non-instantiated-sig signature
	instantiated-sig return-and-param-types
== bool(a called-spec-sig, b called-spec-sig) # TODO: could we just compare index-in-specs? Maybe called-spec-sig should just be that and the rest should be stored elsewhere. -----------------------------------------
hash-mix void(hasher hasher, a called-spec-sig)
	hasher hash-mix a.index-in-specs
	hasher hash-mix a.containing-spec
	hasher hash-mix a.non-instantiated-sig.name
	hasher hash-mix a.instantiated-sig
to json(a called-spec-sig)
	("index-in-specs", a.index-in-specs.to), \
	("spec", a.containing-spec.name.to),
	("sig", a.non-instantiated-sig.name.to),
	("instantiated-sig", a.instantiated-sig.to)
return-type type(a called-spec-sig)
	a.instantiated-sig return-type
param-types type array-view(a called-spec-sig)
	a.instantiated-sig param-types
module-uri uri(a called-spec-sig)
	a.non-instantiated-sig module-uri
name symbol(a called-spec-sig)
	a.non-instantiated-sig name
range uri-and-range(a called-spec-sig)
	a.non-instantiated-sig range
arity arity(a called-spec-sig)
	a.non-instantiated-sig.params.size to
n-type-params nat(_ called-spec-sig)
	0
type-param-asts type-params(_ called-spec-sig)
	()
doc-comment doc-comment(a called-spec-sig)
	a.non-instantiated-sig doc-comment

| Like 'Called', but not fully instantiated. (This is used for Candidate when checking a call expr.)
called-decl union(fun-decl, called-spec-sig)
	module-uri uri()
	n-type-params nat()
	type-param-asts type-params()
	return-type type()
	arity arity()
	doc-comment doc-comment()
# TODO: should be a method, but concretize has bugs --------------------------------------------------------------------------
name symbol(a called-decl)
	match a
	as fun-decl x
		x name
	as called-spec-sig x
		x name
== bool(a called-decl, b called-decl)
hash-mix void(hasher hasher, a called-decl)
	match a
	as fun-decl x
		hasher hash-mix x
	as called-spec-sig x
		hasher hash-mix x

to json(a called-decl)
	match a
	as fun-decl x
		x.name to
	as called-spec-sig x
		x.name to
range uri-and-range(a called-decl)
	match a
	as fun-decl x
		x range
	as called-spec-sig x
		x.non-instantiated-sig range
non-instantiated-params params(a called-decl)
	match a
	as fun-decl x
		x params
	as called-spec-sig x
		x.non-instantiated-sig params
is-variadic bool(a called-decl)
	a.arity is-variadic

called union(called-bogus, fun-inst, called-spec-sig)
	return-type type()
	param-types type array-view()
	arity arity()
== bool(a called, b called)
hash-mix void(hasher hasher, a called)
	match a
	as called-bogus x
		hasher hash-mix x
	as fun-inst x
		hasher hash-mix x
	as called-spec-sig x
		hasher hash-mix x
to json(a called)
called-bogus record(decl called-decl, return-type type, param-types_ type[])
param-types type array-view(a called-bogus)
	a.param-types_ to
== bool(a called-bogus, b called-bogus)
hash-mix void(hasher hasher, a called-bogus)
	hasher hash-mix a.decl
	hasher hash-mix a.return-type
	hasher hash-mix a.param-types_
to json(a called-bogus)
arity arity(a called-bogus)
