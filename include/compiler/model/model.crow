fun-flags record
	bare_ bool
	summon_ bool
	safety fun-safety
	ok-if-unused bool
	force-ctx_ bool
with-ok-if-unused fun-flags(a fun-flags)
	a.bare_, a.summon_, a.safety, true, a.force-ctx_
with-summon fun-flags(a fun-flags)
	a with-summon true
with-summon fun-flags(a fun-flags, summon_ bool)
	a.bare_, summon_, a.safety, a.ok-if-unused, a.force-ctx_

regular fun-flags(bare_ bool, summon_ bool, safety fun-safety, force-ctx_ bool)
	bare_, summon_, safety, false, force-ctx_
none fun-flags()
	false, false, safe, false, false
generated-bare fun-flags()
	true, false, safe, true, false
generated-bare-unsafe fun-flags()
	true, false, unsafe_, true, false
generated fun-flags()
	false, false, safe, true, false

fun-safety enum(safe, trusted_, unsafe_)
== bool(a fun-safety, b fun-safety)

fun-decl-source union(
	fun-source-bogus,
	fun-source-ast,
	enum-or-flags-member,
	fun-source-file-import,
	record-field,
	# This is for a variant method
	signature,
	struct-decl,
	var-decl
) mut
	module-uri uri()
	name-range uri-and-range()
range uri-and-range(a fun-decl-source)
	match a
	as fun-source-bogus x
		x.module-uri, ()
	as fun-source-ast x
		x.module-uri, x.ast.range
	as enum-or-flags-member x
		x.module-uri, x.range
	as fun-source-file-import x
		x.module-uri, x.ast.range
	as record-field x
		x.module-uri, x.range
	as signature x
		x range
	as struct-decl x
		x range
	as var-decl x
		x range
doc-comment-ast doc-comment-ast(a fun-decl-source)
	if x ?= a fun-source-ast
		x.ast doc-comment
type-params type-params(a fun-decl-source)
	match a
	as fun-source-bogus x
		x type-params
	as fun-source-ast x
		x.ast type-params
	as enum-or-flags-member x
		x.containing-enum type-params
	as fun-source-file-import _
		()
	as record-field x
		x.containing-record type-params
	as signature x
		x.container type-params
	as struct-decl x
		x type-params
	as var-decl x
		x type-params
fun-source-bogus record(module-uri uri, type-params type-params)
name-range uri-and-range(a fun-source-bogus)
	a.module-uri top-of-file
fun-source-ast record(module-uri uri, ast fun-decl-ast)
name-range uri-and-range(a fun-source-ast)
	a.module-uri, a.ast.range
fun-source-file-import record
	| This is the importing module, not imported
	module-uri uri
	ast import-or-export-ast
name-range uri-and-range(a fun-source-file-import)
	a.module-uri, a.ast.range

fun-decl record mut
	id decl-id
	source fun-decl-source
	visibility visibility
	name symbol
	return-type type
	params params
	flags_ fun-flags
	externs symbol-set
	specs specs
	doc-comment-references mut doc-comment-references
	body mut fun-body
== bool(a fun-decl, b fun-decl)
	trusted a reference-equal b
type-params type-params(a fun-decl)
	a.source type-params
module-uri uri(a fun-decl)
	a.source module-uri
range uri-and-range(a fun-decl)
	a.source range
name-range uri-and-range(a fun-decl)
	a.source name-range
doc-comment-ast doc-comment-ast(a fun-decl)
	a.source doc-comment-ast
doc-comment doc-comment(a fun-decl)
	a.doc-comment-ast, a.doc-comment-references
linkage linkage(a fun-decl)
	match a body
	as fun-body-extern _
		extern_
	else
		internal
is-bare bool(a fun-decl)
	a.flags_ bare_
is-bare-or-force-ctx bool(a fun-decl)
	a.flags_.bare_ || a.flags_.force-ctx_
is-generated bool(a fun-decl)
	a.body is-generated
is-summon bool(a fun-decl)
	a.flags_ summon_
is-unsafe bool(a fun-decl)
	a.flags_.safety == unsafe_
ok-if-unused bool(a fun-decl)
	a.flags_ ok-if-unused
is-variadic bool(a fun-decl)
	match a params
	as array _
		false
	as varargs _
		true
is-template bool(a fun-decl)
	a.type-params !is-empty || a.specs !is-empty
arity arity(a fun-decl)
	a.params arity
each-spec-in-fun-including-parents bool(a fun-decl, cb bool mut(x spec-inst))
	a.specs iterate x =>
		x each-spec-including-parents cb
-each-spec-including-parents bool(a spec-inst, cb bool mut(x spec-inst))
	from-parents = a.parents exists parent =>
		parent each-spec-including-parents cb
	from-parents || cb[a]
each-spec-sig-and-impl void(a fun-decl, impls spec-impls, cb void mut(x spec-inst, sig signature, c called))
	assert impls.size == a.specs.count-sigs
	impl-index mut nat = 0
	for spec_ : a specs
		spec_ each-spec-sig sig =>
			cb[spec_, sig, impls[impl-index]]
			impl-index +:= 1
	impl-index is impls.size

test_ record mut
	id decl-id
	ast test-ast
	module-uri uri
	flags_ fun-flags
	externs symbol-set
	body expr
	doc-comment-references mut doc-comment-references
doc-comment-ast doc-comment-ast(a test_)
	a.ast doc-comment
doc-comment doc-comment(a test_)
	a.doc-comment-ast, a.doc-comment-references
range uri-and-range(a test_)
	a.module-uri, a.ast.range
name symbol(_ test_)
	"test"
name-range uri-and-range(a test_)
	a.module-uri, a.ast.keyword-range
type-params type-params(_ test_)
	()
| Treat as public since 'run-all-tests' runs tests from other modules
visibility visibility(_ test_)
	public

fun-decl-and-type-args record(decl fun-decl, type-args type-args) mut

| WARN: Do not create directly. Go through the functions in 'instantiate.crow'.
fun-inst record mut
	id inst-id
	decl fun-decl
	type-args type-args
	spec-impls spec-impls
	instantiated-sig return-and-param-types
name symbol(a fun-inst)
	a.decl name
return-type type(a fun-inst)
	a.instantiated-sig return-type
param-types type[](a fun-inst)
	a.instantiated-sig param-types
arity arity(a fun-inst)
	a.decl arity

return-and-param-types record(return-and-param-types type[]) mut
return-type type(a return-and-param-types)
	a.return-and-param-types[0]
param-types type[](a return-and-param-types)
	a.return-and-param-types[1 .. end]

called-spec-sig record(spec-inst spec-inst, sig-index nat) mut
instantiated-sig return-and-param-types(a called-spec-sig)
	a.spec-inst.sig-types[a sig-index]
return-type type(a called-spec-sig)
	a.instantiated-sig return-type
param-types type[](a called-spec-sig)
	a.instantiated-sig param-types
non-instantiated-sig signature(a called-spec-sig)
	a.spec-inst.decl.sigs[a sig-index]
module-uri uri(a called-spec-sig)
	a.spec-inst.decl module-uri
name symbol(a called-spec-sig)
	a.non-instantiated-sig name
range uri-and-range(a called-spec-sig)
	a.non-instantiated-sig range
arity arity(a called-spec-sig)
	a.non-instantiated-sig.params.size to
type-params type-params(_ called-spec-sig)
	()
doc-comment doc-comment(a called-spec-sig)
	a.non-instantiated-sig doc-comment

| Like 'Called', but not fully instantiated. (This is used for Candidate when checking a call expr.)
called-decl union(fun-decl, called-spec-sig) mut
	module-uri uri()
	name symbol()
	type-params type-params()
	return-type type()
	arity arity()
	doc-comment doc-comment()
non-instantiated-params params(a called-decl)
	match a
	as fun-decl x
		x params
	as called-spec-sig x
		x.non-instantiated-sig.params to
is-variadic bool(a called-decl)
	a.arity is-variadic
n-type-params nat(a called-decl)
	a.type-params size

called union(called-bogus, fun-inst, called-spec-sig) mut
	return-type type()
	param-types type[]()
	arity arity()
called-bogus record(decl called-decl, return-type type, param-types type[]) mut
arity arity(a called-bogus)
	a.decl arity

called-decl called-decl(a called)
	match a
	as called-bogus x
		x decl
	as fun-inst x
		x.decl to
	as called-spec-sig x
		x to
name symbol(a called)
	a.called-decl name
is-variadic bool(a called)
	a.arity is-variadic

struct-or-alias union(struct-alias, struct-decl) mut
	id decl-id()
	range uri-and-range()
	name-range uri-and-range()
	visibility visibility()
	name symbol()
	type-params type-params()

| There is no `var-inst` since these can't be templates
var-decl record mut
	id decl-id
	ast var-decl-ast
	module-uri uri
	visibility visibility
	type type
	extern-library-name symbol?
	doc-comment-references mut doc-comment-references
doc-comment-ast doc-comment-ast(a var-decl)
	a.ast doc-comment
doc-comment doc-comment(a var-decl)
	a.doc-comment-ast, a.doc-comment-references
name symbol(a var-decl)
	a.ast.name name
type-params type-params(_ var-decl)
	()
kind var-kind(a var-decl)
	a.ast kind
range uri-and-range(a var-decl)
	a.module-uri, a.ast.range
name-range uri-and-range(a var-decl)
	a.module-uri, a.ast.name-range

module record mut
	uri uri
	| The config closest to this module. (Not necessarily the main config.)
	config config
	ast file-ast
	| WARN: This is not every diagnostic. See {each-diagnostic}.
	diagnostics diagnostic[]
	imports import-or-export[]
	re-exports import-or-export[]
	aliases struct-alias[]
	structs struct-decl[]
	vars var-decl[]
	specs spec-decl[]
	funs fun-decl[]
	tests test_[]
	exports name-referents[symbol]
	doc-comment-references doc-comment-references
module-uri uri(a module)
	a uri
type-params type-params(_ module)
	()
range uri-and-range(a module)
	a.uri top-of-file
doc-comment-ast doc-comment-ast(a module)
	a.ast doc-comment
doc-comment doc-comment(a module)
	a.doc-comment-ast, a.doc-comment-references

| Excludes derived decls, e.g. FunDecl that is a record field getter
each-decl void(a module, cb void mut(x any-decl))
	for x : a aliases
		cb[x to]
	for x : a structs
		cb[x to]
	for x : a vars
		cb[x to]
	for x : a specs
		cb[x to]
	for x : a funs
		if _ ?= x.source fun-source-ast
			cb[x to]
	for x : a tests
		cb[x to]

any-decl union(fun-decl, spec-decl, struct-alias, struct-decl, test_, var-decl) mut
	id decl-id()
	module-uri uri()
	name symbol()
	range uri-and-range()
	name-range uri-and-range()
	doc-comment-ast doc-comment-ast()
	doc-comment doc-comment()
	type-params type-params()
	visibility visibility()
specs specs(a any-decl)
	match a
	as fun-decl x
		x specs
	as spec-decl x
		x parents
	as struct-alias _
		()
	as struct-decl _
		()
	as test_ _
		()
	as var-decl _
		()

type-with-container record(type type, container type-container) mut

| Since a type parameter is represented as its index, we need a context to know where to find it.
| This is like AnyDecl, but also includes 'Module' which can have types in its doc comment.
type-container union(fun-decl, module, spec-decl, struct-alias, struct-decl, test_, var-decl) mut
	module-uri uri()
	type-params type-params()
	doc-comment doc-comment()
forbid-module any-decl(a type-container)
	match a
	as fun-decl x
		x to
	as module _
		throw unreachable
	as spec-decl x
		x to
	as struct-alias x
		x to
	as struct-decl x
		x to
	as test_ x
		x to
	as var-decl x
		x to
to type-container(a any-decl)
	match a
	as fun-decl x
		x to
	as spec-decl x
		x to
	as struct-alias x
		x to
	as struct-decl x
		x to
	as test_ x
		x to
	as var-decl x
		x to

is-import-or-export enum(import_, export_)
each-import-or-re-export void(a module, cb void mut(x import-or-export))
	a each-import-or-re-export-with-kind (_, x) =>
		cb[x]
each-import-or-re-export-with-kind void(a module, cb void mut(kind is-import-or-export, x import-or-export))
	for x : a imports
		cb[import_, x]
	for x : a re-exports
		cb[export_, x]

import-or-export record mut
	| Empty for an automatic import of std
	source import-or-export-ast?
	module module
	| If this is {internal}, import internal and public exports.
	| If this is {public}, import only public exports.
	import-visibility export-visibility
	| If the ast was {name-and-range}[], this will have an entry for each name (except when there was nothing to import).
	| For an import of a whole module, this tracks what was actually used in this module.
	| For a re-export of a whole module, this is not used.
	imported mut imported-referents?
has-imported bool(a import-or-export)
	a.imported !is-empty
is-std bool(a import-or-export)
	a.source is-empty
is-relative-import bool(a import-or-export)
	if x ?= a source
		if _ ?= x.path rel-path
			true
imported-referents alias
	name-referents[symbol]

import-file-content union(nat8[], string, import-file-content-bogus)
import-file-content-bogus record

name-referents record mut
	struct-or-alias struct-or-alias?
	spec_ spec-decl?
	funs fun-decl[]
name symbol(a name-referents)
	if x ?= a struct-or-alias
		x name
	elif x ?= a spec_
		x name
	else
		a.funs[0] name

fun-kind-from-builtin-type fun-kind?(a builtin-type)
	match a
	as lambda-data
		data_,
	as lambda-shared
		shared_,
	as lambda-mut
		mut_,
	as fun-pointer
		function_,
	else
		()

common-funs-and-diagnostics record(common-funs common-funs, diagnostics uri-and-diagnostic[]) mut

common-funs record mut
	js-await fun-inst
	cur-catch-point fun-inst
	set-cur-catch-point fun-inst
	cur-thrown var-decl
	allocate fun-inst
	create-error fun-inst
	lambda-subscript (fun-kind, fun-decl) enum-map
	shared-of-mut-lambda fun-decl
	mark fun-inst
	to-json-from-json fun-inst
	to-json-from-t-array fun-decl
	new-json-from-pairs fun-inst
	run-fiber fun-inst
	run-all-tests fun-inst
	rt-main fun-inst
	throw-impl fun-inst
	equal-const-pointers fun-decl
	rethrow-current-exception fun-inst
	concat-arrays fun-decl
	gc-root fun-inst
	set-gc-root fun-inst
	pop-gc-root fun-inst
catch-point-pointer-type struct-inst(a common-funs)
	a.cur-catch-point.return-type struct-inst!
catch-point-type struct-inst(a common-funs)
	a.catch-point-pointer-type.type-args.only struct-inst!

common-types record mut
	bool struct-inst
	char8 struct-inst
	char32 struct-inst
	c-string struct-inst
	exception struct-inst
	fiber struct-inst
	float32 struct-inst
	float64 struct-inst
	future struct-decl
	integrals integral-types
	js-any struct-inst
	string struct-inst
	symbol struct-inst
	symbol-array struct-inst
	void struct-inst
	array struct-decl
	char8-array struct-inst
	char8-const-pointer struct-inst
	char32-array struct-inst
	nat8-array struct-inst
	string-array struct-inst
	option struct-decl
	pointer-const struct-decl
	pointer-mut struct-decl
	reference struct-decl
	| No tuple0 and tuple1, so this is 2-9 inclusive
	tuples-2-through-9 struct-decl[]
	| Indexed by FunKind, then by arity. (arity = typeArgs.length - 1)
	fun-structs (fun-kind, struct-decl) enum-map
fun-pointer-struct struct-decl(a common-types)
	a.fun-structs[function_]
pair struct-decl(a common-types)
	a tuple! 2
tuple struct-decl?(a common-types, arity nat)
	if arity in 2 .. 10
		a.tuples-2-through-9[arity - 2],
max-tuple-size nat(_ common-types)
	9
subscript struct-inst(a common-types, type char-type)
	match type
	as char8
		a char8
	as char32
		a char32
subscript struct-inst(a common-types, type integral-type)
	a.integrals[type]
subscript struct-inst(a common-types, type char-or-integral-type)
	match type
	as char-type x
		a[x]
	as integral-type x
		a[x]
subscript struct-inst(a common-types, type float-type)
	match type
	as float32
		a float32
	as float64
		a float64
subscript struct-inst(a common-types, type string-like-type)
	match type
	as char8-array
		a char8-array
	as char32-array
		a char32-array
	as c-string
		a c-string
	as js-any
		a js-any
	as string
		a string
	as symbol
		a symbol

