	hash nat32 # TODO: USED? ---------------------------------------------------------------------------------------------------------
	ast var-decl-ast
	module-uri uri
	visibility visibility
	type type
	initializer mut expr-maybe-allocated-locals
	doc-comment-references mut doc-comment-references
== bool(a var-decl, b var-decl)
	trusted a 'reference-equal b
<=> comparison(a var-decl, b var-decl)
	a.range <=> b.range
hash void(a var-decl, state hash-state)
	hash a.hash, state
to json(a var-decl)
	a.name.to::json
doc-comment-ast doc-comment-ast(a var-decl)
	a.ast.doc-comment
doc-comment doc-comment(a var-decl)
	a.doc-comment-ast, a.doc-comment-references
name symbol(a var-decl)
	a.ast.name.name
n-type-params nat(_ var-decl)
	0
type-param-asts type-params(_ var-decl)
	()
kind var-kind(a var-decl)
	a.ast.kind
range uri-and-range(a var-decl)
	a.module-uri, a.ast.range
name-range uri-and-range(a var-decl)
	a.module-uri, a.ast.name-range

module union(crow-module, java-class-module)
	uri uri()
	name string()
	public-exports exports()
	public-and-internal-exports exports()

# Synthetic module generated from a Java class
java-class-module record
	| E.g., 'java/util/Foo'
	path path
	public-exports exports
name string(a java-class-module)
	a.path.base-name
uri uri(a java-class-module)
	a.path.to-java-uri
public-and-internal-exports exports(a java-class-module)
	a.public-exports

crow-module record force-data
	uri uri
	| The config closest to this module. (Not necessarily the main config.)
	config config
	ast file-ast
	| WARN: May contain duplicates. This will match the order in {ast}.imports and {ast}.re-exports, but does not include file imports.
	imports-and-re-exports module[]
	file-imports-and-exports uri[]
	| WARN: This is not every diagnostic. See {each-diagnostic}.
	diagnostics mut diagnostic[]
	aliases struct-alias[]
	structs struct-decl[]
	vars var-decl[]
	specs spec-decl[]
	funs fun-decl[]
	tests test_[]
	| This is derived data based on the funs, specs, and structs/aliases in a module
	public-exports exports
	public-and-internal-exports exports
	doc-comment-references doc-comment-references
== bool(a crow-module, b crow-module)
	trusted a 'reference-equal b
to json(a crow-module)
	deep-omit-empty-values
		uri: a.uri.to
		config: a.config.config-uri.to
		aliases: a.aliases.to
		structs: map a.structs, it.to-json-with-body
		vars: a.vars.to
		specs: a.specs.to
		funs: a.funs.to
		tests: a.tests.to
		doc-comment-references: a.doc-comment-references.to
module-uri uri(a crow-module)
	a.uri
name string(a crow-module)
	a.uri.base-name
n-type-params nat(_ crow-module)
	0
type-param-asts type-params(_ crow-module)
	()
range uri-and-range(a crow-module)
	a.uri.top-of-file
doc-comment-ast doc-comment-ast(a crow-module)
	a.ast.doc-comment
doc-comment doc-comment(a crow-module)
	a.doc-comment-ast, a.doc-comment-references
export-visibility enum(internal, public)
exports exports(a module, visibility export-visibility)
	match visibility
	as public
		a.public-exports
	as internal
		a.public-and-internal-exports

exports record
	funs fun-decl multi-by-name
	structs-and-aliases struct-or-alias by-name
	specs spec-decl by-name
new exports()
	(), (), ()

| Excludes derived decls, e.g. FunDecl that is a record field getter
each-decl void(a crow-module, cb void mut(x any-decl))
	for x in a.aliases
		cb[x]
	for x in a.structs
		cb[x]
	for x in a.vars
		cb[x]
	for x in a.specs
		cb[x]
	for x in a.funs
		if x.source.fun-decl-ast
			cb[x]
	for x in a.tests
		cb[x]

| Does not walk re-exports
zip-ast-and-module-imports void(module crow-module, f void mut(ast import-or-export-ast, imported module))
	ast = module.ast
	ast-total = ast.imports.count-non-file-imports + ast.re-exports.count-non-file-imports + (!ast.no-std_).to
	guard ast-total == module.imports-and-re-exports.size
	i mut nat = !ast.no-std_ 'to
	for x in ast.imports.?paths else ()
		unless x.kind.import-file-ast
			f[x, module.imports-and-re-exports[i]]
			i +:= 1
-count-non-file-imports nat(a imports-or-exports-ast?)
	guard a
	count a.paths, !it.kind.import-file-ast

any-decl union
	fun-decl
	spec-decl
	struct-alias
	struct-decl
	test_
	var-decl
do
	hash nat32()
	module-uri uri()
	range uri-and-range()
	name-range uri-and-range()
	doc-comment-ast doc-comment-ast()
	doc-comment doc-comment()
	type-param-asts type-params()
	visibility visibility()
# TODO: should be a method, but there are bugs in concretize -----------------------------------------------------------------
name symbol(a any-decl)
	match a
	as fun-decl then a.name
	as spec-decl then a.name
	as struct-alias then a.name
	as struct-decl then a.name
	as test_ then a.name
	as var-decl then a.name
== bool(a any-decl, b any-decl)
hash void(a any-decl, state hash-state)
	hash a.hash, state
<=> comparison(a any-decl, b any-decl)
	a.range <=> b.range
specs specs(a any-decl)
	match a
	as fun-decl
		a.specs
	as spec-decl
		a.parents
	as struct-alias
		()
	as struct-decl
		()
	as test_
		()
	as var-decl
		()

type-with-container record(type type, container type-container)

| Since a type parameter is represented as its index, we need a context to know where to find it.
| This is like AnyDecl, but also includes 'Module' which can have types in its doc comment.
type-container union(fun-decl, crow-module, spec-decl, struct-alias, struct-decl, test_, var-decl)
	module-uri uri()
	n-type-params nat()
	type-param-asts type-params()
	doc-comment doc-comment()
forbid-module any-decl(a type-container)
	match a
	as fun-decl then a
	as crow-module then throw unreachable
	as spec-decl then a
	as struct-alias then a
	as struct-decl then a
	as test_ then a
	as var-decl then a
to type-container(a any-decl)
	match a
	as fun-decl then a
	as spec-decl then a
	as struct-alias then a
	as struct-decl then a
	as test_ then a
	as var-decl then a

# TODO: this is not actualy stored on the model anywhere, should I move it to where it's used? -----------------------------------------
import-or-export record force-data
	| Empty for an automatic import of std
	source import-or-export-ast?
	module module
	| If this is {internal}, import internal and public exports.
	| If this is {public}, import only public exports.
	import-visibility export-visibility
	# TODO: doc comment is out of date. This no longer tracks anything .....................................................................
	| If the ast was {name-and-range}[], this will have an entry for each name (except when there was nothing to import).
	| For an import of a whole module, this tracks what was actually used in this module.
	| For a re-export of a whole module, this is not used.
	named-imported mut exports
is-std bool(a import-or-export)
	!a.source

