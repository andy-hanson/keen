fun-decl-source union
	fun-source-bogus
	fun-source-java
	fun-decl-ast
	enum-or-flags-member
	fun-source-file-import
	record-field
	# This is for a variant method
	signature
	struct-decl
	var-decl
do
	module-uri uri()
	name-range uri-and-range()
to json(a fun-decl-source)
range uri-and-range(a fun-decl-source)
	match a
	as fun-source-bogus
		a.module-uri, ()
	as fun-source-java
		a.module-uri, ()
	as fun-decl-ast
		a.module-uri, a.range
	as enum-or-flags-member
		a.range
	as fun-source-file-import
		a.module-uri, a.ast.range
	as record-field
		a.range
	as signature
		a.range
	as struct-decl
		a.range
	as var-decl
		a.range
doc-comment-ast doc-comment-ast(a fun-decl-source)
	if a.fun-decl-ast
		a.doc-comment
type-params type-params(a fun-decl-source)
	match a
	as fun-source-bogus
		a.type-params
	as fun-source-java
		()
	as fun-decl-ast
		a.type-params
	as enum-or-flags-member
		()
	as fun-source-file-import
		()
	as record-field
		a.containing-record.type-param-asts
	as signature
		a.container.type-param-asts
	as struct-decl
		a.type-param-asts
	as var-decl
		a.type-param-asts
fun-source-bogus record(module-uri uri, name symbol, type-params type-params)
to json(a fun-source-bogus)
name-range uri-and-range(a fun-source-bogus)
	a.module-uri.top-of-file
fun-source-java record(class-path path, name symbol)
to json(a fun-source-java)
module-uri uri(a fun-source-java)
	a.class-path.to-java-uri
# TODO: these probably belong in uri.crow? ----------------------------------------------------------------------------------------------------------
to-java-uri uri(a path)
	concat-uri-and-path "java://".must-parse-uri, a
is-java-uri bool(a uri)
	starts-with a.to::symbol.to::string, "java://"
as-java-uri path?(a uri)
	?parse-path try-remove-start a.to::symbol.to::string, "java:///"

name-range uri-and-range(a fun-source-java)
	top-of-file a.module-uri
fun-source-file-import record
	| This is the importing module, not imported
	module-uri uri
	ast import-or-export-ast
to json(a fun-source-file-import)
name symbol(a fun-source-file-import)
	a.ast.kind.import-file-ast!.name.name
name-range uri-and-range(a fun-source-file-import)
	a.module-uri, a.ast.range

fun-decl record force-data, -new
	hash nat32 # TODO: USED? ---------------------------------------------------------------------------------------------------------
	source fun-decl-source
	visibility visibility
	name symbol
	n-type-params-storage nat8
	return-type mut type
	params mut destructure[]
	param-types mut type[]
	specs specs
	doc-comment-references mut doc-comment-references
	body mut fun-body
	insts mut fun-decl-insts
to json(a fun-decl)
	source: a.source.to
	visibility: a.visibility.to
	name: a.name.to
	n-type-params: a.n-type-params.to
	return-type: a.return-type.to
	params: a.params.to
	specs: a.specs.to
	doc-comment-references: a.doc-comment-references.to
	body: a.body.to
| For a non-template, this will be its only {fun-inst}.
fun-decl-insts union(fun-inst, (fun-inst, fun-inst-key) object-memoizer) mut
-fun-name symbol(return-type type, source fun-decl-source, body fun-body)
	match source
	as fun-source-bogus
		source.name
	as fun-source-java
		source.name
	as fun-decl-ast
		source.name.name
	as enum-or-flags-member
		source.name
	as fun-source-file-import
		source.name
	as record-field
		if body.record-field-set
			"set-{source.name}"
		else
			source.name
	as signature
		source.name
	as struct-decl
		match body
		as create-record
			if body.nominal_ then source.name else "new"
		as flags-function
			body.to
		as sum-type-member-get
			return-type.unwrap-option!.struct-inst!.decl.name
		else
			throw unreachable
	as var-decl
		match body
		as var-get
			source.name
		as var-set
			"set-{source.name}"
		else
			throw unreachable
new fun-decl
	hash nat32
	source fun-decl-source
	visibility visibility
	n-type-params nat # TODO: this comes from source so it doesn't need to be a constructor param ---------------------------------
	return-type type
	params destructure[]
	specs specs
	doc-comment-references doc-comment-references
	body fun-body
do
	res fun-decl =
		hash: hash
		source: source
		visibility: visibility
		name: fun-name return-type, source, body
		n-type-params-storage: n-type-params.to
		return-type: return-type
		params: params
		param-types: map params, it.type
		specs: specs
		doc-comment-references: doc-comment-references
		body: body
		insts: trusted gc-safe-value
	res.insts := if res.is-template
		:: (fun-inst, fun-inst-key) object-memoizer
	else
		:: fun-inst
		res, (), (), return-type, res.param-types
	res
n-type-params nat(a fun-decl)
	a.n-type-params-storage.to
== bool(a fun-decl, b fun-decl)
	trusted a 'reference-equal b
<=> comparison(a fun-decl, b fun-decl)
	a.range <=> b.range
hash void(a fun-decl, state hash-state)
	hash a.hash, state
type-param-asts type-params(a fun-decl)
	a.source.type-params
module-uri uri(a fun-decl)
	a.source.module-uri
range uri-and-range(a fun-decl)
	a.source.range
name-range uri-and-range(a fun-decl)
	a.source.name-range
doc-comment-ast doc-comment-ast(a fun-decl)
	a.source.doc-comment-ast
doc-comment doc-comment(a fun-decl)
	a.doc-comment-ast, a.doc-comment-references
is-template bool(a fun-decl)
	a.n-type-params != 0 or !is-empty a.specs.instantiated-sigs
arity nat(a fun-decl)
	a.params.size
is-unsafe bool(a fun-decl)
	a.specs.is-unsafe
is-summon bool(a fun-decl)
	a.specs.is-summon

test_ record force-data
	hash nat32 # TODO: USED? ---------------------------------------------------------------------------------------------------------
	ast test-ast
	module-uri uri
	| This can't have spec-impls, so it's limited to builtin specs like 'java', 'js', or 'summon'
	specs specs
	body mut expr-maybe-allocated-locals
	doc-comment-references mut doc-comment-references
== bool(a test_, b test_)
	trusted a 'reference-equal b
to json(a test_)
	specs: a.specs.to
	body: a.body.to
	doc-comment-references: a.doc-comment-references.to
doc-comment-ast doc-comment-ast(a test_)
	a.ast.doc-comment
doc-comment doc-comment(a test_)
	a.doc-comment-ast, a.doc-comment-references
range uri-and-range(a test_)
	a.module-uri, a.ast.range
name symbol(_ test_)
	"test"
name-range uri-and-range(a test_)
	a.module-uri, a.ast.keyword-range
n-type-params nat(_ test_)
	0
type-param-asts type-params(_ test_)
	()
visibility visibility(_ test_)
	private

expr-container union(fun-decl, test_, var-decl)
	module-uri uri()
	doc-comment doc-comment()
	type-param-asts type-params()
to type-container(a expr-container)
	match a
	as fun-decl then a
	as test_ then a
	as var-decl then a
specs specs(a expr-container)
	match a
	as fun-decl
		a.specs
	as test_
		a.specs
	as var-decl
		()

fun-inst record force-data, -new
	decl fun-decl
	type-args type-args
	spec-impls spec-impls
	return-type mut type
	param-types mut type[]
get-or-add-fun-inst fun-inst
	decl fun-decl
	type-args type-args
	spec-impls spec-impls
	cb-return-and-param-types return-and-param-types mut()
do
	if type-args.is-empty and spec-impls.is-empty
		decl.insts.fun-inst!
	else
		trusted memoize decl.insts.object-memoizer!, (type-args, spec-impls), of
			rp = cb-return-and-param-types[]
			decl, type-args, spec-impls, rp.return-type, rp.param-types
-fun-inst-key record
	type-args type-args
	spec-impls spec-impls
-== bool(a fun-inst-key, b fun-inst-key)
-hash nat(a fun-inst-key)
	state hash-state = ()
	hash a.type-args, state
	hash a.spec-impls, state
	finish state
-memoizer-key fun-inst-key(a fun-inst)
	a.type-args, a.spec-impls
== bool(a fun-inst, b fun-inst)
	trusted a 'reference-equal b
hash void(a fun-inst, state hash-state) # TODO: would this be faster if fun-inst had an ID? -------------------------------------
	hash a.decl, state
	hash a.type-args, state
	hash a.spec-impls, state
to json(a fun-inst)
	decl: a.decl.name.to
	type-args: a.type-args.to
	spec-impls: a.spec-impls.to
arity nat(a fun-inst)
	a.decl.arity

| Represents calling the n'th signature on this function's {specs}
called-spec-sig record
	index-in-specs nat
	containing-spec spec-decl
	non-instantiated-sig signature
	return-type type
	param-types type[]
new called-spec-sig
	index-in-specs nat
	containing-spec spec-decl
	non-instantiated-sig signature
	sig return-and-param-types
do
	index-in-specs, containing-spec, non-instantiated-sig, sig.return-type, sig.param-types
== bool(a called-spec-sig, b called-spec-sig)
	res = a.index-in-specs == b.index-in-specs and a.containing-spec == b.containing-spec
	if res
		assert a.non-instantiated-sig == b.non-instantiated-sig
		assert a.return-type == b.return-type
		assert a.param-types == b.param-types
	res
hash void(a called-spec-sig, state hash-state)
	hash a.index-in-specs, state
	hash a.containing-spec, state
	hash a.non-instantiated-sig.name, state
	hash a.return-type, state
	hash a.param-types, state
to json(a called-spec-sig)
	index-in-specs: a.index-in-specs.to
	spec_: a.containing-spec.name.to
	sig: a.non-instantiated-sig.name.to
	return-type: a.return-type.to
	param-types: a.param-types.to
instantiated-sig return-and-param-types(a called-spec-sig)
	a.return-type, a.param-types
module-uri uri(a called-spec-sig)
	a.non-instantiated-sig.module-uri
name symbol(a called-spec-sig)
	a.non-instantiated-sig.name
name-range uri-and-range(a called-spec-sig)
	a.non-instantiated-sig.name-range
arity nat(a called-spec-sig)
	a.non-instantiated-sig.params.size
n-type-params nat(_ called-spec-sig)
	0
type-param-asts type-params(_ called-spec-sig)
	()
doc-comment doc-comment(a called-spec-sig)
	a.non-instantiated-sig.doc-comment

| Like {called}, but not fully instantiated.
called-decl union(fun-decl, called-spec-sig)
	module-uri uri()
	n-type-params nat()
	type-param-asts type-params()
	return-type type()
	param-types type[]()
	arity nat()
	doc-comment doc-comment()
	name symbol()
	hash void(state hash-state)
== bool(a called-decl, b called-decl)

to json(a called-decl)
	match a
	as fun-decl
		a.name.to
	as called-spec-sig
		a.name.to
range uri-and-range(a called-decl)
	match a
	as fun-decl
		a.range
	as called-spec-sig
		a.non-instantiated-sig.range

called union(called-bogus, fun-inst, called-spec-sig)
	return-type type()
	param-types type[]()
	arity nat()
	hash void(state hash-state)
== bool(a called, b called)
to json(a called)
called-bogus record(decl called-decl, return-type type, param-types type[])
== bool(a called-bogus, b called-bogus)
hash void(a called-bogus, state hash-state)
	hash a.decl, state
	hash a.return-type, state
	hash a.param-types, state
to json(a called-bogus)
arity nat(a called-bogus)
	a.decl.arity

called-decl called-decl(a called)
	match a
	as called-bogus
		a.decl
	as fun-inst
		a.decl
	as called-spec-sig
		a
name symbol(a called)
	a.called-decl.name

struct-or-alias union(struct-alias, struct-decl)
	range uri-and-range()
	name-range uri-and-range()
	visibility visibility()
	name symbol()
	n-type-params nat()
	type-param-asts type-params()

| There is no 'var-inst' since these can't be templates
