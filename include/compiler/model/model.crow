) mut
	range source-range()
start pos(a expr)
	a.range start
end pos(a expr)
	a.range end

type-is-bogus bool(a expr)
	a.type-not-common is-bogus
type-not-common type(a expr) trusted
	res = a type gc-safe-value
	if x ?= res struct-inst
		assert x !reference-equal gc-safe-value
	res
type type(a expr, common-types common-types)
	match a
	as assert-or-forbid-expr _
		common-types.void to
	as bogus-call-expr x
		x expected-type
	as bogus-expr x
		x expected-type
	as bogus-wrong-type-expr x
		x expected-type
	as call-expr x
		x type
	as call-option-expr x
		x.type to
	as closure-get-expr x
		x type
	as closure-set-expr _
		common-types.void to
	as extern-expr _
		common-types.bool to
	as finally-expr x
		x type common-types
	as fun-pointer-expr x
		x.type to
	as if-expr x
		x type common-types
	as lambda-expr x
		x.type to
	as let-expr x
		x type common-types
	as literal-float-expr x
		x type common-types to
	as literal-integral-expr x
		x type common-types to
	as literal-string-like-expr x
		x type common-types to
	as local-get-expr x
		x type
	as local-pointer-expr x
		x.type to
	as local-set-expr _
		common-types.void to
	as loop-expr x
		x type
	as loop-break-expr x
		x.loop_ type
	as loop-continue-expr x
		x.loop_ type
	as loop-while-or-until-expr _
		common-types.void to
	as match-enum-expr x
		x type common-types
	as match-integral-expr x
		x type common-types
	as match-string-like-expr x
		x type common-types
	as match-sum-type-expr x
		x type common-types
	as record-field-pointer-expr x
		x.type to
	as seq-expr x
		x type common-types
	as throw-expr x
		x type
	as trusted-expr x
		x type common-types
	as try-expr x
		x type common-types
	as try-let-expr x
		x type common-types
	as typed-expr x
		x type common-types

condition union(expr, unpack-option) mut
unpack-option record(destructure destructure, option expr) mut
extern-condition record
	is-negated bool
	| If isNegated is set, this means !(x && y && ...)
	required-externs symbol-set
eval-extern-condition bool(a extern-condition, all-externs symbol-set)
	a.is-negated xor (a.required-externs is-subset-of all-externs)
as-extern extern-condition?(a condition)
	if x ?= a expr
		x as-extern
-as-extern extern-condition?(a expr)
	e = a skip-trusted
	if call ?= e call-expr
		if call.called is-and
			assert call.args.size == 2
			if arg0 ?= call.args[0] as-extern
				if arg1 ?= call.args[1] as-extern
					if arg0 !is-negated && arg1 !is-negated
						(false, arg0.required-externs | arg1.required-externs),
		elif call.called is-not
			if names ?= call.args.only.skip-trusted as-extern-expr
				(true, names),
	elif names ?= e as-extern-expr
		(false, names),
-is-and bool(a called)
	a is-builtin-fun fun =>
		if l ?= fun builtin-binary-lazy
			l == bool-and
-is-not bool(a called)
	a is-builtin-fun fun =>
		if l ?= fun builtin-unary
			l == not
-is-builtin-fun bool(a called, cb bool data(x builtin-fun))
	if fun ?= a fun-inst
		fun.decl.body is-builtin-fun cb
-is-builtin-fun bool(a fun-body, cb bool data(x builtin-fun))
	if x ?= a builtin-fun
		cb[x]
-as-extern-expr symbol-set?(a expr)
	a.extern-expr?.names
-skip-trusted expr(a expr)
	if x ?= a trusted-expr
		x inner
	else
		a

assert-or-forbid-expr record mut
	ast assert-or-forbid-ast
	is-forbid bool
	condition condition
	thrown expr?
	after expr
range source-range(a assert-or-forbid-expr)
	a.ast range
default-assert-or-forbid-message string(cur-uri uri, a assert-or-forbid-expr, content file-content-getters)
	prefix string, range source-range = match a.ast condition
	as expr-ast condition
		(a.is-forbid ? "Forbidden expression is true: " : "Asserted expression is false: "), condition.range
	as unpack-option-ast unpack
		(a.is-forbid ? "Forbidden option is non-empty: " : "Asserted option is empty: "), unpack.option.range
	prefix ~~ content[cur-uri, range]

bogus-expr record(range source-range, expected-type type) mut

| Wraps an expression that has an invalid type.
bogus-wrong-type-expr record(inner expr, expected-type type) mut
range source-range(a bogus-wrong-type-expr)
	a.inner range

call-expr-source union(
	arrow-access-ast,
	assignment-ast,
	assignment-call-ast,
	call-ast,
	call-named-ast,
	empty-ast,
	for-ast,
	if-ast,
	interpolated-ast,
	loop-break-ast,
	loop-continue-ast,
	name-and-range,
	with-ast
)
	range source-range()
name-range source-range(a call-expr-source)
	match a
	as arrow-access-ast x
		x.name range
	as assignment-ast x
		x.left range
	as assignment-call-ast x
		x.fun-name range
	as call-ast x
		x name-range
	as call-named-ast x
		x range
	as empty-ast x
		x range
	as for-ast x
		x for-keyword-range
	as if-ast x
		x first-keyword-range
	as interpolated-ast x
		x range
	as loop-break-ast x
		x range
	as loop-continue-ast x
		x range
	as name-and-range x
		x range
	as with-ast x
		x with-keyword-range

bogus-call-expr record mut
	ast call-expr-source
	candidates called-decl[]
	| Note: It may have given up on checking arguments.
	checked-args expr[]
	expected-type type
range source-range(a bogus-call-expr)
	a.ast range

call-expr record(ast call-expr-source, called called, args expr[]) mut
range source-range(a call-expr)
	a.ast range
type type(a call-expr)
	a.called return-type

| Expression for 'x?.y' or 'x?[y]'
call-option-expr record mut
	ast call-ast
	| May or may not return an option. If not it will be wrapped after calling.
	called called
	| The first arg is an option which is unwrapped before calling. The rest are non-optional.
	all-args expr[]
	| If 'called.returnType' is not an option, this wraps it in an option.
	type struct-inst
range source-range(a call-option-expr)
	a.ast range
wraps-return-as-option bool(a call-option-expr)
	a.called.return-type != a.type.to
first-arg expr(a call-option-expr)
	a.all-args[0]
rest-args expr[](a call-option-expr)
	a.all-args[1 .. end]

closure-get-expr record(range source-range, closure-ref closure-ref) mut
type type(a closure-get-expr)
	a.local type
local local(a closure-get-expr)
	a.closure-ref local

closure-set-expr record(assignee-range source-range, closure-ref closure-ref, value expr) mut
range source-range(a closure-set-expr)
	a.assignee-range combine-ranges a.value.range
local local(a closure-set-expr)
	a.closure-ref local

extern-expr record(ast extern-ast, names symbol-set)
range source-range(a extern-expr)
	a.ast range

builtin-extern enum
	DbgHelp
	fake
	js
	libc
	linux
	native
	posix
	pthread
	sodium
	ucrtbase
	unwind
	windows
to builtin-extern?(a symbol)
is-builtin-extern bool(a symbol)
	a.to::builtin-extern? !is-empty

finally-expr record(ast finally-ast, right expr, below expr) mut
range source-range(a finally-expr)
	a.ast range
type type(a finally-expr, common-types common-types)
	a.below type common-types

fun-pointer-expr record(ast ptr-ast, called called, type struct-inst) mut
range source-range(a fun-pointer-expr)
	a.ast range

| Expression for an IfAst -- see that for all kinds of syntax this corresponds to
if-expr record mut
	ast if-ast
	condition condition
	true-branch expr
	false-branch expr
range source-range(a if-expr)
	a.ast range
first-branch expr(a if-expr)
	a.ast is-condition-negated ? a false-branch : a true-branch
second-branch expr(a if-expr)
	a.ast is-condition-negated ? a true-branch : a false-branch
type type(a if-expr, common-types common-types)
	assert (a.true-branch type common-types) == (a.false-branch type common-types)
	a.true-branch type common-types

lambda-source union(for-ast, lambda-ast, with-ast)
	param destructure-ast()
	range source-range()

lambda-expr record mut
	ast lambda-source
	kind lambda-kind
	param destructure
	mut-type-for-explicit-shared struct-inst?
	body expr
	closure variable-ref[]
	type struct-inst
lambda-kind enum(data_, shared_, mut_, explicit-shared)
== bool(a lambda-kind, b lambda-kind)
range source-range(a lambda-expr)
	a.ast range
return-type type(a lambda-expr)
	a.type.type-args[0]
| We don't know whether this lambda is for the main body or for the optional 'else'.
| But if it is from the `else`, this function will return true.
is-ignore bool(a lambda-expr)
	if x ?= a.param destructure-ignore
		x.source.void-destructure-ast !is-empty

let-expr record(ast let-ast, destructure destructure, value expr, then expr) mut
range source-range(a let-expr)
	a.destructure.start, a.then.end
type type(a let-expr, common-types common-types)
	a.then type common-types

literal-float-expr record(range source-range, float-type float-type, value float)
type struct-inst(a literal-float-expr, common-types common-types)
	common-types[a float-type]

literal-integral-expr record
	range source-range
	integral-type char-or-integral-type
	value integral-value
is-signed bool(a literal-integral-expr)
	a.integral-type is-signed
type struct-inst(a literal-integral-expr, common-types common-types)
	common-types[a integral-type]

literal-string-like-expr record
	range source-range
	string-type string-like-type
	| For char32-array, this will be decoded in concretize.
	value string
string-like-type enum(char8-array, char32-array, c-string, js-any, string, symbol)
type struct-inst(a literal-string-like-expr, common-types common-types)
	common-types[a string-type]

local-get-expr record(range source-range, local local) mut
type type(a local-get-expr)
	a.local type

local-pointer-expr record(ast ptr-ast, local local, type struct-inst) mut
range source-range(a local-pointer-expr)
	a.ast range

local-set-expr record(assignee-range source-range, local local, value expr) mut
range source-range(a local-set-expr)
	a.assignee-range combine-ranges a.value.range

loop-expr record(ast loop-ast, type type, body expr) mut
range source-range(a loop-expr)
	a.ast range

loop-break-expr record(ast loop-break-ast, loop_ loop-expr, value expr) mut
range source-range(a loop-break-expr)
	a.ast range
loop-continue-expr record(ast loop-continue-ast, loop_ loop-expr) mut
range source-range(a loop-continue-expr)
	a.ast range

loop-while-or-until-expr record mut
	ast loop-while-or-until-ast
	condition condition
	| Always of type `void`
	body expr
	after expr
is-until bool(a loop-while-or-until-expr)
	a.ast is-until
range source-range(a loop-while-or-until-expr)
	a.ast range

match-enum-expr record mut
	ast match-ast
	matched expr
	cases match-enum-case[]
	else_ expr?
match-enum-case record(member enum-or-flags-member, then expr) mut
range source-range(a match-enum-expr)
	a.ast range
type type(a match-enum-expr, common-types common-types)
	if x ?= a else_
		x type common-types
	else
		a.cases[0].then type common-types
enum-type struct-inst(a match-enum-expr)
	a.matched.type-not-common.struct-inst!
enum_ struct-decl(a match-enum-expr)
	inst = a enum-type
	assert inst.type-args is-empty
	res = inst decl
	assert a.cases every x => x.member.containing-enum == res
	res
enum-body enum_(a match-enum-expr)
	a.enum_.body enum_!

match-integral-expr record mut
	ast match-ast
	integral-type char-or-integral-type
	matched expr
	cases match-integral-case[]
	else_ expr
match-integral-case record(value integral-value, then expr) mut
range source-range(a match-integral-expr)
	a.ast range
type type(a match-integral-expr, common-types common-types)
	a.else_ type common-types
matched-type struct-inst(a match-integral-expr)
	a.matched.type-not-common struct-inst!

match-string-like-expr record mut
	ast match-ast
	string-type string-like-type
	matched expr
	| `==` function for the type
	equals called
	cases match-string-like-case[]
	else_ expr
match-string-like-case record(value string, then expr) mut
range source-range(a match-string-like-expr)
	a.ast range
type type(a match-string-like-expr, common-types common-types)
	a.else_ type common-types
matched-type struct-inst(a match-string-like-expr)
	a.matched.type-not-common struct-inst!

match-sum-type-expr record mut
	ast match-ast
	matched expr
	cases match-sum-type-case[]
	else_ expr?
match-sum-type-case record(destructure destructure, then expr) mut
case-type struct-inst(a match-sum-type-case)
	a.destructure.type struct-inst!
range source-range(a match-sum-type-expr)
	a.ast range
type type(a match-sum-type-expr, common-types common-types)
	if x ?= a else_
		x type common-types
	else
		a.cases[0].then type common-types
sum-type struct-inst(a match-sum-type-expr)
	a.matched.type-not-common struct-inst!
sum-type-body sum-type(a match-sum-type-expr)
	a.sum-type.decl.body sum-type!
is-union bool(a match-sum-type-expr)
	match a.sum-type-body kind
	as interface_
		throw unreachable
	as union_
		true
	as variant_
		false

record-field-pointer-expr record mut
	ast ptr-ast
	| This will be a pointer or by-ref type
	target expr
	field record-field
	type struct-inst
range source-range(a record-field-pointer-expr)
	a.ast range
record-decl struct-decl(a record-field-pointer-expr)
	target-type = a.target.type-not-common struct-inst!
	if target-type.decl is-pointer-const-or-mut
		target-type.pointee-type.struct-inst! decl
	else
		target-type decl
field-index nat(a record-field-pointer-expr)
	a.record-decl.body.record_!.fields must-have-index-of-pointer a.field

seq-expr record(first expr, then expr) mut
range source-range(a seq-expr)
	a.first.start, a.then.end
type type(a seq-expr, common-types common-types)
	a.then type common-types

throw-expr record(ast throw-ast, thrown expr, type type) mut
range source-range(a throw-expr)
	a.ast range

trusted-expr record(ast trusted-ast, inner expr) mut
range source-range(a trusted-expr)
	a.ast range
type type(a trusted-expr, common-types common-types)
	a.inner type common-types

try-expr record(ast try-ast, tried expr, catches match-sum-type-case[]) mut
range source-range(a try-expr)
	a.ast range
type type(a try-expr, common-types common-types)
	a.tried type common-types

try-let-expr record mut
	ast try-let-ast
	destructure destructure
	value expr
	catch_ match-sum-type-case
	then expr
range source-range(a try-let-expr)
	a.ast range
type type(a try-let-expr, common-types common-types)
	a.then type common-types

typed-expr record(ast typed-ast, inner expr) mut
range source-range(a typed-expr)
	a.ast range
type type(a typed-expr, common-types common-types)
	a.inner type common-types

export-visibility enum(internal, public)
== bool(a export-visibility, b export-visibility)
<=> comparison(a export-visibility, b export-visibility)
to export-visibility(a visibility)
	match a
	as private
		throw unreachable
	as internal
		internal
	as public
		public

import-can-see bool(import-visibility export-visibility, export-visibility visibility)
	export-visibility.to::export-visibility >= import-visibility

least-visibility visibility(a visibility, b visibility)
	a min b
greatest-visibility visibility(a visibility, b visibility)
	a max b

called-and-name-range record(called called, name-range source-range) mut
get-called-at-expr called-and-name-range?(a expr)
	match a
	as call-expr x
		(x.called, x.ast.name-range),
	as call-option-expr x
		(x.called, x.ast.name-range),
	as fun-pointer-expr x
		(x.called, x.ast.range),
	else
		()

each-descendent-expr-including void(a expr, cb void mut(x expr))
	cb[a]
	a each-descendent-expr-excluding cb
each-descendent-expr-excluding void(a expr, cb void mut(x expr))
	a each-direct-child-expr x =>
		x each-descendent-expr-including cb
each-direct-child-expr void(a expr, cb void mut(x expr))
	res bool? = a find-direct-child-expr x =>
		cb[x]
		()
	assert res is-empty

find-direct-child-expr[t] t?(a expr, cb t? mut(x expr))
	match a
	as assert-or-forbid-expr x
		cb[x.condition direct-child-in-condition] || x.thrown cb-option cb || cb[x after]
	as bogus-call-expr _
		()
	as bogus-expr _
		()
	as bogus-wrong-type-expr x
		cb[x inner]
	as call-expr x
		x.args first cb
	as call-option-expr x
		x.all-args first cb
	as closure-get-expr _
		()
	as closure-set-expr x
		cb[x value]
	as extern-expr _
		()
	as finally-expr x
		cb[x right] || cb[x below]
	as fun-pointer-expr _
		()
	as if-expr x
		cb[x.condition direct-child-in-condition] || cb[x first-branch] || cb[x second-branch]
	as lambda-expr x
		cb[x body]
	as let-expr x
		cb[x value] || cb[x then]
	as literal-float-expr _
		()
	as literal-integral-expr _
		()
	as literal-string-like-expr _
		()
	as local-get-expr _
		()
	as local-pointer-expr _
		()
	as local-set-expr x
		cb[x value]
	as loop-expr x
		cb[x body]
	as loop-break-expr x
		cb[x value]
	as loop-continue-expr _
		()
	as loop-while-or-until-expr x
		cb[x.condition direct-child-in-condition] || cb[x body] || cb[x after]
	as match-enum-expr x
		cb[x matched] || (x.cases first y => cb[y then]) || x.else_ cb-option cb
	as match-integral-expr x
		cb[x matched] || (x.cases first y => cb[y then]) || cb[x else_]
	as match-string-like-expr x
		cb[x matched] || (x.cases first y => cb[y then]) || cb[x else_]
	as match-sum-type-expr x
		cb[x matched] || x.cases direct-child-in-match-sum-type-cases cb || x.else_ cb-option cb
	as record-field-pointer-expr x
		cb[x target]
	as seq-expr x
		cb[x first] || cb[x then]
	as throw-expr x
		cb[x thrown]
	as trusted-expr x
		cb[x inner]
	as try-expr x
		cb[x tried] || x.catches direct-child-in-match-sum-type-cases cb
	as try-let-expr x
		cb[x value] || cb[x.catch_ then] || cb[x then]
	as typed-expr x
		cb[x inner]
-direct-child-in-condition expr(a condition)
	match a
	as expr x
		x
	as unpack-option x
		x option
-direct-child-in-match-sum-type-cases[t] t?(cases match-sum-type-case[], cb t? mut(x expr))
	cases first x => cb[x then]

sum-type-member-getter fun-decl(funs fun-decl[], struct struct-decl, x sum-type-membership)
	funs must-find-fun-named struct.name, fun =>
		if _ ?= fun.body sum-type-member-get
			fun.params.params-array.only.type == x.sum-type.to &&
			fun.source.struct-decl! == struct
method-caller fun-decl(program program, a signature)
	program module-at-uri a.module-uri must-find-fun-named a.name, fun =>
		if x ?= fun.source signature
			trusted x reference-equal a

must-find-fun-named fun-decl(module module, name symbol, cb bool mut(x fun-decl))
	module.funs must-find-fun-named name, cb
must-find-fun-named fun-decl(funs fun-decl[], name symbol, cb bool mut(x fun-decl))
	funs must-find fun => fun.name == name && cb[fun]

| In the CLI, we omit diagnostics if there are other more severe ones.
| So e.g., you wouldn't see unused code errors if there are parse errors.
diagnostic-severity enum
	unused-code
	warning
	check-error
	name-not-found
	| Severe error where a common fun (e.g. 'alloc', 'main') or type (e.g. 'void') is missing
	common-missing
	parse-error
	import-error
== bool(a diagnostic-severity, b diagnostic-severity)
is-fatal bool(a diagnostic-severity)
	a == common-missing || a == parse-error || a == import-error

uri-and-diagnostic record(uri uri, diagnostic diagnostic) mut
new uri-and-diagnostic(range uri-and-range, kind diag)
	range.uri, (range.range, kind)
where uri-and-range(a uri-and-diagnostic)
	a.uri, a.diagnostic.range
kind diag(a uri-and-diagnostic)
	a.diagnostic kind

diagnostic record(range source-range, kind diag) mut

