	kind logical-expr-kind
	type type
	left expr
	right expr
to json(a logical-expr)
	kind: a.kind.to
	left: a.left.to
	right: a.right.to
logical-expr-kind enum
	bool-and-bool
	bool-or-bool
	option-else
	option-or
== bool(a logical-expr-kind, b logical-expr-kind)
to json(a logical-expr-kind)
keyword-range source-range(a logical-expr)
	a.ast.keyword-range
range source-range(a logical-expr)
	a.ast.range

loop-expr record force-data
	ast loop-ast
	type type
	body mut expr
to json(a loop-expr)
range source-range(a loop-expr)
	a.ast.range

loop-break-expr record(ast loop-break-ast, loop_ loop-expr, value expr)
to json(a loop-break-expr)
	value: a.value.to
range source-range(a loop-break-expr)
	a.ast.range
keyword-range source-range(a loop-break-expr)
	a.ast.keyword-range
loop-continue-expr record(ast loop-continue-ast, loop_ loop-expr)
to json(_ loop-continue-expr)
	null
range source-range(a loop-continue-expr)
	a.ast.range

loop-while-or-until-expr record
	ast loop-while-or-until-ast
	condition expr
	| Always of type 'void'
	body expr
	after expr?
to json(a loop-while-or-until-expr)
	condition: a.condition.to
	body: a.body.to
	after: a.after.to
is-until bool(a loop-while-or-until-expr)
	a.ast.is-until
range source-range(a loop-while-or-until-expr)
	a.ast.range

match-enum-expr record
	ast match-ast
	matched-local local?
	matched expr
	cases match-enum-case[]
	else_ expr?
	type type
to json(a match-enum-expr)
	matched: a.matched.to
	cases: a.cases.to
	else: a.else_.to
match-enum-case record(member enum-or-flags-member, then_ expr)
to json(a match-enum-case)
	member: a.member.name.to
	then: a.then_.to
range source-range(a match-enum-expr)
	a.ast.range
enum-type struct-inst(a match-enum-expr)
	a.matched.type-not-common.struct-inst!

match-scalar-expr record
	ast match-ast
	integral-type char-or-integral-type
	matched-local local?
	matched expr
	cases match-scalar-case[]
	else_ expr
	type type
to json(a match-scalar-expr)
	integral-type: a.integral-type.to
	matched: a.matched.to
	cases: a.cases.to
	else: a.else_.to
match-scalar-case record(value scalar-value, then_ expr)
to json(a match-scalar-case)
range source-range(a match-scalar-expr)
	a.ast.range
matched-type struct-inst(a match-scalar-expr)
	a.matched.type-not-common.struct-inst!

match-string-like-expr record
	ast match-ast
	string-type string-like-type
	matched-local local?
	matched expr
	| '==' function for the type
	equals called
	cases match-string-like-case[]
	else_ expr
	type type
to json(a match-string-like-expr)
	matched: a.matched.to
	cases: a.cases.to
	else: a.else_.to
match-string-like-case record(value string, then_ expr)
to json(a match-string-like-case)
range source-range(a match-string-like-expr)
	a.ast.range
matched-type struct-inst(a match-string-like-expr)
	a.matched.type-not-common.struct-inst!

match-sum-type-expr record
	ast match-ast
	matched-local local?
	matched expr
