spec-inst record force-data, -new
	decl spec-decl
	type-args type-args
	| This includes builtin parents
	builtin_ mut (builtin-spec, type)[]
	| This includes signatures from parents
	all-sigs mut signature[]
	| Corresponds to all-sigs
	sig-types mut return-and-param-types[]
get-or-add-spec-inst (spec-inst, bool)(decl spec-decl, type-args type[])
	types type-array = type-args to
	did-add mut = false
	res = trusted decl.insts memoize types, () =>
		did-add := true
		decl, types, (), (), ()
	res, did-add
-memoizer-key type-args(a spec-inst)
	a type-args
== bool(a spec-inst, b spec-inst) trusted
	a reference-equal b
hash-mix void(hasher hasher, a spec-inst)
	# TODO: just use identity ------------------------------------------------------------------------------------------------------
	hasher hash-mix a.decl
	hasher hash-mix a.type-args
