import
	crow/unsafe
	../../crow/col/experimental/object-memoizer
	../util/enum-map
	../util/by-name
	../util/util
	./ast
	./integral-values
	./parse-diag
	./source-range
	./uri
	./version-info

purity enum(data_, shared_, mut_)
== bool(a purity, b purity)
<=> comparison(a purity, b purity)
to symbol(a purity)
	match a
	as data_
		"data"
	as shared_
		"shared"
	as mut_
		"mut"
to string(a purity)
	a.to to
to json(a purity)
	a.to::string to

is-purity-compatible bool(expected purity, actual purity)
	actual <= expected

purity-range record(best-case purity, worst-case purity)

-combine-purity-range purity-range(a purity-range, b purity-range)
	(a.best-case worse-purity b.best-case), (a.worst-case worse-purity b.worst-case)

is-purity-always-compatible bool(referencer purity, referenced purity-range)
	referenced.worst-case <= referencer
is-purity-always-compatible bool(referencer purity-range, referenced purity)
	referenced <= referencer.best-case
is-purity-possibly-compatible bool(referencer purity, referenced purity-range)
	referenced.best-case <= referencer

worse-purity purity(a purity, b purity)
	a max b

-type-arrays global((type-array, type-array-key) object-memoizer)
-type-params-type-arrays global(type-array[])
	for n : 0::nat .. 10 # TODO: use lang/max-type-args here --------------------------------------------------------------------
		(for i : 0::nat .. n; i type-param-index)::type[] to
-spec-arrays global((specs, specs-key) object-memoizer)

to type-array(type type)
	(type,) to
to type-array(types type[])
	guard types !is-empty
	hash = types get-hash
	trusted type-arrays memoize (types, hash), () => types, hash
type-array record
	inner type[]
	hash nat
-type-array-key record
	inner type[]
	hash nat
-== bool(a type-array-key, b type-array-key)
	a.inner == b.inner
-memoizer-key type-array-key(a type-array)
	a.inner, a.hash
new type-array()
	(), 0
is-empty bool(a type-array)
	a.inner is-empty # TODO:PERF could do 'a reference-equal ()' -------------------------------------------------------------------
size nat(a type-array)
	a.inner size
subscript type(a type-array, index nat)
	a.inner[index]
subscript type array-view(a type-array, indices nat range)
	a.inner[indices]
== bool(a type-array, b type-array)
	trusted a.inner reference-equal b.inner
hash-mix void(hasher hasher, a type-array)
	hasher hash-mix a.hash
to json(a type-array)
	a.inner to
-type-params-type-array type-array(n nat)
	trusted type-params-type-arrays[n]

type-params alias
	name-and-range[]
type-args alias # TODO: this is silly to have two names for the same ytpe --------------------------------------------------------
	type-array
| This could be the same object as a 'type-args', even though they have different meaning
return-and-param-types alias
	type[]
return-type type(a return-and-param-types)
	a[0]
param-types type array-view(a return-and-param-types)
	a[1 .. end]
# It doesn't seem to be worth memoizing these
spec-impls alias
	called[]
specs record -new
	inner spec-inst[]
	hash nat
	all-builtin (builtin-spec, type)[]
	instantiated-sigs called-spec-sig[]
new specs()
	(), 0, (), ()
is-empty bool(a specs)
	res = a.inner is-empty # TODO:PERF could do 'a reference-equal ()' -------------------------------------------------------------------
	assert res == trusted a reference-equal ()
	res
-specs-key record # TODO: move this to all-insts.crow? -----------------------------------------------------------------------------
	inner spec-inst[]
	hash nat
-== bool(a specs-key, b specs-key)
	a.inner == b.inner
-memoizer-key specs-key(a specs)
	a.inner, a.hash
get-or-add-specs specs(specs spec-inst[])
	guard specs !is-empty
	hash = do
		hasher hasher = ()
		hasher hash-mix specs
		hasher finish
	trusted spec-arrays memoize (specs, hash), () =>
		inner: specs
		hash: hash
		all-builtin: for x : specs and-concat; x builtin_
		instantiated-sigs: do
			index mut nat = 0
			for x : specs and-concat
				for sig, sig-type : x.all-sigs zip x.sig-types
					res called-spec-sig = index, x.decl, sig, sig-type
					index +:= 1
					res

type union(bogus-type, type-param-index, struct-inst)
== bool(a type, b type)
	trusted a reference-equal b
<=> comparison(_ type, _ type)
	throw todo
to json(a type)
bogus-type record
== bool(a bogus-type, b bogus-type)
<=> comparison(a bogus-type, b bogus-type)
hash-mix void(hasher hasher, a type)
	if trusted extern java
		hasher hash-mix a.identity-hash # TODO: Is this actually any faster than the below? ---------------------------------------
	else
		match a
		as bogus-type
			()
		as type-param-index x
			hasher hash-mix x.index
		as struct-inst x
			hasher hash-mix x
to json(a bogus-type)
| Represent type parameter as the index, so we don't generate different types for every 't[]'.
| (These are disambiguated in the type checker using 'type-and-context')
type-param-index record
	-index_ nat
	-dummy nat # TODO: this is needed to force this type to be wrapped and not use 'nat' directly. I should have an 'identity' modifier for that........
index nat(a type-param-index)
	a index_
new type-param-index(index nat)
	# This silly-looking code ensures that each type-param-index value is a compile-time constant, avoiding runtime allocation
	match index
	as 0
		0, 0
	as 1
		1, 1
	as 2
		2, 2
	as 3
		3, 3
	as 4
		4, 4
	as 5
		5, 5
	as 6
		6, 6
	as 7
		7, 7
	as 8
		8, 8
	as 9
		9, 9
	as 10
		10, 10
	as 11
		11, 11
	as 12
		12, 12
	as 13
		13, 13
	as 14
		14, 15
	as 15
		15, 15
	else
		throw unreachable
type-param-index type(index nat) # TODO: RM? (rely on builtin syntax: `1, :: type-param-index`
	(index,)::type-param-index
type-param-index doc-comment-reference(index nat)
	(index,)::type-param-index
== bool(a type-param-index, b type-param-index)
	trusted a reference-equal b
<=> comparison(a type-param-index, b type-param-index)
to json(a type-param-index)
	a.index to

debug string(a type)
	match a
	as bogus-type
		"<<bogus>>"
	as type-param-index x
		"t{x index}"
	as struct-inst x
		x debug
debug string(a struct-inst)
	name = a.decl name
	if a.type-args is-empty
		"{name}"
	else
		"{a.type-args debug-type-args} {name}"
debug-type-args string(a type-args)
	args string[] = for x : a inner; x debug
	match args size
	as 0
		""
	as 1
		args only
	else
		"({", " join args}) "

is-bogus bool(a type)
	a.bogus-type !is-empty

is-empty-type bool(a type)
	if x ?= a struct-inst
		x is-empty-type
is-empty-type bool(a struct-inst)
	a.decl is-void || a.decl is-empty-record
-is-empty-record bool(a struct-decl)
	if x ?= a.body record_
		x.fields is-empty

is-enum bool(a type)
	if x ?= a struct-inst
		x.decl.body.enum_ !is-empty
is-flags bool(a type)
	if x ?= a struct-inst
		x.decl.body.flags_ !is-empty

is-array bool(a type)
	a is-builtin-type array
is-mut-array bool(a type)
	a is-builtin-type mut-array
is-mut-array bool(a struct-inst)
	a is-builtin-type mut-array
is-mut-slice bool(a type)
	a is-builtin-type mut-slice
is-array-or-mut-slice bool(a type)
	a is-builtin-type array || a is-builtin-type mut-slice
is-array-or-mut-slice bool(a struct-decl)
	a is-builtin-type array || a is-builtin-type mut-slice

is-tuple bool(common-types common-types, a type)
	if x ?= a struct-inst
		common-types is-tuple x.decl
is-tuple bool(common-types common-types, a struct-decl)
	if actual ?= common-types tuple a.n-type-params
		actual == a

as-tuple type-args?(common-types common-types, type type)
	if common-types is-tuple type
		type.struct-inst! type-args

is-bool bool(a type)
	a is-builtin-type bool
is-char8 bool(a type)
	a is-builtin-type char8
is-char32 bool(a type)
	a is-builtin-type char32
is-float32 bool(a type)
	a is-builtin-type float32
is-float64 bool(a type)
	a is-builtin-type float64
is-future bool(a type)
	a is-builtin-type future
is-future bool(a struct-inst)
	a is-builtin-type future
is-int8 bool(a type)
	a is-builtin-type int8
is-int16 bool(a type)
	a is-builtin-type int16
is-int32 bool(a type)
	a is-builtin-type int32
is-int64 bool(a type)
	a is-builtin-type int64
is-java-any bool(a type)
	a is-builtin-type java-any
is-js-any bool(a type)
	a is-builtin-type js-any
is-js-any bool(a struct-decl)
	a is-builtin-type js-any
is-java-exclusion bool(a type)
	a is-builtin-type java-exclusion
is-nat8 bool(a type)
	a is-builtin-type nat8
is-nat16 bool(a type)
	a is-builtin-type nat16
is-nat32 bool(a type)
	a is-builtin-type nat32
is-nat64 bool(a type)
	a is-builtin-type nat64
is-void bool(a type)
	a is-builtin-type void
is-void bool(a struct-decl)
	a is-builtin-type void
is-weak-ref bool(a type)
	a is-builtin-type weak-ref
is-weak-ref bool(a struct-decl)
	a is-builtin-type weak-ref

is-integral-type bool(a type)
	a.as-integral-type !is-empty
as-integral-type integral-type?(a type)
	if builtin_ ?= a as-builtin-type
		builtin_ to

-is-builtin-type bool(a type, builtin_ builtin-type)
	if x ?= a struct-inst
		x is-builtin-type builtin_
-is-builtin-type bool(a struct-inst, builtin_ builtin-type)
	a.decl is-builtin-type builtin_
-is-builtin-type bool(a struct-decl, builtin_ builtin-type)
	if x ?= a.body builtin-type
		x == builtin_
-as-builtin-type builtin-type?(a type)
	if x ?= a struct-inst
		x.decl.body builtin-type

array-element-type type?(a type)
	if a is-array
		a.struct-inst!.type-args only
mut-slice-element-type type?(a type)
	if a is-mut-slice
		a.struct-inst!.type-args only
array-or-mut-slice-element-type type?(a type)
	if a is-array-or-mut-slice
		a.struct-inst!.type-args only

try-unwrap-option-type type?(a type)
	if a is-option-type || a is-bogus
		a must-unwrap-option-type-or-bogus
must-unwrap-option-type-or-bogus type(a type)
	a is-bogus ? bogus-type : a must-unwrap-option-type
must-unwrap-option-type type(a type)
	assert a is-option-type
	a.struct-inst! must-unwrap-option-type
must-unwrap-option-type type(a struct-inst)
	assert a is-option-type
	a.type-args only

is-option-type bool(a type)
	a is-builtin-type option
is-option-type bool(a struct-inst)
	a is-builtin-type option
is-option-type bool(a struct-decl)
	a is-builtin-type option

is-lambda-type bool(a type)
	if x ?= a struct-inst
		x.decl is-lambda-type
is-lambda-type bool(a struct-decl)
	if x ?= a.body builtin-type
		x is-lambda

purity-range purity-range(a type)
	match a
	as bogus-type
		data_, data_
	as type-param-index _
		data_, mut_
	as struct-inst x
		x purity-range

best-case-purity purity(a type)
	a.purity-range best-case

params union(destructure[], varargs)
arity arity(a params)
	match a
	as array xs
		xs.size to
	as varargs _
		arity-varargs
varargs record(param destructure, element-type type) # TODO: can't element-type just be param.type.array-element-type ????????
is-empty bool(a params)
	a.arity is-empty

params-array destructure[](a params)
	match a
	as array x
		x
	as varargs x
		x.param,

assert-non-variadic destructure[](a params)
	a.array!

| This is logically a union(nat, arity-varargs), but just using a 'nat' for performance
arity record
	-value nat
is-variadic bool(a arity)
	a.value == max-value
to arity(a nat)
	forbid a == max-value
	a,
arity-varargs arity()
	max-value,
n-params nat(a arity)
	forbid a is-variadic
	a value

count-param-decls nat(a arity)
	a.is-variadic ? 1 : a.n-params
is-empty bool(a arity)
	a.value == 0
arity-matches bool(sig-arity arity, n-args nat)
	sig-arity.value == n-args || sig-arity is-variadic

signature-container union(spec-decl, struct-decl)
	module-uri uri()
	name symbol()
	type-param-asts type-params()
to type-container(a signature-container)
	match a
	as spec-decl x
		x
	as struct-decl x
		x

| Function signature without a body. Used in a spec or variant.
signature record force-data
	container signature-container
	ast signature-ast
	return-type type
	params destructure[]
	doc-comment-references mut doc-comment-references
== bool(a signature, b signature)
	a.range == b.range
name symbol(a signature)
	a.ast name
module-uri uri(a signature)
	a.container module-uri
range uri-and-range(a signature)
	a.module-uri, a.ast.range
name-range uri-and-range(a signature)
	a.module-uri, a.ast.name-and-range.range
doc-comment-ast doc-comment-ast(a signature)
	a.ast doc-comment
doc-comment doc-comment(a signature)
	a.doc-comment-ast, a.doc-comment-references
index-of-signature nat(a signature)
	match a container
	as spec-decl x
		x.sigs index-of! a
	as struct-decl x
		x.body.sum-type!.methods index-of! a

type-params-and-sig record
	type-params type-params
	return-type type
	params params-short
	count-specs nat
params-short union(param-short[], params-short-variadic)
params-short-variadic record(param param-short, element-type type)
param-short record(name symbol, type type)

record-field-source union(single-destructure-ast, record-field-ast)
	doc-comment doc-comment-ast()
	range source-range()
	name-range source-range()
name symbol(a record-field-source)
	match a
	as single-destructure-ast x
		x.name name
	as record-field-ast x
		x.name name

record-field record force-data
	source record-field-source
	containing-record struct-decl
	visibility visibility
	mutability visibility?
	type type
	doc-comment-references mut doc-comment-references
== bool(a record-field, b record-field)
	trusted a reference-equal b
module-uri uri(a record-field)
	a.containing-record module-uri
name symbol(a record-field)
	a.source name
range uri-and-range(a record-field)
	a.containing-record.module-uri, a.source.range
name-range uri-and-range(a record-field)
	a.module-uri, a.source.name-range
doc-comment-ast doc-comment-ast(a record-field)
	a.source doc-comment
doc-comment doc-comment(a record-field)
	a.doc-comment-ast, a.doc-comment-references

enum-member-source union(enum-or-flags-member-ast, single-destructure-ast)
	doc-comment doc-comment-ast()
	range source-range()
	name-range source-range()
== bool(a enum-member-source, b enum-member-source)
	a.range == b.range
name symbol(a enum-member-source)
	match a
	as enum-or-flags-member-ast x
		x name
	as single-destructure-ast x
		x.name name

enum-member alias
	enum-or-flags-member
enum-or-flags-member record force-data
	source enum-member-source
	containing-enum struct-decl
	value integral-value
	doc-comment-references mut doc-comment-references
== bool(a enum-or-flags-member, b enum-or-flags-member)
	a.source == b.source
<=> comparison(_ enum-or-flags-member, _ enum-or-flags-member)
	throw todo
hash-mix void(hasher hasher, a enum-or-flags-member)
	hasher hash-mix a.name
to json(a enum-or-flags-member)
	a.source.name to
storage_ integral-type(a enum-or-flags-member)
	match a.containing-enum body
	as enum_ x
		x storage_
	as flags_ x
		x storage_
	else
		throw unreachable
module-uri uri(a enum-or-flags-member)
	a.containing-enum module-uri
visibility visibility(a enum-or-flags-member)
	a.containing-enum visibility
name symbol(a enum-or-flags-member)
	a.source name
range uri-and-range(a enum-or-flags-member)
	a.containing-enum.module-uri, a.source.range
name-range uri-and-range(a enum-or-flags-member)
	a.module-uri, a.source.name-range
doc-comment-ast doc-comment-ast(a enum-or-flags-member)
	a.source doc-comment
doc-comment doc-comment(a enum-or-flags-member)
	a.doc-comment-ast, a.doc-comment-references

struct-body union(struct-body-bogus, builtin-type, enum_, struct-body-extern-java, flags_, record_, sum-type)
struct-body-bogus record
enum_ record
	storage_ integral-type
	members enum-or-flags-member[]
	members-by-name enum-or-flags-member by-name
struct-body-extern-java record(path path)
flags_ record(storage_ integral-type, members enum-or-flags-member[])
record_ record
	new-visibility visibility
	fields record-field[]
| interface, union, or variant
sum-type record
	kind sum-type-kind
	listed-members sum-type-member-and-method-impls[]
	methods signature[]
as-union sum-type-member-and-method-impls[](a struct-body)
	a.sum-type! as-union
as-union sum-type-member-and-method-impls[](a sum-type)
	assert a.kind == union_
	a listed-members

get-all-flags-value integral-value(body flags_)
	res mut nat = 0
	for member : body members
		res |:= member.value as-unsigned
	res,

builtin-type enum
	array
	bool
	char8
	char32
	float32
	float64
	future
	int8
	int16
	int32
	int64
	java-any
	java-exclusion
	js-any
	# TODO: call these 'lambda' (requires changing the name in the struct decl too) -----------------------------------------------
	fun-data
	fun-mut
	fun-shared
	mut-array
	mut-slice
	nat8
	nat16
	nat32
	nat64
	option
	void
	weak-ref
== bool(a builtin-type, b builtin-type)
to symbol(a builtin-type)
show string(a builtin-type)
	a.to::symbol to
to json(a builtin-type)
to builtin-type?(a symbol)
is-lambda-type bool(a builtin-type)
	match a
	as fun-data
		true
	as fun-mut
		true
	as fun-shared
		true
	else
		false
is-char-or-integral bool(a builtin-type)
	if _ ?= a.to::char-type?
		true
	elif _ ?= a.to::integral-type?
		true
is-char-or-integral bool(a type)
	guard b ?= a as-builtin-type
	b is-char-or-integral
to char-or-integral-type?(a builtin-type)
	if x ?= a.to :: char-type?
		x
	elif x ?= a.to :: integral-type?
		x
to char-type?(a builtin-type)
	match a
	as char8
		char8
	as char32
		char32
	else
		()
to float-type?(a builtin-type)
	match a
	as float32
		float32
	as float64
		float64
	else
		()
is-integral-type bool(a builtin-type)
	a.to::integral-type? !is-empty
to integral-type?(a builtin-type)
	match a
	as int8
		int8
	as int16
		int16
	as int32
		int32
	as int64
		int64
	as nat8
		nat8
	as nat16
		nat16
	as nat32
		nat32
	as nat64
		nat64
	else
		()
is-lambda bool(a builtin-type)
	match a
	as fun-data
		true
	as fun-mut
		true
	as fun-shared
		true
	else
		false

struct-alias record force-data
	hash nat32 # TODO: USED? ---------------------------------------------------------------------------------------------------------
	ast struct-alias-ast
	module-uri uri
	visibility visibility
	doc-comment-references mut doc-comment-references
	late-target mut struct-inst?
== bool(a struct-alias, b struct-alias)
	trusted a reference-equal b
target struct-inst(a struct-alias)
	a late-target!
set-target void(a struct-alias, value struct-inst)
	assert a.late-target is-empty
	a.late-target := value
doc-comment-ast doc-comment-ast(a struct-alias)
	a.ast doc-comment
doc-comment doc-comment(a struct-alias)
	a.doc-comment-ast, a.doc-comment-references
name symbol(a struct-alias)
	a.ast.name name
n-type-params nat(_ struct-alias)
	0
type-param-asts type-params(_ struct-alias)
	()
range uri-and-range(a struct-alias)
	a.module-uri, a.ast.range
name-range uri-and-range(a struct-alias)
	a.module-uri, a.ast.name-range

symbol-set alias
	symbol set
show string(a symbol-set)
	", " join for x : a
		x.to quote

struct-decl record force-data
	hash nat32
	source struct-decl-source
	module-uri uri
	visibility visibility
	extern_ symbol-set 
	is-summon bool # TODO:PERF Maybe I should merge this into 'extern_'? It works basically the same way. ---------------------------------------
	| Warn: purity on the decl does not take type args into account
	purity purity
	purity-is-forced bool
	doc-comment-references mut doc-comment-references
	sum-type-memberships mut sum-type-membership[]
	body mut struct-body
	| This is e.g. a `(t0, t1) foo`
	instantiated-with-own-type-params -mut struct-inst
	| For perf, non-templates store their only instance directly
	insts -mut (struct-inst, type-args) object-memoizer?
only-inst struct-inst(a struct-decl)
	forbid a is-template
	a instantiated-with-own-type-params
new struct-decl
	hash nat32
	source struct-decl-source
	module-uri uri
	visibility visibility
	extern_ symbol-set
	is-summon bool
	purity purity
	purity-is-forced bool
	doc-comment-references doc-comment-references
	sum-type-memberships sum-type-membership[]
	body struct-body
do
	res struct-decl = hash, source, module-uri, visibility, extern_, is-summon, purity, purity-is-forced, doc-comment-references, sum-type-memberships, body, (trusted gc-safe-value), ()
	if res is-template
		res.insts := ()::((struct-inst, type-args) object-memoizer)
		res.instantiated-with-own-type-params := res[res.n-type-params.type-params-type-array]
	else
		res.instantiated-with-own-type-params := (res, ())
	res
== bool(a struct-decl, b struct-decl)
	trusted a reference-equal b
<=> comparison(_ struct-decl, _ struct-decl)
	throw todo
hash-mix void(hasher hasher, a struct-decl)
	hasher hash-mix a.hash
doc-comment-ast doc-comment-ast(a struct-decl)
	a.source doc-comment
