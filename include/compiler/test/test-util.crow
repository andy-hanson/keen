import
	../app/file-system
	../frontend/frontend
	../frontend/show-model
	../lib/server
	../model/model
	../model/parse-diag
	../model/uri

test-server server()
	trusted
	settings:
		include-dir: "test:///include" must-parse-uri
		cwd: "test:///" must-parse-uri
		show-options: color: false

uri-and-content record(uri uri, crow string)
setup-test-server void(server server, main-uri uri, main-content string) summon
	server setup-test-server ((main-uri, main-content),)
setup-test-server void(server server, files uri-and-content[]) summon
	for file in files
		file.uri.get-extension is ".crow"
		server set-file file.uri, file.crow
	with reader in this-executable file-reader false
		loop
			unknowns = server flush-all-unknown-uris
			if unknowns is-empty
				break
			else
				for unknown in unknowns
					server set-file unknown,
						reader load-file unknown
				continue

-load-file read-file-result(reader file-reader, uri uri) summon
	if uri.base-name == "crow-config.json"
		not-found
	elif path = uri as-java-uri
		reader try-read-java-class path
	else
		assert x = uri.to::string try-remove-start "test:///include/" else "Unexpected URI {uri}" error
		reader try-read-file (reader.path-to-crow.parent!.parent! / "include" / x).to

is-with-description[t] void(a t, b t, desc string data()) t equal, (json, t) to
	assert a == b else "{desc[]}: Expected {a.to::json} == {b.to::json}" error
