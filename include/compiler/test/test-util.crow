import
	../app/file-system
	../frontend/show-model
	../frontend/storage_
	../lib/server
	../model/parse-diag
	../model/uri

is-supported-backend bool() trusted
	# JS is too slow
	!(extern java) && !(extern js) # TODO: do support java ----------------------------------------------------------------------------------------------------

test-server server()
	assert is-supported-backend
	settings server-settings = do
		include-dir: "test:///include" must-parse-uri
		cwd: "test:///" must-parse-uri
		show-options: (false,)
	settings,

uri-and-content record(uri uri, crow string)
setup-test-server void(server server, main-uri uri, main-content string) summon
	server setup-test-server ((main-uri, main-content),)
setup-test-server void(server server, files uri-and-content[]) summon
	for file : files
		file.uri.get-extension is ".crow"
		server set-file-assume-utf8 file.uri, file.crow.to
	loop
		unknowns = server all-unknown-uris
		if unknowns is-empty
			break
		else
			for unknown : unknowns
				server set-file unknown, unknown.load-file
			continue

-load-file read-file-result(uri uri) summon
	if uri.base-name == "crow-config.json"
		not-found to
	else
		assert x ?= uri.to::string try-remove-start "test:///include/" : "Unexpected URI {uri}" error
		"/home/andy/crow/include/{x}".must-parse-file-path.to try-read-file

is-with-description[t] void(a t, b t, desc string data()) t equal, (json, t) to
	assert a == b : "{desc[]}: Expected {a.to::json} == {b.to::json}" error
