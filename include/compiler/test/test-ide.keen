import
	keen/io/file
	keen/parse
	../app/file-system
	../app/parse-command # TODO: Tests shouldn't need to import 'app', move these imported functions
	../app/server
	../frontend/ide/get-code-lenses
	../frontend/ide/get-completion
	../frontend/ide/get-definition
	../frontend/ide/get-hover
	../frontend/ide/get-implementation
	../frontend/ide/get-inlay-hints
	../frontend/ide/get-references
	../frontend/ide/get-rename
	../frontend/ide/get-signature-help
	../frontend/show-model
	../model/lsp
	../model/model
	../model/source-range
	../model/uri
	./test-util

test global
	server, tests-by-dir = ide-tests-for-keen-and-keen-files
	program = get-program server, ()
	the show-ctx = get-show-ctx server
	the common-types = program.common-types
	for dir-name, tests in tests-by-dir
		match dir-name
		as code-lens
			for test_ in tests
				to::json get-code-lenses program, ((test_.uri,),) is test_.expected
		as completion
			for test_ in tests
				test-at-positions test_, of where
					to get-completion program, (where.to,)
		as folding-ranges
			for test_ in tests
				to::json folding-ranges server, test_.uri is test_.expected
		as hover
			for test_ in tests
				hover-result program, test_.uri is test_.expected
		as implementation
			for test_ in tests
				test-at-positions test_, of where
					to get-implementation program, (where.to,)
		as inlay-hints
			for test_ in tests
				range line-and-character-range = (0, 0), (max-value, max-value)
				hints = get-inlay-hints program, (),
					textDocument: uri: test_.uri
					range: range
				hints.to::json 'is-with-description test_.expected, of
					"For {test_.uri}"
		as references
			for test_ in tests
				test-at-positions test_, of where
					to get-references program, (where.to,)
		as rename
			for test_ in tests
				test-at-positions test_, of where
					to get-rename program,
						text-document-and-position: where.to
						newName: "new-name"
		as signature-help
			for test_ in tests
				test-at-positions test_, of where
					to get-signature-help program, (where.to,)
		as tokens
			for test_ in tests
				decoded-tokens server, test_.uri is test_.expected
		else
			throw todo

-ide-tests-for-keen-and-keen-files (server, keen-json-test[][symbol])() global
	# We can't store the tests here, because the '.keen' files would be picked up when running all tests in 'include'.
	base-path = this-executable.parent!.parent! / "editor" / "test"
	tests keen-json-test[][symbol] = for* dir in get-paths-in-dir base-path
		do unless dir.base-name == "readme.md"
		tests = keen-and-kid-files dir
		- dir.base-name.to, tests
	server = test-server
	setup-test-server server, for* _, x in tests
		for y in x
			y.uri, y.keen
	server, tests

-keen-and-kid-files keen-json-test[](dir file-path) global
	files = get-paths-in-dir dir
	keen-files file-path mut[] = ()
	kid-files file-path mut[] = ()
	for file in files
		match get-extension file
		as ".keen"
			keen-files ~= file
		as ".kid"
			kid-files ~= file
		else
			throw error "Unexpected file {file}"
	kid-files.size is keen-files.size

	for keen-file in keen-files
		uri: "test:".parse-uri / dir.base-name / keen-file.base-name
		keen: read-file keen-file.to
		expected: parse kid, (alter-extension keen-file, ".keen", ".kid").to.read-file.as-string

-keen-json-test record(uri uri, keen string, expected json)

-test-at-positions void(test_ keen-json-test, f json mut(where uri-line-and-character)) show-ctx
	uri = test_.uri
	for key, value in test_.expected.to::json[symbol]
		line-and-column = parse-line-and-column! key.to
		line-and-character = to-line-and-character line-and-column-getters[uri]!, line-and-column
		f[uri, line-and-character] 'is-with-description value, of
			"For {uri} {line-and-column}"

-hover-result json(program program, uri uri) show-type-ctx
	the uncommon-types = program.uncommon-types
	do with out-results in build
	# Combine ranges that have the same info
	cur-range-start mut pos = 0
	cur-info mut info-at-pos = ()
	lcg = line-and-character-getters[uri]
	end-range = of end pos
		:: void
		do unless is-empty cur-info
		fields json[symbol] =
			# TODO: It would probably be neater to use a record with an auto 'to json' -------------------------------
			- "range", lcg[(cur-range-start, end)::source-range].to
			- "hover", cur-info.hover.to
			-- unless is-empty cur-info.definition
				- "definition", cur-info.definition.to
			-- unless is-empty cur-info.type-definition
				- "type-definition", cur-info.type-definition.to
		out-results ~= fields.to

	for pos in 0::pos .. lcg.end-of-file + 1
		where uri-line-and-character = uri, lcg[pos]
		hover hover? = get-hover program, (where.to,)
		here info-at-pos =
			hover: if hover then hover.contents.value
			definition: get-definition program, (where.to,)
			type-definition: get-type-definition program, (where.to,)
		if here != cur-info
			end-range[pos]
			cur-range-start := pos
			cur-info := here

	end-range[end-of-file lcg]
-info-at-pos record
	hover string
	definition uri-and-line-and-character-range[]
	type-definition uri-and-line-and-character-range[]
-new info-at-pos()
	(), (), ()
-is-empty bool(a info-at-pos)
	is-empty a.hover and is-empty a.definition and is-empty a.type-definition
- == bool(a info-at-pos, b info-at-pos)
