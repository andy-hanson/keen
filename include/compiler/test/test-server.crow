import
	crow/parse
	../frontend/frontend
	../frontend/ide/get-tokens
	../lib/lsp/lsp-types
	../lib/server
	../model/model
	../model/source-range
	../model/uri
	../util/exit-code
	./test-util

test summon # test actual LSP
	server = test-server
	uri-a = "test:///a.crow" must-parse-uri
	server setup-test-server uri-a, ""
	server.files-state is all-loaded
	do
		in-message0 did-change-text-document-params =
			textDocument: uri: uri-a
			contentChanges: "main void()" change-whole-file
		out = server handle-lsp-message in-message0
		diag lsp-diagnostic =
			range: (0, 0), (0, 4)
			severity: Error
			message: "Function needs a body. (An automatic function must be named '==', '<=>', or 'to'.)"
		out.out-messages is 
			- uri-a publish-diagnostics-params (diag,)
		out.exit-code is ()
	do
		in-message1 = (uri-a,) semantic-tokens-params
		out = server handle-lsp-message (1 lsp-in-request in-message1)
		tokens semantic-tokens =
			data_: 0, 0, 4, 3, 0, 0, 5, 4, 11, 0
		tokens.json-of-decoded-tokens is
			- line:0, character: 0, length: 4, type: "function"
			- line: 0, character: 5, length: 4, type: "type"
		out.out-messages is
			- 1 lsp-out-response tokens
		out.exit-code is ()

-change-whole-file text-document-content-change-event[](new-text string)
	((), new-text),

test summon # test circular import
	server = test-server
	uri-a = "test:///a.crow" must-parse-uri
	uri-b = "test:///b.crow" must-parse-uri

	server setup-test-server uri-a, "main void()"
	server.files-state is all-loaded

	show-diags string mut() = of
		server show-diagnostics do server get-program ()

	show-diags[] is "test:///a.crow 1:1-1:5 Function needs a body. (An automatic function must be named '==', '<=>', or 'to'.)"

	server set-file uri-a, "main void()\n\tinfo log \"hello, world!\""
	server.files-state is all-loaded
	show-diags[] is ()

	server set-file uri-b, "import\n\t./a"
	server.files-state is all-loaded
	do
		program = server get-program ()
		module-b = program module-at-uri uri-b
		diags = module-b diagnostics
		if false # ----------------------------------------------------------------------------------------------------------------
			info log "module b diags: {diags size}"
	show-diags[] is "test:///b.crow 2:5-2:8 Imported module 'a.crow' is unused."

	server set-file uri-a, "import\n\t./b\n\nmain void()\n\tinfo log hello"
	show-diags[] is expected-diags-2

	server set-file uri-b, "hello string()\n\t\"hello\""
	show-diags[] is ""

