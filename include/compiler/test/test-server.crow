import
	../frontend/frontend
	../frontend/ide/get-tokens
	../lib/lsp/lsp-types
	../lib/server
	../model/model
	../model/source-range
	../model/uri
	../util/exit-code
	./test-util

test summon # test actual LSP
	server = test-server
	uri-a = must-parse-uri "test:///a.crow"
	setup-test-server server, uri-a, ""
	server.files-state is all-loaded
	do
		in-message0 did-change-text-document-params =
			textDocument: uri: uri-a
			contentChanges: change-whole-file "main void()"
		out = handle-lsp-message server, in-message0
		diag lsp-diagnostic =
			range: (0, 0), (0, 4)
			severity: Error
			message: "Function needs a body. (An automatic function must be named '==', '<=>', or 'to'.)"
		out.out-messages is
			- publish-diagnostics-params uri-a, (diag,)
		out.exit-code is ()
	do
		in-message1 = semantic-tokens-params (uri-a,)
		out = handle-lsp-message server, lsp-in-request 1, in-message1
		tokens semantic-tokens =
			data_: 0, 0, 4, 3, 0, 0, 5, 4, 11, 0
		tokens.json-of-decoded-tokens is
			- line: 0, character: 0, length: 4, type: "function"
			- line: 0, character: 5, length: 4, type: "type"
		out.out-messages is
			- lsp-out-response 1, tokens
		out.exit-code is ()

-change-whole-file text-document-content-change-event[](new-text string)
	((), new-text),

test summon # test circular import
	server = test-server
	uri-a = must-parse-uri "test:///a.crow"
	uri-b = must-parse-uri "test:///b.crow"

	setup-test-server server, uri-a, "main void()"
	server.files-state is all-loaded

	show-diags string mut() = of
		show-diagnostics server, get-program server, ()

	show-diags[] is "test:///a.crow 1:1-1:5 Function needs a body. (An automatic function must be named '==', '<=>', or 'to'.)"

	set-file server, uri-a, "main void()\n\tlog \"hello, world!\""
	server.files-state is all-loaded
	show-diags[] is ()

	set-file server, uri-b, "import\n\t./a"
	server.files-state is all-loaded
	do
		program = get-program server, ()
		module-b = module-at-uri program, uri-b
		diags = diagnostics module-b
		if false # ----------------------------------------------------------------------------------------------------------------
			log "module b diags: {diags.size}"
	show-diags[] is "test:///b.crow 2:5-2:8 Imported module 'a.crow' is unused."

	set-file server, uri-a, "import\n\t./b\n\nmain void()\n\tlog hello"
	show-diags[] is expected-diags-2

	set-file server, uri-b, "hello string()\n\t\"hello\""
	show-diags[] is ""

