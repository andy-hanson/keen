import
	../app/file-system
	../app/server
	../frontend/frontend
	../frontend/lang
	../frontend/show-model
	../model/model
	../model/parse-diag
	../model/uri

test-server server()
	do trusted
	settings:
		include-dir: parse-uri "test:///include"
		cwd: parse-uri "test:///"
		show-options: color: false

uri-and-content record(uri uri, keen string)
setup-test-server void(server server, main-uri uri, main-content string) global
	setup-test-server server,
		- main-uri, main-content
setup-test-server void(server server, files uri-and-content[]) global
	for file in files
		extension file.uri is ".keen"
		set-file server, file.uri, file.keen
	do with reader in file-reader this-executable, false
	do until
	unknowns = flush-all-unknown-uris server
	for unknown in unknowns
		set-file server, unknown, load-file reader, unknown
	is-empty unknowns

-load-file read-file-result(reader file-reader, uri uri) global
	if uri.base-name == config-base-name
		not-found
	elif path = as-java-uri uri
		try-read-java-class reader, path
	else
		assert x = try-remove-start uri.to::string, "test:///include/" else error "Unexpected URI {uri}"
		try-read-file reader, (reader.path-to-keen.parent!.parent! / "include" / x.to).to

is-with-description[t] void(a t, b t, desc string data()) t equal, (json, t) to
	assert a == b else error "{desc[]}: Left expression:\n{to-kid a}\nRight expression:\n{to-kid b}"
