use-prefix
import
	crow/io/file
	crow/parse
	crow/unsafe
	../app/file-system
	../app/parse-command # TODO: Tests shouldn't need to import 'app', move these imported functions
	../frontend/ide/get-code-lenses
	../frontend/ide/get-completion
	../frontend/ide/get-definition
	../frontend/ide/get-hover
	../frontend/ide/get-implementation
	../frontend/ide/get-inlay-hints
	../frontend/ide/get-position
	../frontend/ide/get-references
	../frontend/ide/get-rename
	../frontend/ide/get-signature-help
	../frontend/ide/position
	../frontend/show-model
	../lib/lsp/lsp-types
	../lib/server
	../model/ast
	../model/model
	../model/source-range
	../model/uri
	./test-util

# TODO: this is to force these to be used.
# I should fix this bug, whatever it is. It has something to do with functions used by methods being used even if they are not needed
test
	trusted
	x nat = 3
	if x < 2
		_ = range gc-safe-value::any-ast
		_ = name-range gc-safe-value::any-decl
		_ = range gc-safe-value::any-decl
		_ = type-param-asts gc-safe-value::any-decl
		_ = arity gc-safe-value::called
		_ = param-types gc-safe-value::called
		_ = return-type gc-safe-value::called
		_ = arity gc-safe-value::called-decl
		_ = doc-comment gc-safe-value::called-decl
		_ = module-uri gc-safe-value::called-decl
		_ = n-type-params gc-safe-value::called-decl
		_ = type-param-asts gc-safe-value::called-decl
		_ = return-type gc-safe-value::called-decl
		_ = range gc-safe-value::call-expr-source
		_ = range gc-safe-value::destructure-ast
		_ = doc-comment gc-safe-value::doc-comment-container
		_ = name-range gc-safe-value::enum-member-source
		_ = doc-comment gc-safe-value::enum-or-flags-member-ast
		_ = range gc-safe-value::expr
		_ = range gc-safe-value::expr-ast
		_ = doc-comment gc-safe-value::expr-container
		_ = type-param-asts gc-safe-value::expr-container
		_ = param gc-safe-value::for-or-with-ast
		_ = name-range gc-safe-value::fun-decl-source
		_ = param gc-safe-value::lambda-ast
		_ = param gc-safe-value::lambda-source
		_ = range gc-safe-value::lambda-source
		_ json = gc-safe-value::lsp-out-result.to
		_ = range gc-safe-value::modifier-ast
		_ = type-param-asts gc-safe-value::crow-module
		_ = doc-comment gc-safe-value::record-field-ast
		_ = name-range gc-safe-value::record-field-source
		_ = range gc-safe-value::record-field-source
		_ = doc-comment gc-safe-value::single-destructure-ast
		_ = name gc-safe-value::struct-or-alias
		_ = name-range gc-safe-value::struct-or-alias
		_ = range gc-safe-value::struct-or-alias
		_ = visibility gc-safe-value::struct-or-alias
		_ = type-params gc-safe-value::struct-decl-source
		_ = n-type-params gc-safe-value::test_
		_ = doc-comment gc-safe-value::type-container
		_ = module-uri gc-safe-value::type-container
		_ = n-type-params gc-safe-value::type-container
		_ = type-param-asts gc-safe-value::type-container
		_ = name gc-safe-value::visibility-container
		_ = visibility gc-safe-value::visibility-container
		_ = name gc-safe-value::module
		_ = public-exports gc-safe-value::module
		_ = public-and-internal-exports gc-safe-value::module
		_ = hash gc-safe-value::any-decl
		_ = visibility gc-safe-value::any-decl
		_ json = gc-safe-value::name-or-string-ast.to
		_ json = gc-safe-value::char-type.to
		_ json = gc-safe-value::integral-type.to
		_ json = gc-safe-value::float-type-or-js-or-json.to

test summon
	server, tests-by-dir = ide-tests-for-crow-and-crow-files
	program = get-program server, ()
	ctx = get-show-diag-ctx server, program
	for dir-name, tests in tests-by-dir
		match dir-name
		as code-lens
			for test_ in tests
				(get-code-lenses program, ((test_.uri,),)).to::json is test_.expected
		as completion
			for test_ in tests
				test-at-positions ctx, test_, of where
					guard pos = get-position program, where, after
					get-completion-for-position ctx, pos 'to
		as folding-ranges
			for test_ in tests
				(folding-ranges server, test_.uri).to::json is test_.expected
		as hover
			for test_ in tests
				hover-result ctx, program, test_.uri is test_.expected
		as implementation
			for test_ in tests
				test-at-positions ctx, test_, of where
					guard pos = get-position program, where, exact
					get-implementation-for-position program, pos 'to
		as inlay-hints
			for test_ in tests
				range line-and-character-range = (0, 0), (max-value, max-value)
				hints = get-inlay-hints program, ctx, (),
					textDocument: uri: test_.uri
					range: range
				hints.to::json 'is-with-description test_.expected, of
					"For {test_.uri}"
		as references
			for test_ in tests
				test-at-positions ctx, test_, of where
					guard pos = get-position program, where, exact
					get-references-for-position program, pos 'to
		as rename
			for test_ in tests
				test-at-positions ctx, test_, of where
					guard pos = get-position program, where, exact
					get-rename-for-position program, pos, "new-name" 'to
		as signature-help
			for test_ in tests
				test-at-positions ctx, test_, of where
					guard pos = get-position program, where, after
					get-signature-help-for-position ctx, pos 'to
		as tokens
			for test_ in tests
				decoded-tokens server, test_.uri is test_.expected
		else
			throw todo

-ide-tests-for-crow-and-crow-files (server, crow-json-test[][symbol])() summon
	# We can't store the tests here, because the '.crow' files would be picked up when running all tests in 'include'.
	base-path = this-executable.parent!.parent! / "editor" / "test"
	tests crow-json-test[][symbol] = for* dir in get-paths-in-dir base-path
		guard dir.base-name != "readme.md"
		tests = crow-and-crowd-files dir
		- dir.base-name.to, tests
	server = test-server
	setup-test-server server, for* _, x in tests
		for y in x
			y.uri, y.crow
	server, tests

-crow-and-crowd-files crow-json-test[](dir file-path) summon
	files = get-paths-in-dir dir
	crow-files file-path mut[] = ()
	crowd-files file-path mut[] = ()
	for file in files
		match get-extension file
		as ".crow"
			crow-files ~= file
		as ".crowd"
			crowd-files ~= file
		else
			throw error "Unexpected file {file}"
	crowd-files.size is crow-files.size

	for crow-file in crow-files
		uri: "test:".must-parse-uri / dir.base-name / crow-file.base-name
		crow: read-file crow-file.to
		expected: parse crowd, (alter-extension crow-file, ".crowd").to.read-file.as-string

-crow-json-test record(uri uri, crow string, expected json)

-test-at-positions void(ctx show-model-ctx, test_ crow-json-test, f json mut(where uri-line-and-character))
	uri = test_.uri
	for key, value in test_.expected.to::json[symbol]
		line-and-column = parse-line-and-column! key.to
		line-and-character = to-line-and-character ctx.line-and-column-getters[uri], line-and-column
		f[uri, line-and-character] 'is-with-description value, of
			"For {uri} {line-and-column}"

-hover-result json(ctx show-model-ctx, program program, uri uri)
	with out-results in build
		# Combine ranges that have the same info
		cur-range-start mut pos = 0
		cur-info mut info-at-pos = ()
		lcg = ctx.line-and-character-getters[uri]
		end-range void mut(end pos) = of end
			guard !is-empty cur-info
			fields json[symbol] =
				# TODO: It would probably be neater to use a record with an auto 'to json' -------------------------------
				- "range", lcg[(cur-range-start, end)::source-range].to
				- "hover", cur-info.hover.to
				-- unless is-empty cur-info.definition
					- "definition", cur-info.definition.to
				-- unless is-empty cur-info.type-definition
					- "type-definition", cur-info.type-definition.to
			out-results ~= fields.to

		for pos in 0::pos .. lcg.end-of-file + 1
			position = get-position program, (uri, lcg[pos, start-of-range]), exact
			hover hover? = if position
				get-hover ctx, position
			here info-at-pos =
				hover: if hover
					hover.contents.value
				definition: if position
					get-definition-for-position program, position
				type-definition: if position
					get-type-definition-for-position program, position
			if here != cur-info
				end-range[pos]
				cur-range-start := pos
				cur-info := here

		end-range[end-of-file lcg]
-info-at-pos record
	hover string
	definition uri-and-line-and-character-range[]
	type-definition uri-and-line-and-character-range[]
-new info-at-pos()
	(), (), ()
-is-empty bool(a info-at-pos)
	is-empty a.hover and is-empty a.definition and is-empty a.type-definition
-== bool(a info-at-pos, b info-at-pos)
