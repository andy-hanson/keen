import
	../model/low-model
	../util/util
	./bytecode

extern_ record mut
	| Should return an empty option if anything failed to load
	load-extern-pointers extern-pointers-for-all-libraries? mut(libraries extern-libraries, write-error write-error)
	make-synthetic-fun-pointers make-synthetic-fun-pointers
	aggregate-cbs aggregate-cbs
	do-dyn-call do-dyn-call

fun-pointer-inputs record mut
	fun-index low-fun-index
	sig dyn-call-sig
	operation-pointer operation*

make-synthetic-fun-pointers alias
	fun-pointer[] mut(inputs fun-pointer-inputs[])
aggregate-cbs record mut
	new-aggregate DCaggr mut* mut(count-fields nat, size-bytes nat)
	add-field void mut(aggr DCaggr mut*, field-offset nat, field-type dyn-call-type)
	close void mut(aggr DCaggr mut*)

# TODO: below comment was for D, what about now?
# For some reason, trying to pass 'Stacks' into here leads to stack overflow issues
# in optimized builds where 'opCallFunPointerExtern' isn't tail recursive.
# So instead, the caller will 'saveStacks' before calling this, then this should 'saveStacks' before returning.
do-dyn-call alias
	void mut(fun fun-pointer, sig dyn-call-sig)

write-error alias
	void mut(text string)

extern-pointers-for-all-libraries alias
	extern-pointer[symbol][symbol]
extern-pointers-for-library alias
	extern-pointer[symbol]

fun-pointer record by-val
	pointer any-const-pointer
as-extern-pointer extern-pointer(a fun-pointer)
	a.pointer,

| May be a function or variable pointer
extern-pointer record by-val
	pointer any-const-pointer

dyn-call-sig record mut
	return-type-and-parameter-types dyn-call-type[]
return-type dyn-call-type(a dyn-call-sig) bare
	a.return-type-and-parameter-types[0]
parameter-types dyn-call-type[](a dyn-call-sig)
	a.return-type-and-parameter-types[1 .. end]
count-parameter-entries nat(a dyn-call-sig)
	a.parameter-types sum x => x size-words

# Declaring this here since 'dyncall.d' is excluded from WASM builds (TODO: now converting to crow, does this still apply?)
DCaggr extern

dyn-call-type union(primitive-type, dyn-call-type-pointer, dyn-call-type-aggregate) mut
dyn-call-type-pointer record
dyn-call-type-aggregate record mut
	size-words nat
	dc-aggr DCaggr*

size-words nat(_ dyn-call-type)
	throw todo
