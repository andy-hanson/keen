import
	crow/pointer
	crow/col/mut-slice
	../../crow/private/alloc: unmanaged-alloc-uninitialized-elements
	./bytecode

-stacks-initialized global(bool)
-saved-stacks global(stacks)
-stacks-storage global(word mut-slice)
-stacks-storage-size nat()
	0x10000

# Type for storing anything
word record(to nat64) mut, by-val
to word(a bool)
	a.to,
to word(a int8)
	a.to::int64 to
to word(a int16)
	a.to::int64 to
to word(a int32)
	a.to::int64 to
to word(a int64)
	a.wrap-to::nat64 to
to word(a nat8)
	a.to::nat64 to
to word(a nat16)
	a.to::nat64 to
to word(a nat32)
	a.to::nat64 to
to word(a nat64)
	a,
to word(_ float32)
	throw todo
to word(_ float64)
	throw todo
to word(a any-mut-pointer) unsafe, native extern
	a.to,
to bool(a word)
	match a.to::nat64
	as 0
		false
	as 1
		true
	else
		throw unreachable
to int8(a word)
	a.to::int64 to
to int16(a word)
	a.to::int64 to
to int32(a word)
	a.to::int64 to
to int64(a word)
	a.to wrap-to
to nat8(a word)
	a.to::nat64 to
to nat16(a word)
	a.to::nat64 to
to nat32(a word)
	a.to::nat64 to
to float64(a word)
	a.to float64-of-bits
to float32(a word)
	a.to float32-of-bits
-float64-of-bits float64(_ nat64)
	throw todo
-float32-of-bits float32(_ nat32)
	throw todo
to any-mut-pointer(a word) unsafe, native extern
	a.to to-mut-pointer

save-stacks void(a stacks) summon, unsafe
	assert stacks-initialized
	saved-stacks := a

load-stacks stacks() summon, unsafe
	saved-stacks

| WARN: In case this is reentrant, the interpreter must call 'saveStacks' before.
| The callback should have a net 0 effect on the stack depth.
with-default-stacks[out] out(f out mut(stacks stacks)) summon, unsafe, native extern
	unless stacks-initialized
		ptr word mut* = stacks-storage-size unmanaged-alloc-uninitialized-elements
		saved-stacks := ptr[0 .. stacks-storage-size] stacks-for-range
		stacks-initialized := true

	stacks-at-start = saved-stacks copy
	cur-stacks = stacks-at-start

	res = f[cur-stacks]

	assert cur-stacks == stacks-at-start
	saved-stacks := stacks-at-start # TODO: doesn't this have no real effect? ---------------------------------------------------
	res

assert-stacks-at-original-state void(a stacks) unsafe, native extern
	assert a.data-end == stacks-storage.begin-pointer
	assert a.return-ptr == stacks-storage.end-pointer.pointer-cast - 1
	assert *a.return-ptr == null

stacks record mut
	| Pointer to the previous pushed value.
	data-ptr mut word mut*
	| Pointer to the previou pushed value.
	return-ptr mut operation* mut*
copy stacks(a stacks)
	a.data-ptr, a.return-ptr
== bool(a stacks, b stacks) unsafe, native extern
	a.data-ptr == b.data-ptr && a.return-ptr == b.return-ptr

stacks-for-range stacks(range word mut-slice) unsafe, native extern
	res stacks = (range.begin-pointer - 1).pointer-cast, range.end-pointer.pointer-cast
	# Initial return entry is null so we can detect it in 'fillBacktrace'
	res return-push null
	res

data-push void(a stacks, value word) unsafe, native extern
	a.data-ptr +:= 1
	assert a.data-ptr < a.return-ptr.pointer-cast
	*a.data-ptr := value

data-push void(a stacks, values word[]) unsafe, native extern
	for value : values
		a data-push value

data-push-uninitialized word mut*(a stacks, n-words nat) unsafe, native extern
	res = a data-end
	a.data-ptr +:= n-words
	assert a.data-ptr < a.return-ptr.pointer-cast
	res

data-peek word(a stacks) unsafe, native extern
	a data-peek 0
data-peek word(a stacks, offset nat) unsafe, native extern
	*(a.data-ptr - offset)

data-dup-words void(a stacks, offset-words nat, size-words nat) unsafe, native extern
	assert size-words != 0
	assert size-words <= offset-words + 1
	ptr mut = a.data-top - offset-words
	for _ : 0::nat .. size-words
		a data-push *ptr
		ptr +:= 1

data-pop word(a stacks) unsafe, native extern
	res = *a.data-ptr
	a.data-ptr -:= 1
	res

data-ref word mut*(a stacks, offset nat) unsafe, native extern
	a.data-ptr - offset

| WARN: Result is temporary (overwritten on next push)
data-pop-n word mut-slice(a stacks, n nat) unsafe, native extern
	a.data-ptr -:= n
	a.data-ptr[1 .. n + 1]

| Pointer to the last data value pushed
data-top word mut*(a stacks) unsafe, native extern
	a data-ptr

| One past the last data value pushed; meaning a pointer to the next pushed value.
data-end word mut*(a stacks) unsafe, native extern
	a.data-ptr + 1

data-remove word(a stacks, offset nat) unsafe, native extern
	res = a data-peek offset
	a data-return offset, offset
	res

| Typically used to remove local variables when returning from a function.
| 'offsetWords' is the new location of the first word of the return value.
| 'sizeWords' is allowed to be 0, in which case this just removes the top 'offsetWords' entries from the stack.
data-return void(a stacks, offset-words nat, size-words nat) unsafe, native extern
	assert size-words <= offset-words
	in-ptr = a.data-ptr + 1 - size-words
	out-ptr = a.data-ptr - offset-words
	for i : 0::nat .. size-words
		out-ptr[i] := in-ptr[i]
	a.data-ptr -:= offset-words + 1 - size-words

return-push void(a stacks, value operation*) unsafe, native extern
	a.return-ptr -:= 1
	*a.return-ptr := value

return-pop operation*(a stacks) unsafe, native extern
	res = *a.return-ptr
	a.return-ptr +:= 1
	res

return-temp-as-arr-reverse operation* mut-slice(a stacks) unsafe, native extern
	cur mut = a return-ptr
	until *cur == null
		cur +:= 1
	a.return-ptr .. cur as-mut-slice
