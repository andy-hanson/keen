import
	../model/concrete-model
	../model/integral-values
	../model/model
	../model/low-model
	../model/source-range
	../model/type-layout
	../util/util

bool-type low-type()
	bool to
char8-type low-type()
	char8 to
char32-type low-type()	
	char32 to
float32-type low-type()
	float32 to
float64-type low-type()
	float64 to
int8-type low-type()
	int8 to
int16-type low-type()
	int16 to
int32-type low-type()
	int32 to
int64-type low-type()
	int64 to
nat8-type low-type()
	nat8 to
nat16-type low-type()
	nat16 to
nat32-type low-type()
	nat32 to
nat64-type low-type()
	nat64 to
void-type low-type()
	void to

gen-abort low-expr(type low-type, range uri-and-range)
	type, range, abort-low-expr

gen-union-as low-expr(as-type low-type, range uri-and-range, union_ low-expr, member-index nat)
	as-type, range, (union_ union-as-low-expr member-index)

gen-union-kind low-expr(range uri-and-range, union_ low-expr)
	nat64-type, range, union_.union-kind-low-expr

gen-union-match low-expr(
	type low-type,
	range uri-and-range,
	get-union low-expr,
	case-types low-type[],
	cb-case low-expr mut(index nat, get-case low-expr),
)
	assert _ ?= get-union.kind local-get-low-expr
	switch switch-low-expr = do
		value: range gen-union-kind get-union
		case-values: case-types.size integral-values-range
		case-exprs: for index, case-type : case-types with-index
			cb-case[index, (case-type gen-union-as range, get-union, index)]
		default: type gen-abort range
	type, range, switch.to

gen-unary low-expr(type low-type, range uri-and-range, kind builtin-unary, arg low-expr)
	type, range, (kind special-unary-low-expr arg)
gen-unary-math low-expr(type low-type, range uri-and-range, kind builtin-unary-math, arg low-expr)
	type, range, (kind special-unary-math-low-expr arg)
gen-binary low-expr(
	type low-type,
	range uri-and-range,
	kind builtin-binary,
	arg0 low-expr,
	arg1 low-expr,
)
	type, range, (kind special-binary-low-expr (arg0, arg1))
gen-binary-math low-expr(
	type low-type,
	range uri-and-range,
	kind builtin-binary-math,
	arg0 low-expr,
	arg1 low-expr,
)
	type, range, (kind special-binary-math-low-expr (arg0, arg1))
gen-ternary low-expr(
	type low-type,
	range uri-and-range,
	kind builtin-ternary,
	arg0 low-expr,
	arg1 low-expr,
	arg2 low-expr,
)
	type, range, (kind special-ternary-low-expr (arg0, arg1, arg2))
gen-4ary low-expr(
	type low-type,
	range uri-and-range,
	kind builtin-4ary,
	arg0 low-expr,
	arg1 low-expr,
	arg2 low-expr,
	arg3 low-expr,
)
	type, range, (kind special-4ary-low-expr (arg0, arg1, arg2, arg3))

gen-add-pointer low-expr(ptr-type low-pointer-const, range uri-and-range, ptr low-expr, added low-expr)
	ptr-type.to gen-binary range, add-pointer-and-nat64, ptr, added
gen-local-pointer low-expr(type low-type, range uri-and-range, local low-local)
	type, range, local.local-pointer-low-expr
gen-fun-pointer low-expr(type low-type, range uri-and-range, fun concrete-fun)
	type, range, fun.id.constant-fun-pointer.to
gen-fun-pointer low-expr(type low-type, range uri-and-range, fun low-fun-index)
	type, range, fun.fun-pointer-low-expr

gen-drop low-expr(range uri-and-range, a low-expr)
	if a.type == void-type
		a
	else
		void-type gen-unary range, drop, a
gen-drop-then low-expr(range uri-and-range, a low-expr, b low-expr)
	range gen-seq (range gen-drop a), b
gen-drop-all-then low-expr(range uri-and-range, args low-expr[], after low-expr)
	res mut = after
	for arg : args reverse
		res := range gen-drop-then arg, res
	res

gen-deref-gc-pointer low-expr(range uri-and-range, ptr low-expr)
	assert ptr.type is-pointer-gc
	range gen-deref-gc-or-raw-pointer ptr
gen-deref-raw-pointer low-expr(range uri-and-range, ptr low-expr)
	assert ptr.type is-pointer-non-gc
	range gen-deref-gc-or-raw-pointer ptr
-gen-deref-gc-or-raw-pointer low-expr(range uri-and-range, ptr low-expr)
	ptr.type.as-pointee gen-unary range, deref, ptr

gen-if low-expr(range uri-and-range, cond low-expr, then low-expr, else_ low-expr)
	then.type, range, (cond if-low-expr then, else_)

gen-incr-pointer low-expr(range uri-and-range, pointer-type low-pointer-const, pointer low-expr)
	pointer-type gen-add-pointer range, pointer, (range gen-constant-nat64 1)

gen-false low-expr(range uri-and-range)
	range gen-constant-bool false
gen-true low-expr(range uri-and-range)
	range gen-constant-bool true
-gen-constant-bool low-expr(range uri-and-range, value bool)
	bool-type gen-constant-integral range, value.to
gen-constant-nat64 low-expr(range uri-and-range, value nat)
	nat64-type gen-constant-integral range, value
-gen-constant-integral low-expr(type low-type, range uri-and-range, value nat)
	type, range, value.integral-value.to

-gen-null low-expr(type low-type, range uri-and-range)
	type gen-zeroed range

gen-call-fun-pointer-no-gc-roots low-expr(
	type low-type,
	range uri-and-range,
	fun-ptr low-expr,
	args low-expr[],
)
	type, range, (fun-ptr call-fun-pointer-low-expr args)
gen-call-no-gc-roots low-expr(
	type low-type,
	range uri-and-range,
	called low-fun-index,
	args low-expr[],
)
	type, range, (called call-low-expr args)

gen-size-of low-expr(all-types all-low-types, range uri-and-range, t low-type)
	range gen-constant-nat64 (all-types type-size-bytes t)

gen-identifier low-expr(range uri-and-range, local low-local) # TODO: rename to gen-local-get ----------------------------------
	local.type, range, local.local-get-low-expr
gen-local-set low-expr(range uri-and-range, local low-local, value low-expr)
	void-type, range, (local local-set-low-expr value)

gen-wrap-mul-nat64 low-expr(range uri-and-range, left low-expr, right low-expr)
	nat64-type gen-binary range, wrap-mul-nat64, left, right

gen-pointer-equal low-expr(range uri-and-range, a low-expr, b low-expr)
	bool-type gen-binary range, equal-pointer, a, b
gen-pointer-equal-null low-expr(range uri-and-range, a low-expr)
	range gen-pointer-equal a, (a.type gen-null range)
gen-pointer-cast low-expr(type low-type, range uri-and-range, inner low-expr)
	type, range, inner.pointer-cast-low-expr

gen-create-record-no-gc-roots low-expr(type low-type, range uri-and-range, args low-expr[])
	assert _ ?= type low-record
	type, range, args.create-record-low-expr
gen-record-field-get low-expr(type low-type, range uri-and-range, record_ low-expr, field-index nat)
	type, range, (record_ record-field-get-low-expr field-index)
gen-record-field-pointer low-expr(type low-type, range uri-and-range, record_ low-expr, field-index nat)
	type, range, (record_ record-field-pointer-low-expr field-index)
gen-record-field-set-no-gc-root low-expr(
	range uri-and-range,
	record_ low-expr,
	field-index nat,
	value low-expr,
)
	void-type, range, (record_ record-field-set-low-expr field-index, value)

gen-seq low-expr(range uri-and-range, first low-expr, then low-expr)
	then.type gen-binary range, seq, first, then
gen-seq low-expr(range uri-and-range, arg0 low-expr, arg1 low-expr, arg2 low-expr)
	range gen-seq arg0, (range gen-seq arg1, arg2)
gen-seq low-expr(range uri-and-range, arg0 low-expr, arg1 low-expr, arg2 low-expr, arg3 low-expr)
	range gen-seq arg0, (range gen-seq arg1, arg2, arg3)

gen-write-to-pointer low-expr(range uri-and-range, pointer low-expr, value low-expr)
	void-type gen-binary range, write-to-pointer, pointer, value

gen-void low-expr(range uri-and-range)
	void-type gen-zeroed range
gen-zeroed low-expr(type low-type, range uri-and-range)
	type, range, constant-zero.to

gen-local low-local(name symbol, is-mutable bool, index nat, type low-type)
	(name low-local-source-generated is-mutable), index, type

| {local}.type should not contain GC roots
gen-let-no-gc-root low-expr(range uri-and-range, local low-local, init low-expr, then low-expr)
	then.type, range, (local let-low-expr init, then)
gen-let-temp-const-no-gc-root low-expr(
	range uri-and-range,
	local-index nat,
	value low-expr,
	f-then low-expr mut(get low-expr),
)
	local = "temp" gen-local false, local-index, value.type
	range gen-let-no-gc-root local, value, f-then[range gen-identifier local]

gen-seq-then-return-first-no-gc-root low-expr(
	range uri-and-range,
	local-index nat,
	a low-expr,
	b low-expr,
)
	range gen-let-temp-const-no-gc-root local-index, a, get-a =>
		range gen-seq b, get-a

gen-get-array-or-mut-array-size low-expr(range uri-and-range, array low-expr)
	nat64-type gen-record-field-get range, array, 0

gen-get-array-or-mut-array-const-pointer low-expr(
	range uri-and-range,
	array low-expr,
	element-pointer-type low-type,
	const-pointer-type low-type,
)
	value = element-pointer-type gen-record-field-get range, array, 1
	if const-pointer-type == element-pointer-type
		value
	else
		const-pointer-type gen-pointer-cast range, value

get-element-pointer-type-from-array-or-mut-array-type low-type(array-record low-record)
	size, pointer = array-record.fields only2
	size.debug-name is "size"
	pointer.debug-name is "pointer"
	res = pointer type
	assert res is-pointer-non-gc
	res

gen-loop low-expr(type low-type, range uri-and-range, body low-expr)
	type, range, body.loop-low-expr
gen-loop-break low-expr(type low-type, range uri-and-range, value low-expr) # TODO: inline functions like this --------------------
	type, range, value.loop-break-low-expr
gen-loop-continue low-expr(type low-type, range uri-and-range)
	type, range, loop-continue-low-expr

gen-var-get low-expr(type low-type, range uri-and-range, var low-var-index)
	type, range, var.var-get-low-expr
gen-var-set low-expr(range uri-and-range, var low-var-index, value low-expr)
	void-type, range, (var var-set-low-expr value)
