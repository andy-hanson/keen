import
	../model/concrete-model
	../model/low-model
	../model/model
	../util/full-index-map
	../util/util
	./low-expr-helpers

# TODO: I could just save generating all MarkRoot / MarkVisit funs to the end, then not need this?
low-fun-cause union(concrete-fun, mark-root, mark-visit) mut
mark-root record(type low-type) mut
mark-visit record(type low-type) mut

add-low-fun low-fun-index(low-fun-causes low-fun-cause mut[], source low-fun-cause)
	res = low-fun-causes size
	low-fun-causes ~= source
	res,

get-low-type-ctx record mut
	all-types all-low-types
	# The meaning of the value depends on the kind of ConcreteStruct; it might be a LowRecordIndex for example.
	-low-indices nat[concrete-struct-id]

# TODO: INLINE ALL THESE ----------------------------------------------------------------------------------------------------
get-pointer-gc low-type(_ get-low-type-ctx, pointee low-type)
	pointee low-pointer-gc
get-pointer-const low-type(_ get-low-type-ctx, pointee low-type)
	pointee low-pointer-const
get-pointer-mut low-type(_ get-low-type-ctx, pointee low-type)
	pointee low-pointer-mut

low-type-from-concrete-struct low-type(ctx get-low-type-ctx, struct concrete-struct)
	guard struct !is-empty-struct : void-type
	low-index nat mut() = () =>
		ctx.low-indices[struct id]!
	record_ low-type mut() = () =>
		ctx.all-types.all-records[low-index[],] to
	match struct body
	as concrete-builtin-type x
		match x kind
		as bool
			bool to
		as catch-point
			ctx.all-types.all-extern-types[low-index[],] to
		as char8
			char8 to
		as char32
			char32 to
		as float32
			float32 to
		as float64
			float64 to
		as fun-pointer
			ctx.all-types.all-fun-pointer-types[low-index[],] to
		as int8
			int8 to
		as int16
			int16 to
		as int32
			int32 to
		as int64
			int64 to
		as array
			record_[]
		as mut-slice
			record_[]
		as future
			throw unreachable
		as fun-data
			throw unreachable
		as fun-mut
			throw unreachable
		as fun-shared
			throw unreachable
		as option
			throw unreachable
		as mut-array
			throw unreachable
		as string
			throw unreachable
		as symbol
			throw unreachable
		as js-any
			void to
		as void
			void to
		as nat8
			nat8 to
		as nat16
			nat16 to
		as nat32
			nat32 to
		as nat64
			nat64 to
		as const-pointer
			ctx get-pointer-const (ctx low-type-from-concrete-type x.type-args.only)
		as mut-pointer
			ctx get-pointer-mut (ctx low-type-from-concrete-type x.type-args.only)
	as concrete-enum  x
		x.storage_.to to
	as concrete-extern-type
		ctx.all-types.all-extern-types[low-index[],] to
	as concrete-flags x
		x.storage_.to to
	as concrete-record _
		record_[]
	as concrete-union _
		ctx.all-types.all-unions[low-index[],] to
	as concrete-struct-body-deferred
		throw unreachable

low-type-from-concrete-type low-type(ctx get-low-type-ctx, type concrete-type)
	inner = ctx low-type-from-concrete-struct type.struct
	match type reference
	as by-val_
		inner
	as by-ref_
		ctx get-pointer-gc inner

-to primitive-type(a integral-type)
	match a
	as int8
		int8
	as int16
		int16
	as int32
		int32
	as int64
		int64
	as nat8
		nat8
	as nat16
		nat16
	as nat32
		nat32
	as nat64
		nat64
