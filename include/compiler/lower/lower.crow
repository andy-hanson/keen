import
	../frontend/show-model
	../model/low-model
	../model/model
	../model/source-range
	../util/by-name
	../util/enum-map
	../util/perf
	./all-constants-builder
	./check-low-model
	./lower-ctx
	./lower-expr
	./lower-fun-body
	./gather-info
	./generate
	./replace-constants

lower low-program(target build-target, program program-with-main) show-ctx
	start = perf-now
	finally end-lower start
	ctx lower-context =
		show-ctx: the::show-ctx
		program: program
		target: target
	the lower-context = ctx
	the common-types = ctx.common-types
	the uncommon-types = ctx.uncommon-types
	the low-common-types = ctx.low-common-types
	common-funs = common-funs program.program
	ctx.late-equal-symbol-function := get-non-template-low-fun common-funs.equal-symbol
	ctx.late-json-named-new-function := get-non-template-low-fun common-funs.json-named-new
	ctx.late-hash-nat-functions := for nat-type in make-enum-map
		get-non-template-low-fun common-funs.hash-nat[nat-type]
	show-exception = get-non-template-low-fun common-funs.show-exception
	to-symbol-from-string = get-non-template-low-fun common-funs.to-symbol-from-string
	to-string-from-js-any = get-non-template-low-fun common-funs.to-string-from-js-any
	low-common-funs low-common-funs = match target
	as js
		:: low-common-funs-js
		js-any: get-low-type-for-struct-inst js-any, ()
		main: lower-main-fun program.main-fun
		show-exception: show-exception
		to-symbol-from-string: to-symbol-from-string
		to-string-from-js-any: to-string-from-js-any
	as java
		:: low-common-funs-java
		show-exception: show-exception
		start-runtime: get-non-template-low-fun common-funs.start-runtime
		stop-runtime: get-non-template-low-fun common-funs.stop-runtime
		to-symbol-from-string: to-symbol-from-string
		main: lower-main-fun program.main-fun

	loop
		any mut bool = false
		while fun = pop ctx.all-unprocessed-low-funs
			any := true
			ctx.all-processed-low-funs ~= fun
			do if fun.body.low-fun-body-deferred
			match body = fun-body-decl fun
			as expr
				fun.body := lower-fun-body fun, body
				any := true
			as expr-with-allocated-locals
				fun.body := lower-fun-body fun, body
				any := true
			as fun-body-method
				()
			else
				throw unreachable
		if make-callers-for-java-interfaces
			any := true
		if any
			continue
		else
			break

	assert is-empty ctx.all-unprocessed-low-funs

	replace-constants

	method-impls = finish-sum-types

	all-funs low-fun[] = ctx.all-processed-low-funs.move-to
	all-vars = finish-low-vars
	all-constants = finish-all-constants all-constants
	fun-info = gather-info low-common-funs, all-funs, all-vars, method-impls
	all-structs low-type[] = ctx.all-low-types.move-to
	all-funs-including-extern low-fun[] = sort fun-info.all-used-funs.to, it.range
	res low-program =
		model-program: program program
		target: target
		all-constants: all-constants
		all-non-extern-types: filter all-structs, !it.as-extern
		all-types-including-extern: all-structs
		all-vars: all-vars
		all-non-extern-funs: filter all-funs-including-extern, !it.is-extern
		all-funs-including-extern: all-funs-including-extern
		method-impls: method-impls
		async: fun-info.async
		common-types: the::low-common-types
		common-funs: low-common-funs
	check-low-program res
	res

-lower-main-fun low-fun(main main-fun) lower-ctx
	match main
	as main-fun-nat64-of-args
		get-non-template-low-fun main.fun
	as main-fun-void
		low-fun-for-wrap-main main.fun
	as test-selector
		low-fun-for-all-tests main

-make-callers-for-java-interfaces bool() lower-ctx
	interfaces = the::lower-context.deferred-java-interfaces
	res = !is-empty interfaces
	while decl = pop interfaces
		# For a Crow interface, we know all calls to its methods and so can omit unused methods.
		# That is not the case for Java interfaces, so make sure all methods are generated.
		module = java-module-at-uri program, decl.module-uri
		for fun in module.public-exports.funs
			do if fun.body.fun-body-method
			target = fun.params[0].type.struct-inst!.decl
			do if target == decl
			_ = get-low-fun fun, (), ()
	res

-finish-sum-types low-method-info[low-type]() lower-ctx
	ctx = the::lower-context
	for sum-type, info in ctx.sum-types
		unless has-members sum-type.body.low-union! # It will already be set for a 'union' (not interface or variant)
			finish-sum-type-cases sum-type, info.cases

	if preserve-methods
		assert is-empty ctx.deferred-methods
		for sum-type, info in ctx.sum-types
			- sum-type
			-
				methods low-fun[] = sort info.methods-unsorted.to, it.method-index
				method-indices nat[] = map methods, it.method-index
				methods: methods
				cases: for case_ in info.cases
					map method-indices, case_.method-impls[it]
	else
		for fun in ctx.deferred-methods
			sum-type = fun.params[0].type
			method-index = fun.source.low-fun-source-regular!.decl.body.fun-body-method!.method-index
			fun.body := generate-call-method fun, sum-type, ctx.sum-types[sum-type]!.cases, method-index
		()

-method-index nat(a low-fun)
	a.body.low-fun-body-method!.method-index
