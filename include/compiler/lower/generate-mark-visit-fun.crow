import
	../model/low-model
	../model/model
	../model/source-range
	../util/full-index-map
	./lower-util
	./low-expr-helpers

mark-visit-funs record mut
	all-types all-low-types
	common-types low-common-types
	# If a type is not in one of these maps, it means we didn't need to generate a function for the type.
	| Every type with a 'mark-root' needs a 'mark-visit', but not the other way around.
	record-to-mark-root (low-record-index, low-fun-index?) mut-index-map
	union-to-mark-root (low-union-index, low-fun-index?) mut-index-map
	# For a gc-pointee, the 'mark-visit' function works as a 'mark-root'.

	| Value is optional because some record types don't need a mark-visit funtion.
	record-val-to-visit (low-record-index, low-fun-index?) mut-index-map
	union-to-visit (low-union-index, low-fun-index?) mut-index-map
	gc-pointee-to-visit low-fun-index mut[low-type-id]

init-mark-visit-funs mark-visit-funs(all-types all-low-types, common-types low-common-types) # TODO: rename to 'new' --------------
	all-types: all-types
	common-types: common-types
	record-to-mark-root: all-types.all-records.size,
	union-to-mark-root: all-types.all-unions.size,
	record-val-to-visit: all-types.all-records.size,
	union-to-visit: all-types.all-unions.size,
	gc-pointee-to-visit: ()

mark-root-kind enum(pointer-to-local, local-already-pointer)
get-mark-root-for-type (mark-root-kind, low-fun-index)?(
	low-fun-causes low-fun-cause mut[],
	mark-visit-funs mark-visit-funs,
	low-type low-type,
)
	match low-type
	as low-extern-type _
		()
	as low-fun-pointer-type _
		()
	as primitive-type _
		()
	as low-pointer-gc x
		visit = low-fun-causes get-mark-visit-for-pointer-gc mark-visit-funs, x
		(local-already-pointer, visit),
	as low-pointer-const _
		()
	as low-pointer-mut _
		()
	as low-record x
		res = mark-visit-funs.record-to-mark-root ensure x.index, () =>
			if _ ?= low-fun-causes get-mark-visit-for-record mark-visit-funs, x
				(low-fun-causes add-low-fun x.to.mark-root),
		if fun ?= res
			(pointer-to-local, fun),
	as low-union x
		res = mark-visit-funs.union-to-mark-root ensure x.index, () =>
			if _ ?= low-fun-causes get-mark-visit-for-union mark-visit-funs, x
				(low-fun-causes add-low-fun x.to.mark-root),
		if fun ?= res
			(pointer-to-local, fun),

| Returns an empty option if the type does not need a mark-visit function (since it contains no GC pointers)
get-mark-visit-for-type low-fun-index?(
	low-fun-causes low-fun-cause mut[],
	mark-visit-funs mark-visit-funs,
	type low-type,
)
	match type
	as low-extern-type _
		()
	as low-fun-pointer-type _
		()
	as primitive-type _
		()
	as low-pointer-gc x
		(low-fun-causes get-mark-visit-for-pointer-gc mark-visit-funs, x),
	as low-pointer-const _
		()
	as low-pointer-mut _
		()
	as low-record x
		low-fun-causes get-mark-visit-for-record mark-visit-funs, x
	as low-union x
		low-fun-causes get-mark-visit-for-union mark-visit-funs, x

-get-mark-visit-for-pointer-gc low-fun-index(
	low-fun-causes low-fun-cause mut[],
	mark-visit-funs mark-visit-funs,
	type low-pointer-gc,
)
	mark-visit-funs.gc-pointee-to-visit ensure type.pointee.id, () =>
		low-fun-causes add-low-fun type.to.mark-visit

-get-mark-visit-for-record low-fun-index?(
	low-fun-causes low-fun-cause mut[],
	mark-visit-funs mark-visit-funs,
	record_ low-record,
)
	mark-visit-funs.record-val-to-visit ensure record_.index, () =>
		if record_ is-array-or-mut-array || record_ is-fiber || record_.fields exists field => low-fun-causes get-mark-visit-for-type mark-visit-funs, field.type !is-empty
			(low-fun-causes add-low-fun record_.to.mark-visit),

-get-mark-visit-for-union low-fun-index?(
	low-fun-causes low-fun-cause mut[],
	mark-visit-funs mark-visit-funs,
	union_ low-union,
)
	mark-visit-funs.union-to-visit ensure union_.index, () =>
		if union_.members exists member => low-fun-causes get-mark-visit-for-type mark-visit-funs, member !is-empty
			(low-fun-causes add-low-fun union_.to.mark-visit),

generate-mark-root low-fun(
	get-low-type-ctx get-low-type-ctx,
	low-fun-causes low-fun-cause mut[],
	mark-visit-funs mark-visit-funs,
	mark-ctx-type low-type,
	type low-type,
)
	# FOr a pointer we should use mark-visit directly.
	assert type is-record-or-union
	visit = low-fun-causes get-mark-visit-for-type! mark-visit-funs, type
	###
	mark-root void(ctx mark-ctx, pointer void const*)
		ctx mark-visit *(pointer.pointer-cast::t*)
	###
	params low-local[] = ("mark-ctx" gen-local false, 0, mark-ctx-type), ("pointer" gen-local false, 1, (get-low-type-ctx get-pointer-const void-type))
	range uri-and-range = ()
	mark-ctx low-expr = range gen-identifier params[0]
	pointer = range gen-identifier params[1]
	t-pointer = get-low-type-ctx get-pointer-const type
	deref = range gen-deref-raw-pointer (t-pointer gen-pointer-cast range, pointer)
	call-visit = void-type gen-call-no-gc-roots range, visit, (mark-ctx, deref)
	source: "mark-root" low-fun-source-generated (type,)
	return-type: void-type
	params: params
	body: () low-fun-expr-body call-visit

-is-record-or-union bool(a low-type)
	match a
	as low-record _
		true
	as low-union _
		true
	else
		false

generate-mark-visit low-fun(
	low-fun-causes low-fun-cause mut[],
	mark-visit-funs mark-visit-funs,
	mark-ctx-type low-type,
	mark-fun low-fun-index,
	type low-type,
)
	range uri-and-range = ()
	params low-local[] = ("mark-ctx" gen-local false, 0, mark-ctx-type), ("value" gen-local false, 1, type)
	mark-ctx = range gen-identifier params[0]
	value = range gen-identifier params[1]
	get-mark-visit low-fun-index? mut(x low-type) = x =>
		low-fun-causes get-mark-visit-for-type mark-visit-funs, x
	all-types all-low-types = mark-visit-funs all-types
	common-types low-common-types = mark-visit-funs common-types
	body low-expr = match type
	as low-extern-type _
		throw unreachable
	as low-fun-pointer-type _
		throw unreachable
	as primitive-type _
		throw unreachable
	as low-pointer-gc x
		all-types generate-mark-visit-pointer-gc common-types, mark-fun, range, mark-ctx, value, x.pointee, get-mark-visit[x pointee]
	as low-pointer-const _
		throw unreachable
	as low-pointer-mut _
		throw unreachable
	as low-record record_
		if record_ is-array-or-mut-array
			element-pointer-type = record_ get-element-pointer-type-from-array-or-mut-array-type
			all-types generate-mark-visit-array common-types, mark-fun, mark-ctx, value, element-pointer-type, get-mark-visit[element-pointer-type as-pointee]
		elif record_ is-fiber
			range generate-mark-visit-fiber mark-ctx, value, record_, get-mark-visit
		else
			low-fun-causes generate-mark-visit-record mark-visit-funs, range, record_.fields, mark-ctx, value
	as low-union union_
		low-fun-causes generate-mark-visit-union mark-visit-funs, range, union_.members, mark-ctx, value
	source: "mark-visit" low-fun-source-generated (type,)
	return-type: void-type
	params: params
	body: () low-fun-expr-body body

-gen-as-any-pointer-const low-expr(common-types low-common-types, range uri-and-range, a low-expr)
	common-types.nat8-const-pointer gen-unary range, as-any-pointer, a

-generate-mark-visit-pointer-gc low-expr(
	all-types all-low-types,
	common-types low-common-types,
	mark-fun low-fun-index,
	range uri-and-range,
	mark-ctx low-expr,
	value low-expr,
	pointee-type low-type,
	visit-pointee low-fun-index?,
)
	value-as-pointer = common-types gen-as-any-pointer-const range, value
	pointee-size = all-types gen-size-of range, pointee-type
	mark = bool-type gen-call-no-gc-roots range, mark-fun, (mark-ctx, value-as-pointer, pointee-size)
	if v ?= visit-pointee
		value-deref = range gen-deref-gc-pointer value
		recur = void-type gen-call-no-gc-roots range, v, (mark-ctx, value-deref)
		range gen-if mark, recur, range.gen-void
	else
		range gen-drop mark

###
mark-visit void(mark-ctx mark-ctx, a element[])
	if mark-ctx mark a.data.pointer-cast, a.size * size-of@<a>
		cur mut = a.data
		end = a.data + a.size
		loop
			# mark-visit for `element`
			mark-ctx mark-visit *cur
			cur := cur + 1
			if cur == end
				break
			else
				continue
###
generate-mark-visit-array low-expr(
	all-types all-low-types,
	common-types low-common-types,
	mark-fun low-fun-index,
	get-mark-ctx low-expr,
	get-a low-expr,
	element-pointer-type low-type,
	mark-visit-element-fun low-fun-index?,
)
	const-pointer-type = element-pointer-type.low-pointer-const ?? element-pointer-type.low-pointer-mut!.as-pointer-const
	element-type = element-pointer-type as-pointee
	range uri-and-range = ()
	get-data = range gen-get-array-or-mut-array-const-pointer get-a, element-pointer-type, const-pointer-type.to
	get-size = range gen-get-array-or-mut-array-size get-a
	# mark-ctx mark a.data.pointer-cast, a.size * size-of@a
	data-pointer = common-types gen-as-any-pointer-const range, get-data
	size-bytes = range gen-wrap-mul-nat64 get-size, (all-types gen-size-of range, element-type)
	call-mark = bool-type gen-call-no-gc-roots range, mark-fun, (get-mark-ctx, data-pointer, size-bytes)
	guard mark-visit-element ?= mark-visit-element-fun : range gen-drop call-mark
	void-value = range gen-void
	cur = "cur" gen-local true, 2, const-pointer-type.to
	get-cur = range gen-identifier cur
	end = "end" gen-local false, 3, const-pointer-type.to
	get-end = range gen-identifier end
	# mark-ctx mark-visit *cur
	visit = void-type gen-call-no-gc-roots range, mark-visit-element, (get-mark-ctx, (range gen-deref-raw-pointer get-cur))
	# cur := cur + 1
	incr = range gen-local-set cur, (range gen-incr-pointer const-pointer-type, get-cur)
	# cur == end ? break : continue
	break-or-continue = range gen-if (range gen-pointer-equal get-cur, get-end), (void-type gen-loop-break range, void-value), (void-type gen-loop-continue range)
	seq = range gen-seq visit, incr, break-or-continue
	loop_ = void-type gen-loop range, seq
	data-plus-size = const-pointer-type gen-add-pointer range, get-data, get-size
	if-body = range gen-let-no-gc-root cur, get-data, (range gen-let-no-gc-root end, data-plus-size, loop_)
	range gen-if call-mark, if-body, void-value

###
mark-visit void(mark-ctx mark-ctx, a fiber)
	mark-ctx mark-visit fiber.initial-function
	mark-ctx mark-visit fiber.log-handler
	mark-ctx mark-visit fiber.stack
	cur mut = fiber.gc-root
	loop
		if cur == null
			break
		else
			cur->trace[mark-ctx, cur->pointer]
			cur := cur->next
			continue
###
-generate-mark-visit-fiber low-expr(
	range uri-and-range,
	mark-ctx low-expr,
	fiber low-expr,
	fiber-record low-record,
	get-mark-visit low-fun-index? mut(x low-type),
)
	# TODO: This should probably assert the field name too ----------------------------------------------------------------
	gen-visit-field low-expr mut(field-index nat, allow-skip bool) = (field-index, allow-skip) =>
		field-type = fiber-record.fields[field-index] type
		visit-field = get-mark-visit[field-type]
		if x ?= visit-field
			void-type gen-call-no-gc-roots range, x, (mark-ctx, (field-type gen-record-field-get range, fiber, field-index))
		else
			assert allow-skip
			range gen-void
	visit-state = gen-visit-field[0, false]
	# 'log-handler' might never need a closure and so might not need a visit
	visit-log-handler = gen-visit-field[1, true]
	visit-stack = gen-visit-field[2, false]
	gc-root = fiber-record.fields[3]
	get-gc-root = gc-root.type gen-record-field-get range, fiber, 3

	cur = "cur" gen-local true, 2, gc-root.type
	get-cur = range gen-identifier cur
	gc-root-record = cur.type.low-pointer-mut!.pointee low-record!
	gc-root-field low-expr mut(field-index nat) = field-index =>
		gc-root-record.fields[field-index].type gen-record-field-get range, get-cur, field-index
	cur-pointer = gc-root-field[0]
	cur-trace = gc-root-field[1]
	cur-next = gc-root-field[2]
	call-trace = void-type gen-call-fun-pointer-no-gc-roots range, cur-trace, (mark-ctx, cur-pointer)
	update-cur = range gen-local-set cur, cur-next
	cur-is-null = range gen-pointer-equal-null get-cur
	break-void = void-type gen-loop-break range, range.gen-void
	update-and-continue = range gen-seq call-trace, update-cur, (void-type gen-loop-continue range)
	loop_ = void-type gen-loop range, (range gen-if cur-is-null, break-void, update-and-continue)
	let-cur-and-loop = range gen-let-no-gc-root cur, get-gc-root, loop_
	range gen-seq visit-state, visit-log-handler, visit-stack, let-cur-and-loop

-generate-mark-visit-record low-expr(
	low-fun-causes low-fun-cause mut[],
	mark-visit-funs mark-visit-funs,
	range uri-and-range,
	fields low-field[],
	mark-ctx low-expr,
	value low-expr,
)
	res mut low-expr? = ()
	for field-index, field : fields with-index
		if fun ?= low-fun-causes get-mark-visit-for-type mark-visit-funs, field.type
			field-get = field.type gen-record-field-get range, value, field-index
			call = void-type gen-call-no-gc-roots range, fun, (mark-ctx, field-get)
			expr = if before ?= res
				range gen-seq before, call
			else
				call
			res := expr,
	# OK to force because we wouldn't generate this funciton unless some field needed marking.
	res!

-generate-mark-visit-union low-expr(
	low-fun-causes low-fun-cause mut[],
	mark-visit-funs mark-visit-funs,
	range uri-and-range,
	union-members low-type[],
	mark-ctx low-expr,
	value low-expr,
)
	void-type gen-union-match range, value, union-members, (_, member) =>
		if visit-member ?= low-fun-causes get-mark-visit-for-type mark-visit-funs, member.type
			void-type gen-call-no-gc-roots range, visit-member, (mark-ctx, member)
		else
			range gen-void
