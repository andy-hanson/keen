import
	../model/low-model
	../model/model
	../model/source-range
	../model/uri
	./lower-ctx
	./lower-expr
	./generate

low-fun-for-wrap-main low-fun(model-main fun-inst) lower-ctx
	string-array-type = get-low-type-for-struct-inst common-types.string-array, ()
	inner-main = get-non-template-low-fun model-main
	###
	wrapped-main nat(_ string[])
		real-main
		0
	###
	range = model-main.decl.range
	call-main low-expr = void-type, range, call-low-expr inner-main, ()
	zero low-expr = gen-constant-zero nat64-type, range
	body = gen-seq range, call-main, zero
	res low-fun =
		hash: take-next-id
		source: low-fun-source-wrap-main range
		return-type: nat64-type
		params: (args::low-generated-local-kind, string-array-type),
		body: body
	add-low-fun res
	res

low-fun-for-all-tests low-fun(selector test-selector) lower-ctx
	range uri-and-range = selector.main-uri, ()
	nat64 = nat64-type
	body low-expr[] =
		-- for test_ in all-tests selector
			gen-call range, test_, ()
		- gen-constant-zero nat64, range
	string-array-type = get-low-type-for-struct-inst common-types.string-array, ()
	# TODO: this is similar to low-fun-for-wrap-main, share code -------------------------------------------------------
	res low-fun =
		hash: take-next-id
		source: low-fun-source-wrap-main range
		return-type: nat64
		params: (args::low-generated-local-kind, string-array-type),
		body: nat64, range, body.seq-low-expr
	add-low-fun res
	res

-main-uri uri(a test-selector)
	match a
	as test-selector-all
		a.main-config.config-uri!
	as config
		a.config-uri!
	as uri
		a
	as test_
		a.module-uri

-all-tests low-fun[](selector test-selector) lower-ctx
	index mut nat = 0
	res low-fun mut[] = ()
	each-test program, target, selector, of test_
		res ~= low-fun-for-test test_, index
		index +:= 1
	res.move-to

-low-fun-for-test low-fun(test_ test_, test-index nat) lower-ctx
	res low-fun =
		hash: take-next-id
		source: low-fun-source-test test_, test-index
		return-type: void-type
		params: ()
		body: low-fun-body-deferred
	res.body := lower-fun-body res, test_.body
	add-low-fun res
	res
