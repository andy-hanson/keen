import
	crow/col/buffer
	crow/string/unicode
	../model/low-model
	../model/model
	../model/source-range
	../util/util
	./all-constants-builder
	./lower-ctx

gen-false constant-low-expr(range uri-and-range) lower-ctx
	gen-bool range, false
gen-true constant-low-expr(range uri-and-range) lower-ctx
	gen-bool range, true
-gen-bool constant-low-expr(range uri-and-range, value bool) lower-ctx
	bool, range, value.to

gen-union-assume-case low-expr(case-type low-type, range uri-and-range, arg low-expr)
	union-assume-case-low-expr case-type, range, arg

then-else record(then_ low-expr, else_ low-expr)
if-low-expr if-low-expr(range uri-and-range, cond low-expr, then-else then-else)
	if-low-expr range, cond, then-else.then_, then-else.else_

as-seq low-expr[](a low-expr)
	if a.seq-low-expr then a.parts else a,

gen-do-and-continue low-expr(type low-type, range uri-and-range, a low-expr)
	# Make sure we don't have 'throw' followed by an unnecessary 'continue'
	# or we get unreachable code errors in the Java backend
	match a
	as throw-low-expr
		a
	else
		seq-low-expr range,
			-- as-seq a
			- loop-continue-low-expr type, range
gen-drop-then low-expr(range uri-and-range, a low-expr, b low-expr) lower-ctx
	seq-low-expr range,
		- builtin-unary-low-expr void, range, drop, a
		- b

gen-call low-expr(range uri-and-range, fun low-fun, args low-expr[])
	match body = fun.body
	as low-expr
		if body.constant-low-expr
			body
		else
			call-low-expr range, fun, args
	as fun-body-extern-java
		call-low-expr range, fun, args
	as low-fun-body-method
		call-low-expr range, fun, args
	as low-fun-body-deferred
		call-low-expr range, fun, args
	as low-fun-body-always-inline
		throw unreachable
	as low-builtin-unary
		builtin-unary-low-expr fun.return-type, range, body, only! args
	as low-builtin-binary
		arg0, arg1 = only2! args
		builtin-binary-low-expr fun.return-type, range, body, arg0, arg1
	as low-builtin-ternary
		arg0, arg1, arg2 = only3! args
		builtin-ternary-low-expr fun.return-type, range, body, arg0, arg1, arg2
	as js-fun
		builtin-js-low-expr fun.return-type, range, body, args

gen-option low-expr(option-type low-type, range uri-and-range, arg low-expr) lower-ctx
	assert option-type.as-option! == arg.type
	create-union-low-expr option-type, range, 1, arg
gen-constant-some constant-low-expr
	option-type low-type
	range uri-and-range
	inner constant
do lower-ctx
	option-type, range, get-constant-union all-constants, option-type, 1, inner
gen-empty-option constant-low-expr(option-type low-type, range uri-and-range) lower-ctx
	option-type, range, constant-none option-type
constant-none constant(option-type low-type) lower-ctx
	none-type = option-type.body.low-union!.members[0]
	get-constant-union all-constants, option-type, 0,
		get-constant-record all-constants, none-type, ()

gen-void constant-low-expr(range uri-and-range) lower-ctx
	void, range, constant-gc-safe-value

field-index-from-field nat(record-type low-type, field record-field)
	index-of! record-type.source.low-type-source-inst!.decl.body.record_!.fields, field

# TODO:PERF I think this whole thing should be its own kind of low-expr, so the java version can be optimized
gen-union-member-get low-fun-body(fun low-fun, case-index nat) lower-ctx
	###
	This is basically:
	match a
	as member
		a
	else
		()
	###
	option-type = fun.return-type
	case-type = as-option! option-type
	range = fun.range
	get-a = local-get-low-expr range, only! fun.params
	:: match-union-low-expr
	range: range
	matched: get-a
	case-indices: case-index,
	cases:
		- gen-option option-type, range,
			union-assume-case-low-expr case-type, range, get-a
	else_: gen-empty-option option-type, range

generate-call-method low-fun-body
	fun low-fun
	sum-type low-type
	cases low-sum-type-case mut[]
	method-index nat
do lower-ctx
	forbid preserve-methods
	range = fun.range
	members = sum-type.body.low-union!.members
	if is-empty members
		gen-throw-string fun.return-type, range, "Called method of empty interface"
	else
		members.size is cases.size
		gen-match-union fun.return-type, range, members, (local-get-low-expr range, fun.params[0]), of i, member
			if impl = cases[i].method-impls[method-index]
				gen-call range, impl, for param-index, param in with-index fun.params
					if param-index == 0 then member else local-get-low-expr range, param
			else
				gen-bogus fun.return-type, range

gen-match-enum low-expr
	range uri-and-range
	matched low-expr
	f low-expr mut(x enum-or-flags-member)
do low-common-types
	members = must-be-enum matched.type
	values scalar-values = map::nat[] members, it.value 'to
	match-scalar-low-expr range, matched, values, (map members, f), ()
| WARN: 'union_' should be a param getter since it will be copied for each case
gen-match-union low-expr
	return-type low-type
	range uri-and-range
	member-types low-type[]
	union_ low-expr
	f low-expr mut(member-index nat, get-local low-expr)
do low-common-types
	cases low-expr[] = for case-index, case-type in with-index member-types
		f[case-index, union-assume-case-low-expr case-type, range, union_]
	return-type is cases[0].type
	range, union_, (0 .. member-types.size).to, cases, ()

gen-bogus low-expr(type low-type, range uri-and-range) lower-ctx
	gen-throw-string type, range, "Reached compile error"
gen-error low-expr(range uri-and-range, message string) lower-ctx
	# Avoid using a constant so it will have a stack trace
	error = gen-create-record error-type, range,
		- gen-string-literal range, message
	member-index = sum-type-case-index exception, error-type
	create-union-low-expr exception, range, member-index, error
-gen-throw-string low-expr(type low-type, range uri-and-range, message string) lower-ctx
	throw-low-expr type, range, gen-error range, message

gen-string-literal constant-low-expr(range uri-and-range, value string) lower-ctx
	string, range, constant-string value
constant-string constant(value string) lower-ctx
	get-constant-record all-constants, string,
		- constant-of-bytes char8-array-type, value.to
constant-char8-array constant(type low-type, value string) lower-ctx
	constant-of-bytes type, value.to
constant-of-bytes constant(array-type low-type, bytes nat8 array-view) lower-ctx
	# TODO:PERF creating a Constant per byte is expensive
	get-constant-array all-constants, array-type, map bytes, it.to::scalar-value
constant-char32-array constant(type low-type, value string) lower-ctx
	get-constant-array all-constants, type, map value.to::char32[], it.to::scalar-value

gen-constant-array-view constant-low-expr
	type low-type
	range uri-and-range
	array-type low-type
	args constant[]
do lower-ctx
	type, range, get-constant-array-view all-constants, type, array-type, args

gen-create-array low-expr(array-type low-type, range uri-and-range, args low-expr[]) lower-ctx
	if is-empty args
		constant-low-expr array-type, range, get-constant-array all-constants, array-type, ()
	else
		create-array-low-expr array-type, range, args

gen-to-array-view low-expr(array low-expr) lower-ctx, quick-fill-in-low-fun-body
	to-array-view = get-low-fun common-funs.to-array-view, (array.type.as-array!,), ()
	call-low-expr array.range, to-array-view, (array,)
gen-to-buffer-view low-expr(buffer low-expr) lower-ctx, quick-fill-in-low-fun-body
	to-buffer-view = get-low-fun common-funs.to-buffer-view, (buffer.type.as-buffer!,), ()
	call-low-expr buffer.range, to-buffer-view, (buffer,)

gen-concat-array-views low-expr
	range uri-and-range
	elem-type low-type
	array-views low-expr[] mut(array-view-type low-type)
do lower-ctx, quick-fill-in-low-fun-body
	concat = get-low-fun common-funs.concat-array-views, (elem-type,), ()
	call-low-expr range, concat,
		- gen-create-array concat.params[0].type, range, array-views[concat.params[0].type.as-array!]

gen-create-record low-expr(type low-type, range uri-and-range, args low-expr[]) lower-ctx
	if !prevent-constant type.body.low-record! and x = as-constants args
		type, range, get-constant-record all-constants, type, x
	else
		create-record-low-expr type, range, args

as-constants constant[]?(exprs low-expr[])
	map-every exprs, it.constant-low-expr.?value

gen-record-field-get low-expr
	range uri-and-range
	arg low-expr
	field-index nat
do lower-ctx
	field-type = arg.type.body.low-record!.fields[field-index].type
	if is-empty-type field-type
		gen-drop-then range, arg, constant-low-expr field-type, range, constant-gc-safe-value
	else
		record-field-get-low-expr range, arg, field-index
gen-and low-expr(range uri-and-range, a low-expr, b low-expr) lower-ctx
	if-low-expr range, a, b, gen-false range
gen-or low-expr(range uri-and-range, a low-expr, b low-expr) lower-ctx
	if-low-expr range, a, (gen-true range), b

gen-reference-create low-expr(reference-type low-type, range uri-and-range, value low-expr) lower-ctx
	gen-create-record reference-type, range, (value,)
gen-reference-read low-expr(range uri-and-range, reference low-expr) lower-ctx
	gen-record-field-get range, reference, 0
gen-reference-write low-expr
	range uri-and-range
	reference low-expr
	value low-expr
do lower-ctx
	_ = get-referenced-type reference.type # Assert that it's a reference type
	record-field-set-low-expr range, reference, 0, value

gen-equal-integral low-expr(range uri-and-range, a low-expr, b low-expr) lower-ctx
	builtin-binary-low-expr bool, range, equal-exact, a, b
gen-intersect-nat low-expr
	range uri-and-range
	type nat-type
	a low-expr
	b low-expr
do lower-ctx
	builtin-binary-low-expr type.to, range, bitwise-and, a, b

gen-json-array low-expr(value low-expr) lower-ctx
	gen-create-record json-type, value.range,
		- create-union-low-expr json-inner, value.range, value.type.json-inner-member-index, value

constant-json-number constant(value float) lower-ctx
	get-constant-record all-constants, json-type,
		- get-constant-union all-constants, json-inner, json-float-member-index, value.to

constant-json-string constant(value string) lower-ctx
	get-constant-record all-constants, json-type,
		- get-constant-union all-constants, json-inner, json-string-member-index,
			get-constant-string all-constants, string, value

-json-inner low-type() lower-ctx
	json-type.body.low-record!.fields.only!.type

-json-float-member-index nat() lower-ctx
	index-of! json-inner.body.low-union!.members, float64
-json-string-member-index nat() lower-ctx
	index-of! json-inner.body.low-union!.members, string
-json-inner-member-index nat(type low-type) lower-ctx
	index-of! json-inner.body.low-union!.members, type
