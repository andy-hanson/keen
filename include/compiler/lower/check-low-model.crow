	as equal-pointer
		assert arg0-type == arg1-type
		(bool-type,), (), ()
	as less-pointer
		assert arg0-type == arg1-type
		(bool-type,), (), ()
	as reference-equal
		assert arg0-type == arg1-type
		(bool-type,), (), ()
	as less-char8
		bool-type, char8-type, char8-type
	as new-array
		throw unreachable
	as seq
		assert return-type == arg1-type
		(), (void-type,), ()
	as switch-fiber
		void-type, common-types.nat64-mut-pointer-mut-pointer, common-types.nat64-mut-pointer
	as write-to-pointer
		(void-type,), (), (arg0-type.as-pointee,)

-binary-math-type low-type(kind builtin-binary-math)
	match kind
	as atan2-float32
		float32-type
	as unsafe-pow-float32
		float32-type
	as fmod-float32
		float32-type
	as fmod-float64
		float64-type
	as atan2-float64
		float64-type
	as unsafe-pow-float64
		float64-type

-expect-binary alias
	(low-type?, low-type?, low-type?)
-new expect-binary(return low-type, arg0 low-type, arg1 low-type)
	(return,), (arg0,), (arg1,)

-check-type-equal void(ctx fun-ctx, expected low-type, actual low-type)
	if expected != actual
		show-ctx = ctx.ctx show-ctx
		all-types = ctx.program all-types
		fun = show-ctx show-fun-name ctx.program, ctx.fun
		show-expected = ctx.ctx.show-ctx show-low-type all-types, expected
		show-actual = ctx.ctx.show-ctx show-low-type all-types, actual
		error log "Somewhere in {fun}:\nExpected:\n{show-expected}\nActual:\n{show-actual}"
		throw unreachable
