import
	../model/low-model
	../model/model
	../util/enum-map
	../util/util

check-low-program void(a low-program, types low-common-types)
	if a.target == java
		for struct in a.all-non-extern-types
			match x = body struct
			as low-union
				assert are-unique x.members
			else
				()
	the ctx = a, types
	for fun in a.all-non-extern-funs
		if e = fun.body.low-expr
			check-expr fun.return-type, e

-are-unique[t] bool(a t[]) t key
	a.to::(t set).size == a.size

low-common-types record
	bool low-type
	char-types (char-type, low-type) enum-map
	exception low-type
	integral-types (integral-type, low-type) enum-map
	float-types (float-type, low-type) enum-map
	string low-type
	void low-type
-int64 low-type(a low-common-types)
	a.integral-types[int64]
-nat32 low-type(a low-common-types)
	a.integral-types[nat32]
-nat64 low-type(a low-common-types)
	a.integral-types[nat64]
-float32 low-type(a low-common-types)
	a.float-types[float32]
-float64 low-type(a low-common-types)
	a.float-types[float64]

-ctx record
	program low-program
	types low-common-types
-program low-program() ctx
	the::ctx.program
-types low-common-types() ctx
	the::ctx.types

-check-expr void(type low-type, expr low-expr) ctx
	if is-bogus expr.type
		assert expr.kind.throw-low-expr
	else
		forbid is-bogus type
		type is expr.type
	match x = expr.kind
	as array-op-low-expr
		out-element = if is-void type then type else as-array-or-buffer! type
		check-expr x.input.type, x.input
		if l = x.local
			l.type is x.in-element
		check-expr out-element, x.body
	as builtin-low-expr
		check-builtin type, x
	as call-low-expr
		type is x.called.return-type
		for param, arg in zip x.called.params, x.args
			check-expr param.type, arg
	as cast-low-expr
		check-expr x.inner.type, x.inner
	as constant
		each-nested-constant program.all-constants, type, x, of constant-type, c
			match c
			as constant-record
				assert constant-type.body.low-record
			else
				# TODO
				()
	as create-array-low-expr
		element-type = as-array! type
		for arg in x.args
			check-expr element-type, arg
	as create-record-low-expr
		record_ = type.body.low-record!
		for arg, field in zip x.args, record_.fields
			check-expr field.type, arg
	as create-union-low-expr
		check-expr type.body.low-union!.members[x.member-index], x.arg
	as drop-low-expr
		assert is-void type
		check-expr-any-type x.arg
	as finally-low-expr
		check-expr types.void, x.right
		check-expr type, x.below
	as if-low-expr
		check-expr types.bool, x.cond
		check-expr type, x.then_
		check-expr type, x.else_
	as let-low-expr
		check-expr x.local.type, x.value
		check-expr type, x.then_
	as lambda-low-expr
		assert return-type, param-type = as-lambda-type type
		assert x.param.type == param-type
		check-expr return-type, x.body
	as local-get-low-expr
		type is x.local.type
	as local-set-low-expr
		assert is-void type
		check-expr x.local.type, x.value
	as loop-low-expr
		check-expr type, x.body
	as loop-break-low-expr
		check-expr type, x.value
	as loop-continue-low-expr
		()
	as match-scalar-low-expr
		body = x.matched.type.body
		assert low-enum body or is-char-or-integral body.low-builtin-type!.kind
		check-expr-any-type x.matched
		for case_ in x.case-exprs
			check-expr type, case_
		if e = x.else_
			check-expr type, e
	as match-string-like-low-expr
		check-expr-any-type x.matched
		assert x.equals.return-type == types.bool
		x.equals.params.size is 2
		assert every x.equals.params, it.type == x.matched.type
		for case_ in x.cases
			check-expr type, case_.then_
		check-expr type, x.else_
	as match-union-low-expr
		check-expr-any-type x.matched
		assert x.member-indices.size <= x.union_.members.size
		x.cases.size is x.member-indices.size
		for case_ in x.cases
			check-expr type, case_
		if e = x.else_
			check-expr type, e
	as record-field-get-low-expr
		check-expr-any-type x.record_
		assert x.field.type == type
	as record-field-set-low-expr
		assert is-void type
		check-expr-any-type x.record_
		check-expr x.field.type, x.value
	as seq-low-expr
		for part in x.parts[0 .. end - 1]
			check-expr types.void, part
		check-expr type, x.parts[end - 1]
	as throw-low-expr
		check-expr types.exception, x.thrown
	as try-low-expr
		check-expr type, x.tried
		check-catches type, types.exception, x.exception-member-indices, x.catch-cases
	as try-let-low-expr
		local = x.local
		if local
			assert local.type == x.value.type
		check-expr x.value.type, x.value
		check-catches type, types.exception, x.exception-member-index.to, (x.catch_,)
		check-expr type, x.then_
	as union-assume-case-low-expr
		assert contains x.union-type.body.low-union!.members, type
		check-expr x.union-type, x.arg
	as union-is-case-low-expr
		type is types.bool
		check-expr x.union-type, x.arg
	as var-get-low-expr
		type is x.var.type
	as var-set-low-expr
		assert is-void type
		check-expr x.var.type, x.value

-check-catches void
	type low-type
	union_ low-type
	member-indices indices
	cases low-local-and-expr[]
do ctx
	cases.size is member-indices.size
	members = union_.union-members
	for case-index, case_ in with-index cases
		check-local-and-expr type, members[member-indices[case-index]], case_

-check-local-and-expr void(type low-type, local-type low-type, a low-local-and-expr) ctx
	if local = a.local
		local.type is local-type
	check-expr type, a.expr

-union-members low-type[](type low-type)
	type.body.low-union!.members

-check-expr-any-type void(expr low-expr) ctx
	check-expr expr.type, expr

-check-builtin void(type low-type, a builtin-low-expr) ctx
	match x = a.fun
	as builtin-unary
		check-builtin-unary type, x, only! a.args
	as builtin-binary
		a.args.size is 2
		check-builtin-binary type, x, only2! a.args
	as builtin-ternary
		a.args.size is 3
		check-builtin-ternary type, x, only3! a.args
	as builtin-fun-call-lambda
		# TODO: arg0 is a lambda, we could extract the param type,
		fun, param = only2! a.args
		#asdf = fn.type.source low-type-source-lambda! # TODO: I need the type of the lambda .........................
		# TODO: assert that 'type' is the lambda return type -------------------------------------------------------------
		check-expr fun.type, fun
		check-expr param.type, param # TODO: this should use the lambda param type ---------------------------------------------
	as builtin-fun-constant
		# These were compiled to constants
		throw unreachable
	as builtin-fun-is-empty-type
		# These were compiled to constants
		throw unreachable
	as builtin-fun-is-target
		# These were compiled to constants
		throw unreachable
	as js-fun
		check-builtin-js type, x, a.args

-check-builtin-unary void(type low-type, kind builtin-unary, a low-expr) ctx
	check = of return-type low-type, arg-type low-type
		type is return-type
		check-expr arg-type, a
	check2 void mut(x low-type) = check[it, it]
	bool = types.bool
	float32 = types.float32
	float64 = types.float64
	int64 = types.int64
	nat32 = types.nat32
	nat64 = types.nat64
	match kind
	as array-size
		type is nat64
		assert as-array-or-buffer a.type
		check-expr a.type, a
	as bits-of-float32
		check[nat32, float32]
	as bits-of-float64
		check[nat64, float64]
	as bitwise-not
		assert as-integral-type type
		check-expr type, a
	as float32-from-bits
		check[float32, nat32]
	as float64-from-bits
		check[float64, nat64]
	as uninitialized-buffer
		assert as-array-or-buffer type
		check-expr nat64, a
	as not
		check2[bool]
	as reinterpret-cast
		check-expr a.type, a
	as to-float32-from-float64
		check[float32, float64]
	as to-float64-from-float32
		check[float64, float32]
	as to-float64-from-int64
		check[float64, int64]
	as to-float64-from-nat64
		check[float64, nat64]
	as truncate-to-int64-from-float64
		check[int64, float64]
	as weak-ref-get
		as-option! type is as-weak-ref! a.type
		check-expr a.type, a
	as weak-ref-new
		a.type is as-weak-ref! type
		check-expr a.type, a
	as wrap-convert-integral
		assert as-integral-type-allow-char type
		assert is-bool a.type or as-integral-type-allow-char a.type
		check-expr a.type, a

-check-builtin-binary void
	type low-type
	kind builtin-binary
	a low-expr, b low-expr
do ctx
	check = of return-type low-type, a-type low-type, b-type low-type
		type is return-type
		check-expr a-type, a
		check-expr b-type, b
	check3 = of x low-type then check[x, x, x]
	binary-integral = of
		assert as-integral-type type
		check-expr type, a
		check-expr type, b
	binary-float = of
		assert is-float32-or-64 type
		check-expr type, a
		check-expr type, b
	binary-float-or-integral = of
		assert is-float32-or-64 type or as-integral-type type
		check-expr type, a
		check-expr type, b
	compare-primitive = of
		assert is-bool type
		assert is-bool a.type or is-char8-or-32 a.type or as-integral-type a.type or is-float32-or-64 a.type
		check-expr a.type, a
		check-expr a.type, b
	bool = types.bool
	float64 = types.float64
	nat64 = types.nat64
	match kind
	as add-float
		binary-float[]
	as array-get
		type is as-array-or-buffer! a.type
		check-expr a.type, a
		check-expr nat64, b
	as bitwise-and
		binary-integral[]
	as bitwise-or
		binary-integral[]
	as bitwise-xor
		binary-integral[]
	as compare
		# TODO: returns 'comparison'
		a.type is b.type
		check-expr a.type, a
		check-expr b.type, b
	as equal-exact
		check[bool, a.type, a.type]
	as equal-float-ieee
		compare-primitive[]
	as less-float-ieee
		compare-primitive[]
	as mul-float
		binary-float[]
	as sub-float
		binary-float[]
	as unsafe-bit-shift-left
		binary-integral[]
	as unsafe-bit-shift-right
		binary-integral[]
	as unsafe-div
		binary-float-or-integral[]
	as unsafe-mod-float64
		check3[float64]
	as unsafe-mod-nat64
		check3[nat64]
	as wrap-add
		binary-integral[]
	as wrap-mul
		binary-integral[]
	as wrap-sub
		binary-integral[]

-check-builtin-ternary void
	type low-type
	kind builtin-ternary
	a low-expr, b low-expr, c low-expr
do ctx
	match kind
	as array-set
		type is types.void
		check-expr a.type, a
		check-expr types.nat64, b
		check-expr a.type.as-buffer!, c

-check-builtin-js void(type low-type, fun js-fun, args low-expr[]) ctx
	js-any = program.common-funs.low-common-funs-js!.js-any
	js-args = of
		for::void arg in args
			check-expr js-any, arg
	all-js = of
		type is js-any
		js-args[]
	bool-from-js = of
		type is types.bool
		js-args[]
	match fun
	as await
		all-js[]
	as call
		all-js[]
	as call-new
		all-js[]
	as call-property
		all-js[]
	as call-property-spread
		type is js-any
		a, name, xs = only3! args
		check-expr js-any, a
		check-expr js-any, name
		assert as-array xs.type
		check-expr xs.type, xs
	as eq-eq-eq
		bool-from-js[]
	as eval
		all-js[]
	as get
		all-js[]
	as import_
		all-js[]
	as instanceof
		bool-from-js[]
	as js-global
		all-js[]
	as null
		type is js-any
		assert is-empty args
	as plus
		all-js[]
	as set
		type is types.void
		js-args[]
	as typeof
		all-js[]
	as undefined
		type is js-any
		assert is-empty args
