-expect-unary record(return low-type?, arg low-type?)
-new expect-unary()
	(), ()
-new expect-unary(return low-type, arg low-type)
	(return,), (arg,)

-check-special-binary void(ctx fun-ctx, type low-type, a special-binary-low-expr, expr-pos expr-pos)
	arg0, arg1 = a.args
	return, expected0, expected1 = ctx.common-types binary-expected a.kind, type, arg0.type, arg1.type
	if r ?= return
		ctx check-type-equal r, type
	ctx check-low-expr (expected0 ?? arg0.type), arg0, non-tail
	ctx check-low-expr (expected1 ?? arg1.type), arg1, (a.kind.can-tail-recurse ? expr-pos : non-tail)
-can-tail-recurse bool(a builtin-binary)
	a == seq
-binary-expected expect-binary(
	common-types low-common-types,
	kind builtin-binary,
	return-type low-type,
	arg0-type low-type,
	arg1-type low-type,
)
	match kind
	as add-float32
		float32-type, float32-type, float32-type
	as mul-float32
		float32-type, float32-type, float32-type
	as sub-float32
		float32-type, float32-type, float32-type
	as unsafe-div-float32
		float32-type, float32-type, float32-type
	as add-float64
		float64-type, float64-type, float64-type
	as mul-float64
		float64-type, float64-type, float64-type
	as sub-float64
		float64-type, float64-type, float64-type
	as unsafe-div-float64 # TODO: should this be builtin-binary-math? -----------------------------------------------------------
		float64-type, float64-type, float64-type
	as add-pointer-and-nat64
		assert return-type == arg0-type
		assert return-type is-pointer-non-gc
		(), (), (nat64-type,)
	as sub-pointer-and-nat64
		assert return-type == arg0-type
		assert return-type is-pointer-non-gc
		(), (), (nat64-type,)
	as bitwise-and-int8
