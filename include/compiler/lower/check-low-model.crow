import
	../concretize/gather-info
	../frontend/show-model
	../model/concrete-model
	../model/low-model
	../model/model
	../model/show-low-model
	../util/full-index-map
	../util/util
	./low-expr-helpers

check-low-program void(show-ctx show-ctx, program program, a low-program)
	ctx ctx = show-ctx, program, a.concrete-program, a # TODO: a.concreteprogram and a as separate properties is redundant -0000000
	for _, fun : a all-funs
		ctx check-low-fun fun
	
-ctx record
	show-ctx show-ctx
	model-program program
	concrete-program concrete-program
	program low-program

-fun-ctx record(ctx ctx, fun low-fun)
-program low-program(a fun-ctx)
	a.ctx program
-concrete-program concrete-program(a fun-ctx)
	a.ctx concrete-program
-common-types low-common-types(a fun-ctx)
	a.program common-types

-check-low-fun void(ctx ctx, fun low-fun)
	match fun body
	as low-fun-body-extern _
		()
	as low-fun-expr-body x
		(ctx, fun) check-low-expr fun.return-type, x.expr, tail

-expr-pos enum(non-tail, tail, loop_)
-== bool(a expr-pos, b expr-pos)
-to json(a expr-pos)

-check-low-expr void(ctx fun-ctx, type low-type, expr low-expr, expr-pos expr-pos)
	ctx check-type-equal type, expr.type
	match expr kind
	as abort-low-expr _
		()
	as call-low-expr x
		called = ctx.program.all-funs[x called]
		assert called !may-yield ||
			ctx.fun may-yield ||
			ctx.fun.source.concrete-fun! is-always-non-yielding ctx.concrete-program.common-funs
		ctx check-type-equal type, called.return-type
		for param, arg : called.params zip x.args
			ctx check-low-expr param.type, arg, non-tail
	as call-fun-pointer-low-expr x
		ctx check-type-equal type, x.fun-pointer-type.return-type
		x.fun-pointer-type.param-types.size is x.args.size
		for param-type, arg : x.fun-pointer-type.param-types zip x.args
			ctx check-low-expr param-type, arg, non-tail
	as create-record-low-expr x
		for field, arg : type.low-record!.fields zip x.args
			ctx check-low-expr field.type, arg, non-tail
	as create-union-low-expr x
		ctx check-low-expr type.low-union!.members[x member-index], x.arg, non-tail
	as fun-pointer-low-expr _
		() # TODO
	as if-low-expr x
		ctx check-low-expr bool-type, x.cond, non-tail
		ctx check-low-expr type, x.then, expr-pos
		ctx check-low-expr type, x.else_, expr-pos
	as builtin-fun-init _
		ctx check-type-equal type, void-type
	as let-low-expr x
		ctx check-low-expr x.local.type, x.value, non-tail
		ctx check-low-expr type, x.then, expr-pos
	as local-get-low-expr x
		ctx check-type-equal type, x.local.type
	as local-pointer-low-expr x
		ctx check-type-equal type.as-non-gc-pointee, x.local.type
	as local-set-low-expr x
		ctx check-type-equal type, void-type
		ctx check-low-expr x.local.type, x.value, non-tail
	as loop-low-expr x
		ctx check-low-expr type, x.body, loop_
	as loop-break-low-expr x
		expr-pos is loop_
		ctx check-low-expr type, x.value, non-tail
	as loop-continue-low-expr
		expr-pos is loop_
	as pointer-cast-low-expr x
		# TODO: there are some limitations on target...
		ctx check-low-expr x.target.type, x.target, non-tail
	as record-field-get-low-expr x
		ctx check-low-expr x.target.type, x.target, non-tail
		field-type = x.target-record-type.fields[x field-index] type
		ctx check-type-equal type, field-type
	as record-field-pointer-low-expr x
		ctx check-low-expr x.target.type, x.target, non-tail
		field-type = x.target-record-type.fields[x field-index] type
		ctx check-type-equal type.as-non-gc-pointee, field-type
	as record-field-set-low-expr x
		ctx check-low-expr x.target.type, x.target, non-tail
		field-type = x.target-record-type.fields[x field-index] type
		ctx check-low-expr field-type, x.value, non-tail
		ctx check-type-equal type, void-type
	as constant _
		# Constants are untyped, so can't check more
		()
	as special-unary-low-expr x
		ctx check-special-unary type, x
	as special-unary-math-low-expr x
		actual = x.kind unary-math-type
		ctx check-type-equal type, actual
		ctx check-low-expr actual, x.arg, non-tail
	as special-binary-low-expr x
		ctx check-special-binary type, x, expr-pos
	as special-binary-math-low-expr x
		actual = x.kind binary-math-type
		ctx check-type-equal type, actual
		arg0, arg1 = x args
		ctx check-low-expr actual, arg0, non-tail
		ctx check-low-expr actual, arg1, non-tail
	as special-ternary-low-expr x
		match x kind
		as interpreter-backtrace
			() # TODO
	as special-4ary-low-expr x
		match x kind
		as switch-fiber-initial
			ctx check-type-equal type, void-type
			ct = ctx common-types
			arg0, arg1, arg2, _ = x args
			ctx check-low-expr ct.fiber-reference, arg0, non-tail
			ctx check-low-expr ct.nat64-mut-pointer-mut-pointer, arg1, non-tail
			ctx check-low-expr ct.nat64-mut-pointer, arg2, non-tail
			# TODO: arg3 is a 'void function(a fiber)'
	as switch-low-expr x
		ctx check-low-expr x.value.type, x.value, non-tail
		for case_ : x case-exprs
			ctx check-low-expr type, case_, expr-pos
	as tail-recur-low-expr x
		expr-pos is tail
		for param, value : x update-params
			ctx check-low-expr param.type, value, non-tail
	as union-as-low-expr x
		ctx check-type-equal type, x.union_.type.low-union!.members[x member-index]
		ctx check-low-expr x.union_.type, x.union_, non-tail
	as union-kind-low-expr x
		ctx check-type-equal type, nat64.to
		ctx check-low-expr x.union_.type, x.union_, non-tail
	as var-get-low-expr x
		ctx check-type-equal type, ctx.program.vars[x var-index].type
	as var-set-low-expr x
		ctx check-type-equal type, void-type
		ctx check-low-expr ctx.program.vars[x var-index].type, x.value, non-tail

-check-special-unary void(ctx fun-ctx, type low-type, a special-unary-low-expr)
	expected = ctx.common-types unary-expected a.kind, type, a.arg.type
	if r ?= expected return
		ctx check-type-equal r, type
	ctx check-low-expr (expected.arg ?? a.arg.type), a.arg, non-tail

-unary-expected expect-unary(
	common-types low-common-types,
	kind builtin-unary,
	return-type low-type,
	arg-type low-type,
)
	match kind
	as as-future
		throw unreachable
	as as-future-impl
		throw unreachable
	as as-mut-array
		throw unreachable
	as as-mut-array-impl
		throw unreachable
	as array-size
		throw unreachable
	as array-pointer
		throw unreachable
	as c-string-of-symbol
		throw unreachable
	as symbol-of-c-string
		throw unreachable
	as to-char8-array-from-string
		throw unreachable
	as trust-as-string
		throw unreachable
	as weak-ref-get
		throw unreachable
	as weak-ref-new
		throw unreachable
	as reference-from-pointer
		()
	as as-any-pointer
		()
	as bits-of-float32
		nat32-type, float32-type
	as bits-of-float64
		nat64-type, float64-type
	as bitwise-not-nat8
		nat8-type, nat8-type
	as bitwise-not-nat16
		nat16-type, nat16-type
	as bitwise-not-nat32
		nat32-type, nat32-type
	as bitwise-not-nat64
		nat64-type, nat64-type
	as count-ones-nat64
		nat64-type, nat64-type
	as deref
		(arg-type.as-pointee,), ()
	as drop
		(void-type,), ()
	as float32-from-bits
		float32-type, nat32-type
	as float64-from-bits
		float64-type, nat64-type
	as is-nan-float32
		bool-type, float32-type
	as is-nan-float64
		bool-type, float64-type
	as jump-to-catch
		void-type, common-types.catch-point-const-pointer
	as not
		bool-type, bool-type
	as setup-catch
		bool-type, 	common-types.catch-point-mut-pointer
	as to-char8-from-nat8
		char8-type, nat8-type
	as to-float32-from-float64
		float32-type, float64-type
	as to-float64-from-float32
		float64-type, float32-type
	as to-float64-from-int64
		float64-type, int64-type
	as to-float64-from-nat64
		float64-type, nat64-type
	as to-int64-from-int8
		int64-type, int8-type
	as to-int64-from-int16
		int64-type, int16-type
	as to-int64-from-int32
		int64-type, int32-type
	as to-nat8-from-char8
		nat8-type, char8-type
	as to-nat32-from-char32
		nat32-type, char32-type
	as to-nat64-from-nat8
		nat64-type, nat8-type
	as to-nat64-from-nat16
		nat64-type, nat16-type
	as to-nat64-from-nat32
		nat64-type, nat32-type
	as to-nat64-from-ptr
		assert arg-type is-pointer-non-gc
		(nat64-type,), ()
	as to-ptr-from-nat64
		assert return-type is-pointer-non-gc
		(), (nat64-type,)
	as truncate-to-int64-from-float64
		int64-type, float64-type
	as unsafe-to-char32-from-char8
		char32-type, char8-type
	as unsafe-to-char32-from-nat32
		char32-type, nat32-type
	as unsafe-to-int8-from-int64
		int8-type, int64-type
	as unsafe-to-int16-from-int64
		int16-type, int64-type
	as unsafe-to-int32-from-int64
		int32-type, int64-type
	as unsafe-to-int64-from-nat64
		int64-type, nat64-type
	as unsafe-to-nat8-from-nat64
		nat8-type, nat64-type
	as unsafe-to-nat16-from-nat64
		nat16-type, nat64-type
	as unsafe-to-nat32-from-int32
		nat32-type, int32-type
	as unsafe-to-nat32-from-nat64
		nat32-type, nat64-type
	as unsafe-to-nat64-from-int64
		nat64-type, int64-type

