import
	../model/low-model
	../model/model
	../model/source-range
	../util/util
	./all-constants-builder
	./lower-ctx
	./lower-expr-ctx
	./generate

lower-auto-fun low-expr(fun low-fun, a auto-fun) lower-ctx, quick-fill-in-low-fun-body
	the lower-expr-ctx = fun, ()
	return-type = fun.return-type
	params = fun.params
	param0 = of then gen-param-get fun.range, params[0]
	param1 = of then gen-param-get fun.range, params[1]
	range = fun.range
	match a.kind
	as compare
		compare-nats = of storage nat-type
			p0 = gen-cast-nat range, storage, param0[]
			p1 = gen-cast-nat range, storage, param1[]
			gen-compare-integral return-type, range, p0, p1
		match x = enum-flags-record-or-union params.same-type
		as enum_
			compare-nats[x.storage]
		as flags_
			compare-nats[x.storage]
		as low-record
			lower-compare-record range, return-type, params.only2!, x.fields, a.members
		as low-union
			lower-compare-union range, return-type, params.only2!, x.members, a.members
	as equals
		match x = enum-flags-record-or-union params.same-type
		as enum_
			lower-equal-enum-or-flags range, x.storage, param0[], param1[]
		as flags_
			lower-equal-enum-or-flags range, x.storage, param0[], param1[]
		as low-record
			lower-equal-record range, params.only2!, x.fields, a.members
		as low-union
			lower-equal-union range, return-type, params.only2!, x.members, a.members
	as hash
		match x = enum-flags-record-or-union params[0].type
		as enum_
			lower-hash-enum-or-flags range, params.only2!, x.storage
		as flags_
			lower-hash-enum-or-flags range, params.only2!, x.storage
		as low-record
			lower-hash-record range, params.only2!, x.fields, a.members
		as low-union
			lower-hash-union range, params.only2!, x.members, a.members
	as members-of-enum-or-flags
		gen-constant-array all-constants, return-type, range,
			map return-type.array-element-type.enum-or-flags-members, it.value.to
	as to-enum-or-flags-option-from-nat
		lower-integral-to-opt-enum-or-flags range, return-type, only! params
	as to-enum-or-flags-option-from-symbol
		lower-symbol-to-opt-enum-or-flags range, return-type, only! params
	as to-nat-from-enum-or-flags
		arg = param0[]
		storage = enum-or-flags-storage arg.type
		gen-widen-nat return-type.must-be-nat-type, gen-cast storage.nat-type, range, param0[]
	as to-json
		param = only! params
		match body = enum-flags-record-or-union param.type
		as enum_
			auto-fun-match-enum range, return-type, param, of x
				gen-constant return-type, range, constant-json-string x.name.to
		as flags_
			gen-json-array lower-flags-to-array range, json-array-type, param, of member
				constant-json-string member.name.to
		as low-record
			lower-record-to-json range, param, body.fields, a.members
		as low-union
			lower-union-to-json range, param, body.members, a.members
	as to-symbol-array-from-flags
		lower-flags-to-array range, return-type, params.only!, of member
			constant-symbol member.name
	as to-symbol-from-enum
		auto-fun-match-enum range, return-type, params.only!, of x
			symbol-for-enum-member return-type, range, x

lower-flags-function low-expr(cf low-fun, fn flags-function) lower-ctx
	range = cf.range
	param0 = of
		gen-param-get range, cf.params[0]
	param1 = of
		gen-param-get range, cf.params[1]
	cast-param0 = of storage nat-type
		gen-cast-nat range, storage, param0[]
	cast-param1 = of storage nat-type
		gen-cast-nat range, storage, param1[]
	cast-to-flags = of x low-expr
		gen-cast cf.return-type, range, x
	match fn
	as intersect
		storage = flags-storage cf.params[0].type
		res = gen-intersect-nat range, storage, cast-param0[storage], cast-param1[storage]
		cast-to-flags[res]
	as negate
		# ~x & all
		storage = flags-storage cf.params[0].type
		neg = gen-builtin storage.nat-type, range, bitwise-not, (), (cast-param0[storage],)
		all = get-all-flags-expr range, cf.return-type
		intersect = gen-intersect-nat range, storage, neg, all
		cast-to-flags[intersect]
	as none
		storage = flags-storage cf.return-type
		res = gen-constant-zero storage.nat-type, range
		cast-to-flags[res]
	as subscript
		storage = flags-storage cf.params[0].type
		gen-flags-subscript range, storage, cast-param0[storage], cast-param1[storage]
	as union_
		storage = flags-storage cf.params[0].type
		res = gen-builtin storage.nat-type, range, bitwise-or, (),
			- cast-param0[storage]
			- cast-param1[storage]
		cast-to-flags[res]

-get-all-flags-expr low-expr(range uri-and-range, flags-type low-type) lower-ctx
	type = flags-type.flags-storage.nat-type
	gen-constant-nat type, range, flags-type.must-be-flags.get-all-flags-value

# WARN: p1 is used twice, so it should be a param get (or other expression that has no side effect)
-gen-flags-subscript low-expr
	range uri-and-range
	storage nat-type
	p0 low-expr
	p1 low-expr
do lower-ctx
	p0.type is p1.type
	# (p0 & p1) == p1
	intersect = gen-intersect-nat range, storage, p0, p1
	gen-equal-integral range, intersect, p1

-must-be-nat-type nat-type(a low-type)
	a.body.low-builtin-type!.kind.to!

-enum-or-flags-storage nat-type(a low-type)
	match body = a.body
	as low-enum
		body.storage
	as low-flags
		body.storage
	else
		throw unreachable
-enum-storage nat-type(a low-type)
	a.body.low-enum!.storage
-flags-storage nat-type(a low-type)
	a.body.low-flags!.storage

-enum-or-flags-members enum-or-flags-member[](type low-type)
	match x = type.source.low-type-source-inst!.decl.body
	as enum_ then x.members
	as flags_ then x.members
	else then throw unreachable

-lower-equal-enum-or-flags low-expr
	range uri-and-range
	storage nat-type
	arg0 low-expr
	arg1 low-expr
do lower-ctx
	arg0-cast = gen-cast-nat range, storage, arg0
	arg1-cast = gen-cast-nat range, storage, arg1
	gen-equal-integral range, arg0-cast, arg1-cast

-gen-compare-integral low-expr
	comparison-type low-type
	range uri-and-range
	arg0 low-expr
	arg1 low-expr
do
	gen-builtin comparison-type, range, compare::builtin-binary, (), (arg0, arg1)

-gen-cast-nat low-expr(range uri-and-range, type nat-type, arg low-expr) lower-ctx
	gen-cast type.nat-type, range, arg
-gen-cast low-expr(type low-type, range uri-and-range, arg low-expr)
	type, range, arg.cast-low-expr

-lower-flags-to-array low-expr
	range uri-and-range
	array-type low-type
	param low-local
	f constant mut(x enum-or-flags-member)
do lower-ctx, quick-fill-in-low-fun-body
	# (if a & x == 0 then () else ("x",)) ~~ (if a & y == 0 then () else ("y",))
	members = param.type.must-be-flags.members
	storage = param.type.flags-storage
	storage-type = nat-type storage
	value = gen-cast-nat range, storage, gen-param-get range, param
	empty-array = gen-constant array-type, range, get-constant-array all-constants, array-type, ()
	do unless is-empty members else empty-array
	array-for-member = of member enum-or-flags-member
		# if value & x == 0 then () else ("x",)
		member-value low-expr = storage-type, range, member.value.to
		intersect = gen-intersect-nat range, storage, value, member-value
		zero = gen-constant-zero storage-type, range
		test_ = gen-equal-integral range, intersect, zero
		array = gen-constant array-type, range, get-constant-array all-constants, array-type, (f[member],)
		gen-if range, test_, empty-array, array
	res mut = array-for-member[members[0]]
	for member in members[1 .. end]
		res := gen-concat-array range, res, array-for-member[member]
	res

-auto-fun-match-enum low-expr(range uri-and-range, return-type low-type, param low-local, f low-expr mut(x enum-or-flags-member))
	gen-match-scalar return-type, range, (gen-param-get range, param), f

-lower-integral-to-opt-enum-or-flags low-expr
	range uri-and-range
	return-type low-type
	param low-local
do lower-ctx
	if is-flags unwrap-option-type! return-type
		lower-nat-to-opt-flags range, return-type, param
	else
		# TODO: generate a match-integral-low-expr! ------------------------------------------------------------------------------------------
		lower-nat-to-opt-enum range, return-type, param, of param-get, member
			gen-equal-integral range, param-get,
				member.storage.nat-type, range, member.value.to

-lower-nat-to-opt-flags low-expr(range uri-and-range, option-type low-type, param low-local) lower-ctx
	# if a in all then (a.cast,) else ()
	flags-type = unwrap-option-type! option-type
	storage = flags-storage flags-type
	param-get = gen-widen-nat storage, gen-param-get range, param
	all = get-all-flags-expr range, flags-type
	a-in-all = gen-flags-subscript range, storage, all, param-get
	cast = gen-cast flags-type, range, param-get
	some = gen-option option-type, range, cast
	none = gen-empty-option option-type, range
	gen-if range, a-in-all, some, none

-gen-widen-nat low-expr(type nat-type, arg low-expr) lower-ctx
	out-type = nat-type type
	if out-type == arg.type
		arg
	else
		gen-builtin out-type, arg.range, wrap-convert-integral, (), (arg,)

-lower-symbol-to-opt-enum-or-flags low-expr(range uri-and-range, option-type low-type, param low-local) lower-ctx
	enum-type = unwrap-option-type! option-type
	param-get = gen-param-get range, param
	symbol-type = param-get.type
	cases low-match-string-like-case[] = for member in must-be-enum-or-flags enum-type
		- gen-constant symbol-type, range, constant-symbol member.name
		- gen-constant-some option-type, range, member.value.to
	else_ = gen-empty-option option-type, range
	option-type, range, match-string-like-low-expr param-get, equal-symbol-function, cases, else_

-lower-nat-to-opt-enum low-expr
	range uri-and-range
	option-type low-type
	param low-local
	# TODO: we should generate a match on integrals or symbols, since we have expressions for those! ----------
	f-test low-expr mut(param-get low-expr, member enum-or-flags-member)
do lower-ctx
	# TODO: In the common case you can just check 'x <= max-enum-member' and cast it ----------------------------------------------------------------
	enum-type = unwrap-option-type! option-type
	storage = enum-storage enum-type
	param-get = gen-widen-nat storage, gen-param-get range, param
	res mut = gen-empty-option option-type, range
	for member in reverse enum-type.must-be-enum-or-flags
		# if a == "foo" then (foo,) else res
		eq = f-test[param-get, member]
		some-enum-value = gen-constant-some option-type, range, member.value.to
		res := gen-if range, eq, some-enum-value, res
	res

-symbol-for-enum-member low-expr # TODO: INLINE ----------------------------------------------------------------------------
	symbol-type low-type
	range uri-and-range
	member enum-or-flags-member
do lower-ctx
	gen-constant symbol-type, range, constant-symbol member.name

-same-type low-type(params low-local[]) # TODO: rename to 'assert-same-type' ----------------------------------------
	assert all-same params, it.type
	params[0].type

-enum-flags-record-or-union union(enum_, flags_, low-record, low-union)
-enum-flags-record-or-union enum-flags-record-or-union(a low-type)
	match x = a.body
	as low-builtin-type
		throw unreachable
	as low-enum
		a.source.low-type-source-inst!.decl.body.enum_!
	as struct-body-extern-java
		throw unreachable
	as low-flags
		a.source.low-type-source-inst!.decl.body.flags_!
	as low-record
		x
	as low-union
		x
	as low-type-body-deferred
		throw unreachable

-lower-compare-record low-expr
	range uri-and-range
	comparison low-type
	params (low-local, low-local)
	fields low-field[]
	field-compares called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	equal-or-compare-record range, params, fields, field-compares, (of then gen-comparison-equal comparison, range), of x, y
		gen-compare-or range, x, y

-equal-or-compare-record low-expr
	range uri-and-range
	param0 low-local, param1 low-local
	fields low-field[]
	field-called called[]
	# TODO: instead of taking a callback, we could just rely on the caller to do it ........................................
	f-no-fields low-expr mut()
	f-fold low-expr mut(x low-expr, y low-expr)
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	fields.size is field-called.size
	do unless is-empty fields else f-no-fields[]
	p0 = gen-local-get range, param0
	p1 = gen-local-get range, param1
	compare-field = of index nat
		field-type = fields[index].type
		f0 = gen-record-field-get field-type, range, p0, index
		f1 = gen-record-field-get field-type, range, p1, index
		lower-and-call field-called[index], range, (f0, f1)
	res mut = compare-field[0]
	for i in 1::nat .. fields.size
		res := f-fold[res, compare-field[i]]
	res

-lower-compare-union low-expr
	range uri-and-range
	comparison low-type
	param0 low-local, param1 low-local
	members low-type[]
	member-compares called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	do unless is-empty members else gen-comparison-equal comparison, range
	p0 = gen-param-get range, param0
	p1 = gen-param-get range, param1
	less = gen-comparison-less comparison, range
	greater = gen-comparison-greater comparison, range
	###
	Generate code like:
	match param0
	as case0
		match param1
		as case0
			param0 <=> param1
		else
			less
	as case1
		match param1
		as case0
			greater
		as case1
			param0 <=> param1
		else
			less
	...
	###
	if members.size <= 4
		gen-match-union comparison, range, members, p0, of member-index, get-member
			same-case = gen-compare-same-case range, member-compares[member-index], get-member, p1
			# To keep the number of cases down, use 'default' for the bigger half
			more-cases-are-greater = member-index < members.size / 2
			member-indices = if more-cases-are-greater then 0 .. member-index + 1 else member-index .. members.size
			cases low-expr[] = for i in member-indices
				if i == member-index
					same-case
				else
					if more-cases-are-greater then greater else less
			default low-expr? = unless cases.size == members.size
				if more-cases-are-greater then less else greater
			comparison, range, match-union-low-expr p1, member-indices.to, cases, default
	else
		nat = nat64-type
		b-case-index low-local = union-kind::low-generated-local-kind, nat
		get-b-case-index = gen-local-get range, b-case-index
		init-b-case-index low-expr =
			cases low-expr[] = for member-index in 0 .. members.size
				gen-constant-nat nat, range, member-index
			nat, range, match-union-low-expr p1, (0 .. members.size).to, cases, ()
		match_ low-expr = gen-match-union comparison, range, members, p0, of member-index, get-member
			###
			match p1
			as foo
				p0 <=> p1
			else
				42 <=> b-kind
			###
			cases low-expr[] =
				- gen-compare-same-case range, member-compares[member-index], get-member, p1
			a-case-index = gen-constant-nat nat, range, member-index
			default = gen-compare-integral comparison, range, a-case-index, get-b-case-index
			comparison, range,
				match-union-low-expr p1, member-index.to::indices, cases, default
		gen-let comparison, range, b-case-index, init-b-case-index, match_

-gen-compare-same-case low-expr
	range uri-and-range
	compare called
	p0-as-case low-expr
	p1 low-expr
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	lower-and-call compare, range,
		- p0-as-case
		- gen-union-assume-case p0-as-case.type, range, p1

-lower-equal-record low-expr
	range uri-and-range
	params (low-local, low-local)
	fields low-field[]
	field-equals called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	equal-or-compare-record range, params, fields, field-equals, (of then gen-true range), of x, y
		gen-and range, x, y

-lower-equal-union low-expr
	range uri-and-range
	bool-type low-type
	param0 low-local, param1 low-local
	members low-type[]
	member-equals called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	do unless is-empty members else gen-true range
	p0 = gen-param-get range, param0
	p1 = gen-param-get range, param1
	gen-match-union bool-type, range, members, p0, of member-index, get-member
		cases low-expr[] =
			- lower-and-call member-equals[member-index], range,
				- get-member
				- gen-union-assume-case get-member.type, range, p1
		default = gen-false range
		bool-type, range, match-union-low-expr p1, member-index.to, cases, default

-lower-record-to-json low-expr
	range uri-and-range
	param low-local
	fields low-field[]
	field-to-json called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	get-param = gen-param-get range, param
	record-fields = get-param.type.struct-body.record_!.fields
	names symbol[] = map record-fields, it.name
	values low-expr[] = for index, (field, called) in with-index zip fields, field-to-json
		lower-and-call called, range,
			- gen-record-field-get field.type, range, get-param, index
	gen-new-json-object range, names, values

-gen-new-json-object low-expr(range uri-and-range, names symbol[], values low-expr[]) lower-ctx
	names.size is values.size
	symbol-array, json-array = only2! json-named-new-function.params
	gen-call range, json-named-new-function,
		- gen-constant-array all-constants, symbol-array.type, range, for name in names
			constant-symbol name
		- gen-create-array json-array.type, range, values

-gen-constant-array low-expr(constants all-constants-builder, array-type low-type, range uri-and-range, elements constant[])
	array-type, range, get-constant-array constants, array-type, elements

-lower-union-to-json low-expr
	range uri-and-range
	param low-local
	member-types low-type[]
	member-to-json called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	members = as-union param.type.struct-body
	member-types.size is members.size
	member-to-json.size is members.size
	get-param = gen-param-get range, param
	gen-match-union json-type, range, member-types, get-param, of member-index, get-member
		name = members[member-index].member.decl.name
		value = lower-and-call member-to-json[member-index], range, (get-member,)
		gen-new-json-object range, (name,), (value,)

-struct-body struct-body(a low-type)
	a.source.low-type-source-inst!.decl.body

-lower-and-call low-expr
	called called
	range uri-and-range
	args low-expr[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	if fun = get-low-fun-from-called called
		gen-call range, fun, args
	else
		gen-bogus called.return-type.get-low-type, range

-gen-comparison-less low-expr(comparison-type low-type, range uri-and-range)
	gen-constant-nat comparison-type, range, 0
-gen-comparison-equal low-expr(comparison-type low-type, range uri-and-range)
	gen-constant-nat comparison-type, range, 1
-gen-comparison-greater low-expr(comparison-type low-type, range uri-and-range)
	gen-constant-nat comparison-type, range, 2

-gen-compare-or low-expr(range uri-and-range, a low-expr, b low-expr)
	gen-match-scalar a.type, range, a, of x
		if x.value == 1
			b
		else
			gen-constant a.type, range, x.value.to

-lower-hash-enum-or-flags low-expr
	range uri-and-range
	(value low-local, hash-state low-local)
	storage nat-type
do lower-and-expr-ctx
	gen-call range, storage.hash-nat-function,
		- gen-cast-nat range, storage, gen-local-get range, value
		- gen-local-get range, hash-state

-lower-hash-record low-expr
	range uri-and-range
	(value low-local, hash-state low-local)
	fields low-field[]
	field-hash called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	fields.size is field-hash.size
	do unless is-empty fields else gen-void range
	get-value = gen-local-get range, value
	get-hash-state = gen-local-get range, hash-state
	void-type, range, seq-low-expr for i in 0 .. fields.size
		get-field = gen-record-field-get fields[i].type, range, get-value, i
		lower-and-call field-hash[i], range, (get-field, get-hash-state)

-lower-hash-union low-expr
	range uri-and-range
	(value low-local, hash-state low-local)
	members low-type[]
	member-hash called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	members.size is member-hash.size
	do unless is-empty members else gen-void range
	get-value = gen-local-get range, value
	get-hash-state = gen-local-get range, hash-state
	gen-match-union void-type, range, members, get-value, of member-index, get-member
		void-type, range, seq-low-expr
			-
				assert members.size <= nat8.max-value else todo
				index-expr = gen-constant-nat nat8.nat-type, range, member-index
				gen-call range, nat8.hash-nat-function, (index-expr, get-hash-state)
			- lower-and-call member-hash[member-index], range, (get-member, get-hash-state)
