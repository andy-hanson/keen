import
	../model/low-model
	../model/model
	../model/source-range
	../util/util
	./all-constants-builder
	./lower-ctx
	./lower-expr-ctx
	./generate

lower-auto-fun low-expr(fun low-fun, a auto-fun) lower-ctx, quick-fill-in-low-fun-body
	the lower-expr-ctx = fun, ()
	return-type = fun.return-type
	params = fun.params
	param0 = of then local-get-low-expr fun.range, params[0]
	param1 = of then local-get-low-expr fun.range, params[1]
	range = fun.range
	match a.kind
	as compare
		compare-nats = of storage nat-type
			p0-nat = gen-cast-nat range, storage, param0[]
			p1-nat = gen-cast-nat range, storage, param1[]
			builtin-binary-low-expr return-type, range, compare, p0-nat, p1-nat
		match x = enum-flags-record-or-union params.assert-all-same-type
		as enum_
			compare-nats[x.storage]
		as flags_
			compare-nats[x.storage]
		as low-record
			lower-compare-record range, return-type, params.only2!, x.fields, a.members
		as low-union
			lower-compare-union range, return-type, params.only2!, x.members, a.members
	as equals
		match x = enum-flags-record-or-union params.assert-all-same-type
		as enum_
			lower-equal-enum-or-flags range, x.storage, param0[], param1[]
		as flags_
			lower-equal-enum-or-flags range, x.storage, param0[], param1[]
		as low-record
			lower-equal-record range, params.only2!, x.fields, a.members
		as low-union
			lower-equal-union range, return-type, params.only2!, x.members, a.members
	as hash
		match x = enum-flags-record-or-union params[0].type
		as enum_
			lower-hash-enum-or-flags range, params.only2!, x.storage
		as flags_
			lower-hash-enum-or-flags range, params.only2!, x.storage
		as low-record
			lower-hash-record range, params.only2!, x.fields, a.members
		as low-union
			lower-hash-union range, params.only2!, x.members, a.members
	as members-of-enum-or-flags
		gen-constant-array all-constants, return-type, range,
			map return-type.as-array!.enum-or-flags-members, it.value.to
	as to-enum-or-flags-option-from-nat
		param = only! params
		if is-flags as-option! return-type
			lower-nat-to-opt-flags range, return-type, param
		else
			lower-nat-to-opt-enum range, return-type, param
	as to-enum-or-flags-option-from-symbol
		lower-symbol-to-opt-enum-or-flags range, return-type, only! params
	as to-nat-from-enum-or-flags
		arg = param0[]
		storage = enum-or-flags-storage arg.type
		gen-widen-nat return-type.must-be-nat-type, gen-cast storage.to, range, param0[]
	as to-json
		param = only! params
		match body = enum-flags-record-or-union param.type
		as enum_
			enum-to-constant return-type, range, param, it.name.to.constant-json-string
		as flags_
			gen-json-array lower-flags-to-array range, json-array-type, param, of member
				constant-json-string member.name.to
		as low-record
			lower-record-to-json range, param, a.members
		as low-union
			lower-union-to-json range, param, body.members, a.members
	as to-symbol-array-from-flags
		lower-flags-to-array range, return-type, params.only!, of member
			constant-symbol member.name
	as to-symbol-from-enum
		enum-to-constant return-type, range, params.only!, it.name.constant-symbol

lower-flags-function low-expr(cf low-fun, fn flags-function) lower-ctx
	type = cf.return-type
	range = cf.range
	param0 = of
		local-get-low-expr range, cf.params[0]
	param1 = of
		local-get-low-expr range, cf.params[1]
	cast-param0 = of storage nat-type
		gen-cast-nat range, storage, param0[]
	cast-param1 = of storage nat-type
		gen-cast-nat range, storage, param1[]
	cast-to-flags = of x low-expr
		gen-cast type, range, x
	match fn
	as intersect
		storage = flags-storage cf.params[0].type
		res = gen-intersect-nat range, storage, cast-param0[storage], cast-param1[storage]
		cast-to-flags[res]
	as negate
		# ~x & all
		storage = flags-storage cf.params[0].type
		neg = builtin-unary-low-expr storage.to, range, bitwise-not, cast-param0[storage]
		all = get-all-flags-expr range, cf.return-type
		intersect = gen-intersect-nat range, storage, neg, all
		cast-to-flags[intersect]
	as none
		storage = flags-storage cf.return-type
		res = constant-low-expr storage.to, range, 0::nat.to
		cast-to-flags[res]
	as subscript
		storage = flags-storage cf.params[0].type
		gen-flags-subscript range, storage, cast-param0[storage], cast-param1[storage]
	as union_
		storage = flags-storage cf.params[0].type
		res = builtin-binary-low-expr storage.to, range, bitwise-or, cast-param0[storage], cast-param1[storage]
		cast-to-flags[res]

-get-all-flags-expr constant-low-expr(range uri-and-range, flags-type low-type) lower-ctx
	flags-type.flags-storage.to, range, flags-type.must-be-flags.get-all-flags-value.to

# WARN: p1 is used twice, so it should be a param get (or other expression that has no side effect)
-gen-flags-subscript low-expr
	range uri-and-range
	storage nat-type
	p0 low-expr
	p1 low-expr
do lower-ctx
	p0.type is p1.type
	# (p0 & p1) == p1
	intersect = gen-intersect-nat range, storage, p0, p1
	gen-equal-integral range, intersect, p1

-must-be-nat-type nat-type(a low-type)
	a.body.low-builtin-type!.kind.to!

-enum-or-flags-storage nat-type(a low-type)
	match body = a.body
	as low-enum
		body.storage
	as low-flags
		body.storage
	else
		throw unreachable
-enum-storage nat-type(a low-type)
	a.body.low-enum!.storage
-flags-storage nat-type(a low-type)
	a.body.low-flags!.storage

-enum-or-flags-members enum-or-flags-member[](type low-type)
	match x = type.source.low-type-source-inst!.decl.body
	as enum_ then x.members
	as flags_ then x.members
	else then throw unreachable

-lower-equal-enum-or-flags low-expr
	range uri-and-range
	storage nat-type
	arg0 low-expr
	arg1 low-expr
do lower-ctx
	arg0-cast = gen-cast-nat range, storage, arg0
	arg1-cast = gen-cast-nat range, storage, arg1
	gen-equal-integral range, arg0-cast, arg1-cast

-gen-cast-nat low-expr(range uri-and-range, type nat-type, arg low-expr) lower-ctx
	gen-cast type.to, range, arg
-gen-cast low-expr(type low-type, range uri-and-range, arg low-expr)
	builtin-unary-low-expr type, range, reinterpret-cast, arg

-lower-flags-to-array low-expr
	range uri-and-range
	array-type low-type
	param low-local
	f constant mut(x enum-or-flags-member)
do lower-ctx, quick-fill-in-low-fun-body
	members = param.type.must-be-flags.members
	do unless is-empty members else
		constant-low-expr array-type, range, get-constant-array all-constants, array-type, ()
	###
	Generates code like:
	-- if a & x == 0 then () else ("x",)
	-- if a & y == 0 then () else ("y",)
	###
	gen-concat-array-views range, array-type.as-array!, of array-view-type
		empty-array-view = gen-constant-array-view array-view-type, range, array-type, ()
		storage = flags-storage param.type
		value = gen-cast-nat range, storage, local-get-low-expr range, param
		for member in members
			# if value & x == 0 then () else ("x",)
			member-value low-expr = storage.to, range, member.value.to
			intersect = gen-intersect-nat range, storage, value, member-value
			zero = constant-low-expr storage.to, range, 0::nat.to
			test_ = gen-equal-integral range, intersect, zero
			if-low-expr range, test_, empty-array-view,
				gen-constant-array-view array-view-type, range, array-type, (f[member],)

-enum-to-constant low-expr
	type low-type
	range uri-and-range
	param low-local
	f constant mut(x enum-or-flags-member)
do low-common-types
	gen-match-enum range, (local-get-low-expr range, param), of x
		constant-low-expr type, range, f[x]

-lower-nat-to-opt-flags low-expr(range uri-and-range, option-type low-type, param low-local) lower-ctx
	# if a in all then (a.cast,) else ()
	flags-type = as-option! option-type
	storage = flags-storage flags-type
	param-get = gen-widen-nat storage, local-get-low-expr range, param
	all = get-all-flags-expr range, flags-type
	a-in-all = gen-flags-subscript range, storage, all, param-get
	cast = gen-cast flags-type, range, param-get
	if-low-expr range, a-in-all,
		then_: gen-option option-type, range, cast
		else_: gen-empty-option option-type, range

-gen-widen-nat low-expr(type nat-type, arg low-expr) lower-ctx
	out-type low-type = type.to
	if out-type == arg.type
		arg
	else
		builtin-unary-low-expr out-type, arg.range, wrap-convert-integral, arg

-lower-symbol-to-opt-enum-or-flags low-expr(range uri-and-range, option-type low-type, param low-local) lower-ctx
	enum-type = as-option! option-type
	param-get = local-get-low-expr range, param
	cases low-match-string-like-case[] = for member in must-be-enum-or-flags enum-type
		- constant-symbol member.name
		- gen-constant-some option-type, range, member.value.to
	else_ = gen-empty-option option-type, range
	match-string-like-low-expr range, param-get, equal-symbol-function, cases, else_

-lower-nat-to-opt-enum low-expr
	range uri-and-range
	option-type low-type
	param low-local
do lower-ctx
	# TODO:PERF In the common case you can just check 'x <= max-enum-member' and cast it
	enum-type = as-option! option-type
	storage = enum-storage enum-type
	members = must-be-enum-or-flags enum-type
	param-get = gen-widen-nat storage, local-get-low-expr range, param
	:: match-scalar-low-expr
	range: range
	matched: param-get
	case-values: to map::nat[] members, it.value
	case-exprs: for member in members
		gen-constant-some option-type, range, member.value.to
	else_: gen-empty-option option-type, range

-assert-all-same-type low-type(params low-local[])
	assert all-same params, it.type
	params[0].type

-enum-flags-record-or-union union(enum_, flags_, low-record, low-union)
-enum-flags-record-or-union enum-flags-record-or-union(a low-type)
	match x = a.body
	as low-builtin-type
		throw unreachable
	as low-enum
		a.source.low-type-source-inst!.decl.body.enum_!
	as struct-body-extern-java
		throw unreachable
	as low-flags
		a.source.low-type-source-inst!.decl.body.flags_!
	as low-record
		x
	as low-union
		x
	as low-type-body-deferred
		throw unreachable

-lower-compare-record low-expr
	range uri-and-range
	comparison low-type
	params (low-local, low-local)
	fields low-field[]
	field-compares called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	if is-empty fields
		gen-comparison-equal comparison, range
	else
		equal-or-compare-record range, params, fields, field-compares, of x, y
			gen-compare-or range, x, y

-equal-or-compare-record low-expr
	range uri-and-range
	param0 low-local, param1 low-local
	fields low-field[]
	field-called called[]
	f-fold low-expr mut(x low-expr, y low-expr)
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	forbid is-empty fields
	fields.size is field-called.size
	p0 = local-get-low-expr range, param0
	p1 = local-get-low-expr range, param1
	compare-field = of index nat
		lower-and-call field-called[index], range,
			- gen-record-field-get range, p0, index
			- gen-record-field-get range, p1, index
	res mut = compare-field[0]
	for i in 1::nat .. fields.size
		res := f-fold[res, compare-field[i]]
	res

-lower-compare-union low-expr
	range uri-and-range
	comparison low-type
	param0 low-local, param1 low-local
	members low-type[]
	member-compares called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	do unless is-empty members else gen-comparison-equal comparison, range
	p0 = local-get-low-expr range, param0
	p1 = local-get-low-expr range, param1
	less = gen-comparison-less comparison, range
	greater = gen-comparison-greater comparison, range
	###
	Generate code like:
	match param0
	as case0
		match param1
		as case0
			param0 <=> param1
		else
			less
	as case1
		match param1
		as case0
			greater
		as case1
			param0 <=> param1
		else
			less
	...
	###
	if members.size <= 4
		gen-match-union comparison, range, members, p0, of member-index, get-member
			same-case = gen-compare-same-case range, member-compares[member-index], get-member, p1
			# To keep the number of cases down, use 'default' for the bigger half
			more-cases-are-greater = member-index < members.size / 2
			member-indices = if more-cases-are-greater then 0 .. member-index + 1 else member-index .. members.size
			cases low-expr[] = for i in member-indices
				if i == member-index
					same-case
				else
					if more-cases-are-greater then greater else less
			default low-expr? = unless cases.size == members.size
				if more-cases-are-greater then less else greater
			match-union-low-expr range, p1, member-indices.to, cases, default
	else
		b-case-index low-local = union-kind::low-generated-local-kind, nat64
		get-b-case-index = local-get-low-expr range, b-case-index
		init-b-case-index low-expr =
			cases low-expr[] = for member-index in 0 .. members.size
				constant-low-expr nat64, range, member-index.to
			match-union-low-expr range, p1, (0 .. members.size).to, cases, ()
		match_ low-expr = gen-match-union comparison, range, members, p0, of member-index, get-member
			###
			match p1
			as foo
				p0 <=> p1
			else
				42 <=> b-kind
			###
			cases low-expr[] =
				- gen-compare-same-case range, member-compares[member-index], get-member, p1
			a-case-index = constant-low-expr nat64, range, member-index.to
			default = builtin-binary-low-expr comparison, range, compare, a-case-index, get-b-case-index
			match-union-low-expr range, p1, member-index.to::indices, cases, default
		let-low-expr range, b-case-index, init-b-case-index, match_

-gen-compare-same-case low-expr
	range uri-and-range
	compare called
	p0-as-case low-expr
	p1 low-expr
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	lower-and-call compare, range,
		- p0-as-case
		- gen-union-assume-case p0-as-case.type, range, p1

-lower-equal-record low-expr
	range uri-and-range
	params (low-local, low-local)
	fields low-field[]
	field-equals called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	if is-empty fields
		gen-true range
	else
		equal-or-compare-record range, params, fields, field-equals, of x, y
			gen-and range, x, y

-lower-equal-union low-expr
	range uri-and-range
	bool-type low-type
	param0 low-local, param1 low-local
	members low-type[]
	member-equals called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	do unless is-empty members else gen-true range
	p0 = local-get-low-expr range, param0
	p1 = local-get-low-expr range, param1
	gen-match-union bool-type, range, members, p0, of member-index, get-member
		cases low-expr[] =
			- lower-and-call member-equals[member-index], range,
				- get-member
				- gen-union-assume-case get-member.type, range, p1
		default = gen-false range
		match-union-low-expr range, p1, member-index.to, cases, default

-lower-record-to-json low-expr
	range uri-and-range
	param low-local
	field-to-json called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	get-param = local-get-low-expr range, param
	names symbol[] = map get-param.type.struct-body.record_!.fields, it.name
	gen-new-json-object range, names, for index, called in with-index field-to-json
		lower-and-call called, range,
			- gen-record-field-get range, get-param, index

-gen-new-json-object low-expr(range uri-and-range, names symbol[], values low-expr[]) lower-ctx
	names.size is values.size
	symbol-array, json-array = only2! json-named-new-function.params
	call-low-expr range, json-named-new-function,
		- gen-constant-array all-constants, symbol-array.type, range, for name in names
			constant-symbol name
		- gen-create-array json-array.type, range, values

-gen-constant-array low-expr
	constants all-constants-builder
	array-type low-type
	range uri-and-range
	elements constant[]
do
	array-type, range, get-constant-array constants, array-type, elements

-lower-union-to-json low-expr
	range uri-and-range
	param low-local
	member-types low-type[]
	member-to-json called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	members = as-union param.type.struct-body
	member-types.size is members.size
	member-to-json.size is members.size
	get-param = local-get-low-expr range, param
	gen-match-union json-type, range, member-types, get-param, of member-index, get-member
		name = members[member-index].member.decl.name
		value = lower-and-call member-to-json[member-index], range, (get-member,)
		gen-new-json-object range, (name,), (value,)

-struct-body struct-body(a low-type)
	a.source.low-type-source-inst!.decl.body

-lower-and-call low-expr
	called called
	range uri-and-range
	args low-expr[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	if fun = get-low-fun-from-called called
		gen-call range, fun, args
	else
		gen-bogus called.return-type.get-low-type, range

-gen-comparison-less constant-low-expr(comparison-type low-type, range uri-and-range)
	comparison-type, range, 0.to
-gen-comparison-equal constant-low-expr(comparison-type low-type, range uri-and-range)
	comparison-type, range, 1.to
-gen-comparison-greater constant-low-expr(comparison-type low-type, range uri-and-range)
	comparison-type, range, 2.to

-gen-compare-or low-expr(range uri-and-range, a low-expr, b low-expr) low-common-types
	gen-match-enum range, a, of x
		if x.value == 1
			b
		else
			constant-low-expr a.type, range, x.value.to

-lower-hash-enum-or-flags low-expr
	range uri-and-range
	(value low-local, hash-state low-local)
	storage nat-type
do lower-and-expr-ctx
	call-low-expr range, storage.hash-nat-function,
		- gen-cast-nat range, storage, local-get-low-expr range, value
		- local-get-low-expr range, hash-state

-lower-hash-record low-expr
	range uri-and-range
	(value low-local, hash-state low-local)
	fields low-field[]
	field-hash called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	fields.size is field-hash.size
	do unless is-empty fields else gen-void range
	get-value = local-get-low-expr range, value
	get-hash-state = local-get-low-expr range, hash-state
	seq-low-expr range, for i in 0 .. fields.size
		lower-and-call field-hash[i], range,
			- gen-record-field-get range, get-value, i
			- get-hash-state

-lower-hash-union low-expr
	range uri-and-range
	(value low-local, hash-state low-local)
	members low-type[]
	member-hash called[]
do lower-and-expr-ctx, quick-fill-in-low-fun-body
	members.size is member-hash.size
	do unless is-empty members else gen-void range
	get-value = local-get-low-expr range, value
	get-hash-state = local-get-low-expr range, hash-state
	gen-match-union void, range, members, get-value, of member-index, get-member
		seq-low-expr range,
			-
				assert members.size <= nat8.max-value else todo
				index-expr constant-low-expr = nat8, range, member-index.to
				call-low-expr range, nat8.hash-nat-function, (index-expr, get-hash-state)
			- lower-and-call member-hash[member-index], range, (get-member, get-hash-state)
