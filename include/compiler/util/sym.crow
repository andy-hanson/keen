no-std
import
	../../crow/col/experimental/object-memoizer
	crow/bool
	crow/col/array
	crow/col/collection
	crow/col/set
	crow/compare
	crow/hash
	crow/misc
	crow/number
	crow/pointer
	crow/json
	crow/string
	crow/symbol

sym record
	| Arbitrary unique ID.
	| WARN: If a Sym is garbage collected, it may reappear with a different ID.
	id nat
	hash nat
	-chars char8[]
	symbol-of-sym symbol
-sym-key record
	hash nat # Saved for perf ---------------------------------------------------------------------------------
	chars char8 array-view
memoizer-key sym-key(a sym)
	a.hash, a.chars[0 .. end]
-== bool(a sym-key, b sym-key)
	a.chars == b.chars
== bool(a sym, b sym)
	trusted a reference-equal b
-== bool(a char8 array-view, b char8 array-view)
	size = a.size
	guard size == b.size
	i mut nat = 0
	loop
		if i == size
			break true
		elif a[i] == b[i]
			i +:= 1
			continue
		else
			break false

| Compares in arbitrary order
<=> comparison(a sym, b sym)
	a.id <=> b.id
show string(a sym)
	a to
to string(a sym)
	a.symbol-of-sym to
to json(a sym)
	a.to::string to
hash-mix void(hasher hasher, a sym)
	hasher hash-mix a.id

length-char8s nat(a sym)
	a.chars.size

matchable symbol(a sym) # TODO: rm, compiler should support matching on symbols -------------------------------------------------------
	a symbol-of-sym

-initialized global(bool)
-lookup global((sym, sym-key) object-memoizer)
-next-id global(nat)

init-sym void() trusted
	guard !initialized
	initialized := true
	lookup := ()
	next-id := 1

sym-of-string sym(a string) # TODO: RM ------------------------------------------------------------------------------------------------------------------------------------------
	a.to::char8[] to # TODO: this will be slow for Java! Unless I make 'string' a Crow string not a Java string ---------------------------------------------------------------------
sym-of-symbol sym(a symbol) # TODO: RM ------------------------------------------------------------------------------------------------------------------------------------------
	a.to::string.to::char8[] to
to-symbol symbol(a sym) # TODO: RM ------------------------------------------------------------------------------------------------------------------------------------------
	a.to::string to
empty-sym sym() # TODO: RM ------------------------------------------------------------------------------------------------------------------------------------------
	()

to sym(a char8[])
	a sym-of-chars

sym-of-chars sym(a char8[])
	a[0 .. end] to

to sym(a char8 array-view) trusted
	hash = do
		hasher hasher = ()
		for x : a
			hasher hash-mix x
		hasher finish
	lookup memoize (hash, a), () =>
		res sym = next-id, hash, a.to, a.to::string.to
		next-id +:= 1
		res

symbol-set alias
	sym set
show string(a symbol-set)
	", " join for x : a
		x.to quote

# TODO: WIth compiler support, I shouldn't need functions like these ------------------------------------------------------------------------------------
new sym()
	"" sym-of-chars
sym-a sym()
	"a" sym-of-chars
