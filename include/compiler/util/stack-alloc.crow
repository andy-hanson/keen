# TODO: RENAME THIS FILE -------------------------------------------------------------------------------------------------
import
	crow/col/mut-slice
	crow/unsafe

mut-slice-allocator[t] record mut
	-by-size t mut-slice mut[] mut[]
	-count-allocated mut nat

new[t] t mut-slice-allocator()
	(), 0

assert-all-free[t] void(a t mut-slice-allocator)
	a.count-allocated is 0

allocate-gc-safe-values[t] t mut-slice(a t mut-slice-allocator, size nat) unsafe
	guard size != 0
	i = size - 1
	until i < a.by-size.size
		a.by-size ~= ()
	xs = a.by-size[i]
	a.count-allocated +:= 1
	if is-empty xs
		gc-safe-mut-slice size
	else
		pop! xs

free[t] void(a t mut-slice-allocator, array t mut-slice) unsafe
	guard !is-empty array
	for i in 0::nat .. array.size
		array[i] := gc-safe-value
	a.by-size[array.size - 1] ~= array
	a.count-allocated -:= 1

test
	trusted
	a string mut-slice-allocator = ()
	x = allocate-gc-safe-values a, 0
	x.size is 0
	free a, x
	assert is-empty a.by-size
test
	trusted
	a string mut-slice-allocator = ()
	unless js # TODO: get constants working better in JS (so the reference-equal works) ----------------------------------
		assert allocate-gc-safe-values a, 0 'reference-equal ()
	x = allocate-gc-safe-values a, 1
	x.size is 1
	y = allocate-gc-safe-values a, 1
	y.size is 1
	forbid reference-equal y, x
	free a, x
	free a, y
	a.by-size.size is 1
	a.by-size[0].size is 2
	assert a.by-size[0][0] 'reference-equal x
	assert a.by-size[0][1] 'reference-equal y

mut-array-allocator[t] record mut # TODO: this is just a t mut[] pool ----------------------------------------------------------------
	-pool t mut[] mut[]
	-count-allocated mut nat

new[t] t mut-array-allocator()
	(), 0

assert-all-free[t] void(a t mut-array-allocator)
	a.count-allocated is 0

allocate[t] t mut[](a t mut-array-allocator)
	a.count-allocated +:= 1
	a.pool.pop else ()

free[t] void(a t mut-array-allocator, value t mut[])
	assert is-empty value
	a.pool ~= value
	a.count-allocated -:= 1

test
	a string mut-array-allocator = ()
	xs = allocate a
	ys = allocate a
	forbid trusted xs 'reference-equal ys
	a.count-allocated is 2
	free a, xs
	free a, ys
	assert-all-free a
