import
	crow/col/mut-slice
	../../crow/private/bootstrap: get, new-weak-ref, weak-ref
	./util

memoizable[t] spec t data
	content-equals bool(a t, b t)
	hash-content nat(a t)

object-memoizer[t] record mut
	| Greatest distance of any entry from its home
	-max-cost mut nat64
	-capacity-log-2 mut nat
	-entries mut t weak-ref mut-slice
new[t] t object-memoizer() t memoizable
	trusted if extern native
		assert size-of@t == 8 # Must be a reference type (TODO: have a more specific function to test this) -------------------------------------
	0, 1, (new-weak-ref, new-weak-ref)

iterate[t] bool(a t object-memoizer, f bool mut(x t)) t memoizable # TODO: UNSAFE ------------------------------------------------
	for entry : a entries
		if got ?= entry get
			if f[got]
				break true
	else
		false

subscript[t] t(a t object-memoizer, value t) t memoizable
	a get-and-did-add value value

get-and-did-add[t] t value-and-did-add(a t object-memoizer, value t) t memoizable
	assert (1::nat << a.capacity-log-2) == a.entries.size # TODO: RM (for perf) ----------------------------------------------
	if x ?= a find value
		x, false
	else
		a must-insert value
		value, true

-find[t] t?(a t object-memoizer, value t) t memoizable
	i mut = a ideal-index value
	cost mut nat = 0
	loop
		guard cost <= a.max-cost : break
		entry = a.entries[i]
		if v ?= entry get
			if v content-equals value
				break v,
			else
				i := a next-index i
				cost +:= 1
				continue
		else
			i := a next-index i
			cost +:= 1
			continue

| For this function, the caller guarantees that 'value' is not already in 'a'
-must-insert[t] void(a t object-memoizer, top-value t) t memoizable
	value mut = top-value
	i mut = a ideal-index value
	cost mut nat = 0
	loop
		if v ?= a.entries[i] get
			forbid trusted v reference-equal value # TODO: RM (for performance) -------------------------------------------------------------------------
			its-home = a ideal-index v
			its-cost = a cost its-home, i
			if cost > its-cost
				a.entries[i] := value.new-weak-ref
				value := v
				cost := its-cost
			i := a next-index i
			cost +:= 1
			if cost >= a.max-cost
				a.max-cost := cost
				if a.max-cost > a.capacity-log-2
					a increase-capacity
					i := a ideal-index value
					cost := 0
			continue
		else
			a.entries[i] := value.new-weak-ref
			break

-increase-capacity[t] void(a t object-memoizer) t memoizable
	old-entries = a entries
	a.max-cost := 0
	a.capacity-log-2 +:= 1
	a.entries := trusted (1 << a.capacity-log-2) gc-safe-mut-slice
	for x : old-entries
		if v ?= x get
			a must-insert v

-ideal-index[t] nat(a t object-memoizer, value t) t memoizable
	value.hash-content % a.entries.size # TODO: use capacity-log-2 -----------------------------------------------------------
-next-index[t] nat(a t object-memoizer, index nat)
	res = index wrap-add 1
	res == a.entries.size ? 0 : res
-cost[t] nat(a t object-memoizer, ideal-index nat, actual-index nat)
	if ideal-index <= actual-index
		actual-index - ideal-index
	else
		a.entries.size - ideal-index + actual-index

-my-memoizable-record record(x nat, y nat) by-ref
-hash-content nat(a my-memoizable-record)
	# Use a deliberately bad hash code to make this predictable
	a x
-content-equals bool(a my-memoizable-record, b my-memoizable-record)
	a.x == b.x && a.y == b.y
-copy my-memoizable-record(a my-memoizable-record)
	a.x, a.y

test trusted
	a my-memoizable-record object-memoizer = ()
	x0 = a assert-insert (0, 0)
	assert (a assert-get-existing (0, 0)) reference-equal x0
	x1 = a assert-insert (1, 1)
	assert (a assert-get-existing (1, 1)) reference-equal x1
	x2 = a assert-insert (2, 2)
	assert a[0, 0] reference-equal x0
	assert a[1, 1] reference-equal x1
	assert a[2, 2] reference-equal x2
	x0.x is 0
	x1.x is 1
	x2.x is 2

	x01 = a assert-insert (0, 1)
	assert (a assert-get-existing (0, 0)) reference-equal x0
	assert (a assert-get-existing (0, 1)) reference-equal x01
	x01.x is 0
	x01.y is 1

-assert-insert my-memoizable-record(a my-memoizable-record object-memoizer, value my-memoizable-record) trusted
	value-copy = value copy
	res = a get-and-did-add value-copy
	assert res did-add
	assert res.value reference-equal value-copy
	assert res.value content-equals value-copy
	res value

-assert-get-existing my-memoizable-record(a my-memoizable-record object-memoizer, value my-memoizable-record) trusted
	# Ensure this is not a constant (since then it would reference-equal the previous value)
	value-copy = value copy
	res = a get-and-did-add value-copy
	forbid res did-add
	forbid res.value reference-equal value-copy
	assert res.value content-equals value-copy
	res value
