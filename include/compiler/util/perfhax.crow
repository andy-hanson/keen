export
	crow/io/duration
	crow/perf: perf-now

-full-start global(nat)
-check global(nat)
-finish-check-call global(nat)
-get-candidates global(nat)
-parse global(nat)
-concretize global(nat)
-dirty-work-count global(nat)
-dirty-work-time global(nat)
-load-all-files global(nat)
-pre-check-candidate-specs global(nat)
-check-called global(nat)
-check-call-specs global(nat)
-translate-to-java global(nat)
-end-check-call-specs global(nat)
-write-jar global(nat)

end-check void(start nat) trusted
	check +:= perf-now - start
end-pre-check-candidate-specs void(start nat) trusted
	pre-check-candidate-specs +:= perf-now - start
end-finish-check-call void(start nat) trusted
	finish-check-call +:= perf-now - start
end-check-called void(start nat) trusted
	check-called +:= perf-now - start
end-check-call-specs void(start nat) trusted
	check-call-specs +:= perf-now - start
end-get-candidates void(start nat) trusted
	get-candidates +:= perf-now - start
end-parse void(start nat) trusted
	parse +:= perf-now - start
end-concretize void(start nat) trusted
	concretize +:= perf-now - start
end-dirty-work void(start nat) trusted
	dirty-work-count +:= 1
	dirty-work-time +:= perf-now - start
end-load-all-files void(start nat) trusted
	load-all-files +:= perf-now - start
end-translate-to-java void(start nat) trusted
	translate-to-java +:= perf-now - start
end-write-jar void(start nat) trusted
	write-jar +:= perf-now - start

perf-init void() trusted
	full-start := perf-now
	check := 0
	finish-check-call := 0
	pre-check-candidate-specs := 0
	check-call-specs := 0
	check-called := 0
	get-candidates := 0
	parse := 0
	concretize := 0
	dirty-work-count := 0
	dirty-work-time := 0
	load-all-files := 0
	translate-to-java := 0
	write-jar := 0

perf-report json() trusted
	("total", (perf-now - full-start).show-duration), \
	("check", check.show-duration),
	("finish-check-call", finish-check-call.show-duration),
	("pre-check-candidate-specs", pre-check-candidate-specs.show-duration),
	("check-called", check-called.show-duration),
	("check-call-specs", check-call-specs.show-duration),
	("get-candidates", get-candidates.show-duration),
	("parse", parse.show-duration),
	("concretize", concretize.show-duration),
	("dirty-work", (dirty-work-count show-count-and-duration dirty-work-time)),
	("load-all-files", load-all-files.show-duration),
	("translate-to-java", translate-to-java.show-duration),
	("write-jar", write-jar.show-duration)

-show-count-and-duration json(count nat, nsec nat)
	("count", count.to), ("total", nsec.show-duration)

show-duration json(nsec nat)
	"{nsec.to nanoseconds}"::string to
