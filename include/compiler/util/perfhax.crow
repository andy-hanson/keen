	translate-types-time +:= perf-now - start
end-write-jar void(start perf-mark)
	trusted
	write-jar-count +:= 1
	write-jar-time +:= perf-now - start

# Leaving these around to make it easy to quickly add performance measurements
end-custom0 void(start perf-mark)
	trusted
	custom0-count +:= 1
	custom0-time +:= perf-now - start
end-custom1 void(start perf-mark)
	trusted
	custom1-count +:= 1
	custom1-time +:= perf-now - start
end-custom2 void(start perf-mark)
	trusted
	custom2-count +:= 1
	custom2-time +:= perf-now - start
end-custom3 void(start perf-mark)
	trusted
	custom3-count +:= 1
	custom3-time +:= perf-now - start
end-custom4 void(start perf-mark)
	trusted
	custom4-count +:= 1
	custom4-time +:= perf-now - start

perf-report json()
	# Ensuring these look used
	if false
		start = perf-now
		start end-custom0
		start end-custom1
		start end-custom2
		start end-custom3
		start end-custom4
	0.perf-report to
perf-report json(start perf-mark)
	(perf-now - start).perf-report to

perf-part record
	count nat
	time nat
	subparts perf-part[symbol]
new perf-part(count nat, total nat)
	count, total, ()
has-count bool(a perf-part)
	a.count != 0 or a.subparts exists it.b.has-count
to json(a perf-part)
	count json = a.count to
	total = a.time show-duration
	count-total json[symbol] =
		count: count
		total: total
	res json[symbol] = if a.subparts is-empty
		count-total
	else
		count-total ~~
		(("sum-of-parts", (a.subparts sum it.b.time show-duration)),) ~~
		for* k, v in a subparts
			if v has-count
				- k, v.to
	res to

perf-report perf-part(total nat)
	1, total,
		trusted
		handle-one-lsp-message: handle-one-lsp-message-count, handle-one-lsp-message-time
		load-all-files: load-all-files-count, load-all-files-time,
			read-file: read-file-count, read-file-time
			parse: parse-count, parse-time
			parse-java-class: parse-java-class-count, parse-java-class-time
			dirty-work: dirty-work-count, dirty-work-time,
				check: check-count, check-time,
					detect-unused-private: detect-unused-private-count, detect-unused-private-time
				get-java-module: get-java-module-count, get-java-module-time
		make-program: make-program-count, make-program-time,
			detect-unused-internal: detect-unused-internal-count, detect-unused-internal-time
		concretize: concretize-count, concretize-time
		translate-to-java: translate-to-java-count, translate-to-java-time,
			class-to-bytes: class-to-bytes-count, class-to-bytes-time
			translate-constants: translate-constants-count, translate-constants-time
			translate-funs: translate-funs-count, translate-funs-time
			translate-types: translate-types-count, translate-types-time
		translate-to-js: translate-to-js-count, translate-to-js-time
		write-jar: write-jar-count, write-jar-time
		custom0: custom0-count, custom0-time
		custom1: custom1-count, custom1-time
		custom2: custom2-count, custom2-time
		custom3: custom3-count, custom3-time
		custom4: custom4-count, custom4-time

-show-duration json(nsec nat)
	"{nsec.to nanoseconds}"::string to

perf-mark record
	-nanos nat64
- - nat(a perf-mark, b perf-mark)
	a.nanos - b.nanos
perf-now perf-mark()
	trusted if extern java
		- nanoTime wrap-to
	elif extern js
		- (("performance".js-global call-property "now").cast::float64) * 1000000 to
	else
		throw todo
