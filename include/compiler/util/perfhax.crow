# This module is icky. It won't work with multiple threads. ------------------------------------------------------------------------------------------------------------------
export
	crow/io/duration
	crow/perf: perf-now

#("init-candidate", "check", "finish-check-call", "get-candidates", "parse", "concretize")
-full-start global(nat)
-init-candidate global(nat)
-check global(nat)
-finish-check-call global(nat)
-get-candidates global(nat)
-parse global(nat)
-concretize global(nat)
-each-import-count global(nat)
-each-import-time global(nat)

end-init-candidate void(start nat) trusted
	init-candidate +:= perf-now - start
end-check void(start nat) trusted
	check +:= perf-now - start
end-finish-check-call void(start nat) trusted
	finish-check-call +:= perf-now - start
end-get-candidates void(start nat) trusted
	get-candidates +:= perf-now - start
end-parse void(start nat) trusted
	parse +:= perf-now - start
end-concretize void(start nat) trusted
	concretize +:= perf-now - start
end-each-import void(start nat) trusted
	each-import-count +:= 1
	each-import-time +:= perf-now - start

perf-init void() trusted
	full-start := perf-now
	init-candidate := 0
	check := 0
	finish-check-call := 0
	get-candidates := 0
	parse := 0
	concretize := 0
	each-import-count := 0
	each-import-time := 0

perf-report json() trusted
	("total", (perf-now - full-start).show-duration), \
	("init-candidate", init-candidate.show-duration),
	("check", check.show-duration),
	("finish-check-call", finish-check-call.show-duration),
	("get-candidates", get-candidates.show-duration),
	("parse", parse.show-duration),
	("concretize", concretize.show-duration),
	("each-import", (each-import-count show-count-and-duration each-import-time))

-show-count-and-duration json(count nat, nsec nat)
	("count", count.to), ("total", nsec.show-duration)

-show-duration json(nsec nat)
	"{nsec.to nanoseconds}"::string to
