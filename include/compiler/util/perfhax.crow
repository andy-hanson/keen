import
	crow/js
	java/lang/System
export
	crow/io/duration

-check global(nat)
-parse global(nat)
-class-to-bytes global(nat)
-class-to-bytes-count global(nat)
-concretize global(nat)
-dirty-work-count global(nat)
-dirty-work-time global(nat)
-detect-unused-private global(nat)
-detect-unused-internal global(nat)
-get-java-module global(nat)
-load-all-files global(nat)
-parse-java-class global(nat)
-parse-java-class-count global(nat)
-read-file global(nat)
-read-file-count global(nat)
-translate-to-java global(nat)
-translate-constants global(nat)
-translate-funs global(nat)
-translate-types global(nat)
-write-jar global(nat)

end-check void(start perf-mark)
	trusted
	check +:= perf-now - start
end-class-to-bytes void(start perf-mark)
	trusted
	class-to-bytes +:= perf-now - start
	class-to-bytes-count +:= 1
end-detect-unused-private void(start perf-mark)
	trusted
	detect-unused-private +:= perf-now - start
end-detect-unused-internal void(start perf-mark)
	trusted
	detect-unused-internal +:= perf-now - start
end-get-java-module void(start perf-mark)
	trusted
	get-java-module +:= perf-now - start
end-parse void(start perf-mark)
	trusted
	parse +:= perf-now - start
end-concretize void(start perf-mark)
	trusted
	concretize +:= perf-now - start
end-dirty-work void(start perf-mark)
	trusted
	dirty-work-count +:= 1
	dirty-work-time +:= perf-now - start
end-load-all-files void(start perf-mark)
	trusted
	load-all-files +:= perf-now - start
end-parse-java-class void(start perf-mark)
	trusted
	parse-java-class-count +:= 1
	parse-java-class +:= perf-now - start
end-read-file void(start perf-mark)
	trusted
	read-file-count +:= 1
	read-file +:= perf-now - start
end-translate-to-java void(start perf-mark)
	trusted
	translate-to-java +:= perf-now - start
end-translate-constants void(start perf-mark)
	trusted
	translate-constants +:= perf-now - start
end-translate-funs void(start perf-mark)
	trusted
	translate-funs +:= perf-now - start
end-translate-types void(start perf-mark)
	trusted
	translate-types +:= perf-now - start
end-write-jar void(start perf-mark)
	trusted
	write-jar +:= perf-now - start

perf-report json(start perf-mark)
	a json =
		total: perf-now - start show-duration
	a.object! ~~ perf-report.object! to

perf-report json()
	trusted
	check: check show-duration
	detect-unused-private: detect-unused-private show-duration
	detect-unused-internal: detect-unused-internal show-duration
	parse: parse show-duration
	concretize: concretize show-duration
	class-to-bytes: class-to-bytes-count show-count-and-duration class-to-bytes
	dirty-work: dirty-work-count show-count-and-duration dirty-work-time
	get-java-module: get-java-module show-duration
	load-all-files: load-all-files show-duration
	parse-java-class: parse-java-class-count show-count-and-duration parse-java-class
	read-file: read-file-count show-count-and-duration read-file
	translate-to-java: translate-to-java show-duration
	translate-constants: translate-constants show-duration
	translate-funs: translate-funs show-duration
	translate-types: translate-types show-duration
	write-jar: write-jar show-duration

-show-count-and-duration json(count nat, nsec nat)
	count: count to
	total: nsec show-duration

show-duration json(nsec nat)
	"{nsec.to nanoseconds}"::string to

perf-mark record
	-nanos nat64
- - nat(a perf-mark, b perf-mark)
	a.nanos - b.nanos
perf-now perf-mark()
	trusted if extern java
		- nanoTime wrap-to
	elif extern js
		- (("performance".js-global call-property "now").cast::float64) * 1000000 to
	else
		throw todo
