# TODO: share code with 'process-exit' from 'process.crow' -------------------------------------------------------------------
exit-code record(value int)
== bool(a exit-code, b exit-code)
to json(a exit-code)
	a.value.to
ok exit-code()
	0,
error exit-code()
	1,

is-ok bool(a exit-code)
	a.value == 0
