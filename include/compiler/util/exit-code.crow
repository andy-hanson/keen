exit-code record(value int)
== bool(a exit-code, b exit-code)
ok exit-code()
	0,
error exit-code()
	1,

exit-code-combine exit-code(a exit-code, b exit-code)
	a == ok ? b : a
exit-code-combine exit-code-or-signal(a exit-code-or-signal, b exit-code)
	match a
	as exit-code x
		x exit-code-combine b to
	as signal x
		x to

ok-and exit-code(a exit-code, f exit-code mut())
	a == ok ? f[] : a
ok-and exit-code(a exit-code, f exit-code mut(), g exit-code mut())
	a ok-and () =>
		f[] ok-and g
ok-and exit-code-or-signal(a exit-code-or-signal, f exit-code-or-signal mut())
	a == ok ? f[] : a
ok-and exit-code-or-signal(a exit-code-or-signal, f exit-code-or-signal mut(), g exit-code-or-signal mut())
	a ok-and () =>
		f[] ok-and g

on-error exit-code(a exit-code, f exit-code mut())
	a == ok ? a : f[]

each-until-error[t] exit-code(xs t[], f exit-code mut(x t))
	for x : xs
		res = f[x]
		if res != ok
			break res
	else
		ok
each-until-error[t] exit-code-or-signal(xs t[], f exit-code-or-signal mut(x t))
	for x : xs
		res = f[x]
		if res != ok
			break res
	else
		ok

exit-code-or-signal union(exit-code, signal)
ok exit-code-or-signal()
	ok::exit-code to
error exit-code-or-signal()
	error::exit-code to
== bool(a exit-code-or-signal, b exit-code-or-signal)
signal record(signal int)
== bool(a signal, b signal)

is-ok bool(a exit-code-or-signal) # TODO: just inline it ----------------------------------------------------------------------------
	a == ok
