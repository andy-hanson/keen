import
	crow/format/binary

read-entire-tar nat8 array-view[symbol](a nat8[])
	iter = a begin
	with out in build
		while pair ?= iter take-one-file
			out ~= pair

# https://www.fileformat.info/format/tar/corion.htm
| Returns an empty option if this is the empty record. That indicates the end of the archive.
-take-one-file (symbol, nat8 array-view)?(a nat8 array-iterator)
	loop
		file-name = a take-string 100
		guard file-name != "" else break
		a skip-next-n 24 # mode, owner, group
		file-size = a take-octal 12, true
		a skip-next-n 20 # modification time and checksum
		linkflag char8 = a.take-next.to::char8
		is-file = linkflag == "0"
		a skip-next-n 100 # linkname
		magic = a take-string 8
		magic is "ustar  "
		a skip-to-next-record
		file = a take-next-n file-size
		a skip-to-next-record
		if is-file
			break (file-name try-remove-start! "./").to, file
		else
			continue
-skip-to-next-record void(a nat8 array-iterator)
	offset = a.index % 512
	unless offset == 0
		a skip-next-n (512 - offset)
-take-octal nat(a nat8 array-iterator, n-bytes nat, has-trailing-nul bool)
	res mut nat = 0
	for _ nat in 0 .. n-bytes - has-trailing-nul.to
		res *:= 8
		res +:= a.take-next.to.octal-digit.to
	if has-trailing-nul
		a.take-next is 0
	res
-octal-digit nat8(a char8)
	assert "0"::char8 <= a and a <= "7"
	a.to - "0"::char8.to
