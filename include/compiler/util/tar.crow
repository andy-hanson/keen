import
	crow/format/binary

read-entire-tar nat8 array-view[symbol](a nat8[])
	iter = begin a
	with out in build
		while pair = take-one-file iter
			out ~= pair

# https://www.fileformat.info/format/tar/corion.htm
| Returns an empty option if this is the empty record. That indicates the end of the archive.
-take-one-file (symbol, nat8 array-view)?(a nat8 array-iterator)
	do loop
	file-name = take-string a, 100
	do unless file-name == "" else break
	skip-next-n a, 24 # mode, owner, group
	file-size = take-octal a, 12, true
	skip-next-n a, 20 # modification time and checksum
	linkflag char8 = a.take-next.to::char8
	is-file = linkflag == "0"
	skip-next-n a, 100 # linkname
	magic = take-string a, 8
	magic is "ustar  "
	skip-to-next-record a
	file = take-next-n a, file-size
	skip-to-next-record a
	if is-file
		break (try-remove-start! file-name, "./").to, file
	else
		continue
-skip-to-next-record void(a nat8 array-iterator)
	offset = a.index % 512
	unless offset == 0
		skip-next-n a, (512 - offset)
-take-octal nat(a nat8 array-iterator, n-bytes nat, has-trailing-nul bool)
	res mut nat = 0
	for _ nat in 0 .. n-bytes - has-trailing-nul.to
		res *:= 8
		res +:= a.take-next.to.octal-digit.to
	if has-trailing-nul
		a.take-next is 0
	res
-octal-digit nat8(a char8)
	assert "0"::char8 <= a and a <= "7"
	a.to - "0"::char8.to
