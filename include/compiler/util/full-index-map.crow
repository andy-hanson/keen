index[t] spec
	index nat(a t)
	new t(index nat)

full-index-map[k, v] record
	values v[]
subscript[k, v] v(a (k, v) full-index-map, key k) k index
	a.values[key index]
iterate[k, v] bool(a (k, v) full-index-map, f bool mut(key k, value v)) k index
	a.values.with-index every (i, v) =>
		f[((i,), v)]
