import
	crow/col/mut-slice

index[t] spec
	index nat(a t)
	new t(index nat)

full-index-map[k, v] record
	values v[]
size[k, v] nat(a (k, v) full-index-map)
	a.values size
subscript[k, v] v(a (k, v) full-index-map, key k) k index
	a.values[key index]
iterate[k, v] bool(a (k, v) full-index-map, f bool mut(key k, value v)) k index
	a.values.with-index exists (i, v) =>
		f[((i,), v)]

full-index-map-builder[k, v] record mut
	-inner v array-builder
build[k, v] (k, v) full-index-map(a build-options, f void mut(out (k, v) full-index-map-builder))
	(a build out => f[out,]),
~=[k, v] void(a (k, v) full-index-map-builder, value v)
	a.inner ~= value

mut-full-index-map[k, v] record mut
	values v mut-slice
new[k, v] (k, v) mut-full-index-map(size nat, value v) k index
	values v mut-slice = for _ : 0::nat .. size
		value
	values,
subscript[k, v] v(a (k, v) mut-full-index-map, key k) k index
	a.values[key index]
set-subscript[k, v] void(a (k, v) mut-full-index-map, key k, value v) k index
	a.values[key index] := value

mut-index-map[k, v] record mut
	values v? mut[]
new[k, v] (k, v) mut-index-map(size nat) k index
	values v? mut[] = for _ : 0::nat .. size
		()
	values,
subscript[k, v] v?(a (k, v) mut-index-map, key k) k index
	a.values[key index]
ensure[k, v] v(a (k, v) mut-index-map, key k, get-value v mut()) k index
	a[key] ?? do
		value = get-value[]
		a.values[key index] := value,
		value

assert-full[k, v] (k, v) full-index-map(a v[k]) k index, k key
	for i : 0::nat .. a.size
		a[i,]!
