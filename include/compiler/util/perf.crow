import
	crow/js
	java/lang/System
export
	crow/io/duration

-check-count global(nat)
-check-time global(nat)
-tokens-count global(nat)
-tokens-time global(nat)
-parse-count global(nat)
-parse-time global(nat)
-class-to-bytes-count global(nat)
-class-to-bytes-time global(nat)
-concretize-count global(nat)
-concretize-time global(nat)
-custom0-count global(nat)
-custom0-time global(nat)
-custom1-count global(nat)
-custom1-time global(nat)
-custom2-count global(nat)
-custom2-time global(nat)
-custom3-count global(nat)
-custom3-time global(nat)
-custom4-count global(nat)
-custom4-time global(nat)
-dirty-work-count global(nat)
-dirty-work-time global(nat)
-detect-unused-private-count global(nat)
-detect-unused-private-time global(nat)
-detect-unused-internal-count global(nat)
-detect-unused-internal-time global(nat)
-fill-java-class-supertypes-count global(nat)
-fill-java-class-supertypes-time global(nat)
-get-java-module-count global(nat)
-get-java-module-time global(nat)
-handle-one-lsp-message-count global(nat)
-handle-one-lsp-message-time global(nat)
-load-all-files-count global(nat)
-load-all-files-time global(nat)
-make-program-count global(nat)
-make-program-time global(nat)
-parse-java-class-count global(nat)
-parse-java-class-time global(nat)
-read-file-count global(nat)
-read-file-time global(nat)
-translate-constants-count global(nat)
-translate-constants-time global(nat)
-translate-funs-count global(nat)
-translate-funs-time global(nat)
-translate-to-java-count global(nat)
-translate-to-java-time global(nat)
-translate-types-count global(nat)
-translate-types-time global(nat)
-translate-to-js-count global(nat)
-translate-to-js-time global(nat)
-write-jar-count global(nat)
-write-jar-time global(nat)

end-check void(start perf-mark)
	trusted
	check-count +:= 1
	check-time +:= perf-now - start
end-class-to-bytes void(start perf-mark)
	trusted
	class-to-bytes-count +:= 1
	class-to-bytes-time +:= perf-now - start
end-concretize void(start perf-mark)
	trusted
	concretize-count +:= 1
	concretize-time +:= perf-now - start
end-detect-unused-internal void(start perf-mark)
	trusted
	detect-unused-internal-count +:= 1
	detect-unused-internal-time +:= perf-now - start
end-detect-unused-private void(start perf-mark)
	trusted
	detect-unused-private-count +:= 1
	detect-unused-private-time +:= perf-now - start
end-fill-java-class-supertypes void(start perf-mark)
	trusted
	fill-java-class-supertypes-count +:= 1
	fill-java-class-supertypes-time +:= perf-now - start
end-get-java-module void(start perf-mark)
	trusted
	get-java-module-count +:= 1
	get-java-module-time +:= perf-now - start
end-parse void(start perf-mark)
	trusted
	parse-count +:= 1
	parse-time +:= perf-now - start
end-dirty-work void(start perf-mark)
	trusted
	dirty-work-count +:= 1
	dirty-work-time +:= perf-now - start
end-handle-one-lsp-message void(start perf-mark)
	trusted
	handle-one-lsp-message-count +:= 1
	handle-one-lsp-message-time +:= perf-now - start
end-load-all-files void(start perf-mark)
	trusted
	load-all-files-count +:= 1
	load-all-files-time +:= perf-now - start
end-make-program void(start perf-mark)
	trusted
	make-program-count +:= 1
	make-program-time +:= perf-now - start
end-parse-java-class void(start perf-mark)
	trusted
	parse-java-class-count +:= 1
	parse-java-class-time +:= perf-now - start
end-read-file void(start perf-mark)
	trusted
	read-file-count +:= 1
	read-file-time +:= perf-now - start
end-tokens void(start perf-mark)
	trusted
	tokens-count +:= 1
	tokens-time +:= perf-now - start
end-translate-to-java void(start perf-mark)
	trusted
	translate-to-java-count +:= 1
	translate-to-java-time +:= perf-now - start
end-translate-to-js void(start perf-mark)
	trusted
	translate-to-js-count +:= 1
	translate-to-js-time +:= perf-now - start
end-translate-constants void(start perf-mark)
	trusted
	translate-constants-count +:= 1
	translate-constants-time +:= perf-now - start
end-translate-funs void(start perf-mark)
	trusted
	translate-funs-count +:= 1
	translate-funs-time +:= perf-now - start
end-translate-types void(start perf-mark)
