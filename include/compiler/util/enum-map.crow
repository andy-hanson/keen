import
	crow/col/mut-slice

enum-map[k, v] record
	| One for each enum member
	values v[]
mut-enum-map[k, v] record mut
	-values v mut-slice

-to[k, v] (k, v) mut-enum-map(a (k, v) enum-map)
	a.values.to,

new[k, v] (k, v) mut-enum-map() k enum-like, v new
	for _ in make-enum-map
		()

make-enum-map record
for-loop[k, v] (k, v) enum-map(_ make-enum-map, cb v mut(key k)) k enum-like
	values: for index, key in with-index members::k[]
		key.to::nat8 is index.to
		cb[key]
-for-loop[k, v] (k, v) mut-enum-map(a make-enum-map, cb v mut(key k)) k enum-like
	for-loop a, cb 'to

for-loop[k, v-out, v-in] (k, v-out) enum-map(a (k, v-in) enum-map, cb v-out mut(key k, value v-in)) k enum-like
	- for key in members then cb[key, a[key]]
for-loop[k, v-out, v-in] (k, v-out) enum-map(a (k, v-in) mut-enum-map, cb v-out mut(key k, value v-in)) k enum-like
	- for key in members then cb[key, a[key]]

subscript[k, v] v(a (k, v) enum-map, key k) k enum-like
	a.values[key.to::nat8.to]
subscript[k, v] v(a (k, v) mut-enum-map, key k) k enum-like
	a.values[key.to::nat8.to]
set-subscript[k, v] void(a (k, v) mut-enum-map, key k, value v) k enum-like
	a.values[key.to::nat8.to::nat64] := value

enum-like[t] spec t data
	to nat8(a t)
	members t[]()
