import
	crow/parse/string-mut-iterator

# TODO: rename this file to string-mut-iterator-util ----------------------------------------------------------------------------------------------------------------
pos nat32(a string-mut-iterator)
	a.char8-index to
set-pos void(a string-mut-iterator, pos nat32)
	new-index nat = pos to
	assert new-index <= a.char8s.size
	a.char8-index := new-index

subscript char8(a string-mut-iterator, delta int)
	a.char8s[(a.char8-index.to::int + delta).to]

advance void(a string-mut-iterator, n nat)
	new-index = a.char8-index + n
	assert new-index <= a.char8s.size
	a.char8-index := new-index

take-char char8(a string-mut-iterator)
	a take-char8
take-char-or-nul char8(a string-mut-iterator)
	if a is-at-end
		"\0"
	else
		a take-char
try-take-char bool(a string-mut-iterator, x char8)
	if *a == x
		a advance
		true
try-take-chars bool(a string-mut-iterator, xs char8[])
	if a starts-with xs
		a advance xs.size
		true
starts-with bool(a string-mut-iterator, xs char8[])
	(0::nat .. xs.size) every i =>
		a.char8-index + i < a.char8s.size && a[i.to] == xs[i]

starts-with-then-whitespace bool(a string-mut-iterator, chars char8[])
	a starts-with chars && a.char8-index + chars.size != a.char8s.size && a[chars.size to] is-whitespace

string-from string(a string-mut-iterator, start nat)
	a.char8s[start .. a.char8-index] to
symbol-from symbol(a string-mut-iterator, start nat)
	a.char8s[start .. a.char8-index] to

is-utf8-initial-or-continue-code bool(a char8)
	(a.to::nat8 & top-bit) != 0
-top-bit nat8()
	0b10000000

must-take-one-unicode-char char32(a string-mut-iterator)
	iter char8 array-iterator = a.char8s.begin + a.char8-index
	assert res, next ?= (iter,)::string-iterator next
	a.char8-index := next next-char8-index
	res

skip-whitespace void(ptr string-mut-iterator)
	while *ptr is-whitespace
		ptr advance
is-whitespace bool(a char8)
	a == "\n" || a is-whitespace-non-newline
is-whitespace-non-newline bool(a char8)
	a == " " || a == "\t" || a == "\r"

is-decimal-digit bool(a char32)
	"0"::char32 <= a && a <= "9"
is-decimal-digit bool(a char8)
	"0"::char8 <= a && a <= "9"

decode-hex-digit nat8?(a char8)
	if "0"::char8 <= a && a <= "9"
		a.to - "0".to
	elif "a"::char8 <= a && a <= "f"
		10 + (a.to - "a".to)
	elif "A"::char8 <= a && a <= "F"
		10 + (a.to - "A".to)

is-ascii-identifier-char bool(a char32)
	try c8 char8 = a to catch unary-out-of-range _ : false
	c8 is-ascii-identifier-char
is-ascii-identifier-char bool(a char8)
	a is-letter-or-digit || a == "_"
is-letter-or-digit bool(a char8)
	a is-letter || a is-decimal-digit
is-letter bool(a char8)
	a is-lower-case-letter || a is-upper-case-letter
is-lower-case-letter bool(a char8)
	"a"::char8 <= a && a <= "z"
is-upper-case-letter bool(a char8)
	"A"::char8 <= a && a <= "Z"
