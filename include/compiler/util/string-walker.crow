string-walker record mut
	-chars char8[]
	-index mut nat
new string-walker(a string)
	a.to, 0
new string-walker(a string, pos nat32)
	a.to, pos.to
copy string-walker(a string-walker)
	a.chars, a.index
pos nat32(a string-walker)
	a.index to
set-pos void(a string-walker, pos nat32)
	new-index nat = pos to
	assert new-index <= a.chars.size
	a.index := new-index
is-at-end bool(a string-walker) trusted
	a.index == a.chars.size
* char8(a string-walker) trusted
	if a.index == a.chars.size
		"\0"
	else
		a.chars[a index]

subscript char8(a string-walker, delta int)
	a.chars[(a.index.to::int + delta).to]

advance void(a string-walker)
	forbid a is-at-end
	a.index +:= 1

advance void(a string-walker, n nat)
	new-index = a.index + n
	assert new-index <= a.chars.size
	a.index := new-index

take-char char8(a string-walker)
	forbid a is-at-end
	res = *a
	a advance
	res
try-take-char bool(a string-walker, x char8)
	if *a == x
		a advance
		true
try-take-chars bool(a string-walker, xs char8[])
	if a starts-with xs
		a advance xs.size
		true
starts-with bool(a string-walker, xs char8[])
	(0::nat .. xs.size) every i =>
		a[i.to] == xs[i]

starts-with-then-whitespace bool(a string-walker, chars char8[])
	a starts-with chars && a[chars.size to] is-whitespace

string-from string(a string-walker, start nat32)
	a.chars[start.to .. a.index] to

is-utf8-initial-or-continue-code bool(_ char8)
	throw todo

must-take-one-unicode-char char32(_ string-walker)
	throw todo

is-whitespace bool(a char8)
	a == "\n" || a is-whitespace-non-newline
is-whitespace-non-newline bool(a char8)
	a == " " || a == "\t" || a == "\r"

is-decimal-digit bool(a char8)
	"0"::char8 <= a && a <= "9"

decode-hex-digit nat8?(a char8)
	if "0"::char8 <= a && a <= "9"
		a.to - "0".to,
	elif a in "a" .. "f"
		10 + (a.to - "a".to),
	elif a in "A" .. "F"
		10 + (a.to - "A".to),
