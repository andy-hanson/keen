import
	./sym

string-walker record mut
	chars char8[]
	index mut nat
char8-index nat(a string-walker)
	a index
iter string-iterator(a string-walker) # TODO: should we just use string-iterator everywhere?????????????????????????????????????????
	a.chars[a.index .. end].to begin
set-to-iter void(a string-walker, iter string-iterator)
	a.index := iter next-char8-index
new string-walker(a char8[])
	a, 0
copy string-walker(a string-walker)
	a.chars, a.index
pos nat32(a string-walker)
	a.index to
set-pos void(a string-walker, pos nat32)
	new-index nat = pos to
	assert new-index <= a.chars.size
	a.index := new-index
is-at-end bool(a string-walker) trusted
	a.index == a.chars.size
* char8(a string-walker) trusted
	if a.index == a.chars.size
		"\0"
	else
		a.chars[a index]

subscript char8(a string-walker, delta int)
	a.chars[(a.index.to::int + delta).to]

advance void(a string-walker)
	forbid a is-at-end
	a.index +:= 1

advance void(a string-walker, n nat)
	new-index = a.index + n
	assert new-index <= a.chars.size
	a.index := new-index

take-char char8(a string-walker)
	forbid a is-at-end
	res = *a
	a advance
	res
take-char-or-nul char8(a string-walker)
	if a is-at-end
		"\0"
	else
		a take-char
try-take-char bool(a string-walker, x char8)
	if *a == x
		a advance
		true
try-take-chars bool(a string-walker, xs char8[])
	if a starts-with xs
		a advance xs.size
		true
starts-with bool(a string-walker, xs char8[])
	(0::nat .. xs.size) every i =>
		a.index + i < a.chars.size && a[i.to] == xs[i]

starts-with-then-whitespace bool(a string-walker, chars char8[])
	a starts-with chars && a[chars.size to] is-whitespace

string-from string(a string-walker, start nat32)
	a.chars[start.to .. a.index] to
symbol-from sym(a string-walker, start nat32)
	a.chars[start.to .. a.index] to

is-utf8-initial-or-continue-code bool(a char8)
	(a.to::nat8 & top-bit) != 0
-top-bit nat8()
	0b10000000

must-take-one-unicode-char char32(a string-walker)
	res, next = a.iter next!
	a set-to-iter next
	res

is-whitespace bool(a char8)
	a == "\n" || a is-whitespace-non-newline
is-whitespace-non-newline bool(a char8)
	a == " " || a == "\t" || a == "\r"

is-decimal-digit bool(a char32)
	"0"::char32 <= a && a <= "9"
is-decimal-digit bool(a char8)
	"0"::char8 <= a && a <= "9"

decode-hex-digit nat8?(a char8)
	if "0"::char8 <= a && a <= "9"
		a.to - "0".to,
	elif "a"::char8 <= a && a <= "f"
		10 + (a.to - "a".to),
	elif "A"::char8 <= a && a <= "F"
		10 + (a.to - "A".to),

is-ascii-identifier-char bool(a char32)
	try c8 char8 = a to catch unary-out-of-range _ : false
	c8 is-ascii-identifier-char
is-ascii-identifier-char bool(a char8)
	a is-letter-or-digit || a == "_"
is-letter-or-digit bool(a char8)
	a is-letter || a is-decimal-digit
is-letter bool(a char8)
	a is-lower-case-letter || a is-upper-case-letter
is-lower-case-letter bool(a char8)
	"a"::char8 <= a && a <= "z"
is-upper-case-letter bool(a char8)
	"A"::char8 <= a && a <= "Z"
