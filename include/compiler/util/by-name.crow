import
	../../crow/col/mut-map: mut-map-with-capacity
	../../crow/symbol: id
	crow/col/mut-slice
	./util

name[t] spec
	name symbol(a t)

by-name[t] record
	-impl t impl
-impl[t] union(t[], t large-by-name)

-large-by-name[t] record
	values t[]
	next nat32[]

new[t] t by-name()
	()::t[],

| This does not allocate
to[t] t[](a t by-name)
	match a impl
	as array x
		x
	as large-by-name x
		x values

iterate[t] bool(a t by-name, f bool mut(x t))
	a.to::t[] iterate f

# Entry in {next} that indicates that we are at the end of the chain.
-no-next nat32()
	max-value
# This special value is used temporarily in {to}. The final {next} has no unused values.
-unused nat32()
	max-value - 1

move-to-by-name[t] t by-name(values t mut[], on-duplicate void mut(x t, y t)) t name
	values.move-to to-by-name on-duplicate

| If two have the same name, reports both in 'on-duplicate' and omits an arbitrary one from the result
to-by-name[t] t by-name(values t[], on-duplicate void mut(x t, y t)) t name
	if values.size <= 4
		if i, j ?= values find-duplicate-small
			on-duplicate[values[i], values[j]]
			values remove-at j to-by-name on-duplicate
		else
			values,
	else
		(values to-large-by-name on-duplicate),

filter[t] t by-name(a t by-name, f bool mut(x t)) t name
	match a impl
	as array xs
		(xs filter f)::t[],
	as large-by-name l
		l.values filter f to-by-name _ => throw unreachable

choose-keys[t] t by-name(a t by-name, keys symbol set) t name
	xs t[] = for k : keys and-concat
		if x ?= a[k]
			x,
	xs to-by-name _ => throw unreachable

-find-duplicate-small[t] (nat, nat)?(values t[]) t name
	0::nat .. values.size first i =>
		i + 1 .. values.size first j =>
			if values[i].name == values[j].name
				i, j

-to-large-by-name[t] t large-by-name(values t[], on-duplicate void mut(x t, y t)) t name
	n = values size
	res t mut-slice = trusted n gc-safe-mut-slice

	next nat32 mut-slice = n n-of unused
	delay t mut[] = ()

	for x : values
		i = trusted x.name.id % n
		if next[i] == unused
			res[i] := x
			next[i] := no-next
		else
			delay ~= x

	unused-spots nat32 mut[] = ()
	for i, x : next with-index
		if x == unused
			unused-spots ~= i to

	# Try to minimize the maximum cost. Cost = the length of the chain that we would create.
	max-cost mut nat = 2
	until delay is-empty
		delay filter-unordered x =>
			res !place-delayed next, x, unused-spots, max-cost, on-duplicate
		max-cost +:= 1
	trusted res.cast-immutable, next.cast-immutable
-place-delayed[t] bool(res t mut-slice, next nat32 mut-slice, x t, unused-spots nat32 mut[], max-cost nat, on-duplicate void mut(x t, y t)) t name
	cur mut = trusted x.name.id % res.size
	cost mut nat = 1
	loop
		forbid next[cur] == unused
		if x.name == res[cur].name
			on-duplicate[res[cur], x]
			break true
		elif next[cur] == no-next
			# Found the end
			dest = unused-spots pop!
			next[cur] := dest
			res[dest to] := x
			next[dest to] := no-next
			break true
		elif cost == max-cost
			break false
		else
			cur := next[cur] to
			cost +:= 1
			continue

subscript[t] t?(a t by-name, name symbol) t name
	match a impl
	as array xs
		for x : xs
			if x.name == name
				break x
	as large-by-name l
		i mut = trusted name.id % l.values.size
		loop
			value = l.values[i]
			if value.name == name
				break value
			else
				next = l.next[i]
				if next == no-next
					break
				else
					i := next to
					continue

in[t] bool(name symbol, a t by-name) t name
	a[name] !is-empty

test
	r0 r = "a", 1
	r1 r = "b", 2
	a r by-name = (r0, r1) to-by-name _ => throw unreachable
	a["a"] is r0
	a["b"] is r1
	a["c"] is ()
-r record
	name symbol
	whatever nat
-== bool(a r, b r)
-to json(a r)

multi-by-name[t] record
	-impl t multi-by-name-impl
-multi-by-name-impl[t] union(t[], t large-multi-by-name)
-large-multi-by-name[t] record
	# Each nat64 is effectively (start nat32, next nat32)
	starts-and-nexts nat64[]
	| All values stored contiguously
	values t[]

| This does not allocate
to[t] t[](a t multi-by-name)
	match a impl
	as array x
		x
	as large-multi-by-name x
		x values

new[t] t multi-by-name()
	()::t[],

move-to[t] t multi-by-name(values t mut[]) t name
	values.move-to to
to[t] t multi-by-name(values t[]) t name
	guard values.size > 8 : (values sort x => x name)::t[],
	groups = values group-by-name
	groups-by-name t[] large-by-name = groups to-large-by-name _ => throw unreachable
	starts nat32 mut-slice = trusted groups.size gc-safe-mut-slice
	out-values t mut-slice = trusted values.size gc-safe-mut-slice
	next-value mut nat = 0
	for i, subarray : groups-by-name.values with-index
		starts[i] := next-value to
		values-end = next-value + subarray.size
		out-values[next-value .. values-end] := subarray
		next-value := values-end
	starts-and-nexts nat64 mut-slice = trusted starts.size gc-safe-mut-slice
	for i : 0::nat .. starts-and-nexts.size
		starts-and-nexts[i] := (starts[i].to << 32) | groups-by-name.next[i].to
	(trusted starts-and-nexts.cast-immutable large-multi-by-name out-values.cast-immutable),
-group-by-name[t] t[][](values t[]) t name
	res t mut[] mut[symbol] = values.size mut-map-with-capacity
	for x : values
		res ensure x.name ~= x
	for _, x : res; x move-to
-name[t] symbol(a t[]) t name
	a[0] name
###
TODO:PERF consider this instead, once I have a faster 'sort' -----------------------------------------------------------------------
| Sorts the array and returns subarrays of that with the same name
-group-by-name[t] t array-view[](values t[]) t name
	sorted = values sort x => x name
	with out : build
		cur-name mut = sorted[0] name
		start mut nat = 0
		for i : 1::nat .. sorted.size
			if sorted[i].name != cur-name
				out ~= sorted[start .. i]
				cur-name := sorted[i] name
				start := i
		out ~= sorted[start .. end]
-name[t] symbol(a t array-view) t name
	a[0] name
###

subscript[t] t array-view(a t multi-by-name, name symbol) t name
	match a impl
	as array xs
		i mut nat = 0
		loop
			guard i != xs.size : break
			if xs[i].name == name
				j mut nat = i + 1
				until j == xs.size || xs[j].name != name
					j +:= 1
				break xs[i .. j]
			else
				i +:= 1
				continue
	as large-multi-by-name l
		cur mut = trusted name.id % l.starts-and-nexts.size
		loop
			start-and-next = l.starts-and-nexts[cur]
			start = start-and-next >> 32
			next = start-and-next & 0xffffffff
			if l.values[start].name == name
				end = cur + 1 == l.starts-and-nexts.size ? l.values.size : l.starts-and-nexts[cur + 1] >> 32
				break l.values[start .. end]
			elif next == no-next.to
				break
			else
				cur := next
				continue

in[t] bool(name symbol, a t multi-by-name) t name
	a[name] !is-empty

iterate[t] bool(a t multi-by-name, f bool mut(x t))
	a.to iterate f

build[t] t multi-by-name(a build-options, f void mut(out t array-builder)) t name
	a build f to

choose-keys[t] t multi-by-name(a t multi-by-name, keys symbol set) t name
	with out : build
		for k : keys
			for x : a[k]
				out ~= x

test
	r0 r = "a", 1
	r1 r = "b", 2
	r2 r = "a", 3
	(r0, r1, r2).group-by-name sort (x => x[0].name) is do (r0, r2), (r1,)
	a r multi-by-name = (r0, r1, r2) to
	a["a"].to::r[] is (r0, r2)
	a["b"].to::r[] is (r1,)
	a["c"].to::r[] is ()
