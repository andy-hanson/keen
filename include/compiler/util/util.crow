array-like[col, elem] spec
	size nat(a col)
	subscript elem(a col, index nat)
only[col, elem] elem(a col) (col, elem) array-like
	a.size is 1
	a[0]
opt-only[col, elem] elem?(a col) (col, elem) array-like
	if a.size == 1
		a[0]
opt-only2[col, elem] (elem, elem)?(a col) (col, elem) array-like
	if a.size == 2
		a[0], a[1]
only2[col, elem] (elem, elem)(a col) (col, elem) array-like
	a.size is 2
	a[0], a[1]
only3[col, elem] (elem, elem, elem)(a col) (col, elem) array-like
	a.size is 3
	a[0], a[1], a[2]

# TODO: rename to opt-only? ---------------------------------------------------------------------------------------------------------------
as-single[t] t?(a t set) t key
	if a.size == 1
		for x : a
			break x
		else
			throw unreachable
test
	(1,)::(nat set).as-single is 1
	(1, 2)::(nat set).as-single is ()

arrays-correspond[t, u] bool(a t[], b u[], cb bool mut(x t, y u))
	a.size == b.size && 0::nat .. a.size every i =>
		cb[a[i], b[i]]
test
	(1, 2)::nat[] arrays-correspond (11, 12)::nat[], ((x, y) => x == y - 10) is true
	(1, 2)::nat[] arrays-correspond (11, 13)::nat[], ((x, y) => x == y - 10) is false

sum[col, elem] nat(xs col, f nat mut(x elem)) (col, elem) iterate
	res mut nat = 0
	for x : xs
		res +:= f[x]
	res

xor bool(a bool, b bool)
	a != b

must-find[t] t(a t[], f bool mut(x t))
	for x : a
		if f[x]
			break x
	else
		throw unreachable

find-index-or-push[t] nat(a t mut[], value t) t equal
	a index-of value ??
		res = a size
		a ~= value
		res
test
	xs nat mut[] = 1, 2, 3
	xs find-index-or-push 2 is 1
	xs.to::nat[] is (1, 2, 3)
	xs find-index-or-push 4 is 3
	xs.to::nat[] is (1, 2, 3, 4)

value-and-did-add[t] record(value t, did-add bool)
get-or-add-and-did-add[k, v] v value-and-did-add(a v mut[k], key k, cb v mut()) k key # TODO: RM (these should use object-memoizer)
	did-add mut = false
	value = a ensure key, () =>
		did-add := true
		cb[]
	value, did-add

pop-arbitrary[t] t?(a t mut-set) t key
	value t? = for x : a
		break x
	if x ?= value
		assert a remove x
	value
test
	a nat mut-set = 1, 2, 3
	popped nat mut[] = ()
	while x ?= a pop-arbitrary
		popped ~= x
	popped.to::nat[].sort is (1, 2, 3)

map-or-none[out, in-col, in-elem] out[]?(a in-col, f out? mut(x in-elem)) (in-col, in-elem) array-like
	guard a.size != 0 : ()::out[]
	res out mut[] = ()
	for i : 0::nat .. a.size
		if y ?= f[a[i]]
			res ~= y
			continue
		else
			break
	else
		res move-to
test
	xs nat[] = 1, 2, 3
	r0 nat[]? = xs map-or-none x =>
		x + 1
	r0 is (2, 3, 4)
	r1 nat[]? = xs map-or-none x =>
		if x < 3
			x + 3
	r1 is ()
	r2 nat[]? = ()::nat[] map-or-none _ =>
		throw unreachable
	r2 is ()::nat[]

zip[t, u] record(a t array-view, b u array-view)
zip[t, u] (t, u) zip(a t[], b u[])
	a.to zip b.to
zip[t, u] (t, u) zip(a t[], b u array-view)
	a.to zip b
size[t, u] nat64(a (t, u) zip)
	a.a.size is a.b.size
	a.a size
iterate[t, u] bool(a (t, u) zip, f bool mut(x t, y u))
	(0::nat .. a.size) iterate i =>
		f[a.a[i], a.b[i]]

zip-reverse[t, u] record(a t array-view, b u array-view)
size[t, u] nat64(a (t, u) zip-reverse)
	a.a.size is a.b.size
	a.a size
iterate[t, u] bool(a (t, u) zip-reverse, f bool mut(x t, y u))
	(0::nat .. a.size).reverse iterate i =>
		f[a.a[i], a.b[i]]
reverse[t, u] (t, u) zip-reverse(a (t, u) zip)
	a.a, a.b

zip3[t, u, v] record(a t[], b u[], c v[])
size[t, u, v] nat64(a (t, u, v) zip3)
	a.a.size is a.b.size
	a.b.size is a.c.size
	a.a.size
iterate[t, u, v] bool(a (t, u, v) zip3, f bool mut(x t, y u, z v))
	(0::nat .. a. size) iterate i =>
		f[a.a[i], a.b[i], a.c[i]]

# TODO: use a 'for' loop -----------------------------------------------------------------------------------------------------
each-pair[t] void(a t[], f void mut(x t, y t))
	for i : 0::nat .. a.size
		for j : i + 1 .. a.size
			f[a[i], a[j]]
test
	calls (nat, nat) mut[] = ()
	(1, 2, 3)::nat[] each-pair x =>
		calls ~= x
	calls.move-to::(nat, nat)[] is ((1, 2), (1, 3), (2, 3))

none-or-one-or-many[t] union(none, t one, many)
==[t] bool(a t none-or-one-or-many, b t none-or-one-or-many) t equal
to[t] json(a t none-or-one-or-many) (json, t) to
none record
== bool(a none, b none)
to json(a none)
one[t] record(value t)
==[t] bool(a t one, b t one) t equal
to[t] json(a t one) (json, t) to
many record
== bool(a many, b many)
to json(a many)

none-or-one-or-many[col, elem] elem none-or-one-or-many(a col, cb bool mut(x elem)) (col, elem) iterate
	res mut elem none-or-one-or-many = none
	for x : a
		guard cb[x] : continue
		if _ ?= res none
			res := x one
			continue
		else
			res := many
			break
	res
test
	xs nat[] = 1, 2, 3
	xs none-or-one-or-many (x => x == 4) is none
	xs none-or-one-or-many (x => x == 2) is 2.one
	xs none-or-one-or-many (x => x < 3) is many

first[out, in-col, in-elem] out?(a in-col, f out? mut(x in-elem)) (in-col, in-elem) iterate
	for x : a
		if res ?= f[x]
			break res

first-zip-if-size-eq[out, in0, in1] out?(a in0[], b in1[], f out? mut(x in0, y in1))
	if a.size == b.size
		a zip b first f

zip-if-size-eq[t, u] void(a t[], b u[], f void mut(x t, y u)) # TODO: use a 'for-loop' ---------------------------------------
	if a.size == b.size
		for x, y : a zip b
			f[x, y]

cb-option[out, in] out?(a in?, f out? mut(x in))
	if x ?= a
		f[x]
cb-option[in] bool(a in?, f bool mut(x in))
	if x ?= a
		f[x]

| Filter a list, possibly reordering it.
| (This is faster than if we had to preserve the order.)
filter-unordered[t] void(a t mut[], f bool mut(x t))
	i mut nat = 0
	while i < a.size
		if f[a[i]]
			i +:= 1
		elif i == a.size - 1
			_ = a.pop!
		else
			a[i] := a.pop!
test
	xs nat mut[] = 1, 2, 3, 4, 5
	xs filter-unordered x => x is-even
	xs.to::nat[] is (4, 2)
	xs filter-unordered x => x < 3
	xs.to::nat[] is (2,)
	xs filter-unordered x => x == 3
	xs.to::nat[] is ()

all-same[t, k] bool(a t[], f k data(x t)) k equal
	a is-empty ||
		value = f[a[0]]
		a is-empty || a[1 .. end] every x => f[x] == value
test
	()::nat[] all-same (x => x) is true
	(1, 11, 21)::nat[] all-same (x => x % 10) is true
	(1, 11, 22)::nat[] all-same (x => x % 10) is false

must-find-only[t] t(a t[], f bool mut(x t))
	res mut t? = ()
	for x : a
		if f[x]
			forbid _ ?= res : found-multiple
			res := x
	res ?? throw found-none
found-none record exception case
show string(_ found-none)
	"No elements satisfied the predicate."
found-multiple record exception case
show string(_ found-multiple)
	"Multiple elements satisfied the predicate."
test
	xs nat[] = 1, 2, 3
	xs must-find-only (x => x is-even) is 2
	try
		_ = xs must-find-only x => x == 4
		should-throw
	catch found-none
		()
	try
		_ = xs must-find-only x => x != 2
		should-throw
	catch found-multiple
		()

newline string(indent nat)
	tabs string = indent n-of "\t"
	"\n{tabs}"
