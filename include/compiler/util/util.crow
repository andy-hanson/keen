only[t] t(a t[])
	a.size is 1
	a[0]

# Named this way to match the old D implementation ... can't really do this any more .........................................
must-have-index-of-pointer[t] nat(xs t[], value t) trusted
	for i : 0::nat .. xs.size
		if xs[i] reference-equal value
			break i
	else
		throw unreachable

sum[t] nat(xs t[], cb nat mut(x t))
	res mut nat = 0
	for x : xs
		res +:= cb[x]
	res


enum-map[k, v] record
	| One for each enum member
	-values v[]

make-enum-map[k, v] (k, v) enum-map(cb v mut(key k)) k enum-like
	inner v[] = for index, key : members::k[] with-index
		key.to::nat32 is index.to
		cb[key]
	inner,

subscript[k, v] v(a (k, v) enum-map, key k) k enum-like
	a.values[key.to::nat32 to]
at[k, v] v(a (k, v) enum-map, key k) k enum-like
	a.values[key.to::nat32 to]

enum-like[t] spec t data
	to nat32(a t)
	members t[]()

symbol-set alias
	symbol set

xor bool(a bool, b bool)
	a != b

must-find[t] t(a t[], f bool mut(x t))
	for x : a
		if f[x]
			break x
	else
		throw unreachable
