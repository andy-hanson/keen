import
	../../crow/private/parse-util

only[col, elem] elem?(a col) (col, elem) array-like
	if a.size == 1
		a[0]
only2[col, elem] (elem, elem)?(a col) (col, elem) array-like
	if a.size == 2
		a[0], a[1]
only3[col, elem] (elem, elem, elem)?(a col) (col, elem) array-like
	if a.size == 3
		a[0], a[1], a[2]

arrays-correspond[t, u] bool(a t[], b u[], cb bool mut(x t, y u))
	a.size == b.size and every 0::nat .. a.size, cb[a[it], b[it]]
test
	arrays-correspond (1, 2)::nat[], (11, 12)::nat[], (of x, y then x == y - 10) is true
	arrays-correspond (1, 2)::nat[], (11, 13)::nat[], (of x, y then x == y - 10) is false

find-index-or-push[t] nat(a t mut[], value t) t equal
	index-of a, value else
		res = a.size
		a ~= value
		res
test
	xs nat mut[] = 1, 2, 3
	find-index-or-push xs, 2 is 1
	xs.to::nat[] is (1, 2, 3)
	find-index-or-push xs, 4 is 3
	xs.to::nat[] is (1, 2, 3, 4)

value-and-did-add[t] record(value t, did-add bool)
get-or-add-and-did-add[k, v] v value-and-did-add(a v mut[k], key k, cb v mut()) k key # TODO: RM (these should use object-memoizer)
	did-add mut bool = false
	value: ensure a, key, of
		did-add := true
		cb[]
	did-add: did-add

pop-arbitrary[t] t?(a t mut-set) t key
	if x = get-arbitrary a
		assert remove a, x
		x
get-arbitrary[col, elem] elem?(a col) (col, elem) iterate
	first a, it.identity
test
	a nat mut-set = 1, 2, 3
	popped nat mut[] = ()
	while x = pop-arbitrary a
		popped ~= x
	popped.to::nat[].sort is (1, 2, 3)

zip[t, u] record(a t array-view, b u array-view)
size[t, u] nat64(a (t, u) zip)
	a.a.size is a.b.size
	a.a.size
iterate[t, u] bool(a (t, u) zip, f bool mut(x t, y u))
	iterate (0::nat .. a.size), f[a.a[it], a.b[it]]

# TODO: use a 'for' loop -----------------------------------------------------------------------------------------------------
each-pair[t] void(a t[], f void mut(x t, y t))
	for i in 0::nat .. a.size
		for j in i + 1 .. a.size
			f[a[i], a[j]]
test
	calls (nat, nat) mut[] = ()
	each-pair (1, 2, 3)::nat[], of x
		calls ~= x
	calls.move-to::(nat, nat)[] is ((1, 2), (1, 3), (2, 3))

none-or-one-or-many[t] union(none, t one, many)
==[t] bool(a t none-or-one-or-many, b t none-or-one-or-many) t equal
to[t] json(a t none-or-one-or-many) (json, t) to
none record
== bool(a none, b none)
to json(a none)
one[t] record(value t)
==[t] bool(a t one, b t one) t equal
to[t] json(a t one) (json, t) to
many record
== bool(a many, b many)
to json(a many)

none-or-one-or-many[col, elem] elem none-or-one-or-many(a col, cb bool mut(x elem)) (col, elem) iterate
	one mut elem? = ()
	has-many = exists a, of x
		if cb[x]
			if one
				true
			else
				one := x
				false
	if has-many
		many
	elif one
		one one!
	else
		none
test
	xs nat[] = 1, 2, 3
	none-or-one-or-many xs, it == 4 is none
	none-or-one-or-many xs, it == 2 is 2.one
	none-or-one-or-many xs, it < 3 is many

zip-if-size-eq[t, u] record(a t[], b u[])
iterate[t, u] bool(a (t, u) zip-if-size-eq, f bool mut(x t, y u))
	if a.a.size == a.b.size
		iterate (zip a.a, a.b), f

cb-option[output, input] output(a input?, f output mut(x input)) output new
	if a then f[a]

| Filter a list, possibly reordering it.
| (This is faster than if we had to preserve the order.)
filter-unordered[t] void(a t mut[], f bool mut(x t))
	i mut = 0
	while i < a.size
		if f[a[i]]
			i +:= 1
		elif i == a.size - 1
			_ = a.pop!
		else
			a[i] := a.pop!
test
	xs nat mut[] = 1, 2, 3, 4, 5
	filter-unordered xs, it.is-even
	xs.to::nat[] is (4, 2)
	filter-unordered xs, it < 3
	xs.to::nat[] is (2,)
	filter-unordered xs, it == 3
	xs.to::nat[] is ()

all-same[t, k] bool(a t[], f k data(x t)) k equal
	a.size < 2 or
		value = f[a[0]]
		every a[1 .. end], f[it] == value
test
	all-same ()::nat[], it.identity is true
	all-same (1, 11, 21)::nat[], (it % 10) is true
	all-same (1, 11, 22)::nat[], (it % 10) is false

must-find-only[t] t(a t[], f bool mut(x t))
	res mut t? = ()
	for x in a
		if f[x]
			forbid res else found-multiple
			res := x
	res else throw found-none
found-none record exception case
show string(_ found-none)
	"No elements satisfied the predicate."
found-multiple record exception case
show string(_ found-multiple)
	"Multiple elements satisfied the predicate."
test
	xs nat[] = 1, 2, 3
	must-find-only xs, it.is-even is 2
	try
		_ = must-find-only xs, it == 4
		should-throw
	catch as found-none
		()
	try
		_ = must-find-only xs, it != 2
		should-throw
	catch as found-multiple
		()

newline string(indent nat)
	tabs char8[] = n-of indent, "\t"
	"\n{tabs.to::string}"

is-ascii-identifier-char bool(a char8)
	is-letter-or-digit a or a == "_"

filter-together[t, u] (t[], u[])(a t[], b u[], f bool mut(index nat, x t, y u))
	a.size is b.size
	indices nat[] = filter 0 .. a.size, f[it, a[it], b[it]]
	if indices.size == a.size
		a, b
	else
		- map indices, a[it]
		- map indices, b[it]

# TODO: These should be in the standard library somewhere (but make more generic) -------------------------------------------------------------------
last[col, elem] elem?(a col) (col, elem) array-like
	unless a.size == 0
		a[a.size - 1]
last-n[t] t array-view(a t[], n nat)
	assert n <= a.size else index-too-big n, a.size
	a[a.size - n .. a.size]
