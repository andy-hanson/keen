only[t] t(a t[])
	a.size is 1
	a[0]
only[t] t(a t mut[])
	a.size is 1
	a[0]
opt-only[t] t?(a t[])
	if a.size == 1
		a[0],
opt-only[t] t?(a t mut[])
	if a.size == 1
		a[0],
only2[t] (t, t)(a t[])
	a.size is 2
	a[0], a[1]
only3[t] (t, t, t)(a t[])
	a.size is 3
	a[0], a[1], a[2]

# TODO: rename? ---------------------------------------------------------------------------------------------------------------
as-single[t] t?(a t set) t key
	if a.size == 1
		for x : a
			break x,
		else
			throw unreachable
test
	(1,)::(nat set).as-single is (1,)
	(1, 2)::(nat set).as-single is ()

arrays-correspond[t, u] bool(a t[], b u[], cb bool mut(x t, y u))
	a.size == b.size && 0::nat .. a.size every i =>
		cb[a[i], b[i]]
test
	(1, 2)::nat[] arrays-correspond (11, 12)::nat[], ((x, y) => x == y - 10) is true
	(1, 2)::nat[] arrays-correspond (11, 13)::nat[], ((x, y) => x == y - 10) is false

# Named this way to match the old D implementation ... can't really do this any more .........................................
must-have-index-of-pointer[t] nat(xs t[], value t) trusted
	for i : 0::nat .. xs.size
		if xs[i] reference-equal value
			break i
	else
		throw unreachable

sum[t] nat(xs t[], cb nat mut(x t))
	res mut nat = 0
	for x : xs
		res +:= cb[x]
	res

symbol-set alias
	symbol set
show string(a symbol-set)
	", " join for x : a
		x.to quote

xor bool(a bool, b bool)
	a != b

must-find[t] t(a t[], f bool mut(x t))
	for x : a
		if f[x]
			break x
	else
		throw unreachable

find-index-or-push[t] nat(a t mut[], value t) t equal
	a index-of value ?? do
		res = a size
		a ~= value
		res
test
	xs nat mut[] = 1, 2, 3
	xs find-index-or-push 2 is 1
	xs.to::nat[] is (1, 2, 3)
	xs find-index-or-push 4 is 3
	xs.to::nat[] is (1, 2, 3, 4)

value-and-did-add[t] record(value t, did-add bool)
get-or-add-and-did-add[k, v] v value-and-did-add(a v mut[k], key k, cb v mut()) k key
	did-add mut = false
	value = a ensure key, () =>
		did-add := true
		cb[]
	value, did-add

pop-arbitrary[t] t?(a t mut-set) t key
	value t? = for x : a
		break x
	if x ?= value
		assert a remove x
	value
test
	a nat mut-set = 1, 2, 3
	a.pop-arbitrary is (3,)
	a.pop-arbitrary is (1,)
	a.pop-arbitrary is (2,)
	a.pop-arbitrary is ()

mut-multi-map[k, v] record mut
	-inner v mut-set mut[k]
new[k, v] (k, v) mut-multi-map() k key
	(),
~=[k, v] void(a (k, v) mut-multi-map, (key k, value v)) k key, v key
	a.inner ensure key ~= value
remove-key[k, v] v set(a (k, v) mut-multi-map, key k) k key, v key
	if x ?= a.inner remove key
		x move-to
# TODO: PERF design the mut-multi-map so we can easily remove a single value for a key (the D version did this) ---------------
remove-pair[k, v] bool(a (k, v) mut-multi-map, key k, value v) k key, v key
	if vs ?= a.inner[key]
		vs remove value
iterate[k, v] bool(a (k, v) mut-multi-map, f bool mut(key k, value v)) k key,  v key
	a.inner iterate (k, vs) =>
		vs iterate v =>
			f[k, v]

map-or-none[t] record(values t[]) nominal
for-loop[out, in] out[]?(a in map-or-none, f out? mut(x in))
	res out mut[] = ()
	for x : a values
		if y ?= f[x]
			res ~= y
			continue
		else
			break
	else
		res.move-to,
test
	xs nat[] = 1, 2, 3
	r0 nat[]? = for x : xs map-or-none
		x + 1,
	r0 is ((2, 3, 4),)
	r1 nat[]? = for x : xs map-or-none
		if x < 3
			x + 3,
	r1 is ()

zip[t, u] record nominal
	a t[]
	b u[]
size[t, u] nat64(a (t, u) zip)
	a.a.size is a.b.size
	a.a.size
iterate[t, u] bool(a (t, u) zip, f bool mut(x t, y u))
	(0::nat .. a.size) iterate i =>
		f[a.a[i], a.b[i]]

# TODO: use a 'for' loop -----------------------------------------------------------------------------------------------------
each-pair[t] void(a t[], f void mut(x t, y t))
	for i : 0::nat .. a.size
		for j : i + 1 .. a.size
			f[a[i], a[j]]
test
	calls (nat, nat) mut[] = ()
	(1, 2, 3)::nat[] each-pair x =>
		calls ~= x
	calls.move-to::(nat, nat)[] is ((1, 2), (1, 3), (2, 3))

none-or-one-or-many[t] union(none, t one, many)
==[t] bool(a t none-or-one-or-many, b t none-or-one-or-many) t equal
to[t] json(a t none-or-one-or-many) (json, t) to
none record
== bool(a none, b none)
to json(a none)
one[t] record(value t)
==[t] bool(a t one, b t one) t equal
to[t] json(a t one) (json, t) to
many record
== bool(a many, b many)
to json(a many)

none-or-one-or-many[t] t none-or-one-or-many(a t[], cb bool mut(x t))
	res mut t none-or-one-or-many = none
	for x : a
		guard cb[x] : continue
		if _ ?= res none
			res := x one
			continue
		else
			res := many
			break
	res
test
	xs nat[] = 1, 2, 3
	xs none-or-one-or-many (x => x == 4) is none
	xs none-or-one-or-many (x => x == 2) is 2.one
	xs none-or-one-or-many (x => x < 3) is many

first[out, in] out?(a in[], f out? mut(x in))
	for x : a
		if res ?= f[x]
			break res

cb-option[out, in] out?(a in?, f out? mut(x in))
	if x ?= a
		f[x]
cb-option[in] bool(a in?, f bool mut(x in))
	if x ?= a
		f[x]

| Filter a list, possibly reordering it.
| (This is faster than if we had to preserve the order.)
filter-unordered[t] void(a t mut[], f bool mut(x t))
	i mut nat = 0
	while i < a.size
		if f[a[i]]
			i +:= 1
		elif i == a.size - 1
			_ = a.pop!
		else
			a[i] := a.pop!
test
	xs nat mut[] = 1, 2, 3, 4, 5
	xs filter-unordered x => x is-even
	xs.to::nat[] is (4, 2)
	xs filter-unordered x => x < 3
	xs.to::nat[] is (2,)
	xs filter-unordered x => x == 3
	xs.to::nat[] is ()

| Like {filter-unordered}, but does nothing if {f} returned false for every element.
filter-unordered-but-dont-remove-all[t] void(a t mut[], f bool mut(x t))
	keep nat mut[] = ()
	for i, x : a with-index
		if f[x]
			keep ~= i
	unless keep is-empty || keep.size == a.size
		for out-i, in-i : keep with-index
			if in-i != out-i
				a[out-i] := a[in-i]
		_ = a pop-n (a.size - keep.size)
test
	xs nat mut[] = 1, 2, 3, 4, 5
	xs filter-unordered-but-dont-remove-all x => x is-even
	xs.to::nat[] is (2, 4)
	xs filter-unordered-but-dont-remove-all x => x !is-even
	xs.to::nat[] is (2, 4)

all-same[t, k] bool(a t[], f k data(x t)) k equal
	a is-empty || do
		value = f[a[0]]
		a is-empty || a[1 .. end] every x => f[x] == value
test
	()::nat[] all-same (x => x) is true
	(1, 11, 21)::nat[] all-same (x => x % 10) is true
	(1, 11, 22)::nat[] all-same (x => x % 10) is false

make-hash-table[k, v] v[k](values v[], get-key k data(x v), cb-duplicate void mut(x v)) k key
	res v mut[k] = ()
	for value : values
		key = get-key[value]
		if _ ?= res[key]
			cb-duplicate[value]
		else
			res[key] := value
	res move-to

must-find-only[t] t(a t[], f bool mut(x t))
	res mut t? = ()
	for x : a
		if f[x]
			forbid _ ?= res : found-multiple
			res := x,
	res ?? throw found-none
found-none record exception case
show string(_ found-none)
	"No elements satisfied the predicate."
found-multiple record exception case
show string(_ found-multiple)
	"Multiple elements satisfied the predicate."
test
	xs nat[] = 1, 2, 3
	xs must-find-only (x => x is-even) is 2
	try
		_ = xs must-find-only x => x == 4
		should-throw
	catch found-none
		()
	try
		_ = xs must-find-only x => x != 2
		should-throw
	catch found-multiple
		()

add-and-get-index[t] nat(a t mut[], value t)
	res = a size
	a ~= value
	res

newline string(indent nat)
	tabs string = indent n-of "\t"
	"\n{tabs}"
