import
	../../crow/private/parse-util

only[col, elem] elem(a col) (col, elem) array-like
	a.size is 1
	a[0]
opt-only[col, elem] elem?(a col) (col, elem) array-like
	if a.size == 1
		a[0]
opt-only[t] t?(a t set) t key
	if a.size == 1
		a.to::t[] only
opt-only2[col, elem] (elem, elem)?(a col) (col, elem) array-like
	if a.size == 2
		a[0], a[1]
only2[col, elem] (elem, elem)(a col) (col, elem) array-like
	a.size is 2
	a[0], a[1]
only3[col, elem] (elem, elem, elem)(a col) (col, elem) array-like
	a.size is 3
	a[0], a[1], a[2]

arrays-correspond[t, u] bool(a t[], b u[], cb bool mut(x t, y u))
	a.size == b.size and 0::nat .. a.size every cb[a[it], b[it]]
test
	(1, 2)::nat[] arrays-correspond (11, 12)::nat[], (of x, y then x == y - 10) is true
	(1, 2)::nat[] arrays-correspond (11, 13)::nat[], (of x, y then x == y - 10) is false

xor bool(a bool, b bool)
	a != b

find-index-or-push[t] nat(a t mut[], value t) t equal
	a index-of value else
		res = a size
		a ~= value
		res
test
	xs nat mut[] = 1, 2, 3
	xs find-index-or-push 2 is 1
	xs.to::nat[] is (1, 2, 3)
	xs find-index-or-push 4 is 3
	xs.to::nat[] is (1, 2, 3, 4)

value-and-did-add[t] record(value t, did-add bool)
get-or-add-and-did-add[k, v] v value-and-did-add(a v mut[k], key k, cb v mut()) k key # TODO: RM (these should use object-memoizer)
	did-add mut bool = false
	value = a ensure key, of
		did-add := true
		cb[]
	value, did-add

pop-arbitrary[t] t?(a t mut-set) t key
	if x ?= a get-arbitrary
		assert a remove x
		x
get-arbitrary[col, elem] elem?(a col) (col, elem) iterate
	a first it.identity
test
	a nat mut-set = 1, 2, 3
	popped nat mut[] = ()
	while x ?= a pop-arbitrary
		popped ~= x
	popped.to::nat[].sort is (1, 2, 3)

zip[t, u] record(a t array-view, b u array-view)
zip[t, u] (t, u) zip(a t[], b u[])
	a.to zip b.to
zip[t, u] (t, u) zip(a t[], b u array-view)
	a.to zip b
size[t, u] nat64(a (t, u) zip)
	a.a.size is a.b.size
	a.a size
iterate[t, u] bool(a (t, u) zip, f bool mut(x t, y u))
	(0::nat .. a.size) iterate f[a.a[it], a.b[it]]

zip3[t, u, v] record(a t[], b u[], c v[])
size[t, u, v] nat64(a (t, u, v) zip3)
	a.a.size is a.b.size
	a.b.size is a.c.size
	a.a.size
iterate[t, u, v] bool(a (t, u, v) zip3, f bool mut(x t, y u, z v))
	(0::nat .. a. size) iterate f[a.a[it], a.b[it], a.c[it]]

# TODO: use a 'for' loop -----------------------------------------------------------------------------------------------------
each-pair[t] void(a t[], f void mut(x t, y t))
	for i in 0::nat .. a.size
		for j in i + 1 .. a.size
			f[a[i], a[j]]
test
	calls (nat, nat) mut[] = ()
	(1, 2, 3)::nat[] each-pair of x
		calls ~= x
	calls.move-to::(nat, nat)[] is ((1, 2), (1, 3), (2, 3))

none-or-one-or-many[t] union(none, t one, many)
==[t] bool(a t none-or-one-or-many, b t none-or-one-or-many) t equal
to[t] json(a t none-or-one-or-many) (json, t) to
none record
== bool(a none, b none)
to json(a none)
one[t] record(value t)
==[t] bool(a t one, b t one) t equal
to[t] json(a t one) (json, t) to
many record
== bool(a many, b many)
to json(a many)

none-or-one-or-many[col, elem] elem none-or-one-or-many(a col, cb bool mut(x elem)) (col, elem) iterate
	one mut elem? = ()
	has-many = a exists of x
		if cb[x]
			if _ ?= one
				true
			else
				one := x
				false
	if has-many
		many
	elif v ?= one
		v one
	else
		none
test
	xs nat[] = 1, 2, 3
	xs none-or-one-or-many it == 4 is none
	xs none-or-one-or-many it == 2 is 2.one
	xs none-or-one-or-many it < 3 is many

first-zip-if-size-eq[out, in0, in1] out?(a in0[], b in1[], f out? mut(x in0, y in1))
	if a.size == b.size
		a zip b first f

zip-if-size-eq[t, u] void(a t[], b u[], f void mut(x t, y u)) # TODO: use a 'for-loop' ---------------------------------------
	if a.size == b.size
		for x, y in a zip b
			f[x, y]

cb-option[output, input] output?(a input?, f output? mut(x input))
	if x ?= a
		f[x]
cb-option[input] bool(a input?, f bool mut(x input))
	if x ?= a
		f[x]

| Filter a list, possibly reordering it.
| (This is faster than if we had to preserve the order.)
filter-unordered[t] void(a t mut[], f bool mut(x t))
	i mut nat = 0
	while i < a.size
		if f[a[i]]
			i +:= 1
		elif i == a.size - 1
			_ = a.pop!
		else
			a[i] := a.pop!
test
	xs nat mut[] = 1, 2, 3, 4, 5
	xs filter-unordered it.is-even
	xs.to::nat[] is (4, 2)
	xs filter-unordered it < 3
	xs.to::nat[] is (2,)
	xs filter-unordered it == 3
	xs.to::nat[] is ()

# TODO: generalize to all collections and move to standard library ----------------------------------------------------------------------------------
all-same[t, k] bool(a t[], f k data(x t)) k equal
	a.size < 2 or
		value = f[a[0]]
		a[1 .. end] every f[it] == value
test
	()::nat[] all-same it.identity is true
	(1, 11, 21)::nat[] all-same (it % 10) is true
	(1, 11, 22)::nat[] all-same (it % 10) is false

must-find-only[t] t(a t[], f bool mut(x t))
	res mut t? = ()
	for x in a
		if f[x]
			forbid _ ?= res else found-multiple
			res := x
	res else throw found-none
found-none record exception case
show string(_ found-none)
	"No elements satisfied the predicate."
found-multiple record exception case
show string(_ found-multiple)
	"Multiple elements satisfied the predicate."
test
	xs nat[] = 1, 2, 3
	xs must-find-only it.is-even is 2
	try
		_ = xs must-find-only it == 4
		should-throw
	catch found-none
		()
	try
		_ = xs must-find-only it != 2
		should-throw
	catch found-multiple
		()

newline string(indent nat)
	tabs string = indent n-of "\t"
	"\n{tabs}"

is-ascii-identifier-char bool(a char32)
	try c8 char8 = a to catch unary-out-of-range _ then false
	c8 is-ascii-identifier-char
is-ascii-identifier-char bool(a char8)
	a is-letter-or-digit or a == "_"

filter-together[t, u] (t[], u[])(a t[], b u[], f bool mut(x t, y u))
	a.size is b.size
	indices nat[] = 0 .. a.size filter f[a[it], b[it]]
	if indices.size == a.size
		a, b
	else
		- indices map a[it]
		- indices map b[it]
