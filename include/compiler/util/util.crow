only[t] t(a t[])
	a.size is 1
	a[0]
only[t] t(a t mut[])
	a.size is 1
	a[0]
only2[t] (t, t)(a t[])
	a.size is 2
	a[0], a[1]
opt-only[t] t?(a t[])
	if a.size == 1
		a[0],
opt-only[t] t?(a t mut[])
	if a.size == 1
		a[0],
# TODO: rename? ---------------------------------------------------------------------------------------------------------------
as-single[t] t?(a t set) t key
	if a.size == 1
		for x : a
			break x,
		else
			throw unreachable

arrays-correspond[t, u] bool(a t[], b u[], cb bool mut(x t, y u))
	a.size == b.size && 0::nat .. a.size every i =>
		cb[a[i], b[i]]

# Named this way to match the old D implementation ... can't really do this any more .........................................
must-have-index-of-pointer[t] nat(xs t[], value t) trusted
	for i : 0::nat .. xs.size
		if xs[i] reference-equal value
			break i
	else
		throw unreachable

sum[t] nat(xs t[], cb nat mut(x t))
	res mut nat = 0
	for x : xs
		res +:= cb[x]
	res

symbol-set alias
	symbol set

xor bool(a bool, b bool)
	a != b

must-find[t] t(a t[], f bool mut(x t))
	for x : a
		if f[x]
			break x
	else
		throw unreachable

value-and-did-add[t] record(value t, did-add bool)
get-or-add-and-did-add[k, v] v value-and-did-add(a v mut[k], key k, cb v mut()) k key
	did-add mut = false
	value = a ensure key, () =>
		did-add := true
		cb[]
	value, did-add

pop-arbitrary[t] t?(a t mut-set) t key
	value t? = for x : a
		break x
	if x ?= value
		assert a remove x
	value


mut-multi-map[k, v] record mut
	-inner v mut-set mut[k]
new[k, v] (k, v) mut-multi-map() k key
	(),
~=[k, v] void(a (k, v) mut-multi-map, (key k, value v)) k key, v key
	a.inner ensure key ~= value
remove-key[k, v] v set(a (k, v) mut-multi-map, key k) k key, v key
	if x ?= a.inner remove key
		x move-to
# TODO: PERF design the mut-multi-map so we can easily remove a single value for a key (the D version did this) ---------------
remove-pair[k, v] bool(a (k, v) mut-multi-map, key k, value v) k key, v key
	if vs ?= a.inner[key]
		vs remove value
iterate[k, v] bool(a (k, v) mut-multi-map, f bool mut(key k, value v)) k key,  v key
	a.inner iterate (k, vs) =>
		vs iterate v =>
			f[k, v]

map-or-none[t] record(values t[]) nominal
for-loop[out, in] out[]?(a in map-or-none, f out? mut(x in))
	res out mut[] = ()
	for x : a values
		if y ?= f[x]
			res ~= y
			continue
		else
			break
	else
		res.move-to,

zip[t, u] record nominal
	a t[]
	b u[]
size[t, u] nat64(a (t, u) zip)
	a.a.size is a.b.size
	a.a.size
iterate[t, u] bool(a (t, u) zip, f bool mut(x t, y u))
	(0::nat .. a.size) iterate i =>
		f[a.a[i], a.b[i]]

each-pair[t] void(a t[], f void mut(x t, y t))
	for i : 0::nat .. a.size
		for j : i + 1 .. a.size
			f[a[i], a[j]]

none-or-one-or-many[t] union(none, t one, many)
none record
one[t] record(value t)
many record

none-or-one-or-many[t] t none-or-one-or-many(a t[], cb bool mut(x t))
	res mut t none-or-one-or-many = none
	for x : a
		guard cb[x] : continue
		if _ ?= res none
			res := x one
			continue
		else
			res := many
			break
	res

first[out, in] out?(a in[], f out? mut(x in))
	for x : a
		if res ?= f[x]
			break res

cb-option[out, in] out?(a in?, cb out? mut(x in))
	if x ?= a
		cb[x]

| Filter a list, possibly reordering it.
| (This is faster than if we had to preserve the order.)
filter-unordered[t] void(a t mut[], f bool mut(x t))
	i mut nat = 0
	while i < a.size
		if f[a[i]]
			i +:= 1
		elif i == a.size - 1
			_ = a.pop!
		else
			a[i] := a.pop!
test
	xs nat mut[] = 1, 2, 3, 4, 5
	xs filter-unordered x => x is-even
	xs.to::nat[] is (4, 2)

| Like {filter-unordered}, but does nothing if {f} returned false for every element.
filter-unordered-but-dont-remove-all[t] void(a t mut[], f bool mut(x t))
	keep nat mut[] = ()
	for i, x : a with-index
		if f[x]
			keep ~= i
	unless keep is-empty || keep.size == a.size
		for out-i, in-i : keep with-index
			if in-i != out-i
				a[out-i] := a[in-i]
		_ = a pop-n (a.size - keep.size)

test
	xs nat mut[] = 1, 2, 3, 4, 5
	xs filter-unordered-but-dont-remove-all x => x is-even
	xs.to::nat[] is (2, 4)
	xs filter-unordered-but-dont-remove-all x => x !is-even
	xs.to::nat[] is (2, 4)

all-same[t, k] bool(a t[], f k data(x t)) k equal
	a is-empty || do
		value = f[a[0]]
		a is-empty || a[1 .. end] every x => f[x] == value
test
	()::nat[] all-same (x => x) is true
	(1, 11, 21)::nat[] all-same (x => x % 10) is true
	(1, 11, 22)::nat[] all-same (x => x % 10) is false

make-hash-table[k, v] v[k](values v[], get-key k data(x v), cb-duplicate void mut(x v)) k key
	res v mut[k] = ()
	for value : values
		key = get-key[value]
		if _ ?= res[key]
			cb-duplicate[value]
		else
			res[key] := value
	res move-to

