# TODO: this module is no longer used ---------------------------------------------------------------------------------------
import
	crow/col/experimental/frozen-map
	crow/java

hash nat(a symbol)
	assert trusted extern java : todo # ------------------------------------------------------------------------------------------
	hash nat32 = trusted a call-instance "hashCode"
	hash to

get-key[t, k] spec k key
	get-key k(a t)
	hash nat(a k)

multi-set[t, k] record
	inner (k, t[]) frozen-map

new[t, k] (t, k) multi-set() (t, k) get-key
	(),

move-to[t, k] (t, k) multi-set(a t mut[]) (t, k) get-key
	a.move-to to

to[t, k] (t, k) multi-set(a t[]) (t, k) get-key
	res t mut[] mut[k] = ()
	for x : a
		res ensure x.get-key ~= x
	pairs (k, t[])[] = for k, v : res; k, v.move-to
	pairs.to,

filter[t, k] (t, k) multi-set(a (t, k) multi-set, f bool mut(x t)) (t, k) get-key
	pairs (k, t[])[] = with out : build
		for k, vs : a inner
			filtered t[] = vs filter f
			unless filtered is-empty
				out ~= k, filtered
	pairs.to,

iterate[t, k] bool(a (t, k) multi-set, f bool mut(x t)) (t, k) get-key
	a.inner iterate (_, xs) => xs iterate f

subscript[t, k] t[](a (t, k) multi-set, key k) (t, k) get-key
	a.inner[key] ?? ()

in[t, k] bool(key k, a (t, k) multi-set) (t, k) get-key
	key in a.inner

choose-keys[t, k] (t, k) multi-set(a (t, k) multi-set, keys k set) (t, k) get-key
	inner (k, t[]) frozen-map = with out : build
		for key : keys
			out ~= key, a[key]
	inner,

###
multi-set[t, k] record
	# This is a hash table where the `t[]` is all values with the same hash code, even if the keys are not equal.
	-entries t[][]

new[t, k] (t, k) multi-set() (t, k) get-key
	(),

move-to[t, k] (t, k) multi-set(a t mut[]) (t, k) get-key
	a.move-to to

to[t, k] (t, k) multi-set(a t[]) (t, k) get-key
	guard a !is-empty
	entries t mut[] mut-slice = trusted a.size gc-safe-mut-slice
	# TODO: consider a perfect hash so that there are no conflicts ------------------------------------------------------------
	for x : a
		key = x get-key
		hash = key hash
		index = hash % entries.size
		if trusted entries[index] reference-equal gc-safe-value
			entries[index] := ()
		entries[index] ~= x
	res t[][] = for x : entries
		unless trusted x reference-equal gc-safe-value
			x move-to
	res,

filter[t, k] (t, k) multi-set(a (t, k) multi-set, f bool mut(x t)) (t, k) get-key
	# TODO:PERF Just return 'a' if the filter is always true ------------------------------------------------------------------
	res t mut[] = ()
	for x : a
		if f[x]
			res ~= x
	res move-to

multi-set-values[t, k] record
	-entries t[]
	-key k
-new[t, k] (t, k) multi-set-values()
	(), trusted gc-safe-value

iterate[t, k] bool(a (t, k) multi-set, f bool mut(x t)) (t, k) get-key
	a.entries iterate xs =>
		xs iterate f

subscript[t, k] (t, k) multi-set-values(a (t, k) multi-set, key k) (t, k) get-key
	guard a.entries !is-empty
	a.entries[key.hash % a.entries.size], key

in[t, k] bool(key k, a (t, k) multi-set) (t, k) get-key
	a[key] iterate _ => true

choose-keys[t, k] (t, k) multi-set(a (t, k) multi-set, keys k set) (t, k) get-key
	res t mut[] = ()
	for k : keys
		for x : a[k]
			res ~= x
	res move-to

size[t, k] nat(a (t, k) multi-set-values) (t, k) get-key
	res mut nat = 0
	for _ : a
		res +:= 1
	res

to[t, k] t[](a (t, k) multi-set-values) (t, k) get-key
	with out : build
		for x : a
			out ~= x

iterate[t, k] bool(a (t, k) multi-set-values, f bool mut(x t)) (t, k) get-key
	a.entries iterate x =>
		if x.get-key == a.key
			f[x]

test
	xs r[] = (3, "three"), (1, "uno"), (5, "five"), (1, "one")
	a (r, nat) multi-set = xs to
	a[1].to::r[] is ((1, "uno"), (1, "one"))
-r record(get-key nat, s string)
-== bool(a r, b r)
-hash nat(a nat)
	a % 10
-to json(a r)
