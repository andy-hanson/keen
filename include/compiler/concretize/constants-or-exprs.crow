import
	../model/concrete-model

# TODO: This module is too small -----------------------------------------------------------------------------------------------
constants-or-exprs union(constants, exprs)
constants record(constants constant[])
exprs record(exprs concrete-expr[])

# TODO: this could just return constant[]?, since exprs is the input
as-constants-or-exprs constants-or-exprs(exprs concrete-expr[])
	if exprs every x => x.kind.constant !is-empty
		(for x : exprs; x.kind.constant!) constants
	else
		exprs exprs

as-constants constant[]?(exprs concrete-expr[])
	if exprs every x => x.kind.constant !is-empty
		for x : exprs
			x.kind constant!
