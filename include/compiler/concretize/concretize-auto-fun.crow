import
	../model/concrete-model
	../model/model
	../model/source-range
	../util/util
	./all-constants-builder
	./concretize-ctx
	./concretize-expr-ctx
	./generate

concretize-auto-fun concrete-expr(fun concrete-fun, a auto-fun) concretize-ctx, quick-fill-in-concrete-fun-body
	the concretize-expr-ctx = fun, ()
	return-type = fun.return-type
	params = fun.params
	param0 concrete-expr mut() = of
		gen-param-get fun.range, params[0]
	param1 concrete-expr mut() = of
		gen-param-get fun.range, params[1]
	range = fun.range
	match a.kind
	as compare
		compare-nats concrete-expr mut(storage nat-type) = of storage
			p0 = gen-cast-nat range, storage, param0[]
			p1 = gen-cast-nat range, storage, param1[]
			gen-compare-integral return-type, range, p0, p1
		match x = enum-flags-record-or-union params.same-type
		as enum_
			compare-nats[x.storage]
		as flags_
			compare-nats[x.storage]
		as concrete-record
			concretize-compare-record range, return-type, params.only2!, x.fields, a.members
		as concrete-union
			concretize-compare-union range, return-type, params.only2!, x.members, a.members
	as equals
		match x = enum-flags-record-or-union params.same-type
		as enum_
			concretize-equal-enum-or-flags range, x.storage, param0[], param1[]
		as flags_
			concretize-equal-enum-or-flags range, x.storage, param0[], param1[]
		as concrete-record
			concretize-equal-record range, params.only2!, x.fields, a.members
		as concrete-union
			concretize-equal-union range, return-type, params.only2!, x.members, a.members
	as members-of-enum-or-flags
		gen-constant-array all-constants, return-type, range,
			map return-type.array-element-type.enum-or-flags-members, it.value.to
	as to-enum-or-flags-option-from-nat
		concretize-integral-to-opt-enum-or-flags range, return-type, only! params
	as to-enum-or-flags-option-from-symbol
		concretize-symbol-to-opt-enum-or-flags range, return-type, only! params
	as to-nat-from-enum-or-flags
		arg = param0[]
		storage = enum-or-flags-storage arg.type
		gen-widen-nat return-type.must-be-nat-type, gen-cast storage.nat-type, range, param0[]
	as to-json
		param = only! params
		match body = enum-flags-record-or-union param.type
		as enum_
			auto-fun-match-enum range, return-type, param, of x
				gen-constant return-type, range, constant-json-string x.name.to
		as flags_
			gen-json-array concretize-flags-to-array range, json-array-type, param, of member
				constant-json-string member.name.to
		as concrete-record
			concretize-record-to-json range, param, body.fields, a.members
		as concrete-union
			concretize-union-to-json range, param, body.members, a.members
	as to-symbol-array-from-flags
		concretize-flags-to-array range, return-type, params.only!, of member
			constant-symbol member.name
	as to-symbol-from-enum
		auto-fun-match-enum range, return-type, params.only!, of x
			symbol-for-enum-member return-type, range, x

concretize-flags-function concrete-expr(cf concrete-fun, fn flags-function) concretize-ctx
	range = cf.range
	param0 concrete-expr mut() = of
		gen-param-get range, cf.params[0]
	param1 concrete-expr mut() = of
		gen-param-get range, cf.params[1]
	cast-param0 concrete-expr mut(storage nat-type) = of storage
		gen-cast-nat range, storage, param0[]
	cast-param1 concrete-expr mut(storage nat-type) = of storage
		gen-cast-nat range, storage, param1[]
	cast-to-flags concrete-expr mut(x concrete-expr) = of x
		gen-cast cf.return-type, range, x
	match fn
	as intersect
		storage = flags-storage cf.params[0].type
		res = gen-intersect-nat range, storage, cast-param0[storage], cast-param1[storage]
		cast-to-flags[res]
	as negate
		# ~x & all
		storage = flags-storage cf.params[0].type
		neg = gen-builtin storage.nat-type, range, bitwise-not, (), (cast-param0[storage],)
		all = get-all-flags-expr range, cf.return-type
		intersect = gen-intersect-nat range, storage, neg, all
		cast-to-flags[intersect]
	as none
		storage = flags-storage cf.return-type
		res = gen-constant-zero storage.nat-type, range
		cast-to-flags[res]
	as subscript
		storage = flags-storage cf.params[0].type
		gen-flags-subscript range, storage, cast-param0[storage], cast-param1[storage]
	as union_
		storage = flags-storage cf.params[0].type
		res = gen-builtin storage.nat-type, range, bitwise-or, (),
			- cast-param0[storage]
			- cast-param1[storage]
		cast-to-flags[res]

-get-all-flags-expr concrete-expr(range uri-and-range, flags-type concrete-type) concretize-ctx
	type = flags-type.flags-storage.nat-type
	gen-constant-nat type, range, flags-type.must-be-flags.get-all-flags-value

# WARN: p1 is used twice, so it should be a param get (or other expression that has no side effect)
-gen-flags-subscript concrete-expr
	range uri-and-range
	storage nat-type
	p0 concrete-expr
	p1 concrete-expr
do concretize-ctx
	p0.type is p1.type
	# (p0 & p1) == p1
	intersect = gen-intersect-nat range, storage, p0, p1
	gen-equal-integral range, intersect, p1

-must-be-nat-type nat-type(a concrete-type)
	a.body.concrete-builtin-type!.kind.to!

-enum-or-flags-storage nat-type(a concrete-type)
	match body = a.body
	as concrete-enum
		body.storage
	as concrete-flags
		body.storage
	else
		throw unreachable
-enum-storage nat-type(a concrete-type)
	a.body.concrete-enum!.storage
-flags-storage nat-type(a concrete-type)
	a.body.concrete-flags!.storage

-enum-or-flags-members enum-or-flags-member[](type concrete-type)
	match x = type.source.concrete-type-source-inst!.decl.body
	as enum_ then x.members
	as flags_ then x.members
	else then throw unreachable

-concretize-equal-enum-or-flags concrete-expr
	range uri-and-range
	storage nat-type
	arg0 concrete-expr
	arg1 concrete-expr
do concretize-ctx
	arg0-cast = gen-cast-nat range, storage, arg0
	arg1-cast = gen-cast-nat range, storage, arg1
	gen-equal-integral range, arg0-cast, arg1-cast

-gen-compare-integral concrete-expr
	comparison-type concrete-type
	range uri-and-range
	arg0 concrete-expr
	arg1 concrete-expr
do
	gen-builtin comparison-type, range, compare::builtin-binary, (), (arg0, arg1)

-gen-cast-nat concrete-expr(range uri-and-range, type nat-type, arg concrete-expr) concretize-ctx
	gen-cast type.nat-type, range, arg
-gen-cast concrete-expr(type concrete-type, range uri-and-range, arg concrete-expr)
	type, range, arg.cast-concrete-expr

-concretize-flags-to-array concrete-expr
	range uri-and-range
	array-type concrete-type
	param concrete-local
	f constant mut(x enum-or-flags-member)
do concretize-ctx, quick-fill-in-concrete-fun-body
	# (if a & x == 0 then () else ("x",)) ~~ (if a & y == 0 then () else ("y",))
	members = param.type.must-be-flags.members
	storage = param.type.flags-storage
	storage-type = nat-type storage
	value = gen-cast-nat range, storage, gen-param-get range, param
	empty-array = gen-constant array-type, range, get-constant-array all-constants, array-type, ()
	do unless is-empty members else empty-array
	array-for-member concrete-expr mut(member enum-or-flags-member) = of member
		# if value & x == 0 then () else ("x",)
		member-value concrete-expr = storage-type, range, member.value.to
		intersect = gen-intersect-nat range, storage, value, member-value
		zero = gen-constant-zero storage-type, range
		test_ = gen-equal-integral range, intersect, zero
		array = gen-constant array-type, range, get-constant-array all-constants, array-type, (f[member],)
		gen-if range, test_, empty-array, array
	res mut = array-for-member[members[0]]
	for member in members[1 .. end]
		res := gen-concat-array range, res, array-for-member[member]
	res

-auto-fun-match-enum concrete-expr(range uri-and-range, return-type concrete-type, param concrete-local, f concrete-expr mut(x enum-or-flags-member))
	gen-match-scalar return-type, range, (gen-param-get range, param), f

-concretize-integral-to-opt-enum-or-flags concrete-expr
	range uri-and-range
	return-type concrete-type
	param concrete-local
do concretize-ctx
	if is-flags unwrap-option-type! return-type
		concretize-nat-to-opt-flags range, return-type, param
	else
		# TODO: generate a match-integral-concrete-expr! ------------------------------------------------------------------------------------------
		concretize-nat-to-opt-enum range, return-type, param, of param-get, member
			gen-equal-integral range, param-get,
				member.storage.nat-type, range, member.value.to

-concretize-nat-to-opt-flags concrete-expr(range uri-and-range, option-type concrete-type, param concrete-local) concretize-ctx
	# if a in all then (a.cast,) else ()
	flags-type = unwrap-option-type! option-type
	storage = flags-storage flags-type
	param-get = gen-widen-nat storage, gen-param-get range, param
	all = get-all-flags-expr range, flags-type
	a-in-all = gen-flags-subscript range, storage, all, param-get
	cast = gen-cast flags-type, range, param-get
	some = gen-option option-type, range, cast
	none = gen-empty-option option-type, range
	gen-if range, a-in-all, some, none

-gen-widen-nat concrete-expr(type nat-type, arg concrete-expr) concretize-ctx
	out-type = nat-type type
	if out-type == arg.type
		arg
	else
		gen-builtin out-type, arg.range, wrap-convert-integral, (), (arg,)

-concretize-symbol-to-opt-enum-or-flags concrete-expr(range uri-and-range, option-type concrete-type, param concrete-local) concretize-ctx
	enum-type = unwrap-option-type! option-type
	param-get = gen-param-get range, param
	symbol-type = param-get.type
	cases concrete-match-string-like-case[] = for member in must-be-enum-or-flags enum-type
		- gen-constant symbol-type, range, constant-symbol member.name
		- gen-constant-some option-type, range, member.value.to
	else_ = gen-empty-option option-type, range
	option-type, range, match-string-like-concrete-expr param-get, equal-symbol-function, cases, else_

-concretize-nat-to-opt-enum concrete-expr
	range uri-and-range
	option-type concrete-type
	param concrete-local
	# TODO: we should generate a match on integrals or symbols, since we have expressions for those! ----------
	f-test concrete-expr mut(param-get concrete-expr, member enum-or-flags-member)
do concretize-ctx
	# TODO: In the common case you can just check 'x <= max-enum-member' and cast it ----------------------------------------------------------------
	enum-type = unwrap-option-type! option-type
	storage = enum-storage enum-type
	param-get = gen-widen-nat storage, gen-param-get range, param
	res mut = gen-empty-option option-type, range
	for member enum-or-flags-member in reverse enum-type.must-be-enum-or-flags # TODO: should not need type annotation
		# if a == "foo" then (foo,) else res
		eq = f-test[param-get, member]
		some-enum-value = gen-constant-some option-type, range, member.value.to
		res := gen-if range, eq, some-enum-value, res
	res

-symbol-for-enum-member concrete-expr # TODO: INLINE ----------------------------------------------------------------------------
	symbol-type concrete-type
	range uri-and-range
	member enum-or-flags-member
do concretize-ctx
	gen-constant symbol-type, range, constant-symbol member.name

-same-type concrete-type(params concrete-local[]) # TODO: rename to 'assert-same-type' ----------------------------------------
	assert all-same params, it.type
	params[0].type

-enum-flags-record-or-union union(enum_, flags_, concrete-record, concrete-union)
-enum-flags-record-or-union enum-flags-record-or-union(a concrete-type)
	match x = a.body
	as concrete-builtin-type
		throw unreachable
	as concrete-enum
		a.source.concrete-type-source-inst!.decl.body.enum_!
	as struct-body-extern-java
		throw unreachable
	as concrete-flags
		a.source.concrete-type-source-inst!.decl.body.flags_!
	as concrete-record
		x
	as concrete-union
		x
	as concrete-type-body-deferred
		throw unreachable

-concretize-compare-record concrete-expr
	range uri-and-range
	comparison concrete-type
	params (concrete-local, concrete-local)
	fields concrete-field[]
	field-compares called[]
do concretize-and-expr-ctx, quick-fill-in-concrete-fun-body
	equal-or-compare-record range, params, fields, field-compares, (of then gen-comparison-equal comparison, range), of x, y
		gen-compare-or range, x, y

-equal-or-compare-record concrete-expr
	range uri-and-range
	param0 concrete-local, param1 concrete-local
	fields concrete-field[]
	field-called called[]
	# TODO: instead of taking a callback, we could just rely on the caller to do it ........................................
	f-no-fields concrete-expr mut()
	f-fold concrete-expr mut(x concrete-expr, y concrete-expr)
do concretize-and-expr-ctx, quick-fill-in-concrete-fun-body
	fields.size is field-called.size
	do unless is-empty fields else f-no-fields[]
	p0 = gen-local-get range, param0
	p1 = gen-local-get range, param1
	compare-field concrete-expr mut(index nat) = of index
		field-type = fields[index].type
		f0 = gen-record-field-get field-type, range, p0, index
		f1 = gen-record-field-get field-type, range, p1, index
		concretize-and-call field-called[index], range, (f0, f1)
	res mut = compare-field[0]
	for i in 1::nat .. fields.size
		res := f-fold[res, compare-field[i]]
	res

-concretize-compare-union concrete-expr
	range uri-and-range
	comparison concrete-type
	param0 concrete-local, param1 concrete-local
	members concrete-type[]
	member-compares called[]
do concretize-and-expr-ctx, quick-fill-in-concrete-fun-body
	do unless is-empty members else gen-comparison-equal comparison, range
	p0 = gen-param-get range, param0
	p1 = gen-param-get range, param1
	less = gen-comparison-less comparison, range
	greater = gen-comparison-greater comparison, range
	###
	Generate code like:
	match param0
	as case0
		match param1
		as case0
			param0 <=> param1
		else
			less
	as case1
		match param1
		as case0
			greater
		as case1
			param0 <=> param1
		else
			less
	...
	###
	if members.size <= 4
		gen-match-union comparison, range, members, p0, of member-index, get-member
			same-case = gen-compare-same-case range, member-compares[member-index], get-member, p1
			# To keep the number of cases down, use 'default' for the bigger half
			more-cases-are-greater = member-index < members.size / 2
			member-indices = if more-cases-are-greater then 0 .. member-index + 1 else member-index .. members.size
			cases concrete-expr[] = for i in member-indices
				if i == member-index
					same-case
				else
					if more-cases-are-greater then greater else less
			default concrete-expr? = unless cases.size == members.size
				if more-cases-are-greater then less else greater
			comparison, range, match-union-concrete-expr p1, member-indices.to, cases, default
	else
		nat = nat64-type
		b-case-index concrete-local = union-kind::concrete-generated-local-kind, nat
		get-b-case-index = gen-local-get range, b-case-index
		init-b-case-index concrete-expr =
			cases concrete-expr[] = for member-index in 0 .. members.size
				gen-constant-nat nat, range, member-index
			nat, range, match-union-concrete-expr p1, (0 .. members.size).to, cases, ()
		match_ concrete-expr = gen-match-union comparison, range, members, p0, of member-index, get-member
			###
			match p1
			as foo
				p0 <=> p1
			else
				42 <=> b-kind
			###
			cases concrete-expr[] =
				- gen-compare-same-case range, member-compares[member-index], get-member, p1
			a-case-index = gen-constant-nat nat, range, member-index
			default = gen-compare-integral comparison, range, a-case-index, get-b-case-index
			comparison, range,
				match-union-concrete-expr p1, member-index.to::indices, cases, default
		gen-let comparison, range, b-case-index, init-b-case-index, match_

-gen-compare-same-case concrete-expr
	range uri-and-range
	compare called
	p0-as-case concrete-expr
	p1 concrete-expr
do concretize-and-expr-ctx, quick-fill-in-concrete-fun-body
	concretize-and-call compare, range,
		- p0-as-case
		- gen-union-assume-case p0-as-case.type, range, p1

-concretize-equal-record concrete-expr
	range uri-and-range
	params (concrete-local, concrete-local)
	fields concrete-field[]
	field-equals called[]
do concretize-and-expr-ctx, quick-fill-in-concrete-fun-body
	equal-or-compare-record range, params, fields, field-equals, (of then gen-true range), of x, y
		gen-and range, x, y

-concretize-equal-union concrete-expr
	range uri-and-range
	bool-type concrete-type
	param0 concrete-local, param1 concrete-local
	members concrete-type[]
	member-equals called[]
do concretize-and-expr-ctx, quick-fill-in-concrete-fun-body
	do unless is-empty members else gen-true range
	p0 = gen-param-get range, param0
	p1 = gen-param-get range, param1
	gen-match-union bool-type, range, members, p0, of member-index, get-member
		cases concrete-expr[] =
			- concretize-and-call member-equals[member-index], range,
				- get-member
				- gen-union-assume-case get-member.type, range, p1
		default = gen-false range
		bool-type, range, match-union-concrete-expr p1, member-index.to, cases, default

-concretize-record-to-json concrete-expr
	range uri-and-range
	param concrete-local
	fields concrete-field[]
	field-to-json called[]
do concretize-and-expr-ctx, quick-fill-in-concrete-fun-body
	get-param = gen-param-get range, param
	record-fields = get-param.type.struct-body.record_!.fields
	names symbol[] = map record-fields, it.name
	values concrete-expr[] = for index, (field, called) in with-index zip fields, field-to-json
		concretize-and-call called, range,
			- gen-record-field-get field.type, range, get-param, index
	gen-new-json-object range, names, values

-gen-new-json-object concrete-expr(range uri-and-range, names symbol[], values concrete-expr[]) concretize-ctx
	names.size is values.size
	symbol-array, json-array = only2! json-named-new-function.params
	gen-call range, json-named-new-function,
		- gen-constant-array all-constants, symbol-array.type, range, for name in names
			constant-symbol name
		- gen-create-array json-array.type, range, values

-gen-constant-array concrete-expr(constants all-constants-builder, array-type concrete-type, range uri-and-range, elements constant[])
	array-type, range, get-constant-array constants, array-type, elements

-concretize-union-to-json concrete-expr
	range uri-and-range
	param concrete-local
	member-types concrete-type[]
	member-to-json called[]
do concretize-and-expr-ctx, quick-fill-in-concrete-fun-body
	members = as-union param.type.struct-body
	member-types.size is members.size
	member-to-json.size is members.size
	get-param = gen-param-get range, param
	gen-match-union json-type, range, member-types, get-param, of member-index, get-member
		name = members[member-index].member.decl.name
		value = concretize-and-call member-to-json[member-index], range, (get-member,)
		gen-new-json-object range, (name,), (value,)

-struct-body struct-body(a concrete-type)
	a.source.concrete-type-source-inst!.decl.body

-concretize-and-call concrete-expr
	called called
	range uri-and-range
	args concrete-expr[]
do concretize-and-expr-ctx, quick-fill-in-concrete-fun-body
	if fun = get-concrete-fun-from-called called
		gen-call range, fun, args
	else
		gen-bogus called.return-type.get-concrete-type, range

-gen-comparison-less concrete-expr(comparison-type concrete-type, range uri-and-range)
	gen-constant-nat comparison-type, range, 0
-gen-comparison-equal concrete-expr(comparison-type concrete-type, range uri-and-range)
	gen-constant-nat comparison-type, range, 1
-gen-comparison-greater concrete-expr(comparison-type concrete-type, range uri-and-range)
	gen-constant-nat comparison-type, range, 2

-gen-compare-or concrete-expr(range uri-and-range, a concrete-expr, b concrete-expr)
	gen-match-scalar a.type, range, a, of x
		if x.value == 1
			b
		else
			gen-constant a.type, range, x.value.to
