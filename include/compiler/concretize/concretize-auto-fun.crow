import
	../model/concrete-model
	../model/integral-values
	../model/model
	../model/source-range
	../util/util
	./all-constants-builder
	./concretize-ctx
	./concretize-expr-ctx
	./generate

concretize-auto-fun concrete-expr(concretize-ctx concretize-ctx, fun concrete-fun, a auto-fun) quick-fill-in-concrete-fun-body
	ctx concretize-expr-ctx = concretize-ctx, fun
	return-type = fun return-type
	params = fun params
	param0 concrete-expr mut() = of
		fun.range gen-param-get params[0]
	param1 concrete-expr mut() = of
		fun.range gen-param-get params[1]
	range = fun range
	match a kind
	as compare
		compare-integral concrete-expr mut(storage_ integral-type) = of storage_
			p0 = ctx.concretize-ctx gen-cast-integral range, storage_, param0[]
			p1 = ctx.concretize-ctx gen-cast-integral range, storage_, param1[]
			ctx.concretize-ctx gen-compare-integral return-type, range, p0, p1
		match params.same-type enum-flags-record-or-union
		as enum_ x
			compare-integral[x.storage_]
		as flags_ x
			compare-integral[x.storage_]
		as concrete-record x
			ctx concretize-compare-record range, return-type, params.only2, x.fields, a.members
		as concrete-union x
			ctx concretize-compare-union range, return-type, params.only2, x.members, a.members
	as enum-or-flags-members
		elements constant[] = for member in return-type.array-element-type enum-or-flags-members
			member value
		ctx.all-constants gen-constant-array return-type, range, elements
	as enum-or-flags-to-integral
		return-type gen-cast range, param0[]
	as enum-to-symbol
		range auto-fun-match-enum return-type, params.only, of x
			ctx.concretize-ctx symbol-for-enum-member return-type, range, x
	as equals
		match params.same-type enum-flags-record-or-union
		as enum_ x
			ctx.concretize-ctx concretize-equal-enum-or-flags range, x.storage_, param0[], param1[]
		as flags_ x
			ctx.concretize-ctx concretize-equal-enum-or-flags range, x.storage_, param0[], param1[]
		as concrete-record x
			ctx concretize-equal-record range, params.only2, x.fields, a.members
		as concrete-union x
			ctx concretize-equal-union range, return-type, params.only2, x.members, a.members
	as flags-to-symbol-array
		ctx concretize-flags-to-array range, return-type, params.only, of member
			ctx.concretize-ctx constant-symbol member.name
	as integral-to-opt-enum-or-flags
		ctx concretize-integral-to-opt-enum-or-flags range, return-type, params.only
	as symbol-to-opt-enum-or-flags
		ctx concretize-symbol-to-opt-enum-or-flags range, return-type, params.only
	as to-json
		param = params only
		match param.type enum-flags-record-or-union
		as enum_ _
			range auto-fun-match-enum return-type, param, of x
				return-type gen-constant range,
					ctx.concretize-ctx constant-json-string return-type, x.name
		as flags_ _
			to = ctx.concretize-ctx to-json-from-json-array-function
			json-array-type = to.params.only type
			range gen-call to,
				- ctx concretize-flags-to-array range, json-array-type, param, of member
					ctx.concretize-ctx constant-json-string return-type, member.name
		as concrete-record x
			ctx concretize-record-to-json range, param, x.fields, a.members
		as concrete-union x
			ctx concretize-union-to-json range, param, x.members, a.members

concretize-flags-function concrete-expr(ctx concretize-ctx, cf concrete-fun, fn flags-function)
	range = cf range
	param0 concrete-expr mut() = of
		range gen-param-get cf.params[0]
	param1 concrete-expr mut() = of
		range gen-param-get cf.params[1]
	cast-param0 concrete-expr mut(storage_ integral-type) = of storage_
		ctx gen-cast-integral range, storage_, param0[]
	cast-param1 concrete-expr mut(storage_ integral-type) = of storage_
		ctx gen-cast-integral range, storage_, param1[]
	cast-to-flags concrete-expr mut(x concrete-expr) = of x
		cf.return-type gen-cast range, x
	match fn
	as in_
		# (x & y) == x
		storage_ = cf.params[0].type integral-type-from-flags-type
		ctx gen-flags-in range, storage_, cast-param0[storage_], cast-param1[storage_]
	as intersect
		storage_ = cf.params[0].type integral-type-from-flags-type
		res = ctx gen-intersect-integral range, storage_, cast-param0[storage_], cast-param1[storage_]
		cast-to-flags[res]
	as negate
		# ~x & all
		storage_ = cf.params[0].type integral-type-from-flags-type
		storage-type = ctx integral-type storage_
		neg = storage-type gen-builtin range, bitwise-not, (), (cast-param0[storage_],)
		all = ctx get-all-flags-expr range, cf.return-type
		intersect = ctx gen-intersect-integral range, storage_, neg, all
		cast-to-flags[intersect]
	as none
		storage_ = cf.return-type integral-type-from-flags-type
		res = (ctx integral-type storage_) gen-constant-integral range, (0::nat,)
		cast-to-flags[res]
	as union_
		storage_ = cf.params[0].type integral-type-from-flags-type
		storage-type = ctx integral-type storage_
		res = storage-type gen-builtin range, bitwise-or, (), (cast-param0[storage_], cast-param1[storage_])
		cast-to-flags[res]

-get-all-flags-expr concrete-expr(ctx concretize-ctx, range uri-and-range, flags-type concrete-type)
	storage_ = ctx integral-type flags-type.integral-type-from-flags-type
	storage_ gen-constant-integral range, flags-type.must-be-flags.get-all-flags-value

# WARN: p0 is used twice, so it should be a param get (or other expression that has no side effect)
-gen-flags-in concrete-expr
	ctx concretize-ctx
	range uri-and-range
	storage_ integral-type
	p0 concrete-expr
	p1 concrete-expr
do
	assert p0.type == p1.type
	intersect = ctx gen-intersect-integral range, storage_, p0, p1
	ctx gen-equal-integral range, intersect, p0

-integral-type-from-flags-type integral-type(a concrete-type)
	a.body.concrete-flags! storage_

-enum-or-flags-members enum-or-flags-member[](type concrete-type)
	match type.source.concrete-type-source-inst!.decl body	
	as enum_ x
		x members
	as flags_ x
		x members
	else
		throw unreachable

-concretize-equal-enum-or-flags concrete-expr
	ctx concretize-ctx
	range uri-and-range
	storage_ integral-type
	arg0 concrete-expr
	arg1 concrete-expr
do
	arg0-cast = ctx gen-cast-integral range, storage_, arg0
	arg1-cast = ctx gen-cast-integral range, storage_, arg1
	ctx gen-equal-integral range, arg0-cast, arg1-cast

-gen-compare-integral concrete-expr
	ctx concretize-ctx
	comparison-type concrete-type
	range uri-and-range
	arg0 concrete-expr
	arg1 concrete-expr
do
	# if a < b then less else if b < a then greater else equal
	less = comparison-type gen-comparison-less range
	equal = comparison-type gen-comparison-equal range
	greater = comparison-type gen-comparison-greater range
	is-less = ctx gen-less-integral range, arg0, arg1
	is-greater = ctx gen-less-integral range, arg1, arg0
	range gen-if is-less, less, (range gen-if is-greater, greater, equal)

-gen-cast-integral concrete-expr
	ctx concretize-ctx
	range uri-and-range
	type integral-type
	arg concrete-expr
do
	ctx integral-type type gen-cast range, arg
-gen-cast concrete-expr(type concrete-type, range uri-and-range, arg concrete-expr)
	type, range, arg.cast-concrete-expr

-constant-json-string constant(ctx concretize-ctx, json-type concrete-type, value symbol)
	json-inner = json-type.body.concrete-record!.fields.only.type
	members = json-inner.body.concrete-union! members
	member-index nat = 3
	string = ctx string-type
	assert members[member-index] == string
	str = ctx.all-constants get-constant-string string, value.to
	inner = ctx.all-constants get-constant-union json-inner, member-index, str
	ctx.all-constants get-constant-record json-type, (inner,)

-concretize-flags-to-array concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	array-type concrete-type
	param concrete-local
	f constant mut(x enum-or-flags-member)
do quick-fill-in-concrete-fun-body
	# (if a & x == 0 then () else ("x",)) ~~ (if a & y == 0 then () else ("y",))
	members = param.type.must-be-flags members
	storage_ = param.type integral-type-from-flags-type
	storage-type = ctx.concretize-ctx integral-type storage_
	value = ctx.concretize-ctx gen-cast-integral range, storage_, do range gen-param-get param
	empty-array = array-type gen-constant range, do ctx.all-constants get-constant-array array-type, ()
	guard members !is-empty else empty-array
	array-for-member concrete-expr mut(member enum-or-flags-member) = of member
		# if value & x == 0 then () else ("x",)
		member-value = storage-type gen-constant-integral range, member.value
		intersect = ctx.concretize-ctx gen-intersect-integral range, storage_, value, member-value
		zero = storage-type gen-constant-integral range, (0::nat,)
		test_ = ctx.concretize-ctx gen-equal-integral range, intersect, zero
		array = array-type gen-constant range, do ctx.all-constants get-constant-array array-type, do f[member],
		range gen-if test_, empty-array, array
	res mut = array-for-member[members[0]]
	for member in members[1 .. end]
		res := ctx.concretize-ctx gen-concat-array range, res, array-for-member[member]
	res

-auto-fun-match-enum concrete-expr(range uri-and-range, return-type concrete-type, param concrete-local, f concrete-expr mut(x enum-or-flags-member))
	return-type gen-match-enum-or-integral range, (range gen-param-get param), f

-concretize-integral-to-opt-enum-or-flags concrete-expr(ctx concretize-expr-ctx, range uri-and-range, return-type concrete-type, param concrete-local)
	if return-type.unwrap-option-type! is-flags
		ctx concretize-integral-to-opt-flags range, return-type, param
	else
		# TODO: generate a match-integral-concrete-expr! ------------------------------------------------------------------------------------------
		ctx concretize-convert-to-opt-enum-or-flags range, return-type, param, of param-get, member
			value = ctx.concretize-ctx integral-for-enum-member range, member
			ctx.concretize-ctx gen-equal-integral range, param-get, value

-concretize-integral-to-opt-flags concrete-expr(ctx concretize-expr-ctx, range uri-and-range, option-type concrete-type, param concrete-local)
	# if a in all then (a.cast,) else ()
	flags-type = option-type unwrap-option-type!
	storage_ = flags-type integral-type-from-flags-type
	param-get = range gen-param-get param
	all = (ctx.concretize-ctx get-all-flags-expr range, flags-type)
	a-in-all = ctx.concretize-ctx gen-flags-in range, storage_, param-get, all
	cast = flags-type gen-cast range, param-get
	some = ctx.concretize-ctx gen-option option-type, range, cast
	none = ctx.concretize-ctx gen-empty-option option-type, range
	range gen-if a-in-all, some, none

-concretize-symbol-to-opt-enum-or-flags concrete-expr(ctx concretize-expr-ctx, range uri-and-range, option-type concrete-type, param concrete-local)
	enum-type = option-type unwrap-option-type!
	param-get = range gen-param-get param
	symbol-type = param-get type
	equals = ctx.concretize-ctx equal-symbol-function
	cases concrete-match-string-like-case[] = for member in enum-type must-be-enum-or-flags
		- symbol-type gen-constant range,
			ctx.concretize-ctx constant-symbol member.name
		- ctx.concretize-ctx gen-constant-some option-type, range, member.value
	else_ = ctx.concretize-ctx gen-empty-option option-type, range
	option-type, range, do param-get match-string-like-concrete-expr equals, cases, ((), else_)

-concretize-convert-to-opt-enum-or-flags concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	option-type concrete-type
	param concrete-local
	# TODO: we should generate a match on integrals or symbols, since we have expressions for those! ----------
	f-test concrete-expr mut(param-get concrete-expr, member enum-or-flags-member)
do
	enum-type = option-type unwrap-option-type!
	param-get = range gen-param-get param
	res mut = ctx.concretize-ctx gen-empty-option option-type, range
	for member in enum-type.must-be-enum-or-flags reverse
		# if a == "foo" then (foo,) else res
		eq = f-test[param-get, member]
		some-enum-value = ctx.concretize-ctx gen-constant-some option-type, range, member.value
		res := range gen-if eq, some-enum-value, res
	res

-integral-for-enum-member concrete-expr
	ctx concretize-ctx
	range uri-and-range
	member enum-or-flags-member
do
	ctx integral-type member.storage_ gen-constant-integral range, member.value

-symbol-for-enum-member concrete-expr # TODO: INLINE ----------------------------------------------------------------------------
	ctx concretize-ctx
	symbol-type concrete-type
	range uri-and-range
	member enum-or-flags-member
do
	symbol-type gen-constant range, do ctx constant-symbol member.name

-same-type concrete-type(params concrete-local[]) # TODO: rename to 'assert-same-type' ----------------------------------------
	assert params all-same it.type
	params[0] type

-enum-flags-record-or-union union(enum_, flags_, concrete-record, concrete-union)
-enum-flags-record-or-union enum-flags-record-or-union(a concrete-type)
	match a body
	as concrete-builtin-type _
		throw unreachable
	as concrete-enum _
		a.source.concrete-type-source-inst!.decl.body enum_!
	as struct-body-extern-java _
		throw unreachable
	as concrete-flags _
		a.source.concrete-type-source-inst!.decl.body flags_!
	as concrete-record x
		x
	as concrete-union x
		x
	as concrete-type-body-deferred
		throw unreachable

-concretize-compare-record concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	comparison concrete-type
	params (concrete-local, concrete-local)
	fields concrete-field[]
	field-compares called[]
do quick-fill-in-concrete-fun-body
	ctx equal-or-compare-record range, params, fields, field-compares, (of then comparison gen-comparison-equal range), of x, y
		range gen-compare-or x, y

-equal-or-compare-record concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	param0 concrete-local, param1 concrete-local
	fields concrete-field[]
	field-called called[]
	# TODO: instead of taking a callback, we could just rely on the caller to do it ........................................
	f-no-fields concrete-expr mut()
	f-fold concrete-expr mut(x concrete-expr, y concrete-expr)
do quick-fill-in-concrete-fun-body
	fields.size is field-called.size
	guard fields !is-empty else f-no-fields[]
	p0 = range gen-local-get param0
	p1 = range gen-local-get param1
	compare-field concrete-expr mut(index nat) = of index
		field-type = fields[index] type
		f0 = ctx.concretize-ctx gen-record-field-get field-type, range, p0, index
		f1 = ctx.concretize-ctx gen-record-field-get field-type, range, p1, index
		ctx concretize-and-call field-called[index], range, (f0, f1)
	res mut = compare-field[0]
	for i in 1::nat .. fields.size
		res := f-fold[res, compare-field[i]]
	res

-concretize-compare-union concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	comparison concrete-type
	param0 concrete-local, param1 concrete-local
	members concrete-type[]
	member-compares called[]
do quick-fill-in-concrete-fun-body
	guard members !is-empty else comparison gen-comparison-equal range
	p0 = range gen-param-get param0
	p1 = range gen-param-get param1
	less = comparison gen-comparison-less range
	greater = comparison gen-comparison-greater range
	###
	Generate code like:
	match param0
	as case0 xa
		match param1
		as case0 xb
			xa <=> xb
		else
			less
	as case1 xa
		match param1
		as case0 _
			greater
		as case1 xb
			xa <=> xb
		else
			less
	...
	###
	if members.size <= 4
		comparison gen-match-union range, members, p0, of member-index, get-member
			same-case = ctx gen-compare-same-case range, members, member-compares, member-index, get-member
			# To keep the number of cases down, use 'default' for the bigger half
			more-cases-are-greater = member-index < members.size / 2
			member-indices = if more-cases-are-greater then 0 .. member-index + 1 else member-index .. members.size
			cases concrete-local-and-expr[] = for i in member-indices
				if i == member-index
					same-case
				else
					- ()
					- if more-cases-are-greater then greater else less
			default concrete-local-and-expr? = unless cases.size == members.size
				(), if more-cases-are-greater then less else greater
			comparison, range, do p1 match-union-concrete-expr member-indices.to, cases, default
	else
		nat = ctx.concretize-ctx nat64-type
		b-case-index concrete-local = union-kind::concrete-generated-local-kind, nat
		get-b-case-index = range gen-local-get b-case-index
		init-b-case-index concrete-expr =
			cases concrete-local-and-expr[] = for member-index in 0 .. members.size
				(), do nat, range, (member-index,)::integral-value
			nat, range, do p1 match-union-concrete-expr (0 .. members.size).to, cases, ()
		match_ concrete-expr = comparison gen-match-union range, members, p0, of member-index, get-member
			same-case = ctx gen-compare-same-case range, members, member-compares, member-index, get-member
			###
			match p1
			as foo xb
				xa <=> xb
			else
				if 42 < b-kind then less else greater
			###
			cases concrete-local-and-expr[] = same-case,
			a-case-index concrete-expr = nat, range, (member-index,)::integral-value
			a-kind-less = ctx.concretize-ctx gen-less-integral range, a-case-index, get-b-case-index
			default = range gen-if a-kind-less, less, greater
			comparison, range, do p1 match-union-concrete-expr member-index.to, cases, ((), default)
		comparison gen-let range, b-case-index, init-b-case-index, match_

-gen-compare-same-case concrete-local-and-expr
	ctx concretize-expr-ctx
	range uri-and-range
	members concrete-type[]
	member-compares called[]
	member-index nat
	get-member concrete-expr
do quick-fill-in-concrete-fun-body
	local concrete-local = member2::concrete-generated-local-kind, members[member-index]
	local, do ctx concretize-and-call member-compares[member-index], range,
		- get-member
		- range gen-local-get local

-concretize-equal-record concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	params (concrete-local, concrete-local)
	fields concrete-field[]
	field-equals called[]
do quick-fill-in-concrete-fun-body
	ctx equal-or-compare-record range, params, fields, field-equals, (of then ctx.concretize-ctx gen-true range), of x, y
		ctx.concretize-ctx gen-and range, x, y

-concretize-equal-union concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	bool-type concrete-type
	param0 concrete-local, param1 concrete-local
	members concrete-type[]
	member-equals called[]
do quick-fill-in-concrete-fun-body
	guard members !is-empty else ctx.concretize-ctx gen-true range
	p0 = range gen-param-get param0
	p1 = range gen-param-get param1
	bool-type gen-match-union range, members, p0, of member-index, get-member
		cases concrete-local-and-expr[] =
			local concrete-local = member2::concrete-generated-local-kind, members[member-index]
			- local, do ctx concretize-and-call member-equals[member-index], range,
				- get-member
				- range gen-local-get local
		default = ctx.concretize-ctx gen-false range
		bool-type, range, do p1 match-union-concrete-expr member-index.to, cases, ((), default)

-concretize-record-to-json concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	param concrete-local
	fields concrete-field[]
	field-to-json called[]
do quick-fill-in-concrete-fun-body
	get-param = range gen-param-get param
	record-fields = get-param.type.struct-body.record_! fields
	names symbol[] = record-fields map it.name
	values concrete-expr[] = for index, (field, called) in fields zip field-to-json with-index
		ctx concretize-and-call called, range,
			- ctx.concretize-ctx gen-record-field-get field.type, range, get-param, index
	ctx.concretize-ctx gen-new-json-object range, names, values

-gen-new-json-object concrete-expr(ctx concretize-ctx, range uri-and-range, names symbol[], values concrete-expr[])
	names.size is values.size
	named-new = ctx json-named-new-function
	symbol-array, json-array = named-new.params only2
	range gen-call named-new,
		- ctx.all-constants gen-constant-array symbol-array.type, range, for name in names
			ctx constant-symbol name
		- ctx gen-create-array json-array.type, range, values

-gen-constant-array concrete-expr(constants all-constants-builder, array-type concrete-type, range uri-and-range, elements constant[])
	array-type, range,
		constants get-constant-array array-type, elements

-concretize-union-to-json concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	param concrete-local
	member-types concrete-type[]
	member-to-json called[]
do quick-fill-in-concrete-fun-body
	members = param.type.struct-body as-union
	member-types.size is members.size
	member-to-json.size is members.size
	get-param = range gen-param-get param
	ctx.concretize-ctx.json-type gen-match-union range, member-types, get-param, of member-index, get-member
		name = members[member-index].member.decl name
		value = ctx concretize-and-call member-to-json[member-index], range, (get-member,)
		ctx.concretize-ctx gen-new-json-object range, (name,), (value,)

-struct-body struct-body(a concrete-type)
	a.source.concrete-type-source-inst!.decl body

-concretize-and-call concrete-expr
	ctx concretize-expr-ctx
	called called
	range uri-and-range
	args concrete-expr[]
do quick-fill-in-concrete-fun-body
	if fun ?= ctx get-concrete-fun-from-called called
		range gen-call fun, args
	else
		ctx.concretize-ctx gen-bogus (ctx get-concrete-type called.return-type), range

-gen-comparison-less concrete-expr(comparison-type concrete-type, range uri-and-range)
	comparison-type gen-constant range, 0.integral-value
-gen-comparison-equal concrete-expr(comparison-type concrete-type, range uri-and-range)
	comparison-type gen-constant range, 1.integral-value
-gen-comparison-greater concrete-expr(comparison-type concrete-type, range uri-and-range)
	comparison-type gen-constant range, 2.integral-value

-gen-compare-or concrete-expr(range uri-and-range, a concrete-expr, b concrete-expr)
	a.type gen-match-enum-or-integral range, a, of x
		if x.value.as-unsigned == 1
			b
		else
			a.type gen-constant range, x.value
