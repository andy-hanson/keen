import
	../../crow/col/sort: sort-by-first
	../frontend/show-model
	../model/concrete-model
	../model/model
	../model/show-concrete-model
	../model/source-range
	../util/util
	./all-constants-builder
	./concretize-auto-fun
	./concretize-ctx
	./concretize-expr-ctx
	./generate

fun-body-decl fun-body(fun concrete-fun)
	fun.source.concrete-fun-source-regular!.decl.body

# Fills in simple function bodies
quick-fill-in-concrete-fun-body void(ctx concretize-ctx, cf concrete-fun)
	assert cf.body.concrete-fun-body-deferred
	fun-body = cf.fun-body-decl
	return-type = cf.return-type
	range = cf.range
	concrete-params = cf.params
	cf.body := match x = fun-body
	as fun-body-bogus
		gen-bogus ctx, return-type, range
	as fun-body-extern-java
		x
	as auto-fun
		concretize-auto-fun ctx, cf, x
	as builtin-fun
		concretize-builtin-fun ctx, cf, x
	as create-enum-or-flags
		gen-constant return-type, range, x.member.value.to
	as create-record
		if is-empty concrete-params and !prevent-constant return-type.body.concrete-record!
			constant = get-constant-record ctx.all-constants, return-type, ()
			concrete-expr return-type, range, constant
		else
			gen-create-record ctx, return-type, range, for param in concrete-params
				gen-local-get range, param
	as expr
		concrete-fun-body-deferred
	as expr-with-allocated-locals
		concrete-fun-body-deferred
	as fun-body-file-import
		concretize-file-import ctx, cf, x
	as flags-function
		concretize-flags-function ctx, cf, x
	as fun-body-method
		if ctx.preserve-methods
			ensure ctx.sum-type-to-methods, cf.params[0].type ~= cf
			concrete-fun-body-method x.method-index
		else
			ctx.deferred-methods ~= cf
			concrete-fun-body-deferred
	as record-field-get
		record_ = gen-local-get range, only! concrete-params
		index = field-index-from-field record_.type, x.field
		gen-record-field-get ctx, return-type, range, record_, index
	as record-field-set
		param0, param1 = only2! concrete-params
		p0 = gen-local-get range, param0
		p1 = gen-local-get range, param1
		index = field-index-from-field p0.type, x.field
		gen-record-field-set ctx, range, p0, index, p1
	as sum-type-member-get
		case_ = sum-type-case-index ctx, concrete-params.only!.type, unwrap-option-type ctx, return-type
		gen-union-member-get ctx, cf, case_
	as var-get
		assert is-empty concrete-params
		expr = var-get-concrete-expr get-var ctx, x.var
		return-type, range, expr
	as var-set
		value = gen-local-get range, only! concrete-params
		return-type, range, var-set-concrete-expr (get-var ctx, x.var), value
	as fun-body-uninitialized
		throw unreachable

-concretize-builtin-fun concrete-fun-body(ctx concretize-ctx, cf concrete-fun, a builtin-fun)
	return-type = cf.return-type
	range = cf.range
	type-args concrete-type[] data() = of
		cf.source.concrete-fun-source-regular!.type-args
	match a
	as builtin-fun-constant
		gen-constant return-type, range, to-constant ctx, return-type, a
	as builtin-fun-is-empty-type
		constant constant = to::scalar-value is-empty-type only! type-args[]
		concrete-expr return-type, range, constant
	as builtin-fun-is-target
		gen-constant return-type, range, to::scalar-value a.target == ctx.target
	else
		concrete-fun-body-builtin a, type-args[]
-to-constant constant(ctx concretize-ctx, type concrete-type, a builtin-fun-constant)
	match a
	as bool
		a.to::scalar-value
	as float
		a.to::scalar-value
	as builtin-fun-constant-empty-option
		gen-constant-none ctx, type
	as builtin-fun-constant-gc-safe-value
		constant-gc-safe-value

-concretize-file-import concrete-expr(ctx concretize-ctx, cf concrete-fun, import_ fun-body-file-import)
	cf.return-type, cf.range, match import_.type
	as nat8-array
		constant-of-bytes ctx, cf.return-type, import_.content
	as string
		gen-string-literal-kind ctx, import_.content.as-string

get-var concrete-var(ctx concretize-ctx, decl var-decl)
	ensure ctx.concrete-var-lookup, decl, of
		type = get-concrete-type ctx, decl.type, ()
		expr-ctx concretize-expr-ctx =
			concretize-ctx: ctx
			cur-uri: decl.module-uri
			type-scope: ()
			specs-scope: ()
			allocated-locals: decl.initializer.allocated-locals
		decl, concretize-expr expr-ctx, type, decl.initializer.expr

concretize-fun-body concrete-fun-body(ctx concretize-ctx, cf concrete-fun, expr expr-maybe-allocated-locals)
	do unless is-array-op cf else concrete-fun-body-always-inline
	params = match x = cf.source
	as concrete-fun-source-regular
		x.decl.params
	as concrete-fun-source-test
		()
	as concrete-fun-source-wrap-main
		throw unreachable
	expr-ctx concretize-expr-ctx = ctx, cf, expr.allocated-locals
	type = cf.return-type
	for param, concrete-param in zip params, cf.params[0 .. params.size] # Ignore context params
		begin-param-destructure expr-ctx, param, concrete-param
	res mut = concretize-expr expr-ctx, type, expr.expr
	for param, concrete-param in zip params, cf.params[0 .. params.size]
		res := end-param-destructure expr-ctx, type, (to-uri-and-range expr-ctx, param.range), param, concrete-param, res
	res

-concretize-bogus concrete-expr(ctx concretize-expr-ctx, type concrete-type, range uri-and-range)
	gen-bogus ctx.concretize-ctx, type, range

-with-temp-if-necessary concrete-expr(range uri-and-range, value concrete-expr, f concrete-expr mut(get-temp concrete-expr))
	if get = value.kind.local-get-concrete-expr and !is-mutable get.local
		f[value]
	else
		temp concrete-local = member, value.type
		res = f[gen-local-get range, temp]
		gen-let res.type, range, temp, value, res

-concretize-call concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a call-expr
do
	do if concrete-called = get-concrete-fun-from-called ctx, a.called else
		concretize-bogus ctx, type, range
	if is-array-op concrete-called
		input-arg, lambda-arg = only2! a.args
		input = concretize-expr ctx, concrete-called.params[0].type, input-arg
		in-element-type = if is-range input.type then range-element-type input.type else array-element-type input.type
		out-element-type = if is-void type then type else array-element-type type
		empty-out-array constant-array? = unless is-void type
			constant-array! get-constant-array ctx.all-constants, type, ()
		match lambda-arg
		as lambda-expr
			forbid lambda-arg.mut-type-for-explicit-shared # This won't happen because 'for-loop' takes a 'mut' lambda
			rg uri-and-range = ctx.cur-uri, lambda-arg.range
			body = concretize-with-destructure ctx, out-element-type, rg, lambda-arg.param, of
				concretize-expr ctx, out-element-type, lambda-arg.body
			type, range, array-op-concrete-expr input, body.local, empty-out-array, body.expr
		else
			lambda-type = concrete-called.params[1].type
			lambda = concretize-expr ctx, lambda-type, lambda-arg
			with-temp-if-necessary range, lambda, of get-lambda
				in-element concrete-local = member, in-element-type # TODO: use a new kind, not 'member' ----------------------------
				body = builtin-concrete-expr builtin-fun-call-lambda, (out-element-type, in-element-type),
					- get-lambda
					- gen-local-get range, in-element
				type, range,
					array-op-concrete-expr input, in-element, empty-out-array, (out-element-type, range, body)
	else
		args concrete-expr[] =
			# Since 'list-new' is allowed to implement the 'new' spec, we need to support those here
			-- if a.args.size == 0 and is-list-new concrete-called
				array-type = concrete-called.params.only!.type
				empty-array = get-constant-array ctx.all-constants, array-type, ()
				- array-type, range, empty-array
			else
				for i in 0 .. a.args.size
					concretize-expr ctx, concrete-called.params[i].type, a.args[i]
			-- context-args ctx, range, a.called, concrete-called
		if is-not concrete-called and constant = args.only!.kind.constant
			concrete-called.return-type, range, (!constant.as-bool).to
		else
			# We need to widen again even though it was done already in 'concretize-expr',
			# because we may be calling a spec-impl that has a narrower type than the spec.
			# (The call expr's type can't reflect this and uses the spec's declared type.)
			concrete-called.return-type, range, if builtin_ = concrete-called.body.concrete-fun-body-builtin
				builtin-concrete-expr builtin_.kind, builtin_.type-args, args
			elif e = concrete-called.body.concrete-expr and constant = e.kind.constant
				constant
			else
				call-concrete-expr concrete-called, args

-is-list-new bool(a concrete-fun)
	a.name == "list-new" and a.params.size == 1 and is-array a.params.only!.type

-concretize-call-named-new concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a call-named-new-expr
do
	do if concrete-called = get-concrete-fun-from-called ctx, a.called else
		concretize-bogus ctx, type, range
	p0 = concrete-called.params[0]
	p1 = concrete-called.params[1]
	symbol-array-type = p0.type
	arg-array-type = p1.type
	symbols constant[] = for x in a.names
		constant-symbol ctx.concretize-ctx, x
	symbol-array concrete-expr = symbol-array-type, range, get-constant-array ctx.all-constants, symbol-array-type, symbols
	arg-type = get-concrete-type-for ctx, a.args[0]
	args concrete-expr[] = for arg in a.args
		concretize-expr ctx, arg-type, arg
	symbols.size is args.size
	args-array concrete-expr = arg-array-type, range, args.create-array-concrete-expr
	concrete-called.return-type, range,
		call-concrete-expr concrete-called,
			- symbol-array
			- args-array
			-- context-args ctx, range, a.called, concrete-called

-context-args concrete-expr[]
	ctx concretize-expr-ctx
	range uri-and-range
	called called
	concrete-called concrete-fun
do
	for p in last-n concrete-called.params, called.count-contexts
		get-the ctx, p.type, range

-count-contexts nat(a called)
	if a.fun-inst
		a.decl.contexts.size

-is-not bool(a concrete-fun) # RM ------------------------------------------------------------------------------------------------------
	a.body.concrete-fun-body-builtin.?kind.?builtin-unary == not

-is-array-op bool(a concrete-fun)
	# TODO: make sure this is the one in collection.crow and all the spec impls are as expected ------------------------
	do if a.name == "for-loop"
	do if is-void a.return-type or is-array-or-mut-array a.return-type
	do if a.params.size == 2
	input = a.params[0]
	do if is-range input.type or is-array-or-mut-array input.type
	do if as-lambda-type a.params[1].type
	true

-is-range bool(a concrete-type)
	do if inst = a.source.concrete-type-source-inst
	decl = inst.decl
	# TODO: base this on more than just the name ... uri too? -------------------------------------------------------------------
	decl.name == "range"

-concretize-call-option concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a call-option-expr
do
	# `a ?foo` ==> `if x = a then a foo else ()`
	# But `a foo` may already be an option and might not need to be wrapped
	do if called = get-concrete-fun-from-called ctx, a.called else concretize-bogus ctx, type, range
	local concrete-local = destruct::concrete-generated-local-kind, called.params[0].type
	option = concretize-expr ctx, a.first-arg
	call = gen-call range, called,
		- gen-local-get range, local
		-- for i, x in with-index a.rest-args
			concretize-expr ctx, called.params[i + 1].type, x
		-- context-args ctx, range, a.called, called
	wrapped = if call.type == type
		call
	else
		gen-option ctx.concretize-ctx, type, range, call
	assert wrapped.type == type
	gen-if-option range, option, (local, wrapped), if is-void type
		gen-void ctx.concretize-ctx, range
	else
		gen-empty-option ctx.concretize-ctx, type, range

-concretize-lambda concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	e lambda-expr
do
	return-type = get-concrete-type ctx, e.return-type
	do unless is-bogus return-type else concretize-bogus ctx, type, range
	param-type = get-concrete-type ctx, e.param.type
	body = concretize-expr-with-destructure ctx, return-type, range, e.param, e.body
	param = body.local else args::concrete-generated-local-kind, param-type
	closure concrete-local[] = for x in e.closure
		match x
		as local
			ctx.locals[x]!
		as struct-inst
			get-the-local ctx, get-concrete-type ctx, x
	need-wrap = !ctx.is-js and e.kind == explicit-shared
	lambda-type = if need-wrap
		get-concrete-type ctx, e.mut-type-for-explicit-shared!
	else
		type
	lambda concrete-expr = lambda-type, range, lambda-concrete-expr closure, param, body.expr
	# TODO: given that 'shared' just converts a mut lambda to shared,
	# it might make more sense to have it be a separate expression that wraps the lambda
	if need-wrap
		decl = ctx.concretize-ctx.program.common-funs.shared-of-mut-lambda
		fun = get-concrete-fun ctx.concretize-ctx, decl, (return-type, param-type), ()
		gen-call range, fun, (lambda,)
	else
		lambda

-concretize-let concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	e let-expr
do
	local-type = get-concrete-type ctx, e.destructure.type
	value = concretize-expr ctx, local-type, e.value
	concretize-with-destructure-and-let ctx, type, range, e.destructure, value, of
		concretize-expr-or-void ctx, type, range, e.then_

-concretize-list concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a list-expr
do
	do if called = get-concrete-fun-from-called ctx, a.called else concretize-bogus ctx, type, range
	array-type = get-concrete-type ctx, a.array-type
	called.return-type, range,
		call-concrete-expr called,
			- concretize-list-inner ctx, array-type, range, a.parts

-concretize-list-inner concrete-expr
	ctx concretize-expr-ctx
	array-type concrete-type
	range uri-and-range
	parts list-expr-part[]
do
	element = array-element-type array-type
	arrays concrete-expr mut[] = ()
	cur-list concrete-expr mut[] = ()
	finish-list void mut() = of
		arrays ~= array-type, range, cur-list.move-to.create-array-concrete-expr
	for part in parts
		match part
		as expr
			cur-list ~= concretize-expr ctx, element, part
		as list-expr-part-multi
			finish-list[]
			arrays ~= concretize-expr ctx, array-type, part.arg
	finish-list[]

	finished-arrays concrete-expr[] = arrays.move-to
	res mut = finished-arrays[0]
	for x in finished-arrays[1 .. end]
		res := gen-concat-array ctx.concretize-ctx, range, res, x
	res

-concretize-expr-with-destructure concrete-local-and-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	expr expr
do
	concretize-with-destructure ctx, type, range, destructure, of
		concretize-expr ctx, type, expr

-concretize-with-opt-local concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	local local?
	value expr
	f concrete-expr mut(matched concrete-expr)
do
	v = concretize-expr ctx, value
	if local
		concretize-with-destructure-and-let ctx, type, range, local, v, of
			f[gen-local-get range, ctx.locals[local]!]
	else
		f[v]
-concretize-with-destructure-and-let concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	value concrete-expr
	f concrete-expr mut()
do
	use-root-local ctx.concretize-ctx, value,
		concretize-with-destructure ctx, type, range, destructure, f
-use-root-local concrete-expr
	ctx concretize-ctx
	value concrete-expr
	then_ concrete-local-and-expr
do
	expr = then_.expr
	if root = then_.local
		gen-let expr.type, expr.range, root, value, expr
	elif value.kind.constant
		then_.expr
	else
		gen-drop-then ctx, expr.range, value, expr

-concretize-with-destructure concrete-local-and-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	f concrete-expr mut()
do
	begin-destructure ctx, destructure
	res = f[]
	end-destructure ctx, type, range, destructure, res

-begin-destructure void(ctx concretize-expr-ctx, a destructure)
	match a
	as destructure-ignore
		()
	as local
		root-local concrete-local = a, get-concrete-type ctx, a.type
		ctx.locals[a] := if reference-type = is-allocated ctx, a
			a.concrete-local-source-reference, reference-type
		else
			root-local
	as destructure-split
		if is-valid-destructure a, ctx.common-types
			for part in a.parts
				begin-destructure ctx, part
-begin-param-destructure void(ctx concretize-expr-ctx, a destructure, concrete-param concrete-local)
	match a
	as destructure-ignore
		()
	as local
		ctx.locals[a] := concrete-param
	as destructure-split
		begin-destructure ctx, a
-end-destructure concrete-local-and-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a destructure
	expr concrete-expr
do
	match a
	as destructure-ignore
		(), expr
	as local
		concrete-local = remove! ctx.locals, a
		if is-allocated ctx, a
			root-local concrete-local = a, get-concrete-type ctx, a.type
			value = gen-reference-create ctx.concretize-ctx, concrete-local.type, range,
				gen-local-get range, root-local
			- root-local
			- gen-let type, range, concrete-local, value, expr
		else
			concrete-local, expr
	as destructure-split
		if is-valid-destructure a, ctx.common-types
			root-local concrete-local = destruct, get-concrete-type ctx, a.type
			- root-local
			- end-destructure-split ctx, type, range, expr, a, root-local
		else
			- ()
			- concretize-bogus ctx, type, range
-end-param-destructure concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	root-local concrete-local
	expr concrete-expr
do
	match destructure
	as destructure-ignore
		expr
	as local
		forbid is-allocated ctx, destructure
		expr
	as destructure-split
		end-destructure-split ctx, type, range, expr, destructure, root-local
-end-destructure-split concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	expr concrete-expr
	x destructure-split
	root-local concrete-local
do
	# TODO: we should detect this earlier and make the entire expression fail
	do if is-valid-destructure x, ctx.common-types else concretize-bogus ctx, type, range
	get-root-local = gen-local-get range, root-local
	res mut = expr
	for part-index, part in with-index x.parts
		part-range = to-uri-and-range ctx, part.range
		value-type = root-local.type.body.concrete-record!.fields[part-index].type
		assert value-type == (get-concrete-type ctx, part.type)
		its-value = gen-record-field-get ctx.concretize-ctx, value-type, part-range, get-root-local, part-index
		its-local-and-expr = end-destructure ctx, type, part-range, part, res
		res := its-local-and-expr.expr
		if l = its-local-and-expr.local
			res := gen-let type, part-range, l, its-value, res
	res

-is-allocated concrete-type?(ctx concretize-expr-ctx, a local)
	ctx.allocated-locals[a]

-concretize-not concrete-expr(ctx concretize-expr-ctx, type concrete-type, range uri-and-range, a not-expr)
	assert is-bool type
	# Optimize so '!!x' doesn't actually do two negations
	model-arg expr, is-not-not bool = match x = a.arg
	as not-expr
		x.arg, true
	else
		x, false
	arg = concretize-expr ctx, model-arg
	if is-option arg.type
		expected-index nat = if is-not-not then 1 else 0
		type, range, if c = arg.kind.constant
			c.constant-union!.index == expected-index 'to
		else
			union-is-case-concrete-expr arg, expected-index
	else
		if c = arg.kind.constant
			value = c.as-bool == is-not-not
			gen-constant type, range, value.to
		elif is-not-not
			arg
		else
			gen-builtin type, range, not, (), (arg,)

-concretize-if concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a if-expr
do
	true-branch concrete-expr mut() = of then concretize-expr ctx, type, a.true-branch
	false-branch concrete-expr mut() = of then concretize-expr ctx, type, a.false-branch
	concretize-if ctx, type, (type a, ctx.available-types), range, a.condition, true-branch, false-branch

-concretize-if concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	model-type type
	range uri-and-range
	condition expr
	cb-true-branch concrete-expr mut()
	cb-false-branch concrete-expr mut()
do
	if is-option type condition, ctx.available-types
		option = concretize-expr ctx, condition
		gen-if-option range, option, ((), cb-true-branch[]), cb-false-branch[]
	elif unpack-option condition
		option = concretize-expr ctx, condition.option
		true-branch = concretize-with-destructure ctx, type, range, condition.destructure, cb-true-branch
		false-branch = cb-false-branch[]
		gen-if-option range, option, true-branch, false-branch
	elif !condition-has-locals condition
		cond = concretize-expr ctx, ctx.bool-type, condition
		if constant = cond.kind.constant
			if as-bool constant then cb-true-branch[] else cb-false-branch[]
		else
			type, range, if-concrete-expr cond, cb-true-branch[], cb-false-branch[]
	else
		###
		For a complex condition like:
			if x = o1 and y = o2
				true-branch
			else
				false-branch

		It will compile to:
			result t? = if x = o1
				if y = o2
					true-branch
			result else false-branch

		This strategy avoids repeating 'false-branch' twice.
		The function concretize-complex-condition just handles the true part of this.
		###
		option-type = get-concrete-type ctx, ctx.common-types.option[as-type-args model-type]
		true-branch concrete-expr mut() = of
			true_ = cb-true-branch[]
			if throw-concrete-expr true_.kind
				# Avoid wrapping a 'throw' expression in an option, since the JVM complains about unreachable code
				option-type, range, true_.kind
			else
				gen-option ctx.concretize-ctx, option-type, range, true_
		option-true-branch = concretize-complex-condition ctx, option-type, range, condition, true-branch, of
			gen-empty-option ctx.concretize-ctx, option-type, range
		gen-option-else ctx.concretize-ctx, type, range, option-true-branch, cb-false-branch[]

###
WARN: This duplicates 'false-branch'.
Compiles to code like:
	if x = expr1
		if y = expr2
			true-branch
		else
			false-branch
	else
		false-branch
###
| WARN: This duplicates the false branch.
-concretize-complex-condition concrete-expr
	ctx concretize-expr-ctx
	result-type concrete-type
	range uri-and-range
	a expr
	true-branch concrete-expr mut()
	false-branch concrete-expr mut()
do
	if a.logical-expr and a.kind == bool-and-bool
		inner concrete-expr mut() = of
			concretize-complex-condition ctx, result-type, range, a.right, true-branch, false-branch
		concretize-complex-condition ctx, result-type, range, a.left, inner, false-branch
	elif is-option type a, ctx.available-types
		option = concretize-expr ctx, a
		gen-if-option range, option, ((), true-branch[]), false-branch[]
	elif a.unpack-option
		option = concretize-expr ctx, a.option
		true_ = concretize-with-destructure ctx, result-type, range, a.destructure, true-branch
		gen-if-option range, option, true_, false-branch[]
	else
		condition = concretize-expr ctx, ctx.bool-type, a
		gen-if range, condition, true-branch[], false-branch[]

-gen-option-else concrete-expr(ctx concretize-ctx, type concrete-type, range uri-and-range, option concrete-expr, else_ concrete-expr)
	local concrete-local = member::concrete-generated-local-kind, option.type.unwrap-option-type!
	get-local concrete-expr = may-widen-type ctx, type, gen-local-get range, local
	gen-if-option range, option, (local, get-local), else_

-gen-if-option concrete-expr
	range uri-and-range
	option concrete-expr
	then_ concrete-local-and-expr
	else_ concrete-expr
do
	type = else_.type
	if x = then_.local
		option-local concrete-local = member2::concrete-generated-local-kind, option.type
		get-option-local concrete-expr = gen-local-get range, option-local
		gen-let type, range, option-local, option,
			cast-option = gen-union-assume-case x.type, range, get-option-local
			cases concrete-expr[] =
				- else_
				- gen-let type, then_.expr.range, x, cast-option, then_.expr
			type, range,
				match-union-concrete-expr get-option-local, (0, 1), cases, ()
	else
		cases concrete-expr[] = else_, then_.expr
		type, range,
			match-union-concrete-expr option, (0, 1), cases, ()

-concretize-literal-string-like concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	kind string-like-type
	value string
do
	match kind
	as char8-array
		gen-char8-array ctx.concretize-ctx, range, value
	as char32-array
		gen-char32-array ctx.concretize-ctx, range, value
	as java-String
		type, range, value.constant-native-string
	as js-any
		type, range, value.constant-native-string
	as string
		gen-string-literal ctx.concretize-ctx, range, value
	as symbol
		type, range, constant-symbol ctx.concretize-ctx, value.to
	as json
		type, range, constant-json-string ctx.concretize-ctx, value

-concretize-local-get concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	local local
	type-refinements type-args
do
	concrete-local = ctx.locals[local]!
	do unless is-bogus concrete-local.type else concretize-bogus ctx, type, range
	res mut = gen-local-get range, concrete-local
	if is-allocated ctx, local
		res := gen-reference-read ctx.concretize-ctx, range, res
	for t in type-refinements
		res := gen-union-assume-case (get-concrete-type ctx, t), res.range, res
	res

-concretize-local-set concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	local local
	value expr
do
	concrete-local = ctx.locals[local]!
	value-type = if is-allocated ctx, local
		get-referenced-type ctx.concretize-ctx, concrete-local.type
	else
		concrete-local.type
	concrete-value = concretize-expr ctx, value-type, value
	if is-allocated ctx, local
		gen-reference-write ctx.concretize-ctx, range, (gen-local-get range, concrete-local), concrete-value
	else
		gen-local-set ctx.concretize-ctx, range, concrete-local, concrete-value

-concretize-logical concrete-expr
	ctx concretize-expr-ctx
	outer-type concrete-type
	type concrete-type
	model-type type
	range uri-and-range
	a logical-expr
do
	if a.kind == bool-and-bool
		true-branch concrete-expr mut() = of then concretize-expr-and-convert-option-to-bool ctx, a.right
		concretize-complex-condition ctx, type, range, a.left, true-branch, of then gen-false ctx.concretize-ctx, range
	elif a.kind == bool-or-bool
		left = concretize-expr-and-convert-option-to-bool ctx, a.left
		right = concretize-expr-and-convert-option-to-bool ctx, a.right
		gen-or ctx.concretize-ctx, range, left, right
	else
		left-type concrete-type = match a.kind
		as bool-and-bool
			throw unreachable
		as bool-or-bool
			throw unreachable
		as option-else
			if is-option model-type
				type
			else
				get-concrete-type ctx, ctx.common-types.option[model-type.as-type-args]
		as option-or
			outer-type
		left = concretize-expr ctx, left-type, a.left
		right = concretize-expr ctx, type, a.right
		match a.kind
		as bool-and-bool
			throw unreachable
		as bool-or-bool
			throw unreachable
		as option-else
			gen-option-else ctx.concretize-ctx, type, range, left, right
		as option-or
			temp concrete-local = member::concrete-generated-local-kind, type
			get-temp = gen-local-get range, temp
			gen-let type, range, temp, left,
				gen-if-option range, get-temp, ((), get-temp), right

-concretize-loop-while-or-until concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	expr loop-while-or-until-expr
do
	assert is-void ctx.void-type # TODO: sanity check -------------------------------------------------------------------------------
	void = gen-void ctx.concretize-ctx, range
	if unpack = expr.condition.unpack-option
		option = concretize-expr ctx, unpack.option
		if expr.is-until
			after = if after = expr.after
				concretize-expr-with-destructure ctx, type, range, unpack.destructure, after
			else
				(), (gen-void ctx.concretize-ctx, range)
			body = concretize-expr ctx, void.type, expr.body
			if root = after.local
				###
				until x = xs
					body
				after
				==>
				x = loop
					if temp = xs
						break temp
					else
						body
						continue
				after
				###
				temp concrete-local = root.source, root.type
				break_ = gen-break range, gen-local-get range, temp
				if_ = gen-if-option range, option, (temp, break_), gen-do-and-continue root.type, range, body
				loop_ = gen-loop root.type, range, if_
				gen-let type, range, root, loop_, after.expr
			else
				###
				until _ = xs
					body
				after
				=>
				loop
					if _ = xs
						break
					else
						body
						continue
				after
				###
				if_ = gen-if-option range, option, ((), (gen-break range, void)), (gen-do-and-continue void.type, range, body)
				loop_ = gen-loop void.type, range, if_
				gen-seq range, loop_, after.expr
		else
			###
			while x = xs
				body
			after
			==>
			loop
				if x = xs
					body
					continue
				else
					break
			after
			###
			body = concretize-expr-with-destructure ctx, void.type, range, unpack.destructure, expr.body
			if_ = gen-if-option range, option, (body.local, (gen-do-and-continue void.type, range, body.expr)), gen-break range, void
			loop_ = gen-loop void.type, range, if_
			gen-seq range, loop_, concretize-expr-or-void ctx, type, range, expr.after
	elif condition-has-locals expr.condition
		if is-until expr
			###
			until x = xs and y = ys
				body
			after
			==>
			root = loop
				# This variable will actually be inlined
				# NOTE: all destructures from the original are flattened into 'both'
				both (nat, nat)? = if x = xs
					if y = ys
						x, y
					else
						()
				else
					()
				if b = both
					break b
				else
					body
					continue
			x = root item0
			y = root item1
			after
			###
			cond = complex-condition-to-option ctx, expr.condition
			locals = cond.locals
			tuple-option = cond.tuple-option
			both = cond.expr
			tuple-type = tuple-option.unwrap-option-type!
			loop_ =
				body = concretize-expr ctx, void.type, expr.body
				body-and-continue = gen-do-and-continue tuple-type, range, body
				b concrete-local = member, tuple-type
				break-b = gen-break range, gen-local-get range, b
				loop-body = gen-if-option range, both, (b, break-b), body-and-continue
				gen-loop tuple-type, range, loop-body
			root concrete-local = member2, tuple-type
			get-root = gen-local-get range, root
			after mut = if after = expr.after
				concretize-with-locals-from-condition ctx, cond, type, after
			else
				gen-void ctx.concretize-ctx, range
			for index, local in with-index locals
				get-it = if locals.size == 1
					get-root
				else
					gen-record-field-get ctx.concretize-ctx, local.type, range, get-root, index
				after := gen-let type, range, local, get-it, after
			gen-let type, range, root, loop_, after
		else
			###
			while x = xs and y = ys
				body
			after
			==>
			loop
				if x = xs
					if y = ys
						body
						continue
					else
						break
				else
					break
			after
			###
			true-branch concrete-expr mut() = of
				body = concretize-expr ctx, void.type, expr.body
				gen-do-and-continue void.type, range, body
			loop-body = concretize-complex-condition ctx, void.type, range, expr.condition, true-branch, of
				gen-break range, void
			loop_ = gen-loop void.type, range, loop-body
			gen-seq range, loop_, concretize-expr-or-void ctx, type, range, expr.after
	else
		###
		while cond
			body
		after
		==>
		loop
			if cond
				body
				continue
			else
				break
		after
		###
		condition = concretize-expr-and-convert-option-to-bool ctx, expr.condition
		body = concretize-expr ctx, void.type, expr.body
		do-and-continue = gen-do-and-continue void.type, range, body
		break_ = gen-break range, void
		if_ = if expr.is-until
			gen-if range, condition, break_, do-and-continue
		else
			gen-if range, condition, do-and-continue, break_
		loop_ = gen-loop void.type, range, if_
		gen-seq range, loop_, concretize-expr-or-void ctx, type, range, expr.after

-complex-condition-option-result record
	model-locals local[]
	locals concrete-local[]
	tuple-option concrete-type
	expr concrete-expr
-complex-condition-to-option complex-condition-option-result
	ctx concretize-expr-ctx
	a expr
do
	range = to-uri-and-range ctx, a.range
	model-locals local[] = for* x in condition-knowledge a, true
		from-option x.local
	concrete-tuple-option concrete-type = if model-locals.size == 1
		get-concrete-type ctx, ctx.common-types.option[as-type-args model-locals[0].type]
	else
		tuple struct-inst = tuple! ctx.common-types, make-type-args model-locals, it.type
		get-concrete-type ctx, ctx.common-types.option[tuple]
	concrete-tuple-type = unwrap-option-type! concrete-tuple-option
	local-types concrete-type[] = if model-locals.size == 0
		()
	elif model-locals.size == 1
		concrete-tuple-type,
	else
		concrete-tuple-type.source.concrete-type-source-inst!.type-args
	local-types.size is model-locals.size
	concrete-locals mut concrete-local[] = ()
	true-branch concrete-expr mut() = of
		concrete-locals := for local in model-locals then ctx.locals[local]!
		exprs concrete-expr[] = for type, local in zip local-types, model-locals
			concretize-local-get ctx, type, range, local, ()
		tuple-expr concrete-expr = if model-locals.size == 0
			gen-void ctx.concretize-ctx, range
		elif model-locals.size == 1
			only! exprs
		else
			gen-create-record ctx.concretize-ctx, concrete-tuple-type, range, exprs
		gen-option ctx.concretize-ctx, concrete-tuple-option, range, tuple-expr
	expr = concretize-complex-condition ctx, concrete-tuple-option, range, a, true-branch, of
		gen-empty-option ctx.concretize-ctx, concrete-tuple-option, range
	model-locals: model-locals
	locals: concrete-locals
	tuple-option: concrete-tuple-option
	expr: expr
-concretize-with-locals-from-condition concrete-expr
	ctx concretize-expr-ctx
	cond complex-condition-option-result
	type concrete-type
	expr expr
do
	for model-local, concrete-local in zip cond.model-locals, cond.locals
		ctx.locals[model-local] := concrete-local
	finally
		for model-local in cond.model-locals
			_ = remove! ctx.locals, model-local
	concretize-expr ctx, type, expr

-concretize-match-enum concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-enum-expr
do
	do unless is-empty a.cases else concretize-bogus ctx, type, range
	concretize-with-opt-local ctx, type, range, a.matched-local, a.matched, of matched
		values-unsorted nat[] = map a.cases, it.member.value
		cases-unsorted concrete-expr[] = for value in values-unsorted
			case_ = find! a.cases, it.member.value == value
			concretize-expr ctx, type, case_.then_
		else_ concrete-expr? = if x = a.else_
			concretize-expr ctx, type, x
		values, cases = sort-by-first values-unsorted, cases-unsorted
		gen-match-enum-or-integral type, range, matched, values.to, cases, else_

-concretize-match-integral concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-scalar-expr
do
	concretize-with-opt-local ctx, type, range, a.matched-local, a.matched, of matched
		values-unsorted scalar-value[] = map a.cases, it.value
		# TODO: If matched is a constant, just compile the relevant case
		cases-unsorted concrete-expr[] = for value in values-unsorted
			case_ = find! a.cases, it.value == value
			concretize-expr ctx, type, case_.then_
		else_ = concretize-expr ctx, type, a.else_
		values, cases = sort-by-first values-unsorted, cases-unsorted
		gen-match-enum-or-integral type, range, matched, values.to, cases, else_

-concretize-match-string-like concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-string-like-expr
do
	do if equals = get-concrete-fun-from-called ctx, a.equals else
		concretize-bogus ctx, type, range
	concretize-with-opt-local ctx, type, range, a.matched-local, a.matched, of matched
		cases concrete-match-string-like-case[] = for case_ in a.cases
			value = concretize-literal-string-like ctx, matched.type, range, a.string-type, case_.value
			value, concretize-expr ctx, type, case_.then_
		else_ = concretize-expr ctx, type, a.else_
		type, range, match-string-like-concrete-expr matched, equals, cases, else_

-concretize-match-sum-type concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-sum-type-expr
do
	concretize-with-opt-local ctx, type, range, a.matched-local, a.matched, of matched
		else_ concrete-expr? = if x = a.else_
			concretize-expr ctx, type, x
		if is-empty a.cases
			else_ else concretize-bogus ctx, type, range
		else
			case-indices nat[] = for x in a.cases
				member-index-for-match-sum-type-case ctx, matched.type, x.case-type
			cases concrete-expr[] = for case_ in a.cases
				concretize-expr ctx, type, case_.then_
			sorted-indices, sorted-cases = sort-by-first case-indices, cases
			type, range, match-union-concrete-expr matched, sorted-indices.to, sorted-cases, else_

-concretize-catches (nat[], concrete-local-and-expr[], concrete-local-and-expr?)
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	catches catch_[]
do
	variant-type = ctx.concretize-ctx.exception-type
	typed-catches catch_ array-view, catch-else catch_? = if catches[end - 1].caught-type == ctx.common-types.exception
		catches[0 .. end - 1], catches[end - 1]
	else
		catches.to, ()
	case-indices nat[] = for x in typed-catches
		member-index-for-match-sum-type-case ctx, variant-type, x.caught-type
	cases concrete-local-and-expr[] = for catch_ in typed-catches
		concretize-expr-with-destructure ctx, type, range, catch_.destructure.to, catch_.then_
	sorted-indices, sorted-catches = sort-by-first case-indices, cases
	sorted-indices, sorted-catches, if catch-else
		concretize-expr-with-destructure ctx, type, range, catch-else.destructure.to, catch-else.then_

-concretize-catch (nat, concrete-local-and-expr)
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	catch_ catch_
do
	- member-index-for-match-sum-type-case ctx, ctx.concretize-ctx.exception-type, catch_.caught-type
	- concretize-expr-with-destructure ctx, type, range, catch_.destructure.to, catch_.then_

-member-index-for-match-sum-type-case nat(ctx concretize-expr-ctx, variant-type concrete-type, type struct-inst)
	sum-type-case-index ctx.concretize-ctx, variant-type, get-concrete-type ctx, type

-concretize-force concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a force-expr
do
	arg = concretize-expr ctx, a.arg
	gen-option-else ctx.concretize-ctx, type, range, arg,
		gen-throw type, range,
			gen-error ctx.concretize-ctx, range,
				"Option was empty: '{ctx.concretize-ctx.file-content-getters[arg.range].to::string}'"

-concretize-assert-or-forbid concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a assert-or-forbid-expr
do
	model-type = type a, ctx.available-types
	throw_ concrete-expr mut() = of
		gen-throw type, range, if x = a.thrown
			concretize-expr ctx, ctx.concretize-ctx.exception-type, x
		else
			gen-error ctx.concretize-ctx, range,
				default-assert-or-forbid-message ctx.cur-uri, a, ctx.available-types, ctx.concretize-ctx.file-content-getters
	after concrete-expr mut() = of
		concretize-expr-or-void ctx, range, a.after
	true-branch concrete-expr mut(), false-branch concrete-expr mut() =
		if a.is-forbid then throw_, after else after, throw_
	concretize-if ctx, type, model-type, range, a.condition, true-branch, false-branch

-concretize-expr concrete-expr(ctx concretize-expr-ctx, a expr)
	type = get-concrete-type ctx, type a, ctx.available-types
	concretize-expr ctx, type, a

-concretize-expr-or-void concrete-expr(ctx concretize-expr-ctx, type concrete-type, range uri-and-range, a expr?)
	if a
		concretize-expr ctx, type, a
	else
		gen-void ctx.concretize-ctx, range
-concretize-expr-or-void concrete-expr(ctx concretize-expr-ctx, range uri-and-range, a expr?)
	if a
		concretize-expr ctx, a
	else
		gen-void ctx.concretize-ctx, range

concretize-expr concrete-expr(ctx concretize-expr-ctx, outer-type concrete-type, a expr)
	model-type = type a, ctx.available-types
	type = get-concrete-type ctx, model-type
	range uri-and-range = ctx.cur-uri, a.range
	do unless is-bogus type else concretize-bogus ctx, type, range
	res = match a
	as assert-or-forbid-expr
		concretize-assert-or-forbid ctx, type, range, a
	as bogus-call-expr
		concretize-bogus ctx, type, range
	as bogus-expr
		concretize-bogus ctx, type, range
	as bogus-wrong-type-expr
		concretize-bogus ctx, type, range
	as call-expr
		concretize-call ctx, type, range, a
	as call-named-new-expr
		concretize-call-named-new ctx, type, range, a
	as call-option-expr
		concretize-call-option ctx, type, range, a
	as finally-expr
		concretize-finally ctx, type, range, a
	as force-expr
		concretize-force ctx, type, range, a
	as if-expr
		concretize-if ctx, type, range, a
	as not-expr
		concretize-not ctx, type, range, a
	as lambda-expr
		concretize-lambda ctx, type, range, a
	as let-expr
		# Use 'outer-type' instead of 'type' here to make the conversion be in the 'then' expression instead of wrapping the whole 'let'.
		# This leads to simpler generated code.
		concretize-let ctx, outer-type, range, a
	as let-the-expr
		the-type = get-concrete-type ctx, a.the-type
		value = concretize-expr ctx, the-type, a.value
		local = concrete-local the_::concrete-generated-local-kind, the-type
		ctx.contexts ~:= local
		gen-let type, range, local, value, concretize-expr-or-void ctx, type, range, a.then_
	as list-expr
		concretize-list ctx, type, range, a
	as literal-scalar-expr
		if a.type == json
			type, range, constant-json-number ctx.concretize-ctx, a.value.to
		else
			gen-constant type, range, a.value
	as literal-string-like-expr
		concretize-literal-string-like ctx, type, range, a.string-type, a.value
	as local-get-expr
		concretize-local-get ctx, type, range, a.local, ()
	as local-get-and-refine-expr
		concretize-local-get ctx, type, range, a.local, a.type-refinements
	as local-set-expr
		concretize-local-set ctx, range, a.local, a.value
	as logical-expr
		concretize-logical ctx, outer-type, type, model-type, range, a
	as loop-expr
		gen-loop type, range, concretize-expr ctx, type, a.body
	as loop-break-expr
		gen-break range, concretize-expr ctx, type, a.value
	as loop-continue-expr
		gen-continue type, range
	as loop-while-or-until-expr
		concretize-loop-while-or-until ctx, type, range, a
	as match-enum-expr
		concretize-match-enum ctx, type, range, a
	as match-scalar-expr
		concretize-match-integral ctx, type, range, a
	as match-string-like-expr
		concretize-match-string-like ctx, type, range, a
	as match-sum-type-expr
		concretize-match-sum-type ctx, type, range, a
	as seq-expr
		first = concretize-expr ctx, ctx.void-type, a.first
		# See comment on 'as let-expr' for why we use 'outer-type' instead of 'type'
		then_ = concretize-expr ctx, outer-type, a.then_
		if first.kind.constant
			then_
		else
			outer-type, range, seq-concrete-expr first.as-seq ~~ then_.as-seq
	as the-expr
		get-the ctx, type, range
	as throw-expr
		thrown = concretize-expr ctx, ctx.concretize-ctx.exception-type, a.thrown
		type, range, thrown.throw-concrete-expr
	as trusted-expr
		concretize-expr ctx, type, a.inner
	as try-expr
		concretize-try ctx, type, range, a
	as try-let-expr
		concretize-try-let ctx, type, range, a
	as typed-expr
		concretize-expr ctx, type, a.inner
	as unpack-option
		gen-option-to-bool ctx.concretize-ctx, concretize-expr ctx, a.option
	may-widen-type ctx.concretize-ctx, outer-type, res

-~[t] t array-view(a t array-view, x t)
	a.to::t[] ~ x 'to

-get-the concrete-expr(ctx concretize-expr-ctx, type concrete-type, range uri-and-range)
	gen-local-get range, get-the-local ctx, type
-get-the-local concrete-local(ctx concretize-expr-ctx, type concrete-type)
	find! ctx.contexts, it.type == type

-concretize-expr-and-convert-option-to-bool concrete-expr(ctx concretize-expr-ctx, expr expr)
	inner = concretize-expr ctx, expr
	if is-bool inner.type
		inner
	else
		gen-option-to-bool ctx.concretize-ctx, inner

-gen-option-to-bool concrete-expr(ctx concretize-ctx, arg concrete-expr)
	range = arg.range
	gen-if-option range, arg, ((), (gen-true ctx, range)), gen-false ctx, range

-as-seq concrete-expr[](a concrete-expr)
	match x = a.kind
	as seq-concrete-expr
		x.parts
	else
		- a

-may-widen-type concrete-expr
	ctx concretize-ctx
	expected-type concrete-type
	actual concrete-expr
do
	try-widen ctx, expected-type, actual else
		show-ctx = ctx.show-ctx
		where = show-ctx.line-and-column-getters[actual.range]
		log error, "At: {where}, expected type: {show-concrete-type show-ctx, expected-type}, actual: {show-concrete-type show-ctx, actual.type}"
		throw unreachable

# This goes in reverse, from 'to' to 'from'. So must reverse the path at the end.
-try-widen concrete-expr?(ctx concretize-ctx, expected concrete-type, actual concrete-expr)
	if actual.type == expected
		actual
	elif expected-unwrapped = unwrap-option-type expected
		if res = try-widen ctx, expected-unwrapped, actual
			gen-option ctx, expected, actual.range, res
		elif actual-unwrapped = unwrap-option-type actual.type
			# 'actual' generates an option.
			temp concrete-local = member::concrete-generated-local-kind, actual-unwrapped
			range = actual.range
			if widen-temp = try-widen ctx, expected-unwrapped, gen-local-get range, temp
				some = gen-option ctx, expected, range, widen-temp
				gen-if-option range, actual, (temp, some), gen-empty-option ctx, expected, range
	elif u = concrete-union expected.body
		if u.has-members
			first u.members.with-index, of member-index, member
				if res = try-widen ctx, member, actual
					gen-create-union ctx, expected, actual.range, member-index, res
		else
			first ctx.sum-types[expected]!.with-index, of member-index, x
				if res = try-widen ctx, x.member-type, actual
					gen-create-union ctx, expected, actual.range, member-index, res

-concretize-finally concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a finally-expr
do
	right = concretize-expr ctx, ctx.void-type, a.right
	below = concretize-expr ctx, type, a.below
	type, range, finally-concrete-expr right, below

-concretize-try concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a try-expr
do
	tried = concretize-expr ctx, type, a.tried
	member-indices, cases, else_ = concretize-catches ctx, type, range, a.catches
	type, range, try-concrete-expr tried, member-indices.to, cases, else_

-concretize-try-let concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a try-let-expr
do
	local-type = get-concrete-type ctx, a.destructure.type
	value = concretize-expr ctx, local-type, a.value
	catch-member-index, catch-expr = concretize-catch ctx, type, range, a.catch_
	then_ = if then_ = a.then_
		concretize-expr-with-destructure ctx, type, range, a.destructure, then_
	else
		(), gen-void ctx.concretize-ctx, range
	type, range,
		try-let-concrete-expr then_.local, value, catch-member-index, catch-expr, then_.expr
