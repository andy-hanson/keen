import
	../../crow/col/sort: sort-by-first
	../model/concrete-model
	../model/integral-values
	../model/model
	../model/source-range
	../model/uri
	../model/version-info
	../util/util
	./all-constants-builder
	./concretize-ctx
	./constants-or-exprs
	./generate

concretize-fun-body concrete-expr(ctx concretize-ctx, cf concrete-fun, expr expr)
	cf with-params params =>
		expr-ctx concretize-expr-ctx = ctx, cf, (), (cf.params.size,)
		# Ignore closure param, which is never destructured.
		params-to-destructure = cf.params[(params.size + 1 == cf.params.size ? 1 : 0) .. end]
		expr-ctx concretize-with-param-destructures cf.return-type, params.to, params-to-destructure, expr

# TODO: no need for 'with' -----------------------------------------------------------------------------------------------------------
-with-params[t] t(cf concrete-fun, f t mut(x destructure[]))
	match cf source
	as concrete-fun-source-regular x
		f[x.decl.params params-array]
	as concrete-fun-source-lambda x
		f[x.param,]
	as concrete-fun-source-test _
		f[]
	as concrete-fun-source-wrap-main _
		throw unreachable

-concretize-bogus concrete-expr(ctx concretize-expr-ctx, type concrete-type, range uri-and-range)
	ctx.concretize-ctx gen-bogus type, range

-concretize-with-param-destructures concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	params destructure array-view,
	concrete-params concrete-local array-view,
	expr expr,
)
	for param, concrete-param : params zip concrete-params
		ctx begin-param-destructure param, concrete-param
	res mut = ctx concretize-expr type, expr
	for param, concrete-param : params zip concrete-params
		res := ctx end-param-destructure type, (ctx to-uri-and-range param.range), param, concrete-param, res
	res

concretize-expr-ctx record mut
	concretize-ctx concretize-ctx
	| This is the concrete-fun for a lambda, not its containing fun. (TODO: Actually, when preserving lambdas, it's the containing fun) -----
	cur-fun concrete-fun
	locals local-or-constant mut[local]
	local-ids concrete-local-ids
preserve-lambdas bool(a concretize-expr-ctx)
	a.concretize-ctx preserve-lambdas
allocate-mutable-closure-variables bool(a concretize-expr-ctx)
	a !preserve-lambdas || a is-java
is-native bool(a concretize-expr-ctx)
	a.concretize-ctx is-native
is-java bool(a concretize-expr-ctx)
	a.concretize-ctx is-java
is-js bool(a concretize-expr-ctx)
	a.concretize-ctx is-js
-common-types common-types(a concretize-expr-ctx)
	a.concretize-ctx common-types
-cur-uri uri(a concretize-expr-ctx)
	a.cur-fun module-uri
all-constants all-constants-builder(a concretize-expr-ctx)
	a.concretize-ctx all-constants
-bool-type concrete-type(a concretize-expr-ctx)
	a.concretize-ctx bool-type
-void-type concrete-type(a concretize-expr-ctx)
	a.concretize-ctx void-type
-to-uri-and-range uri-and-range(ctx concretize-expr-ctx, a source-range)
	ctx.cur-uri, a

-typed-constant record(type concrete-type, value constant)
-local-or-constant union(concrete-local, typed-constant)
	type concrete-type()

get-concrete-type concrete-type(a concretize-expr-ctx, t type)
	a.concretize-ctx get-concrete-type t, a.type-scope
-type-scope type-args-scope(a concretize-expr-ctx)
	a.cur-fun type-args-scope-for-fun
-specs-scope specs-scope(a concretize-expr-ctx)
	a.cur-fun specs-scope-for-fun

-concretize-call concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a call-expr,
)
	if concrete-called ?= ctx get-concrete-fun-from-called a.called
		if concrete-called.return-type is-bogus
			ctx concretize-bogus type, range
		elif concrete-called is-array-op # TODO: it's a bit wasteful to give the function a body in get-concrete-fun-from-called only to ignore it here ....
			input-arg, lambda-arg = a.args only2
			input = ctx concretize-expr concrete-called.params[0].type, input-arg
			in-element-type = input.type is-range ? input.type.range-element-type : input.type array-element-type
			out-element-type = type.is-void ? type : type array-element-type
			empty-out-array constant-array? = unless type is-void
				(ctx.all-constants get-constant-array type.must-be-by-val, ()).constant-array!,
			match lambda-arg
			as lambda-expr l
				forbid _ ?= l.mut-type-for-explicit-shared # This won't happen because 'for-loop' takes a 'mut' lambda
				rg uri-and-range = ctx.cur-uri, lambda-arg.range
				body = ctx concretize-with-destructure out-element-type, rg, l.param, () =>
					ctx concretize-expr out-element-type, l.body
				type, range, (input array-op-concrete-expr body.root-local, empty-out-array, body.expr)
			else
				lambda-type = concrete-called.params[1].type
				temp concrete-local = ctx.local-ids.take-next-id, member.to, lambda-type # TODO: use a new kind, not 'member'
				lambda = ctx concretize-expr lambda-type, lambda-arg
				in-element concrete-local = ctx.local-ids.take-next-id, member.to, in-element-type # TODO: use a new kind, not 'member'
				assert ctx preserve-lambdas : todo # If not: We need to find the lambda calling function and call it here ------------------
				body = builtin-fun-call-lambda builtin-concrete-expr (out-element-type, in-element-type), ((range gen-local-get temp), (range gen-local-get in-element))
				then concrete-expr = type, range, (input array-op-concrete-expr (in-element,), empty-out-array, (out-element-type, range, body))
				type gen-let range, temp, lambda, then
		else
			ctx concretize-call-inner type, range, concrete-called, a.args
	else
		ctx concretize-bogus type, range

-is-array-op bool(a concrete-fun)
	# TODO: make sure this is the one in collection.crow and all the spec impls are as expected ----------------------------------------------------------------------
	guard a.name == ("for-loop",)
	guard a.return-type is-void || a.return-type is-array-or-mut-array
	guard a.params.size == 2
	input = a.params[0]
	guard input.type is-range || input.type is-array-or-mut-array
	guard _ ?= a.params[1].type as-fun-type
	true

-is-range bool(a concrete-type)
	a.reference == by-val_ && a.struct is-range
-is-range bool(a concrete-struct)
	guard inst ?= a.source concrete-struct-source-inst
	decl = inst decl
	# TODO: base this on more than just the name ... uri too? -----------------------------------------------------
	decl.name == "range"

-concretize-call-inner concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	concrete-called concrete-fun,
	args expr[],
)
	assert concrete-called.return-type == type
	concrete-args = ctx get-concrete-args range, concrete-called, args
	type, range, match concrete-args
	as constants constants
		if constant ?= ctx.concretize-ctx try-eval-constant concrete-called, constants.constants, ctx.concretize-ctx.version-info
			constant to
		else
			concrete-called gen-call-kind for p, x : concrete-called.params zip constants.constants
				p.type, range, x.to
	as exprs exprs
		if builtin_ ?= concrete-called.body concrete-fun-body-builtin
			match builtin_ kind
			as builtin-binary-lazy x
				ctx concretize-builtin-binary-lazy type, range, x, exprs.exprs
			as builtin-fun-call-lambda
				if ctx preserve-lambdas
					builtin_.kind builtin-concrete-expr builtin_.type-args, exprs.exprs
				else
					concrete-called gen-call-kind exprs.exprs
			# These functions are nontrivial, so don't inline them
			as builtin-fun-mark-visit
				concrete-called gen-call-kind exprs.exprs
			as builtin-fun-mark-root
				concrete-called gen-call-kind exprs.exprs
			else
				# TODO: Calling builtins directly seems to break something around set-gc-root in the C build ...............................................
				if ctx is-native
					concrete-called gen-call-kind exprs.exprs
				else
					builtin_.kind builtin-concrete-expr builtin_.type-args, exprs.exprs
		else
			concrete-called gen-call-kind exprs.exprs

-get-concrete-args constants-or-exprs(
	ctx concretize-expr-ctx, 
	range uri-and-range,
	concrete-called concrete-fun,
	args expr[],
)
	args-may-be-constants = args.is-empty || (concrete-called !is-summon && concrete-called.return-type.purity == data_)
	if concrete-called is-variadic
		array-type = concrete-called.params.only type
		element-type = array-type array-element-type
		pre = args-may-be-constants as-constants-or-exprs-if for arg : args
			ctx concretize-expr element-type, arg
		ctx constants-or-exprs-arr range, array-type, pre
	else
		args-may-be-constants as-constants-or-exprs-if for param, arg : concrete-called.params zip args
			ctx concretize-expr param.type, arg

-concretize-builtin-binary-lazy concrete-expr-kind(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	kind builtin-binary-lazy,
	args concrete-expr[],
)
	arg0, arg1 = args only2
	# TODO: handle constants here (false && whatever -> false, etc.) ------------------------------------------------------------------------------------------------------
	match kind
	as bool-and
		ctx.concretize-ctx gen-and-kind range, arg0, arg1
	as bool-or
		ctx.concretize-ctx gen-or-kind range, arg0, arg1
	as option-or
		# TODO: this should use a let expr to ensure 'a' is only evaluated once! -------------------------------------------------
		arg0 gen-if-option-kind ((), arg0), arg1
	as option-question-2
		local concrete-local = ctx.local-ids.take-next-id, member::concrete-generated-local-kind.to, type
		arg0 gen-if-option-kind ((local,), (range gen-local-get local)), arg1

-concretize-call-option concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a call-option-expr,
)
	assert type is-option
	# `a?.b` ==> `x ?= a ? (x.b,) : ()`
	# But `x.b` may already be an option and might not need to be wrapped
	guard called ?= ctx get-concrete-fun-from-called a.called : ctx concretize-bogus type, range
	# TODO: should get-concrete-fun-from-called just return nothing if the return type is bogus? -----------------------------------
	guard called.return-type !is-bogus : ctx concretize-bogus type, range
	option = ctx concretize-expr a.first-arg
	local concrete-local = ctx.local-ids.take-next-id, destruct::concrete-generated-local-kind.to, called.params[0].type
	a.rest-args.size + 1 is called.params.size
	all-args concrete-expr[] = with out : 1 + a.rest-args.size build # TODO: just inline below ----------------------------------
		out ~= range gen-local-get local
		for i, x : a.rest-args with-index
			out ~= ctx concretize-expr called.params[i + 1].type, x
	call = range gen-call called, all-args
	some-call = if call.type == type
		call
	else
		ctx.concretize-ctx gen-some type, range, call
	assert some-call.type == type
	range gen-if-option option, ((local,), some-call), (ctx.concretize-ctx gen-none type, range)

-as-constants-or-exprs-if constants-or-exprs(may-be-constants bool, exprs concrete-expr[])
	if may-be-constants
		exprs as-constants-or-exprs
	else
		exprs exprs

get-concrete-fun-from-called concrete-fun?(ctx concretize-expr-ctx, called called)
	ctx.concretize-ctx get-concrete-fun-from-called ctx.type-scope, ctx.specs-scope, called

-concretize-closure-get concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a closure-get-expr,
)
	if ctx preserve-lambdas
		ctx concretize-local-get type, range, a.local
	else
		info = ctx get-closure-field-info a.closure-ref
		get-field = ctx get-closure-field range, a.closure-ref
		match info reference-kind
		as direct
			assert info.field-type == info.referenced-type
			assert info.field-type == type
			get-field
		as allocated
			assert info.referenced-type == type
			ctx.concretize-ctx gen-reference-read range, get-field

| This does not dereference it if allocated; {concretize-closure-get} does that.
-get-closure-field concrete-expr(ctx concretize-expr-ctx, range uri-and-range, a closure-ref)
	forbid ctx preserve-lambdas
	info = ctx get-closure-field-info a
	ctx.concretize-ctx gen-record-field-get info.field-type, range, (range gen-param-get info.closure-param), info.field-index

-concretize-closure-set concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a closure-set-expr,
)
	if ctx preserve-lambdas
		ctx concretize-local-set range, a.local, a.value
	else
		assert a.closure-ref.closure-reference-kind == allocated
		info = ctx get-closure-field-info a.closure-ref
		assert info.reference-kind == allocated
		field = ctx get-closure-field range, a.closure-ref
		value = ctx concretize-expr info.referenced-type, a.value
		assert type is-void
		ctx.concretize-ctx gen-reference-write range, field, value

-closure-field-info record
	closure-param concrete-local
	field-index nat
	| This may be wrapped in a 'reference'
	field-type concrete-type
	| If field is a reference, this is the type of its value.
	referenced-type concrete-type
	reference-kind closure-reference-kind
-get-closure-field-info closure-field-info(ctx concretize-expr-ctx, a closure-ref)
	closure-param concrete-local = ctx.cur-fun.params[0]
	closure-type = closure-param type
	record_ = closure-type.struct.body concrete-record!
	reference-kind = a closure-reference-kind
	field-type = record_.fields[a index] type
	pointee-type = match reference-kind
	as direct
		field-type
	as allocated
		ctx.concretize-ctx get-referenced-type field-type
	closure-param, a.index, field-type, pointee-type, reference-kind

-concretize-closure-fields concrete-field[](ctx concretize-expr-ctx, closure variable-ref[])
	forbid ctx preserve-lambdas
	for x : closure
		base-type = ctx get-concrete-type x.type
		type = match x closure-reference-kind
		as direct
			base-type
		as allocated
			ctx get-concrete-type x.local.closure-reference-type!.to
		# Even if the variable is mutable, it's a const field holding a mut pointer
		x.name, false, type

-concretize-fun-pointer concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a fun-pointer-expr,
)
	if called ?= ctx get-concrete-fun-from-called a.called
		type, range, called.constant-fun-pointer.to
	else
		ctx concretize-bogus type, range

-concretize-lambda concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	e lambda-expr,
)
	if ctx preserve-lambdas
		if ctx is-java
			forbid e.kind == explicit-shared : todo # For Java, we need to do something for these ---------------------------------------------
		return-type = ctx get-concrete-type e.return-type
		param-type = ctx get-concrete-type e.param.type
		body = ctx concretize-expr-with-destructure return-type, range, e.param, e.body
		param = body.root-local ?? do
			id: ctx.local-ids take-next-id
			source: args::concrete-generated-local-kind to
			type: param-type
		closure concrete-local[] = with out : build
			for x : e closure
				match ctx.locals[x local]!
				as concrete-local l
					out ~= l
				as typed-constant _
					()
		type, range, (closure lambda-concrete-expr param, body.expr)
	elif e.kind == explicit-shared
		inner-type = ctx get-concrete-type e.mut-type-for-explicit-shared!.to
		inner = ctx concretize-lambda-inner inner-type, range, e
		lambda-type-args = inner-type.struct.source.concrete-struct-source-inst! type-args
		shared-of-mut-lambda = ctx.concretize-ctx get-concrete-fun ctx.concretize-ctx.program.common-funs.shared-of-mut-lambda, lambda-type-args, ()
		range gen-call shared-of-mut-lambda, (inner,)
	else
		ctx concretize-lambda-inner type, range, e

-concretize-lambda-inner concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	e lambda-expr,
)
	forbid ctx preserve-lambdas
	# TODO: handle constants in closure
	# (do *not* include in the closure type, instead remember them for when compiling the lambda fn)
	lambda-index = ctx.concretize-ctx next-lambda-index
	closure-fields = ctx concretize-closure-fields e.closure
	closure-type = ctx.concretize-ctx concrete-type-from-closure closure-fields, (ctx.cur-fun concrete-struct-source-lambda lambda-index)
	params = ctx.concretize-ctx concretize-lambda-params closure-type, e.param, ctx.type-scope
	lambda-struct = type must-be-by-val
	closure-args concrete-expr[] = for x : e closure
		ctx concretize-variable-ref-for-closure range, x
	closure = if closure-args is-empty && ctx.concretize-ctx !require-unique-union-types
		ctx.concretize-ctx gen-void range
	else
		ctx.concretize-ctx gen-create-record closure-type, range, closure-args
	return-type = ctx get-concrete-type e.return-type
	guard return-type !is-bogus : ctx concretize-bogus type, range
	fun = ctx.concretize-ctx get-concrete-fun-for-lambda ctx.cur-fun, lambda-index, return-type, e.param, params, e.body
	impl concrete-lambda-impl = closure-type, fun
	ctx.concretize-ctx gen-create-union type, range, (ctx.concretize-ctx next-lambda-impl-id lambda-struct, impl), closure

-next-lambda-impl-id nat(ctx concretize-ctx, lambda-struct concrete-struct, impl concrete-lambda-impl)
	forbid ctx preserve-lambdas
	impl next-lambda-impl-id-inner ctx.lambda-structs[lambda-struct]!.b
-next-lambda-impl-id-inner nat(impl concrete-lambda-impl, impls concrete-lambda-impl mut[])
	res = impls size
	impls ~= impl
	res

-concretize-let concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	e let-expr,
)
	local-type = ctx get-concrete-type e.destructure.type
	value = ctx concretize-expr local-type, e.value
	ctx concretize-with-destructure-and-let type, range, e.destructure, value, () =>
		ctx concretize-expr type, e.then

-concretize-expr-with-destructure root-local-and-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	destructure destructure,
	expr expr,
)
	ctx concretize-with-destructure type, range, destructure, () =>
		ctx concretize-expr type, expr

-root-local-and-expr record(root-local concrete-local?, expr concrete-expr)

-concretize-with-destructure-and-let concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	destructure destructure,
	value concrete-expr,
	f concrete-expr mut(),
)
	then = ctx concretize-with-destructure type, range, destructure, f
	if root ?= then root-local
		type gen-let range, root, value, then.expr
	elif _ ?= value.kind constant
		then expr
	else
		ctx.concretize-ctx gen-drop-then range, value, then.expr

-concretize-with-destructure root-local-and-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	destructure destructure,
	f concrete-expr mut(),
)
	ctx begin-destructure destructure
	res = f[]
	ctx end-destructure type, range, destructure, res

-begin-destructure void(ctx concretize-expr-ctx, destructure destructure)
	match destructure
	as destructure-ignore _
		()
	as local local
		root-local concrete-local = ctx.local-ids.take-next-id, local.to, (ctx get-concrete-type local.type)
		ctx.locals[local] := if ctx is-allocated local
			reference-type = ctx get-concrete-type local.closure-reference-type!.to
			reference-local concrete-local = ctx.local-ids.take-next-id, local.concrete-local-source-reference, reference-type
			reference-local to
		else
			root-local to
	as destructure-split x
		if x is-valid-destructure ctx.common-types
			for part : x parts
				ctx begin-destructure part
-begin-param-destructure void(ctx concretize-expr-ctx, destructure destructure, concrete-param concrete-local)
	match destructure
	as destructure-ignore _
		()
	as local local
		ctx.locals[local] := concrete-param to
	as destructure-split _
		ctx begin-destructure destructure
-end-destructure root-local-and-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	destructure destructure,
	expr concrete-expr,
)
	match destructure
	as destructure-ignore _
		(), expr
	as local local
		concrete-local = ctx.locals remove! local concrete-local!
		if ctx is-allocated local
			root-local concrete-local = ctx.local-ids.take-next-id, local.to, (ctx get-concrete-type local.type)
			value = ctx.concretize-ctx gen-reference-create concrete-local.type, range, (range gen-local-get root-local)
			(root-local,), (type gen-let range, concrete-local, value, expr)
		else
			(concrete-local,), expr
	as destructure-split x
		if x is-valid-destructure ctx.common-types
			root-local concrete-local = ctx.local-ids.take-next-id, destruct.to, (ctx get-concrete-type destructure.type)
			res = ctx end-destructure-split type, range, expr, x, root-local
			(root-local,), res
		else
			(), (ctx concretize-bogus type, range)
-end-param-destructure concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	destructure destructure,
	root-local concrete-local,
	expr concrete-expr,
)
	match destructure
	as destructure-ignore _
		expr
	as local x
		forbid ctx is-allocated x
		expr
	as destructure-split x
		ctx end-destructure-split type, range, expr, x, root-local
-end-destructure-split concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	expr concrete-expr,
	x destructure-split,
	root-local concrete-local
)
	guard x is-valid-destructure ctx.common-types : ctx concretize-bogus type, range # TODO: we should detect this earlier and make the entire expression fail
	get-root-local = range gen-local-get root-local
	res mut = expr
	for part-index, part : x.parts with-index
		part-range = ctx to-uri-and-range part.range
		value-type = root-local.type.must-be-by-val.body.concrete-record!.fields[part-index] type
		expected-type = ctx get-concrete-type part.type
		assert value-type == expected-type : todo # If they don't match, we shoudln't have compiled the destructure at all, the whole thing should be bogus
		its-value = ctx.concretize-ctx gen-record-field-get value-type, part-range, get-root-local, part-index
		its-root-local-and-expr = ctx end-destructure type, part-range, part, res
		res := its-root-local-and-expr expr
		if l ?= its-root-local-and-expr root-local
			res := type gen-let part-range, l, its-value, res
	res

-is-allocated bool(ctx concretize-expr-ctx, a local)
	match a mutability
	as immut
		false
	as mut_
		a is-used-in-closure && ctx allocate-mutable-closure-variables

-concretize-if concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a if-expr,
)
	match a condition
	as expr expr
		cond = ctx concretize-expr ctx.bool-type, expr
		if constant ?= cond.kind constant
			ctx concretize-expr type, (constant.as-bool ? a true-branch : a false-branch)
		else
			true-branch = ctx concretize-expr type, a.true-branch
			false-branch = ctx concretize-expr type, a.false-branch
			type, range, (cond if-concrete-expr true-branch, false-branch)
	as unpack-option unpack
		option = ctx concretize-expr unpack.option
		true-branch = ctx concretize-expr-with-destructure type, range, unpack.destructure, a.true-branch
		false-branch = ctx concretize-expr type, a.false-branch
		range gen-if-option option, true-branch, false-branch

-gen-if-option concrete-expr(
	range uri-and-range,
	option concrete-expr,
	then root-local-and-expr,
	else_ concrete-expr,
)
	else_.type, range, (option gen-if-option-kind then, else_)
-gen-if-option-kind concrete-expr-kind(
	option concrete-expr,
	then root-local-and-expr,
	else_ concrete-expr,
)
	cases concrete-match-union-case[] = ((), else_), (then.root-local, then.expr)
	(option match-union-concrete-expr 2.integral-values-range, cases, ())

-concretize-literal-string-like concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	kind string-like-type,
	value string,
)
	match kind
	as char8-array
		ctx.concretize-ctx gen-char8-array range, value
	as char32-array
		ctx.concretize-ctx gen-char32-array range, value
	as c-string
		type, range, (ctx.concretize-ctx constant-c-string value).to
	as js-any
		type, range, (ctx.concretize-ctx gen-string-literal-kind range, value)
	as string
		ctx.concretize-ctx gen-string-literal range, value
	as symbol
		type, range, (ctx.concretize-ctx constant-symbol value.to).to

-concretize-local-get concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	local local,
)
	match ctx.locals[local]!
	as concrete-local x
		get = range gen-local-get x
		if x.type is-bogus
			ctx concretize-bogus type, range
		elif ctx is-allocated local
			ctx.concretize-ctx gen-reference-read range, get
		else
			get
	as typed-constant x
		type, range, x.value.to

-concretize-ptr-to-local concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a local-pointer-expr,
)
	guard ctx is-native : ctx concretize-bogus type, range # TODO: We should never get here unless native ...........................
	match ctx.locals[a local]!
	as concrete-local local
		if ctx is-allocated a.local
			type gen-record-field-pointer range, (range gen-local-get local), 0
		else
			type gen-local-pointer range, local
	as typed-constant x
		type gen-constant range, x.value

-concretize-local-set concrete-expr(
	ctx concretize-expr-ctx,
	range uri-and-range,
	local local,
	value expr,
)
	concrete-local = ctx.locals[local]! concrete-local!
	value-type = if ctx is-allocated local
		ctx.concretize-ctx get-referenced-type concrete-local.type
	else
		concrete-local.type
	concrete-value = ctx concretize-expr value-type, value
	if ctx is-allocated local
		ctx.concretize-ctx gen-reference-write range, (range gen-local-get concrete-local), concrete-value
	else
		ctx.concretize-ctx gen-local-set range, concrete-local, concrete-value

-concretize-loop-while-or-until concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	expr loop-while-or-until-expr,
)
	assert ctx.void-type is-void # TODO: sanity check -------------------------------------------------------------------------------
	void = ctx.concretize-ctx gen-void range
	match expr condition
	as expr x
		###
		while cond
			body
		after
		==>
		loop
			if cond
				body
				continue
			else
				break
		after
		###
		condition = ctx concretize-expr ctx.bool-type, x
		assert void.type is-void # TODO: sanity check -------------------------------------------------------------------------------
		body = ctx concretize-expr void.type, expr.body
		assert body.type is-void # TODO: sanity check -------------------------------------------------------------------------------
		do-and-continue = void.type gen-do-and-continue range, body
		break_ = range gen-break void
		if_ = if expr is-until
			range gen-if condition, break_, do-and-continue
		else
			range gen-if condition, do-and-continue, break_
		loop_ = void.type gen-loop range, if_
		range gen-seq loop_, (ctx concretize-expr type, expr.after)
	as unpack-option unpack
		option = ctx concretize-expr unpack.option
		if expr is-until
			after = ctx concretize-expr-with-destructure type, range, unpack.destructure, expr.after
			body = ctx concretize-expr void.type, expr.body
			if root ?= after root-local
				###
				until x ?= xs
					body
				after
				==>
				x = loop
					if temp ?= xs
						break temp
					else
						body
						continue
				after
				###
				temp concrete-local = ctx.local-ids.take-next-id, root.source, root.type
				break_ = range gen-break (range gen-local-get temp)
				if_ = range gen-if-option option, ((temp,), break_), (root.type gen-do-and-continue range, body)
				loop_ = root.type gen-loop range, if_
				type gen-let range, root, loop_, after.expr
			else
				###
				until _ ?= xs
					body
				after
				=>
				loop
					if _ ?= xs
						break
					else
						body
						continue
				after
				###
				if_ = range gen-if-option option, ((), (range gen-break void)), (void.type gen-do-and-continue range, body)
				loop_ = void.type gen-loop range, if_
				range gen-seq loop_, after.expr
		else
			###
			while x ?= xs
				body
			after
			==>
			loop
				if x ?= xs
					body
					continue
				else
					break
			after
			###
			body = ctx concretize-expr-with-destructure void.type, range, unpack.destructure, expr.body
			if_ = range gen-if-option option, (body.root-local, (void.type gen-do-and-continue range, body.expr)), (range gen-break void)
			loop_ = void.type gen-loop range, if_
			range gen-seq loop_, (ctx concretize-expr type, expr.after)

-concretize-match-enum concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a match-enum-expr,
)
	guard a.cases !is-empty : ctx concretize-bogus type, range
	matched = ctx concretize-expr a.matched
	values-unsorted integral-value[] = for x : a cases; x.member value
	# TODO: If matched is a constant, just compile the relevant case
	cases-unsorted concrete-expr[] = for value : values-unsorted
		case_ = a.cases find! x => x.member.value == value
		ctx concretize-expr type, case_.then
	else_ concrete-expr? = if x ?= a else_
		(ctx concretize-expr type, x),
	values, cases = values-unsorted sort-by-first cases-unsorted
	type gen-match-enum-or-integral range, matched, values, cases, else_

-concretize-match-integral concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a match-integral-expr,
)
	matched = ctx concretize-expr a.matched
	values-unsorted integral-value[] = for x : a cases; x value
	# TODO: If matched is a constant, just compile the relevant case
	cases-unsorted concrete-expr[] = for value : values-unsorted
		case_ = a.cases find! x => x.value == value
		ctx concretize-expr type, case_.then
	else_ = ctx concretize-expr type, a.else_
	values, cases = values-unsorted sort-by-first cases-unsorted
	type gen-match-enum-or-integral range, matched, values, cases, (else_,)

-concretize-match-string-like concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a match-string-like-expr,
)
	guard equals ?= ctx get-concrete-fun-from-called a.equals : ctx concretize-bogus type, range
	matched = ctx concretize-expr a.matched
	cases concrete-match-string-like-case[] = for case_ : a cases
		value = ctx concretize-literal-string-like matched.type, range, a.string-type, case_.value
		value, (ctx concretize-expr type, case_.then)
	else_ = ctx concretize-expr type, a.else_
	type, range, (matched match-string-like-concrete-expr equals, cases, else_)

-concretize-match-sum-type concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a match-sum-type-expr,
)
	guard a.cases !is-empty : ctx concretize-bogus type, range
	matched = ctx concretize-expr a.matched
	values, cases = ctx concretize-match-sum-type-cases type, range, matched.type, a.cases
	else_ concrete-expr? = if x ?= a else_
		(ctx concretize-expr type, x),
	type, range, (matched match-union-concrete-expr values, cases, else_)
-concretize-match-sum-type-cases (integral-values, concrete-match-union-case[])(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	variant-type concrete-type,
	cases match-sum-type-case[],
)
	values integral-values = for x : cases
		ctx member-index-for-match-sum-type-case variant-type, x
	concrete-cases concrete-match-union-case[] = for value : values
		case_ = cases find! x => (ctx member-index-for-match-sum-type-case variant-type, x) == value
		then = ctx concretize-expr-with-destructure type, range, case_.destructure, case_.then
		then to-match-union-case
	values sort-by-first concrete-cases
-to-match-union-case concrete-match-union-case(a root-local-and-expr) # TODO: should these be the same type? ----------------------
	a.root-local, a.expr
-member-index-for-match-sum-type-case integral-value(
	ctx concretize-expr-ctx,
	variant-type concrete-type,
	a match-sum-type-case,
)
	(ctx.concretize-ctx ensure-sum-type-case variant-type, (ctx get-concrete-type a.destructure.type)),

-concretize-variable-ref-for-closure concrete-expr(
	ctx concretize-expr-ctx,
	range uri-and-range,
	a variable-ref,
)
	match a
	as local x
		match ctx.locals[x]!
		as concrete-local local
			# If it's a reference, leave it that way
			range gen-local-get local
		as typed-constant constant
			constant.type gen-constant range, constant.value
	as closure-ref x
		ctx get-closure-field range, x

-concretize-assert-or-forbid concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a assert-or-forbid-expr,
)
	default-thrown concrete-expr mut() = () =>
		message = ctx.cur-uri default-assert-or-forbid-message a, ctx.concretize-ctx.file-content-getters
		ctx.concretize-ctx gen-error range, message
	throw-no-destructure concrete-expr mut() = () =>
		type gen-throw range, if x ?= a thrown
			ctx concretize-expr ctx.concretize-ctx.exception-type, x
		else
			default-thrown[]
	match a condition
	as expr x
		condition = ctx concretize-expr ctx.bool-type, x
		if constant ?= condition.kind constant
			if constant.as-bool xor a.is-forbid
				ctx concretize-expr type, a.after
			else
				throw-no-destructure[]
		else
			throw_ = throw-no-destructure[]
			after = ctx concretize-expr type, a.after
			type, range, if a is-forbid
				condition if-concrete-expr throw_, after
			else
				condition if-concrete-expr after, throw_
	as unpack-option x
		option = ctx concretize-expr x.option
		if a is-forbid
			thrown = if thrown ?= a thrown
				ctx concretize-expr-with-destructure ctx.concretize-ctx.exception-type, range, x.destructure, thrown
			else
				(), default-thrown[]
			after = ctx concretize-expr type, a.after
			range gen-if-option option, (thrown.root-local, (type gen-throw range, thrown.expr)), after
		else
			then = ctx concretize-expr-with-destructure type, range, x.destructure, a.after
			range gen-if-option option, then, throw-no-destructure[]

-concretize-expr concrete-expr(ctx concretize-expr-ctx, a expr)
	type = ctx get-concrete-type (a type (ctx.common-types,))
	ctx concretize-expr type, a

-concretize-expr concrete-expr(ctx concretize-expr-ctx, type concrete-type, a expr)
	range uri-and-range = ctx.cur-uri, a.range
	guard type !is-bogus : ctx concretize-bogus type, range
	match a
	as assert-or-forbid-expr x
		ctx concretize-assert-or-forbid type, range, x
	as bogus-call-expr _
		ctx concretize-bogus type, range
	as bogus-expr _
		ctx concretize-bogus type, range
	as bogus-wrong-type-expr _
		ctx concretize-bogus type, range
	as call-expr x
		ctx concretize-call type, range, x
	as call-option-expr x
		ctx concretize-call-option type, range, x
	as closure-get-expr x
		ctx concretize-closure-get type, range, x
	as closure-set-expr x
		ctx concretize-closure-set type, range, x
	as extern-expr x
		type, range, (x.names is-subset-of ctx.concretize-ctx.all-externs).constant-bool.to
	as finally-expr x
		ctx concretize-finally type, range, x
	as fun-pointer-expr x
		ctx concretize-fun-pointer type, range, x
	as if-expr x
		ctx concretize-if type, range, x
	as lambda-expr x
		ctx concretize-lambda type, range, x
	as let-expr x
		ctx concretize-let type, range, x
	as literal-float-expr x
		type gen-constant range, x.value.constant-float	
	as literal-integral-expr x
		type gen-constant range, x.value.to
	as literal-string-like-expr x
		ctx concretize-literal-string-like type, range, x.string-type, x.value
	as local-get-expr x
		ctx concretize-local-get type, range, x.local
	as local-pointer-expr x
		ctx concretize-ptr-to-local type, range, x
	as local-set-expr x
		ctx concretize-local-set range, x.local, x.value
	as loop-expr x
		type gen-loop range, (ctx concretize-expr type, x.body)
	as loop-break-expr x
		range gen-break (ctx concretize-expr type, x.value)
	as loop-continue-expr _
		type gen-continue range
	as loop-while-or-until-expr x
		ctx concretize-loop-while-or-until type, range, x
	as match-enum-expr x
		ctx concretize-match-enum type, range, x
	as match-integral-expr x
		ctx concretize-match-integral type, range, x
	as match-string-like-expr x
		ctx concretize-match-string-like type, range, x
	as match-sum-type-expr x
		ctx concretize-match-sum-type type, range, x
	as record-field-pointer-expr x
		assert ctx is-native
		target = ctx concretize-expr x.target
		type gen-record-field-pointer range, target, x.field-index
	as seq-expr x
		first = ctx concretize-expr ctx.void-type, x.first
		then = ctx concretize-expr type, x.then
		if _ ?= first.kind constant
			then
		else
			type, range, (first seq-concrete-expr then)
	as throw-expr x
		thrown = ctx concretize-expr ctx.concretize-ctx.exception-type, x.thrown
		type, range, thrown.throw-concrete-expr
	as trusted-expr x
		ctx concretize-expr type, x.inner
	as try-expr x
		ctx concretize-try type, range, x
	as try-let-expr x
		ctx concretize-try-let type, range, x
	as typed-expr x
		ctx concretize-expr type, x.inner

# TODO: this returns an array with a single array in it, why was I doing this? ------------------------------------------------------
-constants-or-exprs-arr constants-or-exprs(
	ctx concretize-expr-ctx,
	range uri-and-range,
	array-type concrete-type,
	args constants-or-exprs,
)
	match args
	as constants constants
		array = ctx.all-constants get-constant-array array-type.must-be-by-val, constants.constants
		(array,) constants
	as exprs exprs
		array concrete-expr = array-type, range, exprs.exprs.create-array-concrete-expr
		(array,) exprs

-try-eval-constant constant?(ctx concretize-ctx, fn concrete-fun, args constant[], version version-info)
	only-type-arg concrete-type mut() = () =>
		fn.source.concrete-fun-source-regular!.type-args only
	match fn body
	as concrete-fun-body-builtin builtin_
		match builtin_ kind
		as version-fun x
			assert args is-empty
			(version is-version x).constant-bool,
		as builtin-binary x
			x try-eval-constant-binary args.only2
		as builtin-binary-lazy x
			(x eval-constant-binary-lazy args.only2),
		as builtin-unary x
			x try-eval-constant-unary args.only
		as builtin-fun-is-empty-type
			only-type-arg[].struct.is-empty-struct.to.integral-value,
		as builtin-fun-size-of
			assert args is-empty
			if only-type-arg[] is-known-empty-type
				0.integral-value,
		as builtin-fun-gc-safe-value
			throw unreachable # compiles to a constant
		else
			()
	as concrete-fun-body-extern _
		()
	as concrete-expr x
		ctx eval-as-constant fn, x, args
	as concrete-fun-body-method _
		()
	as concrete-fun-body-var-get _
		()
	as concrete-fun-body-var-set _
		()
	as concrete-fun-body-deferred _
		()
-eval-as-constant constant?(ctx concretize-ctx, fn concrete-fun, a concrete-expr, fn-args constant[]) # TODO: It would be better to have a full AST interpreter
	match a kind
	as constant x
		x,
	as create-record-concrete-expr x
		unless a.type.struct.body.concrete-record! is-some-field-mutable
			if args ?= for arg : x.args map-or-none; ctx eval-as-constant fn, arg, fn-args
				(ctx.all-constants get-constant-record a.type, args),
	# TODO: unions ----------------------------------------------------------------------------------------------------------------------------------------------
	as local-get-concrete-expr x
		assert index ?= fn.params index-of x.local
		fn-args[index],
	else
		()

-is-known-empty-type bool(a concrete-type)
	a.struct.type-size-is-set && a is-empty-type

-eval-constant-binary-lazy constant(fn builtin-binary-lazy, (arg0 constant, arg1 constant))
	match fn
	as bool-and
		(arg0.as-bool && arg1.as-bool) constant-bool
	as bool-or
		(arg0.as-bool || arg1.as-bool) constant-bool
	as option-or
		throw todo
	as option-question-2
		throw todo
-try-eval-constant-binary constant?(fn builtin-binary, (arg0 constant, arg1 constant))
	match fn
	as equal-nat64
		(arg0.as-nat64 == arg1.as-nat64).constant-bool,
	else
		()
-try-eval-constant-unary constant?(fn builtin-unary, arg constant)
	match fn
	as not
		(!arg.as-bool).constant-bool,
	else
		()

-concretize-finally concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a finally-expr,
)
	right = ctx concretize-expr ctx.void-type, a.right
	below = ctx concretize-expr type, a.below
	type, range, (right finally-concrete-expr below)

-concretize-try concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a try-expr,
)
	tried = ctx concretize-expr type, a.tried
	values, cases = ctx concretize-match-sum-type-cases type, range, ctx.concretize-ctx.exception-type, a.catches
	type, range, (tried try-concrete-expr values, cases)

-concretize-try-let concrete-expr(
	ctx concretize-expr-ctx,
	type concrete-type,
	range uri-and-range,
	a try-let-expr,
)
	###
	try x, y = some-pair catch foo : caught
	then
	==>
	try pair = some-pair catch foo : caught
	x, y = pair
	then
	###
	local-type = ctx get-concrete-type a.destructure.type
	value = ctx concretize-expr local-type, a.value
	catch-member-index = ctx member-index-for-match-sum-type-case ctx.concretize-ctx.exception-type, a.catch_
	catch-expr = ctx concretize-expr-with-destructure type, range, a.catch_.destructure, a.catch_.then to-match-union-case
	then = ctx concretize-expr-with-destructure type, range, a.destructure, a.then
	type, range, (then.root-local try-let-concrete-expr value, catch-member-index, catch-expr, then.expr)
