import
	../../crow/col/sort: sort-by-first
	../frontend/show-model
	../model/concrete-model
	../model/model
	../model/show-concrete-model
	../model/source-range
	../util/util
	./all-constants-builder
	./concretize-auto-fun
	./concretize-ctx
	./concretize-expr-ctx
	./generate

fun-body-decl fun-body(fun concrete-fun)
	fun.source.concrete-fun-source-regular!.decl body

# Fills in simple function bodies
quick-fill-in-concrete-fun-body void(ctx concretize-ctx, cf concrete-fun)
	assert _ ?= cf.body concrete-fun-body-deferred
	fun-body = cf fun-body-decl
	return-type = cf return-type
	range = cf range
	concrete-params = cf params
	cf.body := match fun-body
	as fun-body-bogus
		ctx gen-bogus return-type, range
	as fun-body-extern-java x
		x
	as auto-fun x
		ctx concretize-auto-fun cf, x
	as builtin-fun x
		ctx concretize-builtin-fun cf, x
	as create-enum-or-flags x
		return-type gen-constant range, x.member.value
	as create-record _
		if concrete-params is-empty and return-type.body.concrete-record! !prevent-constant
			constant = ctx.all-constants get-constant-record return-type, ()
			return-type concrete-expr range, constant
		else
			ctx gen-create-record return-type, range, for param in concrete-params
				range gen-local-get param
	as expr _
		concrete-fun-body-deferred
	as fun-body-file-import x
		ctx concretize-file-import cf, x
	as flags-function x
		ctx concretize-flags-function cf, x
	as fun-body-method x
		if ctx preserve-methods
			ctx.sum-type-to-methods ensure cf.params[0].type ~= cf
			x.method-index concrete-fun-body-method
		else
			ctx.deferred-methods ~= cf
			concrete-fun-body-deferred
	as record-field-get x
		record_ = range gen-local-get concrete-params.only
		index = record_.type field-index-from-field x.field
		ctx gen-record-field-get return-type, range, record_, index
	as record-field-set x
		param0, param1 = concrete-params only2
		p0 = range gen-local-get param0
		p1 = range gen-local-get param1
		index = p0.type field-index-from-field x.field
		ctx gen-record-field-set range, p0, index, p1
	as sum-type-member-get
		case_ = ctx sum-type-case-index concrete-params.only.type, (ctx unwrap-option-type return-type)
		ctx gen-union-member-get cf, case_
	as var-get x
		assert concrete-params is-empty
		expr = ctx get-var x.var var-get-concrete-expr
		return-type, range, expr
	as var-set x
		value = range gen-local-get concrete-params.only
		return-type, range, do ctx get-var x.var var-set-concrete-expr value
	as fun-body-uninitialized
		throw unreachable

-concretize-builtin-fun concrete-fun-body(ctx concretize-ctx, cf concrete-fun, a builtin-fun)
	return-type = cf return-type
	range = cf range
	type-args concrete-type[] data() = of
		cf.source.concrete-fun-source-regular! type-args
	match a
	as builtin-fun-constant x
		return-type gen-constant range, do ctx to-constant return-type, x
	as builtin-fun-is-empty-type _
		constant constant = type-args[].only.is-empty-type.to::scalar-value
		return-type concrete-expr range, constant
	else
		a concrete-fun-body-builtin type-args[]
-to-constant constant(ctx concretize-ctx, type concrete-type, a builtin-fun-constant)
	match a
	as bool x
		x.to::scalar-value
	as float x
		x.to::scalar-value
	as builtin-fun-constant-empty-option
		ctx gen-constant-none type
	as builtin-fun-constant-gc-safe-value
		constant-gc-safe-value

-concretize-file-import concrete-expr(ctx concretize-ctx, cf concrete-fun, import_ fun-body-file-import)
	cf.return-type, cf.range, match import_ type
	as nat8-array
		ctx constant-of-bytes cf.return-type, import_.content
	as string
		ctx gen-string-literal-kind import_.content.as-string

get-var concrete-var(ctx concretize-ctx, decl var-decl)
	ctx.concrete-var-lookup ensure decl, of
		type = ctx get-concrete-type decl.type, ()
		expr-ctx concretize-expr-ctx =
			concretize-ctx: ctx
			cur-uri: decl module-uri
			type-scope: ()
			specs-scope: ()
		decl, do expr-ctx concretize-expr type, decl.initializer

concretize-fun-body concrete-expr(ctx concretize-ctx, cf concrete-fun, expr expr)
	params = match cf source
	as concrete-fun-source-regular x
		x.decl params
	as concrete-fun-source-test _
		()
	as concrete-fun-source-wrap-main _
		throw unreachable
	expr-ctx concretize-expr-ctx = ctx, cf
	# Ignore closure param, which is never destructured.
	concrete-params = cf.params[(params.size + 1 == cf.params.size).to .. end]
	type = cf return-type
	for param, concrete-param in params zip concrete-params
		expr-ctx begin-param-destructure param, concrete-param
	res mut = expr-ctx concretize-expr type, expr
	for param, concrete-param in params zip concrete-params
		res := expr-ctx end-param-destructure type, (expr-ctx to-uri-and-range param.range), param, concrete-param, res
	res

-concretize-bogus concrete-expr(ctx concretize-expr-ctx, type concrete-type, range uri-and-range)
	ctx.concretize-ctx gen-bogus type, range

-with-temp-if-necessary concrete-expr(range uri-and-range, value concrete-expr, f concrete-expr mut(get-temp concrete-expr))
	if get ?= value.kind local-get-concrete-expr and get.local !is-mutable
		f[value]
	else
		temp concrete-local = member, value.type
		res = f[range gen-local-get temp]
		res.type gen-let range, temp, value, res

-concretize-call concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a call-expr
do
	guard concrete-called ?= ctx get-concrete-fun-from-called a.called else
		ctx concretize-bogus type, range
	if concrete-called is-array-op # TODO: it's a bit wasteful to give the function a body in get-concrete-fun-from-called only to ignore it here ....
		input-arg, lambda-arg = a.args only2
		input = ctx concretize-expr concrete-called.params[0].type, input-arg
		in-element-type = if input.type is-range then input.type range-element-type else input.type array-element-type
		out-element-type = if type is-void then type else type array-element-type
		empty-out-array constant-array? = unless type is-void
			ctx.all-constants get-constant-array type, () constant-array!
		match lambda-arg
		as lambda-expr l
			forbid _ ?= l.mut-type-for-explicit-shared # This won't happen because 'for-loop' takes a 'mut' lambda
			rg uri-and-range = ctx.cur-uri, lambda-arg.range
			body = ctx concretize-with-destructure out-element-type, rg, l.param, of
				ctx concretize-expr out-element-type, l.body
			type, range, (input array-op-concrete-expr body.local, empty-out-array, body.expr)
		else
			lambda-type = concrete-called.params[1].type
			lambda = ctx concretize-expr lambda-type, lambda-arg
			range with-temp-if-necessary lambda, of get-lambda
				in-element concrete-local = member, in-element-type # TODO: use a new kind, not 'member' ----------------------------
				body = builtin-fun-call-lambda builtin-concrete-expr (out-element-type, in-element-type),
					- get-lambda
					- range gen-local-get in-element
				type, range,
					input array-op-concrete-expr in-element, empty-out-array, (out-element-type, range, body)
	else
		# Since 'list-new' is allowed to implement the 'new' spec, we need to support those here
		args concrete-expr[] = if a.args.size == 0 and concrete-called is-list-new
			array-type = concrete-called.params.only.type
			empty-array = ctx.all-constants get-constant-array array-type, ()
			- array-type, range, empty-array
		else
			for i in 0 .. a.args.size
				ctx concretize-expr concrete-called.params[i].type, a.args[i]
		if concrete-called is-not and constant ?= args.only.kind constant
			concrete-called.return-type, range, do !constant.as-bool to
		else
			# We need to widen again even though it was done already in 'concretize-expr',
			# because we may be calling a spec-impl that has a narrower type than the spec.
			# (The call expr's type can't reflect this and uses the spec's declared type.)
			concrete-called.return-type, range, if builtin_ ?= concrete-called.body concrete-fun-body-builtin
				builtin_.kind builtin-concrete-expr builtin_.type-args, args
			else
				concrete-called call-concrete-expr args

-is-list-new bool(a concrete-fun)
	a.name == "list-new" and a.params.size == 1 and a.params.only.type is-array

-concretize-call-named-new concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a call-named-new-expr
do
	guard concrete-called ?= ctx get-concrete-fun-from-called a.called else
		ctx concretize-bogus type, range
	p0, p1 = concrete-called.params only2
	symbol-array-type = p0 type
	arg-array-type = p1 type
	symbols constant[] = for x in a names
		ctx.concretize-ctx constant-symbol x
	symbol-array concrete-expr = symbol-array-type, range, do ctx.all-constants get-constant-array symbol-array-type, symbols
	arg-type = ctx get-concrete-type-for a.args[0]
	args concrete-expr[] = for arg in a args
		ctx concretize-expr arg-type, arg
	symbols.size is args.size
	args-array concrete-expr = arg-array-type, range, args.create-array-concrete-expr
	concrete-called.return-type, range,
		concrete-called call-concrete-expr (symbol-array, args-array)

-is-not bool(a concrete-fun)
	guard b ?= a.body concrete-fun-body-builtin
	guard u ?= b.kind builtin-unary
	u == not

-is-array-op bool(a concrete-fun)
	# TODO: make sure this is the one in collection.crow and all the spec impls are as expected ------------------------
	guard a.name == "for-loop"
	guard a.return-type is-void or a.return-type is-array-or-mut-array
	guard a.params.size == 2
	input = a.params[0]
	guard input.type is-range or input.type is-array-or-mut-array
	guard _ ?= a.params[1].type as-lambda-type
	true

-is-range bool(a concrete-type)
	guard inst ?= a.source concrete-type-source-inst
	decl = inst decl
	# TODO: base this on more than just the name ... uri too? -------------------------------------------------------------------
	decl.name == "range"

-concretize-call-option concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a call-option-expr
do
	# `a ?foo` ==> `if x ?= a then a foo else ()`
	# But `a foo` may already be an option and might not need to be wrapped
	guard called ?= ctx get-concrete-fun-from-called a.called else ctx concretize-bogus type, range
	local concrete-local = destruct::concrete-generated-local-kind, called.params[0].type
	option = ctx concretize-expr a.first-arg
	call = range gen-call called,
		- range gen-local-get local
		-- for i, x in a.rest-args with-index
			ctx concretize-expr called.params[i + 1].type, x
	wrapped = if call.type == type
		call
	else
		ctx.concretize-ctx gen-option type, range, call
	assert wrapped.type == type
	range gen-if-option option, (local, wrapped), if type is-void
		ctx.concretize-ctx gen-void range
	else
		ctx.concretize-ctx gen-empty-option type, range

-concretize-lambda concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	e lambda-expr
do
	return-type = ctx get-concrete-type e.return-type
	guard return-type !is-bogus else ctx concretize-bogus type, range
	param-type = ctx get-concrete-type e.param.type
	body = ctx concretize-expr-with-destructure return-type, range, e.param, e.body
	param = body local else args::concrete-generated-local-kind, param-type
	closure concrete-local[] = for* x in e closure
		ctx.locals[x]!.concrete-local from-option
	need-wrap = ctx !is-js and e.kind == explicit-shared
	lambda-type = if need-wrap
		ctx get-concrete-type e.mut-type-for-explicit-shared!
	else
		type
	lambda concrete-expr = lambda-type, range, (closure lambda-concrete-expr param, body.expr)
	# TODO: given that 'shared' just converts a mut lambda to shared,
	# it might make more sense to have it be a separate expression that wraps the lambda
	if need-wrap
		decl = ctx.concretize-ctx.program.common-funs shared-of-mut-lambda
		fun = ctx.concretize-ctx get-concrete-fun decl, (return-type, param-type), ()
		range gen-call fun, (lambda,)
	else
		lambda

-concretize-let concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	e let-expr
do
	local-type = ctx get-concrete-type e.destructure.type
	value = ctx concretize-expr local-type, e.value
	ctx concretize-with-destructure-and-let type, range, e.destructure, value, of
		ctx concretize-expr type, e.then_

-concretize-list concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a list-expr
do
	guard called ?= ctx get-concrete-fun-from-called a.called else
		ctx concretize-bogus type, range
	array-type = ctx get-concrete-type a.array-type
	called.return-type, range,
		called call-concrete-expr
			- ctx concretize-list-inner array-type, range, a.parts

-concretize-list-inner concrete-expr
	ctx concretize-expr-ctx
	array-type concrete-type
	range uri-and-range
	parts list-expr-part[]
do
	element = array-type array-element-type
	arrays concrete-expr mut[] = ()
	cur-list concrete-expr mut[] = ()
	finish-list void mut() = of
		arrays ~= array-type, range, cur-list.move-to.create-array-concrete-expr
	for part in parts
		match part
		as expr x
			cur-list ~= ctx concretize-expr element, x
		as list-expr-part-multi x
			finish-list[]
			arrays ~= ctx concretize-expr array-type, x.arg
	finish-list[]

	finished-arrays concrete-expr[] = arrays move-to
	res mut = finished-arrays[0]
	for x in finished-arrays[1 .. end]
		res := ctx.concretize-ctx gen-concat-array range, res, x
	res

-concretize-expr-with-opt-destructure concrete-local-and-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-else
do
	if d ?= a destructure
		ctx concretize-with-destructure type, range, d, of
			ctx concretize-expr type, a.then_
	else
		(), do ctx concretize-expr type, a.then_
-concretize-expr-with-destructure concrete-local-and-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	expr expr
do
	ctx concretize-with-destructure type, range, destructure, of
		ctx concretize-expr type, expr

-concretize-with-destructure-and-let concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	value concrete-expr
	f concrete-expr mut()
do
	ctx.concretize-ctx use-root-local value,
		ctx concretize-with-destructure type, range, destructure, f
-use-root-local concrete-expr
	ctx concretize-ctx
	value concrete-expr
	then_ concrete-local-and-expr
do
	expr = then_ expr
	if root ?= then_ local
		expr.type gen-let expr.range, root, value, expr
	elif _ ?= value.kind constant
		then_ expr
	else
		ctx gen-drop-then expr.range, value, expr

-concretize-with-destructure concrete-local-and-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	f concrete-expr mut()
do
	ctx begin-destructure destructure
	res = f[]
	ctx end-destructure type, range, destructure, res

-begin-destructure void(ctx concretize-expr-ctx, destructure destructure)
	match destructure
	as destructure-ignore _
		()
	as local local
		root-local concrete-local = local, do ctx get-concrete-type local.type
		ctx.locals[local] := if ctx is-allocated local
			reference-type = ctx get-concrete-type local.closure-reference-type!
			local.concrete-local-source-reference, reference-type
		else
			root-local
	as destructure-split x
		if x is-valid-destructure ctx.common-types
			for part in x parts
				ctx begin-destructure part
-begin-param-destructure void(ctx concretize-expr-ctx, destructure destructure, concrete-param concrete-local)
	match destructure
	as destructure-ignore _
		()
	as local local
		ctx.locals[local] := concrete-param
	as destructure-split _
		ctx begin-destructure destructure
-end-destructure concrete-local-and-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	expr concrete-expr
do
	match destructure
	as destructure-ignore _
		(), expr
	as local local
		concrete-local = ctx.locals remove! local concrete-local!
		if ctx is-allocated local
			root-local concrete-local = local, do ctx get-concrete-type local.type
			value = ctx.concretize-ctx gen-reference-create concrete-local.type, range,
				range gen-local-get root-local
			- root-local
			- type gen-let range, concrete-local, value, expr
		else
			concrete-local, expr
	as destructure-split x
		if x is-valid-destructure ctx.common-types
			root-local concrete-local = destruct, do ctx get-concrete-type destructure.type
			- root-local
			- ctx end-destructure-split type, range, expr, x, root-local
		else
			- ()
			- ctx concretize-bogus type, range
-end-param-destructure concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	root-local concrete-local
	expr concrete-expr
do
	match destructure
	as destructure-ignore _
		expr
	as local x
		forbid ctx is-allocated x
		expr
	as destructure-split x
		ctx end-destructure-split type, range, expr, x, root-local
-end-destructure-split concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	expr concrete-expr
	x destructure-split
	root-local concrete-local
do
	# TODO: we should detect this earlier and make the entire expression fail
	guard x is-valid-destructure ctx.common-types else ctx concretize-bogus type, range
	get-root-local = range gen-local-get root-local
	res mut = expr
	for part-index, part in x.parts with-index
		part-range = ctx to-uri-and-range part.range
		value-type = root-local.type.body.concrete-record!.fields[part-index] type
		assert value-type == (ctx get-concrete-type part.type)
		its-value = ctx.concretize-ctx gen-record-field-get value-type, part-range, get-root-local, part-index
		its-local-and-expr = ctx end-destructure type, part-range, part, res
		res := its-local-and-expr expr
		if l ?= its-local-and-expr local
			res := type gen-let part-range, l, its-value, res
	res

-is-allocated bool(ctx concretize-expr-ctx, a local)
	a is-mutable and a is-used-in-closure and ctx allocate-mutable-closure-variables

-concretize-if concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a if-expr
do
	true-branch concrete-expr mut() = of then ctx concretize-expr type, a.true-branch
	false-branch concrete-expr mut() = of then ctx concretize-expr type, a.false-branch
	ctx concretize-if type, (a type ctx.available-types), range, a.condition, true-branch, false-branch

-concretize-if concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	model-type type
	range uri-and-range
	condition expr
	cb-true-branch concrete-expr mut()
	cb-false-branch concrete-expr mut()
do
	if unpack ?= condition unpack-option
		option = ctx concretize-expr unpack.option
		true-branch = ctx concretize-with-destructure type, range, unpack.destructure, cb-true-branch
		false-branch = cb-false-branch[]
		range gen-if-option option, true-branch, false-branch
	elif condition.condition-destructures is-empty
		cond = ctx concretize-expr ctx.bool-type, condition
		if constant ?= cond.kind constant
			if constant as-bool then cb-true-branch[] else cb-false-branch[]
		else
			type, range, do cond if-concrete-expr cb-true-branch[], cb-false-branch[]
	else
		###
		For a complex condition like:
			if x ?= o1 and y ?= o2
				true-branch
			else
				false-branch

		It will compile to:
			result t? = if x ?= o1
				if y ?= o2
					true-branch
			result else false-branch

		This strategy avoids repeating 'false-branch' twice.
		The function concretize-complex-condition just handles the true part of this.
		###
		option-type = ctx get-concrete-type ctx.common-types.option[model-type as-type-args]
		true-branch concrete-expr mut() = of
			true_ = cb-true-branch[]
			if _ ?= true_.kind throw-concrete-expr
				# Avoid wrapping a 'throw' expression in an option, since the JVM complains about unreachable code
				option-type, range, true_.kind
			else
				ctx.concretize-ctx gen-option option-type, range, true_
		option-true-branch = ctx concretize-complex-condition option-type, range, condition, true-branch, of
			ctx.concretize-ctx gen-empty-option option-type, range
		ctx.concretize-ctx gen-option-else type, range, option-true-branch, cb-false-branch[]

###
WARN: This duplicates 'false-branch'.
Compiles to code like:
	if x ?= expr1
		if y ?= expr2
			true-branch
		else
			false-branch
	else
		false-branch
###
| WARN: This duplicates the false branch.
-concretize-complex-condition concrete-expr
	ctx concretize-expr-ctx
	result-type concrete-type
	range uri-and-range
	a expr
	true-branch concrete-expr mut()
	false-branch concrete-expr mut()
do
	if x ?= a logical-expr and x.kind == bool-and-bool
		inner concrete-expr mut() = of
			ctx concretize-complex-condition result-type, range, x.right, true-branch, false-branch
		ctx concretize-complex-condition result-type, range, x.left, inner, false-branch
	elif unpack ?= a unpack-option
		option = ctx concretize-expr unpack.option
		true_ = ctx concretize-with-destructure result-type, range, unpack.destructure, true-branch
		range gen-if-option option, true_, false-branch[]
	else
		condition = ctx concretize-expr ctx.bool-type, a
		range gen-if condition, true-branch[], false-branch[]

-gen-option-else concrete-expr(ctx concretize-ctx, type concrete-type, range uri-and-range, option concrete-expr, else_ concrete-expr)
	local concrete-local = member::concrete-generated-local-kind, option.type.unwrap-option-type!
	get-local concrete-expr = ctx may-widen-type type, do range gen-local-get local
	range gen-if-option option, (local, get-local), else_

-gen-if-option concrete-expr
	range uri-and-range
	option concrete-expr
	then_ concrete-local-and-expr
	else_ concrete-expr
do
	else_.type, range, do option gen-if-option-kind then_, else_
-gen-if-option-kind concrete-expr-kind
	option concrete-expr
	then_ concrete-local-and-expr
	else_ concrete-expr
do
	cases concrete-local-and-expr[] =
		- (), else_
		- then_.local, then_.expr
	option match-union-concrete-expr (0 .. 2).to, cases, ()

-concretize-literal-string-like concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	kind string-like-type
	value string
do
	match kind
	as char8-array
		ctx.concretize-ctx gen-char8-array range, value
	as char32-array
		ctx.concretize-ctx gen-char32-array range, value
	as java-String
		type, range, value.constant-native-string
	as js-any
		type, range, value.constant-native-string
	as string
		ctx.concretize-ctx gen-string-literal range, value
	as symbol
		type, range, do ctx.concretize-ctx constant-symbol value.to
	as json
		type, range, do ctx.concretize-ctx constant-json-string value

-concretize-local-get concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	local local
do
	match ctx.locals[local]!
	as concrete-local x
		get = range gen-local-get x
		if x.type is-bogus
			ctx concretize-bogus type, range
		elif ctx is-allocated local
			ctx.concretize-ctx gen-reference-read range, get
		else
			get
	as typed-constant x
		type, range, x.value

-concretize-local-set concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	local local
	value expr
do
	concrete-local = ctx.locals[local]! concrete-local!
	value-type = if ctx is-allocated local
		ctx.concretize-ctx get-referenced-type concrete-local.type
	else
		concrete-local.type
	concrete-value = ctx concretize-expr value-type, value
	if ctx is-allocated local
		ctx.concretize-ctx gen-reference-write range, (range gen-local-get concrete-local), concrete-value
	else
		ctx.concretize-ctx gen-local-set range, concrete-local, concrete-value

-concretize-loop-while-or-until concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	expr loop-while-or-until-expr
do
	assert ctx.void-type is-void # TODO: sanity check -------------------------------------------------------------------------------
	void = ctx.concretize-ctx gen-void range
	if unpack ?= expr.condition unpack-option
		option = ctx concretize-expr unpack.option
		if expr is-until
			after = ctx concretize-expr-with-destructure type, range, unpack.destructure, expr.after
			body = ctx concretize-expr void.type, expr.body
			if root ?= after local
				###
				until x ?= xs
					body
				after
				==>
				x = loop
					if temp ?= xs
						break temp
					else
						body
						continue
				after
				###
				temp concrete-local = root.source, root.type
				break_ = range gen-break do range gen-local-get temp
				if_ = range gen-if-option option, (temp, break_), do root.type gen-do-and-continue range, body
				loop_ = root.type gen-loop range, if_
				type gen-let range, root, loop_, after.expr
			else
				###
				until _ ?= xs
					body
				after
				=>
				loop
					if _ ?= xs
						break
					else
						body
						continue
				after
				###
				if_ = range gen-if-option option, ((), (range gen-break void)), (void.type gen-do-and-continue range, body)
				loop_ = void.type gen-loop range, if_
				range gen-seq loop_, after.expr
		else
			###
			while x ?= xs
				body
			after
			==>
			loop
				if x ?= xs
					body
					continue
				else
					break
			after
			###
			body = ctx concretize-expr-with-destructure void.type, range, unpack.destructure, expr.body
			if_ = range gen-if-option option, (body.local, (void.type gen-do-and-continue range, body.expr)), (range gen-break void)
			loop_ = void.type gen-loop range, if_
			range gen-seq loop_, do ctx concretize-expr type, expr.after
	elif expr.condition.condition-destructures !is-empty
		if expr is-until
			###
			until x ?= xs and y ?= ys
				body
			after
			==>
			root = loop
				# This variable will actually be inlined
				# NOTE: all destructures from the original are flattened into 'both'
				both (nat, nat)? = if x ?= xs
					if y ?= ys
						x, y
					else
						()
				else
					()
				if b ?= both
					break b
				else
					body
					continue
			x = root item0
			y = root item1
			after
			###
			cond = ctx complex-condition-to-option expr.condition
			locals = cond locals
			tuple-option = cond tuple-option
			both = cond expr
			tuple-type = tuple-option unwrap-option-type!
			loop_ =
				body = ctx concretize-expr void.type, expr.body
				body-and-continue = tuple-type gen-do-and-continue range, body
				b concrete-local = member, tuple-type
				break-b = range gen-break do range gen-local-get b
				loop-body = range gen-if-option both, (b, break-b), body-and-continue
				tuple-type gen-loop range, loop-body
			root concrete-local = member2, tuple-type
			get-root = range gen-local-get root
			after mut = ctx concretize-with-locals-from-condition cond, type, expr.after
			for index, local in locals with-index
				get-it = if locals.size == 1
					get-root
				else
					ctx.concretize-ctx gen-record-field-get local.type, range, get-root, index
				after := type gen-let range, local, get-it, after
			type gen-let range, root, loop_, after
		else
			###
			while x ?= xs and y ?= ys
				body
			after
			==>
			loop
				if x ?= xs
					if y ?= ys
						body
						continue
					else
						break
				else
					break
			after
			###
			true-branch concrete-expr mut() = of
				body = ctx concretize-expr void.type, expr.body
				void.type gen-do-and-continue range, body
			loop-body = ctx concretize-complex-condition void.type, range, expr.condition, true-branch, of
				range gen-break void
			loop_ = void.type gen-loop range, loop-body
			range gen-seq loop_, do ctx concretize-expr type, expr.after
	else
		###
		while cond
			body
		after
		==>
		loop
			if cond
				body
				continue
			else
				break
		after
		###
		condition = ctx concretize-expr ctx.bool-type, expr.condition
		assert void.type is-void # TODO: sanity check -------------------------------------------------------------------------------
		body = ctx concretize-expr void.type, expr.body
		assert body.type is-void # TODO: sanity check -------------------------------------------------------------------------------
		do-and-continue = void.type gen-do-and-continue range, body
		break_ = range gen-break void
		if_ = if expr is-until
			range gen-if condition, break_, do-and-continue
		else
			range gen-if condition, do-and-continue, break_
		loop_ = void.type gen-loop range, if_
		range gen-seq loop_, (ctx concretize-expr type, expr.after)

-complex-condition-option-result record
	model-locals local[]
	locals concrete-local[]
	tuple-option concrete-type
	expr concrete-expr
-complex-condition-to-option complex-condition-option-result
	ctx concretize-expr-ctx
	a expr
do
	range = ctx to-uri-and-range a.range
	model-locals local[] = for* x in a condition-destructures
		x.locals to

	concrete-tuple-option concrete-type = if model-locals.size == 1
		ctx get-concrete-type ctx.common-types.option[model-locals[0].type as-type-args]
	else
		tuple struct-inst = ctx.common-types tuple! (model-locals make-type-args it.type)
		ctx get-concrete-type ctx.common-types.option[tuple]
	concrete-tuple-type = concrete-tuple-option unwrap-option-type!
	local-types concrete-type[] = if model-locals.size == 0
		()
	elif model-locals.size == 1
		concrete-tuple-type,
	else
		concrete-tuple-type.source.concrete-type-source-inst! type-args
	local-types.size is model-locals.size
	concrete-locals mut concrete-local[] = ()
	true-branch concrete-expr mut() = of
		concrete-locals := for local in model-locals then ctx.locals[local]! concrete-local!
		exprs concrete-expr[] = for type, local in local-types zip model-locals
			ctx concretize-local-get type, range, local
		tuple-expr concrete-expr = if model-locals.size == 0
			ctx.concretize-ctx gen-void range
		elif model-locals.size == 1
			exprs only
		else
			ctx.concretize-ctx gen-create-record concrete-tuple-type, range, exprs
		ctx.concretize-ctx gen-option concrete-tuple-option, range, tuple-expr
	expr = ctx concretize-complex-condition concrete-tuple-option, range, a, true-branch, of
		ctx.concretize-ctx gen-empty-option concrete-tuple-option, range
	model-locals: model-locals
	locals: concrete-locals
	tuple-option: concrete-tuple-option
	expr: expr
-concretize-with-locals-from-condition concrete-expr
	ctx concretize-expr-ctx
	cond complex-condition-option-result
	type concrete-type
	expr expr
do
	for model-local, concrete-local in cond.model-locals zip cond.locals
		ctx.locals[model-local] := concrete-local
	finally
		for model-local in cond model-locals
			_ = ctx.locals remove! model-local
	ctx concretize-expr type, expr

-concretize-match-enum concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-enum-expr
do
	guard a.cases !is-empty else ctx concretize-bogus type, range
	matched = ctx concretize-expr a.matched
	values-unsorted scalar-value[] = a.cases map it.member.value
	cases-unsorted concrete-expr[] = for value in values-unsorted
		case_ = a.cases find! it.member.value == value
		ctx concretize-expr type, case_.then_
	else_ concrete-local-and-expr? = if x ?= a else_
		ctx concretize-expr-with-opt-destructure type, range, x
	values, cases = values-unsorted sort-by-first cases-unsorted
	type gen-match-enum-or-integral range, matched, values.to, cases, else_

-concretize-match-integral concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-scalar-expr
do
	matched = ctx concretize-expr a.matched
	values-unsorted scalar-values = a.cases map it.value to
	# TODO: If matched is a constant, just compile the relevant case
	cases-unsorted concrete-expr[] = for value in values-unsorted
		case_ = a.cases find! it.value == value
		ctx concretize-expr type, case_.then_
	else_ = ctx concretize-expr-with-opt-destructure type, range, a.else_
	values, cases = values-unsorted.values sort-by-first cases-unsorted
	type gen-match-enum-or-integral range, matched, values.to, cases, else_

-concretize-match-string-like concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-string-like-expr
do
	guard equals ?= ctx get-concrete-fun-from-called a.equals else
		ctx concretize-bogus type, range
	matched = ctx concretize-expr a.matched
	cases concrete-match-string-like-case[] = for case_ in a cases
		value = ctx concretize-literal-string-like matched.type, range, a.string-type, case_.value
		value, do ctx concretize-expr type, case_.then_
	else_ = ctx concretize-expr-with-opt-destructure type, range, a.else_
	type, range, do matched match-string-like-concrete-expr equals, cases, else_

-concretize-match-sum-type concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-sum-type-expr
do
	matched = ctx concretize-expr a.matched
	else_ concrete-local-and-expr? = if x ?= a else_
		ctx concretize-expr-with-opt-destructure type, range, x
	# TODO: I think this could be greatly simplified to not have so many different branches -------------------------------
	if a.cases is-empty
		if e ?= else_
			ctx.concretize-ctx use-root-local matched, e
		else
			ctx concretize-bogus type, range
	else
		member-indices, cases = ctx concretize-match-sum-type-cases type, range, matched.type, a.cases
		type, range, do matched match-union-concrete-expr member-indices.to, cases, else_

-concretize-match-sum-type-cases (nat[], concrete-local-and-expr[])
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	variant-type concrete-type
	cases match-sum-type-case[]
do
	member-indices nat[] = for x in cases
		ctx member-index-for-match-sum-type-case variant-type, x
	concrete-cases concrete-local-and-expr[] = for member-index in member-indices
		case_ = cases find! of x
			(ctx member-index-for-match-sum-type-case variant-type, x) == member-index
		ctx concretize-expr-with-destructure type, range, case_.destructure, case_.then_
	member-indices sort-by-first concrete-cases
-member-index-for-match-sum-type-case nat
	ctx concretize-expr-ctx
	variant-type concrete-type
	a match-sum-type-case
do
	ctx.concretize-ctx sum-type-case-index variant-type, do ctx get-concrete-type a.destructure.type

-concretize-force concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a force-expr
do
	arg = ctx concretize-expr a.arg
	ctx.concretize-ctx gen-option-else type, range, arg,
		type gen-throw range,
			ctx.concretize-ctx gen-error range,
				"Option was empty: '{ctx.concretize-ctx.file-content-getters[arg range].to::string}'"

-concretize-assert-or-forbid concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a assert-or-forbid-expr
do
	model-type = a type ctx.available-types
	throw_ concrete-expr mut() = of
		type gen-throw range, if x ?= a thrown
			ctx concretize-expr ctx.concretize-ctx.exception-type, x
		else
			ctx.concretize-ctx gen-error range,
				ctx.cur-uri default-assert-or-forbid-message a, ctx.concretize-ctx.file-content-getters
	after concrete-expr mut() = of
		ctx concretize-expr a.after
	true-branch concrete-expr mut(), false-branch concrete-expr mut() =
		if a is-forbid then throw_, after else after, throw_
	ctx concretize-if type, model-type, range, a.condition, true-branch, false-branch

-concretize-expr concrete-expr(ctx concretize-expr-ctx, a expr)
	type = ctx get-concrete-type do a type ctx.available-types
	ctx concretize-expr type, a

concretize-expr concrete-expr(ctx concretize-expr-ctx, outer-type concrete-type, a expr)
	model-type = a type ctx.available-types
	type = ctx get-concrete-type model-type
	range uri-and-range = ctx.cur-uri, a.range
	guard type !is-bogus else ctx concretize-bogus type, range
	res = match a
	as assert-or-forbid-expr x
		ctx concretize-assert-or-forbid type, range, x
	as bogus-call-expr _
		ctx concretize-bogus type, range
	as bogus-expr _
		ctx concretize-bogus type, range
	as bogus-wrong-type-expr _
		ctx concretize-bogus type, range
	as call-expr x
		ctx concretize-call type, range, x
	as call-named-new-expr x
		ctx concretize-call-named-new type, range, x
	as call-option-expr x
		ctx concretize-call-option type, range, x
	as extern-expr x
		type, range, do x.names is-subset-of ctx.concretize-ctx.all-externs to
	as finally-expr x
		ctx concretize-finally type, range, x
	as force-expr x
		ctx concretize-force type, range, x
	as if-expr x
		ctx concretize-if type, range, x
	as lambda-expr x
		ctx concretize-lambda type, range, x
	as let-expr x
		# Use 'outer-type' instead of 'type' here to make the conversion be in the 'then' expression instead of wrapping the whole 'let'.
		# This leads to simpler generated code.
		ctx concretize-let outer-type, range, x
	as list-expr x
		ctx concretize-list type, range, x
	as literal-scalar-expr x
		if x.type == json
			type, range, do ctx.concretize-ctx constant-json-number x.value.to
		else
			type gen-constant range, x.value
	as literal-string-like-expr x
		ctx concretize-literal-string-like type, range, x.string-type, x.value
	as local-get-expr x
		ctx concretize-local-get type, range, x.local
	as local-set-expr x
		ctx concretize-local-set range, x.local, x.value
	as logical-expr x
		if x.kind == bool-and-bool
			true-branch concrete-expr mut() = of then ctx concretize-expr type, x.right
			ctx concretize-complex-condition type, range, x.left, true-branch, of then ctx.concretize-ctx gen-false range
		else
			left-type concrete-type = match x kind
			as bool-and-bool
				throw unreachable
			as bool-or-bool
				type
			as option-else
				if model-type is-option-type
					type
				else
					ctx get-concrete-type ctx.common-types.option[model-type as-type-args]
			as option-or
				outer-type
			left = ctx concretize-expr left-type, x.left
			right = ctx concretize-expr type, x.right
			match x kind
			as bool-and-bool
				throw unreachable
			as bool-or-bool
				ctx.concretize-ctx gen-or range, left, right
			as option-else
				ctx.concretize-ctx gen-option-else type, range, left, right
			as option-or
				temp concrete-local = member::concrete-generated-local-kind, type
				get-temp = range gen-local-get temp
				type gen-let range, temp, left,
					range gen-if-option get-temp, ((), get-temp), right
	as loop-expr x
		type gen-loop range, (ctx concretize-expr type, x.body)
	as loop-break-expr x
		range gen-break (ctx concretize-expr type, x.value)
	as loop-continue-expr _
		type gen-continue range
	as loop-while-or-until-expr x
		ctx concretize-loop-while-or-until type, range, x
	as match-enum-expr x
		ctx concretize-match-enum type, range, x
	as match-scalar-expr x
		ctx concretize-match-integral type, range, x
	as match-string-like-expr x
		ctx concretize-match-string-like type, range, x
	as match-sum-type-expr x
		ctx concretize-match-sum-type type, range, x
	as seq-expr x
		first = ctx concretize-expr ctx.void-type, x.first
		# See comment on 'as let-expr' for why we use 'outer-type' instead of 'type'
		then_ = ctx concretize-expr outer-type, x.then_
		if _ ?= first.kind constant
			then_
		else
			outer-type, range, do first.as-seq ~~ then_.as-seq seq-concrete-expr
	as throw-expr x
		thrown = ctx concretize-expr ctx.concretize-ctx.exception-type, x.thrown
		type, range, thrown.throw-concrete-expr
	as trusted-expr x
		ctx concretize-expr type, x.inner
	as try-expr x
		ctx concretize-try type, range, x
	as try-let-expr x
		ctx concretize-try-let type, range, x
	as typed-expr x
		ctx concretize-expr type, x.inner
	as unpack-option x
		option = ctx concretize-expr x.option
		range gen-if-option option, ((), (ctx.concretize-ctx gen-true range)), (ctx.concretize-ctx gen-false range)
	ctx.concretize-ctx may-widen-type outer-type, res

-as-seq concrete-expr[](a concrete-expr)
	match a kind
	as seq-concrete-expr x
		x parts
	else
		- a

-may-widen-type concrete-expr
	ctx concretize-ctx
	expected-type concrete-type
	actual concrete-expr
do
	ctx try-widen expected-type, actual else
		show-ctx = ctx show-ctx
		where = show-ctx.line-and-column-getters[actual range]
		error log "At: {where}, expected type: {show-ctx show-concrete-type expected-type}, actual: {show-ctx show-concrete-type actual.type}"
		throw unreachable

# This goes in reverse, from 'to' to 'from'. So must reverse the path at the end.
-try-widen concrete-expr?(ctx concretize-ctx, expected concrete-type, actual concrete-expr)
	if actual.type == expected
		actual
	elif expected-unwrapped ?= expected unwrap-option-type
		if res ?= ctx try-widen expected-unwrapped, actual
			ctx gen-option expected, actual.range, res
		elif actual-unwrapped ?= actual.type unwrap-option-type
			# 'actual' generates an option.
			temp concrete-local = member::concrete-generated-local-kind, actual-unwrapped
			range = actual range
			if widen-temp ?= ctx try-widen expected-unwrapped, do range gen-local-get temp
				some = ctx gen-option expected, range, widen-temp
				range gen-if-option actual, (temp, some), (ctx gen-empty-option expected, range)
	elif u ?= expected.body concrete-union
		if u has-members
			u.members.with-index first of member-index, member
				if res ?= ctx try-widen member, actual
					ctx gen-create-union expected, actual.range, member-index, res
		else
			ctx.sum-types[expected]!.with-index first of member-index, x
				if res ?= ctx try-widen x.member-type, actual
					ctx gen-create-union expected, actual.range, member-index, res

-concretize-finally concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a finally-expr
do
	right = ctx concretize-expr ctx.void-type, a.right
	below = ctx concretize-expr type, a.below
	type, range, (right finally-concrete-expr below)

-concretize-try concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a try-expr
do
	tried = ctx concretize-expr type, a.tried
	member-indices, cases =
		ctx concretize-match-sum-type-cases type, range, ctx.concretize-ctx.exception-type, a.catches
	type, range, do tried try-concrete-expr member-indices.to, cases, if x ?= a catch-else
		ctx concretize-expr-with-opt-destructure type, range, x

-concretize-try-let concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a try-let-expr
do
	local-type = ctx get-concrete-type a.destructure.type
	value = ctx concretize-expr local-type, a.value
	catch-member-index = ctx member-index-for-match-sum-type-case ctx.concretize-ctx.exception-type, a.catch_
	catch-expr = ctx concretize-expr-with-destructure type, range, a.catch_.destructure, a.catch_.then_
	then_ = ctx concretize-expr-with-destructure type, range, a.destructure, a.then_
	type, range,
		then_.local try-let-concrete-expr value, catch-member-index, catch-expr, then_.expr
