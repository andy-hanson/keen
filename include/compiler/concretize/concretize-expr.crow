import
	../../crow/col/sort: sort-by-first
	../frontend/show-model
	../model/ast
	../model/concrete-model
	../model/integral-values
	../model/model
	../model/show-concrete-model
	../model/source-range
	../model/uri
	../util/util
	./all-constants-builder
	./concretize-ctx
	./generate

concretize-fun-body concrete-expr(ctx concretize-ctx, cf concrete-fun, expr expr)
	params = match cf source
	as concrete-fun-source-regular x
		x.decl.params params-array
	as concrete-fun-source-test _
		()
	as concrete-fun-source-wrap-main _
		throw unreachable
	expr-ctx concretize-expr-ctx = ctx, cf
	# Ignore closure param, which is never destructured.
	concrete-params = cf.params[(params.size + 1 == cf.params.size ? 1 : 0) .. end]
	type = cf return-type
	for param, concrete-param : params zip concrete-params
		expr-ctx begin-param-destructure param, concrete-param
	res mut = expr-ctx concretize-expr type, expr
	for param, concrete-param : params zip concrete-params
		res := expr-ctx end-param-destructure type, (expr-ctx to-uri-and-range param.range), param, concrete-param, res
	res

-concretize-bogus concrete-expr(ctx concretize-expr-ctx, type concrete-type, range uri-and-range)
	ctx.concretize-ctx gen-bogus type, range

concretize-expr-ctx record mut
	concretize-ctx concretize-ctx
	cur-uri uri
	type-scope type-args-scope
	specs-scope specs-scope
	locals local-or-constant mut[local]
new concretize-expr-ctx
	concretize-ctx concretize-ctx
	fun concrete-fun
do
	concretize-ctx, fun.module-uri, fun.type-args-scope-for-fun, fun.specs-scope-for-fun, ()
new concretize-expr-ctx
	concretize-ctx concretize-ctx
	cur-uri uri
	type-scope type-args-scope
	specs-scope specs-scope
do
	concretize-ctx, cur-uri, type-scope, specs-scope, ()
allocate-mutable-closure-variables bool(a concretize-expr-ctx)
	a is-java
is-java bool(a concretize-expr-ctx)
	a.concretize-ctx is-java
is-js bool(a concretize-expr-ctx)
	a.concretize-ctx is-js
-common-types common-types(a concretize-expr-ctx)
	a.concretize-ctx common-types
all-constants all-constants-builder(a concretize-expr-ctx)
	a.concretize-ctx all-constants
-bool-type concrete-type(a concretize-expr-ctx)
	a.concretize-ctx bool-type
-void-type concrete-type(a concretize-expr-ctx)
	a.concretize-ctx void-type
-to-uri-and-range uri-and-range(ctx concretize-expr-ctx, a source-range)
	ctx.cur-uri, a

-typed-constant record(type concrete-type, value constant)
-local-or-constant union(concrete-local, typed-constant)

get-concrete-type concrete-type(a concretize-expr-ctx, t type)
	a.concretize-ctx get-concrete-type t, a.type-scope

-concretize-call concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a call-expr
do
	guard concrete-called ?= ctx get-concrete-fun-from-called a.called : ctx concretize-bogus type, range
	if concrete-called.return-type is-bogus
		ctx concretize-bogus type, range
	elif concrete-called is-array-op # TODO: it's a bit wasteful to give the function a body in get-concrete-fun-from-called only to ignore it here ....
		input-arg, lambda-arg = a.args only2
		input = ctx concretize-expr concrete-called.params[0].type, input-arg
		in-element-type = input.type is-range ? input.type.range-element-type : input.type array-element-type
		out-element-type = type.is-void ? type : type array-element-type
		empty-out-array constant-array? = unless type is-void
			ctx.all-constants get-constant-array type, () constant-array!
		match lambda-arg
		as lambda-expr l
			forbid _ ?= l.mut-type-for-explicit-shared # This won't happen because 'for-loop' takes a 'mut' lambda
			rg uri-and-range = ctx.cur-uri, lambda-arg.range
			body = ctx concretize-with-destructure out-element-type, rg, l.param, () =>
				ctx concretize-expr out-element-type, l.body
			type, range, (input array-op-concrete-expr body.local, empty-out-array, body.expr)
		else
			lambda-type = concrete-called.params[1].type
			temp concrete-local = member, lambda-type # TODO: use a new kind, not 'member' --------------------------------------
			lambda = ctx concretize-expr lambda-type, lambda-arg
			in-element concrete-local = member, in-element-type # TODO: use a new kind, not 'member' ----------------------------
			body = builtin-fun-call-lambda builtin-concrete-expr (out-element-type, in-element-type),
				- range gen-local-get temp
				- range gen-local-get in-element
			then concrete-expr = type, range, (input array-op-concrete-expr in-element, empty-out-array, (out-element-type, range, body))
			type gen-let range, temp, lambda, then
	else
		args concrete-expr[] = if concrete-called is-variadic
			array-type = concrete-called.params.only type
			element-type = array-type array-element-type
			elements concrete-expr[] = for arg : a args
				ctx concretize-expr element-type, arg
			(array-type, range, elements.create-array-concrete-expr),
		else
			for i : 0 .. a.args.size
				ctx concretize-expr concrete-called.params[i].type, a.args[i]
		if concrete-called is-not and args.only.kind.constant !is-empty
			concrete-called.return-type, range, do !args.only.kind.constant!.as-bool constant-bool
		elif concrete-called is-logical-op and args[0].kind.constant !is-empty
			arg0 = args[0].kind.constant! as-bool
			assert args.size == 2
			arg1 = args[1]
			match concrete-called.body.concrete-fun-body-builtin!.kind builtin-binary-lazy!
			as bool-and
				arg0 ? arg1 : args[0]
			as bool-or
				arg0 ? args[0] : arg1
			else
				throw unreachable
		else
			# We need to widen again even though it was done already in 'concretize-expr',
			# because we may be calling a spec-impl that has a narrower type than the spec.
			# (The call expr's type can't reflect this and uses the spec's declared type.)
			concrete-called.return-type, range, if builtin_ ?= concrete-called.body concrete-fun-body-builtin
				match builtin_ kind
				as builtin-binary-lazy x
					ctx concretize-builtin-binary-lazy type, range, x, args
				else
					builtin_.kind builtin-concrete-expr builtin_.type-args, args
			else
				concrete-called call-concrete-expr args

-concretize-call-named-new concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a call-named-new-expr
do
	guard concrete-called ?= ctx get-concrete-fun-from-called a.called : ctx concretize-bogus type, range
	p0, p1 = concrete-called.params only2
	symbol-array-type = p0 type
	arg-array-type = p1 type
	symbols constant[] = for x : a.ast names
		ctx.concretize-ctx constant-symbol x.name
	symbol-array concrete-expr = symbol-array-type, range, do ctx.all-constants get-constant-array symbol-array-type, symbols
	arg-model-type = a.args[0] type ctx.common-types
	arg-type = ctx get-concrete-type arg-model-type 
	args concrete-expr[] = for arg : a args
		ctx concretize-expr arg-type, arg
	args-array concrete-expr = arg-array-type, range, args.create-array-concrete-expr
	concrete-called.return-type, range, do concrete-called call-concrete-expr (symbol-array, args-array)

-is-not bool(a concrete-fun)
	guard b ?= a.body concrete-fun-body-builtin
	guard u ?= b.kind builtin-unary
	u == not

-is-logical-op bool(a concrete-fun)
	guard b ?= a.body concrete-fun-body-builtin
	guard l ?= b.kind builtin-binary-lazy
	l == bool-and or l == bool-or

-is-array-op bool(a concrete-fun)
	# TODO: make sure this is the one in collection.crow and all the spec impls are as expected ------------------------
	guard a.name == "for-loop"
	guard a.return-type is-void or a.return-type is-array-or-mut-array
	guard a.params.size == 2
	input = a.params[0]
	guard input.type is-range or input.type is-array-or-mut-array
	guard _ ?= a.params[1].type as-fun-type
	true

-is-range bool(a concrete-type)
	guard inst ?= a.source concrete-type-source-inst
	decl = inst decl
	# TODO: base this on more than just the name ... uri too? -------------------------------------------------------------------
	decl.name == "range"

-concretize-builtin-binary-lazy concrete-expr-kind
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	kind builtin-binary-lazy
	args concrete-expr[]
do
	arg0, arg1 = args only2
	match kind
	as bool-and
		ctx.concretize-ctx gen-and-kind range, arg0, arg1
	as bool-or
		ctx.concretize-ctx gen-or-kind range, arg0, arg1
	as option-or
		# TODO: this should use a let expr to ensure 'a' is only evaluated once! -------------------------------------------------
		arg0 gen-if-option-kind ((), arg0), arg1
	as option-question-2
		local concrete-local = member::concrete-generated-local-kind, type
		arg0 gen-if-option-kind (local, (range gen-local-get local)), arg1

-concretize-call-option concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a call-option-expr
do
	assert type is-option
	# `a?.b` ==> `x ?= a ? (x.b,) : ()`
	# But `x.b` may already be an option and might not need to be wrapped
	guard called ?= ctx get-concrete-fun-from-called a.called : ctx concretize-bogus type, range
	# TODO: should get-concrete-fun-from-called just return nothing if the return type is bogus? -----------------------------------
	guard called.return-type !is-bogus : ctx concretize-bogus type, range
	option = ctx concretize-expr a.first-arg
	local concrete-local = destruct::concrete-generated-local-kind, called.params[0].type
	a.rest-args.size + 1 is called.params.size
	all-args concrete-expr[] = with out : 1 + a.rest-args.size build # TODO: just inline below ----------------------------------
		out ~= range gen-local-get local
		for i, x : a.rest-args with-index
			out ~= ctx concretize-expr called.params[i + 1].type, x
	call = range gen-call called, all-args
	some-call = if call.type == type
		call
	else
		ctx.concretize-ctx gen-some type, range, call
	assert some-call.type == type
	range gen-if-option option, (local, some-call), (ctx.concretize-ctx gen-none type, range)

get-concrete-fun-from-called concrete-fun?(ctx concretize-expr-ctx, called called)
	ctx.concretize-ctx get-concrete-fun-from-called ctx.type-scope, ctx.specs-scope, called

-concretize-lambda concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	e lambda-expr
do
	return-type = ctx get-concrete-type e.return-type
	param-type = ctx get-concrete-type e.param.type
	body = ctx concretize-expr-with-destructure return-type, range, e.param, e.body
	param = body.local ?? args::concrete-generated-local-kind, param-type
	closure concrete-local[] = for* x : e closure
		match ctx.locals[x]!
		as concrete-local l
			- l
		as typed-constant _
			()
	need-wrap = ctx !is-js and e.kind == explicit-shared
	lambda-type = if need-wrap
		ctx get-concrete-type e.mut-type-for-explicit-shared!
	else
		type
	lambda concrete-expr = lambda-type, range, (closure lambda-concrete-expr param, body.expr)
	# TODO: given that 'shared' just converts a mut lambda to shared, it might make more sense to have it be a separate expression that wraps the lambda
	if need-wrap
		decl = ctx.concretize-ctx.program.common-funs shared-of-mut-lambda
		fun = ctx.concretize-ctx get-concrete-fun decl, (return-type, param-type), ()
		range gen-call fun, (lambda,)
	else
		lambda

-concretize-let concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	e let-expr
do
	local-type = ctx get-concrete-type e.destructure.type
	value = ctx concretize-expr local-type, e.value
	ctx concretize-with-destructure-and-let type, range, e.destructure, value, () =>
		ctx concretize-expr type, e.then

-concretize-list concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a list-expr
do
	guard called ?= ctx get-concrete-fun-from-called a.called : ctx concretize-bogus type, range
	array-type = ctx get-concrete-type a.array-type
	inner = ctx concretize-list-inner array-type, range, a.parts
	called.return-type, range, do called call-concrete-expr (inner,)

-concretize-list-inner concrete-expr
	ctx concretize-expr-ctx
	array-type concrete-type
	range uri-and-range
	parts list-expr-part[]
do
	element = array-type array-element-type!
	arrays concrete-expr mut[] = ()
	cur-list concrete-expr mut[] = ()
	finish-list void mut() = () =>
		arrays ~= array-type, range, cur-list.move-to.create-array-concrete-expr
	for part : parts
		match part
		as expr x
			cur-list ~= ctx concretize-expr element, x
		as list-expr-part-multi x
			finish-list[]
			arrays ~= ctx concretize-expr array-type, x.arg
	finish-list[]

	finished-arrays concrete-expr[] = arrays move-to
	res mut = finished-arrays[0]
	for x : finished-arrays[1 .. end]
		res := ctx.concretize-ctx gen-concat-array range, res, x
	res

-concretize-expr-with-opt-destructure concrete-local-and-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-else
do
	if d ?= a destructure
		ctx concretize-with-destructure type, range, d, () =>
			ctx concretize-expr type, a.then
	else
		(), do ctx concretize-expr type, a.then
-concretize-expr-with-destructure concrete-local-and-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	expr expr
do
	ctx concretize-with-destructure type, range, destructure, () =>
		ctx concretize-expr type, expr

-concretize-with-destructure-and-let concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	value concrete-expr
	f concrete-expr mut()
do
	ctx.concretize-ctx use-root-local value,
		ctx concretize-with-destructure type, range, destructure, f
-use-root-local concrete-expr
	ctx concretize-ctx
	value concrete-expr
	then concrete-local-and-expr
do
	expr = then expr
	if root ?= then local
		expr.type gen-let expr.range, root, value, expr
	elif _ ?= value.kind constant
		then expr
	else
		ctx gen-drop-then expr.range, value, expr

-concretize-with-destructure concrete-local-and-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	f concrete-expr mut()
do
	ctx begin-destructure destructure
	res = f[]
	ctx end-destructure type, range, destructure, res

-begin-destructure void(ctx concretize-expr-ctx, destructure destructure)
	match destructure
	as destructure-ignore _
		()
	as local local
		root-local concrete-local = local, do ctx get-concrete-type local.type
		ctx.locals[local] := if ctx is-allocated local
			reference-type = ctx get-concrete-type local.closure-reference-type!
			local.concrete-local-source-reference, reference-type
		else
			root-local
	as destructure-split x
		if x is-valid-destructure ctx.common-types
			for part : x parts
				ctx begin-destructure part
-begin-param-destructure void(ctx concretize-expr-ctx, destructure destructure, concrete-param concrete-local)
	match destructure
	as destructure-ignore _
		()
	as local local
		ctx.locals[local] := concrete-param
	as destructure-split _
		ctx begin-destructure destructure
-end-destructure concrete-local-and-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	expr concrete-expr
do
	match destructure
	as destructure-ignore _
		(), expr
	as local local
		concrete-local = ctx.locals remove! local concrete-local!
		if ctx is-allocated local
			root-local concrete-local = local, do ctx get-concrete-type local.type
			value = ctx.concretize-ctx gen-reference-create concrete-local.type, range, do range gen-local-get root-local
			root-local, (type gen-let range, concrete-local, value, expr)
		else
			concrete-local, expr
	as destructure-split x
		if x is-valid-destructure ctx.common-types
			root-local concrete-local = destruct, do ctx get-concrete-type destructure.type
			res = ctx end-destructure-split type, range, expr, x, root-local
			root-local, res
		else
			(), (ctx concretize-bogus type, range)
-end-param-destructure concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	destructure destructure
	root-local concrete-local
	expr concrete-expr
do
	match destructure
	as destructure-ignore _
		expr
	as local x
		forbid ctx is-allocated x
		expr
	as destructure-split x
		ctx end-destructure-split type, range, expr, x, root-local
-end-destructure-split concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	expr concrete-expr
	x destructure-split
	root-local concrete-local
do
	guard x is-valid-destructure ctx.common-types : ctx concretize-bogus type, range # TODO: we should detect this earlier and make the entire expression fail
	get-root-local = range gen-local-get root-local
	res mut = expr
	for part-index, part : x.parts with-index
		part-range = ctx to-uri-and-range part.range
		value-type = root-local.type.body.concrete-record!.fields[part-index] type
		expected-type = ctx get-concrete-type part.type
		assert value-type == expected-type : todo
		its-value = ctx.concretize-ctx gen-record-field-get value-type, part-range, get-root-local, part-index
		its-local-and-expr = ctx end-destructure type, part-range, part, res
		res := its-local-and-expr expr
		if l ?= its-local-and-expr local
			res := type gen-let part-range, l, its-value, res
	res

-is-allocated bool(ctx concretize-expr-ctx, a local)
	a is-mutable and a is-used-in-closure and ctx allocate-mutable-closure-variables

-concretize-if concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a if-expr
do
	match a condition
	as expr expr
		cond = ctx concretize-expr ctx.bool-type, expr
		if constant ?= cond.kind constant
			ctx concretize-expr type, (constant.as-bool ? a true-branch : a false-branch)
		else
			true-branch = ctx concretize-expr type, a.true-branch
			false-branch = ctx concretize-expr type, a.false-branch
			type, range, (cond if-concrete-expr true-branch, false-branch)
	as unpack-option unpack
		option = ctx concretize-expr unpack.option
		true-branch = ctx concretize-expr-with-destructure type, range, unpack.destructure, a.true-branch
		false-branch = ctx concretize-expr type, a.false-branch
		range gen-if-option option, true-branch, false-branch

-gen-if-option concrete-expr
	range uri-and-range
	option concrete-expr
	then concrete-local-and-expr
	else_ concrete-expr
do
	else_.type, range, (option gen-if-option-kind then, else_)
-gen-if-option-kind concrete-expr-kind
	option concrete-expr
	then concrete-local-and-expr
	else_ concrete-expr
do
	cases concrete-local-and-expr[] =
		- (), else_
		- then.local, then.expr
	option match-union-concrete-expr 2.integral-values-range, cases, ()

-concretize-literal-string-like concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	kind string-like-type
	value string
do
	match kind
	as char8-array
		ctx.concretize-ctx gen-char8-array range, value
	as char32-array
		ctx.concretize-ctx gen-char32-array range, value
	as js-any
		type, range, do ctx.concretize-ctx constant-symbol value.to
	as string
		ctx.concretize-ctx gen-string-literal range, value
	as symbol
		type, range, do ctx.concretize-ctx constant-symbol value.to

-concretize-local-get concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	local local
do
	match ctx.locals[local]!
	as concrete-local x
		get = range gen-local-get x
		if x.type is-bogus
			ctx concretize-bogus type, range
		elif ctx is-allocated local
			ctx.concretize-ctx gen-reference-read range, get
		else
			get
	as typed-constant x
		type, range, x.value

-concretize-local-set concrete-expr
	ctx concretize-expr-ctx
	range uri-and-range
	local local
	value expr
do
	concrete-local = ctx.locals[local]! concrete-local!
	value-type = if ctx is-allocated local
		ctx.concretize-ctx get-referenced-type concrete-local.type
	else
		concrete-local.type
	concrete-value = ctx concretize-expr value-type, value
	if ctx is-allocated local
		ctx.concretize-ctx gen-reference-write range, (range gen-local-get concrete-local), concrete-value
	else
		ctx.concretize-ctx gen-local-set range, concrete-local, concrete-value

-concretize-loop-while-or-until concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	expr loop-while-or-until-expr
do
	assert ctx.void-type is-void # TODO: sanity check -------------------------------------------------------------------------------
	void = ctx.concretize-ctx gen-void range
	match expr condition
	as expr x
		###
		while cond
			body
		after
		==>
		loop
			if cond
				body
				continue
			else
				break
		after
		###
		condition = ctx concretize-expr ctx.bool-type, x
		assert void.type is-void # TODO: sanity check -------------------------------------------------------------------------------
		body = ctx concretize-expr void.type, expr.body
		assert body.type is-void # TODO: sanity check -------------------------------------------------------------------------------
		do-and-continue = void.type gen-do-and-continue range, body
		break_ = range gen-break void
		if_ = if expr is-until
			range gen-if condition, break_, do-and-continue
		else
			range gen-if condition, do-and-continue, break_
		loop_ = void.type gen-loop range, if_
		range gen-seq loop_, (ctx concretize-expr type, expr.after)
	as unpack-option unpack
		option = ctx concretize-expr unpack.option
		if expr is-until
			after = ctx concretize-expr-with-destructure type, range, unpack.destructure, expr.after
			body = ctx concretize-expr void.type, expr.body
			if root ?= after local
				###
				until x ?= xs
					body
				after
				==>
				x = loop
					if temp ?= xs
						break temp
					else
						body
						continue
				after
				###
				temp concrete-local = root.source, root.type
				break_ = range gen-break do range gen-local-get temp
				if_ = range gen-if-option option, (temp, break_), do root.type gen-do-and-continue range, body
				loop_ = root.type gen-loop range, if_
				type gen-let range, root, loop_, after.expr
			else
				###
				until _ ?= xs
					body
				after
				=>
				loop
					if _ ?= xs
						break
					else
						body
						continue
				after
				###
				if_ = range gen-if-option option, ((), (range gen-break void)), (void.type gen-do-and-continue range, body)
				loop_ = void.type gen-loop range, if_
				range gen-seq loop_, after.expr
		else
			###
			while x ?= xs
				body
			after
			==>
			loop
				if x ?= xs
					body
					continue
				else
					break
			after
			###
			body = ctx concretize-expr-with-destructure void.type, range, unpack.destructure, expr.body
			if_ = range gen-if-option option, (body.local, (void.type gen-do-and-continue range, body.expr)), (range gen-break void)
			loop_ = void.type gen-loop range, if_
			range gen-seq loop_, (ctx concretize-expr type, expr.after)

-concretize-match-enum concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-enum-expr
do
	guard a.cases !is-empty : ctx concretize-bogus type, range
	matched = ctx concretize-expr a.matched
	values-unsorted integral-value[] = for x : a cases; x.member value
	cases-unsorted concrete-expr[] = for value : values-unsorted
		case_ = a.cases find! x => x.member.value == value
		ctx concretize-expr type, case_.then
	else_ concrete-local-and-expr? = if x ?= a else_
		ctx concretize-expr-with-opt-destructure type, range, x
	values, cases = values-unsorted sort-by-first cases-unsorted
	type gen-match-enum-or-integral range, matched, values, cases, else_

-concretize-match-integral concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-integral-expr
do
	matched = ctx concretize-expr a.matched
	values-unsorted integral-value[] = for x : a cases; x value
	# TODO: If matched is a constant, just compile the relevant case
	cases-unsorted concrete-expr[] = for value : values-unsorted
		case_ = a.cases find! x => x.value == value
		ctx concretize-expr type, case_.then
	else_ = ctx concretize-expr-with-opt-destructure type, range, a.else_
	values, cases = values-unsorted sort-by-first cases-unsorted
	type gen-match-enum-or-integral range, matched, values, cases, else_

-concretize-match-string-like concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-string-like-expr
do
	guard equals ?= ctx get-concrete-fun-from-called a.equals : ctx concretize-bogus type, range
	matched = ctx concretize-expr a.matched
	cases concrete-match-string-like-case[] = for case_ : a cases
		value = ctx concretize-literal-string-like matched.type, range, a.string-type, case_.value
		value, do ctx concretize-expr type, case_.then
	else_ = ctx concretize-expr-with-opt-destructure type, range, a.else_
	type, range, do matched match-string-like-concrete-expr equals, cases, else_

-concretize-match-sum-type concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a match-sum-type-expr
do
	matched = ctx concretize-expr a.matched
	else_ concrete-local-and-expr? = if x ?= a else_
		ctx concretize-expr-with-opt-destructure type, range, x
	# TODO: I think this could be greatly simplified to not have so many different branches -------------------------------
	if a.cases is-empty
		if e ?= else_
			ctx.concretize-ctx use-root-local matched, e
		else
			ctx concretize-bogus type, range
	else
		values, cases = ctx concretize-match-sum-type-cases type, range, matched.type, a.cases
		type, range, do matched match-union-concrete-expr values, cases, else_

-concretize-match-sum-type-cases (integral-values, concrete-local-and-expr[])
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	variant-type concrete-type
	cases match-sum-type-case[]
do
	values integral-values = for x : cases
		ctx member-index-for-match-sum-type-case variant-type, x
	concrete-cases concrete-local-and-expr[] = for value : values
		case_ = cases find! x =>
			(ctx member-index-for-match-sum-type-case variant-type, x) == value
		ctx concretize-expr-with-destructure type, range, case_.destructure, case_.then
	values sort-by-first concrete-cases
-member-index-for-match-sum-type-case integral-value
	ctx concretize-expr-ctx
	variant-type concrete-type
	a match-sum-type-case
do
	(ctx.concretize-ctx sum-type-case-index variant-type, (ctx get-concrete-type a.destructure.type)),

-concretize-assert-or-forbid concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a assert-or-forbid-expr
do
	default-thrown concrete-expr mut() = () =>
		message = ctx.cur-uri default-assert-or-forbid-message a, ctx.concretize-ctx.file-content-getters
		ctx.concretize-ctx gen-error range, message
	throw-no-destructure concrete-expr mut() = () =>
		type gen-throw range, if x ?= a thrown
			ctx concretize-expr ctx.concretize-ctx.exception-type, x
		else
			default-thrown[]
	match a condition
	as expr x
		condition = ctx concretize-expr ctx.bool-type, x
		if constant ?= condition.kind constant
			if constant.as-bool xor a.is-forbid
				ctx concretize-expr type, a.after
			else
				throw-no-destructure[]
		else
			throw_ = throw-no-destructure[]
			after = ctx concretize-expr type, a.after
			type, range, if a is-forbid
				condition if-concrete-expr throw_, after
			else
				condition if-concrete-expr after, throw_
	as unpack-option x
		option = ctx concretize-expr x.option
		if a is-forbid
			thrown = if thrown ?= a thrown
				ctx concretize-expr-with-destructure ctx.concretize-ctx.exception-type, range, x.destructure, thrown
			else
				(), default-thrown[]
			after = ctx concretize-expr type, a.after
			range gen-if-option option, (thrown.local, (type gen-throw range, thrown.expr)), after
		else
			then = ctx concretize-expr-with-destructure type, range, x.destructure, a.after
			range gen-if-option option, then, throw-no-destructure[]

-concretize-expr concrete-expr(ctx concretize-expr-ctx, a expr)
	type = ctx get-concrete-type (a type ctx.common-types)
	ctx concretize-expr type, a

concretize-expr concrete-expr(ctx concretize-expr-ctx, outer-type concrete-type, a expr)
	model-type = a type ctx.common-types
	type = ctx get-concrete-type model-type
	range uri-and-range = ctx.cur-uri, a.range
	guard type !is-bogus : ctx concretize-bogus type, range
	res = match a
	as assert-or-forbid-expr x
		ctx concretize-assert-or-forbid type, range, x
	as bogus-call-expr _
		ctx concretize-bogus type, range
	as bogus-expr _
		ctx concretize-bogus type, range
	as bogus-wrong-type-expr _
		ctx concretize-bogus type, range
	as call-expr x
		ctx concretize-call type, range, x
	as call-named-new-expr x
		ctx concretize-call-named-new type, range, x
	as call-option-expr x
		ctx concretize-call-option type, range, x
	as extern-expr x
		type, range, do x.names is-subset-of ctx.concretize-ctx.all-externs constant-bool
	as finally-expr x
		ctx concretize-finally type, range, x
	as if-expr x
		ctx concretize-if type, range, x
	as lambda-expr x
		ctx concretize-lambda type, range, x
	as let-expr x
		# Use 'outer-type' instead of 'type' here to make the conversion be in the 'then' expression instead of wrapping the whole 'let'.
		# This leads to simpler generated code.
		ctx concretize-let outer-type, range, x
	as list-expr x
		ctx concretize-list type, range, x
	as literal-float-expr x
		type gen-constant range, x.value.constant-float	
	as literal-integral-expr x
		type gen-constant range, x.value
	as literal-string-like-expr x
		ctx concretize-literal-string-like type, range, x.string-type, x.value
	as local-get-expr x
		ctx concretize-local-get type, range, x.local
	as local-set-expr x
		ctx concretize-local-set range, x.local, x.value
	as logical-expr x
		left-type = match x kind
		as bool-and-bool
			type
		as bool-or-bool
			type
		as option-else
			model-type is-option-type ? type : ctx get-concrete-type ctx.common-types.option[model-type]
		as option-or
			outer-type
		left = ctx concretize-expr left-type, x.left
		right = ctx concretize-expr type, x.right
		match x kind
		as bool-and-bool
			ctx.concretize-ctx gen-and range, left, right
		as bool-or-bool
			ctx.concretize-ctx gen-or range, left, right
		as option-else
			local concrete-local = member::concrete-generated-local-kind, type
			range gen-if-option left, (local, (range gen-local-get local)), right
		as option-or
			temp concrete-local = member::concrete-generated-local-kind, type
			get-temp = range gen-local-get temp
			type gen-let range, temp, left,
				range gen-if-option get-temp, ((), get-temp), right
	as loop-expr x
		type gen-loop range, (ctx concretize-expr type, x.body)
	as loop-break-expr x
		range gen-break (ctx concretize-expr type, x.value)
	as loop-continue-expr _
		type gen-continue range
	as loop-while-or-until-expr x
		ctx concretize-loop-while-or-until type, range, x
	as match-enum-expr x
		ctx concretize-match-enum type, range, x
	as match-integral-expr x
		ctx concretize-match-integral type, range, x
	as match-string-like-expr x
		ctx concretize-match-string-like type, range, x
	as match-sum-type-expr x
		ctx concretize-match-sum-type type, range, x
	as seq-expr x
		first = ctx concretize-expr ctx.void-type, x.first
		# See comment on 'as let-expr' for why we use 'outer-type' instead of 'type'
		then = ctx concretize-expr outer-type, x.then
		if _ ?= first.kind constant
			then
		else
			outer-type, range, do first.as-seq ~~ then.as-seq seq-concrete-expr
	as throw-expr x
		thrown = ctx concretize-expr ctx.concretize-ctx.exception-type, x.thrown
		type, range, thrown.throw-concrete-expr
	as trusted-expr x
		ctx concretize-expr type, x.inner
	as try-expr x
		ctx concretize-try type, range, x
	as try-let-expr x
		ctx concretize-try-let type, range, x
	as typed-expr x
		ctx concretize-expr type, x.inner
	ctx may-widen-type outer-type, res

-as-seq concrete-expr[](a concrete-expr)
	match a kind
	as seq-concrete-expr x
		x parts
	else
		- a

-may-widen-type concrete-expr
	ctx concretize-expr-ctx
	expected-type concrete-type
	actual concrete-expr
do
	ctx.concretize-ctx try-widen expected-type, actual ??
		show-ctx = ctx.concretize-ctx show-ctx
		where = show-ctx.line-and-column-getters[actual range]
		error log "You messed up! At: {where}, expected type: {show-ctx show-concrete-type expected-type}, actual: {show-ctx show-concrete-type actual.type}"
		throw todo

# This goes in reverse, from 'to' to 'from'. So must reverse the path at the end.
-try-widen concrete-expr?(ctx concretize-ctx, expected concrete-type, actual concrete-expr)
	if actual.type == expected
		actual
	elif expected is-option
		if res ?= ctx try-widen expected.unwrap-option-type, actual
			ctx gen-some expected, actual.range, res
	elif u ?= expected.body concrete-union
		if u has-members
			for member-index, member : u.members with-index
				if res ?= ctx try-widen member, actual
					break ctx gen-create-union expected, actual.range, member-index, res
		else
			for member-index, x : ctx.sum-types[expected]! with-index
				if res ?= ctx try-widen x.member-type, actual
					break ctx gen-create-union expected, actual.range, member-index, res

-concretize-finally concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a finally-expr
do
	right = ctx concretize-expr ctx.void-type, a.right
	below = ctx concretize-expr type, a.below
	type, range, (right finally-concrete-expr below)

-concretize-try concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a try-expr
do
	tried = ctx concretize-expr type, a.tried
	values, cases = ctx concretize-match-sum-type-cases type, range, ctx.concretize-ctx.exception-type, a.catches
	type, range, do tried try-concrete-expr values, cases, if x ?= a catch-else
		ctx concretize-expr-with-opt-destructure type, range, x

-concretize-try-let concrete-expr
	ctx concretize-expr-ctx
	type concrete-type
	range uri-and-range
	a try-let-expr
do
	local-type = ctx get-concrete-type a.destructure.type
	value = ctx concretize-expr local-type, a.value
	catch-member-index = ctx member-index-for-match-sum-type-case ctx.concretize-ctx.exception-type, a.catch_
	catch-expr = ctx concretize-expr-with-destructure type, range, a.catch_.destructure, a.catch_.then
	then = ctx concretize-expr-with-destructure type, range, a.destructure, a.then
	type, range, do then.local try-let-concrete-expr value, catch-member-index, catch-expr, then.expr
