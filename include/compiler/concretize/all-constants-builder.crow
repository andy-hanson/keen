import
	../model/concrete-model
	../model/model
	../util/full-index-map
	../util/util

all-constants-builder record mut
	-symbols constant-symbol mut[symbol]
	-arrs arr-type-and-constants mut[concrete-type]
	-records constant-record mut[constant[]] mut[concrete-type]
	-unions constant-union mut[constant-union-value] mut[concrete-type]
new all-constants-builder()
	(), (), (), ()

-arr-type-and-constants record mut
	arr-type concrete-type
	element-type concrete-type
	| The order this was inserted into {arrs}
	type-index nat
	constants constant[] mut[]

finish-all-constants all-constants-concrete(a all-constants-builder)
	arrays arr-type-and-constants-concrete mut[] = for _, x in a.arrs
		# Dummy value. We will actually do it by type-index below
		x.arr-type, x.element-type, ()
	for _, x in a.arrs
		arrays[x.type-index] := (x.arr-type, x.element-type, x.constants.move-to)

	records (constant-record, constant[]) full-index-map[concrete-type] = for struct, constants in a.records
		lookup constant[][constant-record] = for k, v in constants
			v, k
		res (constant-record, constant[]) full-index-map = for i in 0::nat .. lookup.size
			lookup[i,]!
		struct, res

	unions (constant-union, constant-union-value) full-index-map[concrete-type] = for struct, constants in a.unions
		lookup constant-union-value[constant-union] = for k, v in constants
			v, k
		res (constant-union, constant-union-value) full-index-map = for i in 0::nat .. lookup.size
			lookup[i,]!
		struct, res

	symbols-lookup symbol[nat] = for symbol, value in a.symbols then value.index, symbol
	symbols symbol[] = for x in 0::nat .. a.symbols.size then symbols-lookup[x]!
	symbols, arrays.move-to, records, unions

get-constant-array constant(all-constants all-constants-builder, array-type concrete-type, elements constant[])
	assert is-array-or-mut-array array-type
	res = ensure all-constants.arrs, array-type, of
		element-type = only! array-type.source.concrete-type-source-inst!.type-args # TODO: use a helper fn ------------------------
		array-type, element-type, all-constants.arrs.size, ()
	index = find-index-or-push res.constants, elements # TODO:PERF ------------------------------------------------------------------
	constant-array res.type-index, index

get-constant-string constant(a all-constants-builder, type concrete-type, value string)
	char8-array = type.body.concrete-record!.fields.only!.type
	get-constant-record a, type,
		# TODO:PERF this probably costs a lot. Support having a constant array that is represented as a char8[]. --------------------
		- get-constant-array a, char8-array, map value.to::char8[], it.to

get-constant-symbol constant(a all-constants-builder, value symbol)
	ensure a.symbols, value, of
		- a.symbols.size

get-constant-record constant(a all-constants-builder, struct concrete-type, args constant[])
	assert r = struct.body.concrete-record
	forbid prevent-constant r
	r.fields.size is args.size
	records = ensure a.records, struct
	ensure records, args, of
		- records.size

get-constant-union constant(a all-constants-builder, struct concrete-type, member-index nat, member constant)
	assert u = struct.body.concrete-union
	if u.has-members
		assert member-index < u.members.size
	unions = ensure a.unions, struct
	ensure unions, (member-index, member), of
		- unions.size
