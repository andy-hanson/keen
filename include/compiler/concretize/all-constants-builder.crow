import
	../model/concrete-model
	../model/model
	../util/full-index-map
	../util/util

all-constants-builder record mut
	-is-native bool
	-c-strings constant-c-string mut[string]
	-symbols constant-c-string mut[symbol]
	-c-string-values string mut[]
	-arrs arr-type-and-constants mut[concrete-struct]
	-records constant-record mut[constant[]] mut[concrete-struct]
	-unions constant-union mut[constant-union-value] mut[concrete-struct]
new all-constants-builder(is-native bool)
	is-native, (), (), (), (), (), ()

-arr-type-and-constants record mut
	arr-type concrete-struct
	element-type concrete-type
	# Order this was inserted into {arrs}
	type-index nat
	constants constant[] mut[]

finish-all-constants all-constants-concrete(a all-constants-builder, symbol-array-struct concrete-struct)
	static-symbols = a get-constant-array symbol-array-struct, for _, v : a symbols
		v to
	arrays arr-type-and-constants-concrete mut[] = for _, x : a arrs
		# Dummy value. We will actually do it by type-index below
		x.arr-type, x.element-type, ()
	for _, x : a.arrs
		arrays[x type-index] := (x.arr-type, x.element-type, x.constants.move-to)

	records (constant-record, constant[]) full-index-map[concrete-struct] = for struct, constants : a records
		lookup constant[][constant-record] = for k, v : constants
			v, k
		res (constant-record, constant[]) full-index-map = for i : 0::nat .. lookup.size
			lookup[i,]!
		struct, res

	unions (constant-union, constant-union-value) full-index-map[concrete-struct] = for struct, constants : a unions
		lookup constant-union-value[constant-union] = for k, v : constants
			v, k
		res (constant-union, constant-union-value) full-index-map = for i : 0::nat .. lookup.size
			lookup[i,]!
		struct, res

	a.c-string-values.move-to, static-symbols, arrays.move-to, records, unions

get-constant-array constant(all-constants all-constants-builder, array-struct concrete-struct, elements constant[])
	assert array-struct is-array-or-mut-array
	res = all-constants.arrs ensure array-struct, () =>
		element-type = array-struct.source.concrete-struct-source-inst!.type-args only
		array-struct, element-type, all-constants.arrs.size, ()
	index = res.constants find-index-or-push elements # TODO:PERF ------------------------------------------------------------------
	res.type-index constant-array index

get-constant-c-string constant(a all-constants-builder, value string)
	a get-constant-c-string-inner value to
-get-constant-c-string-inner constant-c-string(a all-constants-builder, value string)
	a.c-strings ensure value, () =>
		index = a.c-string-values size
		a.c-strings.size is index
		a.c-string-values ~= value
		index,

get-constant-string constant(a all-constants-builder, string-struct concrete-struct, value string)
	if a is-native
		a get-constant-array string-struct, for x : value.to::char8[]
			x.to integral-value
	else
		a get-constant-c-string value

get-constant-symbol constant(a all-constants-builder, value symbol)
	res = a.symbols ensure value, () =>
		a get-constant-c-string-inner value.to
	res to

get-constant-record constant(a all-constants-builder, struct concrete-struct, args constant[])
	struct.purity is data_
	assert r ?= struct.body concrete-record
	r.fields.size is args.size
	records = a.records ensure struct
	records ensure args, (() => records.size,) to

get-constant-record constant(a all-constants-builder, type concrete-type, args constant[])
	a get-constant-record type.struct, args

get-constant-union constant(a all-constants-builder, struct concrete-struct, member-index nat, member constant)
	assert u ?= struct.body concrete-union
	if u has-members
		assert member-index < u.members.size
	unions = a.unions ensure struct
	unions ensure (member-index, member), (() => unions.size,) to

gc-safe-value-for-type constant(constants all-constants-builder, type concrete-type)
	constants gc-safe-value-for-type-recur type, ()

-gc-safe-value-for-type-recur constant(constants all-constants-builder, type concrete-type, seen concrete-struct mut-set) # TODO: can't I just use constant-gc-safe-value and pass it through?
	match type.struct body
	as concrete-builtin-type x
		match x kind
		as array
			constants get-constant-array type.must-be-by-val, ()
		as bool
			0 integral-value
		as catch-point
			constant-null
		as char8
			0 integral-value
		as char32
			0 integral-value
		as const-pointer
			constant-null
		as float32
			0 constant-float
		as float64
			0 constant-float
		as fun-pointer
			constant-null
		as future
			constant-null
		as int8
			0 integral-value
		as int16
			0 integral-value
		as int32
			0 integral-value
		as int64
			0 integral-value
		as java-any
			constant-null
		as java-exclusion
			constant-null
		as js-any
			constant-null
		as fun-data
			constant-null
		as fun-mut
			constant-null
		as fun-shared
			constant-null
		as mut-array
			constant-null
		as mut-pointer
			constant-null
		as mut-slice
			# Use an immutable value, since it has length 0 and is impossible to change.
			constants get-constant-array type.must-be-by-val, ()
		as nat8
			0 integral-value
		as nat16
			0 integral-value
		as nat32
			0 integral-value
		as nat64
			0 integral-value
		as option
			error log "Tried to get gc-safe-value for option?" # ------------------------------------------------------------------------
			throw unreachable
		as string
			constants get-constant-c-string ""
		as symbol
			constants get-constant-c-string ""
		as void
			constant-null
		as weak-ref
			constant-gc-safe-value
	as concrete-enum _
		0 integral-value
	as concrete-extern-type
		constant-null
	as concrete-flags _
		0 integral-value
	as concrete-record _
		constant-gc-safe-value # TODO: I should just use this for everything and replace this function ..................................................
		###
		Below doesn't seem to be necessary any more
		if type.reference == by-ref_ || type.struct.purity != data_ || seen !try-add type.struct.id
			constant-null
		else
			args constant[] = for field : x fields
				constants gc-safe-value-for-type-recur field.type, seen
			constants get-constant-record type, args
		###
	as concrete-union u
		if u has-members
			constants get-constant-union type.must-be-by-val, 0, (constants gc-safe-value-for-type-recur u.members[0], seen)
		else
			constant-gc-safe-value # TODO: we could use the first member, but possibly the union members aren't filled in yet .........................
	as concrete-struct-body-deferred
		constant-null
