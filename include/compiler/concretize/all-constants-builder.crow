import
	../model/concrete-model
	../util/full-index-map
	../util/util

all-constants-builder record mut
	-is-native bool
	-c-strings constant-c-string mut[string]
	-symbols constant-c-string mut[symbol]
	-c-string-values string mut[]
	# Key is the element type
	-arrs arr-type-and-constants mut[concrete-type-id]
	# Key is the pointee type
	-pointers pointer-type-and-constants mut[concrete-struct-id]
	-records constant-record mut[constant[]] mut[concrete-struct-id]
new all-constants-builder(is-native bool)
	is-native, (), (), (), (), (), ()

-arr-type-and-constants record mut
	arr-type concrete-struct
	element-type concrete-type
	# Order this was inserted into {arrs}
	type-index nat
	constants constant[] mut[]

-pointer-type-and-constants record mut
	pointee-type concrete-struct
	type-index nat
	constants constant mut[]

finish-all-constants all-constants-concrete(a all-constants-builder, symbol-array-struct concrete-struct)
	static-symbols = a get-constant-array symbol-array-struct, for _, v : a symbols
		v to
	arrays arr-type-and-constants-concrete mut[] = for _, x : a arrs
		# Dummy value. We will actually do it by type-index below
		x.arr-type, x.element-type, ()
	for _, x : a.arrs
		arrays[x type-index] := (x.arr-type, x.element-type, x.constants.move-to)

	pointers pointer-type-and-constants-concrete mut[] = for _, x : a pointers
		# Dummy value. We will actually do it by type-index below
		x.pointee-type, ()
	for _, x : a pointers
		pointers[x type-index] := x.pointee-type, x.constants.move-to

	records (constant-record, constant[]) full-index-map[concrete-struct-id] = for struct-id, constants : a records
		lookup constant[][constant-record] = for k, v : constants
			v, k
		res (constant-record, constant[]) full-index-map = with out : build
			for _, i : constants
				out ~= lookup[i]!
		for _, args : res
			forbid args every x => x is-zero
		struct-id, res

	a.c-string-values.move-to, static-symbols, arrays.move-to, pointers.move-to, records

get-constant-pointer constant(constants all-constants-builder, pointee concrete-struct, value constant)
	d = constants.pointers ensure pointee.id, () =>
		pointee, constants.pointers.size, ()
	d.type-index constant-pointer (d.constants find-index-or-push value)

get-constant-array constant(all-constants all-constants-builder, array-struct concrete-struct, elements constant[])
	assert array-struct is-array-or-mut-array
	guard elements !is-empty : constant-zero
	element-type = array-struct.source.concrete-struct-source-inst!.type-args only
	d = all-constants.arrs ensure element-type.id, () =>
		array-struct, element-type, all-constants.arrs.size, ()
	index = d.constants find-index-or-push elements
	d.type-index constant-array index

get-constant-c-string constant(a all-constants-builder, value string)
	a get-constant-c-string-inner value to
-get-constant-c-string-inner constant-c-string(a all-constants-builder, value string)
	a.c-strings ensure value, () =>
		index = a.c-string-values size
		a.c-strings.size is index
		a.c-string-values ~= value
		index,

get-constant-string constant(a all-constants-builder, string-struct concrete-struct, value string)
	if a is-native
		a get-constant-array string-struct, for x : value.to::char8[]
			x.to integral-value
	else
		a get-constant-c-string value

get-constant-symbol constant(a all-constants-builder, value symbol)
	res = a.symbols ensure value, () =>
		a get-constant-c-string-inner value.to
	res to

get-constant-record constant(a all-constants-builder, struct concrete-struct, args constant[])
	assert r ?= struct.body concrete-record
	r.fields.size is args.size
	if args every x => x is-zero
		constant-zero
	else
		records = a.records ensure struct.id
		cr = records ensure args, () =>
			records.size,
		cr to

get-constant-record constant(a all-constants-builder, type concrete-type, args constant[])
	a maybe-allocate-constant type, (a get-constant-record type.struct, args)

-maybe-allocate-constant constant(a all-constants-builder, type concrete-type, inner constant)
	match type reference
	as by-val_
		inner
	as by-ref_
		a get-constant-pointer type.struct, inner
