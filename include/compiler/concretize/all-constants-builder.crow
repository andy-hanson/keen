import
	../model/concrete-model
	../model/integral-values
	../model/model
	../util/full-index-map
	../util/util

all-constants-builder record mut
	-c-strings constant-c-string mut[string] # TODO: strings should just be character arrays, shouldn't need special handling
	-symbols constant-symbol mut[symbol]
	-c-string-values string mut[] # TODO: strings should just be character arrays, shouldn't need special handling ----------
	-arrs arr-type-and-constants mut[concrete-type]
	-records constant-record mut[constant[]] mut[concrete-type]
	-unions constant-union mut[constant-union-value] mut[concrete-type]
new all-constants-builder()
	(), (), (), (), (), ()

-arr-type-and-constants record mut
	arr-type concrete-type
	element-type concrete-type
	# Order this was inserted into {arrs}
	type-index nat
	constants constant[] mut[]

finish-all-constants all-constants-concrete(a all-constants-builder)
	arrays arr-type-and-constants-concrete mut[] = for _, x : a arrs
		# Dummy value. We will actually do it by type-index below
		x.arr-type, x.element-type, ()
	for _, x : a.arrs
		arrays[x type-index] := (x.arr-type, x.element-type, x.constants.move-to)

	records (constant-record, constant[]) full-index-map[concrete-type] = for struct, constants : a records
		lookup constant[][constant-record] = for k, v : constants
			v, k
		res (constant-record, constant[]) full-index-map = for i : 0::nat .. lookup.size
			lookup[i,]!
		struct, res

	unions (constant-union, constant-union-value) full-index-map[concrete-type] = for struct, constants : a unions
		lookup constant-union-value[constant-union] = for k, v : constants
			v, k
		res (constant-union, constant-union-value) full-index-map = for i : 0::nat .. lookup.size
			lookup[i,]!
		struct, res

	symbols-lookup symbol[nat] = for symbol, value : a symbols; value.index, symbol
	symbols symbol[] = for x : 0::nat .. a.symbols.size; symbols-lookup[x]!
	a.c-string-values.move-to, symbols, arrays.move-to, records, unions

get-constant-array constant(all-constants all-constants-builder, array-type concrete-type, elements constant[])
	assert array-type is-array-or-mut-array
	res = all-constants.arrs ensure array-type, () =>
		element-type = array-type.source.concrete-type-source-inst!.type-args only # TODO: use a helper fn ------------------------
		array-type, element-type, all-constants.arrs.size, ()
	index = res.constants find-index-or-push elements # TODO:PERF ------------------------------------------------------------------
	res.type-index constant-array index

get-constant-c-string constant(a all-constants-builder, value string)
	a get-constant-c-string-inner value
-get-constant-c-string-inner constant-c-string(a all-constants-builder, value string)
	a.c-strings ensure value, () =>
		index = a.c-string-values size
		a.c-strings.size is index
		a.c-string-values ~= value
		index,

get-constant-string constant(a all-constants-builder, type concrete-type, value string)
	match type body
	as concrete-builtin-type b
		b.kind is string
		a get-constant-c-string value
	as concrete-record r
		char8-array = r.fields.only type
		# TODO:PERF this probably costs a lot. Support having a constant array that is represented as a char8[]. -------------
		char-constants constant[] = for char : value.to::char8[]
			(char.to,)::integral-value
		chars-array = a get-constant-array char8-array, char-constants
		a get-constant-record type, (chars-array,)
	else
		throw unreachable

get-constant-symbol constant(a all-constants-builder, value symbol)
	a.symbols ensure value, () => a.symbols.size,

get-constant-record constant(a all-constants-builder, struct concrete-type, args constant[])
	assert r ?= struct.body concrete-record
	r.fields.size is args.size
	records = a.records ensure struct
	records ensure args, () => records.size,

get-constant-union constant(a all-constants-builder, struct concrete-type, member-index nat, member constant)
	assert u ?= struct.body concrete-union
	if u has-members
		assert member-index < u.members.size
	unions = a.unions ensure struct
	unions ensure (member-index, member), () => unions.size,
