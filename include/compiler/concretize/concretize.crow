import
	../frontend/show-model
	../model/model
	../model/concrete-model
	../model/version-info
	./all-constants-builder
	./check-concrete-model
	./concretize-ctx
	./concretize-fun-body
	./gather-info
	./generate

concretize concrete-program(show-ctx show-ctx, version-info version-info, program program-with-main)
	ctx concretize-ctx = do
		show-ctx: show-ctx
		program: program
		version-info: version-info
		file-content-getters: show-ctx file-content-getters
		fill-in-concrete-fun-body: (ctx, fun) => ctx fill-in-concrete-fun-body fun
	common-funs = program.program common-funs
	ctx.late-create-error-function := (ctx get-non-template-concrete-fun common-funs.create-error),
	ctx.late-equal-symbol-function := (ctx get-non-template-concrete-fun common-funs.equal-symbol),
	ctx.late-new-json-from-pairs-function := (ctx get-non-template-concrete-fun common-funs.new-json-from-pairs),
	json-to-json = ctx get-non-template-concrete-fun common-funs.to-json-from-json
	ctx.late-to-json-from-json-array-function := (ctx get-concrete-fun common-funs.to-json-from-t-array, (ctx.json-type,), (json-to-json,)),
	concrete-common-funs concrete-common-funs = if ctx is-native
		res concrete-common-funs-native = do
			alloc: ctx get-non-template-concrete-fun common-funs.allocate
			cur-catch-point: ctx get-non-template-concrete-fun common-funs.cur-catch-point
			set-cur-catch-point: ctx get-non-template-concrete-fun common-funs.set-cur-catch-point
			cur-thrown: ctx get-var common-funs.cur-thrown
			mark: ctx get-non-template-concrete-fun common-funs.mark
			rethrow-current-exception: ctx get-non-template-concrete-fun common-funs.rethrow-current-exception
			run-fiber: ctx get-non-template-concrete-fun common-funs.run-fiber
			rt-main: ctx get-non-template-concrete-fun common-funs.rt-main
			throw-impl: ctx get-non-template-concrete-fun common-funs.throw-impl
			user-main: ctx concretize-main-fun common-funs, program.main-fun
			gc-root: ctx get-non-template-concrete-fun common-funs.gc-root
			set-gc-root: ctx get-non-template-concrete-fun common-funs.set-gc-root
			pop-gc-root: ctx get-non-template-concrete-fun common-funs.pop-gc-root
		res to
	elif ctx is-js
		res concrete-common-funs-js = do
			exception: ctx exception-type
			string: ctx string-type
			symbol: ctx symbol-type
			js-await: ctx get-non-template-concrete-fun common-funs.js-await
			main: ctx concretize-main-fun common-funs, program.main-fun
		res to
	elif ctx is-java
		res concrete-common-funs-java = do
			exception: ctx.exception-type must-be-by-val
			show-exception: ctx get-non-template-concrete-fun common-funs.show-exception
			main: ctx concretize-main-fun common-funs, program.main-fun
		res to
	else
		throw unreachable

	ctx finish-lambdas
	ctx finish-variants

	all-concrete-funs concrete-fun[] = ctx.all-concrete-funs move-to
	ctx deferred-fill-record-and-union-bodies

	for struct : ctx all-concrete-structs
		if ctx is-native
			assert _ ?= struct late-default-reference-kind
			assert _ ?= struct late-type-size
		else
			forbid _ ?= struct late-default-reference-kind
			forbid _ ?= struct late-type-size
			assert struct.field-offsets is-empty

	res concrete-program = do
		version: version-info
		all-constants: ctx.all-constants finish-all-constants ctx.symbol-array-type
		all-structs: ctx.all-concrete-structs.move-to
		all-vars: ctx finish-concrete-vars
		all-funs: all-concrete-funs
		yielding-funs: concrete-common-funs get-yielding-funs all-concrete-funs
		common-funs: concrete-common-funs
	common-types concrete-common-types = do
		bool: ctx bool-type
		exception: ctx exception-type
		integral-types: ctx integral-types
		symbol: ctx symbol-type
		void: ctx void-type
	show-ctx check-concrete-program common-types, res
	res

-concretize-main-fun concrete-fun(ctx concretize-ctx, common-funs common-funs, main main-fun)
	match main
	as main-fun-nat64-of-args x
		ctx get-non-template-concrete-fun x.fun
	as main-fun-void x
		ctx concrete-fun-for-wrap-main x.fun
	as test-selector _
		ctx concrete-fun-for-wrap-main common-funs.run-all-tests

-finish-lambdas void(ctx concretize-ctx)
	if ctx preserve-lambdas
		assert ctx.lambda-structs is-empty
	else
		for _, (struct, impls) : ctx lambda-structs
			case-types concrete-type[] = for x : impls
				x closure-type
			struct.body := (case-types,) concrete-union
			if ctx is-native
				ctx.deferred-type-size ~= struct

		for fun : ctx all-concrete-funs
			if builtin_ ?= fun.body concrete-fun-body-builtin
				if _ ?= builtin_.kind builtin-fun-call-lambda
					lambda = fun.params[0].type must-be-by-val
					fun.body := ctx generate-call-lambda fun, lambda.body.concrete-union!.members, ctx.lambda-structs[lambda id]!.b.move-to

-finish-variants void(ctx concretize-ctx)
	for _, (sum-type, cases) : ctx sum-types
		unless sum-type.body.concrete-union! has-members # It will already be set for a 'union' (not interface or variant)
			sum-type finish-sum-type-cases cases
	
	for fun : ctx deferred-methods
		sum-type = fun.params[0].type must-be-by-val
		method-index = fun.source.concrete-fun-source-regular!.decl.body.fun-body-method! method-index
		_, impls = ctx.sum-types[sum-type id]!
		fun.body := ctx generate-call-method fun, sum-type, impls, method-index
