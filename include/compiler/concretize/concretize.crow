import
	../frontend/show-model
	../model/concrete-model
	../model/model
	../model/source-range
	../util/by-name
	../util/perf
	./all-constants-builder
	./check-concrete-model
	./concretize-ctx
	./concretize-expr
	./concretize-fun-body
	./gather-info
	./generate
	./replace-constants

concretize concrete-program(target build-target, program program-with-main) show-ctx
	start = perf-now
	res = concretize-inner target, program
	end-concretize start
	res

-concretize-inner concrete-program(target build-target, program program-with-main) show-ctx
	ctx concretize-ctx =
		show-ctx: the::show-ctx
		program: program
		target: target
	the concretize-ctx = ctx
	common-funs = common-funs program.program
	ctx.late-equal-symbol-function := get-non-template-concrete-fun common-funs.equal-symbol
	ctx.late-json-named-new-function := get-non-template-concrete-fun common-funs.json-named-new
	show-exception = get-non-template-concrete-fun common-funs.show-exception
	to-symbol-from-string = get-non-template-concrete-fun common-funs.to-symbol-from-string
	to-string-from-js-any = get-non-template-concrete-fun common-funs.to-string-from-js-any
	concrete-common-funs concrete-common-funs = match target
	as js
		:: concrete-common-funs-js
		exception: exception-type
		js-any: get-concrete-type-for-struct-inst common-types.js-any, ()
		main: concretize-main-fun program.main-fun
		show-exception: show-exception
		to-symbol-from-string: to-symbol-from-string
		to-string-from-js-any: to-string-from-js-any
	as java
		:: concrete-common-funs-java
		exception: exception-type
		bool: bool-type
		nat32: integral-type nat32
		show-exception: show-exception
		start-runtime: get-non-template-concrete-fun common-funs.start-runtime
		stop-runtime: get-non-template-concrete-fun common-funs.stop-runtime
		to-symbol-from-string: to-symbol-from-string
		main: concretize-main-fun program.main-fun

	loop
		any mut bool = false
		while fun = pop ctx.all-unprocessed-concrete-funs
			any := true
			ctx.all-processed-concrete-funs ~= fun
			do if fun.body.concrete-fun-body-deferred
			match body = fun-body-decl fun
			as expr
				fun.body := concretize-fun-body fun, body
				any := true
			as expr-with-allocated-locals
				fun.body := concretize-fun-body fun, body
				any := true
			as fun-body-method
				()
			else
				throw unreachable
		if fill-sum-type-method-impls or make-callers-for-java-interfaces
			any := true
		if any
			continue
		else
			break

	assert is-empty ctx.all-unprocessed-concrete-funs

	replace-constants

	method-impls = finish-variants

	all-funs concrete-fun[] = ctx.all-processed-concrete-funs.move-to
	all-vars = finish-concrete-vars
	all-constants = finish-all-constants all-constants
	fun-info = gather-info concrete-common-funs, all-funs, all-vars, method-impls
	all-structs concrete-type[] = ctx.all-concrete-types.move-to
	res concrete-program =
		all-funs-including-extern concrete-fun[] = sort fun-info.all-used-funs.to, it.range
		model-program: program program
		target: target
		all-constants: all-constants
		all-non-extern-types: filter all-structs, !it.as-extern
		all-types-including-extern: all-structs
		all-vars: all-vars
		all-non-extern-funs: filter all-funs-including-extern, !it.is-extern
		all-funs-including-extern: all-funs-including-extern
		method-impls: method-impls
		async: fun-info.async
		common-funs: concrete-common-funs
	check-concrete-program res,
		bool: bool-type
		char-types: char-types
		exception: exception-type
		integral-types: integral-types
		float-types: float-types
		string: string-type
		void: void-type
	res

-concretize-main-fun concrete-fun(main main-fun) concretize-ctx
	match main
	as main-fun-nat64-of-args
		get-non-template-concrete-fun main.fun
	as main-fun-void
		concrete-fun-for-wrap-main main.fun
	as test-selector
		concrete-fun-for-all-tests main

-fill-sum-type-method-impls bool() concretize-ctx
	ctx = the::concretize-ctx
	res = !is-empty ctx.deferred-sum-type-method-impls
	while sum-type, index, kind = pop ctx.deferred-sum-type-method-impls
		body = sum-type-body-from-type sum-type
		case_ = ctx.sum-types[sum-type]![index]
		forbid case_.method-impls
		case_.method-impls := match kind
		as declared-on-sum-type
			i = body.listed-members[index]
			type-args = sum-type.source.concrete-type-source-inst!.type-args
			sum-type-method-impls-common i.method-impls, type-args
		as declared-on-case-type
			sum-type-membership-method-impls sum-type, case_.member-type
		case_.method-impls!.size is body.methods.size
	res

-make-callers-for-java-interfaces bool() concretize-ctx
	interfaces = the::concretize-ctx.deferred-java-interfaces
	res = !is-empty interfaces
	while decl = pop interfaces
		# For a Crow interface, we know all calls to its methods and so can omit unused methods.
		# That is not the case for Java interfaces, so make sure all methods are generated.
		module = java-module-at-uri program, decl.module-uri
		for fun in module.public-exports.funs
			do if fun.body.fun-body-method
			target = fun.params[0].type.struct-inst!.decl # TODO: there is other code like this somewhere ....................
			do if target == decl
			_ = get-concrete-fun fun, (), ()
	res

-finish-variants concrete-method-info[concrete-type]() concretize-ctx
	ctx = the::concretize-ctx
	for sum-type, cases in ctx.sum-types
		unless has-members sum-type.body.concrete-union! # It will already be set for a 'union' (not interface or variant)
			finish-sum-type-cases sum-type, cases

	if preserve-methods
		assert is-empty ctx.deferred-methods
		for sum-type, cases in ctx.sum-types
			sum-type, if methods-unsorted = ctx.sum-type-to-methods[sum-type]
				# TODO: below could use move-to? --------------------------------------------------------------------------------
				methods concrete-fun[] = sort methods-unsorted.to, it.method-index
				method-indices nat[] = map methods, it.method-index
				methods: methods
				cases: for case_ in cases
					select-indices case_.method-impls!, method-indices
	else
		for fun in ctx.deferred-methods
			sum-type = fun.params[0].type
			method-index = fun.source.concrete-fun-source-regular!.decl.body.fun-body-method!.method-index
			fun.body := generate-call-method fun, sum-type, ctx.sum-types[sum-type]!, method-index
		()

-method-index nat(a concrete-fun)
	a.body.concrete-fun-body-method!.method-index

-select-indices[t] t[](a t[], indices nat[])
	map indices, a[it]
