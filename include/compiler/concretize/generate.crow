import
	../model/concrete-model
	../model/integral-values
	../model/model
	../model/source-range
	../util/util
	./all-constants-builder
	./concretize-ctx

gen-constant concrete-expr(type concrete-type, range uri-and-range, value constant)
	type, range, value

gen-constant-integral concrete-expr(type concrete-type, range uri-and-range, value integral-value)
	type gen-constant range, value

gen-false concrete-expr(ctx concretize-ctx, range uri-and-range)
	ctx gen-bool range, false
gen-true concrete-expr(ctx concretize-ctx, range uri-and-range)
	ctx gen-bool range, true
-gen-bool concrete-expr(ctx concretize-ctx, range uri-and-range, value bool)
	ctx.bool-type gen-constant range, value.constant-bool

gen-call concrete-expr(range uri-and-range, called concrete-fun, args concrete-expr[])
	called.return-type, range, (called gen-call-kind args)
gen-call-kind concrete-expr-kind(called concrete-fun, args concrete-expr[]) # INLINE --------------------------------------------
	called call-concrete-expr args

# TODO: If I'm just going to use 'then.type' as the type anyway, I might as well have it be a function on the if-concrete-expr
gen-if concrete-expr(range uri-and-range, cond concrete-expr, then_ concrete-expr, else_ concrete-expr)
	then_.type, range, do cond if-concrete-expr then_, else_
# TODO: most of these functions are unnecessary ....................................................................................
gen-loop concrete-expr(type concrete-type, range uri-and-range,  body concrete-expr)
	type, range, body.loop-concrete-expr
gen-do-and-continue concrete-expr(type concrete-type, range uri-and-range, a concrete-expr)
	# Make sure we don't have 'throw' followed by an unnecessary 'continue' or we get unreachable code errors in the Java backend
	match a kind
	as throw-concrete-expr x
		type, range, x
	else
		range gen-seq a, (type gen-continue range)
gen-seq concrete-expr(range uri-and-range, a concrete-expr, b concrete-expr)
	assert a.type is-void
	b.type, range, (a, b).seq-concrete-expr
gen-drop-then concrete-expr(ctx concretize-ctx, range uri-and-range, a concrete-expr, b concrete-expr)
	range gen-seq (ctx gen-drop range, a), b
gen-continue concrete-expr(type concrete-type, range uri-and-range)
	type, range, loop-continue-concrete-expr
gen-break concrete-expr(range uri-and-range, value concrete-expr)
	value.type, range, value.loop-break-concrete-expr
gen-create-union concrete-expr
	_ concretize-ctx # TODO: RM? --------------------------------------------------------------------------------------------------------
	type concrete-type
	range uri-and-range
	member-index nat
	arg concrete-expr
do
	type, range, (member-index create-union-concrete-expr arg)

gen-option concrete-expr
	ctx concretize-ctx
	option-type concrete-type
	range uri-and-range
	arg concrete-expr
do
	assert option-type.unwrap-option-type! == arg.type
	ctx gen-create-union option-type, range, 1, arg
gen-constant-some concrete-expr
	ctx concretize-ctx
	option-type concrete-type
	range uri-and-range
	inner constant
do
	ctx assert-is-option-type option-type
	option-type gen-constant range, (ctx.all-constants get-constant-union option-type, 1, inner)
gen-empty-option concrete-expr(ctx concretize-ctx, option-type concrete-type, range uri-and-range)
	option-type gen-constant range, (ctx gen-constant-none option-type)
gen-constant-none constant(ctx concretize-ctx, option-type concrete-type)
	ctx assert-is-option-type option-type
	none-type = option-type.body.concrete-union!.members[0]
	ctx.all-constants get-constant-union option-type, 0,
		ctx.all-constants get-constant-record none-type, ()
unwrap-option-type concrete-type(ctx concretize-ctx, option-type concrete-type)
	ctx assert-is-option-type option-type
	option-type.source.concrete-type-source-inst!.type-args only
-assert-is-option-type void(ctx concretize-ctx, option-type concrete-type)
	# TODO: this shouldn't need ctx, we could look at the source -----------------------------------------------------------------------
	assert option-type.source.concrete-type-source-inst!.decl == ctx.common-types.option

gen-void concrete-expr(ctx concretize-ctx, range uri-and-range)
	ctx.void-type gen-constant range, constant-gc-safe-value

gen-let concrete-expr
	type concrete-type
	range uri-and-range
	local concrete-local
	value concrete-expr
	then_ concrete-expr
do
	type, range, do local let-concrete-expr value, then_

gen-drop concrete-expr(ctx concretize-ctx, range uri-and-range, inner concrete-expr)
	ctx.void-type, range, inner.drop-concrete-expr
gen-local-get concrete-expr(range uri-and-range, local concrete-local)
	local.type, range, local.local-get-concrete-expr
gen-local-set concrete-expr(ctx concretize-ctx, range uri-and-range, local concrete-local, value concrete-expr)
	ctx.void-type, range, (local local-set-concrete-expr value)

field-index-from-field nat(record-type concrete-type, field record-field)
	record-type.source.concrete-type-source-inst!.decl.body.record_!.fields index-of! field

# TODO: I think this whole thing should be its own kind of concrete-expr, so the java version can be optimized -------------
gen-union-member-get concrete-fun-body(ctx concretize-ctx, fun concrete-fun, case-index nat)
	###
	This is basically:
	match a
	as member x
		x,
	else
		()
	###
	option-type = fun return-type
	case-type = option-type unwrap-option-type!
	range = fun range
	option-type, range,
		:: match-union-concrete-expr
		matched: range gen-local-get fun.params.only
		member-indices: (case-index,),
		cases:
			local concrete-local = member::concrete-generated-local-kind, case-type
			case_ concrete-local-and-expr = local,
				ctx gen-option option-type, range, do range gen-local-get local
			case_,
		else_: (), do ctx gen-empty-option option-type, range

generate-call-method concrete-fun-body
	ctx concretize-ctx
	fun concrete-fun
	sum-type concrete-type
	cases concrete-sum-type-case mut[]
	method-index nat
do
	forbid ctx preserve-methods
	range = fun range
	members = sum-type.body.concrete-union! members
	if members is-empty
		ctx gen-throw-string fun.return-type, range, "Called method of empty interface"
	else
		members.size is cases.size
		fun.return-type gen-match-union range, members, (range gen-param-get fun.params[0]), (i, member) =>
			if impl ?= cases[i].method-impls![method-index]
				range gen-call impl, for param-index, param in fun.params with-index
					param-index == 0 and member else range gen-param-get param
			else
				ctx gen-bogus fun.return-type, range 

gen-match-enum-or-integral concrete-expr
	type concrete-type
	range uri-and-range
	matched concrete-expr
	f concrete-expr mut(x enum-or-flags-member)
do
	members = matched.type must-be-enum
	values integral-values = for x in members
		x value
	type gen-match-enum-or-integral range, matched, values, (members for-loop f), ()
gen-match-enum-or-integral concrete-expr
	type concrete-type
	range uri-and-range
	matched concrete-expr
	case-values integral-values
	cases concrete-expr[]
	else_ concrete-local-and-expr?
do
	type, range, (matched, case-values, cases, else_)::match-enum-or-integral-concrete-expr
gen-match-union concrete-expr
	return-type concrete-type
	range uri-and-range
	member-types concrete-type[]
	union_ concrete-expr
	f concrete-expr mut(member-index nat, get-local concrete-expr)
do
	cases concrete-local-and-expr[] = for member-index, member-type in member-types with-index
		local concrete-local = member::concrete-generated-local-kind, member-type
		local, f[member-index, (range gen-local-get local)]
	kind match-union-concrete-expr = union_, member-types.size.integral-values-range, cases, ()
	return-type, range, kind

gen-throw concrete-expr(type concrete-type, range uri-and-range, thrown concrete-expr)
	type, range, thrown.gen-throw-kind
gen-bogus concrete-expr(ctx concretize-ctx, type concrete-type, range uri-and-range)
	type, range, (ctx gen-bogus-kind range)
gen-bogus-kind concrete-expr-kind(ctx concretize-ctx, range uri-and-range)
	ctx gen-throw-string-kind range, "Reached compile error"
-gen-throw-kind concrete-expr-kind(thrown concrete-expr)# TODO: inline ----------------------------------------------------------------
	thrown throw-concrete-expr
gen-error concrete-expr(ctx concretize-ctx, range uri-and-range, message string)
	# Avoid using a constant so it will have a stack trace
	error = ctx gen-create-record ctx.error-type, range, do (ctx gen-string-literal range, message),
	member-index = ctx sum-type-case-index ctx.exception-type, ctx.error-type
	ctx gen-create-union ctx.exception-type, range, member-index, error
-gen-throw-string concrete-expr(ctx concretize-ctx, type concrete-type, range uri-and-range, message string)
	type gen-throw range, (ctx gen-error range, message)
-gen-throw-string-kind concrete-expr-kind(ctx concretize-ctx, range uri-and-range, message string)
	ctx gen-error range, message gen-throw-kind

gen-string-literal concrete-expr(ctx concretize-ctx, range uri-and-range, value string)
	ctx.string-type, range, do ctx gen-string-literal-kind value
gen-string-literal-kind concrete-expr-kind(ctx concretize-ctx, value string)
	chars = ctx constant-of-bytes ctx.char8-array-type, value.to-bytes
	ctx.all-constants get-constant-record ctx.string-type, (chars,)
gen-char8-array concrete-expr(ctx concretize-ctx, range uri-and-range, value string)
	type = ctx char8-array-type
	type gen-constant range, (ctx constant-of-bytes type, value.to-bytes)
constant-of-bytes constant(ctx concretize-ctx, array-type concrete-type, bytes nat8[])
	# TODO:PERF creating a Constant per byte is expensive
	elements constant[] = for x in bytes
		x.to integral-value
	ctx.all-constants get-constant-array array-type, elements
gen-char32-array concrete-expr(ctx concretize-ctx, range uri-and-range, value string)
	type = ctx char32-array-type
	type gen-constant range, (ctx char32-array-constant type, value)
-char32-array-constant constant(ctx concretize-ctx, type concrete-type, value string)
	ctx.all-constants get-constant-array type, for x in value.to::char32[]
		x.to integral-value

gen-call-variadic concrete-expr(ctx concretize-ctx, range uri-and-range, called concrete-fun, args concrete-expr[])
	range gen-call called, ((ctx gen-create-array called.params.only.type, range, args),)

-gen-create-array concrete-expr(ctx concretize-ctx, array-type concrete-type, range uri-and-range, args concrete-expr[])
	if args is-empty
		array-type gen-constant range, (ctx.all-constants get-constant-array array-type, ())
	else
		array-type, range, args.create-array-concrete-expr

gen-create-record concrete-expr(ctx concretize-ctx, type concrete-type, range uri-and-range, args concrete-expr[])
	type, range, if type.body.concrete-record! !prevent-constant and x ?= args as-constants
		ctx.all-constants get-constant-record type, x
	else
		args create-record-concrete-expr

as-constants constant[]?(exprs concrete-expr[])
	exprs map-or-none x => x.kind constant

gen-constant-symbol concrete-expr(ctx concretize-ctx, range uri-and-range, value symbol)
	ctx.symbol-type gen-constant range, (ctx constant-symbol value)

gen-param-get concrete-expr(range uri-and-range, param concrete-local)
	param.type, range, param.local-get-concrete-expr

# TODO: INLINE -------------------------------------------------------------------------------------------------------------------
gen-record-field-get concrete-expr
	ctx concretize-ctx
	field-type concrete-type
	range uri-and-range
	arg concrete-expr
	field-index nat
do
	if field-type is-empty-type
		ctx gen-drop-then range, arg, (field-type gen-constant range, constant-gc-safe-value)
	else
		field-type, range, (arg record-field-get-concrete-expr field-index)
# TODO: INLINE -------------------------------------------------------------------------------------------------------------------
gen-record-field-set concrete-expr
	ctx concretize-ctx
	range uri-and-range
	record_ concrete-expr
	field-index nat
	value concrete-expr
do
	ctx.void-type, range, (record_ record-field-set-concrete-expr field-index, value)
gen-and concrete-expr(ctx concretize-ctx, range uri-and-range, a concrete-expr, b concrete-expr)
	range gen-if a, b, (ctx gen-false range)
gen-or concrete-expr(ctx concretize-ctx, range uri-and-range, a concrete-expr, b concrete-expr)
	range gen-if a, (ctx gen-true range), b

gen-reference-create concrete-expr(ctx concretize-ctx, reference-type concrete-type, range uri-and-range, value concrete-expr)
	ctx gen-create-record reference-type, range, (value,)
gen-reference-read concrete-expr(ctx concretize-ctx, range uri-and-range, reference concrete-expr)
	ctx gen-record-field-get (ctx get-referenced-type reference.type), range, reference, 0
gen-reference-write concrete-expr
	ctx concretize-ctx
	range uri-and-range
	reference concrete-expr
	value concrete-expr
do
	_ = ctx get-referenced-type reference.type # Assert that it's a reference type
	ctx gen-record-field-set range, reference, 0, value

# TODO: inline most of these ---------------------------------------------------------------------------------------------------------
gen-equal-integral concrete-expr
	ctx concretize-ctx
	range uri-and-range
	a concrete-expr
	b concrete-expr
do
	ctx.bool-type gen-builtin range, equal-exact, (), (a, b)
gen-less-integral concrete-expr
	ctx concretize-ctx
	range uri-and-range
	a concrete-expr
	b concrete-expr
do
	ctx.bool-type gen-builtin range, less::builtin-binary, (), (a, b)
gen-intersect-integral concrete-expr
	ctx concretize-ctx
	range uri-and-range
	type integral-type
	a concrete-expr
	b concrete-expr
do
	ctx integral-type type gen-builtin range, bitwise-and, (), (a, b)
gen-builtin concrete-expr
	type concrete-type
	range uri-and-range
	fun builtin-fun
	type-args concrete-type[]
	args concrete-expr[]
do
	type, range, (fun builtin-concrete-expr type-args, args)

gen-concat-array concrete-expr(ctx concretize-ctx, range uri-and-range, a concrete-expr, b concrete-expr)
	assert a.type == b.type
	concat = ctx get-concrete-fun ctx.common-funs.concat-arrays, (a.type.array-element-type,), ()
	range gen-call concat, (a, b)
