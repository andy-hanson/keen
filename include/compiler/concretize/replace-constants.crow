import
	../model/concrete-model
	../model/model
	../util/util
	./all-constants-builder
	./concretize-ctx
	./generate

replace-constants void(ctx concretize-ctx)
	constants-map constant mut[concrete-fun] = for* fun in ctx all-concrete-funs
		guard e ?= fun.body concrete-expr
		guard c ?= e.kind constant
		- fun, c
	loop
		added-any-new-constants mut bool = false
		for fun in ctx all-concrete-funs
			guard e ?= fun.body concrete-expr
			if new-body ?= (ctx, constants-map, ()) replace-constants-expr e
				fun.body := new-body
				if c ?= new-body.kind constant
					constants-map[fun] := c
					added-any-new-constants := true
		if added-any-new-constants
			continue
		else
			break

-replace-constants-ctx record mut
	ctx concretize-ctx
	constants-map constant mut[concrete-fun]
	constant-locals constant mut[concrete-local]
-replace-constants concrete-expr-kind?(ctx replace-constants-ctx, a concrete-expr)
	match a kind
	as array-op-concrete-expr x
		guard input, body ?= ctx replace-constants-in-args-exprs x.input, x.body
		input array-op-concrete-expr x.local, x.empty-out-array, body
	as builtin-concrete-expr x
		guard args ?= ctx replace-constants-in-args-exprs x.args
		x.fun builtin-concrete-expr x.type-args, args
	as call-concrete-expr x
		if res ?= ctx.constants-map[x called]
			res
		elif args ?= ctx replace-constants-in-args-exprs x.args
			if constants ?= args as-constants
				if constant ?= ctx.ctx try-eval-constant x.called, constants
					constant
				else
					x.called call-concrete-expr args
			else
				x.called call-concrete-expr args
		else
			# TODO: if they are already constants, we should have already propagated them? ------------------------------------------
			if constants ?= x.args as-constants
				if constant ?= ctx.ctx try-eval-constant x.called, constants
					constant
	as cast-concrete-expr _
		()
	as constant _
		()
	as create-array-concrete-expr x
		guard args ?= ctx replace-constants-in-args x.args
		match args
		as constants c
			ctx.ctx.all-constants get-constant-array a.type, c.constants
		as exprs e
			e.exprs create-array-concrete-expr
	as create-record-concrete-expr x
		guard args ?= ctx replace-constants-in-args x.args, !a.type.body.concrete-record!.prevent-constant
		match args
		as constants c
			ctx.ctx.all-constants get-constant-record a.type, c.constants
		as exprs e
			e.exprs create-record-concrete-expr
	as create-union-concrete-expr x
		guard arg ?= ctx replace-constants-expr x.arg
		if c ?= arg.kind constant
			ctx.ctx.all-constants get-constant-union a.type, x.member-index, c
		else
			x.member-index create-union-concrete-expr arg
	as drop-concrete-expr x
		guard arg ?= ctx replace-constants-expr x.arg
		arg drop-concrete-expr
	as finally-concrete-expr x
		guard right, below ?= ctx replace-constants-in-args-exprs x.right, x.below
		right finally-concrete-expr below
	as if-concrete-expr x
		guard cond, then_, else_ ?= ctx replace-constants-in-args x.cond, x.then_, x.else_
		if constant-cond ?= cond.kind constant
			if constant-cond as-bool then then_ kind else else_ kind
		else
			cond if-concrete-expr then_, else_
	as let-concrete-expr x
		if value ?= ctx replace-constants-expr x.value
			if x.local !is-mutable and v ?= value.kind constant
				ctx.constant-locals[x local] := v
				# TODO: should not need type annotation (but the compiler gets confused converting concrete-expr-kind? to concrete-expr-kind??
				(ctx replace-constants x.then_ else x.then_ kind)::concrete-expr-kind
			else
				x.local let-concrete-expr value, do ctx replace-constants-expr x.then_ else x then_
		elif then_ ?= ctx replace-constants-expr x.then_
			x.local let-concrete-expr x.value, then_
	as lambda-concrete-expr x
		guard body ?= ctx replace-constants-expr x.body
		x.closure lambda-concrete-expr x.param, body # TODO: remove things from closure that are constants ------------------------------
	as local-get-concrete-expr x
		ctx.constant-locals[x local]
	as local-set-concrete-expr x
		guard value ?= ctx replace-constants-expr x.value
		x.local local-set-concrete-expr value
	as loop-concrete-expr x
		guard body ?= ctx replace-constants-expr x.body
		body loop-concrete-expr
	as loop-break-concrete-expr x
		guard value ?= ctx replace-constants-expr x.value
		value loop-break-concrete-expr
	as loop-continue-concrete-expr
		()
	as match-scalar-concrete-expr x
		matched = ctx replace-constants-expr x.matched
		cases = ctx replace-constants-in-args-exprs x.case-exprs
		else_ = ctx replace-constants-in-opt-local-and-expr x.else_
		guard _ ?= matched or _ ?= cases or _ ?= else_
		# TODO: if 'matched' is a constant, use just that branch -------------------------------------------------------------------
		:: match-scalar-concrete-expr
		matched: matched else x matched
		case-values: x case-values
		case-exprs: cases else x case-exprs
		else_: else_ or x else_
	as match-string-like-concrete-expr x
		matched = ctx replace-constants-expr x.matched
		# TODO: if 'matched' is a constant, use just that branch -------------------------------------------------------------------
		updated-case mut bool = false
		cases concrete-match-string-like-case[] = for case_ in x cases
			value = ctx replace-constants-expr case_.value
			then_ = ctx replace-constants-expr case_.then_
			updated-case := updated-case or _ ?= value or _ ?= then_
			value: value else case_ value
			then_: then_ else case_.then_
		else_ = ctx replace-constants-in-opt-local-and-expr x.else_
		guard _ ?= matched or updated-case or _ ?= else_
		:: match-string-like-concrete-expr
		matched: matched else x matched
		equals: x equals
		cases: cases
		else_: else_ else x else_
	as match-union-concrete-expr x
		matched = ctx replace-constants-expr x.matched
		# TODO: if 'matched' is a constant, use just that branch -------------------------------------------------------------------
		cases = ctx replace-constants-in-match-union-cases x.cases
		else_ = ctx replace-constants-in-opt-local-and-expr x.else_
		guard _ ?= matched or _ ?= cases or _ ?= else_
		:: match-union-concrete-expr
		matched: matched else x.matched
		member-indices: x member-indices
		cases: cases else x cases
		else_: else_ or x else_
	as record-field-get-concrete-expr x
		guard record_ ?= ctx replace-constants-expr x.record_
		# TODO: For a constant record, get the constant field value! ---------------------------------------------------------
		record_ record-field-get-concrete-expr x.field-index
	as record-field-set-concrete-expr x
		guard record_, value ?= ctx replace-constants-in-args-exprs x.record_, x.value
		record_ record-field-set-concrete-expr x.field-index, value
	as seq-concrete-expr x
		guard new-parts ?= ctx replace-constants-in-args-exprs x.parts
		without-constants concrete-expr[] = for* index, part in new-parts with-index
			if index != new-parts.size - 1 and _ ?= part.kind constant
				assert _ ?= part.kind.constant! constant-gc-safe-value # Always void
			else
				- part
		# TODO: should not need type annotation
		::concrete-expr-kind
		without-constants.opt-only ?kind else without-constants seq-concrete-expr
	as throw-concrete-expr x
		guard thrown ?= ctx replace-constants-expr x.thrown
		thrown throw-concrete-expr
	as try-concrete-expr x
		tried = ctx replace-constants-expr x.tried
		cases = ctx replace-constants-in-match-union-cases x.catch-cases
		catch-else = ctx replace-constants-in-opt-local-and-expr x.catch-else
		guard _ ?= tried or _ ?= cases or _ ?= catch-else
		:: try-concrete-expr
		tried: tried else x tried
		exception-member-indices: x exception-member-indices
		catch-cases: cases else x catch-cases
		catch-else: catch-else or x catch-else
	as try-let-concrete-expr x
		# TODO: if value is constant, the local is constant too -------------------------------------------------------------------
		value = ctx replace-constants-expr x.value
		catch_ = ctx replace-constants-in-local-and-expr x.catch_
		then_ = ctx replace-constants-expr x.then_
		guard _ ?= value or _ ?= catch_ or _ ?= then_
		:: try-let-concrete-expr
		local: x local
		value: value else x value
		exception-member-index: x exception-member-index
		catch_: catch_ else x catch_
		then_: then_ else x then_
	as var-get-concrete-expr _
		()
	as var-set-concrete-expr x
		guard value ?= ctx replace-constants-expr x.value
		x.var var-set-concrete-expr value

-replace-constants-in-match-union-cases concrete-local-and-expr[]?(ctx replace-constants-ctx, cases concrete-local-and-expr[])
	any mut bool = false
	res concrete-local-and-expr[] = for case_ in cases
		replaced = ctx replace-constants-in-local-and-expr case_
		any := any or _ ?= replaced
		replaced else case_
	if any then res
-replace-constants-in-opt-local-and-expr concrete-local-and-expr?(ctx replace-constants-ctx, case_ concrete-local-and-expr?)
	if x ?= case_
		ctx replace-constants-in-local-and-expr x
-replace-constants-in-local-and-expr concrete-local-and-expr?(ctx replace-constants-ctx, case_ concrete-local-and-expr)
	guard expr ?= ctx replace-constants-expr case_.expr
	case_.local, expr

-constants-or-exprs union(constants, exprs)
-constants record(constants constant[])
-exprs record(exprs concrete-expr[])

-replace-constants-in-args constants-or-exprs?(ctx replace-constants-ctx, a concrete-expr[])
	ctx replace-constants-in-args a, true
-replace-constants-in-args constants-or-exprs?(ctx replace-constants-ctx, a concrete-expr[], allow-constants bool)
	if x ?= ctx replace-constants-in-args-exprs a
		if allow-constants and cs ?= x as-constants
			cs constants
		else
			x exprs
	elif x ?= a as-constants and allow-constants
		x constants
-replace-constants-expr concrete-expr?(ctx replace-constants-ctx, a concrete-expr)
	guard res ?= ctx replace-constants a
	a.type, a.range, res
-replace-constants-in-args-exprs (concrete-expr, concrete-expr)?
	ctx replace-constants-ctx
	a concrete-expr
	b concrete-expr
do
	guard res ?= ctx replace-constants-in-args-exprs (a, b)
	res only2
-replace-constants-in-args (concrete-expr, concrete-expr, concrete-expr)?
	ctx replace-constants-ctx
	a concrete-expr
	b concrete-expr
	c concrete-expr
do
	guard res ?= ctx replace-constants-in-args-exprs (a, b, c)
	res only3
-replace-constants-in-args-exprs concrete-expr[]?(ctx replace-constants-ctx, a concrete-expr[])
	any mut bool = false
	res concrete-expr[] = for x in a
		if updated ?= ctx replace-constants-expr x
			any := true
			updated
		else
			x
	if any then res

-try-eval-constant constant?(ctx concretize-ctx, fn concrete-fun, args constant[])
	match fn body
	as concrete-fun-body-builtin builtin_
		match builtin_ kind
		as builtin-binary x
			fn.return-type try-eval-constant-binary x, args.only2
		as builtin-unary x
			x try-eval-constant-unary args.only
		as builtin-fun-is-empty-type
			throw unreachable # compiles to a constant
		as builtin-fun-constant _
			throw unreachable # compiles to a constant
		else
			()
	as concrete-expr x
		ctx eval-as-constant fn, x, args
	as fun-body-extern-java _
		()
	as concrete-fun-body-method _
		()
	as concrete-fun-body-deferred _
		()
-eval-as-constant constant?(ctx concretize-ctx, fn concrete-fun, a concrete-expr, fn-args constant[])
	match a kind
	as constant x
		x
	as create-record-concrete-expr x
		unless a.type.body.concrete-record! prevent-constant
			if args ?= (x.args map-every of arg then ctx eval-as-constant fn, arg, fn-args)::constant[]?
				ctx.all-constants get-constant-record a.type, args
	# TODO: unions -----------------------------------------------------------------------------------------------------------------------------
	as local-get-concrete-expr x
		assert index ?= fn.params index-of x.local
		fn-args[index]
	else
		()
-try-eval-constant-binary constant?(type concrete-type, fn builtin-binary, (arg0 constant, arg1 constant)) # TODO: probably no longer needed
	match fn
	as equal-exact
		if type is-nat64
			arg0.as-nat64 == arg1.as-nat64 to
	else
		()
-try-eval-constant-unary constant?(fn builtin-unary, arg constant)
	match fn
	as not
		!arg.as-bool to
	else
		()
