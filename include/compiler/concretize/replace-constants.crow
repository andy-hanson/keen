use-prefix
import
	../model/concrete-model
	../model/model
	../util/util
	./all-constants-builder
	./concretize-ctx
	./generate

replace-constants void(ctx concretize-ctx)
	constants-map constant mut[concrete-fun] = for* fun in ctx.all-concrete-funs
		guard e = fun.body.concrete-expr
		guard c = e.kind.constant
		- fun, c
	loop
		added-any-new-constants mut bool = false
		for fun in ctx.all-concrete-funs
			guard e = fun.body.concrete-expr
			if new-body = replace-constants-expr (ctx, constants-map, ()), e
				fun.body := new-body
				if c = new-body.kind.constant
					constants-map[fun] := c
					added-any-new-constants := true
		if added-any-new-constants
			continue
		else
			break

-replace-constants-ctx record mut
	ctx concretize-ctx
	constants-map constant mut[concrete-fun]
	constant-locals constant mut[concrete-local]
-replace-constants concrete-expr-kind?(ctx replace-constants-ctx, a concrete-expr)
	match x = a.kind
	as array-op-concrete-expr
		guard input, body = replace-constants-in-args-exprs ctx, x.input, x.body
		array-op-concrete-expr input, x.local, x.empty-out-array, body
	as builtin-concrete-expr
		guard args = replace-constants-in-args-exprs ctx, x.args
		builtin-concrete-expr x.fun, x.type-args, args
	as call-concrete-expr
		if res = ctx.constants-map[x.called]
			res
		elif args = replace-constants-in-args-exprs ctx, x.args
			if constants = as-constants args
				if constant = try-eval-constant ctx.ctx, x.called, constants
					constant
				else
					call-concrete-expr x.called, args
			else
				call-concrete-expr x.called, args
		else
			# TODO: if they are already constants, we should have already propagated them? ------------------------------------------
			if constants = as-constants x.args
				try-eval-constant ctx.ctx, x.called, constants
	as cast-concrete-expr
		()
	as constant
		()
	as create-array-concrete-expr
		guard args = replace-constants-in-args ctx, x.args
		match args
		as constants
			get-constant-array ctx.ctx.all-constants, a.type, args.constants
		as exprs
			create-array-concrete-expr args.exprs
	as create-record-concrete-expr
		guard args = replace-constants-in-args ctx, x.args, !a.type.body.concrete-record!.prevent-constant
		match args
		as constants
			get-constant-record ctx.ctx.all-constants, a.type, args.constants
		as exprs
			create-record-concrete-expr args.exprs
	as create-union-concrete-expr
		guard arg = replace-constants-expr ctx, x.arg
		if c = arg.kind.constant
			get-constant-union ctx.ctx.all-constants, a.type, x.member-index, c
		else
			create-union-concrete-expr x.member-index, arg
	as drop-concrete-expr
		guard arg = replace-constants-expr ctx, x.arg
		drop-concrete-expr arg
	as finally-concrete-expr
		guard right, below = replace-constants-in-args-exprs ctx, x.right, x.below
		finally-concrete-expr right, below
	as if-concrete-expr
		guard cond, then_, else_ = replace-constants-in-args ctx, x.cond, x.then_, x.else_
		if constant-cond = cond.kind.constant
			if as-bool constant-cond then then_.kind else else_.kind
		else
			if-concrete-expr cond, then_, else_
	as let-concrete-expr
		if value = replace-constants-expr ctx, x.value
			if !is-mutable x.local and v = value.kind.constant
				ctx.constant-locals[x.local] := v
				# TODO: should not need type annotation (but the compiler gets confused converting concrete-expr-kind? to concrete-expr-kind??
				::concrete-expr-kind
				replace-constants ctx, x.then_ else x.then_.kind
			else
				let-concrete-expr x.local, value, (replace-constants-expr ctx, x.then_ else x.then_)
		elif then_ = replace-constants-expr ctx, x.then_
			let-concrete-expr x.local, x.value, then_
	as lambda-concrete-expr
		guard body = replace-constants-expr ctx, x.body
		lambda-concrete-expr x.closure, x.param, body # TODO: remove things from closure that are constants ------------------------------
	as local-get-concrete-expr
		ctx.constant-locals[x.local]
	as local-set-concrete-expr
		guard value = replace-constants-expr ctx, x.value
		local-set-concrete-expr x.local, value
	as loop-concrete-expr
		guard body = replace-constants-expr ctx, x.body
		loop-concrete-expr body
	as loop-break-concrete-expr
		guard value = replace-constants-expr ctx, x.value
		loop-break-concrete-expr value
	as loop-continue-concrete-expr
		()
	as match-scalar-concrete-expr
		matched = replace-constants-expr ctx, x.matched
		cases = replace-constants-in-args-exprs ctx, x.case-exprs
		else_ = replace-constants-in-opt-expr ctx, x.else_
		guard matched or cases or else_
		# TODO: if 'matched' is a constant, use just that branch -------------------------------------------------------------------
		:: match-scalar-concrete-expr
		matched: matched else x.matched
		case-values: x.case-values
		case-exprs: cases else x.case-exprs
		else_: else_ or x.else_
	as match-string-like-concrete-expr
		matched = replace-constants-expr ctx, x.matched
		# TODO: if 'matched' is a constant, use just that branch -------------------------------------------------------------------
		updated-case mut bool = false
		cases concrete-match-string-like-case[] = for case_ in x.cases
			value = replace-constants-expr ctx, case_.value
			then_ = replace-constants-expr ctx, case_.then_
			updated-case := updated-case or value or then_
			value: value else case_.value
			then_: then_ else case_.then_
		else_ = replace-constants-in-opt-expr ctx, x.else_
		guard matched or updated-case or else_
		:: match-string-like-concrete-expr
		matched: matched else x.matched
		equals: x.equals
		cases: cases
		else_: else_ else x.else_
	as match-union-concrete-expr
		matched = replace-constants-expr ctx, x.matched
		# TODO: if 'matched' is a constant, use just that branch -------------------------------------------------------------------
		cases = replace-constants-in-match-union-cases ctx, x.cases
		else_ = replace-constants-in-opt-expr ctx, x.else_
		guard matched or cases or else_
		:: match-union-concrete-expr
		matched: matched else x.matched
		case-indices: x.member-indices
		cases: cases else x.cases
		else_: else_ or x.else_
	as record-field-get-concrete-expr
		guard record_ = replace-constants-expr ctx, x.record_
		# TODO: For a constant record, get the constant field value! ---------------------------------------------------------
		record-field-get-concrete-expr record_, x.field-index
	as record-field-set-concrete-expr
		guard record_, value = replace-constants-in-args-exprs ctx, x.record_, x.value
		record-field-set-concrete-expr record_, x.field-index, value
	as seq-concrete-expr
		guard new-parts = replace-constants-in-args-exprs ctx, x.parts
		without-constants concrete-expr[] = for* index, part in with-index new-parts
			if index != new-parts.size - 1 and part.kind.constant
				assert constant-gc-safe-value part.kind.constant! # Always void
				()
			else
				- part
		# TODO: should not need type annotation
		::concrete-expr-kind
		without-constants.opt-only.?kind else seq-concrete-expr without-constants
	as throw-concrete-expr
		guard thrown = replace-constants-expr ctx, x.thrown
		throw-concrete-expr thrown
	as try-concrete-expr
		tried = replace-constants-expr ctx, x.tried
		cases = replace-constants-in-catches ctx, x.catch-cases
		catch-else = replace-constants-in-opt-local-and-expr ctx, x.catch-else
		guard tried or cases or catch-else
		:: try-concrete-expr
		tried: tried else x.tried
		exception-member-indices: x.exception-member-indices
		catch-cases: cases else x.catch-cases
		catch-else: catch-else or x.catch-else
	as try-let-concrete-expr
		# TODO: if value is constant, the local is constant too -------------------------------------------------------------------
		value = replace-constants-expr ctx, x.value
		catch_ = replace-constants-in-local-and-expr ctx, x.catch_
		then_ = replace-constants-expr ctx, x.then_
		guard value or catch_ or then_
		:: try-let-concrete-expr
		local: x.local
		value: value else x.value
		exception-member-index: x.exception-member-index
		catch_: catch_ else x.catch_
		then_: then_ else x.then_
	as union-assume-case-concrete-expr
		# TODO: if we get a constant of the union type, check it at compile time here and output a constant of the case type
		guard arg = replace-constants-expr ctx, x.arg
		union-assume-case-concrete-expr arg
	as union-is-case-concrete-expr
		# TODO: if we get a constant of the union type, check it at compile time here and output a constant boolean
		guard arg = replace-constants-expr ctx, x.arg
		union-is-case-concrete-expr arg, x.case-index
	as var-get-concrete-expr
		()
	as var-set-concrete-expr
		guard value = replace-constants-expr ctx, x.value
		var-set-concrete-expr x.var, value

-replace-constants-in-match-union-cases concrete-expr[]?(ctx replace-constants-ctx, cases concrete-expr[])
	any mut bool = false
	res concrete-expr[] = for case_ in cases
		replaced = replace-constants-expr ctx, case_
		any := any or replaced
		replaced else case_
	if any then res
-replace-constants-in-catches concrete-local-and-expr[]?(ctx replace-constants-ctx, cases concrete-local-and-expr[])
	any mut bool = false
	res concrete-local-and-expr[] = for case_ in cases
		replaced = replace-constants-in-local-and-expr ctx, case_
		any := any or replaced
		replaced else case_
	if any then res
-replace-constants-in-opt-expr concrete-expr?(ctx replace-constants-ctx, expr concrete-expr?)
	if expr then replace-constants-expr ctx, expr
-replace-constants-in-opt-local-and-expr concrete-local-and-expr?(ctx replace-constants-ctx, case_ concrete-local-and-expr?)
	if case_ then replace-constants-in-local-and-expr ctx, case_
-replace-constants-in-local-and-expr concrete-local-and-expr?(ctx replace-constants-ctx, case_ concrete-local-and-expr)
	guard expr = replace-constants-expr ctx, case_.expr
	case_.local, expr

-constants-or-exprs union(constants, exprs)
-constants record(constants constant[])
-exprs record(exprs concrete-expr[])

-replace-constants-in-args constants-or-exprs?(ctx replace-constants-ctx, a concrete-expr[])
	replace-constants-in-args ctx, a, true
-replace-constants-in-args constants-or-exprs?(ctx replace-constants-ctx, a concrete-expr[], allow-constants bool)
	if x = replace-constants-in-args-exprs ctx, a
		if allow-constants and cs = as-constants x
			cs.constants
		else
			x.exprs
	elif allow-constants and x = as-constants a
		x.constants
-replace-constants-expr concrete-expr?(ctx replace-constants-ctx, a concrete-expr)
	guard res = replace-constants ctx, a
	a.type, a.range, res
-replace-constants-in-args-exprs (concrete-expr, concrete-expr)?
	ctx replace-constants-ctx
	a concrete-expr
	b concrete-expr
do
	?only2 replace-constants-in-args-exprs ctx, (a, b)
-replace-constants-in-args (concrete-expr, concrete-expr, concrete-expr)?
	ctx replace-constants-ctx
	a concrete-expr
	b concrete-expr
	c concrete-expr
do
	?only3 replace-constants-in-args-exprs ctx, (a, b, c)
-replace-constants-in-args-exprs concrete-expr[]?(ctx replace-constants-ctx, a concrete-expr[])
	any mut bool = false
	res concrete-expr[] = for x in a
		if updated = replace-constants-expr ctx, x
			any := true
			updated
		else
			x
	if any then res

-try-eval-constant constant?(ctx concretize-ctx, fn concrete-fun, args constant[])
	match body = fn.body
	as concrete-fun-body-builtin
		match x = body.kind
		as builtin-binary
			try-eval-constant-binary fn.return-type, x, args.only2
		as builtin-unary
			try-eval-constant-unary x, args.only
		as builtin-fun-constant
			throw unreachable # compiles to a constant
		as builtin-fun-is-empty-type
			throw unreachable # compiles to a constant
		as builtin-fun-is-target
			throw unreachable # compiles to a constant
		as builtin-fun-call-lambda
			()
		as builtin-ternary
			()
		as js-fun
			()
	as concrete-expr
		eval-as-constant ctx, fn, body, args
	as fun-body-extern-java
		()
	as concrete-fun-body-method
		()
	as concrete-fun-body-deferred
		()
-eval-as-constant constant?(ctx concretize-ctx, fn concrete-fun, a concrete-expr, fn-args constant[])
	match x = a.kind
	as constant
		x
	as create-record-concrete-expr
		unless prevent-constant a.type.body.concrete-record!
			if args constant[] = map-every x.args, of arg then eval-as-constant ctx, fn, arg, fn-args
				get-constant-record ctx.all-constants, a.type, args
	# TODO: unions -----------------------------------------------------------------------------------------------------------------------------
	as local-get-concrete-expr
		assert index = index-of fn.params, x.local
		fn-args[index]
	else
		()
-try-eval-constant-binary constant?(type concrete-type, fn builtin-binary, (arg0 constant, arg1 constant)) # TODO: probably no longer needed
	match fn
	as equal-exact
		if is-nat64 type
			arg0.as-nat64 == arg1.as-nat64 'to
	else
		()
-try-eval-constant-unary constant?(fn builtin-unary, arg constant)
	match fn
	as not
		!arg.as-bool 'to
	else
		()
