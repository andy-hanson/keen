import
	crow/crypto/pseudo-random
	../frontend/show-model
	../model/ast
	../model/concrete-model
	../model/model
	../model/show-concrete-model
	../model/source-range
	../util/enum-map
	../util/util
	./all-constants-builder	

type-args-scope alias
	concrete-type[]

type-args-scope-for-fun type-args-scope(a concrete-fun)
	match a source
	as concrete-fun-source-regular x
		x type-args
	as concrete-fun-source-test _
		()
	as concrete-fun-source-wrap-main _
		()
	
specs-scope record(specs specs, spec-impls concrete-fun[]) # TODO: could this just be the spec-impls???????????????????????????
new specs-scope()
	(), ()
specs-scope-for-fun specs-scope(a concrete-fun)
	match a source
	as concrete-fun-source-regular x
		x.decl.specs, x.spec-impls
	as concrete-fun-source-test _
		()
	as concrete-fun-source-wrap-main _
		()

concretize-ctx record mut
	show-ctx show-ctx
	-prng prng
	# TODO: more of these should probably be private -----------------------------------------------------------------------------
	target build-target
	program-with-main program-with-main
	file-content-getters file-content-getters
	all-externs symbol-set
	quick-fill-in-concrete-fun-body void mut(ctx concretize-ctx, fun concrete-fun) # TODO: I could use a spec instead? -----------------------------
	late-equal-symbol-function mut concrete-fun?
	late-new-json-from-pairs-function mut concrete-fun?
	late-to-json-from-json-array-function mut concrete-fun?
	all-constants all-constants-builder
	non-lambda-concrete-types concrete-type mut[(struct-decl, concrete-type[])] # TODO: Rename, since I removed the lambda concrete-types ----------------------
	all-concrete-types concrete-type mut[] # TODO: Now 'non-lambda-concrete-types' should contain them all ..........................
	concrete-var-lookup concrete-var mut[var-decl]
	non-lambda-concrete-funs concrete-fun mut[concrete-fun-key] # TODO: lambdas are always preserved now, so rename ---------------------------------
	sum-type-to-methods concrete-fun mut[] mut[concrete-type]
	deferred-methods concrete-fun mut[]
	deferred-java-interfaces struct-decl mut[]
	all-concrete-funs concrete-fun mut[]
	| Maps a sum type to its cases
	sum-types concrete-sum-type-case mut[] mut[concrete-type]
	-late-bogus-type mut concrete-type?
	-late-bool-type mut concrete-type?
	-late-char8-array-type mut concrete-type?
	-late-char32-array-type mut concrete-type?
	-late-error-type mut concrete-type?
	-late-exception-type mut concrete-type?
	-late-none-type mut concrete-type?
	-late-void-type mut concrete-type?
	-late-integral-types mut (integral-type, concrete-type) enum-map?
	-late-string-type mut concrete-type?
	-late-symbol-type mut concrete-type?
new concretize-ctx
	show-ctx show-ctx
	program program-with-main
	target build-target
	file-content-getters file-content-getters
	quick-fill-in-concrete-fun-body void mut(ctx concretize-ctx, fun concrete-fun)
do
	show-ctx: show-ctx
	prng: ()
	target: target
	program-with-main: program
	file-content-getters: file-content-getters
	all-externs: program all-externs target
	quick-fill-in-concrete-fun-body: quick-fill-in-concrete-fun-body
	late-equal-symbol-function: ()
	late-new-json-from-pairs-function: ()
	late-to-json-from-json-array-function: ()
	all-constants: ()
	non-lambda-concrete-types: ()
	all-concrete-types: ()
	concrete-var-lookup: ()
	non-lambda-concrete-funs: ()
	sum-type-to-methods: ()
	deferred-methods: ()
	deferred-java-interfaces: ()
	all-concrete-funs: ()
	sum-types: ()
	late-bogus-type: ()
	late-bool-type: ()
	late-char8-array-type: ()
	late-char32-array-type: ()
	late-error-type: ()
	late-exception-type: ()
	late-none-type: ()
	late-void-type: ()
	late-integral-types: ()
	late-string-type: ()
	late-symbol-type: ()

is-java bool(a concretize-ctx)
	a.target == java
is-js bool(a concretize-ctx)
	a.target == js
preserve-methods bool(a concretize-ctx)
	a is-java # TODO: also JS -----------------------------------------------------------------------------------------------------------------
equal-symbol-function concrete-fun(a concretize-ctx)
	a late-equal-symbol-function!
new-json-from-pairs-function concrete-fun(a concretize-ctx)
	a late-new-json-from-pairs-function!
to-json-from-json-array-function concrete-fun(a concretize-ctx)
	a late-to-json-from-json-array-function!
program program(a concretize-ctx)
	a.program-with-main program
common-funs common-funs(a concretize-ctx)
	a.program common-funs
common-types common-types(a concretize-ctx)
	a.program common-types

take-next-id nat(a concretize-ctx)
	a.prng next

concrete-sum-type-case record(member-type concrete-type, method-impls mut concrete-fun?[]?) mut # TODO: rename 'member-type' to 'case-type'

finish-concrete-vars concrete-var[](ctx concretize-ctx)
	res concrete-var[] = for _, v : ctx.concrete-var-lookup; v
	# TODO: this also needs to take into account order of dependencies. If A imports B, B needs to initialize first.
	res sort var => var.range.range start

-bogus-type concrete-type(a concretize-ctx)
	a late-bogus-type ??
		res concrete-type =
			id: a take-next-id
			purity: data_
			source: concrete-type-source-bogus
			body:
				:: concrete-record
				prevent-constant: false
				fields: ()
		a.all-concrete-types ~= res
		a.late-bogus-type := res
		res

bool-type concrete-type(a concretize-ctx)
	a late-bool-type ??
		res = a get-concrete-type-for-struct-inst a.common-types.bool, ()
		a.late-bool-type := res
		res

json-type concrete-type(a concretize-ctx)
	a.new-json-from-pairs-function return-type

none-type concrete-type(a concretize-ctx)
	a late-none-type ??
		res = a get-concrete-type-for-struct-inst a.common-types.none, ()
		a.late-none-type := res
		res

void-type concrete-type(a concretize-ctx)
	a late-void-type ??
		res = a get-concrete-type-for-struct-inst a.common-types.void, ()
		a.late-void-type := res
		res

char8-array-type concrete-type(a concretize-ctx)
	a late-char8-array-type ??
		res = a get-concrete-type-for-struct-inst a.common-types.char8-array, ()
		a.late-char8-array-type := res
		res

char32-array-type concrete-type(a concretize-ctx)
	a late-char32-array-type ??
		res = a get-concrete-type-for-struct-inst a.common-types.char32-array, ()
		a.late-char32-array-type := res
		res

char-types (char-type, concrete-type) enum-map(a concretize-ctx)
	for key : make-enum-map
		match key
		as char8
			a.char8-array-type array-element-type
		as char32
			a.char32-array-type array-element-type
integral-types (integral-type, concrete-type) enum-map(a concretize-ctx)
	a late-integral-types ??
		res (integral-type, concrete-type) enum-map = for x : make-enum-map
			a get-concrete-type-for-struct-inst a.common-types[x], ()
		a.late-integral-types := res
		res
integral-type concrete-type(a concretize-ctx, type integral-type)
	a.integral-types[type]
nat64-type concrete-type(a concretize-ctx)
	a integral-type nat64
float-types (float-type, concrete-type) enum-map(a concretize-ctx)
	for key : make-enum-map
		match key
		as float32
			a get-concrete-type-for-struct-inst a.common-types.float32, ()
		as float64
			a get-concrete-type-for-struct-inst a.common-types.float64, ()

error-type concrete-type(a concretize-ctx)
	# TODO: is caching this this really an optimization / necessary? ---------------------------------------------------------------------------
	a late-error-type ??
		res = a get-concrete-type-for-struct-inst a.common-funs.error, ()
		a.late-error-type := res
		res

exception-type concrete-type(a concretize-ctx)
	a late-exception-type ??
		res = a get-concrete-type-for-struct-inst a.common-types.exception, ()
		a.late-exception-type := res
		res

string-type concrete-type(a concretize-ctx)
	# TODO: I should measure if using 'late-string-type' is actually aany better than just getting it every time ..................
	a late-string-type ??
		res = a get-concrete-type-for-struct-inst a.common-types.string, ()
		a.late-string-type := res
		res

symbol-type concrete-type(a concretize-ctx)
	a late-symbol-type ??
		res = a get-concrete-type-for-struct-inst a.common-types.symbol, ()
		a.late-symbol-type := res
		res

get-referenced-type concrete-type(ctx concretize-ctx, type concrete-type)
	inst = type.source concrete-type-source-inst!
	assert inst.decl == ctx.common-types.reference
	inst.type-args only

constant-symbol constant(a concretize-ctx, value symbol)
	a.all-constants get-constant-symbol value

get-concrete-fun concrete-fun(ctx concretize-ctx, decl fun-decl, type-args concrete-type[], spec-impls concrete-fun[])
	key concrete-fun-key = decl, type-args, spec-impls
	res = ctx.non-lambda-concrete-funs get-or-add-and-did-add key, () =>
		ctx get-concrete-fun-from-key decl, type-args, spec-impls
	if res did-add
		ctx add-concrete-fun res.value
		ctx.quick-fill-in-concrete-fun-body[ctx, res.value]
	res value

get-non-template-concrete-fun concrete-fun(ctx concretize-ctx, inst fun-inst)
	assert inst.decl !is-template
	ctx get-concrete-fun inst.decl, (), ()

get-concrete-type-for-struct-inst concrete-type(ctx concretize-ctx, inst struct-inst, type-args-scope type-args-scope)
	type-args = ctx get-concrete-types inst.type-args, type-args-scope
	decl = inst decl
	res = ctx.non-lambda-concrete-types get-or-add-and-did-add (decl, type-args), () =>
		purity mut = decl purity
		for x : type-args
			purity worse-purity:= x purity
		res concrete-type =
			id: ctx take-next-id
			purity: purity
			source: decl concrete-type-source-inst type-args
			body: concrete-type-body-deferred
		ctx.all-concrete-types ~= res
		res
	if res did-add
		ctx initialize-concrete-type inst, res.value, type-args
	res value

get-concrete-type concrete-type(ctx concretize-ctx, type type, type-args-scope type-args-scope)
	match type
	as bogus-type
		ctx bogus-type
	as type-param-index x
		type-args-scope[x index]
	as struct-inst x
		ctx get-concrete-type-for-struct-inst x, type-args-scope

-get-concrete-types concrete-type[](ctx concretize-ctx, types type-args, type-args-scope type-args-scope)
	for t : types inner
		ctx get-concrete-type t, type-args-scope

get-concrete-fun-from-called concrete-fun?
	ctx concretize-ctx
	type-scope type-args-scope
	specs-scope specs-scope
	called called
do
	match called
	as called-bogus _
		()
	as fun-inst x
		ctx get-concrete-fun-from-fun-inst type-scope, specs-scope, x
	as called-spec-sig x
		specs-scope.spec-impls[x index-in-specs]

get-concrete-fun-from-fun-inst concrete-fun?
	ctx concretize-ctx
	type-scope type-args-scope
	specs-scope specs-scope
	fun-inst fun-inst
do
	spec-impls concrete-fun[]? = fun-inst.spec-impls map-or-none x =>
		ctx get-concrete-fun-from-called type-scope, specs-scope, x
	if impls ?= spec-impls
		type-args = ctx get-concrete-types fun-inst.type-args, type-scope
		ctx get-concrete-fun fun-inst.decl, type-args, impls

# TODO: RENAME (the D version took ConcreteFunKey) -------------------------------------------------------------------------
-get-concrete-fun-from-key concrete-fun
	ctx concretize-ctx
	decl fun-decl
	type-args concrete-type[]
	spec-impls concrete-fun[]
do
	return-type = ctx get-concrete-type decl.return-type, type-args
	params concrete-local[] = for x : decl.params.params-array
		ctx concretize-param-destructure  x, type-args
	hash: ctx take-next-id
	source: decl concrete-fun-source-regular type-args, spec-impls
	return-type: return-type
	params: params
	body: concrete-fun-body-deferred

-concretize-param-destructure concrete-local(ctx concretize-ctx, a destructure, type-args-scope type-args-scope)
	source concrete-local-source = match a
	as destructure-ignore _
		ignore::concrete-generated-local-kind
	as local x
		x
	as destructure-split _
		destruct::concrete-generated-local-kind
	source, do ctx get-concrete-type a.type, type-args-scope

add-concrete-fun void(ctx concretize-ctx, fun concrete-fun)
	ctx.all-concrete-funs ~= fun

-initialize-concrete-type void
	ctx concretize-ctx
	inst struct-inst
	res concrete-type
	type-args concrete-type[]
do
	match inst.decl body
	as struct-body-bogus
		throw unreachable
	as struct-body-extern-java x
		res.body := x
	as builtin-type x
		ctx initialize-concrete-type-for-builtin res, type-args, x
	as enum_ x
		res.body := x.storage_ concrete-enum
	as flags_ x
		res.body := x.storage_ concrete-flags
	as record_ r
		fields concrete-field[] = for f : r fields
			debug-name: f name
			is-mutable: f.mutability !is-empty
			type: ctx get-concrete-type f.type, type-args
		res.body :=
			:: concrete-record
			is-exception-case = inst.decl.sum-type-memberships exists x =>
				x.sum-type == ctx.common-types.exception
			prevent-constant: is-exception-case || fields exists x => x is-mutable
			fields: fields
	as sum-type x
		res.body :=
			:: concrete-union
			java-interface: x.kind == java-interface ? inst.decl.source.struct-decl-source-java!.path
			late-members: ()
		cases concrete-sum-type-case mut[] = for member : x listed-members
			member-type = ctx get-concrete-type-for-struct-inst member.member, type-args
			method-impls = ctx sum-type-method-impls-common member.method-impls, type-args
			method-impls.size is x.methods.size
			member-type, method-impls
		ctx.sum-types[res] := cases
		match x kind
		as interface_
			()
		as java-interface
			ctx.deferred-java-interfaces ~= inst decl
		as union_
			res finish-sum-type-cases cases
		as variant_
			()

	for x : inst.decl sum-type-memberships
		sum-type = ctx get-concrete-type x.sum-type, type-args
		cases = ctx.sum-types[sum-type]! # TODO: can't I inline this to where it is used?????????????????????????????????????????????
		case_ concrete-sum-type-case = res, ()
		cases ~= case_
		case_.method-impls := ctx sum-type-membership-method-impls sum-type, res
		case_.method-impls!.size is sum-type.sum-type-body-from-type.methods.size

sum-type-case-index nat(ctx concretize-ctx, sum-type concrete-type, case-type concrete-type)
	body = sum-type.body concrete-union!
	if body has-members
		body.members index-of! case-type
	else
		assert st ?= ctx.sum-types[sum-type] : "Could not find members for sum type {ctx.show-ctx show-concrete-type sum-type}" error
		res = st find-index member => member.member-type == case-type
		res ??
			error log "Could not find sum type member {ctx.show-ctx show-concrete-type case-type} for {ctx.show-ctx show-concrete-type sum-type}"
			throw todo

-sum-type-body-from-type sum-type(a concrete-type)
	a.source.concrete-type-source-inst!.decl.body sum-type!

finish-sum-type-cases void(sum-type concrete-type, cases concrete-sum-type-case mut[])
	sum-type.body.concrete-union!.members := for x : cases
		x member-type

-sum-type-membership-method-impls concrete-fun?[]
	ctx concretize-ctx
	sum-type concrete-type
	member-type concrete-type
do
	sum-type-decl struct-decl = sum-type.source.concrete-type-source-inst! decl
	member-source = member-type.source concrete-type-source-inst!
	membership = member-source.decl.sum-type-memberships must-find-only x => x.sum-type.decl == sum-type-decl
	ctx sum-type-method-impls-common membership.method-impls, member-source.type-args

-sum-type-method-impls-common concrete-fun?[]
	ctx concretize-ctx
	method-impls called?[]
	type-args type-args-scope
do
	for x : method-impls
		if c ?= x
			ctx get-concrete-fun-from-called type-args, (), c

-initialize-concrete-type-for-builtin void
	ctx concretize-ctx
	type concrete-type
	type-args concrete-type[]
	builtin_ builtin-type
do
	match builtin_
	# TODO: why do we handle 'option' specially here but 'array' specially elsewhere? -----------------------------------------------
	as option
		# TODO: this potentially creates a '(void, void)' union, which is the only place it would have the same type multiple times ........
		# Maybe we could use an impossible type instead. I could declare `-none record` in bootstrap.crow, which would be guaranteed to not be used anywhere.
		type.body :=
			:: concrete-union
			java-interface: ()
			late-members: ctx.none-type, type-args.only
		assert type.body.concrete-union! has-members # TODO: RM (sanity check) ----------------------------------------------
	else
		# TODO: isn't that big expression the same as the local 'type-args'? ----------------------------------------------------
		type.body := builtin_ concrete-builtin-type type.source.concrete-type-source-inst!.type-args
