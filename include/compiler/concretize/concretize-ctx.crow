import
	crow/crypto/pseudo-random
	../frontend/show-model
	../model/ast
	../model/concrete-model
	../model/model
	../model/show-concrete-model
	../model/source-range
	../util/enum-map
	../util/util
	./all-constants-builder

type-args-scope alias
	concrete-type[]

type-args-scope-for-fun type-args-scope(a concrete-fun)
	match x = a.source
	as concrete-fun-source-regular then x.type-args
	as concrete-fun-source-test then ()
	as concrete-fun-source-wrap-main then ()

specs-scope record(specs specs, spec-impls concrete-fun[]) # TODO: could this just be the spec-impls???????????????????????????
new specs-scope()
	(), ()
specs-scope-for-fun specs-scope(a concrete-fun)
	match x = a.source
	as concrete-fun-source-regular then x.decl.specs, x.spec-impls
	as concrete-fun-source-test then ()
	as concrete-fun-source-wrap-main then ()

concretize-ctx record mut
	show-ctx show-ctx
	-prng prng
	# TODO: more of these should probably be private -----------------------------------------------------------------------------
	target build-target
	program-with-main program-with-main
	file-content-getters file-content-getters
	late-equal-symbol-function mut concrete-fun?
	late-json-named-new-function mut concrete-fun?
	all-constants all-constants-builder
	concrete-types concrete-type mut[(struct-decl, concrete-type[])]
	all-concrete-types concrete-type mut[] # TODO:PERF 'concrete-types' contains them all, except the bogus type
	concrete-var-lookup concrete-var mut[var-decl]
	concrete-funs concrete-fun mut[concrete-fun-key]
	sum-type-to-methods concrete-fun mut[] mut[concrete-type]
	deferred-methods concrete-fun mut[]
	deferred-java-interfaces struct-decl mut[]
	all-processed-concrete-funs concrete-fun mut[]
	all-unprocessed-concrete-funs concrete-fun mut[]
	| Maps a sum type to its cases
	sum-types concrete-sum-type-case mut[] mut[concrete-type]
	| The nth case type needs its method impls filled in
	deferred-sum-type-method-impls (concrete-type, nat, sum-type-member-kind) mut[]
	-late-bogus-type mut concrete-type?
	-late-bool-type mut concrete-type?
	-late-char8-array-type mut concrete-type?
	-late-char32-array-type mut concrete-type?
	-late-error-type mut concrete-type?
	-late-exception-type mut concrete-type?
	-late-none-type mut concrete-type?
	-late-void-type mut concrete-type?
	-late-integral-types mut (integral-type, concrete-type) enum-map?
	-late-string-type mut concrete-type?
new concretize-ctx
	show-ctx show-ctx
	program program-with-main
	target build-target
	file-content-getters file-content-getters
do
	show-ctx: show-ctx
	prng: ()
	target: target
	program-with-main: program
	file-content-getters: file-content-getters
	late-equal-symbol-function: ()
	late-json-named-new-function: ()
	all-constants: ()
	concrete-types: ()
	all-concrete-types: ()
	concrete-var-lookup: ()
	concrete-funs: ()
	sum-type-to-methods: ()
	deferred-methods: ()
	deferred-java-interfaces: ()
	all-processed-concrete-funs: ()
	all-unprocessed-concrete-funs: ()
	sum-types: ()
	deferred-sum-type-method-impls: ()
	late-bogus-type: ()
	late-bool-type: ()
	late-char8-array-type: ()
	late-char32-array-type: ()
	late-error-type: ()
	late-exception-type: ()
	late-none-type: ()
	late-void-type: ()
	late-integral-types: ()
	late-string-type: ()
-sum-type-member-kind enum(declared-on-sum-type, declared-on-case-type)

is-java bool(a concretize-ctx)
	a.target == java
is-js bool(a concretize-ctx)
	a.target == js
preserve-methods bool(a concretize-ctx)
	a.is-java # TODO: also JS -----------------------------------------------------------------------------------------------------------------
equal-symbol-function concrete-fun(a concretize-ctx)
	a.late-equal-symbol-function!
json-named-new-function concrete-fun(a concretize-ctx)
	a.late-json-named-new-function!
program program(a concretize-ctx)
	a.program-with-main.program
common-funs common-funs(a concretize-ctx)
	a.program.common-funs
common-types common-types(a concretize-ctx)
	a.program.common-types
available-types available-types(a concretize-ctx)
	a.program.available-types

take-next-id nat(a concretize-ctx)
	a.prng.next

concrete-sum-type-case record(member-type concrete-type, method-impls mut concrete-fun?[]?) mut # TODO: rename 'member-type' to 'case-type'

finish-concrete-vars concrete-var[](ctx concretize-ctx)
	res concrete-var[] = for _, v in ctx.concrete-var-lookup then v
	# TODO: this also needs to take into account order of dependencies. If A imports B, B needs to initialize first.
	sort res, it.range.range.start

-bogus-type concrete-type(a concretize-ctx)
	a.late-bogus-type else
		res concrete-type =
			id: take-next-id a
			purity: data_
			source: concrete-type-source-bogus
			body: (prevent-constant: false, fields: ())::concrete-record
		a.all-concrete-types ~= res
		a.late-bogus-type := res
		res

bool-type concrete-type(a concretize-ctx)
	a.late-bool-type else
		res = get-concrete-type-for-struct-inst a, a.common-types.bool, ()
		a.late-bool-type := res
		res

json-type concrete-type(a concretize-ctx)
	a.json-named-new-function.return-type
json-array-type concrete-type(a concretize-ctx)
	get-concrete-type a, a.common-funs.json-array, ()

none-type concrete-type(a concretize-ctx)
	a.late-none-type else
		res = get-concrete-type-for-struct-inst a, a.common-types.none, ()
		a.late-none-type := res
		res

void-type concrete-type(a concretize-ctx)
	a.late-void-type else
		res = get-concrete-type-for-struct-inst a, a.common-types.void, ()
		a.late-void-type := res
		res

char8-array-type concrete-type(a concretize-ctx)
	a.late-char8-array-type else
		res = get-concrete-type-for-struct-inst a, a.common-types.char8-array, ()
		a.late-char8-array-type := res
		res

char32-array-type concrete-type(a concretize-ctx)
	a.late-char32-array-type else
		res = get-concrete-type-for-struct-inst a, a.common-types.char32-array, ()
		a.late-char32-array-type := res
		res

char-types (char-type, concrete-type) enum-map(a concretize-ctx)
	for key in make-enum-map
		match key
		as char8
			a.char8-array-type.array-element-type
		as char32
			a.char32-array-type.array-element-type
integral-types (integral-type, concrete-type) enum-map(a concretize-ctx)
	a.late-integral-types else
		res (integral-type, concrete-type) enum-map = for x in make-enum-map
			get-concrete-type-for-struct-inst a, a.common-types[x], ()
		a.late-integral-types := res
		res
integral-type concrete-type(a concretize-ctx, type integral-type)
	a.integral-types[type]
nat-type concrete-type(a concretize-ctx, type nat-type)
	integral-type a, type.to
nat64-type concrete-type(a concretize-ctx)
	nat-type a, nat64
float-types (float-type, concrete-type) enum-map(a concretize-ctx)
	for key in make-enum-map
		match key
		as float32
			get-concrete-type-for-struct-inst a, a.common-types.float32, ()
		as float64
			get-concrete-type-for-struct-inst a, a.common-types.float64, ()

error-type concrete-type(a concretize-ctx)
	# TODO: is caching this this really an optimization / necessary? ---------------------------------------------------------------------------
	a.late-error-type else
		res = get-concrete-type-for-struct-inst a, a.common-funs.error, ()
		a.late-error-type := res
		res

exception-type concrete-type(a concretize-ctx)
	a.late-exception-type else
		res = get-concrete-type-for-struct-inst a, a.common-types.exception, ()
		a.late-exception-type := res
		res

float64-type concrete-type(a concretize-ctx)
	get-concrete-type-for-struct-inst a, a.common-types.float64, ()

string-type concrete-type(a concretize-ctx)
	# TODO: I should measure if using 'late-string-type' is actually aany better than just getting it every time ..................
	a.late-string-type else
		res = get-concrete-type-for-struct-inst a, a.common-types.string, ()
		a.late-string-type := res
		res

get-referenced-type concrete-type(ctx concretize-ctx, type concrete-type)
	inst = type.source.concrete-type-source-inst!
	assert inst.decl == ctx.common-types.reference
	only! inst.type-args

constant-symbol constant(a concretize-ctx, value symbol)
	get-constant-symbol a.all-constants, value

quick-fill-in-concrete-fun-body spec
	quick-fill-in-concrete-fun-body void(ctx concretize-ctx, cf concrete-fun)

get-concrete-fun concrete-fun
	ctx concretize-ctx
	decl fun-decl
	type-args concrete-type[]
	spec-impls concrete-fun[]
do quick-fill-in-concrete-fun-body
	key concrete-fun-key = decl, type-args, spec-impls
	res = get-or-add-and-did-add ctx.concrete-funs, key, of
		get-concrete-fun-from-key ctx, decl, type-args, spec-impls
	if res.did-add
		add-concrete-fun ctx, res.value
		quick-fill-in-concrete-fun-body ctx, res.value
	res.value

get-non-template-concrete-fun concrete-fun(ctx concretize-ctx, inst fun-inst) quick-fill-in-concrete-fun-body
	assert !is-template inst.decl
	get-concrete-fun ctx, inst.decl, (), ()

get-concrete-type-for-struct-inst concrete-type(ctx concretize-ctx, inst struct-inst, type-args-scope type-args-scope)
	type-args = get-concrete-types ctx, inst.type-args, type-args-scope
	decl = inst.decl
	res = get-or-add-and-did-add ctx.concrete-types, (decl, type-args), of
		purity mut = decl.purity
		for x in type-args
			purity worse-purity:= x.purity
		res concrete-type =
			id: take-next-id ctx
			purity: purity
			source: concrete-type-source-inst decl, type-args
			body: concrete-type-body-deferred
		ctx.all-concrete-types ~= res
		res
	if res.did-add
		initialize-concrete-type ctx, inst, res.value, type-args
	res.value

get-concrete-type concrete-type(ctx concretize-ctx, type type, type-args-scope type-args-scope)
	match type
	as bogus-type
		ctx.bogus-type
	as type-param-index
		type-args-scope[type.index]
	as struct-inst
		get-concrete-type-for-struct-inst ctx, type, type-args-scope

-get-concrete-types concrete-type[](ctx concretize-ctx, types type-args, type-args-scope type-args-scope)
	for t in types
		get-concrete-type ctx, t, type-args-scope

get-concrete-fun-from-called concrete-fun?
	ctx concretize-ctx
	type-scope type-args-scope
	specs-scope specs-scope
	called called
do quick-fill-in-concrete-fun-body
	match called
	as called-bogus
		()
	as fun-inst
		get-concrete-fun-from-fun-inst ctx, type-scope, specs-scope, called
	as called-spec-sig
		specs-scope.spec-impls[called.index-in-specs]

get-concrete-fun-from-fun-inst concrete-fun?
	ctx concretize-ctx
	type-scope type-args-scope
	specs-scope specs-scope
	fun-inst fun-inst
do quick-fill-in-concrete-fun-body
	spec-impls concrete-fun[]? = map-every fun-inst.spec-impls, of x
		get-concrete-fun-from-called ctx, type-scope, specs-scope, x
	if spec-impls
		type-args = get-concrete-types ctx, fun-inst.type-args, type-scope
		get-concrete-fun ctx, fun-inst.decl, type-args, spec-impls

# TODO: RENAME (the D version took ConcreteFunKey) -------------------------------------------------------------------------
-get-concrete-fun-from-key concrete-fun
	ctx concretize-ctx
	decl fun-decl
	type-args concrete-type[]
	spec-impls concrete-fun[]
do
	return-type = get-concrete-type ctx, decl.return-type, type-args
	params concrete-local[] =
		-- for x in decl.params
			concretize-param-destructure ctx, x, type-args
		-- for x in decl.contexts
			the_::concrete-generated-local-kind, get-concrete-type ctx, x, type-args
	hash: take-next-id ctx
	source: concrete-fun-source-regular decl, type-args, spec-impls
	return-type: return-type
	params: params
	body: concrete-fun-body-deferred

-concretize-param-destructure concrete-local(ctx concretize-ctx, a destructure, type-args-scope type-args-scope)
	source: match a
	as destructure-ignore
		ignore::concrete-generated-local-kind
	as local
		a
	as destructure-split
		destruct::concrete-generated-local-kind
	type: get-concrete-type ctx, a.type, type-args-scope

add-concrete-fun void(ctx concretize-ctx, fun concrete-fun)
	ctx.all-unprocessed-concrete-funs ~= fun

-initialize-concrete-type void
	ctx concretize-ctx
	inst struct-inst
	res concrete-type
	type-args concrete-type[]
do
	match body = inst.decl.body
	as struct-body-bogus
		throw unreachable
	as struct-body-extern-java
		res.body := body
	as builtin-type
		initialize-concrete-type-for-builtin ctx, res, type-args, body
	as enum_
		res.body := body.storage.concrete-enum
	as flags_
		res.body := body.storage.concrete-flags
	as record_
		fields concrete-field[] = for field in body.fields
			debug-name: field.name
			is-mutable: !!field.mutability
			type: get-concrete-type ctx, field.type, type-args
		res.body :=
			:: concrete-record
			is-exception-case = exists inst.decl.sum-type-memberships, of x
				x.sum-type == ctx.common-types.exception
			prevent-constant: is-exception-case or exists fields, it.is-mutable
			fields: fields
	as sum-type
		res.body :=
			:: concrete-union
			java-interface: if body.kind == java-interface
				inst.decl.source.struct-decl-source-java!.path
			late-members: ()
		cases concrete-sum-type-case mut[] = for index, member in with-index body.listed-members
			member-type = get-concrete-type-for-struct-inst ctx, member.member, type-args
			ctx.deferred-sum-type-method-impls ~= res, index, declared-on-sum-type
			member-type, ()
		ctx.sum-types[res] := cases
		match body.kind
		as interface_
			()
		as java-interface
			ctx.deferred-java-interfaces ~= inst.decl
		as union_
			finish-sum-type-cases res, cases
		as variant_
			()

	for x in sum-type-memberships inst.decl
		sum-type = get-concrete-type ctx, x.sum-type, type-args
		case-types = ctx.sum-types[sum-type]!
		index = case-types.size
		case-types ~= (res, ())
		ctx.deferred-sum-type-method-impls ~= sum-type, index, declared-on-case-type

sum-type-case-index nat(ctx concretize-ctx, sum-type concrete-type, case-type concrete-type)
	body = sum-type.body.concrete-union!
	if body.has-members
		index-of! body.members, case-type
	else
		assert st = ctx.sum-types[sum-type] else
			error "Could not find members for sum type {show-concrete-type ctx.show-ctx, sum-type}"
		find-index st, it.member-type == case-type else
			log error, "Could not find sum type member {show-concrete-type ctx.show-ctx, case-type} for {show-concrete-type ctx.show-ctx, sum-type}"
			throw todo

sum-type-body-from-type sum-type(a concrete-type)
	a.source.concrete-type-source-inst!.decl.body.sum-type!

finish-sum-type-cases void(sum-type concrete-type, cases concrete-sum-type-case mut[])
	sum-type.body.concrete-union!.members := for x in cases
		x.member-type

sum-type-membership-method-impls concrete-fun?[]
	ctx concretize-ctx
	sum-type concrete-type
	member-type concrete-type
do quick-fill-in-concrete-fun-body
	sum-type-decl = sum-type.source.concrete-type-source-inst!.decl
	member-source = member-type.source.concrete-type-source-inst!
	membership = must-find-only member-source.decl.sum-type-memberships, it.sum-type.decl == sum-type-decl
	sum-type-method-impls-common ctx, membership.method-impls, member-source.type-args

sum-type-method-impls-common concrete-fun?[]
	ctx concretize-ctx
	method-impls called?[]
	type-args type-args-scope
do quick-fill-in-concrete-fun-body
	for x in method-impls
		if x
			get-concrete-fun-from-called ctx, type-args, (), x

-initialize-concrete-type-for-builtin void
	ctx concretize-ctx
	type concrete-type
	type-args concrete-type[]
	builtin_ builtin-type
do
	match builtin_
	as option
		type.body :=
			:: concrete-union
			java-interface: ()
			late-members: ctx.none-type, only! type-args
	else
		type.body := concrete-builtin-type builtin_, type-args
