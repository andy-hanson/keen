import
	../frontend/show-model
	../model/concrete-model
	../model/model

concrete-fun-info record mut
	all-used-funs concrete-fun[]
	yielding-funs concrete-fun-id set

gather-info concrete-fun-info(
	show-ctx show-ctx, # TODO:KILL -----------------------------------------------------------------------------------------
	common-funs concrete-common-funs,
	all-constants all-constants-concrete,
	all-concrete-funs concrete-fun[],
)
	calls, called-by = show-ctx build-called-by all-concrete-funs, all-constants
	funs-by-id concrete-fun[concrete-fun-id] = for x : all-concrete-funs
		x.id, x
	all-used-funs = common-funs get-used-funs calls, funs-by-id
	yielding-funs = common-funs get-yielding-funs all-used-funs, called-by
	all-used-funs, yielding-funs

-get-used-funs concrete-fun[](
	common-funs concrete-common-funs,
	calls concrete-fun-id[][concrete-fun-id],
	funs-by-id concrete-fun[concrete-fun-id],
)
	start-funs concrete-fun[] = match common-funs
	as concrete-common-funs-java x
		x.main, x.show-exception
	as concrete-common-funs-js x
		x.main,
	as concrete-common-funs-native x
		# These are all needed for 'low-common-funs'
		x.alloc, \
		x.cur-catch-point,
		x.gc-root,
		x.mark,
		x.pop-gc-root,
		x.rethrow-current-exception,
		x.rt-main,
		x.set-cur-catch-point,
		x.set-gc-root,
		x.throw-impl,
		x.user-main
	res concrete-fun mut[] = start-funs to
	set concrete-fun-id mut-set = for x : start-funs; x id
	to-propagate concrete-fun mut[] = start-funs to
	until to-propagate is-empty
		fun = to-propagate pop!
		for called : calls[fun id] ?? ()
			if set try-add called
				called-fun = funs-by-id[called]!
				res ~= called-fun
				to-propagate ~= called-fun
	res move-to

-get-yielding-funs concrete-fun-id set(
	common-funs concrete-common-funs,
	all-used-funs concrete-fun[],
	called-by concrete-fun[][concrete-fun-id],
)
	guard common-funs.concrete-common-funs-java is-empty

	res concrete-fun-id mut-set = ()
	# These are functions known to yield that have been added to 'res' but not yet processed for callers.
	to-propagate concrete-fun mut[] = ()
	add void mut(x concrete-fun) = x =>
		if res try-add x.id
			to-propagate ~= x

	for x : all-used-funs
		if x is-intrinsically-yielding-fun
			add[x]
	until to-propagate is-empty
		fun = to-propagate pop!
		for caller : called-by[fun id] ?? ()
			unless caller is-always-non-yielding common-funs
				add[caller]

	res move-to

-is-intrinsically-yielding-fun bool(a concrete-fun)
	if builtin_ ?= a.body concrete-fun-body-builtin
		match builtin_ kind
		as js-fun x
			x == await
		as builtin-binary binary
			binary == switch-fiber
		as builtin-fun-call-lambda
			true # Pessimistically assume that lambdas yield
		else
			false
is-always-non-yielding bool(a concrete-fun, common-funs concrete-common-funs)
	match common-funs
	as concrete-common-funs-java _
		throw unreachable
	as concrete-common-funs-js _
		false
	as concrete-common-funs-native x
		a == x.run-fiber

# Maps a function to all functions that call it.
-called-by alias
	concrete-fun[][concrete-fun-id]

-build-called-by (concrete-fun-id[][concrete-fun-id], called-by)(show-ctx show-ctx, all-concrete-funs concrete-fun[], all-constants all-constants-concrete)
	calls concrete-fun-id mut[] mut[concrete-fun-id] = ()
	called-by concrete-fun mut[] mut[concrete-fun-id] = ()
	for fun : all-concrete-funs
		match fun body
		as concrete-fun-body-builtin _
			()
		as concrete-fun-body-extern _
			()
		as concrete-expr x
			show-ctx build-called-by-recur all-constants, calls, called-by, fun, x
		as concrete-fun-body-var-get _
			()
		as concrete-fun-body-var-set _
			()
		as concrete-fun-body-deferred
			throw unreachable
	(for k, v : calls; k, v.move-to), (for k, v : called-by; k, v.move-to)
-build-called-by-recur void(
	show-ctx show-ctx, #unused ---------------------------------------------------------------------------------------------------
	all-constants all-constants-concrete,
	calls concrete-fun-id mut[] mut[concrete-fun-id],
	called-by concrete-fun mut[] mut[concrete-fun-id],
	f concrete-fun,
	expr concrete-expr,
)
	match expr kind
	as call-concrete-expr x
		calls ensure f.id, (() => ()) ~= x.called.id
		called-by ensure x.called.id, (() => ()) ~= f
	as constant x
		all-constants each-nested-constant expr.type, x, c =>
			if ptr ?= c constant-fun-pointer
				# Treat this as a call, since those are used to determine what is used
				calls ensure f.id, (() => ()) ~= ptr.fun
	else
		()
	for child : expr direct-child-exprs
		show-ctx build-called-by-recur all-constants, calls, called-by, f, child
