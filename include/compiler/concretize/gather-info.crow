import
	java/lang/StackOverflowError
	../frontend/show-model
	../model/ast
	../model/concrete-model
	../model/show-concrete-model
	../model/model

concrete-fun-info record
	all-used-funs concrete-fun set
	async concrete-async-info?

gather-info concrete-fun-info
	show-ctx show-ctx
	common-funs concrete-common-funs
	all-funs concrete-fun[]
	all-vars concrete-var[]
	method-impls concrete-method-info[concrete-type]
do
	called-by = build-called-by show-ctx, all-funs, all-vars, method-impls
	all-used-funs = get-used-funs common-funs, all-vars, called-by, method-impls
	async concrete-async-info? = if common-funs.concrete-common-funs-js
		get-async-funs all-used-funs, all-vars, called-by
	all-used-funs, async

-get-used-funs concrete-fun set
	common-funs concrete-common-funs
	all-vars concrete-var[]
	called-by foo
	method-impls concrete-method-info[concrete-type]
do
	start-funs concrete-fun set = with out in build
		# TODO: it would be simpler to have 'start-runtime' and 'stop-runtime' on all backends. Then these cases would be identical.
		from-common-funs concrete-fun[] = match x = common-funs
		as concrete-common-funs-java
			x.main, x.show-exception, x.to-symbol-from-string, x.start-runtime, x.stop-runtime
		as concrete-common-funs-js
			x.main, x.show-exception, x.to-symbol-from-string, x.to-string-from-js-any
		out ~~= from-common-funs
		# TODO: We should first find which vars are used .......................................................................
		for var in all-vars
			for v in called-by.var-calls[var] else ()
				out ~= v.called
		# All Java interface methods might be used, so force generating implementations
		for sum-type, impls in method-impls
			guard sum-type.source.concrete-type-source-inst!.decl.body.sum-type!.kind == java-interface # TODO: have a helper fn for this
			out ~~= impls.methods
	res concrete-fun mut[] = start-funs.to::concrete-fun[].to
	set concrete-fun mut-set = start-funs.to
	to-propagate concrete-fun mut[] = start-funs.to::concrete-fun[].to
	until is-empty to-propagate
		fun = pop! to-propagate
		for x in called-by.calls[fun] else ()
			called = x.called
			if try-add set, called
				res ~= called
				to-propagate ~= called
	res.move-to.to

-temp-async-kind enum(depends-on-caller, always-async) # better name? -----------------------------------------------------------------------
-== bool(a temp-async-kind, b temp-async-kind)
-<=> comparison(a temp-async-kind, b temp-async-kind)

-get-async-funs concrete-async-info
	all-used-funs concrete-fun set
	all-used-vars concrete-var[]
	called-by foo
do
	temp-kinds temp-async-kind mut[concrete-fun] = ()
	to-propagate concrete-fun mut[] = ()

	# TODO:PERF we already went over all funs when generating 'called-by'. Should do this as part of that to avoid having to walk all funs again.
	for fun in all-used-funs
		reason = find-direct-async fun
		kind temp-async-kind? = reason.?to
		if kind > temp-kinds[fun]
			temp-kinds[fun] := kind!
			to-propagate ~= fun

	until is-empty to-propagate
		fun = pop! to-propagate
		its-kind = temp-kinds[fun]!
		for x in called-by.called-by[fun] else ()
			caller = x.caller
			guard all-used-funs[caller] # TODO: can we just not put these in callers then? -----------------------------------------------------
			new-kind = propagation-kind its-kind, x
			if new-kind > temp-kinds[caller]
				temp-kinds[caller] := new-kind!
				to-propagate ~= caller

	used-depends-on-caller = calc-used-depends-on-caller all-used-funs, called-by, temp-kinds

	async-funs async-kind[concrete-fun] = for* fun, kind in temp-kinds
		out-kind async-kind? = match kind
		as depends-on-caller
			uses = used-depends-on-caller[fun]!
			if uses == used-sync | used-async
				sync-and-async
			elif uses == used-sync
				()
			elif uses == used-async
				always-async
			else
				throw unreachable
		as always-async
			always-async
		if out-kind
			- fun, out-kind
	funs: async-funs
	# TODO: this is not right.
	# The correct way to do this is basically consider each concrete-var as if it is a fun, since accessing it might run the initializer.
	var-initializers: filter all-used-vars, of x
		# TODO: This should use 'called-by.var-calls' instead of searching again
		search-async x.initializer, async-funs

-uses flags(used-sync, used-async)
-== bool(a uses, b uses)
-calc-used-depends-on-caller uses[concrete-fun](all-used-funs concrete-fun set, called-by foo, async-kinds temp-async-kind mut[concrete-fun])
	# This will only contain 'depends-on-caller' functions
	to-propagate concrete-fun mut[] = ()
	res uses mut[concrete-fun] = ()

	for fun in all-used-funs
		guard calls = called-by.calls[fun]
		use uses? = if ak = async-kinds[fun]
			match ak
			as depends-on-caller
				() # Do nothing so far
			as always-async
				used-async
		else
			used-sync
		guard use # TODO: should be able to put the entire 'if' expression in the 'guard' ------------------
		for x in calls
			called = x.called
			if async-kinds[called] == depends-on-caller and try-add res, called, use
				to-propagate ~= called

	until is-empty to-propagate
		fun = pop! to-propagate
		guard calls = called-by.calls[fun]
		uses = res[fun]!
		for x in calls
			called = x.called
			if async-kinds[called] == depends-on-caller and try-add res, called, uses
				to-propagate ~= called

	res.move-to

-try-add bool(res uses mut[concrete-fun], key concrete-fun, used uses)
	should-add = !(cur = res[key] and cur[used])
	if should-add
		res[key] := (res[key] else ()) | used
	should-add

-search-async bool(a concrete-expr, async-funs async-kind[concrete-fun])
	here bool = match x = a.kind
	as builtin-concrete-expr
		!!(intrinsic-async-kind x.fun, x.args, (), ())
	as call-concrete-expr
		!!async-funs[x.called]
	else
		false
	here or exists a.direct-child-exprs, of x then search-async x, async-funs

-directly-async-reason enum(calls-lambda-parameter, calls-other-lambda, js-await)
-to temp-async-kind(a directly-async-reason)
	match a
	as calls-lambda-parameter
		depends-on-caller
	as calls-other-lambda
		always-async
	as js-await
		always-async
-== bool(a directly-async-reason, b directly-async-reason)
-<=> comparison(a directly-async-reason, b directly-async-reason)

-find-direct-async directly-async-reason?(a concrete-fun)
	match body = a.body
	as concrete-fun-body-builtin
		match x = body.kind
		as builtin-fun-call-lambda
			calls-lambda-parameter
		as js-fun
			intrinsic-async-kind x
		else
			()
	as concrete-expr
		intrinsic-async-kind body, a.params.to, ()
	as fun-body-extern-java
		() # TODO: we shouldn't even get here for a JS build ---------------------------------------------------------------
	as concrete-fun-body-method
		throw todo
	as concrete-fun-body-deferred
		throw unreachable

-intrinsic-async-kind directly-async-reason?(a concrete-expr, params concrete-local set, local-lambda-locals concrete-local set)
	from-children directly-async-reason? mut() = of
		max mut directly-async-reason? = ()
		for x in direct-child-exprs a
			max := max max, intrinsic-async-kind x, params, local-lambda-locals
		max
	match x = a.kind
	as builtin-concrete-expr
		max from-children[], intrinsic-async-kind x.fun, x.args, params, local-lambda-locals
	as let-concrete-expr
		from-value = intrinsic-async-kind x.value, params, local-lambda-locals
		new-locals = match x.value.kind
		as lambda-concrete-expr
			local-lambda-locals ~ x.local
		else
			local-lambda-locals
		max from-value, intrinsic-async-kind x.then_, params, new-locals
	else
		from-children[]
-intrinsic-async-kind directly-async-reason?(a builtin-fun, args concrete-expr[], params concrete-local set, local-lambda-locals concrete-local set)
	match a
	as builtin-fun-call-lambda
		match x = args[0].kind
		as local-get-concrete-expr
			if params[x.local]
				calls-lambda-parameter
			elif local-lambda-locals[x.local]
				# Function is calling a lambda it defined, and we trace its body anyway
				()
			else
				# Unhandled case, pessimistically assume this is async
				calls-other-lambda
		else
			calls-other-lambda
	as js-fun
		intrinsic-async-kind a
	else
		()
-intrinsic-async-kind directly-async-reason?(a js-fun)
	if a == await or a == import_
		js-await

# Maps a function to all functions that call it.
-called-by alias
	concrete-fun[][concrete-fun]

-foo record # NAME ---------------------------------------------------------------------------------------------------------------------
	calls call-kind[][concrete-fun]
	var-calls call-kind[][concrete-var]
	called-by caller[][concrete-fun]

-build-called-by foo
	show-ctx show-ctx
	all-funs concrete-fun[]
	all-vars concrete-var[]
	method-impls concrete-method-info[concrete-type]
do
	calls call-kind mut[] mut[concrete-fun] = ()
	called-by caller mut[] mut[concrete-fun] = ()
	for fun in all-funs
		match x = fun.body
		as concrete-fun-body-builtin
			()
		as concrete-expr
			try
				build-called-by-recur calls, called-by, fun, x
			catch e as StackOverflowError
				log error, "Stack too deep building called-by for function {show-concrete-fun-sig show-ctx, fun, true}" # -------
				throw e
		as fun-body-extern-java
			()
		as concrete-fun-body-method
			method-info = method-impls[fun.params[0].type]!
			new-method-index = index-of! method-info.methods, fun
			assert new-method-index <= x.method-index # some methods may be omitted
			for impls in method-info.cases
				if impl = impls[new-method-index]
					(ensure calls, fun) ~= call-kind-method-impl impl
					(ensure called-by, impl) ~= fun, impl.call-kind-method-impl
		as concrete-fun-body-deferred
			throw unreachable
	var-calls call-kind mut[] mut[concrete-var] = ()
	for var in all-vars
		for called in all-calls var.initializer
			(ensure var-calls, var) ~= called
	calls: for k, v in calls then k, v.move-to
	var-calls: for k, v in var-calls then k, v.move-to
	called-by: for k, v in called-by then k, v.move-to
-build-called-by-recur void
	calls call-kind mut[] mut[concrete-fun]
	called-by caller mut[] mut[concrete-fun]
	f concrete-fun
	expr concrete-expr
do
	for x in all-calls expr
		ensure calls, f, it.noop ~= x
		ensure called-by, x.called, it.noop ~= (f, x)

-all-calls record(expr concrete-expr)
-iterate bool(a all-calls, f bool mut(x call-kind))
	b = match x = a.expr.kind
	as call-concrete-expr
		f[x]
	as match-string-like-concrete-expr
		f[x]
	else
		()
	b or iterate a.expr.direct-child-exprs, of child
		iterate child.all-calls, f

-caller record
	caller concrete-fun
	call-expr call-kind

-call-kind union
	call-concrete-expr
	match-string-like-concrete-expr
	call-kind-method-impl
-call-kind-method-impl record(impl concrete-fun)
-called concrete-fun(a call-kind)
	match a
	as call-concrete-expr
		a.called
	as match-string-like-concrete-expr
		a.equals
	as call-kind-method-impl
		a.impl

-propagation-kind temp-async-kind?(called-kind temp-async-kind, caller caller)
	match call = caller.call-expr
	as call-concrete-expr
		match called-kind
		as depends-on-caller
			res mut temp-async-kind? = ()
			# TODO: res = call.args max-of ..................................................................................................
			for arg in call.args
				res max:= if as-lambda-type arg.type
					match x = arg.kind
					as local-get-concrete-expr
						if contains caller.caller.params, x.local
							depends-on-caller
						else
							# Calling into one of caller's locals, which will be scanned anyway
							()
					as lambda-concrete-expr
						# We scan the body of the lambda anyway
						()
					else
						always-async
				else
					()
			res
		as always-async
			always-async
	as match-string-like-concrete-expr
		called-kind
	as call-kind-method-impl
		called-kind

