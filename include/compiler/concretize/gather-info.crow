import
	java/lang/StackOverflowError
	../frontend/show-model
	../model/concrete-model
	../model/show-concrete-model
	../model/model

concrete-fun-info record
	all-used-funs concrete-fun[]
	yielding-funs concrete-fun set
	yielding-var-initializers concrete-var set

gather-info concrete-fun-info
	show-ctx show-ctx
	common-funs concrete-common-funs
	all-funs concrete-fun[]
	all-vars concrete-var[]
	method-impls concrete-method-info[concrete-type]
do
	calls, var-calls, called-by = show-ctx build-called-by all-funs, all-vars, method-impls
	all-used-funs = common-funs get-used-funs all-vars, calls, var-calls
	yielding-funs, yielding-var-initializers = common-funs get-yielding-funs all-used-funs, all-vars, called-by
	all-used-funs, yielding-funs, yielding-var-initializers

-get-used-funs concrete-fun[](common-funs concrete-common-funs, all-vars concrete-var[], calls concrete-fun[][concrete-fun], var-calls concrete-fun[][concrete-var])
	start-funs concrete-fun set = with out : build
		from-common-funs concrete-fun[] = match common-funs
		as concrete-common-funs-java x
			x.main, x.show-exception, x.to-symbol-from-string, x.start-runtime, x.stop-runtime
		as concrete-common-funs-js x
			x.main, x.to-symbol-from-string
		out ~~= from-common-funs
		# TODO: We should first find which vars are used .......................................................................
		for var : all-vars
			out ~~= var-calls[var] ?? ()
	res concrete-fun mut[] = start-funs.to::concrete-fun[] to
	set concrete-fun mut-set = start-funs to
	to-propagate concrete-fun mut[] = start-funs.to::concrete-fun[] to
	until to-propagate is-empty
		fun = to-propagate pop!
		for called : calls[fun] ?? ()
			if set try-add called
				res ~= called
				to-propagate ~= called
	res move-to

# TODO: call this 'get-async-funs' and only run it if we are doing a JS build ------------------------------------------------------------
-get-yielding-funs (concrete-fun set, concrete-var set)
	common-funs concrete-common-funs
	all-used-funs concrete-fun[]
	all-used-vars concrete-var[]
	called-by concrete-fun[][concrete-fun]
do
	guard common-funs.concrete-common-funs-java is-empty : (), ()

	res concrete-fun mut-set = ()
	# These are functions known to yield that have been added to 'res' but not yet processed for callers.
	to-propagate concrete-fun mut[] = ()
	add void mut(x concrete-fun) = x =>
		if res try-add x
			to-propagate ~= x

	for x : all-used-funs
		if x is-intrinsically-yielding-fun && x !is-always-non-yielding common-funs
			add[x]
	until to-propagate is-empty
		fun = to-propagate pop!
		for caller : called-by[fun] ?? ()
			unless caller is-always-non-yielding common-funs
				add[caller]

	match common-funs
	as concrete-common-funs-java _
		()
	as concrete-common-funs-js x
		# Force this to be async for consistency
		res ~= x.main

	rez concrete-fun set = res move-to
	# TODO: this is not right. The correct way to do this is basically consider each concrete-var as if it is a fun, since accessing it might run the initializer.
	yielding-var-initializers concrete-var set = all-used-vars filter x =>
		x.initializer contains-any-yielding rez
	rez, yielding-var-initializers

-contains-any-yielding bool(a concrete-expr, yielding-funs concrete-fun set)
	here bool = match a kind
	as builtin-concrete-expr x
		x.fun is-intrinsically-yielding
	as call-concrete-expr x
		x.called in yielding-funs
	else
		false
	here || a.direct-child-exprs exists x => x contains-any-yielding yielding-funs

-is-intrinsically-yielding-fun bool(a concrete-fun)
	match a body
	as concrete-fun-body-builtin x
		x.kind is-intrinsically-yielding
	as concrete-expr x
		x is-intrinsically-yielding
	as fun-body-extern-java _
		false # OTDO: we shouldn't even get here for a Java build ---------------------------------------------------------------
	as concrete-fun-body-method _
		throw todo
	as concrete-fun-body-deferred
		throw unreachable
is-always-non-yielding bool(_ concrete-fun, common-funs concrete-common-funs) # RM --------------------------------------------
	match common-funs
	as concrete-common-funs-java _
		throw unreachable
	as concrete-common-funs-js _
		false

-is-intrinsically-yielding bool(a concrete-expr)
	here bool = match a kind
	as builtin-concrete-expr x
		x.fun is-intrinsically-yielding
	else
		false
	here || a.direct-child-exprs exists x => x is-intrinsically-yielding
-is-intrinsically-yielding bool(a builtin-fun)
	match a
	as builtin-fun-call-lambda
		true # Pessimistically assume that lambdas yield
	as js-fun x
		x == await || x == import_
	else
		false

# Maps a function to all functions that call it.
-called-by alias
	concrete-fun[][concrete-fun]

-build-called-by (concrete-fun[][concrete-fun], concrete-fun[][concrete-var], called-by)
	show-ctx show-ctx
	all-funs concrete-fun[]
	all-vars concrete-var[]
	method-impls concrete-method-info[concrete-type]
do
	calls concrete-fun mut[] mut[concrete-fun] = ()
	called-by concrete-fun mut[] mut[concrete-fun] = ()
	for fun : all-funs
		match fun body
		as concrete-fun-body-builtin _
			()
		as concrete-expr x
			try
				calls build-called-by-recur called-by, fun, x
			catch StackOverflowError e
				error log "Stack too deep building called-by for function {show-ctx show-concrete-fun-sig fun, true}" # -------
				throw e
		as fun-body-extern-java _
			()
		as concrete-fun-body-method x
			method-info = method-impls[fun.params[0] type]!
			new-method-index = method-info.methods index-of! fun
			assert new-method-index <= x.method-index # some methods may be omitted
			for impls : method-info.cases
				if impl ?= impls[new-method-index]
					calls ensure fun ~= impl
					called-by ensure impl ~= fun
		as concrete-fun-body-deferred
			throw unreachable
	var-calls concrete-fun mut[] mut[concrete-var] = ()
	for var : all-vars
		var.initializer each-call called =>
			var-calls ensure var ~= called
	(for k, v : calls; k, v.move-to), (for k, v : var-calls; k, v.move-to), (for k, v : called-by; k, v.move-to)
-build-called-by-recur void
	calls concrete-fun mut[] mut[concrete-fun]
	called-by concrete-fun mut[] mut[concrete-fun]
	f concrete-fun
	expr concrete-expr
do
	expr each-call called =>
		calls ensure f, (() => ()) ~= called
		called-by ensure called, (() => ()) ~= f

-each-call void(expr concrete-expr, f void mut(x concrete-fun))
	match expr kind
	as call-concrete-expr x
		f[x called]
	as match-string-like-concrete-expr x
		f[x equals]
	else
		()
	for child : expr direct-child-exprs
		child each-call f
