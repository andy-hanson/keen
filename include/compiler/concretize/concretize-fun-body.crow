use-prefix
import
	../model/concrete-model
	../model/model
	../model/source-range
	../model/uri
	./concretize-ctx
	./concretize-expr
	./generate

concrete-fun-for-wrap-main concrete-fun(ctx concretize-ctx, model-main fun-inst)
	string-array-type = get-concrete-type-for-struct-inst ctx, ctx.common-types.string-array, ()
	inner-main = get-non-template-concrete-fun ctx, model-main
	###
	wrapped-main nat(_ string[])
		real-main
		0
	###
	nat64 = ctx.nat64-type
	range = model-main.decl.range
	call-main concrete-expr = ctx.void-type, range, call-concrete-expr inner-main, ()
	zero concrete-expr = gen-constant-zero nat64, range
	body = gen-seq range, call-main, zero
	res concrete-fun =
		hash: take-next-id ctx
		source: concrete-fun-source-wrap-main range
		return-type: nat64
		params: (args::concrete-generated-local-kind, string-array-type),
		body: body
	add-concrete-fun ctx, res
	res

concrete-fun-for-all-tests concrete-fun(ctx concretize-ctx, selector test-selector)
	range uri-and-range = selector.main-uri, ()
	nat64 = ctx.nat64-type
	body concrete-expr[] =
		-- for test_ in all-tests ctx, selector
			gen-call range, test_, ()
		- gen-constant-zero nat64, range
	string-array-type = get-concrete-type-for-struct-inst ctx, ctx.common-types.string-array, ()
	# TODO: this is similar to concrete-fun-for-wrap-main, share code -------------------------------------------------------
	res concrete-fun =
		hash: take-next-id ctx
		source: concrete-fun-source-wrap-main range
		return-type: nat64
		params: (args::concrete-generated-local-kind, string-array-type),
		body: nat64, range, body.seq-concrete-expr
	add-concrete-fun ctx, res
	res

-main-uri uri(a test-selector)
	match a
	as test-selector-all
		a.main-config.config-uri!
	as config
		a.config-uri!
	as uri
		a
	as test_
		a.module-uri

-all-tests concrete-fun[](ctx concretize-ctx, selector test-selector)
	index mut nat = 0
	res concrete-fun mut[] = ()
	each-test ctx.program, ctx.target, selector, of test_
		res ~= concrete-fun-for-test ctx, test_, index
		index +:= 1
	res.move-to

-concrete-fun-for-test concrete-fun(ctx concretize-ctx, test_ test_, test-index nat)
	res concrete-fun =
		hash: take-next-id ctx
		source: concrete-fun-source-test test_, test-index
		return-type: ctx.void-type
		params: ()
		body: concrete-fun-body-deferred
	res.body := concretize-fun-body ctx, res, test_.body
	add-concrete-fun ctx, res
	res
