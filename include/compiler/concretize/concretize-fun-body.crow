import
	../model/concrete-model
	../model/model
	../model/source-range
	../model/uri
	../util/util
	./all-constants-builder
	./concretize-auto-fun
	./concretize-ctx
	./concretize-expr
	./generate

fill-in-concrete-fun-body void(ctx concretize-ctx, cf concrete-fun)
	cf.body := concrete-fun-body-deferred
	fun-body = cf.source.concrete-fun-source-regular!.decl body
	return-type = cf return-type
	range = cf range
	concrete-params = cf params
	cf.body := match fun-body
	as fun-body-bogus
		ctx gen-bogus return-type, range
	as auto-fun x
		(ctx, cf, (), (cf.params.size,)) concretize-auto-fun x
	as builtin-fun x
		ctx concretize-builtin-fun cf, x
	as create-enum-or-flags x
		return-type gen-constant range, x.member.value
	as create-record
		if concrete-params is-empty
			constant = ctx.all-constants get-constant-record return-type, ()
			return-type concrete-expr range, constant
		else
			ctx gen-create-record-from-params return-type, range, concrete-params
	as create-record-and-convert-to-sum-type x
		member-type = ctx get-concrete-type x.member, cf.source.concrete-fun-source-regular!.type-args
		member-index = ctx ensure-sum-type-case cf.return-type, member-type
		if concrete-params is-empty
			ctx gen-constant-union-empty-member-type return-type, range, member-index
		else
			record_ = ctx gen-create-record-from-params member-type, cf.range, concrete-params
			ctx gen-create-union return-type, range, member-index, record_
	as create-sum-type _
		case_ = ctx ensure-sum-type-case return-type, if concrete-params is-empty
			ctx void-type
		else
			concrete-params.only type
		ctx create-union-body cf, case_
	as expr x
		ctx concretize-fun-body cf, x
	as fun-body-file-import x
		ctx concretize-file-import cf, x
	as flags-function x
		ctx concretize-flags-function cf, x
	as fun-body-method x
		if ctx preserve-methods
			ctx.sum-type-to-methods ensure cf.params[0].type ~= cf
			x.method-index concrete-fun-body-method
		else
			ctx.deferred-methods ~= cf
			concrete-fun-body-deferred
	as record-field-call x
		ctx gen-record-field-call cf, x
	as record-field-get x
		record_ = range gen-local-get concrete-params.only
		index = record_.type field-index-from-field x.field
		ctx gen-record-field-get return-type, range, record_, index
	as record-field-set x
		param0, param1 = concrete-params only2
		p0 = range gen-local-get param0
		p1 = range gen-local-get param1
		index = p0.type field-index-from-field x.field
		ctx gen-record-field-set range, p0, index, p1
	as sum-type-member-get
		case_ = ctx ensure-sum-type-case concrete-params.only.type, (ctx unwrap-option-type return-type)
		ctx gen-union-member-get cf, case_
	as var-get x
		assert concrete-params is-empty
		expr = ctx get-var x.var var-get-concrete-expr
		return-type, range, expr
	as var-set x
		value = range gen-local-get concrete-params.only
		return-type, range, do ctx get-var x.var var-set-concrete-expr value
	as fun-body-uninitialized
		throw unreachable

concrete-fun-for-wrap-main concrete-fun(ctx concretize-ctx, model-main fun-inst)
	string-array-type = ctx get-concrete-type-for-struct-inst ctx.common-types.string-array, ()
	inner-main = ctx get-non-template-concrete-fun model-main
	###
	wrapped-main nat(_ string[])
		real-main
		0
	###
	nat64 = ctx nat64-type
	range = model-main.decl range
	call-main concrete-expr = ctx.void-type, range, (inner-main call-concrete-expr ())
	zero concrete-expr = nat64, range, 0.integral-value
	body = range gen-seq call-main, zero
	res concrete-fun = do
		hash: ctx next-hash
		source: range concrete-fun-source-wrap-main
		return-type: nat64
		params: ((0,), args::concrete-generated-local-kind, string-array-type),
		body: body
	ctx add-concrete-fun res
	res

-concretize-builtin-fun concrete-fun-body(ctx concretize-ctx, cf concrete-fun, a builtin-fun)
	return-type = cf return-type
	range = cf range
	type-args concrete-type[] data() = () => cf.source.concrete-fun-source-regular! type-args
	match a
	as builtin-fun-constant x
		return-type gen-constant range, do ctx to-constant return-type, x
	as builtin-fun-is-empty-type _
		constant constant = type-args[].only.is-empty-type.to integral-value
		return-type concrete-expr range, constant
	else
		a concrete-fun-body-builtin type-args[]
-to-constant constant(ctx concretize-ctx, type concrete-type, a builtin-fun-constant)
	match a
	as bool x
		x constant-bool
	as float x
		x constant-float
	as builtin-fun-constant-empty-option
		ctx gen-constant-none type
	as builtin-fun-constant-gc-safe-value
		constant-gc-safe-value

-gen-create-record-from-params concrete-expr
	ctx concretize-ctx
	record-type concrete-type
	range uri-and-range
	params concrete-local[]
do
	ctx gen-create-record record-type, range, for param : params
		range gen-local-get param

-create-union-body concrete-expr(ctx concretize-ctx, cf concrete-fun, member-index nat)
	if cf.params is-empty
		ctx gen-constant-union-empty-member-type cf.return-type, cf.range, member-index
	else
		ctx gen-create-union cf.return-type, cf.range, member-index, (cf.range gen-local-get cf.params.only)

-gen-constant-union-empty-member-type concrete-expr
	ctx concretize-ctx
	union-type concrete-type
	range uri-and-range
	member-index nat
do
	constant = ctx.all-constants get-constant-union union-type, member-index, constant-gc-safe-value
	union-type gen-constant range, constant

-concretize-file-import concrete-expr(ctx concretize-ctx, cf concrete-fun, import_ fun-body-file-import)
	cf.return-type, cf.range, match import_ content
	as file-content x
		ctx constant-of-bytes cf.return-type, x.bytes
	as string x
		ctx gen-string-literal-kind cf.range, x
	as import-file-content-bogus
		ctx gen-bogus-kind cf.range

get-var concrete-var(ctx concretize-ctx, decl var-decl)
	ctx.concrete-var-lookup ensure decl, () =>
		decl, (ctx get-concrete-type decl.type, ())

concrete-fun-for-all-tests concrete-fun(ctx concretize-ctx, selector test-selector)
	range uri-and-range = selector.main-uri, ()
	expr mut concrete-expr = ctx gen-void range
	for test_ : ctx all-tests selector
		expr := range gen-seq expr, (range gen-call test_, ())
	nat64 = ctx nat64-type
	string-array-type = ctx get-concrete-type-for-struct-inst ctx.common-types.string-array, ()
	# TODO: this is similar to concrete-fun-for-wrap-main, share code -------------------------------------------------------
	res concrete-fun = do
		hash: ctx next-hash
		source: range concrete-fun-source-wrap-main
		return-type: nat64
		params: ((0,), args::concrete-generated-local-kind, string-array-type),
		body: range gen-seq expr, do nat64, range, 0.integral-value
	ctx add-concrete-fun res
	res

-main-uri uri(a test-selector)
	match a
	as test-selector-all x
		x.main-config config-uri!
	as config x
		x config-uri!
	as uri x
		x
	as test_ x
		x module-uri

-all-tests concrete-fun[](ctx concretize-ctx, selector test-selector)
	index mut nat = 0
	res concrete-fun mut[] = ()
	ctx.program each-test ctx.all-externs, selector, test_ =>
		res ~= ctx concrete-fun-for-test test_, index
		index +:= 1
	res move-to

-concrete-fun-for-test concrete-fun(ctx concretize-ctx, test_ test_, test-index nat)
	res concrete-fun = do
		hash: ctx next-hash
		source: test_ concrete-fun-source-test test-index
		return-type: ctx void-type
		params: ()
		body: concrete-fun-body-deferred
	res.body := ctx concretize-fun-body res, test_.body
	ctx add-concrete-fun res
	res
