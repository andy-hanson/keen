import
	../model/concrete-model
	../model/model
	../model/source-range
	../model/uri
	./all-constants-builder
	./concretize-ctx

concretize-expr-ctx record mut
	concretize-ctx concretize-ctx
	cur-uri uri
	allocated-locals concrete-type[local]
	type-scope type-args-scope
	specs-scope specs-scope
	locals local-or-constant mut[local]
new concretize-expr-ctx
	concretize-ctx concretize-ctx
	fun concrete-fun
	allocated-locals struct-inst[local]
do
	type-scope = type-args-scope-for-fun fun
	concretize-ctx: concretize-ctx
	cur-uri: fun.module-uri
	allocated-locals: to-allocated-locals concretize-ctx, allocated-locals, type-scope
	type-scope: type-scope
	specs-scope: specs-scope-for-fun fun
	locals: ()
new concretize-expr-ctx
	concretize-ctx concretize-ctx
	cur-uri uri
	type-scope type-args-scope
	specs-scope specs-scope
	allocated-locals struct-inst[local]
do
	concretize-ctx: concretize-ctx
	cur-uri: cur-uri
	allocated-locals: to-allocated-locals concretize-ctx, allocated-locals, type-scope
	type-scope: type-scope
	specs-scope: specs-scope
	locals: ()
-to-allocated-locals concrete-type[local](concretize-ctx concretize-ctx, a struct-inst[local], type-scope type-args-scope)
	guard concretize-ctx.is-java
	map-values a, of x
		get-concrete-type concretize-ctx, x, type-scope
is-js bool(a concretize-expr-ctx)
	a.concretize-ctx.is-js
common-types common-types(a concretize-expr-ctx)
	a.concretize-ctx.common-types
available-types available-types(a concretize-expr-ctx)
	a.concretize-ctx.available-types
all-constants all-constants-builder(a concretize-expr-ctx)
	a.concretize-ctx.all-constants
bool-type concrete-type(a concretize-expr-ctx)
	a.concretize-ctx.bool-type
void-type concrete-type(a concretize-expr-ctx)
	a.concretize-ctx.void-type
to-uri-and-range uri-and-range(ctx concretize-expr-ctx, a source-range)
	ctx.cur-uri, a

typed-constant record(type concrete-type, value constant)
local-or-constant union(concrete-local, typed-constant)

get-concrete-type concrete-type(a concretize-expr-ctx, t type)
	get-concrete-type a.concretize-ctx, t, a.type-scope
get-concrete-type-for concrete-type(a concretize-expr-ctx, e expr)
	get-concrete-type a, type e, a.concretize-ctx.available-types

get-concrete-fun-from-called concrete-fun?(ctx concretize-expr-ctx, called called) quick-fill-in-concrete-fun-body
	guard res = get-concrete-fun-from-called ctx.concretize-ctx, ctx.type-scope, ctx.specs-scope, called
	guard !is-bogus res.return-type
	res
