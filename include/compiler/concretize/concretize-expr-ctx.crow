import
	../model/concrete-model
	../model/model
	../model/source-range
	../model/uri
	./concretize-ctx

concretize-expr-ctx record mut
	cur-uri uri
	allocated-locals concrete-type[local]
	type-scope type-args-scope
	specs-scope specs-scope
	locals concrete-local mut[local]
	contexts mut concrete-local array-view
new concretize-expr-ctx
	fun concrete-fun
	allocated-locals struct-inst[local]
do concretize-ctx
	type-scope = type-args-scope-for-fun fun
	cur-uri: fun.module-uri
	allocated-locals: to-allocated-locals allocated-locals, type-scope
	type-scope: type-scope
	specs-scope: specs-scope-for-fun fun
	locals: ()
	contexts: fun.context-params

new concretize-expr-ctx
	cur-uri uri
	type-scope type-args-scope
	specs-scope specs-scope
	allocated-locals struct-inst[local]
do concretize-ctx
	cur-uri: cur-uri
	allocated-locals: to-allocated-locals allocated-locals, type-scope
	type-scope: type-scope
	specs-scope: specs-scope
	locals: ()
	contexts: ()
-to-allocated-locals concrete-type[local](a struct-inst[local], type-scope type-args-scope) concretize-ctx
	do if is-java
	map-values a, of x
		get-concrete-type x, type-scope
to-uri-and-range uri-and-range(a source-range) concretize-expr-ctx
	cur-uri, a

concretize-and-expr-ctx spec concretize-ctx, concretize-expr-ctx

concrete-type concrete-type(a expr) concretize-and-expr-ctx
	get-concrete-type model-type a
model-type type(a expr) concretize-ctx
	type a, available-types

cur-uri uri() concretize-expr-ctx
	the::concretize-expr-ctx.cur-uri
locals concrete-local mut[local]() concretize-expr-ctx
	the::concretize-expr-ctx.locals
type-scope type-args-scope() concretize-expr-ctx
	the::concretize-expr-ctx.type-scope
specs-scope specs-scope() concretize-expr-ctx
	the::concretize-expr-ctx.specs-scope

get-concrete-type concrete-type(t type) concretize-and-expr-ctx
	get-concrete-type t, type-scope
get-concrete-type-for concrete-type(e expr) concretize-and-expr-ctx
	get-concrete-type type e, available-types

get-concrete-fun-from-called concrete-fun?(called called) concretize-and-expr-ctx, quick-fill-in-concrete-fun-body
	do if res = get-concrete-fun-from-called type-scope, specs-scope, called
	do unless is-bogus res.return-type
	res
