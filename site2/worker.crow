import
	crow/js
	crow/js/util
	crow/parse
	../include/compiler/lib/server
	../include/compiler/frontend/show-model
	../include/compiler/lib/lsp/lsp-parse
	../include/compiler/lib/lsp/lsp-types
	../include/compiler/model/uri

main void() summon, unsafe, js extern
	server-settings server-settings =
		include-dir: "file:///usr/local/bin/crow/include" must-parse-uri
		cwd: "file:///home/me/demo" must-parse-uri
		show-options:
			color: false
	server server = server-settings,
	server.lsp-state.supports-unknown-uris := true
	on-message void mut(event js-any) = of event
		data_ = event["data"].string-of-js-string
		info log "GOT MESSAGE: {data_}"
		input lsp-in-message = json parse data_ to
		exit = server handle-one-lsp-message input, (), of x
			info log "GONNA RESPOND: {x.to::json}"
			_ = "postMessage".js-global call x.to::json.show.to-js-string
		forbid _ ?= exit else todo
	self["onmessage"] := on-message
