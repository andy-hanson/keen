foo string()
	u mut u = "foo"
	if string u
		u := 1
		# No type refinement for a mutable variable
		u

u union(nat, string)

foo nat()
	r r-mut = 1,
	if r.x
		r.x := ()
		# No type refinement for a mutable field
		r.x
r-mut record(x mut nat?) mut


# No type refinement for a 'global' function
r-immut record(x nat?)
y nat?(a r-immut) global = a.x
foo nat() global
	r r-immut = 1,
	if r.y then r.y

# No type refinement for a function with mutable contexts
z nat?(a r-immut) r-mut = a.x
foo nat()
	r r-immut = 1,
	the r-mut = 2,
	if r.z then r.z
