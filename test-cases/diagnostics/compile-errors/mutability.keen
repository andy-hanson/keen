import
	keen/col/shared-array

rd record
	x mut nat
	y nat shared[]
rs record shared
	x mut nat
	y nat mut[]
rm record mut
	x mut nat
	y nat mut[]

ud union(rd, rs, rm)
ud2 union(rs[])
us union(rd, rs, rm) shared
um union(rd, rs, rm) mut

id interface
is_ interface shared
im interface mut

vd variant
vs variant shared
vm variant mut

m record mut, id case, is_ case, im case, vd case, vs case, vm case
s record shared, id case, is_ case, im case, vd case, vs case, vm case
d record id case, is_ case, im case, vd case, vs case, vm case
