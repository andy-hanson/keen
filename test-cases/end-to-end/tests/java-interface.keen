import
	keen/io/print
	keen/unsafe
	java/lang/Object
	java/util/Arrays
	java/util/Comparator

main void() global, java
	my-arr element buffer =
		- 1, 2
		- 2, 0
		- 1, 1
	# 'sort' is from 'java/lang/Arrays'; it's not the Keen sort function
	trusted sort my-arr, my-comparator
	for x in my-arr
		print "{x}"

-element alias
	(nat, nat)
-show string((x nat, y nat))
	"{x} {y}"

-my-comparator record() element Comparator case
-equals bool(_ my-comparator, _ Object)
	throw unreachable
-compare int32(_ my-comparator, x element, y element)
	match trusted x.reinterpret-cast::element <=> y.reinterpret-cast::element
	as less then -1
	as equal then 0
	as greater then 1
