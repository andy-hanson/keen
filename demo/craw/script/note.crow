import
	crow/col/sorted-list
	crow/io/duration

note record by-val
	# Half-steps above A
	value int
== bool(a note, b note)
<=> comparison(a note, b note)
to json(a note)
	a.value to
hash-mix void(a hasher, b note)
	a hash-mix b.value

to symbol(a note)
	a.show to

A note()
	0,
B note()
	2,
C note()
	3,

~+ note(a note, half-steps int)
	a.value + half-steps,
~- note(a note, half-steps int)
	a.value - half-steps,
~- int(a note, b note)
	a.value - b.value

show string(a note)
	"{a note-name}{a.value / 12}"

-note-name string(a note)
	match a.value % 12
	as 0
		"A"
	as 1
		"A♯"
	as 2
		"B"
	as 3
		"C"
	as 4
		"C♯"
	as 5
		"D"
	as 6
		"D♯"
	as 7
		"E"
	as 8
		"F"
	as 9
		"F♯"
	as 10
		"G"
	as 11
		"G♯"
	else
		throw unreachable

note-event union
	note-on note
	note-off note

show string(a note-event)
	match a
	as note-on x
		"+{x}"
	as note-off x
		"-{x}"

all-tracks record(tracks track[])
new all-tracks()
	(),
total-length duration(a all-tracks)
	unless a.tracks is-empty
		(for x : a tracks; x length)::duration[] max

min-and-max-note note min-and-max?(a all-tracks)
	unless a.tracks is-empty
		all-notes note[] = for track : a.tracks and-concat
			for _ : track notes
				()
			for _, x : track notes
				x note
		all-notes.min-and-max,

instrument enum(lightning, plum)
<=> comparison(a instrument, b instrument)
	a.to::string <=> b.to
hash-mix void(a hasher, b instrument)
	a hash-mix b.to::string
show string(a instrument)
	match a
	as lightning
		"Lightning"
	as plum
		"Plum"

track record(instrument instrument, notes (duration, track-note) sorted-list)
== bool(a track, b track)
to json(a track)
is-empty bool(a track)
	a.notes is-empty
length duration(a track)
	if start, x ?= a.notes last
		start + x.length

track-note record(note note, length duration)
== bool(a track-note, b track-note)
to json(a track-note)

recorded-event record(time duration, kind note-event)
show string(a recorded-event)
	"{a kind} at {a time}"

current-track record
	instrument instrument
	# Maps a currently playing note to the start time
	cur-notes-playing duration[note]
	done-notes (duration, track-note) sorted-list
new current-track(instrument instrument)
	instrument, (), ()
== bool(a current-track, b current-track)
to json(a current-track)
min-and-max-note note min-and-max?(a current-track)
	all-notes note set = a.cur-notes-playing.keys.to ~~ for _, x : a done-notes
		x note
	unless all-notes is-empty
		all-notes.min-and-max,

~ ~ current-track(a current-track, (time duration, event note-event))
	match event
	as note-on note
		a.instrument, (a.cur-notes-playing ~ (note, time)), a.done-notes
	as note-off note
		if start, rest-notes-playing ?= a.cur-notes-playing try-remove note
			a.instrument, rest-notes-playing, a.done-notes ~ (start, (note, time - start))
		else
			a

finish track(a current-track, time duration)
	done = a.done-notes ~~ for note, start : a cur-notes-playing
		start, (note, time - start)
	a.instrument, done

test
	a mut current-track = plum,
	a ~:= (1.seconds, A.note-on)
	a is (plum, ((A, 1.seconds),), ())
	a ~:= (2.seconds, B.note-on)
	a is (plum, ((A, 1.seconds), (B, 2.seconds)), ())
	a ~:= (3.seconds, B.note-off)
	a is do
		instrument: plum
		cur-notes-playing: (A, 1.seconds),
		done-notes: (2.seconds, (B, 1.seconds)),
	info log "{(a finish 4.seconds).to::json}"
	a finish 4.seconds is do
		instrument: plum
		notes: (1.seconds, (A, 3.seconds)), (2.seconds, (B, 1.seconds))

tracks-including-current record(all-tracks all-tracks, current current-track)
total-length duration(a tracks-including-current, cur-time duration)
	a.all-tracks.total-length max cur-time
min-and-max-note note min-and-max?(a tracks-including-current)
	a.all-tracks.min-and-max-note | a.current.min-and-max-note

|[t] t min-and-max?(a t min-and-max?, b t min-and-max?) t compare
	if x ?= a
		if y ?= b
			x | y,
		else
			a
	else
		b
