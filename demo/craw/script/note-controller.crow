import
	crow/experimental/observable
	crow/js
	crow/js/dom
	./note

control-event union
	enter
	note-event note-event

listen-for-notes control-event events() summon, trusted, js extern
	events control-event events-out = ()

	shift-left mut bool = false
	shift-right mut bool = false
	# Key is the unshifted note, value is the shifted note
	keys-down note mut[note] = ()

	keydown void mut(e js-any) = e =>
		code string = e["code"] cast
		if code == "Enter"
			events ~= enter
		if code == "ShiftLeft"
			shift-left := true
		elif code == "ShiftRight"
			shift-right := true
		elif key ?= code note-for-key
			note = key apply-shift shift-left, shift-right
			if old-note ?= keys-down[key]
				if old-note != note
					events ~= old-note.note-off note-event
					events ~= note.note-on note-event
					keys-down[key] := note
			else
				events ~= note.note-on note-event
				keys-down[key] := note
	_ = document.as-js call-property "addEventListener", "keydown"::string, keydown

	keyup void mut(e js-any) = e =>
		code string = e["code"] cast
		if code == "ShiftLeft"
			shift-left := false
		elif code == "ShiftRight"
			shift-right := false
		elif key ?= code note-for-key
			if note ?= keys-down remove key
				events ~= note.note-off note-event
	_ = document.as-js call-property "addEventListener", "keyup"::string, keyup

	all-keys-up void mut() = () =>
		for _, note : keys-down.move-to::(note, note)[]
			events ~= note.note-off note-event
	_ = "window".js-global call-property "addEventListener", "blur"::string, all-keys-up

	events events

-apply-shift note(a note, shift-left bool, shift-right bool)
	if shift-left && shift-right
		a
	elif shift-left
		a - 12
	elif shift-right
		a + 12
	else
		a

-note-for-key note?(key string)
	key-to-note[key]
-key-to-note note[string]()
	xs string[] = "KeyQ", "KeyA", "KeyW", "KeyS", "KeyE", "KeyD", "KeyR", "KeyF", "KeyT", "KeyG",
	"KeyY", "KeyH", "KeyU", "KeyJ", "KeyI", "KeyK", "KeyO", "KeyL", "KeyP",
	"Semicolon", "BracketLeft", "Quote", "BracketRight"
	for i, x : xs with-index
		x, A - 10 + i.to
