import
	crow/js
	crow/js/dom

dimensions record(width float, height float) by-val
show string(a dimensions)
	"{a width} × {a height}"

rect record(top-left dimensions, size dimensions) by-val
left float(a rect)
	a.top-left width
top float(a rect)
	a.top-left height
width float(a rect)
	a.size width
height float(a rect)
	a.size height
show string(a rect)
	"({a left}, {a top}) {a size}"

canvas extern
as-node node(a canvas) trusted, js
	a js-cast

set-canvas-size void(canvas node, size dimensions) trusted, js
	canvas.as-js["width"] := size width
	canvas.as-js["height"] := size height

context2d extern

set-fill-style void(a context2d, style string) trusted, js
	a.as-js["fillStyle"] := style

fill-rect void(a context2d, r rect) js
	a fill-rect r.left, r.top, r.width, r.height
fill-rect void(a context2d, x float, y float, width float, height float) trusted, js
	_ = a.as-js call-property "fillRect", x, y, width, height
