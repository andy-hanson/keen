import
	crow/experimental/observable
	crow/js
	crow/js/dom
	./note
	./show-tracks
	./util

instrument-picker node(obs instrument mut-observable) summon, js extern
	fieldset = "fieldset" create-node
	legend = "legend" create-node
	legend.text-content := "Pick instrument:"
	fieldset ~= legend
	initial = obs get
	fieldset ~~= for x : members::instrument[]
		info log "instrument is {x}"
		input = "input" create-node
		input.id := x to
		trusted
			input.as-js["type"] := "radio"::string
			input.as-js["name"] := "instrument"::string
			if x == initial
				input.as-js["checked"] := true
		input.value := x to
		input on-click () =>
			obs set x

		label = "label" create-node
		trusted
			label.as-js["for"] := x.to::string
		label ~= x.canvas-for-instrument
		"" create-div (input, label)
	"form" create-node (), "instrument-picker", (fieldset,)

-canvas-for-instrument node(instrument instrument) trusted, js extern
	canvas = "canvas" create-node
	canvas-size dimensions = 50, 50
	canvas.canvas-size := canvas-size
	context context2d = canvas.as-js call-property "getContext", "2d"::string cast
	context fill-rect-instrument ((0, 0), canvas-size), instrument
	canvas
