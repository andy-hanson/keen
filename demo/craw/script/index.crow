import
	crow/experimental/observable
	crow/js/dom
	crow/test-util/test-runner
	./main-controller
	./mixer
	./note
	./note-controller

main void() summon, unsafe, js extern
	run-all-tests
	wait-until-window-loaded
	main-element = document query! "main"

	mixer mixer = web-mixer
	notes = listen-for-notes
	mode mode mutable-observable = idle,

	mixer main-controller notes, mode

	main-element ~= mode mode-switcher

	main-element ~= notes.current-notes note-display

-mode-switcher node(mode-obs mode mutable-observable) js extern
	res = create-div
	mode-obs.observable now-and-subscribe shared mode =>
		res remove-all-children

		mode-div = create-div
		mode-span = "" create-span ("{mode}".create-text-node,)
		mode-div ~= mode-span
		res ~= mode-div

		button-text string = match mode
		as idle
			"Record"
		as recording
			"Finish recording"
		button = button-text create-button "", (button-text.create-text-node,), () =>
			mode-obs set match mode
			as idle
				recording
			as recording
				idle
			mode-span.text-content := "{mode}"

		res ~= button
		info log "u done it"
	res

-current-notes note set events(a note-event events)
	notes mut note set = ()
	for event : a
		match event
		as note-on note
			notes ~:= note
			notes
		as note-off note
			notes -:= (note,)
			notes

-note-display node(notes-events note set events) js extern
	res = create-div
	notes-events subscribe shared notes =>
		res remove-all-children
		sorted note[] = notes.to sort
		desc = " " join for note : sorted; "{note}"
		res ~= desc create-text-node
	res
