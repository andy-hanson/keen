import
	crow/experimental/observable
	crow/js/dom
	crow/test-util/test-runner
	./instrument-picker
	./main-controller
	./mixer
	./note
	./note-controller
	./show-tracks

main void() summon, unsafe, js extern
	run-all-tests
	wait-until-window-loaded
	main-element = document query! "main"

	mixer mixer = web-mixer
	notes = listen-for-notes

	main = mixer start-main-controller notes

	main-element ~= main.mode mode-switcher
	main-element ~= main.instrument instrument-picker
	main-element ~= notes.current-notes note-display

	main-element ~= (() => mixer cur-time) show-tracks main.tracks-including-current

-mode-switcher node(mode-obs mode mut-observable) js extern
	res = create-div
	mode-obs.observable now-and-subscribe shared mode =>
		res remove-all-children

		mode-div = create-div
		mode-span = "" create-span ("{mode}".create-text-node,)
		mode-div ~= mode-span
		res ~= mode-div

		button-text string = match mode
		as idle
			"Record"
		as recording
			"Finish recording"
		button = button-text create-button "", (button-text.create-text-node,), () =>
			mode-obs modify x => x opposite
			mode-span.text-content := "{mode}"

		res ~= button
	res

-current-notes note set observable(a control-event events)
	res note set mut-observable = (),
	a subscribe shared event =>
		if note-event ?= event note-event
			match note-event
			as note-on note
				res modify x => x ~ note
			as note-off note
				res modify x => x - (note,)
	res observable

-note-display node(notes-events note set observable) js extern
	res = create-div
	notes-events now-and-subscribe shared notes =>
		sorted note[] = notes.to sort
		desc = " " join for note : sorted; "{note}"
		res remove-all-children
		res ~= "You are playing these notes: {desc}" create-text-node
	res
