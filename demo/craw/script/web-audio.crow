import
	crow/io/duration
	crow/js

AudioContext extern
new AudioContext() summon, trusted, js extern
	"AudioContext".js-global.call-new cast
current-time duration(a AudioContext) summon, trusted, js extern
	a.as-js["currentTime"].cast seconds

AudioDestinationNode extern
destination AudioDestinationNode(a AudioContext) trusted, js extern
	a.as-js["destination"] cast

OscillatorNode extern
OscillatorType enum(sine, square, sawtooth, triangle)
create-oscillator OscillatorNode(a AudioContext, kind OscillatorType) trusted, js extern
	res = a.as-js call-property "createOscillator"
	res["type"] := kind.to::string
	res cast
start void(a OscillatorNode) trusted, js extern
	_ = a.as-js call-property "start"
stop void(a OscillatorNode, time duration) trusted, js extern
	_ = a.as-js call-property "stop", time.seconds

GainNode extern
context AudioContext(a GainNode) trusted, js extern
	a.as-js["context"] cast
disconnect void(a GainNode) trusted, js extern
	_ = a.as-js call-property "disconnect"
create-gain GainNode(a AudioContext) trusted, js extern
	a.as-js call-property "createGain" cast
gain AudioParam(a GainNode) trusted, js extern
	a.as-js["gain"] cast
frequency AudioParam(a OscillatorNode) trusted, js extern
	a.as-js["frequency"] cast

connect void(a OscillatorNode, b GainNode) trusted, js extern
	_ = a.as-js call-property "connect", b
connect void(a GainNode, b AudioDestinationNode) trusted, js extern
	_ = a.as-js call-property "connect", b

AudioParam extern
value float(a AudioParam) trusted, js extern
	a.as-js["value"] cast
setValueAtTime void(a AudioParam, value float, time duration) trusted, js extern
	_ = a.as-js call-property "setValueAtTime", value, time.seconds
linearRampToValueAtTime void(a AudioParam, value float, time duration) trusted, js extern
	_ = a.as-js call-property "linearRampToValueAtTime", value, time.seconds
cancelAndHoldAtTime void(a AudioParam, time duration) trusted, js extern
	_ = a.as-js call-property "cancelAndHoldAtTime", time.seconds
