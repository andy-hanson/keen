import
	crow/col/sorted-list
	crow/experimental/observable
	crow/io/duration
	crow/js
	crow/js/dom
	./note
	./util

show-tracks node(
	cur-time duration mut(),
	obs tracks-including-current observable,
) summon, trusted, js extern
	canvas = "canvas" create-node
	context = canvas.as-js call-property "getContext", "2d"::string
	(window-size | obs) now-and-subscribe shared (window-size, tracks) =>
		canvas-size dimensions = window-size.width * 0.9, window-size.height * 0.5
		canvas.canvas-size := canvas-size
		context.cast render-tracks canvas-size, tracks, cur-time[]
	canvas

fill-rect-instrument void(a context2d, rect rect, instrument instrument) js extern
	a.fill-style := match instrument
	as lightning
		"yellow"
	as plum
		"purple"
	a fill-rect rect

-window-size dimensions observable() summon, trusted, js extern
	res dimensions mut-observable = cur-window-size,
	cb void mut() = () => res set cur-window-size
	_ = "window".js-global call-property "addEventListener", "resize"::string, cb
	res observable

-cur-window-size dimensions() summon, trusted, js extern
	width float = "window".js-global["innerWidth"] cast
	height float = "window".js-global["innerHeight"] cast
	width, height

render-tracks void(
	context context2d,
	canvas-size dimensions,
	tracks tracks-including-current,
	cur-time duration,
) trusted, js extern
	total-length = tracks total-length cur-time round-up-to 5.seconds
	note-scale = tracks note-scale
	context.fill-style := "grey"
	context fill-rect ((0, 0), canvas-size)
	for track : tracks.all-tracks tracks
		context.fill-style := "black"
		for start, note : track notes
			rect = start note-rect note, canvas-size, total-length, note-scale
			context fill-rect-instrument rect, track.instrument

-round-up-to duration(a duration, b duration)
	a.seconds round-up-to b.seconds seconds
-round-up-to float(a float, b float)
	assert b > 0 : b invalid-divisor
	(a / b).round-up * b

invalid-divisor record(value float) exception variant-member
show string(_ invalid-divisor)
	"Float divisor must be positive"
test
	9 round-up-to 5.25 is 10.5
	-10 round-up-to 4 is -8
	try
		_ = 1 round-up-to -2
		should-throw
	catch invalid-divisor x
		x.value is -2

-note-scale note min-and-max(a tracks-including-current)
	base note min-and-max = A, A + 12
	if x ?= a min-and-max-note
		x | base
	else
		base

note-rect rect(
	start duration,
	a track-note,
	canvas-size dimensions,
	total-length duration,
	note-scale note min-and-max,
)
	x-scale = canvas-size.width / total-length.seconds
	x = start.seconds * x-scale
	width = a.length.seconds * x-scale
	y-scale float = canvas-size.height / (note-scale.max + 1 - note-scale.min).to
	y float = canvas-size.height - (a.note + 1 - note-scale.min).to * y-scale
	(x, y), (width, y-scale)
