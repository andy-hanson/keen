import
	./headers

+db record force-shared
	raw sqlite3 mut*

+open-sqlite3 record(db-path string) nominal
+with-block[t] t(a open-sqlite3, cb t mut(db db)) summon, t shared, (native, sqlite3) extern
	trusted
		db mut sqlite3 mut* = null
		# Create empty file it does if not exist
		err = a.db-path.to sqlite3_open_v2 &db, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE, null
		assert err == SQLITE_OK
		finally db close
		cb[db,]

-close void(db sqlite3 mut*) summon, unsafe, (native, sqlite3) extern
	err2 = db sqlite3_close
	assert err2 == SQLITE_OK

+run void(db db, command string) summon, (native, sqlite3) extern
	for _ : db query command
		()

+query record(db db, query string) mut, nominal

# TODO: this is just to get the size hint. Should be named 'size-hint'?
+size nat64(_ query)
	0

+iterate bool(a query, f bool mut(row string[symbol])) summon, trusted, (native, sqlite3) extern
	stmt mut sqlite3_stmt mut* = null
	tail mut c-string = null
	a.db.raw sqlite3_prepare_v3 a.query.to, a.query.size-char8s.to,
		0, &stmt, &tail check-sqlite3-error
	finally stmt.sqlite3_finalize check-sqlite3-error
	assert *tail == "\0"
	n-columns = stmt sqlite3_column_count
	loop
		step-result = stmt sqlite3_step
		match step-result
		as SQLITE_ROW
			row string[symbol] = for i : 0::nat32 .. n-columns
				key = stmt sqlite3_column_name i
				value = stmt sqlite3_column_text i
				key.to::string.to, value.to
			if f[row]
				break
			else
				continue
		as SQLITE_DONE
			break
		else
			throw step-result sqlite-error

# TODO: this is needed because of looping over a range .......................................................................
-+ nat32(a nat32, b nat64)
	a + b.to
# TODO: this is needed because of looping over a range .......................................................................
-- nat64(a nat32, b nat32)
	(a - b).to

+sqlite-error record(code sqlite3-result) exception case
+show string(a sqlite-error)
	"SQLite error {a code}"

-check-sqlite3-error void(err sqlite3-result)
	assert err == SQLITE_OK : err sqlite-error
