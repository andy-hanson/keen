#!/usr/bin/env crow
import
	crow/io/net/http-server
	crow/io/net/http-types
	crow/io/print: out, print
	crow/io/stdin: read-stdin
	./index.html as index-html string
	./index.js as index-js string
	./index.js.map as index-js-map string

main void() summon, (libc, native, posix) extern
	handler http-handler = req => req handle-request
	port nat16 = 8080
	with _ : port http-server handler
		out print "Serving at http://localhost:{port}; press enter to stop"
		_ = read-stdin

-handle-request http-response(req http-request) summon, native extern
	match req method
	as GET
		match req path
		as "/"
			index-html http-ok
		as "/index.js"
			index-js http-ok
		as "/index.js.map"
			index-js-map http-ok
		else
			throw http-not-found
	else
		throw http-not-found
