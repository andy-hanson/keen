import
	crow/io/duration

note record by-val
	# Half-steps above A
	value int
== bool(a note, b note)
<=> comparison(a note, b note)
to json(a note)
	a.value to
hash-mix void(a hasher, b note)
	a hash-mix b.value

A note()
	0,
B note()
	2,
C note()
	3,

~+ note(a note, half-steps int)
	a.value + half-steps,
~- note(a note, half-steps int)
	a.value - half-steps,

show string(a note)
	"{a note-name}{a.value / 12}"

-note-name string(a note)
	match a.value % 12
	as 0
		"A"
	as 1
		"A♯"
	as 2
		"B"
	as 3
		"C"
	as 4
		"C♯"
	as 5
		"D"
	as 6
		"D♯"
	as 7
		"E"
	as 8
		"F"
	as 9
		"F♯"
	as 10
		"G"
	as 11
		"G♯"
	else
		throw unreachable

note-event union
	note-on note
	note-off note

show string(a note-event)
	match a
	as note-on x
		"+{x}"
	as note-off x
		"-{x}"

# Events are in order
recording record(notes recorded-note[])
== bool(a recording, b recording)
to json(a recording)
length duration(a recording)
	unless a.notes is-empty
		a.notes[end - 1] end

recorded-note record(note note, start duration, length duration)
== bool(a recorded-note, b recorded-note)
to json(a recorded-note)
end duration(a recorded-note)
	a.start + a.length

recorded-event record(time duration, kind note-event)
show string(a recorded-event)
	"{a kind} at {a time}"

recording-builder record mut
	# Maps a currently playing note to the start time
	-cur-notes-playing duration mut[note]
	-out recorded-note mut[]
new recording-builder()
	(), ()

~= void(a recording-builder, (time duration, event note-event))
	match event
	as note-on note
		a.cur-notes-playing[note] := time
	as note-off note
		start = a.cur-notes-playing remove! note
		a.out ~= (note, start, time - start)

finish recording(a recording-builder, time duration)
	for note, start : a cur-notes-playing
		a.out ~= (note, start, time - start)
	notes recorded-note[] = a.out.move-to sort x => x start
	notes,

test
	a recording-builder = ()
	a ~= (1.seconds, A.note-on)
	a ~= (2.seconds, B.note-on)
	a ~= (3.seconds, B.note-off)
	a finish 4.seconds is (((A, 1.seconds, 3.seconds), (B, 2.seconds, 1.seconds)),)
