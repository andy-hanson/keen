main void()
	zero nat = 0
	one = zero + 1
	odds nat[] = (1, 2, 3)::nat[] filter x =>
		x !is-multiple-of 2
	for x : odds
		info log "{x}"

f void(_ string-builder, a string-builder, (x nat, y string-builder))
	()

u union
	foo nat
f nat(u u)
	match u
	as foo x
		x

v variant

r record(n nat) v variant-member

f nat(v v)
	match v
	as r x
		x n
	else
		0
