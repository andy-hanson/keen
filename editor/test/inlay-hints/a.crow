import
	./b
	./c

use-c nat()
	# deliberately skip c2 to check that only used imports are shown in import inlay
	c0 + c1 + c3 + c4 + c5 + c6

main void()
	zero nat = 0
	one = zero + 1
	odds nat[] = (1, 2, 3)::nat[] filter of x
		x !is-multiple-of 2
	for x in odds
		info log "{x}"

f string(_ string-builder, a string-builder, (x nat, y string-builder))
	b

v variant
r record(n nat) v case

f nat(v v)
	match v
	as r x
		x n
	else
		0
