{
	"name": "crow",
	"displayName": "Crow Programming Language",
	"description": "IDE support for Crow",
	"publisher": "crow",
	"version": "0.0.0",
	"engines": {
		"vscode": "^1.107.1"
	},
	"activationEvents": [
		"onLanguage:crow"
	],
	"files": ["index.js", "license.txt", "node_modules"],
	"main": "./index.js",
	"contributes": {
		"languages": [
			{
				"id": "crow",
				"extensions": [
					".crow"
				]
			}
		]
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@vscode/vsce": "^3.7.1"
	}
}
