{
	"name": "keen",
	"displayName": "Keen Programming Language",
	"description": "IDE support for Keen",
	"publisher": "crow",
	"version": "0.0.0",
	"engines": {
		"vscode": "^1.107.1"
	},
	"activationEvents": [
		"onLanguage:keen",
		"onLanguage:kid"
	],
	"files": ["index.js", "license.txt", "node_modules"],
	"main": "./index.js",
	"contributes": {
		"languages": [
			{
				"id": "keen",
				"extensions": [
					".keen"
				]
			},
			{
				"id": "kid",
				"extensions": [
					".kid"
				]
			}
		]
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@vscode/vsce": "^3.7.1"
	}
}
