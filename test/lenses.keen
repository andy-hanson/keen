test
	get r, x is 1
	get r, y is 2
	get r, z is (3,)
	set r, x, 7 is 7, 2, (3,)
	set r, y, 7 is 1, 7, (3,)
	set r, z, (7,) is 1, 2, (7,)
	modify r, x, {it * 10} is 10, 2, (3,)

test
	get r, z * n is 3
	set r, z * n, 7 is 1, 2, (7,)
	modify r, z * n, {it * 10} is 1, 2, (30,)

test
	get r, x + y is (1, 2)
	set r, x + y, (7, 8) is 7, 8, (3,)
	modify r, x + y, it.swap is 2, 1, (3,)

test
	get r, x + z * n is 1, 3
	set r, x + z * n, (7, 8) is 7, 2, (8,)
	modify r, x + z * n, it.swap is 3, 2, (1,)

-r r() = 1, 2, (3,)

r record
	x nat
	y nat
	z r2

r2 record
	n nat
