# Unlike 'finally' and 'try' with a block, 'try =' should work in a loop.
test
	n mut = 4
	results nat mut[] = ()
	until
		try res = 12 / n catch as arithmetic-error then true
		results ~= res
		n -:= 1
		false
	n is 0
	results.to::nat[] is (3, 4, 6, 12)

test
	n nat? =
		try x = 1 / 0 catch as arithmetic-error then ()
		x + 1
	n is ()

test
	try
		finally throw error "thrown second"
		throw error "thrown first"
	catch e as error
		e.show is "thrown second"

test
	foo {3} is 4
	foo {0} is 0
	foo {throw error "Testing"} is 99

-foo nat(f nat mut())
	try
		12 / f[]
	catch as arithmetic-error
		0
	catch x
		x.show is "Testing"
		99
