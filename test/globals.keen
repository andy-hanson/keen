import
	keen/io/duration
	keen/io/time
	keen/parallel

test
	do trusted
	g := 33
	# If 'g' were thread-local, this would be uninitialized for some threads.
	(for::nat[] _ in parallel 0::nat .. 10 then g) is n-of 10, 33
-g global(nat) = 0

test global
	do trusted
	do unless java # TODO
	do unless js # TODO: thread-local in JS needs to be on the async context
	results nat[] = for x in parallel 0 .. 10
		tl := x
		tl +:= 1
		# This gives 'tl' time to change before returning,
		# which would cause the test to fail if 'tl' were global
		sleep 1.microseconds
		tl
	results is to 1 .. 11
-tl thread-local(nat64) = 0
