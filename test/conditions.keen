test
	try
		assert 1::nat < 0
		should-throw
	catch x as error
		x.show is "Asserted expression is false: 1::nat < 0"
test
	try
		forbid 1::nat > 0
		should-throw
	catch x as error
		x.show is "Forbidden expression is true: 1::nat > 0"

test
	xs nat mut[] = 1,
	assert x = pop xs
	x is 1
	forbid y = pop xs else "popped {y}".error

test
	try
		xs nat mut[] = ()
		assert pop xs
		should-throw
	catch x as error
		x.show is "Asserted option is empty: pop xs"

test
	try
		xs nat mut[] = 1,
		forbid pop xs
		should-throw
	catch x as error
		x.show is "Forbidden option is non-empty: pop xs"
test
	try
		xs nat mut[] = 1,
		forbid x = pop xs else "popped {x}".error
		should-throw
	catch x as error
		x.show is "popped 1"

test
	xs nat mut[] = 1,
	n = if x = pop xs
		x
	else
		2
	n is 1
	m = if x = pop xs
		x
	else
		2
	m is 2

	y = unless pop xs
		3
	y is 3

test
	xs nat mut[] = 1,
	a =
		do if x = pop xs else 2
		x
	a is 1
	b =
		do if x = pop xs else 2
		x
	b is 2

test
	xs nat mut[] = 1, 2
	out nat mut[] = ()
	while x = pop xs
		out ~= x
	xs.to::nat[] is ()
	out.to::nat[] is (2, 1)

test
	xs nat mut[] = 1, 2
	until x = pop xs
		throw unreachable
	x is 2
	xs.to::nat[] is (1,)

test
	(if x = some and y = none then x + y) is 0
	(if x = some and y = some2 then x + y) is 3
	g =
		do if x = some and y = none
		x + y
	g is 0
	g2 =
		do if x = some and y = some2
		x + y
	g2 is 3
-some nat?()
	1
-some2 nat?()
	2
-none nat?()
	()

test
	x nat? = 1
	res = if not x
		2
	else
		x
	res is 1
