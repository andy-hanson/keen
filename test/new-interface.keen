i0 interface
	m nat()
test
	a i0 = m: {1}
	m a is 1
	b i0 = m: {2}
	m b is 2

i1 interface
	m nat(x nat)
test
	a i1 = m: it + 1
	m a, 1 is 2
	b i1 = m: it * 2
	m b, 2 is 4

i2 interface
	m nat(x nat, y nat)
test
	a i2 = m: of x, y then x + y
	b i2 = m: of x, y then x * y
	m a, 3, 4 is 7
	m b, 3, 4 is 12

i3 interface
	m nat()
	n nat()
test
	a i3 =
		m: {1}
		n: {2}
	m a is 1
	n a is 2
