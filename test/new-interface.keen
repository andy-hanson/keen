i0 interface
	m nat()
test
	m (m: {1}) is 1
	m (m: {2}) is 2

i1 interface
	m nat(x nat)
test
	m (m: it + 1), 1 is 2
	m (m: it * 2), 2 is 4

i2 interface
	m nat(x nat, y nat)
test
	m (m: of x, y then x + y), 3, 4 is 7
	m (m: of x, y then x * y), 3, 4 is 12

i3 interface
	m nat()
	n nat()
test
	a i3 =
		m: {1}
		n: {2}
	m a is 1
	n a is 2
