# Test that Java can handle unsigned numbers that exceed the range of the corresponding signed type.
# Previously there was a bug where it would throw an exception in the java/lang/Byte constructor with a too-big value.
test
	optional-nat8 is 0xff
	optional-nat16 is 0xffff
	optional-nat32 is 0xffffffff
	optional-nat64 is 0xffffffffffffffff
optional-nat8 nat8?() = max-value::nat8
optional-nat16 nat16?() = max-value::nat16
optional-nat32 nat32?() = max-value::nat32
optional-nat64 nat64?() = max-value::nat64
