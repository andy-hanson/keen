test
	r r = 1,
	i i = r
	i.m is "r"
	v v = r
	v.m is "r"
	assert match v
	as r
		true
	else
		false

test
	x = 1
	y nat?? = x
	y!! is 1

-i interface
	m string()
-v variant
	m string()
-r record(x nat) i case, v case
-m string(_ r)
	"r"

test
	r r = 1,
	i i = returns-r
	takes-i r
	xs r[] = r,
	_ i = takes-t-array xs
	_ i[] = takes-t r
	takes-t-t i, r
	takes-t-t r::i, i
-returns-r r()
	1,
-takes-i void(_ i)
	()
-takes-t-array[t] t(a t[])
	a[0]
-takes-t[t] t[](a t)
	a,
-takes-t-t[t] void(_ t, _ t)
	()


test
	u2 u2? = 1
	# Previously there was a bug where this converted u2? -> bool -> u2 -> u1 -> u1?
	u1 u1? = u2
	u1.to::json is u2: nat64: 1
u1 union(u2, string)
u2 union(bool, nat)
