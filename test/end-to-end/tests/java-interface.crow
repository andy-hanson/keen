###
Test implementing a Java interface.
This test does not call 'compare' directly, but depends on it getting generated so that 'sort' can call it.
###
import
	crow/col/mut-slice
	crow/io/print
	crow/unsafe
	java/lang/Object
	java/util/Arrays
	java/util/Comparator

main void() global, java
	my-arr element mut-slice =
		- 1, 2
		- 2, 0
		- 1, 1
	# Note that 'sort' is from 'java/lang/Arrays'; it's not the Crow sort function
	trusted sort my-arr.reinterpret-cast::(Object mut-slice), my-comparator
	for x in my-arr
		print "{x}"

-element alias
	(nat, nat)
-show string((x nat, y nat))
	"{x} {y}"

-my-comparator record() java, Comparator case
-equals bool(_ my-comparator, _ Object)
	throw unreachable
-compare int32(_ my-comparator, x Object, y Object) java
	match trusted x.reinterpret-cast::element <=> y.reinterpret-cast::element
	as less
		-1
	as equal
		0
	as greater
		1
