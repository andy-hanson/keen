import
	crow/io/print
# This tests 'isAllowedUnicodeIdentifierChar'
main void() global
	# Latin
	crow = "crow"
	print crow

	# Latin extended
	kráka = "kráka"
	print kráka

	# Greek and Coptic
	κοράκι = "κοράκι"
	print κοράκι

	# Cyrillic
	ворона = "ворона"
	print ворона

	# Hebrew
	עורב = "עורב"
	print עורב

	# Arabic
	غراب = "غراب"
	print غراب
	کلاغ = "کلاغ"
	print کلاغ
	کوا = "کوا"
	print کوا

	# Devanagari
	কাক = "কাক"
	print কাক
	कौआ = "कौआ"
	print कौआ
	कावळा = "कावळा"
	print कावळा

	# Bengali
	कऊआ = "कऊआ"
	print कऊआ

	# Gurmukhi
	ਕਾਂ = "ਕਾਂ"
	print ਕਾਂ

	# Gujarati
	કાગડો = "કાગડો"
	print કાગડો

	# Tamil
	காகம் = "காகம்"
	print காகம்

	# Telugu
	కాకి = "కాకి"
	print కాకి

	# Tibetan
	ཁྭ་ཏ་ནག་པོ། = "ཁྭ་ཏ་ནག་པོ།"
	print ཁྭ་ཏ་ནག་པོ།

	# Latin extended additional
	quạ = "quạ"
	print quạ

	# Hiragana
	からす = "からす"
	print からす

	# Katakana
	カラス = "カラス"
	print カラス

	# CJK Unified Ideographs
	乌鸦 = "乌鸦"
	print 乌鸦

	# Hangul
	까마귀 = "까마귀"
	print 까마귀
