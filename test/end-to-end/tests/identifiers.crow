import
	crow/io/print
# This tests 'isAllowedUnicodeIdentifierChar'
main void() global
	# Latin
	crow string = "crow"
	print crow

	# Latin extended
	kráka string = "kráka"
	print kráka

	# Greek and Coptic
	κοράκι string = "κοράκι"
	print κοράκι

	# Cyrillic
	ворона string = "ворона"
	print ворона

	# Hebrew
	עורב string = "עורב"
	print עורב

	# Arabic
	غراب string = "غراب"
	print غراب
	کلاغ string = "کلاغ"
	print کلاغ
	کوا string = "کوا"
	print کوا

	# Devanagari
	কাক string = "কাক"
	print কাক
	कौआ string = "कौआ"
	print कौआ
	कावळा string = "कावळा"
	print कावळा

	# Bengali
	कऊआ string = "कऊआ"
	print कऊआ

	# Gurmukhi
	ਕਾਂ string = "ਕਾਂ"
	print ਕਾਂ

	# Gujarati
	કાગડો string = "કાગડો"
	print કાગડો

	# Tamil
	காகம் string = "காகம்"
	print காகம்

	# Telugu
	కాకి string = "కాకి"
	print కాకి

	# Tibetan
	ཁྭ་ཏ་ནག་པོ། string = "ཁྭ་ཏ་ནག་པོ།"
	print ཁྭ་ཏ་ནག་པོ།

	# Latin extended additional
	quạ string = "quạ"
	print quạ

	# Hiragana
	からす string = "からす"
	print からす

	# Katakana
	カラス string = "カラス"
	print カラス

	# CJK Unified Ideographs
	乌鸦 string = "乌鸦"
	print 乌鸦

	# Hangul
	까마귀 string = "까마귀"
	print 까마귀
