main void()
	# type is data
	d d = 0,
	takes-data d

	# type is mut
	m m = 0,
	takes-data m

	# type is data and type arg is data
	dd d dt = (0,),
	takes-dt dd
	takes-dt-t-data dd
	takes-data dd

	# type is mut and type arg is mut
	mm m mt = (0,),
	takes-mt mm
	takes-mt-t-data mm
	takes-data mm

	# type is mutable but type arg is data
	dm d mt = (0,),
	takes-mt dm
	takes-mt-t-data dm
	takes-data dm

	# type is data but type arg is mut
	md m dt = (0,),
	takes-dt md
	takes-dt-t-data md
	takes-data md

	indirect d
	indirect m

d record
	value nat64
m record mut
	value mut nat64
dt[t] record
	inner t
mt[t] record mut
	value t

takes-dt[t] void(a t dt)
	takes-dt-t-data a

takes-mt[t] void(a t mt)
	takes-mt-t-data a

takes-dt-t-data[t] void(a t dt) t data
	takes-data a

takes-mt-t-data[t] void(a t mt) t data
	takes-data a

takes-data[t] void(_ t) t data
	()

takes-data[t] spec
	takes-data void(_ t)
indirect[t] void(_ t) t takes-data
	()
