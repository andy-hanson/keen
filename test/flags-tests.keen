test
	none.to::nat32 is 0
	0.to::f? is ()::f

	x.to::nat32 is 1
	1.to::f? is x

	y.to::nat32 is 0b10
	0b10.to::f? is y

	z.to::nat32 is 0b100
	0b100.to::f? is z

	xy.to::nat32 is 0b11
	0b11.to::f? is xy

	xz.to::nat32 is 0b101
	0b101.to::f? is xz

	yz.to::nat32 is 0b110
	0b110.to::f? is yz

	all.to::nat32 is 0b111
	0b111.to::f? is all

	0b1000.to::f? is ()

test
	x <=> x is equal
	x <=> y is less
	y <=> x is greater
	y <=> y is equal
	xy <=> y is greater
	xy <=> z is less

test
	none | none is none
	x | x is x
	xy | yz is all
	all | x is all

test
	none & none is none
	x & yz is none
	x & all is x
	xy & yz is y
	all & all is all

test
	assert x[x]
	assert xz[x]
	forbid xz[y]

test
	members::f[] is (x, y, z)

test
	none.to::symbol[] is ()
	x.to::symbol[] is ("x",)
	xy.to::symbol[] is ("x", "y")
	all.to::symbol[] is ("x", "y", "z")

test
	"x".to::f? is x
	"w".to::f? is ()

test
	none.to::json is ()::json[].to
	x.to::json is ("x",)
	xy.to::json is ("x", "y")

test
	~none is all
	~x is yz
	~y is xz
	~z is xy
	~xy is z
	~xz is y
	~yz is x
	~all is none

test
	none.to::symbol[] is ()
	x.to::symbol[] is ("x",)
	xy.to::symbol[] is ("x", "y")
	all.to::symbol[] is ("x", "y", "z")

-f flags(x, y, z)

-none f()
	()
-xy f()
	x | y
-xz f()
	x | z
-yz f()
	y | z
-all f()
	x | y | z
