test
	a nat? = ()
	b nat? = 1
	c nat? = 2

	(a else 2) is 2
	(b else 2) is 1
	(a else 2)::nat is 2
	(b else 2)::nat is 1

	(a or a) is ()
	(b or b) is 1
	(a or b) is 1
	(b or a) is 1
	(b or c) is 1
	(c or b) is 2

	(a or a)::nat? is ()
	(b or b)::nat? is 1
	(a or b)::nat? is 1
	(b or a)::nat? is 1
	(b or c)::nat? is 1
	(c or b)::nat? is 2

	try
		_ = a!
		should-throw
	catch e as error
		e.show is "Option was empty: 'a'"

test
	().foo is 42

-foo nat?(x nat?)
	# Here the expression is always a 'nat'. Make sure it implicitly converts to an option.
	x else 42
