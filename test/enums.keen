test
	x.to::symbol is "x"
	y.to::symbol is "y"
	"x"::symbol.to::e? is x
	"z"::symbol.to::e? is ()

	x.to::nat32 is 0
	y.to::nat32 is 1

	0.to::e? is x
	1.to::e? is y
	2.to::e? is ()

	x == x is true
	x == y is false

	x <=> x is equal
	x <=> y is less
	y <=> x is greater
	y <=> y is equal

	members::e[] is (x, y)

-e enum(x, y)
