import
	keen/io/file
	../../app/frontend/frontend
	../../app/frontend/lang
	../../app/frontend/show-model
	../../app/model/parse-diag
	../../app/model/uri
	../../app/server
	../../app/util/file-system

test-server server()
	do trusted
	settings:
		keen-lib: parse-uri "test:///keen/lib"
		builtin-java-paths: get-builtin-java-paths
		cwd: parse-uri "test:///"
		show-options: color: false

uri-and-content record(uri uri, keen string)
setup-test-server void(server server, main-uri uri, main-content string) global
	setup-test-server server,
		- main-uri, main-content
setup-test-server void(server server, files uri-and-content[]) global
	for file in files
		extension file.uri is ".keen"
		set-file server, file.uri, file.keen
	do with reader in file-reader this-executable.must-parse-file-path, false
	do until
	unknowns = flush-all-unknown-uris server
	for unknown in unknowns
		set-file server, unknown, load-file reader, unknown
	is-empty unknowns

-load-file read-file-result(reader file-reader, uri uri) global
	if uri.base-name == config-base-name
		not-found
	elif as-jar-and-class-uri uri
		try-read-file reader, uri
	else
		assert x = try-remove-start uri.to::string, "test:///keen/lib/" else error "Unexpected URI {uri}"
		try-read-file reader, (reader.path-to-keen.parent!.parent! / "lib" / x.to).to

is-with-description[t] void(a t, b t, desc string data()) t equal, t to-json
	a is b else error "{desc[]}: Left expression:\n{to-kid a}\nRight expression:\n{to-kid b}"
