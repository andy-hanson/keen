u union(nat, string)

# Refine an option to non-option
test
	a nat? = 1
	(if a then a + 1) is 2
	b nat? = ()
	(if b then b + 1) is ()

# Refine a union
test
	a u = 1
	(if nat32 a then a + 1) is 2
	(if string a then a.size) is 0

# Refine an optional union
test
	foo () is 0
	foo 1 is 1
	foo "a" is 0
-foo nat(a u?)
	if a and nat32 a
		a

# Refine a union, then another union
uu union(u, bool)
test
	a uu = 1
	(if u a and nat32 a then a + 1) is 2

# Refine a field access
test
	a r-nat-or-string = 1,
	(if nat32 a.x then a.x + 1) is 2
r-nat-or-string record(x nat-or-string)
nat-or-string union(nat, string)

# Works with prefix syntax
test
	a r-nat-or-string = 1,
	(if nat32 x a then (x a) + 1) is 2

# Refine a local, then refine a field access
test
	a u1 = r-nat-or-string "foo"
	(if r-nat-or-string a and string a.x then a.x) is "foo"
u1 union(bool, r-nat-or-string)

# Here we are testing that it works for accessing immutable fields of mutable records
r record(x nat?, y mut string) mut
# Refine an option property
test
	r r = 1, ""
	(if r.x then r.x + 1) is 2

# Allow 'force-data' record
r-force-data record(x mut nat?) force-data
test
	r r-force-data = 1,
	(if r.x then r.x + 1) is 2

# Refine a union property
r2 record(x u)
test
	r r2 = "foo",
	(if string r.x then r.x.size) is 3

	n nat = match r.x
	as nat
		r.x + 1
	as string
		r.x.size
	n is 3

# Refine a pure function
y nat?(a r2) = a.x.nat32 else 0
test
	r r2 = 1,
	(if r.y then r.y + 1) is 2

# Refine an optional union property
r3 record(x u?)
test
	r r3 = "foo",
	(if r.x and string r.x then r.x.size) is 3

# Refine optional union, then optional union property
u3 union(r3, string)
test
	r u3? = 1,
	(if r and r3 r and r.x and nat32 r.x then 2::nat) is 2

# Works with function taking a wider type
test
	a nat = 1
	(if a.as-nat then a.as-nat + 1) is 2
as-nat nat?(a nat-or-string)
	match a
	as nat then a
	as string then ()

# Works with 'or'
test
	x nat? = 7
	# Works when expecting bool
	assert not x or x + 1 == 8
	# Works when not expecting anything particular
	b = not x or x + 1 == 8
	b is true
