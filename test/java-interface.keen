import
	keen/unsafe
	java/lang/Object
	java/util/Arrays
	java/util/Comparator

test java
	my-arr element buffer = (1, 2), (2, 0), (1, 1)
	trusted sort my-arr, my-comparator
	my-arr.to::element[] is (1, 1), (1, 2), (2, 0)

-element alias
	(nat, nat)

-my-comparator record() element Comparator case
-equals bool(_ my-comparator, _ Object)
	throw unreachable
-compare int32(_ my-comparator, x element, y element)
	match trusted x.reinterpret-cast::element <=> y.reinterpret-cast::element
	as less then -1
	as equal then 0
	as greater then 1
