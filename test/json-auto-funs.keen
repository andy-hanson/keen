e enum(x, y)
test
	x::e.to::json is "x"
	"x"::json.to::e is x
	y::e.to::json is "y"
	"y"::json.to::e is y
	fails-to-deserialize "e", "z", {it.to::e}

f flags(x, y)
test
	()::f.to::json is empty-array
	empty-array::json.to::f is ()
	()::json.to::f is ()

	x::f.to::json is ("x",)
	"x"::json.to::f is x
	("x",)::json.to::f is x

	y::f.to::json is ("y",)
	"y"::json.to::f is y
	("y",)::json.to::f is y

	(x | y)::f.to::json is ("x", "y")
	("x", "y")::json.to::f is x | y

	fails-to-deserialize "f", empty-object, {it.to::f}
	fails-to-deserialize "f", "z", {it.to::f}

r record(x nat, y string)
test
	a r = x: 1, y: "foo"
	j json = a.to
	j is x: 1, y: "foo"
	j.to::r is a

	# Extra properties ignored
	(x: 1, y: "foo", z: 7)::json.to::r is a

u union(nat, string)
test
	a u = 1
	j = a.to::json
	j is nat64: 1
	j.to::u is a

	fails-to-deserialize "u", empty-object, {it.to::u}
	# Extra properties not allowed
	fails-to-deserialize "u", (nat64: 1, string: "foo"), {it.to::u}

-fails-to-deserialize[t] void(expected string, value json, f t mut(x json))
	try
		_ t = f[value]
		should-throw
	catch error as deserialize-error
		error is expected, value
