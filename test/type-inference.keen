test
	x nat32 = 0xffffffff
	y nat32 = 2
	z nat64 = x + y
	z is 0x100000001

test
	index nat32? = 1
	# Expected type of 'walues' is 't[]?' where 't' is 'string?' but may be narrower
	s string? = ?wubscript walues, index
	s is "b"
walues string[]() = "a", "b", "c"
wubscript[t] t(a t[], index nat32) = a[index]
