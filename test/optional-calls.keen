test
	calls symbol mut[] = ()
	one = of x symbol
		calls ~= x
		1
	optional-one = of::nat? x symbol then one[x]
	none = of::nat? x symbol
		calls ~= x
		()
	get-calls = of::symbol[] then move-to calls

	?add one["a"], optional-one["b"], one["c"] is 3
	get-calls[] is ("a", "b", "c")
	?add one["a"], none["b"], one["b"] is ()
	get-calls[] is ("a", "b")
	?add optional-one["a"], one["b"], optional-one["c"] is 3
	get-calls[] is ("a", "b", "c")

-add nat(a nat, b nat, c nat)
	a + b + c
