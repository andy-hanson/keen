# Large (> 8 element) byte arrays are compiled to constants differently.

test
	short is (0 .. 3).to
	long is (0 .. 9).to
	long2 is (120 .. 129).to

short nat8[]()
	0, 1, 2
long nat8[]()
	0, 1, 2, 3, 4, 5, 6, 7, 8
# When some bytes are >= 128, it must be base64 encoded
long2 nat8[]()
	120, 121, 122, 123, 124, 125, 126, 127, 128
