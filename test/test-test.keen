import
	../lib/test-util: is-impl, isnt-impl

test
	try
		is-impl 1::nat, 2
		should-throw
	catch e as expected-equal
		assert e.a == 1
		assert e.b == 2

test
	try
		isnt-impl 1::nat, 1
		should-throw
	catch e as expected-not-equal
		assert e.a == 1
		assert e.b == 1

test
	try
		1::nat is 2 else index-too-big 2, 0
		should-throw
	catch e as index-too-big
		assert e.actual == 2
		assert e.max-exclusive == 0

test
	try
		1::nat isnt 1 else index-too-big 2, 0
		should-throw
	catch e as index-too-big
		assert e.actual == 2
		assert e.max-exclusive == 0
