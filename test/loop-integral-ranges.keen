| Keen treats loops on integrals specially for performance (see array-op-low-expr)

test
	(for::int8[] x in 10::int8 .. 10 then x) is ()
	(for::int16[] x in 10::int16 .. 10 then x) is ()
	(for::int32[] x in 10::int32 .. 10 then x) is ()
	(for::int64[] x in 10::int64 .. 10 then x) is ()
	(for::nat8[] x in 10::nat8 .. 10 then x) is ()
	(for::nat16[] x in 10::nat16 .. 10 then x) is ()
	(for::nat32[] x in 10::nat32 .. 10 then x) is ()
	(for::nat64[] x in 10::nat64 .. 10 then x) is ()

test
	(for::int8[] x in -2::int8 .. 2 then x) is -2, -1, 0, 1
	(for::int16[] x in -2::int16 .. 2 then x) is -2, -1, 0, 1
	(for::int32[] x in -2::int32 .. 2 then x) is -2, -1, 0, 1
	(for::int64[] x in -2::int64 .. 2 then x) is -2, -1, 0, 1

test
	(for::nat8[] x in 2::nat8 .. 5 then x) is 2, 3, 4
	(for::nat16[] x in 2::nat16.. 5 then x) is 2, 3, 4
	(for::nat32[] x in 2::nat32.. 5 then x) is 2, 3, 4
	(for::nat64[] x in 2::nat64.. 5 then x) is 2, 3, 4

test
	(-2, -1, 0, 1)::int8[] is with out in build
		for x in -2::int8 .. 2
			out ~= x
	(-2, -1, 0, 1)::int16[] is with out in build
		for x in -2::int16 .. 2
			out ~= x
	(-2, -1, 0, 1)::int32[] is with out in build
		for x in -2::int32 .. 2
			out ~= x
	(-2, -1, 0, 1)::int64[] is with out in build
		for x in -2::int64 .. 2
			out ~= x

test
	(2, 3, 4)::nat8[] is with out in build
		for x in 2::nat8 .. 5
			out ~= x
	(2, 3, 4)::nat16[] is with out in build
		for x in 2::nat16 .. 5
			out ~= x
	(2, 3, 4)::nat32[] is with out in build
		for x in 2::nat32 .. 5
			out ~= x
	(2, 3, 4)::nat64[] is with out in build
		for x in 2::nat64 .. 5
			out ~= x
