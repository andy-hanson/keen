import
	../../model/parse-diag
	../../model/source-range
	../../util/string-walker

add-diag alias
	void mut(pos pos, diag parse-diag)
cb-comment alias
	void mut(pos pos)

indent-kind enum(tabs, spaces-2, spaces-4, ignore)

detect-indent-kind indent-kind(a string)
	ptr string-walker = a,
	loop
		begin = ptr pos
		match *ptr
		as "\0"
			break tabs
		as "\t"
			break tabs
		as " "
			while *ptr == " "
				ptr advance
			n = ptr.pos - begin
			break if n == 2
				spaces-2
			else
				spaces-4
		else
			ptr skip-until-newline
			if *ptr == "\n"
				ptr advance
			continue

skip-until-newline void(a string-walker)
	while a !is-at-end && *a != "\n"
		a advance

| Used to lex the tokens that appear between AST nodes for syntax highlighting.
lex-tokens-between-asts void(
	source string,
	range source-range,
	cb-comment void mut(x source-range),
	cb-keyword void mut(x source-range),
)
	ptr string-walker = source,
	ptr advance range.start.to
	end = range end
	while ptr.pos < end
		ptr skip-for-tokens end, cb-comment
		if ptr < end
			start = ptr pos
			while *ptr !ignore-char-for-tokens && ptr.pos < end
				ptr advance
			cb-keyword[start, ptr.pos]

| Does not skip newlines (unless within a comment), only spaces within a line
skip-spaces-and-comments void(ptr string-walker, cb-comment cb-comment, add-diag add-diag)
	loop
		start = ptr pos
		if *ptr is-whitespace-non-newline
			ptr advance
			continue
		elif *ptr == "\\"
			if ptr try-take-line-continuation cb-comment
				continue
			else
				break
		elif *ptr == "#"
			if ptr try-take-triple-hash-then-newline
				ptr skip-rest-of-block-comment add-diag
				cb-comment[start]
			else
				while ptr try-take-char " "
					()
				ptr skip-until-newline
				cb-comment[start]
			continue
		else
			break

-is-whitespace-non-newline bool(a char8)
	a == " " || a == "\t" || a == "\r"

skip-blank-lines-and-get-indent-delta int(ptr string-walker, indent-kind indent-kind, cur-indent nat cell, add-diag add-diag)
	throw todo
