string-walker record mut
	-chars char8[]
	-index mut nat
pos nat32(a string-walker)
	a.index to
new string-walker(a string)
	a.to, 0
is-at-end bool(a string-walker) trusted
	a.index == a.chars.size
* char8(a string-walker) trusted
	if a.index == a.chars.size
		"\0"
	else
		a.chars[a index]

advance void(a string-walker)
	forbid a is-at-end
	a.index +:= 1

advance void(a string-walker, n nat)
	new-index = a.index + n
	assert new-index <= a.chars.size
	a.index := new-index

try-take-char bool(a string-walker, x char8)
	if *a == x
		a advance
		true
