import
	./path-and-content: new, path-and-content

page-template path-and-content(path string, title string, content string)
	out-path: path
	content: """
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<title>Crow programming language: {title}</title>
	<link rel="icon" href="/crow.svg" type="image/x-icon">
	<link rel="stylesheet" href="//cdn.jsdelivr.net/npm/hack-font@3/build/web/hack-subset.css">
	<link rel="stylesheet" href="/style/index.css">
	<link rel="modulepreload" href="/worker.js">
	<script type="module" src="/index.js"></script>
</head>
<body>
	<header>
		<nav>
			<div id="crow">
				<a href="/">
					<img src="/crow.svg" alt="crow icon" />
				</a>
			</div>
			<ul class="grow">
				{path nav-links}
			</ul>
			<ul>
				<li>
					<a href="https://github.com/andy-hanson/crow/issues">
						bugs<crow-icon icon="external-link"></crow-icon>
					</a>
				</li>
				<li>
					<a href="https://github.com/andy-hanson/crow">
						source<crow-icon icon="external-link"></crow-icon>
					</a>
				</li>
			</ul>
		</nav>
	</header>
	{content}
</body>
</html>
"""

nav-links string(path string)
	current string = " class=\"current\""
	"""
	<li><a href="/download.html"{if path starts-with "download" then current}>download</a></li>
	<li><a href="/tutorial"{if path starts-with "tutorial" then current}>tutorial</a></li>
	<li><a href="/doc"{if path starts-with "doc" then current}>documentation</a></li>
	<li><a href="/play.html"{if path starts-with "play" then current}>play</a></li>
	"""

