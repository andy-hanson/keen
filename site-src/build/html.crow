html union(html-node, string)
== bool(a html, b html)
to json(a html)
html-node record
	tag symbol
	attributes string[symbol]
	children html[]
node html-node(tag symbol)
	tag, (), ()
node html-node(tag symbol, attributes string[symbol])
	tag, attributes, ()
node html-node(tag symbol, attributes string[symbol], children html[])
	tag, attributes, children
== bool(a html-node, b html-node)
to json(a html-node)

div html-node(attributes string[symbol], children html[])
	"div" node attributes, children
main html-node(attributes string[symbol], children html[])
	"main" node attributes, children
crow-runnable html-node(name string, text string)
	attributes string[symbol] = unless name is-empty then name: name
	"crow-runnable" node attributes, (text,)
p html-node(_ void, children html[])
	"p" node (), children
p html-node(text string)
	() p (text,)
br html-node()
	"br" node
bullets html-node(_ void, elements html[][])
	"ul" node (class: "bullets"), for element in elements
		"li" node (), element
strong html-node(text string)
	"strong", (), (text,)
em html-node(text string)
	"em", (), (text,)

render string(a html)
	with out in build
		out render a
render string(a html[])
	with out in build
		for x in a
			out render x
-render void(out string-builder, a html)
	match a
	as html-node
		out ~= "<"
		out ~~= a.tag to
		for name, value in a attributes
			out ~= " "
			out ~~= name to
			out ~= "="
			out ~= "\""
			out html-escape-attribute-value value
			out ~= "\""
		out ~= ">"
		if a.tag is-self-closing-tag
			assert a.children is-empty
		else
			for child in a children
				out render child
			out ~~= "</"
			out ~~= a.tag to
			out ~= ">"
	as string
		out html-escape-text-content a

-is-self-closing-tag bool(tag symbol)
	match tag
	as area
		true
	as base
		true
	as br
		true
	as col
		true
	as embed
		true
	as hr
		true
	as img
		true
	as input
		true
	as link
		true
	as meta
		true
	as param
		true
	as source
		true
	as track
		true
	as wbr
		true
	else
		false

test
	foo html = "▶"
	foo.render is "&#9654;"

-html-escape-text-content void(out string-builder, a string)
	for x in a
		if esc = x html-escape-character-in-text
			out ~~= esc
		elif x.to::nat32 > 0xff
			out ~~= "&#{x.to::nat32};"
		else
			out ~= x

-html-escape-character-in-text string?(a char32)
	match a
	as "&"
		"&amp;"
	as "<"
		"&lt;"
	as ">"
		"&gt;"
	as "\""
		"&quot;"
	as "'"
		"&#39;"
	else
		()

-html-escape-attribute-value void(out string-builder, a string)
	for x in a
		if esc = x html-escape-character-in-attribute-value
			out ~~= esc
		else
			out ~= x
-html-escape-character-in-attribute-value string?(a char32)
	match a
	as "\""
		"&quot;"
	as "\n"
		throw todo
	else
		()

interpolate html[](parts html[][])
	for* x in parts then x
interpolate-string html[](a string)
	- a
interpolate-value html[](a html-node)
	- a
interpolate-value html[](a string)
	- a
interpolate-value html[](a html[])
	a

code html-node(text string)
	"code" node (), (text,)
code html-node(text string, class_ string)
	"code" node (class: class_), (text,)
function html-node(text string)
	text code "function"
keyword html-node(text string)
	text code "keyword"
number html-node(text string)
	text code "number"
parameter html-node(text string)
	text code "parameter"
string html-node(text string)
	text code "string"
type html-node(text string)
	text code "type"
variable html-node(text string)
	text code "variable"

test
	asdf = "foo" variable
	asdf.render is "Sf"

link html-node(target string, attributes string[symbol], children html[])
	"a", (href: target) ~~ attributes, children
link html-node(target string, children html[])
	"a", (href: target), children
link html-node(target string)
	"/{target}" link (target,)

h1 html-node(text string)
	"h1", (), (text,)
h2 html-node(text string)
	"h2", (), (text,)
h3 html-node(text string)
	"h3", (), (text,)
h4 html-node(text string)
	"h4", (), (text,)

hr html-node()
	"hr", (), ()

section html-node(_ void, children html[])
	"section", (), children

aside html-node(title string, content html[])
	"aside" node (),
		- title h4
		- () div content
aside-danger html-node(title string, content html[])
	"aside" node (class: "danger"),
		- title h4
		- () div content
aside-small html-node(_ void, content html[])
	"aside" node (class: "small"), content
