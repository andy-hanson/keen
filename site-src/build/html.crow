import
	crow/string/unicode

html union(html-node, string)
== bool(a html, b html)
to json(a html)
html-node record
	tag symbol
	attributes string[symbol]
	children html[]
node html-node(tag symbol)
	tag, (), ()
node html-node(tag symbol, attributes string[symbol])
	tag, attributes, ()
node html-node(tag symbol, attributes string[symbol], children html[])
	tag, attributes, children
== bool(a html-node, b html-node)
to json(a html-node)

div html-node(children html[])
	div (), children
div html-node(attributes string[symbol], children html[])
	node "div", attributes, children
main html-node(attributes string[symbol], children html[])
	node "main", attributes, children
crow-runnable html-node(text string)
	node "crow-runnable", (), (text,)
crow-runnable html-node(name string, text string)
	node "crow-runnable", (name: name), (text,)
p html-node(children html[])
	node "p", (), children
br html-node()
	node "br"
bullets html-node(elements html[][])
	node "ul", (class: "bullets"), for element in elements
		node "li", (), element
strong html-node(text string)
	"strong", (), (text,)
em html-node(text string)
	"em", (), (text,)

render string(a html)
	with out in build
		render out, a
render string(a html[])
	with out in build
		for x in a
			render out, x
-render void(out char8 builder, a html)
	match a
	as html-node
		out ~= "<"
		out ~~= a.tag.to
		for name, value in attributes a
			out ~= " "
			out ~~= name.to
			out ~= "="
			out ~= "\""
			html-escape-attribute-value out, value
			out ~= "\""
		out ~= ">"
		if is-self-closing-tag tag a
			assert is-empty children a
		else
			for child in children a
				render out, child
			out ~~= "</"
			out ~~= a.tag.to
			out ~= ">"
	as string
		html-escape-text-content out, a

-is-self-closing-tag bool(tag symbol)
	match tag
	as area
		true
	as base
		true
	as br
		true
	as col
		true
	as embed
		true
	as hr
		true
	as img
		true
	as input
		true
	as link
		true
	as meta
		true
	as param
		true
	as source
		true
	as track
		true
	as wbr
		true
	else
		false

test
	foo html = "▶"
	foo.render is "&#9654;"

-html-escape-text-content void(out char8 builder, a string)
	for x in a.to::char32[]
		out ~~= if esc = html-escape-character-in-text x
			esc.to::char8[]
		elif x.to::nat32 > 0xff
			"&#{x.to::nat32};"
		else
			x.to::char8[]

-interpolate char8[](parts string[])
	join parts 'to

-html-escape-character-in-text string?(a char32)
	match a
	as "&"
		"&amp;"
	as "<"
		"&lt;"
	as ">"
		"&gt;"
	as "\""
		"&quot;"
	as "'"
		"&#39;"
	else
		()

-html-escape-attribute-value void(out char8 builder, a string)
	for x in a.to::char32[]
		out ~~= html-escape-character-in-attribute-value x else x.to
-html-escape-character-in-attribute-value char8[]?(a char32)
	match a
	as "\""
		"&quot;"
	as "\n"
		throw todo
	else
		()

interpolate html[](parts html[][])
	for* x in parts then x
interpolate-string html[](a string)
	- a
interpolate-value html[](a html-node)
	- a
interpolate-value html[](a string)
	- a
interpolate-value html[](a html[])
	a

code html-node(text string)
	node "code", (), (text,)
code html-node(text string, class_ string)
	node "code", (class: class_), (text,)
function html-node(text string)
	code text, "function"
keyword html-node(text string)
	code text, "keyword"
number html-node(text string)
	code text, "number"
parameter html-node(text string)
	code text, "parameter"
string html-node(text string)
	code text, "string"
type html-node(text string)
	code text, "type"
variable html-node(text string)
	code text, "variable"

link html-node(target string, attributes string[symbol], children html[])
	"a", (href: target) ~~ attributes, children
link html-node(target string, children html[])
	"a", (href: target), children
link html-node(target string)
	link "/{target}", (target,)

h1 html-node(text string)
	"h1", (), (text,)
h2 html-node(text string)
	"h2", (), (text,)
h3 html-node(text string)
	"h3", (), (text,)
h4 html-node(text string)
	"h4", (), (text,)

hr html-node()
	"hr", (), ()

section html-node(children html[])
	"section", (), children

aside html-node(title string, content html[])
	node "aside", (),
		- h4 title
		- div content
aside-danger html-node(title string, content html[])
	node "aside", (class: "danger"),
		- h4 title
		- div content
aside-small html-node(content html[])
	node "aside", (class: "small"), content
