import
	./html

page-template-options record
	nav html-node?
	main html[]
new page-template-options(main html[])
	(), main
page-template-html html-node(path string, title string, options page-template-options)
	"html" node (),
		- "head" node (),
			- "title" node (), "Crow programming language: {title}"
			- "link" node rel: "icon", href: "/crow.svg", type: "image/x-icon"
			- "link" node rel: "stylesheet", href: "//cdn.jsdelivr.net/npm/hack-font@3/build/web/hack-subset.css"
			- "link" node rel: "stylesheet", href: "/style/index.css"
			- "link" node rel: "modulepreload", href: "/worker.js"
			- "script" node type:"module", src: "/index.js"
		- "body" node (),
			- "header" node (),
				- "nav" node (),
					- (id: "crow") div
						- "/" link
							- "home" crow-icon
					- "ul" node (class: "grow"), path.nav-links-html
					- "ul" node (),
						- "li" node (),
							- "https://github.com/andy-hanson/crow/issues" link "bugs{"external-link" crow-icon}"
						- "li" node (),
							- "https://github.com/andy-hanson/crow" link "source{"external-link" crow-icon}"
						- "li" node (),
							- "theme-switcher" node
			# The side-nav-wrapper is needed for proper layout even without a side nav.
			# Without it, there is no margin between 'main' and the page bottom.
			- (id: "side-nav-wrapper") div
				-- if n ?= options nav
					- n
				- () main options.main

crow-icon html-node(icon string)
	"crow-icon" node icon: icon

page-template string(path string, title string, content string) # TODO: RM! ---------------------------------------------------------------------------------------
	quote
		<!DOCTYPE html>
		<html lang="en">
		<head>
			<meta charset="utf-8">
			<title>Crow programming language: {title}</title>
			<link rel="icon" href="/crow.svg" type="image/x-icon">
			<link rel="stylesheet" href="//cdn.jsdelivr.net/npm/hack-font@3/build/web/hack-subset.css">
			<link rel="stylesheet" href="/style/index.css">
			<link rel="modulepreload" href="/worker.js">
			<script type="module" src="/index.js"></script>
		</head>
		<body>
			<header>
				<nav>
					<div id="crow">
						<a href="/">
							<crow-icon name="home"></crow-icon>
						</a>
					</div>
					<ul class="grow">
						{path nav-links}
					</ul>
					<ul>
						<li>
							<a href="https://github.com/andy-hanson/crow/issues">
								bugs<crow-icon icon="external-link"></crow-icon>
							</a>
						</li>
						<li>
							<a href="https://github.com/andy-hanson/crow">
								source<crow-icon icon="external-link"></crow-icon>
							</a>
						</li>
					</ul>
				</nav>
			</header>
			{content}
		</body>
		</html>

-nav-links-html html[](path string)
	links nav-link[] =
		- "/download.html", "download", "download"
		- "/tutorial", "tutorial", "tutorial"
		- "/doc", "doc", "documentation"
		- "/play.html", "play", "play"
	for link in links
		"li" node (),
			- link.target link (if path starts-with link.prefix then class: "current"), (link.text,)

-nav-link record(target string, prefix string, text string)

nav-links string(path string) # TODO: RM -------------------------------------------------------------------------------------------
	current string = " class=\"current\""
	quote
		<li><a href="/download.html"{if path starts-with "download" then current}>download</a></li>
		<li><a href="/tutorial"{if path starts-with "tutorial" then current}>tutorial</a></li>
		<li><a href="/doc"{if path starts-with "doc" then current}>documentation</a></li>
		<li><a href="/play.html"{if path starts-with "play" then current}>play</a></li>
