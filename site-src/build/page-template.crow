import
	./html

page-template-options record
	nav html-node?
	main html[]
new page-template-options(main html[])
	(), main
page-template-html html-node(path string, title string, options page-template-options)
	node "html", (),
		- node "head", (),
			- node "title", (), "Crow programming language: {title}"
			- node "link", rel: "icon", href: "/crow.svg", type: "image/x-icon"
			- node "link", rel: "stylesheet", href: "//cdn.jsdelivr.net/npm/hack-font@3/build/web/hack-subset.css"
			- node "link", rel: "stylesheet", href: "/style/index.css"
			- node "link", rel: "modulepreload", href: "/worker.js"
			- node "script", type:"module", src: "/index.js"
		- node "body", (),
			- node "header", (),
				- node "nav", (),
					- div (id: "crow"),
						- link "/",
							- crow-icon "home"
					- node "ul", (class: "grow"), nav-links-html path
					- node "ul", (),
						- node "li", (),
							- link "https://github.com/andy-hanson/crow/issues", "bugs{crow-icon "external-link"}"
						- node "li", (),
							- link "https://github.com/andy-hanson/crow", "source{crow-icon "external-link"}"
						- node "li", (),
							- node "theme-switcher"
			# The side-nav-wrapper is needed for proper layout even without a side nav.
			# Without it, there is no margin between 'main' and the page bottom.
			- div (id: "side-nav-wrapper"),
				-- from-option nav options
				- main (), main options

crow-icon html-node(icon string)
	node "crow-icon", icon: icon

page-template string(path string, title string, content string) # TODO: RM! ---------------------------------------------------------------------------------------
	quote
		<!DOCTYPE html>
		<html lang="en">
		<head>
			<meta charset="utf-8">
			<title>Crow programming language: {title}</title>
			<link rel="icon" href="/crow.svg" type="image/x-icon">
			<link rel="stylesheet" href="//cdn.jsdelivr.net/npm/hack-font@3/build/web/hack-subset.css">
			<link rel="stylesheet" href="/style/index.css">
			<link rel="modulepreload" href="/worker.js">
			<script type="module" src="/index.js"></script>
		</head>
		<body>
			<header>
				<nav>
					<div id="crow">
						<a href="/">
							<crow-icon name="home"></crow-icon>
						</a>
					</div>
					<ul class="grow">
						{nav-links path}
					</ul>
					<ul>
						<li>
							<a href="https://github.com/andy-hanson/crow/issues">
								bugs<crow-icon icon="external-link"></crow-icon>
							</a>
						</li>
						<li>
							<a href="https://github.com/andy-hanson/crow">
								source<crow-icon icon="external-link"></crow-icon>
							</a>
						</li>
					</ul>
				</nav>
			</header>
			{content}
		</body>
		</html>

-nav-links-html html[](path string)
	links nav-link[] =
		- "/download.html", "download", "download"
		- "/tutorial", "tutorial", "tutorial"
		- "/doc", "doc", "documentation"
		- "/play.html", "play", "play"
	for link in links
		node "li", (),
			- link link.target, (if starts-with path, prefix link then class: "current"), (link.text,)

-nav-link record(target string, prefix string, text string)

nav-links string(path string) # TODO: RM -------------------------------------------------------------------------------------------
	current = " class=\"current\""
	quote
		<li><a href="/download.html"{if starts-with path, "download" then current}>download</a></li>
		<li><a href="/tutorial"{if starts-with path, "tutorial" then current}>tutorial</a></li>
		<li><a href="/doc"{if starts-with path, "doc" then current}>documentation</a></li>
		<li><a href="/play.html"{if starts-with path, "play" then current}>play</a></li>
