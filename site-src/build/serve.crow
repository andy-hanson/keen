#!/usr/bin/env crow
import
	crow/col/mut-slice
	crow/io/file
	com/sun/net/httpserver/SimpleFileServer
	com/sun/net/httpserver/SimpleFileServer$OutputLevel
	com/sun/net/httpserver/HttpServer
	java/lang/Thread
	java/net/InetSocketAddress
	java/nio/file/Path
	java/nio/file/Paths

main void() global, java
	trusted
	port int32 = 8080
	addr InetSocketAddress = port,
	path Path = get "/{current-directory}/site", () # ---------------------------------------------------------------------------------------
	server HttpServer = createFileServer addr, path, INFO
	start server
	finally stop server, 0
	log "Serving at localhost:{port}/"
	join currentThread # waits forever
