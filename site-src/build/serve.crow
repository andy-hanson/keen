#!/usr/bin/env crow
import
	crow/col/mut-slice
	crow/io/file
	com/sun/net/httpserver/SimpleFileServer
	com/sun/net/httpserver/SimpleFileServer$OutputLevel
	com/sun/net/httpserver/HttpServer
	java/lang/Thread
	java/net/InetSocketAddress
	java/nio/file/Path
	java/nio/file/Paths

main void() summon, java
	trusted
	port int32 = 8080
	addr InetSocketAddress = port,
	path Path = "/{current-directory}/site" get () # ---------------------------------------------------------------------------------------
	server HttpServer = addr createFileServer path, INFO
	server start
	finally server stop 0
	info log "Serving at localhost:{port}/"
	currentThread join # waits forever
