import
	crow/io/file
	crow/io/path
	./pages

main void() summon
	for content in pages ~~ to-copy
		content ensure-up-to-date

-ensure-up-to-date void(a path-and-content) summon
	full-out-path = "site" child-path a.out-path
	unless full-out-path is-up-to-date a.content
		full-out-path.parent-path ensure-directory-recursive
		info log "write to {full-out-path}"
		full-out-path write-file a.content

-is-up-to-date bool(path string, content string) summon
	path.read-file-or-empty == content

-ensure-directory-recursive void(path string) summon
	unless path == "" or path path-exists
		path.parent-path ensure-directory-recursive
		path ensure-directory

-to-copy path-and-content[]() summon
	plain-files string[] =
		- "crow.svg"
		- "tutorial/example.json"
		-- "font" in-site-src
		-- "style" in-site-src
	info log "LE PLAIN FILES: {plain-files.to-json}"
	bin-files string[] = "bin/crow.tar.xz", "bin/crow-demo.tar.xz", "bin/crow.vsix"
	-- for x in plain-files
		out-path: x
		content: "site-src/{x}" read-file
	-- for x in bin-files
		out-path: x
		content: x read-file

-in-site-src string[](dir string) summon
	for name in "site-src/{dir}" names-in-dir
		"{dir}/{name}"
