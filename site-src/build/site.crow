import
	crow/io/file
	crow/io/path
	../crow.svg as crow-svg nat8[]
	../../bin/crow.tar.xz as crow-tar-xz nat8[]
	../../bin/crow-demo.tar.xz as crow-demo nat8[]
	../../bin/crow.vsix as crow-vsix nat8[]
	../font/Alkatra.ttf as alkatra nat8[]
	../font/Murecho-ExtraBold.woff2 as murecho-bold nat8[]
	../font/Murecho-Regular.woff2 as murecho-regular nat8[]
	../style/colors.css as colors nat8[]
	../style/index.css as style-index nat8[]
	./pages

main void() summon
	for content in pages ~~ to-copy
		content ensure-up-to-date

-ensure-up-to-date void(a path-and-content) summon
	full-out-path = "site" child-path a.out-path
	unless full-out-path is-up-to-date a.content
		full-out-path.parent-path ensure-directory-recursive
		info log "write to {full-out-path}"
		full-out-path write-file a.content

-is-up-to-date bool(path string, content nat8[]) summon
	try
		path.read-file::nat8[] == content
	catch as path-not-found
		false

-ensure-directory-recursive void(path string) summon
	unless path == "" or path path-exists
		path.parent-path ensure-directory-recursive
		path ensure-directory

-to-copy path-and-content[]()
	- "bin/crow.tar.xz", crow-tar-xz
	- "bin/crow-demo.tar.xz", crow-demo
	- "bin/crow.vsix", crow-vsix
	- "crow.svg", crow-svg
	- "font/Alkatra.ttf", alkatra
	- "font/Murecho-ExtraBold.woff2", murecho-bold
	- "font/Murecho-Regular.woff2", murecho-regular
	- "style/colors.css", colors
	- "style/index.css", style-index
