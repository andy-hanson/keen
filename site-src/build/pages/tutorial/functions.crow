use-prefix
import
	../../html

tutorial-functions html[]()
	- section
		- h2 "Identifiers"
		- p quote
			An identifier is the name of a function, variable, type, record field, etc.
			{br}
			An identifier may contain letters, numbers, {variable "_"} and {variable "-"},
			but it can't begin with a number, or begin or end with a {variable "-"}.
			{br}
			Examples of valid identifiers: {variable "a"}, {variable "is-empty"}, {variable "float32"}, {variable "BIG_WORDS"},
			{variable "עורב"}, {variable "까마귀"}.
			{br}
			The standard library prefers {variable "kebab-case"}.
	- section
		- h2 "Function call syntax"
		- p quote
			In Crow, a function name always comes after its first argument (if any).
			{br}
			The first column below shows how to call a function {function "f"} in Crow.
			{br}
			The other columns show an equivalent in other languages.
		- syntax-translate
			- "f()"
			- "f(a)"
			- "f(a, b)"
			- "f(a, b, c)"
		- p quote
			You can edit any cell above to experiment.
			This does not use a full parser; it only supports identifiers and calls.
		- p quote
			{code "f"} in Crow is the equivalent of either {code "f"} or {code "f()"} in C.
			It accesses a variable if one is in scope; otherwise, it is a function call.
		- p quote
			You can write {a-dot-f} to avoid needing to parenthesize {a-f-parenthesized}.
			This only works for a function with one argument.
		- syntax-translate
			- "abs(sin(a))"
			- "in(id(a), allowed(b))"
		- aside "Just functions",
			- p quote
				It's worth repeating that {a-dot-f} is just a syntactical convenience for calling a function.
				{br}
				It's not a "property access" syntax.
				There's no semantic difference between it and {a-f-parenthesized}.
		- p quote
			Normally (without a {dot}), function names bind loosely.
			{br}
			When you see a function name, everything to the left of it is the first argument.
		- syntax-translate
			- "then(then(a, b), c)"
			- "in(a, allowed(b, purpose))"
			- "draw(triangle(a, b, c))"
		- p quote
			If the function name is prefixed with {keyword "!"}, it returns the opposite boolean result.
		- syntax-translate
			- "not(in(x, xs))"
	- section
		- h2 "Function definition syntax"
		- p "Now we're ready to define a function and call it:"
		- crow-runnable quote
			main void()
				info log hello-world

			hello-world string()
				"Hello, world!"
		- p quote
			{variable "info"}{sp}{function "log"}{sp}{function "hello-world"} calls the function {function "log"} with 2 arguments
			{function "info"} and {function "hello-world"}, which are 0-argument function calls.
		- p quote
			{function "hello-world"}{sp}{type "string"}{code "()"} is the function {em "signature"}.
			It takes no arguments and returns a {type "string"}.
			The function {em "body"} always goes beneath the signature and indented.

		- h3 "Parameters"
		- p "Here's a modified version that takes a single parameter."
		- crow-runnable quote
			main void()
				info log 3.hello-world

			hello-world string(times nat)
				"Hello, world! " repeat times
		- aside-small quote
			We wrote {number "3"}{dot}{function "hello-world"} to avoid needing to parenthesize
			{keyword "("}{number "3"}{sp}{function "hello-world"}{keyword ")"}.
		- p quote
			This defines a function {function "hello-world"} that takes a {type "nat"} (natural number)
			and returns a {type "string"}.
			{br}
			The argument {number "3"} becomes the value of the parameter
			{parameter "times"}, causing the string to repeat 3 times.
		- aside "Type placement",
			- p "Types always come after the name of the entity with that type."
			- bullets
				- quote
					{function "hello-world"}{sp}{type "string"} defines a function {function "hello-world"}
					with a return type of {type "string"}.
				- "{parameter "times"}{sp}{type "nat"} defines a parameter {parameter "times"} with a type of {type "nat"}."
		- p quote
			The below takes 2 parameters {parameter "name"} and {parameter "times"}
			and passes arguments {string "\"crow\""} and {number "3"}, respectively.
		- crow-runnable quote
			main void()
				info log ("crow" hello 3)

			hello string(name string, times nat)
				"Hello, \{name}! " repeat times
		- aside-small quote
			{string "\"Hello, \{name}! \""} is string interpolation.
			This will be explained in {link "tutorial/types"}.

-a-dot-f html[]()
	"{variable "a"}{keyword "."}{function "f"}"

-dot html-node()
	keyword "."

-a-f-parenthesized html[]()
	"{keyword "("}{variable "a"}{sp}{function "f"}{keyword ")"}"

-sp html-node()
	code " "

-syntax-translate html-node(examples string[])
	node "syntax-translate", (), for x in examples
		node "syntax-translate-row", (), (x,)
