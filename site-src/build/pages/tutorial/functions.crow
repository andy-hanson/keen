import
	../../html

tutorial-functions html[]()
	- () section
		- "Identifiers" h2
		- () p quote
			An identifier is the name of a function, variable, type, record field, etc.
			{br}
			An identifier may contain letters, numbers, {"_" variable} and {"-" variable},
			but it can't begin with a number, or begin or end with a {"-" variable}.
			{br}
			Examples of valid identifiers: {"a" variable}, {"is-empty" variable}, {"float32" variable}, {"BIG_WORDS" variable},
			{"עורב" variable}, {"까마귀" variable}.
			{br}
			The standard library prefers {"kebab-case" variable}.
	- () section
		- "Function call syntax" h2
		- () p quote
			In Crow, a function name always comes after its first argument (if any).
			{br}
			The first column below shows how to call a function {"f" function} in Crow.
			{br}
			The other columns show an equivalent in other languages.
		- () syntax-translate
			- "f()"
			- "f(a)"
			- "f(a, b)"
			- "f(a, b, c)"
		- () p quote
			You can edit any cell above to experiment.
			This does not use a full parser; it only supports identifiers and calls.
		- () p quote
			{"f" code} in Crow is the equivalent of either {"f" code} or {"f()" code} in C.
			It accesses a variable if one is in scope; otherwise, it is a function call.
		- () p quote
			You can write {a-dot-f} to avoid needing to parenthesize {a-f-parenthesized}.
			This only works for a function with one argument.
		- () syntax-translate
			- "abs(sin(a))"
			- "in(id(a), allowed(b))"
		- "Just functions" aside
			- () p quote
				It's worth repeating that {a-dot-f} is just a syntactical convenience for calling a function.
				{br}
				It's not a "property access" syntax.
				There's no semantic difference between it and {a-f-parenthesized}.
		- () p quote
			Normally (without a {dot}), function names bind loosely.
			{br}
			When you see a function name, everything to the left of it is the first argument.
		- () syntax-translate
			- "then(then(a, b), c)"
			- "in(a, allowed(b, purpose))"
			- "draw(triangle(a, b, c))"
		- () p quote
			If the function name is prefixed with {"!" keyword}, it returns the opposite boolean result.
		- () syntax-translate
			- "not(in(x, xs))"
	- () section
		- "Function definition syntax" h2
		- () p "Now we're ready to define a function and call it:"
		- () crow-runnable quote
			main void()
				info log hello-world

			hello-world string()
				"Hello, world!"
		- () p quote
			{"info" variable}{sp}{"log" function}{sp}{"hello-world" function} calls the function {"log" function} with 2 arguments
			{"info" function} and {"hello-world" function}, which are 0-argument function calls.
		- () p quote
			{"hello-world" function}{sp}{"string" type}{"()" code} is the function {"signature" em}.
			It takes no arguments and returns a {"string" type}.
			The function {"body" em} always goes beneath the signature and indented.

		- "Parameters" h3
		- () p "Here's a modified version that takes a single parameter."
		- () crow-runnable quote
			main void()
				info log 3.hello-world

			hello-world string(times nat)
				"Hello, world! " repeat times
		- () aside-small quote
			We wrote {"3" number}{dot}{"hello-world" function} to avoid needing to parenthesize
			{"(" keyword}{"3" number}{sp}{"hello-world" function}{")" keyword}.
		- () p quote
			This defines a function {"hello-world" function} that takes a {"nat" type} (natural number)
			and returns a {"string" type}.
			{br}
			The argument {"3" number} becomes the value of the parameter
			{"times" parameter}, causing the string to repeat 3 times.
		- "Type placement" aside
			- () p "Types always come after the name of the entity with that type."
			- () bullets
				- quote
					{"hello-world" function}{sp}{"string" type} defines a function {"hello-world" function}
					with a return type of {"string" type}.
				- "{"times" parameter}{sp}{"nat" type} defines a parameter {"times" parameter} with a type of {"nat" type}."
		- () p quote
			The below takes 2 parameters {"name" parameter} and {"times" parameter}
			and passes arguments {"\"crow\"" string} and {"3" number}, respectively.
		- () crow-runnable quote
			main void()
				info log ("crow" hello 3)

			hello string(name string, times nat)
				"Hello, \{name}! " repeat times
		- () aside-small quote
			{"\"Hello, \{name}! \"" string} is string interpolation.
			This will be explained in {"tutorial/types" link}.

-a-dot-f html[]()
	"{"a" variable}{"." keyword}{"f" function}"

-dot html-node()
	"." keyword

-a-f-parenthesized html[]()
	"{"(" keyword}{"a" variable}{sp}{"f" function}{")" keyword}"

-sp html-node()
	" " code

-syntax-translate html-node(_ void, examples string[])
	"syntax-translate" node (), for x in examples
		"syntax-translate-row" node (), (x,)
