import
	../html
	../page-template

index html()
	page-template-html "index", "Crow programming language",
		main: index-main
-index-main html[]()
	- crow-runnable quote
		main void()
			for x nat in 1 .. 21
				m3 = is-multiple-of x, 3
				m5 = is-multiple-of x, 5
				log if m3 and m5
					"FizzBuzz"
				elif m3
					"Fizz"
				elif m5
					"Buzz"
				else
					"\{x}"
	- p quote
		{strong "Crow"} is an upcoming general-purpose, high-level programming language.
		{br}
		It's currently in alpha state. There will be breaking changes.
	- p "Some interesting features:"
	- bullets
		- "Crow programs can be {strong "run directly"} or {strong "build to a standalone executable"}."
		- "Crow code can {strong "directly call C"} functions. (But typically code is higher-level and safe.)"
		- quote
			Crow has {strong "IDE support"}.
			{br}
			The IDE uses the same compiler as on the command line, giving it complete information.
		- quote
			Syntax is {strong "expression-based"} and {strong "uses indentation"}.
			Function bodies are expressions with no {keyword "return"} needed.
			{br}
			Even {keyword "if"} and {keyword "for"} are expressions.
		- quote
			Code is {strong "flat"}. Declarations are not nested.
			{br}
			(For example, a function doesn't "belong" to a type and so doesn't go inside of it.)
			{br}
			A 100 character per line limit is realistic.
		- quote
			All code goes in {strong "modules"}.
			There are no global declarations, and what you don't import can't hurt you.
		- quote
			Crow is {strong "strongly typed"} with no subtyping, implicit conversion,
			or {keyword "null"} values.
			{br}
			Overload resolution is unambiguous; there are no "better" matches.
		- quote
			Expressions are type-checked with an {strong "expected type"}.
			{br}
			The same syntax {number "1, 2"}
			could be a list, tuple, vector, etc., inferred by where it is used.
			{br}
			This saves you from having to write something like {code "new List<int>(1, 2)"}.
		- "Data is {strong "garbage collected"}. Don't worry about what's by-reference or by-value."
		- quote
			{strong "Mutability is controlled."}
			Types track what is safe to share between parallel tasks.
			{br}
			It's also easy to use mutable data and ensure that tasks using it wait their turn.
			{br}
			Data structures are immutable by default (with efficient immutable updates).
		- quote
			{strong "I/O is controlled."}
			Functions are pure by default and can't do I/O except through parameters.
		- quote
			{strong "Templates"} are statically checked to work for all possible types.
			{br}
			{strong "Specs"} allow you to call functions provided by the caller's context.
	-- "To get started, read the {tutorial-link}."

-tutorial-link html-node()
	link "/tutorial", ("tutorial",)
