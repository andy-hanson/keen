import
	../html
	../page-template

index html()
	"index" page-template-html "Crow programming language",
		main: index-main
-index-main html[]()
	- () crow-runnable quote
		main void()
			for x nat in 1 .. 21
				m3 = x is-multiple-of 3
				m5 = x is-multiple-of 5
				info log if m3 and m5
					"FizzBuzz"
				elif m3
					"Fizz"
				elif m5
					"Buzz"
				else
					"\{x}"
	- () p quote
		{"Crow" strong} is an upcoming general-purpose, high-level programming language.
		{br}
		It's currently in alpha state. There will be breaking changes.
	- "Some interesting features:" p
	- () bullets
		- "Crow programs can be {"run directly" strong} or {"build to a standalone executable" strong}."
		- "Crow code can {"directly call C" strong} functions. (But typically code is higher-level and safe.)"
		- quote
			Crow has {"IDE support" strong}.
			{br}
			The IDE uses the same compiler as on the command line, giving it complete information.
		- quote
			Syntax is {"expression-based" strong} and {"uses indentation" strong}.
			Function bodies are expressions with no {"return" keyword} needed.
			{br}
			Even {"if" keyword} and {"for" keyword} are expressions.
		- quote
			Code is {"flat" strong}. Declarations are not nested.
			{br}
			(For example, a function doesn't "belong" to a type and so doesn't go inside of it.)
			{br}
			A 100 character per line limit is realistic.
		- quote
			All code goes in {"modules" strong}.
			There are no global declarations, and what you don't import can't hurt you.
		- quote
			Crow is {"strongly typed" strong} with no subtyping, implicit conversion,
			or {"null" keyword} values.
			{br}
			Overload resolution is unambiguous; there are no "better" matches.
		- quote
			Expressions are type-checked with an {"expected type" strong}.
			{br}
			The same syntax {"1, 2" code "number"}
			could be a list, tuple, vector, etc., inferred by where it is used.
			{br}
			This saves you from having to write something like {"new List<int>(1, 2)" code}.
		- "Data is {"garbage collected" strong}. Don't worry about what's by-reference or by-value."
		- quote
			{"Mutability is controlled." strong}
			Types track what is safe to share between parallel tasks.
			{br}
			It's also easy to use mutable data and ensure that tasks using it wait their turn.
			{br}
			Data structures are immutable by default (with efficient immutable updates).
		- quote
			{"I/O is controlled." strong}
			Functions are pure by default and can't do I/O except through parameters.
		- quote
			{"Templates" strong} are statically checked to work for all possible types.
			{br}
			{"Specs" strong} allow you to call functions provided by the caller's context.
	-- "To get started, read the {tutorial-link}."

-tutorial-link html-node()
	"/tutorial" link ("tutorial",)
