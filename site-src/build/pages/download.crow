import
	crow/io/path
	../html
	../page-template

download html()
	page-template-html "download.html", "download",
		main: download-main

-download-main html[]()
	- h1 "Download"
	- download-link "./bin/crow.tar.xz"

	- h4 "Global install (recommended)"
	- p "First you must install a Java runtime on your system."
	- code-block quote
		cd ~/Downloads
		sudo tar -xJf crow.tar.xz -C /usr/local/bin bin --strip-components 1
		sudo mkdir /usr/local/include/crow
		sudo tar -xJf crow.tar.xz -C /usr/local/include/crow include --strip-components 1
	- p
		- "To uninstall: "
		- code "sudo rm -r /usr/local/bin/crow /usr/local/include/crow"

	- h4 "Local install"
	- code-block quote
		tar --extract --xz --file crow-linux-64.tar.xz
		export PATH="$PATH:~/Downloads/crow"
	- p
		- "To uninstall: "
		- code "rm -r ~/Downloads/crow"

	- h3 "Test it out"
	- download-link "./bin/crow-demo.tar.xz"
	- code-block quote
		cd ~/Downloads
		tar -xJf crow-demo.tar.xz
		crow crow-demo/hello.crow

	- h3 "VSCode extension"
	- p "Includes syntax coloring, hover, go-to-definition, find-references, etc."
	- download-link "./bin/crow.vsix"
	- code-block "code --install-extension crow.vsix"

-code-block html(content string)
	div (class: "code-block"), interleave br, map (split content, "\n"), it.to

-interleave[t] t[](joiner t, values t[])
	do unless is-empty values
	do with out in build values.size * 2 - 1
	for index, value in with-index values
		unless index == 0
			out ~= joiner
		out ~= value

-download-link html(target string)
	link target, (class: "download"),
		- crow-icon "download"
		- node "code", (), (target.base-name,)
