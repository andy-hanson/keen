import
	crow/io/path
	crow/string/util
	../html
	../page-template

download html()
	"download.html" page-template-html "download",
		main: download-main

-download-main html[]()
	- "Download" h1
	- "./bin/crow.tar.xz" download-link
	
	- "Global install (recommended)" h4
	- () p "First you must install a Java runtime on your system."
	- () code-block quote
		cd ~/Downloads
		sudo tar -xJf crow.tar.xz -C /usr/local/bin bin --strip-components 1
		sudo mkdir /usr/local/include/crow
		sudo tar -xJf crow.tar.xz -C /usr/local/include/crow include --strip-components 1
	- () p
		- "To uninstall: "
		- "sudo rm -r /usr/local/bin/crow /usr/local/include/crow" code
	
	- "Local install" h4
	- () code-block quote
		tar --extract --xz --file crow-linux-64.tar.xz
		export PATH="$PATH:~/Downloads/crow"
	- () p
		- "To uninstall: "
		- "rm -r ~/Downloads/crow" code
	
	- "Test it out" h3
	- "./bin/crow-demo.tar.xz" download-link
	- () code-block quote
		cd ~/Downloads
		tar -xJf crow-demo.tar.xz
		crow crow-demo/hello.crow

	- "VSCode extension" h3
	- () p "Includes syntax coloring, hover, go-to-definition, find-references, etc."
	- "./bin/crow.vsix" download-link
	- () code-block "code --install-extension crow.vsix"

-code-block html(_ void, content string)
	(class: "code-block") div
		br interleave do content.lines map it.identity

-interleave[t] t[](joiner t, values t[])
	with out in build
		for index, value in values with-index
			unless index == 0
				out ~= joiner
			out ~= value

-download-link html(target string)
	target link (class: "download"),
		- "download" crow-icon
		- "code" node (), (target.base-name,)
