import
	./page-template
	./html
	./pages/download
	./pages/index
	./pages/tutorial/index
	./pages/tutorial/functions

path-and-content record
	# relative to 'site'
	out-path string
	content nat8[]

-template path-and-content(path string, title string, options page-template-options)
	out-path: path
	content: (page-template-html path, title, options).render.to

pages path-and-content[]()
	- "index.html", index.render.to
	- "download.html", download.render.to
	#- "play.html" template "play", play
	-- tutorial-pages

tutorial-pages path-and-content[]()
	tutorials = tutorials
	for index, tutorial in with-index tutorials
		next tutorial? = unless index + 1 == tutorials.size
			tutorials[index + 1]
		tutorial-template "tutorial", tutorial, tutorials, tutorial.content, next

-tutorials tutorial[]()
	index symbol = if 1::nat < 2 then "index" else "" # TODO: this silly thing makes this not a constant array which causes bugs in translate-to-java
	- index, "Running crow programs", tutorial-index
	- "functions", "Functions", tutorial-functions
	###
	- "local-variables", "Local variables", local-variables
	- "conditionals", "Conditional expressions", conditionals
	- "loops", "Loop expressions", loops
	- "types", "Basic types", types
	- "type-inference", "Type inference", type-inference
	- "special-call-syntax", "Special call syntax", special-call-syntax
	- "options", "Option types", options
	- "records", "Record types", records
	- "unions", "Union types", unions
	- "variants", "Variant and Interface types", variants
	- "purity", "Purity", purity
	- "collections", "Collections", collections
	- "lambdas", "Lambdas", lambdas
	- "for-and-with", "\"For\" and \"with\" expressions", for-and-with
	- "exceptions", "Exceptions", exceptions
	- "fibers", "Fibers", fibers
	- "io", "I/O", io
	- "modules", "Modules", modules
	- "templates", "Templates", templates
	- "specs", "Specs", specs
	- "auto-functions", "Auto functions", auto-functions
	- "enums", "Enums and flags", enums
	- "low-level", "Low-level code", low-level
	- "js", "Compiling to JavaScript", js
	- "config", "Config files", config
	- "doc", "Doc comments", doc
	- "test", "Tests", test_
	- "misc", "Miscellaneous", misc
	###
-tutorial record(key symbol, title string, content html[])

-path string(tutorial-dir string, a tutorial)
	"{tutorial-dir}/{key a}.html"

-tutorial-nav html-node(tutorial-dir string, cur-path string, tutorial-metas tutorial[])
	node "nav", (),
		- node "ul", (),
			for x in tutorial-metas
				path = path tutorial-dir, x
				node "li", (),
					- link "/{path}", (if path == cur-path then class: "current"), "{title x}"

-tutorial-template path-and-content
	tutorial-dir string
	meta tutorial
	tutorial-metas tutorial[]
	content html[]
	next tutorial?
do
	page-path = path tutorial-dir, meta
	template page-path, meta.title,
		nav: tutorial-nav tutorial-dir, page-path, tutorial-metas
		main:
			- h1 title meta
			-- content
			- if next
				link "/{path tutorial-dir, next}", (id: "next"), "next: {title next}"
