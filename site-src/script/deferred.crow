import
	crow/js
	crow/parallel

# TODO: this should probably be in the standard library. Maybe observable.crow ---------------------------------------------------------------------------------------------
deferred[t] record
	-promise t future
	-resolve js-any

new[t] t deferred() js extern
	trusted
	resolve mut js-any = null
	f void mut(resolve js-any) = of resolve_
		resolve := resolve_
	promise = "Promise".js-global call-new f.to
	promise: promise assume-type
	resolve: resolve

| This will hang forever if 'resolve' is never called!
await[t] t(a t deferred) unsafe, js extern
	a.promise await 

resolve[t] void(a t deferred, value t) unsafe, js extern
	_ = a.resolve call value.as-js
