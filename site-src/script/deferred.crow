import
	crow/js

# TODO: this should probably be in the standard library ---------------------------------------------------------------------------------------------
deferred[t] record
	-promise js-any
	-resolve js-any

new[t] t deferred() js extern
	trusted
	resolve mut js-any = ()
	f void mut(resolve js-any) = of resolve_
		resolve := resolve_
	promise = "Promise".js-global call-new f.as-js
	promise: promise
	resolve: resolve

| This will hang forever if 'resolve' is never called!
await[t] t(a t deferred) unsafe, js extern
	a.promise.await cast

resolve[t] void(a t deferred, value t) unsafe, js extern
	_ = a.resolve call value.as-js
