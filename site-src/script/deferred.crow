use-prefix
import
	crow/js
	crow/parallel

# TODO: this should probably be in the standard library. Maybe observable.crow ---------------------------------------------------------------------------------------------
deferred[t] record
	-promise t future
	-resolve js-any

new[t] t deferred() js
	trusted
	resolve mut js-any = null
	f void mut(resolve js-any) = of resolve_
		resolve := resolve_
	promise = call-new "Promise".js-global, f.to
	promise: assume-type promise
	resolve: resolve

| This will hang forever if 'resolve' is never called!
await[t] t(a t deferred) unsafe, js
	await promise a

resolve[t] void(a t deferred, value t) unsafe, js
	_ = call a.resolve, value.as-js
