import
	crow/js
	crow/js/dom
	crow/js/util
	../style/theme-switcher.css as theme-switcher-css string
	./icon

define-theme-switcher-element void() summon, js extern
	"theme-switcher" define-custom-element (style: theme-switcher-css), of x
		x.shadow-root set-icon get-theme

-set-icon void(shadow-root node, theme theme) summon, js extern
	res = theme icon
	on-click void mut(_ js-any) = of _
		theme.opposite set-theme
		shadow-root set-icon theme.opposite
	trusted
		res["onclick"] := on-click to
	shadow-root.children := res,

-theme enum(dark, light)
-== bool(a theme, b theme)
-to theme?(a symbol)
-to theme?(a string)
	a.to::symbol to
-to string(a theme)
	a.to::symbol to
-to symbol(a theme)
-opposite theme(a theme)
	match a
	as dark
		light
	as light
		dark

-icon node(a theme) js extern
	match a
	as dark
		moon-icon
	as light
		sun-icon

-get-theme theme() summon, js extern
	from-local theme? = local-storage["theme"] ?to
	sys = system-theme
	if from-local == sys
		local-storage -= "theme"
	res = from-local else system-theme
	res update-root-for-theme
	res

-set-theme void(a theme) summon, js extern
	if a == system-theme
		local-storage -= "theme"
	else
		local-storage["theme"] := a to
	a update-root-for-theme

-update-root-for-theme void(a theme) summon, js extern
	trusted
	root = document["documentElement"]
	match a
	as dark
		root.classes := "dark-mode",
	as light
		root.classes := "light-mode",

-local-storage record
-subscript string?(_ local-storage, name symbol) summon, js extern
	trusted
	res = "localStorage".js-global call-property "getItem", name.to
	unless res == null then res to

-set-subscript void(_ local-storage, name symbol, value string) summon, js extern
	trusted
	_ = "localStorage".js-global call-property "setItem", name.to, value.to

-= void(_ local-storage, name symbol) summon, js extern
	trusted
	_ = "localStorage".js-global call-property "removeItem", name.to

-system-theme theme() summon, js extern
	trusted if ("matchMedia".js-global call "(prefers-color-scheme: dark)")["matches"] to
		dark
	else
		light

###
-apply-theme void(a theme) summon, js extern
	trusted
	sheets js-any[] = document["styleSheets"] to
	for sheet in sheets
		rules js-any[] = sheet["cssRules"] to
		for rule in rules
			rule["media"]
###

###
// Apply the chosen color scheme by traversing stylesheet rules, and applying a medium.
function applyPreferredColorScheme(scheme) {
  for (var s = 0; s < document.styleSheets.length; s++) {

    for (var i = 0; i < document.styleSheets[s].cssRules.length; i++) {
      rule = document.styleSheets[s].cssRules[i];


      if (rule && rule.media && rule.media.mediaText.includes("prefers-color-scheme")) {

        switch (scheme) {
          case "light":
            rule.media.appendMedium("original-prefers-color-scheme");
            if (rule.media.mediaText.includes("light")) rule.media.deleteMedium("(prefers-color-scheme: light)");
            if (rule.media.mediaText.includes("dark")) rule.media.deleteMedium("(prefers-color-scheme: dark)");
            break;
          case "dark":
            rule.media.appendMedium("(prefers-color-scheme: light)");
            rule.media.appendMedium("(prefers-color-scheme: dark)");
            if (rule.media.mediaText.includes("original")) rule.media.deleteMedium("original-prefers-color-scheme");
            break;
          default:
            rule.media.appendMedium("(prefers-color-scheme: dark)");
            if (rule.media.mediaText.includes("light")) rule.media.deleteMedium("(prefers-color-scheme: light)");
            if (rule.media.mediaText.includes("original")) rule.media.deleteMedium("original-prefers-color-scheme");
            break;
        }
      }
    }


  }

  // Change the toggle button to be the opposite of the current scheme
  if (scheme === "dark") {
    document.getElementById("icon-sun").style.display = 'inline';
    document.getElementById("icon-moon").style.display = 'none';
  } else {
    document.getElementById("icon-moon").style.display = 'inline';
    document.getElementById("icon-sun").style.display = 'none';
  }
}

applyPreferredColorScheme(getPreferredColorScheme());
###