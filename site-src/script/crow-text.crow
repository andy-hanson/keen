import
	crow/col/mut-stack
	crow/experimental/observable
	crow/io/duration
	crow/js
	crow/js/dom
	crow/js/util
	crow/math/vec
	../../include/compiler/frontend/ide/get-tokens
	../../include/compiler/lib/lsp/lsp-types
	../../include/compiler/model/source-range
	../style/colors.css as colors-css string
	../style/crow-text.css as crow-text-css string
	./util/util

-line-height-px float()
	20
-tab-size nat()
	4

tokens-and-diagnostics record
	tokens token[]
	diagnostics lsp-diagnostic[]
new tokens-and-diagnostics()
	(), ()
to json(a tokens-and-diagnostics)

crow-text-props record mut
	get-hover string mut(where line-and-character)
	tokens-and-diagnostics tokens-and-diagnostics observable
	text string mut-observable

define-crow-text-custom-element void() summon, js extern
	"crow-text" define-custom-element (styles: colors-css, crow-text-css), it.connected

create-crow-text node(props crow-text-props) js extern
	trusted
	res = "crow-text" create-node
	res["props"] := props as-js
	res

-connected void(a custom-element-node) summon, js extern
	trusted
	props crow-text-props = a.as-js["props"] assume-type
	highlight-div = "highlight" create-div
	ta = "textarea" create-node
	ta.value := props.text.observable get
	ta.attributes["spellcheck"] := "false"
	ta add-event-listener "keydown", of event
		ta handle-keydown event, props.text
	ta add-event-listener "input", of _
		props.text set ta.value

	measurer-span = "" create-span
		- "a".create-text-node
	line-numbers = "line-numbers" create-div
	text-container = "code" create-div
		- "measurer" create-div (measurer-span,)
		- highlight-div
		- ta

	interrupter interrupter = ()

	ta add-event-listener "mousemove", of e
		ta mouse-move measurer-span, text-container, e, props, interrupter
	ta add-event-listener "mouseout", of e
		_ = interrupter get
		ta mouse-out text-container, e

	diag-debounce debouncer = 100.milliseconds,
	props.tokens-and-diagnostics now-and-subscribe shared of x
		text = props.text.observable get
		(x.tokens, ()) highlight highlight-div, text
		line-numbers.text-content := "\n" join for i nat in 0 .. text.count-lines
			"{i + 1}"
		with in diag-debounce
			x highlight highlight-div, text

	a.shadow-root ~~= line-numbers, text-container

-interrupter record mut
	current mut nat
-new interrupter()
	0,
-get nat(a interrupter)
	res = a current
	a.current +:= 1
	res
-is-still-current bool(a interrupter, was nat)
	was == a.current - 1

-handle-keydown void(ta node, event js-any, text string mut-observable) js extern
	trusted
	insert bool mut(to-insert string) = of to-insert
		text set do ta insert-text-area-text to-insert
		true
	prevent-default = match event["key"].to::string
	# 'End' works without modification
	# Modify 'Home' to go after the indentation instead of to the full start of the line
	as Home
		ta on-pressed-home-key
	as Enter
		insert["\n{ta indentation-at-selection}"]
	as Tab
		insert["\t"]
	as PageUp
		_ = ta call-property "setSelectionRange", 0, 0
		true
	as PageDown
		# Get this using JS so it is the length in UTF-16 characters.
		text-size = ta["value"]["length"]
		_ = ta call-property "setSelectionRange", text-size, text-size
		true
	else
		false
	if prevent-default
		_ = event call-property "preventDefault"

-count-lines nat(a string)
	a split "\n" size

-mouse-move void
	text-area node
	measurer node
	text-container node
	event js-any
	props crow-text-props
	interrupter interrupter
do unsafe, js extern
	offset = event offset
	state = interrupter get
	res = text-area get-hover measurer, offset, props
	# If the mouse has moved again, do nothing, since we are already getting hover at the new position
	guard interrupter is-still-current state
	if hover ?= res
		cur = text-container.attributes["data-tooltip"] else ""
		if hover.text != cur
			# We will not attach a tooltip to the actual highlight span, because that does not get hover events.
			# Instead just attach it to the text-area and set its position.
			text-container.attributes["data-tooltip"] := hover text
			text-container.classes["hover-diagnostic"] := hover is-diagnostic
			text-container.attributes["style"] := "--tooltip-x: {offset x}px; --tooltip-y: {offset y}px"
	else
		text-container.attributes -= "data-tooltip"

-offset vec2(event js-any) unsafe, js extern
	event["offsetX"].to, event["offsetY"].to

-dimensions vec2(node node) unsafe, js extern
	node["offsetWidth"].to, node["offsetHeight"].to

-mouse-out void
	text-area node
	text-container node
	event js-any
do unsafe, js extern
	offset = event offset
	unless offset is-in-rect ((0, 0), text-area.dimensions)
		text-container.attributes -= "data-tooltip"

-is-in-rect bool(pos vec2, rect (vec2, vec2))
	rect.a.x <= pos.x and pos.x <= rect.b.x and rect.a.y <= pos.y and pos.y <= rect.b.y

-got-hover record(text string, is-diagnostic bool)
-get-hover got-hover?(text-area node, measurer node, offset vec2, props crow-text-props) unsafe, js extern
	guard position ?= text-area get-position measurer, offset
	diagnostics = props.tokens-and-diagnostics.get diagnostics
	if diagnostic ?= diagnostics find of d then d.range has-pos position
		diagnostic.message, true
	else
		res = props.get-hover[position]
		guard res !is-empty
		res, false

find-the-span node?(highlight-div node, position line-and-character) js extern
	# TODO: handle line and character out of bounds -----------------------------------------------------------------------------------------------------
	lines = highlight-div child-nodes
	guard position.line < lines.size.to
	line = lines[position.line to]
	remaining mut int32 = position.character to
	line.child-nodes find of x
		remaining -:= x.text-content.size.to::nat32 to
		remaining < 0

-text-content string(a node) js extern
	(trusted a["textContent"]) to

-get-position line-and-character?(text-area node, measurer node, offset vec2) js extern
	lines = text-area.value split "\n"
	column-width float = trusted measurer.as-js["offsetWidth"] to
	line nat = (offset.y / line-height-px).round-down clamp-to
	column-pre nat = (offset.x / column-width).round-down clamp-to
	guard line < lines.size
	line-text = lines[line]
	leading-tabs = line-text count-leading-tabs
	tabs-fix = leading-tabs * (tab-size - 1)
	character = unless line-text == ""
		column-pre clamp-sub tabs-fix
	guard character < line-text.size
	line.to, character.to

-insert-text-area-text string(text-area js-any, inserted string) unsafe, js extern
	inserted-js-string js-any = inserted to
	value = text-area["value"]
	selection-start = text-area["selectionStart"]
	selection-end = text-area["selectionEnd"]
	# Selection is UTF-16 indices.
	# The easiest way to handle that is to use JS slicing instead of Crow slicing.
	before = value.as-js call-property "slice", 0, selection-start
	after = value.as-js call-property "slice", selection-end
	text-area["value"] := before + inserted-js-string + after
	# Similarly, get the string length in JS instead of in Crow.
	new-cursor = selection-start + inserted-js-string["length"]
	_ = text-area call-property "setSelectionRange", new-cursor, new-cursor
	text-area["value"] to

# If false, do not override default behavior
-on-pressed-home-key bool(text-area js-any) unsafe, js extern # TODO: make a new file text-area-utils? --------------------------------------------------
	str = text-area["value"]
	pos mut float = text-area["selectionStart"] to
	guard pos != 0
	guard str[pos - 1 to] != "\t"
	if str[pos - 1 to] == "\n"
		until pos == str["length"].to or str[pos to] != "\t"
			pos +:= 1
	else
		# Walk backwards to a "\t" or "\n"
		until pos == 0 or str[pos - 1 to] is-newline-or-tab
			pos -:= 1
	_ = text-area call-property "setSelectionRange", pos.to, pos.to
	true

-is-newline-or-tab bool(a js-any) unsafe, js extern
	a == "\n" or a == "\t"

-indentation-at-selection string(text-area js-any) unsafe, js extern
	str char8[] = text-area["value"].to::string to # TODO: maybe I should just use the value as a JS string .....................................................
	pos mut nat = text-area["selectionStart"].to min str.size - 1
	first-non-space mut = pos
	loop
		char char8 = str[pos]
		if char != " " and char != "\t"
			first-non-space := pos
		pos -:= 1
		if pos >= 0 and str[pos] != "\n"
			continue
		else
			break str[pos + 1 .. first-non-space] to

-count-leading-tabs nat(a string)
	res mut nat = 0
	_ = a iterate of x
		if x == "\t"
			res +:= 1
			false
		else
			true
	res

-highlight void(td tokens-and-diagnostics, highlight-div node, text string) js extern
	highlight-div remove-all-children
	highlight-div ~~= td tokens-and-diags-to-nodes text

-tokens-and-diags-to-nodes node[](td tokens-and-diagnostics, text string) js extern # TODO: this whole thing could go in its own file ..................................
	a node-builder = td.diagnostics, text
	a start-line
	for token in td tokens
		a walk-to (token.line, token.character)
		_ = a maybe-start-diag
		a add-span token.type.to,
			line: token line
			character: token.character + token.length
		a maybe-stop-diag

	a walk-to a.lines.last-position
	a end-line
	assert a.container-stack.size == 1
	a.container-stack[0].all-container!.nodes move-to

-node-builder record mut
	lines line[]
	diagnostics lsp-diagnostic[]
	pos mut line-and-character
	container-stack container mut-stack
	diag-index mut nat
-new node-builder(diagnostics lsp-diagnostic[], text string)
	lines: text split "\n" map it.to
	diagnostics: diagnostics
	pos: 0, 0
	container-stack:
		- () all-container
	diag-index: 0

-pop-container void(a node-builder) js extern
	popped = a.container-stack.pop!
	child node = match popped
	as line-container x
		"line" create-div x.nodes.move-to
	as diag-container x
		"diagnostic" create-span (), x.children.move-to
	else
		throw unreachable
	last-container = a.container-stack.peek!
	# text can't contain other nodes
	forbid last-container is-text
	last-container.children ~= child

-start-line void(a node-builder)
	a.container-stack ~= () line-container
-end-line void(a node-builder) js extern
	until a.container-stack.peek! is-line
		a pop-container
	a pop-container
-next-line void(a node-builder) js extern
	a end-line
	a start-line

-finish-text void(a node-builder) js extern
	last = a.container-stack.peek!
	if text ?= last text-container
		_ = a.container-stack.pop!
		new-last = a.container-stack.peek!
		# text can't contain other nodes
		forbid new-last is-text
		new-last.children ~= "no-token" create-span (text.text.create-text-node,)

-maybe-start-diag bool(a node-builder) js extern
	if a.diag-index < a.diagnostics.size
		diag = a.diagnostics[a.diag-index]
		message = diag message
		range = diag range
		start = range start
		end = range end
		if start <= a.pos
			# Ignore nested diags
			unless a.container-stack.peek! is-diag
				a finish-text
				a.container-stack ~= ((), end, message)::diag-container
			a.diag-index +:= 1
			true

-should-stop-diag bool(a node-builder)
	last-container = a.container-stack.peek!
	if x ?= last-container.diag-container
		x.end <= a.pos

-maybe-stop-diag void(a node-builder) js extern
	if a should-stop-diag
		a pop-container

-no-token-node node(a node-builder, start-pos line-and-character) js extern
	assert start-pos < a.pos
	"no-token" create-span ((a.lines slice-line start-pos, a.pos).to.create-text-node,)

-walk-to void(a node-builder, end-pos line-and-character) js extern
	start-pos mut = a.pos
	while a.pos < end-pos
		if a maybe-start-diag
			if start-pos < a.pos
				a.container-stack[end - 2].children ~= a no-token-node start-pos
			start-pos := a.pos
		next-pos = a.lines next-position a.pos
		if next-pos.line != a.pos.line
			if start-pos != a.pos
				a.container-stack.peek!.children ~= a no-token-node start-pos
			start-pos := next-pos
			a next-line
		a.pos := next-pos
		if a should-stop-diag
			a.container-stack.peek!.children ~= a no-token-node start-pos
			start-pos := a.pos
			a pop-container
	if start-pos < a.pos
		a.container-stack.peek!.children ~= a no-token-node start-pos

-add-span void(a node-builder, class-name string, end-pos line-and-character) js extern
	guard a.pos < end-pos
	parts = a.lines slice-lines a.pos, end-pos
	a.container-stack.peek!.children ~= class-name create-span (parts[0].to.create-text-node,)
	for part in parts[1 .. end]
		a next-line
		a.container-stack.peek!.children ~= class-name create-span (part.to.create-text-node,)
	a.pos := end-pos

-container union(all-container, line-container, diag-container, text-container) mut
-all-container record(nodes node mut[]) mut
-line-container record(nodes node mut[]) mut
-diag-container record mut
	children node mut[]
	end line-and-character
	message string
-text-container record mut
	text string

# TODO: inline these --------------------------------------------------------------------------------------------------------------------------------
-is-line bool(a container)
	_ ?= a line-container
-is-diag bool(a container)
	_ ?= a diag-container
-is-text bool(a container)
	_ ?= a text-container

-children node mut[](a container)
	match a
	as all-container x
		x nodes
	as line-container x
		x nodes
	as diag-container x
		x children
	as text-container _
		throw unreachable

line alias
	char32[]

-slice-lines line[](lines line[], start line-and-character, end line-and-character)
	if start.line == end.line
		- lines slice-line start, end
	else
		- lines slice-line-from start
		-- lines[start.line.to .. end.line.to] to # TODO: should not need 'to' at the end here. Should be able to spread in an array-view..
		- lines slice-line-to end
-slice-line line(lines line[], start line-and-character, end line-and-character)
	assert start.line == end.line
	# Since diagnostics may be out of date, we need to make sure to handle invalid start/end positions
	lines safe-at start.line.to safe-slice start.character.to .. end.character.to
-slice-line-from line(lines line[], start line-and-character)
	lines safe-at start.line.to safe-slice-from start.character.to
-slice-line-to line(lines line[], end line-and-character)
	lines safe-at end.line.to safe-slice-to end.character.to

-safe-at[t] t(xs t[], index nat) t new
	if index < xs.size
		xs[index]
-safe-slice[t] t[](xs t[], range nat range)
	guard range.low < xs.size
	xs[range.low .. (range.high min xs.size)] to
-safe-slice-from[t] t[](xs t[], index nat)
	if index < xs.size
		xs[index .. end] to
-safe-slice-to[t] t[](xs t[], index nat)
	if index < xs.size
		xs[0 .. index] to
	else
		xs

-next-position line-and-character(lines line[], pos line-and-character)
	if pos.character >= lines[pos.line to].size.to
		pos.line + 1, 0
	else
		pos.line, pos.character + 1

-last-position line-and-character(lines line[])
	lines.size.to - 1, lines[end - 1].size.to
