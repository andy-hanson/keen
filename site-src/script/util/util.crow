import
	crow/io/duration: duration, milliseconds
	crow/js
	crow/js/dom

now-iso string() js
	trusted call-property "Date".js-global.call-new, "toISOString" 'to

debouncer record mut
	-msec float
	-timeout mut js-any
new debouncer(time duration) js
	msec: time.milliseconds
	timeout: null
with-block void(a debouncer, action void mut()) summon, js
	trusted
	_ = call "clearTimeout".js-global, a.timeout
	a.timeout := call "setTimeout".js-global, action.as-js, a.msec.as-js

get-child-text string(node node) js
	child-nodes = child-nodes node
	assert child-nodes.size == 1
	get-text-from-node child-nodes[0]
-get-text-from-node string(node node) js
	trusted
	assert instanceof node, "Text".js-global
	node["data"].to
