import
	crow/io/duration: duration, milliseconds
	crow/js
	crow/js/dom

debouncer record mut
	-msec float
	-timeout mut js-any
new debouncer(time duration) js extern
	msec: time milliseconds
	timeout: trusted null
with-block void(a debouncer, action void mut()) summon, js extern
	trusted
	_ = "clearTimeout".js-global call a.timeout
	a.timeout := "setTimeout".js-global call action, a.msec

get-child-text string(node node) js extern
	child-nodes = node child-nodes
	assert child-nodes.size == 1
	child-nodes[0] get-text-from-node
-get-text-from-node string(node node) js extern
	trusted
	assert node.as-js instanceof "Text".js-global
	node.as-js["data"].string-of-js-string reduce-indent

-reduce-indent string(a string)
	# Find first non-whtespace
	a replace-all "\n{"\t"::string repeat a.count-indent}", "\n" strip
-count-indent nat(a string)
	i mut nat = 0
	ok = a iterate of x
		match x
		as "\n"
			i := 0
			false
		as "\t"
			i +:= 1
			false
		else
			true
	if ok then i
