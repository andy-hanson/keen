import
	crow/io/duration: duration, milliseconds
	crow/js
	crow/js/dom

now-iso string() js
	trusted "Date".js-global.call-new call-property "toISOString" to

debouncer record mut
	-msec float
	-timeout mut js-any
new debouncer(time duration) js
	msec: time milliseconds
	timeout: null
with-block void(a debouncer, action void mut()) summon, js
	trusted
	_ = "clearTimeout".js-global call a.timeout
	a.timeout := "setTimeout".js-global call action.as-js, a.msec.as-js

get-child-text string(node node) js
	child-nodes = node child-nodes
	assert child-nodes.size == 1
	child-nodes[0] get-text-from-node
-get-text-from-node string(node node) js
	trusted
	assert node instanceof "Text".js-global
	node["data"] to
