import
	crow/js
	crow/js/dom
	crow/js/util

copy-text-to-clipboard void(text string) summon, js
	trusted
	_ = await call-property "navigator".js-global["clipboard"], "writeText", text.to

download-text void(name string, text string) summon, js
	trusted
	link = create-node "a"
	blob-parts js-any[] = text.as-js,
	blob = call-new "Blob".js-global, blob-parts.as-js, type: "text/crow"
	link.as-js["href"] := call-property "URL".js-global, "createObjectURL", blob
	link.as-js["download"] := name.to
	_ = call-property link.as-js, "click"

get-url-search string?(name string) summon, js
	trusted
	res = call-new "URLSearchParams".js-global, location.inner["search"] 'call-property "get", name.to
	unless res == null then res.to

location record
	-inner js-any
to string(a location) js
	trusted call-property a.inner, "toString" 'to
location location() summon, js
	trusted
	- "window".js-global["location"]
origin string(a location) js
	trusted a.inner["origin"].to
pathname string(a location) js
	trusted a.inner["pathname"].to
search string(a location) js
	trusted a.inner["search"].to
hash string(a location) js
	trusted a.inner["hash"].to

push-history void(url string) js
	trusted
	_ = call-property "history".js-global, "pushState", (path: url.to), "", url.to
