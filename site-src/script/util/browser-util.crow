import
	crow/js
	crow/js/dom
	crow/js/util

copy-text-to-clipboard void(text string) summon, js extern
	trusted
	_ = "navigator".js-global["clipboard"] call-property "writeText", text.to-js-string await

download-text void(name string, text string) summon, js extern
	trusted
	link = "a" create-node
	blob-parts js-any[] =
		- text as-js
	blob = "Blob".js-global call-new blob-parts.as-js,
		:: js-any
		type: "text/crow"
	link.as-js["href"] := "URL".js-global call-property "createObjectURL", blob
	link.as-js["download"] := name to-js-string
	_ = link.as-js call-property "click"

get-url-search string?(name string) summon, js extern
	trusted
	res = "URLSearchParams".js-global call-new location.inner["search"] call-property "get", name.to-js-string
	unless res == null then res string-of-js-string

location record
	-inner js-any
to string(a location) js extern
	trusted a.inner call-property "toString" string-of-js-string
location location() summon, js extern
	trusted
	- "window".js-global["location"]
origin string(a location) js extern
	trusted a.inner["origin"] string-of-js-string
pathname string(a location) js extern
	trusted a.inner["pathname"] string-of-js-string
search string(a location) js extern
	trusted a.inner["search"] string-of-js-string
hash string(a location) js extern
	trusted a.inner["hash"] string-of-js-string

push-history void(url string) js extern
	trusted
	options js-any =
		path: url to-js-string
	_ = "history".js-global call-property "pushState", options, "", url.to-js-string
