import
	crow/js
	crow/js/dom
	crow/js/util

copy-text-to-clipboard void(text string) summon, js
	trusted
	_ = "navigator".js-global["clipboard"] call-property "writeText", text.to await

download-text void(name string, text string) summon, js
	trusted
	link = "a" create-node
	blob-parts js-any[] =
		- text as-js
	blob = "Blob".js-global call-new blob-parts.as-js, type: "text/crow"
	link.as-js["href"] := "URL".js-global call-property "createObjectURL", blob
	link.as-js["download"] := name to
	_ = link.as-js call-property "click"

get-url-search string?(name string) summon, js
	trusted
	res = "URLSearchParams".js-global call-new location.inner["search"] call-property "get", name.to
	unless res == null then res to

location record
	-inner js-any
to string(a location) js
	trusted a.inner call-property "toString" to
location location() summon, js
	trusted
	- "window".js-global["location"]
origin string(a location) js
	trusted a.inner["origin"] to
pathname string(a location) js
	trusted a.inner["pathname"] to
search string(a location) js
	trusted a.inner["search"] to
hash string(a location) js
	trusted a.inner["hash"] to

push-history void(url string) js
	trusted
	_ = "history".js-global call-property "pushState", (path: url to), "", url.to
