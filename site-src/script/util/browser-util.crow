import
	crow/js
	crow/js/dom

copy-text-to-clipboard void(text string) summon, js extern
	trusted
	_ = "navigator".js-global["clipboard"] call-property "writeText", text await

download-text void(name string, text string) summon, js extern
	trusted
	link = "a" create-node
	blob = "Blob".js-global call-new (text,)::string[], \
		(("type", "text/crow"),)::js-any
	url = "URL".js-global call-property "createObjectURL", blob
	link.as-js["href"] := url
	link.as-js["download"] := name
	_ = link.as-js call-property "click"

get-url-search string?(name string) summon, js extern
	trusted
	res = "URLSearchParams".js-global call-new location.search call-property "get", name
	unless res == null
		res cast

location record
	-inner js-any
to string(a location) js extern
	trusted a.inner call-property "toString" cast
location location() summon, js extern
	trusted
	- "window".js-global["location"]
origin string(a location) js extern
	trusted a.inner["origin"] cast
pathname string(a location) js extern
	trusted a.inner["pathname"] cast
search string(a location) js extern
	trusted a.inner["search"] cast
hash string(a location) js extern
	trusted a.inner["hash"] cast

push-history void(url string) js extern
	trusted
	history = "history" js-global
	_ = history call-property "pushState", (("path", url.as-js),)::js-any, ""::string, url
