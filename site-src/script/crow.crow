import
	crow/experimental/observable
	crow/parse
	crow/js
	crow/js/util
	../../include/compiler/frontend/ide/get-tokens
	../../include/compiler/lib/lsp/lsp-types
	../../include/compiler/model/source-range
	../../include/compiler/model/uri
	./deferred

crow-server record mut
	-worker js-any
	-responses json deferred mut[nat]
	-next-id mut nat
	-diagnostics lsp-diagnostic[][uri] mut-observable

diagnostics lsp-diagnostic[][uri] observable(a crow-server)
	a.diagnostics observable

make-crow-server crow-server() summon, js extern
	trusted
	worker = "Worker".js-global call-new "worker.js"::js-any,
		:: js-any
		type: "module"
	
	responses json deferred mut[nat] = ()
	diagnostics lsp-diagnostic[][uri] mut-observable = ()
	on-message void mut(event js-any) = of event
		object = json parse event["data"].to
		if "id"::symbol in object
			responses[object["id"] to]! resolve object["result"]
		else
			method symbol = object["method"] to
			params = object["params"]
			if method == "textDocument/publishDiagnostics"
				p publish-diagnostics-params = params to
				diagnostics modify of x
					x ~ (p.uri, p.diagnostics)
			else
				error log "What do we do with this?"
				error log method.show
				error log object.show
				throw todo
	worker["onmessage"] := on-message as-js

	server crow-server =
		worker: worker
		responses: responses
		next-id: 1
		diagnostics: diagnostics
	_ = server request "initialize", ()
	server

-send-message void(server crow-server, method symbol, params json) unsafe, js extern
	msg json =
		method: method to
		params: params
	_ = server.worker call-property "postMessage", msg.to::json.show.to

-request json(server crow-server, method symbol, params json) js extern
	trusted
	id = server.next-id
	server.next-id +:= 1
	msg json =
		id: id to
		method: method to
		params: params
	deferred json deferred = ()
	server.responses[id] := deferred
	_ = server.worker call-property "postMessage", msg.to::json.show.to
	deferred await

open-file void(a crow-server, uri uri, text string) unsafe, summon, js extern
	params did-open-text-document-params =
		textDocument:
			uri: uri
			text: text
	a send-message "textDocument/didOpen", params.to

change-file void(a crow-server, uri uri, text string) unsafe, summon, js extern
	params did-change-text-document-params =
		textDocument:
			uri: uri
		contentChanges:
			-
				text: text
	a send-message "textDocument/didChange", params.to

get-hover string(a crow-server, uri uri, position line-and-character) js extern
	params hover-params =
		params:
			textDocument:
				uri: uri
			position: position
	res = a request "textDocument/hover", params.to
	unless res == null
		res["contents"]["value"] string!

highlightable-token record
	line nat32
	character nat32
	length nat
	type symbol[]
	modifiers symbol set

get-tokens token[](a crow-server, uri uri) js extern
	params semantic-tokens-params =
		textDocument:
			uri: uri
	data_ nat[] = (a request "textDocument/semanticTokens/full", params.to)["data"].array! map it.to
	(data_,).decode-semantic-tokens to

syntax-translate string
	server crow-server
	from-lang language
	source string
	to-lang language
do js extern
	params syntax-translate-params =
		source: source
		from-language: from-lang
		to-language: to-lang
	response syntax-translate-result = server request "custom/syntaxTranslate", params.to to
	if response.diagnostics is-empty
		response output
	else
		"Parse error at ${response.diagnostics[0]}"

build-js-script build-js-script-result(server crow-server, main uri) js extern
	params build-js-script-params =
		uri: main
		diagnosticsOnlyForUris: ()
	server request "custom/build-js-script", params.to to
