import
	crow/experimental/observable
	crow/io/duration
	crow/io/time
	crow/parallel
	crow/js
	crow/js/util
	../../include/crow/json: parse-json
	../../include/compiler/frontend/ide/get-tokens
	../../include/compiler/lib/lsp/lsp-types
	../../include/compiler/model/source-range
	../../include/compiler/model/uri
	./deferred
	./util/util

crow-server record mut
	-worker js-any
	-responses json deferred mut[nat]
	-next-id mut nat
	-diagnostics lsp-diagnostic[][uri] mut-observable

diagnostics lsp-diagnostic[][uri] observable(a crow-server)
	observable diagnostics a

make-crow-server crow-server() global, js
	trusted
	start = monotime
	log "launched worker at {now-iso}"
	worker = call-new "Worker".js-global, "/worker.js", type: "module"

	responses json deferred mut[nat] = ()
	loaded void deferred = ()
	diagnostics lsp-diagnostic[][uri] mut-observable = ()
	on-message void mut(event js-any) = of event
		object = parse-json event["data"].to
		if has-key object, "id"
			id nat = object["id"].to
			if id == 2
				resolve loaded, ()
			resolve responses[id]!, object["result"]
		else
			method symbol = object["method"].to
			params = object["params"]
			assert method == "textDocument/publishDiagnostics" else todo
			p publish-diagnostics-params = params.to
			modify diagnostics, of x then x ~ (p.uri, p.diagnostics)
	worker["onmessage"] := as-js on-message

	server crow-server =
		worker: worker
		responses: responses
		next-id: 1
		diagnostics: diagnostics
	_ = with-block fire-and-forget, shared of
		_ = request server, "initialize", ()

	_ = with-block fire-and-forget, shared of # TODO: Support 'shared with' ---------------------------------------------------------------------
		await loaded
		log "Took {monotime - start} to load Crow server"
		json = request server, "custom/perf-report", ()
		log "{json}"
	server

-send-message void(server crow-server, method symbol, params json) unsafe, js
	msg json = method: method.to, params: params
	_ = call-property server.worker, "postMessage", msg.to-json.to

-request json(server crow-server, method symbol, params json) js
	trusted
	id = server.next-id
	server.next-id +:= 1
	msg json =
		id: id.to
		method: method.to
		params: params
	deferred json deferred = ()
	server.responses[id] := deferred
	_ = call-property server.worker, "postMessage", msg.to-json.to
	await deferred

open-file void(a crow-server, uri uri, text string) unsafe, global, js
	params did-open-text-document-params = textDocument: (uri: uri, text: text)
	send-message a, "textDocument/didOpen", params.to

change-file void(a crow-server, uri uri, text string) unsafe, global, js
	params did-change-text-document-params =
		textDocument: uri: uri
		contentChanges:
			- text: text
	send-message a, "textDocument/didChange", params.to

get-hover string(a crow-server, uri uri, position line-and-character) js
	params hover-params =
		params:
			textDocument: uri: uri
			position: position
	res = request a, "textDocument/hover", params.to
	unless res == null
		res["contents"]["value"].to

highlightable-token record
	line nat32
	character nat32
	length nat
	type symbol[]
	modifiers symbol set

get-tokens token[](a crow-server, uri uri) js
	params semantic-tokens-params =
		textDocument: uri: uri
	encoded = request a, "textDocument/semanticTokens/full", params.to
	data_ nat[] = encoded["data"].to
	(data_,).decode-semantic-tokens.to

syntax-translate string
	server crow-server
	from-lang language
	source string
	to-lang language
do js
	params syntax-translate-params =
		source: source
		from-language: from-lang
		to-language: to-lang
	response syntax-translate-result = request server, "custom/syntaxTranslate", params.to 'to
	if is-empty diagnostics response
		output response
	else
		"Parse error at position {response.diagnostics[0]}"

build-js-script build-js-script-result(server crow-server, main uri) js
	params build-js-script-params = uri: main, diagnosticsOnlyForUris: ()
	request server, "custom/build-js-script", params.to 'to
