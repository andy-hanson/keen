import
	crow/js
	crow/js/dom
	./crow
	./crow-runnable
	./crow-text
	./icon
	./loading-spinner
	./syntax-translate

main void() summon, js extern
	info log "TOP OF THE SCRIPT"
	crow = make-crow-server
	info log "made the server"
	open-details-on-click
	define-icon-custom-element
	crow define-crow-runnable-custom-element
	define-crow-text-custom-element
	define-loading-spinner-element
	crow define-syntax-translate-element

-open-details-on-click void() summon, js extern
	trusted
	for details in "details" query-all
		link = details call-property "querySelector", "a"::js-any
		unless link == null
			fn void mut() = of
				_ = details.as-js call-property "setAttribute", "open"::js-any, true
			link["onclick"] := fn
