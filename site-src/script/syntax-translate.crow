import
	crow/js/dom
	../../include/compiler/lib/lsp/lsp-types
	../style/colors.css as colors-css string
	../style/syntax-translate.css as syntax-translate-css string
	./crow: crow-server, syntax-translate
	./util/util: get-child-text

define-syntax-translate-element void(crow crow-server) global, js
	define-custom-element "syntax-translate-row", it.noop
	define-custom-element "syntax-translate", (styles: colors-css, syntax-translate-css), of x
		x.shadow-root ~= make-div crow, x.as-node.child-nodes

-make-div node(crow crow-server, child-nodes node[]) js
	create-node "table", (), "",
		- create-node "thead", (), "",
			- create-node "tr", (), "",
				- th "Crow syntax"
				- th "Java-like syntax"
				- th "C-like syntax"
		- create-node "tbody", (), "", for* x in child-nodes
			unless is-text-node x
				- create-row crow, x.get-child-text

-create-row node(crow crow-server, initial-c-source string) js
	inputs mut node[] = ()

	input-for-lang node mut(x language) = of lang
		inputs[index-of! langs, lang]

	on-input void mut(x language) = of input-lang
		for output-lang in langs
			unless output-lang == input-lang
				input-value = value input-for-lang[input-lang]
				result = syntax-translate crow, input-lang, input-value, output-lang
				input-for-lang[output-lang].value := result

	inputs := for lang in langs
		create-input-text (of _ then on-input[lang]), if lang == c then initial-c-source

	on-input[c]

	create-node "tr", (), "", for x in inputs
		create-node "td", (), "",
			- x

-langs language[]() # TODO: this is just 'members', but I think it matters that I made 'crow' the first option --------------------------------------
	crow, java, c

-th node(text string) js
	create-node "th", (), "",
		- create-text-node text
