import
	crow/js/dom
	../../include/compiler/lib/lsp/lsp-types
	./crow: crow-server, syntax-translate
	./util/util: get-child-text

define-syntax-translate-element void(crow crow-server) summon, js extern
	"syntax-translate-row" define-custom-element "", it.noop
	"syntax-translate" define-custom-element css, of x
		x.shadow-root ~= crow make-div x.as-node.child-nodes

-make-div node(crow crow-server, child-nodes node[]) js extern
	"table" create-node (), "",
		- "thead" create-node (), "",
			- "tr" create-node (), "",
				- "Crow syntax" th
				- "Java-like syntax" th
				- "C-like syntax" th
		- "tbody" create-node (), "", for* x in child-nodes
			unless x is-text-node
				- crow create-row x.get-child-text

-create-row node(crow crow-server, initial-c-source string) js extern
	inputs mut node[] = ()

	input-for-lang node mut(x language) = of lang
		inputs[langs index-of! lang]

	on-input void mut(x language) = of input-lang
		for output-lang in langs
			unless output-lang == input-lang
				input-value = input-for-lang[input-lang] value
				result = crow syntax-translate input-lang, input-value, output-lang
				input-for-lang[output-lang].value := result

	inputs := for lang in langs
		(of _ then on-input[lang]) create-input-text if lang == c then initial-c-source

	on-input[c]

	"tr" create-node (), "", for x in inputs
		"td" create-node (), "",
			- x

-langs language[]() # TODO: this is just 'members', but I think it matters that I made 'crow' the first option --------------------------------------
	crow, java, c

-th node(text string) js extern
	"th" create-node (), "",
		- text create-text-node

-css string()
	"""
table \{
	table-layout: fixed;
	width: 100%;
	border-collapse: collapse;
}
table th \{
	padding: 0;
	width: 33%;
}
table td \{
	padding: 0;
	width: 33%;
	border: 1px solid #888;
}
table td:focus-within \{
	background: #f8ffe0;
}
input \{
	padding-left: 0.5em;
	padding-right: 0;
	width: calc(100% - 0.5em);
	font-family: "hack";
	font-size: 105%;
	border: none;
}
input:focus-visible \{
	outline: none;
	background: #f8ffe0;
}
"""
