import
	crow/js/dom
	../style/loading-spinner.css as loading-spinner-css string

define-loading-spinner-element void() summon, js extern
	"crow-loading-spinner" define-custom-element (style: loading-spinner-css), of x
		x.shadow-root ~= loading-div

create-loading-spinner node() js extern
	"crow-loading-spinner" create-node

-loading-div node() js extern
	"root" create-div for class-name in ("child-0", "child-1", "child-2", "child-3")::string[]
		class-name create-div
