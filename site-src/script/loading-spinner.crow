import
	crow/js/dom
	../style/loading-spinner.css as loading-spinner-css string

define-loading-spinner-element void() global, js
	define-custom-element "crow-loading-spinner", (style: loading-spinner-css), of x
		x.shadow-root ~= loading-div

create-loading-spinner node() js
	create-node "crow-loading-spinner"

-loading-div node() js
	create-div "root", for class-name in ("child-0", "child-1", "child-2", "child-3")::string[]
		create-div class-name
