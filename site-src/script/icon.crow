use-prefix
import
	crow/js
	crow/js/dom

# Icons from https://heroicons.com/

define-icon-custom-element void() summon, js
	define-custom-element "crow-icon", of this
		child = match this.attributes["icon"]!
		as download
			download-icon
		as home
			home-icon
		as external-link
			external-link-icon
		as play
			play-icon
		else
			throw todo
		this.shadow-root ~= child

link-icon node() js
	d string =
		"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 " ~~
		"1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 " ~~
		"4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"
	icon "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"{d}\" />"

download-icon node() js
	icon quote
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
		/>

play-icon node() js
	icon quote
		<polygon
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			fill="none"
			points="6,6 6,18 18,12" />

up-icon node() js
	icon quote
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			d="M5 15l7-7 7 7"
		/>

sun-icon node() js
	d string =
		"M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 " ~~
		"18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 " ~~
		"12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
	icon "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"{d}\" />"

moon-icon node() js
	d string =
		"M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 " ~~
		"0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 " ~~
		"12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
	icon "<path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"{d}\" />"

home-icon node() js
	d string =
		"m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 " ~~
		"1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 " ~~
		"1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
	icon "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"{d}\" />"

external-link-icon node() js
	d string = "M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
	icon "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"{d}\"/>"

-icon node(content string) js
	trusted
	res = create-div "icon"
	res["innerHTML"] := quote
		<svg
			xmlns="http://www.w3.org/2000/svg"
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor">
			{content}
		</svg>
	res
