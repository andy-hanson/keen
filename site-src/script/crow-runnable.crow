import
	crow/experimental/observable
	crow/format/base64
	crow/io/print
	crow/js
	crow/js/dom
	crow/unsafe
	../../include/compiler/frontend/ide/get-tokens
	../../include/compiler/lib/lsp/lsp-types
	../../include/compiler/model/uri
	../../include/compiler/util/exit-code
	./crow
	./crow-text
	./icon
	./loading-spinner
	./util/browser-util
	./util/util

define-crow-runnable-custom-element void(crow crow-server) summon, js extern
	names names = ()
	trusted "crow-runnable" define-custom-element it.is-play.css, of x
		x connected crow, names

-names record(seen string mut-set, next-index mut nat) mut
-new names()
	(), 0
-get-default-name string(a names) unsafe
	index = a.next-index
	a.next-index +:= 1
	"demo{index}.crow"

-get-crow-runnable-name string(a names, name-attr string?) unsafe, js extern
	name = name-attr else a get-default-name
	assert name ends-with ".crow"
	unless a.seen try-add name
		error log "Two CrowRunnable have the same name {name}"
	name

-get-crow-runnable-initial-text string(play bool, node node) summon, unsafe, js extern
	(if play then get-code-from-url) else node get-child-text
-get-code-from-url string?() summon, unsafe, js extern
	if code ?= "code" get-url-search
		code.base64-decode as-string

-copy-play-link-from-text void(text string) summon, unsafe, js extern
	url string = "{location origin}{location pathname}?code={text base64-encode}"
	url push-history
	url copy-text-to-clipboard

-is-play bool(a custom-element-node) unsafe, js extern
	_ ?= a.attributes["play"]

-connected void(a custom-element-node, crow crow-server, names names) summon, unsafe, js extern
	name = names get-crow-runnable-name a.attributes["name"]
	no-run = _ ?= a.attributes["no-run"]
	play = a is-play
	initial-text = play get-crow-runnable-initial-text a.as-node
	main-uri uri = "file:///{name}" must-parse-uri
	text-mut string mut-observable = initial-text,
	text = text-mut observable
	tokens-observable token[] mut-observable = ()
	crow-text-props crow-text-props =
		getHover: of position
			crow get-hover main-uri, position
		tokensAndDiagnostics: for tokens, diagnostics in tokens-observable.observable join crow.diagnostics
			tokens, (diagnostics[main-uri] else ())
		text: text-mut
	crow-text = crow-text-props create-crow-text

	text now-and-subscribe shared of value
		crow open-file main-uri, value
		tokens-observable set do crow get-tokens main-uri

	output output = ()

	collapse-button mut node = gc-safe-value # TODO: just use an option ---------------------------------------------------------------------
	collapse-button := "Hide output" create-button "collapsed", (up-icon,), of ()
		output hide
		collapse-button.classes ~= "collapsed"
	collapse-button.style["float"] := "right"

	run-button node? = unless no-run
		button = "Run" create-button "run", (play-icon,), of
			output start-running
			collapse-button remove-class "collapsed"
			# TODO: I'm going to totally change how 'run' works. The server will build JS and send it to us to run.
			output finish-running do crow build-js-script main-uri run-js
		button

	copy-button = "Copy to clipboard" create-button "", (copy-icon,), of
		text.get copy-text-to-clipboard
	download-button = "Download" create-button "", (download-icon,), of
		name download-text text.get
	link-button node? = if play
		"Copy link to clipboard" create-button "", (link-icon,), of
			text.get copy-play-link-from-text

	buttons node[] =
		-- run-button from-option
		- copy-button
		- download-button
		-- link-button from-option
		- collapse-button
	a.shadow-root ~= "outer-container" create-div
		- crow-text
		- output container
		- "bottom" create-div buttons

-output record(container node) mut
-new output() js extern
	res output =
		- "output" create-div ()
	res hide
	res
-hide void(a output) js extern
	a.container.style["height"] := "0"
-start-running void(a output) js extern
	a.container.classes := "output", "running"
	a.container.style["height"] := "2em"
	a.container remove-all-children
	a.container ~= create-loading-spinner
-finish-running void(a output, run-result run-test-result) unsafe, js extern
	a.container remove-class "running"
	a.container.style["height"] := ""
	a.container remove-all-children
	a.container add-spans-for-writes run-result

-add-spans-for-writes void(container node, run-result run-test-result) js extern
	cur-pipe mut string? = ()
	cur-line mut string = ""
	finish-line void mut() = of
		unless trusted container.as-js["textContent"] == ""
			container ~= "br" create-node
		container ~= cur-pipe!.show create-span (cur-line.create-text-node,)
		cur-line := ""

	for write in run-result writes
		pipe string = write.pipe to
		text = write text
		if x ?= cur-pipe
			if x != pipe and cur-line != ""
				finish-line[]

		cur-pipe := pipe
		parts = text split "\n"
		cur-line ~~:= parts[0]
		for part in parts[1 .. end]
			finish-line[]
			cur-line ~~:= part
	if cur-line != ""
		finish-line[]

	if run-result.exit !is-ok
		cur-pipe := "exit-code"
		cur-line := "Exit code: {run-result.exit value}"
		finish-line[]
	elif run-result.writes is-empty
		cur-pipe := "stdout"
		cur-line := "<<no output>>"
		finish-line[]

-css string(play bool)
	"""
.outer-container \{
	max-width: {if play then 60::nat else 40}em;
	margin-left: auto;
	margin-right: auto;
}
.output \{
	width: 100%;
	color: #fdf9f3;
	background: #161517;
	font-family: "hack";
	white-space: pre-wrap;
	tab-size: 4;
	overflow: hidden;
}
.output.running \{ transition: none; }
.output > .stderr \{ color: #ff6622; }
.output > .exit-code \{ color: #ff4444; }
button \{
	border: none;
	outline: none;
	color: #ffebbd;
	background: #00000000;
	cursor: pointer;
}
.run \{ color: #ffd866; }
.bottom \{
	border-bottom-left-radius: 1.5em;
	border-bottom-right-radius: 1.5em;
	background: #423e44;
	margin: 0;
	padding-left: 0.5em;
	padding-right: 0.5em;
}
div.icon svg \{ height: 1.5em; }
button.collapsed \{ display: none; }
"""

-run-js run-test-result(build build-js-script-result) js extern
	trusted
	console = "console" js-global
	old-info = console["info"]
	old-error = console["error"]
	finally
		console["info"] := old-info
		console["error"] := old-error
	writes write mut[] = ()
	unless build.diagnostics is-empty
		writes ~= err, "{build diagnostics}\n"
	new-info void mut(x js-any) = of x
		writes ~= out, "{x.to::string}\n"
	new-error void mut(x js-any) = of x
		writes ~= err, "{x.to::string}\n"
	console["info"] := new-info to
	console["error"] := new-error to

	# TODO: we might need to provide a global 'process' ---------------------------------------------------------------------------------------------
	exit exit-code = if script ?= build script
		encoded = "encodeURIComponent".js-global call script.to
		data-url = "data:text/javascript;charset=utf-8,"::js-any + encoded
		try
			_ = data-url.js-import await
			ok
		catch else e
			writes ~=
				pipe: err
				text: e.as-js call-property "toString" to
			error
	else
		error
	exit: exit
	writes: writes move-to
	
