import
	crow/js
	crow/js/browser
	crow/js/util
	crow/parallel
	../../include/crow/json: parse-json
	../../include/compiler/app/server
	../../include/compiler/frontend/show-model
	../../include/compiler/model/lsp
	../../include/compiler/model/uri
	../../include/compiler/util/perf
	../../include/compiler/util/tar
	./util/util

main void() global, unsafe, js
	log "worker is alive at {now-iso}"
	# We need to assign `onmessage` immediately, so don't await this yet
	files-promise = with in parallel then preload
	server server =
		settings:
			include-dir: must-parse-uri "file:///usr/local/bin/crow/include"
			cwd: must-parse-uri "file:///home/me/demo"
			show-options: color: false
	on-message = of event js-any
		:: void
		files = await files-promise
		data_ string = event["data"].to
		input lsp-in-message = data_.parse-json.to
		read-file-locally = of uri uri then read-file-locally files, uri
		exit = handle-one-lsp-message server, input, read-file-locally, of x
			_ = call "postMessage".js-global, x.to-json.to
		forbid exit else todo
	self["onmessage"] := as-js on-message

-tar-files alias
	nat8 array-view[symbol]
-preloaded-files record
	crow-include tar-files
	java-classes tar-files
-preload preloaded-files() global, js
	start = perf-now
	finally end-read-file start
	tars tar-files[] = for x in ("crow-include.tar", "java-classes.tar")::string[]
		read-entire-tar fetch x
	crow-include: tars[0]
	java-classes: tars[1]

-read-file-locally read-file-result-params(files preloaded-files, uri uri)
	start = perf-now
	finally end-read-file start
	s = show uri
	content nat8 array-view? = if path = try-remove-start s, "file:///usr/local/bin/crow/include/crow/"
		files.crow-include[path.to]
	elif path = try-remove-start s, "java:///"
		files.java-classes["{path}.class"]
	if content
		uri, ok, content
	else
		unless ends-with s, "/crow-config.json"
			log error, "not found: {uri}" # ----------------------------------------------------------------------------------------------------------
		uri, not-found, ()
