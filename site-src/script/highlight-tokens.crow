import
	crow/col/mut-stack
	crow/js
	crow/js/dom
	../../include/compiler/frontend/ide/get-tokens
	../../include/compiler/lib/lsp/lsp-types
	../../include/compiler/model/source-range

tokens-and-diags-to-nodes node[](tokens token[], diagnostics lsp-diagnostic[], text string) js
	a node-builder = diagnostics, text
	start-line a
	for token in tokens
		walk-to a, (token.line, token.character)
		_ = maybe-start-diag a
		add-span a, token.type.to,
			line: line token
			character: token.character + token.length
		maybe-stop-diag a

	walk-to a, a.lines.last-position
	end-line a
	assert a.container-stack.size == 1
	a.container-stack[0].all-container!.nodes.move-to

-node-builder record mut
	lines line[]
	diagnostics lsp-diagnostic[]
	pos mut line-and-character
	container-stack container mut-stack
	diag-index mut nat
-new node-builder(diagnostics lsp-diagnostic[], text string)
	lines: split text, "\n" 'map it.to
	diagnostics: diagnostics
	pos: 0, 0
	container-stack:
		- all-container ()
	diag-index: 0

-pop-container void(a node-builder) js
	popped = pop! container-stack a
	child node = match popped
	as line-container
		create-div "line", move-to nodes popped
	as diag-container
		create-span "diagnostic", (), move-to children popped
	else
		throw unreachable
	last-container = peek! container-stack a
	# text can't contain other nodes
	forbid text-container last-container
	last-container.children ~= child

-start-line void(a node-builder)
	a.container-stack ~= line-container ()
-end-line void(a node-builder) js
	until line-container peek! container-stack a
		pop-container a
	pop-container a
-next-line void(a node-builder) js
	end-line a
	start-line a

-finish-text void(a node-builder) js
	last = peek! container-stack a
	if text-container last
		_ = pop! container-stack a
		new-last = peek! container-stack a
		# text can't contain other nodes
		forbid text-container new-last
		new-last.children ~= create-text-span "no-token", text last

-maybe-start-diag bool(a node-builder) js
	if a.diag-index < a.diagnostics.size
		diag = a.diagnostics[a.diag-index]
		if diag.range.start <= a.pos
			# Ignore nested diags
			unless diag-container peek! container-stack a
				finish-text a
				a.container-stack ~= ((), diag.range.end, diag.message)::diag-container
			a.diag-index +:= 1
			true

-should-stop-diag bool(a node-builder)
	last-container = peek! container-stack a
	diag-container last-container and last-container.end <= a.pos

-maybe-stop-diag void(a node-builder) js
	if should-stop-diag a
		pop-container a

-no-token-node node(a node-builder, start-pos line-and-character) js
	assert start-pos < a.pos
	create-text-span "no-token", to slice-line a.lines, start-pos, a.pos

-walk-to void(a node-builder, end-pos line-and-character) js
	start-pos mut = a.pos
	while a.pos < end-pos
		if maybe-start-diag a
			if start-pos < a.pos
				a.container-stack[end - 2].children ~= no-token-node a, start-pos
			start-pos := a.pos
		next-pos = next-position a.lines, a.pos
		if next-pos.line != a.pos.line
			if start-pos != a.pos
				a.container-stack.peek!.children ~= no-token-node a, start-pos
			start-pos := next-pos
			next-line a
		a.pos := next-pos
		if should-stop-diag a
			a.container-stack.peek!.children ~= no-token-node a, start-pos
			start-pos := a.pos
			pop-container a
	if start-pos < a.pos
		a.container-stack.peek!.children ~= no-token-node a, start-pos

-add-span void(a node-builder, class-name string, end-pos line-and-character) js
	do if a.pos < end-pos
	parts = slice-lines a.lines, a.pos, end-pos
	a.container-stack.peek!.children ~= create-text-span class-name, parts[0].to
	for part in parts[1 .. end]
		next-line a
		a.container-stack.peek!.children ~= create-text-span class-name, part.to
	a.pos := end-pos

-container union(all-container, line-container, diag-container, text-container) mut
-all-container record(nodes node mut[]) mut
-line-container record(nodes node mut[]) mut
-diag-container record mut
	children node mut[]
	end line-and-character
	message string
-text-container record mut
	text string

-create-text-span node(class-name string, text string) js
	create-span class-name, (text.create-text-node,)

-children node mut[](a container)
	match a
	as all-container
		nodes a
	as line-container
		nodes a
	as diag-container
		children a
	as text-container
		throw unreachable

line alias
	char32[]

-slice-lines line[](lines line[], start line-and-character, end line-and-character)
	if start.line == end.line
		- slice-line lines, start, end
	else
		- slice-line-from lines, start
		-- to lines[start.line.to .. end.line.to] # TODO: should not need the main 'to' here. Should be able to spread in an array-view.....
		- slice-line-to lines, end
-slice-line line(lines line[], start line-and-character, end line-and-character)
	assert start.line == end.line
	# Since diagnostics may be out of date, we need to make sure to handle invalid start/end positions
	safe-slice (safe-at lines, start.line.to), start.character.to .. end.character.to
-slice-line-from line(lines line[], start line-and-character)
	safe-slice-from (safe-at lines, start.line.to), start.character.to
-slice-line-to line(lines line[], end line-and-character)
	safe-slice-to (safe-at lines, end.line.to), end.character.to

-safe-at[t] t(xs t[], index nat) t new
	if index < xs.size
		xs[index]
-safe-slice[t] t[](xs t[], range nat range)
	do if range.low < xs.size
	xs[range.low .. (min range.high, xs.size)].to
-safe-slice-from[t] t[](xs t[], index nat)
	if index < xs.size
		xs[index .. end].to
-safe-slice-to[t] t[](xs t[], index nat)
	if index < xs.size
		xs[0 .. index].to
	else
		xs

-next-position line-and-character(lines line[], pos line-and-character)
	if pos.character >= lines[pos.line.to].size.to
		pos.line + 1, 0
	else
		pos.line, pos.character + 1

-last-position line-and-character(lines line[])
	lines.size.to - 1, lines[end - 1].size.to
