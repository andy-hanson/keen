import
	../random/random
	../random/secure-random
	../random/xoshiro

| If this test fails, use the seed as the argument to {random-test-with-seed}
+random-test void(f void mut(x random)) global
	seed = secure-random-seed
	try
		f[xoshiro seed]
	catch e as exception
		log-error "Random seed was {seed}"
		throw e

+random-test-with-seed void(seed nat64, f void mut(x random))
	f[xoshiro seed]
