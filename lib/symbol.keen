no-std
import
	java/lang/String
	./bool
	./col/array
	./col/experimental/object-memoizer
	./compare
	./hash
	./java
	./js
	./misc
	./number
	./private/bootstrap: new, symbol-chars, symbol-deterministic-hash, symbol-seeded-hash
	./string
	./unsafe
export
	./private/bootstrap: symbol

-symbol-key record
	| This is the seeded hash
	hash nat64
	chars string-view
-memoizer-key symbol-key(a symbol)
	a.symbol-seeded-hash, a.symbol-chars
- == bool(a symbol-key, b symbol-key)
	trusted a.chars == b.chars

~seeded-hash-value nat64(a symbol) global
	a.symbol-seeded-hash

+ == bool(a symbol, b symbol)
	trusted a 'reference-equal b

| Same as `{a}.to::string <=> {b}.to::string`.
+ <=> comparison(a symbol, b symbol)
	trusted a.to::string <=> b.to

+to string(a symbol)
	a.to::char8[].to
+to char8[](a symbol)
	a.symbol-chars

+to symbol(a string)
	a.to::string-view.to
+to symbol(a string-view)
	trusted to-symbol-with-hash a, seeded-hash a
| {hash} must be the hash of {a} (in case the caller wants to avoid walking {a} twice)
~to-symbol-with-hash symbol(a string-view, hash nat64) global, unsafe
	memoize lookup, (hash, a), {hash, a.deterministic-hash, a.to}

+to symbol(a String) java
	a.to::string.to

-lookup global((symbol, symbol-key) object-memoizer) = ()

+show string(a symbol)
	a.to

+hash void(a symbol, state hash-state)
	trusted hash a.symbol-deterministic-hash, state

+interpolate symbol(parts string[])
	parts.interpolate::string.to

| Converts to a JS 'string', not a 'Symbol'
+to js-any(a symbol) js
	a.to::string.to
+to symbol(a js-any) js
	a.to::string.to
