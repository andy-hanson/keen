import
	keen/io/duration

test
	1.seconds.seconds is 1
	2.seconds.milliseconds is 2_000
	3.milliseconds.seconds is 0.003
	show 4.seconds is "4s"
	show 5.milliseconds is "5ms"
	show 6.microseconds is "6μs"
	show 7.nanoseconds is "7.000000000000001ns"

	1.seconds + 2.milliseconds is 1002.milliseconds
