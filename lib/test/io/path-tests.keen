import
	keen/io/path

test
	"foo/keen.txt".get-extension is "txt"
	"x.y/keen".get-extension is ()

test
	remove-extension "foo/keen.txt" is "foo/keen"

test
	add-extension "foo/keen.txt", "exe" is "foo/keen.txt.exe"

test
	change-extension "foo/keen.txt", "exe" is "foo/keen.exe"

test
	base-name "foo/keen.txt" is "keen.txt"
