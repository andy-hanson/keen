import
	keen/format/binary

-one-through-eight nat8[]()
	1, 2, 3, 4, 5, 6, 7, 8

test
	take16 begin one-through-eight is 0x0102
	take32 begin one-through-eight is 0x01020304
	take64 begin one-through-eight is 0x0102030405060708
	from-big-endian::nat64 one-through-eight is 0x0102030405060708
	big-endian 0x0102030405060708 is one-through-eight

test
	buf nat8 buffer = trusted uninitialized-buffer 8
	write-big-endian buf, 0x0102030405060708
	to::nat8[] buf is one-through-eight

test
	bytes nat8[] = 0x6b, 0x65, 0x65, 0x6e
	take-string bytes.begin, 4 is "keen"
