test
	a nat8 mut[] = 1, 2, 3, 4, 5
	pop-n-left a, 2 is (1, 2)
	a.to::nat8[] is (3, 4, 5)
	pop-n a, 2 is (4, 5)
	a.to::nat8[] is (3,)
	a prepend= 2
	a.to::nat8[] is (2, 3)
	insert-at a, 1, 5
	a.to::nat8[] is (2, 5, 3)
	remove-at a, 1 is 5
	a.to::nat8[] is (2, 3)

test
	a string mut[] = ()
	insert-at a, 0, "a"
	to::string[] a is "a",
	insert-at a, 0, "b"
	to::string[] a is "b", "a"
	insert-at a, 1, "c"
	to::string[] a is "b", "c", "a"
	insert-at a, 1, "d"
	to::string[] a is "b", "d", "c", "a"

test
	a nat8 mut[] = 1, 2
	b nat8 mut[] = 3,
	swap a, b
	a.to::nat8[] is (3,)
	b.to::nat8[] is (1, 2)

| Test things we can do while iterating
test
	xs nat mut[] = 0, 1, 2
	for _ in xs
		is-empty xs is false
		xs.size is 3
		xs[1] is 1
		xs.copy.to::nat[] is (0, 1, 2)
		xs.to::nat[] is (0, 1, 2)
		xs.peek is 2
	xs.to::nat[] is (0, 1, 2)
| Test that nested iterations work, and it isn't unlocked until the last iteration finishes
test
	xs nat mut[] = 0, 1, 2
	all nat mut[] = ()
	for x in xs
		for y in xs
			xs[1] is 1
			all ~= x * 10 + y
		xs[2] is 2
		try
			xs ~= 3
			should-throw
		catch as was-locked
			()
	all.to::nat[] is (0, 1, 2, 10, 11, 12, 20, 21, 22)
	xs ~= 33
	xs.to::nat[] is (0, 1, 2, 33)
test
	test-cant-do-while-iterating {it[0] := 42}
	test-cant-do-while-iterating {it ~= 1}
	test-cant-do-while-iterating {it ~~= (1, 2)::nat[]}
	test-cant-do-while-iterating {clear it}
	test-cant-do-while-iterating of xs
		xs filter= it < 2
	test-cant-do-while-iterating {insert-at it, 1, 1}
	test-cant-do-while-iterating of xs
		xs map= it + 1
	test-cant-do-while-iterating {move-to::nat[] it}
	test-cant-do-while-iterating {pop it}
	test-cant-do-while-iterating {pop-left it}
	test-cant-do-while-iterating {pop-n it, 1}
	test-cant-do-while-iterating {pop-n-left it, 1}
	test-cant-do-while-iterating {it prepend= 1}
	test-cant-do-while-iterating {reduce-size-to it, 1}
	test-cant-do-while-iterating {remove-at it, 1}
	test-cant-do-while-iterating {swap it, it}
	test-cant-do-while-iterating {swap-at it, 1, 2}

-test-cant-do-while-iterating[t] void(f t mut(a nat mut[]))
	xs nat mut[] = 0, 1, 2
	try
		for _ in xs
			_ = f[xs]
		should-throw
	catch as was-locked
		()
	xs.to::nat[] is (0, 1, 2)

test
	xs nat mut[] = 0, 1, 2
	try
		xs map= of x
			if x == 2
				_ = xs[1]
			x + 10
		should-throw
	catch as was-locked
		()
	xs.to::nat[] is (10, 11, 2)

test
	xs nat mut[] = 0, 1, 2, 3, 4
	try
		xs filter= of x
			if x == 3
				_ = xs[1]
			is-even x
		should-throw
	catch as was-locked
		()
	xs.to::nat[] is (0, 2)

test
	xs nat mut[] = 1, 2, 3
	xs flat-map= of x
		n-of x, x
	to::nat[] xs is 1, 2, 2, 3, 3, 3
