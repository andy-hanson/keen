import
	keen/random/random
	keen/random/util
	keen/test-util/random-test

test
	()::nat64[].sort is ()
	(3, 1, 2)::nat64[].sort is (1, 2, 3)

	# Test that it's a stable sort
	arr char8[] buffer = "2a", "2b", "1a", "1b"
	arr sort= it[0]
	arr.to::char8[][] is ("1a", "1b", "2a", "2b")
	arr sort= it[1]
	arr.to::char8[][] is ("1a", "2a", "1b", "2b")

test
	xs (nat, nat)[] = (3, 1), (1, 3), (3, 2)
	sort-unique xs, it.a is (1, 3), (3, 2)

test
	test-array nat8[] = 3, 3, 3, 99, 99, 6, 6, 6, 99, 99, 9, 9, 9, 99, 99, 12, 12, 12, 99, 99, 15, 15, 15, 99, 99
	size test-array is 25
	test-array.sort[12] is 15
	median test-array is 15

test global
	random-test it.inner
-inner void(r random)
	the random = r
	values nat8[] = for _ in 0 .. (random 1 .. 50) then random
	median values is values.sort[values.size / 2]

test
	median-by (31, 57, 28), it % 10 is 57
