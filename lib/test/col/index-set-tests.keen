import
	../../../lib/col/index-set

-verify void(a index-set, expected string, expected-list nat32[])
	a.dbg is expected
	actual-list nat32[] = a.to
	actual-list is expected-list
	prev mut nat32 = 0
	for cur in a
		for x in prev .. cur
			a[x] is false
		a[cur] is true
		prev := cur + 1
	size a is size actual-list

test
	a index-set = ()
	verify a, "_", ()
	a[3] is false

	b = a ~ 8
	verify b, "[100 0 0 0 0 0 0 0]", (8,)

	count b, 0 .. 8 is 0
	count-greater-or-equal b, 8 is 1
	count b, 4 .. 8 is 0
	count b, 8 .. 9 is 1

	c = b ~~ (4, 9)
	verify c, "[310 0 0 0 0 0 0 0]", (4, 8, 9)

	try-remove c, 7 is ()
	try-add c, 8 is ()

	d = c - 8
	verify d, "[210 0 0 0 0 0 0 0]", (4, 9)

	e = filter-less c, 9
	verify e, "[110 0 0 0 0 0 0 0]", (4, 8)

	# TODO
	# filtered = filter c, it != 8
	# filtered verify "[x210]", (4, 9)

	mapped index-set = map c, 10 - it
	verify mapped, "[46 0 0 0 0 0 0 0]", (1, 2, 6)

test
	a index-set = 100,
	verify a, "[0 0 0 10 0 0 0 0]", (100,)
	b = a ~ 1000
	verify b, "([0 0 0 10 0 0 0 0] _ _ [0 0 0 0 0 0 0 100])", (100, 1000)
	c = b ~ 5000
	cv = "((([0 0 0 10 0 0 0 0] _ _ [0 0 0 0 0 0 0 100]) _ _ _) ((_ _ _ [0 0 0 0 100 0 0 0]) _ _ _) _ _)"
	verify c, cv, (100, 1000, 5000)
	d = c - 1000
	verify d, "((([0 0 0 10 0 0 0 0] _ _ _) _ _ _) ((_ _ _ [0 0 0 0 100 0 0 0]) _ _ _) _ _)", (100, 5000)
	e = c - 5000
	verify e, "([0 0 0 10 0 0 0 0] _ _ [0 0 0 0 0 0 0 100])", (100, 1000)

-to json(a index-set)
	a.to::nat32[].to
