import
	../../../lib/col/private/frozen-map

test
	a (nat64, string) frozen-map = ()
	is-empty a is true
	size a is 0
	a[0] is ()

	b (nat64, string) frozen-map = (3, "3"), (1, "1"), (5, "5"), (2, "2")
	b[0] is ()
	b[1] is "1"
	b[2] is "2"
	b[3] is "3"
	b[4] is ()
	b[5] is "5"
	b[6] is ()

	c (nat64, string) frozen-map = (3, "3"), (1, "1"), (5, "5"), (2, "2"), (8, "8")
	c[0] is ()
	c[1] is "1"
	c[2] is "2"
	c[3] is "3"
	c[4] is ()
	c[5] is "5"
	c[6] is ()
	c[7] is ()
	c[8] is "8"
	c[9] is ()

test
	a (nat64, string) frozen-map = (1, "1"), (1, "2")
	size a is 1
	a[1] is "2"
