test
	a nat8 buffer = 0, 1, 2, 3, 4
	a[1 .. 3] := (7, 8)::nat8[]
	to::nat8[] a is 0, 7, 8, 3, 4
test
	# Same test but with string to test non-TypedArray case
	a string buffer = "a", "b", "c", "d", "e"
	a[1 .. 3] := ("x", "y")::string[]
	to::string[] a is "a", "x", "y", "d", "e"

test
	a nat8 buffer = 0, 1, 2, 3, 4
	a[1 .. 3] := a[2 .. 4]
	to::nat8[] a is 0, 2, 3, 3, 4
test
	# Same test but with string to test non-TypedArray case
	a string buffer = "a", "b", "c", "d", "e"
	a[1 .. 3] := a[2 .. 4]
	to::string[] a is "a", "c", "d", "d", "e"

test
	a nat8 buffer = 0, 1, 2, 3, 4
	a[2 .. 4] := a[1 .. 3]
	to::nat8[] a is 0, 1, 1, 2, 4
test
	# Same test but with string to test non-TypedArray case
	a string buffer = "a", "b", "c", "d", "e"
	a[2 .. 4] := a[1 .. 3]
	to::string[] a is "a", "b", "b", "c", "e"
