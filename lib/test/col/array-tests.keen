import
	keen/unsafe
	../../../lib/col/array: concat-array-views

test
	xs nat[] = ()
	try
		_ = xs[0]
		should-throw
	catch x as index-too-big
		x is actual: 0, max-exclusive: 0

test
	xs nat[] = 1, 2, 3
	try
		_ = xs[4]
		should-throw
	catch x as index-too-big
		x is actual: 4, max-exclusive: 3

-to json(a index-too-big) = actual: a.actual.to, max-exclusive: a.max-exclusive.to

test
	(for::nat[] _ in ((), ())::void[] then 1) is (1, 1)

test
	(for::nat[] i, _ in with-index ((), ())::void[] then i) is (0, 1)

test
	side-effects nat mut[] = ()
	foo void[] = for x in (1, 2)::nat[]
		side-effects ~= x
	foo is ((), ())
	side-effects.move-to::nat[] is (1, 2)

test
	count mut nat32 = 0
	foo void[] = for in ((), ())::void[]
		count +:= 1
	foo is ((), ())
	count is 2

test
	a void[] = with out in build
		out ~= ()
		out ~~= ((), ())::void[]
	a.size is 3

test
	xs nat[] = for x in 1::nat .. 1
		x
	ys nat[] = for x in xs
		x + 1
	xs is ()
	ys is ()
	trusted if java
		# For performance, the bytecode uses a constant empty array for array-op-low-expr
		assert reference-equal xs, ys

test
	array-views nat array-view[] =
		- ()
		- 1, 2
		- ()
		- 3,
	concat-array-views array-views is 1, 2, 3
