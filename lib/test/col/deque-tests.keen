import
	../../col/deque

test
	a nat32 deque = ()
	assert is-empty a
	a.dbg is "[]"
	a.to::nat32[] is ()
	a.pop-left is ()
	a.pop-right is ()

	bl nat32 deque = 1 ~ a
	bl.dbg is "1 []"
	bl.to::nat32[] is (1,)
	bl.pop-left! is (1, ())
	bl.pop-right! is ((), 1)

	br = a ~ 1
	br.dbg is "[] 1"
	br.to::nat32[] is bl.to
	br.pop-left! is (1, ())
	br.pop-right! is ((), 1)

	c = bl ~ 2 ~ 3
	c.dbg is "1 [] 2 3"
	c-pop, d = pop-left! c
	c-pop is 1

	# Forces it to convert to an array
	d.dbg is "[] 2 3"
	d.pop-left! is (2, (3,))

	d-pop = pop-left! d
	d-pop.a is 2
	d-pop.b.dbg is "[3]"

	# Test converting right stack to array
	e nat32 deque = 1 ~ (2 ~ (3 ~ ()))
	e.to::nat32[] is (1, 2, 3)
	e.dbg is "1 2 3 []"
	e-pop = pop-right! e
	e-pop.b is 3
	e-pop.a.dbg is "[1 2]"

	six nat32 deque = 1 ~ (2 ~ (3, 4)) ~ 5 ~ 6
	six.dbg is "1 2 [3 4] 5 6"
	map::nat32[] six, it + 10 is (11, 12, 13, 14, 15, 16)
