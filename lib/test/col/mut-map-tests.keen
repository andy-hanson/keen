import
	keen/string/util

test
	a string mut[nat64] = ()

	a[6] := "6"
	a[5] is ()
	a[6] is "6"
	a.size is 1
	a.to::(nat64, string)[] is ((6, "6"),)

	a[6] := "six"

	a[3] := "3"

	a[4] := "4"

	a[8] := "8"

	a[4] is "4"
	a[8] is "8"
	a[5] is ()

	a.to::(nat64, string)[].sort is ((3, "3"), (4, "4"), (6, "six"), (8, "8"))

	a[12] := "12"

	remove a, 5 is ()
	remove a, 4 is "4"

	a[11] := "11"

	a filter= of key, value
		key > 10 or value == "six"

	a map-values= of key, value
		"{key}-{value}"

test
	a string mut[nat64] = (1, "one"),
	b string mut[nat64] = ()
	swap a, b
	a.to::string[nat64] is ()
	b.to::string[nat64] is ((1, "one"),)

test
	a string mut[nat64] = (1, "one"),
	remove a, 2 is ()
	a.size is 1
	remove a, 1 is "one"
	a.size is 0
	remove a, 1 is ()

test
	a string mut[nat64] = ()
	ensure a, 1, {"one"} is "one"
	ensure a, 1, {"two"} is "one"
	try
		_ = ensure a, 2, of
			a[3] := "three"
			"two"
		should-throw
	catch as was-locked
		a.size is 1
	a[2] is ()
	ensure a, 2, {"two"} is "two"

test
	a string mut[nat64] = (0, "zero"), (1, "one"), (2, "two")
	a map-values= of _, value
		try
			a[3] := "three"
			should-throw
		catch as was-locked
			()
		upper-case value
	a.to::string[nat64] is
		- 0, "ZERO"
		- 1, "ONE"
		- 2, "TWO"

test
	a string mut[nat64] = (0, "zero"), (1, "one"), (2, "two")
	a filter= of key, _
		try
			a[3] := "three"
			should-throw
		catch as was-locked
			()
		is-even key
	a.to::string[nat64] is ((0, "zero"), (2, "two"))

test
	a string mut[nat64] = (0, "zero"), (1, "one")
	calls (nat64, string) mut[] = ()
	for pair in a
		try
			_ = remove a, 0
			should-throw
		catch as was-locked
			()
		calls ~= pair
	calls.move-to::(nat64, string)[] is ((0, "zero"), (1, "one"))

test
	a string mut[nat] = (0, "zero"), (1, "one")
	res (nat, string) mut[] = ()
	# Iteration locks for writing, but supports nested iteration
	for _ in a
		for y in a
			res ~= y
	move-to::(nat, string)[] res is (0, "zero"), (1, "one"), (0, "zero"), (1, "one")
	a[2] := "two"
	move-to::(nat, string)[] a is (0, "zero"), (1, "one"), (2, "two")
