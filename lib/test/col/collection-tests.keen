test
	xs nat[] = 1, 2, 3
	xs[end - 1] is 3
	xs[end - 2] is 2
	xs[end - 3] is 1
	throws-index-too-big 3, 3, {xs[end]}
	throws-index-too-big 4, 4, {xs[end - 4]}

-throws-index-too-big[t] void(actual nat, max-exclusive nat, f t mut())
	try
		_ = f[]
		should-throw
	catch e as index-too-big
		e is actual: actual, max-exclusive: max-exclusive

-to json(a index-too-big) = actual: a.actual.to, max-exclusive: a.max-exclusive.to

test
	min-by ()::nat[], {it} is ()
	xs nat[] = 3, 1, 2
	min-by xs, {it} is 1
	max-by xs, {it} is 3

test
	xs nat[] = 53, 61, 72
	min-by xs, it % 10 is 61
	min-of xs, it % 10 is 1
	max-by xs, it % 10 is 53
	max-of xs, it % 10 is 3

test
	xs nat[] = 1, 2, 3
	r0 nat[]? = map-every xs, it + 1
	r0 is (2, 3, 4)
	r1 nat[]? = map-every xs, {if it < 3 then it + 3}
	r1 is ()
	r2 nat[]? = map-every ()::nat[], {throw unreachable}
	r2 is ()::nat[]

test
	xs nat[] = 1, 2, 3, 4, 5
	count xs, it.is-even is 2
	sum xs is 15
	sum xs, it * it is 55
