import
	keen/col/enum-set

e enum
	x
	y
	z

test
	a e enum-set = ()
	is-empty a is true
	is-full a is false
	size a is 0
	a.to::e[] is ()
	a[x] is false

	ay = a | y
	ay is y,
	ay.to::e[] is y,
	ay[x] is false
	ay[y] is true
	ay[z] is false
	is-empty ay is false
	is-full ay is false
	size ay is 1

test
	a e enum-set = all
	is-empty a is false
	is-full a is true
	size a is 3
	a is all
	a.to::e[] is x, y, z

test
	xz e enum-set = x, z
	j json = "x", "z"
	to::(e enum-set) j is xz
	to::json xz is j
