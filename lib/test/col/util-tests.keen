test
	a nat[] = 1, 2, 3, 4, 5
	take-while a, it < 3 is 1, 2

test
	a nat[] = 1, 2, 3, 4, 5
	odd nat[], even nat[] = partition a, it.is-even
	odd is 1, 3, 5
	even is 2, 4

test
	map::(nat, nat)[] (1,)::nat[].all-pairs, {it} is ()
	map::(nat, nat)[] (1, 2, 3)::nat[].all-pairs, {it} is ((1, 2), (1, 3), (2, 3))

test
	map::(nat, nat)[] (1,)::nat[].adjacent-pairs, {it} is ()
	map::(nat, nat)[] (1, 2, 3)::nat[].adjacent-pairs, {it} is (1, 2), (2, 3)

test
	a nat buffer = ()
	set-reverse a # does not throw
test
	a nat buffer = 1,
	set-reverse a
	to::nat[] a is 1,
test
	a nat buffer = 1, 2
	set-reverse a
	to::nat[] a is 2, 1
test
	a nat buffer = 1, 2, 3
	set-reverse a
	to::nat[] a is 3, 2, 1
test
	a nat buffer = 1, 2, 3, 4
	set-reverse a
	to::nat[] a is 4, 3, 2, 1
test
	a nat mut[] = 1, 2, 3, 4, 5
	set-reverse a
	to::nat[] a is 5, 4, 3, 2, 1

test
	xs nat[] = 2, 4, 6, 9, 10
	count xs, it.is-even is 4
	count-while xs, it.is-even is 3
