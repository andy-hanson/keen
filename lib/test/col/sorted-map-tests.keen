import
	../../col/sorted-map
	keen/random/random
	keen/random/util
	keen/test-util/random-test

test global
	random-test it.inner
-inner void(random random)
	the random = random
	values nat[] = unique for _ in 0 .. 1000 then random 1000 .. 2000
	a mut (nat, nat) sorted-map = ()
	for value in values
		a ~:= (value, value)
		validate a
		a[value] is value
	for value in values
		a[value] is value
	for value in values
		removed, rest = remove! a, value
		removed is value
		a := rest
		validate a
	assert is-empty a

-unique[t] t[](a t[]) t key
	set t mut-set = ()
	filter a, {try-add set, it}
