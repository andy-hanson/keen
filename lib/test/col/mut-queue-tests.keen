import
	keen/col/mut-queue

test
	a nat64 mut-queue = ()
	assert is-empty a
	a.size is 0
	a.to::nat64[] is ()

	a ~= 1
	a.to::nat64[] is (1,)
	forbid is-empty a
	a.size is 1
	dequeue a is 1
	assert is-empty a
	a.size is 0
	dequeue a is ()
	assert is-empty a

	a ~~= (2, 3, 4)::nat64[]
	a.size is 3
	to::nat64[] a is 2, 3, 4
	dequeue a is 2
	dequeue a is 3
	dequeue a is 4
	dequeue a is ()
