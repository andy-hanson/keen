import
	../../col/mut-cuckoo-filter
	keen/random/random
	keen/random/util
	keen/random/xoshiro

test
	the random = xoshiro 0
	a mut-cuckoo-filter = capacity: 4
	# Deliberately use hashes that will conflict (all multiples of capacity) to test reinsert logic
	for i in 0::nat32 .. 4
		try-add a, i * 4 is added
		for j in 0::nat32 .. i + 1
			probably-contains a, j * 4 is true
	try-add a, 28 is failed-to-add
	probably-contains a, 28 is false
	for i in 0::nat32 .. 4
		probably-contains a, i * 4 is true
		probably-contains a, i * 4 + 1 is false
		probably-contains a, i * 4 + 2 is false
		probably-contains a, i * 4 + 3 is false

test
	a mut-cuckoo-filter = capacity: 8
	try-add a, 123 is added
	probably-contains a, 123 is true
	try-add a, 123 is already-contained
	try-add a, 456 is added
	probably-contains a, 123 is true
	probably-contains a, 456 is true
	probably-contains a, 789 is false

test
	# Test rolling over max-version
	a mut-cuckoo-filter = capacity: 4
	assert-empty void mut() = of
		for j in 0::nat32 .. 16
			probably-contains a, j * 4 is false
	for i in 0::nat32 .. 16
		assert-empty[]
		try-add a, i * 4 is added
		clear a
	assert-empty[]
	try-add a, 16 * 4 is added
	probably-contains a, 16 * 4 is true

test
	the random = xoshiro 0
	n nat32 = 0x100000
	# Use an under-capacity filter to test reinserts
	a mut-cuckoo-filter = capacity: n / 2
	compare nat64 mut-set = ()
	values nat32[] = for _ in 0 .. n
		random n * 2
	false-positives mut = 0
	failed-to-add nat64 mut-set = ()
	for value in values
		added = try-add compare, value
		ta = try-add a, value
		match ta
		as already-contained
			if added
				false-positives +:= 1
		as added
			probably-contains a, value is true
			added is not failed-to-add[value]
		as failed-to-add
			failed-to-add ~= value
	false-positives is 24
	failed-to-add.size is 317
	false-positives := 0
	for value in values
		compare[value] is true
		unless failed-to-add[value]
			probably-contains a, value is true
	for _ in 0 .. n
		value = random n * 2
		actual = probably-contains a, value
		if compare[value] and not failed-to-add[value]
			actual is true
		elif actual
			false-positives +:= 1
	false-positives is 49

test
	map::nat[] 0 .. 8, it.metro-hash is
		- 0x626fdc468ff6d70e
		- 0x9cb00c463905c750
		- 0x193a41ed34c788a8
		- 0xd6ab428827404544
		- 0xd9d3e9f0ed71e67e
		- 0x55e756c0803a76a9
		- 0xa09c12b426fdd414
		- 0x3aa1a9969d17c2f2
