import
	../../col/private/sort-utils

test
	a nat64[] = 1, 5, 9
	binary-search-exact a, 5 is 1
	binary-search-exact a, 6 is ()

test
	a nat64[] = 1, 3, 5, 7
	binary-search-insert-cb a, 0::nat64 <=> it is 0
	binary-search-insert-cb a, 3::nat64 <=> it is 1
	binary-search-insert-cb a, 4::nat64 <=> it is 2
	binary-search-insert-cb a, 5::nat64 <=> it is 2
	binary-search-insert-cb a, 6::nat64 <=> it is 3
	binary-search-insert-cb a, 7::nat64 <=> it is 3
	binary-search-insert-cb a, 8::nat64 <=> it is 4

test
	merge-no-duplicates (1, 2, 3), (4, 5, 6) is (1, 2, 3, 4, 5, 6)
	merge-no-duplicates (4, 5, 6), (1, 2, 3) is (1, 2, 3, 4, 5, 6)
	merge-no-duplicates (1, 3, 5), (2, 4, 6) is (1, 2, 3, 4, 5, 6)
	merge-no-duplicates (2, 4, 6), (1, 3, 5) is (1, 2, 3, 4, 5, 6)
	merge-no-duplicates (3, 4, 5), (1, 2, 6) is (1, 2, 3, 4, 5, 6)
-merge-no-duplicates nat64[](a nat64[], b nat64[])
	a-mut nat64 mut[] = a.to
	b-mut nat64 mut[] = b.to
	merge-no-duplicates a-mut, b-mut, of x, y
		assert-comparison-not-equal x <=> y
	assert is-empty b-mut
	move-to a-mut
