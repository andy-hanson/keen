import
	keen/col/shared-array
	keen/parallel
	../private/runtime

test
	xs nat[] = for x in parallel 0::nat .. 5
		x * 2
	xs is (0, 2, 4, 6, 8)

test
	out nat mut[] = ()
	f void shared(x nat) = shared-of-mut-lambda of x
		out ~= x
	for x in parallel 0::nat .. 10
		f[x]
	out.move-to.sort::nat[] is for x in 0::nat .. 10 then x

test
	processed nat shared[] = ()
	try
		_ nat8[] = for x in parallel 1::nat8 .. 10
			processed ~= x
			250 + x
		should-throw
	catch as binary-out-of-range
		()
	sort processed.move-to::nat[] is to 1 .. 10
