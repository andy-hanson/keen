test
	1::int64 + 1 is 2
	throws-arithmetic-error {max-value::int64 + 1}
	throws-arithmetic-error {min-value::int64 + -1}
	throws-arithmetic-error {min-value::int64 + min-value}

-throws-arithmetic-error[t] void(f t mut())
	try
		_ = f[]
		should-throw
	catch as arithmetic-error
		()
test
	1::int64 - 2 is -1
	throws-arithmetic-error {max-value::int64 - -1}
	throws-arithmetic-error {min-value::int64 - 1}
	min-value::int64 - min-value is 0

test
	max-value::int64 * 0 is 0
	-1::int64 * -1 is 1
	throws-arithmetic-error {max-value::int64 / 3 * 4}
	throws-arithmetic-error {4::int64 * (max-value::int64 / 3)}
	throws-arithmetic-error {min-value::int64 * -1}
	throws-arithmetic-error {-1::int64 * min-value}
test
	3::nat32 * 5 is 15
	throws-arithmetic-error {max-value::nat32 * 2}

test
	-1.5::float.to::int64 is -2
	-1.49::float.to::int64 is -1
	1.49::float.to::int64 is 1
	1.5::float.to::int64 is 2

	4.1::float.to::nat64 is 4
	4.5::float.to::nat64 is 5
	5.5::float.to::nat64 is 6

test
	to::float32 -7::int8 is -7
	to::float32 -7::int16 is -7
	to::float32 -7::int32 is -7
	to::float32 -7::int64 is -7
	to::float32 7::nat8 is 7
	to::float32 max-value::nat8 is 255
	to::float32 max-value::nat16 is 65535
	to::float32 max-value::nat32 is 4294967295
	to::float32 max-value::nat64 is 18446744073709551615

	to::float64 -7::int8 is -7
	to::float64 -7::int16 is -7
	to::float64 -7::int32 is -7
	to::float64 -7::int64 is -7
	to::float64 7::nat8 is 7
	to::float64 max-value::nat8 is 255
	to::float64 max-value::nat16 is 65535
	to::float64 max-value::nat32 is 4294967295
	to::float64 max-value::nat64 is 18446744073709551615

test
	do trusted
	nan::float64 == nan::float64 is true
	nan::float64 <=> nan is equal

	-infinity::float64 == nan is false
	infinity::float64 <=> nan is greater
	nan::float64 <=> infinity is less

	infinity::float64 == nan is false
	-infinity::float64 <=> nan is greater
	nan::float64 <=> -infinity is less

	-0::float64 == 0 is false
	-0::float64 <=> 0 is less
	0::float64 <=> -0 is greater

	-infinity::float64 is -infinity
	infinity::float64 is infinity
	-infinity::float64 <=> infinity is less
	infinity::float64 <=> -infinity is greater

	-1::float64 <=> 1 is less
	1::float64 <=> -1 is greater
	1::float64 <=> 1 is equal
	1::float64 == 1 is true
	1::float64 == -1 is false

test
	do trusted
	-0::float64 'float-equal 0 is true
	-0::float64 'float-less 0 is false
	nan::float64 'float-equal nan is false
	infinity::float64 'float-equal nan is false
	nan::float64 'float-less infinity is false
	infinity::float64 'float-less nan is false

test
	infinity::float + infinity is infinity
	-infinity::float + -infinity is -infinity
	throws-arithmetic-error {infinity::float + -infinity}
	throws-arithmetic-error {-infinity::float + infinity}
	throws-arithmetic-error {infinity::float - infinity}

test
	throws-arithmetic-error {infinity::float - infinity}
	throws-arithmetic-error {-infinity::float - -infinity}
	infinity::float - -infinity is infinity
	-infinity::float - infinity is -infinity

test
	throws-arithmetic-error {infinity::float * 0}
	throws-arithmetic-error {-infinity::float * 0}
	throws-arithmetic-error {0::float * infinity}
	throws-arithmetic-error {0::float * -infinity}
	0::float * -0 is -0
	infinity::float * infinity is infinity
	-infinity::float * -infinity is infinity
	infinity::float * -infinity is -infinity

test
	1.499999::float64.round is 1
	1.5::float64.round is 2
test
	1.999::float64.round-down is 1
	2::float64.round-down is 2
test
	1::float64.round-up is 1
	1.001::float64.round-up is 2

test
	4::float64 ** 0.5 is 2
	-2::float64 ** -3 is -0.125
	-2::float64 ** 2 is 4
	throws-arithmetic-error {-2::float64 ** 2.001}
test
	f64 float64 = 1.23
	f64.bits-of is 4608218246714312622
	f32 float32 = 1.23
	f32.bits-of is 1067282596
	1067282596.from-bits::float32 is 1.23
	4608218246714312622.from-bits::float64 is 1.23

test
	5.4::float64 % 2.2 is 1
	-3.5::float64 % 4 is 0.5
	throws-arithmetic-error {5.4::float64 % -2.2}

test
	0 'round-up-to 3 is 0
	1 'round-up-to 3 is 3
	2 'round-up-to 3 is 3
	3 'round-up-to 3 is 3
	4 'round-up-to 3 is 6
	throws-arithmetic-error {1 'round-up-to 0}

test
	0 'divide-and-round-up 3 is 0
	1 'divide-and-round-up 3 is 1
	2 'divide-and-round-up 3 is 1
	3 'divide-and-round-up 3 is 1
	4 'divide-and-round-up 3 is 2
	5 'divide-and-round-up 3 is 2
	6 'divide-and-round-up 3 is 2
	7 'divide-and-round-up 3 is 3

test
	65535::nat16 / 256 is 255
	255::nat8 / 16 is 15

| There was a bug in the Java backend where the comparison would fail due to the number being sign-extended.
| This is why 'equalInt8' and 'equalInt16' in Keen.java are written funny.
test
	a r8 = 255,
	a.x is 255
-r8 record(x nat8)
test
	a r16 = 65535,
	a.x is 65535
-r16 record(x nat16)

test
	saturating-add 100::nat8, 150 is 250
	saturating-add 100::nat8, 200 is 255
	saturating-add 0xff00::nat16, 0x88 is 0xff88
	saturating-add 0xffff::nat16, 1 is 0xffff
	saturating-add 0xffff0000::nat32, 0x8888 is 0xffff8888
	saturating-add 0xffffffff::nat32, 1 is 0xffffffff
	saturating-add 0xffffffff00000000::nat64, 0x88888888 is 0xffffffff88888888
	saturating-add 0xffffffffffffffff::nat64, 1 is 0xffffffffffffffff

test
	saturating-subtract 100::nat8, 99 is 1
	saturating-subtract 100::nat8, 101 is 0
	saturating-subtract 100::nat16, 99 is 1
	saturating-subtract 100::nat16, 101 is 0
	saturating-subtract 100::nat32, 99 is 1
	saturating-subtract 100::nat32, 101 is 0
	saturating-subtract 100::nat64, 99 is 1
	saturating-subtract 100::nat64, 101 is 0

test
	saturating-multiply 100::nat8, 2 is 200
	saturating-multiply 150::nat8, 2 is 255
	saturating-multiply 0x7070::nat16, 2 is 0xe0e0
	saturating-multiply 0x8080::nat16, 2 is 0xffff
	saturating-multiply 0x70707070::nat32, 2 is 0xe0e0e0e0
	saturating-multiply 0x80808080::nat32, 2 is 0xffffffff
	saturating-multiply 0x7070707070707070::nat64, 2 is 0xe0e0e0e0e0e0e0e0
	saturating-multiply 0x8080808080808080::nat64, 2 is 0xffffffffffffffff

test
	clamp-to::int8 7::int32 is 7
	clamp-to::int8 200::int32 is 127
	clamp-to::int8 -200::int32 is -128
	clamp-to::int16 100000::int32 is 32767
	clamp-to::int16 -100000::int32 is -32768
	clamp-to::int32 2345678901::int64 is 2147483647
	clamp-to::int32 -2345678901::int64 is -2147483648

test
	clamp-to::int8 0x7e::nat8 is 0x7e
	clamp-to::int8 0x81::nat8 is 0x7f
	clamp-to::int16 0x7ffe::nat16 is 0x7ffe
	clamp-to::int16 0x8123::nat16 is 0x7fff
	clamp-to::int32 0x7ffffffe::nat32 is 0x7ffffffe
	clamp-to::int32 0x81234567::nat32 is 0x7fffffff
	clamp-to::int64 0x7ffffffffffffffe::nat64 is 0x7ffffffffffffffe
	clamp-to::int64 0x8000000000000001::nat64 is 0x7fffffffffffffff

test
	truncate-to::int32 1.2::float32 is 1
	truncate-to::int32 -1.2::float32 is -1
	truncate-to::int32 infinity::float32 is max-value
	truncate-to::int32 2::float32 ** 100 is max-value
	truncate-to::int32 -infinity::float32 is min-value
	truncate-to::int32 -(2::float32 ** 100) is min-value
	truncate-to::int32 trusted nan::float32 is 0

test
	truncate-to::int32 1.2::float64 is 1
	truncate-to::int32 -1.2::float64 is -1
	truncate-to::int32 infinity::float64 is max-value
	truncate-to::int32 2::float64 ** 100 is max-value
	truncate-to::int32 -infinity::float64 is min-value
	truncate-to::int32 -(2::float64 ** 100) is min-value
	truncate-to::int32 trusted nan::float64 is 0

test
	truncate-to::int64 1.2::float32 is 1
	truncate-to::int64 -1.2::float32 is -1
	truncate-to::int64 infinity::float32 is max-value
	truncate-to::int64 2::float32 ** 100 is max-value
	truncate-to::int64 -infinity::float32 is min-value
	truncate-to::int64 -(2::float32 ** 100) is min-value
	truncate-to::int64 trusted nan::float32 is 0

test
	truncate-to::int64 1.2::float64 is 1
	truncate-to::int64 -1.2::float64 is -1
	truncate-to::int64 infinity::float64 is max-value
	truncate-to::int64 2::float64 ** 100 is max-value
	truncate-to::int64 -infinity::float64 is min-value
	truncate-to::int64 -(2::float64 ** 100) is min-value
	truncate-to::int64 trusted nan::float64 is 0
