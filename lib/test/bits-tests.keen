import
	keen/bits

test
	wrap-to::nat8 0x0102030405060708::nat64 is 8
	wrap-to::nat16 0x0102030405060708::nat64 is 0x0708
	wrap-to::nat32 0x0102030405060708::nat64 is 0x05060708

	wrap-to::int8 -1::int64 is -1
	wrap-to::int8 0x0102030405060708::int64 is 8
	wrap-to::int16 -1::int64 is -1
	wrap-to::int16 0x0102030405060708::int64 is 0x0708
	wrap-to::int32 -1::int64 is -1
	wrap-to::int32 0x0102030405060708::int64 is 0x05060708

	wrap-to::int8 0x0102030405060708::nat64 is 8
	wrap-to::int8 0xffffffffffffffff::nat64 is -1
	wrap-to::int16 0x0102030405060708::nat64 is 0x0708
	wrap-to::int16 0xffffffffffffffff::nat64 is -1
	wrap-to::int32 0x0102030405060708::nat64 is 0x05060708
	wrap-to::int32 0xffffffffffffffff::nat64 is -1

	wrap-to::int64 0xffffffffffffffff::nat64 is -1
	wrap-to::nat64 -1::int64 is 0xffffffffffffffff

	wrap-to::int64 0x0102030405060708::nat64 is 0x0102030405060708
	wrap-to::nat64 0x0102030405060708::int64 is 0x0102030405060708

	wrap-to::int64 0x8000000000000000::nat64 is min-value::int64
	wrap-to::nat64 min-value::int64 is 0x8000000000000000

	wrap-to::int64 0x7fffffffffffffff is max-value::int64
	wrap-to::nat64 max-value::int64 is 0x7fffffffffffffff

test
	a nat32 = 0xffffffff
	wrap-add a, 2 is 1

test
	wrap-mul 0x11::nat8, 0x11::nat8 is 0x21
	wrap-mul 0x1111::nat16, 0x1111::nat16 is 0x4321
	wrap-mul 0x11111111::nat32, 0x11111111 is 0x87654321
	wrap-mul 0x1111111111111111::nat64, 0x1111111111111111 is 0x0fedcba987654321

test
	to-hex 0x0d15ea5e0d15ea5e::nat64 & ~7 is "d15ea5e0d15ea58"

test
	count-ones 0 is 0
	count-ones 1 is 1
	count-ones 0b100000 is 1
	count-ones 0b10101 is 3

test
	0xdeadbeefcafebabe::nat64 >> 32 is 0xdeadbeef
	0xdeadbeef::nat32 >> 16 is 0xdead
	0xdead::nat16 >> 8 is 0xde
	0xde::nat8 >> 4 is 0xd

test
	high-n-bits 0::nat32 is 0
	high-n-bits 31::nat32 is 0b11111111_11111111_11111111_11111110
	high-n-bits 32::nat32 is 0b11111111_11111111_11111111_11111111
	try
		_ nat32 = high-n-bits 33
		should-throw
	catch as arithmetic-error
		()
test
	high-n-bits 0::nat64 is 0
	high-n-bits 1::nat64 is 0b10000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000
	high-n-bits 13::nat64 is 0b11111111_11111000_00000000_00000000_00000000_00000000_00000000_00000000
	high-n-bits 63::nat64 is 0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111110
	high-n-bits 64::nat64 is 0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111

test
	low-n-bits 0::nat32 is 0
	low-n-bits 1::nat32 is 1
	low-n-bits 31::nat32 is 0b01111111_11111111_11111111_11111111
	low-n-bits 32::nat32 is 0b11111111_11111111_11111111_11111111
	try
		_ nat32 = low-n-bits 33
		should-throw
	catch as arithmetic-error
		()
test
	low-n-bits 0::nat64 is 0
	low-n-bits 1::nat64 is 1
	low-n-bits 13::nat64 is 0b11111_11111111
	low-n-bits 63::nat64 is 0b01111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111
	low-n-bits 64::nat64 is 0b11111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111

test
	log-2-rounded-down 0 is 0
	log-2-rounded-down 1 is 0
	log-2-rounded-down 2 is 1
	log-2-rounded-down 3 is 1
	log-2-rounded-down 4 is 2
	log-2-rounded-down 7 is 2
	log-2-rounded-down 8 is 3
	log-2-rounded-down 15 is 3
	log-2-rounded-down 16 is 4
	log-2-rounded-down 0x8fffffffffffffff is 63
	log-2-rounded-down 0xffffffffffffffff is 63

test
	log-2-rounded-up 0 is 0
	log-2-rounded-up 1 is 0
	log-2-rounded-up 2 is 1
	log-2-rounded-up 3 is 2
	log-2-rounded-up 4 is 2
	log-2-rounded-up 5 is 3
	log-2-rounded-up 8 is 3
	log-2-rounded-up 9 is 4
	log-2-rounded-up 16 is 4
	log-2-rounded-up 0x8000000000000000 is 63
	log-2-rounded-up 0x8000000000000001 is 64

test
	round-up-to-power-of-two 0 is 1
	round-up-to-power-of-two 1 is 1
	round-up-to-power-of-two 2 is 2
	round-up-to-power-of-two 3 is 4
	round-up-to-power-of-two 4 is 4
	round-up-to-power-of-two 5 is 8
	round-up-to-power-of-two 8 is 8
	round-up-to-power-of-two 9 is 16
	round-up-to-power-of-two 16 is 16
	round-up-to-power-of-two 17 is 32
	round-up-to-power-of-two 0x7fffffffffffffff is 0x8000000000000000
	round-up-to-power-of-two 0x8000000000000000 is 0x8000000000000000
	try
		_ = round-up-to-power-of-two 0x8000000000000001
		should-throw
	catch as arithmetic-error
		()

test
	trailing-zeroes 0 is 64
	trailing-zeroes 1 is 0
	trailing-zeroes 64 is 6

test
	word nat = 0b10101
	nth-one-bit word, 0 is 0
	nth-one-bit word, 1 is 2
	nth-one-bit word, 2 is 4
	nth-one-bit word, 3 is ()

test
	a nat16 = 0xcafe
	b nat16 = 0xbabe
	bits-cat a, b is 0xcafebabe

test
	nth-one-bit 0b10101, 0 is 0
	nth-one-bit 0b10101, 1 is 2
	nth-one-bit 0b10101, 2 is 4
	nth-one-bit 0b10101, 3 is ()
