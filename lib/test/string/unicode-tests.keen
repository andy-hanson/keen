import
	keen/string/unicode

test
	c8s char8[] = "$¥₿𝄮"
	c32s char32[] = "$¥₿𝄮"
	s = "$¥₿𝄮"

	c8s.to::string is s
	s.to::char8[] is c8s
	c32s.to::string is s
	s.to::char32[] is c32s

	"\ue000"::string.to::char32[] is "\ue000"
	"\ue000"::char32[].to::string is "\ue000"

	iter string-iterator = begin s
	next-char32 iter is "$"
	next-char32 iter is "¥"
	next-char32 iter is "₿"
	next-char32 iter is "𝄮"
	assert is-at-end iter
	prev-char32 iter is "𝄮"
	prev-char32 iter is "₿"
	prev-char32 iter is "¥"
	prev-char32 iter is "$"
	assert is-at-begin iter
