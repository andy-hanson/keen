import
	keen/random/generator-util

test
	times-called mut = 0
	my-random random32 = next32: of
		times-called +:= 1
		if is-even times-called then 0xdeadbeef else 0xcafebabe
	random = random-from-32 my-random
	next random, 1 is 0
	times-called is 0
	next random, 7 is 3
	times-called is 1
	map::nat64[] 0 .. 13, {next random, 7} is 2, 5, 6, 5, 2, 4, 3, 5, 5, 5, 5, 2, 5
	times-called is 2
	next random, 7 is 5
	times-called is 3

test
	times-called mut = 0
	my-random random64 = next64: of
		times-called +:= 1
		0xdeadbeefcafebabe
	random = random-from-64 my-random
	next random, 1 is 0
	times-called is 0
	next random, 7 is 3
	times-called is 1
	map::nat64[] 0 .. 13, {next random, 7} is 2, 5, 6, 5, 2, 4, 3, 5, 5, 5, 5, 2, 5
	times-called is 1
	next random, 7 is 5
	times-called is 2
