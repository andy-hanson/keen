import
	keen/col/counter
	keen/random/random
	../../random/util
	keen/random/xoshiro

test
	the random = xoshiro256 7
	(for _ in 0 .. 10 then random)::e[] is e2, e3, e3, e0, e2, e0, e2, e1, e1, e3
e enum(e0, e1, e2, e3)

test
	a nat buffer = 1, 2, 3, 4, 5, 6, 7
	the random = xoshiro256 7
	shuffle a
	a.to::nat[] is 3, 4, 1, 2, 7, 5, 6

test
	the random = xoshiro256 7
	randoms-with-replacement-where 1 .. 6, 3, it.is-even is 2, 4, 2
	randoms-with-replacement-where 1 .. 6, 9, it.is-even is 4, 2, 4, 2, 4, 2, 2, 4, 4
	randoms-with-replacement-where 1 .. 6, 1, it > 5 is ()

test
	the random = xoshiro256 7
	randoms-without-replacement 1 .. 6, 3 is 2, 3, 5
	randoms-without-replacement 1 .. 6, 100 is 3, 5, 1, 2, 4

test
	the random = xoshiro256 7
	randoms-without-replacement-where 1 .. 6, 3, it.is-even is 2, 4
	randoms-without-replacement-where 1 .. 6, 3, it > 5 is ()

test
	the random = xoshiro256 7
	random-where 1 .. 6, it.is-even is 2
	random-where 1 .. 6, it > 5 is ()

test
	w = weighted-choice (1, 2, 3)
	w.sum-weight is 6
	w.prob is 3, 6, 6
	w.aliases is 2, 1, 2
	the random = xoshiro256 7
	indices nat[] = for _ in 0 .. 60 then random-index w
	counts nat counter = to indices
	counts is from-pairs
		- 0, 12
		- 1, 20
		- 2, 28

test
	w = weighted-choice (3, 2, 1)
	w.sum-weight is 6
	w.prob is 6, 6, 3
	w.aliases is 0, 1, 0
	the random = xoshiro256 7
	indices nat[] = for _ in 0 .. 60 then random-index w
	counts nat counter = to indices
	counts is from-pairs
		- 0, 29
		- 1, 22
		- 2, 9

test
	w = weighted-choice (0, 1)
	the random = xoshiro256 7
	for _ in 0 .. 10
		random-index w is 1

test
	the random = xoshiro256 7
	a nat random-bag = 0, 1, 2, 3, 4

	took nat mut[] = ()
	for _ in 0 .. 5
		took ~= take-random! a
	move-to::nat[] took is 1, 3, 0, 4, 2
	is-empty a is true

	for x in 0 .. 5
		a ~= x
	for _ in 0 .. 5
		took ~= get-random! a
	move-to::nat[] took is 3, 2, 2, 3, 2
	a.size is 5
