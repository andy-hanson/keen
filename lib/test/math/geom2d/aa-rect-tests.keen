import
	keen/math/geom2d/aa-rect
	keen/math/geom2d/size2
	keen/math/vec

-unit aa-rect32()
	bottom-left: -0.5, -0.5
	top-right: 0.5, 0.5

test
	expand-to-ratio unit, (1, 2) is
		bottom-left: -0.5, -1
		top-right: 0.5, 1
	expand-to-ratio unit, (16, 9) is
		bottom-left: -8 / 9, -0.5
		top-right: 8 / 9, 0.5

test
	bounds aa-rect32 = bottom-left: (-3, -3), top-right: (3, 3)
	try-move-within bounds, bottom-left: (1, 1), top-right: (4, 4) is bottom-left: (0, 0), top-right: (3, 3)
	try-move-within bounds, bottom-left: (-3, 1), top-right: (5, 4) is bottom-left: (-4, 0), top-right: (4, 3)
