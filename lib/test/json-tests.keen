import
	keen/parse
	keen/string/util

#TODO:MOVE
-to json(a parse-error)
	# TODO: include input/iter
	expected: a.expected.to

-verify[t] void(a t, s string) (json, t) to
	j json = a.to
	parse json, s is j
	j.to-json is s

test
	try
		_ = parse json, "potato"
		should-throw
	catch e as parse-error
		e is ("potato", 0, "JSON value")
	verify ()::null, "null"
	verify true::bool, "true"
	verify false::bool, "false"
	verify -3.0::float64, "-3"
	verify 1.5::float64, "1.5"
	verify -1.5::float64, "-1.5"
	verify "j", "\"j\""
	verify "a\nb", "\"a\\nb\""
	verify "a\\nb", "\"a\\\\nb\""

	verify ()::json[], "[]"
	verify (1,)::json[], "[1]"
	verify (1, true)::json[], "[1,true]"

	verify ()::json[symbol], "\{\}"
	verify (("a", 1),)::json[symbol], "\{\"a\":1\}"
	verify (("a", 1), ("x\ny", true))::json[symbol], "\{\"a\":1,\"x\\ny\":true\}"

test
	assert ()::json < false
	assert false::json < 0
	assert 0::json < ""
	assert ""::json < empty-array
	assert empty-array::json < empty-object

test
	j json = a: 1
	j["a"] is 1
	j["b"] is null

test
	roundtrip "()", null
	roundtrip "false", false
	roundtrip "true", true
	roundtrip "1", 1
	roundtrip "-1", -1
	roundtrip "\"hello\"", "hello"
	roundtrip "empty-array", empty-array
	roundtrip "empty-object", empty-object
	roundtrip "1,", (1,)
	parse kid, "- 1" is (1,)
	roundtrip "a: 1", a: 1
	roundtrip "\"big key\": 1",
		"big key": 1

	one-two = quote
		- 1
		- 2
	parse kid, one-two is (1, 2)
	roundtrip "1, 2", (1, 2)
	a-b-c = quote
		a: 1
		b: 2
		c: 3
	parse kid, a-b-c is a: 1, b: 2, c: 3
	roundtrip "a: 1, b: 2, c: 3", a: 1, b: 2, c: 3
	k-1 = quote
		k:
			1
	parse kid, k-1 is k: 1

	k-v = quote
		k:
			- "v"
	parse kid, k-v is k: "v",
	roundtrip "k: (\"v\",)", k: "v",
	a-b-c-d = quote
		a:
			b:
				c: 1
			d: 2
	parse kid, a-b-c-d is a: (b: (c: 1), d: 2)
	parse kid, "a: b: c: 1" is a: b: c: 1
	parse kid, "a: 1, b: 2" is a: 1, b: 2
	parse kid, "a: 1, 2" is a: 1, 2
	parse kid, "(1, 2), (3, 4)" is (1, 2), (3, 4)

-roundtrip void(text string, value json)
	parse kid, text is value
	to-kid value is strip text
