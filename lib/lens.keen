no-std
import
	./private/bootstrap: new
	./misc: data, subscript
export
	./private/bootstrap: get, set, lens

| Use the lens to get the value.
| This simply changes the argument order for the 'get' function on the lens interface for better readability.
+get[t, u] u(outer t, lens (t, u) lens)
	get lens, outer

| Use the lens to set the value.
| This simply changes the argument order for the 'get' function on the lens interface for better readability.
+set[t, u] t(outer t, lens (t, u) lens, inner u)
	set lens, outer, inner

| Use the lens to get the value, modify it, then set the new value.
+modify[t, u] t(outer t, lens (t, u) lens, f u mut(x u))
	set lens, outer, f[get lens, outer]

| Lens that gets or sets two things as a tuple.
| For the setter, this sets {a} first before setting {b}.
| Generally you should use this with orthogonal properties so that the order doesn't matter.
+ +[t, u, v] (t, (u, v)) lens(a (t, u) lens, b (t, v) lens) t data, u data, v data
	get: of outer
		- get a, outer
		- get b, outer
	set: of outer, (inner0, inner1)
		set b, (set a, outer, inner0), inner1

| Lens that gets or sets a nested property.
+ *[t, u, v] (t, v) lens(a (t, u) lens, b (u, v) lens) t data, u data, v data
	get: of x
		get b, get a, x
	set: of x, value
		set a, x, set b, (get a, x), value

