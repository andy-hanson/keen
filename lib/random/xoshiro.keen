import
	keen/bits
	keen/random/random
	./generator-util

+xoshiro128 random(seed nat32)
	random-from-32 xoshiro128 seed

+xoshiro256 random(seed nat64)
	random-from-64 xoshiro256 seed

+xoshiro128 record mut, random32 case
	-state0 mut nat32
	-state1 mut nat32
	-state2 mut nat32
	-state3 mut nat32
+xoshiro128 xoshiro128(seed nat32)
	state mut = seed
	next = of::nat32
		state wrap-add:= 0x9e3779b9
		x = state ^ (state >> 16) 'wrap-mul 0x85ebca6b
		y = x ^ (x >> 13) 'wrap-mul 0xc2b2ae35
		y ^ (y >> 16)
	xoshiro128 (next[], next[], next[], next[])
+xoshiro128 xoshiro128(seed (nat32, nat32, nat32, nat32))
	seed isnt 0, 0, 0, 0
	seed.a, seed.b, seed.c, seed.d
+next32 nat32(a xoshiro128)
	result = a.state1 'wrap-mul 5 'rotate-left 7 'wrap-mul 9
	temp = a.state1 << 9
	a.state2 ^:= a.state0
	a.state3 ^:= a.state1
	a.state1 ^:= a.state2
	a.state0 ^:= a.state3
	a.state2 ^:= temp
	a.state3 rotate-left:= 11
	result

+xoshiro256 record mut, random64 case
	-state0 mut nat64
	-state1 mut nat64
	-state2 mut nat64
	-state3 mut nat64

+xoshiro256 xoshiro256(seed nat64)
	state mut = seed
	next = of::nat64
		state wrap-add:= 0x9e3779b97f4a7c15
		x = state ^ (state >> 30) 'wrap-mul 0xbf58476d1ce4e5b9
		y = x ^ (x >> 27) 'wrap-mul 0x94d049bb133111eb
		y ^ (y >> 31)
	xoshiro256 (next[], next[], next[], next[])
+xoshiro256 xoshiro256(seed (nat64, nat64, nat64, nat64))
	seed isnt 0, 0, 0, 0
	seed.a, seed.b, seed.c, seed.d

+next64 nat64(a xoshiro256)
	result = a.state0 'wrap-add a.state3 'rotate-left 23 'wrap-add a.state0
	temp = a.state1 << 17
	a.state2 ^:= a.state0
	a.state3 ^:= a.state1
	a.state1 ^:= a.state2
	a.state0 ^:= a.state3
	a.state2 ^:= temp
	a.state3 rotate-left:= 45
	result
