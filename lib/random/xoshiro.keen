import
	keen/bits
	keen/random/random
	./generator-util

+xoshiro random(seed nat64)
	random-from-64 xoshiro seed

+xoshiro record mut, random64 case
	state0 mut nat64
	state1 mut nat64
	state2 mut nat64
	state3 mut nat64

-xoshiro-seed record
	a nat64
	b nat64
	c nat64
	d nat64
-xoshiro xoshiro(seed xoshiro-seed)
	seed isnt 0, 0, 0, 0
	seed.a, seed.b, seed.c, seed.d

+xoshiro xoshiro(seed nat64)
	state mut = seed
	next = of::nat64
		state wrap-add:= 0x9e3779b97f4a7c15
		x = state ^ (state >> 30) 'wrap-mul 0xbf58476d1ce4e5b9
		y = x ^ (x >> 27) 'wrap-mul 0x94d049bb133111eb
		y ^ (y >> 31)
	xoshiro (next[], next[], next[], next[])

+next64 nat64(a xoshiro)
	result = a.state0 'wrap-add a.state3 'rotate-left 23 'wrap-add a.state0
	temp = a.state1 << 17
	a.state2 ^:= a.state0
	a.state3 ^:= a.state1
	a.state1 ^:= a.state2
	a.state0 ^:= a.state3
	a.state2 ^:= temp
	a.state3 rotate-left:= 45
	result
