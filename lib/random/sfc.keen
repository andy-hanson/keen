import
	keen/bits
	keen/random/generator-util
	keen/random/random

+sfc32 random(seed nat64)
	random-from-32 sfc32 seed

+sfc32 record mut, random32 case
	a mut nat32
	b mut nat32
	c mut nat32
	d mut nat32

+sfc32 sfc32(seed nat64)
	res sfc32 = 0, seed.wrap-to, (seed >> 32).wrap-to, 0
	for _ in 0 .. 12
		_ = next32 res
	res

+next32 nat32(a sfc32)
	temp = a.a 'wrap-add a.b 'wrap-add a.d
	a.d wrap-add:= 1
	a.a := a.b ^ (a.b >> 9)
	a.b := a.c 'wrap-add (a.c << 3)
	a.c := (a.c << 21) | (a.c >> 11)
	a.c wrap-add:= temp
	temp
