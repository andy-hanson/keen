| Utilities for writing random number generators
no-std
import
	../bits
	../compare
	../misc
	../number
	../option
	./random

| Adapts a {random64} to a {random}
+random-from-64 record mut, random case
	-bits mut nat64
	-count-bits mut nat64
	-inner random64
+random-from-64 random-from-64(inner random64) = 0, 0, inner
+next nat(a random-from-64, n nat64)
	forbid n == 0
	# Fast dice roller algorithm
	v mut = 1
	c mut = 0
	until
		if v >= n
			if c < n
				c
			else
				v -:= n
				c -:= n
				()
		else
			if a.count-bits == 0
				a.bits := next64 a.inner
				a.count-bits := 64
			v *:= 2
			c *:= 2
			c |:= a.bits & 1
			a.bits >>:= 1
			a.count-bits -:= 1
			()
+next64 nat(a random-from-64)
	next64 a.inner
