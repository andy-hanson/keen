| Utilities for writing random number generators
no-std
import
	../bits
	../compare
	../misc
	../number
	../option
	./random

| Adapts a {random64} to a {random}
+random-from-64 record mut, random case
	-bits mut nat64
	-count-bits mut nat32
	-inner random64
+random-from-64 random-from-64(inner random64) = 0, 0, inner
+next nat32(a random-from-64, n nat32)
	forbid n == 0
	# Fast dice roller algorithm
	v mut nat32 = 1
	c mut nat32 = 0
	bits mut nat32 = wrap-to a.bits
	count-bits mut nat32 = a.count-bits
	until
		if v >= n
			if c < n
				a.bits >>:= a.count-bits - count-bits
				a.count-bits := count-bits
				c
			else
				v -:= n
				c -:= n
				()
		else
			if count-bits == 0
				fetch-next-64 a
				bits := wrap-to a.bits
				count-bits := a.count-bits
			v *:= 2
			c *:= 2
			c |:= bits & 1
			bits >>:= 1
			count-bits -:= 1
			()
+next nat64(a random-from-64, n nat64)
	forbid n == 0
	# Fast dice roller algorithm
	v mut nat64 = 1
	c mut nat64 = 0
	until
		if v >= n
			if c < n
				c
			else
				v -:= n
				c -:= n
				()
		else
			if a.count-bits == 0
				fetch-next-64 a
			v *:= 2
			c *:= 2
			c |:= a.bits & 1
			a.bits >>:= 1
			a.count-bits -:= 1
			()
+next32 nat32(a random-from-64)
	if a.count-bits >= 32
		res nat32 = wrap-to a.bits
		a.count-bits -:= 32
		res
	else
		remaining nat32 = 32 - a.count-bits
		res nat32 = a.bits.wrap-to << remaining
		fetch-next-64 a
		a.bits >>:= remaining
		a.count-bits -:= remaining
		res | (a.bits.wrap-to & low-n-bits remaining)
+next64 nat64(a random-from-64)
	next64 a.inner

-fetch-next-64 void(a random-from-64)
	a.bits := next64 a.inner
	a.count-bits := 64
