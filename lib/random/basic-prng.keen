no-std
import
	../bits
	../misc
	../number
	./generator-util
	./random
	./secure-random

| This uses a truly random seed, then uses a basic algorithm  based on that
+basic-prng-random-seed random() global
	basic-prng secure-random-seed
+basic-prng random(seed nat64)
	random-from-64 state: seed

+basic-prng32 record mut, random32 case
	-state mut nat32
+new basic-prng32() = state: 0xcafebabe
+basic-prng32 basic-prng32()
	()
+new basic-prng32(seed nat32)
	state: seed
+basic-prng32 basic-prng32(seed nat32)
	state: seed
+next32 nat32(a basic-prng32)
	a.state := 0x19660d 'wrap-mul a.state 'wrap-add 0x3c6ef35f
	a.state

| Very simple and fast pseudorandom number generator.
+basic-prng64 record mut, random64 case
	-state mut nat64
+new basic-prng64()
	state: 0xdecafc0ffeecafe
+basic-prng64 basic-prng64()
	()
+new basic-prng64(seed nat64)
	state: seed
+basic-prng64 basic-prng64(seed nat64)
	state: seed
+next64 nat64(a basic-prng64)
	# Uses the value from musl
	a.state := 0x5851f42d4c957f2d 'wrap-mul a.state 'wrap-add 1
	a.state
