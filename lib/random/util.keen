no-std
import
	../col/buffer
	../col/collection
	../col/util
	../compare
	../misc
	../number
	../range
	./random

+shuffle[out, col, elem] out(a col, random random) col size, (col, elem) some, (out, elem) list-new
	buf elem buffer = map a, {it}
	shuffle-in-place buf, random
	list-new trusted cast-immutable buf

+shuffle-in-place[t] void(a t buffer, random random)
	#  Fisher-Yates shuffle
	do if a.size > 1
	for i in reverse 1 .. a.size
		swap a, i, next-in-range random, 0 .. i + 1
