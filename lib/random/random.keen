no-std
import
	../number

| Functions for using randoms are in 'keen/random/util'
+random interface mut
	next nat32(max-exclusive nat32)
	next nat64(max-exclusive nat64)
	next32 nat32()
	next64 nat64()

| Interface for generating random {nat64}s.
| This is more low-level and you probably want {random} instead.
+random64 interface mut
	next64 nat64()
