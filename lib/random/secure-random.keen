no-std
import
	java/util/Random
	java/security/SecureRandom
	../bits
	../col/buffer
	../exception
	../misc
	../number
	../js
	../unsafe
	./generator-util
	./random

+secure-random random() global
	if java
		random-from-64 secure-random
	elif js
		random-from-32 secure-random
	else
		throw todo

+secure-random-seed nat32() global
	next32 secure-random::secure-random
+secure-random-seed nat64() global
	next64 secure-random::secure-random

| This uses `SecureRandom` in Java and `crypto.getRandomValues` in JS.
+secure-random record mut, global, random32 case, random64 case
+next32 nat32(_ secure-random) global
	do trusted
	if java
		getInstanceStrong::SecureRandom.nextInt.wrap-to
	elif js
		xs nat32 buffer = 0,
		_ = call-property js-global["crypto"], "getRandomValues", reinterpret-cast xs
		xs[0]
	else
		throw todo
+next64 nat64(_ secure-random) global
	do trusted
	if java
		getInstanceStrong::SecureRandom.nextLong.wrap-to
	elif js
		xs nat32 buffer = 0, 0
		_ = call-property js-global["crypto"], "getRandomValues", reinterpret-cast xs
		bits-cat xs[0], xs[1]
	else
		throw todo
