no-std
import
	./private/bootstrap: array, float64, int64, nat64, json, string
export
	./private/bootstrap: exception, show

+todo record exception case
+show string(_ todo)
	"TODO"

+not-implemented record exception case
+show string(_ not-implemented)
	"The operation is not implemented on this platform."

| Thrown when an exception is not specified in an `assert` or `forbid`.
+error record(show string) exception case

+unreachable record exception case
+show string(_ unreachable)
	"Should be unreachable"

| Used to store inputs for {arithmetic-error}
+number union(nat64, int64, float64)
+to json(a number)
	match a
	as nat64 then a
	as int64 then a
	as float64 then a
+to number(a json)
	match a
	as nat64 then a
	as int64 then a
	as float64 then a
	else then throw todo
+arithmetic-error record(operation string, inputs number[]) exception case
+arithmetic-error arithmetic-error(operation string, input number) = operation, (input,)
+arithmetic-error arithmetic-error(operation string, a number, b number) = operation, (a, b)
-list-new[t] t[](a t[]) = a
+show string(_ arithmetic-error) = "Arithmetic operation can't return a correct value for the given inputs."
