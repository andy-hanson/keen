import
	keen/unsafe
	java/lang/ThreadLocal
	java/util/concurrent/Executors
	java/util/concurrent/ExecutorService
	java/util/concurrent/locks/ReentrantLock
	../io/process

# Called by the compiler before 'main'
~start-runtime void(args string[]) global, unsafe, java
	command-line-args := args
	cur-exclusion := ()::(ReentrantLock ThreadLocal)

# Called by the compiler after 'main'
~stop-runtime void() global, unsafe, java
	if e = executor
		shutdown e

test global, java
	# Just ensuring these are detected as used
	do if false
	do trusted
	start-runtime ()
	stop-runtime

~unlocked-exclusion record
~with-block[t] t(_ unlocked-exclusion, f t mut()) global, unsafe, java
	ex = get-cur-exclusion
	unlock ex
	finally lock ex
	f[]

# TODO: use a thread-local(ReentrantLock) (not global(ThreadLocal))
-cur-exclusion global(ReentrantLock ThreadLocal?)

-get-cur-exclusion ReentrantLock() java
	do trusted
	got = get cur-exclusion!
	if reference-equal got, gc-safe-value
		res ReentrantLock = ()
		set cur-exclusion!, res.reinterpret-cast
		lock res
		res
	else
		reinterpret-cast got

-change-exclusion-to ReentrantLock(new-exclusion ReentrantLock) java
	do trusted
	prev-exclusion = get-cur-exclusion
	unlock prev-exclusion
	set cur-exclusion!, new-exclusion.reinterpret-cast
	lock new-exclusion
	prev-exclusion

~get-executor ExecutorService() global, unsafe, java
	if executor
		executor!
	else
		res = newFixedThreadPool 4
		executor := res
		res

-executor global(ExecutorService?)

| This is called by the compiler for `shared` lambdas.
~shared-of-mut-lambda[r, p] r shared(param p)(a r mut(param p)) r shared, p shared
	trusted if java
		wrapper (r, p) force-lambda-shared = a, get-cur-exclusion
		of param
			prev-exclusion = change-exclusion-to wrapper.exclusion
			finally
				_ = change-exclusion-to prev-exclusion
			wrapper.fn[param]
	elif js
		reinterpret-cast a
	else
		throw todo
-force-lambda-shared[r, p] record force-shared
	fn r mut(param p)
	exclusion ReentrantLock
