| The compiler expects many common types to appear in this file.
no-std

region basic types

+void builtin

+option[t] builtin
| Used by the compiler internally. Options are compiled to a union of 'none' or 't'.
~none record

+array[t] builtin
+array-view[t] record
	~inner t[]
	~low nat64
	~high nat64

+buffer[t] builtin mut
+buffer-view[t] record mut
	~inner t buffer
	~low nat64
	~high nat64

| This could be any byte in a UTF-8 string.
+char8 builtin
| 32-bit Unicode character.
+char32 builtin

| Boolean type: either {false} or {true}.
+bool builtin
+false bool()
+true bool()

+symbol record
	~symbol-seeded-hash nat64
	~symbol-deterministic-hash nat64
	~symbol-chars char8[]

region number

| 8-bit natural number.
| An unsigned integer in the range 0 through 255.
+nat8 builtin
| 16-bit natural number.
| An unsigned integer in the range 0 through 65_535.
+nat16 builtin
| 32-bit natural number.
| An unsigned integer in the range 0 through 4_294_967_295 (4 billion).
+nat32 builtin
| 64-bit natural number.
| An unsigned integer in the range 0 through 18_446_744_073_709_551_615 (18 quintillion).
+nat64 builtin
| 8-bit signed integer.
| In the range -128 through 127.
+int8 builtin
| 16-bit signed integer.
| In the range -32_768 through 32_767.
+int16 builtin
| 32-bit signed integer.
| In the range -2_147_483_648 through 2_147_483_647 (-2 billion through 2 billion).
+int32 builtin
| 64-bit signed integer,
| In the range 9_223_372_036_854_775_808 through 9_223_372_036_854_775_807
| (-9 quintillion through 9 quintillion).
+int64 builtin
| 32-bit IEEE floating point number.
+float32 builtin
| 64-bit IEEE floating point number.
+float64 builtin

region tuple

+tuple2[t0, t1] record(a t0, b t1)
+tuple3[t0, t1, t2] record(a t0, b t1, c t2)
+tuple4[t0, t1, t2, t3] record(a t0, b t1, c t2, d t3)
+tuple5[t0, t1, t2, t3, t4] record(a t0, b t1, c t2, d t3, e t4)
+tuple6[t0, t1, t2, t3, t4, t5] record(a t0, b t1, c t2, d t3, e t4, f t5)
+tuple7[t0, t1, t2, t3, t4, t5, t6] record(a t0, b t1, c t2, d t3, e t4, f t5, g t6)
+tuple8[t0, t1, t2, t3, t4, t5, t6, t7] record
	a t0
	b t1
	c t2
	d t3
	e t4
	f t5
	g t6
	h t7

+lambda-data[r, p] builtin
+lambda-mut[r, p] builtin mut
+lambda-shared[r, p] builtin shared

+exception variant
	show string()

+js-any builtin js

+string record
	~chars char8[]

| Wraps a value in a mutable record.
+reference[t] record mut
	~reference-value mut t

+global spec builtin
+unsafe spec builtin
+java spec builtin
+js spec builtin
