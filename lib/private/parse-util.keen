| Parsing utilities common to both Keen and Kid.
no-std
import
	keen/bits
	keen/bool
	keen/col/array
	keen/col/collection
	keen/compare
	keen/hash
	keen/misc
	keen/number
	keen/option
	keen/string
	keen/string/unicode
	keen/symbol
	../hash: global-hash-seed
	../symbol: to-symbol-with-hash

| WARN: This peeks the next byte, which could be an invalid char8.
| Uses "\0" to indicate the end.
+peek8 char8(a string-iterator)
	try
		take-next a.copy
	catch as iterator-out-of-bounds
		"\0"

pos nat32(a string-iterator)
	a.index.to
set-pos void(a string-iterator, pos nat32)
	a.index := pos

peek8-next char8(a string-iterator)
	try
		copy = copy a
		_ = take-next copy
		take-next copy
	catch as iterator-out-of-bounds
		"\0"

take-char8-or-nul char8(a string-iterator)
	try
		take-next a
	catch as iterator-out-of-bounds
		"\0"
try-take-char8 bool(a string-iterator, x char8)
	if a.peek8 == x
		_ = take-next a
		true

string-from string(a string-iterator, start-pos nat32)
	slice-from a, start-pos 'to
slice-from string-view(a string-iterator, start-pos nat32)
	start = copy a
	start.pos := start-pos
	start 'slice a

is-utf8-initial-or-continue-code bool(a char8)
	(a.to::nat8 & top-bit) != 0
-top-bit nat8()
	0b10000000

must-take-one-unicode-char char32(a string-iterator)
	try
		next-char32 a
	catch as unicode-decode-error
		_ = take-next a
		"�"

decode-hex-digit nat8?(a char8)
	if "0"::char8 <= a and a <= "9"
		a.to - "0"::char8.to
	elif "a"::char8 <= a and a <= "f"
		10 + (a.to - "a"::char8.to)
	elif "A"::char8 <= a and a <= "F"
		10 + (a.to - "A"::char8.to)

| This does not check for keywords
try-take-keen-identifier symbol?(iter string-iterator)
	start = pos iter
	state hash-state = trusted global-hash-seed,
	if try-take-initial-identifier-char iter, state
		while try-take-one-identifier-char iter, state
			()
		trusted iter 'slice-from start 'to-symbol-with-hash state.finish
-try-take-initial-identifier-char bool(iter string-iterator, state hash-state)
	if is-initial-single-byte-identifier-char iter.peek8
		hash iter.take-next, state
		true
	else
		try-take-unicode-identifier-char iter, state
-try-take-one-identifier-char bool(iter string-iterator, state hash-state)
	if is-single-byte-identifier-char iter.peek8
		hash iter.take-next, state
		true
	else
		try-take-unicode-identifier-char iter, state

-try-take-unicode-identifier-char bool(iter string-iterator, state hash-state)
	if is-utf8-initial-or-continue-code iter.peek8
		before = iter.pos
		x = must-take-one-unicode-char iter
		if is-allowed-unicode-identifier-char x
			iter 'slice-from before 'hash state
			true
		else
			iter.pos := before
			false

| True even for keywords
is-keen-identifier bool(a string)
	iter = begin a
	try-take-keen-identifier iter and is-at-end iter

is-initial-single-byte-identifier-char bool(a char8)
	match a
	as "a" then true
	as "b" then true
	as "c" then true
	as "d" then true
	as "e" then true
	as "f" then true
	as "g" then true
	as "h" then true
	as "i" then true
	as "j" then true
	as "k" then true
	as "l" then true
	as "m" then true
	as "n" then true
	as "o" then true
	as "p" then true
	as "q" then true
	as "r" then true
	as "s" then true
	as "t" then true
	as "u" then true
	as "v" then true
	as "w" then true
	as "x" then true
	as "y" then true
	as "z" then true
	as "A" then true
	as "B" then true
	as "C" then true
	as "D" then true
	as "E" then true
	as "F" then true
	as "G" then true
	as "H" then true
	as "I" then true
	as "J" then true
	as "K" then true
	as "L" then true
	as "M" then true
	as "N" then true
	as "O" then true
	as "P" then true
	as "Q" then true
	as "R" then true
	as "S" then true
	as "T" then true
	as "U" then true
	as "V" then true
	as "W" then true
	as "X" then true
	as "Y" then true
	as "Z" then true
	as "_" then true
	else then false

-is-single-byte-identifier-char bool(a char8)
	match a
	as "a" then true
	as "b" then true
	as "c" then true
	as "d" then true
	as "e" then true
	as "f" then true
	as "g" then true
	as "h" then true
	as "i" then true
	as "j" then true
	as "k" then true
	as "l" then true
	as "m" then true
	as "n" then true
	as "o" then true
	as "p" then true
	as "q" then true
	as "r" then true
	as "s" then true
	as "t" then true
	as "u" then true
	as "v" then true
	as "w" then true
	as "x" then true
	as "y" then true
	as "z" then true
	as "A" then true
	as "B" then true
	as "C" then true
	as "D" then true
	as "E" then true
	as "F" then true
	as "G" then true
	as "H" then true
	as "I" then true
	as "J" then true
	as "K" then true
	as "L" then true
	as "M" then true
	as "N" then true
	as "O" then true
	as "P" then true
	as "Q" then true
	as "R" then true
	as "S" then true
	as "T" then true
	as "U" then true
	as "V" then true
	as "W" then true
	as "X" then true
	as "Y" then true
	as "Z" then true
	as "0" then true
	as "1" then true
	as "2" then true
	as "3" then true
	as "4" then true
	as "5" then true
	as "6" then true
	as "7" then true
	as "8" then true
	as "9" then true
	as "-" then true
	as "_" then true
	else then false

is-letter bool(a char8)
	# TODO: support other alphabets
	is-lower-case-letter a or is-upper-case-letter a
-is-lower-case-letter bool(a char8)
	"a"::char8 <= a and a <= "z"
-is-upper-case-letter bool(a char8)
	"A"::char8 <= a and a <= "Z"

-is-allowed-unicode-identifier-char bool(a char32)
	is-allowed-unicode-identifier-char a.to::nat32
-is-allowed-unicode-identifier-char bool(a nat32)
	# Latin extended
	if 0xc0::nat32 <= a and a <= 0xff and a != "×"::char32.to and a != "÷"::char32.to
		true
	# Greek and Coptic
	elif 0x370::nat32 <= a and a <= 0x3ff
		true
	# Cyrillic
	elif 0x400::nat32 <= a and a <= 0x4ff
		true
	# Hebrew
	elif 0x591::nat32 <= a and a <= 0x5f4
		true
	# Arabic
	elif 0x600::nat32 <= a and a <= 0x6ff
		true
	# Devanagari
	elif 0x904::nat32 <= a and a <= 0x97f and !(0x964::nat32 <= a and a <= 0x971)
		true
	# Bengali
	elif 0x985::nat32 <= a and a <= 0x9e3
		true
	# Gurmukhi
	elif 0xa01::nat32 <= a and a <= 0xa5e
		true
	# Gujarati
	elif 0xa81::nat32 <= a and a <= 0xaff
		true
	# Tamil
	elif 0xb82::nat32 <= a and a <= 0xbfa
		true
	# Telugu
	elif 0xc00::nat32 <= a and a <= 0xc7f
		true
	# Tibetan
	elif 0xf00::nat32 <= a and a <= 0xfda
		true
	# Latin extended additional
	elif 0x1e00::nat32 <= a and a <= 0x1eff
		true
	# Hiragana
	elif 0x3041::nat32 <= a and a <= 0x309f
		true
	# Katakana
	elif 0x30a0::nat32 <= a and a <= 0x30ff
		true
	# CJK Unified Ideographs
	elif 0x4e00::nat32 <= a and a <= 0x9fff
		true
	# Hangul
	elif 0xac00::nat32 <= a and a <= 0xd7a3
		true

indent-kind enum(tabs, spaces-2, spaces-4)
show string(a indent-kind)
	match a
	as tabs
		"tabs"
	as spaces-2
		"groups of 2 spaces"
	as spaces-4
		"groups of 4 spaces"

detect-indent-kind indent-kind(a string-iterator)
	iter = copy a
	do until
	begin = iter.pos
	match iter.peek8
	as "\0"
		tabs
	as "\t"
		tabs
	as " "
		while try-take-char8 iter, " "
			()
		n = iter.pos - begin
		if n == 2
			spaces-2
		else
			spaces-4
	else
		skip-until-newline iter
		_ = try-take-char8 iter, "\n"
		()

skip-until-newline void(a string-iterator)
	while !is-at-end a and a.peek8 != "\n"
		_ = take-next a

take-indent-amount-after-newline nat32
	iter string-iterator
	indent-kind indent-kind
	add-diag void mut(pos nat32)
do
	res = match indent-kind
	as tabs
		take-indent-chars iter, "\t", " ", add-diag
	as spaces-2
		take-indent-spaces iter, 2, add-diag
	as spaces-4
		take-indent-spaces iter, 4, add-diag
	if is-at-end iter then 0 else res
-take-indent-spaces nat32(iter string-iterator, n nat32, add-diag void mut(pos nat32))
	start = iter.pos
	n-spaces = take-indent-chars iter, " ", "\t", add-diag
	res = n-spaces / n
	if res * n != n-spaces
		add-diag[start]
	res
-take-indent-chars nat32(iter string-iterator, right-indent char8, wrong-indent char8, add-diag void mut(pos nat32))
	start = iter.pos
	while try-take-char8 iter, right-indent
		()
	res = iter.pos - start
	mid = iter.pos
	if try-take-char8 iter, wrong-indent
		while try-take-char8 iter, wrong-indent
			()
		add-diag[mid]
	res
