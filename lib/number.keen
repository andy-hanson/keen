| See also 'keen/math/math'
no-std
import
	./bool
	./compare
	./exception: todo
	./js
	./misc
	./private/bootstrap: array, exception, hash-state, json, set-state, state, string
	./private/java-math
export
	./private/bootstrap: float32, float64, int8, int16, int32, int64, nat8, nat16, nat32, nat64

+int alias
	int64
+nat alias
	nat64
+float alias
	float64

+new nat8() = 0
+new nat16() = 0
+new nat32() = 0
+new nat64() = 0
+new int8() = 0
+new int16() = 0
+new int32() = 0
+new int64() = 0
+new float32() = 0
+new float64() = 0

+ == bool(a nat8, b nat8)
+ == bool(a nat16, b nat16)
+ == bool(a nat32, b nat32)
+ == bool(a nat64, b nat64)
+ == bool(a int8, b int8)
+ == bool(a int16, b int16)
+ == bool(a int32, b int32)
+ == bool(a int64, b int64)
| This treats all {nan} values as equal, since safe code can't distinguish them.
| However, -0 is not equal to 0.
+ == bool(a float32, b float32)
+ == bool(a float64, b float64)

+ <=> comparison(a nat8, b nat8)
+ <=> comparison(a nat16, b nat16)
+ <=> comparison(a nat32, b nat32)
+ <=> comparison(a nat64, b nat64)
+ <=> comparison(a int8, b int8)
+ <=> comparison(a int16, b int16)
+ <=> comparison(a int32, b int32)
+ <=> comparison(a int64, b int64)
| The order is {nan}, -{infinity}, ..., -0, +0, ..., {infinity}
+ <=> comparison(a float32, b float32)
+ <=> comparison(a float64, b float64)

| IEEE equality: Treats '-0' and '0' as equal and {nan} as not equal to itself.
+float-equal bool(a float32, b float32)
| IEEE equality: Treats '-0' and '0' as equal and {nan} as not equal to itself.
+float-equal bool(a float64, b float64)
| IEEE less-than: Treats '-0' and '0' as equal and always compares false when some operand is {nan}.
+float-less bool(a float32, b float32)
+float-less bool(a float64, b float64)

# ~unsafe-mod int64(a int64, b int64) unsafe # TODO ------------------------------------------------------------------
-unsafe-mod nat64(a nat64, b nat64) unsafe

# The public versions of these functions are defined in bits.keen
-wrap-to int8(a int64)
-wrap-to int16(a int32)
-wrap-to int16(a int64)
-wrap-to int32(a int64)
-wrap-to int64(a nat64)
-wrap-to nat8(a nat64)
-wrap-to nat16(a nat32)
-wrap-to nat16(a nat64)
-wrap-to nat32(a nat64)
-wrap-to nat64(a int64)

-wrap-to nat8(a int8)
-wrap-to nat16(a int16)
-wrap-to nat32(a int32)

-wrap-add nat8(a nat8, b nat8)
-wrap-add nat16(a nat16, b nat16)
-wrap-add nat32(a nat32, b nat32)
-wrap-add nat64(a nat64, b nat64)

-wrap-add int8(a int8, b int8)
-wrap-add int16(a int16, b int16)
-wrap-add int32(a int32, b int32)
-wrap-add int64(a int64, b int64)

-wrap-sub nat8(a nat8, b nat8)
-wrap-sub nat16(a nat16, b nat16)
-wrap-sub nat32(a nat32, b nat32)
-wrap-sub nat64(a nat64, b nat64)

-wrap-sub int8(a int8, b int8)
-wrap-sub int16(a int16, b int16)
-wrap-sub int32(a int32, b int32)
-wrap-sub int64(a int64, b int64)

-wrap-mul nat32(a nat32, b nat32)
-wrap-mul nat64(a nat64, b nat64)

-wrap-mul int8(a int8, b int8)
-wrap-mul int16(a int16, b int16)
-wrap-mul int32(a int32, b int32)
-wrap-mul int64(a int64, b int64)

~unsafe-div nat8(a nat8, b nat8) unsafe
~unsafe-div nat16(a nat16, b nat16) unsafe
~unsafe-div nat32(a nat32, b nat32) unsafe
~unsafe-div nat64(a nat64, b nat64) unsafe
~unsafe-div int8(a int8, b int8) unsafe
~unsafe-div int16(a int16, b int16) unsafe
~unsafe-div int32(a int32, b int32) unsafe
~unsafe-div int64(a int64, b int64) unsafe

# Equivlaent to `a 'is-multiple-of 2`.
+is-even bool(a nat64)
	(trusted unsafe-mod a, 2) == 0
+is-even bool(a int64)
	is-even wrap-to::nat64 a

region constants

# Least possible value for a type.
+min-value int8()
	-0x80
+min-value int16()
	-0x8000
+min-value int32()
	-0x80000000
+min-value int64()
	-0x8000000000000000

# Greatest possible value for a type.
+max-value int8()
	0x7f
+max-value int16()
	0x7fff
+max-value int32()
	0x7fffffff
+max-value int64()
	0x7fffffffffffffff
+max-value nat8()
	0xff
+max-value nat16()
	0xffff
+max-value nat32()
	0xffffffff
+max-value nat64()
	0xffffffffffffffff

region arithmetic

| Used to store inputs for {arithmetic-error}
+number union(nat64, int64, float64)
+to json(a number)
	match a
	as nat64 then a
	as int64 then a
	as float64 then a
+to number(a json)
	match a
	as nat64 then a
	as int64 then a
	as float64 then a
	else then throw todo
+arithmetic-error record(operation string, inputs number[]) exception case
+arithmetic-error arithmetic-error(operation string, input number) = operation, (input,)
+arithmetic-error arithmetic-error(operation string, a number, b number) = operation, (a, b)
-list-new[t] t[](a t[]) = a
+show string(_ arithmetic-error) = "Arithmetic operation can't return a correct value for the given inputs."

| Throws if the result would overflow.
|
| "Overflow" means: be greater than the maximum possible value.
+ + nat8(a nat8, b nat8)
	res = wrap-add a, b
	assert res >= a else arithmetic-error "+::nat8", a, b
	res
+ + nat16(a nat16, b nat16)
	res = wrap-add a, b
	assert res >= a else arithmetic-error "+::nat16", a, b
	res
+ + nat32(a nat32, b nat32)
	res = wrap-add a, b
	assert res >= a else arithmetic-error "+::nat32", a, b
	res
+ + nat64(a nat64, b nat64)
	res = wrap-add a, b
	assert res >= a else arithmetic-error "+::nat64", a, b
	res

| Throws if the result would be negative.
+ - nat8(a nat8, b nat8)
	assert a >= b else arithmetic-error "-::nat8", a, b
	wrap-sub a, b
+ - nat16(a nat16, b nat16)
	assert a >= b else arithmetic-error "-::nat16", a, b
	wrap-sub a, b
+ - nat32(a nat32, b nat32)
	assert a >= b else arithmetic-error "-::nat32", a, b
	wrap-sub a, b
+ - nat64(a nat64, b nat64)
	assert a >= b else arithmetic-error "-::nat64", a, b
	wrap-sub a, b

| Throws if the result would overflow.
+ * nat8(a nat8, b nat8)
	res = wrap-mul a::nat32, b::nat32
	assert res <= max-value::nat8 else arithmetic-error "*::nat8", a, b
	res.wrap-to
+ * nat16(a nat16, b nat16)
	res = wrap-mul a::nat32, b::nat32
	assert res <= max-value::nat16 else arithmetic-error "*::nat16", a, b
	res.wrap-to
+ * nat32(a nat32, b nat32)
	res = wrap-mul a::nat64, b::nat64
	assert res <= max-value::nat32 else arithmetic-error "*::nat32", a, b
	res.wrap-to
+ * nat64(a nat64, b nat64)
	if a <= max-value::nat32 and b <= max-value::nat32
		# Fast path: Multiplying small numbers always works
		wrap-mul a, b
	else
		do unless a == 0 or b == 0
		res = wrap-mul a, b
		assert res / b == a and res / a == b else arithmetic-error "*::nat64", a, b
		res

| Flooring division of {a} divided by {b}.
| Throws if `b == 0`.
+ / nat8(a nat8, b nat8)
	b isnt 0 else arithmetic-error "/", a, b
	trusted unsafe-div a, b
+ / nat16(a nat16, b nat16)
	b isnt 0 else arithmetic-error "/", a, b
	trusted unsafe-div a, b
+ / nat32(a nat32, b nat32)
	b isnt 0 else arithmetic-error "/", a, b
	trusted unsafe-div a, b
+ / nat64(a nat64, b nat64)
	b isnt 0 else arithmetic-error "/", a, b
	trusted unsafe-div a, b

| Like {a} / {b} but takes the ceil instead of the floor.
+div-ceil nat64(a nat64, b nat64)
	res = a / b
	res + (res * b != a).to

| Remainder of {a} / {b}.
| Result will be in the range 0 .. {b}.
| Throws if {b} == 0.
+ % nat8(a nat8, b nat8)
	b isnt 0 else arithmetic-error "%", a, b
	trusted unsafe-mod a, b 'wrap-to
+ % nat16(a nat16, b nat16)
	b isnt 0 else arithmetic-error "%", a, b
	trusted unsafe-mod a, b 'wrap-to
+ % nat32(a nat32, b nat32)
	b isnt 0 else arithmetic-error "%", a, b
	trusted unsafe-mod a, b 'wrap-to
+ % nat64(a nat64, b nat64)
	b isnt 0 else arithmetic-error "%", a, b
	trusted unsafe-mod a, b

| This returns a {nat64} since modulo always returns a non-negative number.
+ % nat64(a int64, b nat64)
	b isnt 0 else arithmetic-error "%", a, b
	if a < 0
		abs-mod = a.abs % b
		if abs-mod != 0
			b - abs-mod
	else
		a.to::nat64 % b

-unsafe-mod float64(a float64, b float64)

+ % float32(a float32, b float32)
	a::float64 % b::float64 'to
+ % float64(a float64, b float64)
	forbid b <= 0 else arithmetic-error "%", a, b
	res = unsafe-mod a, b
	if res >= 0 then res else res + b

| {true} if `{b} * x == {a}` for some 'x'.
+is-multiple-of bool(a nat64, b nat64)
	if b == 0
		a == 0
	else
		(trusted unsafe-mod a, b) == 0

+round-down-to-multiple-of nat64(a nat64, b nat64)
	a - (a % b)

| Throws {arithmetic-error} if the result would overflow.
|
| "Overflow" means:
| Be less than the least possible value or greater than the greatest possible value.
+ + int8(a int8, b int8)
	wrap-add::int32 a, b 'to
+ + int16(a int16, b int16)
	wrap-add::int32 a, b 'to
+ + int32(a int32, b int32)
	wrap-add::int64 a, b 'to
+ + int64(a int64, b int64)
	overflow = if b > 0
		a > (wrap-sub max-value::int64, b)
	else
		a < (wrap-sub min-value::int64, b)
	forbid overflow else arithmetic-error "+::int64", a, b
	wrap-add a, b

+ - int8(a int8, b int8)
	wrap-sub::int32 a, b 'to
+ - int16(a int16, b int16)
	wrap-sub::int32 a, b 'to
+ - int32(a int32, b int32)
	wrap-sub::int64 a, b 'to
+ - int64(a int64, b int64)
	overflow = if b > 0
		a < (wrap-add min-value::int64, b)
	else
		a > (wrap-add max-value::int64, b)
	forbid overflow else arithmetic-error "-::int64", a, b
	wrap-sub a, b

+ * int8(a int8, b int8)
	wrap-mul::int32 a, b 'to
+ * int16(a int16, b int16)
	wrap-mul::int32 a, b 'to
+ * int32(a int32, b int32)
	wrap-mul::int64 a, b 'to
+ * int64(a int64, b int64)
	overflow = if a == -1
		b == min-value
	elif b == -1
		a == min-value
	elif b == 0
		false
	elif a > max-value::int64 / b
		true
	elif a < min-value::int64 / b
		true
	forbid overflow else arithmetic-error "*::int64", a, b
	wrap-mul a, b

| Negates a number.
| Same as `{a} * -1`.
|
| Throws if {a} is {min-value}.
+ - int8(a int8)
	a * -1
+ - int16(a int16)
	a * -1
+ - int32(a int32)
	a * -1
+ - int64(a int64)
	a * -1
+ - int8(a nat8)
	to -(a::nat64)
+ - int16(a nat16)
	to -(a::nat64)
+ - int32(a nat32)
	to -(a::nat64)
+ - int64(a nat64)
	if a == max-value::int64.to + 1
		min-value::int64
	else
		-(a.to::int64)

| Flooring division.
| Throws if `{b} == 0`.
| Throws if the result would overflow, which only happens if
| {a} is {min-value} and {b} is -1.
+ / int8(a int8, b int8)
	forbid b == 0 or a == min-value and b == -1 else arithmetic-error "/::int8", a, b
	trusted unsafe-div a, b
+ / int16(a int16, b int16)
	forbid b == 0 or a == min-value and b == -1 else arithmetic-error "/::int16", a, b
	trusted unsafe-div a, b
+ / int32(a int32, b int32)
	forbid b == 0 or a == min-value and b == -1 else arithmetic-error "/::int32", a, b
	trusted unsafe-div a, b
+ / int64(a int64, b int64)
	forbid b == 0 or a == min-value and b == -1 else arithmetic-error "/::int64", a, b
	trusted unsafe-div a, b

region misc

| Absolute value.
| For an integer type, throws for {min-value}.
+abs nat8(a int8)
	(if a < 0 then -a else a) 'to
+abs nat16(a int16)
	(if a < 0 then -a else a) 'to
+abs nat32(a int32)
	(if a < 0 then -a else a)::int32 'wrap-to
+abs nat64(a int64)
	(if a < 0 then -a else a) 'to

+abs float32(a float32)
	if a < 0 then -a else a
+abs float64(a float64)
	if a < 0 then -a else a

+ ** nat8(a nat8, b nat8)
	try
		to a::nat32 ** b::nat32
	catch as arithmetic-error
		throw arithmetic-error "**::nat8", a, b
+ ** nat16(a nat16, b nat16)
	try
		to a::nat32 ** b::nat32
	catch as arithmetic-error
		throw arithmetic-error "**::nat16", a, b
+ ** nat32(a nat32, b nat32)
	try
		if b == 0
			1
		elif is-even b
			(a * a) ** (b / 2)
		else
			a * a ** (b - 1)
	catch as arithmetic-error
		throw arithmetic-error "**::nat32", a, b
+ ** nat64(a nat64, b nat64)
	try
		if b == 0
			1
		elif is-even b
			(a * a) ** (b / 2)
		else
			a * a ** (b - 1)
	catch as arithmetic-error
		throw arithmetic-error "**::nat64", a, b

region float

+ + float32(a float32, b float32)
	trusted non-nan "+::float32", a, b, unsafe-add a, b
+ + float64(a float64, b float64)
	trusted non-nan "+::float64", a, b, unsafe-add a, b
+ - float32(a float32)
	a * -1
+ - float64(a float64)
	a * -1
+ - float32(a float32, b float32)
	trusted non-nan "-::float32", a, b, unsafe-sub a, b
+ - float64(a float64, b float64)
	trusted non-nan "-::float64", a, b, unsafe-sub a, b
+ * float32(a float32, b float32)
	trusted non-nan "*::float32", a, b, unsafe-mul a, b
+ * float64(a float64, b float64)
	trusted non-nan "*::float64", a, b, unsafe-mul a, b

-non-nan float32(name string, arg0 float32, arg1 float32, res float32) unsafe
	res isnt nan else arithmetic-error name, arg0, arg1
	res
-non-nan float64(name string, arg0 float64, arg1 float64, res float64) unsafe
	res isnt nan else arithmetic-error name, arg0, arg1
	res

| Returns nan for infinity + -infinity
-unsafe-add float32(a float32, b float32) unsafe
-unsafe-add float64(a float64, b float64) unsafe

-unsafe-sub float32(a float32, b float32) unsafe
-unsafe-sub float64(a float64, b float64) unsafe

| Returns nan for infinity * 0
-unsafe-mul float32(a float32, b float32) unsafe
-unsafe-mul float64(a float64, b float64) unsafe

| Divide two floats. Undefined behavior if `{b} == 0`.
-unsafe-div float32(a float32, b float32) unsafe
-unsafe-div float64(a float64, b float64) unsafe

| Throws if `{b} == 0`.
+ / float32(a float32, b float32)
	b isnt 0 else arithmetic-error "/::float32", a, b
	trusted unsafe-div a, b
+ / float64(a float64, b float64)
	b isnt 0 else arithmetic-error "/::float64", a, b
	trusted unsafe-div a, b

| {a} to the power of {b}.
| Throws {arithmetic-error} if {a} is negative and {b} is not an integer.
+ ** float32(a float32, b float32)
	a::float64 ** b::float64 'to
+ ** float64(a float64, b float64)
	trusted non-nan "**::float64", a, b, if java
		java-pow a, b
	elif js
		call-property Math, "pow", a.to, b.to 'to
	else
		throw todo

| Not-a-Number value.
| 'unsafe' because Keen generally throws exceptions instead of returning NaN.
+nan float32() unsafe
+nan float64() unsafe
+infinity float32()
+infinity float64()

region conversion

| Conversions between integral types throw on overflow or underflow.
| Conversions involving floats (in either direction) are approximate and never throw.
+to float32(a nat64)
	a.to::float64.to
+to float32(a int64)
	a.to::float64.to
+to float32(a float64)

+to float64(a nat64)
+to float64(a int64)

+to int64(a float64)
	a.round.truncate-to

+round float32(a float32)
	to round a::float64
+round float64(a float64)
	trusted if java
		sign float64 = if a < 0 then -1 else 1
		sign * a.abs.java-round.to
	elif js
		sign float64 = if a < 0 then -1 else 1
		js-round float64 = call-property Math, "round", a.abs.to 'to
		sign * js-round
	else
		throw todo
| floor
+round-down float32(a float32)
	a::float64.round-down.to
+round-down float64(a float64)
	trusted if java
		java-floor a
	elif js
		call-property Math, "floor", a.to 'to
	else
		throw todo
| ceiling
+round-up float32(a float32)
	a::float64.round-up.to
+round-up float64(a float64)
	trusted if java
		java-ceil a
	elif js
		call-property Math, "ceil", a.to 'to
	else
		throw todo

-Math js-any() js
	trusted js-global["Math"]

+to nat64(a float64)
	a.to::int64.to

+to int64(a nat64)
	assert a <= max-value::int64.to else arithmetic-error "to::int64", a
	a.wrap-to

# This is not strictly necessary since it could just implicitly convert to int64 first, but this is faster
+to nat8(a int8)
	assert a >= 0 else arithmetic-error "to::nat8", a
	wrap-to a
+to nat8(a int64)
	assert a >= 0 else arithmetic-error "to::nat8", a
	to wrap-to::nat a
+to int8(a nat64)
	assert a <= max-value::int8.to else arithmetic-error "to::int8", a
	to wrap-to::int a
+to int8(a int64)
	assert a >= min-value::int8 and a <= max-value::int8 else arithmetic-error "to::int8", a
	a.wrap-to

# This is not strictly necessary since it could just implicitly convert to int64 first, but this is faster
+to nat16(a int16)
	assert a >= 0 else arithmetic-error "to::nat16", a
	wrap-to a
+to nat16(a int64)
	assert a >= 0 else arithmetic-error "to::nat16", a
	to wrap-to::nat a
+to int16(a nat64)
	assert a <= max-value::int16.to else arithmetic-error "to::int16", a
	to wrap-to::int a
+to int16(a int32)
	assert a >= min-value::int16 and a <= max-value::int16 else arithmetic-error "to::int16", a
	wrap-to a
+to int16(a int64)
	assert a >= min-value::int16 and a <= max-value::int16 else arithmetic-error "to::int16", a
	wrap-to a

+to nat32(a int32)
	assert a >= 0 else arithmetic-error "to::nat32", a
	wrap-to a
+to nat32(a int64)
	assert a >= 0 else arithmetic-error "to::nat32", a
	to wrap-to::nat a
| Convert an int to 32 bits. Fail if the result would overflow.
+to int32(a int64)
	assert a >= min-value::int32 and a <= max-value::int32 else arithmetic-error "to::int32", a
	wrap-to a
+to int32(a nat64)
	a.to::int64.to

| Return the closest value. Never throws.
+clamp-to int32(a int64)
	if a < min-value::int32
		min-value
	elif a > max-value::int32
		max-value
	else
		wrap-to a
+clamp-to int64(a nat64)
	if a <= max-value::int64.to then wrap-to a else max-value
+clamp-to nat8(a nat64)
	if a <= max-value::nat8 then wrap-to a else max-value
+clamp-to nat16(a nat64)
	if a <= max-value::nat16 then wrap-to a else max-value
+clamp-to nat32(a nat64)
	if a <= max-value::nat32 then wrap-to a else max-value
+clamp-to nat64(a int64)
	if a >= 0 then wrap-to a
+clamp-to nat64(a float64)
	clamp-to to::int64 a

| Throws if the result would not have the same value as the input (due to overflow or underflow).
+to nat64(a int64)
	assert a >= 0 else arithmetic-error "to::nat64", a
	a.wrap-to
+to nat8(a nat64)
	assert a <= max-value::nat8 else arithmetic-error "to::nat8", a
	a.wrap-to
+to nat16(a nat32)
	assert a <= max-value::nat16 else arithmetic-error "to::nat16", a
	wrap-to a
+to nat16(a nat64)
	assert a <= max-value::nat16 else arithmetic-error "to::nat16", a
	wrap-to a
+to nat32(a nat64)
	assert a <= max-value::nat32 else arithmetic-error "to::nat32", a
	a.wrap-to

+truncate-to int64(a float64)

+bits-of nat64(a float64)
+bits-of nat32(a float32)
+from-bits float32(bits nat32)
+from-bits float64(bits nat64)

+divide-and-round-up nat64(a nat64, b nat64)
	unless a == 0
		(a - 1) / b + 1

+round-up-to nat64(a nat64, b nat64)
	remainder = a % b
	if remainder == 0
		a
	else
		a + b - remainder

region Spec impls for range

+next nat8(a nat8)
	a + 1
+next nat16(a nat16)
	a + 1
+next nat32(a nat32)
	a + 1
+next nat64(a nat64)
	a + 1
+next int8(a int8)
	a + 1
+next int16(a int16)
	a + 1
+next int32(a int32)
	a + 1
+next int64(a int64)
	a + 1

+prev nat8(a nat8)
	a - 1
+prev nat16(a nat16)
	a - 1
+prev nat32(a nat32)
	a - 1
+prev nat64(a nat64)
	a - 1
+prev int8(a int8)
	a - 1
+prev int16(a int16)
	a - 1
+prev int32(a int32)
	a - 1
+prev int64(a int64)
	a - 1

+difference nat64(a int8, b int8)
	a - b 'to
+difference nat64(a int16, b int16)
	a - b 'to
+difference nat64(a int32, b int32)
	a - b 'to
+difference nat64(a int64, b int64)
	a - b 'to

+hash void(a nat8, state hash-state)
	trusted hash a::nat64, state
+hash void(a nat16, state hash-state)
	trusted hash a::nat64, state
+hash void(a nat32, state hash-state)
	trusted hash a::nat64, state
+hash void(a nat64, state hash-state)
	do trusted
	state.state ^:= a
	state.state := 0x5851f42d4c957f2d 'wrap-mul state.state 'wrap-add 1
+hash void(a int8, state hash-state)
	trusted hash a.wrap-to::nat8, state
+hash void(a int16, state hash-state)
	trusted hash a.wrap-to::nat16, state
+hash void(a int32, state hash-state)
	trusted hash a.wrap-to::nat32, state
+hash void(a int64, state hash-state)
	trusted hash a.wrap-to::nat64, state
+hash void(a float32, state hash-state)
	trusted hash a.bits-of, state
+hash void(a float64, state hash-state)
	trusted hash a.bits-of, state

- ^ nat(a nat, b nat)

+saturating-add nat8(a nat8, b nat8)
	res = wrap-add a, b
	if res >= a then res else max-value
+saturating-add nat16(a nat16, b nat16)
	res = wrap-add a, b
	if res >= a then res else max-value
+saturating-add nat32(a nat32, b nat32)
	res = wrap-add a, b
	if res >= a then res else max-value
+saturating-add nat64(a nat64, b nat64)
	res = wrap-add a, b
	if res >= a then res else max-value
+saturating-subtract nat8(a nat8, b nat8)
	if a >= b then wrap-sub a, b
+saturating-subtract nat16(a nat16, b nat16)
	if a >= b then wrap-sub a, b
+saturating-subtract nat32(a nat32, b nat32)
	if a >= b then wrap-sub a, b
+saturating-subtract nat64(a nat64, b nat64)
	if a >= b then wrap-sub a, b
+saturating-multiply nat8(a nat8, b nat8)
	clamp-to wrap-mul a::nat32, b::nat32
+saturating-multiply nat16(a nat16, b nat16)
	clamp-to wrap-mul a::nat32, b::nat32
+saturating-multiply nat32(a nat32, b nat32)
	clamp-to wrap-mul a::nat64, b::nat64
+saturating-multiply nat64(a nat64, b nat64)
	try
		a * b
	catch as arithmetic-error
		max-value
