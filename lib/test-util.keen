no-std
import
	./compare
	./exception
	./json
	./misc
	./string

| Exception thrown by a failed `is`
+expected-equal record(a json, b json) exception case
+show string(a expected-equal)
	"Expected:\n{a a}\nis:\n{b a}"

| Exception thrown by a failed `isnt`
+expected-not-equal record(a json, b json) exception case
+show string(a expected-not-equal)
	"Expected:\n{a a}\nisnt:\n{b a}"

| Used by the compiler for an 'is' with no 'else'
~is-impl[t] void(a t, b t) t equal, t to-json
	assert a == b else expected-equal a.to, b.to

| Used by the compiler for an 'isnt' with no 'else'
~isnt-impl[t] void(a t, b t) t equal, t to-json
	forbid a == b else expected-not-equal a.to, b.to

| Use this like so:
| try
|	<<some code>>
|	should-throw
| catch x as expected-exception
|	x is <<expected value>>
+should-throw void()
	throw error "Should have thrown a different exception before getting here"
