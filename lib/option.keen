no-std
import
	./bool
	./compare
	./private/bootstrap: hash, hash-state, void
export
	./private/bootstrap: option

| Empty option.
+new[t] t?()

+ ==[t] bool(a t?, b t?) t equal
	trusted if a
		if b
			a == b
		else
			false
	elif b
		false
	else
		true
| An empty option is less than a non-empty option.
+ <=>[t] comparison(a t?, b t?) t compare
	trusted if a
		if b
			a <=> b
		else
			greater
	elif b
		less
	else
		equal
+ hash[t] void(a t?, state hash-state) t hash
	trusted ?hash a, state
