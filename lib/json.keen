no-std
import
	./bits
	./bool
	./compare
	./col/array
	./col/buffer
	./col/collection
	./col/mut-array
	./col/private/sort-utils
	./col/sort
	./col/util
	./exception
	./hash
	./misc
	./number
	./option
	./private/bootstrap: new-json-object-from-sorted
	./private/parse-util
	./range
	./string
	./string/unicode
	./symbol
	./tuple
export
	./private/bootstrap: from-json, json, json-object, keys, null, to-json, values

+is-empty bool(a json-object)
	is-empty a.keys
+size nat32(a json-object)
	size zip a.keys, a.values
+some bool(a json-object, f bool mut(key symbol, value json))
	some (zip a.keys, a.values), f
+list-new json-object(pairs (symbol, json)[])
	new-json-object (map pairs, it.a), (map pairs, it.b)
-new-json-object json-object(keys symbol[], values json[])
	sorted-keys, sorted-values = sort-by-first keys, values
	new-json-object-from-sorted sorted-keys, sorted-values
+subscript json?(a json-object, key symbol)
	a.values?[binary-search-exact a.keys, key]

+ == bool(a json-object, b json-object)
	trusted a.keys == b.keys and a.values == b.values
+ <=> comparison(a json-object, b json-object)
	trusted match res = a.keys <=> b.keys
	as equal then a.values <=> b.values
	else then res
+hash void(a json-object, state hash-state)
	do trusted
	hash a.keys, state
	hash a.values, state
+to json(a json-object) = a

+interpolate json(parts string[])
	parts.interpolate::string.to

+deserialize-error record(expected string, value json) exception case
+show string(a deserialize-error)
	"Expected to deserialize the json value as {a.expected}. Actual: {a.value}"
+to json(a deserialize-error) = expected: a.expected.to, value: a.value
+to deserialize-error(a json) = expected: a["expected"].to, value: a["value"].to

+ == bool(_ null, _ null) = trusted true
+ <=> comparison(_ null, _ null) = trusted equal
+hash void(_ null, _ hash-state) = trusted ()
+to json(a null) = a

+ == bool(a json, b json) = trusted a.as-copy == b.as-copy
+ <=> comparison(a json, b json) = trusted a.as-copy <=> b.as-copy
+hash void(a json, state hash-state) = trusted hash a.as-copy, state
# Hack to get auto funs generated here (instead of in bootstrap where they would have a bunch of specs)
-json-copy union(null, bool, nat64, int64, float64, string, json[], json-object)
-as-copy json-copy(a json)
	match a
	as null then a
	as bool then a
	as nat64 then a
	as int64 then a
	as float then a
	as string then a
	as array then a
	as json-object then a

~to-symbol-or-empty symbol(a json)
	a.string.?to else ""
~only-key-and-value (symbol, json)(a json)
	if json-object a and key = only a.keys
		key, only! a.values
	else
		"", null
~to-flags-from-json nat64(a json, expected string, member-names symbol[], member-values nat64[])
	match a
	as null
		()
	as array
		res mut nat64 = 0
		for x in a
			res |:= to-flags-from-string x, expected, member-names, member-values
		res
	else
		to-flags-from-string a, expected, member-names, member-values
-to-flags-from-string nat64(a json, expected string, member-names symbol[], member-values nat64[])
	assert string a and index = index-of member-names, a.to else deserialize-error expected, a
	member-values[index]

| If no arguments are passed this is {null}. Otherwise it is a JSON array.
| For an empty array, use {empty-array} or `()::json[]`
+list-new json(args json[])
	if is-empty args
		null
	else
		args
+named-new json(keys symbol[], values json[])
	assert keys.size == values.size
	new-json-object keys, values

+empty-array json[]() = ()
+empty-object json-object() = ()
+to json(a json) = a
+to json(_ void) = null
+to void(a json)
	assert null a else deserialize-error "void", a
+to json(a bool) = a
+to json(a char8) = a.to::string.to
+to char8(a json) = ?only string a else throw deserialize-error "char8", a
+to json(a char32) = a.to::string.to
+to char32(a json)
	res char32? = if string a then only to::char32[] a
	res else throw deserialize-error "char32", a
+to json(a string) = a
+to string(a json) = string a else throw deserialize-error "string", a
+to json(a nat8) = a
+to nat8(a json) = a.to::nat64.to
+to json(a nat16) = a
+to nat16(a json) = a.to::nat64.to
+to json(a nat32) = a
+to nat32(a json) = a.to::nat64.to
+to json(a nat64) = a
+to nat64(a json) = a.to::float64.to
+to json(a int8) = a
+to int8(a json) = a.to::int64.to
+to json(a int16) = a
+to int16(a json) = a.to::int64.to
+to json(a int32) = a
+to int32(a json) = a.to::int64.to
+to json(a int64) = a
+to int64(a json) = a.to::float64.to
+to json(a float32) = a
+to float32(a json) = a.to::float64.to
+to json(a float64) = a
+to float64(a json)
	match a
	as nat64 then a.to
	as int64 then a.to
	as float64 then a
	else then throw deserialize-error "float", a
+to json(a symbol) = a.to::string
+to symbol(a json) = a.to::string.to

+to[t] json(a t[]) t to-json
	map::json[] a, it.to
+to[t] t[](a json) t from-json
	match x = a
	as null
		()
	as array
		map x, it.to
	else
		throw deserialize-error "array", a
+to[t] json(a t array-view) t to-json
	map::json[] a, it.to
+to[t] t array-view(a json) t from-json
	to::t[] a
+to[t] json(a t buffer) t to-json
	map::json[] a, it.to
+to[t] json(a t buffer-view) t to-json
	map::json[] a, it.to
+to[t] json(a t mut[]) t to-json
	map::json[] a, it.to
+to[t] json(a t?) t to-json
	if a
		a.to
	else
		null
+to[t] t?(a json) t from-json
	unless a == null
		to::t a
+to[t0, t1] json(a (t0, t1)) t0 to-json, t1 to-json
	a.a.to, a.b.to
+to[t0, t1] (t0, t1)(a json) t0 from-json, t1 from-json
	assert x0, x1 = ?only2 array a else deserialize-error "tuple2", a
	x0.to, x1.to
+to[t0, t1, t2] json(a (t0, t1, t2)) t0 to-json, t1 to-json, t2 to-json
	a.a.to, a.b.to, a.c.to
+to[t0, t1, t2] (t0, t1, t2)(a json) t0 from-json, t1 from-json, t2 from-json
	assert x0, x1, x2 = ?only3 array a else deserialize-error "tuple3", a
	x0.to, x1.to, x2.to
+to[t0, t1, t2, t3] json(a (t0, t1, t2, t3)) t0 to-json, t1 to-json, t2 to-json, t3 to-json
	a.a.to, a.b.to, a.c.to, a.d.to
+to[t0, t1, t2, t3] (t0, t1, t2, t3)(a json) t0 from-json, t1 from-json, t2 from-json, t3 from-json
	assert x0, x1, x2, x3 = ?only4 array a else deserialize-error "tuple4", a
	x0.to, x1.to, x2.to, x3.to
+to[t0, t1, t2, t3, t4] json(a (t0, t1, t2, t3, t4)) t0 to-json, t1 to-json, t2 to-json, t3 to-json, t4 to-json
	a.a.to, a.b.to, a.c.to, a.d.to, a.e.to
+to[t0, t1, t2, t3, t4] (t0, t1, t2, t3, t4)
	a json
do t0 from-json, t1 from-json, t2 from-json, t3 from-json, t4 from-json
	assert x0, x1, x2, x3, x4 = ?only5 array a else deserialize-error "tuple5", a
	x0.to, x1.to, x2.to, x3.to, x4.to
+to[t0, t1, t2, t3, t4, t5] json
	a (t0, t1, t2, t3, t4, t5)
do t0 to-json, t1 to-json, t2 to-json, t3 to-json, t4 to-json, t5 to-json
	a.a.to, a.b.to, a.c.to, a.d.to, a.e.to, a.f.to
+to[t0, t1, t2, t3, t4, t5] (t0, t1, t2, t3, t4, t5)
	a json
do t0 from-json, t1 from-json, t2 from-json, t3 from-json, t4 from-json, t5 from-json
	assert x0, x1, x2, x3, x4, x5 = ?only6 array a else deserialize-error "tuple6", a
	x0.to, x1.to, x2.to, x3.to, x4.to, x5.to
+to[t0, t1, t2, t3, t4, t5, t6] json
	a (t0, t1, t2, t3, t4, t5, t6)
do t0 to-json, t1 to-json, t2 to-json, t3 to-json, t4 to-json, t5 to-json, t6 to-json
	a.a.to, a.b.to, a.c.to, a.d.to, a.e.to, a.f.to, a.e.to
+to[t0, t1, t2, t3, t4, t5, t6] (t0, t1, t2, t3, t4, t5, t6)
	a json
do t0 from-json, t1 from-json, t2 from-json, t3 from-json, t4 from-json, t5 from-json, t6 from-json
	assert x0, x1, x2, x3, x4, x5, x6 = ?only7 array a else deserialize-error "tuple7", a
	x0.to, x1.to, x2.to, x3.to, x4.to, x5.to, x6.to
+to[t0, t1, t2, t3, t4, t5, t6, t7] json
	a (t0, t1, t2, t3, t4, t5, t6, t7)
do t0 to-json, t1 to-json, t2 to-json, t3 to-json, t4 to-json, t5 to-json, t6 to-json, t7 to-json
	a.a.to, a.b.to, a.c.to, a.d.to, a.e.to, a.f.to, a.e.to, a.f.to
+to[t0, t1, t2, t3, t4, t5, t6, t7] (t0, t1, t2, t3, t4, t5, t6, t7)
	a json
do t0 from-json, t1 from-json, t2 from-json, t3 from-json, t4 from-json, t5 from-json, t6 from-json, t7 from-json
	assert x0, x1, x2, x3, x4, x5, x6, x7 = ?only8 array a else deserialize-error "tuple8", a
	x0.to, x1.to, x2.to, x3.to, x4.to, x5.to, x6.to, x7.to

+to json(a comparison)
	match a
	as less then "less"
	as equal then "equal"
	as greater then "greater"
+to comparison(a json)
	match to-symbol-or-empty a
	as less then less
	as equal then equal
	as greater then greater
	else then throw deserialize-error "comparison", a
+to[t] json(a t range) t to-json
	low: a.low.to
	high: a.high.to
+to[t] t range(a json) t from-json, t equal, t compare
	a["low"].to .. a["high"].to

| If {a} is an `object` containing the key {key}, returns the associated value.
| Returns `null` if any of these is true:
| * {a} is not an object.
| * {a} is an object, but does not have {key}.
| * {a} is an object with the key, and its value is {null}.
|
| Most code does not care about this distinction.
| If you do, you can test `if {json-object} {a}` or `if {has-key} {a}, {key}`.
+subscript json(a json, key symbol)
	a.json-object?[key] else null

| {true} if {a} is an object and {key} is one of its keys.
+has-key bool(a json, key symbol)
	a.json-object?[key]

+to bool(a json)
	bool a else
		assert a == null else deserialize-error "bool", a
		false

| By default, json is shown using Kid syntax.
+show string(a json)
	to-kid a

| Converts a value to {json} and renders it as standard JSON.
+to-json[t] string(a t) t to-json
	match x = a.to::json
	as null
		"null"
	as bool
		"{x}"
	as nat64
		"{x}"
	as int64
		"{x}"
	as float64
		"{x}"
	as string
		quoted x, false
	as array
		"[{join ",", map x, it.to-json}]"
	as json-object
		parts = join ",", for k, v in zip x.keys, x.values
			"{quoted k.to, false}:{to-json v}"
		"\{{parts}\}"

-to-quote string[](a string)
	lines = split a, "\n"
	do with out in build lines.size + 1
	out ~= "quote"
	do for line in lines
	out ~= with out-line in build line.size
		out-line ~= "\t"
		do for x in line
		if esc = escape x, true
			out-line ~~= esc
		else
			out-line ~= x

-quoted string(a string, is-kid bool)
	do with out in build
	out ~= "\""
	for x in a
		if esc = escape x, is-kid
			out ~~= esc
		else
			out ~= x
	out ~= "\""

-escape char8[]?(a char8, is-kid bool)
	match a
	as "\"" then "\\\""
	as "\n" then "\\n"
	as "\r" then "\\r"
	as "\t" then "\\t"
	as "\\" then "\\\\"
	as "\{" then if is-kid then "\\\{"
	as "\}" then if is-kid then "\\\}"
	as "\0" then "\\0"
	else then ()

+omit-null-values json(a json)
	match a
	as json-object
		filter::json-object a, it.b.null.not
	else
		a

+omit-empty-values json(a json)
	match a
	as json-object
		filter::json-object a, it.b.is-empty-value.not
	else
		a

| For every object in the json value, omit a key if the value is null, an empty array, or an empty object.
+deep-omit-empty-values json(a json)
	match a
	as array
		map a, it.deep-omit-empty-values
	as json-object
		to with::json-object out in build
			for k, v in a
				unless is-empty-value v
					out ~= k, deep-omit-empty-values v
	else
		a
-is-empty-value bool(a json)
	match a
	as null
		true
	as array
		is-empty a
	as json-object
		is-empty a
	else
		false

| Converts a value to {json} and renders it as Kid.
+to-kid[t] string(a t) t to-json
	match x = to-kid-inner a.to, 100
	as lines
		join "\n", x.lines
	as single
		text x
-to-kid-result union(lines, single)
-lines record(lines string[])
-single record(text string, needs-parens bool)
-parenthesize string(a single)
	if a.needs-parens then "({a.text})" else a.text
-to-kid-inner to-kid-result(a json, max-columns nat32)
	match a
	as null
		single "()", false
	as bool
		single "{a}", false
	as nat64
		single "{a}", false
	as int64
		single "{a}", false
	as float
		single "{a}", false
	as string
		if contains a, "\n"
			lines to-quote a
		else
			single (quoted a, true), false
	as array
		if is-empty a
			single "empty-array", false
		else
			to-kid-array-or-object (), a, max-columns
	as json-object
		if is-empty a
			single "empty-object", false
		else
			to-kid-array-or-object a.keys, a.values, max-columns
-tab-size nat32()
	4
-to-kid-array-or-object to-kid-result(keys symbol[]?, values json[], max-columns nat32)
	forbid is-empty values
	if keys
		assert keys.size == values.size
	size mut nat32 = 0
	multi-line mut = false
	parts to-kid-result[] = for index, x in with-index values
		key-size = if keys then keys[index].quote-if-necessary.size + ": ".size
		part = to-kid-inner x, saturating-subtract max-columns, tab-size + key-size
		match part
		as lines
			multi-line := true
		as single
			if keys
				size +:= key-size + 1
			size +:= part.text.size
		part
	size +:= ", ".size * values.size - 1
	if multi-line or size > max-columns
		lines: with out in build
			do for index, part in with-index parts
			key = if keys then "{quote-if-necessary keys[index]}:" else "-"
			match part
			as lines
				out ~= key
				for line in part.lines
					out ~= "\t{line}"
			as single
				out ~= "{key} {part.text}"
	else
		text = join ", ", for index, part in with-index parts
			p = parenthesize part.single!
			if keys then "{quote-if-necessary keys[index]}: {p}" else p
		text: if not keys and parts.size == 1 then "{text}," else text
		needs-parens: true
-quote-if-necessary string(key symbol)
	s string = key.to
	if is-keen-identifier s then s else quoted s, true
