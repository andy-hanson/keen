no-std
import
	./bits
	./bool
	./compare
	./col/array
	./col/buffer
	./col/collection
	./col/map
	./col/mut-array
	./col/set
	./col/util
	./exception
	./hash
	./misc
	./number
	./option
	./private/parse-util
	./range
	./string
	./string/unicode
	./symbol
	./tuple

| JSON data.
| The representation is deliberately opaque to allow precise representation of numbers.
| Generally you should use 'to::t' to read a JSON value as the type you expect it to be.
| If you really need to match on a json value, use {simplify}.
+json record
	-inner json-inner
-json-inner union(null, bool, nat64, int64, float64, string, json[], json[symbol])

+interpolate json(parts string[])
	parts.interpolate::string.to

+deserialize-error record(expected string, value json) exception case
+show string(a deserialize-error)
	"Expected to deserialize the json value as {a.expected}. Actual: {a.value}"
+to json(a deserialize-error) = expected: a.expected.to, value: a.value
+to deserialize-error(a json) = expected: a["expected"].to, value: a["value"].to

+json-simplified union(null, bool, float64, string, json[], json[symbol])
+simplify json-simplified(a json)
	match x = a.inner
	as null
		null
	as bool
		x
	as nat
		x.to::float64
	as int
		x.to::float64
	as float
		x
	as string
		x
	as array
		x
	as map
		x

+ == bool(a json, b json)
	# TODO: We should actually just use the auto fun. But make sure '1' parses as a nat consistently!
	trusted a.simplify == b.simplify
+ <=> comparison(a json, b json)
	trusted a.simplify <=> b.simplify
+hash void(a json, state hash-state)
	trusted hash a.simplify, state

~to-symbol-or-empty symbol(a json)
	a.inner.string.?to else ""
~only-key-and-value (symbol, json)(a json)
	a.inner.map.?only else ("", null)
~to-flags-from-json nat(a json, expected string, member-names symbol[], member-values nat[])
	match inner = a.inner
	as null
		()
	as array
		res mut nat = 0
		for x in inner
			res |:= to-flags-from-string x, expected, member-names, member-values
		res
	else
		to-flags-from-string a, expected, member-names, member-values
-to-flags-from-string nat(a json, expected string, member-names symbol[], member-values nat[])
	s = a.inner
	assert string s and index = index-of member-names, s.to else deserialize-error expected, a
	member-values[index]

+null record
+to json(a null) = a,

| If no arguments are passed this is {null}. Otherwise it is a JSON array.
| For an empty JSON array, use `()::json[] to`
+list-new json(args json[])
	if is-empty args
		null
	else
		- args
+named-new json(keys symbol[], values json[])
	assert keys.size == values.size
	map json[symbol] = for i in 0::nat .. keys.size
		keys[i], values[i]
	map.to

+null json()
	inner: ()::null
+false json()
	inner: false::bool
+true json()
	inner: true::bool
+empty-array json()
	()::json[].to
+empty-object json()
	()::json[symbol].to
+to json(a json)
	a
+to json(_ void)
	null
+to void(a json)
	assert a.inner.null else deserialize-error "void", a
+to json(a bool)
	inner: a
+to json(a char8)
	a.to::string.to
+to char8(a json)
	?only string a.inner else throw deserialize-error "char8", a
+to json(a char32)
	a.to::string.to
+to char32(a json)
	res char32? = if x = a.inner.string then only to::char32[] x
	res else throw deserialize-error "char32", a
+to json(a string)
	inner: a
+to string(a json)
	string a.inner else throw deserialize-error "string", a
+to json(a nat8)
	a::nat64.to
+to nat8(a json)
	a.to::nat64.to
+to json(a nat16)
	a::nat64.to
+to nat16(a json)
	a.to::nat64.to
+to json(a nat32)
	a::nat64.to
+to nat32(a json)
	a.to::nat64.to
+to json(a nat64)
	inner: a
+to nat64(a json)
	a.to::float64.to
+to json(a int8)
	a::int64.to
+to int8(a json)
	a.to::int64.to
+to json(a int16)
	a::int64.to
+to int16(a json)
	a.to::int64.to
+to json(a int32)
	a::int64.to
+to int32(a json)
	a.to::int64.to
+to json(a int64)
	inner: a
+to int64(a json)
	a.to::float64.to
+to json(a float32)
	a.to::float64.to
+to float32(a json)
	a.to::float64.to
+to json(a float64)
	inner: a
+to float64(a json)
	match x = a.inner
	as nat64 then x.to
	as int64 then x.to
	as float64 then x
	else then throw deserialize-error "float", a
+to json(a symbol)
	a.to::string.to
+to symbol(a json)
	a.to::string.to

+to[t] json(a t[]) (json, t) to
	- map::json[] a, it.to
+to[t] t[](a json) (t, json) to
	match x = a.inner
	as null
		()
	as array
		map x, it.to
	else
		throw deserialize-error "array", a
+to[t] json(a t array-view) (json, t) to
	- map::json[] a, it.to
+to[t] t array-view(a json) (t, json) to
	to::t[] a
+to[t] json(a t buffer) (json, t) to
	- map::json[] a, it.to
+to[t] json(a t buffer-view) (json, t) to
	- map::json[] a, it.to
+to[t] json(a t mut[]) (json, t) to
	- map::json[] a, it.to
+to[t] json(a t set) (json, t) to, t key
	- map::json[] a, it.to
+to[t] t set(a json) (t, json) to, t key
	a.to::t[].to
+to[k, v] json(a v[k]) k key, (json, k) to, (json, v) to
	parts (json, json)[] = for key, value in a
		key.to, value.to
	if every parts, it.a.inner.string
		inner:
			:: json[symbol]
			for k, v in parts then k.inner.string!.to, v.to
	else
		parts.to
+to[k, v] v[k](a json) k key, (k, json) to, (v, json) to
	match x = a.inner
	as null
		()
	as array
		for value in x
			to::(k, v) value
	as map
		for k, v in x
			k.to::json.to::k, v.to::v
	else
		throw deserialize-error "map", a
+to[t] json(a t?) (json, t) to
	if a
		a.to
	else
		null
+to[t] t?(a json) (t, json) to
	unless a == null
		to::t a
+to[t, u] json(a (t, u)) (json, t) to, (json, u) to
	a.a.to, a.b.to
+to[t, u] (t, u)(a json) (t, json) to, (u, json) to
	assert t, u = ?only2 array a.inner else deserialize-error "tuple2", a
	t.to, u.to
+to[t, u, v] json(a (t, u, v)) (json, t) to, (json, u) to, (json, v) to
	a.a.to, a.b.to, a.c.to
+to[t, u, v] (t, u, v)(a json) (t, json) to, (u, json) to, (v, json) to
	assert t, u, v = ?only3 array a.inner else deserialize-error "tuple3", a
	t.to, u.to, v.to
+to json(a comparison)
	match a
	as less then "less"
	as equal then "equal"
	as greater then "greater"
+to comparison(a json)
	match to-symbol-or-empty a
	as less then less
	as equal then equal
	as greater then greater
	else then throw deserialize-error "comparison", a
+to[t] json(a t range) (json, t) to
	low: a.low.to
	high: a.high.to
+to[t] t range(a json) (t, json) to, t equal, t compare
	a["low"].to .. a["high"].to

| If {a} is an `object` containing the key {key}, returns the associated value.
| Returns `null` if any of these is true:
| * {a} is not an object.
| * {a} is an object, but does not have {key}.
| * {a} is an object with the key, and its value is {null}.
|
| Most code does not care about this distinction.
| If you do, you can test `if {a}.{simplify} {map}` or `if {a} {has-key} {key}`.
+subscript json(a json, key symbol)
	a.inner.map?[key] else null

| {true} if {a} is an object and {key} is one of its keys.
+has-key bool(a json, key symbol)
	(x = a.inner.map) and x[key]

| `a bool-or-null` is like `a bool`, but treats {null} as {false}.
+to bool(a json)
	a.inner.bool else
		assert a == null else deserialize-error "bool", a
		false

| By default, json is shown using Kid syntax.
+show string(a json)
	to-kid a

| Converts a value to {json} and renders it as standard JSON.
+to-json[t] string(a t) (json, t) to
	match x = a.to.inner
	as null
		"null"
	as bool
		"{x}"
	as nat64
		"{x}"
	as int64
		"{x}"
	as float64
		"{x}"
	as string
		quoted x
	as array
		"[{join ",", map x, it.to-json}]"
	as map
		parts = join ",", for k, v in x
			"{quoted k.to}:{to-json v}"
		"\{{parts}\}"

-quoted string(a string)
	do with out in build
	out ~= "\""
	for x in a
		match x
		as "\""
			out ~~= "\\\""
		as "\n"
			out ~~= "\\n"
		as "\r"
			out ~~= "\\r"
		as "\t"
			out ~~= "\\t"
		as "\\"
			out ~~= "\\\\"
		as "\0"
			out ~~= "\\0"
		else
			out ~= x
	out ~= "\""

+omit-empty-values json(a json)
	match x = a.inner
	as map
		filter::json[symbol] x, it.b.is-empty-value.not 'to
	else
		a

| For every object in the json value, omit a key if the value is null, an empty array, or an empty object.
+deep-omit-empty-values json(a json)
	match x = a.inner
	as array
		map x, it.deep-omit-empty-values
	as map
		res json[symbol] = with out in build
			for k, v in x
				unless is-empty-value v
					out ~= k, deep-omit-empty-values v
		res.to
	else
		a
-is-empty-value bool(a json)
	match x = a.inner
	as null
		true
	as array
		is-empty x
	as map
		is-empty x
	else
		false

| Converts a value to {json} and renders it as Kid.
+to-kid[t] string(a t) (json, t) to
	match x = to-kid-inner a.to, 100
	as lines
		join "\n", x.lines
	as single
		text x
-to-kid-result union(lines, single)
-lines record(lines string[])
-single record(text string, needs-parens bool)
-parenthesize string(a single)
	if a.needs-parens then "({a.text})" else a.text
-to-kid-inner to-kid-result(value json, max-columns nat)
	match x = value.inner
	as null
		single "()", false
	as bool
		single "{x}", false
	as nat64
		single "{x}", false
	as int64
		single "{x}", false
	as float
		single "{x}", false
	as string
		single x.quoted, false
	as array
		if is-empty x
			single "empty-array", false
		else
			to-kid-array-or-object (), x, max-columns
	as map
		if is-empty x
			single "empty-object", false
		else
			to-kid-array-or-object x.keys, x.values, max-columns
-tab-size nat()
	4
-to-kid-array-or-object to-kid-result(keys symbol[]?, values json[], max-columns nat)
	forbid is-empty values
	if keys
		assert keys.size == values.size
	size mut = 0
	multi-line mut bool = false
	parts to-kid-result[] = for index, x in with-index values
		key-size = if keys then keys[index].quote-if-necessary.size + ": ".size
		part = to-kid-inner x, safe-subtract max-columns, tab-size + key-size
		match part
		as lines
			multi-line := true
		as single
			if keys
				size +:= key-size + 1
			size +:= part.text.size
		part
	size +:= ", ".size * values.size - 1
	if multi-line or size > max-columns
		lines: with out in build
			do for index, part in with-index parts
			key = if keys then "{quote-if-necessary keys[index]}:" else "-"
			match part
			as lines
				out ~= key
				for line in part.lines
					out ~= "\t{line}"
			as single
				out ~= "{key} {part.text}"
	else
		text = join ", ", for index, part in with-index parts
			p = parenthesize part.single!
			if keys then "{quote-if-necessary keys[index]}: {p}" else p
		text: if not keys and parts.size == 1 then "{text}," else text
		needs-parens: true
-safe-subtract nat(a nat, b nat)
	if a >= b then a - b else 0
-quote-if-necessary string(key symbol)
	s string = key.to
	if is-keen-identifier s then s else quoted s
