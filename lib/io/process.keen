import
	java/io/File
	java/lang/Process
	java/lang/ProcessBuilder
	java/lang/String
	java/lang/System
	java/nio/file/Files
	keen/js
	../java

+command-line-args string[]() global
	trusted command-line-args-global
~set-command-line-args void(args string[]) global
	trusted command-line-args-global := args
-command-line-args-global global(string[]) = ()

+exit-process void(exit-code int32) global
	if java
		trusted exit exit-code
	elif js
		_ = trusted call-property js-global["process"], "exit", exit-code.to
	else
		throw todo

| Represents the output of running a process.
+process-result record(exit process-exit, stdout string, stderr string)

+process-exit union(exited, signaled)
+exited record(exit-code int32)
+signaled record(signal int32)

+has-error bool(a process-result)
	not is-empty a.stderr or match x =  exit a
	as exited
		x.exit-code != 0
	as signaled
		true

| Run a process that inherits this process' standard input and output streams.
+run-process-and-inherit-io int32(exe string, args string[]) global
	do trusted
	assert java else todo
	all-args String buffer = map exe ~ args, it.to
	pb ProcessBuilder = all-args,
	_ = inheritIO pb
	process = start pb
	waitFor process

| Run a process and wait for it to complete.
| {exe} should be a file path and not just a name; this does not search the system path for {exe}.
+run-process process-result(exe string, args string[]) global
	run-process exe, args, ()
+run-process-options record
	cwd string?
+new run-process-options() = ()
+run-process process-result(exe string, args string[], options run-process-options) global
	do trusted
	assert java else todo
	all-args String buffer = map exe ~ args, it.to
	pb ProcessBuilder = all-args,
	temp-out = createTempFile "stdout-", ".txt"
	finally delete toPath temp-out
	temp-err = createTempFile "stderr-", ".txt"
	finally delete toPath temp-err
	_ = redirectOutput pb, temp-out
	_ = redirectError pb, temp-err
	if options.cwd
		_ = directory pb, (options.cwd.to,)
	process = start pb
	exit: exited waitFor process
	stdout: temp-out.toPath.readString.to
	stderr: temp-err.toPath.readString.to

| Launches a process and synchronously waits on the result.
| The child process shares stdout and stderr with the parent process.
+spawn-and-wait process-exit(_ string, _ string[]) global
	throw todo

| Executes a shell command and returns its output.
+shell-exec string(_ string) global
	throw todo
