import
	keen/unsafe
	java/io/InputStream
	java/lang/System
	./print

| Reads a line from stdin.
| If that comes from the user typing at the terminal, this will block until they hit enter.
| Result will not have leading or trailing whitespace.
+read-stdin string() global
	to with::char8[] out in build
		do until
		c char8 = read-one-byte-from-stdin.to
		if c == "\n"
			true
		else
			if c != "\r"
				out ~= c
			false

+stdin-has-input bool() global
	do trusted
	assert java else todo
	in.available != 0

+read-one-byte-from-stdin nat8() global
	do trusted
	assert java else todo
	in.read.to

+read-n-bytes-from-stdin nat8[](size nat32) global
	first = read-up-to-n-bytes-from-stdin size
	if first.size == size
		first
	else
		res nat8 mut[] = ()
		res ~~= first
		while res.size < size
			res ~~= read-up-to-n-bytes-from-stdin size - res.size
		res.size is size
		res.move-to

+read-up-to-n-bytes-from-stdin nat8[](max-size nat32) global
	do trusted
	assert java else todo
	buffer int8 buffer = uninitialized-buffer max-size
	bytes-read int32  = read in, buffer
	assert bytes-read <= buffer.size.to else unreachable
	safe-reinterpret-cast buffer[0 .. bytes-read.to].to

| Keep reading from stdin until {parse} returns a non-empty option.
| Print {error-message} after every failure.
+read-stdin-until-parse[t] t
	error-message string
	parse t? mut(input string)
do global, t shared
	until res = parse[read-stdin]
		print error-message
	res
