| Represents an amount of time.
| This is allowed to be negative.
+duration record
	| Number of seconds in {a}.
	seconds float64
+to json(a duration)
	show a
+to duration(_ json)
	throw todo
+ + duration(a duration, b duration)
	a.seconds + b.seconds,
+ - duration(a duration, b duration)
	a.seconds - b.seconds,

| 0 duration.
+new duration() = (),

| Duration of {a} seconds.
+seconds duration(a float64) = a,
| Duration of {a} milliseconds.
+milliseconds duration(a float64) = a * 0.001,
| Duration of {a} microseconds.
+microseconds duration(a float64) = a * 0.000_001,
| Duration of {a} nanoseconds.
+nanoseconds duration(a float64) = a * 0.000_000_001,

| Number of milliseconds in {a}.
+milliseconds float64(a duration) = a.seconds * 1000
| Number of microseconds in {a}.
+microseconds float64(a duration) = a.seconds * 1_000_000
| Number of nanoseconds in {a}.
+nanoseconds float64(a duration) = a.seconds * 1_000_000_000

| Tries to pick an appropriate format for the value, like `1.5s` or `2.3us`.
+show string(a duration)
	if a >= 1.seconds
		"{a.seconds}s"
	elif a >= 1.milliseconds
		"{a.milliseconds}ms"
	elif a >= 1.microseconds
		"{a.microseconds}μs"
	else
		"{a.nanoseconds}ns"
