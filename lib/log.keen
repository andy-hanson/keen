no-std
import
	./io/print
	./js
	./json
	./misc
	./string
	./symbol

| Log severity.
| The log handler can use this any way it wants.
| The default log handler just prints the level at the beginning of each log.
+log-level enum
	| Any log message not fitting in other levels can be 'info'.
	info
	| This is useful for anything that seems like it might be a problem in the future.
	| For example: Something took an unusually long time; or a resource like memory is running low.
	warn
	| Use error logs when there has actually been an error.
	error
+to symbol(a log-level)
+show string(a log-level)
	a.to::symbol.show

+log[t] void(value t) (json, t) to
	log-with-level info, to-kid value
+log[t, u] void(a t, b u) (json, t) to, (json, u) to
	log (a.to, b.to)::json
+log[t, u, v] void(a t, b u, c v) (json, t) to, (json, u) to, (json, v) to
	log (a.to, b.to, c.to)::json
+log[t, u, v, w] void(a t, b u, c v, d w) (json, t) to, (json, u) to, (json, v) to, (json, w) to
	log (a.to, b.to, c.to, d.to)::json
+log[t, u, v, w, x] void(a t, b u, c v, d w, e x) (json, t) to, (json, u) to, (json, v) to, (json, w) to, (json, x) to
	log (a.to, b.to, c.to, d.to, e.to)::json

+log-error[t] void(value t) (json, t) to
	log-with-level error, to-json value

| Sends a log to the current log handler.
| By default, this means the message is logged to the console.
+log-with-level void(level log-level, message string)
	if trusted js
		_ = trusted call-property js-global["console"], level.show.to, "{level}: {message}"
	else
		trusted print-error "{level}: {message}"
