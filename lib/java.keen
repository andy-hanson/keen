no-std
import
	java/lang/String
	./col/buffer
	./option: new, option
	./private/bootstrap: array, bool, chars, int8, java, new, string, unsafe
	./unsafe

+java-null[t] t() unsafe, java
	gc-safe-value
+is-null[t] bool(a t) unsafe, java
	reference-equal a, java-null

+option-of-nullable[t] t?(a t) unsafe, java
	unless is-null a
		a

+show string(a String) java = a.to
+to string(a String) java
	- safe-reinterpret-cast trusted cast-immutable a.getBytes
+to String(a string) java
	do trusted
	- cast-mutable a.chars.safe-reinterpret-cast::int8[]
