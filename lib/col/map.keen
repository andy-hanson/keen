no-std
import
	../bits
	../bool
	../compare
	../exception
	../hash
	../json
	../misc
	../number
	../option
	../range
	../string
	../symbol
	../tuple
	./array
	./collection
	./buffer
	./private/frozen-map
	./sort
	./util

| Immutable unordered map type.
| Iteration is sorted, meaning it does O(n) work even if it only iterates one element.
| A map is logically a collection of key-value pairs (`({k}, {v})`).
| A key can appear at most once, and given a key, you can access the associated value in O(1).
+map[k, v] record
	-root (k, v) node

+ ==[k, v] bool(a v[k], b v[k]) k key, v equal
	trusted a.size == b.size and every a.unsorted, of k, v
		b[k] == v

+ <=>[k, v] comparison(a v[k], b v[k]) k key, v compare
	trusted a.to::(k, v)[] <=> b.to::(k, v)[]

+ hash[k, v] void(a v[k], state hash-state) k key, v hash
	trusted hash a.to::(k, v)[], state

+to[k, v] json(a v[k]) k key, k to-json, v to-json
	parts (json, json)[] = for key, value in a
		key.to, value.to
	if every parts, it.a.as-string
		named-new (map parts, it.a.to::string.to::symbol), (map parts, it.b)
	else
		parts.to
+as-string string?(a json)
	try
		a.to::string
	catch as deserialize-error
		()
+to[k, v] v[k](a json) k key, k from-json, v from-json
	match a
	as null
		()
	as array
		for value in a
			to::(k, v) value
	as json-object
		for k, v in a
			k.to::json.to::k, v.to::v
	else
		throw deserialize-error "map", a

-node[k, v] union
	(k, v) frozen-map
	(k, v) inner-node
	(k, v)[]
-inner-node[k, v] record(nodes (k, v) node[])

-empty-leaf-node[k, v] (k, v) node()
	()::(k, v)[]

-low-bits nat64(a nat64)
	a & 0b1111

-inner-node-n-bits nat64()
	4

-leaf-max-size nat64()
	8

| Later pairs overwrite earlier pairs with the same key.
+list-new[k, v] v[k](a (k, v)[]) k key
	a.to

| Maps with symbol keys can be created using the named-new syntax.
+named-new[v] v[symbol](keys symbol[], values v[])
	for i, key in with-index keys
		key, values[i]

| Converts a list of pairs to a map.
| Later pairs overwrite earlier pairs with the same key.
+to[k, v] v[k](a (k, v)[]) k key
	if a.size <= 4 and not has-duplicate-keys a
		a,
	else
		a.to::((k, v) frozen-map),
+to[k, v] v[k](a (k, v) array-view) k key
	if a.size <= 4 and not has-duplicate-keys a
		a.to::(k, v)[],
	else
		a.to::((k, v) frozen-map),

| All pairs in the map, sorted by key.
+to[k, v] (k, v)[](a v[k]) k key
	map a, {it}

| O(n^2) but it doesn't matter since n <= 4
-has-duplicate-keys[k, v] bool(a (k, v) array-view) k key
	match a.size
	as 0
		false
	as 1
		false
	as 2
		a[0].a == a[1].a
	as 3
		a[0].a == a[1].a or a[0].a == a[2].a or has-duplicate-keys a[1 .. a.size]
	as 4
		a[0].a == a[1].a or a[0].a == a[2].a or a[0].a == a[3].a or has-duplicate-keys a[1 .. a.size]
	else
		throw unreachable

| {true} if `{a}.{size} == 0`
+is-empty[k, v] bool(a v[k]) k key
	node-is-empty a.root
-node-is-empty[k, v] bool(a (k, v) node)
	match a
	as frozen-map
		is-empty a
	as inner-node
		false
	as array
		is-empty a

| Number of pairs.
+size[k, v] nat64(a v[k])
	a.root.size
-size[k, v] nat64(a (k, v) node)
	match a
	as frozen-map
		a.size
	as inner-node
		acc mut nat64 = 0
		for child in a.nodes
			acc +:= child.size
		acc
	as array
		a.size

| Gets the value associated with a key.
| Returns an empty option unless `{key} in {a}`.
+subscript[k, v] v?(a v[k], key k) k key
	match root = a.root
	as frozen-map
		root[key]
	as inner-node
		subscript-inner root, key
	as array
		lookup root, key
-subscript-inner[k, v] v?(a (k, v) inner-node, key k) k key
	cur mut (k, v) node = a
	remaining-hash mut = trusted seeded-hash key
	do until
	match x = cur
	as frozen-map
		throw unreachable
	as inner-node
		which = low-bits remaining-hash
		do if which < x.nodes.size else ()::v?
		cur := x.nodes[which]
		remaining-hash >>:= inner-node-n-bits
		()
	as array
		lookup x, key
-lookup[k, v] v?(a (k, v)[], key k) k key
	first a, of k, v
		if k == key then v

| Associates the {key} with the {value}.
| If the {key} is already in {a}, overwrites the old value. Otherwise adds a new entry.
+ ~[k, v] v[k](a v[k], (key k, value v)) k key
	res = get-or-update a, key, of _
		insert value
	if node = res.new-node
		node,
	else
		a

| Adds/updates many entries to {a}.
| Where keys match, values in {b} overwrite values in {b}. Otherwise they add new entries.
+ ~~[k, v] v[k](a v[k], b v[k]) k key
	res mut = a
	trusted for pair in b.unsorted
		res ~:= pair
	res

+keys[k, v] k[](a v[k]) k key
	map a, it.a

+values[k, v] v[](a v[k]) k key
	map a, it.b

~got-or-added[k, v] union(v got, (k, v) added)
~got[t] record(value t)
~added[k, v] record(map v[k], value v)

| If {key} is already in {a}, returns {got} with the old value.
| Else, adds a new pair `{key}, {get-value}[]` and return {added}.
~get-or-add[k, v] (k, v) got-or-added(a v[k], key k, get-value v mut()) k key
	res = get-or-update a, key, of old-value
		if old-value
			no-change
		else
			insert get-value[]
	if v = res.old-value
		(v,)::(v got)
	else
		((res.new-node!,), res.new-value!)::((k, v) added)

| Removes {key} and its associated value.
| If {key} is not in {a}, returns {a} unmodified.
| If you need the old value, use {remove} instead.
+ -[k, v] v[k](a v[k], key k) k key
	if res = remove a, key
		res.b
	else
		a

| Removes a key and its associated value, and returns the value and the new map.
|
| If {key} is not in {a}, returns an empty option.
+remove[k, v] (v, v[k])?(a v[k], key k) k key
	res = get-or-update a, key, {remove}
	if value = res.old-value
		value, (res.new-node!,)

-get-or-update-result[k, v] record
	# If none, don't update anything
	new-node (k, v) node?
	old-value v?
	new-value v?
-get-or-update-action[v] union(no-change, remove, v insert)
-no-change record
-remove record
-insert[t] record(value t)
-get-or-update[k, v] (k, v) get-or-update-result
	a v[k]
	key k
	f v get-or-update-action mut(old-value v?)
do k key
	hash = trusted seeded-hash key
	match root = a.root
	as frozen-map
		trusted get-or-update-leaf root.to, key, hash, 0, f
	as inner-node
		get-or-update-recur root, key, hash, 0, f
	as array
		get-or-update-leaf root, key, hash, 0, f

-get-or-update-recur[k, v] (k, v) get-or-update-result
	a (k, v) node
	key k
	remaining-hash nat64
	hash-shift nat64
	f v get-or-update-action mut(old-value v?)
do k key
	match a
	as frozen-map
		throw unreachable
	as inner-node
		which = low-bits remaining-hash
		if which < a.nodes.size
			next-hash = remaining-hash >> inner-node-n-bits
			child-res = get-or-update-recur a.nodes[which], key, next-hash, hash-shift + inner-node-n-bits, f
			if node = child-res.new-node
				new-node: update-child a.nodes, which, node
				old-value: child-res.old-value
				new-value: child-res.new-value
			else
				child-res
		else
			match action = f[]
			as no-change
				(), (), ()
			as remove
				(), (), ()
			as insert
				new-leaf (k, v)[] = (key, action.value),
				new-node = update-at-with-default a.nodes, which, new-leaf, empty-leaf-node
				new-node.inner-node, (), action.value
	as array
		get-or-update-leaf a, key, remaining-hash, hash-shift, f

| Unlike for {update-at}, {index} doesn't need to be a valid index.
| If `{index} > {a}.{size}`, entries between the and of {a} and the new entries will be {default}.
-update-at-with-default[t] t[](a t[], index nat64, new-value t, default t)
	if index < a.size
		update-at a, index, new-value
	else
		for i in 0::nat64 .. index + 1
			if i < a.size
				a[i]
			elif i == index
				new-value
			else
				default

-update-child[k, v] (k, v) node(a (k, v) node[], which nat64, new-child (k, v) node)
	if leaf = inner-node-to-leaf a, which, new-child
		leaf
	elif node-is-empty new-child
		if which == a.size - 1
			new-children (k, v) node array-view = a[0 .. a.size - 1]
			if new-children.size == 1 then new-children[0] else inner-node new-children.to
		else
			new-children = update-at a, which, new-child
			if child = find-only-non-empty-child new-children
				child
			else
				inner-node new-children
	else
		inner-node update-at a, which, new-child

| Returns a new node if we should change this to a leaf.
-inner-node-to-leaf[k, v] (k, v) node?(a (k, v) node[] , which nat64, new-child (k, v) node)
	total-size mut nat64 = 0
	for child-index, child in with-index a
		total-size := match x = if child-index == which then new-child else child
		as frozen-map
			throw unreachable
		as inner-node
			leaf-max-size + 1
		as array
			total-size + x.size
	if total-size <= leaf-max-size
		# TODO: if only one non-empty leaf, don't copy..
		pairs (k, v)[] = with out in build total-size
			for child-index, child in with-index a
				match x = if child-index == which then new-child else child
				as frozen-map
					throw unreachable
				as inner-node
					throw unreachable
				as array
					out ~~= x
		assert pairs.size == total-size
		pairs

-find-only-non-empty-child[k, v] (k, v) node?(children (k, v) node[])
	first-non-empty-index = find-index! children, it.node-is-empty.not
	if every children[first-non-empty-index + 1 .. children.size], it.node-is-empty
		children[first-non-empty-index]

-get-or-update-leaf[k, v] (k, v) get-or-update-result
	a (k, v)[]
	key k
	remaining-hash nat64
	hash-shift nat64
	f v get-or-update-action mut(old-value v?)
do k key
	if index = find-index a, it.a == key
		_, old-value = a[index]
		match action = f[old-value]
		as no-change
			(), old-value, ()
		as remove
			(remove-at a, index), old-value, ()
		as insert
			new-node: update-at a, index, (key, action.value)
			old-value: old-value
			new-value: action.value
	else
		match action = f[]
		as no-change
			(), (), ()
		as remove
			(), (), ()
		as insert
			new-node (k, v) node = if a.size >= leaf-max-size
				assert hash-shift < 64 else todo # TODO: fall back to a sorted map?
				# If we get here, it's guaranteed that we don't need to recursively create leaves.
				# Just group by hash.
				new-inner-node a, key, action.value, remaining-hash, hash-shift
			else
				a ~ (key, action.value)
			new-node, (), action.value

-new-inner-node[k, v] (k, v) inner-node(a (k, v)[], key k, value v, hash nat64, hash-shift nat64) k key
	do trusted
	key-hash = low-bits hash
	max-hash mut = key-hash
	for k, _ in a
		max-hash max:= low-bits k.seeded-hash >> hash-shift
	res (k, v) node buffer = n-of max-hash + 1, empty-leaf-node
	# TODO: avoid allocating the same leaf twice...
	res[key-hash] := ((key, value),)::(k, v)[]
	for k, v in a
		index = low-bits k.seeded-hash >> hash-shift
		res[index] := res[index].array! ~ (k, v)
	- cast-immutable res

+some[k, v] bool(a v[k], f bool mut(key k, value v)) k key
	trusted map::(k, v)[] a.unsorted, {it} 'sort it.a 'some f

+map-unsorted[k, v] record
	-inner v[k]
+unsorted[k, v] (k, v) map-unsorted(a v[k]) unsafe
	a,
+size[k, v] nat(a (k, v) map-unsorted)
	a.inner.size
+some[k, v] bool(a (k, v) map-unsorted, f bool mut(key k, value v)) unsafe
	some-recur a.inner.root, f
-some-recur[k, v] bool(a (k, v) node, f bool mut(key k, value v)) unsafe
	match a
	as frozen-map
		some a, f
	as inner-node
		some a.nodes, {some-recur it, f}
	as array
		some a, f

dbg[k, v] string(a v[k]) k show, v show
	dbg a.root, ""
-dbg[k, v] string(a (k, v) node, path string) k show, v show
	match a
	as frozen-map
		"TODO"
	as inner-node
		join " ", for* index, child in with-index a.nodes
			unless node-is-empty child
				- dbg child, "{path}{index}"
	as array
		parts string[] = for k, v in a
			"{k} -> {v}"
		"{path}[{join ", ", parts}]"
