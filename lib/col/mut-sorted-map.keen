import
	./private/sort-utils

| Mutable sorted map.
| This works like `mut v[k]`, but iterates in sorted order.
+mut-sorted-map[k, v] record mut
	| Values are empty options if they have been deleted.
	-pairs (k, v?) mut[]
	| Number of pairs in this node where the value is non-empty.
	| Does not include sizes of other nodes.
	-node-size mut nat32
	-next mut (k, v) mut-sorted-map?

| Later pairs overwrite earlier pairs with the same key.
+list-new[k, v] (k, v) mut-sorted-map(a (k, v)[]) k sorted-key
	a.to

+to[k, v] (k, v) mut-sorted-map(a (k, v)[]) k sorted-key
	res (k, v) mut-sorted-map = ()::(k, v?) mut[], 0, ()
	for k, v in a
		res[k] := v
	res

| {true} if `{a}.{size} == 0`.
+is-empty[k, v] bool(a (k, v) mut-sorted-map)
	is-empty a.pairs

| Removes every pair.
+clear[k, v] void(a (k, v) mut-sorted-map)
	clear a.pairs
	a.node-size := 0
	a.next := ()

+min-key[k, v] k?(a (k, v) mut-sorted-map) k sorted-key
	compact a
	unless is-empty a
		assert a.pairs[0].b
		a.pairs[0].a

+remove-min-key[k, v] (k, v)?(a (k, v) mut-sorted-map) k sorted-key
	if key = min-key a
		key, remove-key! a, key

+max-key[k, v] k?(a (k, v) mut-sorted-map) k sorted-key
	compact a
	unless is-empty a
		assert a.pairs[end - 1].b
		a.pairs[end - 1].a

+remove-max-key[k, v] (k, v)?(a (k, v) mut-sorted-map) k sorted-key
	if key = max-key a
		key, remove-key! a, key

| Number of pairs in the map.
| This is O({a} {size}).
+size[k, v] nat32(a (k, v) mut-sorted-map)
	acc mut nat32 = 0
	cur mut = a
	do until
	acc +:= cur.node-size
	if next = cur.next
		cur := next
		()
	else
		acc

| Find the value associated with the key.
| Returns an empty option iff the key is not in the map.
| This is O({a}.{size} log).
+subscript[k, v] v?(a (k, v) mut-sorted-map, key k) k sorted-key
	if index = find-exact a.pairs, key
		a.pairs[index].b
	elif x = a.next
		x[key]

| Adds a key-value pair, replacing any existing one with that key.
+set-subscript[k, v] void(a (k, v) mut-sorted-map, key k, value v) k sorted-key
	unless insert-into-key-match-or-empty-slot a, key, value
		add-pair a, key, value

+ensure[k, v] v(a (k, v) mut-sorted-map, key k, get-value v mut()) k sorted-key
	a[key] else
		value = get-value[]
		a[key] := value
		value
+ensure[k, v] v(a (k, v) mut-sorted-map, key k) k sorted-key, v new
	ensure a, key, {}

| Adds many key-value pairs, replacing existing ones with the same keys.
| Equivalent to adding each element of {b} separately.
+ ~~=[k, v] void(a (k, v) mut-sorted-map, b (k, v)[]) k sorted-key
	for k, v in b
		a[k] := v

| Traverses nodes left-to-right looking for the key.
| If that fails, traverses back right-to-left and inserts into an empty slot if possible.
| Returns {true} if it succeeded.
-insert-into-key-match-or-empty-slot[k, v] bool(a (k, v) mut-sorted-map, key k, value v) k sorted-key
	insert = binary-search-insert-cb a.pairs, key <=> it.a
	next-pair (k, v?)? = unless insert == a.pairs.size
		a.pairs[insert]
	if k, v = next-pair and k == key
		unless v
			a.node-size +:= 1
		a.pairs[insert] := key, value
		true
	else
		inserted = if next = a.next
			insert-into-key-match-or-empty-slot next, key, value

		if inserted
			true
		elif k, v = next-pair and not v
			assert key < k
			a.node-size +:= 1
			a.pairs[insert] := key, value
			true
		elif k, _ = next-pair and insert != 0 and not a.pairs[insert - 1].b
			assert key < k
			# overwrite empty slot even though key doesn't match
			a.node-size +:= 1
			a.pairs[insert - 1] := key, value
			true

| Returns the new physical size of this node and all nodes to the right
-add-pair[k, v] void(a (k, v) mut-sorted-map, key k, value v) k sorted-key
	if a.node-size < 4
		if is-empty a.pairs
			a.pairs ~= key, value
		else
			# List has a small absolute size, so even if we can't insert near the end,
			# there's an empty slot somewhere so we don't have to do much moving.
			insert-linear a.pairs, 0, key, value
		a.node-size +:= 1
	elif key > a.pairs[end - 4].a
		# We can insert it near the end
		insert-linear a.pairs, a.pairs.size - 4, key, value
		a.node-size +:= 1
	else
		if next = a.next
			add-pair next, key, value
			compact-if-needed a
		else
			new-pairs (k, v?) mut[] = ()
			new-pairs ~= key, value
			a.next := new-pairs, 1, ()

| Insert at the last place where the key is < that value.
-insert-linear[k, v] void(a (k, v?) mut[], index nat32, key k, value v) k sorted-key
	if key < a[index].a
		move-right a, index
		a[index] := key, value
	elif index == a.size - 1
		a ~= key, value
	else
		insert-linear a, index + 1, key, value

| If there's something here, move it so something else can be inserted.
-move-right[k, v] void(a (k, v?) mut[], index nat32)
	if a[index].b
		# If this is the last value, push it
		if index == a.size - 1
			a ~= a[index]
		else
			move-right a, index + 1
			a[index + 1] := a[index]

+move-to[k, v] (k, v)[](a (k, v) mut-sorted-map) k sorted-key
	res (k, v)[] = for x in a then x
	clear a
	res

# TODO: use the same `try-remove` interface that mut-map uses.
| If the key is in the map, removes it and returns the value that was associated with it.
| Else, returns an empty option.
+remove-key[k, v] v?(a (k, v) mut-sorted-map, key k) k sorted-key
	if index = find-exact a.pairs, key
		res = if a.pairs.size - index < 4
			_, v = remove-at a.pairs, index
			v
		else
			_, old-value = a.pairs[index]
			a.pairs[index] := key, ()
			old-value
		if res
			a.node-size -:= 1
		compact-if-needed a
		res
	elif next = a.next
		remove-key next, key

-compact-if-needed[k, v] void(a (k, v) mut-sorted-map) k sorted-key
	physical-size = total-pairs-size a
	if a.node-size * 2 <= physical-size
		compact a
		a.node-size is a.total-pairs-size

-total-pairs-size[k, v] nat32(a (k, v) mut-sorted-map)
	acc mut nat32 = 0
	cur mut = a
	do until
	acc +:= cur.pairs.size
	if next = cur.next
		cur := next
		()
	else
		acc

-compact[k, v] void(a (k, v) mut-sorted-map) k sorted-key
	a.pairs filter= it.b
	do if next = a.next
	compact next
	merge-no-duplicates a.pairs, next.pairs, of (k0, _), (k1, _)
		assert-comparison-not-equal k0 <=> k1
	a.next := ()
	a.node-size := a.pairs.size

-find-exact[k, v] nat32?(pairs (k, v?) mut[], key k) k sorted-key
	binary-search-exact pairs, key

region mutating iteration

+filter=[k, v] void(a (k, v) mut-sorted-map, f bool mut(key k, value v)) k sorted-key
	compact a
	a.pairs filter= of k, v
		f[k, v!]

+map=[k, v] void(a (k, v) mut-sorted-map, f (k, v) mut(key k, value v)) k sorted-key
	compact a
	a.pairs map= of k, v
		k-out, v-out = f[k, v!]
		k-out, v-out
	a.pairs sort= it.a

+map-values=[k, v] void(a (k, v) mut-sorted-map, f v mut(key k, value v)) k sorted-key
	a map= of k, v
		k, f[k, v]

+some[k, v] bool(a (k, v) mut-sorted-map, f bool mut(key k, value v)) k sorted-key
	compact a
	some a.pairs, of k, v
		f[k, v!]

+some-reverse[k, v] bool(a (k, v) mut-sorted-map, f bool mut(key k, value v)) k sorted-key
	compact a
	some-reverse a.pairs, of k, v
		f[k, v!]

region test

~verify void(a (nat64, string) mut-sorted-map, expected string)
	a.dbg is expected
	verify-node-size a

-dbg[k, v] string(a (k, v) mut-sorted-map) k show, v show
	pairs = join ", ", for k, v in a.pairs
		"{k} -> {v.?show else "_"}"
	if next = a.next
		"[{pairs}], {dbg next}"
	else
		"[{pairs}]"

-verify-node-size[k, v] void(a (k, v) mut-sorted-map)
	res mut nat32 = 0
	for _, v in a.pairs
		res +:= v.to
	a.node-size is res
	?verify-node-size a.next
