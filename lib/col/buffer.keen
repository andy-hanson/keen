no-std
import
	java/lang/IndexOutOfBoundsException
	java/lang/Object
	java/lang/System
	../bits
	../bool
	../compare
	../js
	../misc
	../number
	../option
	../private/bootstrap: array, array-view, high, inner, low
	../range
	../unsafe
	./collection
export
	../private/bootstrap: buffer, buffer-view

# Called implicitly by the compiler
~to-buffer-view[t] t buffer-view(a t buffer)
	buffer-view a, 0, a.size

+list-new[t] t buffer(a t[])
	a.to

+new[t] t buffer-view()
	buffer-view (), 0, 0

+cast-immutable[t] t array-view(a t buffer-view) unsafe
	array-view a.inner.cast-immutable, a.low, a.high

+to[t] t[](a t buffer-view)
	trusted cast-immutable a.to::(t buffer)
+to[t] t buffer(a t buffer-view)
	res t buffer = trusted uninitialized-buffer a.size
	res 'copy-from a
	res

+is-empty[t] bool(a t buffer-view)
	a.low == a.high

+size[t] nat32(a t buffer-view)
	a.high - a.low

+subscript[t] t(a t buffer-view, index nat32)
	assert index < a.size else index-too-big index, a.size
	trusted unsafe-at a.inner, a.low + index
+subscript[t] t(a t buffer-view, index index-relative-to-end)
	a[to-index a, index]

+set-subscript[t] void(a t buffer-view, index nat32, value t)
	assert index < a.size else index-too-big index, a.size
	a.inner[a.low + index] := value
+set-subscript[t] void(a t buffer-view, index index-relative-to-end, value t)
	a[to-index a, index] := value

+subscript[t] t buffer-view(a t buffer, indices nat32 range)
	a.to-buffer-view[indices]
+subscript[t] t buffer-view(a t buffer, indices range-relative-to-end)
	a.to-buffer-view[indices]
+subscript[t] t buffer-view(a t buffer-view, indices nat32 range)
	assert indices.high <= a.size else index-too-big indices.high, a.size
	buffer-view a.inner, a.low + indices.low, a.low + indices.high
+subscript[t] t buffer-view(a t buffer-view, indices range-relative-to-end)
	a[to-range a, indices]

+some[t] bool(a t buffer-view, f bool mut(x t))
	i mut = a.low
	do until
	if i == a.high
		false
	elif f[a.inner[i]]
		true
	else
		i +:= 1
		()

| Copies the array elements to a new `buffer`.
| This is O({a} {size}).
+to[t] t buffer(a t[])
	if a.size == 0
		trusted cast-mutable a
	else
		a::(t array-view).to

+to[t] t buffer(a t array-view)
	res t buffer = trusted uninitialized-buffer a.size
	copy-from res, a
	res

| Copies the elements to an immutable array.
| This is O({a} {size}).
|
| There is no `move-to` function for `buffer`,
| since its pointer and size are immutable and so it can't be made empty.
+to[t] t[](a t buffer)
	a::(t buffer-view) 'to

| Number of elements.
+size[t] nat32(a t buffer)

| {true} if `{a}.{size} == 0`.
+is-empty[t] bool(a t buffer)
	a.size == 0

| Copies the elements to a new `buffer`.
| This is O({a} {size}).
+copy[t] t buffer(a t buffer)
	a::(t buffer-view) 'to

+subscript[t] t(a t buffer, index nat32)
	trusted if java
		try
			unsafe-at a, index
		catch as IndexOutOfBoundsException
			throw index-too-big index, a.size
	else
		assert index < a.size else index-too-big index, a.size
		unsafe-at a, index
~unsafe-at[t] t(a t buffer, index nat32) unsafe
-unsafe-at[t] t(a t[], index nat32) unsafe

+set-subscript[t] void(a t buffer, index nat32, value t)
	trusted if java
		try
			unsafe-set-at a, index, value
		catch as IndexOutOfBoundsException
			throw index-too-big index, a.size
	else
		assert index < a.size else index-too-big index, a.size
		unsafe-set-at a, index, value
+set-subscript[t] void(a t buffer, index index-relative-to-end, value t)
	a[to-index a, index] := value
~unsafe-set-at[t] void(a t buffer, index nat32, value t) unsafe

+set-subscript[t] void(dest t buffer, range nat32 range, source t[])
	dest[range] 'copy-from source
+set-subscript[t] void(dest t buffer, range nat32 range, source t array-view)
	dest[range] 'copy-from source
+set-subscript[t] void(dest t buffer, range nat32 range, source t buffer)
	dest[range] 'copy-from source
+set-subscript[t] void(dest t buffer, range nat32 range, source t buffer-view)
	dest[range] 'copy-from source
+set-subscript[t] void(dest t buffer, range range-relative-to-end, source t[])
	dest[to-range dest, range] 'copy-from source
+set-subscript[t] void(dest t buffer, range range-relative-to-end, source t array-view)
	dest[to-range dest, range] 'copy-from source
+set-subscript[t] void(dest t buffer, range range-relative-to-end, source t buffer)
	dest[to-range dest, range] 'copy-from source
+set-subscript[t] void(dest t buffer, range range-relative-to-end, source t buffer-view)
	dest[to-range dest, range] 'copy-from source

+set-subscript[t] void(dest t buffer-view, range nat32 range, source t[])
	dest[range] 'copy-from source
+set-subscript[t] void(dest t buffer-view, range nat32 range, source t array-view)
	dest[range] 'copy-from source
+set-subscript[t] void(dest t buffer-view, range nat32 range, source t buffer)
	dest[range] 'copy-from source
+set-subscript[t] void(dest t buffer-view, range nat32 range, source t buffer-view)
	dest[range] 'copy-from source
+set-subscript[t] void(dest t buffer-view, range range-relative-to-end, source t[])
	dest[to-range dest, range] 'copy-from source
+set-subscript[t] void(dest t buffer-view, range range-relative-to-end, source t array-view)
	dest[to-range dest, range] 'copy-from source
+set-subscript[t] void(dest t buffer-view, range range-relative-to-end, source t buffer)
	dest[to-range dest, range] 'copy-from source
+set-subscript[t] void(dest t buffer-view, range range-relative-to-end, source t buffer-view)
	dest[to-range dest, range] 'copy-from source

| Overwrites {dest} with the contents of {source}.
| {dest} and {source} must be the same size.
+copy-from[t] void(dest t buffer-view, source t buffer-view)
	dest 'copy-from trusted cast-immutable source
+copy-from[t] void(dest t buffer-view, source t array-view)
	dest.inner 'copy-from dest.low .. dest.high, source.inner, source.low .. source.high
-copy-from[t] void(dest t buffer, dest-range nat32 range, src t[], src-range nat32 range)
	do trusted
	do unless is-empty-type@t
	size = dest-range.size
	assert src-range.size == size
	assert dest-range.high <= dest.size
	assert src-range.high <= src.size
	dl = dest-range.low
	sl = src-range.low
	if java
		arraycopy src.reinterpret-cast::Object, sl.wrap-to, dest.reinterpret-cast::Object, dl.wrap-to, size.wrap-to
	else
		assert js
		dest-low = to-js-float dest-range.low
		src-low = to-js-float src-range.low
		src-high = to-js-float src-range.high
		if reference-equal dest, cast-mutable src
			_ = call-property dest.reinterpret-cast, "copyWithin", dest-low, src-low, src-high
		elif to call-property js-global["ArrayBuffer"], "isView", dest.reinterpret-cast
			sub = call-property src.reinterpret-cast, "subarray", src-low, src-high
			_ = call-property dest.reinterpret-cast, "set", sub, dest-low
		else
			i mut nat32 = 0
			until i == size
				unsafe-set-at dest, dl + i, unsafe-at src, sl + i
				i +:= 1
-to-js-float js-any(a nat32) js = a.to::float.to

| Overwrites each element `x` with `{f}[x]`.
+map=[t] void(a t buffer-view, f t mut(x t))
	i mut nat32 = 0
	until i == a.size
		a[i] := f[a[i]]
		i +:= 1

region unsafe

| Allocates a buffer full of {gc-safe-value}.
| To use this safely, you need to be careful to never read an element before writing it.
| For a safer alternative, consider using a `for` loop to create the buffer.
+uninitialized-buffer[t] t buffer(size nat32) unsafe

| Sets every element to {gc-safe-value}.
+clear-memory[t] void(a t buffer-view) unsafe
	i mut nat32 = 0
	until i == a.size
		a[i] := gc-safe-value
		i +:= 1

| Unsafe cast to an immutable array.
| This is O(1).
| WARN: It's undefined behavior if {a} is ever written to again.
+cast-immutable[t] t[](a t buffer) unsafe
	reinterpret-cast a
| Unsafe cast to a mutable array.
| Use this only if you are sure it will not actually be written to.
+cast-mutable[t] t buffer(a t[]) unsafe
	reinterpret-cast a

| Calls {f} on each element in {a}.
| {a} remains mutable during iteration.
+some[t] bool(a t buffer, f bool mut(elem t))
	i mut = a.low
	do until
	if i == a.high
		false
	elif f[trusted unsafe-at a.inner, i]
		true
	else
		i +:= 1
		()

+some-reverse[t] bool(a t buffer, f bool mut(x t)) = some-reverse a::(t buffer-view), f
+some-reverse[t] bool(a t buffer-view, f bool mut(x t))
	do unless is-empty a
	i mut = a.high - 1
	do until
	if f[trusted unsafe-at a.inner, i]
		true
	elif i == a.low
		false
	else
		i -:= 1
		()

# These are defined by 'array.keen', but that imports this, so just copy the definitions here.
-size[t] nat32(a t[])
-size[t] nat32(a t array-view)
	a.high - a.low
