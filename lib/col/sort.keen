no-std
import
	../bool
	../compare
	../hash
	../misc
	../number
	../option
	../range
	../tuple
	./array
	./collection
	./buffer
	./mut-array
	./util

+is-sorted[col, elem] bool(a col) (col, elem) some, elem sorted-key
	is-sorted a, {it}

+is-sorted[col, elem, key] bool(a col, f key data(x elem)) (col, elem) some, key sorted-key
	prev mut key? = ()
	every a, of x
		key = f[x]
		wrong = p = prev and p > key
		prev := key
		not wrong

| Sorts the elements from least to greatest.
| The result satisfies `res[i] <= res[i + 1]`.
+sort[col, elem] col
	a col
do (col, elem) list-new, (col, elem) some, col size, elem sorted-key
	sort a, {it}

| Sorts the elements comparing by the result of {get-key}.
+sort[col, elem, k] col
	a col
	get-key k mut(elem elem)
do (col, elem) list-new, (col, elem) some, col size, k sorted-key
	res elem buffer = map a, {it}
	res sort= get-key
	list-new trusted cast-immutable res

| Sorts and remove duplicates.
| That means `res[i] < res[i + 1]` for each element in the result.
+sort-unique[col, elem] col
	a col
do (col, elem) list-new, (col, elem) some, col size, elem sorted-key
	sort-unique a, {it}
+sort-unique[col, elem, k] col
	a col
	get-key k data(a elem)
do (col, elem) list-new, (col, elem) some, col size, k sorted-key
	m elem buffer = map a, {it}
	list-new to sort-unique-in-place m, get-key

| Sorts in-place from least to greatest.
+sort-in-place[t] void(a t buffer-view) t sorted-key
	a sort= {it}
+sort=[t, k] void(a t mut[], get-key k mut(elem t)) k sorted-key
	trusted a.temp-as-buffer sort= get-key
+sort=[t, k] void(a t buffer-view, get-key k mut(elem t)) k sorted-key
	do if a.size > 4 else small-sort a, get-key

	a[0 .. a.size / 2] sort= get-key
	a[a.size / 2 .. end] sort= get-key

	# Copy the left half to avoid overwriting it
	left t[] = a[0 .. a.size / 2].to
	l mut nat64 = 0
	r mut nat64 = a.size / 2
	out mut nat64 = 0
	while l < left.size and r < a.size
		x = left[l]
		y = a[r]
		if get-key[x] <= get-key[y]
			a[out] := x
			l +:= 1
		else
			a[out] := y
			r +:= 1
		out +:= 1
	while l < left.size
		a[out] := left[l]
		out +:= 1
		l +:= 1
	while r < a.size
		a[out] := a[r]
		out +:= 1
		r +:= 1
	assert out == a.size

-small-sort[t, k] void(a t buffer-view, get-key k mut(elem t)) k sorted-key
	do if a.size > 1
	for i in 2::nat64 .. a.size + 1
		move-last-into-sorted a[0 .. i], get-key
| Given that all but the last element is sorted, move the last element to where it needs to be.
-move-last-into-sorted[t, k] void(a t buffer-view, get-key k mut(elem t)) k sorted-key
	if a.size > 1 and get-key[a[end - 2]] > get-key[a[end - 1]]
		swap-at a, end - 2, end - 1
		move-last-into-sorted a[0 .. end - 1], get-key

| Sorts in place and removes unique elements.
| Returns a new view which will be shorter if non-unique elements were removed.
| Elements that come later are preferred.
-sort-unique-in-place[t, k] t buffer-view(a t buffer-view, get-key k data(x t)) k sorted-key
	a sort= get-key[it]
	out mut = 0
	in_ mut = 0
	prev mut k? = ()
	while in_ != a.size
		x = a[in_]
		key = get-key[x]
		if prev == key
			out -:= 1
		a[out] := x
		out +:= 1
		prev := key
		in_ +:= 1
	a[0 .. out]

| Sort {a}, and move elements of {b} in the same permutation as {a}.
| This is useful if {a} and {b} are parallel arrays,
| meaning `a[i]` and `b[i]` belong together for the same `i`.
| Every pair `a[i]` and `b[i]`, will move to `res.a[j]` and `res.b[j]` for some `j`.
+sort-by-first[t, u] (t[], u[])(a t[], b u[]) t sorted-key
	mut-a t buffer = a.to
	mut-b u buffer = b.to
	sort-in-place-by-first mut-a, mut-b
	trusted mut-a.cast-immutable, mut-b.cast-immutable

| Sort `a` in place, and move elements of `b` in the same permutation as `a`.
+sort-in-place-by-first[t, u] void(a t buffer-view, b u buffer-view) t sorted-key
	assert a.size == b.size
	if a.size > 1
		swap-at a, 0, a.size / 2
		swap-at b, 0, b.size / 2
		pivot = a[0]
		new-pivot-index = (set-partition-by-first a, b, pivot, 1, a.size - 1) - 1
		swap-at a, 0, new-pivot-index
		swap-at b, 0, new-pivot-index
		sort-in-place-by-first a[0 .. new-pivot-index], b[0 .. new-pivot-index]
		sort-in-place-by-first a[new-pivot-index + 1 .. end], b[new-pivot-index + 1 .. end]

-set-partition-by-first[t, u] nat64
	a t buffer-view
	b u buffer-view
	pivot t
	left nat64
	right nat64
do t sorted-key
	assert a.size == b.size
	l mut = left
	r mut = right
	while l <= r
		assert r < a.size
		if a[l] < pivot
			l +:= 1
		else
			swap-at a, l, r
			swap-at b, l, r
			r -:= 1
	l

| If {a} has an even number of elements, prefers the higher median.
+median[t] t(a t array-view) t sorted-key
	median-by a, {it}
+median-by[t, k] t(a t array-view, get-key k mut(x t)) k sorted-key
	forbid is-empty a
	nth-sorted-by a, a.size / 2, get-key

| Equivalent to `a.sort[n]` but faster
+nth-sorted[t] t(a t array-view, n nat) t sorted-key
	nth-sorted-by a, n, {it}
+nth-sorted-by[t, k] t(a t array-view, n nat, get-key k mut(x t)) k sorted-key
	assert n < a.size else index-too-big n, a.size
	nth-sorted-and-mess a.to, n, get-key
| This may rearrange the array in an arbitrary way.
-nth-sorted-and-mess[t, k] t(a t buffer-view, n nat, get-key k mut(x t)) k sorted-key
	assert n < a.size
	if n <= 10
		a sort= get-key
		a[n]
	else
		groups = divide-and-round-up a.size, 5
		medians t[] = for i in 0 .. groups
			group = a[5 * i .. if i == groups - 1 then a.size else 5 * (i + 1)]
			nth-sorted-and-mess group, group.size / 2, get-key
		pivot-index = pivot-around a, (median-by medians, get-key), get-key
		match n <=> pivot-index
		as less
			nth-sorted-and-mess a[0 .. pivot-index], n, get-key
		as equal
			a[pivot-index]
		as greater
			nth-sorted-and-mess a[pivot-index + 1 .. end], n - pivot-index - 1, get-key
| Rearranges the array around the pivot. Returns the index of the pivot.
| All elements in `a[0 .. index]` will be <= the pivot
| and elements `a[index + 1 .. end]` will be > the pivot.
| If there are multiple copies of the pivot, this returns the index of the last one.
-pivot-around[t, k] nat(a t buffer-view, pivot t, get-key k mut(x t)) k sorted-key
	forbid is-empty a
	# Invariant: Everything at an index < l is <= pivot ; everything at an index > r is > pivot
	l mut = 0
	r mut = a.size - 1
	found-pivot mut = 0
	pivot-key = get-key[pivot]
	while l <= r
		match get-key[a[l]] <=> pivot-key
		as less
			l +:= 1
		as equal
			found-pivot := l
			l +:= 1
		as greater
			if get-key[a[r]] > pivot-key
				r -:= 1
			else
				swap-at a, l, r
	l -:= 1
	swap-at a, found-pivot, l
	l
