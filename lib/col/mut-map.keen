no-std
import
	../bits
	../bool
	../compare
	../hash
	../misc
	../number
	../option
	../tuple
	./array
	./collection
	./map
	./buffer
	./sort
	./util

| Mutable unordered map.
+mut-map[k, v] record mut
	| Highest bit is for locked
	-size-and-locked mut nat32
	-entries mut (k, v)? buffer

-locked-flag nat32() = 0x80000000

-write-locked[k, v] bool(a v mut[k])
	bits-intersect a.size-and-locked, locked-flag
-set-write-locked[k, v] void(a v mut[k], b bool)
	if b
		forbid write-locked a else was-locked
		a.size-and-locked |:= locked-flag
	else
		assert write-locked a
		a.size-and-locked &:= ~locked-flag

| Later pairs overwrite earlier pairs with the same key.
+list-new[k, v] v mut[k](a (k, v)[]) k key
	a.to

| New empty map with space for approximately {capacity} entries.
| This can have a small performance benefit if you know that much space will be needed.
|
| Since hash conflicts are possible,
| this makes no guarantees about whether more allocations will be needed.
~mut-map-with-capacity[k, v] v mut[k](capacity nat32) k key
	size-and-locked: 0
	entries: n-of capacity, ()

| Convert a list of pairs to a map.
| Later pairs overwrite earlier pairs with the same key.
+to[k, v] v mut[k](a (k, v)[]) k key
	out v mut[k] = mut-map-with-capacity a.size
	for x in a
		out ~= x
	out
| Copy to an immutable map.
+to[k, v] v[k](a v mut[k]) k key
	to a.to::(k, v)[]
| Copy pairs to an array.
+to[k, v] (k, v)[](a v mut[k]) k key
	res (k, v)[] = with out in build a.size
		for x in a.entries
			if x
				out ~= x
	sort res, it.a

| Copy pairs to an array and clear the map.
+move-to[k, v] (k, v)[](a v mut[k]) k key
	res (k, v)[] = a.to
	clear a
	res
+move-to[k, v] v[k](a v mut[k]) k key
	res v[k] = a.to
	clear a
	res
+move-to[k, v] v mut[k](a v mut[k]) k key
	forbid write-locked a
	res v mut[k] = a.size-and-locked, a.entries
	a.size-and-locked := 0
	a.entries := ()
	res

| Copy pairs to a new {mut-map}.
+copy[k, v] v mut[k](a v mut[k]) k key
	size-and-locked: a.size-and-locked & ~locked-flag
	entries: a.entries.copy

| {true} if `{a}.{size} == 0`.
+is-empty[k, v] bool(a v mut[k]) k key
	a.size == 0

| Number of pairs in the map.
+size[k, v] nat32(a v mut[k])
	a.size-and-locked & ~locked-flag

~hint-size[k, v] void(a v mut[k], size nat32) k key
	if size > a.entries.size / 2
		expand-to-capacity a, size * 9 / 8

| Gets the value associated with a key.
| Returns an empty option if {key} is not in the map.
+subscript[k, v] v?(a v mut[k], key k) k key
	if index = get-index a.entries, key
		b trusted unsafe-at! a.entries, index

| Sets the key to the given value, so that `{a}[{key}]` will return {value}.
| If the key was already in the map, this overwrites the previous value.
+set-subscript[k, v] void(a v mut[k], key k, value v) k key
	forbid write-locked a else was-locked
	if index = get-index a.entries, key
		trusted unsafe-set-at a.entries, index, (key, value)
	else
		must-add a, key, value

| Removes all pairs, leaving the map empty.
+clear[k, v] void(a v mut[k]) k key
	forbid write-locked a else was-locked
	a.entries := ()
	a.size-and-locked := 0

| Set the contents of {a} to the contents of {b} and vice versa.
| This is O(1).
+swap[k, v] void(a v mut[k], b v mut[k]) k key
	forbid write-locked a or write-locked b else was-locked
	temp-entries = a.entries
	a.entries := b.entries
	b.entries := temp-entries
	temp-size = a.size-and-locked
	a.size-and-locked := b.size-and-locked
	b.size-and-locked := temp-size

| If the key is in the map, removes it and returns the associated value.
+remove[k, v] v?(a v mut[k], key k) k key
	forbid write-locked a else was-locked
	do if index = get-index a.entries, key
	value = b trusted unsafe-at! a.entries, index
	trusted remove-at-index a, index
	value

| Assumes the index is valid
-remove-at-index[k, v] void(a v mut[k], index nat32) k key, unsafe
	# When there is a hole, move values closer to where they should be.
	hole mut = index
	unsafe-set-at a.entries, hole, ()
	from mut = next-index index, a.entries
	while key, _ = unsafe-at a.entries, from
		key-desired-index = (wrap-to::nat32 trusted seeded-hash key) % a.entries.size
		if (walk-distance a.entries, key-desired-index, hole) < (walk-distance a.entries, key-desired-index, from)
			swap-at a.entries, hole, from
			hole := from
		from next-index:= a.entries
	a.size-and-locked -:= 1

| Ensures that a key is the map.
| If the key is already in the map, does nothing and returns the associated value.
| Otherwise, sets the value to `{get-value}[]` and returns that.
+ensure[k, v] v(a v mut[k], key k, get-value v mut()) k key
	forbid write-locked a else was-locked
	res = if index = get-index a.entries, key
		b trusted unsafe-at! a.entries, index
	else
		value =
			a.write-locked := true
			finally a.write-locked := false
			get-value[]
		must-add a, key, value
		value
	res

+ensure[k, v] v(a v mut[k], key k) k key, v new
	ensure a, key, {}

-must-add[k, v] void(a v mut[k], key k, value v) k key
	if should-expand-before-add a
		do-expand a
	a.size-and-locked +:= 1
	must-add-to-entries a.entries, key, value

-must-add-to-entries[k, v] void(entries (k, v)? buffer, initial-key k, initial-value v) k key
	key mut = initial-key
	value mut = initial-value
	index mut = ideal-index key, entries.size
	my-cost mut nat64 = 0
	while existing-key, existing-value = trusted unsafe-at entries, index
		forbid existing-key == key
		its-cost = cost entries, existing-key, index
		if my-cost > its-cost
			trusted unsafe-set-at entries, index, (key, value)
			key := existing-key
			value := existing-value
			my-cost := its-cost
		index next-index:= entries
		my-cost +:= 1
	trusted unsafe-set-at entries, index, (key, value)

-cost[k, v] nat64(entries (k, v)? buffer, key k, actual-index nat32) k key
	walk-distance entries, (ideal-index key, entries.size), actual-index

-ideal-index[k] nat32(key k, array-size nat32) k key
	(wrap-to::nat32 trusted seeded-hash key) % array-size

| This is the same as calling `{a}[{key}] := {value}`.
| Prefer to write it that way instead.
+ ~=[k, v] void(a v mut[k], (key k, value v)) k key
	a[key] := value

+ ~~=[k, v] void(a v mut[k], pairs (k, v)[]) k key
	for pair in pairs
		a ~= pair

-get-index[k, v] nat32?(entries (k, v)? buffer, key k) k key
	do unless is-empty entries
	start-i = ideal-index key, entries.size
	i mut = start-i
	do until
	do if k, _ = trusted unsafe-at entries, i else ()::nat32?
	if key == k
		i
	else
		i next-index:= entries
		if i == start-i then ()::nat32?

-next-index[t] nat32(index nat32, array t buffer)
	res = index + 1
	if res == array.size
		0
	else
		res

| Number of {next-index} calls it would take to get from {from} to {to}
-walk-distance[t] nat32(entries t buffer, from nat32, to nat32)
	if from <= to
		to - from
	else
		entries.size + to - from

-should-expand-before-add[k, v] bool(a v mut[k]) k key
	forbid write-locked a
	if a.size-and-locked <= 8
		a.size-and-locked::nat == a.entries.size
	else
		a.size-and-locked::nat * 4 / 3 >= a.entries.size

-do-expand[k, v] void(a v mut[k]) k key
	expand-to-capacity a, if a.entries.size < 2 then 2 else a.entries.size * 2

-expand-to-capacity[k, v] void(a v mut[k], new-capacity nat32) k key
	new-entries (k, v)? buffer = n-of new-capacity, ()
	for e in a.entries
		if k, v = e
			must-add-to-entries new-entries, k, v
	a.entries := new-entries

| Filters the map in place.
| Calls {f} on every key and value and removes the key if {f} returns {false}.
+filter=[k, v] void(a v mut[k], f bool mut(key k, value v)) k key
	forbid write-locked a else was-locked
	a.write-locked := true
	finally a.write-locked := false
	for key in a.keys
		index = get-index! a.entries, key
		unless f[trusted unsafe-at! a.entries, index]
			trusted remove-at-index a, index

| Calls {f} on every key and value, and replaces the value with the new value returned by {f}.
| Does not modify keys.
+map-values=[k, v] void(a v mut[k], f v mut(key k, value v)) k key
	forbid write-locked a else was-locked
	a.write-locked := true
	finally a.write-locked := false
	for index, entry in with-index a.entries
		if key, value = entry
			trusted unsafe-set-at a.entries, index, (key, f[key, value])

+keys[k, v] k[](a v mut[k]) k key
	sort with out in build a.size
		for pair in a.entries
			if k, _ = pair
				out ~= k

+values[k, v] v[](a v mut[k]) k key
	map a.to::(k, v)[], it.b

+some[k, v] bool(a v mut[k], f bool mut(key k, value v)) k key
	locked-before = write-locked a
	unless locked-before
		a.write-locked := true
	finally
		unless locked-before
			a.write-locked := false
	some a.to::(k, v)[], f

+mut-map-unsorted[k, v] record mut
	-inner v mut[k]
+unsorted[k, v] (k, v) mut-map-unsorted(a v mut[k]) unsafe
	a,
+size[k, v] nat32(a (k, v) mut-map-unsorted)
	size a.inner
+some[k, v] bool(a (k, v) mut-map-unsorted, f bool mut(key k, value v)) unsafe
	locked-before = write-locked a.inner
	unless locked-before
		a.inner.write-locked := true
	finally
		unless locked-before
			a.inner.write-locked := false
	entries = a.inner.entries
	i mut nat32 = 0
	do until
	if i == entries.size
		false
	else
		entry = unsafe-at entries, i
		if entry and f[entry]
			true
		else
			i +:= 1
			()
