+mut-enum-map[k, v] record mut, ~new
	values v buffer

+enum-like[t] spec t data
	to nat8(a t)
	members t[]()

~check-valid-enum[k] void() k enum-like
	for index, key in with-index members::k[]
		to::nat8 key is index.to

+clear[k, v] void(a (k, v) mut-enum-map) v new
	for i in 0 .. a.values.size
		a.values[i] := ()

+list-new[k, v] (k, v) mut-enum-map(elements (k, v)[]) k enum-like, v new
	check-valid-enum@k
	res (k, v) mut-enum-map = values: map members::k[], {}
	for k, v in elements
		res[k] := v
	res

| Always the number of members in the enum.
+size[k, v] nat32(a (k, v) mut-enum-map)
	a.values.size

+set-subscript[k, v] void(a (k, v) mut-enum-map, key k, value v) k enum-like
	a.values[key.to] := value
+subscript[k, v] v(a (k, v) mut-enum-map, key k) k enum-like
	a.values[key.to]

+some[k, v] bool(a (k, v) mut-enum-map, f bool mut(key k, value v)) k enum-like
	some members::k[], {f[it, a[it]]}

+map=[k, v] void(a (k, v) mut-enum-map, f v mut(key k, value v)) k enum-like
	for key in members::k[]
		a[key] := f[key, a[key]]
