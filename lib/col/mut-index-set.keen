no-std
import
	../bits
	../bool
	../compare
	../misc
	../number
	../option
	../range
	./array
	./buffer
	./collection
	./util

| Set of {nat}s. This takes up space proportional to the largest value.
| This is ideal for a reasonably dense (at least 1/64 full) set of small numbers.
+mut-index-set record mut
	~words mut nat64 buffer

+list-new mut-index-set(a nat64[])
	do if max = max-of a else words: ()
	res = new-with-capacity max + 1
	for x in a
		res ~= x
	res

| {capacity} is 1 more than the greatest value that it can store without reallocating.
+new-with-capacity mut-index-set(capacity nat64)
	words: n-of (divide-and-round-up capacity, 64), 0

+is-empty bool(a mut-index-set)
	a.size == 0

| This is O(n) (but pretty fast) where n is the largest value in {a}.
+size nat(a mut-index-set)
	sum a.words, it.count-ones

+to nat[](a mut-index-set) = map a, {it}

+subscript bool(a mut-index-set, n nat64)
	word-index = n / 64
	word-index < a.words.size and has-bit a.words[word-index], n % 64

+ ~= void(a mut-index-set, n nat64)
	ensure-capacity a, n
	a.words[n / 64] add-bit:= n % 64

-ensure-capacity void(a mut-index-set, max-value nat64)
	word-capacity = divide-and-round-up (max-value + 1), 64
	do if a.words.size < word-capacity
	words nat64 buffer = trusted uninitialized-buffer word-capacity
	words[0 .. a.words.size] := a.words
	for i in a.words.size .. word-capacity
		words[i] := 0
	a.words := words

+ try-add bool(a mut-index-set, n nat64)
	unless a[n]
		a ~= n
		true

+ -= void(a mut-index-set, n nat64)
	word-index = n / 64
	do if word-index < a.words.size
	a.words[word-index] remove-bit:= n % 64

+some bool(a mut-index-set, f bool mut(n nat))
	word-index mut = 0
	until
		if word-index == a.words.size
			false
		elif some a.words[word-index].one-bits, {f[word-index * 64 + it]}
			true
		else
			word-index +:= 1
			()
