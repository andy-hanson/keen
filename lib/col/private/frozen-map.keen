no-std
import
	../../bool
	../../compare
	../../hash
	../../misc
	../../number
	../../option
	../../range
	../../tuple
	../array
	../collection
	../util
	../buffer

| Immutable map that is not efficient to update.
| However, this is more compact than `v[k]` and has faster lookups.
~frozen-map[k, v] record
	-pairs (k, v)[]
	-bucket-starts nat64[]

~list-new[k, v] (k, v) frozen-map(a (k, v)[]) k key
	a.to

~to[k, v] (k, v) frozen-map(a (k, v)[]) k key
	trusted as-frozen-map a.to
~to[k, v] (k, v) frozen-map(a (k, v) array-view) k key
	trusted as-frozen-map a.to

| This is O(1). Unsafe because the pairs are unsorted.
~to[k, v] (k, v)[](a (k, v) frozen-map) unsafe
	a.pairs

~is-empty[k, v] bool(a (k, v) frozen-map)
	is-empty a.pairs

~size[k, v] nat64(a (k, v) frozen-map)
	size a.pairs

~subscript[k, v] v?(a (k, v) frozen-map, key k) k key
	if index = find (bucket-indices a, key), a.pairs[it].a == key
		a.pairs[index].b

-bucket-indices[k, v] nat64 range(a (k, v) frozen-map, key k) k key
	if is-empty a.bucket-starts
		0 .. a.pairs.size
	else
		bucket-indices-at-index a, (trusted seeded-hash key) % a.bucket-starts.size

# Returns a slice of 'a.pairs'
-bucket-indices-at-index[k, v] nat64 range(a (k, v) frozen-map, bucket-index nat64)
	bucket-start = a.bucket-starts[bucket-index]
	bucket-end = if bucket-index == a.bucket-starts.size - 1
		a.pairs.size
	else
		a.bucket-starts[bucket-index + 1]
	bucket-start .. bucket-end

-bucket-at-index[k, v] (k, v) array-view(a (k, v) frozen-map, bucket-index nat64)
	a.pairs[bucket-indices-at-index a, bucket-index]

-as-frozen-map[k, v] (k, v) frozen-map(a (k, v) buffer) unsafe, k key
	remove-duplicates a.make-frozen-map

-make-frozen-map[k, v] (k, v) frozen-map
	a (k, v) buffer
do unsafe, k key
	if a.size <= 4
		a.cast-immutable, ()
	else
		n-buckets = a.size / 2
		bucket-starts = get-bucket-starts a, n-buckets
		bucket-counts nat64 buffer = n-of n-buckets, 0
		cur mut nat64 = 0
		until cur == a.size
			bucket-index = get-bucket-index a[cur].a, bucket-counts.size
			bucket-count = bucket-counts[bucket-index]
			bucket-start = bucket-starts[bucket-index]
			bucket-cur-end = bucket-start + bucket-count
			if bucket-start <= cur and cur <= bucket-cur-end
				if cur == bucket-cur-end
					bucket-counts[bucket-index] := bucket-count + 1
				cur +:= 1
			else
				bucket-counts[bucket-index] := bucket-count + 1
				swap-at a, cur, bucket-cur-end
		a.cast-immutable, bucket-starts

-remove-duplicates[k, v] (k, v) frozen-map(a (k, v) frozen-map) unsafe, k key
	if has-duplicates a
		# Write out pairs from each bucket to a buffer,
		# omitting a pair if its key appears later in the same bucket.
		make-frozen-map with out in build a.size
			write-without-duplicates out, a
	else
		a

-write-without-duplicates[k, v] void(out (k, v) builder, a (k, v) frozen-map) k key
	if is-empty a.bucket-starts
		write-bucket-without-duplicates out, a.pairs
	else
		for i in 0 .. a.bucket-starts.size
			write-bucket-without-duplicates out, bucket-at-index a, i

-write-bucket-without-duplicates[k, v] void(out (k, v) builder, pairs (k, v) array-view) k key
	for i, pair in with-index pairs
		unless key-in-range pair.a, pairs[i + 1 .. end]
			out ~= pair

-has-duplicates[k, v] bool(a (k, v) frozen-map) k key
	if is-empty a.bucket-starts
		bucket-has-duplicates a.pairs
	else
		some 0 .. a.bucket-starts.size, of i
			bucket-has-duplicates bucket-at-index a, i

-bucket-has-duplicates[k, v] bool(pairs (k, v) array-view) k key
	some pairs.with-index, of i, (k, _)
		key-in-range k, pairs[i + 1 .. end]

-key-in-range[k, v] bool(key k, pairs (k, v) array-view) k key
	some pairs, it.a == key

-get-bucket-starts[k, v] nat64[](a (k, v) buffer, n-buckets nat64) unsafe, k key
	res nat64 buffer = n-of n-buckets, 0
	for k, _ in a
		res[get-bucket-index k, n-buckets] +:= 1
	running-sum res
	cast-immutable res

-get-bucket-index[k] nat64(key k, n-buckets nat64) k key
	(trusted seeded-hash key) % n-buckets

-running-sum void(a nat64 buffer)
	acc mut nat64 = 0
	a map= of x
		start = acc
		acc +:= x
		start

~some[k, v] bool(a (k, v) frozen-map, f bool mut(key k, value v)) unsafe
	some a.pairs, f
