no-std
import
	../../compare
	../../number
	../../range
	../collection

~to-range[col] nat32 range(col col, range range-relative-to-end) col size
	low = match x = range.low
	as nat32
		x
	as index-relative-to-end
		to-index col, x
	high = to-index col, range.high
	assert low <= high else index-too-big low, high
	low .. high
