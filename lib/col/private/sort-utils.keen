no-std
import
	../../bool
	../../compare
	../../exception
	../../hash
	../../misc
	../../number
	../../option
	../../range
	../../tuple
	../array
	../buffer
	../mut-array
	../util

binary-search-exact[t] nat64?(a t array-view, value t) t sorted-key
	res = binary-search-insert a, value
	if res != a.size and a[res] == value
		res
binary-search-exact[k, v] nat64?(a (k, v) array-view, key k) k sorted-key
	res = binary-search-insert-cb a, key <=> it.a
	if res != a.size and a[res].a == key
		res
binary-search-exact[k, v] nat64?(a (k, v) mut[], key k) k sorted-key
	binary-search-exact (trusted temp-as-array-view a), key

binary-search-insert[t] nat64(a t array-view, value t) t sorted-key
	binary-search-insert-cb a, value <=> it
binary-search-insert[k, v] nat64(a (k, v) array-view, key k) k sorted-key
	binary-search-insert-cb a, key <=> it.a

| Returns the pointer to the least value that is compared equal or greater.
| Returns `a.size` if all values compare less.
binary-search-insert-cb[t] nat64(a t mut[], compare comparison data(elem t))
	binary-search-insert-cb (trusted temp-as-buffer a), compare
binary-search-insert-cb[t] nat64(a t array-view, compare comparison data(elem t))
	left mut nat64 = 0
	right mut = a.size
	do until
	if left == right
		left
	else
		mid = left + (right - left) / 2
		match compare[a[mid]]
		as less
			right := mid
			()
		as equal
			mid
		as greater
			left := mid + 1
			()
binary-search-insert-cb[t] nat64(a t buffer-view, compare comparison data(elem t))
	binary-search-insert-cb (trusted cast-immutable a), compare

unique-comparison enum(less, greater)

assert-comparison-not-equal unique-comparison(a comparison)
	match a
	as less
		less
	as equal
		throw unreachable
	as greater
		greater

| {a} and {b} must be sorted. Moves contents of {b} into {a} and preserves sorting.
merge-no-duplicates[t] void(a t mut[], b t mut[], compare unique-comparison data(x t, y t))
	do unless is-empty b
	a-old-size = a.size
	trusted push-gc-safe-values a, b.size
	a-read mut = a-old-size - 1
	a-write mut = a.size - 1
	b-read mut = b.size - 1
	# Merge right-to-left so we never overwrite anything we still have to read.
	# Invariant: a-read, a-write, b-read are all valid indices.
	until
		match compare[a[a-read], b[b-read]]
		as less
			a[a-write] := b[b-read]
			if b-read == 0
				true
			else
				a-write -:= 1
				b-read -:= 1
				false
		as greater
			a[a-write] := a[a-read]
			if a-read == 0
				assert b-read + 1 == a-write
				for i in 0 .. a-write
					a[i] := b[i]
				true
			else
				a-read -:= 1
				a-write -:= 1
				false
	clear b
