| Efficient "map" with an enum key.
| This does actually not have the same interface as a {map}, since there must be a value for every key.
| The enum values must be 0 .. n. This is the default unless you explicitly write values.
+enum-map[k, v] record -new
	| One for each enum member
	values v[]
+enum-like[t] spec t data
	to nat8(a t)
	members t[]()

+list-new[k, v] (k, v) enum-map(elements (k, v)[]) k enum-like, v new
	check-valid-enum@k
	values v buffer = map members::k[], {}
	for k, v in elements
		values[k.to] := v
	values: trusted cast-immutable values

-check-valid-enum[k] void() k enum-like
	for index, key in with-index members::k[]
		to::nat8 key is index.to

| Make an enum map by providing a value for each key in a loop.
+make-enum-map record
+for-loop[k, v] (k, v) enum-map(_ make-enum-map, cb v mut(key k)) k enum-like
	check-valid-enum@k
	values: map members::k[], cb

| Always the number of members in the enum.
+size[k, v] nat32(a (k, v) enum-map)
	a.values.size
+subscript[k, v] v(a (k, v) enum-map, key k) k enum-like
	a.values[key.to]

+some[k, v] bool(a (k, v) enum-map, f bool mut(key k, value v)) k enum-like
	some members::k[], {f[it, a[it]]}

+update[k, v] (k, v) enum-map(a (k, v) enum-map, key k, value v) k enum-like
	values: update-at a.values, key.to, value

| Map an enum-map to another with the same key type.
+map-enum-map[k, v-out, v-in] (k, v-out) enum-map(a (k, v-in) enum-map, cb v-out mut(key k, value v-in)) k enum-like
	values: for key in members::k[] then cb[key, a[key]]

+lens-for-key[k, v] ((k, v) enum-map, v) lens(key k) k enum-like
	get: of map then map[key]
	set: of map, value then update map, key, value
