import
	./mut-array: temp-as-array-view
	./private/sort-utils

| Mutable sorted collection backed by a plain array. Ideal for small arrays.
+mut-sorted-array[t] record mut
	-inner t mut[]

+list-new[t] t mut-sorted-array(values t[]) t sorted-key
	values.to

+to[t] t mut-sorted-array(values t[]) t sorted-key
	inner t mut[] = values.to
	sort-in-place inner
	inner: inner

+has[t] bool(a t mut-sorted-array, value t) t sorted-key
	binary-search-exact (trusted temp-as-array-view a.inner), value

+is-empty[t] bool(a t mut-sorted-array) t sorted-key
	is-empty a.inner
+size[t] nat(a t mut-sorted-array) t sorted-key
	size a.inner

| This is O(n).
+ ~=[t] void(a t mut-sorted-array, value t) t sorted-key
	index = count-while a.inner, it < value
	insert-at a.inner, index, value

+pop-max[t] t?(a t mut-sorted-array) t sorted-key
	pop a.inner

| Iterate from least to greatest
+some[t] bool(a t mut-sorted-array, f bool mut(x t))
	some a.inner, f
| Iterate from greatest to least
+some-reverse[t] bool(a t mut-sorted-array, f bool mut(x t))
	some-reverse a.inner, f
