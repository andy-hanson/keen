+mut-queue[t] record mut
	# Queue is empty iff 'values' is.
	-values mut t buffer
	# 'end' is exclusive, but will always be a valid index unless 'values' is empty.
	-begin mut nat64
	-end mut nat64

+list-new[t] t mut-queue(values t[])
	values.to

+to[t] t mut-queue(a t[])
	a.to, 0, 0
+to[t] t[](a t mut-queue)
	map a, {it}

+is-empty[t] bool(a t mut-queue)
	is-empty a.values

+size[t] nat64(a t mut-queue)
	if a.begin < a.end
		a.end - a.begin
	else
		(a.values.size - a.end) + a.begin

+ ~=[t] void(a t mut-queue, value t)
	if a.begin == a.end
		old-size = a.values.size
		new-size = if old-size == 0 then 2 else old-size * 2
		new-values t buffer = trusted uninitialized-buffer new-size
		for i, x in with-index a
			new-values[i] := x
		new-values[old-size] := value
		a.values := new-values
		a.begin := 0
		a.end := advance a, old-size
	else
		a.values[a.end] := value
		a.end := advance a, a.end

+ ~~=[t, col] void(a t mut-queue, values col) (col, t) some
	for x in values
		a ~= x

+dequeue[t] t?(a t mut-queue)
	do unless is-empty a
	res = a.values[a.begin]
	a.begin := advance a, a.begin
	if a.begin == a.end
		a.values := ()
	res

-advance[t] nat64(a t mut-queue, index nat64)
	res = index + 1
	if res == a.values.size then 0 else res

+some[t] bool(a t mut-queue, f bool mut(elem t))
	do unless is-empty a
	cur mut = begin a
	do until
	if f[a.values[cur]]
		true
	else
		cur := advance a, cur
		if cur == a.end then false

test
	a nat64 mut-queue = ()
	assert is-empty a
	a.to::nat64[] is ()

	a ~= 1
	a.to::nat64[] is (1,)
	forbid is-empty a
	a.dequeue is 1
	assert is-empty a
	a.dequeue is ()
	assert is-empty a

	a ~~= (2, 3, 4)::nat64[]
	a.to::nat64[] is (2, 3, 4)
	a.dequeue is 2
	a.dequeue is 3
	a.dequeue is 4
	a.dequeue is ()
