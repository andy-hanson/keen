import
	./mut-multi-map

| Unordered collection of pairs that supports lookup by key.
| Unlike with a {map}, keys are not unique.
| However, (key, value) pairs are unique. (Test using `a[key][value]`)
+multi-map[k, v] record
	-inner v set[k]
+ ==[k, v] bool(a (k, v) multi-map, b (k, v) multi-map) k key, v key
	trusted a.inner == b.inner
+ <=>[k, v] comparison(a (k, v) multi-map, b (k, v) multi-map) k key, v key
	trusted a.inner <=> b.inner
+ hash[k, v] void(a (k, v) multi-map, state hash-state) k key, v key
	trusted hash a.inner, state
+to[k, v] json(a (k, v) multi-map) k key, k to-json, v key, v to-json
	a.inner.to
+to[k, v] (k, v) multi-map(a json) k key, k from-json, v key, v from-json
	inner: a.to

+list-new[k, v] (k, v) multi-map(pairs (k, v)[]) k key, v key
	map (k, v) mut-multi-map = to pairs
	inner: for key in keys map
		key, map map[key], {it}

+subscript[k, v] v set(a (k, v) multi-map, key k) k key, v key
	a.inner[key] else ()

+ ~[k, v] (k, v) multi-map(a (k, v) multi-map, (key k, value v)) k key, v key
	values = a[key]
	if values[value]
		a
	else
		inner: a.inner ~ (key, values ~ value)

| If the (key, value) pair exists in the map, this is the map without it.
| Else this is an empty option.
+try-remove-pair[k, v] (k, v) multi-map?(a (k, v) multi-map, key k, value v) k key, v key
	values = a.inner[key]
	if values and new-values = try-remove values, value
		inner: a.inner ~ (key, new-values)

| Like `try-remove-pair`, but if {a} does not contain the pair, this just returns {a}.
+remove-pair[k, v] (k, v) multi-map(a (k, v) multi-map, key k, value v) k key, v key
	try-remove-pair a, key, value else a

| If the key exists in the map, this is the map without all associated values.
| Else this is an empty option.
+try-remove-key[k, v] (k, v) multi-map?(a (k, v) multi-map, key k) k key, v key
	if _, new-inner = remove a.inner, key
		inner: new-inner

| Removes all values for the key (if any).
+remove-key[k, v] (k, v) multi-map(a (k, v) multi-map, key k) k key, v key
	try-remove-key a, key else a

+some[k, v] bool(a (k, v) multi-map, f bool mut(key k, value v)) k key, v key
	some a.inner, of key, values
		some values, {f[key, it]}

+multi-map-by-key[k, v] record
	map (k, v) multi-map
+by-key[k, v] (k, v) multi-map-by-key(a (k, v) multi-map) = a,
+some[k, v] bool(a (k, v) multi-map-by-key, f bool mut(key k, value v set)) k key, v key
	some a.map.inner, f
