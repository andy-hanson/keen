no-std
import
	java/lang/IndexOutOfBoundsException
	../bool
	../compare
	../hash
	../lens
	../misc
	../number
	../option
	../private/bootstrap: high, inner, low
	../range
	../tuple
	../unsafe
	./buffer
	./collection
	./private/private-util
export
	../private/bootstrap: array, array-view

# Called implicitly by the compiler
~to-array-view[t] t array-view(a t[])
	array-view a, 0, a.size

| Alternative to {subscript} that returns an option instead of throwing
+at[t] t?(a t array-view, index nat32)
	if index < a.size
		a[index]

| Throws {index-too-big} if the index is too big
+subscript[t] t(a t[], index nat32)
	trusted if java
		try
			unsafe-at a, index
		catch as IndexOutOfBoundsException
			throw index-too-big index, a.size
	else
		assert index < a.size else index-too-big index, a.size
		unsafe-at a, index
~unsafe-at[t] t(a t[], index nat32) unsafe
+subscript[t] t(a t array-view, index nat32)
	assert index < a.size else index-too-big index, a.size
	trusted unsafe-at a.inner, a.low + index

+subscript[t] t array-view(a t[], indices nat32 range)
	(a::(t array-view))[indices]
+subscript[t] t array-view(a t array-view, indices nat32 range)
	assert indices.high <= a.size else index-too-big indices.high, a.size
	array-view a.inner, a.low + indices.low, a.low + indices.high

+subscript[t] t(a t[], index index-relative-to-end)
	a[to-index a, index]
+subscript[t] t(a t array-view, index index-relative-to-end)
	a[to-index a, index]

+subscript[t] t array-view(a t[], indices range-relative-to-end)
	(a::(t array-view))[indices]
+subscript[t] t array-view(a t array-view, indices range-relative-to-end)
	a[to-range a, indices]

+list-new[t] t[](a t[])
	a

+size[t] nat32(a t[])
+size[t] nat32(a t array-view)
	a.high - a.low

+to[t] t[](a t range) t rangeable, t difference
	res t buffer = trusted uninitialized-buffer a.size
	i mut nat32 = 0
	_ = some a, of x
		res[i] := x
		i +:= 1
		false
	trusted cast-immutable res
+to[t] t[](a t array-view)
	if a.size == a.inner.size
		a.inner
	else
		trusted cast-immutable a.to::(t buffer)

| {true} if `a.size == 0`.
+is-empty[t] bool(a t[])
	a.size == 0
+is-empty[t] bool(a t array-view)
	a.low == a.high

| Prepend an element to an array.
| This is O(n).
+ ~[t] t[](a t, b t[])
	(a,)::t[] ~~ b
+ ~[t] t[](a t, b t array-view)
	(a,)::(t array-view) ~~ b

| Append an element to an array.
| This is O(n).
+ ~[t] t[](a t[], b t)
	a ~~ (b,)::t[]
+ ~[t] t[](a t array-view, b t)
	a ~~ (b,)::(t array-view)

| Used by the compiler to implement list-new expressions
~concat-array-views[t] t[](parts t array-view[])
	size mut nat32 = 0
	_ = some parts, of part
		size +:= part.size
		false
	res t buffer = trusted uninitialized-buffer size
	i mut nat32 = 0
	_ = some parts, of part
		j = i + part.size
		res[i .. i + part.size] := part
		i := j
		false
	assert i == res.size
	trusted cast-immutable res

| Concatenates two arrays.
| This is O(n).
+ ~~[t] t[](a t[], b t[])
	if is-empty a
		b
	elif is-empty b
		a
	else
		a.to-array-view ~~ b.to-array-view
+ ~~[t] t[](a t array-view, b t array-view)
	if is-empty a
		b.to
	elif is-empty b
		a.to
	else
		res t buffer = trusted uninitialized-buffer a.size + b.size
		res[0 .. a.size] := a
		res[a.size .. res.size] := b
		trusted cast-immutable res

+ ==[t] bool(a t[], b t[]) t equal
	trusted a.to-array-view == b.to-array-view

+ ==[t] bool(a t array-view, b t array-view) t equal
	trusted if reference-equal a.inner, b.inner and a.low == b.low and a.high == b.high
		true
	elif a.size != b.size
		false
	else
		i mut nat32 = 0
		do until
		if i == a.size
			true
		elif a[i] != b[i]
			false
		else
			i +:= 1
			()

+ <=>[t] comparison(a t[], b t[]) t compare
	trusted a.to-array-view <=> b.to-array-view
+ <=>[t] comparison(a t array-view, b t array-view) t compare
	do trusted
	do unless trusted reference-equal a, b else equal
	i mut nat32 = 0
	limit = min a.size, b.size
	do until
	if i == limit
		a.size <=> b.size
	else
		match res = a[i] <=> b[i]
		as equal
			i +:= 1
			()
		else
			res

region basic array operations

+nth[t] (t[], t) lens(n nat32)
	get: of xs then xs[n]
	set: of xs, x then update-at xs, n, x

| Returns a new array like {a} but where `{a}[{index}]` is replaced with {new-value}.
| This is O(n).
|
| {index} must be a valid index into {a}. This can't be used to add a value to the end.
+update-at[t] t[](a t[], index nat32, new-value t)
	update-at a.to-array-view, index, new-value
+update-at[t] t[](a t array-view, index nat32, new-value t)
	assert index < a.size else index-too-big index, a.size
	-- a[0 .. index]
	- new-value
	-- a[index + 1 .. end]

| Inserts an element at {index}.
| Moves all elements that were at {index} or after to the right.
| Unlike for {update-at}, {index} can be `{a}.{size}`, though it still can't be higher.
+insert-at[t] t[](a t[], index nat32, value t)
	insert-at a.to-array-view, index, value
+insert-at[t] t[](a t array-view, index nat32, value t)
	assert index <= a.size else index-too-big index, a.size
	-- a[0 .. index]
	- value
	-- a[index .. end]

| Removes the element at {index}, shifting all later elements to the left.
+remove-at[t] t[](a t[], index nat32)
	remove-at a.to-array-view, index
+remove-at[t] t[](a t array-view, index nat32)
	assert index < a.size else index-too-big index, a.size
	a[0 .. index] ~~ a[index + 1 .. a.size]

+hash[t] void(a t[], state hash-state) t hash
	trusted hash a.to-array-view, state
+hash[t] void(a t array-view, state hash-state) t hash
	do trusted
	i mut nat32 = 0
	until i == a.size
		hash a[i], state
		i +:= 1

+some[t] bool(a t[], f bool mut(elem t))
	i mut nat32 = 0
	do until
	if i == a.size
		false
	elif f[a[i]]
		true
	else
		i +:= 1
		()
+some[t] bool(a t array-view, f bool mut(x t))
	i mut = a.low
	do until
	if i == a.high
		false
	elif f[trusted unsafe-at a.inner, i]
		true
	else
		i +:= 1
		()

+some-reverse[t] bool(a t[], f bool mut(x t))
	some-reverse a.to-array-view, f
+some-reverse[t] bool(a t array-view, f bool mut(x t))
	do unless is-empty a
	i mut = a.high - 1
	do until
	if f[trusted unsafe-at a.inner, i]
		true
	elif i == a.low
		false
	else
		i -:= 1
		()

+array-iterator[t] record mut
	~array t[]
	-start nat32
	~cur mut nat32
	-end nat32
+begin[t] t array-iterator(a t[])
	a, 0, 0, a.size
+begin[t] t array-iterator(a t array-view)
	a.inner, a.low, a.low, a.high
+end[t] t array-iterator(a t[])
	a, 0, a.size, a.size
+end[t] t array-iterator(a t array-view)
	a.inner, a.low, a.high, a.high
+copy[t] t array-iterator(a t array-iterator)
	a.array, a.start, a.cur, a.end
+is-at-begin[t] bool(a t array-iterator)
	a.cur == a.start
+is-at-end[t] bool(a t array-iterator)
	a.cur == a.end
| If {a} iterates an {array-view}, this is the index relative to the view.
+index[t] nat32(a t array-iterator)
	a.cur - a.start
+set-index[t] void(a t array-iterator, index nat32)
	assert a.start + index <= a.end
	a.cur := a.start + index
+take-prev[t] t(a t array-iterator)
	assert a.cur > a.start else iterator-out-of-bounds
	a.cur -:= 1
	trusted unsafe-at a.array, a.cur
+peek[t] t?(a t array-iterator)
	if a.cur < a.end
		trusted unsafe-at a.array, a.cur
| Peek with an offset
+peek-by[t] t?(a t array-iterator, relative-index nat32) t equal
	index = a.cur + relative-index
	if index < a.end
		trusted unsafe-at a.array, index
+peek-prev[t] t?(a t array-iterator)
	if a.cur > a.start
		trusted unsafe-at a.array, a.cur - 1
+take-next[t] t(a t array-iterator)
	assert a.cur < a.end else iterator-out-of-bounds
	res = trusted unsafe-at a.array, a.cur
	a.cur +:= 1
	res
+take-next-n[t] t array-view(a t array-iterator, n nat32)
	assert a.cur + n <= a.end else iterator-out-of-bounds
	res = a.array[a.cur .. a.cur + n]
	a.cur +:= n
	res
+take-prev-n[t] t array-view(a t array-iterator, n nat32)
	assert a.start + n <= a.cur else iterator-out-of-bounds
	end = a.cur
	a.cur -:= n
	a.array[a.cur .. end]
+skip-next-n[t] void(a t array-iterator, n nat32)
	_ = take-next-n a, n
+skip-prev-n[t] void(a t array-iterator, n nat32)
	_ = take-prev-n a, n
+slice[t] t array-view(begin t array-iterator, end t array-iterator)
	assert begin.start == end.start and begin.end == end.end
	begin.array[begin.cur .. end.cur]
