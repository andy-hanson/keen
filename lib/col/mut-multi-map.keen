| Unordered collection of pairs that supports lookup by key.
| Unlike with a {mut-map}, keys are not unique.
| However, (key, value) pairs are unique.
+mut-multi-map[k, v] record mut
	-inner v mut-set mut[k]

+list-new[k, v] (k, v) mut-multi-map(pairs (k, v)[]) k key, v key
	to pairs
+to[k, v] (k, v) mut-multi-map(pairs (k, v)[]) k key, v key
	res (k, v) mut-multi-map = inner: ()
	for pair in pairs
		res ~= pair
	res
+ ~=[k, v] void(a (k, v) mut-multi-map, (key k, value v)) k key, v key
	ensure a.inner, key ~= value

+some[k, v] bool(a (k, v) mut-multi-map, f bool mut(key k, value v)) k key, v key
	some a.inner, of key, values
		some values, {f[key, it]}

+mut-multi-map-keys[k, v] record mut
	-inner (k, v) mut-multi-map
+keys[k, v] (k, v) mut-multi-map-keys(a (k, v) mut-multi-map) k key, v key
	inner: a
+size[k, v] nat(a (k, v) mut-multi-map-keys) k key, v key
	a.inner.inner.size
+some[k, v] bool(a (k, v) mut-multi-map-keys, f bool mut(key k)) k key, v key
	some a.inner.inner, {f[it.a]}

+mut-multi-map-values-for-key[k, v] record mut
	-inner v mut-set?
+ subscript[k, v] (k, v) mut-multi-map-values-for-key(a (k, v) mut-multi-map, key k) k key, v key
	inner: a.inner[key]
+size[k, v] nat(a (k, v) mut-multi-map-values-for-key) k key, v key
	if a.inner then a.inner.size
+some[k, v] bool(a (k, v) mut-multi-map-values-for-key, f bool mut(value v)) v key
	a.inner and some a.inner, f
