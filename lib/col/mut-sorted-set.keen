import
	./mut-sorted-map

+mut-sorted-set[t] record mut
	-inner (t, void) mut-sorted-map

+list-new[t] t mut-sorted-set(a t[]) t sorted-key
	a.to

+to[t] t mut-sorted-set(a t[]) t sorted-key
	inner: to for::(t, void)[] x in a then (x, ())

+is-empty[t] bool(a t mut-sorted-set)
	is-empty a.inner

+clear[t] void(a t mut-sorted-set)
	clear a.inner

+size[t] nat(a t mut-sorted-set)
	size a.inner

+subscript[t] bool(a t mut-sorted-set, value t) t sorted-key
	!!a.inner[value]

+ ~=[t] void(a t mut-sorted-set, value t) t sorted-key
	a.inner[value] := ()

+remove[t] bool(a t mut-sorted-set, value t) t sorted-key
	!!(remove-key a.inner, value)

+min-value[t] t?(a t mut-sorted-set) t sorted-key
	min-key a.inner

+max-value[t] t?(a t mut-sorted-set) t sorted-key
	max-key a.inner

+remove-min[t] t?(a t mut-sorted-set) t sorted-key
	a.inner.remove-min-key.?a

+remove-max[t] t?(a t mut-sorted-set) t sorted-key
	a.inner.remove-max-key.?a

+some[t] bool(a t mut-sorted-set, f bool mut(x t)) t sorted-key
	some a.inner, f[it.a]
