import
	keen/bits
	./mut-enum-map

+enum-set[t] record
	-value nat

+ ==[t] bool(a t enum-set, b t enum-set)
	trusted a.value == b.value
+ <=>[t] comparison(a t enum-set, b t enum-set)
	trusted a.value <=> b.value
+ hash[t] void(a t enum-set, state hash-state)
	trusted hash a.value, state
+ to[t] json(a t enum-set) t enum-like, t to-json
	a.to::t[].to
+ to[t] t enum-set(a json) t enum-like, t from-json
	a.to::t[].to

+list-new[t] t enum-set(elements t[]) t enum-like
	to elements
+all[t] t enum-set() t enum-like
	value: low-n-bits members::t[].size
+to[t] t enum-set(a t[]) t enum-like
	res mut t enum-set = value: 0
	for x in a
		res |:= x
	res
+to[t] t[](a t enum-set) t enum-like
	map a, {it}

+subscript[t] bool(a t enum-set, value t) t enum-like
	has-bit a.value, value.to::nat
+ &[t] t enum-set(a t enum-set, b t enum-set) t enum-like
	value: a.value & b.value
+ |[t] t enum-set(a t enum-set, b t enum-set) t enum-like
	value: a.value | b.value
+ |[t] t enum-set(a t enum-set, value t) t enum-like
	value: a.value | value.to::nat.nth-bit

+is-empty[t] bool(a t enum-set)
	a.value == 0
+is-full[t] bool(a t enum-set) t enum-like
	a == all
+size[t] nat(a t enum-set)
	count-ones a.value
+some[t] bool(a t enum-set, f bool mut(x t)) t enum-like
	some members::t[], of x
		a[x] and f[x]
