import
	./mut-sorted-map

+mut-sorted-list[k, v] record mut
	-inner (k, v mut[]) mut-sorted-map

+list-new[k, v] (k, v) mut-sorted-list(pairs (k, v)[]) k sorted-key
	res (k, v) mut-sorted-list = ()
	for pair in pairs
		res ~= pair
	res

+to[k, v] (k, v)[](a (k, v) mut-sorted-list) k sorted-key
	map a, {it}

+is-empty[k, v] bool(a (k, v) mut-sorted-list) k sorted-key
	is-empty a.inner
+size[k, v] nat32(a (k, v) mut-sorted-list) k sorted-key
	sum a.inner, it.b.size

+ ~=[k, v] void(a (k, v) mut-sorted-list, (key k, value v)) k sorted-key
	(ensure a.inner, key) ~= value

+remove-max-key[k, v] (k, v)?(a (k, v) mut-sorted-list) k sorted-key
	if key = a.inner.max-key
		values = a.inner[key]!
		res = pop! values
		if is-empty values
			_ = remove-max-key a.inner
		key, res

+some[k, v] bool(a (k, v) mut-sorted-list, f bool mut(key k, value v)) k sorted-key
	some a.inner, of key, values
		some values, {f[key, it]}
