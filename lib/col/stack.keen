no-std
import
	../bool
	../json
	../misc
	../number
	../option
	../test-util
	../tuple
	./array
	./collection
	./util

| Immutable stack type.
| Iterates from the bottom (least recently pushed) to the top (most recently pushed).
+stack[t] record
	-last-node t node?

-node[t] record(prev t node?, value t)

| The first element of {a} goes on the bottom and the last element of {a} goes on the top.
+list-new[t] t stack(a t[])
	a.to

| Stack containing the given elements.
| The first element of {a} goes on the bottom and the last element of {a} goes on the top.
+to[t] t stack(a t[])
	res mut t stack = ()::(t node?),
	for x in a
		res ~:= x
	res

+to[t] t[](a t stack)
	for x in a then x

| {true} if `{a}.{size} == 0`.
+is-empty[t] bool(a t stack)
	!a.last-node

| Appends an element to the stack.
| This is O(1).
+ ~[t] t stack(a t stack, b t)
	(a.last-node, b),

| Number of elements in the stack.
| This is O(1).
+size[t] nat64(a t stack)
	res mut nat64 = 0
	for _ in a
		res +:= 1
	res

| Top element.
| Returns an empty option if `{a} {is-empty}`.
| This is O(1).
+peek[t] t?(a t stack)
	a.last-node.?value

| Returns the top element of the a stacknd a new stack with all elements but the top.
| Returns an empty option if `{a} {is-empty}`.
+pop[t] (t stack, t)?(a t stack)
	if node = a.last-node
		(node.prev,), node.value

+some[t] bool(a t stack, f bool mut(elem t))
	some-recur a.last-node, f
-some-recur[t] bool(a t node?, f bool mut(elem t))
	if a
		some-recur a.prev, f or f[a.value]
+some-reverse[t] bool(a t stack, f bool mut(elem t))
	cur mut = a.last-node
	do until
	do if c = cur else false
	if f[c.value]
		true
	else
		cur := c.prev
		()

~to-array-reverse[t] t[](a t stack)
	do with out in build a.size
	_ = some-reverse a, of x
		out ~= x
		false

test
	a nat64 stack = ()
	assert is-empty a
	a.to::nat64[] is ()
	a.peek is ()

	b = a ~ 1
	b.to::nat64[] is (1,)
	b.peek is 1
	b-popped = pop! b
	b.pop!.a.to::nat64[] is ()
	b-popped.b is 1
	forbid is-empty b

	c = b ~ 2
	c.to::nat64[] is (1, 2)
	c.peek is 2
	c-popped = c.pop!
	c-popped.a.to::nat64[] is (1,)
	c-popped.b is 2

	d = c ~ 3
	d.to::nat64[] is (1, 2, 3)

	map::nat64[] d, {it} is (1, 2, 3)
	d.reverse.to::nat64[] is (3, 2, 1)
