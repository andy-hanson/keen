no-std
import
	../bits
	../bool
	../compare
	../js
	../misc
	../number
	../option
	../range
	../tuple
	./collection
	./array
	./buffer

+array-like[col, elem] spec col size
	subscript elem(a col, index nat32)
+buffer-like[col, elem] spec (col, elem) array-like
	set-subscript void(a col, index nat32, value elem)

| Calls {f} for each element in the collection and returns nothing.
+for-loop[col, elem] void(a col, f void mut(elem elem)) (col, elem) some
	res = some a, of x
		f[x]
		false
	forbid res

| Calls {f} for each element in the input collection
| and returns an output collection of the results of {f}.
+for-loop[out-col, out-elem, in-col, in-elem] out-col
	a in-col
	f out-elem mut(elem in-elem)
do (out-col, out-elem) list-new, (in-col, in-elem) some, in-col size
	do trusted
	size = a.size
	res out-elem buffer = uninitialized-buffer size
	i mut nat32 = 0
	_ = some a, of x
		unsafe-set-at res, i, f[x]
		i +:= 1
		false
	# This can fail if the 'some' function iterates a different number of elements than 'size' promised.
	# In that case it is a bug in the collection.
	assert i == size
	list-new cast-immutable res

+fold[t, col, elem] t(value t, col col, f t mut(x t, elem elem)) (col, elem) some
	res mut = value
	_ = some col, of x
		res := f[res, x]
		false
	res

| Calls {f} for each element in the input collection,
| and returns an output collection of the elements for which {f} returned {true}.
+filter[out-col, elem, in-col] out-col
	a in-col
	f bool mut(elem elem)
do (out-col, elem) list-new, in-col size, (in-col, elem) some
	do trusted
	in-size = a.size
	res elem buffer = uninitialized-buffer in-size
	out-size mut nat32 = 0
	_ = some a, of x
		if f[x]
			unsafe-set-at res, out-size, x
			out-size +:= 1
		false
	list-new res.cast-immutable[0 .. out-size].to

| Opposite of {filter}
+omit[out-col, elem, in-col] out-col
	a in-col
	f bool mut(elem elem)
do (out-col, elem) list-new, in-col size, (in-col, elem) some
	filter a, {not f[it]}

| Returns a collection of all elements for which {f} returned false,
| and another collection for which {f} returned true.
+partition[out-col-false, out-col-true, elem, in-col] (out-col-false, out-col-true)
	a in-col
	f bool mut(elem elem)
do (out-col-false, elem) list-new, (out-col-true, elem) list-new, in-col size, (in-col, elem) some
	do trusted
	in-size = a.size
	falses elem buffer = uninitialized-buffer in-size
	count-falses mut nat32 = 0
	trues elem buffer = uninitialized-buffer in-size
	count-trues mut nat32 = 0
	_ = some a, of x
		if f[x]
			unsafe-set-at trues, count-trues, x
			count-trues +:= 1
		else
			unsafe-set-at falses, count-falses, x
			count-falses +:= 1
		false
	- list-new falses.cast-immutable[0 .. count-falses].to
	- list-new trues.cast-immutable[0 .. count-trues].to

| Same as {for-loop}.
| For good style, use this only with an `it` lambda.
| `each xs, it.log` is OK, but instead of `each xs, of x ...`, prefer `for x in xs ...`
+each[col, elem] void(a col, f void mut(elem elem)) (col, elem) some
	for-loop a, f

| Same as {for-loop}.
| For good style, use this only with an `it` lambda.
| `map xs, it.abs` is OK, but instead of `map xs, of x ...`, prefer `for x in xs ...`
+map[out-col, out-elem, in-col, in-elem] out-col
	a in-col
	f out-elem mut(elem in-elem)
do (out-col, out-elem) list-new, (in-col, in-elem) some, in-col size
	for-loop a, f

| Only returns a result if {f} returned a non-empty option every time.
+map-every[out-col, out-elem, in-col, in-elem] out-col?
	a in-col
	f out-elem? mut(x in-elem)
do (out-col, out-elem) list-new, in-col size, (in-col, in-elem) some
	ok mut bool = false
	out out-elem builder = a.size,
	ok := not some a, of x
		if y = f[x]
			out ~= y
			false
		else
			true
	if ok then finish out

+map-values[out-col, out-value, in-col, in-value, key] out-col
	col in-col
	f out-value mut(value in-value)
do (out-col, (key, out-value)) list-new, (in-col, (key, in-value)) some, in-col size
	map col, of k, v
		k, f[v]

+n-of[col, elem] col(n nat32, value elem) (col, elem) list-new
	do trusted
	res elem buffer = uninitialized-buffer n
	for i in 0 .. n
		unsafe-set-at res, i, value
	list-new cast-immutable res

+concatenate[col] spec
	~~ col(a col, b col)
+repeat[col] col(a col, n nat32) col concatenate, col new
	res mut col = ()
	for _ in 0 .. n
		res ~~:= a
	res

| Like `for-loop`, but {f} must return an array of outputs which are all added to the result.
+for-star[out-col, out-elem, in-col, in-elem] out-col
	a in-col
	f out-elem[] mut(elem in-elem)
do (out-col, out-elem) list-new, (in-col, in-elem) some
	out out-elem builder = ()
	_ = some a, of x
		out ~~= f[x]
		false
	finish out

+with-index[col] record(inner col)
+size[col] nat32(a col with-index) col size
	a.inner.size
+some[col, elem] bool(a col with-index, f bool mut(index nat32, elem elem)) (col, elem) some
	i mut nat32 = 0
	some a.inner, of x
		res = f[i, x]
		i +:= 1
		res

+split[out-col, in-col, in-iter, elem] out-col[]
	a in-col
	split-by in-col
do (in-col, in-iter, elem) basic-iter, in-iter skip-next-n, (out-col, in-iter) slice, elem equal
	out out-col builder = ()
	part-start mut = begin a
	iter = copy part-start
	do until
	before = copy iter
	if try-take-all iter, split-by
		out ~= slice part-start, before
		part-start := copy iter
		()
	elif try-take-next iter
		()
	else
		out ~= slice part-start, iter
		finish-array out

+count[col, elem] nat32(a col, f bool mut(x elem)) (col, elem) some
	sum a, f[it].to

+summable[t] spec t new
	+ t(a t, b t)
+sum[col, elem] elem(a col) elem summable, (col, elem) some
	sum a, {it}
+sum[out, col, elem] out(a col, f out mut(x elem)) out summable, (col, elem) some
	res mut out = ()
	_ = some a, of x
		res +:= f[x]
		false
	res

| Collection that iterates and returns 'value' forever
+infinite[t] record(value t)
+infinite void infinite()
	(),
+some[t] bool(a t infinite, f bool mut(x t))
	until then f[a.value]
	true

+reverse[col] record(inner col)
+size[col] nat32(a col reverse) col size
	a.inner.size
+some[col, elem] bool(a col reverse, f bool mut(x elem)) (col, elem) some-reverse
	some-reverse a.inner, f
+to[out-col, in-col, elem] out-col
	a in-col reverse
do (out-col, elem) list-new, in-col size, (in-col, elem) some-reverse
	out elem builder = a.inner.size,
	_ = some-reverse a.inner, of x
		out ~= x
		false
	finish out

+index-of-sequence[col, iter, elem] nat?
	a col
	seq col
do (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	index mut nat = 0
	iter = begin a
	do until
	if try-take-all iter, seq
		index
	elif try-take-next iter
		index +:= 1
		()
	else
		()::nat?

+swap-at[col, elem] void(a col, i nat32, j nat32) (col, elem) buffer-like
	temp = a[i]
	a[i] := a[j]
	a[j] := temp
+swap-at[col, elem] void
	a col
	i nat32
	j index-relative-to-end
do (col, elem) buffer-like
	swap-at a, i, to-index a, j
+swap-at[col, elem] void
	a col
	i index-relative-to-end
	j index-relative-to-end
do (col, elem) buffer-like
	swap-at a, (to-index a, i), (to-index a, j)

+set-reverse[col, elem] void(a col) (col, elem) buffer-like
	do if a.size > 1
	lo mut nat32 = 0
	hi mut = a.size - 1
	while lo < hi
		swap-at a, lo, hi
		lo +:= 1
		hi -:= 1

+fill[col, elem] void(a col, value elem) (col, elem) buffer-like
	for i in 0 .. a.size
		a[i] := value

+take-while[out, col, iter, elem] out
	a col
	f bool mut(x elem)
do (iter, col) begin, (elem, iter) take-next, iter copy, (out, iter) slice
	iter = begin a
	do until
	before = copy iter
	unless x = try-take-next iter and f[x]
		slice a.begin, before

+take-right-while[out, col, iter, elem] out
	a col
	f bool mut(x elem)
do (iter, col) end, (elem, iter) take-prev, iter copy, (out, iter) slice
	iter = end a
	do until
	before = copy iter
	unless x = try-take-prev iter and f[x]
		slice before, a.end

+drop-while[out, col, iter, elem] out
	a col
	f bool mut(x elem)
do (iter, col) begin, (iter, col) end, (elem, iter) take-next, iter copy, (out, iter) slice
	iter = begin a
	do until
	before = copy iter
	unless x = try-take-next iter and f[x]
		slice before, a.end

+drop-right-while[out, col, iter, elem] out
	a col
	f bool mut(x elem)
do (iter, col) begin, (iter, col) end, (elem, iter) take-prev, iter copy, (out , iter) slice
	iter = end a
	do until
	before = copy iter
	unless x = try-take-prev iter and f[x]
		slice a.begin, before

+starts-with[col, iter, elem] bool(a col, b col) (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	try-take-all a.begin, b

+ends-with[col, iter, elem] bool(a col, b col) (col, iter, elem) basic-reverse-iter, iter skip-prev-n, elem equal
	try-take-all-prev a.end, b

+try-remove-start[out, col, iter, elem] out?
	a col
	start col
do (col, iter, elem) basic-iter, (iter, col) end, iter skip-next-n, (out, iter) slice, elem equal
	iter = begin a
	if try-take-all iter, start
		slice iter, a.end
+try-remove-end[out, col, iter, elem] out?
	a col
	end col
do (col, iter, elem) basic-reverse-iter, (iter, col) begin, iter skip-prev-n, (out, iter) slice, elem equal
	iter = end a
	if try-take-all-prev iter, end
		slice a.begin, iter

| Removes all occurrences of {b} from the front of {a}.
+strip-left[col, iter, elem] col
	a col
	b col
do (col, iter, elem) basic-iter, (iter, col) end, iter skip-next-n, (col, iter) slice, elem equal
	if x = try-remove-start a, b
		strip-left x, b
	else
		a
| Removes all occurrences of {b} from the end of {a}.
+strip-right[col, iter, elem] col
	a col
	b col
do (col, iter, elem) basic-reverse-iter, (iter, col) begin, iter skip-prev-n, (col, iter) slice, elem equal
	if x = try-remove-end a, b
		strip-right x, b
	else
		a

| If the next elements in {a} all match {start}, skips them all and returns true.
| Otherwise, does nothing and returns false.
~try-take-all[col, iter, elem] bool
	a iter
	start col
do (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	copy = copy a
	iter-start = begin start
	do until
	if x = try-take-next iter-start
		unless value = try-take-next copy and value == x
			false
	else
		skip-next-n a, start.size
		true
~try-take-all-prev[col, iter, elem] bool
	a iter
	end col
do (col, iter, elem) basic-reverse-iter, iter skip-prev-n, elem equal
	copy = copy a
	iter-end = end end
	do until
	if x = try-take-prev iter-end
		unless value = try-take-prev copy and value == x
			false
	else
		skip-prev-n a, end.size
		true

| {true} if {b} is contained in {a}.
|
| That means: The elements in {b} appear in {a}, in order, without interruptions.
+contains-seq[col, iter, elem] bool(a col, b col) (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	iters-of-seq a, b

| Finds the first appearance of {b} in {a},
| and returns slices of {a} to the left and right of that.
|
| Returns an empty option if {b} is not a subsequence of {a}.
+try-split-once[out, col, iter, elem] (out, out)?
	a col
	b col
do (iter, col) end, (col, iter, elem) basic-iter, iter skip-next-n, (out, iter) slice, elem equal
	if l, r = iters-of-seq a, b
		- slice a.begin, l
		- slice r, a.end

+try-split-once-right[out, col, iter, elem] (out, out)?
	a col
	b col
do (iter, col) begin, (col, iter, elem) basic-reverse-iter, iter skip-prev-n, (out, iter) slice, elem equal
	if l, r = iters-of-seq-right a, b
		- slice a.begin, l
		- slice r, a.end

| Tries to find a subsequence {b} within {a}. If so, returns an iterator before and after {b}.
~iters-of-seq[col, iter, elem] (iter, iter)?
	a col
	b col
do (col, iter, elem) basic-iter, iter skip-next-n, elem equal
	iter = begin a
	do until
	before = copy iter
	if try-take-all iter, b
		before, iter
	elif try-take-next iter
		()
	else
		()::(iter, iter)?

-iters-of-seq-right[col, iter, elem] (iter, iter)?
	a col
	b col
do (col, iter, elem) basic-reverse-iter, iter skip-prev-n, elem equal
	iter = a.end
	do until
	before = copy iter
	if try-take-all-prev iter, b
		iter, before
	elif try-take-prev iter
		()
	else
		()::(iter, iter)?

| This is an opaque type for pushing values to using {~=} or {~~=}.
| This deliberately does not provide any way to access the values.
| You get a builder by using `with out in build` where `out` is the builder.
+builder[t] record mut
	-buffer mut t buffer
	-cur-size mut nat32
~new[t] t builder()
	0,
~new[t] t builder(size-hint nat32)
	trusted size-hint.uninitialized-buffer, 0
+ ~=[t] void(a t builder, value t)
	forbid a.cur-size == max-value
	capacity = a.buffer.size
	if a.cur-size == capacity
		expand-capacity a, if capacity == 0 then 4 else capacity * 2
	trusted unsafe-set-at a.buffer, a.cur-size, value
	a.cur-size +:= 1
+ ~~=[t] void(a t builder, values t array-view)
	forbid a.cur-size == max-value
	capacity = a.buffer.size
	new-size = a.cur-size + values.size
	if new-size > capacity
		expand-capacity a, round-up-to-power-of-two a.cur-size + values.size
	a.buffer[a.cur-size .. new-size] := values
	a.cur-size +:= values.size
-expand-capacity[t] void(a t builder, new-capacity nat32)
	do trusted
	assert new-capacity > a.buffer.size
	new-buffer t buffer = uninitialized-buffer new-capacity
	new-buffer[0 .. a.cur-size] := a.buffer[0 .. a.cur-size]
	a.buffer := new-buffer
-finish-array[elem] elem[](a elem builder)
	do trusted
	forbid a.cur-size == max-value
	size = a.cur-size
	a.cur-size := max-value
	buffer = a.buffer
	a.buffer := uninitialized-buffer 0
	if buffer.size == size
		cast-immutable buffer
	else
		buffer[0 .. size].to
~finish[col, elem] col(a elem builder) (col, elem) list-new
	list-new finish-array a
+build-options record
	size-hint nat32
+build build-options()
	0,
+build build-options(size-hint nat32)
	size-hint,
+with-block[col, elem] col
	a build-options
	f void mut(out elem builder)
do (col, elem) list-new
	out elem builder = a.size-hint,
	f[out]
	finish out

| Like {build}, but builds 2 things at once.
+build2 record
+with-block[col0, elem0, col1, elem1] (col0, col1)
	_ build2
	f void mut(out0 elem0 builder, out1 elem1 builder)
do (col0, elem0) list-new, (col1, elem1) list-new
	out0 elem0 builder = ()
	out1 elem1 builder = ()
	f[out0, out1]
	out0.finish, out1.finish

| If the collection has a single element, this is it.
| Otherwise this is an empty option.
+only[col, elem] elem?(a col) col size, (col, elem) some
	do if a.size == 1
	values elem[] = map a, {it}
	assert values.size == 1
	trusted unsafe-at values, 0
| If the collection has exactly 2 elements, returns them as a tuple.
| Otherwise this is an empty option.
+only2[col, elem] (elem, elem)?(a col) col size, (col, elem) some
	do if a.size == 2
	values elem[] = map a, {it}
	assert values.size == 2
	- trusted unsafe-at values, 0
	- trusted unsafe-at values, 1
| If the collection has exactly 3 elements, returns them as a tuple.
| Otherwise this is an empty option.
+only3[col, elem] (elem, elem, elem)?(a col) col size, (col, elem) some
	do if a.size == 3
	values elem[] = map a, {it}
	assert values.size == 3
	- trusted unsafe-at values, 0
	- trusted unsafe-at values, 1
	- trusted unsafe-at values, 2
| If the collection has exactly 4 elements, returns them as a tuple.
+only4[col, elem] (elem, elem, elem, elem)?(a col) col size, (col, elem) some
	do if a.size == 4
	values elem[] = map a, {it}
	assert values.size == 4
	- trusted unsafe-at values, 0
	- trusted unsafe-at values, 1
	- trusted unsafe-at values, 2
	- trusted unsafe-at values, 3
| If the collection has exactly 5 elements, returns them as a tuple.
+only5[col, elem] (elem, elem, elem, elem, elem)?(a col) col size, (col, elem) some
	do if a.size == 5
	values elem[] = map a, {it}
	assert values.size == 5
	- trusted unsafe-at values, 0
	- trusted unsafe-at values, 1
	- trusted unsafe-at values, 2
	- trusted unsafe-at values, 3
	- trusted unsafe-at values, 4
| If the collection has exactly 6 elements, returns them as a tuple.
+only6[col, elem] (elem, elem, elem, elem, elem, elem)?(a col) col size, (col, elem) some
	do if a.size == 6
	values elem[] = map a, {it}
	assert values.size == 6
	- trusted unsafe-at values, 0
	- trusted unsafe-at values, 1
	- trusted unsafe-at values, 2
	- trusted unsafe-at values, 3
	- trusted unsafe-at values, 4
	- trusted unsafe-at values, 5
| If the collection has exactly 7 elements, returns them as a tuple.
+only7[col, elem] (elem, elem, elem, elem, elem, elem, elem)?(a col) col size, (col, elem) some
	do if a.size == 7
	values elem[] = map a, {it}
	assert values.size == 7
	- trusted unsafe-at values, 0
	- trusted unsafe-at values, 1
	- trusted unsafe-at values, 2
	- trusted unsafe-at values, 3
	- trusted unsafe-at values, 4
	- trusted unsafe-at values, 5
	- trusted unsafe-at values, 6
| If the collection has exactly 8 elements, returns them as a tuple.
+only8[col, elem] (elem, elem, elem, elem, elem, elem, elem, elem)?(a col) col size, (col, elem) some
	do if a.size == 8
	values elem[] = map a, {it}
	assert values.size == 8
	- trusted unsafe-at values, 0
	- trusted unsafe-at values, 1
	- trusted unsafe-at values, 2
	- trusted unsafe-at values, 3
	- trusted unsafe-at values, 4
	- trusted unsafe-at values, 5
	- trusted unsafe-at values, 6
	- trusted unsafe-at values, 7

+zip[t, u] record(a t, b u)
+size[t, u] nat32(a (t, u) zip) t size, u size
	assert a.a.size == a.b.size
	a.a.size
+some[t, x, u, y] bool(a (t, u) zip, f bool mut(x x, y y)) (t, x) array-like, (u, y) array-like
	some (0::nat32 .. a.size), {f[a.a[it], a.b[it]]}
+some-reverse[t, x, u, y] bool(a (t, u) zip, f bool mut(x x, y y)) (t, x) array-like, (u, y) array-like
	some-reverse (0::nat32 .. a.size), {f[a.a[it], a.b[it]]}

| All pairs of different two elements of the array.
| The element with the lower index always comes first.
+all-pairs[t] record(inner t[])
+size[t] nat32(a t all-pairs)
	a.inner.size * (saturating-subtract a.inner.size, 1) / 2
+some[t] bool(a t all-pairs, f bool mut(x t, y t))
	some 0 .. a.inner.size, of i
		some i + 1 .. a.inner.size, of j
			f[(trusted unsafe-at a.inner, i), (trusted unsafe-at a.inner, j)]

| `(a[0], a[1])`, `(a[1], a[2])`, etc.
+adjacent-pairs[t] record(inner t[])
+size[t] nat32(a t adjacent-pairs)
	saturating-subtract a.inner.size, 1
+some[t] bool(a t adjacent-pairs, f bool mut(x t, y t))
	a.inner.size > 1 and some 0 .. a.inner.size - 1, of i
		f[(trusted unsafe-at a.inner, i), (trusted unsafe-at a.inner, i + 1)]
