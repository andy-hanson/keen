import
	./sorted-map

+sorted-set[t] record
	-inner (t, void) sorted-map

+is-empty[t] bool(a t sorted-set) t sorted-key
	is-empty a.inner

+size[t] nat(a t sorted-set) t sorted-key
	size a.inner

+ ==[t] bool(a t sorted-set, b t sorted-set) t sorted-key
	trusted a.inner == b.inner

+list-new[t] t sorted-set(a t[]) t sorted-key
	a.to

+to[t] t sorted-set(a t[]) t sorted-key
	inner: map a, {it, ()}

+to[t] t[](a t sorted-set) t sorted-key
	map a.inner.to::(t, void)[], it.a

+subscript[t] bool(a t sorted-set, value t) t sorted-key
	a.inner[value]

+ ~[t] t sorted-set(a t sorted-set, value t) t sorted-key
	inner: a.inner ~ (value, ())
+ -[t] t sorted-set(a t sorted-set, value t) t sorted-key
	inner: a.inner - value
+ |[t] t sorted-set(a t sorted-set, b t sorted-set) t sorted-key
	inner: a.inner ~~ b.inner
+ &[t] t sorted-set(a t sorted-set, b t sorted-set) t sorted-key
	inner: intersect a.inner, b.inner, {}
+ -[t] t sorted-set(a t sorted-set, b t sorted-set) t sorted-key
	filter a, b[it].not

+some[t] bool(a t sorted-set, f bool mut(value t)) t sorted-key
	some a.inner, f[it.a]

+min[t] t?(a t sorted-set) t sorted-key
	min-key a.inner
+max[t] t?(a t sorted-set) t sorted-key
	max-key a.inner

+to[t] json(a t sorted-set) (json, t) to, t sorted-key
	map a, it.to

test
	a nat sorted-set = 3, 1, 2
	b nat sorted-set = 2, 4, 3
	a | b is (1, 2, 3, 4)
	a & b is (2, 3)
	a - b is (1,)
