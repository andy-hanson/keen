+counter[k] record
	-inner nat[k]

+ ==[k] bool(a k counter, b k counter) k key
	trusted a.inner == b.inner
+ <=>[k] comparison(a k counter, b k counter) k key
	trusted a.inner <=> b.inner
+hash[k] void(a k counter, state hash-state) k key
	trusted hash a.inner, state
+to[k] json(a k counter) k key, k to-json
	a.inner.to
+to[k] k counter(a json) k key, k from-json
	inner: a.to

+list-new[k] k counter(a k[]) k key
	a.to
+from-pairs[k] k counter(a (k, nat)[]) k key
	inner: a.to

+to[k] k counter(values k[]) k key
	res nat mut[k] = ()
	for x in values
		res[x] := (res[x] else 0) + 1
	inner: res.move-to

+to[k] nat[k](a k counter) k key
	a.inner

+to[k] (k, nat)[](a k counter) k key
	a.inner.to

+subscript[k] nat(a k counter, value k) k key
	a.inner[value] else 0

+ ~[k] k counter(a k counter, value k) k key
	a.inner ~ (value, a[value] + 1),

+some[k] bool(a k counter, f bool mut(key k, count nat)) k key
	some a.inner, f
