import
	./private/sort-utils

| Mutable priority queue.
|
| Elements are key-value pairs. Pairs are sorted by key.
| Popping removes the first pair (with the lowest key).
|
| If two pairs have the same key, the second pair added will be popped second.
+mut-priority-queue[k, v] record mut
	| The smallest value goes on the right
	-mins (k, v) mut[]
	| This may be shorter than mins -- buckets on the right considered missing.
	-buckets (k, v) mut[] mut[]

+list-new[k, v] (k, v) mut-priority-queue(a (k, v)[]) k sorted-key
	a.to

| Copies an array to a new priority queue.
+to[k, v] (k, v) mut-priority-queue(a (k, v)[]) k sorted-key
	mins (k, v) mut[] = a.to
	mins sort= it.a.compare-reverse
	mins, ()

| Removes all pairs from the queue.
+clear[k, v] void(a (k, v) mut-priority-queue) k sorted-key
	clear a.mins
	clear a.buckets

| {true} if `{a}.{size} == 0`.
+is-empty[k, v] bool(a (k, v) mut-priority-queue) k sorted-key
	is-empty a.mins

| Number of pairs in the queue.
| This is O({a} {size}).
+size[k, v] nat64(a (k, v) mut-priority-queue) k sorted-key
	res mut = a.mins.size
	for b in a.buckets
		res +:= b.size
	res

| Adds a pair to the queue.
| This is O({a}.{size} log).
+ ~=[k, v] void(a (k, v) mut-priority-queue, (key k, value v)) k sorted-key
	# Highest min is on the right, so comparing in reverse
	insert = binary-search-insert-cb a.mins, it.a <=> key
	if insert == a.mins.size
		a.mins ~= key, value
	else
		add-to-bucket a.buckets, insert, (key, value)

| Returns the first pair (with the lowest key) without modifying {a}.
| This is O(1).
+peek[k, v] (k, v)?(a (k, v) mut-priority-queue)
	peek a.mins

| Removes and returns the first pair (with the lowest key).
| Returns an empty option if the queue was empty.
| This is amortized O({a}.{size} log).
+pop[k, v] (k, v)?(a (k, v) mut-priority-queue) k sorted-key
	res = pop a.mins
	if a.mins.size < a.buckets.size
		assert a.mins.size + 1 == a.buckets.size
		bucket = pop! a.buckets
		# Mins are popped off from the right.
		# This preserves insertion order: 'sort' doesn't change that,
		# then we reverse, then popping from the right reverses it again.
		# Note: Handling equal keys is why we can't just use a reversed comparer
		bucket sort= it.a
		set-reverse bucket
		a.mins ~~= bucket
	res

| Copy pairs to a new priority queue.
| This is O(n).
+copy[k, v] (k, v) mut-priority-queue(a (k, v) mut-priority-queue) k sorted-key
	spread-all-buckets a
	a.mins.copy, ()

| Copy pairs to an array.
| This is O(n).
+to[k, v] (k, v)[](a (k, v) mut-priority-queue) k sorted-key
	spread-all-buckets a
	a.mins.reverse.to

-spread-all-buckets[k, v] void(a (k, v) mut-priority-queue) k sorted-key
	old-mins (k, v)[] = a.mins.move-to
	for index, old-min in with-index old-mins
		if index < a.buckets.size
			bucket = a.buckets[index]
			bucket sort= it.a
			for x in reverse bucket
				a.mins ~= x
		a.mins ~= old-min
	clear a.buckets

-add-to-bucket[k, v] void(buckets (k, v) mut[] mut[], index nat64, pair (k, v))
	until index < buckets.size
		buckets ~= ()
	buckets[index] ~= pair

-dbg[k, v] string(a (k, v) mut-priority-queue) k show, v show
	# TODO: should be able to infer type arguments
	join ", ", for i, min in with-index a.mins
		show-bucket = if i < a.buckets.size
			bucket = a.buckets[i]
			unless is-empty bucket
				parts = join ", ", map bucket, it.dbg
				" [{parts}]"
		"{dbg min}{show-bucket}"

-dbg[k, v] string((k k, v v)) k show, v show
	"{k} -> {v}"

-verify void(a (nat64, string) mut-priority-queue, expected string)
	a.dbg is expected

test
	a (nat64, string) mut-priority-queue = ()
	is-empty a is true
	pop a is ()
	verify a, ""

	a ~= 5, "5"
	is-empty a is false
	verify a, "5 -> 5"

	a ~= 6, "6"
	verify a, "5 -> 5 [6 -> 6]"

	a ~= 2, "2"
	verify a, "5 -> 5 [6 -> 6], 2 -> 2"

	a ~= 3, "3a"
	verify a, "5 -> 5 [6 -> 6], 2 -> 2 [3 -> 3a]"

	a ~= 4, "4"
	a ~= 3, "3b"
	verify a, "5 -> 5 [6 -> 6], 2 -> 2 [3 -> 3a, 4 -> 4, 3 -> 3b]"

	pop a is (2, "2")
	verify a, "5 -> 5 [6 -> 6], 4 -> 4, 3 -> 3b, 3 -> 3a"

	a ~= 4, "4b"
	verify a, "5 -> 5 [6 -> 6], 4 -> 4 [4 -> 4b], 3 -> 3b, 3 -> 3a"

	pop a is (3, "3a")
	pop a is (3, "3b")
	verify a, "5 -> 5 [6 -> 6], 4 -> 4 [4 -> 4b]"
	pop a is (4, "4")
	verify a, "5 -> 5 [6 -> 6], 4 -> 4b"

	a.to::(nat64, string)[] is ((4, "4b"), (5, "5"), (6, "6"))
	verify a, "6 -> 6, 5 -> 5, 4 -> 4b"

test
	a (nat64, string) mut-priority-queue = ()
	a ~= 5, "5"
	a ~= 5, "five"
	pop a is (5, "5")
	pop a is (5, "five")
	a.is-empty is true
