import
	keen/unsafe
	../js

+new js-any() js
	null
| Create a new JS object.
+named-new js-any(keys symbol[], values js-any[]) unsafe, js
	keys.size is values.size
	res js-any = call-new Object
	for i in 0 .. keys.size
		res[keys[i].to] := values[i]
	res

+to js-any(a json) js
	match x = simplify a
	as null
		null
	as bool
		x.to
	as float64
		x.to
	as string
		x.to
	as array
		do trusted
		res js-any = call-new Array
		for y in x
			_ = call-property res, "push", y.to
		res
	as json-object
		do trusted
		res js-any = call-new Object
		for key, value in x
			res[key.to] := value.to
		res

| `console.log(a)` . Useful for debugging JS values such as nodes that the console handles specially.
+console-log void(a js-any) js
	_ = trusted call-property js-global["console"], "log", a

###
Creates a new JS class.
This currently does not support fields, getters/setters, or calling 'super' with arguments.
###
+make-class js-any
	super-class js-any
	constructor method
	methods method[symbol]
do unsafe, js
	src js-any = quote
		(ctor, Super) => class extends Super \{
			constructor(...args) \{
				super()
				ctor(\{ a: this, b: args \})
			\}
		\}
	res = call src.eval, constructor.reinterpret-cast, super-class
	for name, method in methods
		res["prototype"][name.to] := make-method method
	res

+method alias
	js-any mut(this js-any, args js-any[])

-make-method js-any(fn method) unsafe, js
	call "fn => function(...args) \{ return fn(\{ a: this, b: args \}) \}".eval, reinterpret-cast fn

+debugger void() js
	do trusted
	_ = eval "debugger"
