import
	keen/js
	keen/unsafe

| Type that is useful for detailing with JS asynchronous events.
| Create a {deferred} and set it up so that it will {resolve} once.
| Then {await} the deferred which blocks until {resolve} is called.
+deferred[t] record js, mut
	-promise js-any
	-resolve js-any

+new[t] t deferred() js
	do trusted
	resolve mut js-any = null
	f = of resolve_ js-any
		resolve := resolve_
	promise = call-new js-global["Promise"], f.to
	promise: reinterpret-cast promise
	resolve: resolve

| This will hang forever if 'resolve' is never called.
+await[t] t(a t deferred) unsafe, js
	reinterpret-cast await a.promise

| Provides a value to whatever is {await}ing this {deferred}.
| It's safe to call this before the {await}.
+resolve[t] void(a t deferred, value t) unsafe, js
	_ = call a.resolve, reinterpret-cast value
