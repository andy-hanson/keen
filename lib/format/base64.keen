import
	keen/bits

+base64-encode string(a string)
	base64-encode a.to::nat8[]

+base64-encode string(a nat8[])
	chars char8[] = with out in build
		cur mut nat32 = 0
		cur-bits mut nat32 = 0
		for x in a
			cur <<:= 8
			cur-bits +:= 8
			cur |:= x.to
			while cur-bits >= 6
				cur-bits -:= 6
				value = (cur >> cur-bits) & 0b111111
				out ~= base64-digits[value]
		if cur-bits != 0
			cur <<:= 6 - cur-bits
			out ~= base64-digits[cur & 0b111111]
	chars.to

+base64-encode-single char8(a nat8)
	assert a < 64 else index-too-big a, 64
	base64-digits[a]

+base64-decode nat8[](a string)
	do unless is-empty a
	# Walk the string and emit 6 bits at a time.
	cur mut nat32 = 0
	cur-bits mut nat32 = 0
	do with out in build
	chars mut string-view = a.to
	while not is-empty chars and chars[end - 1] == "="
		chars := chars[0 .. end - 1]
	for char in chars
		value = base64-decode-single char
		cur <<:= 6
		cur-bits +:= 6
		cur |:= value.to
		if cur-bits >= 8
			cur-bits -:= 8
			out ~= (cur >> cur-bits).wrap-to
	cur & cur-bits.low-n-bits is 0 else not-base64

+base64-decode-single nat8(char char8)
	if "A"::char8 <= char and char <= "Z"
		char - "A"
	elif "a"::char8 <= char and char <= "z"
		char - "a" + 26
	elif "0"::char8 <= char and char <= "9"
		char - "0" + 52
	elif char == "+"
		62
	elif char == "/"
		63
	else
		throw not-base64

- - nat8(a char8, b char8)
	a.to::nat8 - b.to::nat8

+not-base64 record exception case
+show string(_ not-base64)
	"The string is not a valid base64 string."

-base64-digits char8[]()
	"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
