import
	keen/bits

+base64-encode string(a string)
	base64-encode a.to::nat8[]

+base64-encode string(a nat8[])
	chars char8[] = with out in build
		cur mut nat32 = 0
		cur-bits mut nat32 = 0
		for x in a
			cur <<:= 8
			cur-bits +:= 8
			cur |:= x.to
			while cur-bits >= 6
				cur-bits -:= 6
				value = (cur >> cur-bits) & 0b111111
				out ~= base64-digits[value]
		if cur-bits != 0
			cur <<:= 6 - cur-bits
			out ~= base64-digits[cur & 0b111111]
	chars.to

+base64-decode nat8[](a string)
	do unless is-empty a
	lookup nat8[char8] = for value, char in with-index base64-digits
		char, value.to
	# Walk the string and emit 6 bits at a time.
	cur mut nat32 = 0
	cur-bits mut nat32 = 0
	do with out in build
	chars mut string-view = a.to
	while not is-empty chars and chars[end - 1] == "="
		chars := chars[0 .. end - 1]
	for char in chars
		value = lookup[char] else throw not-base64
		cur <<:= 6
		cur-bits +:= 6
		cur |:= value.to
		if cur-bits >= 8
			cur-bits -:= 8
			out ~= (cur >> cur-bits).wrap-to
	assert (cur & cur-bits.low-n-bits) == 0 else not-base64

test
	tests (string, string)[] =
		- "", ""
		- "a", "YQ"
		- "ab", "YWI"
		- "abc", "YWJj"
	for value, base64 in tests
		value.base64-encode is base64
		base64.base64-decode.as-string is value
test
	binary-tests (nat8[], string)[] =
		- (), ""
		- (0, 0xff), "AP8"
	for value, base64 in binary-tests
		value.base64-encode is base64
		base64.base64-decode is value
test
	try
		_ = base64-decode "foo foo"
		should-throw
	catch as not-base64
		()

+not-base64 record exception case
+show string(_ not-base64)
	"The string is not a valid base64 string."

-base64-digits char8[]()
	"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
