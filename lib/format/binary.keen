| Utilities for reading binary files
import
	keen/bits

| Takes 2 big-endian bytes
+take16 nat16(a nat8 array-iterator)
	res mut nat16 = 0
	for _ in 0 .. 2
		res <<:= 8
		res |:= take-next a
	res

| Takes 4 big-endian bytes
+take32 nat32(a nat8 array-iterator)
	res mut nat32 = 0
	for _ in 0 .. 4
		res <<:= 8
		res |:= take-next a
	res

| Takes 8 big-endian bytes
+take64 nat64(a nat8 array-iterator)
	res mut nat64 = 0
	for _ in 0 .. 8
		res <<:= 8
		res |:= take-next a
	res

+big-endian nat8[](a nat16)
	- wrap-to a >> 8
	- wrap-to a
+big-endian nat8[](a nat32)
	for i in 0::nat32 .. 4
		wrap-to a >> (24 - i * 8)
+big-endian nat8[](a nat64)
	for i in 0 .. 8
		wrap-to a >> (56 - i * 8)

+write-big-endian void(buffer nat8 buffer-view, a nat16)
	buffer.size is 2
	buffer[0] := wrap-to (a >> 8)
	buffer[1] := wrap-to a
+write-big-endian void(buffer nat8 buffer-view, a nat32)
	buffer.size is 4
	for i in 0::nat32 .. 4
		buffer[i] := wrap-to a >> (24 - i * 8)
+write-big-endian void(buffer nat8 buffer-view, a nat64)
	buffer.size is 8
	for i in 0 .. 8
		buffer[i] := wrap-to a >> (56 - i * 8)

+from-big-endian nat16(a nat8 array-view)
	a.size is 2
	take16 begin a
+from-big-endian nat32(a nat8 array-view)
	a.size is 4
	take32 begin a
+from-big-endian nat64(a nat8 array-view)
	a.size is 8
	take64 begin a

| Takes a UTF8 string with a fixed size.
| The string will be cut at the first "\0", but this still takes all {n-bytes} unconditionally.
+take-string string(a nat8 array-iterator, n-bytes nat32)
	bytes = take-next-n a, n-bytes
	as-string if index = index-of bytes, 0 then bytes[0 .. index] else bytes
