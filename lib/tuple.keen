no-std
import
	./private/bootstrap: bool, compare, comparison, equal, hash, hash-state, void
export
	./private/bootstrap: a, b, c, d, e, f, g, h, new, tuple2, tuple3, tuple4, tuple5, tuple6, tuple7, tuple8

+ ==[t0, t1] bool(a (t0, t1), b (t0, t1)) t0 equal, t1 equal
	trusted a.a == b.a and a.b == b.b
+ ==[t0, t1, t2] bool(a (t0, t1, t2), b (t0, t1, t2)) t0 equal, t1 equal, t2 equal
	trusted a.a == b.a and a.b == b.b and a.c == b.c
+ ==[t0, t1, t2, t3] bool(a (t0, t1, t2, t3), b (t0, t1, t2, t3)) t0 equal, t1 equal, t2 equal, t3 equal
	trusted a.a == b.a and a.b == b.b and a.c == b.c and a.d == b.d
+ ==[t0, t1, t2, t3, t4] bool
	a (t0, t1, t2, t3, t4)
	b (t0, t1, t2, t3, t4)
do t0 equal, t1 equal, t2 equal, t3 equal, t4 equal
	trusted a.a == b.a and a.b == b.b and a.c == b.c and a.d == b.d and a.e == b.e
+ ==[t0, t1, t2, t3, t4, t5] bool
	a (t0, t1, t2, t3, t4, t5)
	b (t0, t1, t2, t3, t4, t5)
do t0 equal, t1 equal, t2 equal, t3 equal, t4 equal, t5 equal
	trusted a.a == b.a and a.b == b.b and a.c == b.c and a.d == b.d and a.e == b.e and a.f == b.f
+ ==[t0, t1, t2, t3, t4, t5, t6] bool
	a (t0, t1, t2, t3, t4, t5, t6)
	b (t0, t1, t2, t3, t4, t5, t6)
do t0 equal, t1 equal, t2 equal, t3 equal, t4 equal, t5 equal, t6 equal
	trusted a.a == b.a and a.b == b.b and a.c == b.c and a.d == b.d and a.e == b.e and a.f == b.f and a.e == b.e
+ ==[t0, t1, t2, t3, t4, t5, t6, t7] bool
	a (t0, t1, t2, t3, t4, t5, t6, t7)
	b (t0, t1, t2, t3, t4, t5, t6, t7)
do t0 equal, t1 equal, t2 equal, t3 equal, t4 equal, t5 equal, t6 equal, t7 equal
	trusted a.a == b.a and a.b == b.b and a.c == b.c and a.d == b.d and a.e == b.e and a.f == b.f and a.e == b.e and
		a.f == b.f

+ <=>[t0, t1] comparison(a (t0, t1), b (t0, t1)) t0 compare, t1 compare
	trusted match res = a.a <=> b.a
	as equal
		a.b <=> b.b
	else
		res
+ <=>[t0, t1, t2] comparison(a (t0, t1, t2), b (t0, t1, t2)) t0 compare, t1 compare, t2 compare
	trusted match res = a.a <=> b.a
	as equal
		(a.b, a.c) <=> (b.b, b.c)
	else
		res
+ <=>[t0, t1, t2, t3] comparison(a (t0, t1, t2, t3), b (t0, t1, t2, t3)) t0 compare, t1 compare, t2 compare, t3 compare
	trusted match res = a.a <=> b.a
	as equal
		(a.b, a.c, a.d) <=> (b.b, b.c, b.d)
	else
		res
+ <=>[t0, t1, t2, t3, t4] comparison
	a (t0, t1, t2, t3, t4)
	b (t0, t1, t2, t3, t4)
do t0 compare, t1 compare, t2 compare, t3 compare, t4 compare
	trusted match res = a.a <=> b.a
	as equal
		(a.b, a.c, a.d, a.e) <=> (b.b, b.c, b.d, a.e)
	else
		res
+ <=>[t0, t1, t2, t3, t4, t5] comparison
	a (t0, t1, t2, t3, t4, t5)
	b (t0, t1, t2, t3, t4, t5)
do t0 compare, t1 compare, t2 compare, t3 compare, t4 compare, t5 compare
	trusted match res = a.a <=> b.a
	as equal
		(a.b, a.c, a.d, a.e, a.f) <=> (b.b, b.c, b.d, a.e, a.f)
	else
		res
+ <=>[t0, t1, t2, t3, t4, t5, t6] comparison
	a (t0, t1, t2, t3, t4, t5, t6)
	b (t0, t1, t2, t3, t4, t5, t6)
do t0 compare, t1 compare, t2 compare, t3 compare, t4 compare, t5 compare, t6 compare
	trusted match res = a.a <=> b.a
	as equal
		(a.b, a.c, a.d, a.e, a.f, a.g) <=> (b.b, b.c, b.d, a.e, a.f, a.g)
	else
		res
+ <=>[t0, t1, t2, t3, t4, t5, t6, t7] comparison
	a (t0, t1, t2, t3, t4, t5, t6, t7)
	b (t0, t1, t2, t3, t4, t5, t6, t7)
do t0 compare, t1 compare, t2 compare, t3 compare, t4 compare, t5 compare, t6 compare, t7 compare
	trusted match res = a.a <=> b.a
	as equal
		(a.b, a.c, a.d, a.e, a.f, a.g, a.h) <=> (b.b, b.c, b.d, a.e, a.f, a.g, a.h)
	else
		res

+hash[t0, t1] void(a (t0, t1), state hash-state) t0 hash, t1 hash
	do trusted
	hash a.a, state
	hash a.b, state
+hash[t0, t1, t2] void(a (t0, t1, t2), state hash-state) t0 hash, t1 hash, t2 hash
	do trusted
	hash a.a, state
	hash a.b, state
	hash a.c, state
+hash[t0, t1, t2, t3] void(a (t0, t1, t2, t3), state hash-state) t0 hash, t1 hash, t2 hash, t3 hash
	do trusted
	hash a.a, state
	hash a.b, state
	hash a.c, state
	hash a.d, state
+hash[t0, t1, t2, t3, t4] void(a (t0, t1, t2, t3, t4), state hash-state) t0 hash, t1 hash, t2 hash, t3 hash, t4 hash
	do trusted
	hash a.a, state
	hash a.b, state
	hash a.c, state
	hash a.d, state
	hash a.e, state
+hash[t0, t1, t2, t3, t4, t5] void
	a (t0, t1, t2, t3, t4, t5)
	state hash-state
do t0 hash, t1 hash, t2 hash, t3 hash, t4 hash, t5 hash
	do trusted
	hash a.a, state
	hash a.b, state
	hash a.c, state
	hash a.d, state
	hash a.e, state
	hash a.f, state
+hash[t0, t1, t2, t3, t4, t5, t6] void
	a (t0, t1, t2, t3, t4, t5, t6)
	state hash-state
do t0 hash, t1 hash, t2 hash, t3 hash, t4 hash, t5 hash, t6 hash
	do trusted
	hash a.a, state
	hash a.b, state
	hash a.c, state
	hash a.d, state
	hash a.e, state
	hash a.f, state
	hash a.g, state
+hash[t0, t1, t2, t3, t4, t5, t6, t7] void
	a (t0, t1, t2, t3, t4, t5, t6, t7)
	state hash-state
do t0 hash, t1 hash, t2 hash, t3 hash, t4 hash, t5 hash, t6 hash, t7 hash
	do trusted
	hash a.a, state
	hash a.b, state
	hash a.c, state
	hash a.d, state
	hash a.e, state
	hash a.f, state
	hash a.g, state
	hash a.h, state
