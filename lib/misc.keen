no-std
import
	./bool: bool, true
	./private/bootstrap: array, reference-value, set-reference-value
	./compare: comparison, equal
export
	./private/bootstrap: lambda-data, lambda-mut, lambda-shared, global, java, js, reference, unsafe, void, to

+new void()
+ == bool(_ void, _ void) = trusted true
+ <=> comparison(_ void, _ void) = trusted equal

| If this spec is implemented for a type, that type has an implicit empty value.
+new[t] spec
	new t()
| If this spec is implemented for a type, that type is considered a collection.
| Collections can be constructed using list syntax (`- x` and `-- xs`).
+list-new[col, elem] spec
	list-new col(elems elem[])
| Converts between two types.
+to[output, input] spec
	to output(a input)
| Shallowly copies a mutable type.
+copy[t] spec
	copy t(a t)

| Requires the type to be immutable, meaning not `mut` or `shared`.
+data[t] spec builtin

| The type must be immutable or marked `shared`. In other words, the type can not be `mut`.
+shared[t] spec builtin

| Calls the function and returns its return value.
+subscript[r, p] r(a r data(x p), params p)
+subscript[r, p] r(a r shared(x p), params p)
+subscript[r, p] r(a r mut(x p), params p)

+new[t] t reference(value t) = reference value
+get[t] t(a t reference) = a.reference-value
+set=[t] void(a t reference, value t)
	a.reference-value := value

| True if this is a Java build. (This is the default.)
| In contexts where this is true (such as inside `if java`), you can call `java` functions.
+java bool() global
| True if this is a JavaScript build.
| In contexts where this is true (such as inside `if js`), you can call `js` functions.
+js bool() global
