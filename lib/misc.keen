no-std
import
	./bool: bool, true
	./private/bootstrap: array, reference-value, set-reference-value
	./compare: comparison, equal
export
	./private/bootstrap: lambda-data, lambda-mut, lambda-shared, global, java, js, reference, unsafe, void, to

+new void()
+ == bool(_ void, _ void)
	trusted true
+ <=> comparison(_ void, _ void)
	trusted equal

+new[t] spec
	new t()
+list-new[col, elem] spec
	list-new col(elems elem[])

+copy[t] spec
	copy t(a t)

| Specifies that a type must be immutable data.
|
| This includes most types that are not `mut`.
|
| To put it another way, a type works with `data` if it is:
| * A primitive like `nat`, an `enum`, or `flags`.
| * A record with no `mut` fields, whose fields are all `data`.
| * A union whose member types are all `data`.
| * Immutable collections like `x[]`, where the type arguments are all `data`.
| * A constant pointer like `nat*`.
+data[t] spec builtin

| Specifies that a type must be safe to share between tasks that may run in parallel.
| Anything that satisfies `data` satisfies `shared`.
+shared[t] spec builtin

| Calls the function and returns its return value.
+subscript[r, p] r(a r data(x p), params p)
+subscript[r, p] r(a r shared(x p), params p)
+subscript[r, p] r(a r mut(x p), params p)

+new[t] t reference(value t)
	reference value
+get[t] t(a t reference)
	a.reference-value
+set=[t] void(a t reference, value t)
	a.reference-value := value

| True if this is a Java build. (This is the default.)
| In contexts where this is 'true' (such as inside 'if java'), you can call 'java' functions.
+java bool() global
| True if this is a JavaScript build.
| In contexts where this is 'true' (such as inside 'if js'), you can call 'js' functions.
+js bool() global
