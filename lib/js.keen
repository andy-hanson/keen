| Contains functions for JavaScript primitive operations.
no-std
import
	./bool
	./private/bootstrap: array, chars, float32, float64, int8, int16, int32, int64, nat8, nat16, nat32, nat64
	./private/bootstrap: new, string
	./misc
	./unsafe
export
	./private/bootstrap: js-any

| 'self' in the browser or 'global' in node.js
+js-global js-any() js, global, unsafe
| Gets a property from a JS object.
| For a  function call use {call} or {call-property}.
+subscript js-any(a js-any, key js-any) js, unsafe
| Sets a property on a JS object.
+set-subscript void(a js-any, key js-any, value js-any) js, unsafe
| `{a}()`
| WARN: This does not {await} the result.
| WARN: {subscript} followed by {call} may not work. Use {call-property} instead.
+call js-any(a js-any) js, unsafe
| `{a}({arg})`
+call js-any(a js-any, arg js-any) js, unsafe
| `{a}({arg0}, {arg1})`
+call js-any(a js-any, arg0 js-any, arg1 js-any) js, unsafe
| `{a}({arg0}, {arg1}, {arg2})`
+call js-any(a js-any, arg0 js-any, arg1 js-any, arg2 js-any) js, unsafe
| `new {a}()`
+call-new js-any(a js-any) js, unsafe
| `new {a}({arg})`
+call-new js-any(a js-any, arg js-any) js, unsafe
| `new {a}({arg0}, {arg1})`
+call-new js-any(a js-any, arg0 js-any, arg1 js-any) js, unsafe
| `new {a}({arg0}, {arg1}, {arg2})`
+call-new js-any(a js-any, arg0 js-any, arg1 js-any, arg2 js-any) js, unsafe
| `{a}[{name}]()`
+call-property js-any(a js-any, name js-any) js, unsafe
| `{a}[{name}]({arg})`
+call-property js-any(a js-any, name js-any, arg js-any) js, unsafe
| `{a}[{name}]({arg0}, {arg1})`
+call-property js-any
	a js-any
	name js-any
	arg0 js-any
	arg1 js-any
do js, unsafe
| `{a}[{name}]({arg0}, {arg1}, {arg2})`
+call-property js-any
	a js-any
	name js-any
	arg0 js-any
	arg1 js-any
	arg2 js-any
do js, unsafe
| `{a}[{name}]({arg0}, {arg1}, {arg2}, {arg3})`
+call-property js-any
	a js-any
	name js-any
	arg0 js-any
	arg1 js-any
	arg2 js-any
	arg3 js-any
do js, unsafe
| `{a}[{name}](...{args})`
+call-property-spread js-any(a js-any, name js-any, args js-any[]) js, unsafe

+null js-any() js
+undefined js-any() js

region Unary operators
+await js-any(a js-any) js, unsafe
+typeof js-any(a js-any) js, unsafe

region Binary operators
| This is actually JavaScript's `===` operator.
+ == bool(a js-any, b js-any) js, unsafe
+instanceof bool(a js-any, b js-any) js, unsafe
+ + js-any(a js-any, b js-any) js, unsafe

region Utiliies

| Calls JavaScript's 'eval' function. 'source' should be JavaScript source code.
| This could be useful for making use of JS features that don't have a Keen analog,
| or if you just have a big chunk of JS code and don't have time to translate it to Keen.
|
| This happens in its own scope, so don't count on anything being in the enclosing scope.
| Instead, {eval} a function literal, then {call} it, like `"x => f(x)".eval call x`.
| If appropriate, remember to make the function `async` and {await} the result.
+eval js-any(source js-any) js, unsafe

+js-import js-any(name js-any) js, global, unsafe

region Conversion

+to void(a js-any) js
	assert trusted a == undefined
	()
+to js-any(a void) js
	trusted reinterpret-cast a
+to bool(a js-any) js
	do trusted
	assert a.typeof == "boolean"
	reinterpret-cast a
+to js-any(a bool) js
	trusted reinterpret-cast a
+false js-any() js
	false::bool.to
+true js-any() js
	true::bool.to

+to js-any(a void mut()) js
	trusted reinterpret-cast a
+to js-any(a void mut(arg js-any)) js
	trusted reinterpret-cast a
+to js-any(a js-any mut()) js
	trusted reinterpret-cast a
+to js-any(a js-any mut(arg js-any)) js
	trusted reinterpret-cast a
+to js-any(a void mut(arg0 js-any, arg1 js-any)) js
	trusted call "f => (a, b) => f(\{ a, b \})".eval, reinterpret-cast a
+to js-any(a js-any mut(arg0 js-any, arg1 js-any)) js
	trusted call "f => (a, b) => f(\{ a, b \})".eval, reinterpret-cast a

+to js-any(a float32) js
	trusted reinterpret-cast a
+to float32(a js-any) js
	do trusted
	assert a.typeof == "number"
	reinterpret-cast call-property js-global["Math"], "fround", a
+to js-any(a float64) js
	trusted reinterpret-cast a
+to float64(a js-any) js
	do trusted
	assert a.typeof == "number"
	reinterpret-cast a

+to js-any(a int32) js
	trusted reinterpret-cast a
+to int32(a js-any) js
	do trusted
	assert call "x => x === (x | 0)".eval, a 'to
	reinterpret-cast a
+to js-any(a int64) js
	trusted reinterpret-cast a
+to int64(a js-any) js
	do trusted
	if a.typeof == "bigint"
		assert a == (call-property Number, "asIntN", 64, a)
		reinterpret-cast a
	else
		assert a.typeof == "number"
		assert call-property Number, "isInteger", a 'to
		call BigInt, a 'to
+to js-any(a nat32) js
	trusted a.reinterpret-cast
+to nat32(a js-any) js
	do trusted
	assert call "x => x === (x >>> 0)".eval, a 'to
	reinterpret-cast a
+to js-any(a nat64) js
	trusted reinterpret-cast a
+to nat64(a js-any) js
	do trusted
	if a.typeof == "bigint"
		assert a == (call-property BigInt, "asUintN", 64, a)
		reinterpret-cast a
	else
		assert a.typeof == "number"
		assert call-property Number, "isInteger", a 'to
		call BigInt, a 'to

+to string(a js-any) js
	do trusted
	assert a.typeof == "string"
	chars = call-property js-global["TextEncoder"].call-new, "encode", a
	- reinterpret-cast chars
+to js-any(a string) js
	trusted call-property js-global["TextDecoder"].call-new, "decode", a.chars.reinterpret-cast

~Array js-any() js
	trusted js-global["Array"]
~BigInt js-any() js
	trusted js-global["BigInt"]
~Number js-any() js
	trusted js-global["Number"]
~Object js-any() js
	trusted js-global["Object"]
~String js-any() js
	trusted js-global["String"]

| {reinterpret-cast} as an `Int8Array`. Unsafe because that is mutable.
+to js-any(a int8[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as an `Int16Array`. Unsafe because that is mutable.
+to js-any(a int16[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as an `Int32Array`. Unsafe because that is mutable.
+to js-any(a int32[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as an `Int64Array`. Unsafe because that is mutable.
+to js-any(a int64[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as a `Uint8Array`. Unsafe because that is mutable.
+to js-any(a nat8[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as a `Uint16Array`. Unsafe because that is mutable.
+to js-any(a nat16[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as a `Uint32Array`. Unsafe because that is mutable.
+to js-any(a nat32[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} as a `Uint64Array`. Unsafe because that is mutable.
+to js-any(a nat64[]) unsafe, js
	reinterpret-cast a

| Requires an `Int8Array`
+to int8[](a js-any) unsafe, js
	assert a 'instanceof trusted js-global["Int8Array"]
	reinterpret-cast a
| Requires an `Int16Array`
+to int16[](a js-any) unsafe, js
	assert a 'instanceof trusted js-global["Int16Array"]
	reinterpret-cast a
| Requires an `Int32Array`
+to int32[](a js-any) unsafe, js
	assert a 'instanceof trusted js-global["Int32Array"]
	reinterpret-cast a
| Requires an `Int64Array`
+to int64[](a js-any) unsafe, js
	assert a 'instanceof trusted js-global["Int64Array"]
	reinterpret-cast a
| Requires a `Uint8Array`
+to nat8[](a js-any) unsafe, js
	assert a 'instanceof trusted js-global["Uint8Array"]
	reinterpret-cast a
| Requires a `Uint16Array`
+to nat16[](a js-any) unsafe, js
	assert a 'instanceof trusted js-global["Uint16Array"]
	reinterpret-cast a
| Requires a `Uint32Array`
+to nat32[](a js-any) unsafe, js
	assert a 'instanceof trusted js-global["Uint32Array"]
	reinterpret-cast a
| Requires a `Uint64Array`
+to nat64[](a js-any) unsafe, js
	assert a 'instanceof trusted js-global["Uint64Array"]
	reinterpret-cast a

| {reinterpret-cast} as a JS array. Unsafe because that is mutable.
+to js-any(a js-any[]) unsafe, js
	reinterpret-cast a
| {reinterpret-cast} the value as an array. Unsafe because the input may be mutable.
+to js-any[](a js-any) unsafe, js
	assert a 'instanceof Array
	reinterpret-cast a
