no-std
import
	./bool
	./col/collection
	./compare
	./misc
	./number
	./option

| {low} is inclusive and {high} is exclusive.
| Use {..} to construct a range.
+range[t] record(low t, high t) -new

# Create a range from `low` (inclusive) to `high` (exclusive).
+ ..[t] t range(low t, high t) t equal, t compare
	assert low <= high
	low, high

+forward-rangeable[t] spec t equal, t compare
	next t(a t)

+difference[t] spec
	difference nat32(a t, b t)

+subtract-to-nat[t] spec
	- nat32(a t, b t)

+difference[t] nat32(a t, b t) t subtract-to-nat
	a - b

# Spec for types that support most range operations
+rangeable[t] spec t forward-rangeable
	prev t(a t)

+size[t] nat32(a t range) t difference
	difference a.high, a.low

+is-empty[t] bool(a t range) t equal
	a.low == a.high

# Calls `f` for each value in the range, from `a.low` to `a.high - 1`.
+some[t] bool(a t range, f bool mut(elem t)) t forward-rangeable
	cur mut = a.low
	do until
	if cur >= a.high
		false
	elif f[cur]
		true
	else
		cur := next cur
		()
+some-reverse[t] bool(a t range, f bool mut(elem t)) t rangeable
	cur mut = a.high
	do until
	do unless cur == a.low else false
	cur := prev cur
	if f[cur]
		true

+subscript nat8(a nat8 range, index nat32)
	assert index < a.size else index-too-big index, a.size
	a.low + index.to
+subscript nat16(a nat16 range, index nat32)
	assert index < a.size else index-too-big index, a.size
	a.low + index.to
+subscript nat32(a nat32 range, index nat32)
	assert index < a.size else index-too-big index, a.size
	a.low + index.to
+subscript nat64(a nat64 range, index nat32)
	assert index::nat64 < (a.high - a.low) else index-too-big index, a.high - a.low
	a.low + index

+subscript nat32 range(a nat32 range, b nat32 range)
	assert b.high <= a.size else index-too-big b.high, a.size
	a.low + b.low .. a.low + b.high

region iteration

+range-iterator[t] record mut
	-collection t range
	-next-value mut t
+begin[t] t range-iterator(a t range)
	a, a.low
+end[t] t range-iterator(a t range)
	a, a.high
+take-prev[t] t(a t range-iterator) t rangeable
	assert a.next-value > a.collection.low else iterator-out-of-bounds
	a.next-value := prev a.next-value
	a.next-value
+take-next[t] t(a t range-iterator) t forward-rangeable
	assert a.next-value < a.collection.high else iterator-out-of-bounds
	res = a.next-value
	a.next-value := next a.next-value
	res

+in[t] bool(a t, b t range) t compare
	b.low <= a and a < b.high

+clamp[t] t(a t, range t range) t rangeable
	if a < range.low
		range.low
	elif a > range.high
		range.high
	else
		a
