| Functions for getting hash codes.
|
| Hash codes are used internally by map and set types,
| which require a `hash` implementation for the key type.
no-std
import
	./bits
	./bool
	./compare
	./misc
	./number
	./random/secure-random

| Spec for types that can be used as keys in sorted collections that don't need hashing.
+sorted-key[k] spec k data, k compare
| Spec for types that can be used as keys in any map or set.
+key[k] spec k sorted-key, k hash

| Spec that should be implemented for any type used as a map key.
|
| {hash} on a composite type (such as a record or collection)
| usually just calls {hash} for each value it contains.
|
| {hash} on a union should mix a number or name for the union member,
| then mix its associated value, if any.
+hash[t] spec
	hash void(a t, state hash-state)

~global-hash-seed nat() global, unsafe
	global-hash-seed-value

-global-hash-seed-value global(nat)
	# TODO: The initializer for a 'global' should obviously be allowed to be 'global'...
	trusted next secure-random

| Get a hash code based on a global random seed.
| This will return the same value given the same argument in the same process,
| but will be different for each new process.
+seeded-hash[t] nat64(a t) global, t hash
	state hash-state = trusted global-hash-seed,
	hash a, state
	finish state

| Get a deterministic hash code for any value.
+deterministic-hash[t] nat64(a t) t hash
	state hash-state = ()
	hash a, state
	finish state

+hash-state record mut
	-state mut nat64
	-dummy void
+new hash-state()
	0xdecafc0ffeecafe,
+new hash-state(seed nat64)
	seed, ()
+finish nat64(a hash-state)
	state a

+hash void(_ void, _ hash-state)
	trusted ()
+hash void(a bool, state hash-state)
	trusted hash a.to::nat64, state
+hash void(a nat8, state hash-state)
	trusted hash a::nat64, state
+hash void(a nat16, state hash-state)
	trusted hash a::nat64, state
+hash void(a nat32, state hash-state)
	trusted hash a::nat64, state
+hash void(a nat64, state hash-state)
	do trusted
	state.state ^:= a
	state.state := 0x5851f42d4c957f2d 'wrap-mul state.state 'wrap-add 1
+hash void(a int8, state hash-state)
	trusted hash a::int64, state
+hash void(a int16, state hash-state)
	trusted hash a::int64, state
+hash void(a int32, state hash-state)
	trusted hash a::int64, state
+hash void(a int64, state hash-state)
	trusted hash a.wrap-to::nat64, state
+hash void(a float32, state hash-state)
	trusted hash a.bits-of, state
+hash void(a float64, state hash-state)
	trusted hash a.bits-of, state

+hash[t, u] void((t t, u u), state hash-state) t hash, u hash
	do trusted
	hash t, state
	hash u, state
