no-std
import
	java/lang/String
	./bool
	./compare
	./col/array
	./col/mut-array
	./col/buffer
	./col/collection
	./col/private/private-util
	./col/util
	./exception
	./hash
	./java
	./js
	./misc
	./number
	./private/bootstrap: chars, option
	./range
	./tuple
	./unsafe
export
	./private/bootstrap: char8, char16, char32, string

+to char8(a nat8)
+to nat8(a char8)
+to char16(a nat16)
+to nat16(a char16)
+ == bool(a char8, b char8)
+ == bool(a char32, b char32)

+string-view alias
	char8 array-view
+show string(a string-view)
	a.to

+ ~~ string(a string, b string)
	a.chars ~~ b.chars 'to
+ ~ string(a char8, b string)
	a ~ b.chars 'to
+ ~ string(a string, b char8)
	a.chars ~ b 'to

+interpolate-string string(a string)
	a
+interpolate-value[t] string(a t) t show
	show a
+interpolate string(parts string[])
	join parts
+interpolate String(parts string[]) java
	parts.interpolate::string.to
+interpolate js-any(parts string[]) js
	parts.interpolate::string.to

| Same as `""`.
+new string()
	""

| Same as `{a} == ""`.
+is-empty bool(a string)
	is-empty a.to::char8[]

+size nat32(a string)
	a.to::char8[].size

+ == bool(a string, b string)
	trusted a.chars == b.chars
+ <=> comparison(a string, b string)
	trusted a.chars <=> b.chars
+ <=> comparison(a char8, b char8)
+ <=> comparison(a char32, b char32)
	trusted a.to::nat32 <=> b.to

-to nat32(a char32)

+hash void(a string, state hash-state)
	trusted hash a.chars, state
+hash void(a char8, state hash-state)
	trusted hash a.to::nat8, state
+hash void(a char32, state hash-state)
	trusted hash a.to::nat32, state

+subscript char8(a string, index nat32)
	a.chars[index]
+subscript char8(a string, index index-relative-to-end)
	a.chars[to-index a, index]
+subscript string-view(a string, indices nat32 range)
	a.chars[indices]
+subscript string-view(a string, indices range-relative-to-end)
	a.chars[to-range a, indices]

region conversion

+to char8[](a string)
	a.chars

| Treats UTF-8 character codes as a string.
+to string(a char8[])
	a,
+to string(a string-view)
	a.to::char8[].to
+move-to string(a char8 mut[])
	a.move-to::char8[].to
+as-string string(bytes nat8[])
	bytes.safe-reinterpret-cast::char8[].to
+as-string string(bytes nat8 array-view)
	as-string bytes.to

| Treats a string as UTF-8 bytes.
| This is O(1).
+to nat8[](a string)
	safe-reinterpret-cast a.chars
+to int8[](a string)
	safe-reinterpret-cast a.chars

+show[t] spec
	show string(a t)

| `"true"` or `"false"`.
+show string(a bool)
	if a then "true" else "false"

| String containing a single character.
+to string(a char8)
	chars: a,
+show string(a char8)
	if is-valid-single-byte-character a
		a.to
	else
		"\\u{to-hex a.to::nat8}"

+show string(a comparison)
	match a
	as less
		"less"
	as equal
		"equal"
	as greater
		"greater"

+show[t] string(a t?) t show
	if a
		show a
	else
		"none"

~is-valid-single-byte-character bool(a char8)
	a.to::nat8 < 0b1000_0000

+show string(a nat8)
	show a::nat64
+show string(a nat16)
	show a::nat64
+show string(a nat32)
	show a::nat64
| Converts a {nat} to a {string}.
| Returns only digits without punctuation, e.g. `1234`.
+show string(a nat64)
	to-base a, 10

-js-to-string string(a js-any) unsafe, js
	call String, a 'to

-digit-to-string string(a nat64)
	a.digit-to-char.to
-digit-to-char char8(a nat64)
	match a
	as 0
		"0"
	as 1
		"1"
	as 2
		"2"
	as 3
		"3"
	as 4
		"4"
	as 5
		"5"
	as 6
		"6"
	as 7
		"7"
	as 8
		"8"
	as 9
		"9"
	as 10
		"a"
	as 11
		"b"
	as 12
		"c"
	as 13
		"d"
	as 14
		"e"
	as 15
		"f"
	else
		throw unreachable

+to-binary string(a nat64)
	to-base a, 2
+to-hex string(a nat64)
	to-base a, 16

-to-base string(a nat64, base nat64)
	if a < base
		digit-to-string a
	else
		(to-base a / base, base) ~~ (a % base).digit-to-string

+show string(a string)
	a

+show string(a int8)
	show a::int64
+show string(a int16)
	show a::int64
+show string(a int32)
	show a::int64
+show string(a int64)
	if a == min-value
		"-9223372036854775808"
	else
		s = "{abs a}"
		if a < 0 then "-{s}" else s

+show string(a float32)
	show a::float64
+show string(a float64)
	trusted if java
		strip-point-0 a.valueOf.to
	elif js
		if a == -0
			"-0"
		else
			js-to-string a.to
	else
		throw todo
-strip-point-0 string(a string)
	?to try-remove-end a, ".0" else a

+some bool(a string, f bool mut(x char8))
	some a.to::char8[], f
+some-reverse bool(a string, f bool mut(x char8))
	some-reverse a.to::char8[], f

+string-iterator alias
	char8 array-iterator
+begin string-iterator(a string)
	begin a.to::char8[]
+end string-iterator(a string)
	end a.to::char8[]

+with-block string(a build-options, f void mut(out char8 builder))
	with-block::char8[] a.size-hint.build, f 'to

region utilities

+join string(parts string[])
	join "", parts
| Equivalent to `{parts}[0] ~~ {joiner} ~~ {parts}[1] ~~ {joiner} ~~ ... ~~ {parts}[end - 1]`.
+join string(joiner string, parts string[])
	match parts.size
	as 0
		""
	as 1
		parts[0]
	else
		join-with-multiple-parts joiner, parts
-join-with-multiple-parts string(joiner string, parts string[])
	res-size = (sum parts, it.size) + joiner.size * (parts.size - 1)
	res char8 buffer = trusted uninitialized-buffer res-size
	out-i mut nat32 = 0
	for i in 0 .. parts.size
		if i != 0
			res[out-i .. out-i + joiner.size] := joiner.chars
			out-i +:= joiner.size
		part = parts[i].chars
		res[out-i .. out-i + part.size] := part
		out-i +:= part.size
	assert out-i == res.size
	trusted res.cast-immutable.to
