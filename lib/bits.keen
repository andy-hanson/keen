| Functions for operating on the individual bits in nats / ints.
|
| Bit indexes are counted from the right, so the least-siginificant digit is 0.
| So, the number 5 has bits 0 and 2 set, since 5 is `2**0 + 2**2`.
no-std
import
	java/lang/Integer
	java/lang/Long
	./bool
	./compare
	./exception
	./misc
	./number
	./option

+wrap-to int8(a int64)
+wrap-to int16(a int64)
+wrap-to int32(a int64)
+wrap-to int8(a nat64)
+wrap-to int16(a nat64)
+wrap-to int32(a nat64)
+wrap-to int64(a nat64)
+wrap-to nat8(a nat64)
+wrap-to nat16(a nat64)
+wrap-to nat32(a nat64)
+wrap-to nat8(a int64)
+wrap-to nat16(a int64)
+wrap-to nat32(a int64)
+wrap-to nat64(a int64)

+wrap-add nat8(a nat8, b nat8)
+wrap-add nat16(a nat16, b nat16)
+wrap-add nat32(a nat32, b nat32)
+wrap-add nat64(a nat64, b nat64)

+wrap-add int8(a int8, b int8)
+wrap-add int16(a int16, b int16)
+wrap-add int32(a int32, b int32)
+wrap-add int64(a int64, b int64)

+wrap-sub nat8(a nat8, b nat8)
+wrap-sub nat16(a nat16, b nat16)
+wrap-sub nat32(a nat32, b nat32)
+wrap-sub nat64(a nat64, b nat64)

+wrap-sub int8(a int8, b int8)
+wrap-sub int16(a int16, b int16)
+wrap-sub int32(a int32, b int32)
+wrap-sub int64(a int64, b int64)

+wrap-mul nat8(a nat8, b nat8)
+wrap-mul nat16(a nat16, b nat16)
+wrap-mul nat32(a nat32, b nat32)
+wrap-mul nat64(a nat64, b nat64)

+wrap-mul int8(a int8, b int8)
+wrap-mul int16(a int16, b int16)
+wrap-mul int32(a int32, b int32)
+wrap-mul int64(a int64, b int64)

| Negates every bit.
| 0 bits become 1 bits and vice versa.
+ ~ nat8(a nat8)
+ ~ nat16(a nat16)
+ ~ nat32(a nat32)
+ ~ nat64(a nat64)

| Intersection of bits; 'and's each corresponding bit in parallel.
| An output bit will be 1 iff both corresponding input bits are 1.
+ & nat8(a nat8, b nat8)
+ & nat16(a nat16, b nat16)
+ & nat32(a nat32, b nat32)
+ & nat64(a nat64, b nat64)

| Union of bits; 'or's each corresponding bit in parallel.
| An output bit will be 1 iff either corresponding input bit is 1.
+ | nat8(a nat8, b nat8)
+ | nat16(a nat16, b nat16)
+ | nat32(a nat32, b nat32)
+ | nat64(a nat64, b nat64)

| Performs exclusive or (xor) of each bit in parallel.
| Output bits will be 1 iff the corresponding input bits are not equal.
+ ^ nat8(a nat8, b nat8)
+ ^ nat16(a nat16, b nat16)
+ ^ nat32(a nat32, b nat32)
+ ^ nat64(a nat64, b nat64)

| Shifts the bits of 'a' left by 'b' bits.
| Does not rotate.
+ << nat8(a nat8, b nat8)
	do if b < 8
	trusted a 'unsafe-bit-shift-left b
+ << nat16(a nat16, b nat16)
	do if b < 16
	trusted a 'unsafe-bit-shift-left b
+ << nat32(a nat32, b nat32)
	do if b < 32
	trusted a 'unsafe-bit-shift-left b
+ << nat64(a nat64, b nat64)
	do if b < 64
	trusted a 'unsafe-bit-shift-left b

+rotate-left nat64(a nat64, amount nat64)
	n = amount % 64
	(a << n) | (a >> (64 'wrap-sub n))
+rotate-right nat64(a nat64, amount nat64)
	n = amount % 64
	(a >> n) | (a << (64 'wrap-sub n))

| Shifts the bits of {a} right by {b} bits.
| Does not rotate.
+ >> nat8(a nat8, b nat8)
	do if b < 8
	trusted a 'unsafe-bit-shift-right b
+ >> nat16(a nat16, b nat16)
	do if b < 16
	trusted a 'unsafe-bit-shift-right b
+ >> nat32(a nat32, b nat32)
	do if b < 32
	trusted a 'unsafe-bit-shift-right b
+ >> nat64(a nat64, b nat64)
	do if b < 64
	trusted a 'unsafe-bit-shift-right b

| True iff the numbers have at least one bit in common.
+bits-intersect bool(a nat8, b nat8)
	a & b != 0
+bits-intersect bool(a nat16, b nat16)
	a & b != 0
+bits-intersect bool(a nat32, b nat32)
	a & b != 0
+bits-intersect bool(a nat64, b nat64)
	a & b != 0

| True if for every 1 bit in `b`, the corresponding bit in `a` is also a 1.
+has-all-bits bool(a nat8, b nat8)
	a & b == b
+has-all-bits bool(a nat16, b nat16)
	a & b == b
+has-all-bits bool(a nat32, b nat32)
	a & b == b
+has-all-bits bool(a nat64, b nat64)
	a & b == b

| Unsafe because {b} should be less than the number of bits in the type (else undefined behavior)
-unsafe-bit-shift-left nat8(a nat8, b nat8) unsafe
-unsafe-bit-shift-left nat16(a nat16, b nat16) unsafe
-unsafe-bit-shift-left nat32(a nat32, b nat32) unsafe
-unsafe-bit-shift-left nat64(a nat64, b nat64) unsafe
-unsafe-bit-shift-right nat8(a nat8, b nat8) unsafe
-unsafe-bit-shift-right nat16(a nat16, b nat16) unsafe
-unsafe-bit-shift-right nat32(a nat32, b nat32) unsafe
-unsafe-bit-shift-right nat64(a nat64, b nat64) unsafe

| Number with only the bit at `bit-index` set.
| Same as `1 << bit-index`.
+nth-bit nat32(bit-index nat32)
	1 << bit-index
+nth-bit nat64(bit-index nat64)
	1 << bit-index

| True if the bit at `bit-index` is set.
+has-bit bool(a nat64, bit-index nat64)
	bits-intersect a, bit-index.nth-bit

| Sets the bit at `bit-index` to 1.
+add-bit nat32(a nat32, bit-index nat32)
	a | bit-index.nth-bit
+add-bit nat64(a nat64, bit-index nat64)
	a | bit-index.nth-bit

| Sets the bit at `bit-index` to 0.
+remove-bit nat32(a nat32, bit-index nat32)
	a & ~bit-index.nth-bit
+remove-bit nat64(a nat64, bit-index nat64)
	a & ~bit-index.nth-bit

| Returns the number of 1 bits in `a`.
+count-ones nat32(a nat32)
	if trusted java
		trusted a.wrap-to::int32.bitCount.wrap-to
	else
		res mut nat32 = 0
		x mut = a
		until x == 0
			res wrap-add:= x & 1
			x >>:= 1
		res

+count-ones nat64(a nat64)
	if trusted java
		trusted a.wrap-to::int64.bitCount.wrap-to
	else
		res mut nat64 = 0
		x mut = a
		until x == 0
			res wrap-add:= x & 1
			x >>:= 1
		res

+one-bits one-bits32(bits nat32) = bits,
+one-bits one-bits64(bits nat64) = bits,

+one-bits32 record(bits nat32)
+size nat(a one-bits32) = count-ones a.bits
| Calls `f` on the index of each `1` bit.
+some bool(a one-bits32, f bool mut(bit nat32))
	cur mut = a.bits
	offset mut nat32 = 0
	do until
	if cur == 0
		false
	elif bits-intersect cur, 1 and f[offset]
		true
	else
		cur >>:= 1
		offset wrap-add:= 1
		()

+one-bits64 record(bits nat64)
+size nat(a one-bits64) = count-ones a.bits
| Calls `f` on the index of each `1` bit.
+some bool(a one-bits64, f bool mut(bit nat64))
	cur mut = a.bits
	offset mut nat64 = 0
	do until
	if cur == 0
		false
	elif bits-intersect cur, 1 and f[offset]
		true
	else
		cur >>:= 1
		offset wrap-add:= 1
		()

| Returns the index of the {n}th 1 bit in the word.
| (Low bits have low indices, so the 1s place is index 0, the 2s place is index 1, etc.)
| Returns an empty option unless there are at least `{n} + 1` one bits in {word}.
+nth-one-bit nat32?(word nat32, n nat32)
	do if n < word.count-ones
	cur mut = word
	# Clear the lowest {index} 1 bits
	i mut = 0
	until i == n
		cur &:= wrap-sub cur, 1
		i wrap-add:= 1
	trailing-zeroes cur
+nth-one-bit nat64?(word nat64, n nat64)
	do if n < word.count-ones
	cur mut = word
	# Clear the lowest {index} 1 bits
	i mut = 0
	until i == n
		cur &:= wrap-sub cur, 1
		i wrap-add:= 1
	trailing-zeroes cur

+bits-cat nat16(a nat8, b nat8)
	a::nat16 << 8 | b
+bits-cat nat32(a nat16, b nat16)
	a::nat32 << 16 | b
| Concatenates two 32-bit numbers to a 64-bit number.
| `a` will be the high bits and `b` will be the low bits.
+bits-cat nat64(a nat32, b nat32)
	a::nat64 << 32 | b

| Number with the highest `n` bits set.
+high-n-bits nat32(n nat32)
	assert n <= 32 else arithmetic-error "high-n-bits::nat32", n
	~(32 'wrap-sub n).low-n-bits
+high-n-bits nat64(n nat64)
	assert n <= 64 else arithmetic-error "high-n-bits::nat64", n
	~(64 'wrap-sub n).low-n-bits

| Number with the lowest `n` bits set.
+low-n-bits nat32(n nat32)
	assert n <= 32 else arithmetic-error "low-n-bits::nat32", n
	if n == 32
		0xffffffff
	else
		trusted 1 'unsafe-bit-shift-left n 'wrap-sub 1
+low-n-bits nat64(n nat64)
	assert n <= 64 else arithmetic-error "low-n-bits::nat64", n
	if n == 64
		0xffffffffffffffff
	else
		trusted 1 'unsafe-bit-shift-left n 'wrap-sub 1

+log-2-rounded-up nat64(a nat64)
	do unless a == 0
	trusted if java
		floor = 63 'wrap-sub a.wrap-to.numberOfLeadingZeros.wrap-to
		floor + ((1 << floor) != a).to
	elif js
		res = log-2-rounded-down a
		res + (1 << res != a).to
	else
		throw todo

+log-2-rounded-down nat64(a nat64)
	do unless a == 0
	trusted if java
		63 'wrap-sub a.wrap-to.numberOfLeadingZeros.wrap-to
	elif js
		log mut = 0
		cur mut = a
		while cur > 1
			cur >>:= 1
			log +:= 1
		log
	else
		throw todo

| Number of 0s in the binary representation of a number
+trailing-zeroes nat32(a nat32)
	trusted if java
		wrap-to numberOfTrailingZeros wrap-to::int32 a
	elif a == 0
		32
	else
		res mut nat32 = 0
		cur mut = a
		while is-even cur
			cur := cur >> 1
			res +:= 1
		res
+trailing-zeroes nat64(a nat64)
	trusted if java
		wrap-to numberOfTrailingZeros wrap-to::int64 a
	elif a == 0
		64
	else
		res mut = 0
		cur mut = a
		while is-even cur
			cur := cur >> 1
			res +:= 1
		res

+is-power-of-two bool(a nat64)
	a != 0 and (a & (a 'wrap-sub 1)) == 0

+round-up-to-power-of-two nat32(a nat32)
	to round-up-to-power-of-two a::nat64
+round-up-to-power-of-two nat64(a nat64)
	trusted if java
		h nat64 = a.wrap-to.highestOneBit.wrap-to
		if h == a
			if a == 0 then 1 else a
		else
			res = h 'unsafe-bit-shift-left 1
			res isnt 0 else arithmetic-error "round-up-to-power-of-two", a
			res
	else
		x mut nat64 = a 'wrap-sub 1
		x |:= x 'unsafe-bit-shift-right 1
		x |:= x 'unsafe-bit-shift-right 2
		x |:= x 'unsafe-bit-shift-right 4
		x |:= x 'unsafe-bit-shift-right 8
		x |:= x 'unsafe-bit-shift-right 16
		x |:= x 'unsafe-bit-shift-right 32
		x wrap-add:= 1
		if x == 0
			a is 0 else arithmetic-error "round-up-to-power-of-two", a
			1
		else
			x
