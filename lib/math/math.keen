import
	keen/js
	java/lang/Math: sqrt
	../private/java-math

+is-finite bool(a float32)
	a != (trusted nan) and a != -infinity and a != infinity
+is-finite bool(a float64)
	a != (trusted nan) and a != -infinity and a != infinity

+pi float64()
	3.141592653589793239
+pi float32()
	pi::float64.to
| pi / 2
+pi_2 float64()
	1.570796326794899662
+pi_2 float32()
	pi_2::float64.to
| pi / 4
+pi_4 float64()
	# TODO: add '62' to the end
	0.785398163397448309
+pi_4 float32()
	pi_4::float64.to

-Math js-any() js
	trusted js-global["Math"]

+square-root float32(a float32)
	a::float64.square-root.to
+square-root float64(a float64)
	assert a >= 0 else arithmetic-error "square-root", a
	trusted if java
		sqrt a
	elif js
		call-property Math, "sqrt", a.to 'to
	else
		throw todo

+acos float32(a float32)
	a::float64.acos.to
+acos float64(a float64)
	trusted if java
		java-acos a
	elif js
		call-property Math, "acos", a.to 'to
	else
		throw todo
+asin float32(a float32)
	a::float64.asin.to
+asin float64(a float64)
	trusted if java
		java-asin a
	elif js
		call-property Math, "asin", a.to 'to
	else
		throw todo
+atan float32(a float32)
	a::float64.atan.to
+atan float64(a float64)
	trusted if java
		java-atan a
	elif js
		call-property Math, "atan", a.to 'to
	else
		throw todo
+atan2 float32(y float32, x float32)
	atan2 y::float64, x::float64 'to
+atan2 float64(y float64, x float64)
	trusted if java
		java-atan2 y, x
	elif js
		call-property Math, "atan2", y.to, x.to 'to
	else
		throw todo
+cos float32(a float32)
	a::float64.cos.to
+cos float64(a float64)
	assert is-finite a else arithmetic-error "cos", a
	trusted if java
		java-cos a
	elif js
		call-property Math, "cos", a.to 'to
	else
		throw todo
+sin float32(a float32)
	a::float64.sin.to
+sin float64(a float64)
	assert is-finite a else arithmetic-error "sin", a
	trusted if java
		java-sin a
	elif js
		call-property Math, "sin", a.to 'to
	else
		throw todo
+tan float32(a float32)
	a::float64.tan.to
+tan float64(a float64)
	assert is-finite a else arithmetic-error "tan", a
	trusted if java
		java-tan a
	elif js
		call-property Math, "tan", a.to 'to
	else
		throw todo
+acosh float32(a float32)
	a::float64.acosh.to
+acosh float64(a float64)
	assert a >= 1 else arithmetic-error "acosh", a
	trusted if java
		log a + square-root (a * a - 1)
	elif js
		call-property Math, "acosh", a.to 'to
	else
		throw todo
+asinh float32(a float32)
	a::float64.asinh.to
+asinh float64(a float64)
	trusted if java
		log a + square-root (a * a + 1)
	elif js
		call-property Math, "asinh", a.to 'to
	else
		throw todo
+atanh float32(a float32)
	a::float64.atanh.to
+atanh float64(a float64)
	assert a >= -1 and a <= 1 else arithmetic-error "atanh", a
	trusted if java
		0.5 * log abs ((a + 1) / (a - 1))
	elif js
		call-property Math, "atanh", a.to 'to
	else
		throw todo
+cosh float32(a float32)
	a::float64.cosh.to
+cosh float64(a float64)
	trusted if java
		java-cosh a
	elif js
		call-property Math, "cosh", a.to 'to
	else
		throw todo
+sinh float32(a float32)
	a::float64.sinh.to
+sinh float64(a float64)
	trusted if java
		java-sinh a
	elif js
		call-property Math, "sinh", a.to 'to
	else
		throw todo
+tanh float32(a float32)
	a::float64.tanh.to
+tanh float64(a float64)
	trusted if java
		java-tanh a
	elif js
		call-property Math, "tanh", a.to 'to
	else
		throw todo

+e float32()
	2.718281828459045
+e float64()
	2.718281828459045

| Natual logarithm (base {e})
+log float32(a float32)
	a::float64.log.to
+log float64(a float64)
	assert a > 0 else arithmetic-error "log", a
	trusted if java
		java-log a
	elif js
		call-property Math, "log", a.to 'to
	else
		throw todo

+log float32(a float32, base float32)
	a.log / base.log
+log float64(a float64, base float64)
	a.log / base.log
