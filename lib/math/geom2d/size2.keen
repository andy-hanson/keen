import
	keen/math/vec

+size2-32 record
	width float32
	height float32
+new size2-32()
	0, 0
+area float32(a size2-32)
	a.width * a.height
+to vec2-32(a size2-32)
	a.width, a.height
+shorter-side float32(a size2-32)
	min a.width, a.height
+square size2-32(width float32)
	width, width
+ * size2-32(a size2-32, scale float32)
	a.width * scale, a.height * scale
+ / size2-32(a size2-32, b size2-32)
	a.width / b.width, a.height / b.height
