no-std
import
	./private/bootstrap: bool, false, true
export
	./private/bootstrap: compare, comparison, equal, greater, less

+ == bool(a comparison, b comparison)
	trusted match a
	as less
		match b
		as less then true
		else then false
	as equal
		match b
		as equal then true
		else then false
	as greater
		match b
		as greater then true
		else then false
+ <=> comparison(a comparison, b comparison)
	trusted match a
	as less
		match b
		as less then equal
		else then less
	as equal
		b
	as greater
		match b
		as greater then equal
		else then greater

| Opposite comparison
+ - comparison(a comparison)
	match a
	as less
		greater
	as equal
		equal
	as greater
		less

| Opposite of `{a} == {b}`
+ !=[t] bool(a t, b t) t equal

| True iff `({a} <=> {b}) == {less}`.
+ <[t] bool(a t, b t) t compare

| True iff `({a} <=> {b}) != {greater}`.
+ <=[t] bool(a t, b t) t compare

| True iff `({a} <=> {b}) == {greater}`.
+ >[t] bool(a t, b t) t compare

| True iff `({a} <=> {b}) != {less}`.
+ >=[t] bool(a t, b t) t compare

| Returns the lesser argument.
| Returns {b} if they are equal.
+min[t] t(a t, b t) t compare
	if a < b then a else b

| Returns the greater argument.
| Returns {b} if they are equal.
+max[t] t(a t, b t) t compare
	if a > b then a else b

| Wraps a value and reverses comparison (so less becomes greater and vice versa)
+compare-reverse[t] record(inner t)
+ ==[t] bool(a t compare-reverse, b t compare-reverse) t equal
	trusted a.inner == b.inner
+ <=>[t] comparison(a t compare-reverse, b t compare-reverse) t compare
	trusted -(a.inner <=> b.inner)
