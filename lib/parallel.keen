no-std
import
	java/lang/Runnable
	java/lang/Throwable
	java/util/concurrent/CompletableFuture
	java/util/concurrent/ExecutionException
	java/util/concurrent/ExecutorService
	./bool
	./col/array
	./col/buffer
	./col/mut-array
	./col/collection
	./col/sort
	./col/util
	./exception
	./js
	./json
	./misc
	./number
	./private/runtime
	./range
	./random/random
	./random/secure-random
	./random/util
	./string
	./test-util
	./unsafe

| In Java, this is a `java.util.concurrent.CompletableFuture`.
| In JS, this is a `Promise`.
+future[t] builtin

-as-js[t] js-any(value t) js, unsafe
	reinterpret-cast value

+await[t] t(a t future)
	trusted if java
		with in unlocked-exclusion
			try
				a.reinterpret-cast::(t CompletableFuture).get
			catch e as ExecutionException
				throw reinterpret-cast e.reinterpret-cast::Throwable.getCause
	elif js
		reinterpret-cast await as-js a
	else
		throw todo

-Promise js-any() js
	trusted js-global["Promise"]

| Just yields the fiber temporarily. It may be restarted immediately.
+yield-fiber void()
	trusted if java
		with in unlocked-exclusion
			()
	elif js
		resolver = of resolve js-any
			:: void
			_ = call js-global["setTimeout"], resolve, 0
		_ = await call-new Promise, resolver.to
	else
		throw todo

| Converts a value to a future resolved with that value.
+new[t] t future(value t)
	trusted if java
		res t CompletableFuture = ()
		ok = complete res, value
		assert ok
		reinterpret-cast res
	elif js
		reinterpret-cast call-property Promise, "resolve", value.as-js
	else
		throw todo
test
	x nat future = 1,
	x.await is 1

| Future resolved with an exception.
+rejected[t] t future(err exception)
	trusted if java
		res t CompletableFuture = ()
		ok = completeExceptionally res, err.reinterpret-cast
		assert ok
		reinterpret-cast res
	elif js
		reinterpret-cast call-property Promise, "reject", err.as-js
	else
		throw todo
test
	fut nat future = rejected error "foo"
	try
		_ = await fut
		should-throw
	catch e as error
		e.show is "foo"

+parallel record
| Run {f} in a new fiber with a new exclusion and return a future for its result.
+with-block[t] t future(_ parallel, f t shared())
	trusted if java
		future t CompletableFuture = ()
		fill-it = of
			:: void
			ok = complete future, f[]
			assert ok == true
		_ = submit get-executor, fill-it.reinterpret-cast::Runnable
		reinterpret-cast future
	elif js
		# This ensures 'f' is not run immediately
		Promise 'call-property "resolve" 'call-property "then", f.as-js 'reinterpret-cast
	else
		throw todo
# Test single future awaited by multiple fibers at once
test
	f nat future = with in later
		1
	a0 nat future = with in parallel
		f.await + 1
	a1 nat future = with in parallel
		f.await + 2
	a0.await is 2
	a1.await is 3
# This tests 'shared-of-mut-lambda', which the compiler uses to implement 'shared' lambdas.
test
	out nat mut[] = ()
	f void shared(x nat) = shared of x
		out ~= x
		()
	for x in parallel 0::nat .. 10
		f[x]
	out.move-to.sort::nat[] is for x in 0::nat .. 10 then x

| This is like running something with `parallel` and then waiting on it.
| The purpose is to allow other fibers with the current exclusion to run while waiting.
+new-exclusion record
+with-block[t] t(_ new-exclusion, f t shared())
	await with-block parallel, f

+later record
| Run {f} in a new fiber with the current exclusion. So it can't run until the current fiber yields.
+with-block[t] t future(_ later, f t mut()) t shared
	with-block parallel, shared-of-mut-lambda f
test
	out nat mut[] = ()
	f void future = with in later
		out ~= 2
	out ~= 1
	out.to::nat[] is (1,) # this is guaranteed to not have changed yet
	await f
	out.to::nat[] is (1, 2)

| Does not await the future, but will log any exceptions from the future once it is done.
+forget[t] void(a t future)
	do trusted
	assert js else todo # --------------------------------------------------------------------------------------------
	cb = of error js-any
		:: void
		_ = call-property js-global["console"], "error", error
	_ = call-property a.as-js, "catch", cb.to

+fire-and-forget record
| Runs {f} in parallel and logs any exceptions, but does not await it.
+with-block void(_ fire-and-forget, f void shared())
	forget with-block parallel, f

+parallel-collection[col] record(collection col)
+parallel[col] col parallel-collection(a col)
	a,
| For each element of {a}, runs {f} in parallel. Then awaits them all.
+for-loop[out-col, out-elem, in-col, in-elem] out-col
	a in-col parallel-collection
	f out-elem shared(elem in-elem)
do out-elem shared, in-elem shared, (out-col, out-elem) list-new, in-col size, (in-col, in-elem) some
	array in-elem[] = for x in a.collection then x
	permutation = random-permutation a.collection.size
	futures out-elem future[] = for index in permutation
		with in parallel
			f[array[index]]
	results out-elem[] = for x in futures
		trusted if js
			# Can't do `x await`, since that will fail if the input is not a Promise.
			# This is tricky because we may have implicitly awaited the Promise already.
			reinterpret-cast await as-js x
		else
			await x
	trusted list-new undo-permutation results, permutation
test
	xs nat[] = for x in parallel 0::nat .. 5
		x * 2
	xs is (0, 2, 4, 6, 8)

| Same as the above but returning 'void'.
+for-loop[col, elem] void
	a col parallel-collection
	f void shared(elem elem)
do elem shared, col size, (col, elem) some
	array elem[] = for x in a.collection then x
	permutation = random-permutation a.collection.size
	futures void future[] = for index in permutation
		with in parallel
			f[array[index]]
	for x in futures
		await x

-random-permutation nat[](size nat)
	shuffle (0 .. size).to, basic-prng trusted next secure-random
| Unsafe because permutation must contain all indices in 0 .. n exactly once
-undo-permutation[t] t[](a t[], permutation nat[]) unsafe
	a.size is permutation.size
	res t buffer = uninitialized-buffer permutation.size
	for i in  0 .. permutation.size
		res[permutation[i]] := a[i]
	cast-immutable res

| Runs {f} in parallel for each element of {a} and returns elements for which it was {true}.
+filter[out-col, in-col, elem, builder] out-col
	a in-col parallel-collection
	f bool shared(elem elem)
do (out-col, elem) list-new, elem shared, in-col size, (in-col, elem) some
	bools bool[] = for-loop a, f
	do with out in build
	for i, x in with-index a.collection
		if bools[i]
			out ~= x
