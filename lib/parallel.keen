import
	java/lang/Object
	java/lang/Runnable
	java/util/concurrent/ExecutorService
	java/util/concurrent/Future
	./js
	./private/runtime
	./random/random
	./random/secure-random
	./random/util
	./unsafe

+parallel-collection[col] record(collection col)
+parallel[col] col parallel-collection(a col)
	a,
| For each element of {a}, runs {f} in parallel.
| Returns a collection of all the results of {f}.
|
| If any call to {f} throws an exception, this will throw that too.
| (If multiple calls to {f} throw an exception, one will be thrown arbitrarily.)
| This will still wait for all calls to {f} to complete before returning.
+for-loop[out-col, out-elem, in-col, in-elem] out-col
	a in-col parallel-collection
	f out-elem shared(elem in-elem)
do out-elem shared, in-elem shared, (out-col, out-elem) list-new, in-col size, (in-col, in-elem) some
	array in-elem[] = for x in a.collection then x
	# Use a random mutation to avoid a pattern in execution order, since that is not guaranteed.
	permutation nat[] = random-permutation a.collection.size
	do trusted
	results out-elem buffer = uninitialized-buffer array.size
	if java
		do with in unlocked-exclusion
		error mut exception? = ()
		futures Object Future[] = for index in permutation
			fill-it void mut() = of
				try
					results[index] := f[array[index]]
				catch e
					error := error else e
			submit get-executor, fill-it.reinterpret-cast::Runnable
		for x in futures
			_ = get x
		forbid error else error!
	elif js
		fn = eval quote
			async (array, permutation, results, f) => \{
				const promises = Array.from(permutation).map(async i => \{ results[i] = await f(array[i]) \})
				await Promise.allSettled(promises) // Ensure all promises have run to completion
				for (const x of promises) await x // Ensure any errors get thrown
			\}
		_ = await call fn, array.reinterpret-cast, permutation.to, results.reinterpret-cast, f.reinterpret-cast
	else
		throw todo
	list-new cast-immutable results

| For each element of {a}, runs {f} in parallel.
+for-loop[col, elem] void
	a col parallel-collection
	f void shared(elem elem)
do elem shared, col size, (col, elem) some
	_ void[] = for-loop a, f

-random-permutation nat[](size nat)
	shuffle (0 .. size).to, basic-prng trusted next secure-random

| Runs {f} in parallel for each element of {a} and returns elements for which it was {true}.
+filter[out-col, in-col, elem, builder] out-col
	a in-col parallel-collection
	f bool shared(elem elem)
do (out-col, elem) list-new, elem shared, in-col size, (in-col, elem) some
	bools bool[] = for-loop a, f
	do with out in build
	for i, x in with-index a.collection
		if bools[i]
			out ~= x
