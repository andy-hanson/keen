no-std
import
	./private/bootstrap

| Returns a value which the GC will ignore.
| This is 'null' for pointers, or an arbitrary value for non-pointer types.
| In JS, this is the JS 'null' value.
+gc-safe-value[t] t() unsafe

| True if two references have the same pointer.
| Contrast with `a == b` which can also be true for different pointers with equal contents.
+reference-equal[t] bool(a t, b t) unsafe

| Treat an {input} as if it were an {output}.
| WARN: Use only if you're sure an {input} can be treated as an {output}.
| Otherwise this could cause invalid bytecode to be generated.
+reinterpret-cast[output, input] output(a input) unsafe

| Certain {reinterpret-cast}s are guaranteed to be safe.
| For example, treating signed integers as unsigned integers wraps based on two's complement.
+safe-reinterpret-cast char8[](a nat8[])
	trusted reinterpret-cast a
+safe-reinterpret-cast char8 buffer(a nat8 buffer)
	trusted reinterpret-cast a
+safe-reinterpret-cast nat8[](a char8[])
	trusted reinterpret-cast a
+safe-reinterpret-cast nat8 buffer(a char8 buffer)
	trusted reinterpret-cast a

+safe-reinterpret-cast char8[](a int8[])
	trusted reinterpret-cast a
+safe-reinterpret-cast char8 buffer(a int8 buffer)
	trusted reinterpret-cast a
+safe-reinterpret-cast int8[](a char8[])
	trusted reinterpret-cast a
+safe-reinterpret-cast int8 buffer(a char8 buffer)
	trusted reinterpret-cast a

+safe-reinterpret-cast int8[](a nat8[])
	trusted reinterpret-cast a
+safe-reinterpret-cast int8 buffer(a nat8 buffer)
	trusted reinterpret-cast a
+safe-reinterpret-cast nat8[](a int8[])
	trusted reinterpret-cast a
+safe-reinterpret-cast nat8 buffer(a int8 buffer)
	trusted reinterpret-cast a

+safe-reinterpret-cast int16[](a nat16[])
	trusted reinterpret-cast a
+safe-reinterpret-cast int16 buffer(a nat16 buffer)
	trusted reinterpret-cast a
+safe-reinterpret-cast nat16[](a int16[])
	trusted reinterpret-cast a
+safe-reinterpret-cast nat16 buffer(a int16 buffer)
	trusted reinterpret-cast a

+safe-reinterpret-cast int32[](a nat32[])
	trusted reinterpret-cast a
+safe-reinterpret-cast int32 buffer(a nat32 buffer)
	trusted reinterpret-cast a
+safe-reinterpret-cast nat32[](a int32[])
	trusted reinterpret-cast a
+safe-reinterpret-cast nat32 buffer(a int32 buffer)
	trusted reinterpret-cast a

+safe-reinterpret-cast int64[](a nat64[])
	trusted reinterpret-cast a
+safe-reinterpret-cast int64 buffer(a nat64 buffer)
	trusted reinterpret-cast a
+safe-reinterpret-cast nat64[](a int64[])
	trusted reinterpret-cast a
+safe-reinterpret-cast nat64 buffer(a int64 buffer)
	trusted reinterpret-cast a

+safe-reinterpret-cast-array[out, input] spec
	safe-reinterpret-cast out[](a input[])
+safe-reinterpret-cast[out, input] out array-view(a input array-view) (out, input) safe-reinterpret-cast-array
	array-view a.inner.safe-reinterpret-cast, a.low, a.high

~is-empty-type[t] bool() unsafe

+weak-ref[t] builtin
| Create an already-expired reference (weak-refs are intrinsically optional)
+new[t] t weak-ref() unsafe
+new[t] t weak-ref(a t) unsafe
+get[t] t?(a t weak-ref) unsafe
