import
	java/lang/Double
	java/lang/String
	./bits
	./col/util: try-take-all
	./java
	./js
	./private/parse-util
	./string/unicode

+try-take bool(a string-iterator, start string)
	try-take-all a, start.to::char8[]
+starts-with bool(a string-iterator, start string)
	try-take a.copy, start

+grammar[t] interface
	parse t(iter string-iterator)

| Match a string against a grammar.
| The whole string must match the grammar.
| If the string has leading or trailing spaces you must use a grammar that includes those.
| Throws a {parse-error} on failure.
+parse[t] t(a t grammar, text string)
	parse a, text.to::string-view
+parse[t] t(a t grammar, text string-view)
	iter string-iterator = begin text
	try
		res = parse a, iter
		assert is-at-end iter else parse-error text.to, iter.index, "string continues past end of parse"
		res
	catch e as inner-parse-error
		throw parse-error text.to, iter.index, e.expected

+parse-error record exception case
	| The argument passed to {parse}.
	input string
	| Position where the parse error happened.
	| This will be `{input}.end` if the error was end of input.
	index nat
	| Description of what was expected.
	expected string
+show string(a parse-error)
	# TODO: show where it is. Also handle funny characters
	peek = if a.index == a.input.size then "EOF" else "'{(a.input.to::char8[])[a.index]}'"
	"Expected {a.expected}, got {peek}"

+inner-parse-error record(expected string) exception case
+show string(a inner-parse-error)
	"Expected {a.expected}"

| This is like {grammar} but produces no result.
+grammar-skip record(inner void grammar)

| Grammar matching empty strings
+new grammar-skip()
	exact ""

| Use to discard the result of any {grammar}.
+skip[t] grammar-skip(a t grammar) t data
	- transform a, {}

+and-return[t] t grammar(a grammar-skip, value t) t data
	transform a.inner, {value}

+text-delimited string grammar(begin string, end string)
	begin ~~ end.text-not-containing ~~ end

+text-not-containing string grammar(ending string)
	text-not-containing-any (ending,)

+text-not-containing-any string grammar(possible-endings string[])
	parse: of iter
		res string = with out in build
			do until
			if some possible-endings, {starts-with iter, it}
				true
			elif not is-at-end iter
				out ~= take-next iter
				false
			else
				true
		forbid is-empty res else
			endings = join ", ", for x in possible-endings then "'{x}'"
			inner-parse-error "expected text ending in one of {endings}"
		res

| Grammar for a single character matching the predicate.
-char-matching-predicate char8 grammar(description string, predicate bool data(x char8))
	parse: of iter
		res = peek iter
		assert res and predicate[res] else inner-parse-error description
		_ = take-next iter
		res

| Expects to parse {a} followed by {b}.
| By default this does not allow spaces in between. For that, use `a ~~ spaces ~~ b`.
+ ~~[t, u] (t, u) grammar(a t grammar, b u grammar) t data, u data
	parse: of iter
		- parse a, iter
		- parse b, iter
+ ~~[t] t grammar(a t grammar, b grammar-skip) t data
	parse: of iter
		res = parse a, iter
		parse b.inner, iter
		res
+ ~~[t] t grammar(a grammar-skip, b t grammar) t data
	parse: of iter
		parse a.inner, iter
		parse b, iter
+ ~~ grammar-skip(a grammar-skip, b grammar-skip)
	- a.inner ~~ b
| Skips an exact string, then parses {b}.
+ ~~[t] t grammar(a string, b t grammar) t data
	a.exact ~~ b
| Parses {a}, then skips an exact string.
+ ~~[t] t grammar(a t grammar, b string) t data
	a ~~ b.exact
+ ~~ grammar-skip(a string, b grammar-skip)
	a.exact ~~ b
+ ~~ grammar-skip(a grammar-skip, b string)
	a ~~ b.exact

| Tries to parse with {a}, and if that fails, tries to parse with {b} instead.
+ /[t] t grammar(a t grammar, b t grammar) t data
	parse: of iter
		restore = iter.index
		try
			parse a, iter
		catch as inner-parse-error
			iter.index := restore
			parse b, iter

| Uses a function to transform the result if parsing is successful.
+transform[output, input] output grammar(a input grammar, f output data(x input)) output data, input data
	parse: of iter
		f[parse a, iter]

| Allows parsing to fail, returning an empty option if it does.
+optional[t] t? grammar(a t grammar) t data
	parse: of iter
		restore = iter.index
		try
			parse a, iter
		catch as inner-parse-error
			iter.index := restore
			()
| Optionally skips an exact string.
+optional grammar-skip(a string)
	skip optional inner exact a

| Parses the same grammar as many times as possible (including 0 times).
+many[t] t[] grammar(a t grammar) t data
	parse: of iter
		do with out in build
		restore mut = iter.index
		try
			while true
				restore := iter.index
				out ~= parse a, iter
		catch as inner-parse-error
			iter.index := restore

+many grammar-skip(a grammar-skip)
	inner void[] grammar = many a.inner
	- transform inner, {}

| Parses {a} at least once, then as many times as possible.
+one-or-more[t] t[] grammar(a t grammar) t data
	transform a ~~ a.many, of first, rest
		first ~ rest

+one-or-more grammar-skip(a grammar-skip)
	inner void[] grammar = one-or-more a.inner
	- transform inner, {}

| Parses {a} as many times as possible, with 'separator' in between.
|
| This does not allow a trailing separator;
| it is a parse error to have a separator not followed by another {a}.
| This does allow to parse nothing, returning an empty array.
+separated-by[t] t[] grammar(a t grammar, separator string) t data
	separated-by a, separator.exact
+separated-by[t] t[] grammar(a t grammar, separator grammar-skip) t data
	parse: of iter
		do if first = try-parse a, iter
		do with out in build
		out ~= first
		while try-parse separator, iter
			out ~= parse a, iter

-try-parse bool(a grammar-skip, iter string-iterator)
	try-parse a.inner, iter

-try-parse[t] t?(a t grammar, iter string-iterator)
	restore = index iter
	try
		parse a, iter
	catch as inner-parse-error
		iter.index := restore
		()

| Matches {a} exactly.
+exact grammar-skip(a string)
	inner: parse: of iter
		assert try-take iter, a else inner-parse-error "expected '{a}'"

| Equivalent to `{transform} {a}.{exact}, \{{value}\}`
+exact[t] t grammar(a string, value t) t data
	transform a.exact.inner, {value}

+whitespace grammar-skip()
	inner: parse: it.skip-whitespace
+skip-whitespace void(a string-iterator)
	while x = a.peek and is-space x
		_ = take-next a
+is-space bool(a char8)
	match a
	as " "
		true
	as "\r"
		true
	as "\n"
		true
	as "\t"
		true
	else
		false

| A double-quoted string as in JSON, including escape sequences.
+quoted-string string grammar()
	parse: it.take-quoted-string
~take-quoted-string string(iter string-iterator)
	assert try-take iter, "\"" else inner-parse-error "quoted string"
	take-quoted-string-after-quote iter
~take-quoted-string-after-quote string(iter string-iterator)
	do with out in build
	do until
	forbid is-at-end iter else inner-parse-error "quoted string"
	match char = take-next iter
	as "\""
		true
	as "\\"
		assert take-string-escape out, iter else inner-parse-error "Valid escape sequence"
		false
	as "\n"
		throw inner-parse-error "closing quote"
	else
		out ~= char
		false

~take-string-escape bool(out char8 builder, iter string-iterator)
	match try-take-next iter else "\0"
	as "\\"
		out ~= "\\"
		true
	as "\{"
		out ~= "\{"
		true
	as "\}"
		out ~= "\}"
		true
	as "0"
		out ~= "\0"
		true
	as "\""
		out ~= "\""
		true
	as "n"
		out ~= "\n"
		true
	as "r"
		out ~= "\r"
		true
	as "t"
		out ~= "\t"
		true
	as "u"
		take-unicode-escape out, iter, 4
	as "U"
		take-unicode-escape out, iter, 8
	as "x"
		take-unicode-escape out, iter, 2
	else
		false

-take-unicode-escape bool(out char8 builder, iter string-iterator, sequence-length nat)
	try
		full-char mut nat32 = 0
		for _ in 0::nat .. sequence-length
			assert x = ?decode-hex-digit peek iter else invalid-unicode-character 0
			_ = take-next iter
			full-char := (full-char << 4) | x.to
		out ~~= full-char.to::char32.to::string.to
		true
	catch as invalid-unicode-character
		false

# TODO: support letters from more languages
| Matches and returns a sequence of letters.
+word string grammar()
	transform letter.one-or-more, it.to

-letter char8 grammar()
	char-matching-predicate "letter", it.is-letter

| Parse a string "true" or "false".
+bool bool grammar()
	(exact "true", true) / (exact "false", false)

| Parses a natural number in decimal format.
| This allows leading 0s which have no effect.
+nat nat64 grammar()
	parse: it.take-nat

| Parses a signed integer in decimal format.
| This allows e.g. "1", "+23", "-45".
+int int64 grammar()
	parse: of iter
		sign = try-take-sign iter
		int-of-nat sign, take-nat iter

-int-of-nat int(sign sign?, a nat)
	try
		if sign
			match sign
			as negative
				-a
			as positive
				to a
		else
			to a
	catch as arithmetic-error
		throw inner-parse-error "numeric overflow"

-take-base-and-nat (nat, nat)(iter string-iterator)
	assert peek-digit iter else inner-parse-error "number"
	base = try-take-0-base iter else 10
	assert nat-value mut = next-digit iter, base else inner-parse-error "number"
	while
		skip-underscore-if-before-digit iter
		if digit = next-digit iter, base
			try
				nat-value := nat-value * base + digit
			catch as arithmetic-error
				throw inner-parse-error "numeric overflow"
			true
	base, nat-value

~take-nat nat64(iter string-iterator) =b take-base-and-nat iter
-next-digit nat64?(a string-iterator, base nat)
	do if char = peek a
	do if digit = char-to-nat64 char, base
	_ = take-next a
	digit

+is-digit bool(a char8)
	"0"::char8 <= a and a <= "9"
-char-to-nat64 nat64?(c char8, base nat64)
	assert base <= 36
	if "0"::char8 <= c and c <= "9"
		res nat64 = c.to - "0"::char8.to
		if res < base then res
	elif "a"::char8 <= c and c <= "z"
		res nat64 = 10 + (c.to - "a"::char8.to)
		if res < base then res

| Parse a decimal number.
| This allows e.g. "+1.23".
+float float64 grammar()
	parse: it.take-number.to
-to float(a number)
	match a
	as nat then a.to
	as int then a.to
	as float then a
-sign enum(negative, positive)
~take-number number(iter string-iterator)
	start = copy iter
	sign = try-take-sign iter
	base, nat-value = take-base-and-nat iter
	if base == 10 and iter.peek == "." and peek-digit-next iter
		# Float parsing is hard, so just get a string and pass it to the Java (or JS) standard library.
		_ = take-next iter
		while
			skip-underscore-if-before-digit iter
			next-digit iter, 10
		parse-float slice start, iter
	elif sign
		if sign == negative and nat-value == 0
			# '-0' makes no sense as an int, so assume float
			-0::float
		else
			int-of-nat sign, nat-value
	else
		nat-value

-try-take-sign sign?(a string-iterator)
	if try-take a, "-"
		negative
	elif try-take a, "+"
		positive

-try-take-0-base nat?(iter string-iterator)
	if try-take iter, "0b"
		2
	elif try-take iter, "0o"
		8
	elif try-take iter, "0x"
		16

~peek-digit bool(a string-iterator)
	(x = peek a) and is-digit x
-peek-digit-next bool(a string-iterator)
	(x = peek-by a, 1) and is-digit x

-skip-underscore-if-before-digit void(a string-iterator)
	if a.peek == "_" and peek-digit-next a
		_ = a.take-next

| WARN: Does not validate {a}
-parse-float float64(a string-view)
	trusted if java
		parseDouble fix-number-for-java a
	elif js
		call Number, a.to::string.to 'to
	else
		throw todo
-fix-number-for-java String(a string-view) java
	fixed char8[] = if contains a, "_"
		for* x in a
			unless x == "_"
				- x
	else
		a.to
	fixed.to::string.to

+is-whitespace bool(a char8)
	a == "\n" or is-whitespace-non-newline a

+is-whitespace-non-newline bool(a char8)
	a == " " or a == "\t" or a == "\r"

+json json grammar()
	parse: of iter
		res = parse-json iter
		skip-whitespace iter
		res
| Expose an alternate version to avoid 'parse' which is an async fun
~parse-json json(a string)
	iter = begin a
	res = parse-json iter
	skip-whitespace iter
	assert is-at-end iter else parse-error a, iter.index, "string continues past end of parse"
	res
-parse-json json(a string-iterator)
	skip-whitespace a
	if try-take a, "false"
		false
	elif try-take a, "true"
		true
	elif try-take a, "null"
		null
	elif try-take a, "\""
		take-quoted-string-after-quote a 'to
	elif try-take a, "["
		skip-whitespace a
		res json[] = unless try-take a, "]"
			do with out in build
			out ~= parse-json a
			skip-whitespace a
			while try-take a, ","
				out ~= parse-json a
			skip-whitespace a
			assert try-take a, "]" else inner-parse-error "']'"
		res.to
	elif try-take a, "\{"
		skip-whitespace a
		res json[symbol] = unless try-take a, "\}"
			do with out in build
			out ~= take-key-value a
			while try-take a, ","
				out ~= take-key-value a
			skip-whitespace a
			assert try-take a, "\}" else inner-parse-error "'\}'"
		res.to
	else
		try
			take-number a 'to
		catch as inner-parse-error
			throw inner-parse-error "JSON value"
-take-key-value (symbol, json)(a string-iterator)
	skip-whitespace a
	key = take-quoted-string a
	skip-whitespace a
	assert try-take a, ":" else inner-parse-error "':'"
	skip-whitespace a
	value = parse-json a
	skip-whitespace a
	key.to, value

~try-take-number number?(iter string-iterator)
	if peek-digit iter or iter.peek == "-" and peek-digit-next iter
		take-number iter

+kid json grammar()
	parse: it.parse-kid

~kid-parse-error record(pos nat32, expected string)
~parse-kid-result union(json, kid-parse-error)
~parse-kid parse-kid-result(text string-view)
	iter string-iterator = begin text
	try
		res = parse-kid iter
		assert is-at-end iter else inner-parse-error "Kid value"
		res
	catch error as inner-parse-error
		pos: iter.pos
		expected: expected error

-parse-kid json(iter string-iterator)
	indent-kind = detect-indent-kind iter
	skip-all-whitespace iter
	ctx ctx = indent-kind: indent-kind
	res, new-indent = parse-kid-line iter, ctx, 0
	new-indent is eof-indent
	res

-ctx record(indent-kind indent-kind)
-eof-indent int32()
	# Treat end of file as being at a lesser indent so the parser will naturally exit
	-1

| Returns the expression, and optionally the new indent amount (which will be <= {indent})
-parse-kid-line (json, int32)(iter string-iterator, ctx ctx, indent int32)
	if try-take-list-start iter
		parse-kid-multi-line-list iter, ctx, indent
	else
		match first = parse-kid-simple iter
		as json
			- if try-take iter, ","
				parse-kid-single-line-list-after-value-and-comma iter, first
			else
				first
			- take-next-indent iter, ctx, indent
		as symbol
			parse-kid-single-or-multi-line-object iter, ctx, first, indent

-to (json, int32?)((j json, i int32))
	j, i

-parse-kid-inner-including-list (json, int32?)(iter string-iterator, ctx ctx, indent int32)
	res, new-indent = parse-kid-inner iter, ctx, indent
	- if not new-indent and try-take iter, ","
		parse-kid-single-line-list-after-value-and-comma iter, res
	else
		res
	- new-indent

| This does not take commas for lists. Caller is responsible.
-parse-kid-inner (json, int32?)(iter string-iterator, ctx ctx, indent int32)
	skip-spaces iter
	if try-take iter, "\n"
		new-indent = take-next-indent-after-newline iter, ctx
		new-indent is indent + 1 else inner-parse-error "Kid value"
		parse-kid-line iter, ctx, new-indent 'to
	else
		match first = parse-kid-simple iter
		as json
			- first
			- try-take-next-indent iter, ctx, indent
		as symbol
			parse-kid-single-line-object iter, ctx, first, indent 'to

-parse-kid-single-line-list-after-value-and-comma json(iter string-iterator, first json)
	skip-spaces iter
	if peek-end-of-line iter or iter.peek == ")"
		- first
	else
		parse-kid-single-line-list-after-value-comma-value iter, first, parse-kid-simple-no-colon iter
-parse-kid-single-line-list-after-value-comma-value json(iter string-iterator, first json, second json)
	do with::json[] out in build
	out ~= first
	out ~= second
	while try-take iter, ","
		skip-spaces iter
		out ~= parse-kid-simple-no-colon iter

-parse-kid-multi-line-list (json, int32)(iter string-iterator, ctx ctx, indent int32)
	new-indent mut int32 = ()
	res json[] = with out in build
		first-value, first-indent = parse-kid-inner-including-list iter, ctx, indent
		out ~= first-value
		new-indent := first-indent else take-next-indent iter, ctx, indent
		while new-indent == indent
			assert try-take-list-start iter else inner-parse-error "List item"
			next-value, next-indent = parse-kid-inner-including-list iter, ctx, indent
			out ~= next-value
			new-indent := next-indent else take-next-indent iter, ctx, indent
	res.to, new-indent

-try-take-list-start bool(iter string-iterator)
	if starts-with-then-whitespace iter, "-"
		_ = take-next iter
		true

-starts-with-then-whitespace bool(a string-iterator, start string)
	copy = copy a
	try-take-all copy, start.to::char8[] and x = peek copy and is-whitespace x

-parse-kid-single-line-object (json, int32)(iter string-iterator, ctx ctx, first-name symbol, indent int32)
	first-value, first-indent = parse-kid-inner iter, ctx, indent
	if first-indent
		res json[symbol] = (first-name, first-value),
		res.to, first-indent
	else
		parse-kid-single-line-object-inner iter, ctx, first-name, first-value, indent

-parse-kid-single-or-multi-line-object (json, int32)(iter string-iterator, ctx ctx, first-name symbol, indent int32)
	first-value, first-indent = parse-kid-inner iter, ctx, indent
	do if first-indent else parse-kid-single-line-object-inner iter, ctx, first-name, first-value, indent
	new-indent mut int32 = first-indent
	res json[symbol] = with out in build
		out ~= first-name, first-value
		while new-indent == indent
			next-name = take-name-colon-or-string-colon iter
			next-value, next-indent = parse-kid-inner-including-list iter, ctx, indent
			new-indent := next-indent else take-next-indent iter, ctx, indent
			out ~= next-name, next-value
	res.to, new-indent

-parse-kid-single-line-object-inner (json, int32)
	iter string-iterator
	ctx ctx
	first-name symbol
	first-value json
	indent int32
do
	new-indent mut int32? = ()
	cur-name mut = first-name
	cur-value mut = first-value
	res json[symbol] = with out in build
		while not new-indent and try-take iter, ","
			skip-spaces iter
			match x = parse-kid-simple iter
			as json
				cur-value := parse-kid-single-line-list-after-value-comma-value iter, cur-value, x
			as symbol
				out ~= cur-name, cur-value
				next-value, next-indent = parse-kid-inner iter, ctx, indent
				cur-name := x
				cur-value := next-value
				new-indent := next-indent
		out ~= cur-name, cur-value
	- res.to
	- new-indent else take-next-indent iter, ctx, indent

-parse-kid-simple-no-colon json(iter string-iterator)
	if try-take iter, "("
		after-paren iter
	elif name = try-take-keen-identifier iter
		kid-value-from-name name
	elif x = try-take-quoted-string iter
		x.to
	elif x = try-take-number iter
		x.to
	else
		throw inner-parse-error "Kid value"

-after-paren json(iter string-iterator)
	if try-take iter, ")"
		null
	else
		value, dedent = parse-kid-inner-including-list iter, (indent-kind: tabs), 0
		assert not dedent and try-take iter, ")" else
			inner-parse-error "Closing parenthesis"
		value

# 'json' for a simple value; 'symbol' for a name followed by a colon
-kid-simple union(json, symbol)
-parse-kid-simple kid-simple(iter string-iterator)
	if try-take iter, "("
		after-paren iter
	elif name = try-take-keen-identifier iter
		if try-take iter, ":"
			name
		else
			kid-value-from-name name
	elif x = try-take-quoted-string iter
		if try-take iter, ":"
			to::symbol x
		else
			to::json x
	elif x = try-take-number iter
		to::json x
	else
		throw inner-parse-error "Kid value"

-kid-value-from-name json(name symbol)
	match name
	as empty-array
		()::json[].to
	as empty-object
		()::json[symbol].to
	as false
		false
	as null
		null
	as true
		true
	else
		throw inner-parse-error "Kid value"

-peek-end-of-line bool(a string-iterator)
	is-at-end a or a.peek == "\n"

-take-name-colon-or-string-colon symbol(iter string-iterator)
	assert res = (try-take-keen-identifier iter or ?to try-take-quoted-string iter) else
		inner-parse-error "Identifier or string, then ':'"
	assert try-take iter, ":" else inner-parse-error "Colon after identifier"
	res

-skip-all-whitespace void(iter string-iterator)
	while x = peek iter and is-whitespace x
		_ = take-next iter
-skip-spaces void(iter string-iterator)
	while x = peek iter and is-whitespace-non-newline x
		_ = take-next iter
~try-take-quoted-string string?(iter string-iterator)
	if try-take iter, "\""
		try
			take-quoted-string-after-quote iter
		catch as inner-parse-error
			()

-try-take-next-indent int32?(iter string-iterator, ctx ctx, cur-indent int32)
	if peek-end-of-line iter
		take-next-indent iter, ctx, cur-indent
-take-next-indent int32(iter string-iterator, ctx ctx, cur-indent int32)
	skip-spaces iter
	assert try-take iter, "\n" or is-at-end iter else inner-parse-error "Newline"
	res = take-next-indent-after-newline iter, ctx
	assert res <= cur-indent else inner-parse-error "Cannot indent here"
	res
-take-next-indent-after-newline int32(iter string-iterator, ctx ctx)
	do until
	new-indent = take-indent-amount-after-newline iter, ctx.indent-kind, of _
		throw inner-parse-error "Indent by {ctx.indent-kind}"
	if is-at-end iter
		eof-indent
	elif try-take iter, "\n"
		()
	else
		new-indent::nat64.to::int64.to
